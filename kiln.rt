fn configure_native(var kiln::Target& target) {
	@target.compiler("cpp");
	@target.sources.add("base/src");
	@target.sources.add("version");
	@target.sources.add("compiler/src");
	@target.depends_on("rutile-language.obj");
	@target.option("standard", "c++latest");
	@target.option("includes", "base/include;version;../Kiln/build/bootstrap/include");
	@target.option("forced_includes", "../Kiln/build/bootstrap/config.hpp");
	@target.option("library_paths", "../Kiln/build/bootstrap/lib");
	@target.option("libraries", "LLVM-C.lib;CLI11.lib;legacy_stdio_definitions.lib;kernel32.lib;user32.lib;shell32.lib;advapi32.lib");
	@target.option("excludes", "base/src/posix.cpp");
	@target.option("runtime_files", "distro/windows-x64/LLVM-C.dll");
};

fn main(kiln::Options& options) {
	kiln::profile("debug", 0);
	kiln::profile("release", 2);
	var language = kiln::add_target("rutile-language.obj", kiln::TargetType::object_lib);
	@language.sources.add("compiler/std");
	@language.sources.add("compiler/src");

	var compiler = kiln::add_target("compiler.exe", kiln::TargetType::executable);
	configure_native(@compiler);
};
