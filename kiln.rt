fn configure_native(var kiln::Target& target, kiln::Options& options) {
	var version_result = kiln::read_file(rt::string(options.path()) + "/VERSION");
	if (!version_result.has<rt::string>()) {
		kiln::error("Cannot read VERSION.");
		return;
	};
	rt::string version_file = version_result.get<rt::string>();
	var version = version_file.trim();
	if (version.empty() || version.size() >= 64) {
		kiln::error("VERSION must contain a nonempty version shorter than 64 bytes.");
		return;
	};
	var definitions = rt::string("RUTILE_VERSION=\"") + version + "\";RUTILE_PROTOCOL_VERSION=2";

	@target.option("standard", "c++latest");
	@target.option("runtime", "MT");
	@target.option("includes", "compiler/include;compiler/src");
	@target.option("defines", definitions);
	@target.option("libraries", "legacy_stdio_definitions.lib;kernel32.lib;user32.lib;shell32.lib;advapi32.lib");
	@target.option("excludes", "compiler/src/platform/posix.cpp");
};

fn build(kiln::Options& options) {
	kiln::build_directory("build");
	kiln::profile("debug", 0);
	kiln::profile("release", 2);

	var standard = kiln::add_target("std", kiln::TargetType::static_lib);
	@standard.option("runtime", "MT");
	@standard.sources.add("std");

	var compiler = kiln::add_target("compiler", kiln::TargetType::static_lib);
	configure_native(@compiler, options);
	@compiler.package("nlohmann_json");
	@compiler.package("LLVM");
	@compiler.option("excludes", "compiler/src/platform/posix.cpp;compiler/src/cli/main.cpp");
	@compiler.sources.add("compiler/src");
	@compiler.depends_on("std");

	var executable = kiln::add_target("rutilec", kiln::TargetType::executable);
	configure_native(@executable, options);
	@executable.package("CLI11");
	@executable.package("nlohmann_json");
	@executable.sources.add("compiler/src/cli");
	@executable.depends_on("compiler");

	var compiler_tests = kiln::add_tests(compiler);
	@compiler_tests.sources.add("tests/compiler");
	var std_tests = kiln::add_tests(standard);
	@std_tests.sources.add("tests/std");
	var editor = kiln::add_target("Rutile.VisualStudio", kiln::TargetType::shared_lib);
	@editor.sources.add("tools/Rutile.VisualStudio");
	var editor_tests = kiln::add_tests(editor);
	@editor_tests.depends_on("std");
	@editor_tests.sources.add("tests/visual-studio");
	@editor_tests.option("dispatcher", "EditorObservations");
};
