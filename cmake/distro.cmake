if(DEFINED RUTILE_DISTRO_REFRESH)
	if(NOT RUTILE_DISTRO_CONFIGURATION STREQUAL "Release")
		message(FATAL_ERROR "Refresh the compiler distribution from a Release build.")
	endif()
	if(NOT RUTILE_DISTRO_INPUTS)
		message(FATAL_ERROR "The compiler distribution requires its source inputs.")
	endif()

	foreach(required IN ITEMS "RUTILE_DISTRO_COMPILER" "RUTILE_DISTRO_LLVM" "RUTILE_DISTRO_CLI_LICENSE")
		if(NOT EXISTS "${${required}}")
			message(FATAL_ERROR "Missing distribution input: ${${required}}")
		endif()
	endforeach()
	if(NOT EXISTS "${RUTILE_DISTRO_SOURCE}/distro/licenses/llvm.txt")
		message(FATAL_ERROR "The LLVM distribution license is missing.")
	endif()
	foreach(runtime IN ITEMS "msvcp140.dll" "vcruntime140.dll" "vcruntime140_1.dll")
		if(NOT EXISTS "${RUTILE_DISTRO_CRT}/${runtime}")
			message(FATAL_ERROR "Missing Microsoft redistributable runtime: ${RUTILE_DISTRO_CRT}/${runtime}")
		endif()
	endforeach()

	file(READ "${RUTILE_DISTRO_SOURCE}/version/release.txt" release_version)
	string(STRIP "${release_version}" release_version)
	if(NOT release_version MATCHES "^0\\.0\\.[1-9][0-9]*$")
		message(FATAL_ERROR "Invalid release version for distribution publication.")
	endif()
	execute_process(COMMAND "${RUTILE_DISTRO_COMPILER}" "--version" OUTPUT_VARIABLE compiler_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL "ANY")
	if(NOT compiler_version STREQUAL release_version)
		message(FATAL_ERROR "Compiler version ${compiler_version} does not match publication ${release_version}.")
	endif()

	set(distribution "${RUTILE_DISTRO_SOURCE}/distro")
	file(MAKE_DIRECTORY "${distribution}/windows-x64" "${distribution}/licenses" "${RUTILE_DISTRO_BUILD}/distro")
	file(COPY_FILE "${RUTILE_DISTRO_COMPILER}" "${distribution}/windows-x64/compiler.exe" ONLY_IF_DIFFERENT)
	file(COPY_FILE "${RUTILE_DISTRO_LLVM}" "${distribution}/windows-x64/LLVM-C.dll" ONLY_IF_DIFFERENT)
	foreach(runtime IN ITEMS "msvcp140.dll" "vcruntime140.dll" "vcruntime140_1.dll")
		file(COPY_FILE "${RUTILE_DISTRO_CRT}/${runtime}" "${distribution}/windows-x64/${runtime}" ONLY_IF_DIFFERENT)
	endforeach()
	file(COPY_FILE "${RUTILE_DISTRO_CLI_LICENSE}" "${distribution}/licenses/cli11.txt" ONLY_IF_DIFFERENT)
	set(compiler_source "")
	foreach(source IN LISTS RUTILE_DISTRO_INPUTS)
		file(READ "${source}" source_content)
		string(REPLACE "\r\n" "\n" source_content "${source_content}")
		string(APPEND compiler_source "${source_content}\n")
	endforeach()
	file(WRITE "${distribution}/compiler.rt" "${compiler_source}")

	file(SHA256 "${distribution}/compiler.rt" source_hash)
	file(WRITE "${distribution}/version.txt" "${release_version}\n")
	file(WRITE "${distribution}/source.sha256" "${source_hash}\n")

	set(archive "${RUTILE_DISTRO_BUILD}/distro/rutile-${release_version}-windows-x64.zip")
	execute_process(COMMAND "${CMAKE_COMMAND}" "-E" "tar" "cf" "${archive}" "--format=zip" "compiler.rt" "windows-x64/compiler.exe" "windows-x64/LLVM-C.dll" "windows-x64/msvcp140.dll" "windows-x64/vcruntime140.dll" "windows-x64/vcruntime140_1.dll" "licenses" "version.txt" "source.sha256" WORKING_DIRECTORY "${distribution}" COMMAND_ERROR_IS_FATAL "ANY")
	message(STATUS "Compiler distribution refreshed: ${archive}")
	return()
endif()

function(rutile_configure_distro target)
	if(NOT WIN32 OR CMAKE_CROSSCOMPILING OR NOT CMAKE_SIZEOF_VOID_P EQUAL "8" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
		return()
	endif()

	set(redist_root "$ENV{VCToolsRedistDir}")
	if(NOT IS_DIRECTORY "${redist_root}")
		get_filename_component(toolchain_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
		get_filename_component(toolchain_root "${toolchain_bin}/../../.." ABSOLUTE)
		get_filename_component(vc_root "${toolchain_root}/../../.." ABSOLUTE)
		file(GLOB redist_versions LIST_DIRECTORIES "TRUE" "${vc_root}/Redist/MSVC/[0-9]*")
		list(SORT redist_versions COMPARE "NATURAL" ORDER "DESCENDING")
		foreach(candidate IN LISTS redist_versions)
			if(IS_DIRECTORY "${candidate}/x64/Microsoft.VC143.CRT")
				set(redist_root "${candidate}")
				break()
			endif()
		endforeach()
	endif()
	set(crt_directory "${redist_root}/x64/Microsoft.VC143.CRT")
	set(cli_license "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/cli11/copyright")

	add_custom_target("rutile-distro"
		COMMAND "${CMAKE_COMMAND}" "-DRUTILE_DISTRO_REFRESH=ON" "-DRUTILE_DISTRO_CONFIGURATION=$<CONFIG>" "-DRUTILE_DISTRO_COMPILER=$<TARGET_FILE:${target}>" "-DRUTILE_DISTRO_LLVM=$<TARGET_FILE:rutile-llvm>" "-DRUTILE_DISTRO_CRT=${crt_directory}" "-DRUTILE_DISTRO_CLI_LICENSE=${cli_license}" "-DRUTILE_DISTRO_SOURCE=${CMAKE_SOURCE_DIR}" "-DRUTILE_DISTRO_BUILD=${CMAKE_BINARY_DIR}" "-DRUTILE_DISTRO_INPUTS=${rutile_compiler_sources}" "-P" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
		DEPENDS "rutile-bootstrap-check" "${target}"
		VERBATIM)
endfunction()
