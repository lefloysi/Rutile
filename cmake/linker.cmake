function(rutile_configure_linker target)
	if(WIN32)
		find_program(RUTILE_NATIVE_LINKER NAMES "lld-link" HINTS "${RUTILE_LLVM_ROOT}/bin" "$ENV{LLVM_ROOT}/bin" "$ENV{ProgramFiles}/LLVM/bin" REQUIRED)
		set(runtime_paths "$ENV{LIB}")
		foreach(runtime IN ITEMS "libcmt" "libvcruntime" "libucrt" "oldnames" "kernel32")
			string(TOUPPER "${runtime}" runtime_name)
			find_library("RUTILE_RUNTIME_${runtime_name}" NAMES "${runtime}" PATHS ${runtime_paths} REQUIRED)
			file(TO_CMAKE_PATH "${RUTILE_RUNTIME_${runtime_name}}" runtime_path)
			target_compile_definitions("${target}" PRIVATE "RUTILE_RUNTIME_${runtime_name}=\"${runtime_path}\"")
		endforeach()
	else()
		find_program(RUTILE_NATIVE_LINKER NAMES "cc" "gcc" "clang" REQUIRED)
	endif()
	file(TO_CMAKE_PATH "${RUTILE_NATIVE_LINKER}" linker_path)
	target_compile_definitions("${target}" PRIVATE "RUTILE_NATIVE_LINKER=\"${linker_path}\"")
endfunction()
