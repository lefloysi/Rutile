function(rutile_configure_llvm target)
	if(WIN32)
		find_path(RUTILE_LLVM_ROOT NAMES "bin/LLVM-C.dll" HINTS "$ENV{LLVM_ROOT}" "$ENV{ProgramFiles}/LLVM" REQUIRED)
		find_library(RUTILE_LLVM_LIBRARY NAMES "LLVM-C" PATHS "${RUTILE_LLVM_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
		find_program(llvm_readobj NAMES "llvm-readobj" PATHS "${RUTILE_LLVM_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
		find_program(powershell NAMES "pwsh" "powershell" REQUIRED)
		set(llvm_dll "${RUTILE_LLVM_ROOT}/bin/LLVM-C.dll")
		set(version_probe "Add-Type 'using System.Runtime.InteropServices; public class RutileLlvmVersion { [DllImport(\"${llvm_dll}\", CallingConvention=CallingConvention.Cdecl)] public static extern void LLVMGetVersion(out uint major, out uint minor, out uint patch); }'; [uint32]$major=0; [uint32]$minor=0; [uint32]$patch=0; [RutileLlvmVersion]::LLVMGetVersion([ref]$major,[ref]$minor,[ref]$patch); Write-Output \"$major.$minor.$patch\"")
		execute_process(COMMAND "${powershell}" "-NoProfile" "-Command" "${version_probe}" RESULT_VARIABLE probe_result OUTPUT_VARIABLE llvm_version ERROR_VARIABLE probe_error OUTPUT_STRIP_TRAILING_WHITESPACE)
		if(NOT probe_result EQUAL "0" OR NOT llvm_version MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
			message(FATAL_ERROR "Cannot determine installed LLVM-C.dll version: ${probe_error}")
		endif()
		set(llvm_major "${CMAKE_MATCH_1}")
		set(llvm_minor "${CMAKE_MATCH_2}")
		set(llvm_patch "${CMAKE_MATCH_3}")
		find_path(llvm_include NAMES "llvm-c/Core.h" PATHS "${RUTILE_LLVM_ROOT}/include" NO_DEFAULT_PATH)
		if(llvm_include)
			set(config_header "${llvm_include}/llvm/Config/llvm-config.h")
			if(NOT EXISTS "${config_header}")
				message(FATAL_ERROR "LLVM headers have no version configuration: ${config_header}")
			endif()
			file(READ "${config_header}" config_contents)
			foreach(component IN ITEMS "MAJOR" "MINOR" "PATCH")
				string(TOLOWER "${component}" component_name)
				if(NOT config_contents MATCHES "#define[ \t]+LLVM_VERSION_${component}[ \t]+${llvm_${component_name}}([ \t\r\n]|$)")
					message(FATAL_ERROR "LLVM C headers do not match installed LLVM-C.dll ${llvm_version}.")
				endif()
			endforeach()
		endif()
		if(NOT llvm_include)
			set(llvm_include "${CMAKE_BINARY_DIR}/llvm/${llvm_version}/include")
			set(header_queue "llvm-c/Core.h" "llvm-c/Analysis.h" "llvm-c/Error.h" "llvm-c/Target.h" "llvm-c/TargetMachine.h" "llvm-c/Transforms/PassBuilder.h")
			set(downloaded_headers "")
			while(header_queue)
				list(POP_FRONT header_queue header)
				if(header IN_LIST downloaded_headers OR header MATCHES "^llvm/Config/")
					continue()
				endif()
				list(APPEND downloaded_headers "${header}")
				set(header_path "${llvm_include}/${header}")
				if(NOT EXISTS "${header_path}")
					get_filename_component(header_directory "${header_path}" DIRECTORY)
					file(MAKE_DIRECTORY "${header_directory}")
					file(DOWNLOAD "https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-${llvm_version}/llvm/include/${header}" "${header_path}" TLS_VERIFY "ON" STATUS download_status)
					list(GET download_status "0" download_result)
					if(NOT download_result EQUAL "0")
						file(REMOVE "${header_path}")
						message(FATAL_ERROR "Could not obtain official LLVM ${llvm_version} header ${header}: ${download_status}")
					endif()
				endif()
				file(STRINGS "${header_path}" includes REGEX "^#include \"llvm[^\"]+\"")
				foreach(include IN LISTS includes)
					string(REGEX REPLACE "^#include \"([^\"]+)\".*" "\\1" dependency "${include}")
					list(APPEND header_queue "${dependency}")
				endforeach()
			endwhile()
			execute_process(COMMAND "${llvm_readobj}" "--coff-exports" "${llvm_dll}" RESULT_VARIABLE exports_result OUTPUT_VARIABLE llvm_exports)
			if(NOT exports_result EQUAL "0")
				message(FATAL_ERROR "Cannot inspect installed LLVM native target exports.")
			endif()
			if(NOT CMAKE_SIZEOF_VOID_P EQUAL "8" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
				message(FATAL_ERROR "The partial Windows LLVM SDK requires an x64 host; use a complete LLVM SDK for other hosts.")
			endif()
			foreach(symbol IN ITEMS "Target" "TargetInfo" "TargetMC" "AsmPrinter" "AsmParser" "Disassembler")
				if(NOT llvm_exports MATCHES "Name: LLVMInitializeX86${symbol}[\r\n]")
					message(FATAL_ERROR "Installed LLVM is missing LLVMInitializeX86${symbol}.")
				endif()
			endforeach()
			file(MAKE_DIRECTORY "${llvm_include}/llvm/Config")
			file(WRITE "${llvm_include}/llvm/Config/llvm-config.h" "#pragma once\n#define LLVM_VERSION_MAJOR ${llvm_major}\n#define LLVM_VERSION_MINOR ${llvm_minor}\n#define LLVM_VERSION_PATCH ${llvm_patch}\n#define LLVM_ENABLE_LLVM_C_EXPORT_ANNOTATIONS 1\n#define LLVM_NATIVE_TARGET LLVMInitializeX86Target\n#define LLVM_NATIVE_TARGETINFO LLVMInitializeX86TargetInfo\n#define LLVM_NATIVE_TARGETMC LLVMInitializeX86TargetMC\n#define LLVM_NATIVE_ASMPRINTER LLVMInitializeX86AsmPrinter\n#define LLVM_NATIVE_ASMPARSER LLVMInitializeX86AsmParser\n#define LLVM_NATIVE_DISASSEMBLER LLVMInitializeX86Disassembler\n")
			file(WRITE "${llvm_include}/llvm/Config/Targets.def" "LLVM_TARGET(X86)\n")
			file(WRITE "${llvm_include}/llvm/Config/AsmPrinters.def" "LLVM_ASM_PRINTER(X86)\n")
			file(WRITE "${llvm_include}/llvm/Config/AsmParsers.def" "LLVM_ASM_PARSER(X86)\n")
			file(WRITE "${llvm_include}/llvm/Config/Disassemblers.def" "LLVM_DISASSEMBLER(X86)\n")
		endif()
		add_library("rutile-llvm" SHARED IMPORTED GLOBAL)
		set_target_properties("rutile-llvm" PROPERTIES IMPORTED_IMPLIB "${RUTILE_LLVM_LIBRARY}" IMPORTED_LOCATION "${llvm_dll}" INTERFACE_INCLUDE_DIRECTORIES "${llvm_include}")
	else()
		find_package("LLVM" CONFIG REQUIRED)
		find_library(RUTILE_LLVM_LIBRARY NAMES "LLVM-${LLVM_VERSION_MAJOR}" "LLVM" HINTS "${LLVM_LIBRARY_DIRS}" REQUIRED)
		set(llvm_major "${LLVM_VERSION_MAJOR}")
		set(llvm_minor "${LLVM_VERSION_MINOR}")
		set(llvm_patch "${LLVM_VERSION_PATCH}")
		add_library("rutile-llvm" SHARED IMPORTED GLOBAL)
		set_target_properties("rutile-llvm" PROPERTIES IMPORTED_LOCATION "${RUTILE_LLVM_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS}")
	endif()
	target_link_libraries("${target}" PRIVATE "rutile-llvm")
	target_compile_definitions("rutile-llvm" INTERFACE "RUTILE_LLVM_VERSION_MAJOR=${llvm_major}" "RUTILE_LLVM_VERSION_MINOR=${llvm_minor}" "RUTILE_LLVM_VERSION_PATCH=${llvm_patch}")
	message(STATUS "Rutile LLVM C API: ${llvm_major}.${llvm_minor}.${llvm_patch}")
endfunction()
