fn fopen(const char* path, const char* mode) -> var NativeFile*;

fn platform_standard_error() -> var NativeFile*;

fn rutile_compiler_session(((var Compiler*, var void*) -> i32)* callback, var void* data) -> i32 {
	var compiler = rt::unique<Compiler>::make();

	if (!compiler.get()) {
		return 1;
	};

	return callback(compiler.get(), $data);
};

fn rutile_compile(var Compiler* compiler, var (var char*)* paths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics) -> i32 {
	if (!compiler) {
		return 1;
	};

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler->compile($paths, $count, $output_path, $opener, $entry, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(var (var char*)* paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics) -> i32 {
	Compiler compiler;

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler.compile($paths, $count, $output_path, $opener, nullptr, $optimization, $diagnostics, output_kind::library);
};
