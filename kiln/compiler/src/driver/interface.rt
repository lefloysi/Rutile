fn fopen(const char* path, const char* mode) -> NativeFile*;

fn platform_standard_error() -> NativeFile*;

fn rutile_compiler_session(((Compiler*, void*) -> i32)* callback, void* data) -> i32 {
	var compiler = rt::unique<Compiler>::make();

	if (!compiler.get()) {
		return 1;
	};

	return callback(compiler.get(), $data);
};

fn rutile_compile(Compiler* compiler, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, NativeFile* diagnostics) -> i32 {
	if (!compiler) {
		return 1;
	};

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler->compile($paths, $count, $output_path, $opener, $entry, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(char** paths, usize count, char* output_path, FileOpener opener, i32 optimization, NativeFile* diagnostics) -> i32 {
	Compiler compiler;

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler.compile($paths, $count, $output_path, $opener, nullptr, $optimization, $diagnostics, output_kind::library);
};
