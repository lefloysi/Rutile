fn Backend::external_signature(var Backend& this, var Entity* entity) -> bool {
	const FunctionSignature& signature = entity->type()->signature();
	const Type* result = signature.result()->representation();

	if (result->kind() == type_kind::array || result->kind() == type_kind::named) {
		var message = DiagnosticMessage();
		@message.text("external aggregate return requires unsupported C ABI lowering for function '\0");
		diagnostic_entity(@message, *entity);
		@message.text("' of type '\0");
		diagnostic_type(@message, *entity->type());
		@message.text("'; result type is '\0");
		diagnostic_type(@message, *signature.result());
		@message.text("'\0");
		return @this.error(entity->token(), message.view());
	};

	usize index = 0;

	while (index < signature.parameters().size()) {
		const Type* parameter = signature.parameters().data()[index]->representation();

		if (parameter->kind() == type_kind::array || parameter->kind() == type_kind::named) {
			var message = DiagnosticMessage();
			@message.text("external aggregate parameter requires unsupported C ABI lowering for parameter \0");
			@message.number(index + 1);
			@message.text(" of function '\0");
			diagnostic_entity(@message, *entity);
			@message.text("' of type '\0");
			diagnostic_type(@message, *entity->type());
			@message.text("'; parameter type is '\0");
			diagnostic_type(@message, *signature.parameters().data()[index]);
			@message.text("'\0");
			return @this.error(entity->parameters().data()[index]->token(), message.view());
		};

		@index = index + 1;
	};

	return true;
};
