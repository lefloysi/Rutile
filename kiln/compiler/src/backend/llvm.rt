// C ABI declarations checked against the bundled LLVM 21.1 headers.

struct LLVMOpaqueContext;
struct LLVMOpaqueModule;
struct LLVMOpaqueBuilder;
struct LLVMOpaqueType;
struct LLVMOpaqueValue;
struct LLVMOpaqueBasicBlock;
struct LLVMTarget;
struct LLVMOpaqueTargetMachine;
struct LLVMOpaqueTargetData;
struct LLVMOpaqueMemoryBuffer;
struct LLVMOpaquePassBuilderOptions;
struct LLVMOpaqueError;

fn LLVMGetVersion(var u32* major, var u32* minor, var u32* patch);

fn LLVMContextCreate() -> var LLVMOpaqueContext*;
fn LLVMContextDispose(var LLVMOpaqueContext* context);

fn LLVMModuleCreateWithNameInContext(const char* name, var LLVMOpaqueContext* context) -> var LLVMOpaqueModule*;

fn LLVMDisposeModule(var LLVMOpaqueModule* module);

fn LLVMCreateBuilderInContext(var LLVMOpaqueContext* context) -> var LLVMOpaqueBuilder*;

fn LLVMDisposeBuilder(var LLVMOpaqueBuilder* builder);

fn LLVMInitializeX86TargetInfo();
fn LLVMInitializeX86Target();
fn LLVMInitializeX86TargetMC();
fn LLVMInitializeX86AsmPrinter();

fn LLVMGetDefaultTargetTriple() -> var char*;

fn LLVMDisposeMessage(var char* message);

fn LLVMGetTargetFromTriple(const char* triple, var (var LLVMTarget*)* target, var (var char*)* message) -> i32;

fn LLVMCreateTargetMachine(var LLVMTarget* target, const char* triple, const char* cpu, const char* features, i32 level, i32 relocation, i32 model) -> var LLVMOpaqueTargetMachine*;

fn LLVMDisposeTargetMachine(var LLVMOpaqueTargetMachine* machine);

fn LLVMCreateTargetDataLayout(var LLVMOpaqueTargetMachine* machine) -> var LLVMOpaqueTargetData*;

fn LLVMDisposeTargetData(var LLVMOpaqueTargetData* layout);

fn LLVMCopyStringRepOfTargetData(var LLVMOpaqueTargetData* layout) -> var char*;

fn LLVMPointerSize(var LLVMOpaqueTargetData* layout) -> u32;

fn LLVMABISizeOfType(var LLVMOpaqueTargetData* layout, var LLVMOpaqueType* type) -> u64;

fn LLVMSetTarget(var LLVMOpaqueModule* module, const char* triple);
fn LLVMSetDataLayout(var LLVMOpaqueModule* module, const char* layout);

fn LLVMVoidTypeInContext(var LLVMOpaqueContext* context) -> var LLVMOpaqueType*;

fn LLVMIntTypeInContext(var LLVMOpaqueContext* context, u32 bits) -> var LLVMOpaqueType*;

fn LLVMFloatTypeInContext(var LLVMOpaqueContext* context) -> var LLVMOpaqueType*;

fn LLVMDoubleTypeInContext(var LLVMOpaqueContext* context) -> var LLVMOpaqueType*;

fn LLVMPointerTypeInContext(var LLVMOpaqueContext* context, u32 address_space) -> var LLVMOpaqueType*;

fn LLVMArrayType2(var LLVMOpaqueType* element, u64 count) -> var LLVMOpaqueType*;

fn LLVMFunctionType(var LLVMOpaqueType* result, var (var LLVMOpaqueType*)* parameters, u32 count, i32 variadic) -> var LLVMOpaqueType*;

fn LLVMStructCreateNamed(var LLVMOpaqueContext* context, const char* name) -> var LLVMOpaqueType*;
fn LLVMStructSetBody(var LLVMOpaqueType* type, var (var LLVMOpaqueType*)* fields, u32 count, i32 packed);

fn LLVMConstInt(var LLVMOpaqueType* type, u64 value, i32 sign_extend) -> var LLVMOpaqueValue*;
fn LLVMConstReal(var LLVMOpaqueType* type, f64 value) -> var LLVMOpaqueValue*;
fn LLVMConstNull(var LLVMOpaqueType* type) -> var LLVMOpaqueValue*;
fn LLVMConstStringInContext2(var LLVMOpaqueContext* context, const char* text, usize length, i32 no_terminator) -> var LLVMOpaqueValue*;

fn LLVMTypeOf(var LLVMOpaqueValue* value) -> var LLVMOpaqueType*;

fn LLVMAddGlobal(var LLVMOpaqueModule* module, var LLVMOpaqueType* type, const char* name) -> var LLVMOpaqueValue*;

fn LLVMSetInitializer(var LLVMOpaqueValue* global, var LLVMOpaqueValue* initializer);
fn LLVMSetGlobalConstant(var LLVMOpaqueValue* global, i32 immutable);
fn LLVMSetLinkage(var LLVMOpaqueValue* global, i32 linkage);

fn LLVMAddFunction(var LLVMOpaqueModule* module, const char* name, var LLVMOpaqueType* type) -> var LLVMOpaqueValue*;

fn LLVMGetNamedFunction(var LLVMOpaqueModule* module, const char* name) -> var LLVMOpaqueValue*;
fn LLVMGetParam(var LLVMOpaqueValue* function, u32 index) -> var LLVMOpaqueValue*;

fn LLVMGlobalGetValueType(var LLVMOpaqueValue* global) -> var LLVMOpaqueType*;

fn LLVMAppendBasicBlockInContext(var LLVMOpaqueContext* context, var LLVMOpaqueValue* function, const char* name) -> var LLVMOpaqueBasicBlock*;

fn LLVMPositionBuilderAtEnd(var LLVMOpaqueBuilder* builder, var LLVMOpaqueBasicBlock* block);

fn LLVMGetInsertBlock(var LLVMOpaqueBuilder* builder) -> var LLVMOpaqueBasicBlock*;
fn LLVMGetBasicBlockTerminator(var LLVMOpaqueBasicBlock* block) -> var LLVMOpaqueValue*;

fn LLVMBuildAlloca(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildLoad2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, var LLVMOpaqueValue* pointer, const char* name) -> var LLVMOpaqueValue*;
