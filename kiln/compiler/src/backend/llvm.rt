fn LLVMBuildRet(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value) -> var LLVMOpaqueValue*;
fn LLVMBuildRetVoid(var LLVMOpaqueBuilder* builder) -> var LLVMOpaqueValue*;
fn LLVMBuildBr(var LLVMOpaqueBuilder* builder, var LLVMOpaqueBasicBlock* destination) -> var LLVMOpaqueValue*;
fn LLVMBuildCondBr(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* condition, var LLVMOpaqueBasicBlock* yes, var LLVMOpaqueBasicBlock* no) -> var LLVMOpaqueValue*;
fn LLVMBuildUnreachable(var LLVMOpaqueBuilder* builder) -> var LLVMOpaqueValue*;
fn LLVMBuildCall2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, var LLVMOpaqueValue* function, var (var LLVMOpaqueValue*)* arguments, u32 count, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildGEP2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, var LLVMOpaqueValue* pointer, var (var LLVMOpaqueValue*)* indices, u32 count, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildStructGEP2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, var LLVMOpaqueValue* pointer, u32 index, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildICmp(var LLVMOpaqueBuilder* builder, i32 predicate, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFCmp(var LLVMOpaqueBuilder* builder, i32 predicate, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, const char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildPhi(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, const char* name) -> var LLVMOpaqueValue*;

fn LLVMAddIncoming(var LLVMOpaqueValue* phi, var (var LLVMOpaqueValue*)* values, var (var LLVMOpaqueBasicBlock*)* blocks, u32 count);

fn LLVMVerifyModule(var LLVMOpaqueModule* module, i32 action, var (var char*)* message) -> i32;

fn LLVMCreatePassBuilderOptions() -> var LLVMOpaquePassBuilderOptions*;

fn LLVMDisposePassBuilderOptions(var LLVMOpaquePassBuilderOptions* options);

fn LLVMPassBuilderOptionsSetVerifyEach(var LLVMOpaquePassBuilderOptions* options, i32 verify);

fn LLVMRunPasses(var LLVMOpaqueModule* module, const char* passes, var LLVMOpaqueTargetMachine* machine, var LLVMOpaquePassBuilderOptions* options) -> var LLVMOpaqueError*;

fn LLVMGetErrorMessage(var LLVMOpaqueError* error) -> var char*;

fn LLVMDisposeErrorMessage(var char* message);

fn LLVMTargetMachineEmitToMemoryBuffer(var LLVMOpaqueTargetMachine* machine, var LLVMOpaqueModule* module, i32 file_type, var (var char*)* message, var (var LLVMOpaqueMemoryBuffer*)* buffer) -> i32;

fn LLVMDisposeMemoryBuffer(var LLVMOpaqueMemoryBuffer* buffer);

fn LLVMGetBufferStart(var LLVMOpaqueMemoryBuffer* buffer) -> const char*;
fn LLVMGetBufferSize(var LLVMOpaqueMemoryBuffer* buffer) -> usize;

