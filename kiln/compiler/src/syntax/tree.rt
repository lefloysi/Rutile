enum syntax_kind : [i32] {
	absent;
	error_expression;
	noop;
	unit;
	name;
	number;
	string;
	null_pointer;
	unary;
	grouping;
	binary;
	call;
	member;
	index;
	brace;
	array;
	conditional;
	while_loop;
	for_loop;
	return_value;
	break_loop;
	continue_loop;
	discard_value;
	allocation;
	deallocation;
	array_deallocation;
	switch_expression;
	case_label;
	sizeof_type;
	cast;
	variable;
	parameter;
	function;
	record;
	enumeration;
	enumerator;
	namespace_body;
	template_declaration;
	template_parameter;
	using_alias;
	list;
	attributes;
	ambiguity;
	type_name;
	type_pointer;
	type_reference;
	type_array;
	type_function;
	type_const;
	type_mutable;
	type_auto;
	access_label;
	qualified_name;
	conversion_name;
	operator_name;
	operator_array;
	template_apply;
};

// Syntax owns source structure. Resolved entities and types belong to semantic analysis.
// Slots are explicit: absent has no source expression; noop denotes the token ';'.
// Fixed shapes are constructed in grammar order and checked before publication:
// variable = [name, type, initializer], parameter = [name, type, default]
// function = [name, parameters, result, attributes, body]
// record = [name, bases, members], enumeration = [name, underlying, members]
// conditional = [condition, body, alternative], while/switch = [condition, body]
// for = [initializer, condition, step, body], call = [callable, arguments]
// namespace/template = [name-or-parameters, body-or-declaration]
// indirect type = [element], array type = [element, extent]
// function type = [parameters, result], const type = [element, condition]
// Lists, brace expressions, units, and attributes own a sequence of children.
// Ambiguity owns complete source interpretations, never borrowed alternatives.

struct Syntax {
	fn Syntax(var Syntax& this, syntax_kind kind, const Token& token);
	fn Syntax(var Syntax& this, const Syntax& other) : [delete];
	fn Syntax(var Syntax& this, Syntax other) : [default];

	fn operator=(var Syntax& this, const Syntax& other) -> var Syntax& : [delete];
	fn operator=(var Syntax& this, Syntax other) -> var Syntax& : [default];
	fn append(var Syntax& this, rt::unique<Syntax> child) -> bool;

	fn kind(const Syntax& this) -> syntax_kind;
	fn explicitly_qualified(const Syntax& this) -> bool;
	fn token(const Syntax& this) -> Token;
	fn size(const Syntax& this) -> usize;
	fn item(const Syntax& this, usize index) -> var Syntax*;
	fn complete(const Syntax& this) -> bool;
	fn fixed_arity(const Syntax& this) -> usize;

private:
	syntax_kind category;
	Token location;
	rt::buffer<rt::unique<Syntax>> children;
};

fn Syntax::Syntax(var Syntax& this, syntax_kind kind, const Token& token) {
	@this.category = $kind;
	@this.location := token;
};

fn Syntax::kind(const Syntax& this) -> syntax_kind {
	return syntax_kind(this.category);
};

fn Syntax::explicitly_qualified(const Syntax& this) -> bool {
	return this.category == syntax_kind::type_const || this.category == syntax_kind::type_mutable || this.category == syntax_kind::type_auto;
};

fn Syntax::token(const Syntax& this) -> Token {
	return Token(this.location);
};

fn Syntax::size(const Syntax& this) -> usize {
	return this.children.size();
};

fn Syntax::item(const Syntax& this, usize index) -> var Syntax* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn Syntax::append(var Syntax& this, rt::unique<Syntax> child) -> bool {
	if (!child.get() || this.children.size() >= this.fixed_arity()) {
		return false;
	};

	return @this.children.push_back($child);
};

fn Syntax::operand(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::left(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::right(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::callable(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::arguments(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::member_object(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::member_name(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::index_object(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::index_value(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::condition(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::body(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alternative(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_initializer(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::for_condition(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::for_step(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_body(const Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::variable_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::variable_type(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::variable_initializer(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::parameter_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::parameter_type(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::parameter_default(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_parameters(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_result(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_attributes(const Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::function_body(const Syntax& this) -> var Syntax* {
	return this.item(4);
};

fn Syntax::record_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::record_bases(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::record_members(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::enum_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enum_underlying(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::enum_members(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::namespace_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::namespace_members(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameters(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_declaration(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alias_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::alias_type(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::cast_type(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::cast_operand(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::allocation_type(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::allocation_arguments(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::designated_type(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::array_extent(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_type_parameters(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_type_result(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

// TypeSyntax is a borrowed view of the owned syntax subtree for a type-id.

struct TypeSyntax {
	fn TypeSyntax(var TypeSyntax& this, var Syntax* syntax);

	fn kind(const TypeSyntax& this) -> syntax_kind;
	fn element(const TypeSyntax& this) -> var Syntax*;
	fn extent(const TypeSyntax& this) -> var Syntax*;
	fn parameters(const TypeSyntax& this) -> var Syntax*;
	fn result(const TypeSyntax& this) -> var Syntax*;

private:
	var Syntax* syntax;
};

fn TypeSyntax::TypeSyntax(var TypeSyntax& this, var Syntax* syntax) {
	@this.syntax = $syntax;
};

fn TypeSyntax::kind(const TypeSyntax& this) -> syntax_kind {
	return this.syntax->kind();
};

fn TypeSyntax::element(const TypeSyntax& this) -> var Syntax* {
	return this.syntax->designated_type();
};

fn TypeSyntax::extent(const TypeSyntax& this) -> var Syntax* {
	return this.syntax->array_extent();
};

fn TypeSyntax::parameters(const TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_parameters();
};

fn TypeSyntax::result(const TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_result();
};

fn Syntax::qualifier_condition(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::same_tree(const Syntax& this, const Syntax& other) -> bool {
	if (this.kind() != other.kind() || this.token().source != other.token().source || this.token().begin != other.token().begin || this.token().length != other.token().length || this.size() != other.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.size()) {
		if (!this.item(index)->same_tree(*other.item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::take_item(var Syntax& this, usize index) -> rt::unique<Syntax> {
	if (index >= this.children.size()) {
		return rt::unique<Syntax>();
	};

	return rt::unique<Syntax>(@((@this.children).data()[index]).release());
};

fn Syntax::fixed_arity(const Syntax& this) -> usize {
	switch (this.category) {
		case syntax_kind::error_expression:
		case syntax_kind::absent:
		case syntax_kind::noop:
		case syntax_kind::name:
		case syntax_kind::number:
		case syntax_kind::string:
		case syntax_kind::null_pointer:
		case syntax_kind::break_loop:
		case syntax_kind::continue_loop:
		case syntax_kind::access_label:
		case syntax_kind::operator_array:
			return 0;
		case syntax_kind::unary:
		case syntax_kind::grouping:
		case syntax_kind::return_value:
		case syntax_kind::discard_value:
		case syntax_kind::deallocation:
		case syntax_kind::array_deallocation:
		case syntax_kind::sizeof_type:
		case syntax_kind::conversion_name:
		case syntax_kind::type_name:
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_auto:
		case syntax_kind::array:
			return 1;
		case syntax_kind::binary:
		case syntax_kind::call:
		case syntax_kind::member:
		case syntax_kind::index:
		case syntax_kind::while_loop:
		case syntax_kind::switch_expression:
		case syntax_kind::cast:
		case syntax_kind::allocation:
		case syntax_kind::namespace_body:
		case syntax_kind::template_declaration:
		case syntax_kind::using_alias:
		case syntax_kind::enumerator:
		case syntax_kind::type_array:
		case syntax_kind::type_function:
		case syntax_kind::type_const:
		case syntax_kind::type_mutable:
		case syntax_kind::qualified_name:
		case syntax_kind::template_apply:
		case syntax_kind::operator_name:
			return 2;
		case syntax_kind::conditional:
		case syntax_kind::variable:
		case syntax_kind::parameter:
		case syntax_kind::record:
		case syntax_kind::enumeration:
		case syntax_kind::template_parameter:
			return 3;
		case syntax_kind::for_loop:
			return 4;
		case syntax_kind::function:
			return 5;
		case syntax_kind::case_label:
			return 1;
		default:
			return usize::max;
	};
};

fn Syntax::complete(const Syntax& this) -> bool {
	usize arity = this.fixed_arity();

	if (arity != usize::max && this.children.size() != arity) {
		return false;
	};

	if (this.category == syntax_kind::ambiguity && this.children.size() < 2) {
		return false;
	};

	usize index = 0;

	while (index < this.children.size()) {
		if (!this.item(index) || !this.item(index)->complete()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::case_value(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_name(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_value(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_name(const Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_type(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_parameter_default(const Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::operator_target(const Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::operator_token(const Syntax& this) -> Token {
	return this.item(0)->token();
};

fn Syntax::operator_suffix(const Syntax& this) -> var Syntax* {
	return this.item(1);
};
