struct SourceFile {
	fn SourceFile(var SourceFile& this) : [default];

	fn assign(var SourceFile& this, const rt::string_view& path, const rt::string_view& text) -> bool;
	fn append_token(var SourceFile& this, Token token) -> bool;
	fn clear_tokens(var SourceFile& this);

	fn path(const SourceFile& this) -> rt::string_view;
	fn text(const SourceFile& this) -> rt::string_view;
	fn line(const SourceFile& this, usize number) -> rt::string_view;
	fn tokens(const SourceFile& this) -> const rt::buffer<Token>&;
	fn token_count(const SourceFile& this) -> usize;

private:
	rt::string file_path;
	rt::string contents;
	rt::buffer<usize> line_offsets;
	rt::buffer<Token> token_buffer;
};

struct SourceManager {
	fn add(var SourceManager& this, const rt::string_view& path, const rt::string_view& text) -> var SourceFile*;
	fn at(auto SourceManager& this, usize index) -> const[this] SourceFile*;
	fn clear(var SourceManager& this);

	fn count(const SourceManager& this) -> usize;

private:
	rt::buffer<rt::unique<SourceFile>> files;
};

fn SourceFile::assign(var SourceFile& this, const rt::string_view& path, const rt::string_view& text) -> bool {
	rt::string next_path;
	rt::string next_text;
	rt::buffer<usize> next_lines;

	if (!@next_path.append(path) || !@next_text.append(text) || !@next_lines.push_back(0)) {
		return false;
	};

	usize offset = 0;

	while (offset < text.size()) {
		if (text.data()[offset] == '\n' && !@next_lines.push_back(offset + 1)) {
			return false;
		};

		@offset = offset + 1;
	};

	@this.token_buffer.clear();
	@this.file_path = $next_path;
	@this.contents = $next_text;
	@this.line_offsets = $next_lines;

	return true;
};

fn SourceFile::path(const SourceFile& this) -> rt::string_view {
	return this.file_path.view();
};

fn SourceFile::text(const SourceFile& this) -> rt::string_view {
	return this.contents.view();
};

fn SourceFile::line(const SourceFile& this, usize number) -> rt::string_view {
	if (!number || number > this.line_offsets.size()) {
		return rt::string_view();
	};

	usize begin = this.line_offsets.data()[number - 1];
	usize end = this.contents.size();

	if (number < this.line_offsets.size()) {
		@end = this.line_offsets.data()[number] - 1;
	};

	if (end > begin && this.contents.data()[end - 1] == '\r') {
		@end = end - 1;
	};

	return rt::string_view(this.contents.data() + begin, end - begin);
};

fn SourceFile::tokens(const SourceFile& this) -> const rt::buffer<Token>& {
	return this.token_buffer;
};

fn SourceFile::token_count(const SourceFile& this) -> usize {
	return this.token_buffer.size();
};

fn SourceFile::append_token(var SourceFile& this, Token token) -> bool {
	return @this.token_buffer.push_back($token);
};

fn SourceFile::clear_tokens(var SourceFile& this) {
	@this.token_buffer.clear();
};

fn SourceManager::add(var SourceManager& this, const rt::string_view& path, const rt::string_view& text) -> var SourceFile* {
	var file = rt::unique<SourceFile>::make();

	if (!file.get() || !@file.get()->assign(path, text)) {
		return nullptr;
	};

	var SourceFile* result = file.get();

	if (!@this.files.push_back($file)) {
		return nullptr;
	};

	return result;
};

fn SourceManager::count(const SourceManager& this) -> usize {
	return this.files.size();
};

fn SourceManager::at(auto SourceManager& this, usize index) -> const[this] SourceFile* {
	if (index >= this.files.size()) {
		return nullptr;
	};

	return const_cast<const[this] SourceFile*>(this.files.data()[index].get());
};

fn SourceManager::clear(var SourceManager& this) {
	@this.files.clear();
};
