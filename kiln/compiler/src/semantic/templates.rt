enum template_input_kind : [u08] {
	explicit_arguments;
	deduced_arguments;
};

union TemplateInputStorage {
	Syntax* explicit_arguments;
	const rt::buffer<TemplateArgument>* deduced_arguments;
};

struct TemplateInput {
	fn TemplateInput(TemplateInput& this, Syntax& arguments);
	fn TemplateInput(TemplateInput& this, const rt::buffer<TemplateArgument>& arguments, const Token& request);

	template_input_kind kind;
	TemplateInputStorage storage;
	Token request;
};

fn TemplateInput::TemplateInput(TemplateInput& this, Syntax& arguments) {
	@this.kind = template_input_kind::explicit_arguments;
	@this.storage.explicit_arguments = &arguments;
	@this.request = arguments.token();
};

fn TemplateInput::TemplateInput(TemplateInput& this, const rt::buffer<TemplateArgument>& arguments, const Token& request) {
	@this.kind = template_input_kind::deduced_arguments;
	@this.storage.deduced_arguments = &arguments;
	@this.request = request;
};

struct TemplateInstance {
	Entity* pattern;
	Entity* entity;
	rt::buffer<TemplateArgument> arguments;
};

struct TemplateMemberDefinition {
	Entity* owner;
	Syntax* source;
	access_kind access;
};

struct TemplateEngine {
	fn clear(TemplateEngine& this);
	fn collect(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& source) -> bool;
	fn apply(TemplateEngine& this, Analyzer& analyzer, Scope& lookup_scope, Scope& argument_scope, Syntax& source) -> Entity*;
	fn deduce(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const rt::buffer<rt::unique<SemanticExpression>>& values, Syntax& request) -> Entity*;
	fn call_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity*;
	fn specialize_call(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, rt::optional_ref<Syntax> supplied, const rt::buffer<rt::unique<SemanticExpression>>& values, Syntax& request) -> Entity*;

	fn qualifier_dependent(const TemplateEngine& this, Syntax& declaration) -> bool;
	fn qualifier(const TemplateEngine& this, Scope& initial, Syntax& syntax) -> const Type*;
	fn instance(const TemplateEngine& this, Entity& entity) -> TemplateInstance*;

private:
	fn auto_declaration(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Scope& bindings, Syntax& declaration, access_kind access) -> bool;
	fn same_auto_signature(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second) -> bool;
	fn same_type_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool;
	fn pattern_owner(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity*;
	fn argument(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& input, Syntax& parameter, Entity& pattern, usize position, TemplateArgument& result) -> bool;
	fn instantiation_context(const TemplateEngine& this, Analyzer& analyzer, Entity& entity, const Token& request);
	fn argument_context(const TemplateEngine& this, Analyzer& analyzer, Entity& pattern, Syntax& parameter, usize position);
	fn bind(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& parameter, const TemplateArgument& argument) -> bool;
	fn instantiate(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const TemplateInput& input) -> Entity*;
	fn member_definitions(TemplateEngine& this, Analyzer& analyzer, TemplateInstance& instance) -> bool;
	fn match(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& syntax, const TypeUse& actual_use, Syntax& parameters, rt::buffer<TemplateArgument>& arguments) -> bool;

	fn same_parameter_expression(const TemplateEngine& this, const Syntax& first, const Syntax& second, const Syntax& first_parameters, const Syntax& second_parameters) -> bool;
	fn auto_argument(const TemplateEngine& this, Syntax& syntax, const TypeUse& actual) -> const TypeUse*;
	fn has_auto(const TemplateEngine& this, Syntax& syntax) -> bool;
	fn contains(const TemplateEngine& this, Syntax& root, Syntax& syntax) -> bool;
	fn parameter_count(const TemplateEngine& this, Entity& pattern) -> usize;
	fn explicit_count(const TemplateEngine& this, Entity& pattern) -> usize;
	fn function_source(const TemplateEngine& this, Entity& pattern) -> Syntax*;
	fn deduced_pattern(const TemplateEngine& this, Syntax& syntax, Syntax& parameters, usize supplied) -> bool;
	fn qualifications(TemplateEngine& this, Analyzer& analyzer, Syntax& declaration, const rt::buffer<rt::unique<SemanticExpression>>& values, rt::buffer<TemplateArgument>& arguments) -> bool;
	fn parameter_at(const TemplateEngine& this, Entity& pattern, usize index) -> Syntax*;
	fn parameter_name(const TemplateEngine& this, Syntax& parameter) -> Syntax*;
	fn declaration_name(const TemplateEngine& this, Syntax& declaration) -> Syntax*;
	fn unqualified(const TemplateEngine& this, Syntax& initial) -> Syntax*;
	fn argument_syntax(const TemplateEngine& this, Syntax& source, template_argument_kind kind) -> Syntax*;

	rt::buffer<rt::unique<TemplateInstance>> instances;
	rt::buffer<TemplateMemberDefinition> definitions;
};

fn TemplateEngine::clear(TemplateEngine& this) {
	@this.instances.clear();
	@this.definitions.clear();
};

fn TemplateEngine::instance(const TemplateEngine& this, Entity& entity) -> TemplateInstance* {
	usize index = 0;
	while (index < this.instances.size()) {
		TemplateInstance* instance = this.instances.data()[index].get();

		if (instance->entity == &entity) {
			return $instance;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::declaration_name(const TemplateEngine& this, Syntax& declaration) -> Syntax* {
	switch (declaration.kind()) {
		case syntax_kind::function:
			return declaration.function_name();
		case syntax_kind::record:
			return declaration.record_name();
		case syntax_kind::namespace_body:
			return declaration.namespace_name();
		case syntax_kind::using_alias:
			return declaration.alias_name();
		default:
			return nullptr;
	};
};

fn TemplateEngine::unqualified(const TemplateEngine& this, Syntax& initial) -> Syntax* {
	Syntax* name = &initial;
	while (name && name->kind() == syntax_kind::qualified_name) {
		@name = name->right();
	};

	return $name;
};

fn TemplateEngine::pattern_owner(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity* {
	if (name.kind() == syntax_kind::template_apply) {
		return @this.pattern_owner(@analyzer, @scope, @*name.callable());
	};

	if (name.kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name.left());

		if (!owner || !@analyzer.resolve(Entity*(owner))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner) {
			return nullptr;
		};

		return @this.pattern_owner(@analyzer, @*owner->members(), @*name.right());
	};

	return scope.lookup(name.token().text());
};

fn TemplateEngine::collect(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& source) -> bool {
	Syntax* declaration = &source;

	if (source.kind() == syntax_kind::template_declaration) {
		@declaration = source.template_declaration();
	};

	Syntax* name = this.declaration_name(@*declaration);

	if (!name) {
		var message = DiagnosticMessage();
		@message.text("template requires a record, function, namespace, or alias declaration; received construct beginning with \0");
		@message.quoted(declaration->token().text());
		@analyzer.report(declaration->token(), message.view());

		return false;
	};

	if (source.kind() == syntax_kind::template_declaration && declaration->kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name->left());

		if (!owner || owner->kind() != entity_kind::template_pattern) {
			var message = DiagnosticMessage();
			@message.text("template declaration '\0");
			diagnostic_name(@message, *name);
			@message.text("': qualified template member requires a declared owner template\0");
			@analyzer.report(source.token(), message.view());

			return false;
		};

		TemplateMemberDefinition definition;
		@definition.owner = $owner;
		@definition.source = &source;
		@definition.access = scope.access();

		if (!@this.definitions.push_back($definition)) {
			@analyzer.error(&source, "template definition storage is unavailable\0");

			return false;
		};

		return true;
	};

	if (name->kind() != syntax_kind::name) {
		if (source.kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
			Entity* owner = @analyzer.lookup(@scope, @*name->left());
			if (!owner || !@analyzer.resolve(Entity*(owner))) {
				return false;
			};
			@owner = owner->member_owner();
			if (!owner || !owner->members()) {
				var message = DiagnosticMessage();
				@message.text("template declaration '\0");
				diagnostic_name(@message, *name);
				@message.text("': qualified function owner has no member scope\0");
				@analyzer.report(source.token(), message.view());
				return false;
			};
			return @this.auto_declaration(@analyzer, @*owner->members(), @*owner->members(), @source, scope.access());
		};

		var message = DiagnosticMessage();
		@message.text("template declaration '\0");
		diagnostic_name(@message, *name);
		@message.text("': requires an unqualified name\0");
		@analyzer.report(source.token(), message.view());

		return false;
	};
	if (source.kind() == syntax_kind::function) {
		return @this.auto_declaration(@analyzer, @scope, @scope, @source, scope.access());
	};

	Entity* previous = scope.local(name->token().text());

	if (previous && previous->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text("template declaration '\0");
		diagnostic_name(@message, *name);
		@message.text("': name conflicts with another declaration\0");
		@analyzer.report(source.token(), message.view());
		@analyzer.note(previous->token(), "conflicting declaration is here\0");

		return false;
	};

	if (previous && declaration->kind() == syntax_kind::record) {
		Syntax* existing = previous->declaration()->template_declaration();

		if (existing->kind() != syntax_kind::record || previous->declaration()->template_parameters()->size() != source.template_parameters()->size()) {
			var message = DiagnosticMessage();
			@message.text("template redeclaration '\0");
			diagnostic_name(@message, *name);
			@message.text("' has a different parameter list; previous declaration has \0");
			@message.number(previous->declaration()->template_parameters()->size());
			@message.text(" parameters, received \0");
			@message.number(source.template_parameters()->size());
			@analyzer.report(source.token(), message.view());
			@analyzer.note(previous->token(), "previous template declaration is here\0");

			return false;
		};

		if (declaration->record_members()->kind() != syntax_kind::noop) {
			if (existing->record_members()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text("template declaration '\0");
				diagnostic_name(@message, *name);
				@message.text("': duplicate template definition\0");
				@analyzer.report(source.token(), message.view());
				@analyzer.note(previous->token(), "previous template definition is here\0");

				return false;
			};

			@previous->replace_declaration(&source);
		};

		return true;
	};

	Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &source, &scope);

	if (!pattern) {
		@analyzer.error(&source, "template declaration storage is unavailable\0");

		return false;
	};

	@pattern->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::same_parameter_expression(const TemplateEngine& this, const Syntax& first, const Syntax& second, const Syntax& first_parameters, const Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind() || first.size() != second.size()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (!first.size()) {
		usize index = 0;
		while (index < first_parameters.size()) {
			if (first_parameters.item(index)->parameter_name()->token().text() == first.token().text()) {
				return second_parameters.item(index)->parameter_name()->token().text() == second.token().text();
			};
			@index = index + 1;
		};
		return first.token().kind == second.token().kind && first.token().text() == second.token().text();
	};
	if (first.token().kind != second.token().kind) {
		return false;
	};
	usize index = 0;
	while (index < first.size()) {
		if (!this.same_parameter_expression(*first.item(index), *second.item(index), first_parameters, second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn TemplateEngine::same_type_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (first.kind() == syntax_kind::type_auto || first.kind() == syntax_kind::type_pointer || first.kind() == syntax_kind::type_reference || first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_array) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first.designated_type(), @second_scope, @*second.designated_type(), @first_parameters, @second_parameters)) {
			return false;
		};
		if (first.kind() == syntax_kind::type_const) {
			return this.same_parameter_expression(*first.qualifier_condition(), *second.qualifier_condition(), first_parameters, second_parameters);
		};
		if (first.kind() == syntax_kind::type_array) {
			return this.same_parameter_expression(*first.array_extent(), *second.array_extent(), first_parameters, second_parameters);
		};
		return true;
	};
	const Type* first_type = @analyzer.type(@first_scope, @first);
	const Type* second_type = @analyzer.type(@second_scope, @second);
	return first_type && first_type == second_type;
};

fn TemplateEngine::same_auto_signature(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second) -> bool {
	Syntax* first_parameters = first.function_parameters();
	Syntax* second_parameters = second.function_parameters();
	if (first_parameters->size() != second_parameters->size()) {
		return false;
	};
	usize index = 0;
	while (index < first_parameters->size()) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first_parameters->item(index)->parameter_type(), @second_scope, @*second_parameters->item(index)->parameter_type(), @*first_parameters, @*second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return @this.same_type_pattern(@analyzer, @first_scope, @*first.function_result(), @second_scope, @*second.function_result(), @*first_parameters, @*second_parameters);
};

fn TemplateEngine::auto_declaration(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Scope& bindings, Syntax& declaration, access_kind access) -> bool {
	Syntax* name = this.unqualified(@*declaration.function_name());
	usize index = 0;
	while (index < scope.bindings().size()) {
		Entity* previous = scope.bindings().data()[index];
		@index = index + 1;
		if (previous->name() != name->token().text()) {
			continue;
		};
		if (previous->kind() != entity_kind::template_pattern || previous->declaration()->kind() != syntax_kind::function) {
			var message = DiagnosticMessage();
			@message.text("function template '\0");
			diagnostic_name(@message, *name);
			@message.text("': name conflicts with another declaration\0");
			@analyzer.report(declaration.token(), message.view());
			@analyzer.note(previous->token(), "previous declaration is here\0");
			return false;
		};
		if (!@this.same_auto_signature(@analyzer, @*previous->resolution_scope(), @*previous->declaration(), @bindings, @declaration)) {
			continue;
		};
		if (declaration.function_body()->kind() != syntax_kind::noop) {
			if (previous->declaration()->function_body()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text("function template '\0");
				diagnostic_name(@message, *name);
				@message.text("': duplicate function definition\0");
				@analyzer.report(declaration.token(), message.view());
				@analyzer.note(previous->token(), "previous declaration is here\0");
				return false;
			};
			@previous->replace_declaration(&declaration);
			@previous->set_resolution_scope(&bindings);
		};
		return true;
	};
	Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &declaration, &scope);
	if (!pattern) {
		return false;
	};
	@pattern->set_resolution_scope(&bindings);
	@pattern->set_access($access);
	@pattern->set_state(entity_state::ready);
	return true;
};

fn TemplateEngine::argument_syntax(const TemplateEngine& this, Syntax& source, template_argument_kind kind) -> Syntax* {
	if (source.kind() != syntax_kind::ambiguity) {
		return &source;
	};

	usize index = 0;
	while (index < source.size()) {
		Syntax* candidate = source.item(index);
		bool type = candidate->kind() == syntax_kind::type_name || candidate->kind() == syntax_kind::type_pointer || candidate->kind() == syntax_kind::type_reference || candidate->kind() == syntax_kind::type_array || candidate->kind() == syntax_kind::type_const || candidate->kind() == syntax_kind::type_function;

		if ((kind == template_argument_kind::type) == type) {
			return $candidate;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::argument(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& input, Syntax& parameter, Entity& pattern, usize position, TemplateArgument& result) -> bool {
	Syntax* source = &input;
	if (parameter.token().kind == token_kind::kw_typename) {
		@result.kind = template_argument_kind::type;
		@source = this.argument_syntax(@*source, template_argument_kind::type);

		if (!source) {
			var message = DiagnosticMessage();
			@message.text("template argument for type parameter \0");
			@message.quoted(this.parameter_name(@parameter)->token().text());
			@message.text(" of template '\0");
			diagnostic_entity(@message, pattern);
			@message.text("' at position \0");
			@message.number(position + 1);
			@message.text(" must name a type; received '\0");
			diagnostic_name(@message, input);
			@message.text("'\0");
			@analyzer.report(input.token(), message.view());
			@analyzer.note(parameter.token(), "type parameter is declared here\0");

			return false;
		};

		@result.type = @analyzer.type(@scope, @*source);

		if (!result.type) {
			this.argument_context(@analyzer, @pattern, @parameter, usize(position));
			return false;
		};

		const TypeUse* use = @analyzer.semantic_unit()->describe_type(@analyzer, @scope, *source, *result.type);

		if (!use) {
			return false;
		};

		@result.type_use.bind(*use);

		return true;
	};

	@result.kind = template_argument_kind::value;
	@source = this.argument_syntax(@*source, template_argument_kind::value);
	const Type* expected = @analyzer.type(@scope, @*parameter.template_parameter_type());

	if (!source || source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		var message = DiagnosticMessage();
		@message.text("template argument for value parameter \0");
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(" of template '\0");
		diagnostic_entity(@message, pattern);
		@message.text("' at position \0");
		@message.number(position + 1);
		@message.text(" requires a value expression; received '\0");
		diagnostic_name(@message, input);
		@message.text("'\0");
		@analyzer.report(input.token(), message.view());
		@analyzer.note(parameter.token(), "value parameter is declared here\0");
		return false;
	};
	if (!expected) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return false;
	};

	var value = @analyzer.expression(@scope, @*source, rt::optional_ref<const Type>(*expected));

	if (!value.get()) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return false;
	};
	if (!@analyzer.constant_integer(*value.get(), @result.value)) {
		var message = DiagnosticMessage();
		@message.text("template argument for value parameter \0");
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(" of template '\0");
		diagnostic_entity(@message, pattern);
		@message.text("' at position \0");
		@message.number(position + 1);
		@message.text(" must be an integer constant of type '\0");
		diagnostic_type(@message, *expected);
		@message.text("'\0");
		@message.text("; supplied expression '\0");
		diagnostic_name(@message, *source);
		@message.text("' has type '\0");
		diagnostic_type(@message, *value.get()->type());
		@message.text("'\0");
		@analyzer.report(source->token(), message.view());
		@analyzer.note(parameter.token(), "value parameter is declared here\0");

		return false;
	};

	@result.type = $expected;

	return true;
};

fn TemplateEngine::argument_context(const TemplateEngine& this, Analyzer& analyzer, Entity& pattern, Syntax& parameter, usize position) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text("while checking argument \0");
	@message.number(position + 1);
	@message.text(" for parameter \0");
	@message.quoted(this.parameter_name(@parameter)->token().text());
	@message.text(" of template '\0");
	diagnostic_entity(@message, pattern);
	@message.text("'\0");
	@analyzer.note(parameter.token(), message.view());
};

fn TemplateEngine::bind(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& parameter, const TemplateArgument& argument) -> bool {
	Syntax* name = this.parameter_name(@parameter);
	entity_kind kind = entity_kind::type_parameter;

	if (argument.kind == template_argument_kind::value) {
		@kind = entity_kind::enumerator;
	};

	Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), &parameter, &scope);

	if (!entity) {
		@analyzer.error(&parameter, "template parameter binding storage is unavailable\0");

		return false;
	};

	@entity->set_type(argument.type);

	if (argument.type_use.has_value()) {
		@entity->set_type_use(argument.type_use.value());
	};

	@entity->set_integer(u64(argument.value));
	@entity->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::apply(TemplateEngine& this, Analyzer& analyzer, Scope& lookup_scope, Scope& argument_scope, Syntax& source) -> Entity* {
	Entity* pattern = @analyzer.lookup(@lookup_scope, @*source.callable());

	if (pattern && pattern->kind() != entity_kind::template_pattern) {
		TemplateInstance* current = this.instance(@*Entity*(pattern));

		if (current) {
			@pattern = current->pattern;
		};
	};

	if (!pattern || pattern->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text("template arguments for '\0");
		diagnostic_name(@message, *source.callable());
		@message.text("' require a template declaration\0");
		if (pattern) {
			@message.text("; resolved declaration is '\0");
			diagnostic_entity(@message, *pattern);
			@message.text("'\0");
		};
		@analyzer.report(source.token(), message.view());
		if (pattern) {
			@analyzer.note(pattern->token(), "non-template declaration is here\0");
		};

		return nullptr;
	};

	return @this.instantiate(@analyzer, @argument_scope, @*pattern, TemplateInput(@*source.arguments()));
};

fn TemplateEngine::instantiate(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const TemplateInput& input) -> Entity* {
	if (analyzer.cancelled()) {
		return nullptr;
	};
	TemplateDeclarationValidator validator;

	if (!@validator.validate(@analyzer, @pattern)) {
		return nullptr;
	};

	Syntax* wrapper = pattern.declaration();
	usize parameter_count = this.parameter_count(@pattern);

	if (input.kind == template_input_kind::explicit_arguments && input.storage.explicit_arguments->size() > this.explicit_count(@pattern)) {
		var message = DiagnosticMessage();
		@message.text("too many template arguments for '\0");
		diagnostic_entity(@message, pattern);
		@message.text("': expected at most \0");
		@message.number(u64(this.explicit_count(@pattern)));
		@message.text(", received \0");
		@message.number(u64(input.storage.explicit_arguments->size()));
		@analyzer.report(input.storage.explicit_arguments->token(), message.view());
		@analyzer.note(pattern.token(), "template is declared here\0");

		return nullptr;
	};

	Scope* bindings = @analyzer.semantic_unit()->create_scope(pattern.resolution_scope(), pattern.scope()->owner());

	if (!bindings) {
		@analyzer.error(wrapper, "template binding scope storage is unavailable\0");

		return nullptr;
	};

	var instance = rt::unique<TemplateInstance>(new TemplateInstance());

	if (!instance.get()) {
		@analyzer.error(wrapper, "template instance storage is unavailable\0");

		return nullptr;
	};

	@instance.get()->pattern = &pattern;
	usize index = 0;
	while (index < parameter_count) {
		Syntax* parameter = this.parameter_at(@pattern, index);
		TemplateArgument argument;

		if (input.kind == template_input_kind::explicit_arguments && index < input.storage.explicit_arguments->size()) {
			if (!@this.argument(@analyzer, @scope, @*input.storage.explicit_arguments->item(index), @*parameter, @pattern, usize(index), @argument)) {
				return nullptr;
			};
		}
		else if (input.kind == template_input_kind::deduced_arguments && index < input.storage.deduced_arguments->size() && input.storage.deduced_arguments->data()[index].type) {
			@argument := input.storage.deduced_arguments->data()[index];
		}
		else {
			Syntax* fallback = nullptr;

			if (parameter->kind() == syntax_kind::template_parameter) {
				@fallback = parameter->template_parameter_default();
			};

			if (!fallback || fallback->kind() == syntax_kind::absent) {
				var message = DiagnosticMessage();
				@message.text("missing argument for template parameter \0");
				@message.quoted(this.parameter_name(@*parameter)->token().text());
				@message.text(" of '\0");
				diagnostic_entity(@message, pattern);
				@message.text("'; the argument could not be deduced and has no default\0");
				@analyzer.report(input.request, message.view());
				@analyzer.note(parameter->token(), "template parameter is declared here\0");

				return nullptr;
			};

			if (!@this.argument(@analyzer, @*bindings, @*fallback, @*parameter, @pattern, usize(index), @argument)) {
				if (analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text("while evaluating default argument for parameter \0");
					@message.quoted(this.parameter_name(@*parameter)->token().text());
					@message.text(" of template '\0");
					diagnostic_entity(@message, pattern);
					@message.text("'\0");
					@analyzer.note(fallback->token(), message.view());
					@analyzer.note(input.request, "template instantiation is requested here\0");
				};
				return nullptr;
			};
		};

		if (index < this.explicit_count(@pattern) && !@this.bind(@analyzer, @*bindings, @*parameter, argument)) {
			return nullptr;
		};

		if (!@instance.get()->arguments.push_back($argument)) {
			@analyzer.error(wrapper, "template argument storage is unavailable\0");
			return nullptr;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < this.instances.size()) {
		TemplateInstance* existing = this.instances.data()[index].get();
		@index = index + 1;

		if (existing->pattern != &pattern || existing->arguments.size() != instance.get()->arguments.size()) {
			continue;
		};

		usize argument = 0;

		while (argument < existing->arguments.size() && existing->arguments.data()[argument].same(instance.get()->arguments.data()[argument])) {
			@argument = argument + 1;
		};

		if (argument == existing->arguments.size()) {
			return existing->entity;
		};
	};

	Syntax* declaration = wrapper;

	if (wrapper->kind() == syntax_kind::template_declaration) {
		@declaration = wrapper->template_declaration();
	};

	Syntax* name = this.unqualified(@*this.declaration_name(@*declaration));
	entity_kind kind = entity_kind::record;

	if (declaration->kind() == syntax_kind::function) {
		@kind = entity_kind::function;
	}
	else if (declaration->kind() == syntax_kind::namespace_body) {
		@kind = entity_kind::namespace_body;
	}
	else if (declaration->kind() == syntax_kind::using_alias) {
		@kind = entity_kind::alias;
	};

	Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), declaration, bindings);

	if (!entity) {
		@analyzer.error(declaration, "template instance storage is unavailable\0");

		return nullptr;
	};

	@entity->set_access(pattern.access());
	@instance.get()->entity = entity;
	@entity->set_instantiated();
	if (!@analyzer.semantic_unit()->record_origin(@*entity, @pattern, instance.get()->arguments, this.explicit_count(@pattern))) {
		@analyzer.error(declaration, "template navigation storage is unavailable\0");
		return nullptr;
	};
	TemplateInstance* published = instance.get();

	if (!@this.instances.push_back($instance)) {
		@analyzer.error(declaration, "template instance storage is unavailable\0");

		return nullptr;
	};

	// Publish the canonical identity before members can recursively refer to the instance.
	if (entity->kind() == entity_kind::record || entity->kind() == entity_kind::namespace_body) {
		Scope* members = @analyzer.semantic_unit()->create_scope(bindings, Entity*(entity));

		if (!members) {
			@analyzer.error(declaration, "template member scope storage is unavailable\0");
			return nullptr;
		};

		@entity->set_members(Scope*(members));
		Syntax* body = declaration->record_members();

		if (entity->kind() == entity_kind::namespace_body) {
			@body = declaration->namespace_members();
		};

		if (!@analyzer.collect(@*members, @*body) || !@this.member_definitions(@analyzer, @*published)) {
			this.instantiation_context(@analyzer, @*entity, input.request);
			return nullptr;
		};
	};

	if (!@analyzer.resolve(Entity*(entity))) {
		this.instantiation_context(@analyzer, @*entity, input.request);
		return nullptr;
	};

	return $entity;
};

fn TemplateEngine::instantiation_context(const TemplateEngine& this, Analyzer& analyzer, Entity& entity, const Token& request) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text("while instantiating '\0");
	diagnostic_entity(@message, entity);
	@message.text("' requested here\0");
	@analyzer.note(request, message.view());
};

fn TemplateEngine::member_definitions(TemplateEngine& this, Analyzer& analyzer, TemplateInstance& instance) -> bool {
	usize index = 0;
	while (index < this.definitions.size()) {
		TemplateMemberDefinition definition := this.definitions.data()[index];
		@index = index + 1;

		if (definition.owner != instance.pattern) {
			continue;
		};

		Syntax* parameters = definition.source->template_parameters();

		if (parameters->size() != instance.arguments.size()) {
			var message = DiagnosticMessage();
			@message.text("member definition '\0");
			diagnostic_name(@message, *definition.source->template_declaration()->function_name());
			@message.text("' has \0");
			@message.number(parameters->size());
			@message.text(" template parameters; owning template '\0");
			diagnostic_entity(@message, *instance.pattern);
			@message.text("' requires \0");
			@message.number(instance.arguments.size());
			@analyzer.report(definition.source->token(), message.view());
			@analyzer.note(instance.pattern->token(), "owning template is declared here\0");

			return false;
		};

		Scope* bindings = @analyzer.semantic_unit()->create_scope(instance.entity->members(), Entity*(instance.entity));

		if (!bindings) {
			@analyzer.error(definition.source, "template member binding scope storage is unavailable\0");
			return false;
		};

		usize parameter = 0;

		while (parameter < parameters->size()) {
			if (!@this.bind(@analyzer, @*bindings, @*parameters->item(parameter), instance.arguments.data()[parameter])) {
				return false;
			};

			@parameter = parameter + 1;
		};

		Syntax* declaration = definition.source->template_declaration();
		Syntax* name = this.unqualified(@*declaration->function_name());
		entity_kind category = entity_kind::function;

		if (this.qualifier_dependent(@*declaration)) {
			if (!@this.auto_declaration(@analyzer, @*instance.entity->members(), @*bindings, @*declaration, access_kind(definition.access))) {
				return false;
			};
			continue;
		};

		Entity* function = @analyzer.semantic_unit()->create_entity($category, name->token(), declaration, instance.entity->members());

		if (!function) {
			return false;
		};

		@function->set_access(access_kind(definition.access));
		@function->set_resolution_scope($bindings);

		if (function->kind() == entity_kind::template_pattern) {
			@function->set_state(entity_state::ready);
		};
	};

	return true;
};

fn TemplateEngine::match(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& syntax, const TypeUse& actual_use, Syntax& parameters, rt::buffer<TemplateArgument>& arguments) -> bool {
	const Type* actual = &actual_use.type();
	const TypeUse* use = &actual_use;

	if (syntax.kind() == syntax_kind::type_auto) {
		const Type* unqualified = @analyzer.type_store()->qualified(*actual, type_qualifier::mutable);
		@use = @analyzer.semantic_unit()->retype_use(*use, *unqualified);

		return use && @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_name) {
		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_reference || syntax.kind() == syntax_kind::type_const) {
		if (actual->kind() == type_kind::reference) {
			@actual = actual->element();
			@use = &use->element();
		};

		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_pointer) {
		return actual->kind() == type_kind::pointer && @this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_array) {
		if (actual->kind() != type_kind::array || !@this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments)) {
			return false;
		};

		Syntax* extent = syntax.array_extent();
		usize index = 0;
		while (index < parameters.size()) {
			Syntax* parameter = parameters.item(index);

			if (parameter->token().kind != token_kind::kw_typename && parameter->template_parameter_name()->token().text() == extent->token().text()) {
				TemplateArgument* argument = (@arguments).data() + index;
				const Type* type = @analyzer.type(@scope, @*parameter->template_parameter_type());

				if (!type || argument->type && argument->value != actual->count()) {
					return false;
				};

				@argument->kind = template_argument_kind::value;
				@argument->type = $type;
				@argument->value = actual->count();

				return true;
			};

			@index = index + 1;
		};

		u64 expected = 0;

		return @analyzer.integer(@*extent, @expected) && expected == actual->count();
	};

	if (syntax.kind() == syntax_kind::name) {
		usize index = 0;
		while (index < parameters.size()) {
			Syntax* parameter = parameters.item(index);

			if (parameter->token().kind == token_kind::kw_typename && parameter->template_parameter_name()->token().text() == syntax.token().text()) {
				TemplateArgument* argument = (@arguments).data() + index;

				if (argument->type && argument->type != actual) {
					return false;
				};

				@argument->kind = template_argument_kind::type;
				@argument->type = $actual;

				if (!argument->type_use.has_value()) {
					@argument->type_use.bind(*use);
				};

				return true;
			};

			@index = index + 1;
		};
	};

	Syntax* application = &syntax;

	if (syntax.kind() == syntax_kind::qualified_name) {
		@application = syntax.right();
	};

	if (application->kind() == syntax_kind::template_apply && actual->kind() == type_kind::named) {
		TemplateInstance* instance = this.instance(@*actual->entity());
		Entity* pattern = @this.pattern_owner(@analyzer, @scope, @syntax);

		if (!instance || instance->pattern != pattern || application->arguments()->size() > instance->arguments.size()) {
			return false;
		};

		usize index = 0;
		while (index < application->arguments()->size()) {
			const TemplateArgument& argument = instance->arguments.data()[index];
			Syntax* argument_source = this.argument_syntax(@*application->arguments()->item(index), template_argument_kind(argument.kind));

			if (!argument_source) {
				return false;
			};

			if (argument.kind == template_argument_kind::type) {
				const TypeUse* argument_use = argument.type_use.get();

				if (!argument_use) {
					@argument_use = @analyzer.semantic_unit()->canonical_use(*argument.type);
				};

				if (!argument_use || !@this.match(@analyzer, @scope, @*argument_source, *argument_use, @parameters, @arguments)) {
					return false;
				};
			}
			else {
				usize parameter = 0;

				while (parameter < parameters.size()) {
					Syntax* name = parameters.item(parameter)->template_parameter_name();

					if (name->token().text() == argument_source->token().text()) {
						break;
					};

					@parameter = parameter + 1;
				};

				if (parameter < parameters.size()) {
					TemplateArgument* bound = (@arguments).data() + parameter;

					if (bound->type && !bound->same(argument)) {
						return false;
					};

					@*bound := argument;
				}
				else {
					var value = @analyzer.expression(@scope, @*argument_source, rt::optional_ref<const Type>(*argument.type));
					u64 expected = 0;

					if (!value.get() || !@analyzer.constant_integer(*value.get(), @expected) || expected != argument.value) {
						return false;
					};
				};
			};

			@index = index + 1;
		};

		return true;
	};

	const Type* expected = @analyzer.type(@scope, @syntax);

	return expected && expected == actual;
};

fn TemplateEngine::call_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity* {
	Syntax* application = &name;
	Scope* lookup = &scope;

	if (name.kind() == syntax_kind::qualified_name) {
		@application = name.right();
	};

	if (application->kind() != syntax_kind::template_apply) {
		return nullptr;
	};

	if (name.kind() == syntax_kind::qualified_name) {
		Entity* owner = @analyzer.lookup(@scope, @*name.left());

		if (!owner || !@analyzer.resolve(Entity*(owner))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner || !owner->members()) {
			return nullptr;
		};

		@lookup = owner->members();
	};

	Entity* pattern = @analyzer.lookup(@*lookup, @*application->callable());

	if (!pattern || pattern->kind() != entity_kind::template_pattern || !this.function_source(@*pattern)) {
		return nullptr;
	};

	return pattern;
};

fn TemplateEngine::deduced_pattern(const TemplateEngine& this, Syntax& syntax, Syntax& parameters, usize supplied) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		usize index = supplied;
		while (index < parameters.size()) {
			if (parameters.item(index)->template_parameter_name()->token().text() == syntax.token().text()) {
				return true;
			};

			@index = index + 1;
		};
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.deduced_pattern(@*syntax.item(index), @parameters, usize(supplied))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifications(TemplateEngine& this, Analyzer& analyzer, Syntax& declaration, const rt::buffer<rt::unique<SemanticExpression>>& values, rt::buffer<TemplateArgument>& arguments) -> bool {
	usize index = 0;
	while (index < values.size()) {
		Syntax* parameter = declaration.function_parameters()->item(index);
		SemanticExpression* value = values.data()[index].get();
		@index = index + 1;

		if (!this.has_auto(@*parameter->parameter_type())) {
			continue;
		};

		const TypeUse* use = value->type_use().get();

		if (!use) {
			@use = @analyzer.semantic_unit()->canonical_use(*value->type());
		};

		if (!use) {
			return false;
		};

		@use = this.auto_argument(@*parameter->parameter_type(), *use);

		if (!use) {
			return false;
		};

		bool readonly = use->type().qualifier() == type_qualifier::immutable || parameter->parameter_type()->kind() == syntax_kind::type_reference && !value->mutable_access();
		type_qualifier qualifier = type_qualifier::mutable;

		if (readonly) {
			@qualifier = type_qualifier::immutable;
		};

		TemplateArgument argument;
		@argument.kind = template_argument_kind::value;
		@argument.type = @analyzer.type_store()->qualified(*analyzer.type_store()->find_primitive(rt::string_view("bool\0")), $qualifier);
		@argument.value = static_cast<u64>($readonly);

		if (!argument.type || !@arguments.push_back($argument)) {
			return false;
		};
	};

	return true;
};

fn TemplateEngine::deduce(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const rt::buffer<rt::unique<SemanticExpression>>& values, Syntax& request) -> Entity* {
	return @this.specialize_call(@analyzer, @scope, @pattern, rt::optional_ref<Syntax>(), values, @request);
};

fn TemplateEngine::specialize_call(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, rt::optional_ref<Syntax> supplied, const rt::buffer<rt::unique<SemanticExpression>>& values, Syntax& request) -> Entity* {
	Syntax* declaration = this.function_source(@pattern);

	if (!declaration || declaration->function_parameters()->size() != values.size()) {
		var message = DiagnosticMessage();
		@message.text("function template '\0");
		diagnostic_entity(@message, pattern);
		if (declaration) {
			@message.text("' expects \0");
			@message.number(u64(declaration->function_parameters()->size()));
			@message.text(" call arguments, received \0");
			@message.number(u64(values.size()));
			@message.text(" with types \0");
			diagnostic_arguments(@message, values);
		}
		else {
			@message.text("' does not declare a callable function\0");
		};
		@analyzer.report(request.token(), message.view());
		@analyzer.note(pattern.token(), "template is declared here\0");
		return nullptr;
	};

	usize visible = this.explicit_count(@pattern);
	usize provided = 0;

	if (supplied.has_value()) {
		@provided = supplied.value().size();
	};

	if (provided > visible) {
		var message = DiagnosticMessage();
		@message.text("too many template arguments for '\0");
		diagnostic_entity(@message, pattern);
		@message.text("': expected at most \0");
		@message.number(u64(visible));
		@message.text(", received \0");
		@message.number(u64(provided));
		@analyzer.report(request.token(), message.view());
		@analyzer.note(pattern.token(), "template is declared here\0");
		return nullptr;
	};

	rt::buffer<TemplateArgument> arguments;
	usize index = 0;
	while (index < visible) {
		TemplateArgument argument;

		if (index < provided && !@this.argument(@analyzer, @scope, @*supplied.value().item(index), @*this.parameter_at(@pattern, index), @pattern, usize(index), @argument)) {
			return nullptr;
		};

		if (!@arguments.push_back($argument)) {
			@analyzer.error(&request, "template deduction argument storage is unavailable\0");
			return nullptr;
		};

		@index = index + 1;
	};

	if (visible) {
		Syntax* parameters = pattern.declaration()->template_parameters();
		@index = 0;

		while (index < values.size()) {
			Syntax* parameter = declaration->function_parameters()->item(index)->parameter_type();
			SemanticExpression* value = values.data()[index].get();
			@index = index + 1;

			if (!this.deduced_pattern(@*parameter, @*parameters, usize(provided))) {
				continue;
			};

			const TypeUse* use = value->type_use().get();

			if (!use) {
				@use = @analyzer.semantic_unit()->canonical_use(*value->type());
			};

			if (!use || !@this.match(@analyzer, @*pattern.scope(), @*parameter, *use, @*parameters, @arguments)) {
				if (!analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text("cannot deduce template arguments for '\0");
					diagnostic_entity(@message, pattern);
					@message.text("' with arguments \0");
					diagnostic_arguments(@message, values);
					@message.text(": call argument \0");
					@message.number(u64(index));
					@message.text(" of type '\0");
					diagnostic_type(@message, *value->type());
					@message.text("' does not match parameter \0");
					@message.number(u64(index));
					Syntax* parameter_name = declaration->function_parameters()->item(index - 1)->parameter_name();
					if (parameter_name && parameter_name->kind() != syntax_kind::absent) {
						@message.text(" \0");
						@message.quoted(parameter_name->token().text());
					};
					@analyzer.report(request.token(), message.view());
					@analyzer.note(pattern.token(), "function template is declared here\0");
					@analyzer.note(parameter->token(), "deduction failed for this parameter type\0");
					usize binding = 0;
					while (binding < visible && binding < arguments.size()) {
						const TemplateArgument& bound = arguments.data()[binding];
						Syntax* bound_parameter = this.parameter_at(@pattern, binding);
						@binding = binding + 1;
						if (!bound.type) {
							continue;
						};
						var binding_message = DiagnosticMessage();
						@binding_message.text("template parameter \0");
						@binding_message.quoted(this.parameter_name(@*bound_parameter)->token().text());
						if (bound.kind == template_argument_kind::type) {
							@binding_message.text(" is bound to type '\0");
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text("'\0");
						}
						else {
							@binding_message.text(" is bound to value \0");
							if (bound.type->kind() == type_kind::signed_integer && bound.type->signed_value(bound.value) < 0) {
								@binding_message.text("-\0");
								@binding_message.number(u64(0) - u64(bound.type->signed_value(bound.value)));
							}
							else {
								@binding_message.number(bound.value);
							};
							@binding_message.text(" of type '\0");
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text("'\0");
						};
						@analyzer.note(bound_parameter->token(), binding_message.view());
					};
				};
				return nullptr;
			};
		};
	};

	if (!@this.qualifications(@analyzer, @*declaration, values, @arguments)) {
		if (!analyzer.failed()) {
			var message = DiagnosticMessage();
			@message.text("cannot deduce automatic qualification for function template '\0");
			diagnostic_entity(@message, pattern);
			@message.text("' with argument types \0");
			diagnostic_arguments(@message, values);
			@analyzer.report(request.token(), message.view());
			@analyzer.note(pattern.token(), "function template is declared here\0");
		};
		return nullptr;
	};

	return @this.instantiate(@analyzer, @scope, @pattern, TemplateInput(arguments, request.token()));
};

fn TemplateEngine::has_auto(const TemplateEngine& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_auto) {
		return true;
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.has_auto(@*syntax.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::contains(const TemplateEngine& this, Syntax& root, Syntax& syntax) -> bool {
	if (&root == &syntax) {
		return true;
	};

	usize index = 0;
	while (index < root.size()) {
		if (this.contains(@*root.item(index), @syntax)) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifier_dependent(const TemplateEngine& this, Syntax& declaration) -> bool {
	return declaration.kind() == syntax_kind::function && this.has_auto(@*declaration.function_parameters());
};

fn TemplateEngine::function_source(const TemplateEngine& this, Entity& pattern) -> Syntax* {
	Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};

	if (source->kind() != syntax_kind::function) {
		return nullptr;
	};

	return source;
};

fn TemplateEngine::explicit_count(const TemplateEngine& this, Entity& pattern) -> usize {
	Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		return source->template_parameters()->size();
	};

	return 0;
};

fn TemplateEngine::parameter_count(const TemplateEngine& this, Entity& pattern) -> usize {
	usize count = this.explicit_count(@pattern);
	Syntax* source = this.function_source(@pattern);

	if (!source) {
		return $count;
	};

	usize index = 0;
	while (index < source->function_parameters()->size()) {
		if (this.has_auto(@*source->function_parameters()->item(index)->parameter_type())) {
			@count = count + 1;
		};

		@index = index + 1;
	};

	return $count;
};

fn TemplateEngine::parameter_at(const TemplateEngine& this, Entity& pattern, usize position) -> Syntax* {
	usize visible = this.explicit_count(@pattern);

	if (position < visible) {
		return pattern.declaration()->template_parameters()->item(position);
	};

	Syntax* source = this.function_source(@pattern);

	if (!source) {
		return nullptr;
	};

	usize index = 0;
	usize parameter = visible;
	while (index < source->function_parameters()->size()) {
		Syntax* candidate = source->function_parameters()->item(index);
		@index = index + 1;

		if (!this.has_auto(@*candidate->parameter_type())) {
			continue;
		};

		if (parameter == position) {
			return $candidate;
		};

		@parameter = parameter + 1;
	};

	return nullptr;
};

fn TemplateEngine::parameter_name(const TemplateEngine& this, Syntax& parameter) -> Syntax* {
	if (parameter.kind() == syntax_kind::parameter) {
		return parameter.parameter_name();
	};

	return parameter.template_parameter_name();
};

fn TemplateEngine::qualifier(const TemplateEngine& this, Scope& initial, Syntax& syntax) -> const Type* {
	Scope* scope = &initial;
	while (scope) {
		Entity* owner = scope->owner();
		TemplateInstance* instance = nullptr;

		if (owner) {
			@instance = this.instance(@*owner);
		};

		if (instance && owner->declaration()->kind() == syntax_kind::function && this.function_source(@*instance->pattern)) {
			usize index = this.explicit_count(@*instance->pattern);
			while (index < instance->arguments.size()) {
				Syntax* parameter = this.parameter_at(@*instance->pattern, index);

				if (this.contains(@*parameter->parameter_type(), @syntax)) {
					return instance->arguments.data()[index].type;
				};

				@index = index + 1;
			};
		};

		@scope = scope->parent();
	};

	return nullptr;
};

fn TemplateEngine::auto_argument(const TemplateEngine& this, Syntax& syntax, const TypeUse& actual) -> const TypeUse* {
	if (syntax.kind() == syntax_kind::type_auto) {
		return &actual;
	};

	if (syntax.kind() == syntax_kind::type_reference) {
		if (actual.type().kind() == type_kind::reference) {
			return this.auto_argument(@*syntax.designated_type(), actual.element());
		};

		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	if (syntax.kind() == syntax_kind::type_pointer && actual.type().kind() == type_kind::pointer || syntax.kind() == syntax_kind::type_array && actual.type().kind() == type_kind::array) {
		return this.auto_argument(@*syntax.designated_type(), actual.element());
	};

	if (syntax.kind() == syntax_kind::type_const) {
		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	return nullptr;
};

fn TemplateArgument::same(const TemplateArgument& this, const TemplateArgument& other) -> bool {
	return this.kind == other.kind && this.type == other.type && (this.kind == template_argument_kind::type || this.value == other.value);
};
