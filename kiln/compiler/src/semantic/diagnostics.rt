fn diagnostic_entity_kind(DiagnosticMessage& message, entity_kind kind) {
	switch (kind) {
		case entity_kind::function: {
			@message.text("function\0");
			break;
		};
		case entity_kind::global: {
			@message.text("global variable\0");
			break;
		};
		case entity_kind::local: {
			@message.text("local variable\0");
			break;
		};
		case entity_kind::parameter: {
			@message.text("parameter\0");
			break;
		};
		case entity_kind::record: {
			@message.text("record\0");
			break;
		};
		case entity_kind::field: {
			@message.text("field\0");
			break;
		};
		case entity_kind::enumeration: {
			@message.text("enumeration\0");
			break;
		};
		case entity_kind::enumerator: {
			@message.text("enumerator\0");
			break;
		};
		case entity_kind::namespace_body: {
			@message.text("namespace\0");
			break;
		};
		case entity_kind::alias: {
			@message.text("type alias\0");
			break;
		};
		case entity_kind::type_parameter: {
			@message.text("type parameter\0");
			break;
		};
		case entity_kind::template_pattern: {
			@message.text("template\0");
			break;
		};
		case entity_kind::primitive_type: {
			@message.text("primitive type\0");
			break;
		};
		case entity_kind::constant: {
			@message.text("constant\0");
			break;
		};
	};
};

fn diagnostic_entity(DiagnosticMessage& message, const Entity& entity) {
	Scope* scope = entity.scope();
	if (scope && scope->owner() && scope->owner() != &entity) {
		diagnostic_entity(@message, *scope->owner());
		@message.text("::\0");
	};
	@message.text(entity.name());
	const TemplateInstantiation* instance = entity.template_arguments();
	if (instance && instance->source_argument_count) {
		@message.text("<\0");
		usize index = 0;
		while (index < instance->source_argument_count) {
			if (index) {
				@message.text(", \0");
			};
			const TemplateArgument& argument = instance->arguments.data()[index];
			if (argument.kind == template_argument_kind::type) {
				diagnostic_type(@message, *argument.type);
			}
			else {
				if (argument.type && argument.type->kind() == type_kind::signed_integer && argument.type->signed_value(argument.value) < 0) {
					@message.text("-\0");
					@message.number(u64(0) - u64(argument.type->signed_value(argument.value)));
				}
				else {
					@message.number(argument.value);
				};
			};
			@index = index + 1;
		};
		@message.text(">\0");
	};
};

fn diagnostic_name(DiagnosticMessage& message, const Syntax& syntax) {
	if (syntax.kind() == syntax_kind::qualified_name) {
		diagnostic_name(@message, *syntax.left());
		@message.text("::\0");
		diagnostic_name(@message, *syntax.right());
		return;
	};
	if (syntax.kind() == syntax_kind::type_name) {
		diagnostic_name(@message, *syntax.designated_type());
		return;
	};
	if (syntax.kind() == syntax_kind::template_apply) {
		diagnostic_name(@message, *syntax.callable());
		@message.text("<\0");
		usize index = 0;
		while (index < syntax.arguments()->size()) {
			if (index) {
				@message.text(", \0");
			};
			diagnostic_name(@message, *syntax.arguments()->item(index));
			@index = index + 1;
		};
		@message.text(">\0");
		return;
	};
	@message.text(syntax.token().text());
};

fn diagnostic_type(DiagnosticMessage& message, const Type& type) {
	if (type.qualifier() == type_qualifier::immutable) {
		@message.text("const \0");
	};

	switch (type.kind()) {
		case type_kind::void_type: @message.text("void\0"); break;
		case type_kind::null_type: @message.text("null\0"); break;
		case type_kind::boolean: @message.text("bool\0"); break;
		case type_kind::character: @message.text("char\0"); break;
		case type_kind::signed_integer:
			@message.text("i\0");
			@message.number(u64(type.bits()));
			break;
		case type_kind::unsigned_integer:
			@message.text("u\0");
			@message.number(u64(type.bits()));
			break;
		case type_kind::floating_point:
			@message.text("f\0");
			@message.number(u64(type.bits()));
			break;
		case type_kind::named:
		case type_kind::parameter:
			diagnostic_entity(@message, *type.entity());
			break;
		case type_kind::pointer:
		case type_kind::reference:
			diagnostic_type(@message, *type.element());
			if (type.kind() == type_kind::pointer) {
				@message.text("*\0");
			}
			else {
				@message.text("&\0");
			};
			break;
		case type_kind::array:
			diagnostic_type(@message, *type.element());
			@message.text("[\0");
			@message.number(type.count());
			@message.text("]\0");
			break;
		case type_kind::function: {
			@message.text("(\0");
			const FunctionSignature& signature = type.signature();
			usize index = 0;
			while (index < signature.parameters().size()) {
				if (index) {
					@message.text(", \0");
				};
				diagnostic_type(@message, *signature.parameters().data()[index]);
				@index = index + 1;
			};
			if (signature.arity() == parameter_arity::variadic) {
				if (index) {
					@message.text(", \0");
				};
				@message.text("...\0");
			};
			@message.text(") -> \0");
			diagnostic_type(@message, *signature.result());
			break;
		};
	};
};

fn Analyzer::cancelled(const Analyzer& this) -> bool {
	return this.diagnostics->cancelled();
};

fn Analyzer::failed(const Analyzer& this) -> bool {
	return this.diagnostics->failed();
};

fn Analyzer::report(Analyzer& this, const Token& token, const rt::string_view& message) {
	@this.diagnostics->error(token, message);
};

fn Analyzer::note(Analyzer& this, const Token& token, const rt::string_view& message) {
	@this.diagnostics->note(token, message);
};

fn Analyzer::deleted_function(Analyzer& this, const Token& token, const Entity& function) {
	var message = DiagnosticMessage();
	@message.text("selected function '\0");
	diagnostic_entity(@message, function);
	@message.text("' of type '\0");
	diagnostic_type(@message, *function.type());
	@message.text("' is deleted\0");
	@this.report(token, message.view());
	@this.note(function.token(), "function is declared deleted here\0");
};

fn diagnostic_arguments(DiagnosticMessage& message, const rt::buffer<rt::unique<SemanticExpression>>& arguments) {
	@message.text("(\0");
	usize index = 0;
	while (index < arguments.size()) {
		if (index) {
			@message.text(", \0");
		};
		const SemanticExpression& argument = *arguments.data()[index].get();
		if (argument.kind() == semantic_kind::deferred_argument) {
			@message.text("brace expression\0");
		}
		else {
			diagnostic_type(@message, *argument.type());
		};
		@index = index + 1;
	};
	@message.text(")\0");
};

fn diagnostic_candidate(Diagnostics& diagnostics, const Entity& candidate) {
	var detail = DiagnosticMessage();
	@detail.text("candidate '\0");
	diagnostic_entity(@detail, candidate);
	@detail.text("' has type '\0");
	diagnostic_type(@detail, *candidate.type());
	@detail.text("'\0");
	@diagnostics.note(candidate.token(), detail.view());
};

fn diagnostic_conversion_ambiguity(Diagnostics& diagnostics, const Token& token, const Type& source, const Type& target, const ConversionSelection& selection) {
	var message = DiagnosticMessage();
	@message.text("ambiguous implicit conversion from '\0");
	diagnostic_type(@message, source);
	@message.text("' to '\0");
	diagnostic_type(@message, target);
	@message.text("'; multiple conversion functions are applicable\0");
	@diagnostics.error(token, message.view());
	diagnostic_candidate(@diagnostics, *selection.selected);
	diagnostic_candidate(@diagnostics, *selection.conflict);
};

fn diagnostic_candidates(Diagnostics& diagnostics, const Entity& group) {
	const rt::buffer<Entity*>& candidates = group.scope()->bindings();
	usize index = 0;
	while (index < candidates.size()) {
		const Entity& candidate = *candidates.data()[index];
		@index = index + 1;
		if (candidate.kind() != entity_kind::function || candidate.name() != group.name() || !candidate.type()) {
			continue;
		};

		diagnostic_candidate(@diagnostics, candidate);
	};
};

fn Analyzer::infer_variable(Analyzer& this, Syntax& declaration, const SemanticExpression& initializer) -> const Type* {
	const Type* type = initializer.type();
	if (
		type
		&& type->kind().is_numeric()
		&& type->kind() != type_kind::boolean
		&& type->kind() != type_kind::character
		&& numeric_literal_expression(initializer)
	) {
		var message = DiagnosticMessage();
		@message.text("cannot infer the type of variable \0");
		@message.quoted(declaration.variable_name()->token().text());
		@message.text(" from an untyped numeric literal; specify a variable type or construct a typed value\0");
		@this.diagnostics->error(declaration.variable_name()->token(), message.view());
		return nullptr;
	};
	return $type;
};
