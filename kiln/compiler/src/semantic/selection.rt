fn Analyzer::select(var Analyzer& this, var Entity* group, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	rt::buffer<var Entity*> candidates;
	const rt::buffer<var Entity*>& bindings = group->scope()->bindings();
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];

		if (candidate->kind() == entity_kind::function && candidate->name() == group->name()) {
			if (!@candidates.push_back((var Entity*(candidate)))) {
				@this.error(&@syntax, "out of memory collecting function candidates\0");

				return nullptr;
			};
		};

		@index = index + 1;
	};

	return @this.select_candidates(candidates, arguments, $skipped, $mode, @syntax);
};

fn Analyzer::select_candidates(var Analyzer& this, const rt::buffer<var Entity*>& bindings, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	var Entity* selected = nullptr;
	i32 best = i32::max;
	i32 best_origin = 2;
	rt::buffer<var Entity*> best_matches;
	rt::buffer<var Entity*> seen;
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return nullptr;
		};

		@candidate = candidate->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != candidate) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, "out of memory ranking overload candidates\0");

			return nullptr;
		};

		if (mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (candidate->parameters().size() < skipped) {
			continue;
		};

		usize fixed = candidate->parameters().size() - skipped;
		bool variadic = candidate->type()->signature().arity() == parameter_arity::variadic;

		if (arguments.size() < fixed || !variadic && arguments.size() != fixed) {
			continue;
		};

		i32 rank = 0;

		if (variadic) {
			@rank = 16;
		};

		usize argument = 0;

		while (argument < fixed) {
			i32 component = @this.argument_rank(*arguments.data()[argument].get(), *candidate->parameters().data()[argument + skipped]->type());

			if (component < 0) {
				@rank = -1;
				break;
			};

			@rank = rank + component;
			@argument = argument + 1;
		};

		i32 origin = 0;

		if (candidate->origin() == declaration_origin::compiler_supplied) {
			@origin = 1;
		};

		if (rank < 0 || rank > best || rank == best && origin > best_origin) {
			continue;
		};

		if (rank != best || origin != best_origin) {
			@best_matches.clear();
		};
		if (!@best_matches.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, "out of memory retaining equally ranked overload candidates\0");
			return nullptr;
		};
		if (rank == best && origin == best_origin) {
			continue;
		};

		@best_origin = origin;
		@best := rank;
		@selected := candidate;
	};

	if (best_matches.size() > 1) {
		var message = DiagnosticMessage();
		@message.text("ambiguous call to '\0");
		diagnostic_entity(@message, *selected);
		@message.text("' with arguments \0");
		diagnostic_arguments(@message, arguments);
		@this.diagnostics->error(syntax.token(), message.view());
		usize candidate_index = 0;
		while (candidate_index < best_matches.size()) {
			var Entity* candidate = best_matches.data()[candidate_index];
			@candidate_index = candidate_index + 1;
			var detail = DiagnosticMessage();
			@detail.text("equally ranked candidate '\0");
			diagnostic_entity(@detail, *candidate);
			@detail.text("' has type '\0");
			diagnostic_type(@detail, *candidate->type());
			@detail.text("'\0");
			@this.diagnostics->note(candidate->token(), detail.view());
		};

		return nullptr;
	};

	return $selected;
};

fn Analyzer::overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	rt::buffer<var Entity*> candidates;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		var Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function && candidate->kind() != entity_kind::template_pattern) {
			continue;
		};

		if (candidate->state() == entity_state::ready && candidate->kind() == entity_kind::function) {
			if (candidate->operator_kind() != syntax.token().kind) {
				continue;
			};
		}
		else {
			var Syntax* declaration = candidate->declaration();

			if (!declaration) {
				continue;
			};

			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};

			if (declaration->kind() != syntax_kind::function) {
				continue;
			};

			var Syntax* name = declaration->function_name();

			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};

			if (name->kind() != syntax_kind::operator_name || name->operator_token().kind != syntax.token().kind) {
				continue;
			};
		};

		bool visible = false;
		var Scope* enclosing = &@scope;

		while (enclosing) {
			if (candidate->scope() == enclosing) {
				@visible = true;
			};

			@enclosing = enclosing->parent();
		};

		usize argument = 0;

		while (argument < arguments.size()) {
			const Type* type = arguments.data()[argument].get()->type();

			if (type->kind() == type_kind::named) {
				var Entity* owner = type->entity();

				if (candidate->scope() == owner->members() || candidate->scope() == owner->scope()) {
					@visible = true;
				};
			};

			@argument = argument + 1;
		};

		if (!visible) {
			continue;
		};

		if (candidate->kind() == entity_kind::template_pattern) {
			@candidate = @this.templates.deduce(@this, @scope, @*candidate, arguments, @syntax);

			if (!candidate) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!@candidates.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, "out of memory collecting operator candidates\0");

			return rt::unique<SemanticExpression>();
		};
	};

	var Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @syntax);

	if (!selected) {
		if (!this.diagnostics->failed()) {
			var message = DiagnosticMessage();
			@message.text("no applicable operator \0");
			@message.quoted(syntax.token().text());
			@message.text(" for operands \0");
			diagnostic_arguments(@message, arguments);
			@this.diagnostics->error(syntax.token(), message.view());
			usize candidate_index = 0;
			while (candidate_index < candidates.size()) {
				var Entity* candidate = candidates.data()[candidate_index];
				@candidate_index = candidate_index + 1;
				if (!candidate->type()) {
					continue;
				};
				var detail = DiagnosticMessage();
				@detail.text("candidate '\0");
				diagnostic_entity(@detail, *candidate);
				@detail.text("' has type '\0");
				diagnostic_type(@detail, *candidate->type());
				@detail.text("'\0");
				@this.diagnostics->note(candidate->token(), detail.view());
			};
		};
		return rt::unique<SemanticExpression>();
	};

	if (selected->definition() == function_definition::deleted) {
		@this.deleted_function(syntax.token(), *selected);
		return rt::unique<SemanticExpression>();
	};
	if (!this.accessible(*selected, @scope)) {
		var message = DiagnosticMessage();
		@message.text("selected operator '\0");
		diagnostic_entity(@message, *selected);
		@message.text("' of type '\0");
		diagnostic_type(@message, *selected->type());
		@message.text("' is not accessible from this scope\0");
		@this.diagnostics->error(syntax.token(), message.view());
		@this.diagnostics->note(selected->token(), "operator is declared here\0");
		return rt::unique<SemanticExpression>();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), &@syntax);

	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	@callable.get()->bind((var Entity*(selected)), value_category::place);

	return @this.invoke(@syntax, selected, $callable, $arguments, expected);
};
