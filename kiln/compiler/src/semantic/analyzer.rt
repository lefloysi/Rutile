fn strtod(char* text, var char var** end) -> f64;

struct SwitchAnalysis;

struct ConversionSelection {
	var Entity* selected;
	var Entity* conflict;

	fn unique(ConversionSelection& this) -> var Entity*;
};

struct Analyzer {
	fn Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits);

	fn set_editor(var Analyzer& this, bool enabled);
	fn analyze(var Analyzer& this, rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit>;
	fn editor_template_context(var Analyzer& this, var SemanticUnit& unit, var SourceFile& source, usize anchor, var Syntax& arguments, var rt::string& label) -> bool;
	fn analyze_into(var Analyzer& this, var SemanticUnit& unit, rt::buffer<rt::unique<Syntax>>& syntax) -> bool;
	fn error(var Analyzer& this, var Syntax* syntax, rt::string_view& message);
	fn report(var Analyzer& this, Token& token, rt::string_view& message);
	fn note(var Analyzer& this, Token& token, rt::string_view& message);
	fn deleted_function(var Analyzer& this, Token& token, Entity& function);
	fn cancelled(Analyzer& this) -> bool;
	fn failed(Analyzer& this) -> bool;
	fn infer_variable(var Analyzer& this, var Syntax& declaration, SemanticExpression& initializer) -> Type*;
	fn type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type*;
	fn lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity*;
	fn primitive_scope(var Analyzer& this, Type& type, Token& location) -> var Entity*;
	fn primitive_constants(var Analyzer& this, var Entity& owner) -> bool;
	fn collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn resolve(var Analyzer& this, var Entity* entity) -> bool;
	fn integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> bool;
	fn expression(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn function_body(var Analyzer& this, var Entity* entity) -> bool;
	fn global_initializer(var Analyzer& this, var Entity& entity) -> bool;
	fn constant_integer(var Analyzer& this, SemanticExpression& expression, var u64& result) -> bool;
	fn validate_dispatch_syntax(var Analyzer& this, var Syntax& syntax, bool class_scope) -> bool;

	fn semantic_unit(Analyzer& this) -> var SemanticUnit*;
	fn type_store(Analyzer& this) -> var TypeStore*;
	fn accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool;

private:
	bool editor;
	fn resolve_impl(var Analyzer& this, var Entity* entity) -> bool;
	fn recovery_operand(Analyzer& this, Syntax& syntax) -> bool;
	fn expression_impl(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn names_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn size_query(var Analyzer& this, var Syntax& syntax, Type& type) -> rt::unique<SemanticExpression>;
	fn selection(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn label(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn prepare_expression(var Analyzer& this, var SemanticExpression* expression) -> bool;
	fn prepare_lifetime(var Analyzer& this, Type* type) -> bool;
	fn prepare_default(var Analyzer& this, Type* type) -> bool;
	fn prepare_copy(var Analyzer& this, Type* type) -> bool;
	fn prepare_copy_assignment(var Analyzer& this, Type* type) -> bool;
	fn field_initializer(var Analyzer& this, var Entity* entity) -> bool;
	fn resolve_bases(var Analyzer& this, var Entity* entity) -> bool;
	fn build_dispatch(var Analyzer& this, var Entity* entity) -> bool;
	fn supply_special_functions(var Analyzer& this, var Entity* entity) -> bool;
	fn contextual_argument(var Analyzer& this, var Scope& scope, var Syntax& syntax, TypeUse& use, rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression>;
	fn contextual_arguments(var Analyzer& this, var Scope& scope, var Syntax& syntax, var SemanticExpression& callable, var rt::buffer<rt::unique<SemanticExpression>>& values) -> bool;
	fn supply_special(var Analyzer& this, var Entity* entity, function_role role, token_kind operation, Type* source, function_definition definition) -> var Entity*;
	fn node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression>;
	fn unary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn binary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn call(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression>;
	fn cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn component(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn member_value(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> object, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn construct(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* type, var Syntax& arguments) -> rt::unique<SemanticExpression>;
	fn construct_values(var Analyzer& this, var Syntax& syntax, Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression>;
	fn initialize(var Analyzer& this, var Syntax& syntax, Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression>;
	fn select_candidates(var Analyzer& this, rt::buffer<var Entity*>& candidates, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn invoke(var Analyzer& this, var Syntax& syntax, var Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn select(var Analyzer& this, var Entity* group, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn convert(var Analyzer& this, rt::unique<SemanticExpression> value, rt::optional_ref<const Type>& expected, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn argument_rank(var Analyzer& this, SemanticExpression& value, Type& expected) -> i32;
	fn implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> var Entity*;
	fn select_implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> ConversionSelection;
	fn conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> var Entity*;
	fn select_conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> ConversionSelection;

	fn compatible(Analyzer& this, Type* source, Type* target) -> bool;
	fn builtin_rank(Analyzer& this, SemanticExpression& value, Type& expected) -> i32;

	var TypeStore* types;
	var Diagnostics* diagnostics;
	var SemanticUnit* unit;
	var Entity* function;
	u32 pointer_bits;
	usize loop_depth;
	var SwitchAnalysis* active_switch;
	TemplateEngine templates;
};

fn Analyzer::error(var Analyzer& this, var Syntax* syntax, rt::string_view& message) {
	Token token;

	if (syntax) {
		@token = syntax->token();
	};

	@this.diagnostics->error(token, message);
};

fn Analyzer::node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression> {
	Token location;

	if (syntax) {
		@location = syntax->token();
	};

	var result = rt::unique<SemanticExpression>(new var SemanticExpression($kind, type, location));

	if (!result.get()) {
		@this.error(syntax, rt::string_view("out of memory during semantic analysis", 38));
	};

	return $result;
};


fn Analyzer::lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@scope, @*name.left());

		if (!owner || !@this.resolve((var Entity*(owner)))) {
			return nullptr;
		};

		var Entity* associated = owner->member_owner();

		if (!associated && owner->denotes_type() && owner->type()) {
			@associated = @this.primitive_scope(*owner->type(), owner->token());
		};

		@owner := associated;

		if (!owner) {
			return nullptr;
		};

		if (!@this.unit->record_receiver(@scope, @name, @*owner)) {
			return nullptr;
		};

		var Syntax* member = name.right();

		if (member->kind() == syntax_kind::template_apply) {
			if (!owner->members()->local(member->callable()->token().text())) {
				return nullptr;
			};

			return @this.templates.apply(@this, @*owner->members(), @scope, @*member);
		};

		return owner->find_member(member->token().text());
	};

	if (name.kind() == syntax_kind::template_apply) {
		return @this.templates.apply(@this, @scope, @scope, @name);
	};

	var Entity* result = scope.lookup(name.token().text());

	if (result) {
		return result;
	};

	Type* primitive = this.types->find_primitive(name.token().text());

	if (!primitive) {
		return nullptr;
	};

	return @this.primitive_scope(*primitive, name.token());
};

fn Analyzer::integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> bool {
	if (syntax.kind() != syntax_kind::number) {
		return false;
	};

	var text = syntax.token().text();
	u64 value = 0;
	u64 base = 10;
	usize index = 0;

	if (text.size() > 2 && text.data()[0] == '0') {
		if (text.data()[1] == 'x' || text.data()[1] == 'X') {
			@base = 16;
			@index = 2;
		}
		else if (text.data()[1] == 'b' || text.data()[1] == 'B') {
			@base = 2;
			@index = 2;
		};
	};

	while (index < text.size()) {
		char character := text.data()[index];
		@index = index + 1;

		if (character == '_') {
			continue;
		};

		u64 digit = 0;

		if (character >= '0' && character <= '9') {
			@digit = static_cast<u64>(character - '0');
		}
		else if (character >= 'a' && character <= 'f') {
			@digit = static_cast<u64>(character - 'a') + 10;
		}
		else if (character >= 'A' && character <= 'F') {
			@digit = static_cast<u64>(character - 'A') + 10;
		}
		else {
			return false;
		};

		if (digit >= base || value > (u64::max - digit) / base) {
			return false;
		};

		@value = value * base + digit;
	};

	@result = $value;

	return true;
};

fn Analyzer::type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type* {
	if (syntax.kind() == syntax_kind::absent) {
		return nullptr;
	};

	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_auto) {
		Type* element = @this.type(@scope, @*syntax.designated_type());
		Type* actual = this.templates.qualifier(@scope, @syntax);

		if (!element || !actual) {
			if (this.failed()) {
				return nullptr;
			};
			@this.error(&@syntax, rt::string_view("automatic qualification requires a deduced parameter binding", 60));

			return nullptr;
		};

		return @this.types->qualified(*element, actual->qualifier());
	};

	if (kind == syntax_kind::type_name) {
		return @this.type(@scope, @*syntax.designated_type());
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		var Entity* entity = @this.lookup(@scope, @syntax);
		if (this.failed()) {
			return nullptr;
		};

		if (kind == syntax_kind::name && !entity) {
			Type* builtin = this.types->find_primitive(syntax.token().text());

			if (builtin) {
				return $builtin;
			};
		};

		if (!entity || !entity->denotes_type()) {
			var message = DiagnosticMessage();
			if (!entity) {
				@message.text(rt::string_view("unknown type name '", 19));
			}
			else {
				@message.text(rt::string_view("name does not denote a type: '", 30));
			};
			diagnostic_name(@message, syntax);
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());
			if (entity) {
				@this.note(entity->token(), rt::string_view("referenced declaration is here", 30));
			};

			return nullptr;
		};

		if (!this.accessible(*entity, @scope)) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("type '", 6));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("' is not accessible from this scope", 35));
			@this.report(syntax.token(), message.view());
			@this.note(entity->token(), rt::string_view("type is declared here", 21));

			return nullptr;
		};

		if (!@this.resolve((var Entity*(entity)))) {
			return nullptr;
		};

		if (!@this.unit->record_name(@this, @scope, @syntax, @*entity, 2)) {
			@this.error(&@syntax, rt::string_view("navigation index storage is unavailable", 39));
			return nullptr;
		};
		return entity->type();
	};

	if (kind == syntax_kind::type_function) {
		rt::buffer<Type*> parameters;
		parameter_arity arity = parameter_arity::fixed;
		var Syntax* list = syntax.function_type_parameters();
		usize index = 0;
		while (list && index < list->size()) {
			var Syntax* parameter = list->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			if (parameter->kind() == syntax_kind::parameter) {
				@parameter = parameter->parameter_type();
			};

			Type* resolved = @this.type(@scope, @*parameter);

			if (!resolved) {
				return nullptr;
			};

			if (!@parameters.push_back(resolved)) {
				return nullptr;
			};

			@index = index + 1;
		};

		Type* result = @this.type(@scope, @*syntax.function_type_result());

		if (!result) {
			@result = this.types->find_primitive(rt::string_view("void", 4));
		};

		return @this.types->function($result, $parameters, parameter_arity(arity));
	};

	if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array || (kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
		Type* element = @this.type(@scope, @*syntax.designated_type());

		if (!element) {
			return nullptr;
		};

		if ((kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
			var Syntax* condition = syntax.qualifier_condition();

			if (condition && condition->kind() != syntax_kind::absent) {
				var Entity* parameter = nullptr;
				var Scope* context = &@scope;

				while (context && !parameter) {
					var Entity* owner = context->owner();

					if (owner && owner->kind() == entity_kind::function) {
						usize index = 0;
						while (index < owner->parameters().size()) {
							var Entity* candidate := owner->parameters().data()[index];

							if (candidate->name() == condition->token().text()) {
								@parameter := candidate;
								break;
							};

							@index = index + 1;
						};
					};

					@context = context->parent();
				};

				if (!parameter) {
					@parameter = @this.lookup(@scope, @*condition);
				};

				if (!parameter || !parameter->type()) {
					if (this.failed()) {
						return nullptr;
					};
					var message = DiagnosticMessage();
					@message.text(rt::string_view("conditional qualification requires a named parameter; '", 55));
					diagnostic_name(@message, *condition);
					@message.text(rt::string_view("' does not provide a parameter type", 35));
					@this.report(condition->token(), message.view());

					return nullptr;
				};

				Type* actual = parameter->type();

				if (actual->kind() == type_kind::reference) {
					@actual = actual->element();
				};

				if (actual->qualifier() == type_qualifier::immutable) {
					return @this.types->qualified(*element, type_qualifier::immutable);
				};
				return $element;
			};

			if (kind == syntax_kind::type_mutable) {
				return $element;
			};
			return @this.types->qualified(*element, type_qualifier::immutable);
		};

		if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference) {
			if (!syntax.designated_type()->explicitly_qualified()) {
				@element = @this.types->qualified(*element, type_qualifier::immutable);
				if (!element) {
					return nullptr;
				};
			};
		};
		if (kind == syntax_kind::type_pointer) {
			return @this.types->pointer(element);
		};

		if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::reference) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("cannot form ", 12));
			if (kind == syntax_kind::type_reference) {
				@message.text(rt::string_view("a reference to '", 16));
			}
			else {
				@message.text(rt::string_view("an array of '", 13));
			};
			diagnostic_type(@message, *element);
			@message.text(rt::string_view("'; the element type has no object storage", 41));
			@this.report(syntax.token(), message.view());

			return nullptr;
		};

		if (kind == syntax_kind::type_reference) {
			return @this.types->reference(element);
		};

		u64 count = 0;
		var extent = @this.expression(@scope, @*syntax.array_extent(), rt::optional_ref<const Type>());

		if (!extent.get()) {
			return nullptr;
		};

		if (!extent.get()->type()->kind().is_integer()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be a positive integer constant; received type '", 66));
			diagnostic_type(@message, *extent.get()->type());
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!@this.constant_integer(*extent.get(), @count)) {
			if (this.failed()) {
				return nullptr;
			};
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be a positive integer constant; expression beginning with ", 77));
			@message.quoted(syntax.array_extent()->token().text());
			@message.text(rt::string_view(" of type '", 10));
			diagnostic_type(@message, *extent.get()->type());
			@message.text(rt::string_view("' is not constant", 17));
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!count) {
			@this.report(syntax.array_extent()->token(), rt::string_view("array extent shall be a positive integer constant; received 0", 61));

			return nullptr;
		};

		if (extent.get()->type()->kind() == type_kind::signed_integer && count & (u64(1) << (static_cast<u64>(extent.get()->type()->bits()) - 1))) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be positive; received -", 42));
			@message.number(u64(0) - u64(extent.get()->type()->signed_value(count)));
			@this.report(syntax.array_extent()->token(), message.view());

			return nullptr;
		};

		return @this.types->array(element, $count);
	};

	var message = DiagnosticMessage();
	@message.text(rt::string_view("unsupported type syntax beginning with ", 39));
	@message.quoted(syntax.token().text());
	@this.report(syntax.token(), message.view());

	return nullptr;
};

fn Analyzer::collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool {
	var Scope* scope_cursor = &@scope;
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::unit || kind == syntax_kind::brace || kind == syntax_kind::list) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!@this.collect(@*scope_cursor, @*syntax.item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return true;
	};

	if (kind == syntax_kind::access_label) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("access label ", 13));
			@message.quoted(syntax.token().text());
			@message.text(rt::string_view(" requires class scope; current scope is ", 40));
			if (scope_cursor->owner()) {
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(rt::string_view(" ", 1));
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text(rt::string_view("module scope", 12));
			};
			@this.report(syntax.token(), message.view());
			return false;
		};

		Token token = syntax.token();

		if (token.is(rt::string_view("private", 7))) {
			@scope_cursor->set_access(access_kind::private_access);
		}
		else if (token.is(rt::string_view("protected", 9))) {
			@scope_cursor->set_access(access_kind::protected_access);
		}
		else {
			@scope_cursor->set_access(access_kind::public_access);
		};

		return true;
	};

	if (kind == syntax_kind::ambiguity) {
		var Syntax* declaration = nullptr;
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			syntax_kind category = candidate->kind();

			if (category == syntax_kind::variable || category == syntax_kind::function || category == syntax_kind::record || category == syntax_kind::enumeration || category == syntax_kind::namespace_body || category == syntax_kind::template_declaration || category == syntax_kind::using_alias) {
				if (declaration) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("declaration has multiple unresolved interpretations; source begins with ", 72));
					@message.quoted(syntax.token().text());
					if (scope_cursor->owner()) {
						@message.text(rt::string_view(" in ", 4));
						diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
						@message.text(rt::string_view(" ", 1));
						diagnostic_entity(@message, *scope_cursor->owner());
					};
					@this.report(syntax.token(), message.view());
					return false;
				};

				@declaration := candidate;
			};

			@index = index + 1;
		};

		if (!declaration) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("declaration context has no declaration interpretation; source begins with ", 74));
			@message.quoted(syntax.token().text());
			if (scope_cursor->owner()) {
				@message.text(rt::string_view(" in ", 4));
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(rt::string_view(" ", 1));
				diagnostic_entity(@message, *scope_cursor->owner());
			};
			@this.report(syntax.token(), message.view());
			return false;
		};

		return @this.collect(@*scope_cursor, @*declaration);
	};

	if (kind == syntax_kind::template_declaration) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::function && this.templates.qualifier_dependent(@syntax)) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	var Syntax* name = nullptr;
	entity_kind category = entity_kind::global;
	var Syntax* members = nullptr;

	if (kind == syntax_kind::function) {
		@name = syntax.function_name();
		@category = entity_kind::function;
	}
	else if (kind == syntax_kind::variable) {
		@name = syntax.variable_name();

		if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
			@category = entity_kind::field;
		};
	}
	else if (kind == syntax_kind::record) {
		@name = syntax.record_name();
		@category = entity_kind::record;
		@members = syntax.record_members();
	}
	else if (kind == syntax_kind::enumeration) {
		@name = syntax.enum_name();
		@category = entity_kind::enumeration;
		@members = syntax.enum_members();
	}
	else if (kind == syntax_kind::enumerator) {
		@name = syntax.item(0);
		@category = entity_kind::enumerator;
	}
	else if (kind == syntax_kind::namespace_body) {
		@name = syntax.namespace_name();
		@category = entity_kind::namespace_body;
		@members = syntax.namespace_members();
	}
	else if (kind == syntax_kind::using_alias) {
		@name = syntax.alias_name();
		@category = entity_kind::alias;
	}
	else {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("declaration required at module or record scope; source begins with ", 67));
		@message.quoted(syntax.token().text());
		if (scope_cursor->owner()) {
			@message.text(rt::string_view(" in ", 4));
			diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
			@message.text(rt::string_view(" ", 1));
			diagnostic_entity(@message, *scope_cursor->owner());
		};
		@this.report(syntax.token(), message.view());
		return false;
	};

	if (!name || name->kind() == syntax_kind::absent) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("declaration requires an unqualified name in its owning scope; ", 62));
		diagnostic_entity_kind(@message, category);
		@message.text(rt::string_view(" declaration begins with ", 25));
		@message.quoted(syntax.token().text());
		@this.report(syntax.token(), message.view());
		return false;
	};

	access_kind declaration_access = scope_cursor->access();

	if (name->kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@*scope_cursor, @*name->left());

		if (!owner || !owner->members()) {
			if (!this.failed()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("cannot declare '", 16));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("': owner '", 10));
				diagnostic_name(@message, *name->left());
				if (owner) {
					@message.text(rt::string_view("' is a ", 7));
					diagnostic_entity_kind(@message, owner->kind());
					@message.text(rt::string_view(" without a member scope", 23));
				}
				else {
					@message.text(rt::string_view("' is not declared", 17));
				};
				@this.report(name->token(), message.view());
				if (owner) {
					@this.note(owner->token(), rt::string_view("owner is declared here", 22));
				};
			};
			return false;
		};

		@scope_cursor = owner->members();
		@name = name->right();
	};

	var Entity* existing = scope_cursor->local(name->token().text());

	if (existing && category != entity_kind::function) {
		if (existing->kind() != category) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("conflicting declaration kind for ", 33));
			@message.quoted(name->token().text());
			@message.text(rt::string_view(": declaring ", 12));
			diagnostic_entity_kind(@message, category);
			@message.text(rt::string_view(" after ", 7));
			diagnostic_entity_kind(@message, existing->kind());
			@this.report(name->token(), message.view());
			@this.note(existing->token(), rt::string_view("previous declaration is here", 28));
			return false;
		};

		if (category == entity_kind::record) {
			if (members->kind() != syntax_kind::noop) {
				if (existing->declaration()->record_members()->kind() != syntax_kind::noop) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("duplicate record definition for ", 32));
					@message.quoted(name->token().text());
					@message.text(rt::string_view(" (", 2));
					diagnostic_entity_kind(@message, category);
					@message.text(rt::string_view(")", 1));
					@this.report(name->token(), message.view());
					@this.note(existing->token(), rt::string_view("previous record definition is here", 34));
					return false;
				};

				@existing->replace_declaration(&@syntax);
			};
		}
		else if (category != entity_kind::namespace_body) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("duplicate declaration of ", 25));
			@message.quoted(name->token().text());
			@message.text(rt::string_view(" (", 2));
			diagnostic_entity_kind(@message, category);
			@message.text(rt::string_view(")", 1));
			@this.report(name->token(), message.view());
			@this.note(existing->token(), rt::string_view("previous declaration is here", 28));
			return false;
		};
	};

	var Entity* entity = existing;

	if (!entity || category == entity_kind::function) {
		@entity = @this.unit->create_entity(entity_kind(category), name->token(), &@syntax, scope_cursor);

		if (entity) {
			@entity->set_access(access_kind(declaration_access));
		};
	};

	if (!entity) {
		@this.error(&@syntax, rt::string_view("out of memory storing declaration", 33));
		return false;
	};

	if (members) {
		var Scope* nested = entity->members();

		if (!nested) {
			@nested = @this.unit->create_scope(scope_cursor, (var Entity*(entity)));
			@entity->set_members((var Scope*(nested)));
		};

		if (!nested || !@this.collect(@*nested, @*members)) {
			return false;
		};
	};

	if (entity->kind() == entity_kind::field) {
		@entity->set_index(scope_cursor->owner()->fields().size());

		return @scope_cursor->owner()->add_field(entity);
	};

	if (entity->kind() == entity_kind::function && name->kind() == syntax_kind::unary && name->token().kind == token_kind::op_tilde) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record || !name->operand()->token().same(scope_cursor->owner()->token())) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("destructor '", 12));
			@message.text(rt::string_view("~", 1));
			diagnostic_name(@message, *name->operand());
			@message.text(rt::string_view("' shall name its owning class", 29));
			if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
				@message.text(rt::string_view(" ", 1));
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text(rt::string_view("; declaration is outside class scope", 36));
			};
			@this.report(name->token(), message.view());
			return false;
		};

		@scope_cursor->owner()->set_destructor(entity);
	};

	return true;
};

fn Analyzer::Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits) {
	@this.types = &@types;
	@this.diagnostics = &@diagnostics;
	@this.pointer_bits = $pointer_bits;

	if (!@types.initialize_primitives(this.pointer_bits)) {
		Token location;
		@diagnostics.error(location, rt::string_view("cannot initialize primitive types", 33));
	};
};

fn Analyzer::semantic_unit(Analyzer& this) -> var SemanticUnit* {
	return this.unit;
};

fn Analyzer::type_store(Analyzer& this) -> var TypeStore* {
	return this.types;
};

fn Analyzer::accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool {
	return entity.accessible_from(@scope);
};

fn Analyzer::set_editor(var Analyzer& this, bool enabled) {
	@this.editor = $enabled;
};

fn Analyzer::recovery_operand(Analyzer& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::error_expression) {
		return true;
	};
	if (syntax.kind() != syntax_kind::unary && syntax.kind() != syntax_kind::binary && syntax.kind() != syntax_kind::index && syntax.kind() != syntax_kind::cast && syntax.kind() != syntax_kind::grouping) {
		return false;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.recovery_operand(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};
