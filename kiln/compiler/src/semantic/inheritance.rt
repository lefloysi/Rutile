fn Analyzer::resolve_bases(var Analyzer& this, var Entity* entity) -> bool {
	var Syntax* declaration = entity->declaration();
	var Syntax* bases = declaration->record_bases();

	if (!bases->size()) {
		return true;
	};

	if (entity->layout() == record_layout::overlapping) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("union '", 7));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' cannot contain a base subobject", 33));
		@this.report(entity->token(), message.view());
		return false;
	};

	if (bases->size() != 1) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("record '", 8));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' declares ", 11));
		@message.number(u64(bases->size()));
		@message.text(rt::string_view(" base types; multiple base analysis is not implemented", 54));
		@this.report(entity->token(), message.view());
		return false;
	};

	Type* base = @this.type(@*entity->resolution_scope(), @*bases->item(0));

	if (!base) {
		return false;
	};
	if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record || base->qualifier() != type_qualifier::mutable || base->entity()->layout() != record_layout::sequential) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("invalid base type '", 19));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("' for record '", 14));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("': ", 3));
		if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record) {
			@message.text(rt::string_view("base requires a record type", 27));
		}
		else if (base->qualifier() != type_qualifier::mutable) {
			@message.text(rt::string_view("base type shall be unqualified", 30));
		}
		else {
			@message.text(rt::string_view("base type shall not be a union", 30));
		};
		@this.report(bases->item(0)->token(), message.view());
		return false;
	};

	var Entity* owner = base->entity();

	if (owner->state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("base relation contains a cycle; record '", 40));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' names base '", 14));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("'", 1));
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), rt::string_view("base record is declared here", 28));
		return false;
	};

	if (!@this.resolve(owner)) {
		return false;
	};

	if (owner->declaration()->record_members()->kind() == syntax_kind::noop) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("base requires a complete record definition; record '", 52));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' names base '", 14));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("'", 1));
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), rt::string_view("base record is declared here", 28));
		return false;
	};

	if (!@entity->add_base(base)) {
		@this.error(declaration, rt::string_view("base subobject metadata storage is unavailable", 46));
		return false;
	};

	return true;
};
