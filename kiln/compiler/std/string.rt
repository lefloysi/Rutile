fn malloc(usize size) -> var void*;

fn free(void* memory);

fn memcpy(var void* destination, void* source, usize size) -> var void*;

fn memmove(var void* destination, void* source, usize size) -> var void*;

namespace rt {
	union string_storage {
		fn string_storage(var string_storage& this) : [default];
		fn ~string_storage(var string_storage& this) : [default];

		char[16] inline_bytes;
		var char* heap;
	};

	struct string {
		fn string(var string& this) : [default];
		fn string(var string& this, string& other);
		fn string(var string& this, string_view text);
		fn string(var string& this, char* text);
		fn ~string(var string& this);

		fn operator:=(var string& this, string& other) -> var string&;
		fn clear(var string& this);
		fn append(var string& this, string_view text) -> bool;
		// The requested capacity excludes the terminating NUL byte.
		fn reserve(var string& this, usize required) -> bool;

		fn size(string& this) -> usize;
		fn capacity(string& this) -> usize;
		fn empty(string& this) -> bool;
		fn data(auto string& this) -> const[this] char*;
		fn c_str(string& this) -> char*;
		fn view(string& this) -> string_view;

	private:
		string_storage storage;
		usize length;
		// Zero selects inline storage; heap capacity excludes the terminating NUL.
		usize heap_capacity;
	};

	fn string_view::string_view(var string_view& this, string& text) {
		@this.bytes = text.data();
		@this.length = text.size();
	};

	fn string::reserve(var string& this, usize required) -> bool {
		if (required <= this.capacity()) {
			return true;
		};

		usize maximum = usize::max - 1;
		if (required > maximum) {
			return false;
		};

		usize count = $required;
		usize capacity = this.capacity();
		usize half = capacity >> 1;
		if (capacity > maximum - half) {
			@count = $maximum;
		}
		else if (capacity + half > count) {
			@count = capacity + half;
		};

		var char* replacement = static_cast<var char*>(malloc(count + 1));
		if (!replacement) {
			return false;
		};

		memcpy(replacement, this.data(), this.length + 1);
		if (this.heap_capacity) {
			free(this.storage.heap);
		};

		@this.storage.heap = $replacement;
		@this.heap_capacity = $count;

		return true;
	};

	fn string::append(var string& this, string_view text) -> bool {
		if (text.empty()) {
			return true;
		};

		if (text.size() > usize::max - this.length - 1) {
			return false;
		};

		char* source = text.data();
		usize address = reinterpret_cast<usize>(source);
		usize begin = reinterpret_cast<usize>(this.data());
		bool aliases = address >= begin && address - begin <= this.length;
		usize offset = 0;
		if (aliases) {
			@offset = address - begin;
		};

		usize length = this.length + text.size();
		if (!@this.reserve(length)) {
			return false;
		};

		var char* destination = (@this).data();
		if (aliases) {
			@source = destination + offset;
		};

		memmove(destination + this.length, source, text.size());
		@destination[length] = '\0';
		@this.length = $length;

		return true;
	};

	fn string::string(var string& this, string& other) {
		@this.append(other.view());
	};

	fn string::string(var string& this, string_view text) {
		@this.append(text);
	};

	fn string::string(var string& this, char* text) {
		@this.append(string_view($text));
	};

	fn string::~string(var string& this) {
		if (this.heap_capacity) {
			free(this.storage.heap);
		};
	};

	fn string::operator:=(var string& this, string& other) -> var string& {
		string replacement;
		if (!@replacement.append(other.view())) {
			return @this;
		};

		@this = $replacement;

		return @this;
	};

	fn string::size(string& this) -> usize {
		return this.length;
	};

	fn string::capacity(string& this) -> usize {
		if (this.heap_capacity) {
			return this.heap_capacity;
		};

		return 15;
	};

	fn string::empty(string& this) -> bool {
		return !this.length;
	};

	fn string::data(auto string& this) -> const[this] char* {
		if (this.heap_capacity) {
			return this.storage.heap;
		};

		return &@this.storage.inline_bytes[0];
	};

	fn string::c_str(string& this) -> char* {
		return this.data();
	};

	fn string::view(string& this) -> string_view {
		return string_view(this.data(), this.length);
	};

	fn string::clear(var string& this) {
		@this.length = 0;
		var char* bytes = (@this).data();
		@bytes[0] = '\0';
	};
};
