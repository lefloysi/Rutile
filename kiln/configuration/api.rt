namespace kiln {
	enum TargetType : [u08] {
		executable;
		shared_lib;
		static_lib;
		object_lib;
	};

	using TargetCallback = ((var void*, const char*, usize, const char*, usize, const char*, usize, i32) -> usize)*;
	using OptionCallback = ((var void*, usize, const char*, usize, const char*, usize) -> i32)*;
	using SourceCallback = ((var void*, usize, const char*, usize) -> i32)*;
	using ProfileCallback = ((var void*, const char*, usize, i32) -> i32)*;

	struct Options {
		var void* context;
		TargetCallback target_callback;
		OptionCallback option_callback;
		SourceCallback source_callback;
		rt::string_view root_path;
		rt::string_view host_os;
		rt::string_view build_profile;
		ProfileCallback profile_callback;

		fn path(Options& this) -> rt::string_view;
		fn os(Options& this) -> rt::string_view;
		fn profile(Options& this) -> rt::string_view;
	};

	var Options* current;
	i32 failure;

	struct Sources {
		usize target_id;
		fn add(var Sources& this, rt::string_view folder) -> bool;
	};

	struct Target {
		Sources sources;
		fn option(var Target& this, rt::string_view key, rt::string_view value) -> bool;
		fn compiler(var Target& this, rt::string_view name) -> bool;
		fn depends_on(var Target& this, rt::string_view name) -> bool;
	};

	fn begin(var Options& options) {
		@current = &@options;
		@failure = 0;
	};

	fn finish() -> i32 {
		return failure;
	};

	fn profile(rt::string_view name, i32 optimization) -> bool {
		if (!current || !current->profile_callback(current->context, name.data(), name.size(), optimization)) {
			@failure = 1;
			return false;
		};
		return true;
	};

	fn add_subdirectory(rt::string_view folder) -> bool {
		if (!current || !current->option_callback(current->context, 0, "subdirectory".data(), 12, folder.data(), folder.size())) {
			@failure = 1;
			return false;
		};
		return true;
	};

	fn Options::path(Options& this) -> rt::string_view {
		return this.root_path;
	};

	fn Options::os(Options& this) -> rt::string_view {
		return this.host_os;
	};

	fn Options::profile(Options& this) -> rt::string_view {
		return this.build_profile;
	};

	fn add_target(rt::string_view name, TargetType kind) -> Target {
		Target target;

		i32 target_kind = 0;
		if (kind == TargetType::shared_lib) {
			@target_kind = 1;
		};
		if (kind == TargetType::static_lib) {
			@target_kind = 2;
		};
		if (kind == TargetType::object_lib) {
			@target_kind = 3;
		};
		if (current) {
			@target.sources.target_id = current->target_callback(current->context, name.data(), name.size(), "rutile".data(), 6, "".data(), 0, target_kind);
		};
		if (!target.sources.target_id) {
			@failure = 1;
		};
		return $target;
	};

	fn Sources::add(var Sources& this, rt::string_view folder) -> bool {
		if (!current || !current->source_callback(current->context, this.target_id, folder.data(), folder.size())) {
			@failure = 1;
			return false;
		};
		return true;
	};

	fn Target::option(var Target& this, rt::string_view key, rt::string_view value) -> bool {
		if (!current || !current->option_callback(current->context, this.sources.target_id, key.data(), key.size(), value.data(), value.size())) {
			@failure = 1;
			return false;
		};
		return true;
	};

	fn Target::compiler(var Target& this, rt::string_view name) -> bool {
		return @this.option("compiler", name);
	};

	fn Target::depends_on(var Target& this, rt::string_view name) -> bool {
		return @this.option("dependency", name);
	};
};
