struct Allocation {
	void* memory;
	((void*) -> void)* dispose;
	Allocation* next;
};

struct Arena {
	fn ~Arena(Arena& this);
	fn clear(Arena& this);
	fn adopt(Arena& this, void* memory, ((void*) -> void)* dispose) -> void*;

	Allocation* head;
};

fn Arena::~Arena(Arena& this) {
	@this.clear();
};

fn Arena::adopt(Arena& this, void* memory, ((void*) -> void)* dispose) -> void* {
	if (!memory) {
		return nullptr;
	};
	Allocation* allocation = static_cast<Allocation*>(malloc(sizeof(Allocation)));
	if (!allocation) {
		dispose($memory);
		return nullptr;
	};
	@allocation->memory := memory;
	@allocation->dispose = $dispose;
	@allocation->next := this.head;
	@this.head = $allocation;
	return memory;
};

fn Arena::clear(Arena& this) {
	while (this.head) {
		Allocation* allocation := this.head;
		@this.head := allocation->next;
		allocation->dispose(void*(allocation->memory));
		free($allocation);
	};
};

