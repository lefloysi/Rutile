struct LayoutVisit {
	Entity* entity;
	LayoutVisit* parent;
};

fn layout_validate(Compiler& compiler, Type* type, LayoutVisit* parent, const Token& token) {
	if (!type) {
		return;
	};
	if (type_enum(static_cast<Type*>(type))) {
		if (type->data.entity->state != resolution::active || !type->data.entity->data.enumeration.underlying) {
			entity_resolve(@compiler, static_cast<Entity*>(type->data.entity));
		};
		if (compiler.result == compilation_result::failure) {
			return;
		};
		layout_validate(@compiler, static_cast<Type*>(type->data.entity->data.enumeration.underlying), $parent, token);
		return;
	};
	if (type->kind == type_kind::kw_void || type->kind == type_kind::kw_null || type->kind == type_kind::function) {
		@compiler.diagnostics.report(token, "type has no value storage layout\0");
		return;
	};
	if (type->kind == type_kind::array) {
		layout_validate(@compiler, static_cast<Type*>(type->data.array.element), static_cast<LayoutVisit*>(parent), token);
		if (compiler.result == compilation_result::failure) {
			return;
		};

		u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, static_cast<Type*>(type->data.array.element)));
		u64 maximum = 18446744073709551615;
		if (compiler.usize_type->data.bits < 64) {
			@maximum = 1;
			i32 bit = 0;
			while (bit < compiler.usize_type->data.bits) {
				@maximum = maximum * 2;
				@bit = bit + 1;
			};
			@maximum = maximum - 1;
		};
		if (size && type->data.array.count > maximum / size) {
			@compiler.diagnostics.report(token, "array storage exceeds the native address range\0");
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};

	Entity* entity := type->data.entity;
	LayoutVisit* previous := parent;
	while (previous) {
		if (previous->entity == entity) {
			@compiler.diagnostics.report(token, "record contains itself by value\0");
			return;
		};
		@previous := previous->parent;
	};

	entity_resolve(@compiler, static_cast<Entity*>(entity));
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		@compiler.diagnostics.report(token, "incomplete record has no storage layout\0");
		return;
	};

	Field* binding := entity->data.aggregate.fields;
	LayoutVisit visit;
	@visit.entity := entity;
	@visit.parent = $parent;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type(static_cast<Entity*>(base->entity)), &visit, base->name->token);
		@base := base->next;
	};
	while (binding && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type(static_cast<Entity*>(binding->entity)), &visit, binding->entity->name);
		@binding := binding->next;
	};
};

