enum value_category : [i32] {
	entity;
	storage;
	temporary;
};

struct Semantic {
	Compiler* compiler;
	Scope* scope;
	Entity* function;
	SemanticFlow* flow;
	Type* selection_type;
};

struct Emitter {
	MirScope* scope;
	LLVMOpaqueValue* llvm_function;
	LLVMOpaqueValue* component_source;
	Type* return_type;
	Compiler* compiler;
	Entity* function;
	Temporary* temporaries;
};

struct Temporary {
	Type* type;
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* guard;
	Temporary* next;
};

struct CaseValue {
	CaseValue* next;
	u64 value;
};

fn entity_type(Entity* entity) -> Type* {
	switch (entity->kind) {
		case entity_kind::primitive:
			return static_cast<Type*>(entity->data.primitive.type);
		case entity_kind::kw_struct:
		case entity_kind::kw_union:
			return static_cast<Type*>(entity->data.aggregate.type);
		case entity_kind::kw_enum:
			return static_cast<Type*>(entity->data.enumeration.aggregate.type);
		case entity_kind::function:
			return static_cast<Type*>(entity->data.function.type);
		case entity_kind::variable:
			return static_cast<Type*>(entity->data.variable.type);
		default:
			return nullptr;
	};
};

