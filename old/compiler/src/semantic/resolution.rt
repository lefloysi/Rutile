fn interface_receiver_validate(Compiler& compiler, Entity* entity, Type* signature, const Token& token) {
	if (entity->data.function.role == function_role::conversion) {
		return;
	};
	if (entity->data.function.role == function_role::ordinary && entity->data.function.modification == function_modification::ordinary && !function_receiver(static_cast<Entity*>(entity))) {
		return;
	};
	Entity* owner := entity->data.function.interface_owner;
	if (!owner && entity->data.function.role != function_role::ordinary && entity->scope) {
		@owner := entity->scope->owner;
	};
	if (!owner) {
		return;
	};
	Parameter* receiver := signature->data.function.parameters;
	if (!receiver || !function_receiver(static_cast<Entity*>(entity)) || receiver->type->kind != type_kind::reference || receiver->type->data.element->kind != type_kind::named || receiver->type->data.element->data.entity != owner) {
		@compiler.diagnostics.report(token, "struct interface function requires its owning reference receiver named this\0");
		return;
	};
	if (entity->data.function.role == function_role::destructor && (receiver->next || receiver->type->data.element->qualifier == type_qualifier::kw_const || signature->data.function.arity != parameter_arity::fixed || signature->data.function.result->kind != type_kind::kw_void)) {
		@compiler.diagnostics.report(token, "destructor requires exactly one mutable owning-type reference receiver named this\0");
	};
};

fn defaulted_validate(Compiler& compiler, Entity* entity, Type* signature, const Token& token) {
	if (entity->data.function.definition != function_definition::defaulted) {
		return;
	};
	Parameter* receiver := signature->data.function.parameters;
	function_role role := entity->data.function.role;
	if (role == function_role::ordinary || !receiver || signature->data.function.arity != parameter_arity::fixed || receiver->type->kind != type_kind::reference || receiver->type->data.element->qualifier == type_qualifier::kw_const) {
		@compiler.diagnostics.report(token, "default applies only to a special member function\0");
		return;
	};
	if (role == function_role::destructor) {
		return;
	};
	Parameter* source := receiver->next;
	if (role == function_role::constructor && !source) {
		return;
	};
	if (!source || source->next) {
		@compiler.diagnostics.report(token, "defaulted transfer requires one owning-type value or reference parameter\0");
		return;
	};
	Type* source_type := source->type;
	if (source_type->kind == type_kind::reference) {
		@source_type = @compiler.semantic.types.qualified(static_cast<Type*>(source_type->data.element), type_qualifier::mutable);
	};
	if (!type_equal(static_cast<Type*>(source_type), static_cast<Type*>(receiver->type->data.element))) {
		@compiler.diagnostics.report(token, "defaulted transfer requires one owning-type value or reference parameter\0");
		return;
	};
	if (role == function_role::assignment && (signature->data.function.result->kind != type_kind::reference || !type_equal(static_cast<Type*>(signature->data.function.result), static_cast<Type*>(receiver->type)))) {
		@compiler.diagnostics.report(token, "defaulted assignment must return its mutable owning-type reference\0");
	};
};

fn enum_constructor(Compiler& compiler, Entity* owner, Syntax* body) {
	Scope* owner_scope = entity_members(static_cast<Entity*>(owner));
	Token location := owner->name;
	Entity* function = entity_create(@compiler, entity_kind::function, Token(location));
	@function->scope := owner_scope;
	@function->data.function.role = function_role::constructor;
	Syntax* declaration = syntax_create(@compiler, syntax_kind::node_declaration, Token(location));
	@declaration->entity := function;
	@declaration->data.declaration.name := location;
	@declaration->data.declaration.definition = function_definition::definition;
	@function->declaration := declaration;
	Parameter* receiver = static_cast<Parameter*>(@compiler.allocate(sizeof(Parameter)));
	Token receiver_token = token_synthetic(@compiler, Token(location), "this\0");
	@receiver->type = @compiler.semantic.types.indirect(type_kind::reference, entity_type(static_cast<Entity*>(owner)));
	Parameter* value = static_cast<Parameter*>(@compiler.allocate(sizeof(Parameter)));
	Token value_token = token_synthetic(@compiler, Token(location), "value\0");
	@value->type := owner->data.enumeration.underlying;
	@receiver->next := value;
	TypeUse* use = static_cast<TypeUse*>(@compiler.allocate(sizeof(TypeUse)));
	ParameterUse* receiver_use = static_cast<ParameterUse*>(@compiler.allocate(sizeof(ParameterUse)));
	ParameterUse* value_use = static_cast<ParameterUse*>(@compiler.allocate(sizeof(ParameterUse)));
	if (!use || !receiver_use || !value_use) {
		return;
	};
	@receiver_use->name := receiver_token;
	@receiver_use->next := value_use;
	@value_use->name := value_token;
	@value_use->use := owner->data.enumeration.underlying_use;
	@use->data.callable.parameters = $receiver_use;
	@function->data.function.type_use = $use;
	@function->data.function.type = @compiler.semantic.types.function(static_cast<Type*>(compiler.void_type), static_cast<Parameter*>(receiver), parameter_arity::fixed);
	Scope* scope = @compiler.create_scope(static_cast<Scope*>(owner_scope), context_kind::function, static_cast<Entity*>(function));
	Entity* receiver_entity = entity_create(@compiler, entity_kind::variable, Token(receiver_token));
	@receiver_entity->data.variable.storage = storage_kind::parameter;
	@receiver_entity->data.variable.type := receiver->type;
	@receiver_entity->state = resolution::ready;
	@scope->define(static_cast<Entity*>(receiver_entity));
	Entity* value_entity = entity_create(@compiler, entity_kind::variable, Token(value_token));
	@value_entity->data.variable.storage = storage_kind::parameter;
	@value_entity->data.variable.type := value->type;
	@value_entity->state = resolution::ready;
	@scope->define(static_cast<Entity*>(value_entity));
	Syntax* receiver_name = syntax_create(@compiler, syntax_kind::expr_name, Token(receiver_token));
	@receiver_name->entity = $receiver_entity;
	Syntax* access = syntax_create(@compiler, syntax_kind::expr_access, Token(location));
	@access->data.expression = $receiver_name;
	Syntax* value_name = syntax_create(@compiler, syntax_kind::expr_name, Token(value_token));
	@value_name->entity = $value_entity;
	Syntax* relocate = syntax_create(@compiler, syntax_kind::expr_relocate, Token(location));
	@relocate->data.expression = $value_name;
	Syntax* cast = syntax_create(@compiler, syntax_kind::expr_cast, Token(location));
	@cast->data.cast.resolved = entity_type(static_cast<Entity*>(owner));
	@cast->data.cast.value = $relocate;
	Syntax* assignment = syntax_create(@compiler, syntax_kind::expr_binary, Token(location));
	@assignment->data.binary.operation = token_kind::op_assign;
	@assignment->data.binary.left = $access;
	@assignment->data.binary.right = $cast;
	Syntax* function_body = syntax_create(@compiler, syntax_kind::node_block, Token(location));
	@function_body->scope = $scope;
	@function_body->data.statements = $assignment;
	@declaration->data.declaration.body = $function_body;
	declaration_special_register(@compiler, static_cast<Scope*>(owner_scope), static_cast<Syntax*>(declaration));
	Syntax** tail = &body->data.statements;
	while (*tail) {
		@tail = &(*tail)->next;
	};
	@*tail = $declaration;
};

fn entity_resolve(Compiler& compiler, Entity* entity) {
	if (!entity || entity->state == resolution::ready) {
		return;
	};
	if (entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
		global_variable_resolve(@compiler, $entity);
		return;
	};
	if (entity->state == resolution::active) {
		@compiler.diagnostics.report(entity->name, "cyclic entity definition\0");
		return;
	};
	@entity->state = resolution::active;
	if (entity->kind == entity_kind::primitive && entity->data.primitive.source) {
		@entity->data.primitive.type = type_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(entity->data.primitive.source));
		@entity->data.primitive.type_use = type_use_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(entity->data.primitive.source));
		@entity->state = resolution::ready;
		return;
	};
	Syntax* declaration := entity->declaration;
	if (!declaration) {
		@compiler.diagnostics.report(entity->name, "entity has no declaration\0");
		return;
	};
	if (entity->kind == entity_kind::function) {
		@entity->data.function.type = function_type_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<Entity*>(entity));
		interface_receiver_validate(@compiler, static_cast<Entity*>(entity), static_cast<Type*>(entity->data.function.type), declaration->token);
		Parameter* receiver := entity->data.function.type->data.function.parameters;
		Entity* owner = nullptr;
		if (entity->scope) {
			@owner := entity->scope->owner;
		};
		if (owner && (owner->kind == entity_kind::kw_struct || owner->kind == entity_kind::kw_union) && receiver && function_receiver(static_cast<Entity*>(entity)) && (receiver->type->kind != type_kind::reference || receiver->type->data.element->kind != type_kind::named || receiver->type->data.element->data.entity != owner)) {
			@compiler.diagnostics.report(entity->name, "associated receiver must reference its owning type\0");
		};
		@entity->data.function.definition := declaration->data.declaration.definition;
		if (entity->data.function.definition == function_definition::defaulted) {
			@entity->data.function.analysis = function_analysis::unrequested;
		};
		defaulted_validate(@compiler, static_cast<Entity*>(entity), static_cast<Type*>(entity->data.function.type), declaration->token);
		@entity->data.function.body := declaration->data.declaration.body;
		if (entity->data.function.body) {
			@entity->data.function.scope := entity->data.function.body->scope;
			ParameterBinding** tail = &entity->data.function.parameter_bindings;
			Parameter* parameter := entity->data.function.type->data.function.parameters;
			ParameterUse* label := entity->data.function.type_use->data.callable.parameters;
			while (parameter) {
				if (!label || !label->name.source) {
					@compiler.diagnostics.report(entity->name, "function definition requires named parameters\0");
					break;
				};
				Entity* variable = (entity->data.function.scope)->lookup(label->name);
				if (!variable || variable->kind != entity_kind::variable) {
					@compiler.diagnostics.report(label->name, "function parameter binding is missing\0");
					return;
				};
				@variable->data.variable.type := parameter->type;
				@variable->data.variable.type_use := label->use;
				@variable->state = resolution::ready;

				ParameterBinding* binding = static_cast<ParameterBinding*>(@compiler.allocate(sizeof(ParameterBinding)));
				if (!binding) {
					return;
				};
				@binding->entity = $variable;
				@*tail := binding;
				@tail = &binding->next;
				@parameter := parameter->next;
				@label := label->next;
			};
		};
	}
	else if (entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum) {
		if (!entity_type(static_cast<Entity*>(entity))) {
			Type* type = @compiler.semantic.types.entity(type_kind::named, static_cast<Entity*>(entity));
			if (entity->kind == entity_kind::kw_enum) {
				@entity->data.enumeration.aggregate.type = static_cast<Type*>(type);
			}
			else {
				@entity->data.aggregate.type = static_cast<Type*>(type);
			};
		};
		if (entity->kind == entity_kind::kw_enum) {
			@entity->data.enumeration.underlying = type_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(declaration->data.declaration.type));
			@entity->data.enumeration.underlying_use = type_use_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(declaration->data.declaration.type));
			Type* underlying := entity->data.enumeration.underlying;
			if (!underlying || underlying->kind == type_kind::kw_void || underlying->kind == type_kind::kw_null || underlying->kind == type_kind::function || underlying->kind == type_kind::reference || underlying->qualifier == type_qualifier::kw_const || (type_enum(static_cast<Type*>(underlying)) && underlying->data.entity == entity)) {
				@compiler.diagnostics.report(entity->name, "enum underlying type requires a complete mutable value representation\0");
				return;
			};
			if (type_enum(static_cast<Type*>(underlying))) {
				entity_resolve(@compiler, static_cast<Entity*>(underlying->data.entity));
				if (compiler.result == compilation_result::failure) {
					return;
				};
			};
			layout_validate(@compiler, static_cast<Type*>(underlying), nullptr, entity->name);
			if (compiler.result == compilation_result::failure) {
				return;
			};
		};
		bases_resolve(@compiler, static_cast<Entity*>(entity));
		usize base_count = 0;
		if (aggregate_header(static_cast<Entity*>(entity))) {
			@base_count = 1;
		};
		usize component := base_count;
		BaseRelation* layout_base := entity->data.aggregate.bases;
		while (layout_base) {
			if (layout_base->kind == base_kind::nonvirtual) {
				@layout_base->component := component;
				@component = component + 1;
			};
			@layout_base := layout_base->next;
		};
		if (entity->kind == entity_kind::kw_struct) {
			BaseRelation* base := entity->data.aggregate.bases;
			while (base && compiler.result != compilation_result::failure) {
				entity_resolve(@compiler, static_cast<Entity*>(base->entity));
				if (!base->entity->declaration || !base->entity->declaration->data.declaration.body) {
					@compiler.diagnostics.report(base->name->token, "base struct requires a complete definition\0");
					return;
				};
				if (base->kind == base_kind::nonvirtual) {
					@base_count = base_count + 1;
				};
				@base := base->next;
			};
		};
		Syntax* body := declaration->data.declaration.body;
		if (body) {
			Syntax* field := body->data.statements;
			usize index = 0;
			Field* last_field = nullptr;
			ConstantValue* next_value = nullptr;
			if (entity->kind == entity_kind::kw_enum && (entity->data.enumeration.underlying && entity->data.enumeration.underlying->kind.is_numeric())) {
				@next_value = constant_zero(@compiler, static_cast<Type*>(entity->data.enumeration.underlying));
			};
			while (field) {
				if (field->kind != syntax_kind::node_declaration) {
					@compiler.diagnostics.report(field->token, "aggregate context requires declarations\0");
					break;
				};
				if (field->entity->kind != entity_kind::variable) {
					@field := field->next;
					continue;
				};
				Entity* variable := field->entity;
				if (entity->kind == entity_kind::kw_enum) {
					@variable->data.variable.type = entity_type(static_cast<Entity*>(entity));
					@variable->data.variable.storage = storage_kind::constant;
					ConstantValue* value = nullptr;
					if (field->data.declaration.body) {
						Semantic semantic;
						@semantic.compiler = &compiler;
						@semantic.scope := body->scope;
						Type* actual = @semantic.expression(static_cast<Syntax*>(field->data.declaration.body), static_cast<Type*>(entity->data.enumeration.underlying));
						@semantic.expect(static_cast<Syntax*>(field->data.declaration.body), static_cast<Type*>(actual), static_cast<Type*>(entity->data.enumeration.underlying));
						if (compiler.result == compilation_result::failure) {
							return;
						};
						ConstantContext context;
						@context.compiler = &compiler;
						@context.scope := body->scope;
						@value = @context.expression(static_cast<Syntax*>(field->data.declaration.body), static_cast<Type*>(entity->data.enumeration.underlying));
						if (!value) {
							@compiler.diagnostics.report(field->token, static_cast<const char*>(context.reason));
							return;
						};
					};
					if (!field->data.declaration.body) {
						@value = constant_copy(@compiler, static_cast<ConstantValue*>(next_value));
					};
					if (!value) {
						if (entity->data.enumeration.underlying && entity->data.enumeration.underlying->kind.is_numeric()) {
							@compiler.diagnostics.report(field->token, "automatic enum numbering exceeds the underlying type range\0");
						}
						else {
							@compiler.diagnostics.report(field->token, "enum member with a non-primitive underlying type requires an initializer\0");
						};
						return;
					};
					@next_value = nullptr;
					Type* underlying := entity->data.enumeration.underlying;
					if (underlying && underlying->kind.is_numeric()) {
						@next_value = constant_copy(@compiler, static_cast<ConstantValue*>(value));
					};
					if (underlying->kind == type_kind::kw_float) {
						@next_value->data.real = next_value->data.real + 1;
					}
					else if (underlying && underlying->kind.is_integer()) {
						u64 maximum = constant_selector(18446744073709551615, static_cast<Type*>(underlying));
						if (!type_unsigned(static_cast<Type*>(underlying)) && underlying->kind != type_kind::kw_char) {
							@maximum = maximum >> 1;
						};
						if (value->data.integer == maximum) {
							@next_value = nullptr;
						}
						else {
							@next_value->data.integer = next_value->data.integer + 1;
						};
					};
					if (entity->data.enumeration.underlying && entity->data.enumeration.underlying->kind.is_integer()) {
						@variable->data.variable.data.integer := value->data.integer;
					};
					@value->type = entity_type(static_cast<Entity*>(entity));
					@variable->data.variable.evaluation = static_cast<ConstantEvaluation*>(@compiler.allocate(sizeof(ConstantEvaluation)));
					@variable->data.variable.evaluation->state = constant_state::constant;
					@variable->data.variable.evaluation->value = $value;
				}
				else {
					@variable->data.variable.type = type_resolve(@compiler, static_cast<Scope*>(body->scope), static_cast<TypeSyntax*>(field->data.declaration.type));
					@variable->data.variable.type_use = type_use_resolve(@compiler, static_cast<Scope*>(body->scope), static_cast<TypeSyntax*>(field->data.declaration.type));
					if (entity->kind == entity_kind::kw_union && variable->data.variable.type->kind == type_kind::reference) {
						@compiler.diagnostics.report(field->token, "union cannot contain a reference field\0");
					};
					@variable->data.variable.storage = storage_kind::field;
					@variable->data.variable.data.field.owner := entity;
					@variable->data.variable.data.field.index = base_count + index;
					Field* representation = static_cast<Field*>(@compiler.allocate(sizeof(Field)));
					@representation->entity := variable;
					if (last_field) {
						@last_field->next := representation;
					}
					else {
						@entity->data.aggregate.fields := representation;
					};
					@last_field = $representation;
					@index = index + 1;
				};
				@variable->state = resolution::ready;
				@field := field->next;
			};
			if (entity->kind == entity_kind::kw_enum) {
				@entity->data.enumeration.values := body->scope->bindings;
				enum_constructor(@compiler, static_cast<Entity*>(entity), static_cast<Syntax*>(body));
			}
			else {
				@entity->data.aggregate.field_count = static_cast<u64>(index);
			};
		};
	}
	else if (entity->kind == entity_kind::variable) {
		if (declaration->data.declaration.type) {
			@entity->data.variable.type = type_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(declaration->data.declaration.type));
			@entity->data.variable.type_use = type_use_resolve(@compiler, static_cast<Scope*>(entity->scope), static_cast<TypeSyntax*>(declaration->data.declaration.type));
		};
	};
	@entity->state = resolution::ready;
};

