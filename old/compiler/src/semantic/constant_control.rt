fn ConstantContext::declare(ConstantContext& this, Syntax* syntax) {
	Entity* variable := syntax->entity;
	Type* type := variable->data.variable.type;
	if (!type && syntax->data.declaration.type) {
		@type = type_resolve(@*this.compiler, static_cast<Scope*>(this.scope), static_cast<TypeSyntax*>(syntax->data.declaration.type));
	};
	if (!type) {
		@this.failure("constant local requires a resolved type\0");
		return;
	};
	if (type_requires_destruction(static_cast<Type*>(type))) {
		@this.failure("local destruction requires runtime execution\0");
		return;
	};
	if (!@this.storage_supported(type_effective(static_cast<Type*>(type)))) {
		return;
	};
	ConstantValue* value = constant_zero(@*this.compiler, type_effective(static_cast<Type*>(type)));
	@this.bind(static_cast<Entity*>(variable), static_cast<ConstantValue*>(value));
	if (!syntax->data.declaration.body && syntax->data.declaration.constructor) {
		@this.call(static_cast<Entity*>(syntax->data.declaration.constructor), nullptr, static_cast<ConstantValue*>(value));
	};
};

fn ConstantContext::region(ConstantContext& this, Syntax* syntax) {
	if (!syntax || this.reason || this.compiler->result == compilation_result::failure) {
		return;
	};
	MirRegion* region = mir_region(@*this.compiler, static_cast<Syntax*>(syntax), static_cast<MirScope*>(this.mir_scope));
	if (!region) {
		return;
	};
	Scope* outer := this.scope;
	MirScope* outer_mir := this.mir_scope;
	MirBlock* block := region->entry;
	while (block && !this.reason && this.compiler->result == compilation_result::success) {
		@this.steps = this.steps + block->ticks;
		if (this.steps > constant_evaluation_step_limit) {
			@this.failure("constant evaluation exceeded the execution-step limit\0");
			break;
		};
		@this.mir_scope := block->scope;
		MirScope* scope := block->scope;
		while (scope && !scope->bindings) {
			@scope := scope->parent;
		};
		@this.scope := outer;
		if (scope) {
			@this.scope := scope->bindings;
		};
		if (block->kind == mir_kind::exit) {
			break;
		};
		if (block->kind == mir_kind::dispatch) {
			@this.failure("expression requires runtime execution\0");
			break;
		};
		if (block->kind == mir_kind::declare) {
			@this.declare(static_cast<Syntax*>(block->value));
		}
		else if (block->kind == mir_kind::kw_return) {
			if (block->value) {
				@this.result = @this.expression(static_cast<Syntax*>(block->value), nullptr);
			};
			break;
		}
		else if (block->kind == mir_kind::evaluate && block->value->kind != syntax_kind::kw_discard) {
			@this.expression(static_cast<Syntax*>(block->value), nullptr);
		};
		MirEdge* edge := block->edges;
		if (block->kind == mir_kind::branch) {
			i32 truth = 1;
			if (block->value) {
				ConstantValue* value = @this.expression(static_cast<Syntax*>(block->value), nullptr);
				if (!value) {
					break;
				};
				@truth = static_cast<i32>(constant_truth(static_cast<ConstantValue*>(value)));
			};
			while (edge && ((edge->kind == mir_edge_kind::when_true) != !!truth)) {
				@edge := edge->next;
			};
		};
		@block = nullptr;
		if (edge) {
			@block := edge->target;
		};
	};
	@this.scope = static_cast<Scope*>(outer);
	@this.mir_scope = static_cast<MirScope*>(outer_mir);
};

