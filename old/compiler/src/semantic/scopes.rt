fn Compiler::create_scope(Compiler& this, Scope* parent, context_kind context, Entity* owner) -> Scope* {
	Scope* scope = static_cast<Scope*>(@this.allocate(sizeof(Scope)));
	if (!scope) {
		return nullptr;
	};

	@scope->compiler = &this;
	@scope->parent = $parent;
	@scope->context = $context;
	@scope->owner = $owner;
	@scope->bucket_count = 64;
	@scope->buckets = static_cast<Binding**>(@this.allocate(scope->bucket_count * sizeof(Binding*)));
	if (!scope->buckets) {
		return nullptr;
	};

	return $scope;
};

fn Token::hash(const Token& this) -> usize {
	usize hash = 5381;
	usize index = 0;

	while (index < this.length) {
		@hash = hash * 33 + static_cast<usize>(this.source->bytes.data[this.begin + index]);
		@index = index + 1;
	};

	return $hash;
};

fn Scope::local(const Scope& this, const Token& name) -> Entity* {
	Binding* binding := this.buckets[name.hash() % this.bucket_count];

	while (binding) {
		if (binding->name.same(name)) {
			return static_cast<Entity*>(binding->entity);
		};
		@binding := binding->hash_next;
	};

	return nullptr;
};

fn Scope::lookup(const Scope& this, const Token& name) -> Entity* {
	const Scope* scope = &this;
	while (scope) {
		Entity* entity = scope->local(name);
		if (entity) {
			return $entity;
		};
		if (scope->owner && scope->owner->kind == entity_kind::kw_struct) {
			@entity = associated_lookup(@*scope->compiler, static_cast<Entity*>(scope->owner), name);
			if (entity || scope->compiler->result == compilation_result::failure) {
				return $entity;
			};
		};
		@scope := scope->parent;
	};

	return nullptr;
};

fn Scope::bind_named(Scope& this, Token name, Entity* entity, Scope* declaration_scope, Source* source) -> i32 {
	Binding* binding = static_cast<Binding*>(@this.compiler->allocate(sizeof(Binding)));
	if (!binding) {
		return 0;
	};

	usize bucket = name.hash() % this.bucket_count;
	if (!entity->scope) {
		@entity->scope := &this;
	};
	@binding->name = $name;
	@binding->declaration_scope = $declaration_scope;
	@binding->source = $source;
	@binding->entity = $entity;
	@binding->hash_next := this.buckets[bucket];
	@this.buckets[bucket] := binding;
	if (this.last_binding) {
		@this.last_binding->next := binding;
	}
	else {
		@this.bindings := binding;
	};
	@this.last_binding = $binding;
	@this.binding_count = this.binding_count + 1;
	return 1;
};

fn Scope::bind(Scope& this, Entity* entity) -> i32 {
	return @this.bind_named(Token(entity->name), static_cast<Entity*>(entity), &this, static_cast<Source*>(entity->name.source));
};

fn Scope::define(Scope& this, Entity* entity) -> i32 {
	if (this.local(entity->name)) {
		@this.compiler->diagnostics.report(entity->name, "duplicate declaration\0");
		return 0;
	};

	return @this.bind($entity);
};

fn entity_create(Compiler& compiler, entity_kind kind, Token name) -> Entity* {
	Entity* entity = static_cast<Entity*>(@compiler.allocate(sizeof(Entity)));
	if (!entity) {
		return nullptr;
	};

	@entity->kind = $kind;
	@entity->name = $name;
	if (entity->kind == entity_kind::function) {
		@entity->data.function.analysis = function_analysis::requested;
	};

	return $entity;
};

fn primitive_define(Compiler& compiler, char* name, type_kind kind, i32 bits) -> Type* {
	Source* source = @compiler.sources.create(@compiler);
	if (!source) {
		return nullptr;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen(static_cast<char*>(name));
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Type* type = @compiler.semantic.types.primitive($kind, $bits);
	if (!type) {
		return nullptr;
	};
	Entity* entity = entity_create(@compiler, entity_kind::primitive, $token);
	if (!entity) {
		return nullptr;
	};

	@entity->state = resolution::ready;
	@entity->data.primitive.type := type;
	@compiler.module->define($entity);

	return $type;
};

fn boolean_define(Compiler& compiler, char* name, bool value) {
	Source* source = @compiler.sources.create(@compiler);
	if (!source) {
		return;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen(static_cast<char*>(name));
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Entity* entity = entity_create(@compiler, entity_kind::variable, $token);
	if (!entity) {
		return;
	};

	@entity->state = resolution::ready;
	@entity->data.variable.storage = storage_kind::constant;
	@entity->data.variable.type := compiler.bool_type;
	@entity->data.variable.data.integer = static_cast<u64>(value);
	@compiler.module->define($entity);
};

fn compiler_builtins(Compiler& compiler, i32 pointer_bits) {
	declaration_rule_define(&compiler.declaration_rules[0], token_kind::kw_fn, entity_kind::function, context_kind::function);
	declaration_rule_define(&compiler.declaration_rules[1], token_kind::kw_struct, entity_kind::kw_struct, context_kind::kw_struct);
	declaration_rule_define(&compiler.declaration_rules[2], token_kind::kw_union, entity_kind::kw_union, context_kind::kw_union);
	declaration_rule_define(&compiler.declaration_rules[3], token_kind::kw_enum, entity_kind::kw_enum, context_kind::kw_enum);

	@compiler.module = @compiler.create_scope(nullptr, context_kind::module, nullptr);
	@compiler.void_type = primitive_define(@compiler, "void\0", type_kind::kw_void, 0);
	@compiler.null_type = primitive_define(@compiler, "null\0", type_kind::kw_null, 0);
	@compiler.bool_type = primitive_define(@compiler, "bool\0", type_kind::kw_bool, 0);
	boolean_define(@compiler, "false\0", false);
	boolean_define(@compiler, "true\0", true);
	@compiler.char_type = primitive_define(@compiler, "char\0", type_kind::kw_char, 0);
	primitive_define(@compiler, "i08\0", type_kind::kw_signed, 8);
	primitive_define(@compiler, "i16\0", type_kind::kw_signed, 16);
	@compiler.i32_type = primitive_define(@compiler, "i32\0", type_kind::kw_signed, 32);
	primitive_define(@compiler, "i64\0", type_kind::kw_signed, 64);
	primitive_define(@compiler, "u08\0", type_kind::kw_unsigned, 8);
	primitive_define(@compiler, "u16\0", type_kind::kw_unsigned, 16);
	primitive_define(@compiler, "u32\0", type_kind::kw_unsigned, 32);
	primitive_define(@compiler, "u64\0", type_kind::kw_unsigned, 64);
	@compiler.usize_type = primitive_define(@compiler, "usize\0", type_kind::kw_unsigned, i32(pointer_bits));
	primitive_define(@compiler, "ptrdiff\0", type_kind::kw_signed, $pointer_bits);
	primitive_define(@compiler, "f32\0", type_kind::kw_float, 32);
	primitive_define(@compiler, "f64\0", type_kind::kw_float, 64);
};

fn declaration_rule_define(DeclarationRule* rule, token_kind keyword, entity_kind entity, context_kind context) {
	@rule->keyword = $keyword;
	@rule->entity = $entity;
	@rule->context = $context;
};

fn declaration_rule(Compiler& compiler, token_kind token_kind) -> DeclarationRule* {
	usize count = sizeof(compiler.declaration_rules) / sizeof(DeclarationRule);
	usize index = 0;

	while (index < count) {
		if (compiler.declaration_rules[index].keyword == token_kind) {
			return &compiler.declaration_rules[index];
		};

		@index = index + 1;
	};

	return nullptr;
};

fn declaration_entity(Compiler& compiler, Scope* scope, entity_kind kind, const Token& name) -> Entity* {
	Entity* entity = scope->local(name);
	if (entity && entity->kind != kind) {
		@compiler.diagnostics.report(name, "conflicting declaration kind\0");
		return nullptr;
	};
	if (!entity) {
		@entity = entity_create(@compiler, static_cast<entity_kind>(kind), Token(name));
		if (!entity) {
			return nullptr;
		};
		@scope->define(static_cast<Entity*>(entity));
	};
	if ((kind == entity_kind::kw_struct || kind == entity_kind::kw_union || kind == entity_kind::kw_enum) && !entity->data.aggregate.scope) {
		@entity->data.aggregate.scope = @compiler.create_scope(static_cast<Scope*>(scope), context_kind::module, static_cast<Entity*>(entity));
	};
	return $entity;
};

fn namespace_define(Compiler& compiler, Scope* scope, Token name) -> Entity* {
	Entity* entity = scope->local(name);
	if (entity) {
		if (entity->kind != entity_kind::kw_namespace) {
			@compiler.diagnostics.report(name, "namespace conflicts with another declaration\0");
			return nullptr;
		};
		return $entity;
	};

	@entity = entity_create(@compiler, entity_kind::kw_namespace, $name);
	if (!entity) {
		return nullptr;
	};
	@entity->data.namespace_entity.scope = @compiler.create_scope(static_cast<Scope*>(scope), context_kind::module, static_cast<Entity*>(entity));
	@entity->state = resolution::ready;
	@scope->define(static_cast<Entity*>(entity));
	return $entity;
};

enum declaration_phase : [i32] {
	identities;
	members;
};

