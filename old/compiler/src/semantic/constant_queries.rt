fn constant_integer(Compiler& compiler, Scope* scope, Syntax* syntax) -> u64 {
	ConstantContext context;
	@context.compiler = &compiler;
	@context.scope = $scope;
	ConstantValue* value = @context.expression(static_cast<Syntax*>(syntax), nullptr);
	Type* representation = nullptr;
	if (value) {
		@representation = type_representation(static_cast<Type*>(value->type));
	};
	if (!representation || !representation->kind.is_integer()) {
		const char* reason = "expected an integer constant expression\0";
		if (context.reason) {
			@reason := context.reason;
		};
		@compiler.diagnostics.report(syntax->token, $reason);
		return 0;
	};
	return static_cast<u64>(value->data.integer);
};

fn constant_selector(u64 value, Type* type) -> u64 {
	i32 bits = type_bits($type);
	if (bits >= 64) {
		return $value;
	};

	u64 maximum = 18446744073709551615;
	u64 shift = static_cast<u64>((64 - bits));
	return value & (maximum >> shift);
};

