fn Semantic::nested_statement(Semantic& this, Syntax* syntax) {
	Scope* outer := this.scope;
	@this.scope = @this.compiler->create_scope(static_cast<Scope*>(outer), context_kind::local, nullptr);
	@this.statement($syntax);
	@this.scope = $outer;
};

fn Semantic::statement(Semantic& this, Syntax* syntax) {
	var references = ReferenceAnalysis(this.compiler, this.scope);
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	if (!syntax || compiler.result == compilation_result::failure) {
		return;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			Syntax* statement := syntax->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement(static_cast<Syntax*>(statement));
				@statement := statement->next;
			};
			@this.scope = &outer;
			break;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind == entity_kind::variable) {
				Entity* variable := syntax->entity;
				if (syntax->data.declaration.type) {
					@variable->data.variable.type = type_resolve(@compiler, static_cast<Scope*>(this.scope), static_cast<TypeSyntax*>(syntax->data.declaration.type));
					@variable->data.variable.type_use = type_use_resolve(@compiler, static_cast<Scope*>(this.scope), static_cast<TypeSyntax*>(syntax->data.declaration.type));
				};
				@variable->state = resolution::ready;
				if (!syntax->data.declaration.body && variable->data.variable.type) {
					@this.generated_operation_validate(static_cast<Type*>(variable->data.variable.type), generated_operation::kw_default, syntax->token);
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && variable->data.variable.type->kind == type_kind::named && (variable->data.variable.type->data.entity->kind == entity_kind::kw_struct || variable->data.variable.type->data.entity->kind == entity_kind::kw_union)) {
					@syntax->data.declaration.constructor = @this.special_select(static_cast<Entity*>(variable->data.variable.type->data.entity), function_role::constructor, nullptr, Token(syntax->token));
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && type_requires_union_choice(static_cast<Type*>(variable->data.variable.type))) {
					@compiler.diagnostics.report(syntax->token, "automatic union member construction requires an explicit member initializer\0");
					return;
				};
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					@references.initializer(static_cast<Syntax*>(syntax->data.declaration.body), static_cast<Entity*>(variable), Token(syntax->token));
					if (compiler.result == compilation_result::failure) {
						return;
					};
				}
				else {
					@this.scope->bind(static_cast<Entity*>(variable));
					if (variable->data.variable.type) {
						@references.prepare_object(static_cast<Entity*>(variable), static_cast<Syntax*>(syntax->data.declaration.body), Token(syntax->token));
					};
				};
				@this.statement(static_cast<Syntax*>(syntax->data.declaration.body));
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					@this.scope->bind(static_cast<Entity*>(variable));
				};
				if (!variable->data.variable.type || variable->data.variable.type->kind == type_kind::kw_void || variable->data.variable.type->kind == type_kind::kw_null || variable->data.variable.type->kind == type_kind::function) {
					@compiler.diagnostics.report(syntax->token, "variable requires a resolved storage type\0");
				};
				layout_validate(@compiler, static_cast<Type*>(variable->data.variable.type), nullptr, syntax->token);
			}
			else {
				entity_resolve(@compiler, static_cast<Entity*>(syntax->entity));
			};
			break;
		case syntax_kind::kw_return:
			if (!this.function) {
				@compiler.diagnostics.report(syntax->token, "return requires a function context\0");
			}
			else {
				Type* result := this.function->data.function.type->data.function.result;
				if (syntax->data.expression) {
					@this.expression(static_cast<Syntax*>(syntax->data.expression), static_cast<Type*>(result));
				if (compiler.result == compilation_result::failure) {
					return;
				};
					if (result->kind != type_kind::reference) {
						Syntax* value := syntax->data.expression;
						if (value->kind == syntax_kind::expr_name && value->entity && value->entity->kind == entity_kind::variable && !type_builtin_copyable(static_cast<Type*>(value->type)) && !implicit_copy_find(@compiler, static_cast<Type*>(value->type)) && !storage_borrowed(static_cast<Syntax*>(value)) && (value->entity->data.variable.storage == storage_kind::local || value->entity->data.variable.storage == storage_kind::parameter)) {
							Syntax* relocation = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
							@relocation->kind = syntax_kind::expr_relocate;
							@relocation->token := value->token;
							@relocation->type := value->type;
							@relocation->data.expression := value;
							@syntax->data.expression = $relocation;
						};
						@this.owned(static_cast<Syntax*>(syntax->data.expression));
					};
				}
				else if (result->kind != type_kind::kw_void) {
					@compiler.diagnostics.report(syntax->token, "return requires a result value\0");
				};
			};
			break;
		case syntax_kind::kw_if: {
			Type* condition = @this.expression(static_cast<Syntax*>(syntax->data.branch.condition), static_cast<Type*>(compiler.bool_type));
			if (!condition || !condition->kind.is_scalar()) {
				@compiler.diagnostics.report(syntax->token, "condition requires a scalar value\0");
			};
			@this.nested_statement(static_cast<Syntax*>(syntax->data.branch.first));
			@this.nested_statement(static_cast<Syntax*>(syntax->data.branch.second));
			break;
		};
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			SemanticFlow flow;
			@flow.kind = flow_kind::loop;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			@this.statement(static_cast<Syntax*>(syntax->data.loop.initializer));
			if (syntax->data.loop.condition) {
				Type* condition = @this.expression(static_cast<Syntax*>(syntax->data.loop.condition), static_cast<Type*>(compiler.bool_type));
				if (!condition || !condition->kind.is_scalar()) {
					@compiler.diagnostics.report(syntax->token, "condition requires a scalar value\0");
				};
			};
			@this.statement(static_cast<Syntax*>(syntax->data.loop.body));
			if (syntax->data.loop.step) {
				@this.expression(static_cast<Syntax*>(syntax->data.loop.step), nullptr);
			};
			@this.scope = &outer;
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_switch: {
			Type* type = @this.expression(static_cast<Syntax*>(syntax->data.selection.value), nullptr);
			Type* representation = type_representation(static_cast<Type*>(type));
			if (!representation || !representation->kind.is_integer()) {
				@compiler.diagnostics.report(syntax->token, "switch requires an integer value or an enum with integer underlying storage\0");
				break;
			};
			@this.selection_validate(static_cast<Syntax*>(syntax), static_cast<Type*>(type));
			SemanticFlow flow;
			@flow.kind = flow_kind::kw_switch;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Type* outer := this.selection_type;
			@this.selection_type = static_cast<Type*>(type);
			Scope& outer_scope = @*this.scope;
			Scope* created = @this.create_scope(*syntax->data.selection.cases->scope);
			if (!created) {
				return;
			};
			Scope& cases = @*created;
			@syntax->data.selection.cases->scope = &cases;
			@this.scope = &cases;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement(static_cast<Syntax*>(statement));
				@statement := statement->next;
			};
			@this.scope = &outer_scope;
			@this.selection_type = static_cast<Type*>(outer);
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_case:
			if (!this.flow || this.flow->kind != flow_kind::kw_switch) {
				@compiler.diagnostics.report(syntax->token, "case requires a switch context\0");
			};
			if (syntax->data.selection_case.value) {
				constant_integer(@compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(syntax->data.selection_case.value));
			};
			break;
		case syntax_kind::kw_break:
		case syntax_kind::kw_continue: {
			SemanticFlow* flow := this.flow;
			if (syntax->kind == syntax_kind::kw_continue) {
				while (flow && flow->kind != flow_kind::loop) {
					@flow := flow->parent;
				};
			};
			if (!flow) {
				@compiler.diagnostics.report(syntax->token, "flow statement has no enclosing target\0");
			};
			break;
		};
		default: {
			Type* type = @this.expression(static_cast<Syntax*>(syntax), nullptr);
			if (syntax->kind != syntax_kind::stmt_bind_reference && (type->kind == type_kind::named || type->kind == type_kind::array)) {
				layout_validate(@compiler, static_cast<Type*>(type), nullptr, syntax->token);
			};
			break;
		};
	};
};

