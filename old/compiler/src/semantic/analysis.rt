fn Semantic::selection_validate(Semantic& this, Syntax* syntax, Type* type) {
	Syntax* statement := syntax->data.selection.cases->data.statements;
	CaseValue* values = nullptr;
	Syntax* fallback = nullptr;
	while (statement && this.compiler->result != compilation_result::failure) {
		if (statement->kind != syntax_kind::kw_case) {
			@statement := statement->next;
			continue;
		};

		Syntax* expression := statement->data.selection_case.value;
		if (!expression) {
			if (fallback) {
				@this.compiler->diagnostics.report(statement->token, "duplicate default label\0");
				return;
			};
			@fallback := statement;
			@statement := statement->next;
			continue;
		};

		@expression->type := type;
		@expression->scope := syntax->data.selection.cases->scope;
		u64 value = constant_integer(@*this.compiler, static_cast<Scope*>(expression->scope), $expression);
		@value = constant_selector(static_cast<u64>(value), static_cast<Type*>(type));
		@statement->data.selection_case.selector := value;
		CaseValue* previous := values;
		while (previous) {
			if (previous->value == value) {
				@this.compiler->diagnostics.report(statement->token, "duplicate case value after conversion to the selector type\0");
				return;
			};
			@previous := previous->next;
		};

		CaseValue* selected = static_cast<CaseValue*>(@this.compiler->allocate(sizeof(CaseValue)));
		if (!selected) {
			return;
		};
		@selected->value = $value;
		@selected->next := values;
		@values = $selected;
		@statement := statement->next;
	};
};

fn Semantic::argument_block(Semantic& this, Syntax* argument, Type* type, ParameterUse* label) {
	var references = ReferenceAnalysis(this.compiler, this.scope);
	if (argument->type) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	Token name := argument->token;
	if (label && label->name.source) {
		@name := label->name;
	};
	@argument->scope->context = context_kind::arguments;
	Entity* storage = entity_create(@compiler, entity_kind::variable, $name);
	@storage->state = resolution::ready;
	@storage->data.variable.type := type;
	if (label) {
		@storage->data.variable.type_use := label->use;
	};
	@storage->data.variable.storage = storage_kind::argument;
	@storage->declaration := argument;
	@storage->scope := argument->scope;
	@argument->scope->owner := storage;
	if (type->kind == type_kind::reference) {
		@references.initializer(static_cast<Syntax*>(argument), static_cast<Entity*>(storage), Token(argument->token));
	}
	else {
		if (label && label->name.source) {
			@(argument->scope)->define(static_cast<Entity*>(storage));
		};
		@references.prepare_object(static_cast<Entity*>(storage), static_cast<Syntax*>(argument), Token(argument->token));
		@argument->use = value_use::transferred;
	};
	@argument->entity = $storage;
	@this.statement(static_cast<Syntax*>(argument));
	@argument->type = $type;
};

fn Semantic::create_scope(Semantic& this, const Scope& parsed) -> Scope* {
	Scope* created = @this.compiler->create_scope(Scope*(this.scope), context_kind(parsed.context), Entity*(parsed.owner));
	if (!created) {
		return nullptr;
	};
	Scope& scope = @*created;

	Binding* binding := parsed.bindings;
	while (binding) {
		Entity& entity = @*binding->entity;
		if (entity.kind != entity_kind::variable || entity.data.variable.storage == storage_kind::parameter || entity.data.variable.storage == storage_kind::argument || entity.data.variable.storage == storage_kind::constant) {
			@(&scope)->define(&entity);
		};
		@binding := binding->next;
	};

	if (parsed.context == context_kind::function && parsed.parent) {
		@binding := parsed.parent->bindings;
		while (binding) {
			if (binding->entity->kind == entity_kind::variable && binding->entity->data.variable.storage == storage_kind::parameter) {
				@(&scope)->define(Entity*(binding->entity));
			};
			@binding := binding->next;
		};
	};

	return &scope;
};

fn Semantic::member_project(Semantic& this, Syntax* member, Type* source, Type* target) -> Type* {
	if (type_value_equal(static_cast<Type*>(source), static_cast<Type*>(target))) {
		return $source;
	};
	@target = @this.compiler->semantic.types.qualified(static_cast<Type*>(target), static_cast<type_qualifier>(source->qualifier));
	Type* expected = nullptr;
	if (member->token.kind == token_kind::op_arrow) {
		@expected = @this.compiler->semantic.types.pointer(static_cast<Type*>(target));
	}
	else {
		@expected = @this.compiler->semantic.types.indirect(type_kind::reference, static_cast<Type*>(target));
	};
	if (!@this.base_conversion(static_cast<Syntax*>(member->data.member.object), static_cast<Type*>(member->data.member.object->type), static_cast<Type*>(expected))) {
		@this.compiler->diagnostics.report(member->token, "member owner is not an unambiguous base of its receiver\0");
	};
	return static_cast<Type*>(expected->data.element);
};

fn Semantic::member_object(Semantic& this, Syntax* member) -> Type* {
	Type* object = @this.expression(static_cast<Syntax*>(member->data.member.object), nullptr);
	if (member->token.kind == token_kind::op_arrow) {
		if (object->kind != type_kind::pointer) {
			@this.compiler->diagnostics.report(member->token, "arrow member access requires a pointer\0");
			return static_cast<Type*>(this.compiler->void_type);
		};
		@object := object->data.element;
	};
	if (!member->data.member.qualifier) {
		return $object;
	};
	Type* owner = named_type(@*this.compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(member->data.member.qualifier));
	if (owner->kind != type_kind::named || (owner->data.entity->kind != entity_kind::kw_struct && owner->data.entity->kind != entity_kind::kw_union)) {
		@this.compiler->diagnostics.report(member->token, "qualified instance access requires a record type\0");
		return static_cast<Type*>(this.compiler->void_type);
	};
	return @this.member_project($member, $object, $owner);
};

fn Semantic::constructor_designates(Semantic& this, Type* owner, const Token& name) -> bool {
	if (!owner->kind.is_object()) {
		return false;
	};
	if (owner->kind == type_kind::named && name.same(owner->data.entity->name)) {
		return true;
	};
	Entity* entity = this.scope->lookup(name);
	if (!entity || (entity->kind != entity_kind::primitive && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union && entity->kind != entity_kind::kw_enum)) {
		return false;
	};
	entity_resolve(@*this.compiler, static_cast<Entity*>(entity));
	return type_value_equal(static_cast<Type*>(owner), entity_type($entity));
};

fn Semantic::method_receiver(Semantic& this, Syntax* member) -> Syntax* {
	Syntax* receiver := member->data.member.object;
	Type* type = @this.expression(static_cast<Syntax*>(receiver), nullptr);
	if (member->token.kind != token_kind::op_arrow) {
		return $receiver;
	};
	if (type->kind != type_kind::pointer) {
		@this.compiler->diagnostics.report(member->token, "arrow member access requires a pointer\0");
		return $receiver;
	};
	Syntax* object = static_cast<Syntax*>(@this.compiler->allocate(sizeof(Syntax)));
	@object->kind = syntax_kind::expr_unary;
	@object->token := member->token;
	@object->data.unary.operation = token_kind::op_star;
	@object->data.unary.value = $receiver;
	@object->type = type_effective(static_cast<Type*>(type->data.element));
	return $object;
};

fn Semantic::comparison_function_add(Semantic& this, Entity** selected, Entity* candidate, Syntax* left, Syntax* right, const Token& name) {
	Compiler& compiler = @*this.compiler;
	if (!candidate || candidate->kind != entity_kind::function || *selected == candidate) {
		return;
	};
	entity_resolve(@compiler, static_cast<Entity*>(candidate));
	if (compiler.result == compilation_result::failure || function_receiver(static_cast<Entity*>(candidate))) {
		return;
	};
	Parameter* parameter := candidate->data.function.type->data.function.parameters;
	if (!parameter || !parameter->next || parameter->next->next || @this.conversion_rank(static_cast<Syntax*>(left), static_cast<Type*>(parameter->type), constructor_conversion::kw_explicit) < 0 || @this.conversion_rank(static_cast<Syntax*>(right), static_cast<Type*>(parameter->next->type), constructor_conversion::kw_explicit) < 0) {
		return;
	};
	if (*selected) {
		@compiler.diagnostics.report(name, "ambiguous comparison operator\0");
		return;
	};
	@*selected = $candidate;
};

fn Semantic::comparison_namespace_lookup(Semantic& this, Entity** selected, Type* type, Syntax* left, Syntax* right, const Token& name) {
	if (!type || type->kind != type_kind::named) {
		return;
	};
	Scope* scope := type->data.entity->scope;
	while (scope && scope->owner && scope->owner->kind != entity_kind::kw_namespace) {
		@scope := scope->parent;
	};
	if (scope) {
		@this.comparison_function_add(static_cast<Entity**>(selected), scope->local(name), static_cast<Syntax*>(left), static_cast<Syntax*>(right), name);
	};
};

fn Semantic::receiver_callable(Semantic& this, Type* type, Token name) -> Entity* {
	Entity* associated = nullptr;
	if (type->kind == type_kind::named && (type->data.entity->kind == entity_kind::kw_struct || type->data.entity->kind == entity_kind::kw_union || type->data.entity->kind == entity_kind::kw_enum)) {
		entity_resolve(@*this.compiler, static_cast<Entity*>(type->data.entity));
		@associated = associated_lookup(@*this.compiler, static_cast<Entity*>(type->data.entity), name);
	};
	if (associated) {
		return $associated;
	};
	Entity* lexical = this.scope->lookup(name);
	if (!lexical || lexical->kind != entity_kind::function) {
		return nullptr;
	};
	entity_resolve(@*this.compiler, static_cast<Entity*>(lexical));
	Parameter* first := lexical->data.function.type->data.function.parameters;
	if (!first || !function_receiver(static_cast<Entity*>(lexical))) {
		return nullptr;
	};
	return $lexical;
};

fn Semantic::address(Semantic& this, Syntax* syntax) -> Type* {
	if (syntax->kind == syntax_kind::expr_access) {
		Type* type = @this.address(static_cast<Syntax*>(syntax->data.expression));
		if (syntax_category(static_cast<Syntax*>(syntax->data.expression)) != value_category::storage || type->qualifier == type_qualifier::kw_const) {
			@this.compiler->diagnostics.report(syntax->token, "mutable access requires mutable storage\0");
		};
		@syntax->type := type;
		return $type;
	};
	if (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star) {
		Type* pointer = @this.expression(static_cast<Syntax*>(syntax->data.unary.value), nullptr);
		if (pointer->kind != type_kind::pointer) {
			@this.compiler->diagnostics.report(syntax->token, "dereference requires a pointer\0");
			return static_cast<Type*>(this.compiler->void_type);
		};
		Type* type := pointer->data.element;
		if (type->kind == type_kind::kw_void || type->kind == type_kind::kw_null) {
			@this.compiler->diagnostics.report(syntax->token, "dereference requires an object or function type\0");
		};
		@syntax->type := type;
		return $type;
	};
	return @this.expression($syntax, nullptr);
};

fn Semantic::expression(Semantic& this, Syntax* syntax, Type* expected) -> Type* {
	var references = ReferenceAnalysis(this.compiler, this.scope);
	Compiler& compiler = @*this.compiler;
	if (!syntax) {
		return static_cast<Type*>(compiler.void_type);
	};
	if (syntax->kind == syntax_kind::expr_typed_apply) {
		construction_resolve(@compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(syntax));
		if (compiler.result == compilation_result::failure) {
			return static_cast<Type*>(compiler.void_type);
		};
	};
	Type* target := expected;
	if (target && target->kind == type_kind::reference && target->data.element->qualifier == type_qualifier::kw_const) {
		@target := target->data.element;
	};
	if (target && target->kind == type_kind::named && (target->data.entity->kind == entity_kind::kw_struct || target->data.entity->kind == entity_kind::kw_union)) {
		Type* actual = nullptr;
		if (!syntax_number_expression(static_cast<Syntax*>(syntax))) {
			@actual = @this.expression(static_cast<Syntax*>(syntax), nullptr);
		};
		if (!actual || !type_value_equal(static_cast<Type*>(actual), static_cast<Type*>(target))) {
			Syntax* next := syntax->next;
			@syntax->next = nullptr;
			Entity* constructor = @this.conversion_select(static_cast<Entity*>(target->data.entity), function_role::constructor, static_cast<Syntax*>(syntax), syntax->token, constructor_conversion::kw_implicit);
			@syntax->next = $next;
			if (constructor) {
				value_use argument_use := syntax->use;
				syntax_construct(@compiler, static_cast<Syntax*>(syntax), static_cast<Type*>(target), nullptr);
				@syntax->data.construction.arguments->use = $argument_use;
				@syntax->use = value_use::observed;
				@syntax->data.construction.constructor = $constructor;
				Type* converted = @this.expression(static_cast<Syntax*>(syntax), nullptr);
				return @this.expect(static_cast<Syntax*>(syntax), $converted, static_cast<Type*>(expected));
			};
		};
	};
	if (expected && expected->kind == type_kind::reference && syntax_number_expression(static_cast<Syntax*>(syntax))) {
		Type* actual = @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected->data.element));
		return @this.expect(static_cast<Syntax*>(syntax), $actual, static_cast<Type*>(expected));
	};
	if (expected && expected->kind == type_kind::reference && (syntax->kind == syntax_kind::expr_access || (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star))) {
		Type* actual = @this.address(static_cast<Syntax*>(syntax));
		return @this.expect(static_cast<Syntax*>(syntax), $actual, $expected);
	};
	if (syntax->type) {
		return @this.expect(static_cast<Syntax*>(syntax), static_cast<Type*>(syntax->type), static_cast<Type*>(expected));
	};
	Type* type = nullptr;
	switch (syntax->kind) {
		case syntax_kind::kw_new: {
			Syntax* construction := syntax->data.allocation.construction;
			Syntax* count := syntax->data.allocation.count;
			if (count) {
				Type* context = nullptr;
				if (syntax_number_expression(static_cast<Syntax*>(count))) {
					@context := compiler.usize_type;
				};
				Type* length = @this.expression(static_cast<Syntax*>(count), $context);
				if (!(length && length->kind.is_integer())) {
					@compiler.diagnostics.report(count->token, "array allocation length requires an integer\0");
				};
			};
			Type* allocated = @this.expression(static_cast<Syntax*>(construction), nullptr);
			if (compiler.result == compilation_result::failure) {
				return static_cast<Type*>(compiler.void_type);
			};
			@construction->use = value_use::transferred;
			Syntax* argument := construction->data.construction.arguments;
			while (argument) {
				if (argument->use == value_use::transferred) {
					destruction_request(static_cast<Type*>(argument->type));
				};
				@argument := argument->next;
			};
			if (allocated->kind == type_kind::kw_void || allocated->kind == type_kind::kw_null || allocated->kind == type_kind::reference || allocated->kind == type_kind::function) {
				@compiler.diagnostics.report(syntax->token, "new requires a complete object type\0");
			};
			layout_validate(@compiler, static_cast<Type*>(allocated), nullptr, syntax->token);
			@type = @compiler.semantic.types.pointer($allocated);
			@syntax->type_use = type_use_element(@compiler, static_cast<TypeUse*>(construction->data.construction.type_use));
			break;
		};
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard: {
			Type* pointer = @this.expression(static_cast<Syntax*>(syntax->data.expression), nullptr);
			if (pointer->kind != type_kind::pointer || pointer->data.element->kind == type_kind::function) {
				@compiler.diagnostics.report(syntax->token, "delete requires an object pointer\0");
				@type := compiler.void_type;
				break;
			};
			if (syntax->kind == syntax_kind::kw_delete && pointer->data.element->kind != type_kind::kw_null) {
				if (pointer->data.element->kind == type_kind::kw_void) {
					@compiler.diagnostics.report(syntax->token, "delete requires a complete object type\0");
				};
				layout_validate(@compiler, static_cast<Type*>(pointer->data.element), nullptr, syntax->token);
				destruction_request(static_cast<Type*>(pointer->data.element));
			};
			@type := compiler.void_type;
			break;
		};
		case syntax_kind::kw_nullptr:
			@type = @compiler.semantic.types.pointer(static_cast<Type*>(compiler.null_type));
			break;
		case syntax_kind::expr_destroy: {
			Type* target := syntax->data.cast.resolved;
			if (!target) {
				@target = type_resolve(@compiler, static_cast<Scope*>(this.scope), static_cast<TypeSyntax*>(syntax->data.cast.type));
			};
			Type* actual = @this.address(static_cast<Syntax*>(syntax->data.cast.value));
			if (!target->kind.is_object() || !type_value_equal(static_cast<Type*>(actual), static_cast<Type*>(target))) {
				@compiler.diagnostics.report(syntax->token, "destructor type must match the object type\0");
			};
			if (syntax_category(static_cast<Syntax*>(syntax->data.cast.value)) != value_category::storage || !syntax_mutable_access(static_cast<Syntax*>(syntax->data.cast.value))) {
				@compiler.diagnostics.report(syntax->token, "destructor invocation requires explicit '@' access to storage\0");
			};
			layout_validate(@compiler, static_cast<Type*>(target), nullptr, syntax->token);
			destruction_request(static_cast<Type*>(target));
			@type := compiler.void_type;
			break;
		};
		case syntax_kind::kw_discard:
			@this.expression(static_cast<Syntax*>(syntax->data.expression), nullptr);
			if (syntax->data.expression->kind != syntax_kind::expr_name || !syntax->data.expression->entity || syntax->data.expression->entity->kind != entity_kind::variable || storage_borrowed(static_cast<Syntax*>(syntax->data.expression)) || (syntax->data.expression->entity->data.variable.storage != storage_kind::local && syntax->data.expression->entity->data.variable.storage != storage_kind::parameter)) {
				@compiler.diagnostics.report(syntax->token, "discard requires a directly owned local identifier\0");
			};
			@type := compiler.void_type;
			break;
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate: {
			Syntax* operand := syntax->data.expression;
			if (syntax->kind == syntax_kind::expr_access && operand->kind == syntax_kind::expr_destroy) {
				Syntax* access = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
				@access->kind = syntax_kind::expr_access;
				@access->token := syntax->token;
				@access->data.expression := operand->data.cast.value;
				@operand->data.cast.value = $access;
				Syntax* next := syntax->next;
				@*syntax := *operand;
				@syntax->next = $next;
				return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
			};
			if (syntax->kind == syntax_kind::expr_access && operand->kind == syntax_kind::expr_call && operand->data.call.callable->kind == syntax_kind::expr_member) {
				Syntax* member := operand->data.call.callable;
				Syntax* receiver = @this.method_receiver(static_cast<Syntax*>(member));
				Type* owner := receiver->type;
				if (member->data.member.qualifier) {
					@owner = named_type(@compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(member->data.member.qualifier));
				};
				if (@this.constructor_designates(static_cast<Type*>(owner), member->data.member.name)) {
					Syntax* access = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
					@access->kind = syntax_kind::expr_access;
					@access->token := syntax->token;
					@access->data.expression = $receiver;
					@member->data.member.object = $access;
					@member->token.kind = token_kind::op_dot;
					Syntax* next := syntax->next;
					@*syntax := *operand;
					@syntax->next = $next;
					return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
				};
				Entity* function = @this.receiver_callable(static_cast<Type*>(owner), Token(member->data.member.name));
				if (function && function->kind == entity_kind::function) {
					entity_resolve(@compiler, static_cast<Entity*>(function));
					Parameter* first := function->data.function.type->data.function.parameters;
					if (first && function_receiver(static_cast<Entity*>(function))) {
						Syntax* access = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
						@access->kind = syntax_kind::expr_access;
						@access->token := syntax->token;
						@access->data.expression = $receiver;
						@member->data.member.object = $access;
						@member->token.kind = token_kind::op_dot;
						Syntax* next := syntax->next;
						@*syntax := *operand;
						@syntax->next = $next;
						return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
					};
				};
			};
			@type = @this.expression(static_cast<Syntax*>(operand), nullptr);
			if (syntax_category(static_cast<Syntax*>(operand)) != value_category::storage) {
				@compiler.diagnostics.report(syntax->token, "reference access and relocation require an existing object\0");
			};
			if (syntax->kind == syntax_kind::expr_access && type->qualifier == type_qualifier::kw_const) {
				@compiler.diagnostics.report(syntax->token, "immutable object cannot provide mutable access\0");
			};
			if (syntax->kind == syntax_kind::expr_relocate && type->qualifier == type_qualifier::kw_const) {
				@compiler.diagnostics.report(syntax->token, "relocation requires a mutable object\0");
			};
			if (syntax->kind == syntax_kind::expr_relocate && !operand->indirect_storage() && (operand->kind != syntax_kind::expr_name || !operand->entity || operand->entity->kind != entity_kind::variable || storage_borrowed(static_cast<Syntax*>(operand)))) {
				@compiler.diagnostics.report(syntax->token, "relocation requires an owned local binding or indirect object storage\0");
			};
			break;
		};
		case syntax_kind::expr_construct: {
			@type := syntax->data.construction.target;
			if (type->kind == type_kind::kw_null) {
				@compiler.diagnostics.report(syntax->token, "null is an unsized type and cannot be constructed\0");
				break;
			};
			Syntax* argument := syntax->data.construction.arguments;
			if (type->kind == type_kind::named && (type->data.entity->kind == entity_kind::kw_struct || type->data.entity->kind == entity_kind::kw_union || type->data.entity->kind == entity_kind::kw_enum)) {
				if (!syntax->data.construction.constructor) {
				@syntax->data.construction.constructor = @this.special_select(static_cast<Entity*>(type->data.entity), function_role::constructor, static_cast<Syntax*>(argument), Token(syntax->token));
				};
				if (syntax->data.construction.constructor || compiler.result == compilation_result::failure) {
					if (syntax->data.construction.constructor && syntax->data.construction.constructor->data.function.definition != function_definition::defaulted) {
						@this.constructor_members_validate(static_cast<Type*>(type), syntax->token);
					};
					if (syntax->data.construction.constructor && type_has_reference(static_cast<Type*>(type))) {
						@compiler.diagnostics.report(syntax->token, "constructor reference-field binding syntax is not implemented\0");
					};
					break;
				};
			};
			if (!argument) {
				@this.generated_operation_validate(static_cast<Type*>(type), generated_operation::kw_default, syntax->token);
				break;
			};
			if (argument->next) {
				@compiler.diagnostics.report(syntax->token, "generated construction requires zero or one argument\0");
				break;
			};
			Type* context := type;
			if (type_enum(static_cast<Type*>(type))) {
				entity_resolve(@compiler, static_cast<Entity*>(type->data.entity));
				@context := type->data.entity->data.enumeration.underlying;
			};
			Type* argument_context = nullptr;
			if (argument->kind == syntax_kind::node_block || syntax_number_expression(static_cast<Syntax*>(argument))) {
				@argument_context := context;
			};
			if (argument->kind == syntax_kind::node_block) {
				@this.argument_block(static_cast<Syntax*>(argument), static_cast<Type*>(context), nullptr);
			};
			Type* actual = @this.expression(static_cast<Syntax*>(argument), static_cast<Type*>(argument_context));
			if (type_enum(static_cast<Type*>(type)) && type_value_equal(static_cast<Type*>(actual), static_cast<Type*>(type))) {
				@context := type;
			};
			Type* representation = type_representation(static_cast<Type*>(actual));
