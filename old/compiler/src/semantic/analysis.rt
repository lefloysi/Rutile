				Entity* function = @this.receiver_callable(static_cast<Type*>(a), Token(name));
				if (function) {
					Syntax* member = syntax_create(@compiler, syntax_kind::expr_member, Token(syntax->token));
					@member->token.kind = token_kind::op_dot;
					@member->data.member.object := left;
					@member->data.member.name = Token(name);
					@syntax->kind = syntax_kind::expr_call;
					@syntax->data.call = CallSyntax();
					@syntax->data.call.callable = $member;
					@syntax->data.call.arguments := right;
					return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
				};
			};

			Type* right_context := operand;
			if (a->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				@right_context = nullptr;
				if (syntax_number_expression(static_cast<Syntax*>(right))) {
					@right_context := compiler.usize_type;
				};
			};
			if (!b) {
				@b = @this.expression(static_cast<Syntax*>(right), static_cast<Type*>(right_context));
			};
			if (a->kind == type_kind::pointer && b->kind == type_kind::pointer && (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) && !type_equal(static_cast<Type*>(a), static_cast<Type*>(b))) {
				BaseSearch forward = base_search(@compiler, static_cast<Type*>(b->data.element), static_cast<Type*>(a->data.element));
				BaseSearch reverse = base_search(@compiler, static_cast<Type*>(a->data.element), static_cast<Type*>(b->data.element));
				if (forward.count == 1) {
					@this.expect(static_cast<Syntax*>(right), static_cast<Type*>(b), static_cast<Type*>(a));
					@b := a;
				}
				else if (reverse.count == 1 || type_pointer_conversion(static_cast<Type*>(a), static_cast<Type*>(b))) {
					@this.expect(static_cast<Syntax*>(left), static_cast<Type*>(a), static_cast<Type*>(b));
					@a := b;
					@right_context := b;
				};
			};
			@this.expect(static_cast<Syntax*>(right), static_cast<Type*>(b), static_cast<Type*>(right_context));
			if (a->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				layout_validate(@compiler, static_cast<Type*>(a->data.element), nullptr, syntax->token);
				if (!(b && b->kind.is_integer())) {
					@compiler.diagnostics.report(right->token, "pointer offset requires an integer\0");
				};
				@type := a;
				break;
			};
			if (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) {
				Type* representation = type_representation(static_cast<Type*>(a));
				if ((!(a && a->kind.is_scalar()) || !(b && b->kind.is_scalar())) && !(type_enum(static_cast<Type*>(a)) && (representation && representation->kind.is_scalar()) && type_value_equal(static_cast<Type*>(a), static_cast<Type*>(b)))) {
					@compiler.diagnostics.report(syntax->token, "comparison requires scalar operands or matching enum types\0");
				};
				@type := compiler.bool_type;
			}
			else {
				if (!(a && a->kind.is_numeric()) || !type_value_equal(static_cast<Type*>(a), static_cast<Type*>(b))) {
					@compiler.diagnostics.report(syntax->token, "arithmetic requires matching numeric operands\0");
				};
				if ((operation == token_kind::op_remainder || operation == token_kind::op_ampersand || operation == token_kind::op_pipe || operation == token_kind::op_caret || operation == token_kind::op_shift_left || operation == token_kind::op_shift_right) && !(a && a->kind.is_integer())) {
					@compiler.diagnostics.report(syntax->token, "operation requires integer operands\0");
				};
				@type = static_cast<Type*>(a);
				if (type->kind == type_kind::kw_bool) {
					@type := compiler.i32_type;
				};
			};
			break;
		};
		case syntax_kind::expr_call: {
			Syntax* callable_syntax := syntax->data.call.callable;
			if (callable_syntax->kind == syntax_kind::expr_name) {
				Entity* callable_entity = syntax_lookup(static_cast<Scope*>(this.scope), static_cast<Syntax*>(callable_syntax));
				if (callable_entity && callable_entity->kind == entity_kind::kw_template && callable_entity->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					@callable_entity = @this.template_deduce(static_cast<Entity*>(callable_entity), static_cast<Syntax*>(callable_syntax), static_cast<Syntax*>(syntax->data.call.arguments));
					if (!callable_entity) {
						return static_cast<Type*>(compiler.void_type);
					};
					@callable_syntax->entity := callable_entity;
				};
				if (callable_entity && (callable_entity->kind == entity_kind::primitive || callable_entity->kind == entity_kind::kw_struct || callable_entity->kind == entity_kind::kw_union || callable_entity->kind == entity_kind::kw_enum)) {
					Syntax* arguments := syntax->data.call.arguments;
					Type* target = named_type(@compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(callable_syntax));
					TypeUse* target_use = nullptr;
					if (callable_entity->kind == entity_kind::primitive) {
						@target_use := callable_entity->data.primitive.type_use;
					};
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.destination = nullptr;
					@syntax->data.construction.target = static_cast<Type*>(target);
					@syntax->data.construction.type_use = $target_use;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = static_cast<Syntax*>(arguments);
					return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
				};
			};
			if (callable_syntax->kind == syntax_kind::expr_member) {
				Syntax* receiver = @this.method_receiver(static_cast<Syntax*>(callable_syntax));
				Type* owner := receiver->type;
				if (callable_syntax->data.member.qualifier) {
					@owner = named_type(@compiler, static_cast<Scope*>(this.scope), static_cast<Syntax*>(callable_syntax->data.member.qualifier));
					BaseSearch path = base_search(@compiler, static_cast<Type*>(receiver->type), static_cast<Type*>(owner));
					if (!path.count) {
						@compiler.diagnostics.report(callable_syntax->token, "qualified callable owner is not a base of its receiver\0");
						return static_cast<Type*>(compiler.void_type);
					};
					@syntax->data.call.qualified_owner := owner->data.entity;
				};
				if (@this.constructor_designates(static_cast<Type*>(owner), callable_syntax->data.member.name)) {
					if (owner->qualifier == type_qualifier::kw_const || (callable_syntax->token.kind != token_kind::op_arrow && (syntax_category(static_cast<Syntax*>(receiver)) != value_category::storage || !syntax_mutable_access(static_cast<Syntax*>(receiver))))) {
						@compiler.diagnostics.report(callable_syntax->token, "construction requires mutable storage\0");
						return static_cast<Type*>(compiler.void_type);
					};
					Syntax* arguments := syntax->data.call.arguments;
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.type_use = @this.expression_use(static_cast<Syntax*>(receiver));
					@syntax->data.construction.destination = $receiver;
					@syntax->data.construction.target := owner;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = $arguments;
					return @this.expression(static_cast<Syntax*>(syntax), static_cast<Type*>(expected));
				};
				Entity* function = @this.receiver_callable(static_cast<Type*>(owner), Token(callable_syntax->data.member.name));
				if (function && function->kind == entity_kind::kw_template && function->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					Syntax* input = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
					@*input := *receiver;
					@input->next := syntax->data.call.arguments;
					@function = @this.template_deduce(static_cast<Entity*>(function), static_cast<Syntax*>(callable_syntax), $input);
				};
				if (function && function->kind == entity_kind::function) {
					entity_resolve(@compiler, static_cast<Entity*>(function));
					Parameter* first := function->data.function.type->data.function.parameters;
					@syntax->data.call.receiver.value := receiver;
					if (first && function_receiver(static_cast<Entity*>(function))) {
						if (callable_syntax->data.member.qualifier && !type_equal(static_cast<Type*>(receiver->type), static_cast<Type*>(owner))) {
							Type* reference = @compiler.semantic.types.indirect(type_kind::reference, static_cast<Type*>(owner));
							@this.expect(static_cast<Syntax*>(receiver), static_cast<Type*>(receiver->type), static_cast<Type*>(reference));
						};
						@this.expect(static_cast<Syntax*>(receiver), static_cast<Type*>(receiver->type), static_cast<Type*>(first->type));
						@syntax->data.call.receiver.kind = receiver_kind::bind;
					}
					else {
						@syntax->data.call.receiver.kind = receiver_kind::evaluate;
					};
					Syntax* direct = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
					@direct->kind = syntax_kind::expr_name;
					@direct->token := callable_syntax->data.member.name;
					@direct->entity = static_cast<Entity*>(function);
					@syntax->data.call.callable = static_cast<Syntax*>(direct);
				};
			};
			Type* callable = @this.expression(static_cast<Syntax*>(syntax->data.call.callable), nullptr);
			TypeUse* callable_use = @this.expression_use(static_cast<Syntax*>(syntax->data.call.callable));
			if (callable->kind == type_kind::pointer) {
				@callable := callable->data.element;
				if (callable_use) {
					@callable_use := callable_use->data.element;
				};
			};
			if (callable->kind != type_kind::function) {
				@compiler.diagnostics.report(syntax->token, "call requires a function entity or function pointer\0");
				return static_cast<Type*>(compiler.void_type);
			};
			if (callable->data.function.result->kind != type_kind::kw_void) {
				layout_validate(@compiler, static_cast<Type*>(callable->data.function.result), nullptr, syntax->token);
			};
			Parameter* complete := callable->data.function.parameters;
			while (complete) {
				layout_validate(@compiler, static_cast<Type*>(complete->type), nullptr, syntax->token);
				@complete := complete->next;
			};
			Parameter* parameter := callable->data.function.parameters;
			ParameterUse* label = nullptr;
			if (callable_use) {
				@label := callable_use->data.callable.parameters;
			};
			Syntax* direct := syntax->data.call.callable;
			if (syntax->data.call.receiver.kind == receiver_kind::none && direct->kind == syntax_kind::expr_name && !direct->data.expression && direct->entity && direct->entity->scope && direct->entity->scope->owner && (direct->entity->scope->owner->kind == entity_kind::kw_struct || direct->entity->scope->owner->kind == entity_kind::kw_union) && parameter && label && label->name.is("this\0")) {
				Entity* current = this.scope->lookup(token_synthetic(@compiler, Token(direct->token), "this\0"));
				if (current) {
					Syntax* receiver = static_cast<Syntax*>(@compiler.allocate(sizeof(Syntax)));
					@receiver->kind = syntax_kind::expr_name;
					@receiver->token := current->name;
					@receiver->entity = static_cast<Entity*>(current);
					@this.expression(static_cast<Syntax*>(receiver), static_cast<Type*>(parameter->type));
					@syntax->data.call.receiver.value = static_cast<Syntax*>(receiver);
					@syntax->data.call.receiver.kind = receiver_kind::bind;
				};
			};
			if (syntax->data.call.receiver.kind == receiver_kind::bind) {
				@parameter := parameter->next;
				if (label) {
					@label := label->next;
				};
			};
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (!parameter && callable->data.function.arity != parameter_arity::variadic) {
					@compiler.diagnostics.report(argument->token, "too many arguments\0");
					break;
				};
				Type* destination = nullptr;
				if (parameter) {
					@destination := parameter->type;
				};
				if (argument->kind == syntax_kind::node_block) {
					if (!parameter || !label || !label->name.source) {
						@compiler.diagnostics.report(argument->token, "argument block requires a named parameter\0");
					}
					else {
						@this.argument_block(static_cast<Syntax*>(argument), static_cast<Type*>(destination), static_cast<ParameterUse*>(label));
					};
				}
				else {
					Type* actual = @this.expression(static_cast<Syntax*>(argument), static_cast<Type*>(destination));
					if (!destination || destination->kind != type_kind::reference) {
						@this.owned(static_cast<Syntax*>(argument));
					};
					if (!parameter && type_aggregate(static_cast<Type*>(actual))) {
						@compiler.diagnostics.report(argument->token, "aggregate C variadic arguments require ABI lowering that is not supported yet\0");
					};
				};
				if (parameter) {
					@parameter := parameter->next;
				};
				if (label) {
					@label := label->next;
				};
				@argument := argument->next;
			};
			if (parameter) {
				@compiler.diagnostics.report(syntax->token, "too few arguments\0");
			};
			@type = type_effective(static_cast<Type*>(callable->data.function.result));
			break;
		};
		case syntax_kind::node_block:
			@this.statement(static_cast<Syntax*>(syntax));
			@type := compiler.void_type;
			break;
		default:
			@compiler.diagnostics.report(syntax->token, "expected value expression\0");
			@type := compiler.void_type;
			break;
	};
	@type = type_effective(static_cast<Type*>(type));
	@syntax->type := type;
	return @this.expect($syntax, $type, $expected);
};

