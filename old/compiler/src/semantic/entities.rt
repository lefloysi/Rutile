enum template_parameter_kind : [i32] {
	type;
	value;
};

struct TemplateParameter {
	TypeSyntax* constness;
	TypeSyntax* type;
	ArgumentSyntax* default_argument;
	TemplateParameter* next;
	Token name;
	template_parameter_kind kind;
};

struct TemplateArgument {
	TypeUse* type_use;
	Type* type;
	TemplateParameter* parameter;
	TemplateArgument* next;
	u64 value;
	template_parameter_kind kind;
};

struct TemplateDeclaration {
	SourceDeclaration* source;
	TypeSyntax* signature;
	Entity* pattern;
	Scope* definition_scope;
	TemplateParameter* parameters;
	TemplateDeclaration* next;
	TemplateDeclaration* pattern_next;
};
struct TemplateSpecialization {
	TemplateArgument* arguments;
	Entity* entity;
	Scope* scope;
	TemplateSpecialization* next;
	resolution validation;
};

struct TemplatePattern {
	TemplateDeclaration* declarations;
	TemplateDeclaration* definition;
	TemplateSpecialization* specializations;
	Scope* instances;
	resolution grammar;
	token_kind declaration_kind;
};

enum lifetime_status : [i32] {
	alive;
	relocated;
	discarded;
	ended;
};

enum reachability : [i32] {
	unreachable;
	reachable;
};

struct LifetimeObject {
	MirScope* scope;
	Entity* entity;
	LifetimeObject* next;
	lifetime_status status;
};

struct LifetimeState {
	LifetimeObject* objects;
	reachability path;
};

struct LifetimeCleanup {
	Entity* entity;
	LifetimeCleanup* next;
};

struct LifetimeAnalysis {
	Compiler* compiler;
	MirScope* scope;
	LifetimeState state;
};

enum type_kind : [i32] {
	kw_void;
	kw_null;
	kw_bool;
	kw_char;
	kw_signed;
	kw_unsigned;
	kw_float;
	named;
	pointer;
	reference;
	array;
	function;
	parameter;
};

fn type_kind::is_numeric(const type_kind& this) -> bool {
	return this == type_kind::kw_char || this == type_kind::kw_bool || this == type_kind::kw_signed || this == type_kind::kw_unsigned || this == type_kind::kw_float;
};

fn type_kind::is_integer(const type_kind& this) -> bool {
	return this.is_numeric() && this != type_kind::kw_float;
};

fn type_kind::is_scalar(const type_kind& this) -> bool {
	return this.is_numeric() || this == type_kind::pointer || this == type_kind::reference;
};

fn type_kind::is_object(const type_kind& this) -> bool {
	return this.is_numeric() || this == type_kind::named || this == type_kind::pointer || this == type_kind::array;
};

fn type_kind::is_unsigned(const type_kind& this) -> bool {
	return this == type_kind::kw_unsigned || this == type_kind::kw_bool;
};

struct ArrayType {
	Type* element;
	u64 count;
};

struct Parameter {
	Type* type;
	Parameter* next;
};

struct ParameterUse {
	TypeUse* use;
	ParameterUse* next;
	Token name;
};

struct CallableUse {
	ParameterUse* parameters;
	TypeUse* result;
};

union TypeUseData {
	TypeUse* element;
	CallableUse callable;
};

struct TypeUse {
	TypeUseData data;
};

struct TypeResolution {
	Type* type;
	TypeUse* use;
};

struct FunctionType {
	Parameter* parameters;
	Type* result;
	parameter_arity arity;
};

union TypeData {
	i32 bits;
	Entity* entity;
	Type* element;
	ArrayType array;
	FunctionType function;
};

enum type_qualifier : [i32] {
	mutable;
	kw_const;
};

struct Type {
	fn key_equal(const Type& this, const Type& second) -> bool;
	fn key_hash(const Type& this) -> usize;

	TypeData data;
	type_kind kind;
	type_qualifier qualifier;
};

struct TypeRecord {
	Type value;
	TypeRecord* next;
};

struct TypeStore {
	fn bind(TypeStore& this, compilation_result& result);
	fn primitive(TypeStore& this, type_kind kind, i32 bits) -> Type*;
	fn entity(TypeStore& this, type_kind kind, Entity* entity) -> Type*;
	fn indirect(TypeStore& this, type_kind kind, Type* element) -> Type*;
	fn pointer(TypeStore& this, Type* element) -> Type*;
	fn array(TypeStore& this, Type* element, u64 count) -> Type*;
	fn function(TypeStore& this, Type* result, Parameter* parameters, parameter_arity arity) -> Type*;
	fn qualified(TypeStore& this, Type* type, type_qualifier qualifier) -> Type*;

  private:
	fn intern(TypeStore& this, const Type& value) -> Type*;

	Arena allocations;
	TypeRecord*[1024] buckets;
	compilation_result* result;
};

enum entity_kind : [i32] {
	primitive;
	kw_struct;
	kw_union;
	kw_enum;
	function;
	variable;
	kw_namespace;
	kw_template;
};

enum resolution : [i32] {
	pending;
	active;
	ready;
};

enum context_kind : [i32] {
	module;
	kw_struct;
	kw_union;
	kw_enum;
	function;
	local;
	initialization;
	arguments;
};

struct Binding {
	Entity* entity;
	Scope* declaration_scope;
	Source* source;
	Binding* next;
	Binding* hash_next;
	Token name;
};

struct DeclarationRule {
	token_kind keyword;
	entity_kind entity;
	context_kind context;
};

struct QualifierParameter {
	Token name;
	Type* type;
	QualifierParameter* next;
};

struct Scope {
	fn local(const Scope& this, const Token& name) -> Entity*;
	fn lookup(const Scope& this, const Token& name) -> Entity*;
	fn bind_named(Scope& this, Token name, Entity* entity, Scope* declaration_scope, Source* source) -> i32;
	fn bind(Scope& this, Entity* entity) -> i32;
	fn define(Scope& this, Entity* entity) -> i32;

	Compiler* compiler;
	Scope* parent;
	Binding* bindings;
	Binding* last_binding;
	Binding** buckets;
	Entity* owner;
	QualifierParameter* qualifier_parameters;
	usize bucket_count;
	usize binding_count;
	context_kind context;
};

struct PrimitiveEntity {
	Type* type;
	TypeUse* type_use;
	TypeSyntax* source;
};

struct Field {
	Entity* entity;
	Field* next;
};

enum base_kind : [i32] {
	nonvirtual;
	kw_virtual;
};

struct VirtualType {
	Entity* entity;
	VirtualType* next;
	usize index;
};

enum subobject_kind : [i32] {
	root;
	nonvirtual;
	kw_virtual;
};

struct SubobjectEdge {
	BaseRelation* relation;
	Subobject* target;
	SubobjectEdge* next;
};

struct Subobject {
	Entity* entity;
	SubobjectEdge* edges;
	Subobject* next;
	Subobject* virtual_next;
	u64 offset;
	usize component;
	subobject_kind kind;
};

struct CompleteGraph {
	Entity* entity;
	Subobject* root;
	Subobject* objects;
	Subobject* last_object;
	Subobject* virtuals;
	Subobject* last_virtual;
};

struct RuntimeThunk {
	Subobject* receiver;
	VirtualCallable* callable;
	LLVMOpaqueValue* function;
	RuntimeThunk* next;
	VirtualTarget target;
};

struct RuntimeWrapper {
	Entity* entity;
	RuntimeWrapper* next;
};

struct RuntimeView {
	CompleteGraph* graph;
	Subobject* object;
	LLVMOpaqueValue* value;
	RuntimeView* next;
	RuntimeView* pending_next;
};

struct BaseRelation {
	NameSyntax* name;
	Entity* entity;
	BaseRelation* next;
	usize component;
	base_kind kind;
};

struct BasePath {
	BaseRelation* relation;
	BasePath* next;
};

struct BaseSearch {
	BasePath* path;
	usize count;
};

struct AggregateEntity {
	Type* type;
	Scope* scope;
	Field* fields;
	BaseRelation* bases;
	VirtualType* virtual_types;
	VirtualCallable* virtual_callables;
	CompleteGraph* complete_graph;
	Entity* constructors;
	Entity* assignments;
	Entity* destructor;
	usize field_count;
	resolution bases_resolution;
};

struct EnumEntity {
	AggregateEntity aggregate;
	Type* underlying;
	TypeUse* underlying_use;
	Binding* values;
};

struct OverrideLink {
	Entity* function;
	OverrideLink* next;
};

struct VirtualCallable {
	Entity* function;
	VirtualCallable* next;
	usize index;
};

struct VirtualTarget {
	Entity* function;
	Subobject* object;
};

enum function_role : [i32] {
	ordinary;
	constructor;
	destructor;
	assignment;
	conversion;
};

enum function_analysis : [i32] {
	unrequested;
	requested;
	analyzing;
	analyzed;
};

struct ParameterBinding {
	Entity* entity;
	ParameterBinding* next;
};

struct FunctionEntity {
	TypeUse* type_use;
	Entity* overload_next;
	Entity* interface_owner;
	OverrideLink* overrides;
	VirtualCallable* callable;
	Type* type;
	Scope* scope;
	Syntax* body;
	ParameterBinding* parameter_bindings;
	usize overload_index;
	function_analysis analysis;
	function_definition definition;
	function_role role;
	reachability lifetime_exit;
	function_modification modification;
	resolution virtual_resolution;
	constructor_conversion conversion;
};

enum storage_kind : [i32] {
	local;
	global;
	parameter;
	argument;
	field;
	constant;
};

struct FieldStorage {
	Entity* owner;
	usize index;
};

union StorageData {
	FieldStorage field;
	u64 integer;
};

struct VariableEntity {
	TypeUse* type_use;
	Type* type;
	ConstantEvaluation* evaluation;
	StorageData data;
	storage_kind storage;
};

enum constant_state : [i32] {
	unevaluated;
	evaluating;
	constant;
	runtime;
	invalid;
};

union ConstantData {
	u64 integer;
	f64 real;
	ConstantValue** elements;
	rt::string_view text;
};

enum constant_kind : [i32] {
	scalar;
	aggregate;
	text;
};

struct ConstantValue {
	Type* type;
	ConstantData data;
	usize count;
	constant_kind kind;
};

struct ConstantEvaluation {
	ConstantValue* value;
	const char* reason;
	constant_state state;
};

struct ConstantBinding {
	Entity* entity;
	ConstantValue* value;
	ConstantBinding* next;
};

struct ConstantContext {
	fn failure(ConstantContext& this, const char* reason) -> ConstantValue*;
	fn storage_supported(ConstantContext& this, Type* type) -> bool;
	fn convert(ConstantContext& this, ConstantValue* source, Type* target) -> ConstantValue*;
	fn bind(ConstantContext& this, Entity* entity, ConstantValue* value);
	fn variable(ConstantContext& this, Entity* entity) -> ConstantValue*;
	fn lvalue(ConstantContext& this, Syntax* syntax) -> ConstantValue*;
	fn call(ConstantContext& this, Entity* function, Syntax* arguments, ConstantValue* receiver) -> ConstantValue*;
	fn expression(ConstantContext& this, Syntax* syntax, Type* expected) -> ConstantValue*;
	fn declare(ConstantContext& this, Syntax* syntax);
	fn region(ConstantContext& this, Syntax* syntax);

	Compiler* compiler;
	Scope* scope;
	ConstantBinding* bindings;
	ConstantValue* result;
	const char* reason;
	usize steps;
	usize depth;
	MirScope* mir_scope;
};

struct NamespaceEntity {
	Scope* scope;
};

union EntityData {
	TemplatePattern template_pattern;
	NamespaceEntity namespace_entity;
	PrimitiveEntity primitive;
	AggregateEntity aggregate;
	EnumEntity enumeration;
	FunctionEntity function;
	VariableEntity variable;
};

struct Entity {
	Scope* scope;
	Syntax* declaration;
	Entity* template_origin;
	TemplateSpecialization* specialization;
	TemplateParameter* template_parameter;
	Token name;
	EntityData data;
	entity_kind kind;
	resolution state;
};

