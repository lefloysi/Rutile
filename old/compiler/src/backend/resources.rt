struct LLVMContextDisposer {
};

fn LLVMContextDisposer::dispose(LLVMOpaqueContext* handle) {
	if (!handle) {
		return;
	};
	LLVMContextDispose($handle);
};

struct LLVMTargetMachineDisposer {
};

fn LLVMTargetMachineDisposer::dispose(LLVMOpaqueTargetMachine* handle) {
