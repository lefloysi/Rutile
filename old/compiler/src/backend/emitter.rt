fn Emitter::byte_offset(Emitter& this, LLVMOpaqueValue* address, u64 offset) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), $offset, 0);
	return LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), $address, &index, 1, "subobject\0");
};

fn Emitter::base_address(Emitter& this, LLVMOpaqueValue* address, Entity* derived, BasePath* path, base_direction direction) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	u64 offset = 0;
	while (path) {
		BaseRelation* relation := path->relation;
		if (direction == base_direction::up && relation->kind == base_kind::kw_virtual) {
			LLVMOpaqueValue* header = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, static_cast<Entity*>(derived)), LLVMOpaqueValue*(address), 0, "view.storage\0");
			LLVMOpaqueValue* view = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "view\0");
			LLVMOpaqueValue* offsets = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), runtime_view_type(@compiler, static_cast<Entity*>(derived)), $view, 0, "virtual.offsets\0");
			LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), static_cast<u64>(relation->component), 0);
			LLVMOpaqueValue* slot = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), $offsets, &index, 1, "virtual.offset.storage\0");
			LLVMOpaqueValue* displacement = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), $slot, "virtual.offset\0");
			@address = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), LLVMOpaqueValue*(address), &displacement, 1, "virtual.base\0");
		}
		else if (direction == base_direction::up) {
			@address = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, static_cast<Entity*>(derived)), LLVMOpaqueValue*(address), static_cast<u32>(relation->component), "base\0");
		}
		else {
			@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, static_cast<Entity*>(derived)), static_cast<u32>(relation->component));
		};
		@derived := relation->entity;
		@path := path->next;
	};
	if (direction == base_direction::down && offset) {
		LLVMOpaqueValue* integer = LLVMBuildPtrToInt(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(address), llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), "base.address\0");
		@integer = LLVMBuildSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(integer), LLVMConstInt(llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), static_cast<u64>(offset), 0), "derived.address\0");
		@address = LLVMBuildIntToPtr(LLVMOpaqueBuilder*(builder), $integer, LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "derived\0");
	};
	return $address;
};

fn Emitter::base_conversion(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Syntax* value := syntax->data.base_conversion.value;
	Type* source := value->type;
	LLVMOpaqueValue* address = nullptr;
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		@address = @this.expression(static_cast<Syntax*>(value));
		@source := source->data.element;
	}
	else {
		@address = @this.address(static_cast<Syntax*>(value));
	};
	Entity* derived := source->data.entity;
	if (syntax->data.base_conversion.direction == base_direction::down) {
		@derived := syntax->data.base_conversion.target->data.element->data.entity;
	};
	if (syntax->kind == syntax_kind::expr_base_pointer && base_path_virtual(static_cast<BasePath*>(syntax->data.base_conversion.path))) {
		LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
		LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "base.nonnull\0");
		LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "base.end\0");
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
		LLVMOpaqueValue* converted = @this.base_address(LLVMOpaqueValue*(address), static_cast<Entity*>(derived), static_cast<BasePath*>(syntax->data.base_conversion.path), static_cast<base_direction>(syntax->data.base_conversion.direction));
		@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
		LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMTypeOf(LLVMOpaqueValue*(address)), "base.pointer\0");
		LLVMOpaqueValue*[2] values {};
		LLVMOpaqueBasicBlock*[2] blocks {};
		@values[0] = $null;
		@values[1] = $converted;
		@blocks[0] = $initial;
		@blocks[1] = $live;
		LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
		return $result;
	};
	LLVMOpaqueValue* result = @this.base_address(LLVMOpaqueValue*(address), $derived, static_cast<BasePath*>(syntax->data.base_conversion.path), static_cast<base_direction>(syntax->data.base_conversion.direction));
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		return LLVMBuildSelect(compiler.backend.llvm_builder.get(), $empty, $null, LLVMOpaqueValue*(result), "base.pointer\0");
	};
	return $result;
};

fn runtime_callable(Compiler& compiler, Entity* entity) -> LLVMOpaqueValue* {
	BackendEntity* native = backend_entity(@compiler.backend, static_cast<Entity*>(entity));
	if (!entity->data.function.callable) {
		return LLVMOpaqueValue*(native->value);
	};
	if (native->wrapper) {
		return LLVMOpaqueValue*(native->wrapper);
	};
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.virtual.callable\0", llvm_type(@compiler, static_cast<Type*>(entity->data.function.type)));
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	emit_function_attributes(@compiler, LLVMOpaqueValue*(function), static_cast<Type*>(entity->data.function.type));
	@native->wrapper := function;
	RuntimeWrapper* wrapper = static_cast<RuntimeWrapper*>(@compiler.allocate(sizeof(RuntimeWrapper)));
	@wrapper->entity = $entity;
	@wrapper->next := compiler.backend.runtime_wrappers;
	@compiler.backend.runtime_wrappers = $wrapper;
	return $function;
};

fn Emitter::dispatch_target(Emitter& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Entity* owner := entity->data.function.interface_owner;
	LLVMOpaqueValue* header = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, static_cast<Entity*>(owner)), $receiver, 0, "virtual.header\0");
	LLVMOpaqueValue* view = LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "virtual.view\0");
	LLVMOpaqueValue* functions = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), runtime_view_type(@compiler, $owner), $view, 1, "virtual.functions\0");
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), static_cast<u64>(entity->data.function.callable->index), 0);
	LLVMOpaqueValue* slot = LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $functions, &index, 1, "virtual.slot\0");
	return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $slot, "virtual.target\0");
};

fn Emitter::covariant_result(Emitter& this, LLVMOpaqueValue* value, Type* source, Type* target) -> LLVMOpaqueValue* {
	if (type_equal(static_cast<Type*>(source), static_cast<Type*>(target))) {
		return $value;
	};
	Compiler& compiler = @*this.compiler;
	BaseSearch path = base_search(@compiler, static_cast<Type*>(source->data.element), static_cast<Type*>(target->data.element));
	if (source->kind == type_kind::reference) {
		return @this.base_address(LLVMOpaqueValue*(value), static_cast<Entity*>(source->data.element->data.entity), static_cast<BasePath*>(path.path), base_direction::up);
	};
	LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
	LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "return.nonnull\0");
	LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "return.end\0");
	LLVMOpaqueValue* null = LLVMConstNull(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0));
	LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(value), LLVMOpaqueValue*(null), "return.null\0");
	LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
	LLVMOpaqueValue* adjusted = @this.base_address($value, static_cast<Entity*>(source->data.element->data.entity), static_cast<BasePath*>(path.path), base_direction::up);
	@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
	LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "return.base\0");
	LLVMOpaqueValue*[2] values {};
	LLVMOpaqueBasicBlock*[2] blocks {};
	@values[0] = $null;
	@values[1] = $adjusted;
	@blocks[0] = $initial;
	@blocks[1] = $live;
	LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
	return $result;
};

fn covariance_adjustment_required(Compiler& compiler, Type* source, Type* target) -> bool {
	if (type_equal(static_cast<Type*>(source), static_cast<Type*>(target))) {
		return false;
	};
	BaseSearch conversion = base_search(@compiler, static_cast<Type*>(source->data.element), static_cast<Type*>(target->data.element));
	Entity* current := source->data.element->data.entity;
	BasePath* path := conversion.path;
	u64 offset = 0;
	while (path) {
		if (path->relation->kind == base_kind::kw_virtual) {
			return true;
		};
		@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, static_cast<Entity*>(current)), static_cast<u32>(path->relation->component));
		@current := path->relation->entity;
		@path := path->next;
	};
	return offset != 0;
};

fn Emitter::storage_address(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return LLVMOpaqueValue*(this.component_source);
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	switch (syntax->kind) {
		case syntax_kind::expr_construct:
			@this.expression(static_cast<Syntax*>(syntax));
			return LLVMOpaqueValue*(backend_syntax(@compiler.backend, static_cast<Syntax*>(syntax))->constructed);
		case syntax_kind::expr_binary:
			if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
				return @this.special_call(static_cast<Entity*>(syntax->entity), @this.address(static_cast<Syntax*>(syntax->data.binary.left)), static_cast<Syntax*>(syntax->data.binary.right));
			};
			if (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy) {
				@this.expression(static_cast<Syntax*>(syntax));
				return LLVMOpaqueValue*(backend_syntax(@compiler.backend, static_cast<Syntax*>(syntax))->address);
			};
			break;
		case syntax_kind::expr_access:
			return @this.storage_address(static_cast<Syntax*>(syntax->data.expression));
		case syntax_kind::expr_base_reference:
			return @this.base_conversion(static_cast<Syntax*>(syntax));
		case syntax_kind::expr_name:
			if (syntax->entity->kind == entity_kind::function) {
				return runtime_callable(@compiler, static_cast<Entity*>(syntax->entity));
			};
			return LLVMOpaqueValue*(backend_entity(@compiler.backend, static_cast<Entity*>(syntax->entity))->value);
		case syntax_kind::expr_cast:
			return @this.address(static_cast<Syntax*>(syntax->data.cast.value));
		case syntax_kind::expr_call:
			return @this.call(static_cast<Syntax*>(syntax));
		case syntax_kind::expr_unary:
			return @this.expression(static_cast<Syntax*>(syntax->data.unary.value));
		case syntax_kind::expr_member: {
			Syntax* object := syntax->data.member.object;
			Type* type := object->type;
			LLVMOpaqueValue* address = nullptr;
			if (syntax->token.kind == token_kind::op_arrow) {
				@address = @this.expression(static_cast<Syntax*>(object));
				@type := type->data.element;
			}
			else if (syntax_category(static_cast<Syntax*>(object)) == value_category::storage) {
				@address = @this.address(static_cast<Syntax*>(object));
			}
			else {
				@address = @this.address(static_cast<Syntax*>(object));
			};
			Entity* owner := syntax->entity->data.variable.data.field.owner;
			if (type->data.entity != owner) {
				BaseSearch path = base_search(@compiler, static_cast<Type*>(type), entity_type(static_cast<Entity*>(owner)));
				@address = @this.base_address(LLVMOpaqueValue*(address), static_cast<Entity*>(type->data.entity), static_cast<BasePath*>(path.path), base_direction::up);
				@type = entity_type(static_cast<Entity*>(owner));
			};
			if (type->data.entity->kind == entity_kind::kw_union) {
				return $address;
			};
			LLVMOpaqueValue* field = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, static_cast<Entity*>(type->data.entity)), LLVMOpaqueValue*(address), static_cast<u32>(syntax->entity->data.variable.data.field.index), "field\0");
			return $field;
		};
		case syntax_kind::expr_index: {
			Syntax* object := syntax->data.binary.left;
			LLVMOpaqueValue* index = @this.expression(static_cast<Syntax*>(syntax->data.binary.right));
			@index = @this.cast(LLVMOpaqueValue*(index), static_cast<Type*>(syntax->data.binary.right->type), static_cast<Type*>(compiler.usize_type));
			LLVMOpaqueValue*[2] indices {};
			if (object->type->kind == type_kind::array) {
				@indices[0] = LLVMConstInt(llvm_type(@compiler, static_cast<Type*>(compiler.usize_type)), 0, 0);
				@indices[1] := index;
				return LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, static_cast<Type*>(object->type)), @this.address(static_cast<Syntax*>(object)), &indices[0], 2, "element\0");
			};
			@indices[0] = LLVMOpaqueValue*(index);
			return LLVMBuildGEP2($builder, llvm_type(@compiler, static_cast<Type*>(object->type->data.element)), @this.expression($object), &indices[0], 1, "element\0");
		};
	};
	@compiler.diagnostics.report(syntax->token, "expression has no storage address\0");
	return nullptr;
};

