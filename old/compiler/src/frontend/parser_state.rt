enum expression_context : [i32] {
	ordinary;
	argument;
};

struct ParseFailure {
	Token token;
	const char* message;
	usize offset;
	usize pending_greater;
};

enum parse_choice_kind : [i32] {
	type;
	template_name;
};

struct ParseChoice {
	TypeSyntax* type;
	NameSyntax* name;
	usize offset;
	usize pending_greater;
	parse_choice_kind kind;
};

struct Parser {
	ParseFailure failure;
	ParseMemoStore* memo;
	Compiler* compiler;
	Token* tokens;
	usize count;
	usize offset;
	usize pending_greater;
	expression_context context;
};

enum flow_kind : [i32] {
	function;
	loop;
	kw_switch;
};

struct SemanticFlow {
	SemanticFlow* parent;
	flow_kind kind;
};

