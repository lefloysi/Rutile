enum syntax_kind : [i32] {
	expr_name;
	literal_number;
	kw_nullptr;
	literal_string;
	node_block;
	node_declaration;
	node_source_declaration;
	source_choice;
	source_expression_chain;
	source_error;
	source_list;
	expr_call;
	expr_member;
	expr_index;
	expr_unary;
	expr_access;
	expr_relocate;
	kw_discard;
	expr_destroy;
	expr_construct;
	expr_typed_apply;
	kw_new;
	kw_delete;
	expr_delete_discard;
	expr_borrowed_component;
	expr_owned_component;
	expr_binary;
	stmt_initialize;
	stmt_bind_reference;
	kw_return;
	kw_if;
	kw_while;
	kw_for;
	kw_switch;
	kw_case;
	kw_break;
	kw_continue;
	kw_sizeof;
	expr_cast;
	expr_base_reference;
	expr_base_pointer;
};

enum parameter_arity : [i32] {
	fixed;
	variadic;
};

// ============================================================================
// MODULE: SOURCE TYPES
// PURPOSE: Preserve parsed names, type structure, and generic arguments without bindings.
// DEPENDS ON: Source tokens and source expressions.
// ============================================================================
enum type_syntax_kind : [i32] {
	choice;
	name;
	qualified;
	automatic;
	conditional;
	pointer;
	reference;
	array;
	function;
};

struct NameSyntax {
	NameChoice* choices;
	ParseFailure* error;
	Token token;
	NameSyntax* qualifier;
	ArgumentListSyntax* arguments;
};

struct ArgumentListSyntax {
	ArgumentListSyntax* rest;
	ArgumentListArm* choices;
	ParseFailure* error;
	ArgumentSyntax* first;
};

struct ArgumentSyntax {
	ParseGuard* type_guard;
	ParseGuard* value_guard;
	TypeSyntax* type;
	ValueSyntax* value;
};

struct ArraySyntax {
	TypeSyntax* element;
	Token count;
};

struct QualifiedTypeSyntax {
	TypeSyntax* element;
	Token condition;
};

union TypeSyntaxData {
	TypeChoice* choices;
	NameSyntax* name;
	TypeSyntax* element;
	QualifiedTypeSyntax qualified;
	ArraySyntax array;
	SignatureSyntax signature;
};

struct TypeSyntax {
	Token token;
	TypeSyntaxData data;
	type_syntax_kind kind;
};

struct ParameterSyntax {
	TypeSyntax* type;
	ParameterSyntax* next;
	Token name;
};

struct SignatureSyntax {
	ParameterSyntax* parameters;
	TypeSyntax* result;
	parameter_arity arity;
};

enum function_modification : [i32] {
	ordinary;
	kw_virtual;
	kw_override;
	kw_final;
};

enum constructor_conversion : [i32] {
	kw_explicit;
	kw_implicit;
};

enum function_definition : [i32] {
	declaration;
	definition;
	deleted;
	defaulted;
};

struct DeclarationSyntax {
	Syntax* path;
	TypeSyntax* conversion_target;
	BaseRelation* bases;
	TypeSyntax* type;
	Syntax* body;
	Entity* constructor;
	Token name;
	function_definition definition;
	function_modification modification;
};

enum initialization_access : [i32] {
	explicit;
	access;
};

struct BinarySyntax {
	Syntax* left;
	Syntax* right;
	token_kind operation;
	initialization_access access;
};

struct UnarySyntax {
	Syntax* value;
	token_kind operation;
};

enum receiver_kind : [i32] {
	none;
	bind;
	evaluate;
};

struct ReceiverBinding {
	Syntax* value;
	receiver_kind kind;
};

struct CallSyntax {
	Syntax* callable;
	Syntax* arguments;
	Entity* qualified_owner;
	ReceiverBinding receiver;
};

struct MemberSyntax {
	Syntax* object;
	Syntax* qualifier;
	Token name;
};

struct BranchSyntax {
	Syntax* condition;
	Syntax* first;
	Syntax* second;
};

struct LoopSyntax {
	Syntax* initializer;
	Syntax* condition;
	Syntax* step;
	Syntax* body;
};

struct SelectionSyntax {
	Syntax* value;
	Syntax* cases;
};

struct CaseSyntax {
	Syntax* value;
	u64 selector;
};

enum base_direction : [i32] {
	up;
	down;
};

enum base_conversion_request : [i32] {
	implicit_conversion;
	explicit_conversion;
};

struct BaseConversionSyntax {
	Syntax* value;
	Type* target;
	BasePath* path;
	base_direction direction;
	base_conversion_request request;
};

struct SizeofSyntax {
	TypeSyntax* type;
	Syntax* value;
	Type* measured;
};

struct CastSyntax {
	TypeSyntax* type;
	Syntax* value;
	Type* resolved;
	TypeUse* type_use;
};

struct TypedApplySyntax {
	TypeSyntax* target;
	Syntax* arguments;
};

struct ConstructionSyntax {
	TypeUse* type_use;
	Syntax* destination;
	Type* target;
	Entity* constructor;
	Syntax* arguments;
};

struct AllocationSyntax {
	Syntax* construction;
	Syntax* count;
};

union SyntaxData {
	SizeofSyntax sizeof_operand;
	fn SyntaxData(SyntaxData& this);

	rt::string_view string;
	Syntax* expression;
	Syntax* statements;
	DeclarationSyntax declaration;
	BinarySyntax binary;
	UnarySyntax unary;
	CallSyntax call;
	MemberSyntax member;
	BranchSyntax branch;
	LoopSyntax loop;
	SelectionSyntax selection;
	CaseSyntax selection_case;
	CastSyntax cast;
	ConstructionSyntax construction;
	AllocationSyntax allocation;
	TypedApplySyntax typed_apply;
	BaseConversionSyntax base_conversion;
};

fn SyntaxData::SyntaxData(SyntaxData& this) {
};

enum value_use : [i32] {
	observed;
	transferred;
};

struct Syntax {
	fn indirect_storage(const Syntax& this) -> bool;

	NameSyntax* source_name;
	TypeUse* type_use;
	Syntax* next;
	Entity* entity;
	Type* type;
	Scope* scope;
	TemplateArgument* template_arguments;
	Token token;
	SyntaxData data;
	syntax_kind kind;
	value_use use;
};

