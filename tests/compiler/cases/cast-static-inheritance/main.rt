struct Base {
	i32 value;
};

struct Derived : [Base] {
	i32 other;
};

fn main() -> i32 {
	Derived object;
	var Base* base = static_cast<var Base*>(&@object);
	@base->value = 20;
	var Derived* derived = static_cast<var Derived*>(base);
	@derived->other = 22;
	var Base& reference = static_cast<var Base&>(@object);
	if (&@reference != base || derived != &@object) {
		return 1;
	};
	return reference.value + object.other;
};
