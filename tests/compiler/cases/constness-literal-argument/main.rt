fn read(auto i32& source) -> i32 {
	return source;
};

fn decimal(auto f64& source) -> f64 {
	return source;
};

fn narrow(auto i08& source) -> i08 {
	return source;
};

fn main() -> i32 {
	if (read(42) != 42 || read(-42) != -42 || decimal(2.5) != 2.5 || narrow(42) != i08(42)) {
		return 1;
	};
	return 42;
};
