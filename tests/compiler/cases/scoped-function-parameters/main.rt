fn add(i32 left, i32 right) -> i32 {
	return left + right;
};

fn subtract(i32 minuend, i32 subtrahend) -> i32 {
	return minuend - subtrahend;
};

fn main() -> i32 {
	var sum = &add;
	var difference = &subtract;
	i32 first = sum({ @left = 20; }, { @right = 22; });
	i32 second = difference({ @minuend = 45; }, { @subtrahend = 3; });
	if (first != 42 || second != 42) {
		return 1;
	};
	return 42;
};
