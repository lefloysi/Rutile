fn main() -> i32 {
	i32 index := 0;
	i32 sum := 0;
	while (index < 4) {
		@index := index + 1;
		switch (index) {
		case 1:
			continue;
		case 2:
			@sum := sum + 10;
			break;
		default:
			@sum := sum + 1;
			break;
		};
		i32 inner := 0;
		while (inner < 4) {
			@inner := inner + 1;
			if (inner == 2) {
				break;
			};
			@sum := sum + inner;
		};
	};
	if (sum == 15 && index == 4) {
		return 42;
	};
	return 1;
};
