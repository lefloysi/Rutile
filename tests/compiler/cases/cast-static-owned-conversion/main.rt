struct Target {
	fn ~Target(Target& this);
	i32 value;
	i32* destroyed;
};

struct Source {
	i32 value;
	i32* destroyed;
};

fn Target::~Target(Target& this) {
	@*this.destroyed = *this.destroyed + 1;
};

fn operator Target(const Source& this) -> Target {
	Target target;
	@target.value := this.value;
	@target.destroyed := this.destroyed;
	return $target;
};

fn main() -> i32 {
	i32 destroyed = 0;
	Source source;
	@source.value = 42;
	@source.destroyed = &destroyed;
	{
		var target = static_cast<Target>(source);
		if (target.value != 42 || destroyed != 0 || source.value != 42) {
			return 1;
		};
	};
	if (destroyed != 1) {
		return 2;
	};
	return 42;
};
