struct Text {
	char* buffer;
};

fn mutable_data(Text& source) -> const[source] char* {
	return source.buffer;
};

fn const_data(const Text& source) -> const[source] char* {
	return source.buffer;
};

fn main() -> i32 {
	char value = 'a';
	Text text;
	@text.buffer = &value;
	char* writable = mutable_data(@text);
	@*writable = 'b';
	const char* readable = const_data(text);
	if (*readable != 'b') {
		return 1;
	};
	return 42;
};
