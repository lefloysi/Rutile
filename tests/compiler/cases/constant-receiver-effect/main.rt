struct Value {
	i32 number;
};

fn Value::result() -> i32 {
	return 0;
};

fn make(var i32& counter) -> Value {
	@counter = counter + 1;
	return Value();
};

fn compute() -> i32 {
	i32 counter = 0;
	make(@counter).result();
	return counter;
};

const i32 folded = compute();

fn main() -> i32 {
	if (folded != compute()) {
		return 41;
	};
	return 42;
};
