struct Owner {
	i32 value;
};

struct Element {
	fn Element(var Element& this, Owner owner);
	i32 value;
};

fn Element::Element(var Element& this, Owner owner) {
	@this.value := owner.value;
};

fn main() -> i32 {
	Owner owner;
	var elements = new var Element[2]($owner);
	delete elements;
	return 0;
};
