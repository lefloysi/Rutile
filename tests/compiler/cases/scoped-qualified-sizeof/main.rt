namespace Small {
	struct Value {
		i32 number;
	};
	fn width() -> usize {
		return sizeof(Value);
	};
};

namespace Large {
	struct Value {
		i64 number;
	};
	fn width() -> usize {
		return sizeof(Value);
	};
};

fn main() -> i32 {
	if (sizeof(Small::Value) != 4 || sizeof(Large::Value) != 8) {
		return 1;
	};
	if (Small::width() != 4 || Large::width() != 8) {
		return 2;
	};
	return 42;
};
