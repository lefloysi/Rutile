struct Raw {
	fn Raw(Raw& this) :[delete];
	i32 value;
};

struct Box {
	fn Box(Box& this, i32 value);
	i32 value;
};

fn Box::Box(Box& this, i32 value) {
	@this.value = $value;
};

fn overwrite(i32 value) -> i32 {
	@value = 42;
	return value + 0;
};

fn main() -> i32 {
	var character = char({});
	@character = 'x';
	var number = new i32({});
	@*number = 42;
	var raw = Raw({});
	@raw.value = 42;
	var box = Box({ @value = 42; });
	if (character != 'x' || *number != 42 || raw.value != 42 || box.value != 42 || overwrite({}) != 42) {
		delete number;
		return 1;
	};
	delete number;
	return 42;
};
