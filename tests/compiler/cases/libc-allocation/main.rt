fn malloc(usize bytes) -> var void*;

fn free(var void* memory);

fn puts(var char* text) -> i32;

fn main() -> i32 {
	var i32* value := static_cast<var i32*>(malloc(sizeof(i32)));
	@*value := 42;
	i32 result := *value;
	puts("Bootstrap libc allocation\0");
	free(static_cast<var void*>($value));
	return result;
};
