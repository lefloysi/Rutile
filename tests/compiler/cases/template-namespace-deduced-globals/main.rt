i32 calls;

fn increment() -> i32 {
	@calls = calls + 1;
	return 42;
};

template<typename T>
namespace Generic {
	i32 value = increment();
	fn result() -> i32 {
		return value + 0;
	};
};

template<typename T>
fn use(T value) -> i32 {
	return Generic<T>::result();
};

fn main() -> i32 {
	if (calls != 1) {
		return 1;
	};
	return use(i32(0));
};
