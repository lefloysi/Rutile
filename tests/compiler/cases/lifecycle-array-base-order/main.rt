struct Tracker {
	fn ~Tracker(Tracker& this);
	i32* trace;
	i32 id;
};

fn Tracker::~Tracker(Tracker& this) {
	if (this.trace) {
		@*this.trace = *this.trace * 10 + this.id;
	};
};

struct Base {
	Tracker base;
};

struct Derived : [Base] {
	Tracker[2] items;
};

fn main() -> i32 {
	i32 trace = 0;
	{
		Derived value;
		@value.base.trace = &trace;
		@value.base.id = 1;
		@value.items[0].trace = &trace;
		@value.items[0].id = 2;
		@value.items[1].trace = &trace;
		@value.items[1].id = 3;
	};
	if (trace == 321) {
		return 42;
	};
	return 1;
};
