struct Value {
	i32 number;
};

fn main() -> i32 {
	Value* pointer = nullptr;
	i32 factor = 7;
	(i32)factor;
	i32 iterations = 0;
	for (i32 Value = 1; (Value) * factor < 14; @Value = Value + 1) {
		@iterations = iterations + 1;
	};
	if (iterations != 1) {
		return 3;
	};
	{
		i32 Value = 6;
		Value * factor;
		if ((Value) * factor != 42 || ((i32)Value) * factor != 42) {
			return 1;
		};
	};
	if (pointer) {
		return 2;
	};
	return 42;
};
