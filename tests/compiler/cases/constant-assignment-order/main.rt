fn pick(i32& counter) -> usize {
	@counter = counter * 10 + 1;
	return 0;
};

fn rhs(i32& counter) -> i32 {
	@counter = counter * 10 + 2;
	return 7;
};

fn compute() -> i32 {
	i32 counter = 0;
	i32[1] array;
	@array[pick(@counter)] = rhs(@counter);
	return counter;
};

const i32 folded = compute();

fn main() -> i32 {
	if (folded != compute()) {
		return 41;
	};
	return 42;
};
