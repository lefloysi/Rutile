template<typename T = i32, typename U = T, usize N = 2, usize M = N + 1>
struct Storage {
	T[N] first;
	U[M] second;
};

fn main() -> i32 {
	if (sizeof(Storage<>) != 20 || sizeof(Storage<i32>) != 20 || sizeof(Storage<i64>) != 40) {
		return 1;
	};
	if (sizeof(Storage<i32, i64, 1>) != 24) {
		return 2;
	};
	return 42;
};
