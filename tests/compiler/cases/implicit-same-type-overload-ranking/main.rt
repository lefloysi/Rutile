struct Choice {
	fn Choice(Choice& this, const usize& value);
	fn Choice(Choice& this, usize value);
	i32 selected;
};

fn Choice::Choice(Choice& this, const usize& value) {
	@this.selected = 1;
};

fn Choice::Choice(Choice& this, usize value) {
	@this.selected = 2;
};

fn main() -> i32 {
	usize source = 42;
	var borrowed = Choice(source);
	var owned = Choice(usize(source));
	if (borrowed.selected != 1 || owned.selected != 2 || source != 42) {
		return 1;
	};
	return 42;
};
