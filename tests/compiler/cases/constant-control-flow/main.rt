fn compute(i32 limit) -> i32 {
	i32 sum = 0;
	for (i32 index = 0; index < limit; @index = index + 1) {
		if (index == 1) {
			continue;
		};
		if (index == 5) {
			break;
		};
		@sum = sum + index;
	};
	while (sum < 40) {
		@sum = sum + 1;
	};
	if (sum == 40) {
		return sum + 2;
	};
	return 0;
};

enum answer : [i32] {
	value = compute(10);
};

fn main() -> i32 {
	return static_cast<i32>(answer::value);
};
