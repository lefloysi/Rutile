struct Text {
	var char* buffer;
	fn data(auto Text& this) -> const[this] char*;
};

fn Text::data(auto Text& this) -> const[this] char* {
	return this.buffer;
};

fn read(const Text& text) -> char {
	const char* pointer = text.data();
	return *pointer;
};

fn main() -> i32 {
	char value = 'a';
	Text text;
	@text.buffer = &@value;
	var char* pointer = (@text).data();
	@*pointer = 'b';
	if (read(text) != 'b') {
		return 1;
	};
	return 42;
};
