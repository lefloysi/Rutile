fn narrow(i08 value) -> i32 {
	return static_cast<i32>((value + static_cast<i08>(1)));
};

fn unsigned_narrow(u08 value) -> u32 {
	return static_cast<u32>((value + static_cast<u08>(1)));
};

fn boolean(bool value) -> i32 {
	return static_cast<i32>(value);
};

fn invert(u08 value) -> u32 {
	return static_cast<u32>((~value));
};

fn float_step(f32 value) -> f64 {
	return static_cast<f64>((value + static_cast<f32>(1.0)));
};

fn negated(u08 value) -> u32 {
	return static_cast<u32>((-value));
};

fn bool_invert(bool value) -> bool {
	return ~value;
};

const i32 signed_fold = narrow(static_cast<i08>(127));
const u32 unsigned_fold = unsigned_narrow(static_cast<u08>(255));
const i32 bool_fold = boolean(true);
const u32 invert_fold = invert(static_cast<u08>(0));
const f64 float_fold = float_step(static_cast<f32>(16777216.0));
const u32 negate_fold = negated(static_cast<u08>(1));
const bool bool_invert_fold = bool_invert(true);

fn main() -> i32 {
	i32 result = 42;
	if (signed_fold != narrow(static_cast<i08>(127))) {
		@result = result + 1;
	};
	if (unsigned_fold != unsigned_narrow(static_cast<u08>(255))) {
		@result = result + 2;
	};
	if (bool_fold != boolean(true)) {
		@result = result + 4;
	};
	if (invert_fold != invert(static_cast<u08>(0))) {
		@result = result + 8;
	};
	if (float_fold != float_step(static_cast<f32>(16777216.0))) {
		@result = result + 16;
	};
	if (negate_fold != negated(static_cast<u08>(1))) {
		@result = result + 32;
	};
	if (bool_invert_fold != bool_invert(true)) {
		@result = result + 64;
	};
	return result;
};
