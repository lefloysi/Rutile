namespace sample {
	template<typename T, typename U = i32>
	struct Pair {
		fn Pair(Pair& this, T first, U second);
		T first;
		U second;
	};
};

template<typename T, typename U>
fn sample::Pair<T, U>::Pair(Pair& this, T first, U second) {
	@this.first = $first;
	@this.second = $second;
};

fn main() -> i32 {
	var first = sample::Pair<i32>(20, 22);
	var second = sample::Pair<i64, i32>(10, 32);
	if (first.first != 20 || first.second != 22 || second.first != 10 || second.second != 32) {
		return 1;
	};
	return first.first + second.second - 10;
};
