template<typename T>
struct Outer {
	struct Inner {
		T value;
	};
};

fn main() -> i32 {
	Outer<i32>::Inner narrow;
	Outer<i64>::Inner wide;
	@narrow.value = 20;
	@wide.value = 22;
	if (sizeof(Outer<i32>::Inner) != 4 || sizeof(Outer<i64>::Inner) != 8) {
		return 1;
	};
	return narrow.value + (i32)wide.value;
};
