template<typename T>
namespace Generic {
	struct Link {
		var Generic<T>::Link* next;
		T value;
	};
	fn result() -> i32 {
		Link tail;
		@tail.value = T(22);
		Link head;
		@head.next = &@tail;
		@head.value = T(20);
		return static_cast<i32>((head.value + head.next->value));
	};
};

fn main() -> i32 {
	return Generic<i64>::result();
};
