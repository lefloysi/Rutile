struct Text {
	char* buffer;
	fn data(auto Text& this) -> const[this] char*;
};

fn Text::data(auto Text& this) -> const[this] char* {
	return this.buffer;
};

fn invalid(const Text& text) -> char* {
	return text.data();
};

fn main() -> i32 {
	char value = 'a';
	Text text;
	@text.buffer = &value;
	char* pointer = invalid(text);
	return i32(*pointer);
};
