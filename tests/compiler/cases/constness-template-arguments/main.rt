struct Holder {
	i32* pointer;
};

template<typename T>
fn data(auto T& source) -> const[source] i32* {
	return source.pointer;
};

fn main() -> i32 {
	i32 value = 42;
	Holder source;
	@source.pointer = &value;
	i32* explicit_mutable = data<Holder>(@source);
	const i32* explicit_constant = data<Holder>(source);
	i32* deduced_mutable = data(@source);
	const i32* deduced_constant = data(source);
	if (explicit_mutable != &value || explicit_constant != &value || deduced_mutable != &value || deduced_constant != &value) {
		return 1;
	};
	return *deduced_constant;
};
