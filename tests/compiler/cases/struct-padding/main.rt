struct Padded {
	i08 marker;
	u64 value;
};

fn main() -> i32 {
	Padded value;
	@value.marker := 7;
	@value.value := 42;
	usize offset := reinterpret_cast<usize>(&value.value) - reinterpret_cast<usize>(&value);
	if (sizeof(Padded) == 16 && offset == 8 && value.marker == 7) {
		return static_cast<i32>(value.value);
	};
	return 1;
};
