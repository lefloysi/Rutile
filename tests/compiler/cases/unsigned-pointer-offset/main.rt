fn main() -> i32 {
	[1024]i32 values;
	values[456] = 42;
	*i32 pointer = &values[256];
	u08 offset = 200;
	i64 difference = (pointer + offset) - pointer;
	if (difference != 200 || pointer[offset] != 42) {
		return 1;
	}
	pointer += offset;
	if (*pointer != 42) {
		return 2;
	}
	pointer -= offset;
	return pointer[offset];
}
