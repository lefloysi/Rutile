fn main() -> i32 {
	i32[1024] values;
	@values[456] := 42;
	i32* pointer := &values[256];
	u08 offset := 200;
	usize difference := ((usize)(pointer + offset) - (usize)pointer) / sizeof(i32);
	if (difference != 200 || pointer[offset] != 42) {
		return 1;
	};
	@pointer := pointer + offset;
	if (*pointer != 42) {
		return 2;
	};
	@pointer := pointer - offset;
	return i32(pointer[offset]);
};
