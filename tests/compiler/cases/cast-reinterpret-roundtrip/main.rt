fn roundtrip(var i32* pointer) -> var i32* {
	u64 address = reinterpret_cast<u64>(pointer);
	return reinterpret_cast<var i32*>(address);
};

fn main() -> i32 {
	i32 value = 42;
	var u08* bytes = reinterpret_cast<var u08*>(&@value);
	var i32* restored = reinterpret_cast<var i32*>(bytes);
	if (restored != &@value || roundtrip(restored) != &@value) {
		return 1;
	};
	return *restored;
};
