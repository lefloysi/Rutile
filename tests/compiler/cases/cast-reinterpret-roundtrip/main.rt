fn roundtrip(i32* pointer) -> i32* {
	u64 address = reinterpret_cast<u64>(pointer);
	return reinterpret_cast<i32*>(address);
};

fn main() -> i32 {
	i32 value = 42;
	u08* bytes = reinterpret_cast<u08*>(&value);
	i32* restored = reinterpret_cast<i32*>(bytes);
	if (restored != &value || roundtrip(restored) != &value) {
		return 1;
	};
	return *restored;
};
