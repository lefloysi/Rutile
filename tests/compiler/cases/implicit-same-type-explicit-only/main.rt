struct Value {
	fn Value(var Value& this) : [default];
	fn Value(var Value& this, const Value& other) : [default];
	i32 number;
};

fn operator Value(const Value& this) -> Value {
	return Value(this);
};

fn owned(Value value) -> i32 {
	return i32(value.number);
};

fn main() -> i32 {
	Value value;
	@value.number = 42;
	return owned(value);
};
