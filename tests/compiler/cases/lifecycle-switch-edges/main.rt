struct Tracker {
	fn Tracker(Tracker& this, i32* trace, i32 id);
	fn ~Tracker(Tracker& this);
	i32* trace;
	i32 id;
};

fn Tracker::Tracker(Tracker& this, i32* trace, i32 id) {
	@this.trace = $trace;
	@this.id := id;
	@*this.trace = *this.trace * 10 + id;
};

fn Tracker::~Tracker(Tracker& this) {
	@*this.trace = *this.trace * 10 + this.id + 3;
};

fn main() -> i32 {
	i32 trace = 0;
	i32 index = 0;
	while (true) {
		@index = index + 1;
		var outer = Tracker(&trace, 1);
		switch (index) {
		case 1: {
			var inner = Tracker(&trace, 2);
			continue;
		};
		default: {
			var inner = Tracker(&trace, 2);
			break;
		};
		};
		break;
	};
	if (trace == 12541254) {
		return 42;
	};
	return 1;
};
