fn doubled(usize value) -> usize {
	return value * 2;
};

template<typename T, usize N = doubled((usize)sizeof(T))>
struct Storage {
	char[N] bytes;
};

fn main() -> i32 {
	if (sizeof(Storage<i32>) != 8 || sizeof(Storage<i64>) != 16) {
		return 1;
	};
	if (sizeof(Storage<i32, doubled(3)>) != 6) {
		return 2;
	};
	return 42;
};
