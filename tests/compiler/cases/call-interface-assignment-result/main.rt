struct Selector {
	fn operator=(Selector& this, i32 value) -> ((i32 result_argument) -> i32)*;
};

fn identity(i32 original_argument) -> i32 {
	return $original_argument;
};

fn Selector::operator=(Selector& this, i32 value) -> ((i32 result_argument) -> i32)* {
	return &identity;
};

fn main() -> i32 {
	Selector selector;
	return (@selector = 1)({ @result_argument = 42; });
};
