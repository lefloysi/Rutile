i32 calls = 0;

fn initial() -> i32 {
	@calls = calls + 1;
	return 42;
};

template<typename T>
namespace Foo {
	i32 value = initial();

	fn get() -> i32 {
		return i32(value);
	};
};

template<typename T>
fn read() -> i32 {
	return Foo<T>::get();
};

fn main() -> i32 {
	if (read<i32>() != 42 || read<i64>() != 42 || calls != 2) {
		return 1;
	};
	if (read<i32>() != 42 || calls != 2) {
		return 2;
	};
	return 42;
};
