struct Tracker {
	fn Tracker(Tracker& this, i32* trace, i32 id);
	fn ~Tracker(Tracker& this);
	i32* trace;
	i32 id;
};

fn Tracker::Tracker(Tracker& this, i32* trace, i32 id) {
	@this.trace = $trace;
	@this.id := id;
	@*this.trace = *this.trace * 10 + id;
};

fn Tracker::~Tracker(Tracker& this) {
	@*this.trace = *this.trace * 10 + this.id + 3;
};

fn visit(i32* trace) {
	var first = Tracker(i32*(trace), 1);
	var second = Tracker($trace, 2);
	return;
};

fn main() -> i32 {
	i32 trace = 0;
	visit(&trace);
	if (trace == 1254) {
		return 42;
	};
	return 1;
};
