struct Counts {
	i32 moved;
	i32 destroyed;
	i32 order;
};

struct Value {
	fn Value(var Value& this) : [default];
	fn Value(var Value& this, const Value& other) : [delete];
	fn Value(var Value& this, Value other);
	fn ~Value(var Value& this);
	var Counts* counts;
	i32 id;
};

fn Value::Value(var Value& this, Value other) {
	@this.counts := other.counts;
	@this.id := other.id;
	@this.counts->moved = this.counts->moved + 1;
	discard $other;
};

fn Value::~Value(var Value& this) {
	if (this.counts) {
		@this.counts->destroyed = this.counts->destroyed + 1;
		@this.counts->order = this.counts->order * 10 + this.id;
	};
};

struct Base {
	Value base;
};

struct Wrapper : [Base] {
	fn Wrapper(var Wrapper& this) : [default];
	fn Wrapper(var Wrapper& this, Wrapper other) : [default];
	Value[2] items;
};

struct Outer {
	fn Outer(var Outer& this) : [default];
	fn Outer(var Outer& this, Outer other) : [default];
	Wrapper inner;
};

struct Plain {
	Value member;
};

fn main() -> i32 {
	Counts counts;
	{
		Outer source;
		@source.inner.base.counts = &@counts;
		@source.inner.base.id = 1;
		@source.inner.items[0].counts = &@counts;
		@source.inner.items[0].id = 2;
		@source.inner.items[1].counts = &@counts;
		@source.inner.items[1].id = 3;
		var moved = Outer($source);
		if (counts.moved || counts.destroyed) {
			return 1;
		};
		if (moved.inner.base.id != 1 || moved.inner.items[0].id != 2 || moved.inner.items[1].id != 3) {
			return 2;
		};
		var relocated = $moved;
		if (counts.moved || counts.destroyed || relocated.inner.items[1].id != 3) {
			return 4;
		};
		Plain plain_source;
		@plain_source.member.counts = &@counts;
		@plain_source.member.id = 4;
		var plain_moved = Plain($plain_source);
		if (counts.moved || counts.destroyed || plain_moved.member.id != 4) {
			return 5;
		};
		var plain_relocated = $plain_moved;
		if (counts.moved || counts.destroyed || plain_relocated.member.id != 4) {
			return 6;
		};
	};
	if (counts.destroyed != 4 || counts.order != 4321) {
		return 3;
	};
	return 42;
};
