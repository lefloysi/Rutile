struct Base {
	fn value(const Base& this) -> i32 : [virtual];
};

struct Derived : [Base] {
	fn value(const Derived& this) -> i32 : [override];
};

fn Base::value(const Base& this) -> i32 {
	return 1;
};

fn Derived::value(const Derived& this) -> i32 {
	return 42;
};

fn dispatch(const Base& object) -> i32 {
	return object.value();
};

fn main() -> i32 {
	Derived object;
	return dispatch(object);
};
