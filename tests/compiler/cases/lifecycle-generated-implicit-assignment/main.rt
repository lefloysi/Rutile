struct Counts {
	i32 moved;
	i32 destroyed;
	i32 order;
};

struct Owner {
	fn Owner(var Owner& this, var Counts* counts, i32 value);
	fn Owner(var Owner& this, Owner other);

	fn ~Owner(var Owner& this);
	var Counts* counts;
	var i32* value;
};

fn Owner::Owner(var Owner& this, var Counts* counts, i32 value) {
	@this.counts = $counts;
	@this.value = new var i32($value);
};

fn Owner::Owner(var Owner& this, Owner other) {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->moved = this.counts->moved + 1;
	@this.counts->order = this.counts->order * 10 + 2;
	discard $other;
};

fn Owner::~Owner(var Owner& this) {
	@this.counts->destroyed = this.counts->destroyed + 1;
	@this.counts->order = this.counts->order * 10 + *this.value;
	delete (var i32*(this.value));
};

fn main() -> i32 {
	Counts counts;
	{
		var source = Owner(&@counts, 3);
		var target = Owner(&@counts, 1);
		@target = $source;
		if (counts.moved != 1 || counts.destroyed != 1 || counts.order != 12) {
			return 1;
		};
		if (*target.value != 3) {
			return 2;
		};
	};
	if (counts.moved != 1 || counts.destroyed != 2 || counts.order != 123) {
		return 3;
	};
	return 42;
};
