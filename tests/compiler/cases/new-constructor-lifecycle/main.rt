struct Tracker {
	fn Tracker(Tracker& this, i32* trace);
	fn ~Tracker(Tracker& this);
	i32* trace;
};

fn Tracker::Tracker(Tracker& this, i32* trace) {
	@this.trace = $trace;
	@*this.trace = *this.trace * 10 + 4;
};

fn Tracker::~Tracker(Tracker& this) {
	@*this.trace = *this.trace * 10 + 2;
};

fn main() -> i32 {
	i32 trace = 0;
	var object = new Tracker(&trace);
	if (!object) {
		return 1;
	};
	delete object;
	return trace;
};
