template<typename T>
fn copy_value(const T& input) -> T {
	return T(input);
};

template<typename T>
fn pointer_copy(T* input) -> T* {
	return T*($input);
};

fn main() -> i32 {
	i32 value = 20;
	var pointer = pointer_copy<i32>(copy_value<i32*>(&value));
	i32 result = copy_value<i32>(*pointer);
	return result + i32(22);
};
