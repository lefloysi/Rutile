struct Counts {
	i32 assigned;
	i32 results;
};

struct Result {
	fn ~Result(var Result& this);
	var Counts* counts;
};

fn Result::~Result(var Result& this) {
	@this.counts->results = this.counts->results + 1;
};

struct Value {
	fn Value(var Value& this) :[default];
	fn operator=(var Value& this, const Value& other) -> Result;
	var Counts* counts;
};

fn Value::operator=(var Value& this, const Value& other) -> Result {
	@this.counts := other.counts;
	@this.counts->assigned = this.counts->assigned + 1;
	Result result;
	@result.counts := this.counts;
	return $result;
};

struct Wrapper {
	Value member;
};

fn main() -> i32 {
	Counts counts;
	Wrapper source;
	@source.member.counts = &@counts;
	Wrapper target;
	@target = $source;
	if (!counts.assigned && !counts.results) {
		return 42;
	};
	return 1;
};
