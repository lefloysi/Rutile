struct Holder {
	var i32* pointer;
	fn data(auto Holder& this) -> const[this] i32*;
};

fn Holder::data(auto Holder& this) -> const[this] i32* {
	return this.pointer;
};

fn make() -> const Holder {
	return Holder();
};

fn main() -> i32 {
	const i32* pointer = Holder().data();
	const i32* constant_pointer = make().data();
	if (pointer != nullptr || constant_pointer != nullptr) {
		return 1;
	};
	return 42;
};
