struct Tracker {
	fn Tracker(var Tracker& this, var i32* trace, i32 id);
	fn ~Tracker(var Tracker& this);
	var i32* trace;
	i32 id;
};

fn Tracker::Tracker(var Tracker& this, var i32* trace, i32 id) {
	@this.trace = $trace;
	@this.id := id;
	@*this.trace = *this.trace * 10 + id;
};

fn Tracker::~Tracker(var Tracker& this) {
	@*this.trace = *this.trace * 10 + this.id + 3;
};

fn main() -> i32 {
	i32 trace = 0;
	i32 index = 0;
	while (true) {
		@index = index + 1;
		var value = Tracker(&@trace, i32(index));
		if (index == 1) {
			continue;
		};
		break;
	};
	if (trace == 1425) {
		return 42;
	};
	return 1;
};
