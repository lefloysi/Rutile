struct Counts {
	i32 conversions;
	i32 copies;
	i32 destroyed;
};

struct Owner {
	fn Owner(Owner& this) : [default];
	fn Owner(Owner& this, const Owner& other);
	fn ~Owner(Owner& this);
	Counts* counts;
	i32* value;
};

fn Owner::Owner(Owner& this, const Owner& other) {
	@this.counts := other.counts;
	@this.value = new i32(i32(*other.value));
	@this.counts->copies = this.counts->copies + 1;
};

fn Owner::~Owner(Owner& this) {
	@this.counts->destroyed = this.counts->destroyed + 1;
	delete i32*(this.value);
};

fn operator Owner(const Owner& this) -> Owner : [implicit] {
	@this.counts->conversions = this.counts->conversions + 1;
	return Owner(this);
};

fn consume(Owner value) -> i32 {
	@*value.value = *value.value + 1;
	return i32(*value.value);
};

fn main() -> i32 {
	Counts counts;
	{
		Owner source;
		@source.counts = &counts;
		@source.value = new i32(42);
		if (consume(source) != 43) {
			return 1;
		};
		if (counts.conversions != 1 || counts.copies != 1 || counts.destroyed != 1 || *source.value != 42) {
			return 2;
		};
	};
	if (counts.conversions != 1 || counts.copies != 1 || counts.destroyed != 2) {
		return 3;
	};
	return 42;
};
