struct Source {
	i32 value;
};

namespace values {
	struct View {
		fn View(View& this, const Source& source) : [implicit];
		i32 value;
	};

	fn View::View(View& this, const Source& source) {
		@this.value := source.value;
	};

	fn operator==(const View& lhs, const View& rhs) -> bool {
		return lhs.value == rhs.value;
	};
};

fn main() -> i32 {
	Source source;
	@source.value = 42;
	var view = values::View(source);
	if (!(source == view) || !(view == source)) {
		return 1;
	};
	return 42;
};
