i32 receiver_calls = 0;
i32 storage = 0;

fn destination() -> i32* {
	@receiver_calls = receiver_calls + 1;
	return &storage;
};

template<typename T>
fn construct(T* pointer, T value) {
	@pointer->T($value);
};

template<typename T>
fn destroy(T* pointer) {
	@pointer->~T();
};

fn main() -> i32 {
	construct<i32>(destination(), 42);
	if (storage != 42 || receiver_calls != 1) {
		return 1;
	};
	destroy<i32>(destination());
	if (receiver_calls != 2) {
		return 2;
	};
	@destination()->i32(42);
	@destination()->~i32();
	if (receiver_calls != 4) {
		return 3;
	};
	return 42;
};
