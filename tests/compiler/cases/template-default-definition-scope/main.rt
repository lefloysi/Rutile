namespace library {
	template<typename T>
	struct Default {
		i32 value;
	};

	template<typename T, typename D = Default<T>>
	struct Owner {
		D data;
	};
};

namespace caller {
	struct Default {
	};

	fn run() -> i32 {
		library::Owner<i32> value;
		@value.data.value = 42;
		return i32(value.data.value);
	};
};

fn main() -> i32 {
	return caller::run();
};
