template<typename T>
namespace Foo {
	struct Bar {
		T value;
	};

	T value;

	fn set(T next) {
		@value = $next;
	};

	fn get() -> T {
		return T(value);
	};
};

fn main() -> i32 {
	if (sizeof(Foo<i32>::Bar) != 4 || sizeof(Foo<i64>::Bar) != 8) {
		return 1;
	};
	Foo<i32>::set(20);
	Foo<i64>::set(i64(22));
	if (Foo<i32>::get() != 20 || Foo<i64>::get() != 22) {
		return 2;
	};
	@Foo<i32>::value = 40;
	if (Foo<i32>::get() != 40 || Foo<i64>::get() != 22) {
		return 3;
	};
	return 42;
};
