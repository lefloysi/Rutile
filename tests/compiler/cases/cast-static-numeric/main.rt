enum values : [i32] {
	answer = 42;
};

fn convert(f64 value) -> i32 {
	return static_cast<i32>(value);
};

fn main() -> i32 {
	var small = static_cast<u08>(convert(42.9));
	if (static_cast<i32>(values::answer) != 42 || static_cast<usize>('0') != 48 || static_cast<i32>(42) != 42) {
		return 1;
	};
	return static_cast<i32>(static_cast<u08>(small));
};
