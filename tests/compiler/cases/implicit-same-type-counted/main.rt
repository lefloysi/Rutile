struct Value {
	fn Value(Value& this) : [default];
	fn Value(Value& this, const Value& other) : [default];
	fn Value(Value& this, Value other) : [default];
	fn operator=(Value& this, Value other) -> Value& : [default];
	i32* copies;
	i32 number;
};

fn operator Value(const Value& this) -> Value : [implicit] {
	@*this.copies = *this.copies + 1;
	return Value(this);
};

fn owned(Value value) -> i32 {
	return i32(value.number);
};

fn copied_return(const Value& value) -> Value {
	return value;
};

fn borrowed(const Value& value) -> i32 {
	return i32(value.number);
};

fn change(Value& value) {
	@value.number = 43;
};

fn local_copy(i32* copies) -> Value {
	Value local;
	@local.copies = $copies;
	@local.number = 42;
	return local;
};

fn main() -> i32 {
	i32 copies = 0;
	Value source;
	@source.copies = &copies;
	@source.number = 42;
	Value initialized = source;
	if (copies != 1 || initialized.number != 42 || source.number != 42) {
		return 1;
	};
	if (owned(source) != 42 || copies != 2) {
		return 2;
	};
	var returned = copied_return(source);
	if (copies != 3 || returned.number != 42) {
		return 3;
	};
	Value assigned;
	@assigned = source;
	if (copies != 4 || assigned.number != 42 || source.number != 42) {
		return 4;
	};
	if (borrowed(source) != 42 || copies != 4) {
		return 5;
	};
	change(@source);
	if (source.number != 43 || copies != 4) {
		return 6;
	};
	var moved = $initialized;
	if (owned($moved) != 42 || copies != 4) {
		return 7;
	};
	Value explicit_copy := source;
	var explicit_construct = Value(source);
	if (copies != 4 || explicit_copy.number != 43 || explicit_construct.number != 43) {
		return 8;
	};
	var local = local_copy(&copies);
	if (copies != 5 || local.number != 42) {
		return 9;
	};
	return 42;
};
