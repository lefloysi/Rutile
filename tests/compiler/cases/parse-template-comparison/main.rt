template<typename T>
struct Box {
	T value;
};

template<typename T>
fn identity(T value) -> T {
	return $value;
};

fn main() -> i32 {
	Box<Box<i32>> nested;
	@nested.value.value = identity<i32>(42);
	i32 smaller = 1;
	i32 larger = 2;
	if (smaller < larger && larger > smaller && (larger >> 1) == smaller) {
		return i32(nested.value.value);
	};
	return 1;
};
