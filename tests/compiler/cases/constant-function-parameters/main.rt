fn add(i32 left, i32 right) -> i32 {
	return left + right;
};

fn subtract(i32 minuend, i32 subtrahend) -> i32 {
	return minuend - subtrahend;
};

enum results : [i32] {
	sum = add(20, 22);
	difference = subtract(45, 3);
};

fn main() -> i32 {
	if ((i32)results::sum != 42 || (i32)results::difference != 42) {
		return 1;
	};
	return 42;
};
