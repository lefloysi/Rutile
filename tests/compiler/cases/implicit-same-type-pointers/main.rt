struct Holder {
	var i32* pointer;
};

fn mutable_pointer(const Holder& holder) -> var i32* {
	return holder.pointer;
};

fn const_pointer(const Holder& holder) -> const i32* {
	return holder.pointer;
};

fn owned_pointer(var i32* pointer) -> var i32* {
	return pointer;
};

using Pointer = var i32*;

fn copied_pointer(const Pointer& pointer) -> var i32* {
	return pointer;
};

fn owned_const_pointer(const i32* pointer) -> const i32* {
	return pointer;
};

fn owned_void_pointer(var void* pointer) -> var void* {
	return pointer;
};

fn answer() -> i32 {
	return 42;
};

using Callable = (() -> i32)*;

fn owned_callable(Callable callable) -> Callable {
	return callable;
};

fn main() -> i32 {
	i32 value = 42;
	var i32* source = &@value;
	var i32* initialized = source;
	var i32* assigned = nullptr;
	@assigned = source;
	if (owned_pointer(source) != &@value || copied_pointer(source) != &@value || initialized != &@value || assigned != &@value || source != &@value) {
		return 1;
	};
	Holder holder;
	@holder.pointer = source;
	const i32* read_only = source;
	const i32* copied_read_only = read_only;
	if (mutable_pointer(holder) != source || const_pointer(holder) != read_only || owned_const_pointer(read_only) != source || copied_read_only != source || holder.pointer != source) {
		return 2;
	};
	var void* opaque = (var void*(source));
	var void* opaque_copy = opaque;
	if (owned_void_pointer(opaque) != opaque || opaque_copy != opaque || source != &@value) {
		return 3;
	};
	Callable callable = &answer;
	Callable callable_copy = callable;
	Callable callable_returned = owned_callable(callable);
	if (callable() != 42 || callable_copy() != 42 || callable_returned() != 42) {
		return 4;
	};
	return 42;
};
