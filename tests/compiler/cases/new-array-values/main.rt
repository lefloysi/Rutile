fn length(i32& calls) -> usize {
	@calls = calls + 1;
	return 6;
};

fn main() -> i32 {
	i32 calls = 0;
	var values = new i32[length(@calls) + 1](6);
	if (!values || calls != 1) {
		return 1;
	};
	i32 sum = 0;
	usize index = 0;
	while (index < 7) {
		@sum = sum + values[index];
		@index = index + 1;
	};
	delete values;
	var bytes = new char[43]({});
	if (!bytes) {
		return 2;
	};
	@bytes[42] = 'x';
	if (bytes[42] != 'x') {
		return 3;
	};
	delete bytes;
	return sum;
};
