template<typename T, usize N>
fn array_size() -> usize {
	T[N] values;
	return sizeof(values);
};

template<typename T>
fn value_size(const T& value) -> usize {
	return sizeof(T);
};

fn main() -> i32 {
	i32 narrow = 1;
	i64 wide = 1;
	i32* pointer = &narrow;
	if (value_size<i32>(narrow) != 4 || value_size<i64>(wide) != 8 || value_size<i32*>(pointer) != sizeof(i32*)) {
		return 1;
	};
	if (array_size<i32, 2>() != 8 || array_size<i64, 3>() != 24 || array_size<i32, 3>() != 12) {
		return 2;
	};
	return 42;
};
