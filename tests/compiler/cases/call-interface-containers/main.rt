struct Holder {
	((i32 field_argument) -> i32)* callable;
};

fn identity(i32 value) -> i32 {
	return $value;
};

fn main() -> i32 {
	((i32 array_argument) -> i32)*[1] callbacks;
	@callbacks[0] = &identity;
	Holder holder;
	@holder.callable = &identity;
	i32 first = callbacks[0]({ @array_argument = 20; });
	i32 second = holder.callable({ @field_argument = 22; });
	return first + second;
};
