template<typename T>
fn copy(T value) -> T {
	return value;
};

fn main() -> i32 {
	bool value_0 = true;
	if (copy<bool>(value_0) != value_0 || value_0 != true) {
		return 1;
	};
	char value_1 = 'x';
	if (copy<char>(value_1) != value_1 || value_1 != 'x') {
		return 1;
	};
