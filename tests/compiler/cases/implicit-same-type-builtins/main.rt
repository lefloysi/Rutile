	if (copy<i08>(value_2) != value_2 || value_2 != 42) {
		return 1;
	};
	i16 value_3 = 42;
	if (copy<i16>(value_3) != value_3 || value_3 != 42) {
		return 1;
	};
	i32 value_4 = 42;
	if (copy<i32>(value_4) != value_4 || value_4 != 42) {
		return 1;
	};
	i64 value_5 = 42;
	if (copy<i64>(value_5) != value_5 || value_5 != 42) {
		return 1;
	};
	u08 value_6 = 42;
	if (copy<u08>(value_6) != value_6 || value_6 != 42) {
		return 1;
	};
	u16 value_7 = 42;
	if (copy<u16>(value_7) != value_7 || value_7 != 42) {
		return 1;
	};
	u32 value_8 = 42;
	if (copy<u32>(value_8) != value_8 || value_8 != 42) {
		return 1;
	};
	u64 value_9 = 42;
	if (copy<u64>(value_9) != value_9 || value_9 != 42) {
		return 1;
	};
	usize value_10 = 42;
	if (copy<usize>(value_10) != value_10 || value_10 != 42) {
		return 1;
	};
	ptrdiff value_11 = 42;
	if (copy<ptrdiff>(value_11) != value_11 || value_11 != 42) {
		return 1;
	};
	f32 value_12 = 1.5;
	if (copy<f32>(value_12) != value_12 || value_12 != 1.5) {
		return 1;
	};
	f64 value_13 = 1.5;
	if (copy<f64>(value_13) != value_13 || value_13 != 1.5) {
		return 1;
	};
	return 42;
};
