template<typename T>
namespace Foo {
	namespace Inner {
		struct Bar {
			T value;
		};
	};

	template<typename U>
	fn convert(U value) -> T {
		return static_cast<T>($value);
	};
};

fn main() -> i32 {
	Foo<i32>::Inner::Bar narrow;
	Foo<i64>::Inner::Bar wide;
	@narrow.value = Foo<i32>::convert<i64>(i64(20));
	@wide.value = Foo<i64>::convert<i32>(22);
	if (sizeof(narrow) != 4 || sizeof(wide) != 8) {
		return 1;
	};
	return narrow.value + static_cast<i32>(wide.value);
};
