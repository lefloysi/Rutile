fn malloc(usize size) -> var void*;
fn free(var void* memory);

struct Value {
	fn Value(var Value& this, i32 number);
	fn Value(var Value& this, Value other) : [default];

	i32 number;
};

fn Value::Value(var Value& this, i32 number) {
	@this.number = $number;
};

template<typename T>
fn construct(var T* destination, T value) {
	@destination->T($value);
};

fn main() -> i32 {
	var Value* destination = static_cast<var Value*>(malloc(sizeof(Value)));
	construct<Value>(destination, Value(42));
	i32 result := destination->number;
	free(destination);
	return result;
};
