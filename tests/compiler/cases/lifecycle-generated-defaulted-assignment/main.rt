struct Counts {
	i32 moved;
	i32 destroyed;
	i32 order;
};

struct Owner {
	fn Owner(Owner& this, Counts* counts, i32 value);
	fn Owner(Owner& this, Owner other);
	fn operator=(Owner& this, Owner other) -> Owner& : [default];
	fn ~Owner(Owner& this);
	Counts* counts;
	i32* value;
};

fn Owner::Owner(Owner& this, Counts* counts, i32 value) {
	@this.counts = $counts;
	@this.value = new i32($value);
};

fn Owner::Owner(Owner& this, Owner other) {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->moved = this.counts->moved + 1;
	@this.counts->order = this.counts->order * 10 + 2;
	discard $other;
};

fn Owner::~Owner(Owner& this) {
	@this.counts->destroyed = this.counts->destroyed + 1;
	@this.counts->order = this.counts->order * 10 + *this.value;
	delete i32*(this.value);
};

fn main() -> i32 {
	Counts counts;
	{
		var source = Owner(&counts, 3);
		var target = Owner(&counts, 1);
		@target = $source;
		if (counts.moved != 1 || counts.destroyed != 1 || counts.order != 12) {
			return 1;
		};
		if (*target.value != 3) {
			return 2;
		};
	};
	if (counts.moved != 1 || counts.destroyed != 2 || counts.order != 123) {
		return 3;
	};
	return 42;
};
