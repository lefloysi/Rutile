[[test]]
fn relocated_objects_cannot_be_used() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back("fn broken() -> i32 { i32 value = 42; i32 moved = $value; return value; };\n");
	rt::test::expect((@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library)).has<compilation_error>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	rt::test::expect(records.size());
	rt::test::expect(records.data()[0].message.contains("object has been relocated"));
};

[[test]]
fn reference_analysis_accepts_long_left_associated_expressions() {
	var directory = compiler_directory("reference-worklist");
	var source = rt::string("fn sum(i32 value) -> i32 { return value");
	for (usize index = 0; index < 256; @index = index + 1) {
		@source.append(" + value");
	};
	@source.append("; };\n");
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("left-associated.rt");
	@sources.push_back(source);
	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<void>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::test::expect(!analysis.value().diagnostics().failed());
};

[[test]]
fn references_cannot_escape_local_storage() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back("fn broken() -> i32& { i32 value = 42; return value; };\n");
	rt::test::expect((@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library)).has<compilation_error>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	rt::test::expect(records.size());
	rt::test::expect(records.data()[0].message.contains("local storage"));
};

[[test]]
fn reconstruction_starts_a_new_object_lifetime() {
	var directory = compiler_directory("reconstruction");
	var subject = "struct Counter { i32 value = 42; };\n";
	var source = """[[test]] fn reconstruct() {
	Counter counter;
	Counter moved = $counter;
	@counter.Counter();
	rt::test::expect(moved.value == 42);
	rt::test::expect(counter.value == 42);
};
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());

	rt::sys::Result executed = rt::sys::cmd(fixture_command(directory, ""));
	if (executed.exit_code) {
		discard puts(executed.output.c_str());
		discard puts(executed.error.c_str());
	};
	rt::test::expect(!executed.exit_code);
};
[[test]]
fn void_alternatives_preserve_lifetimes_through_copy_and_move() {
	var directory = compiler_directory("void-variant-lifetimes");
	var subject = """i32 copies;
i32 destructions;
struct Payload {
	i32 value;
	fn Payload(var Payload& this, i32 value) { @this.value = value; };
	fn Payload(var Payload& this, Payload& other) { @this.value = other.value; @copies = copies + 1; };
	fn ~Payload(var Payload& this) { @destructions = destructions + 1; };
};
using Result = void | Payload | i32;
using Later = Payload | void | i32;
i32 completions;
fn complete() { @completions = completions + 1; };
""";
	var source = """[[test]] fn lifecycle() {
	{
		Result empty;
		rt::test::expect(empty.has<void>());
		empty.get<void>();
		Result copied = Result(empty);
		Result moved = $copied;
		rt::test::expect(moved.has<void>());
		rt::test::expect(!copies && !destructions);
		Result payload = Result(Payload(42));
		rt::test::expect(payload.has<Payload>());
		@payload = Result();
		rt::test::expect(payload.has<void>());
		rt::test::expect(destructions == 1);
		@empty := payload;
		rt::test::expect(empty.has<void>());
		@empty = Result(i32(7));
		rt::test::expect(empty.has<i32>() && empty.get<i32>() == 7);
		@empty = Result();
		rt::test::expect(empty.has<void>());
	};
	rt::test::expect(!copies && destructions == 1);
};
[[test]] fn nonfirst_void() {
	@copies = 0; @destructions = 0; @completions = 0;
	{
		Later empty = Later(complete());
		rt::test::expect(completions == 1 && empty.has<void>());
		Later copied = Later(empty);
		Later moved = $copied;
		rt::test::expect(moved.has<void>());
		Later payload = Later(Payload(42));
		Later payload_copy = Later(payload);
		Later payload_move = $payload_copy;
		rt::test::expect(copies == 1 && payload_move.get<Payload>().value == 42);
		@payload_move = Later(complete());
		rt::test::expect(payload_move.has<void>() && destructions == 1);
		@payload = Later(i32(7));
		rt::test::expect(payload.get<i32>() == 7 && destructions == 2);
		@payload := empty;
		rt::test::expect(payload.has<void>());
	};
	rt::test::expect(copies == 1 && destructions == 2 && completions == 2);
};
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());

	rt::sys::Result executed = rt::sys::cmd(fixture_command(directory, ""));
	if (executed.exit_code) {
		discard puts(executed.output.c_str());
		discard puts(executed.error.c_str());
	};
	rt::test::expect(!executed.exit_code);
};

[[test]]
fn nested_reference_stores_reject_escaping_local_referents() {
	var directory = compiler_directory("nested-reference-store-escape");
	var source = """i32 shared;
struct Holder { i32& reference; };
fn write_holder(var Holder& destination, i32& value) { @destination = Holder(value); };
fn write_wrapper(var Holder& destination, i32& value) { write_holder(@destination, value); };
fn read_holder() -> i32 {
	Holder holder = Holder(shared);
	{
		i32 local = 42;
		write_wrapper(@holder, local);
	};
	return holder.reference;
};
""";
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back(source);

	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<compilation_error>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	rt::test::expect(records.size());
	rt::test::expect(records.data()[0].message.contains("stored reference may outlive its referent"));
};

[[test]]
fn nested_reference_stores_accept_overwrites_before_scope_exit() {
	var directory = compiler_directory("nested-reference-store-overwrite");
	var source = """i32 shared;
struct Holder { i32& reference; };
fn write_holder(var Holder& destination, i32& value) { @destination = Holder(value); };
fn write_wrapper(var Holder& destination, i32& value) { write_holder(@destination, value); };
fn read_holder() -> i32 {
	Holder holder = Holder(shared);
	{
		i32 local = 42;
		write_wrapper(@holder, local);
		write_wrapper(@holder, shared);
	};
	return holder.reference;
};
""";
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back(source);

	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<void>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::test::expect(!analysis.value().diagnostics().failed());
};

[[test]]
fn local_virtual_calls_do_not_escape_the_receiver_through_unrelated_construction() {
	var directory = compiler_directory("local-virtual-receiver");
	var source = """
struct View { i32 value; };
struct Base { fn read(Base& this) -> View : [virtual]; };
fn Base::read(Base& this) -> View { return View(0); };
struct Derived : [Base] { fn read(Derived& this) -> View : [override]; };
fn Derived::read(Derived& this) -> View { return View(42); };
fn unrelated(bool condition) {
	if (condition) {
		var other = View(3);
	};
};
fn observe() -> i32 {
	Derived owner;
	unrelated(true);
	Base& alias = owner;
	View first = alias.read();
	View second = alias.read();
	return first.value + second.value;
};
""";
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back(source);
	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<void>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::test::expect(!analysis.value().diagnostics().failed());
};

[[test]]
fn escaping_a_virtual_receiver_keeps_its_lifetime_loan_active() {
	var directory = compiler_directory("escaped-virtual-receiver");
	var source = """
struct Base { fn read(Base& this) -> i32 : [virtual]; };
fn Base::read(Base& this) -> i32 { return 0; };
struct Derived : [Base] { fn read(Derived& this) -> i32 : [override]; };
fn Derived::read(Derived& this) -> i32 { return 42; };
fn retain(Base& receiver);
fn observe() -> i32 {
	Derived owner;
	Base& alias = owner;
	retain(alias);
	return alias.read();
};
""";
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back(source);
	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<compilation_error>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	rt::test::expect(records.size());
	rt::test::expect(records.data()[0].message.contains("dependent reference loan"));
};

[[test]]
fn raw_mutation_after_global_receiver_aliasing_keeps_virtual_dispatch_conservative() {
	var directory = compiler_directory("raw-virtual-receiver");
	var source = """
struct Base { fn read(Base& this) -> i32 : [virtual]; };
fn Base::read(Base& this) -> i32 { return 0; };
struct Derived : [Base] { fn read(Derived& this) -> i32 : [override]; };
fn Derived::read(Derived& this) -> i32 { return 42; };
var void* saved;
fn remember(var Base& receiver) { @saved = static_cast<var void*>(&@receiver); };
fn overwrite_saved(var void* address);
fn observe() -> i32 {
	Derived owner;
	var Base& alias = @owner;
	remember(@alias);
	overwrite_saved(saved);
	return alias.read();
};
""";
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back(source);
	var result = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library);
	rt::test::expect(result.has<compilation_error>());
	var analysis = @compiler.acquire_analysis();
	rt::test::expect(analysis.get());
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	rt::test::expect(records.size());
	rt::test::expect(records.data()[0].message.contains("dependent reference loan"));
};
