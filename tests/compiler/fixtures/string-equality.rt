fn compare_in_each_direction(const rt::string& first, const rt::string& second, const rt::string_view& first_view, const rt::string_view& second_view, i32 expected) -> bool {
	if ((first == second) != (expected == 0) || (second == first) != (-expected == 0) || (first == second_view) != (expected == 0) || (second_view == first) != (-expected == 0) || (first_view == second) != (expected == 0) || (second == first_view) != (-expected == 0) || (first_view == second_view) != (expected == 0) || (second_view == first_view) != (-expected == 0)) {
		return false;
	};
	if ((first != second) != (expected != 0) || (second != first) != (-expected != 0) || (first != second_view) != (expected != 0) || (second_view != first) != (-expected != 0) || (first_view != second) != (expected != 0) || (second != first_view) != (-expected != 0) || (first_view != second_view) != (expected != 0) || (second_view != first_view) != (-expected != 0)) {
		return false;
	};
	if ((first < second) != (expected < 0) || (second < first) != (-expected < 0) || (first < second_view) != (expected < 0) || (second_view < first) != (-expected < 0) || (first_view < second) != (expected < 0) || (second < first_view) != (-expected < 0) || (first_view < second_view) != (expected < 0) || (second_view < first_view) != (-expected < 0)) {
		return false;
	};
	if ((first <= second) != (expected <= 0) || (second <= first) != (-expected <= 0) || (first <= second_view) != (expected <= 0) || (second_view <= first) != (-expected <= 0) || (first_view <= second) != (expected <= 0) || (second <= first_view) != (-expected <= 0) || (first_view <= second_view) != (expected <= 0) || (second_view <= first_view) != (-expected <= 0)) {
		return false;
	};
	if ((first > second) != (expected > 0) || (second > first) != (-expected > 0) || (first > second_view) != (expected > 0) || (second_view > first) != (-expected > 0) || (first_view > second) != (expected > 0) || (second > first_view) != (-expected > 0) || (first_view > second_view) != (expected > 0) || (second_view > first_view) != (-expected > 0)) {
		return false;
	};
	if ((first >= second) != (expected >= 0) || (second >= first) != (-expected >= 0) || (first >= second_view) != (expected >= 0) || (second_view >= first) != (-expected >= 0) || (first_view >= second) != (expected >= 0) || (second >= first_view) != (-expected >= 0) || (first_view >= second_view) != (expected >= 0) || (second_view >= first_view) != (-expected >= 0)) {
		return false;
	};
	return true;
};

fn is_abc(const rt::string_view& value) -> bool {
	return value == rt::string_view("abc\0");
};

fn main() -> i32 {
	var first = rt::string("abc\0");
	var same = rt::string("abc\0");
	var different = rt::string("abd\0");
	var shorter = rt::string("ab\0");
	if (!compare_in_each_direction(first, same, first, same, 0)) {
		return 1;
	};
	if (!compare_in_each_direction(first, different, first, different, -1)) {
		return 2;
	};
	if (!compare_in_each_direction(first, shorter, first, shorter, 1)) {
		return 3;
	};

	rt::string empty;
	var allocated_empty = rt::string("\0");
	if (!compare_in_each_direction(empty, allocated_empty, empty, allocated_empty, 0)) {
		return 4;
	};
	if (!compare_in_each_direction(empty, first, empty, first, -1)) {
		return 5;
	};

	var binary = rt::string(rt::string_view("a\0b\0", 3));
	var same_binary = rt::string(rt::string_view("a\0b\0", 3));
	var different_binary = rt::string(rt::string_view("a\0c\0", 3));
	var prefix = rt::string("a\0");
	if (!compare_in_each_direction(binary, same_binary, binary, same_binary, 0)) {
		return 6;
	};
	if (!compare_in_each_direction(binary, different_binary, binary, different_binary, -1)) {
		return 7;
	};
	if (!compare_in_each_direction(binary, prefix, binary, prefix, 1)) {
		return 8;
	};

	if (!(rt::string("abc\0") == rt::string("abc\0")) || !(rt::string("abc\0") == rt::string_view("abc\0")) || !(rt::string_view("abc\0") == rt::string("abc\0"))) {
		return 9;
	};
	if ((rt::string("abc\0") == rt::string("abd\0")) || (rt::string("abc\0") == rt::string_view("ab\0")) || (rt::string_view("ab\0") == rt::string("abc\0"))) {
		return 10;
	};
	if (!is_abc(rt::string("abc\0")) || is_abc(rt::string("abd\0")) || is_abc(rt::string("ab\0"))) {
		return 11;
	};
	char[1] high_byte;
	@high_byte[0] = char(255);
	char[1] low_byte;
	@low_byte[0] = char(127);
	var high = rt::string(rt::string_view(&high_byte[0], 1));
	var low = rt::string(rt::string_view(&low_byte[0], 1));
	if (!compare_in_each_direction(high, low, high, low, 1)) {
		return 12;
	};
	var earlier_but_longer = rt::string("aaa-long\0");
	if (!compare_in_each_direction(earlier_but_longer, first, earlier_but_longer, first, -1)) {
		return 13;
	};
	if (!(rt::string("abc\0") != rt::string("abd\0")) || !(rt::string("abc\0") < rt::string("abd\0")) || !(rt::string("abc\0") <= rt::string("abc\0")) || !(rt::string("abd\0") > rt::string("abc\0")) || !(rt::string("abc\0") >= rt::string("abc\0"))) {
		return 14;
	};
	if (!(rt::string("abc\0") != rt::string_view("abd\0")) || !(rt::string("abc\0") < rt::string_view("abd\0")) || !(rt::string("abc\0") <= rt::string_view("abc\0")) || !(rt::string("abd\0") > rt::string_view("abc\0")) || !(rt::string("abc\0") >= rt::string_view("abc\0"))) {
		return 15;
	};
	if (!(rt::string_view("abc\0") != rt::string("abd\0")) || !(rt::string_view("abc\0") < rt::string("abd\0")) || !(rt::string_view("abc\0") <= rt::string("abc\0")) || !(rt::string_view("abd\0") > rt::string("abc\0")) || !(rt::string_view("abc\0") >= rt::string("abc\0"))) {
		return 16;
	};
	return 42;
};


