fn main() -> i32 {
	var maximum = ~usize(0);
	usize highest = maximum / 2 + 1;
	usize power = 1;
	while (power < highest) {
		if (rt::string::capacity_for(usize(power)) != power) {
			return 1;
		};
		if (rt::string::capacity_for(power + 1) != power * 2) {
			return 2;
		};
		if (power > 2 && rt::string::capacity_for(power - 1) != power) {
			return 3;
		};
		@power = power * 2;
	};
	if (rt::string::capacity_for(usize(highest)) != highest || rt::string::capacity_for(highest - 1) != highest) {
		return 4;
	};
	if (rt::string::capacity_for(highest + 1) != highest + 1 || rt::string::capacity_for(maximum - 1) != maximum - 1 || rt::string::capacity_for(usize(maximum)) != maximum) {
		return 5;
	};
	return 42;
};

