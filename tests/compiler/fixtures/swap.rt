struct SwapTracker {
	fn SwapTracker(SwapTracker& this, i32* destroyed, i32 value);
	fn ~SwapTracker(SwapTracker& this);
	i32* destroyed;
	i32 value;
};

fn SwapTracker::SwapTracker(SwapTracker& this, i32* destroyed, i32 value) {
	@this.destroyed = $destroyed;
	@this.value = $value;
};

fn SwapTracker::~SwapTracker(SwapTracker& this) {
	@*this.destroyed = *this.destroyed + 1;
};

fn main() -> i32 {
	i32 left = 12;
	i32 right = 30;
	swap<i32>(@left, @right);
	if (left != 30 || right != 12) {
		return 1;
	};
	swap<i32>(@left, @left);
	if (left != 30) {
		return 2;
	};
	i32* first = &left;
	i32* second = &right;
	swap<i32*>(@first, @second);
	if (first != &right || second != &left) {
		return 3;
	};
	i32 destroyed = 0;
	{
		var a = unique<SwapTracker>(new SwapTracker(&destroyed, 10));
		var b = unique<SwapTracker>(new SwapTracker(&destroyed, 20));
		swap<unique<SwapTracker>>(@a, @b);
		if (a.get()->value != 20 || b.get()->value != 10 || destroyed) {
			return 4;
		};
		unique<SwapTracker> empty;
		swap<unique<SwapTracker>>(@a, @empty);
		if (a.get() || empty.get()->value != 20 || destroyed) {
			return 5;
		};
	};
	if (destroyed != 2) {
		return 6;
	};
	return 42;
};
