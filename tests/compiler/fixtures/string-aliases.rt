fn set_character(rt::string::value_t& value, rt::string::value_t replacement) {
	@value = $replacement;
};

fn main() -> i32 {
	rt::string::value_t character = 'a';
	rt::string::value_t* pointer = &character;
	set_character(@character, 'b');
	if (pointer[0] != 'b') {
		return 1;
	};

	rt::string_view::value_t view_character = 'c';
	rt::string_view::value_t* view_pointer = &view_character;
	var view = rt::string_view(view_pointer, 1);
	var text = rt::string(view);
	const rt::string::value_t* text_pointer = text.data();
	if (text_pointer[0] != 'c' || !(text == view)) {
		return 2;
	};
	rt::string::value_t* writable = (@text).data();
	@writable[0] = 'd';
	if (text.data()[0] != 'd') {
		return 3;
	};
	return 42;
};
