[[test]]
fn library_output_is_a_native_x64_object() {
	var directory = compiler_directory("native-object");
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	@paths.push_back("source.rt");
	@sources.push_back("export fn exported_answer() -> i32 { return 42; };\n");

	var compiled = @compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::library);
	rt::test::expect(compiled.has<void>());
	var object = rt::fs::read(directory + "/case.obj");
	rt::test::expect(object.has<rt::string>());
	rt::test::expect(object.get<rt::string>().size() >= 20);
	rt::test::expect(static_cast<u08>(object.get<rt::string>().data()[0]) == 100);
	rt::test::expect(static_cast<u08>(object.get<rt::string>().data()[1]) == 134);

	rt::test::expect(object.get<rt::string>().contains("exported_answer"));
};

[[test]]
fn template_instantiations_generate_native_code() {
	var directory = compiler_directory("template-execution");
	var subject = "template<typename T> fn twice(T value) -> T { return value + value; };\n";
	var source = """[[test]] fn instantiate() {
	rt::test::expect(twice<i32>(21) == 42);
	rt::test::expect(twice<i64>(21) == 42);
};
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());
};

[[test]]
fn failed_expectations_preserve_following_tests() {
	var directory = compiler_directory("assertion-exceptions");
	var subject = "fn puts(char* text) -> i32;\n";
	var source = """[[test]] fn first() {
	rt::test::expect(false);
	discard puts("continued after failure\0".data());
};
[[test]] fn second() { discard puts("subsequent test ran\0".data()); };
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());

	var failures_before = rt::test::failures;
	bool continued_after_failure = false;
	bool caught = false;
	try {
		rt::test::expect(false);
		@continued_after_failure = true;
	} catch (...) {
		@caught = true;
	};
	var failures_after = rt::test::failures;
	@rt::test::failures = failures_before;
	rt::test::expect(caught && !continued_after_failure);
	rt::test::expect(failures_after == failures_before + 1);
	rt::test::expect(true);
};