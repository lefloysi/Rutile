fn puts(char* text) -> i32;

fn standard_interface() -> rt::string {
	rt::string context = rt::environment("KILN_TEST_INTERFACES");
	var document = rt::json_parse(context);
	rt::test::expect(document.has<rt::unique<rt::json_value>>());
	var standard = document.get<rt::unique<rt::json_value>>().get()->member("std");
	rt::test::expect(standard && standard->kind() == rt::json_kind::string);
	return rt::string(standard->text());
};

fn compiler_directory(rt::string_view name) -> rt::string {
	var directory = rt::string("build/tests/compiler/") + name;
	rt::fs::create_directories(directory);
	return $directory;
};

fn standard_sources() -> InterfaceResult {
	var bytes = rt::fs::read(standard_interface());
	rt::test::expect(bytes.has<rt::string>());
	return decode_interface(bytes.get<rt::string>(), rt::from_c_string(rutile_compiler_version()), static_cast<u32>(sizeof(usize) * 8), false);
};

fn append_import(var Compiler& compiler, rt::buffer<InterfaceSource>& imported, var rt::buffer<rt::string_view>& paths, var rt::buffer<rt::string_view>& sources) {
	for (usize index = 0; index < imported.size(); @index = index + 1) {
		InterfaceSource& source = imported.data()[index];
		@paths.push_back(source.path);
		@sources.push_back(source.text);
		@compiler.add_module_source(source.path, source.module, source.access);
	};
};
