[[test]]
fn unknown_types_report_the_source_location() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	if (!rt::test::expect(@paths.push_back("source.rt")) || !rt::test::expect(@sources.push_back("fn broken() {\n\tMissing value;\n};\n"))) {
		return;
	};
	rt::test::expect(@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library) == 1);
	var analysis = @compiler.acquire_analysis();
	if (!rt::test::expect(analysis.get())) {
		return;
	};
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	if (!rt::test::expect(records.size())) {
		return;
	};
	rt::test::expect(records.data()[0].location.line == 2 && records.data()[0].location.column == 2);
	rt::test::expect(records.data()[0].message.contains("unknown type name 'Missing'"));
};

[[test]]
fn lexer_reports_the_actual_invalid_character() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	if (!rt::test::expect(@paths.push_back("source.rt")) || !rt::test::expect(@sources.push_back("fn broken() { #; };\n"))) {
		return;
	};
	rt::test::expect(@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library) == 1);
	var analysis = @compiler.acquire_analysis();
	if (!rt::test::expect(analysis.get())) {
		return;
	};
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	if (!rt::test::expect(records.size())) {
		return;
	};
	rt::test::expect(records.data()[0].message.contains("unknown source character; found '#'"));
};

[[test]]
fn parser_reports_the_actual_unexpected_token() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	if (!rt::test::expect(@paths.push_back("source.rt")) || !rt::test::expect(@sources.push_back("fn take(i32 value];\n"))) {
		return;
	};
	rt::test::expect(@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library) == 1);
	var analysis = @compiler.acquire_analysis();
	if (!rt::test::expect(analysis.get())) {
		return;
	};
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	if (!rt::test::expect(records.size())) {
		return;
	};
	rt::test::expect(records.data()[0].message.contains("expected"));
	rt::test::expect(records.data()[0].message.contains("found ']'"));
};

[[test]]
fn constant_array_bounds_are_checked() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	if (!rt::test::expect(@paths.push_back("source.rt")) || !rt::test::expect(@sources.push_back("fn broken() -> i32 { i32[2] values {}; return values[2]; };\n"))) {
		return;
	};
	rt::test::expect(@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library) == 1);
	var analysis = @compiler.acquire_analysis();
	if (!rt::test::expect(analysis.get())) {
		return;
	};
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	if (!rt::test::expect(records.size())) {
		return;
	};
	rt::test::expect(records.data()[0].message.contains("array index is provably outside the array bounds"));
};

[[test]]
fn immutable_places_reject_assignment() {
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	if (!rt::test::expect(@paths.push_back("source.rt")) || !rt::test::expect(@sources.push_back("fn broken() { i32 value = 1; value = 2; };\n"))) {
		return;
	};
	rt::test::expect(@compiler.compile_sources(paths, sources, "build/tests/compiler/unexpected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library) == 1);
	var analysis = @compiler.acquire_analysis();
	if (!rt::test::expect(analysis.get())) {
		return;
	};
	rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
	if (!rt::test::expect(records.size())) {
		return;
	};
	rt::test::expect(records.data()[0].message.contains("assignment requires explicit mutable access to a place"));
};

