[[test]]
fn class_template_specializations_compile_their_selected_definitions() {
	var directory = compiler_directory("class-template-specialization");
	var subject = """template<typename Tag, typename V, typename G>
struct Handle {
	V value;
	G generation;
	fn kind() -> i32 { return 1; };
};
template<typename Tag, typename V>
struct Handle<Tag, V, void> {
	V value;
	fn Handle(var Handle& this, V value) { @this.value = $value; };
	fn get(Handle& this) -> V { return this.value; };
	fn kind() -> i32 { return 2; };
};
struct Tag {};
template<>
struct Handle<Tag, i32, void> {
	i32 value;
	fn kind() -> i32 { return 3; };
};
template<typename T> struct Box { T value; };
template<typename T> struct Classifier { fn kind() -> i32 { return 4; }; };
template<typename T> struct Classifier<Box<T>> { fn kind() -> i32 { return 5; }; };
template<typename T> struct Classifier<T*> { fn kind() -> i32 { return 6; }; };
template<typename T> struct Classifier<const T> { fn kind() -> i32 { return 11; }; };
template<typename T> struct Classifier<Box<const T>> { fn kind() -> i32 { return 12; }; };
template<typename T> struct Classifier<T&> { fn kind() -> i32 { return 13; }; };
template<typename T, usize N> struct Classifier<T[N]> { fn kind() -> i32 { return 14; }; fn count() -> usize { return N; }; };
template<typename A, typename B> struct EqualTypes { fn kind() -> i32 { return 7; }; };
template<typename T> struct EqualTypes<T, T> { fn kind() -> i32 { return 8; }; };
template<i32 N> struct Count { fn kind() -> i32 { return 9; }; };
template<> struct Count<4> { fn kind() -> i32 { return 10; }; };
""";
	var source = """[[test]] fn select_specializations() {
	rt::test::expect(Handle<Tag, u32, u16>::kind() == 1);
	rt::test::expect(Handle<Tag, i64, void>::kind() == 2);
	rt::test::expect(Handle<Tag, i32, void>::kind() == 3);
	var handle = Handle<Tag, i64, void>(42);
	rt::test::expect(handle.get() == 42);
	rt::test::expect(sizeof(Handle<Tag, i64, void>) == sizeof(i64));
	rt::test::expect(Classifier<i32>::kind() == 4);
	rt::test::expect(Classifier<Box<i32>>::kind() == 5);
	rt::test::expect(Classifier<i32*>::kind() == 6);
	rt::test::expect(Classifier<const i32>::kind() == 11);
	rt::test::expect(Classifier<Box<const i32>>::kind() == 12);
	rt::test::expect(Classifier<const Box<i32>>::kind() == 11);
	rt::test::expect(Classifier<i32&>::kind() == 13);
	rt::test::expect(Classifier<i32[3]>::kind() == 14);
	rt::test::expect(Classifier<i32[3]>::count() == 3);
	rt::test::expect(EqualTypes<i32, i64>::kind() == 7);
	rt::test::expect(EqualTypes<i32, i32>::kind() == 8);
	rt::test::expect(Count<3>::kind() == 9);
	rt::test::expect(Count<4>::kind() == 10);
};
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());
};

[[test]]
fn class_template_specializations_reject_missing_duplicate_and_ambiguous_definitions() {
	rt::buffer<rt::string_view> cases;
	rt::buffer<rt::string_view> expected;
	@cases.push_back("template<typename T> struct Missing<T, void> {};\n");
	@expected.push_back("requires a declared primary class template");
	@cases.push_back("template<typename A, typename B> struct Pick {}; template<typename T> struct Pick<T, void> {}; template<typename U> struct Pick<U, void> {};\n");
	@expected.push_back("duplicate class template specialization");
	@cases.push_back("template<typename A, typename B> struct Pick {}; template<typename T> struct Pick<T, i32> {}; template<typename U> struct Pick<i32, U> {}; Pick<i32, i32> value;\n");
	@expected.push_back("ambiguous class template specialization");
	@cases.push_back("template<typename A, typename B> struct Pick {}; template<> struct Pick<i32> {};\n");
	@expected.push_back("must specify every primary template argument");
	@cases.push_back("template<typename A, typename B> struct Pick {}; template<typename X, typename Y> struct Pick<X, Y> {};\n");
	@expected.push_back("must constrain the primary template arguments");
	@cases.push_back("template<typename T> struct Pick {}; template<typename X, typename Y> struct Pick<X*> {};\n");
	@expected.push_back("parameter cannot be deduced");
	@cases.push_back("template<typename T> fn value() -> i32 { return 1; }; template<> fn value<i32>() -> i32 { return 2; };\n");
	@expected.push_back("empty template parameter list requires a class template specialization");
	for (usize index = 0; index < cases.size(); @index = index + 1) {
		Compiler compiler;
		rt::buffer<rt::string_view> paths;
		rt::buffer<rt::string_view> sources;
		@paths.push_back("source.rt");
		@sources.push_back(cases.data()[index]);
		rt::test::expect((@compiler.compile_sources(paths, sources, "build/tests/compiler/specialization-rejected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library)).has<compilation_error>());
		var analysis = @compiler.acquire_analysis();
		rt::test::expect(analysis.get());
		rt::buffer<DiagnosticRecord>& records = analysis.value().diagnostics().records();
		rt::test::expect(records.size());
		rt::test::expect(records.data()[0].message.contains(expected.data()[index]));
	};
};

[[test]]
fn logical_negation_uses_only_implicit_boolean_conversions() {
	var directory = compiler_directory("implicit-boolean-negation");
	var subject = """struct Flag {
	bool value;
	fn operator bool(Flag& this) -> bool : [implicit] { return this.value; };
};
""";
	var source = """[[test]] fn negate_flags() {
	Flag flag;
	rt::test::expect(!flag);
	@flag.value = true;
	rt::test::expect(!(!flag));
	bool entered = false;
	if (flag) { @entered = true; };
	rt::test::expect(entered);
};
""";
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	Compiler compiler;
	rt::buffer<rt::string_view> paths;
	rt::buffer<rt::string_view> sources;
	append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
	@paths.push_back("subject.rt");
	@sources.push_back(subject);
	@paths.push_back("tests.rt");
	@sources.push_back(source);
	rt::test::expect((@compiler.compile_sources(paths, sources, directory + "/case.obj", &platform_open_utf8_file, "", 0, platform_standard_error(), output_kind::tests)).has<void>());

	Compiler rejected;
	rt::buffer<rt::string_view> rejected_paths;
	rt::buffer<rt::string_view> rejected_sources;
	@rejected_paths.push_back("explicit.rt");
	@rejected_sources.push_back("struct Flag { fn operator bool(Flag& this) -> bool { return true; }; }; fn broken(Flag& flag) -> bool { return !flag; };\n");
	rt::test::expect((@rejected.compile_sources(rejected_paths, rejected_sources, directory + "/explicit.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library)).has<compilation_error>());
};

[[test]]
fn identifier_tags_prevent_cross_tag_assignment_and_comparison() {
	var imported = standard_sources();
	rt::test::expect(imported.has<rt::buffer<InterfaceSource>>());
	rt::buffer<rt::string_view> cases;
	@cases.push_back("struct A {}; struct B {}; using First = rt::identifier<A, u32, void>; using Second = rt::identifier<B, u32, void>; fn broken(First& first) { Second second; @second := first; };\n");
	@cases.push_back("struct A {}; struct B {}; using First = rt::identifier<A, u32, u16>; using Second = rt::identifier<B, u32, u16>; fn broken(First& first, Second& second) -> bool { return first == second; };\n");
	for (usize index = 0; index < cases.size(); @index = index + 1) {
		Compiler compiler;
		rt::buffer<rt::string_view> paths;
		rt::buffer<rt::string_view> sources;
		append_import(@compiler, imported.get<rt::buffer<InterfaceSource>>(), @paths, @sources);
		@paths.push_back("source.rt");
		@sources.push_back(cases.data()[index]);
		rt::test::expect((@compiler.compile_sources(paths, sources, "build/tests/compiler/identifier-tag-rejected.obj", &platform_open_utf8_file, "", 0, nullptr, output_kind::library)).has<compilation_error>());
	};
};
