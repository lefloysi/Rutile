fn make_owned_error() -> rt::error {
	rt::string message = "rtslc: input failed";
	var failure = rt::error(message);
	@message.clear();
	return $failure;
};

[[test]]
fn error_keeps_a_message_after_its_source_is_destroyed() {
	var failure = make_owned_error();
	rt::test::expect(failure.description() == "rtslc: input failed");
};
