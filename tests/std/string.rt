[[test]]
fn compound_string_assignment_preserves_the_left_reference() {
	var text = rt::string("hello");
	var suffix = rt::string(" world");
	var rt::string* original = &@text;
	@text += suffix;
	rt::test::expect(text == "hello world");
	rt::test::expect(suffix == " world");
	{
		var result = (@text += rt::string_view("!"));
		rt::test::expect(result.has<var rt::string&>());
		var rt::string& reference = result.get<var rt::string&>();
		rt::test::expect(&reference == original);
		@reference.clear();
	};
	rt::test::expect(text.empty());
	{
		var rt::string& extracted = (@text += "again");
		rt::test::expect(&extracted == original);
		rt::test::expect(extracted == "again");
	};
	rt::test::expect(text == "again");
};

[[test]]
fn compound_string_assignment_captures_allocation_failure() {
	var text = rt::string("retained");
	var too_large = rt::string_view(text.data(), usize::max);
	var result = (@text += too_large);
	rt::test::expect(result.has<rt::allocation_error>());
	rt::test::expect(result.get<rt::allocation_error>().requested_bytes == usize::max);
	rt::test::expect(text == "retained");
	var caught = false;
	try {
		@text += too_large;
	} catch (rt::allocation_error& error) {
		@caught = error.requested_bytes == usize::max;
	};
	rt::test::expect(caught);
	rt::test::expect(text == "retained");
};

[[test]]
fn empty_strings_have_a_terminator() {
	rt::string text;
	rt::test::expect(text.empty());
	rt::test::expect(!text.size());
	rt::test::expect(text.capacity() == 15);
	rt::test::expect(text.data());
	rt::test::expect(!text.data()[0]);
	var appended = @text.append("");
	rt::test::expect(appended.has<void>());
	@text.clear();
	rt::test::expect(!text.data()[0]);
};

[[test]]
fn strings_convert_to_views_and_concatenate() {
	var first = rt::string("hello");
	var second = rt::string(" world");
	rt::string_view view = first;
	rt::test::expect(view == "hello");
	rt::string joined = first + second;
	rt::test::expect(joined == "hello world");
	rt::test::expect(first == "hello");
	rt::test::expect(second == " world");
	rt::string literal_rhs = first + "!";
	rt::test::expect(literal_rhs == "hello!");
	rt::test::expect(first == "hello");
	rt::string views = rt::string_view("hello") + rt::string_view(" world");
	rt::test::expect(views == "hello world");
	rt::string literals = "hello" + " world";
	rt::test::expect(literals == "hello world");
	rt::string prefixed = "say " + joined;
	rt::string suffixed = joined + "!";
	rt::test::expect(prefixed == "say hello world");
	rt::test::expect(suffixed == "hello world!");
};

[[test]]
fn concatenation_returns_reserve_failure_without_reading_the_input() {
	var huge = rt::string_view("x".data(), usize::max - 1);
	rt::string_view empty;
	var result = huge + empty;
	rt::test::expect(result.has<rt::allocation_error>());
	rt::test::expect(result.get<rt::allocation_error>().requested_bytes == usize::max);
	try {
		rt::string extracted = huge + empty;
		rt::test::expect(false);
	}
	catch (rt::allocation_error& error) {
		rt::test::expect(error.requested_bytes == usize::max);
	};
};

[[test]]
fn string_copies_own_independent_storage() {
	var original = rt::string("abc");
	rt::string copied := original;
	rt::test::expect(copied == "abc");
	rt::test::expect(copied.data() != original.data());
	var char* writable = @original.data();
	@writable[0] = 'A';
	rt::test::expect(original == "Abc");
	rt::test::expect(copied == "abc");
	@copied := original;
	@copied := copied;
	rt::test::expect(copied == "Abc");
	var moved = $original;
	@copied = $moved;
	rt::test::expect(copied == "Abc");
};

[[test]]
fn appending_overlapping_views_survives_growth() {
	var text = rt::string("123456789abcdef");
	var appended = @text.append(text);
	rt::test::expect(appended.has<void>());
	rt::test::expect(text == "123456789abcdef123456789abcdef");
	var middle = rt::string_view(text.data() + 2, 3);
	var middle_appended = @text.append(middle);
	rt::test::expect(middle_appended.has<void>());
	rt::test::expect(text == "123456789abcdef123456789abcdef345");
	rt::test::expect(!text.data()[text.size()]);
};

[[test]]
fn string_capacity_failures_preserve_text() {
	var text = rt::string("preserved");
	var reserved = @text.reserve(128);
	rt::test::expect(reserved.has<void>());
	usize capacity = text.capacity();
	char* storage = text.data();
	rt::test::expect(capacity >= 128);
	var existing_capacity = @text.reserve(16);
	rt::test::expect(existing_capacity.has<void>());
	rt::test::expect(text.capacity() == capacity);
	var overflow_reserve = @text.reserve(usize::max);
	rt::test::expect(overflow_reserve.has<rt::allocation_error>());
	try {
		@text.reserve(usize::max);
		rt::test::expect(false);
	}
	catch (rt::allocation_error& error) {
		rt::test::expect(error.requested_bytes == usize::max);
	};
	var appended = @text.append(rt::string_view("x".data(), usize::max));
	rt::test::expect(appended.has<rt::allocation_error>());
	rt::test::expect(text.data() == storage);
	rt::test::expect(text == "preserved");
	try {
		var oversized = rt::string(rt::string_view("x".data(), usize::max));
		rt::test::expect(false);
	}
	catch (rt::allocation_error error) {
		rt::test::expect(error.requested_bytes == usize::max);
	};
	var overflow = text + rt::string_view("x".data(), usize::max);
	rt::test::expect(overflow.has<rt::allocation_error>());
	rt::test::expect(overflow.get<rt::allocation_error>().requested_bytes == usize::max);
	rt::test::expect(text == "preserved");
	try {
		rt::string oversized = text + rt::string_view("x".data(), usize::max);
		rt::test::expect(false);
	}
	catch (rt::allocation_error error) {
		rt::test::expect(error.requested_bytes == usize::max);
	};
	@text.clear();
	rt::test::expect(text.empty());
	rt::test::expect(text.capacity() == capacity);
	var reused = @text.append("reused");
	rt::test::expect(reused.has<void>());
	rt::test::expect(text == "reused");
};

[[test]]
fn string_comparisons_include_embedded_zeroes_and_unsigned_bytes() {
	var binary = rt::string("a\0b");
	rt::test::expect(binary.size() == 3);
	rt::test::expect(binary == "a\0b");
	rt::test::expect(binary != "a");
	rt::test::expect(binary > "a");
	rt::test::expect(binary < "a\0c");
	rt::test::expect(binary <= "a\0b");
	rt::test::expect(binary >= "a\0b");
	rt::string joined = binary + "c";
	rt::test::expect(joined.size() == 4);
	rt::test::expect(joined == "a\0bc");
	char[1] high;
	char[1] low;
	@high[0] = char(255);
	@low[0] = char(127);
	var high_text = rt::string(rt::string_view(&high[0], 1));
	var low_text = rt::string(rt::string_view(&low[0], 1));
	rt::test::expect(high_text > low_text);
};

[[test]]
fn substring_search_checks_boundaries_and_binary_text() {
	var owned = rt::string("compiler output");
	rt::test::expect(owned.contains("output"));
	rt::test::expect(!owned.contains("missing"));
	rt::string_view text = "compiler output";
	rt::test::expect(text.contains("compiler"));
	rt::test::expect(text.contains("output"));
	rt::test::expect(text.contains("compiler output"));
	rt::test::expect(text.contains(""));
	rt::test::expect(!text.contains("compiler outputs"));
	rt::test::expect(!text.contains("Output"));
	rt::string_view empty;
	rt::test::expect(empty.contains(""));
	rt::test::expect(!empty.contains("x"));
	rt::string_view binary = "a\0b";
	rt::test::expect(binary.contains("\0b"));
	rt::test::expect(!binary.contains("ab"));
};

[[test]]
fn trimming_returns_a_view_without_changing_the_text() {
	var source = rt::string(" \t0.0.113\r\n");
	var trimmed = source.trim();
	rt::test::expect(trimmed == "0.0.113");
	rt::test::expect(source == " \t0.0.113\r\n");
	rt::test::expect(trimmed.data() == source.data() + 2);
	rt::test::expect(rt::string_view("\r\n\t ").trim().empty());
	rt::test::expect(rt::string_view().trim().empty());
	rt::test::expect(rt::string_view("a b").trim() == "a b");
};
