[[test]]
fn persistent_editor_service_supplies_project_sources_imported_types_colors_and_navigation() {
	var result = editor_observation("Service");
	rt::test::expect(!result.exit_code);
	var document = rt::json_parse(result.output);
	rt::test::expect(document.has<rt::unique<rt::json_value>>());
	var root = document.get<rt::unique<rt::json_value>>().get();
	rt::test::expect(root->member("disposed")->boolean());
	rt::test::expect(root->member("cancelled_disposed")->boolean());
	rt::test::expect(root->member("unexpected_disposed")->boolean());
	rt::test::expect(root->member("unexpected_notification")->boolean());
	i64 notifications = -1;
	@notifications = root->member("disposal_notifications")->integer();
	rt::test::expect(!notifications);
	var locations = root->member("definitions");
	rt::test::expect(locations->size() == 1);
	rt::test::expect(locations->item(0)->member("uri")->text() == root->member("uri")->text());
	var start = locations->item(0)->member("range")->member("start");
	i64 position = -1;
	@position = start->member("line")->integer();
	rt::test::expect(!position);
	@position = start->member("character")->integer();
	rt::test::expect(position == 3);
	var colors = root->member("colors");
	bool function_declaration = false;
	bool function_reference = false;
	bool control = false;
	bool imported_type = false;
	bool integer_literal = false;
	for (usize index = 0; index < colors->size(); @index = index + 1) {
		var color = colors->item(index);
		var text = color->member("text")->text();
		var classification = color->member("classification")->text();
		i64 offset = -1;
		@offset = color->member("start")->integer();
		if (text == "answer" && classification == "rutile.function" && offset == 3) {
			@function_declaration = true;
		};
		if (text == "answer" && classification == "rutile.function" && offset == 62) {
			@function_reference = true;
		};
		if (text == "return" && classification == "rutile.control") {
			@control = true;
		};
		if (text == "string" && classification == "rutile.type") {
			@imported_type = true;
		};
		if (text == "42" && classification == "number") {
			@integer_literal = true;
		};
	};
	rt::test::expect(function_declaration);
	rt::test::expect(function_reference);
	rt::test::expect(control);
	rt::test::expect(imported_type);
	rt::test::expect(integer_literal);
};
