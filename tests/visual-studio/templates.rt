[[test]]
fn template_responses_reject_pending_and_stale_snapshots_and_preserve_arguments() {
	var result = editor_observation("TemplateResponses");
	if (!rt::test::expect(result.state == rt::sys::status::completed && !result.exit_code)) {
		return;
	};
	var document = rt::json_parse(result.output);
	if (!rt::test::expect(document.value())) {
		return;
	};
	var root = document.value();
	rt::test::expect(root->member("pending")->kind() == rt::json_kind::null_value);
	rt::test::expect(root->member("stale")->kind() == rt::json_kind::null_value);
	rt::test::expect(root->member("current")->member("name")->text() == "Box");
	var nested = root->member("nested");
	rt::test::expect(nested->size() == 2);
	rt::test::expect(nested->item(0)->text() == "Pair<i32, u08>");
	rt::test::expect(nested->item(1)->text() == "default_delete<Pair<i32, u08>>");
	rt::test::expect(root->member("trailing_default")->text() == "i32");
	rt::test::expect(root->member("interior_default")->text() == ", i32");
};

[[test]]
fn template_widget_keeps_inputs_compact_and_resets_selection_with_declaration_identity() {
	var result = editor_observation("TemplateWidget");
	if (!rt::test::expect(result.state == rt::sys::status::completed && !result.exit_code)) {
		return;
	};
	var document = rt::json_parse(result.output);
	if (!rt::test::expect(document.value())) {
		return;
	};
	var root = document.value();
	i64 height = 0;
	rt::test::expect(root->member("height_pixels")->integer(@height) && height <= 32);
	rt::test::expect(!root->member("input_visible")->boolean());
	var added = root->member("added");
	bool found = false;
	for (usize index = 0; index < added->size(); @index = index + 1) {
		if (added->item(index)->text() == "Box<i32>") {
			@found = true;
		};
	};
	rt::test::expect(found);
	rt::test::expect(root->member("clear_event")->boolean());
	rt::test::expect(root->member("after_clear")->item(1)->text() == "(None)");
	rt::test::expect(root->member("sample")->item(0)->text() == "i32");
	rt::test::expect(root->member("sample")->item(1)->text().empty());
	rt::test::expect(root->member("next_declaration")->item(0)->text().empty());
	rt::test::expect(root->member("next_menu")->item(1)->text() == "(None)");
};
