[[test]]
fn configured_analysis_stays_idle_and_explicit_tests_import_mixed_library_interfaces() {
	var result = editor_observation("WatchDependencies");
	rt::test::expect(!result.exit_code);
	var document = rt::json_parse(result.output);
	rt::test::expect(document.has<rt::unique<rt::json_value>>());
	var root = document.get<rt::unique<rt::json_value>>().get();
	var before_configure = root->member("before_configure");
	var after_configure = root->member("after_configure");
	var after_edit = root->member("after_edit");
	i64 before_count = -1;
	i64 configured_count = -2;
	i64 edited_count = -3;
	@before_count = before_configure->member("compilations")->integer();
	@configured_count = after_configure->member("compilations")->integer();
	@edited_count = after_edit->member("compilations")->integer();
	rt::test::expect(before_count == configured_count && before_count == edited_count);
	var configured_sessions = after_configure->member("sessions");
	for (usize index = 0; index < configured_sessions->size(); @index = index + 1) {
		rt::test::expect(!configured_sessions->item(index)->member("compiling")->boolean());
	};
	var edited_sessions = after_edit->member("sessions");
	for (usize index = 0; index < edited_sessions->size(); @index = index + 1) {
		rt::test::expect(!edited_sessions->item(index)->member("compiling")->boolean());
	};
	var watch = root->member("watch");
	i64 current_test_sessions = 0;
	@current_test_sessions = root->member("current_test_sessions")->integer();
	rt::test::expect(current_test_sessions == 1);
	rt::test::expect(watch->member("target")->text() == "subject");
	rt::test::expect(watch->member("kind")->text() == "test");
	rt::test::expect(watch->member("profile")->text() == "debug");
	rt::test::expect(!watch->member("compiling")->boolean());
	rt::test::expect(watch->member("artifacts_current")->boolean());
	i64 source_revision = -1;
	i64 artifact_revision = -2;
	@source_revision = watch->member("source_revision")->integer();
	@artifact_revision = watch->member("artifact_revision")->integer();
	rt::test::expect(source_revision == artifact_revision);
	i64 native_watch_sessions = -1;
	@native_watch_sessions = root->member("native_watch_sessions")->integer();
	rt::test::expect(!native_watch_sessions);
	rt::test::expect(root->member("progress")->member("state")->text() == "succeeded");
	rt::test::expect(root->member("diagnostics")->size() == 0);
	var colors = root->member("colors");
	bool imported_label = false;
	bool imported_view = false;
	bool test_function = false;
	for (usize index = 0; index < colors->size(); @index = index + 1) {
		var color = colors->item(index);
		var text = color->member("text")->text();
		var classification = color->member("classification")->text();
		if (text == "Label" && classification == "rutile.type") {
			@imported_label = true;
		};
		if (text == "string_view" && classification == "rutile.type") {
			@imported_view = true;
		};
		if (text == "label_uses_imported_view" && classification == "rutile.function") {
			@test_function = true;
		};
	};
	rt::test::expect(imported_label);
	rt::test::expect(imported_view);
	rt::test::expect(test_function);
};
