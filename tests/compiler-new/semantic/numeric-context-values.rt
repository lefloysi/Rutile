fn maximum(u32 bits) -> u64 {
	return (~u64(0)) >> (64 - static_cast<u64>(bits));
};

fn flag() -> bool {
	return 1 / 2;
};

fn main() -> i32 {
	u64 answer = (1 + 2) * u64(14);
	usize bytes = 4 * sizeof(i32);

	if (maximum(32) != 4294967295 || bytes != 16 || !flag()) {
		return 1;
	};

	return static_cast<i32>(answer);
};
