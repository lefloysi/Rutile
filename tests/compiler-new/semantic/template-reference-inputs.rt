fn template_reference_input_tests() -> i32 {
	TemplateFixture fixture;
	if (!@fixture.build("template<typename T = i32> struct Box {T value;}; using Default = Box<>; var box: Default; template<typename T> fn identity(T value)->T {return $value;}; fn answer()->i32 {return identity<>(identity(42));};\0")) {
		return 1;
	};

	var Entity* box = fixture.unit.get()->root_scope()->local(rt::string_view("box\0"));
	if (!box || box->type()->entity()->fields().size() != 1 || box->type()->entity()->fields().data()[0]->type()->bits() != 32) {
		return 2;
	};

	usize instances = 0;
	usize index = 0;
	while (index < fixture.unit.get()->entities().size()) {
		var Entity* entity = fixture.unit.get()->entities().data()[index].get();
		if (entity->kind() == entity_kind::function && entity->instantiated() && entity->name() == rt::string_view("identity\0")) {
			@instances = instances + 1;
		};

		@index = index + 1;
	};

	if (instances != 1) {
		return 3;
	};

	TemplateFixture missing;
	if (@missing.build("template<typename T> struct Box {T value;}; var box: Box<>;\0")) {
		return 4;
	};

	return 42;
};
