fn mixed_qualification_tests() -> i32 {
	TemplateFixture fixture;
	if (!@fixture.build("struct Holder {i32* pointer;}; template<typename T> fn data(auto T& source)->const[source] i32* {return source.pointer;}; fn answer()->i32 {i32 value=42;Holder source;@source.pointer=&value;i32* first=data<Holder>(@source);const i32* second=data<Holder>(source);i32* third=data(@source);const i32* fourth=data(source);const Holder& borrowed=source;const i32* fifth=data<Holder>(borrowed);return *fourth;};\0")) {
		return 1;
	};

	usize instances = 0;
	usize index = 0;
	while (index < fixture.unit.get()->entities().size()) {
		Entity* entity = fixture.unit.get()->entities().data()[index].get();
		if (entity->kind() == entity_kind::function && entity->instantiated() && entity->name() == rt::string_view("data\0")) {
			@instances = instances + 1;
		};
		@index = index + 1;
	};

	if (instances != 2) {
		return 2;
	};

	TemplateFixture invalid;
	if (@invalid.build("struct Holder {i32* pointer;}; template<typename T> fn data(auto T& source)->const[source] i32* {return source.pointer;}; fn answer()->i32 {Holder source;data<Holder,true>(@source);return 42;};\0")) {
		return 3;
	};

	TemplateFixture shadowed;
	if (!@shadowed.build("fn read(auto i32& i32)->i32 {return i32;};fn answer()->i32 {i32 value=42;return read(value);};\0")) {
		return 4;
	};

	return 42;
};
