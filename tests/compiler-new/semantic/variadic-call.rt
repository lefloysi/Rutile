fn snprintf(var char* destination, usize count, const char* format, ...) -> i32;

fn main() -> i32 {
	char[32] text;
	i08 number = 42;
	f32 decimal = f32(1.5);
	var count = snprintf(&@text[0], 32, "%d %.1f\0".data(), number, decimal);
	if (count != 6 || text[0] != '4' || text[1] != '2' || text[3] != '1' || text[5] != '5') {
		return 1;
	};
	return 42;
};
