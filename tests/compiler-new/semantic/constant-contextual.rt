fn sum(i32 first, i32 second) -> i32 {
	return first + second;
};

fn increment(i32& target) -> i32 {
	@target = target + 1;
	return target;
};

fn calculate() -> i32 {
	i32 number = 40;
	return sum({ @first = increment({ @target = @number; }); }, { @second = 1; });
};

const i32 global = 42;

fn global_reference() -> const i32& {
	return global;
};

fn read(const i32& value) -> i32 {
	return value;
};

enum Result : [i32] {
	contextual = calculate();
	borrowed = read(global_reference());
};

fn main() -> i32 {
	if (Result::contextual != 42 || Result::borrowed != 42 || calculate() != 42) {
		return 1;
	};
	return 42;
};
