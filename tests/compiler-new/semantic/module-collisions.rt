struct ModulePairFixture {
	SourceFile first;
	SourceFile second;
	SourceFile consumer;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax;
	rt::unique<SemanticUnit> unit;
	fn build(var ModulePairFixture& this, rt::string_view first, rt::string_view second, rt::string_view consumer, i32 first_access) -> bool;
};

fn ModulePairFixture::build(var ModulePairFixture& this, rt::string_view first, rt::string_view second, rt::string_view consumer, i32 first_access) -> bool {
	if (!@this.first.assign("first.rt", first) || !@this.second.assign("second.rt", second) || !@this.consumer.assign("consumer.rt", consumer) || !@this.first.set_module("first", first_access) || !@this.second.set_module("second", 1) || !@this.consumer.set_module("consumer", 0)) {
		return false;
	};
	var first_lexer = Lexer(@this.first);
	var second_lexer = Lexer(@this.second);
	var consumer_lexer = Lexer(@this.consumer);
	if (!@first_lexer.scan() || !@second_lexer.scan() || !@consumer_lexer.scan()) {
		return false;
	};
	var first_parser = Parser(this.first.tokens());
	var second_parser = Parser(this.second.tokens());
	var consumer_parser = Parser(this.consumer.tokens());
	var first_tree = @first_parser.parse();
	var second_tree = @second_parser.parse();
	var consumer_tree = @consumer_parser.parse();
	if (!first_tree.get() || !second_tree.get() || !consumer_tree.get() || !@this.syntax.push_back($first_tree) || !@this.syntax.push_back($second_tree) || !@this.syntax.push_back($consumer_tree)) {
		return false;
	};
	var diagnostics = Diagnostics(nullptr);
	var analyzer = Analyzer(@this.types, @diagnostics, 64);
	@this.unit = @analyzer.analyze(this.syntax);
	return this.unit.get() != nullptr;
};

fn module_collision_references(SemanticExpression& expression, rt::string_view module) -> bool {
	var Entity* entity = expression.entity();
	if (entity && (entity->name() == "helper" || entity->name() == "secret" || entity->name() == "Hidden") && (!entity->token().source || entity->token().source->module_name() != module)) {
		return false;
	};
	usize index = 0;
	while (index < expression.size()) {
		if (!module_collision_references(*expression.item(index), module)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn module_collision_tests() -> i32 {
	var private_names = ModulePairFixture();
	if (!@private_names.build("namespace detail { struct Hidden { i32 value; }; i32 secret = 20; fn helper() -> i32 { return secret; }; }; namespace first { export fn answer() -> i32 { detail::Hidden value; return detail::helper(); }; };", "namespace detail { struct Hidden { i32 value; }; i32 secret = 22; fn helper() -> i32 { return secret; }; }; namespace second { export fn answer() -> i32 { detail::Hidden value; return detail::helper(); }; };", "fn main() -> i32 { return first::answer() + second::answer(); };", 1)) {
		return 1;
	};
	usize index = 0;
	while (index < private_names.unit.get()->entities().size()) {
		var Entity* function = private_names.unit.get()->entities().data()[index].get();
		@index = index + 1;
		if (function->kind() == entity_kind::function && function->body() && function->token().source && (function->token().source->module_name() == "first" || function->token().source->module_name() == "second") && !module_collision_references(*function->body(), function->token().source->module_name())) {
			return 8;
		};
	};
	var public_records = ModulePairFixture();
	if (@public_records.build("export struct Public {};", "export struct Public {};", "fn main() -> i32 { Public value; return 42; };", 1)) {
		return 2;
	};
	var public_functions = ModulePairFixture();
	if (@public_functions.build("export fn answer() -> i32 { return 20; };", "export fn answer() -> i32 { return 22; };", "fn main() -> i32 { return answer(); };", 1)) {
		return 3;
	};
	var tested_private = ModulePairFixture();
	if (!@tested_private.build("namespace detail { fn helper() -> i32 { return 20; }; };", "namespace detail { fn helper() -> i32 { return 22; }; };", "fn main() -> i32 { return detail::helper(); };", 2)) {
		return 4;
	};
	var unrelated_private = ModulePairFixture();
	if (@unrelated_private.build("namespace detail { struct Own {}; };", "namespace detail { struct Other {}; };", "fn main() -> i32 { detail::Other value; return 42; };", 2)) {
		return 5;
	};
	var own_private = ModulePairFixture();
	if (!@own_private.build("namespace detail { fn helper() -> i32 { return 20; }; }; namespace first { export fn answer() -> i32 { return detail::helper(); }; };", "namespace detail { export fn helper() -> i32 { return 22; }; };", "fn main() -> i32 { return first::answer() + detail::helper(); };", 1)) {
		return 6;
	};
	var private_templates = ModulePairFixture();
	if (!@private_templates.build("namespace detail { template<typename T> struct Hidden { T value; }; template<typename T> fn helper(T value) -> T { return value; }; }; namespace first { export fn answer() -> i32 { detail::Hidden<i32> value; return detail::helper(20); }; };", "namespace detail { template<typename T> struct Hidden { T value; }; template<typename T> fn helper(T value) -> T { return value; }; }; namespace second { export fn answer() -> i32 { detail::Hidden<i32> value; return detail::helper(22); }; };", "fn main() -> i32 { return first::answer() + second::answer(); };", 1)) {
		return 7;
	};
	return 42;
};
