fn reference_tests() -> i32 {
	var temporary = TemplateFixture();
	if (!@temporary.build("fn inspect(const i32& value) -> i32 { const i32& local = 2; return value + local; }; fn produce(var i32& calls) -> i32 { @calls = calls + 1; return 40; }; fn compute() -> i32 { i32 calls; i32 answer = inspect(produce(@calls)); if (calls != 1) return 0; return answer; }; enum Result : [i32] { answer = compute(); };")) {
		return 1;
	};
	var Entity* result = temporary.unit.get()->root_scope()->local("Result");
	if (result->members()->local("answer")->integer() != 42) {
		return 2;
	};
	var borrowed = TemplateFixture();
	if (!@borrowed.build("fn inspect(const i32& value) -> i32 { return value; }; fn compute() -> i32 { i32 calls; i32 number = 42; i32 answer = inspect({ @calls = calls + 1; @value = @number; }); if (calls != 1) return 0; return answer; }; enum Result : [i32] { answer = compute(); };")) {
		return 3;
	};
	var Entity* borrowed_result = borrowed.unit.get()->root_scope()->local("Result");
	if (borrowed_result->members()->local("answer")->integer() != 42) {
		return 4;
	};
	return 42;
};
