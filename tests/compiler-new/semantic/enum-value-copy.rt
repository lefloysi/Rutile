enum Category : [i32] {
	answer = 42;
};

struct Holder {
	Category category;
	fn read(const Holder& this) -> Category {
		return Category(this.category);
	};
};

fn identity(Category value) -> Category {
	return value;
};

fn read(const Holder& holder) -> Category {
	return identity(Category(holder.category));
};

fn main() -> i32 {
	Holder holder;
	@holder.category = Category::answer;
	if (holder.read() != Category::answer || read(holder) != Category::answer) {
		return 1;
	};
	return 42;
};
