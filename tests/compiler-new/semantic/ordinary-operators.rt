namespace sample {
	struct Value {
		i32 number;
	};
	fn operator+(const Value& first, const Value& second) -> i32 {
		return first.number + second.number;
	};
	fn operator==(const Value& first, const Value& second) -> bool {
		return first.number == second.number;
	};
	fn operator i32(const Value& value) -> i32 : [implicit] {
		return value.number;
	};
};

fn main() -> i32 {
	sample::Value first;
	sample::Value second;
	@first.number = 20;
	@second.number = 20;
	i32 result = first + second;
	if (first == second) {
		@result = result + static_cast<i32>(first) - 18;
	};
	return result;
};
