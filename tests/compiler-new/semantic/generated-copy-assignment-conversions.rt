struct Counts {
	i32 copies;
	i32 assigned;
	i32 destroyed;
	i32 results;
};

struct Result {
	var Counts* counts;

	fn ~Result(var Result& this);
};

fn Result::~Result(var Result& this) {
	@this.counts->results = this.counts->results + 1;
};

struct Member {
	var Counts* counts;
	i32 value;

	fn Member(var Member& this) : [default];
	fn Member(var Member& this, const Member& other) : [implicit];
	fn operator:=(var Member& this, const Member& other) -> Result;
	fn assign_value(var Member& this, Member other) -> Result;
	fn ~Member(var Member& this);
};

fn Member::Member(var Member& this, const Member& other) : [implicit] {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->copies = this.counts->copies + 1;
};

fn Member::operator:=(var Member& this, const Member& other) -> Result {
	return @this.assign_value(other);
};

fn Member::assign_value(var Member& this, Member other) -> Result {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->assigned = this.counts->assigned + 1;
	Result result;
	@result.counts := this.counts;

	return $result;
};

fn Member::~Member(var Member& this) {
	if (this.counts) {
		@this.counts->destroyed = this.counts->destroyed + 1;
	};
};

struct Holder {
	Member member;

	fn operator:=(var Holder& this, const Holder& other) -> var Holder& : [default];
};

fn main() -> i32 {
	Counts counts;
	{
		Holder source;
		@source.member.counts = &@counts;
		@source.member.value = 42;
		Holder target;

		@target := source;

		if (counts.copies != 1 || counts.assigned != 1 || counts.destroyed != 1 || counts.results != 1) {
			return 1;
		};

		if (source.member.value != 42 || target.member.value != 42) {
			return 2;
		};
	};

	if (counts.destroyed != 3) {
		return 3;
	};

	return 42;
};
