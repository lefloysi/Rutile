fn template_validation_tests() -> i32 {
	var nonintegral = TemplateFixture();
	if (@nonintegral.build("template<f64 N> struct Bad { i32 value; };\0")) {
		return 1;
	};

	var duplicate = TemplateFixture();
	if (@duplicate.build("template<typename T> struct Bad { i32 value; i32 value; };\0")) {
		return 2;
	};

	var receiver = TemplateFixture();
	if (@receiver.build("template<typename T> struct Bad { fn Bad(i32 value); };\0")) {
		return 3;
	};

	var deferred = TemplateFixture();
	if (!@deferred.build("template<usize Value> struct Deferred { i32 value; Value * value; }; template<typename T> struct Reference { void& value; }; template<usize N> struct Sized { i32[N] value; };\0")) {
		return 4;
	};

	var dependent = TemplateFixture();
	if (!@dependent.build("template<typename T, T N> struct Dependent { T value; }; template<typename T> struct Owner { fn Owner(Owner<T>& this); };\0")) {
		return 5;
	};

	var unknown = TemplateFixture();
	if (@unknown.build("template<typename T> struct Bad { Missing value; };\0")) {
		return 6;
	};

	var forward = TemplateFixture();
	if (!@forward.build("template<typename T> struct Forward { Later* value; }; struct Later {};\0")) {
		return 7;
	};
	var ordinary_operator = TemplateFixture();
	if (!@ordinary_operator.build("template<typename T> struct Box { fn operator==(i32 left, i32 right) -> bool; };\0")) {
		return 8;
	};

	var value_shadow = TemplateFixture();
	if (@value_shadow.build("template<typename T> struct Box { i32 T; T value; };\0")) {
		return 9;
	};

	var sibling = TemplateFixture();
	if (@sibling.build("template<typename T> struct Outer { struct First { struct Hidden {}; }; struct Second { Hidden value; }; };\0")) {
		return 10;
	};

	var restored = TemplateFixture();
	if (!@restored.build("template<typename T> struct Outer { struct First { i32 T; }; struct Second { T value; }; T tail; };\0")) {
		return 11;
	};

	var virtual_receiver = TemplateFixture();
	if (@virtual_receiver.build("template<typename T> struct Box { fn function(i32 value) : [virtual]; };\0")) {
		return 12;
	};
	return 42;
};
