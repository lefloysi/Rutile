i32 copies;
i32 moves;

struct Value {
	i32 number;
	fn Value(var Value& this) : [default];
	fn Value(var Value& this, const Value& other) {
		@copies = copies + 1;
		@this.number = other.number;
	};
	fn Value(var Value& this, Value other) {
		@moves = moves + 1;
		@this.number = other.number;
		discard $other;
	};
};

fn main() -> i32 {
	Value original;
	@original.number = 20;
	Value copied = original;
	Value moved = $original;
	return copied.number + moved.number + copies + moves;
};
