fn primitive_target(u32 bits, u64 expected) -> bool {
	TemplateFixture fixture;
	if (!@fixture.source.assign("primitive-target.rt", "using Word=usize; using Signed=i64; enum Limits:[u64] { word=Word::max; signed_max=Signed::max; }; fn answer()->i32 { i32[u08::max] values; return 42; };")) {
		return false;
	};
	var lexer = Lexer(@fixture.source);
	if (!@lexer.scan()) {
		return false;
	};
	var parser = Parser(fixture.source.tokens());
	var syntax = @parser.parse();
	if (!syntax.get()) {
		return false;
	};
	if (!@fixture.syntax.push_back($syntax)) {
		return false;
	};
	var NativeFile* output = fopen("primitive-target-diagnostics.log\0".data(), "wb\0".data());
	var diagnostics = Diagnostics(output);
	var analyzer = Analyzer(@fixture.types, @diagnostics, $bits);
	@fixture.unit = @analyzer.analyze(fixture.syntax);
	fclose(output);
	if (!fixture.unit.get()) {
		return false;
	};
	var Entity* limits = fixture.unit.get()->root_scope()->local("Limits");
	var Entity* word = limits->find_member("word");
	var Entity* signed_max = limits->find_member("signed_max");
	var Entity* associated = fixture.unit.get()->associated_owner(*fixture.types.find_primitive("usize"));
	if (!word || word->integer() != expected || !signed_max || signed_max->integer() != 9223372036854775807 || !associated || associated->find_member("max")->kind() != entity_kind::constant) {
		return false;
	};
	return true;
};
fn primitive_scope_tests() -> i32 {
	if (!primitive_target(32, 4294967295) || !primitive_target(64, 18446744073709551615)) {
		return 1;
	};
	TemplateFixture missing;
	if (@missing.build("fn answer()->i32 { return static_cast<i32>(void::max); };")) {
		return 2;
	};
	return 42;
};
