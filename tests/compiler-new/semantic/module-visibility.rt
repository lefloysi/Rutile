using ProgressCallback = ((var void*, char*, usize, usize, char*) -> void)*;

struct CompilerProgress {
	fn CompilerProgress(var CompilerProgress& this) : [default];
	fn CompilerProgress(var CompilerProgress& this, CompilerProgress& other) : [implicit, default];
	fn report(CompilerProgress& this, rt::string_view phase, usize completed, usize total, rt::string_view detail);
	ProgressCallback callback;
	var void* context;
};

fn CompilerProgress::report(CompilerProgress& this, rt::string_view phase, usize completed, usize total, rt::string_view detail) {
};

struct ModuleFixture {
	SourceFile library;
	SourceFile consumer;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax;
	rt::unique<SemanticUnit> unit;

	fn build(var ModuleFixture& this, rt::string_view declarations, rt::string_view use, i32 access) -> bool;
};

fn ModuleFixture::build(var ModuleFixture& this, rt::string_view declarations, rt::string_view use, i32 access) -> bool {
	if (!@this.library.assign("library.rt", declarations) || !@this.consumer.assign("consumer.rt", use) || !@this.library.set_module("library", access)) {
		return false;
	};
	var library_lexer = Lexer(@this.library);
	var consumer_lexer = Lexer(@this.consumer);
	if (!@library_lexer.scan() || !@consumer_lexer.scan()) {
		return false;
	};
	var library_parser = Parser(this.library.tokens());
	var consumer_parser = Parser(this.consumer.tokens());
	var library_tree = @library_parser.parse();
	var consumer_tree = @consumer_parser.parse();
	if (!library_tree.get() || !consumer_tree.get() || !@this.syntax.push_back($library_tree) || !@this.syntax.push_back($consumer_tree)) {
		return false;
	};
	var diagnostics = Diagnostics(nullptr);
	var analyzer = Analyzer(@this.types, @diagnostics, 64);
	@this.unit = @analyzer.analyze(this.syntax);
	return this.unit.get() != nullptr;
};

fn module_visibility_tests() -> i32 {
	var public_namespace = ModuleFixture();
	if (!@public_namespace.build("namespace library { export fn answer() -> i32 { return 42; }; };", "fn main() -> i32 { return library::answer(); };", 1)) {
		return 1;
	};
	var private_function = ModuleFixture();
	if (@private_function.build("fn hidden() -> i32 { return 42; };", "fn main() -> i32 { return hidden(); };", 1)) {
		return 2;
	};
	var private_global = ModuleFixture();
	if (@private_global.build("i32 hidden = 42;", "fn main() -> i32 { return hidden; };", 1)) {
		return 3;
	};
	var private_pointer = ModuleFixture();
	if (@private_pointer.build("fn hidden() -> i32 { return 42; };", "fn main() -> i32 { var callback = &hidden; return callback(); };", 1)) {
		return 4;
	};
	var private_alias = ModuleFixture();
	if (@private_alias.build("export struct Public { i32 value; }; using Hidden = Public;", "fn main() -> i32 { Hidden value; return 42; };", 1)) {
		return 5;
	};
	var private_template = ModuleFixture();
	if (@private_template.build("template<typename T> struct Hidden { T value; };", "fn main() -> i32 { Hidden<i32> value; return 42; };", 1)) {
		return 6;
	};
	var private_function_template = ModuleFixture();
	if (@private_function_template.build("template<typename T> fn hidden(T value) -> T { return value; };", "fn main() -> i32 { return hidden(42); };", 1)) {
		return 7;
	};
	var test_access = ModuleFixture();
	if (!@test_access.build("template<typename T> struct Hidden { T value; }; fn hidden() -> i32 { return 42; };", "fn main() -> i32 { Hidden<i32> value; return hidden(); };", 2)) {
		return 8;
	};
	var namespace_export = ModuleFixture();
	if (@namespace_export.build("export namespace library { fn hidden() -> i32 { return 42; }; };", "fn main() -> i32 { return library::hidden(); };", 1)) {
		return 9;
	};
	var own_private = ModuleFixture();
	if (!@own_private.build("struct Hidden { i32 value; }; export using Public = Hidden; export fn answer() -> i32 { Hidden value; return 42; };", "fn main() -> i32 { return answer(); };", 1)) {
		return 10;
	};
	var private_explicit_template = ModuleFixture();
	if (@private_explicit_template.build("template<typename T> fn hidden(T value) -> T { return value; };", "fn main() -> i32 { return hidden<i32>(42); };", 1)) {
		return 11;
	};
	var all_test_access = ModuleFixture();
	if (!@all_test_access.build("struct Hidden { i32 value; }; using Alias = Hidden; i32 secret = 42; fn hidden() -> i32 { return secret; };", "fn main() -> i32 { Alias value; var callback = &hidden; return callback(); };", 2)) {
		return 12;
	};
	var exported_template = ModuleFixture();
	if (!@exported_template.build("template<typename T> export struct Box { T value; }; template<typename T> export fn identity(T value) -> T { return value; };", "fn main() -> i32 { Box<i32> value; return identity(42); };", 1)) {
		return 13;
	};
	var own_global = ModuleFixture();
	if (!@own_global.build("fn hidden() -> i32 { return 42; }; export i32 result = hidden();", "fn main() -> i32 { return result; };", 1)) {
		return 14;
	};
	var private_alias_qualifier = ModuleFixture();
	if (@private_alias_qualifier.build("export struct Public { struct Nested {}; }; using Hidden = Public;", "fn main() -> i32 { Hidden::Nested value; return 42; };", 1)) {
		return 15;
	};
	var public_type_qualifier = ModuleFixture();
	if (!@public_type_qualifier.build("export struct Public { struct Nested {}; };", "fn main() -> i32 { Public::Nested value; return 42; };", 1)) {
		return 16;
	};
	var public_pointer_global = ModuleFixture();
	if (!@public_pointer_global.build("export i32* value;", "fn main() -> i32 { if (value == nullptr) { return 42; }; return 0; };", 1)) {
		return 17;
	};
	var exported_forward = ModuleFixture();
	if (!@exported_forward.build("export struct Public; struct Public { i32 value; }; export fn answer() -> i32; fn answer() -> i32 { return 42; };", "fn main() -> i32 { Public value; return answer(); };", 1)) {
		return 18;
	};
	return 42;
};
