struct Member {
	fn operator:=(var Member& this, const Member& other) -> var Member& : [delete];
};

struct Holder {
	Member member;

	fn operator:=(var Holder& this, const Holder& other) -> var Holder& : [default];
};

fn main() -> i32 {
	Holder source;
	Holder target;

	@target := source;

	return 42;
};
