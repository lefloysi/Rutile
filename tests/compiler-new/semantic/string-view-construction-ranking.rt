fn make(const char* text) -> rt::string_view {
	return rt::from_c_string(text);
};

fn main() -> i32 {
	const char* source = "hello\0".data();
	var direct = rt::from_c_string(source);
	var returned = make(source);
	var copied = rt::string_view(direct);

	if (direct.size() != 5 || returned.size() != 5 || copied.size() != 5) {
		return 1;
	};

	if (source != direct.data() || source != returned.data() || source != copied.data()) {
		return 2;
	};

	return 42;
};
