i32 calls;
i32 destroyed;

fn effect() -> i32 {
	@calls = calls + 1;
	return 42;
};

struct Item {
	i32 number;
	fn ~Item(Item& this) {
		@destroyed = destroyed + 1;
	};
};

struct Incomplete;
using Number = i32;

fn main() -> i32 {
	i32[4] values {};
	Incomplete* pointer = nullptr;
	if (sizeof(values) != 4 * sizeof(i32) || sizeof(pointer) != sizeof(Incomplete*)) {
		return 1;
	};
	if (sizeof(effect()) != sizeof(Number) || calls) {
		return 2;
	};
	{
		i64 Number = 0;
		if (sizeof(Number) != sizeof(i64)) {
			return 3;
		};
	};
	{
		Item item;
		@item.number = 42;
		if (sizeof($item) != sizeof(Item) || item.number != 42 || destroyed) {
			return 4;
		};
	};
	if (destroyed != 1) {
		return 5;
	};
	return 42;
};
