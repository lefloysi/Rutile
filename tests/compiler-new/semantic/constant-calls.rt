fn factorial(i32 value) -> i32 {
	if (value <= 1) {
		return 1;
	};
	return value * factorial(value - 1);
};

fn increment(i32& value) {
	@value = value + 1;
};

fn compute(i32 limit) -> i32 {
	i32 sum;
	for (i32 index = 0; index < limit; @index = index + 1) {
		if (index == 1) {
			continue;
		};
		if (index == 5) {
			break;
		};
		@sum = sum + index;
	};
	while (sum < 40) {
		increment(@sum);
	};
	if (false && factorial(1000)) {
		return 0;
	};
	return sum + factorial(2);
};

enum Result : [i32] {
	answer = compute(10);
};

fn main() -> i32 {
	return static_cast<i32>(Result::answer);
};
