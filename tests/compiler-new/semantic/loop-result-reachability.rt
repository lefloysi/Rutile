fn endless() -> i32 {
	while (true) {};
};

fn false_break() -> i32 {
	while (true) {
		if (false) {
			break;
		};
	};
};

fn nested_selection() -> i32 {
	i32 value = 0;

	while (true) {
		switch (value) {
		default:
			break;
		};
	};
};

fn returning(i32 value) -> i32 {
	while (true) {
		switch (value) {
		case 0:
			return 42;
		default:
			break;
		};

		if (value) {
			return 42;
		};
	};
};

fn main() -> i32 {
	if (returning(0) != 42 || returning(1) != 42) {
		return 1;
	};

	return 42;
};
