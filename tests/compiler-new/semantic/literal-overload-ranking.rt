struct IntegerChoice {
	fn IntegerChoice(var IntegerChoice& this, u64 value);
	fn IntegerChoice(var IntegerChoice& this, const u64& value);
	i32 selected;
};

struct RealChoice {
	fn RealChoice(var RealChoice& this, f32 value);
	fn RealChoice(var RealChoice& this, const f32& value);
	i32 selected;
};

fn IntegerChoice::IntegerChoice(var IntegerChoice& this, u64 value) {
	@this.selected = 42;
};

fn IntegerChoice::IntegerChoice(var IntegerChoice& this, const u64& value) {
	@this.selected = 43;
};

fn RealChoice::RealChoice(var RealChoice& this, f32 value) {
	@this.selected = 42;
};

fn RealChoice::RealChoice(var RealChoice& this, const f32& value) {
	@this.selected = 43;
};

fn main() -> i32 {
	u64 number = 42;
	f32 decimal = 2.5;
	if (IntegerChoice(42).selected != 42 || IntegerChoice(20 + 22).selected != 42 || IntegerChoice(number).selected != 43 || IntegerChoice(u64(number)).selected != 42) {
		return 1;
	};
	if (RealChoice(2.5).selected != 42 || RealChoice(2.0 + 0.5).selected != 42 || RealChoice(decimal).selected != 43 || RealChoice(f32(decimal)).selected != 42) {
		return 2;
	};
	return 42;
};
