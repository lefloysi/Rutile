fn main() -> i32 {
	TypeStore types;
	const Type* integer = @types.primitive(type_kind::signed_integer, 32);
	if (!integer || integer != @types.primitive(type_kind::signed_integer, 32)) {
		return 1;
	};
	const Type* pointer = @types.pointer(integer);
	if (!pointer || pointer != @types.pointer(integer) || pointer->element() != integer) {
		return 2;
	};
	const Type* immutable = @types.qualified(*integer, type_qualifier::immutable);
	if (!immutable || immutable == integer || immutable->qualifier() != type_qualifier::immutable) {
		return 3;
	};
	if (@types.qualified(*integer, type_qualifier::mutable) != integer) {
		return 4;
	};
	const Type* array = @types.array(integer, 4);
	if (!array || array->count() != 4 || array != @types.array(integer, 4) || array == @types.array(integer, 5)) {
		return 5;
	};
	rt::buffer<const Type*> parameters;
	if (!@parameters.push_back(pointer)) {
		return 6;
	};
	const Type* function = @types.function(integer, $parameters, parameter_arity::fixed);
	rt::buffer<const Type*> repeated;
	if (!@repeated.push_back(pointer) || !function) {
		return 7;
	};
	const Type* same_function = @types.function(integer, $repeated, parameter_arity::fixed);
	if (function != same_function) {
		return 7;
	};
	usize count = 1;
	while (count < 1024) {
		if (!@types.array(integer, static_cast<u64>(count))) {
			return 8;
		};
		@count = count + 1;
	};
	if (integer != @types.primitive(type_kind::signed_integer, 32) || array != @types.array(integer, 4)) {
		return 9;
	};
	@types.clear();
	if (!@types.primitive(type_kind::unsigned_integer, 64)) {
		return 10;
	};
	return 42;
};
