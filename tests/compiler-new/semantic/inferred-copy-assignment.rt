i32 copies;
i32 destroyed;
i32 evaluations;

struct Member {
	i32 value;
	fn Member(var Member& this) : [default];
	fn Member(var Member& this, const Member& other) {
		@copies = copies + 1;
		@this.value = other.value;
	};
	fn ~Member(var Member& this) {
		@destroyed = destroyed + 1;
	};
};

struct Owner {
	Member member;
};

fn source(var Owner& owner) -> const Owner& {
	@evaluations = evaluations + 1;
	return owner;
};

fn main() -> i32 {
	{
		Owner first;
		@first.member.value = 42;
		Owner second;
		@second := source(@first);
		if (copies || evaluations != 1 || second.member.value != 42 || first.member.value != 42) {
			return 1;
		};
	};
	if (destroyed != 2) {
		return 2;
	};
	return 42;
};
