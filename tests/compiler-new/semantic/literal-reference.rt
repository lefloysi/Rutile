fn narrow(const i08& value) -> i32 {
	if (value == 42) {
		return 42;
	};

	if (value == -5) {
		return -5;
	};

	return 0;
};

fn real(const f32& value) -> i32 {
	if (value == 42) {
		return 42;
	};

	if (value == -5) {
		return -5;
	};

	return 0;
};

fn auto_narrow(auto i08& value) -> i32 {
	if (value == 42) {
		return 42;
	};

	if (value == -5) {
		return -5;
	};

	return 0;
};

fn auto_real(auto f32& value) -> i32 {
	if (value == 42) {
		return 42;
	};

	if (value == -5) {
		return -5;
	};

	return 0;
};

fn main() -> i32 {
	if (narrow(42) != 42 || narrow(-(2 + 3)) != -5 || real(42) != 42 || real(40.0 + 2.0) != 42) {
		return 1;
	};

	if (auto_narrow(42) != 42 || auto_real(42) != 42) {
		return 2;
	};

	return 42;
};
