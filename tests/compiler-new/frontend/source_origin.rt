fn main() -> i32 {
	var source = SourceFile();
	if (!@source.assign("<generated-test-runner>", "")) {
		return 1;
	};
	if (source.compiler_generated()) {
		return 2;
	};
	@source.mark_compiler_generated();
	@source.clear_tokens();
	if (!source.compiler_generated()) {
		return 3;
	};
	if (!@source.assign("<generated-test-runner>", "") || source.compiler_generated()) {
		return 4;
	};
	return 42;
};
