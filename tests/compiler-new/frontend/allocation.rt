fn allocation_parses(rt::string_view text, bool expected) -> bool {
	SourceFile source;
	if (!@source.assign("allocation.rt", text)) {
		return false;
	};
	var lexer = Lexer(@source);
	if (!@lexer.scan()) {
		return false;
	};
	var parser = Parser(source.tokens());
	var tree = @parser.parse();
	if (expected) {
		return tree.get() != nullptr;
	};
	return !tree.get() && parser.error() == "array allocation requires a construction argument list; use 'new T[count]()' for default construction";
};

fn main() -> i32 {
	if (!allocation_parses("fn f() { new char[42](); };", true)) {
		return 1;
	};
	if (!allocation_parses("fn f() { new char[42]; };", false)) {
		return 2;
	};
	if (!allocation_parses("fn f() { new i32[4][8](0); };", true)) {
		return 3;
	};
	return 42;
};
