fn editor_recovery_case(const char* text, syntax_kind expected, usize statements) -> bool {
	SourceFile source;
	if (!@source.assign(rt::string_view("recovery.rt\0"), rt::string_view(text))) {
		return false;
	};
	var lexer = Lexer(@source);
	if (!@lexer.scan()) {
		return false;
	};
	var strict = Parser(source.tokens());
	var invalid = @strict.parse();
	if (invalid.get()) {
		return false;
	};
	var parser = Parser(source.tokens());
	var tree = @parser.parse_editor();
	if (!tree.get() || !parser.issues().size() || tree.get()->size() != 2 || tree.get()->item(1)->kind() != syntax_kind::function) {
		return false;
	};
	var Syntax* body = tree.get()->item(0)->function_body();
	return body->kind() == syntax_kind::brace && body->size() == statements && body->item(0)->kind() == expected;
};

fn editor_recovery_tests() -> i32 {
	if (!editor_recovery_case("fn edit(){ object.; i32 retained; }; fn after(){};\0", syntax_kind::member, 2)) {
		return 1;
	};
	if (!editor_recovery_case("fn edit(){ Space::; i32 retained; }; fn after(){};\0", syntax_kind::qualified_name, 2)) {
		return 2;
	};
	if (!editor_recovery_case("fn edit(){ call(1, ); i32 retained; }; fn after(){};\0", syntax_kind::call, 2)) {
		return 3;
	};
	if (!editor_recovery_case("fn edit(){ call(1, ; i32 retained; }; fn after(){};\0", syntax_kind::call, 2)) {
		return 4;
	};
	if (!editor_recovery_case("fn edit(){ return 1 + ; i32 retained; }; fn after(){};\0", syntax_kind::return_value, 2)) {
		return 5;
	};
	if (!editor_recovery_case("fn edit(){ using = ; i32 retained; }; fn after(){};\0", syntax_kind::error_expression, 2)) {
		return 6;
	};
	SourceFile source;
	@source.assign(rt::string_view("valid.rt\0"), rt::string_view("fn valid(){};\0"));
	var lexer = Lexer(@source);
	@lexer.scan();
	var parser = Parser(source.tokens());
	var valid = @parser.parse_editor();
	if (!valid.get() || parser.issues().size()) {
		return 7;
	};
	SourceFile malformed;
	@malformed.assign(rt::string_view("record.rt\0"), rt::string_view("struct Base { i32 inherited; }; struct Item : Base { i32 own; private: i32 hidden; }; fn outside(Item& item) { item.; };\0"));
	var malformed_lexer = Lexer(@malformed);
	if (!@malformed_lexer.scan()) {
		return 8;
	};
	var malformed_parser = Parser(malformed.tokens());
	var recovered = @malformed_parser.parse_editor();
	if (!recovered.get() || !malformed_parser.issues().size()) {
		return 9;
	};
	if (!editor_recovery_case("fn edit(){ ) ; i32 retained; }; fn after(){};\0", syntax_kind::error_expression, 2)) {
		return 10;
	};
	return 42;
};
