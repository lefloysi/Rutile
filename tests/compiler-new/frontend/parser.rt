fn puts(const char* message) -> i32;

struct ParseFixture {
	SourceFile source;
	rt::unique<Syntax> tree;

	fn build(ParseFixture& this, const char* text) -> bool;
};

fn ParseFixture::build(ParseFixture& this, const char* text) -> bool {
	if (!@this.source.assign(rt::string_view("parser.rt\0"), rt::string_view(text))) {
		return false;
	};
	var lexer = Lexer(@this.source);
	if (!@lexer.scan()) {
		puts(lexer.error().data());
		return false;
	};
	var parser = Parser(this.source.tokens());
	@this.tree = @parser.parse();
	if (!this.tree.get()) {
		puts(parser.error().data());
		return false;
	};
	return true;
};

fn parser_tests() -> i32 {
	var expression = ParseFixture();
	if (!@expression.build("fn main() -> i32 { return 1 + 2 * 3; };\0")) {
		return 1;
	};
	Syntax* function = expression.tree.get()->item(0);
	if (function->kind() != syntax_kind::function || function->function_body()->kind() != syntax_kind::brace) {
		return 2;
	};
	Syntax* sum = function->function_body()->item(0)->operand();
	if (sum->kind() != syntax_kind::binary || sum->token().kind != token_kind::op_plus || sum->right()->token().kind != token_kind::op_star) {
		return 3;
	};

	var empty = ParseFixture();
	if (!@empty.build("fn declared(); fn defined() {}; ;;\0")) {
		return 4;
	};
	if (empty.tree.get()->size() != 4 || empty.tree.get()->item(0)->function_body()->kind() != syntax_kind::noop || empty.tree.get()->item(1)->function_body()->kind() != syntax_kind::brace || empty.tree.get()->item(2)->kind() != syntax_kind::noop || empty.tree.get()->item(3)->kind() != syntax_kind::noop) {
		return 5;
	};

	var variables = ParseFixture();
	if (!@variables.build("var inferred = 42; var explicit : i32; i32 typed = 1; a * b;\0")) {
		return 6;
	};
	if (variables.tree.get()->size() != 4 || variables.tree.get()->item(0)->variable_type()->kind() != syntax_kind::absent || variables.tree.get()->item(1)->variable_initializer()->kind() != syntax_kind::absent || variables.tree.get()->item(3)->kind() != syntax_kind::ambiguity || variables.tree.get()->item(3)->size() != 2) {
		return 7;
	};

	var control = ParseFixture();
	if (!@control.build("fn choose(i32 value) -> i32 { if (value) return 42; else return 0; };\0")) {
		return 8;
	};
	Syntax* condition = control.tree.get()->item(0)->function_body()->item(0);
	if (condition->kind() != syntax_kind::conditional || condition->body()->kind() != syntax_kind::return_value || condition->alternative()->kind() != syntax_kind::return_value) {
		return 9;
	};

	var types = ParseFixture();
	if (!@types.build("var pointer : const Thing*; var array : i32[4]; var casted = static_cast<i32>(42);\0")) {
		return 10;
	};
	if (types.tree.get()->item(0)->variable_type()->kind() != syntax_kind::type_pointer || types.tree.get()->item(0)->variable_type()->designated_type()->kind() != syntax_kind::type_const || types.tree.get()->item(1)->variable_type()->array_extent()->kind() != syntax_kind::number || types.tree.get()->item(2)->variable_initializer()->operand()->kind() != syntax_kind::cast) {
		return 11;
	};
	var declarations = ParseFixture();
	if (!@declarations.build("template<typename T, typename D = Owner<T>> struct Box { private: T* data; fn Box(Box& this); fn operator=(Box& this, Box other) -> Box& : [default]; }; var callback : ((i32 value) -> i32)*; struct { i32 field; }* object;\0")) {
		return 12;
	};
	if (declarations.tree.get()->size() != 3 || declarations.tree.get()->item(0)->kind() != syntax_kind::template_declaration || declarations.tree.get()->item(1)->variable_type()->designated_type()->kind() != syntax_kind::type_function) {
		return 13;
	};

	var branches = ParseFixture();
	if (!@branches.build("enum Mode : [i32] { first; fn test(const Mode& this) -> i32 { return 42; }; }; fn f(i32 value) { switch (value) { case 1: delete[] values; break; default: return; }; };\0")) {
		return 14;
	};
	if (branches.tree.get()->item(0)->enum_members()->size() != 2 || branches.tree.get()->item(1)->function_body()->item(0)->kind() != syntax_kind::switch_expression) {
		return 15;
	};
	var mixed = ParseFixture();
	if (!@mixed.build("var value = f<T>() + a < b > c; a < b > c;\0")) {
		return 16;
	};
	if (mixed.tree.get()->size() != 2 || mixed.tree.get()->item(0)->kind() != syntax_kind::variable || mixed.tree.get()->item(0)->variable_initializer()->operand()->token().kind != token_kind::op_greater || mixed.tree.get()->item(1)->kind() != syntax_kind::ambiguity || mixed.tree.get()->item(1)->size() != 2) {
		return 17;
	};
	var groups = ParseFixture();
	if (!@groups.build("(callable)(42); (i32)(42); template<i32 N = 4> struct Fixed {}; discard $owned;\0")) {
		return 18;
	};
	if (groups.tree.get()->item(0)->callable()->kind() != syntax_kind::grouping || groups.tree.get()->item(1)->callable()->kind() != syntax_kind::grouping || groups.tree.get()->item(2)->template_parameters()->item(0)->template_parameter_default()->kind() != syntax_kind::number || groups.tree.get()->item(3)->kind() != syntax_kind::discard_value) {
		return 19;
	};
	return 42;
};
