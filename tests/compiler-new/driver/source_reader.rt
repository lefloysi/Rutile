fn tmpfile() -> var NativeFile*;
fn rewind(var NativeFile* file);

fn open_test_source(const char* path, const char* mode) -> var NativeFile* {
	if (rt::from_c_string(path) == "missing.rt") {
		return nullptr;
	};
	var NativeFile* file = tmpfile();
	if (!file) {
		return nullptr;
	};
	fwrite("fn answer() -> i32 { return 42; };\n\0".data(), 1, 34, file);
	rewind(file);
	return $file;
};

fn main() -> i32 {
	SourceManager sources;
	var diagnostics = Diagnostics(nullptr);
	var reader = SourceReader(&open_test_source, @sources, @diagnostics);
	var SourceFile* source = @reader.load("answer.rt");
	if (!source || diagnostics.failed() || source->path() != "answer.rt") {
		return 1;
	};
	if (source->text().size() != 34) {
		return 2;
	};
	var lexer = Lexer(@*source);
	if (!@lexer.scan()) {
		return 3;
	};
	if (@reader.load("missing.rt") || !diagnostics.failed() || sources.count() != 1) {
		return 4;
	};
	return 42;
};
