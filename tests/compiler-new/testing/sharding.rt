[[harness]]
fn test_harness() {
	puts("harness startup\0".data());
	rt::test::run();
	puts("harness shutdown\0".data());
};

[[test]]
fn first_sharded_test() {
	rt::test::expect(true);
	rt::test::register("nested child", &child_test);
};

[[test]]
fn second_sharded_test() {
	rt::test::expect(true);
};

fn child_test() {
	rt::test::expect(true);
};
