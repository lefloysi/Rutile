fn text_size(const rt::string_view& text) -> usize {
	return text.size();
};

fn main() -> i32 {
	rt::string text;
	if (!text.empty() || text.c_str()[0]) {
		return 1;
	};
	if (!@text.append(rt::string_view("hello\0"))) {
		return 2;
	};
	if (text.size() != 5 || text.c_str()[5] || text.view() != rt::string_view("hello\0")) {
		return 3;
	};
	if (text_size(text) != 5) {
		return 10;
	};
	var suffix = text.view().slice(1, 4);
	if (!@text.append(suffix) || text.view() != rt::string_view("helloello\0")) {
		return 4;
	};
	if (!@text.append(text.view()) || text.view() != rt::string_view("helloellohelloello\0")) {
		return 5;
	};
	var copied = rt::string(text);
	@text.clear();
	if (!text.empty() || copied.size() != 18 || copied.c_str()[18]) {
		return 6;
	};
	var moved = $copied;
	var char* writable = (@moved).data();
	@writable[0] = 'H';
	const char* readable = moved.data();
	if (readable[0] != 'H' || moved.size() != 18) {
		return 7;
	};
	@text = moved;
	@text = text;
	if (text.view() != moved.view()) {
		return 8;
	};
	if (!(rt::string_view("a\0") < rt::string_view("b\0")) || rt::string_view("a\0").compare(rt::string_view("aa\0")) >= 0) {
		return 9;
	};
	return 42;
};
