i32 disposals = 0;

struct CountingDelete {
	fn dispose(i32* pointer) {
		@disposals = disposals + 1;
		delete pointer;
	};
};

fn main() -> i32 {
	{
		var custom = rt::unique<i32, CountingDelete>(new i32(42));
		var standard = rt::unique<i32>(new i32(9));
		if (*custom.get() != 42 || *standard.get() != 9) {
			return 1;
		};
	};
	if (disposals != 1) {
		return 2;
	};
	return 42;
};
