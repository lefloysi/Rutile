fn main() -> i32 {
	rt::buffer<i32> values;
	if (values.size() || values.capacity() || values.data()) {
		return 1;
	};
	i32 index = 0;
	while (index < 100) {
		if (!@values.push_back(i32(index))) {
			return 2;
		};
		@index = index + 1;
	};
	if (values.size() != 100 || values.capacity() < values.size()) {
		return 3;
	};
	@index = 0;
	while (index < 100) {
		if (values.data()[index] != index) {
			return 4;
		};
		@index = index + 1;
	};
	i32* writable = (@values).data();
	@writable[0] = 42;
	const i32* readable = values.data();
	if (readable[0] != 42) {
		return 5;
	};
	usize capacity = values.capacity();
	@values.clear();
	if (values.size() || values.capacity() != capacity) {
		return 6;
	};
	if (!@values.push_back(42) || values.data()[0] != 42) {
		return 7;
	};
	return 42;
};
