i32 constructions = 0;
i32 destructions = 0;

struct Payload {
	fn Payload(Payload& this, i32 number) {
		@this.number := number;
		@constructions = constructions + 1;
	};
	fn Payload(Payload& this, const Payload& other) : [delete];
	fn Payload(Payload& this, Payload other) : [default];
	fn ~Payload(Payload& this) {
		@destructions = destructions + 1;
	};
	i32 number;
};

fn main() -> i32 {
	{
		var empty = rt::optional<Payload>();
		if (constructions || destructions || empty.has_value()) {
			return 1;
		};
		@empty.emplace(Payload(42));
		if (constructions != 1 || destructions || empty.value().number != 42) {
			return 2;
		};
		var moved = rt::optional<Payload>($empty);
		if (destructions || moved.value().number != 42) {
			return 3;
		};
		@moved.reset();
		@moved.reset();
		if (destructions != 1 || moved.has_value()) {
			return 4;
		};
		@moved.emplace(Payload(9));
	};
	if (constructions != 2 || destructions != 2) {
		return 5;
	};
	return 42;
};
