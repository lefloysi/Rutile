struct Payload {
	fn Payload(var Payload& this) : [default];
	fn Payload(var Payload& this, const Payload& other) : [delete];
	fn Payload(var Payload& this, Payload other) : [default];
	i32 number;
};

fn main() -> i32 {
	var first = rt::optional<Payload>(Payload());
	var copied = rt::optional<Payload>(first);
	return 42;
};
