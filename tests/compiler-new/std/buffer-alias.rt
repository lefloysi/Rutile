struct Copyable {
	fn Copyable(var Copyable& this, i32 value);
	fn Copyable(var Copyable& this, const Copyable& other) : [default];
	fn Copyable(var Copyable& this, Copyable other) : [default];
	i32 value;
};

fn Copyable::Copyable(var Copyable& this, i32 value) {
	@this.value = $value;
};

fn main() -> i32 {
	rt::buffer<Copyable> values;
	if (!@values.reserve(1) || !@values.push_back(Copyable(42))) {
		return 1;
	};
	if (!@values.push_back(Copyable(values.data()[0]))) {
		return 2;
	};
	if (values.size() != 2 || values.data()[0].value != 42 || values.data()[1].value != 42) {
		return 3;
	};
	return 42;
};
