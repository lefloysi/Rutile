struct Counts {
	i32 live;
	i32 constructed;
	i32 moved;
	i32 destroyed;
	i32 order;
};

struct Tracker {
	fn Tracker(var Tracker& this, var Counts* counts, i32 value);
	fn Tracker(var Tracker& this, const Tracker& other) : [delete];
	fn Tracker(var Tracker& this, Tracker other);
	fn ~Tracker(var Tracker& this);
	var Counts* counts;
	i32 value;
};

fn Tracker::Tracker(var Tracker& this, var Counts* counts, i32 value) {
	@this.counts = $counts;
	@this.value = $value;
	@this.counts->live = this.counts->live + 1;
	@this.counts->constructed = this.counts->constructed + 1;
};

fn Tracker::Tracker(var Tracker& this, Tracker other) {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->moved = this.counts->moved + 1;
	discard $other;
};

fn Tracker::~Tracker(var Tracker& this) {
	@this.counts->live = this.counts->live - 1;
	@this.counts->destroyed = this.counts->destroyed + 1;
	@this.counts->order = this.counts->order * 10 + this.value;
};

fn main() -> i32 {
	Counts counts;
	{
		rt::buffer<Tracker> values;
		if (!@values.reserve(16) || counts.constructed || counts.destroyed) {
			return 1;
		};
		if (!@values.push_back(Tracker(&@counts, 1)) || !@values.push_back(Tracker(&@counts, 2))) {
			return 2;
		};
		if (counts.live != 2 || counts.constructed != 2 || counts.destroyed) {
			return 3;
		};
		i32 moved := counts.moved;
		if (!@values.reserve(32) || counts.moved != moved + 2 || counts.destroyed) {
			return 4;
		};
		const Tracker* previous = values.data();
		if (@values.reserve(~usize(0)) || values.data() != previous || values.size() != 2) {
			return 5;
		};
		var transferred = $values;
		rt::buffer<Tracker> destination;
		if (!@destination.push_back(Tracker(&@counts, 3))) {
			return 6;
		};
		@destination = $transferred;
		if (counts.live != 2 || counts.destroyed != 1 || counts.order != 3) {
			return 7;
		};
		@destination.clear();
		if (counts.live || counts.destroyed != 3 || counts.order != 312) {
			return 8;
		};
		if (!@destination.push_back(Tracker(&@counts, 4))) {
			return 9;
		};
	};
	if (counts.live || counts.destroyed != 4 || counts.order != 3124) {
		return 10;
	};
	return 42;
};
