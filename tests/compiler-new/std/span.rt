fn main() -> i32 {
	var i32[2] values {};
	@values[0] = 20;
	@values[1] = 22;
	var view = rt::span<i32>(&values[0], 2);
	var copy = rt::span<i32>(view);
	if (view.empty() || copy.size() != 2 || copy.data() != view.data()) {
		return 1;
	};
	var empty = rt::span<i32>(nullptr, 0);
	if (!empty.empty() || empty.size() || empty.data()) {
		return 2;
	};
	return view.data()[0] + copy.data()[1];
};
