i32 destroyed = 0;
struct Key {
	fn Key(var Key& this, i32 number) {
		@this.number = $number;
	};
	fn Key(var Key& this, const Key& other) : [delete];
	fn Key(var Key& this, Key other) : [default];
	i32 number;
};
struct Value {
	fn Value(var Value& this, i32 number) {
		@this.number = $number;
	};
	fn Value(var Value& this, const Value& other) : [delete];
	fn Value(var Value& this, Value other) : [default];
	fn ~Value(var Value& this) {
		@destroyed = destroyed + 1;
	};
	i32 number;
};
struct CollisionHash {
	fn CollisionHash(var CollisionHash& this, usize seed) {
		@this.seed = $seed;
	};
	fn hash(const CollisionHash& this, const Key& key) -> usize {
		return this.seed;
	};
	usize seed;
};
struct ModuloEqual {
	fn ModuloEqual(var ModuloEqual& this, i32 modulus) {
		@this.modulus = $modulus;
	};
	fn equal(const ModuloEqual& this, const Key& first, const Key& second) -> bool {
		return first.number % this.modulus == second.number % this.modulus;
	};
	i32 modulus;
};
fn main() -> i32 {
	{
		var values = rt::unordered_map<Key, Value, CollisionHash, ModuloEqual>(CollisionHash(7), ModuloEqual(4096));
		i32 index = 0;
		while (index < 1024) {
			if (!@values.insert(Key(index), Value(index))) {
				return 1;
			};
			@index = index + 1;
		};
		if (@values.insert(Key(4096), Value(99)) || destroyed != 1) {
			return 2;
		};
		var key = Key(500);
		var Value* stable = (@values).find(key);
		if (!stable || stable->number != 500 || !@values.reserve(8192) || (@values).find(key) != stable) {
			return 3;
		};
		if (@values.reserve(~usize(0)) || values.size() != 1024) {
			return 4;
		};
		var head = Key(1023);
		var tail = Key(0);
		if (!@values.erase(head) || !@values.erase(key) || !@values.erase(tail) || @values.erase(key)) {
			return 5;
		};
		var moved = rt::unordered_map<Key, Value, CollisionHash, ModuloEqual>($values);
		var remaining = Key(42);
		if (!moved.find(remaining) || moved.find(remaining)->number != 42 || moved.size() != 1021) {
			return 6;
		};
		var destination = rt::unordered_map<Key, Value, CollisionHash, ModuloEqual>(CollisionHash(9), ModuloEqual(4096));
		if (!@destination.insert(Key(3000), Value(1))) {
			return 9;
		};
		@destination = $moved;
		if (!destination.find(remaining) || destination.find(remaining)->number != 42) {
			return 10;
		};
		@destination.clear();
		if (!destination.empty() || destination.find(remaining) || destroyed != 1026) {
			return 7;
		};
	};
	if (destroyed != 1026) {
		return 8;
	};
	return 42;
};
