using Callback = (() -> i32)*;

struct CallbackHash {
	fn hash(CallbackHash& this, Callback value) -> usize;
};

fn CallbackHash::hash(CallbackHash& this, Callback value) -> usize {
	return rt::mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));
};

fn answer() -> i32 {
	return 42;
};

fn main() -> i32 {
	rt::unordered_map<Callback, i32, CallbackHash> values;
	Callback key = &answer;

	if (!@values.insert(key, 42) || *values.find(key) != 42) {
		return 1;
	};

	return 42;
};
