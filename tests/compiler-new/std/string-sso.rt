fn inline_text(rt::string& text) -> bool {
	usize storage = reinterpret_cast<usize>(text.data());
	usize begin = reinterpret_cast<usize>(&text);

	return storage >= begin && storage - begin < sizeof(rt::string);
};

fn text_equals(rt::string& text, rt::string_view expected) -> bool {
	return text.view() == expected && text.size() == expected.size() && !text.c_str()[text.size()];
};

fn main() -> i32 {
	rt::string short_text;
	if (!short_text.empty() || short_text.c_str()[0] || !inline_text(short_text) || short_text.capacity() != 15) {
		return 1;
	};

	if (!@short_text.append(rt::string_view("123456789abcdef\0")) || short_text.size() != 15 || !inline_text(short_text) || short_text.c_str()[15]) {
		return 2;
	};

	rt::string short_copy = rt::string(short_text);
	@(@short_copy).data()[0] = 'X';
	if (short_text.data()[0] != '1' || !inline_text(short_copy)) {
		return 3;
	};

	if (!@short_text.append(short_text.view()) || !text_equals(short_text, rt::string_view("123456789abcdef123456789abcdef\0")) || inline_text(short_text)) {
		return 4;
	};

	rt::string boundary = rt::string("123456789abcdef\0");
	if (!@boundary.append(rt::string_view("g\0")) || !text_equals(boundary, rt::string_view("123456789abcdefg\0")) || inline_text(boundary) || boundary.capacity() != 22) {
		return 5;
	};

	char[4] embedded {};
	@embedded[0] = 'a';
	@embedded[1] = '\0';
	@embedded[2] = 'b';
	@embedded[3] = 'c';
	rt::string binary = rt::string(rt::string_view(&embedded[0], 4));
	if (binary.size() != 4 || binary.data()[0] != 'a' || binary.data()[1] || binary.data()[2] != 'b' || binary.data()[3] != 'c' || binary.c_str()[4]) {
		return 6;
	};

	rt::string grown = rt::string("abcdefghijklmnop\0");
	usize repetitions = 0;
	while (repetitions < 7) {
		if (!@grown.append(grown.view())) {
			return 7;
		};
		@repetitions = repetitions + 1;
	};
	if (grown.size() != 2048 || grown.c_str()[2048]) {
		return 8;
	};
	usize index = 0;
	while (index < grown.size()) {
		if (grown.data()[index] != "abcdefghijklmnop\0"[index % 16]) {
			return 9;
		};
		@index = index + 1;
	};

	rt::string independent = rt::string(grown);
	@(@grown).data()[0] = 'Z';
	if (independent.data()[0] != 'a' || independent.data() == grown.data()) {
		return 10;
	};
	@independent := grown;
	@(@grown).data()[1] = 'Y';
	if (independent.data()[0] != 'Z' || independent.data()[1] != 'b') {
		return 11;
	};

	rt::string short_moved = $short_copy;
	if (!inline_text(short_moved) || short_moved.size() != 15 || short_moved.data()[0] != 'X' || short_moved.c_str()[15]) {
		return 12;
	};
	rt::string long_moved = $independent;
	if (inline_text(long_moved) || long_moved.size() != 2048 || long_moved.data()[0] != 'Z' || long_moved.c_str()[2048]) {
		return 13;
	};

	@short_moved = $long_moved;
	if (inline_text(short_moved) || short_moved.size() != 2048 || short_moved.data()[0] != 'Z') {
		return 14;
	};
	rt::string tiny = rt::string("tiny\0");
	@short_moved = $tiny;
	if (!inline_text(short_moved) || !text_equals(short_moved, rt::string_view("tiny\0"))) {
		return 15;
	};

	rt::buffer<rt::string> strings;
	if (!@strings.reserve(1) || !@strings.push_back($short_moved) || !@strings.push_back($grown) || !@strings.reserve(64)) {
		return 16;
	};
	if (!inline_text(strings.data()[0]) || !text_equals(strings.data()[0], rt::string_view("tiny\0")) || strings.data()[1].size() != 2048 || strings.data()[1].data()[0] != 'Z' || strings.data()[1].data()[1] != 'Y' || strings.data()[1].c_str()[2048]) {
		return 17;
	};

	usize retained_capacity = boundary.capacity();
	@boundary.clear();
	if (!boundary.empty() || boundary.c_str()[0] || boundary.capacity() != retained_capacity || !@boundary.append(rt::string_view("reuse\0")) || !text_equals(boundary, rt::string_view("reuse\0"))) {
		return 18;
	};
	if (@boundary.append(rt::string_view("x\0", usize::max)) || !text_equals(boundary, rt::string_view("reuse\0"))) {
		return 19;
	};

	rt::string reserved = rt::string("reserve\0");
	if (!@reserved.reserve(15) || !inline_text(reserved) || !@reserved.reserve(128) || inline_text(reserved) || reserved.capacity() < 128 || !text_equals(reserved, rt::string_view("reserve\0"))) {
		return 20;
	};
	usize capacity = reserved.capacity();
	char* address = reserved.data();
	if (@reserved.reserve(usize::max) || reserved.capacity() != capacity || reserved.data() != address || !text_equals(reserved, rt::string_view("reserve\0"))) {
		return 21;
	};

	rt::string colon_copy;
	@colon_copy := strings.data()[1];
	@colon_copy := colon_copy;
	@(@(@strings).data()[1]).data()[2] = 'Q';
	if (colon_copy.size() != 2048 || colon_copy.data()[0] != 'Z' || colon_copy.data()[1] != 'Y' || colon_copy.data()[2] != 'c' || colon_copy.c_str()[2048]) {
		return 22;
	};

	rt::string terminator = rt::string("123456789abcdef\0");
	rt::string_view own_zero = rt::string_view(terminator.data() + terminator.size(), 1);
	if (!@terminator.append(own_zero) || terminator.size() != 16 || inline_text(terminator) || terminator.data()[14] != 'f' || terminator.data()[15] || terminator.c_str()[16]) {
		return 23;
	};

	rt::string growth;
	if (growth.capacity() != 15 || !@growth.reserve(16) || growth.capacity() != 22) {
		return 24;
	};
	char* first_heap = growth.data();
	if (!@growth.reserve(22) || growth.data() != first_heap || growth.capacity() != 22 || !@growth.reserve(23) || growth.capacity() != 33 || growth.c_str()[0]) {
		return 25;
	};

	return 42;
};
