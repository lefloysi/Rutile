fn invalid(rt::string_view input) -> bool {
	var document = rt::json_parse(input);
	return !document.value() && document.error().size() != 0;
};

fn main() -> i32 {
	var escaped = rt::json_parse("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0041\"\0");
	if (!escaped.value() || escaped.value()->text().size() != 9) {
		return 1;
	};
	var characters = escaped.value()->text();
	if (characters.data()[0] != '"' || characters.data()[1] != '\\' || characters.data()[2] != '/' || static_cast<u08>(characters.data()[3]) != 8 || static_cast<u08>(characters.data()[4]) != 12 || characters.data()[8] != 'A') {
		return 2;
	};
	char[4] bad;
	@bad[0] = '"';
	@bad[1] = static_cast<char>(192);
	@bad[2] = static_cast<char>(175);
	@bad[3] = '"';
	if (!invalid(rt::string_view(&bad[0], 4)) || rt::json_value::make_string(rt::string_view(&bad[1], 2)).get()) {
		return 3;
	};
	@bad[1] = '\0';
	@bad[2] = 'a';
	if (!invalid(rt::string_view(&bad[0], 4))) {
		return 4;
	};
	rt::string deep;
	usize index = 0;
	while (index < 130) {
		@deep.append("[\0");
		@index = index + 1;
	};
	@deep.append("0\0");
	@index = 0;
	while (index < 130) {
		@deep.append("]\0");
		@index = index + 1;
	};
	if (!invalid(deep.view())) {
		return 5;
	};
	var duplicate = rt::json_parse("{\"a\":1,\"a\":42}\0");
	i64 integer = 0;
	if (!duplicate.value() || duplicate.value()->size() != 1 || !duplicate.value()->member("a\0")->integer(@integer) || integer != 42) {
		return 6;
	};
	var copy = duplicate.value()->clone();
	var root = @duplicate.release();
	@root.reset(nullptr);
	if (!copy.get() || !copy.get()->member("a\0")->integer(@integer) || integer != 42) {
		return 7;
	};
	var minimum = rt::json_value::make_integer(-9223372036854775808);
	var maximum = rt::json_value::make_unsigned(18446744073709551615);
	if (!minimum.get() || minimum.get()->text() != rt::string_view("-9223372036854775808\0") || !maximum.get() || maximum.get()->text() != rt::string_view("18446744073709551615\0")) {
		return 8;
	};
	rt::string written;
	if (!rt::json_write(*escaped.value(), @written)) {
		return 9;
	};
	var decoded = rt::json_parse(written.view());
	if (!decoded.value() || decoded.value()->text() != characters || rt::json_value::make_number("01\0").get()) {
		return 10;
	};
	return 42;
};
