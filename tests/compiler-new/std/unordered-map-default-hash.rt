template<typename K>
fn check(K key) -> bool {
	rt::unordered_map<K, i32> values;

	rt::default_hash<K> default_policy;
	rt::integer_hash<K> integer_policy;

	if (default_policy.hash(key) != integer_policy.hash(key) || !@values.insert(K(key), 42)) {
		return false;
	};

	return values.size() == 1 && *values.find(key) == 42;
};

fn main() -> i32 {
	if (!check(bool(true)) || !check(char('a')) || !check(i08(-1)) || !check(i16(-2)) || !check(i32(-3)) || !check(i64(-4))) {
		return 1;
	};

	if (!check(u08(1)) || !check(u16(2)) || !check(u32(3)) || !check(u64(4)) || !check(usize(5)) || !check(isize(-6))) {
		return 2;
	};

	rt::unordered_map<f32, i32> single;
	rt::unordered_map<f64, i32> wide;

	if (!@single.insert(f32(0.0), 20) || @single.insert(f32(-0.0), 100) || !@wide.insert(f64(-0.0), 22) || @wide.insert(f64(0.0), 100)) {
		return 3;
	};

	if (*single.find(f32(-0.0)) + *wide.find(f64(0.0)) != 42) {
		return 4;
	};

	i32 key = 42;
	const i32* read_only = &key;
	rt::unordered_map<i32*, i32> pointers;
	rt::unordered_map<const i32*, i32> constants;

	if (!@pointers.insert(&key, 20) || !@constants.insert(read_only, 22) || *pointers.find(&key) + *constants.find(read_only) != 42) {
		return 5;
	};

	rt::unordered_map<rt::string_view, i32> texts;
	char[3] first;
	@first[0] = 'a';
	@first[1] = '\0';
	@first[2] = 'b';
	char[3] second;
	@second[0] = 'a';
	@second[1] = '\0';
	@second[2] = 'b';
	var first_view = rt::string_view(&first[0], 3);
	var second_view = rt::string_view(&second[0], 3);

	if (!@texts.insert(rt::string_view(first_view), 42) || @texts.insert(rt::string_view(second_view), 0) || *texts.find(second_view) != 42) {
		return 6;
	};

	return 42;
};
