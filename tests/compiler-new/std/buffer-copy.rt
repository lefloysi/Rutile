struct CopyCounts {
	i32 copies;
	i32 live;
};

struct CopyItem {
	fn CopyItem(CopyItem& this, CopyCounts* counts, i32 value);
	fn CopyItem(CopyItem& this, const CopyItem& other);
	fn ~CopyItem(CopyItem& this);

	CopyCounts* counts;
	i32 value;
};

struct BufferOwner {
	rt::buffer<CopyItem> items;
};

fn CopyItem::CopyItem(CopyItem& this, CopyCounts* counts, i32 value) {
	@this.counts = $counts;
	@this.value = $value;
	@this.counts->live = this.counts->live + 1;
};

fn CopyItem::CopyItem(CopyItem& this, const CopyItem& other) {
	@this.counts := other.counts;
	@this.value := other.value;
	@this.counts->copies = this.counts->copies + 1;
	@this.counts->live = this.counts->live + 1;
};

fn CopyItem::~CopyItem(CopyItem& this) {
	@this.counts->live = this.counts->live - 1;
};

fn main() -> i32 {
	CopyCounts counts;
	{
		rt::buffer<CopyItem> source;
		if (!@source.push_back(CopyItem(&counts, 7))) {
			return 1;
		};

		var copied = rt::buffer<CopyItem>(source);
		if (copied.size() != 1 || copied.data() == source.data() || counts.copies != 1 || counts.live != 2) {
			return 2;
		};
		@((@copied).data()[0].value) = 9;
		if (source.data()[0].value != 7 || copied.data()[0].counts != &counts) {
			return 3;
		};

		@copied = source;
		if (copied.data()[0].value != 7 || counts.copies != 2 || counts.live != 2) {
			return 4;
		};
		@copied = copied;
		if (copied.size() != 1 || copied.data()[0].value != 7 || counts.live != 2) {
			return 5;
		};
		@copied := source;
		if (copied.data() == source.data() || copied.data()[0].value != 7 || counts.live != 2) {
			return 7;
		};
	};

	if (counts.live) {
		return 6;
	};

	i32 before = counts.copies;
	{
		BufferOwner source;
		if (!@source.items.push_back(CopyItem(&counts, 42))) {
			return 8;
		};
		var copied = BufferOwner(source);
		if (copied.items.data() == source.items.data() || counts.copies != before + 1 || counts.live != 2) {
			return 9;
		};
		@copied = source;
		if (copied.items.data() == source.items.data() || copied.items.data()[0].value != 42 || counts.copies != before + 2 || counts.live != 2) {
			return 10;
		};
	};
	if (counts.live) {
		return 11;
	};
	return 42;
};
