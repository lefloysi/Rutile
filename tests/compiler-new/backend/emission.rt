fn backend_literal(const Type* type, const Token& token, u64 value) -> rt::unique<SemanticExpression> {
	var result = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::literal_integer, type, token));
	if (result.get()) {
		@result.get()->set_integer(value);
	};
	return $result;
};

fn rutile_backend_fixture(NativeFile* output, i32 optimization) -> i32 {
	var diagnostics = Diagnostics(nullptr);
	var backend = Backend(@diagnostics);
	if (!@backend.initialize($optimization)) {
		return 1;
	};
	TypeStore types;
	const Type* integer = @types.primitive(type_kind::signed_integer, 32);
	const Type* empty = @types.primitive(type_kind::void_type, 0);
	if (!integer || !empty) {
		return 2;
	};
	SemanticUnit unit;
	Scope* scope = @unit.create_scope(nullptr, nullptr);
	SourceManager sources;
	SourceFile* source = @sources.add(rt::string_view("backend.rt\0"), rt::string_view("g main\0"));
	if (!scope || !source) {
		return 3;
	};
	Token name;
	@name.source = source;
	@name.length = 1;
	@name.line = 1;
	@name.column = 1;
	@name.kind = token_kind::identifier;
	Token union_token = Token(name);
	@union_token.kind = token_kind::kw_union;
	var union_syntax = Syntax(syntax_kind::record, union_token);
	Entity* overlapping = @unit.create_entity(entity_kind::record, name, &union_syntax, scope);
	Entity* bytes = @unit.create_entity(entity_kind::field, name, nullptr, scope);
	Entity* aligned = @unit.create_entity(entity_kind::field, name, nullptr, scope);
	if (!overlapping || !bytes || !aligned) {
		return 4;
	};
	@bytes->set_type(@types.array(@types.primitive(type_kind::character, 8), 17));
	@aligned->set_type(@types.primitive(type_kind::unsigned_integer, 64));
	if (!@overlapping->add_field(bytes) || !@overlapping->add_field(aligned)) {
		return 4;
	};
	const Type* union_type = @types.named(type_kind::named, overlapping);
	@overlapping->set_type(union_type);
	LLVMOpaqueType* union_layout = @backend.type(union_type);
	if (!union_layout || LLVMABISizeOfType(backend.layout(), union_layout) != 24 || LLVMABIAlignmentOfType(backend.layout(), union_layout) != 8) {
		return 4;
	};
	Entity* global = @unit.create_entity(entity_kind::global, name, nullptr, scope);
	if (!global) {
		return 4;
	};
	@global->set_type(integer);
	@global->set_body(backend_literal(integer, name, 20));
	@name.begin = 2;
	@name.length = 4;
	@name.column = 3;
	Entity* function = @unit.create_entity(entity_kind::function, name, nullptr, scope);
	rt::buffer<const Type*> parameters;
	const Type* signature = @types.function(integer, $parameters, parameter_arity::fixed);
	if (!function || !signature) {
		return 5;
	};
	@function->set_type(signature);
	Token unused_name = Token(name);
	@unused_name.begin = 0;
	@unused_name.length = 1;
	Entity* unused = @unit.create_entity(entity_kind::function, unused_name, nullptr, scope);
	Entity* unused_default = @unit.create_entity(entity_kind::function, unused_name, nullptr, scope);
	if (!unused || !unused_default) {
		return 5;
	};
	@unused->set_instantiated();
	@unused_default->set_instantiated();
	@unused_default->set_type(signature);
	@unused_default->set_definition(function_definition::defaulted);
	var body = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::brace, empty, name));
	var returned = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::return_value, empty, name));
	@name.kind = token_kind::op_plus;
	var sum = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::binary, integer, name));
	var reference = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::name, integer, name));
	if (!body.get() || !returned.get() || !sum.get() || !reference.get()) {
		return 6;
	};
	@reference.get()->bind(global, value_category::place);
	if (!@sum.get()->append($reference) || !@sum.get()->append(backend_literal(integer, name, 22))) {
		return 7;
	};
	if (!@returned.get()->append($sum)) {
		return 8;
	};
	var selection = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::switch_expression, empty, name));
	var cases = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::brace, empty, name));
	@name.kind = token_kind::kw_case;
	var label = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::case_label, empty, name));
	@name.kind = token_kind::kw_default;
	var fallback = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::case_label, empty, name));
	var rejected = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::return_value, empty, name));
	if (!selection.get() || !cases.get() || !label.get() || !fallback.get() || !rejected.get()) {
		return 8;
	};
	@label.get()->set_integer(1);
	if (!@cases.get()->append($label)) {
		return 8;
	};
	if (!@cases.get()->append($returned)) {
		return 8;
	};
	if (!@cases.get()->append($fallback)) {
		return 8;
	};
	if (!@rejected.get()->append(backend_literal(integer, name, 0))) {
		return 8;
	};
	if (!@cases.get()->append($rejected)) {
		return 8;
	};
	if (!@selection.get()->append(backend_literal(integer, name, 1))) {
		return 8;
	};
	if (!@selection.get()->append($cases)) {
		return 8;
	};
	if (!@body.get()->append($selection)) {
		return 8;
	};
	@function->set_body($body);
	if (!@backend.emit(unit, rt::string_view("main\0"), output_kind::executable)) {
		return 9;
	};
	var file = File(output);
	if (!@backend.write(@file)) {
		return 10;
	};
	if (!@file.close()) {
		return 11;
	};
	return 0;
};
