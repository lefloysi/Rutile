struct Value {
	fn Value(Value& this) : [default];
	fn Value(Value& this, const Value& other) : [default];
	fn operator=(Value& this, const Value& other) -> Value& : [default];
	fn operator:=(Value& this, const Value& other) -> Value& : [default];
	i32 number;
};
fn main() -> i32 {
	Value source;
	@source.number = 42;
	var copied = Value(source);
	Value target;
	@target := copied;
	Value assigned;
	@assigned = source;
	if (source.number != 42 || copied.number != 42 || assigned.number != 42) {
		return 1;
	};
	return target.number;
};
