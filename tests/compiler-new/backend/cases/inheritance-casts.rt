struct Base {
	i32 value;
	fn get(const Base& this) -> i32 {
		return this.value;
	};
};

struct Derived : [Base] {
	i32 other;
};

fn main() -> i32 {
	Derived object;
	@object.value = 20;
	var Base* base = static_cast<var Base*>(&@object);
	var Derived* derived = static_cast<var Derived*>(base);
	@derived->other = 22;
	var Base& reference = static_cast<var Base&>(@object);
	if (&@reference != base) {
		return 1;
	};
	i32 result = reference.value;
	const Base& borrowed = object;
	var Derived* absent = nullptr;
	var Base* empty = static_cast<var Base*>(absent);
	if (&@borrowed != base || derived != &@object || empty || object.get() != 20) {
		return 1;
	};
	return result + object.other;
};
