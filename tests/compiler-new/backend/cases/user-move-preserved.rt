i32 moved;
struct Value {
	fn Value(var Value& this) : [default];
	fn Value(var Value& this, Value other);
	i32 number;
};
fn Value::Value(var Value& this, Value other) {
	@this.number = other.number;
	@moved = moved + 1;
	discard $other;
};
fn main() -> i32 {
	Value source;
	@source.number = 42;
	var target = Value($source);
	if (moved != 1) {
		return 1;
	};
	return target.number;
};
