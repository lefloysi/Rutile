i32 constructed;
i32 destroyed;
i32 calls;

struct Item {
	i32 index;
	fn Item(var Item& this) {
		@constructed = constructed + 1;
		@this.index = constructed;
	};
	fn ~Item(var Item& this) {
		@destroyed = destroyed * 10 + this.index;
	};
};

fn length() -> usize {
	@calls = calls + 1;
	return 2;
};

fn main() -> i32 {
	var items = new var Item[length()]();
	if (!items || calls != 1 || constructed != 2 || items[0].index != 1 || items[1].index != 2) {
		return 1;
	};
	delete[] items;
	if (destroyed != 21) {
		return 2;
	};
	var empty = new var Item[0]();
	delete[] empty;
	var Item* absent = nullptr;
	delete[] absent;
	if (constructed != 2 || destroyed != 21) {
		return 3;
	};
	return 42;
};
