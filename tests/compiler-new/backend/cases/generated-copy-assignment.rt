i32 assignments;
struct Leaf {
	fn operator=(Leaf& this, const Leaf& other) -> Leaf&;
	i32 number;
};
fn Leaf::operator=(Leaf& this, const Leaf& other) -> Leaf& {
	@this.number = other.number;
	@assignments = assignments + 1;
	return @this;
};
struct Wrapper {
	Leaf leaf;
	i32* pointer;
};
fn main() -> i32 {
	i32 external = 17;
	Wrapper source;
	@source.leaf.number = 42;
	@source.pointer = &external;
	Wrapper target;
	@target := source;
	if (assignments != 1 || target.leaf.number != 42 || target.pointer != source.pointer) {
		return 1;
	};
	@target = source;
	if (assignments != 2 || target.pointer != &external) {
		return 2;
	};
	return target.leaf.number;
};
