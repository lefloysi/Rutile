i32 copies;
i32 destroyed;
struct Probe {
	fn Probe(var Probe& this) : [default];
	fn Probe(var Probe& this, const Probe& other);
	fn ~Probe(var Probe& this);
	i32 number;
};
fn Probe::Probe(var Probe& this, const Probe& other) {
	@this.number = other.number;
	@copies = copies + 1;
};
fn Probe::~Probe(var Probe& this) {
	@destroyed = destroyed + 1;
};
fn main() -> i32 {
	{
		Probe original;
		@original.number = 42;
		var moved = Probe($original);
		Probe target;
		@target = $moved;
		if (target.number != 42 || copies || destroyed != 1) {
			return 1;
		};
	};
	if (copies || destroyed != 2) {
		return 2;
	};
	return 42;
};
