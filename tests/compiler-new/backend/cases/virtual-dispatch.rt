struct Base {
	i32 first;
	fn value(const Base& this) -> i32 : [virtual] {
		return this.first;
	};
};

struct Derived : [Base] {
	i32 second;
	fn value(const Derived& this) -> i32 : [override] {
		return this.first + this.second;
	};
};

fn dispatch(const Base& object) -> i32 {
	return object.value();
};

fn main() -> i32 {
	Derived object;
	@object.first = 20;
	@object.second = 22;
	var callback = &Base::value;
	if (dispatch(object) != 42 || callback(object) != 42 || object.value() != 42) {
		return 1;
	};
	return 42;
};
