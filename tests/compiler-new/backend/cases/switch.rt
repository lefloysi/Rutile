fn classify(i32 value) -> i32 {
	switch (value) {
		case 0:
			return 10;
		case 1:
		case 2:
			return 20;
		default:
			return 30;
	};
};

fn main() -> i32 {
	i32 result;
	switch (2) {
		case 0:
			@result = 100;
			break;
		case 2:
			@result = 1;
		case 3:
			@result = result + 1;
			break;
		default:
			@result = 200;
	};
	return result + classify(1) + classify(2);
};
