fn main() -> i32 {
	i32[1024] values;
	@values[456] = 42;
	i32* base = &values[256];
	u08 forward = 200;
	i08 backward = -56;
	if (base[forward] != 42 || base[forward] != *(base + forward)) {
		return 1;
	};
	@base[backward] = 17;
	if (values[200] != 17 || *(base + backward) != 17) {
		return 2;
	};
	u08 direct = 200;
	if (values[direct] != 17) {
		return 3;
	};
	i32[2][256] nested;
	u08 outer = 200;
	@nested[outer][1] = 42;
	return nested[outer][1];
};
