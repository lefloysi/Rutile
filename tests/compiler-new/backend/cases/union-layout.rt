union Storage {
	u08[17] bytes;
	u64 number;
};

struct Wrapped {
	u08 marker;
	Storage value;
	u08 tail;
};

fn main() -> i32 {
	Wrapped storage;
	@storage.marker = 1;
	@storage.value.number = 42;
	usize offset = reinterpret_cast<usize>(&@storage.value) - reinterpret_cast<usize>(&@storage);
	usize number = reinterpret_cast<usize>(&@storage.value.number);
	usize bytes = reinterpret_cast<usize>(&@storage.value.bytes);
	if (sizeof(Storage) != 24 || sizeof(Wrapped) != 40 || offset != 8 || number != bytes) {
		return 1;
	};
	return static_cast<i32>(storage.value.number);
};
