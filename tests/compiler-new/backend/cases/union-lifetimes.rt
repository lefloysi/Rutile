i32 constructed;
i32 destroyed;
i32 unions;

struct Member {
	fn Member(var Member& this) {
		@constructed = constructed + 1;
	};
	fn ~Member(var Member& this) {
		@destroyed = destroyed + 1;
	};
};

union Storage {
	u08 empty;
	Member member;
	fn Storage(var Storage& this) {
		@this.empty = 0;
	};
	fn ~Storage(var Storage& this) {
		@unions = unions + 1;
	};
};

fn main() -> i32 {
	{
		Storage value;
	};
	if (constructed || destroyed || unions != 1) {
		return 1;
	};
	return 42;
};
