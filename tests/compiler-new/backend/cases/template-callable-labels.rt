fn identity(i32 value) -> i32 {
	return $value;
};

template<typename T>
fn deduced(T callback) -> i32 {
	return callback({ @value = 20; });
};

template<typename T>
fn explicit(T callback) -> i32 {
	return callback({ @declared_argument = 22; });
};

fn main() -> i32 {
	using Callback = ((i32 declared_argument) -> i32)*;
	return deduced(&identity) + explicit<Callback>(&identity);
};
