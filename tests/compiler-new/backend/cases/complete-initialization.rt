struct Pair {
	i32 first;
	i32 second;
};

struct Partial {
	fn Partial(var Partial& this, i32 value);

	i32 written;
	i32 unwritten;
};

fn Partial::Partial(var Partial& this, i32 value) {
	@this.written = $value;
};

fn scalar_transfer(var i32* destination, i32* source) {
	@destination[0].i32(source[0]);
};

fn move_transfer(var Pair* destination, var Pair* source) {
	@destination[0].Pair($(source[0]));
};

fn copy_transfer(var Pair* destination, Pair* source) {
	@destination[0].Pair(source[0]);
};

union PartialUnion {
	fn PartialUnion(var PartialUnion& this) : [default];
	fn PartialUnion(var PartialUnion& this, PartialUnion& source);

	i32[2] parts;
};

fn PartialUnion::PartialUnion(var PartialUnion& this, PartialUnion& source) {
	@this.parts[0] = source.parts[0];
};

struct Wrapper {
	PartialUnion member;
};

fn main() -> i32 {
	i32 value = 42;
	scalar_transfer(&@value, &value);
	if (value != 42) {
		return 1;
	};

	Pair source;
	@source.first = 17;
	@source.second = 25;
	Pair copy;
	copy_transfer(&@copy, &source);
	if (copy.first != 17 || copy.second != 25) {
		return 2;
	};

	Pair moved;
	move_transfer(&@moved, &@source);
	if (moved.first != 17 || moved.second != 25) {
		return 3;
	};

	Partial partial = Partial(9);
	@partial.unwritten = 99;
	@partial.Partial(10);
	Pair empty;
	i32[2] zero_array {};
	i32 zero;
	if (partial.written != 10 || partial.unwritten || empty.first || empty.second || zero || zero_array[0] || zero_array[1]) {
		return 4;
	};

	Wrapper partial_source;
	@partial_source.member.parts[0] = 42;
	@partial_source.member.parts[1] = 57;
	Wrapper partial_destination;
	@partial_destination.member.parts[0] = 18;
	@partial_destination.member.parts[1] = 99;
	@partial_destination.Wrapper(partial_source);
	if (partial_destination.member.parts[0] != 42 || partial_destination.member.parts[1]) {
		return 5;
	};

	return 42;
};
