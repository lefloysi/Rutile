i32 copies;
i32 moves;
i32 destroyed;

struct Member {
	i32 value;
	fn Member(var Member& this) : [default];
	fn Member(var Member& this, const Member& other) {
		@copies = copies + 1;
		@this.value = other.value;
	};
	fn Member(var Member& this, Member other) {
		@moves = moves + 1;
		@this.value = other.value;
		discard $other;
	};
	fn ~Member(var Member& this) {
		@destroyed = destroyed + 1;
	};
};

struct Owner {
	Member member;
	fn Owner(var Owner& this) : [default];
	fn Owner(var Owner& this, Owner other) : [default];
};

fn main() -> i32 {
	i32 result;
	{
		Owner first;
		@first.member.value = 41;
		Owner second = $first;
		@result = second.member.value;
	};
	return result + destroyed + copies * 10 + moves * 10;
};
