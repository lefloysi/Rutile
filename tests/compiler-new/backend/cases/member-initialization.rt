i32 constructed;
i32 trace;

struct Member {
	i32 index;
	fn Member(var Member& this) {
		@constructed = constructed + 1;
		@this.index = constructed;
		@trace = trace * 10 + constructed;
	};
	fn ~Member(var Member& this) {
		@trace = trace * 10 + this.index;
	};
};

struct Owner {
	Member first;
	Member second;
	fn Owner(var Owner& this) {
		if (constructed != 2 || trace != 12) {
			@trace = 999;
			return;
		};
		@trace = trace * 10 + 3;
	};
	fn ~Owner(var Owner& this) {
		@trace = trace * 10 + 4;
	};
};

fn main() -> i32 {
	{
		Owner value;
	};
	if (constructed != 2 || trace != 123421) {
		return 1;
	};
	return 42;
};
