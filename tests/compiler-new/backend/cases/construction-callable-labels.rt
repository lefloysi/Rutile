fn identity(i32 original_argument) -> i32 {
	return $original_argument;
};

fn other(i32 other_argument) -> i32 {
	return $other_argument;
};

fn main() -> i32 {
	using Callback = ((i32 construction_argument) -> i32)*;
	var callback = Callback(&identity);
	@callback = &other;

	return callback({ @construction_argument = 42; });
};
