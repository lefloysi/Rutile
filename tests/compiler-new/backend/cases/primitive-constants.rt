using Signed = i64;
using Word = usize;
using Real = f32;
enum Limit : [u64] {
	maximum = Word::max;
};
fn main() -> i32 {
	if (i08::max != 127 || i16::max != 32767 || i32::max != 2147483647 || Signed::max != 9223372036854775807) {
		return 1;
	};
	if (u08::max != 255 || u16::max != 65535 || u32::max != 4294967295 || u64::max != 18446744073709551615) {
		return 2;
	};
	if (Word::max != 18446744073709551615 || isize::max != Signed::max || static_cast<u64>(Limit::maximum) != Word::max) {
		return 3;
	};
	if (char::max != 127 || !bool::max || i8::max != i08::max || u8::max != u08::max) {
		return 4;
	};
	if (Real::max != 3.4028234663852886e38 || f64::max != 1.7976931348623157e308) {
		return 5;
	};
	i32[u08::max] values;
	@values[254] = 42;
	return values[254];
};
