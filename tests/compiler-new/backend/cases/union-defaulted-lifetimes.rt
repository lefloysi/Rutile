i32 constructed;
i32 destroyed;

struct Item {
	fn Item(Item& this);
	fn ~Item(Item& this);

	i32 value;
};

fn Item::Item(Item& this) {
	@constructed = constructed + 1;
	@this.value = 42;
};

fn Item::~Item(Item& this) {
	@destroyed = destroyed + 1;
};

union Slot {
	fn Slot(Slot& this) : [default];
	fn ~Slot(Slot& this) : [default];

	u08 empty;
	Item value;
};

fn main() -> i32 {
	{
		Slot inactive;
	};
	if (constructed || destroyed) {
		return 1;
	};

	i32 result = 0;
	{
		Slot active;
		@active.value.Item();
		@result = active.value.value;
		@active.value.~Item();
	};
	if (constructed != 1 || destroyed != 1) {
		return 2;
	};

	Slot* storage = new Slot[3]();
	if (constructed != 1 || destroyed != 1) {
		return 3;
	};
	@storage[1].value.Item();
	@storage[1].value.~Item();
	delete[] storage;
	if (constructed != 2 || destroyed != 2) {
		return 4;
	};
	return $result;
};
