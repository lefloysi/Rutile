fn OrderedOwner::answer(OrderedOwner& this) -> i32 {
	return 42;
};

fn OrderedBufferOwner::count(OrderedBufferOwner& this) -> usize {
	return this.values.size();
};

fn OrderedTemplateOwner::answer(OrderedTemplateOwner& this) -> i32 {
	return this.value.answer();
};

template<typename T>
fn OrderedTemplate<T>::answer(OrderedTemplate& this) -> i32 {
	return 42;
};

struct OrderedOwner {
	fn answer(OrderedOwner& this) -> i32;
};

struct OrderedBufferOwner {
	rt::buffer<OrderedElement> values;
	fn count(OrderedBufferOwner& this) -> usize;
};

struct OrderedElement {
	i32 value;
};

template<typename T>
struct OrderedTemplate {
	fn answer(OrderedTemplate& this) -> i32;
};

struct OrderedTemplateOwner {
	OrderedTemplate<i32> value;
	fn answer(OrderedTemplateOwner& this) -> i32;
};

fn main() -> i32 {
	OrderedOwner owner;
	OrderedBufferOwner buffer_owner;
	OrderedTemplateOwner template_owner;
	if (buffer_owner.count()) {
		return 1;
	};
	if (template_owner.answer() != 42) {
		return 2;
	};
	return owner.answer();
};
