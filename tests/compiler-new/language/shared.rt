fn shared_analysis_tests() -> i32 {
	var compiler = Compiler();
	var analysis = rt::unique<Analysis>::make();
	if (!analysis.get() || !@analysis.get()->add_source("shared.rt\0", "fn answer() -> i32 { return 42; };\0") || !@analysis.get()->analyze(64, nullptr, nullptr)) {
		return 1;
	};
	const SemanticUnit* unit = analysis.get()->semantics();
	if (analysis.get()->diagnostics().failed() || !@compiler.publish($analysis)) {
		return 2;
	};
	var lease = @compiler.acquire_analysis();
	if (!lease.get() || lease.value().semantics() != unit || !lease.value().navigation().symbol_count()) {
		return 3;
	};
	if (@compiler.emit_current(const_cast<char*>("shared-analysis.obj\0"), nullptr, 0, nullptr, output_kind::library)) {
		return 4;
	};
	if (lease.value().semantics() != unit) {
		return 5;
	};

	var source = rt::string_view("fn answer() -> i32 { return missing; };\0");
	var editor = rt::unique<Analysis>::make();
	if (!editor.get() || !@editor.get()->add_source("shared-diagnostic.rt\0", source) || !@editor.get()->analyze(64, nullptr, nullptr)) {
		return 6;
	};
	if (!editor.get()->diagnostics().failed() || !editor.get()->diagnostics().records().size()) {
		return 7;
	};
	var file = File(fopen("shared-diagnostic.rt\0", "wb\0"));
	if (!file.is_open() || !@file.write(source) || !@file.close()) {
		return 8;
	};
	char*[1] paths;
	@paths[0] = const_cast<char*>("shared-diagnostic.rt\0");
	if (@compiler.compile(&paths[0], 1, const_cast<char*>("shared-diagnostic.obj\0"), &fopen, nullptr, 0, nullptr, output_kind::library) != 1) {
		return 9;
	};
	var failed = @compiler.acquire_analysis();
	if (!failed.get() || failed.value().diagnostics().records().size() != editor.get()->diagnostics().records().size()) {
		return 10;
	};
	const DiagnosticRecord& native_error = failed.value().diagnostics().records().data()[0];
	const DiagnosticRecord& editor_error = editor.get()->diagnostics().records().data()[0];
	if (native_error.message.view() != editor_error.message.view() || native_error.location.begin != editor_error.location.begin) {
		return 11;
	};
	if (lease.value().semantics() != unit || lease.value().source_text(0) != rt::string_view("fn answer() -> i32 { return 42; };\0")) {
		return 12;
	};
	if (target_analysis_tests() != 42) {
		return 19;
	};
	if (language_metadata_tests() != 42) {
		return 39;
	};
	if (target_diagnostic_tests() != 42) {
		return 55;
	};
	return completion_metadata_tests();
};

fn target_analysis_tests() -> i32 {
	var compiler = Compiler();
	var first_key = rt::string_view("first\0");
	var second_key = rt::string_view("second\0");
	if (!@compiler.expect_target(first_key, 5) || !@compiler.expect_target(second_key, 2) || @compiler.expect_target(first_key, 4)) {
		return 20;
	};
	var first = rt::unique<Analysis>::make();
	var second = rt::unique<Analysis>::make();
	if (!first.get() || !second.get()) {
		return 21;
	};
	if (!@first.get()->add_source("first.rt\0", "fn answer() -> i32 { return 42; };\0") || !@second.get()->add_source("second.rt\0", "fn answer() -> i32 { return 17; };\0")) {
		return 22;
	};
	if (!@first.get()->analyze(64, nullptr, nullptr) || !@second.get()->analyze(64, nullptr, nullptr)) {
		return 23;
	};
	const SemanticUnit* first_unit = first.get()->semantics();
	const SemanticUnit* second_unit = second.get()->semantics();
	if (@compiler.publish_target(first_key, 5, $first) != analysis_publication::published || @compiler.publish_target(second_key, 2, $second) != analysis_publication::published) {
		return 24;
	};
	var first_lease = @compiler.acquire_target(first_key);
	var second_lease = @compiler.acquire_target(second_key);
	if (!first_lease.get() || !second_lease.get() || first_lease.revision() != 5 || second_lease.revision() != 2 || first_lease.value().semantics() != first_unit || second_lease.value().semantics() != second_unit || first_unit == second_unit) {
		return 25;
	};
	if (@compiler.emit_target(first_key, const_cast<char*>("shared-target-first.obj\0"), nullptr, 0, nullptr, output_kind::library)) {
		return 26;
	};
	if (!@compiler.expect_target(first_key, 6)) {
		return 27;
	};
	var pending = @compiler.acquire_current_target(first_key);
	if (pending.get() || @compiler.emit_target(first_key, const_cast<char*>("shared-pending.obj\0"), nullptr, 0, nullptr, output_kind::library) != 1) {
		return 32;
	};
	var obsolete = rt::unique<Analysis>::make();
	if (@compiler.publish_target(first_key, 5, $obsolete) != analysis_publication::obsolete) {
		return 28;
	};
	var replacement = rt::unique<Analysis>::make();
	if (!@replacement.get()->add_source("replacement.rt\0", "fn replacement() -> i32 { return 9; };\0") || !@replacement.get()->analyze(64, nullptr, nullptr)) {
		return 29;
	};
	if (@compiler.publish_target(first_key, 6, $replacement) != analysis_publication::published) {
		return 30;
	};
	var current = @compiler.acquire_target(first_key);
	var untouched = @compiler.acquire_target(second_key);
	if (!current.get() || current.revision() != 6 || current.value().semantics() == first_unit || untouched.value().semantics() != second_unit || first_lease.value().semantics() != first_unit || first_lease.value().source_path(0) != rt::string_view("first.rt\0")) {
		return 31;
	};
	return 42;
};

fn language_metadata_tests() -> i32 {
	var analysis = Analysis();
	var source = rt::string_view("struct Payload { i32 field; }; template<typename T, i32 N> struct Box { T value; }; fn pick(i32 input) -> i32 { return input; }; fn pick(Payload input) -> i32 { return input.field; }; fn answer() -> i32 { Box<Payload, 3> box; i32 outer = 42; { Payload outer; pick($outer); }; return pick(outer); };\0");
	if (!@analysis.add_source("metadata.rt\0", source) || !@analysis.analyze(64, nullptr, nullptr) || analysis.diagnostics().failed()) {
		return 40;
	};
	const SemanticUnit& semantics = *analysis.semantics();
	const rt::buffer<rt::unique<Entity>>& entities = semantics.entities();
	bool retained = false;
	usize index = 0;
	while (index < entities.size()) {
		Entity* entity = entities.data()[index].get();
		@index = index + 1;
		const TemplateInstantiation* metadata = entity->template_arguments();
		if (entity->name() == rt::string_view("Box\0") && metadata && metadata->arguments.size() == 2) {
			@retained = metadata->arguments.data()[0].kind == template_argument_kind::type && metadata->arguments.data()[0].type->entity()->name() == rt::string_view("Payload\0") && metadata->arguments.data()[1].kind == template_argument_kind::value && metadata->arguments.data()[1].value == 3;
		};
	};
	if (!retained) {
		return 41;
	};
	const NavigationIndex& navigation = analysis.navigation();
	bool readable = false;
	@index = 0;
	while (index < navigation.symbol_count()) {
		const NavigationSymbol* symbol = navigation.symbol_at(index);
		@index = index + 1;
		if (symbol->detail == rt::string_view("Box<Payload, 3>: Box<Payload, 3>\0")) {
			@readable = true;
		};
	};
	if (!readable || !navigation.scope_count() || !navigation.binding_count() || navigation.call_count() != 2) {
		return 43;
	};
	const NavigationCall* first = navigation.call_at(0);
	const NavigationCall* second = navigation.call_at(1);
	if (first->symbol == second->symbol || first->scope == second->scope || first->arguments.size() != 1 || second->arguments.size() != 1 || navigation.parameter_count(first->symbol) != 1 || navigation.parameter_at(first->symbol, 0)->name != rt::string_view("input\0")) {
		return 44;
	};
	var first_range = first->arguments.data()[0];
	if (source.slice(first_range.begin, first_range.end - first_range.begin) != rt::string_view("$outer\0")) {
		return 45;
	};
	return 42;
};

fn target_diagnostic_tests() -> i32 {
	var compiler = Compiler();
	var key = rt::string_view("unsaved-target\0");
	var analysis = rt::unique<Analysis>::make();
	if (!@analysis.get()->add_source("unsaved-error.rt\0", "fn pick(i32 input) -> i32 { return input; }; fn answer() -> i32 { return pick(nullptr); };\0") || !@analysis.get()->analyze(64, nullptr, nullptr)) {
		return 50;
	};
	if (!analysis.get()->diagnostics().failed() || !analysis.get()->diagnostics().records().size() || !analysis.get()->diagnostics().records().data()[0].notes.size()) {
		return 51;
	};
	if (!@compiler.expect_target(key, 1) || @compiler.publish_target(key, 1, $analysis) != analysis_publication::published) {
		return 52;
	};
	NativeFile* output = fopen("shared-target-diagnostic.txt\0", "wb\0");
	if (!output) {
		return 53;
	};
	i32 result = @compiler.emit_target(key, const_cast<char*>("shared-invalid.obj\0"), nullptr, 0, output, output_kind::library);
	fclose(output);
	if (result != 1) {
		return 54;
	};
	return 42;
};

fn completion_metadata_tests() -> i32 {
	var analysis = Analysis();
	var source = rt::string_view("struct Item { i32 public_value; fn read(const Item& this) -> i32; private: i32 private_value; }; fn Item::read(const Item& this) -> i32 { return this.private_value; }; fn outside(Item& item) -> i32 { return item.public_value; };\0");
	if (!@analysis.add_source("completion.rt\0", source) || !@analysis.analyze(64, nullptr, nullptr) || analysis.diagnostics().failed()) {
		return 60;
	};
	const NavigationIndex& navigation = analysis.navigation();
	u64 parameter = 0;
	u64 receiver = 0;
	u64 private_field = 0;
	u64 public_field = 0;
	usize index = 0;
	while (index < navigation.symbol_count()) {
		const NavigationSymbol* symbol = navigation.symbol_at(index);
		@index = index + 1;
		if (symbol->name == rt::string_view("item\0")) {
			@parameter = symbol->id;
		};
		if (symbol->name == rt::string_view("this\0")) {
			@receiver = symbol->id;
		};
		if (symbol->name == rt::string_view("private_value\0")) {
			@private_field = symbol->id;
		};
		if (symbol->name == rt::string_view("public_value\0")) {
			@public_field = symbol->id;
		};
	};
	u64 outside_scope = 0;
	u64 inside_scope = 0;
	@index = 0;
	while (index < navigation.binding_count()) {
		const NavigationBinding* binding = navigation.binding_at(index);
		@index = index + 1;
		if (binding->symbol == parameter) {
			@outside_scope = binding->scope;
		};
		if (binding->symbol == receiver) {
			@inside_scope = binding->scope;
		};
	};
	if (!parameter || !private_field || !public_field || !outside_scope || !inside_scope || !navigation.member_scope(parameter) || !navigation.accessible(public_field, outside_scope) || navigation.accessible(private_field, outside_scope) || !navigation.accessible(private_field, inside_scope)) {
		return 61;
	};
	@index = 0;
	while (index < navigation.scope_count()) {
		const NavigationScope* scope = navigation.scope_at(index);
		@index = index + 1;
		if (!scope->parent) {
			continue;
		};
		bool found = false;
		usize parent = 0;
		while (parent < navigation.scope_count()) {
			if (navigation.scope_at(parent)->id == scope->parent) {
				@found = true;
			};
			@parent = parent + 1;
		};
		if (!found) {
			return 62;
		};
	};
	return 42;
};
