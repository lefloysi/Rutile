namespace rt {
	template<typename T>
	export struct span {
		fn span(var span& this, T* data, usize size);
		fn span(var span& this, span& other) : [implicit, default];
		fn data(span& this) -> T*;
		fn size(span& this) -> usize;
		fn empty(span& this) -> bool;

	private:
		T* elements;
		usize count;
	};

	template<typename T>
	export fn span<T>::span(var span<T>& this, T* data, usize size) {
		@this.elements = $data;
		@this.count = $size;
	};

	template<typename T>
	export fn span<T>::data(span<T>& this) -> T* {
		return this.elements;
	};

	template<typename T>
	export fn span<T>::size(span<T>& this) -> usize {
		return this.count;
	};

	template<typename T>
	export fn span<T>::empty(span<T>& this) -> bool {
		return !this.count;
	};
};
