namespace rt {
	struct monostate {
	};

	template<typename...Ts>
	struct variant {
		fn variant(var variant& this, variant& other) : [default];
		fn variant(var variant& this, variant other) : [default];
		fn ~variant(var variant& this) : [default];
		fn operator=(var variant& this, variant other) -> var variant& : [default];
		fn operator:=(var variant& this, variant& other) -> var variant& : [default];

	private:
		union Storage {
		};

		Storage _storage;
		usize _index;
	};
};
