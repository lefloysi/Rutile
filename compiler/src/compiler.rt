fn LLVMDisposePassBuilderOptions(void* options);
fn LLVMPassBuilderOptionsSetVerifyEach(void* options, i32 enabled);
fn LLVMRunPasses(void* module, char* passes, void* machine, void* options) -> void*;
fn LLVMGetErrorMessage(void* error) -> char*;
fn LLVMDisposeErrorMessage(char* message);
fn LLVMTargetMachineEmitToMemoryBuffer(void* machine, void* module, i32 kind, char** message, void** buffer) -> i32;
fn LLVMGetBufferStart(void* buffer) -> char*;
fn LLVMGetBufferSize(void* buffer) -> usize;
fn LLVMDisposeMemoryBuffer(void* buffer);

enum ValueCategory {
	VALUE_ENTITY,
	VALUE_STORAGE,
	VALUE_TEMPORARY,
};

struct Semantic {
	Compiler* compiler;
	Scope* scope;
	Entity* function;
	Flow* flow;
	Type* selection_type;
};

struct Emitter {
	Compiler* compiler;
	Entity* function;
	Flow* flow;
	CaseBlock* cases;
};

struct CaseBlock {
	Syntax* syntax;
	void* block;
	CaseBlock* next;
};

struct CaseValue {
	u64 value;
	CaseValue* next;
};

fn entity_type(Entity* entity) -> Type* {
	switch (entity->kind) {
		case ENTITY_PRIMITIVE:
			return entity->data.primitive.type;
		case ENTITY_STRUCT:
		case ENTITY_UNION:
			return entity->data.aggregate.type;
		case ENTITY_ENUM:
			return entity->data.enumeration.type;
		case ENTITY_FUNCTION:
			return entity->data.function.type;
		case ENTITY_VARIABLE:
			return entity->data.variable.type;
		default:
			return (Type*)0;
	};
};

fn type_new(Compiler* compiler, TypeKind kind) -> Type* {
	Type* type = (Type*)memory_allocate(compiler, sizeof(Type));
	if (!type) {
		return (Type*)0;
	};

	type->kind = kind;

	return type;
};

fn type_pointer(Compiler* compiler, Type* element) -> Type* {
	Type* type = type_new(compiler, TYPE_POINTER);
	if (!type) {
		return (Type*)0;
	};

	type->data.element = element;

	return type;
};

fn type_equal(Type* first, Type* second) -> i32 {
	if (first == second) {
		return 1;
	};
	if (!first || !second || first->kind != second->kind) {
		return 0;
	};
	switch (first->kind) {
		case TYPE_VOID:
		case TYPE_BOOL:
		case TYPE_CHAR:
			return 1;
		case TYPE_SIGNED:
		case TYPE_UNSIGNED:
		case TYPE_FLOAT:
			return first->data.bits == second->data.bits;
		case TYPE_NAMED:
			return first->data.entity == second->data.entity;
		case TYPE_POINTER:
		case TYPE_REFERENCE:
			return type_equal(first->data.element, second->data.element);
		case TYPE_ARRAY:
			return first->data.array.count == second->data.array.count && type_equal(first->data.array.element, second->data.array.element);
		case TYPE_FUNCTION: {
			if (first->data.function.arity != second->data.function.arity || !type_equal(first->data.function.result, second->data.function.result)) {
				return 0;
			};
			Parameter* a := first->data.function.parameters;
			Parameter* b := second->data.function.parameters;
			while (a && b) {
				if (!type_equal(a->type, b->type)) {
					return 0;
				};
				a := a->next;
				b := b->next;
			};
			return !a && !b;
		};
	};
	return 0;
};

fn type_numeric(Type* type) -> i32 {
	return type && (type->kind == TYPE_CHAR || type->kind == TYPE_BOOL || type->kind == TYPE_SIGNED || type->kind == TYPE_UNSIGNED || type->kind == TYPE_FLOAT || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_ENUM));
};

fn type_integer(Type* type) -> i32 {
	return type_numeric(type) && type->kind != TYPE_FLOAT;
};

fn type_scalar(Type* type) -> i32 {
	return type_numeric(type) || (type && (type->kind == TYPE_POINTER || type->kind == TYPE_REFERENCE));
};

fn type_aggregate(Type* type) -> i32 {
	if (!type) {
		return 0;
	};
	if (type->kind == TYPE_ARRAY) {
		return 1;
	};
	return type->kind == TYPE_NAMED && (type->data.entity->kind == ENTITY_STRUCT || type->data.entity->kind == ENTITY_UNION);
};

fn type_bits(Type* type) -> i32 {
	if (type->kind == TYPE_BOOL) {
		return 1;
	};
	if (type->kind == TYPE_CHAR) {
		return 8;
	};
	if (type->kind == TYPE_NAMED) {
		return 32;
	};
	return type->data.bits;
};

fn type_unsigned(Type* type) -> i32 {
	return type->kind == TYPE_UNSIGNED || type->kind == TYPE_BOOL;
};

fn type_resolve(Compiler* compiler, Scope* scope, Syntax* syntax) -> Type*;
fn entity_resolve(Compiler* compiler, Entity* entity);
fn llvm_body(Compiler* compiler, Entity* entity) -> void*;
fn llvm_type(Compiler* compiler, Type* type) -> void*;

fn integer_spelling(Compiler* compiler, Token token, u64 maximum) -> u64 {
	if (token.length && token.source->bytes[token.begin] == '\'') {
		char character := token.source->bytes[token.begin + 1];

		if (character == '\\') {
			character = literal_escape(compiler, token, token.source->bytes[token.begin + 2]);
		};

		u64 value = (u64)character;

		if (value > maximum) {
			compiler_error(compiler, token, "character literal is outside the destination range\0");
			return 0;
		};

		return value;
	};

	u64 result = 0;
	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes[token.begin + index];

		if (!lexer_digit(character)) {
			compiler_error(compiler, token, "expected a decimal integer literal\0");
			return 0;
		};

		u64 digit = (u64)(character - '0');

		if (result > maximum / 10 || (result == maximum / 10 && digit > maximum % 10)) {
			compiler_error(compiler, token, "integer literal is outside the destination range\0");
			return 0;
		};

		result = result * 10 + digit;
		index = index + 1;
	};
	return result;
};

fn number_truth(Compiler* compiler, Token token) -> u64 {
	if (token.source->bytes[token.begin] == '\'') {
		return integer_spelling(compiler, token, 255) != 0;
	};

	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes[token.begin + index];
		if (character == 'e' || character == 'E') {
			break;
		};
		if (character >= '1' && character <= '9') {
			return 1;
		};

		index = index + 1;
	};

	return 0;
};

fn type_resolve(Compiler* compiler, Scope* scope, Syntax* syntax) -> Type* {
	if (!syntax) {
		return compiler->void_type;
	};
	if (syntax->type) {
		return syntax->type;
	};
	Type* type = (Type*)0;
	switch (syntax->kind) {
		case SYNTAX_NAME: {
			Entity* entity = syntax_lookup(scope, syntax);
			if (!entity || (entity->kind != ENTITY_PRIMITIVE && entity->kind != ENTITY_STRUCT && entity->kind != ENTITY_UNION && entity->kind != ENTITY_ENUM)) {
				compiler_error(compiler, syntax->token, "identifier does not name a type entity\0");
				return compiler->void_type;
			};
			syntax->entity := entity;
			if (!entity_type(entity) && entity->kind != ENTITY_PRIMITIVE) {
				Type* named = type_new(compiler, TYPE_NAMED);
				named->data.entity := entity;
				if (entity->kind == ENTITY_ENUM) {
					entity->data.enumeration.type = named;
				}
				else {
					entity->data.aggregate.type = named;
				};
			};
			type = entity_type(entity);
			break;
		};
		case SYNTAX_POINTER:
		case SYNTAX_REFERENCE: {
			TypeKind kind = TYPE_POINTER;
			if (syntax->kind == SYNTAX_REFERENCE) {
				kind = TYPE_REFERENCE;
			};
			type = type_new(compiler, kind);
			type->data.element = type_resolve(compiler, scope, syntax->data.expression);
			if ((kind == TYPE_POINTER && type->data.element->kind == TYPE_REFERENCE) || (kind == TYPE_REFERENCE && (type->data.element->kind == TYPE_VOID || type->data.element->kind == TYPE_REFERENCE))) {
				compiler_error(compiler, syntax->token, "reference requires an object or function referent type\0");
			};
			break;
		};
		case SYNTAX_ARRAY:
			type = type_new(compiler, TYPE_ARRAY);
			type->data.array.count = integer_spelling(compiler, syntax->data.array.count, (u64)18446744073709551615);
			type->data.array.element = type_resolve(compiler, scope, syntax->data.array.element);
			if (!type->data.array.count || type->data.array.element->kind == TYPE_VOID || type->data.array.element->kind == TYPE_FUNCTION || type->data.array.element->kind == TYPE_REFERENCE) {
				compiler_error(compiler, syntax->token, "array requires a positive length and a storage element type\0");
			};
			break;
		case SYNTAX_SIGNATURE: {
			type = type_new(compiler, TYPE_FUNCTION);
			type->data.function.result = type_resolve(compiler, scope, syntax->data.signature.result);
			type->data.function.arity := syntax->data.signature.arity;
			Parameter* last = (Parameter*)0;
			ParameterSyntax* input := syntax->data.signature.parameters;
			while (input) {
				Parameter* parameter = (Parameter*)memory_allocate(compiler, sizeof(Parameter));
				parameter->name := input->name;
				parameter->type = type_resolve(compiler, scope, input->type);
				if (parameter->type->kind == TYPE_VOID || parameter->type->kind == TYPE_FUNCTION) {
					compiler_error(compiler, input->type->token, "parameter requires a storage type\0");
				};
				if (last) {
					last->next := parameter;
				}
				else {
					type->data.function.parameters := parameter;
				};
				last = parameter;
				input := input->next;
			};
			break;
		};
		default:
			compiler_error(compiler, syntax->token, "expected type expression\0");
			type := compiler->void_type;
			break;
	};
	syntax->type := type;
	return type;
};

fn constant_selector(u64 value, Type* type) -> u64;

fn constant_integer(Compiler* compiler, Scope* scope, Syntax* syntax) -> u64 {
	if (syntax->kind == SYNTAX_NUMBER) {
		return integer_spelling(compiler, syntax->token, (u64)18446744073709551615);
	};

	if (syntax->kind == SYNTAX_NAME) {
		Entity* entity = syntax_lookup(scope, syntax);
		if (entity && entity->kind == ENTITY_VARIABLE && entity->data.variable.storage == STORAGE_CONSTANT && entity->resolution == RESOLUTION_PENDING && entity->scope && entity->scope->owner && entity->scope->owner->kind == ENTITY_ENUM) {
			entity_resolve(compiler, entity->scope->owner);
		};
		if (entity && entity->kind == ENTITY_VARIABLE && entity->data.variable.storage == STORAGE_CONSTANT && entity->resolution == RESOLUTION_READY) {
			return entity->data.variable.data.integer;
		};
	};

	if (syntax->kind == SYNTAX_UNARY) {
		u64 value = constant_integer(compiler, scope, syntax->data.unary.value);
		if (syntax->data.unary.operation == TOKEN_MINUS) {
			return (u64)0 - value;
		};
		if (syntax->data.unary.operation == TOKEN_PLUS) {
			return value;
		};
		if (syntax->data.unary.operation == TOKEN_BANG) {
			return (u64)!value;
		};
		if (syntax->data.unary.operation == TOKEN_TILDE) {
			return ~value;
		};
	};

	if (syntax->kind == SYNTAX_CAST) {
		Type* target = type_resolve(compiler, scope, syntax->data.cast.type);
		if (!type_integer(target)) {
			compiler_error(compiler, syntax->token, "constant cast requires an integer destination\0");
			return 0;
		};

		u64 value = constant_integer(compiler, scope, syntax->data.cast.value);
		value = constant_selector(value, target);
		i32 bits = type_bits(target);
		if (!type_unsigned(target) && bits < 64) {
			u64 width = (u64)(64 - bits);
			u64 mask = (u64)18446744073709551615 >> width;
			if (value > mask / 2) {
				value = value | ~mask;
			};
		};
		return value;
	};

	if (syntax->kind == SYNTAX_BINARY) {
		u64 first = constant_integer(compiler, scope, syntax->data.binary.left);
		u64 second = constant_integer(compiler, scope, syntax->data.binary.right);
		if (compiler->result == COMPILATION_FAILURE) {
			return 0;
		};
		i64 signed_first := (i64)first;
		i64 signed_second := (i64)second;
		if ((syntax->data.binary.operation == TOKEN_SLASH || syntax->data.binary.operation == TOKEN_REMAINDER) && (!second || (signed_first == (i64)-9223372036854775808 && signed_second == (i64)-1))) {
			compiler_error(compiler, syntax->token, "invalid constant division\0");
			return 0;
		};
		if ((syntax->data.binary.operation == TOKEN_SHIFT_LEFT || syntax->data.binary.operation == TOKEN_SHIFT_RIGHT) && second >= 64) {
			compiler_error(compiler, syntax->token, "constant shift count is outside the integer width\0");
			return 0;
		};
		switch (syntax->data.binary.operation) {
			case TOKEN_PLUS:
				return first + second;
			case TOKEN_MINUS:
				return first - second;
			case TOKEN_STAR:
				return first * second;
			case TOKEN_AMPERSAND:
				return first & second;
			case TOKEN_PIPE:
				return first | second;
			case TOKEN_CARET:
				return first ^ second;
			case TOKEN_SHIFT_LEFT:
				return first << second;
			case TOKEN_SHIFT_RIGHT:
				return (u64)(signed_first >> signed_second);
			case TOKEN_SLASH:
				if (second) {
					return (u64)(signed_first / signed_second);
				};
				break;
			case TOKEN_REMAINDER:
				if (second) {
					return (u64)(signed_first % signed_second);
				};
				break;
			case TOKEN_EQUAL:
				return (u64)(first == second);
			case TOKEN_NOT_EQUAL:
				return (u64)(first != second);
			case TOKEN_LESS:
				return (u64)(signed_first < signed_second);
			case TOKEN_GREATER:
				return (u64)(signed_first > signed_second);
			case TOKEN_LESS_EQUAL:
				return (u64)(signed_first <= signed_second);
			case TOKEN_GREATER_EQUAL:
				return (u64)(signed_first >= signed_second);
			case TOKEN_AND:
				return (u64)(first && second);
			case TOKEN_OR:
				return (u64)(first || second);
		};
	};

	compiler_error(compiler, syntax->token, "expected an integer constant expression\0");
	return 0;
};

fn constant_selector(u64 value, Type* type) -> u64 {
	i32 bits = type_bits(type);
	if (bits >= 64) {
		return value;
	};

	u64 maximum = (u64)18446744073709551615;
	u64 shift = (u64)(64 - bits);
	return value & (maximum >> shift);
};

fn selection_validate(Semantic* semantic, Syntax* syntax, Type* type) {
	Syntax* statement := syntax->data.selection.cases->data.statements;
	CaseValue* values = (CaseValue*)0;
	Syntax* fallback = (Syntax*)0;
	while (statement && semantic->compiler->result != COMPILATION_FAILURE) {
		if (statement->kind != SYNTAX_CASE) {
			statement := statement->next;
			continue;
		};

		Syntax* expression := statement->data.selection_case.value;
		if (!expression) {
			if (fallback) {
				compiler_error(semantic->compiler, statement->token, "duplicate default label\0");
				return;
			};
			fallback := statement;
			statement := statement->next;
			continue;
		};

		expression->type := type;
		expression->scope := syntax->data.selection.cases->scope;
		u64 value = constant_integer(semantic->compiler, expression->scope, expression);
		value = constant_selector(value, type);
		CaseValue* previous := values;
		while (previous) {
			if (previous->value == value) {
				compiler_error(semantic->compiler, statement->token, "duplicate case value after conversion to the selector type\0");
				return;
			};
			previous := previous->next;
		};

		CaseValue* selected = (CaseValue*)memory_allocate(semantic->compiler, sizeof(CaseValue));
		if (!selected) {
			return;
		};
		selected->value = value;
		selected->next := values;
		values = selected;
		statement := statement->next;
	};
};

fn entity_resolve(Compiler* compiler, Entity* entity) {
	if (!entity || entity->resolution == RESOLUTION_READY) {
		return;
	};
	if (entity->resolution == RESOLUTION_ACTIVE) {
		compiler_error(compiler, entity->name, "cyclic entity definition\0");
		return;
	};
	entity->resolution = RESOLUTION_ACTIVE;
	Syntax* declaration := entity->declaration;
	if (!declaration) {
		compiler_error(compiler, entity->name, "entity has no declaration\0");
		return;
	};
	if (entity->kind == ENTITY_FUNCTION) {
		entity->data.function.type = type_resolve(compiler, entity->scope, declaration->data.declaration.type);
		Parameter* receiver := entity->data.function.type->data.function.parameters;
		Entity* owner = (Entity*)0;
		if (entity->scope) {
			owner := entity->scope->owner;
		};
		if (owner && (owner->kind == ENTITY_STRUCT || owner->kind == ENTITY_UNION) && receiver && token_is(receiver->name, "this\0") && (receiver->type->kind != TYPE_REFERENCE || receiver->type->data.element->kind != TYPE_NAMED || receiver->type->data.element->data.entity != owner)) {
			compiler_error(compiler, receiver->name, "associated receiver must reference its owning type\0");
		};
		entity->data.function.body := declaration->data.declaration.body;
		if (entity->data.function.body) {
			entity->data.function.scope := entity->data.function.body->scope;
			Parameter* parameter := entity->data.function.type->data.function.parameters;
			while (parameter) {
				if (!parameter->name.source) {
					compiler_error(compiler, entity->name, "function definition requires named parameters\0");
					break;
				};
				parameter->entity = scope_lookup(entity->data.function.scope, parameter->name);
				if (parameter->entity && parameter->entity->kind == ENTITY_VARIABLE) {
					parameter->entity->data.variable.type := parameter->type;
					parameter->entity->resolution = RESOLUTION_READY;
				};
				parameter := parameter->next;
			};
		};
	}
	else if (entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION || entity->kind == ENTITY_ENUM) {
		if (!entity_type(entity)) {
			Type* type = type_new(compiler, TYPE_NAMED);
			type->data.entity := entity;
			if (entity->kind == ENTITY_ENUM) {
				entity->data.enumeration.type = type;
			}
			else {
				entity->data.aggregate.type = type;
			};
		};
		bases_resolve(compiler, entity);
		usize base_count = 0;
		if (entity->data.aggregate.virtual_types) {
			base_count = 1;
		};
		if (entity->kind == ENTITY_STRUCT) {
			BaseRelation* base := entity->data.aggregate.bases;
			while (base && compiler->result != COMPILATION_FAILURE) {
				entity_resolve(compiler, base->entity);
				if (!base->entity->declaration || !base->entity->declaration->data.declaration.body) {
					compiler_error(compiler, base->name->token, "base struct requires a complete definition\0");
					return;
				};
				if (base->kind == BASE_NONVIRTUAL) {
					base_count = base_count + 1;
				};
				base := base->next;
			};
		};
		Syntax* body := declaration->data.declaration.body;
		if (body) {
			Syntax* field := body->data.statements;
			usize index = 0;
			Field* last_field = (Field*)0;
			u64 next_value = 0;
			while (field) {
				if (field->kind != SYNTAX_DECLARATION) {
					compiler_error(compiler, field->token, "aggregate context requires declarations\0");
					break;
				};
				if (field->entity->kind != ENTITY_VARIABLE) {
					if (entity->kind == ENTITY_ENUM) {
						compiler_error(compiler, field->token, "enum context requires enumerator declarations\0");
						break;
					};
					field := field->next;
					continue;
				};
				Entity* variable := field->entity;
				if (entity->kind == ENTITY_ENUM) {
					variable->data.variable.type = entity_type(entity);
					variable->data.variable.storage = STORAGE_CONSTANT;
					if (field->data.declaration.body) {
						next_value = constant_integer(compiler, body->scope, field->data.declaration.body);
					};
					if ((i64)next_value < (i64)-2147483648 || (i64)next_value > (i64)2147483647) {
						compiler_error(compiler, field->token, "enum value is outside the i32 range\0");
					};
					variable->data.variable.data.integer := next_value;
					next_value = next_value + 1;
				}
				else {
					variable->data.variable.type = type_resolve(compiler, body->scope, field->data.declaration.type);
					if (entity->kind == ENTITY_UNION && variable->data.variable.type->kind == TYPE_REFERENCE) {
						compiler_error(compiler, field->token, "union cannot contain a reference field\0");
					};
					variable->data.variable.storage = STORAGE_FIELD;
					variable->data.variable.data.field.owner := entity;
					variable->data.variable.data.field.index = base_count + index;
					Field* representation = (Field*)memory_allocate(compiler, sizeof(Field));
					representation->entity := variable;
					if (last_field) {
						last_field->next := representation;
					}
					else {
						entity->data.aggregate.fields := representation;
					};
					last_field = representation;
					index = index + 1;
				};
				variable->resolution = RESOLUTION_READY;
				field := field->next;
			};
			if (entity->kind == ENTITY_ENUM) {
				entity->data.enumeration.values := body->scope->bindings;
			}
			else {
				entity->data.aggregate.field_count = index;
			};
		};
	}
	else if (entity->kind == ENTITY_VARIABLE) {
		if (declaration->data.declaration.type) {
			entity->data.variable.type = type_resolve(compiler, entity->scope, declaration->data.declaration.type);
		};
	};
	entity->resolution = RESOLUTION_READY;
};

fn type_effective(Type* type) -> Type* {
	if (type && type->kind == TYPE_REFERENCE) {
		return type->data.element;
	};
	return type;
};

fn syntax_storage_type(Syntax* syntax) -> Type* {
	if (syntax->kind == SYNTAX_BASE_REFERENCE || syntax->kind == SYNTAX_BASE_POINTER) {
		return syntax->data.base_conversion.target;
	};
	if (syntax->entity && syntax->entity->kind == ENTITY_VARIABLE) {
		return entity_type(syntax->entity);
	};
	if (syntax->kind == SYNTAX_CAST && syntax->data.cast.type->type && syntax->data.cast.type->type->kind == TYPE_REFERENCE) {
		return syntax->data.cast.type->type;
	};
	if (syntax->kind == SYNTAX_INDEX) {
		Type* object := syntax->data.binary.left->type;
		if (object->kind == TYPE_ARRAY) {
			return object->data.array.element;
		};
		return object->data.element;
	};
	if (syntax->kind == SYNTAX_UNARY && syntax->data.unary.operation == TOKEN_STAR) {
		return syntax->data.unary.value->type->data.element;
	};
	if (syntax->kind == SYNTAX_CALL) {
		Type* callable := syntax->data.call.callable->type;
		if (callable->kind == TYPE_POINTER) {
			callable := callable->data.element;
		};
		return callable->data.function.result;
	};
	return syntax->type;
};

fn syntax_category(Syntax* syntax) -> ValueCategory {
	if (syntax->kind == SYNTAX_NAME && syntax->entity && syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage != STORAGE_CONSTANT) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_BASE_REFERENCE || (syntax->kind == SYNTAX_CAST && syntax_storage_type(syntax)->kind == TYPE_REFERENCE) || syntax->kind == SYNTAX_MEMBER || syntax->kind == SYNTAX_INDEX || (syntax->kind == SYNTAX_CALL && syntax_storage_type(syntax)->kind == TYPE_REFERENCE) || (syntax->kind == SYNTAX_UNARY && syntax->data.unary.operation == TOKEN_STAR)) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_NAME && syntax->entity && syntax->entity->kind != ENTITY_VARIABLE) {
		return VALUE_ENTITY;
	};
	return VALUE_TEMPORARY;
};

fn semantic_expression(Semantic* semantic, Syntax* syntax, Type* expected) -> Type*;
fn semantic_statement(Semantic* semantic, Syntax* syntax);
fn layout_validate(Compiler* compiler, Type* type, LayoutVisit* parent, Token token);

fn syntax_number_expression(Syntax* syntax) -> i32 {
	if (syntax->kind == SYNTAX_NUMBER) {
		return 1;
	};
	if (syntax->kind == SYNTAX_UNARY && (syntax->data.unary.operation == TOKEN_PLUS || syntax->data.unary.operation == TOKEN_MINUS)) {
		return syntax_number_expression(syntax->data.unary.value);
	};
	if (syntax->kind == SYNTAX_BINARY && syntax->data.binary.operation != TOKEN_ASSIGN && syntax->data.binary.operation != TOKEN_COPY) {
		return syntax_number_expression(syntax->data.binary.left) && syntax_number_expression(syntax->data.binary.right);
	};
	return 0;
};

fn storage_borrowed(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 0;
	};
	if (syntax_storage_type(syntax) && syntax_storage_type(syntax)->kind == TYPE_REFERENCE) {
		return 1;
	};
	switch (syntax->kind) {
		case SYNTAX_MEMBER:
		case SYNTAX_INDEX:
			return 1;
		case SYNTAX_UNARY:
			return syntax->data.unary.operation == TOKEN_STAR;
		default:
			return 0;
	};
};

fn semantic_scope(Semantic* semantic, Scope* parsed) -> Scope* {
	Scope* scope = scope_create(semantic->compiler, semantic->scope, parsed->context, parsed->owner);
	if (!scope) {
		return (Scope*)0;
	};

	Binding* binding := parsed->bindings;
	while (binding) {
		Entity* entity := binding->entity;
		if (entity->kind != ENTITY_VARIABLE || entity->data.variable.storage == STORAGE_PARAMETER || entity->data.variable.storage == STORAGE_ARGUMENT || entity->data.variable.storage == STORAGE_CONSTANT) {
			scope_define(semantic->compiler, scope, entity);
		};
		binding := binding->next;
	};

	if (parsed->context == CONTEXT_FUNCTION && parsed->parent) {
		binding := parsed->parent->bindings;
		while (binding) {
			if (binding->entity->kind == ENTITY_VARIABLE && binding->entity->data.variable.storage == STORAGE_PARAMETER) {
				scope_define(semantic->compiler, scope, binding->entity);
			};
			binding := binding->next;
		};
	};

	return scope;
};

fn reference_initializer(Compiler* compiler, Syntax* body, Entity* variable, Token token) {
	Syntax* statement = (Syntax*)0;
	if (body) {
		statement := body->data.statements;
	};
	while (statement) {
		if ((statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY) && statement->data.binary.left->kind == SYNTAX_NAME && token_same(statement->data.binary.left->token, variable->name)) {
			statement->kind = SYNTAX_INITIALIZE;
			statement->data.binary.left->entity := variable;
			return;
		};
		statement := statement->next;
	};
	compiler_error(compiler, token, "reference requires a bound initializer\0");
};

union ReferencePathData {
	BaseRelation* base;
	Entity* entity;
	usize index;
};

struct ReferencePath {
	ReferencePath* parent;
	SyntaxKind kind;
	ReferencePathData data;
};

fn reference_path_type(ReferencePath* path) -> Type* {
	if (path->kind == SYNTAX_BASE_REFERENCE) {
		return entity_type(path->data.base->entity);
	};
	if (path->kind == SYNTAX_INDEX) {
		return reference_path_type(path->parent)->data.array.element;
	};
	return type_effective(entity_type(path->data.entity));
};

fn reference_base_count(ReferencePath* path) -> usize {
	if (path->kind != SYNTAX_BASE_REFERENCE) {
		return 0;
	};
	return 1 + reference_base_count(path->parent);
};

fn reference_base_at(ReferencePath* path, usize index) -> BaseRelation* {
	usize depth = reference_base_count(path);
	if (!depth || index >= depth) {
		return (BaseRelation*)0;
	};
	if (index + 1 == depth) {
		return path->data.base;
	};
	return reference_base_at(path->parent, index);
};

fn reference_bases_match(Compiler* compiler, ReferencePath* expected, Type* source, BasePath* first, BasePath* second) -> bool {
	CompleteGraph* graph = complete_graph(compiler, source->data.entity);
	Subobject* actual = subobject_path(subobject_path(graph->root, first), second);
	Subobject* required := graph->root;
	usize index = 0;
	while (index < reference_base_count(expected)) {
		required = subobject_edge(required, reference_base_at(expected, index));
		index = index + 1;
	};
	return actual == required;
};

fn reference_path_matches(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool;

fn reference_cast_subobject(Compiler* compiler, Scope* scope, ReferencePath* root, CompleteGraph* graph, Syntax* storage) -> Subobject* {
	if (storage->kind != SYNTAX_CAST) {
		if (reference_path_matches(compiler, scope, root, storage)) {
			return graph->root;
		};
		return (Subobject*)0;
	};
	Type* selected = type_resolve(compiler, scope, storage->data.cast.type);
	if (selected->kind != TYPE_REFERENCE || selected->data.element->kind != TYPE_NAMED) {
		return (Subobject*)0;
	};
	Subobject* source = reference_cast_subobject(compiler, scope, root, graph, storage->data.cast.value);
	if (!source) {
		return (Subobject*)0;
	};
	BaseSearch path = base_search(compiler, entity_type(source->entity), selected->data.element);
	if (path.count != 1) {
		return (Subobject*)0;
	};
	return subobject_path(source, path.path);
};

fn reference_path_matches(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	if (storage && storage->kind == SYNTAX_CAST && path->kind == SYNTAX_BASE_REFERENCE) {
		ReferencePath* root := path;
		while (root->kind == SYNTAX_BASE_REFERENCE) {
			root := root->parent;
		};
		Type* source = reference_path_type(root);
		CompleteGraph* graph = complete_graph(compiler, source->data.entity);
		Subobject* actual = reference_cast_subobject(compiler, scope, root, graph, storage);
		Subobject* required := graph->root;
		usize index = 0;
		while (index < reference_base_count(path)) {
			required = subobject_edge(required, reference_base_at(path, index));
			index = index + 1;
		};
		return actual && actual == required;
	};
	if (!storage || storage->kind != path->kind) {
		return false;
	};
	if (path->kind == SYNTAX_NAME) {
		return token_same(storage->token, path->data.entity->name);
	};
	if (path->kind == SYNTAX_MEMBER) {
		if (storage->token.kind == TOKEN_ARROW || !token_same(storage->data.member.name, path->data.entity->name)) {
			return false;
		};
		ReferencePath* object := path->parent;
		while (object->kind == SYNTAX_BASE_REFERENCE) {
			object := object->parent;
		};
		if (!reference_path_matches(compiler, scope, object, storage->data.member.object)) {
			return false;
		};
		Type* source = reference_path_type(object);
		Type* owner = entity_type(path->data.entity->data.variable.data.field.owner);
		Type* visible := source;
		if (storage->data.member.qualifier) {
			visible = type_resolve(compiler, scope, storage->data.member.qualifier);
		};
		if (visible->kind != TYPE_NAMED || associated_lookup(compiler, visible->data.entity, storage->data.member.name) != path->data.entity) {
			return false;
		};
		BaseSearch first = base_search(compiler, source, owner);
		BaseSearch second;
		if (storage->data.member.qualifier) {
			Type* selected = type_resolve(compiler, scope, storage->data.member.qualifier);
			first = base_search(compiler, source, selected);
			second = base_search(compiler, selected, owner);
			if (second.count != 1) {
				return false;
			};
		};
		if (first.count > 1 || second.count > 1) {
			compiler_error(compiler, storage->token, "ambiguous inherited reference field subobject\0");
			return false;
		};
		return first.count == 1 && reference_bases_match(compiler, path->parent, source, first.path, second.path);
	};
	if (path->kind == SYNTAX_INDEX) {
		return reference_path_matches(compiler, scope, path->parent, storage->data.binary.left) && constant_integer(compiler, scope, storage->data.binary.right) == (u64)path->data.index;
	};
	return false;
};

fn type_has_reference(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_REFERENCE) {
		return true;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_has_reference(type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base) {
		if (type_has_reference(entity_type(base->entity))) {
			return true;
		};
		base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field) {
		if (type_has_reference(entity_type(field->entity))) {
			return true;
		};
		field := field->next;
	};
	return false;
};

fn reference_path_contains(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	while (storage) {
		if (reference_path_matches(compiler, scope, path, storage)) {
			return true;
		};
		if (storage->kind == SYNTAX_MEMBER && storage->token.kind != TOKEN_ARROW) {
			storage := storage->data.member.object;
		}
		else if (storage->kind == SYNTAX_INDEX) {
			storage := storage->data.binary.left;
		}
		else {
			break;
		};
	};
	return false;
};

fn reference_fields_prepare(Compiler* compiler, Scope* scope, Type* type, ReferencePath* path, Syntax* body, Token token);

fn reference_whole_prepare(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* body) -> bool {
	Syntax* statement = (Syntax*)0;
	if (body) {
		statement := body->data.statements;
	};
	while (statement) {
		if ((statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY) && reference_path_matches(compiler, scope, path, statement->data.binary.left)) {
			statement->kind = SYNTAX_INITIALIZE;
			if (path->kind == SYNTAX_NAME || path->kind == SYNTAX_MEMBER) {
				statement->data.binary.left->entity := path->data.entity;
			};
			return true;
		};
		statement := statement->next;
	};
	return false;
};

fn reference_subobjects_bound(Compiler* compiler, Subobject* object, SubobjectVisit** visited) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate(compiler, sizeof(SubobjectVisit));
	visit->object := object;
	visit->next := *visited;
	*visited = visit;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		reference_subobjects_bound(compiler, edge->target, visited);
		edge := edge->next;
	};
};

fn reference_subobjects_prepare(Compiler* compiler, Scope* scope, Subobject* object, ReferencePath* path, Syntax* body, Token token, SubobjectVisit** visited) {
	if (reference_whole_prepare(compiler, scope, path, body)) {
		reference_subobjects_bound(compiler, object, visited);
		return;
	};
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate(compiler, sizeof(SubobjectVisit));
	visit->object := object;
	visit->next := *visited;
	*visited = visit;

	SubobjectEdge* edge := object->edges;
	while (edge && compiler->result != COMPILATION_FAILURE) {
		ReferencePath inherited;
		inherited.kind = SYNTAX_BASE_REFERENCE;
		inherited.parent := path;
		inherited.data.base := edge->relation;
		reference_subobjects_prepare(compiler, scope, edge->target, &inherited, body, token, visited);
		edge := edge->next;
	};
	Field* field := object->entity->data.aggregate.fields;
	while (field && compiler->result != COMPILATION_FAILURE) {
		ReferencePath member;
		member.kind = SYNTAX_MEMBER;
		member.parent := path;
		member.data.entity := field->entity;
		reference_fields_prepare(compiler, scope, entity_type(field->entity), &member, body, token);
		field := field->next;
	};
};

fn reference_fields_prepare(Compiler* compiler, Scope* scope, Type* type, ReferencePath* path, Syntax* body, Token token) {
	if (!type || compiler->result == COMPILATION_FAILURE || !type_has_reference(type)) {
		return;
	};
	if (reference_whole_prepare(compiler, scope, path, body)) {
		return;
	};
	Syntax* statement = (Syntax*)0;
	if (type->kind == TYPE_REFERENCE) {
		compiler_error(compiler, token, "object requires an initializer binding every reference field\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		ReferencePath element;
		element.kind = SYNTAX_INDEX;
		element.parent := path;
		usize index = 0;
		while (index < type->data.array.count && compiler->result != COMPILATION_FAILURE) {
			element.data.index := index;
			reference_fields_prepare(compiler, scope, type->data.array.element, &element, body, token);
			index = index + 1;
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	entity_resolve(compiler, type->data.entity);
	if (type->data.entity->kind == ENTITY_UNION) {
		if (body) {
			statement := body->data.statements;
		};
		while (statement) {
			if ((statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY)) {
				Field* field := type->data.entity->data.aggregate.fields;
				while (field) {
					ReferencePath member;
					member.kind = SYNTAX_MEMBER;
					member.parent := path;
					member.data.entity := field->entity;
					if (reference_path_contains(compiler, scope, &member, statement->data.binary.left)) {
						reference_fields_prepare(compiler, scope, entity_type(field->entity), &member, body, token);
						return;
					};
					field := field->next;
				};
			};
			statement := statement->next;
		};
		return;
	};
	CompleteGraph* graph = complete_graph(compiler, type->data.entity);
	SubobjectVisit* visited = (SubobjectVisit*)0;
	reference_subobjects_prepare(compiler, scope, graph->root, path, body, token, &visited);
};

fn object_initializer_prepare(Compiler* compiler, Scope* scope, Entity* variable, Syntax* body, Token token) {
	Type* type := entity_type(variable);
	layout_validate(compiler, type, (LayoutVisit*)0, token);
	if (compiler->result == COMPILATION_FAILURE || !type_has_reference(type)) {
		return;
	};
	Syntax* whole = (Syntax*)0;
	if (body) {
		whole := body->data.statements;
	};
	while (whole) {
		if ((whole->kind == SYNTAX_BINARY || whole->kind == SYNTAX_INITIALIZE) && (whole->data.binary.operation == TOKEN_ASSIGN || whole->data.binary.operation == TOKEN_COPY) && whole->data.binary.left->kind == SYNTAX_NAME && token_same(whole->data.binary.left->token, variable->name)) {
			whole->kind = SYNTAX_INITIALIZE;
			whole->data.binary.left->entity := variable;
			return;
		};
		whole := whole->next;
	};
	ReferencePath root;
	root.kind = SYNTAX_NAME;
	root.data.entity = variable;
	reference_fields_prepare(compiler, scope, type, &root, body, token);
};

fn syntax_base_count(Syntax* syntax) -> usize {
	if (syntax->kind != SYNTAX_BASE_REFERENCE) {
		return 0;
	};
	usize count = syntax_base_count(syntax->data.base_conversion.value);
	BasePath* path := syntax->data.base_conversion.path;
	while (path) {
		count = count + 1;
		path := path->next;
	};
	return count;
};

fn syntax_base_at(Syntax* syntax, usize index) -> BaseRelation* {
	if (syntax->kind != SYNTAX_BASE_REFERENCE) {
		return (BaseRelation*)0;
	};
	usize before = syntax_base_count(syntax->data.base_conversion.value);
	if (index < before) {
		return syntax_base_at(syntax->data.base_conversion.value, index);
	};
	index = index - before;
	BasePath* path := syntax->data.base_conversion.path;
	while (path && index) {
		path := path->next;
		index = index - 1;
	};
	if (!path) {
		return (BaseRelation*)0;
	};
	return path->relation;
};

fn syntax_base_root(Syntax* syntax) -> Syntax* {
	while (syntax->kind == SYNTAX_BASE_REFERENCE) {
		syntax := syntax->data.base_conversion.value;
	};
	return syntax;
};

fn storage_root_entity(Syntax* syntax) -> Entity* {
	while (syntax) {
		if (syntax->kind == SYNTAX_BASE_REFERENCE) {
			syntax := syntax->data.base_conversion.value;
		}
		else if (syntax->kind == SYNTAX_MEMBER && syntax->token.kind != TOKEN_ARROW) {
			syntax := syntax->data.member.object;
		}
		else if (syntax->kind == SYNTAX_INDEX && syntax->data.binary.left->type->kind == TYPE_ARRAY) {
			syntax := syntax->data.binary.left;
		}
		else {
			break;
		};
	};
	if (!syntax || syntax->kind != SYNTAX_NAME) {
		return (Entity*)0;
	};
	return syntax->entity;
};

fn reference_storage_same(Compiler* compiler, Scope* scope, Syntax* first, Syntax* second) -> bool {
	if (!first || !second) {
		return false;
	};
	if (first->kind == SYNTAX_BASE_REFERENCE || second->kind == SYNTAX_BASE_REFERENCE) {
		Syntax* root = syntax_base_root(first);
		Syntax* other = syntax_base_root(second);
		Type* type = type_effective(root->type);
		if (!type || type->kind != TYPE_NAMED || !type_equal(type, type_effective(other->type))) {
			return false;
		};
		CompleteGraph* graph = complete_graph(compiler, type->data.entity);
		Subobject* left := graph->root;
		Subobject* right := graph->root;
		usize index = 0;
		while (index < syntax_base_count(first)) {
			left = subobject_edge(left, syntax_base_at(first, index));
			index = index + 1;
		};
		index = 0;
		while (index < syntax_base_count(second)) {
			right = subobject_edge(right, syntax_base_at(second, index));
			index = index + 1;
		};
		if (left != right) {
			return false;
		};
		return reference_storage_same(compiler, scope, syntax_base_root(first), syntax_base_root(second));
	};
	if (first->kind != second->kind) {
		return false;
	};
	if (first->kind == SYNTAX_NAME) {
		return first->entity == second->entity;
	};
	if (first->kind == SYNTAX_MEMBER) {
		return first->entity == second->entity && reference_storage_same(compiler, scope, first->data.member.object, second->data.member.object);
	};
	if (first->kind == SYNTAX_INDEX) {
		return constant_integer(compiler, scope, first->data.binary.right) == constant_integer(compiler, scope, second->data.binary.right) && reference_storage_same(compiler, scope, first->data.binary.left, second->data.binary.left);
	};
	return false;
};

fn reference_storage_contains(Compiler* compiler, Scope* scope, Syntax* parent, Syntax* storage) -> bool {
	while (storage) {
		if (reference_storage_same(compiler, scope, parent, storage)) {
			return true;
		};
		if (storage->kind == SYNTAX_MEMBER) {
			storage := storage->data.member.object;
		}
		else if (storage->kind == SYNTAX_INDEX) {
			storage := storage->data.binary.left;
		}
		else if (storage->kind == SYNTAX_BASE_REFERENCE) {
			storage := storage->data.base_conversion.value;
		}
		else {
			break;
		};
	};
	return false;
};

fn reference_read_validate(Semantic* semantic, Syntax* storage) {
	if (storage->token.kind == TOKEN_ARROW) {
		return;
	};
	Syntax* object := storage->data.member.object;
	while (object->kind == SYNTAX_MEMBER || object->kind == SYNTAX_INDEX || object->kind == SYNTAX_NAME || object->kind == SYNTAX_BASE_REFERENCE) {
		if (object->kind == SYNTAX_BASE_REFERENCE) {
			object := object->data.base_conversion.value;
			continue;
		};
		Type* type = syntax_storage_type(object);
		if ((type && type->kind == TYPE_REFERENCE) || (object->kind == SYNTAX_MEMBER && object->token.kind == TOKEN_ARROW)) {
			return;
		};
		if (object->kind == SYNTAX_MEMBER) {
			object := object->data.member.object;
		}
		else if (object->kind == SYNTAX_INDEX) {
			object := object->data.binary.left;
		}
		else {
			break;
		};
	};
	Scope* scope := semantic->scope;
	while (scope) {
		if ((scope->context == CONTEXT_INITIALIZATION || scope->context == CONTEXT_ARGUMENTS) && scope->owner && scope->owner->kind == ENTITY_VARIABLE && scope->owner->declaration) {
			Syntax* body := scope->owner->declaration;
			if (body->kind == SYNTAX_DECLARATION) {
				body := body->data.declaration.body;
			};
			Syntax* root := storage;
			while (root->kind == SYNTAX_MEMBER || root->kind == SYNTAX_INDEX || root->kind == SYNTAX_BASE_REFERENCE) {
				if (root->kind == SYNTAX_BASE_REFERENCE) {
					root := root->data.base_conversion.value;
				}
				else if (root->kind == SYNTAX_MEMBER) {
					root := root->data.member.object;
				}
				else {
					root := root->data.binary.left;
				};
			};
			if (root->kind != SYNTAX_NAME || root->entity != scope->owner) {
				return;
			};
			Syntax* statement := body->data.statements;
			while (statement) {
				if (statement->kind == SYNTAX_BIND_REFERENCE && reference_storage_same(semantic->compiler, semantic->scope, statement->data.binary.left, storage)) {
					return;
				};
				if (statement->kind == SYNTAX_INITIALIZE && statement->type && reference_storage_contains(semantic->compiler, semantic->scope, statement->data.binary.left, storage)) {
					return;
				};
				statement := statement->next;
			};
			compiler_error(semantic->compiler, storage->token, "reference field must be bound before use\0");
			return;
		};
		scope := scope->parent;
	};
};

fn semantic_move(Semantic* semantic, Syntax* syntax) {
	if (storage_borrowed(syntax)) {
		compiler_error(semantic->compiler, syntax->token, "cannot move a borrowed value\0");
		return;
	};
	while (syntax->kind == SYNTAX_CAST || syntax->kind == SYNTAX_BASE_POINTER) {
		if (syntax->kind == SYNTAX_BASE_POINTER) {
			syntax := syntax->data.base_conversion.value;
		}
		else {
			syntax := syntax->data.cast.value;
		};
	};
	if (storage_borrowed(syntax)) {
		compiler_error(semantic->compiler, syntax->token, "cannot move a borrowed value\0");
		return;
	};

	if (syntax->kind != SYNTAX_NAME || !syntax->entity || syntax->entity->kind != ENTITY_VARIABLE || syntax->entity->data.variable.storage == STORAGE_CONSTANT) {
		return;
	};

	scope_remove(semantic->compiler, semantic->scope, syntax->entity);
};

fn syntax_base_conversion(Compiler* compiler, Syntax* syntax, Type* target, BasePath* path, BaseDirection direction) {
	Syntax* original = (Syntax*)memory_allocate(compiler, sizeof(Syntax));
	*original := *syntax;
	original->next = (Syntax*)0;
	if (target->kind == TYPE_REFERENCE) {
		syntax->kind = SYNTAX_BASE_REFERENCE;
		syntax->type := target->data.element;
	}
	else {
		syntax->kind = SYNTAX_BASE_POINTER;
		syntax->type := target;
	};
	syntax->entity = (Entity*)0;
	syntax->data.base_conversion.value = original;
	syntax->data.base_conversion.target = target;
	syntax->data.base_conversion.path = path;
	syntax->data.base_conversion.direction = direction;
};

fn semantic_base_conversion(Semantic* semantic, Syntax* syntax, Type* actual, Type* expected) -> bool {
	Type* source := actual;
	Type* target := expected->data.element;
	if (expected->kind == TYPE_POINTER) {
		if (actual->kind != TYPE_POINTER) {
			return false;
		};
		source := actual->data.element;
	}
	else if (syntax_category(syntax) != VALUE_STORAGE) {
		return false;
	};
	BaseSearch result = base_search(semantic->compiler, source, target);
	if (result.count > 1) {
		compiler_error(semantic->compiler, syntax->token, "ambiguous base subobject conversion\0");
		return false;
	};
	if (!result.count) {
		return false;
	};
	syntax_base_conversion(semantic->compiler, syntax, expected, result.path, BASE_UP);
	return true;
};

fn semantic_expect(Semantic* semantic, Syntax* syntax, Type* actual, Type* expected) -> Type* {
	if (expected && actual && !type_equal(actual, expected)) {
		if ((expected->kind == TYPE_BOOL && type_scalar(actual)) || (actual->kind == TYPE_BOOL && type_numeric(expected))) {
			return expected;
		};
		if (expected->kind == TYPE_REFERENCE && type_equal(actual, expected->data.element) && (syntax_category(syntax) == VALUE_STORAGE || actual->kind == TYPE_FUNCTION)) {
			return expected;
		};
		if ((expected->kind == TYPE_REFERENCE || expected->kind == TYPE_POINTER) && semantic_base_conversion(semantic, syntax, actual, expected)) {
			return expected;
		};
		if (actual->kind == TYPE_POINTER && expected->kind == TYPE_POINTER && (actual->data.element->kind == TYPE_VOID || expected->data.element->kind == TYPE_VOID)) {
			return expected;
		};
		compiler_error(semantic->compiler, syntax->token, "expression type does not match its destination\0");
	};
	return actual;
};

fn semantic_base_cast(Semantic* semantic, Syntax* syntax, Syntax* value, Type* source, Type* target) -> bool {
	Type* actual := source;
	if (target->kind == TYPE_POINTER) {
		if (source->kind != TYPE_POINTER) {
			return false;
		};
		actual := source->data.element;
	}
	else if (syntax_category(value) != VALUE_STORAGE) {
		compiler_error(semantic->compiler, syntax->token, "reference cast requires an existing referent\0");
		return false;
	};
	Type* destination := target->data.element;
	BaseSearch up = base_search(semantic->compiler, actual, destination);
	BaseSearch down;
	if (!up.count) {
		down = base_search(semantic->compiler, destination, actual);
	};
	if (up.count > 1 || down.count > 1) {
		compiler_error(semantic->compiler, syntax->token, "ambiguous base subobject cast\0");
		return false;
	};
	if (!up.count && !down.count) {
		return false;
	};
	BaseDirection direction = BASE_UP;
	BasePath* path := up.path;
	if (down.count) {
		if (base_path_virtual(down.path)) {
			compiler_error(semantic->compiler, syntax->token, "downcast through a virtual base is invalid\0");
			return false;
		};
		direction = BASE_DOWN;
		path := down.path;
	};
	syntax->data.base_conversion.value = value;
	syntax->data.base_conversion.target := target;
	syntax->data.base_conversion.path = path;
	syntax->data.base_conversion.direction = direction;
	if (target->kind == TYPE_REFERENCE) {
		syntax->kind = SYNTAX_BASE_REFERENCE;
		syntax->type := target->data.element;
	}
	else {
		syntax->kind = SYNTAX_BASE_POINTER;
		syntax->type = target;
	};
	return true;
};

fn semantic_member_project(Semantic* semantic, Syntax* member, Type* source, Type* target) -> Type* {
	if (type_equal(source, target)) {
		return source;
	};
	Type* expected = (Type*)0;
	if (member->token.kind == TOKEN_ARROW) {
		expected = type_pointer(semantic->compiler, target);
	}
	else {
		expected = type_new(semantic->compiler, TYPE_REFERENCE);
		expected->data.element = target;
	};
	semantic_expect(semantic, member->data.member.object, member->data.member.object->type, expected);
	return expected->data.element;
};

fn semantic_member_object(Semantic* semantic, Syntax* member) -> Type* {
	Type* object = semantic_expression(semantic, member->data.member.object, (Type*)0);
	if (member->token.kind == TOKEN_ARROW) {
		if (object->kind != TYPE_POINTER) {
			compiler_error(semantic->compiler, member->token, "arrow member access requires a pointer\0");
			return semantic->compiler->void_type;
		};
		object := object->data.element;
	};
	if (!member->data.member.qualifier) {
		return object;
	};
	Type* owner = type_resolve(semantic->compiler, semantic->scope, member->data.member.qualifier);
	if (owner->kind != TYPE_NAMED || (owner->data.entity->kind != ENTITY_STRUCT && owner->data.entity->kind != ENTITY_UNION)) {
		compiler_error(semantic->compiler, member->token, "qualified instance access requires a record type\0");
		return semantic->compiler->void_type;
	};
	return semantic_member_project(semantic, member, object, owner);
};

fn method_receiver(Semantic* semantic, Syntax* member) -> Syntax* {
	Syntax* receiver := member->data.member.object;
	Type* type = semantic_expression(semantic, receiver, (Type*)0);
	if (member->token.kind != TOKEN_ARROW) {
		return receiver;
	};
	if (type->kind != TYPE_POINTER) {
		compiler_error(semantic->compiler, member->token, "arrow member access requires a pointer\0");
		return receiver;
	};
	Syntax* object = (Syntax*)memory_allocate(semantic->compiler, sizeof(Syntax));
	object->kind = SYNTAX_UNARY;
	object->token := member->token;
	object->data.unary.operation = TOKEN_STAR;
	object->data.unary.value = receiver;
	object->type = type_effective(type->data.element);
	return object;
};

fn receiver_callable(Semantic* semantic, Type* type, Token name) -> Entity* {
	Entity* associated = (Entity*)0;
	if (type->kind == TYPE_NAMED && (type->data.entity->kind == ENTITY_STRUCT || type->data.entity->kind == ENTITY_UNION)) {
		entity_resolve(semantic->compiler, type->data.entity);
		associated = associated_lookup(semantic->compiler, type->data.entity, name);
	};
	if (associated) {
		return associated;
	};
	Entity* lexical = scope_lookup(semantic->scope, name);
	if (!lexical || lexical->kind != ENTITY_FUNCTION) {
		return (Entity*)0;
	};
	entity_resolve(semantic->compiler, lexical);
	Parameter* first := lexical->data.function.type->data.function.parameters;
	if (!first || !token_is(first->name, "this\0")) {
		return (Entity*)0;
	};
	return lexical;
};

fn semantic_expression(Semantic* semantic, Syntax* syntax, Type* expected) -> Type* {
	Compiler* compiler := semantic->compiler;
	if (!syntax) {
		return compiler->void_type;
	};
	if (syntax->type) {
		return semantic_expect(semantic, syntax, syntax->type, expected);
	};
	Type* type = (Type*)0;
	switch (syntax->kind) {
		case SYNTAX_NAME:
			if (!syntax->entity) {
				syntax->entity = syntax_lookup(semantic->scope, syntax);
			};
			if (!syntax->entity) {
				compiler_error(compiler, syntax->token, "unknown identifier\0");
				return compiler->void_type;
			};
			if (syntax->entity->kind != ENTITY_VARIABLE && syntax->entity->kind != ENTITY_FUNCTION) {
				compiler_error(compiler, syntax->token, "type entity is not a runtime value\0");
				return compiler->void_type;
			};
			entity_resolve(compiler, syntax->entity);
			if (syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage == STORAGE_FIELD) {
				Token name := syntax->token;
				Entity* receiver = scope_lookup(semantic->scope, token_synthetic(compiler, name, "this\0"));
				if (!receiver || receiver->kind != ENTITY_VARIABLE) {
					compiler_error(compiler, name, "field access requires an instance receiver\0");
					return compiler->void_type;
				};
				Syntax* object = (Syntax*)memory_allocate(compiler, sizeof(Syntax));
				object->kind = SYNTAX_NAME;
				object->token := receiver->name;
				object->entity = receiver;
				syntax->kind = SYNTAX_MEMBER;
				syntax->data.member.object = object;
				syntax->data.member.name = name;
				return semantic_expression(semantic, syntax, expected);
			};
			type = type_effective(entity_type(syntax->entity));
			break;
		case SYNTAX_NUMBER:
			if (!expected || !type_numeric(expected)) {
				compiler_error(compiler, syntax->token, "number literal requires a numeric destination type\0");
				return compiler->void_type;
			};
			type := expected;
			if (type_integer(type) && type->kind != TYPE_BOOL) {
				u64 maximum = (u64)18446744073709551615;
				i32 bits = type_bits(type);
				if (bits < 64) {
					maximum = 1;
					i32 bit = 0;
					while (bit < bits) {
						maximum = maximum * 2;
						bit = bit + 1;
					};
					maximum = maximum - 1;
				};
				if (!type_unsigned(type) && type->kind != TYPE_CHAR) {
					maximum = maximum / 2;
				};
				integer_spelling(compiler, syntax->token, maximum);
			};
			break;
		case SYNTAX_STRING:
			type = type_pointer(compiler, compiler->char_type);
			break;
		case SYNTAX_CAST: {
			type = type_resolve(compiler, semantic->scope, syntax->data.cast.type);
			if (type->kind == TYPE_REFERENCE) {
				Syntax* value := syntax->data.cast.value;
				Type* source = semantic_expression(semantic, value, (Type*)0);
				if (semantic_base_cast(semantic, syntax, value, source, type)) {
					type := syntax->type;
				}
				else {
					semantic_expect(semantic, value, source, type);
				};
				break;
			};
			Type* source = (Type*)0;
			if (syntax_number_expression(syntax->data.cast.value)) {
				Type* context := type;
				if (type->kind == TYPE_POINTER) {
					context := compiler->usize_type;
				};
				source = semantic_expression(semantic, syntax->data.cast.value, context);
			}
			else {
				source = semantic_expression(semantic, syntax->data.cast.value, (Type*)0);
			};
			if (type->kind == TYPE_POINTER && source->kind == TYPE_POINTER && semantic_base_cast(semantic, syntax, syntax->data.cast.value, source, type)) {
				break;
			};
			if (!type_scalar(type) || !type_scalar(source)) {
				compiler_error(compiler, syntax->token, "cast requires scalar types\0");
			};
			if (((type->kind == TYPE_POINTER || type->kind == TYPE_REFERENCE) && source->kind == TYPE_FLOAT) || ((source->kind == TYPE_POINTER || source->kind == TYPE_REFERENCE) && type->kind == TYPE_FLOAT)) {
				compiler_error(compiler, syntax->token, "pointer casts require an integer or pointer counterpart\0");
			};
			break;
		};
		case SYNTAX_SIZEOF: {
			Syntax* operand := syntax->data.expression;
			if (operand->kind == SYNTAX_NAME) {
				Entity* entity = syntax_lookup(semantic->scope, operand);
				if (entity && (entity->kind == ENTITY_PRIMITIVE || entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION || entity->kind == ENTITY_ENUM)) {
					operand->type = type_resolve(compiler, semantic->scope, operand);
				}
				else {
					semantic_expression(semantic, operand, (Type*)0);
				};
			}
			else if (operand->kind == SYNTAX_POINTER || operand->kind == SYNTAX_REFERENCE || operand->kind == SYNTAX_ARRAY || operand->kind == SYNTAX_SIGNATURE) {
				operand->type = type_resolve(compiler, semantic->scope, operand);
			}
			else {
				semantic_expression(semantic, operand, (Type*)0);
			};
			operand->type = type_effective(operand->type);
			if (!operand->type || operand->type->kind == TYPE_VOID || operand->type->kind == TYPE_FUNCTION) {
				compiler_error(compiler, syntax->token, "sizeof requires a storage type\0");
			};
			layout_validate(compiler, operand->type, (LayoutVisit*)0, syntax->token);
			type := compiler->usize_type;
			break;
		};
		case SYNTAX_MEMBER: {
			Type* object = semantic_member_object(semantic, syntax);
			if (object->kind != TYPE_NAMED || (object->data.entity->kind != ENTITY_STRUCT && object->data.entity->kind != ENTITY_UNION)) {
				compiler_error(compiler, syntax->token, "member access requires a record\0");
				return compiler->void_type;
			};
			entity_resolve(compiler, object->data.entity);
			layout_validate(compiler, object, (LayoutVisit*)0, syntax->token);
			if (compiler->result == COMPILATION_FAILURE) {
				return compiler->void_type;
			};
			syntax->entity = associated_lookup(compiler, object->data.entity, syntax->data.member.name);
			if (!syntax->entity) {
				compiler_error(compiler, syntax->data.member.name, "unknown record field\0");
				return compiler->void_type;
			};
			if (syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage == STORAGE_FIELD) {
				semantic_member_project(semantic, syntax, object, entity_type(syntax->entity->data.variable.data.field.owner));
			};
			if (syntax->entity->kind != ENTITY_VARIABLE || syntax->entity->data.variable.storage != STORAGE_FIELD) {
				compiler_error(compiler, syntax->token, "associated declaration is not instance field storage\0");
				return compiler->void_type;
			};
			if (entity_type(syntax->entity)->kind == TYPE_REFERENCE) {
				reference_read_validate(semantic, syntax);
			};
			type = type_effective(entity_type(syntax->entity));
			break;
		};
		case SYNTAX_INDEX: {
			Type* object = semantic_expression(semantic, syntax->data.binary.left, (Type*)0);
			Type* index_context = (Type*)0;
			if (syntax_number_expression(syntax->data.binary.right)) {
				index_context := compiler->usize_type;
			};
			Type* index = semantic_expression(semantic, syntax->data.binary.right, index_context);
			if (!type_integer(index)) {
				compiler_error(compiler, syntax->token, "index requires an integer\0");
			};
			if (object->kind == TYPE_ARRAY) {
				type := object->data.array.element;
			}
			else if (object->kind == TYPE_POINTER) {
				type := object->data.element;
			}
			else {
				compiler_error(compiler, syntax->token, "index requires an array or pointer\0");
				type := compiler->void_type;
			};
			layout_validate(compiler, type, (LayoutVisit*)0, syntax->token);
			break;
		};
		case SYNTAX_UNARY: {
			TokenKind operation := syntax->data.unary.operation;
			Type* context := expected;
			if (context && context->kind == TYPE_BOOL && !syntax_number_expression(syntax->data.unary.value) && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				context = type_new(compiler, TYPE_FLOAT);
				context->data.bits = 64;
			};
			if (operation == TOKEN_AMPERSAND || operation == TOKEN_STAR) {
				context = (Type*)0;
			};
			if (operation == TOKEN_BANG) {
				context := compiler->bool_type;
			};
			Type* operand = (Type*)0;
			if (operation == TOKEN_MINUS && syntax->data.unary.value->kind == SYNTAX_NUMBER && context && context->kind == TYPE_SIGNED) {
				Type* magnitude = type_new(compiler, TYPE_UNSIGNED);
				magnitude->data.bits := context->data.bits;
				semantic_expression(semantic, syntax->data.unary.value, magnitude);

				u64 maximum = 1;
				i32 bit = 1;
				while (bit < context->data.bits) {
					maximum = maximum * 2;
					bit = bit + 1;
				};
				integer_spelling(compiler, syntax->data.unary.value->token, maximum);
				syntax->data.unary.value->type := context;
				operand = context;
			}
			else {
				operand = semantic_expression(semantic, syntax->data.unary.value, context);
			};
			if (operation == TOKEN_AMPERSAND) {
				if (syntax_category(syntax->data.unary.value) != VALUE_STORAGE && operand->kind != TYPE_FUNCTION) {
					compiler_error(compiler, syntax->token, "address-of requires storage or a function entity\0");
				};
				type = type_pointer(compiler, operand);
			}
			else if (operation == TOKEN_STAR) {
				if (operand->kind != TYPE_POINTER) {
					compiler_error(compiler, syntax->token, "dereference requires a pointer\0");
					type := compiler->void_type;
				}
				else {
					type := operand->data.element;
					if (type->kind != TYPE_FUNCTION) {
						layout_validate(compiler, type, (LayoutVisit*)0, syntax->token);
					};
				};
			}
			else if (operation == TOKEN_BANG) {
				if (!type_scalar(operand)) {
					compiler_error(compiler, syntax->token, "logical negation requires a scalar\0");
				};
				type := compiler->bool_type;
			}
			else {
				if (!type_numeric(operand) || (operation == TOKEN_TILDE && !type_integer(operand))) {
					compiler_error(compiler, syntax->token, "unary operation requires a numeric operand\0");
				};
				type = operand;
				if (type->kind == TYPE_BOOL && !syntax_number_expression(syntax->data.unary.value)) {
					type := compiler->i32_type;
				};
			};
			break;
		};
		case SYNTAX_INITIALIZE:
		case SYNTAX_BINARY: {
			TokenKind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == TOKEN_ASSIGN || operation == TOKEN_COPY) {
				if (syntax->kind == SYNTAX_INITIALIZE && left->entity && entity_type(left->entity) && entity_type(left->entity)->kind == TYPE_REFERENCE) {
					Type* reference := entity_type(left->entity);
					if (left->kind == SYNTAX_MEMBER) {
						Type* object = semantic_member_object(semantic, left);
						semantic_member_project(semantic, left, object, entity_type(left->entity->data.variable.data.field.owner));
					};
					semantic_expression(semantic, right, reference);
					if (left->entity->data.variable.storage != STORAGE_FIELD) {
						scope_define(compiler, semantic->scope, left->entity);
					};
					left->type := reference->data.element;
					syntax->kind = SYNTAX_BIND_REFERENCE;
					type := reference->data.element;
					break;
				};

				Type* destination = semantic_expression(semantic, left, (Type*)0);
				Type* source_type = (Type*)0;
				if (left->entity && left->entity->kind == ENTITY_VARIABLE && !left->entity->data.variable.type) {
					source_type = semantic_expression(semantic, right, (Type*)0);
					destination := source_type;
					left->entity->data.variable.type := destination;
					left->type := destination;
				};
				if (syntax_category(left) != VALUE_STORAGE) {
					compiler_error(compiler, left->token, "assignment requires writable storage\0");
				};
				if (!source_type) {
					source_type = semantic_expression(semantic, right, destination);
				};
				semantic_expect(semantic, right, source_type, destination);
				if (left->entity && left->entity->kind == ENTITY_VARIABLE && left->entity->data.variable.storage == STORAGE_FIELD && left->entity->data.variable.data.field.owner->kind == ENTITY_UNION && !type_has_reference(destination)) {
					Scope* context := semantic->scope;
					while (context && context->context != CONTEXT_INITIALIZATION && context->context != CONTEXT_ARGUMENTS) {
						context := context->parent;
					};
					if (context && context->owner == storage_root_entity(left) && entity_type(context->owner)->kind != TYPE_REFERENCE) {
						syntax->kind = SYNTAX_INITIALIZE;
					};
				};
				if (syntax->kind != SYNTAX_INITIALIZE && type_has_reference(destination)) {
					compiler_error(compiler, syntax->token, "assignment cannot replace an object containing reference fields\0");
				};
				if (operation == TOKEN_ASSIGN) {
					semantic_move(semantic, right);
				};
				type = destination;
				break;
			};
			if (operation == TOKEN_AND || operation == TOKEN_OR) {
				Type* a = semantic_expression(semantic, left, compiler->bool_type);
				Type* b = semantic_expression(semantic, right, compiler->bool_type);
				if (!type_scalar(a) || !type_scalar(b)) {
					compiler_error(compiler, syntax->token, "logical operation requires scalars\0");
				};
				type := compiler->bool_type;
				break;
			};

			Type* operand := expected;
			if (operand && operand->kind == TYPE_BOOL && syntax_number_expression(left) && syntax_number_expression(right)) {
				operand = type_new(compiler, TYPE_FLOAT);
				operand->data.bits = 64;
			};
			Type* a = (Type*)0;
			Type* b = (Type*)0;
			if (!syntax_number_expression(left)) {
				a = semantic_expression(semantic, left, (Type*)0);
				operand := a;
			}
			else if (!syntax_number_expression(right)) {
				b = semantic_expression(semantic, right, (Type*)0);
				operand := b;
			};
			if (!a) {
				a = semantic_expression(semantic, left, operand);
			};

			Type* right_context := operand;
			if (a->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				right_context = (Type*)0;
				if (syntax_number_expression(right)) {
					right_context := compiler->usize_type;
				};
			};
			if (!b) {
				b = semantic_expression(semantic, right, right_context);
			};
			if (a->kind == TYPE_POINTER && b->kind == TYPE_POINTER && (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) && !type_equal(a, b)) {
				BaseSearch forward = base_search(compiler, b->data.element, a->data.element);
				BaseSearch reverse = base_search(compiler, a->data.element, b->data.element);
				if (forward.count == 1) {
					semantic_expect(semantic, right, b, a);
					b := a;
				}
				else if (reverse.count == 1) {
					semantic_expect(semantic, left, a, b);
					a := b;
					right_context := b;
				};
			};
			semantic_expect(semantic, right, b, right_context);
			if (a->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				layout_validate(compiler, a->data.element, (LayoutVisit*)0, syntax->token);
				if (!type_integer(b)) {
					compiler_error(compiler, right->token, "pointer offset requires an integer\0");
				};
				type := a;
				break;
			};
			if (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) {
				if (!type_scalar(a) || !type_scalar(b)) {
					compiler_error(compiler, syntax->token, "comparison requires scalar operands\0");
				};
				type := compiler->bool_type;
			}
			else {
				if (!type_numeric(a) || !type_equal(a, b)) {
					compiler_error(compiler, syntax->token, "arithmetic requires matching numeric operands\0");
				};
				if ((operation == TOKEN_REMAINDER || operation == TOKEN_AMPERSAND || operation == TOKEN_PIPE || operation == TOKEN_CARET || operation == TOKEN_SHIFT_LEFT || operation == TOKEN_SHIFT_RIGHT) && !type_integer(a)) {
					compiler_error(compiler, syntax->token, "operation requires integer operands\0");
				};
				type = a;
				if (type->kind == TYPE_BOOL) {
					type := compiler->i32_type;
				};
			};
			break;
		};
		case SYNTAX_CALL: {
			Syntax* callable_syntax := syntax->data.call.callable;
			if (callable_syntax->kind == SYNTAX_MEMBER) {
				Syntax* receiver = method_receiver(semantic, callable_syntax);
				Type* owner := receiver->type;
				if (callable_syntax->data.member.qualifier) {
					owner = type_resolve(compiler, semantic->scope, callable_syntax->data.member.qualifier);
					BaseSearch path = base_search(compiler, receiver->type, owner);
					if (!path.count) {
						compiler_error(compiler, callable_syntax->token, "qualified callable owner is not a base of its receiver\0");
						return compiler->void_type;
					};
					syntax->data.call.qualified_owner := owner->data.entity;
				};
				Entity* function = receiver_callable(semantic, owner, callable_syntax->data.member.name);
				if (function && function->kind == ENTITY_FUNCTION) {
					entity_resolve(compiler, function);
					Parameter* first := function->data.function.type->data.function.parameters;
					syntax->data.call.receiver.value := receiver;
					if (first && token_is(first->name, "this\0")) {
						if (callable_syntax->data.member.qualifier && !type_equal(receiver->type, owner)) {
							Type* reference = type_new(compiler, TYPE_REFERENCE);
							reference->data.element = owner;
							semantic_expect(semantic, receiver, receiver->type, reference);
						};
						semantic_expect(semantic, receiver, receiver->type, first->type);
						syntax->data.call.receiver.kind = RECEIVER_BIND;
					}
					else {
						syntax->data.call.receiver.kind = RECEIVER_EVALUATE;
					};
					Syntax* direct = (Syntax*)memory_allocate(compiler, sizeof(Syntax));
					direct->kind = SYNTAX_NAME;
					direct->token := callable_syntax->data.member.name;
					direct->entity = function;
					syntax->data.call.callable = direct;
				};
			};
			Type* callable = semantic_expression(semantic, syntax->data.call.callable, (Type*)0);
			if (callable->kind == TYPE_POINTER) {
				callable := callable->data.element;
			};
			if (callable->kind != TYPE_FUNCTION) {
				compiler_error(compiler, syntax->token, "call requires a function entity or function pointer\0");
				return compiler->void_type;
			};
			Parameter* parameter := callable->data.function.parameters;
			Syntax* direct := syntax->data.call.callable;
			if (syntax->data.call.receiver.kind == RECEIVER_NONE && direct->kind == SYNTAX_NAME && !direct->data.expression && direct->entity && direct->entity->scope && direct->entity->scope->owner && (direct->entity->scope->owner->kind == ENTITY_STRUCT || direct->entity->scope->owner->kind == ENTITY_UNION) && parameter && token_is(parameter->name, "this\0")) {
				Entity* current = scope_lookup(semantic->scope, token_synthetic(compiler, direct->token, "this\0"));
				if (current) {
					Syntax* receiver = (Syntax*)memory_allocate(compiler, sizeof(Syntax));
					receiver->kind = SYNTAX_NAME;
					receiver->token := current->name;
					receiver->entity = current;
					semantic_expression(semantic, receiver, parameter->type);
					syntax->data.call.receiver.value = receiver;
					syntax->data.call.receiver.kind = RECEIVER_BIND;
				};
			};
			if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
				parameter := parameter->next;
			};
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (!parameter && callable->data.function.arity != PARAMETERS_VARIADIC) {
					compiler_error(compiler, argument->token, "too many arguments\0");
					break;
				};
				Type* destination = (Type*)0;
				if (parameter) {
					destination := parameter->type;
				};
				if (argument->kind == SYNTAX_BLOCK) {
					if (!parameter || !parameter->name.source) {
						compiler_error(compiler, argument->token, "argument block requires a named parameter\0");
					}
					else {
						argument->scope->context = CONTEXT_ARGUMENTS;
						Entity* storage = entity_create(compiler, ENTITY_VARIABLE, parameter->name);
						storage->resolution = RESOLUTION_READY;
						storage->data.variable.type := destination;
						storage->data.variable.storage = STORAGE_ARGUMENT;
						storage->declaration := argument;
						argument->scope->owner := storage;
						if (destination->kind == TYPE_REFERENCE) {
							reference_initializer(compiler, argument, storage, argument->token);
						}
						else {
							scope_define(compiler, argument->scope, storage);
							object_initializer_prepare(compiler, semantic->scope, storage, argument, argument->token);
						};
						argument->entity = storage;
						semantic_statement(semantic, argument);
						argument->type = destination;
					};
				}
				else {
					Type* actual = semantic_expression(semantic, argument, destination);
					if (!parameter && type_aggregate(actual)) {
						compiler_error(compiler, argument->token, "aggregate C variadic arguments require ABI lowering that is not supported yet\0");
					};
				};
				if (parameter) {
					parameter := parameter->next;
				};
				argument := argument->next;
			};
			if (parameter) {
				compiler_error(compiler, syntax->token, "too few arguments\0");
			};
			type = type_effective(callable->data.function.result);
			break;
		};
		case SYNTAX_BLOCK:
			semantic_statement(semantic, syntax);
			type := compiler->void_type;
			break;
		default:
			compiler_error(compiler, syntax->token, "expected value expression\0");
			type := compiler->void_type;
			break;
	};
	type = type_effective(type);
	syntax->type := type;
	return semantic_expect(semantic, syntax, type, expected);
};

fn llvm_body(Compiler* compiler, Entity* entity) -> void* {
	if (entity->data.aggregate.llvm_body) {
		return entity->data.aggregate.llvm_body;
	};
	entity_resolve(compiler, entity);
	void* record = LLVMStructCreateNamed(compiler->llvm_context, "rt.body\0");
	entity->data.aggregate.llvm_body := record;
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		return record;
	};
	usize count := entity->data.aggregate.field_count;
	if (entity->data.aggregate.virtual_types) {
		count = count + 1;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			count = count + 1;
		};
		base := base->next;
	};
	void** fields = (void**)memory_allocate(compiler, (count + 2) * sizeof(void*));
	usize index = 0;
	if (entity->data.aggregate.virtual_types) {
		fields[index] = LLVMPointerTypeInContext(compiler->llvm_context, 0);
		index = index + 1;
	};
	base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			fields[index] = llvm_body(compiler, base->entity);
			index = index + 1;
		};
		base := base->next;
	};
	Field* binding := entity->data.aggregate.fields;
	u64 maximum_size = 0;
	u32 maximum_alignment = 0;
	void* aligned = (void*)0;
	while (binding) {
		void* field = llvm_type(compiler, entity_type(binding->entity));
		fields[index] := field;
		index = index + 1;
		if (entity->kind == ENTITY_UNION) {
			u64 size = LLVMABISizeOfType(compiler->llvm_layout, field);
			u32 alignment = LLVMABIAlignmentOfType(compiler->llvm_layout, field);
			if (size > maximum_size) {
				maximum_size = size;
			};
			if (alignment > maximum_alignment) {
				maximum_alignment = alignment;
				aligned = field;
			};
		};
		binding := binding->next;
	};
	if (entity->kind == ENTITY_UNION && aligned) {
		u64 size = LLVMABISizeOfType(compiler->llvm_layout, aligned);
		fields[0] = aligned;
		index = 1;
		if (maximum_size > size) {
			fields[1] = LLVMArrayType2(LLVMIntTypeInContext(compiler->llvm_context, 8), maximum_size - size);
			index = 2;
		};
	};
	if (!index) {
		fields[0] = LLVMIntTypeInContext(compiler->llvm_context, 8);
		index = 1;
	};
	LLVMStructSetBody(record, fields, (u32)index, 0);
	return record;
};

fn llvm_type(Compiler* compiler, Type* type) -> void* {
	if (!type) {
		return LLVMVoidTypeInContext(compiler->llvm_context);
	};
	switch (type->kind) {
		case TYPE_VOID:
			return LLVMVoidTypeInContext(compiler->llvm_context);
		case TYPE_CHAR:
			return LLVMIntTypeInContext(compiler->llvm_context, 8);
		case TYPE_BOOL:
			return LLVMIntTypeInContext(compiler->llvm_context, 1);
		case TYPE_SIGNED:
		case TYPE_UNSIGNED:
			return LLVMIntTypeInContext(compiler->llvm_context, (u32)type->data.bits);
		case TYPE_FLOAT:
			if (type->data.bits == 32) {
				return LLVMFloatTypeInContext(compiler->llvm_context);
			};
			return LLVMDoubleTypeInContext(compiler->llvm_context);
		case TYPE_POINTER:
		case TYPE_REFERENCE:
			return LLVMPointerTypeInContext(compiler->llvm_context, 0);
		case TYPE_ARRAY:
			return LLVMArrayType2(llvm_type(compiler, type->data.array.element), type->data.array.count);
		case TYPE_FUNCTION: {
			u32 count = 0;
			Parameter* parameter := type->data.function.parameters;
			while (parameter) {
				count = count + 1;
				parameter := parameter->next;
			};
			void** parameters = (void**)memory_allocate(compiler, (usize)count * sizeof(void*));
			parameter := type->data.function.parameters;
			u32 index = 0;
			while (parameter) {
				parameters[index] = llvm_type(compiler, parameter->type);
				index = index + 1;
				parameter := parameter->next;
			};
			return LLVMFunctionType(llvm_type(compiler, type->data.function.result), parameters, count, type->data.function.arity == PARAMETERS_VARIADIC);
		};
		case TYPE_NAMED: {
			Entity* entity := type->data.entity;
			if (entity->kind == ENTITY_ENUM) {
				return LLVMIntTypeInContext(compiler->llvm_context, 32);
			};
			if (entity->data.aggregate.llvm_type) {
				return entity->data.aggregate.llvm_type;
			};
			void* body = llvm_body(compiler, entity);
			if (!entity->data.aggregate.virtual_types) {
				entity->data.aggregate.llvm_type := body;
				return body;
			};
			void* record = LLVMStructCreateNamed(compiler->llvm_context, entity_name(compiler, entity));
			entity->data.aggregate.llvm_type := record;
			CompleteGraph* graph = complete_graph(compiler, entity);
			usize count = 1;
			Subobject* object := graph->virtuals;
			while (object) {
				count = count + 1;
				object := object->virtual_next;
			};
			void** components = (void**)memory_allocate(compiler, count * sizeof(void*));
			components[0] = body;
			object := graph->virtuals;
			while (object) {
				components[object->component] = llvm_body(compiler, object->entity);
				object := object->virtual_next;
			};
			LLVMStructSetBody(record, components, (u32)count, 0);
			return record;
		};
	};
	return LLVMVoidTypeInContext(compiler->llvm_context);
};

fn emit_slot(Compiler* compiler, Type* type) -> void* {
	void* block = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock(compiler->llvm_builder)));
	void* builder = LLVMCreateBuilderInContext(compiler->llvm_context);
	void* first = LLVMGetFirstInstruction(block);
	if (first) {
		LLVMPositionBuilderBefore(builder, first);
	}
	else {
		LLVMPositionBuilderAtEnd(builder, block);
	};
	void* slot = LLVMBuildAlloca(builder, llvm_type(compiler, type), "storage\0");
	LLVMDisposeBuilder(builder);
	return slot;
};

fn emit_expression(Emitter* emitter, Syntax* syntax) -> void*;
fn emit_statement(Emitter* emitter, Syntax* syntax);
fn emit_cast(Emitter* emitter, void* value, Type* source, Type* target) -> void*;

fn emit_call(Emitter* emitter, Syntax* syntax) -> void*;

fn emit_address(Emitter* emitter, Syntax* syntax) -> void*;

fn subobject_offsets(Compiler* compiler, Subobject* object, u64 offset) {
	object->offset := offset;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		if (edge->relation->kind == BASE_NONVIRTUAL) {
			u64 child = offset + LLVMOffsetOfElement(compiler->llvm_layout, llvm_body(compiler, object->entity), (u32)edge->relation->component);
			subobject_offsets(compiler, edge->target, child);
		};
		edge := edge->next;
	};
};

fn complete_offsets(Compiler* compiler, CompleteGraph* graph) {
	void* type = llvm_type(compiler, entity_type(graph->entity));
	subobject_offsets(compiler, graph->root, 0);
	Subobject* object := graph->virtuals;
	while (object) {
		u64 offset = LLVMOffsetOfElement(compiler->llvm_layout, type, (u32)object->component);
		subobject_offsets(compiler, object, offset);
		object := object->virtual_next;
	};
};

fn runtime_view_request(Compiler* compiler, CompleteGraph* graph, Subobject* object) -> void* {
	if (object->view) {
		return object->view;
	};
	usize count = 0;
	VirtualType* target := object->entity->data.aggregate.virtual_types;
	while (target) {
		count = count + 1;
		target := target->next;
	};
	void* type = LLVMArrayType2(llvm_type(compiler, compiler->usize_type), (u64)count);
	void* view = LLVMAddGlobal(compiler->llvm_module, type, "rt.view\0");
	LLVMSetLinkage(view, 9);
	LLVMSetGlobalConstant(view, 1);
	object->view := view;
	RuntimeView* request = (RuntimeView*)memory_allocate(compiler, sizeof(RuntimeView));
	request->graph = graph;
	request->object = object;
	request->next := compiler->runtime_views;
	compiler->runtime_views = request;
	return view;
};

fn runtime_views_emit(Compiler* compiler) {
	RuntimeView* view := compiler->runtime_views;
	while (view) {
		complete_offsets(compiler, view->graph);
		VirtualType* target := view->object->entity->data.aggregate.virtual_types;
		usize count = 0;
		while (target) {
			count = count + 1;
			target := target->next;
		};
		void** values = (void**)memory_allocate(compiler, count * sizeof(void*));
		target := view->object->entity->data.aggregate.virtual_types;
		while (target) {
			Subobject* storage := view->graph->virtuals;
			while (storage && storage->entity != target->entity) {
				storage := storage->virtual_next;
			};
			values[target->index] = LLVMConstInt(llvm_type(compiler, compiler->usize_type), storage->offset - view->object->offset, 0);
			target := target->next;
		};
		LLVMSetInitializer(view->object->view, LLVMConstArray2(llvm_type(compiler, compiler->usize_type), values, (u64)count));
		view := view->next;
	};
};

fn emit_byte_offset(Emitter* emitter, void* address, u64 offset) -> void* {
	Compiler* compiler := emitter->compiler;
	void* index = LLVMConstInt(llvm_type(compiler, compiler->usize_type), offset, 0);
	return LLVMBuildGEP2(compiler->llvm_builder, LLVMIntTypeInContext(compiler->llvm_context, 8), address, &index, 1, "subobject\0");
};

fn emit_base_address(Emitter* emitter, void* address, Entity* derived, BasePath* path, BaseDirection direction) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder;
	u64 offset = 0;
	while (path) {
		BaseRelation* relation := path->relation;
		if (direction == BASE_UP && relation->kind == BASE_VIRTUAL) {
			void* header = LLVMBuildStructGEP2(builder, llvm_body(compiler, derived), address, 0, "view.storage\0");
			void* view = LLVMBuildLoad2(builder, LLVMPointerTypeInContext(compiler->llvm_context, 0), header, "view\0");
			void* index = LLVMConstInt(llvm_type(compiler, compiler->usize_type), (u64)relation->component, 0);
			void* slot = LLVMBuildGEP2(builder, llvm_type(compiler, compiler->usize_type), view, &index, 1, "virtual.offset.storage\0");
			void* displacement = LLVMBuildLoad2(builder, llvm_type(compiler, compiler->usize_type), slot, "virtual.offset\0");
			address = LLVMBuildGEP2(builder, LLVMIntTypeInContext(compiler->llvm_context, 8), address, &displacement, 1, "virtual.base\0");
		}
		else if (direction == BASE_UP) {
			address = LLVMBuildStructGEP2(builder, llvm_body(compiler, derived), address, (u32)relation->component, "base\0");
		}
		else {
			offset = offset + LLVMOffsetOfElement(compiler->llvm_layout, llvm_body(compiler, derived), (u32)relation->component);
		};
		derived := relation->entity;
		path := path->next;
	};
	if (direction == BASE_DOWN && offset) {
		void* integer = LLVMBuildPtrToInt(builder, address, llvm_type(compiler, compiler->usize_type), "base.address\0");
		integer = LLVMBuildSub(builder, integer, LLVMConstInt(llvm_type(compiler, compiler->usize_type), offset, 0), "derived.address\0");
		address = LLVMBuildIntToPtr(builder, integer, LLVMPointerTypeInContext(compiler->llvm_context, 0), "derived\0");
	};
	return address;
};

fn emit_base_conversion(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	Syntax* value := syntax->data.base_conversion.value;
	Type* source := value->type;
	void* address = (void*)0;
	if (syntax->kind == SYNTAX_BASE_POINTER) {
		address = emit_expression(emitter, value);
		source := source->data.element;
	}
	else {
		address = emit_address(emitter, value);
	};
	Entity* derived := source->data.entity;
	if (syntax->data.base_conversion.direction == BASE_DOWN) {
		derived := syntax->data.base_conversion.target->data.element->data.entity;
	};
	if (syntax->kind == SYNTAX_BASE_POINTER && base_path_virtual(syntax->data.base_conversion.path)) {
		void* initial = LLVMGetInsertBlock(compiler->llvm_builder);
		void* function = LLVMGetBasicBlockParent(initial);
		void* live = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "base.nonnull\0");
		void* merge = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "base.end\0");
		void* null = LLVMConstNull(LLVMTypeOf(address));
		void* empty = LLVMBuildICmp(compiler->llvm_builder, 32, address, null, "base.null\0");
		LLVMBuildCondBr(compiler->llvm_builder, empty, merge, live);
		LLVMPositionBuilderAtEnd(compiler->llvm_builder, live);
		void* converted = emit_base_address(emitter, address, derived, syntax->data.base_conversion.path, syntax->data.base_conversion.direction);
		live = LLVMGetInsertBlock(compiler->llvm_builder);
		LLVMBuildBr(compiler->llvm_builder, merge);
		LLVMPositionBuilderAtEnd(compiler->llvm_builder, merge);
		void* result = LLVMBuildPhi(compiler->llvm_builder, LLVMTypeOf(address), "base.pointer\0");
		void*[2] values {};
		void*[2] blocks {};
		values[0] = null;
		values[1] = converted;
		blocks[0] = initial;
		blocks[1] = live;
		LLVMAddIncoming(result, &values[0], &blocks[0], 2);
		return result;
	};
	void* result = emit_base_address(emitter, address, derived, syntax->data.base_conversion.path, syntax->data.base_conversion.direction);
	if (syntax->kind == SYNTAX_BASE_POINTER) {
		void* null = LLVMConstNull(LLVMTypeOf(address));
		void* empty = LLVMBuildICmp(compiler->llvm_builder, 32, address, null, "base.null\0");
		return LLVMBuildSelect(compiler->llvm_builder, empty, null, result, "base.pointer\0");
	};
	return result;
};

fn emit_storage_address(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder;
	switch (syntax->kind) {
		case SYNTAX_BASE_REFERENCE:
			return emit_base_conversion(emitter, syntax);
		case SYNTAX_NAME:
			if (syntax->entity->kind == ENTITY_FUNCTION) {
				return syntax->entity->data.function.llvm_value;
			};
			return syntax->entity->data.variable.data.address;
		case SYNTAX_CAST:
			return emit_address(emitter, syntax->data.cast.value);
		case SYNTAX_CALL:
			return emit_call(emitter, syntax);
		case SYNTAX_UNARY:
			return emit_expression(emitter, syntax->data.unary.value);
		case SYNTAX_MEMBER: {
			Syntax* object := syntax->data.member.object;
			Type* type := object->type;
			void* address = (void*)0;
			if (syntax->token.kind == TOKEN_ARROW) {
				address = emit_expression(emitter, object);
				type := type->data.element;
			}
			else if (syntax_category(object) == VALUE_STORAGE) {
				address = emit_address(emitter, object);
			}
			else {
				address = emit_slot(compiler, type);
				LLVMBuildStore(builder, emit_expression(emitter, object), address);
			};
			Entity* owner := syntax->entity->data.variable.data.field.owner;
			if (type->data.entity != owner) {
				BaseSearch path = base_search(compiler, type, entity_type(owner));
				address = emit_base_address(emitter, address, type->data.entity, path.path, BASE_UP);
				type = entity_type(owner);
			};
			if (type->data.entity->kind == ENTITY_UNION) {
				return address;
			};
			void* field = LLVMBuildStructGEP2(builder, llvm_body(compiler, type->data.entity), address, (u32)syntax->entity->data.variable.data.field.index, "field\0");
			return field;
		};
		case SYNTAX_INDEX: {
			Syntax* object := syntax->data.binary.left;
			void* index = emit_expression(emitter, syntax->data.binary.right);
			index = emit_cast(emitter, index, syntax->data.binary.right->type, compiler->usize_type);
			void*[2] indices {};
			if (object->type->kind == TYPE_ARRAY) {
				indices[0] = LLVMConstInt(llvm_type(compiler, compiler->usize_type), 0, 0);
				indices[1] := index;
				return LLVMBuildGEP2(builder, llvm_type(compiler, object->type), emit_address(emitter, object), &indices[0], 2, "element\0");
			};
			indices[0] = index;
			return LLVMBuildGEP2(builder, llvm_type(compiler, object->type->data.element), emit_expression(emitter, object), &indices[0], 1, "element\0");
		};
	};
	compiler_error(compiler, syntax->token, "expression has no storage address\0");
	return (void*)0;
};

fn type_has_views(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_has_views(type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (entity->data.aggregate.virtual_types) {
		return true;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_has_views(entity_type(base->entity))) {
			return true;
		};
		base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_has_views(entity_type(field->entity))) {
			return true;
		};
		field := field->next;
	};
	return false;
};

fn type_requires_union_choice(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_requires_union_choice(type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (entity->kind == ENTITY_UNION) {
		return type_has_views(type) || type_has_reference(type);
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_requires_union_choice(entity_type(base->entity))) {
			return true;
		};
		base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_requires_union_choice(entity_type(field->entity))) {
			return true;
		};
		field := field->next;
	};
	return false;
};

fn emit_initialize_type(Emitter* emitter, Type* type, void* address);
fn emit_payload_copy(Emitter* emitter, Type* type, void* destination, void* source);

fn emit_array_element(Emitter* emitter, Type* type, void* address, usize index) -> void* {
	Compiler* compiler := emitter->compiler;
	void*[2] indices {};
	indices[0] = LLVMConstInt(llvm_type(compiler, compiler->usize_type), 0, 0);
	indices[1] = LLVMConstInt(llvm_type(compiler, compiler->usize_type), (u64)index, 0);
	return LLVMBuildGEP2(compiler->llvm_builder, llvm_type(compiler, type), address, &indices[0], 2, "array.element\0");
};

fn emit_initialize_body_fields(Emitter* emitter, Entity* entity, void* address) {
	if (entity->kind == ENTITY_UNION) {
		return;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		Type* type = entity_type(field->entity);
		if (type_has_views(type)) {
			void* storage = LLVMBuildStructGEP2(emitter->compiler->llvm_builder, llvm_body(emitter->compiler, entity), address, (u32)field->entity->data.variable.data.field.index, "member.object\0");
			emit_initialize_type(emitter, type, storage);
		};
		field := field->next;
	};
};

fn emit_initialize_type(Emitter* emitter, Type* type, void* address) {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views(type)) {
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_initialize_type(emitter, type->data.array.element, emit_array_element(emitter, type, address, index));
			index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;
	if (entity->kind == ENTITY_UNION) {
		return;
	};
	CompleteGraph* graph = complete_graph(compiler, entity);
	complete_offsets(compiler, graph);
	Subobject* object := graph->objects;
	while (object) {
		void* storage = emit_byte_offset(emitter, address, object->offset);
		if (object->entity->data.aggregate.virtual_types) {
			void* header = LLVMBuildStructGEP2(compiler->llvm_builder, llvm_body(compiler, object->entity), storage, 0, "view.storage\0");
			LLVMBuildStore(compiler->llvm_builder, runtime_view_request(compiler, graph, object), header);
		};
		emit_initialize_body_fields(emitter, object->entity, storage);
		object := object->next;
	};
};

fn emit_body_payload_copy(Emitter* emitter, Entity* entity, void* destination, void* source) {
	Compiler* compiler := emitter->compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			void* target = LLVMBuildStructGEP2(compiler->llvm_builder, llvm_body(compiler, entity), destination, (u32)base->component, "copy.base.destination\0");
			void* origin = LLVMBuildStructGEP2(compiler->llvm_builder, llvm_body(compiler, entity), source, (u32)base->component, "copy.base.source\0");
			emit_body_payload_copy(emitter, base->entity, target, origin);
		};
		base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		void* target = LLVMBuildStructGEP2(compiler->llvm_builder, llvm_body(compiler, entity), destination, (u32)field->entity->data.variable.data.field.index, "copy.field.destination\0");
		void* origin = LLVMBuildStructGEP2(compiler->llvm_builder, llvm_body(compiler, entity), source, (u32)field->entity->data.variable.data.field.index, "copy.field.source\0");
		emit_payload_copy(emitter, entity_type(field->entity), target, origin);
		field := field->next;
	};
};

fn emit_payload_copy(Emitter* emitter, Type* type, void* destination, void* source) {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views(type) || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_UNION)) {
		void* value = LLVMBuildLoad2(compiler->llvm_builder, llvm_type(compiler, type), source, "copy.value\0");
		LLVMBuildStore(compiler->llvm_builder, value, destination);
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_payload_copy(emitter, type->data.array.element, emit_array_element(emitter, type, destination, index), emit_array_element(emitter, type, source, index));
			index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;
	emit_body_payload_copy(emitter, entity, destination, source);
	CompleteGraph* graph = complete_graph(compiler, entity);
	Subobject* target := graph->virtuals;
	while (target) {
		BasePath* path = (BasePath*)0;
		subobject_find_path(compiler, graph->root, target, &path);
		void* origin = emit_base_address(emitter, source, entity, path, BASE_UP);
		void* result = emit_base_address(emitter, destination, entity, path, BASE_UP);
		emit_body_payload_copy(emitter, target->entity, result, origin);
		target := target->virtual_next;
	};
};

fn emit_complete_read(Emitter* emitter, Type* type, void* source) -> void* {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views(type) || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_UNION)) {
		return LLVMBuildLoad2(compiler->llvm_builder, llvm_type(compiler, type), source, "value\0");
	};
	void* value = emit_slot(compiler, type);
	emit_initialize_type(emitter, type, value);
	emit_payload_copy(emitter, type, value, source);
	return LLVMBuildLoad2(compiler->llvm_builder, llvm_type(compiler, type), value, "complete.value\0");
};

fn emit_value_read(Emitter* emitter, Syntax* syntax) -> void* {
	return emit_complete_read(emitter, syntax->type, emit_address(emitter, syntax));
};

fn emit_truth(Emitter* emitter, void* value, Type* type) -> void* {
	void* zero = LLVMConstNull(llvm_type(emitter->compiler, type));
	if (type->kind == TYPE_FLOAT) {
		return LLVMBuildFCmp(emitter->compiler->llvm_builder, 14, value, zero, "truth\0");
	};
	return LLVMBuildICmp(emitter->compiler->llvm_builder, 33, value, zero, "truth\0");
};

fn emit_address(Emitter* emitter, Syntax* syntax) -> void* {
	void* address = emit_storage_address(emitter, syntax);
	Type* storage = syntax_storage_type(syntax);
	if (storage && storage->kind == TYPE_REFERENCE && syntax->kind != SYNTAX_CALL && syntax->kind != SYNTAX_CAST && syntax->kind != SYNTAX_BASE_REFERENCE) {
		return LLVMBuildLoad2(emitter->compiler->llvm_builder, llvm_type(emitter->compiler, storage), address, "referent\0");
	};
	return address;
};


fn emit_cast(Emitter* emitter, void* value, Type* source, Type* target) -> void* {
	void* builder := emitter->compiler->llvm_builder;
	void* type = llvm_type(emitter->compiler, target);
	if (target->kind == TYPE_BOOL && source->kind != TYPE_BOOL) {
		return emit_truth(emitter, value, source);
	};
	if (type_equal(source, target)) {
		return value;
	};
	if (source->kind == TYPE_POINTER || source->kind == TYPE_REFERENCE) {
		if (target->kind == TYPE_POINTER || target->kind == TYPE_REFERENCE) {
			return value;
		};
		return LLVMBuildPtrToInt(builder, value, type, "cast\0");
	};
	if (target->kind == TYPE_POINTER || target->kind == TYPE_REFERENCE) {
		return LLVMBuildIntToPtr(builder, value, type, "cast\0");
	};
	if (source->kind == TYPE_FLOAT && target->kind == TYPE_FLOAT) {
		return LLVMBuildFPCast(builder, value, type, "cast\0");
	};
	if (source->kind == TYPE_FLOAT) {
		if (type_unsigned(target)) {
			return LLVMBuildFPToUI(builder, value, type, "cast\0");
		};
		return LLVMBuildFPToSI(builder, value, type, "cast\0");
	};
	if (target->kind == TYPE_FLOAT) {
		if (type_unsigned(source) || source->kind == TYPE_CHAR) {
			return LLVMBuildUIToFP(builder, value, type, "cast\0");
		};
		return LLVMBuildSIToFP(builder, value, type, "cast\0");
	};
	return LLVMBuildIntCast2(builder, value, type, !(type_unsigned(source) || source->kind == TYPE_CHAR), "cast\0");
};

fn emit_extension(Compiler* compiler, Type* type) -> void* {
	if (!type_integer(type) || type_bits(type) >= 32) {
		return (void*)0;
	};
	char* name = "signext\0";
	if (type_unsigned(type) || type->kind == TYPE_CHAR) {
		name = "zeroext\0";
	};
	return LLVMCreateEnumAttribute(compiler->llvm_context, LLVMGetEnumAttributeKindForName(name, strlen(name)), 0);
};

fn emit_binary(Emitter* emitter, Syntax* syntax, void* first, void* second) -> void* {
	void* builder := emitter->compiler->llvm_builder;
	Type* type := syntax->data.binary.left->type;
	TokenKind operation := syntax->data.binary.operation;
	if (operation != TOKEN_EQUAL && operation != TOKEN_NOT_EQUAL && operation != TOKEN_LESS && operation != TOKEN_GREATER && operation != TOKEN_LESS_EQUAL && operation != TOKEN_GREATER_EQUAL) {
		type := syntax->type;
	};
	if (type->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
		second = emit_cast(emitter, second, syntax->data.binary.right->type, emitter->compiler->usize_type);
		if (operation == TOKEN_MINUS) {
			second = LLVMBuildNeg(builder, second, "negative\0");
		};
		return LLVMBuildGEP2(builder, llvm_type(emitter->compiler, type->data.element), first, &second, 1, "offset\0");
	};
	if (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) {
		i32 predicate = 32;
		if (operation == TOKEN_NOT_EQUAL) {
			predicate = 33;
		};
		if (operation == TOKEN_GREATER) {
			predicate = 38;
		};
		if (operation == TOKEN_GREATER_EQUAL) {
			predicate = 39;
		};
		if (operation == TOKEN_LESS) {
			predicate = 40;
		};
		if (operation == TOKEN_LESS_EQUAL) {
			predicate = 41;
		};
		void* result = (void*)0;
		if (type->kind == TYPE_FLOAT) {
			predicate = 1;
			if (operation == TOKEN_NOT_EQUAL) {
				predicate = 14;
			};
			if (operation == TOKEN_GREATER) {
				predicate = 2;
			};
			if (operation == TOKEN_GREATER_EQUAL) {
				predicate = 3;
			};
			if (operation == TOKEN_LESS) {
				predicate = 4;
			};
			if (operation == TOKEN_LESS_EQUAL) {
				predicate = 5;
			};
			result = LLVMBuildFCmp(builder, predicate, first, second, "compare\0");
		}
		else {
			if ((type_unsigned(type) || type->kind == TYPE_CHAR || type->kind == TYPE_POINTER) && predicate >= 38) {
				predicate = predicate - 4;
			};
			result = LLVMBuildICmp(builder, predicate, first, second, "compare\0");
		};
		return result;
	};
	if (type->kind == TYPE_FLOAT) {
		switch (operation) {
			case TOKEN_PLUS:
				return LLVMBuildFAdd(builder, first, second, "sum\0");
			case TOKEN_MINUS:
				return LLVMBuildFSub(builder, first, second, "difference\0");
			case TOKEN_STAR:
				return LLVMBuildFMul(builder, first, second, "product\0");
			case TOKEN_SLASH:
				return LLVMBuildFDiv(builder, first, second, "quotient\0");
		};
	};
	switch (operation) {
		case TOKEN_PLUS:
			return LLVMBuildAdd(builder, first, second, "sum\0");
		case TOKEN_MINUS:
			return LLVMBuildSub(builder, first, second, "difference\0");
		case TOKEN_STAR:
			return LLVMBuildMul(builder, first, second, "product\0");
		case TOKEN_SLASH:
			if (type_unsigned(type)) {
				return LLVMBuildUDiv(builder, first, second, "quotient\0");
			};
			return LLVMBuildSDiv(builder, first, second, "quotient\0");
		case TOKEN_REMAINDER:
			if (type_unsigned(type)) {
				return LLVMBuildURem(builder, first, second, "remainder\0");
			};
			return LLVMBuildSRem(builder, first, second, "remainder\0");
		case TOKEN_AMPERSAND:
			return LLVMBuildAnd(builder, first, second, "and\0");
		case TOKEN_PIPE:
			return LLVMBuildOr(builder, first, second, "or\0");
		case TOKEN_CARET:
			return LLVMBuildXor(builder, first, second, "xor\0");
		case TOKEN_SHIFT_LEFT:
			return LLVMBuildShl(builder, first, second, "shift\0");
		case TOKEN_SHIFT_RIGHT:
			if (type_unsigned(type)) {
				return LLVMBuildLShr(builder, first, second, "shift\0");
			};
			return LLVMBuildAShr(builder, first, second, "shift\0");
	};
	compiler_error(emitter->compiler, syntax->token, "unsupported numeric operation\0");
	return (void*)0;
};

fn emit_call(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder;
	if (syntax->data.call.receiver.kind == RECEIVER_EVALUATE) {
		Syntax* object := syntax->data.call.receiver.value;
		if (syntax_category(object) == VALUE_STORAGE) {
			emit_address(emitter, object);
		}
		else {
			emit_expression(emitter, object);
		};
	};
	Syntax* callee := syntax->data.call.callable;
	Type* signature := callee->type;
	if (signature->kind == TYPE_POINTER) {
		signature := signature->data.element;
	};
	u32 count = 0;
	if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
		count = 1;
	};
	Syntax* argument := syntax->data.call.arguments;
	while (argument) {
		count = count + 1;
		argument := argument->next;
	};
	void** values = (void**)memory_allocate(compiler, (usize)count * sizeof(void*));
	Parameter* parameter := signature->data.function.parameters;
	argument := syntax->data.call.arguments;
	u32 index = 0;
	if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
		Syntax* receiver := syntax->data.call.receiver.value;
		if (parameter->type->kind == TYPE_REFERENCE) {
			values[0] = emit_address(emitter, receiver);
		}
		else {
			values[0] = emit_expression(emitter, receiver);
		};
		parameter := parameter->next;
		index = 1;
	};
	while (argument) {
		void* value = (void*)0;
		if (argument->kind == SYNTAX_BLOCK) {
			argument->entity->data.variable.data.address = emit_slot(compiler, argument->type);
			if (argument->data.statements && argument->type->kind != TYPE_REFERENCE) {
				emit_initialize_type(emitter, argument->type, argument->entity->data.variable.data.address);
			};
			emit_statement(emitter, argument);
			value = LLVMBuildLoad2(builder, llvm_type(compiler, argument->type), argument->entity->data.variable.data.address, "argument\0");
		}
		else if (parameter && parameter->type->kind == TYPE_REFERENCE) {
			value = emit_address(emitter, argument);
		}
		else {
			value = emit_expression(emitter, argument);
		};
		if (parameter && parameter->type->kind != TYPE_REFERENCE) {
			value = emit_cast(emitter, value, argument->type, parameter->type);
		};
		if (!parameter) {
			Type* promoted := argument->type;
			if (promoted->kind == TYPE_FLOAT && promoted->data.bits == 32) {
				promoted = type_new(compiler, TYPE_FLOAT);
				promoted->data.bits = 64;
			}
			else if (type_integer(promoted) && type_bits(promoted) < 32) {
				promoted := compiler->i32_type;
			};
			value = emit_cast(emitter, value, argument->type, promoted);
		};
		values[index] = value;
		index = index + 1;
		argument := argument->next;
		if (parameter) {
			parameter := parameter->next;
		};
	};
	char* name = "call\0";
	if (signature->data.function.result->kind == TYPE_VOID) {
		name = "\0";
	};
	void* call = LLVMBuildCall2(builder, llvm_type(compiler, signature), emit_expression(emitter, callee), values, count, name);
	void* extension = emit_extension(compiler, signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute(call, 0, extension);
	};
	index = 1;
	parameter := signature->data.function.parameters;
	while (parameter) {
		extension = emit_extension(compiler, parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute(call, index, extension);
		};
		index = index + 1;
		parameter := parameter->next;
	};
	return call;
};

fn emit_expression(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder;
	void* type = llvm_type(compiler, syntax->type);
	switch (syntax->kind) {
		case SYNTAX_BASE_POINTER:
			return emit_base_conversion(emitter, syntax);
		case SYNTAX_BASE_REFERENCE:
			return emit_value_read(emitter, syntax);
		case SYNTAX_NUMBER:
			if (syntax->type->kind == TYPE_BOOL) {
				return LLVMConstInt(type, number_truth(compiler, syntax->token), 0);
			};
			if (syntax->type->kind == TYPE_FLOAT) {
				if (syntax->token.source->bytes[syntax->token.begin] == '\'') {
					return LLVMConstReal(type, (f64)integer_spelling(compiler, syntax->token, (u64)18446744073709551615));
				};
				char* text = memory_text(compiler, syntax->token.source->bytes + syntax->token.begin, syntax->token.length);
				return LLVMConstReal(type, strtod(text, (char**)0));
			};
			return LLVMConstInt(type, integer_spelling(compiler, syntax->token, (u64)18446744073709551615), 0);
		case SYNTAX_STRING: {
			void* value = LLVMConstStringInContext2(compiler->llvm_context, syntax->data.string.bytes, syntax->data.string.length, 1);
			void* global = LLVMAddGlobal(compiler->llvm_module, LLVMTypeOf(value), "string\0");
			LLVMSetInitializer(global, value);
			LLVMSetGlobalConstant(global, 1);
			LLVMSetLinkage(global, 9);
			return global;
		};
		case SYNTAX_NAME:
			if (syntax->entity->kind == ENTITY_FUNCTION) {
				return syntax->entity->data.function.llvm_value;
			};
			if (syntax->entity->data.variable.storage == STORAGE_CONSTANT) {
				return LLVMConstInt(type, syntax->entity->data.variable.data.integer, 0);
			};
			if (syntax->type->kind == TYPE_FUNCTION) {
				return emit_address(emitter, syntax);
			};
			return emit_value_read(emitter, syntax);
		case SYNTAX_MEMBER:
		case SYNTAX_INDEX:
			if (syntax->type->kind == TYPE_FUNCTION) {
				return emit_address(emitter, syntax);
			};
			return emit_value_read(emitter, syntax);
		case SYNTAX_SIZEOF:
			return LLVMConstInt(type, LLVMABISizeOfType(compiler->llvm_layout, llvm_type(compiler, syntax->data.expression->type)), 0);
		case SYNTAX_CAST:
			return emit_cast(emitter, emit_expression(emitter, syntax->data.cast.value), syntax->data.cast.value->type, syntax->type);
		case SYNTAX_UNARY: {
			TokenKind operation := syntax->data.unary.operation;
			Syntax* operand := syntax->data.unary.value;
			if (operation == TOKEN_AMPERSAND) {
				if (operand->type->kind == TYPE_FUNCTION) {
					return emit_expression(emitter, operand);
				};
				return emit_address(emitter, operand);
			};
			if (operation == TOKEN_STAR) {
				if (syntax->type->kind == TYPE_FUNCTION) {
					return emit_expression(emitter, operand);
				};
				return emit_value_read(emitter, syntax);
			};
			void* value = emit_expression(emitter, operand);
			if (operation == TOKEN_BANG) {
				value = LLVMBuildNot(builder, emit_truth(emitter, value, operand->type), "not\0");
				return value;
			};
			value = emit_cast(emitter, value, operand->type, syntax->type);
			if (operation == TOKEN_TILDE) {
				return LLVMBuildNot(builder, value, "complement\0");
			};
			if (operation == TOKEN_MINUS) {
				if (syntax->type->kind == TYPE_FLOAT) {
					return LLVMBuildFNeg(builder, value, "negative\0");
				};
				return LLVMBuildNeg(builder, value, "negative\0");
			};
			return value;
		};
		case SYNTAX_BIND_REFERENCE: {
			Syntax* left := syntax->data.binary.left;
			void* referent = emit_address(emitter, syntax->data.binary.right);
			LLVMBuildStore(builder, referent, emit_storage_address(emitter, left));
			return referent;
		};
		case SYNTAX_INITIALIZE:
		case SYNTAX_BINARY: {
			TokenKind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == TOKEN_ASSIGN || operation == TOKEN_COPY) {
				if (type_has_views(left->type)) {
					void* destination = emit_address(emitter, left);
					if (syntax->kind == SYNTAX_INITIALIZE && left->kind != SYNTAX_BASE_REFERENCE) {
						emit_initialize_type(emitter, left->type, destination);
					};
					void* source = (void*)0;
					if (syntax_category(right) == VALUE_STORAGE) {
						source = emit_address(emitter, right);
					}
					else {
						void* value = emit_expression(emitter, right);
						source = emit_slot(compiler, right->type);
						LLVMBuildStore(builder, value, source);
					};
					emit_payload_copy(emitter, left->type, destination, source);
					return emit_complete_read(emitter, left->type, destination);
				};
				void* value = emit_expression(emitter, right);
				value = emit_cast(emitter, value, right->type, left->type);
				LLVMBuildStore(builder, value, emit_address(emitter, left));
				return value;
			};
			if (operation == TOKEN_AND || operation == TOKEN_OR) {
				void* initial = LLVMGetInsertBlock(builder);
				void* function = LLVMGetBasicBlockParent(initial);
				void* rhs = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "logical.right\0");
				void* merge = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "logical.end\0");
				void* first = emit_truth(emitter, emit_expression(emitter, left), left->type);
				initial = LLVMGetInsertBlock(builder);
				if (operation == TOKEN_AND) {
					LLVMBuildCondBr(builder, first, rhs, merge);
				}
				else {
					LLVMBuildCondBr(builder, first, merge, rhs);
				};
				LLVMPositionBuilderAtEnd(builder, rhs);
				void* second = emit_truth(emitter, emit_expression(emitter, right), right->type);
				rhs = LLVMGetInsertBlock(builder);
				LLVMBuildBr(builder, merge);
				LLVMPositionBuilderAtEnd(builder, merge);
				void* phi = LLVMBuildPhi(builder, LLVMIntTypeInContext(compiler->llvm_context, 1), "logical\0");
				void*[2] values {};
				void*[2] blocks {};
				values[0] = LLVMConstInt(LLVMIntTypeInContext(compiler->llvm_context, 1), (u64)(operation == TOKEN_OR), 0);
				values[1] = second;
				blocks[0] = initial;
				blocks[1] = rhs;
				LLVMAddIncoming(phi, &values[0], &blocks[0], 2);
				return phi;
			};
			void* first = emit_expression(emitter, left);
			void* second = emit_expression(emitter, right);
			if (left->type->kind != TYPE_POINTER) {
				Type* operand := left->type;
				if (operation != TOKEN_EQUAL && operation != TOKEN_NOT_EQUAL && operation != TOKEN_LESS && operation != TOKEN_GREATER && operation != TOKEN_LESS_EQUAL && operation != TOKEN_GREATER_EQUAL) {
					operand := syntax->type;
				};
				first = emit_cast(emitter, first, left->type, operand);
				second = emit_cast(emitter, second, right->type, operand);
			};
			return emit_binary(emitter, syntax, first, second);
		};
		case SYNTAX_CALL: {
			if (syntax_storage_type(syntax)->kind == TYPE_REFERENCE && syntax->type->kind != TYPE_FUNCTION) {
				return emit_value_read(emitter, syntax);
			};
			return emit_call(emitter, syntax);
		};
	};
	compiler_error(compiler, syntax->token, "expression cannot be emitted\0");
	return (void*)0;
};

fn emit_jump(Emitter* emitter, void* block) {
	void* current = LLVMGetInsertBlock(emitter->compiler->llvm_builder);
	if (!LLVMGetBasicBlockTerminator(current)) {
		LLVMBuildBr(emitter->compiler->llvm_builder, block);
	};
};

fn emit_has_predecessor(void* target) -> i32 {
	void* block = LLVMGetFirstBasicBlock(LLVMGetBasicBlockParent(target));
	while (block) {
		void* instruction = LLVMGetBasicBlockTerminator(block);
		if (instruction) {
			u32 count = LLVMGetNumSuccessors(instruction);
			u32 index = 0;
			while (index < count) {
				if (LLVMGetSuccessor(instruction, index) == target) {
					return 1;
				};
				index = index + 1;
			};
		};
		block = LLVMGetNextBasicBlock(block);
	};
	return 0;
};

fn emit_statement(Emitter* emitter, Syntax* syntax) {
	Compiler* compiler := emitter->compiler;
	if (!syntax || compiler->result == COMPILATION_FAILURE) {
		return;
	};
	void* builder := compiler->llvm_builder;
	if (syntax->kind != SYNTAX_CASE && syntax->kind != SYNTAX_BLOCK && syntax->kind != SYNTAX_DECLARATION && LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(builder))) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_BLOCK: {
			Syntax* statement := syntax->data.statements;
			while (statement) {
				emit_statement(emitter, statement);
				statement := statement->next;
			};
			break;
		};
		case SYNTAX_DECLARATION:
			if (syntax->entity->kind == ENTITY_VARIABLE) {
				Entity* variable := syntax->entity;
				variable->data.variable.data.address = emit_slot(compiler, variable->data.variable.type);
				if (LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(builder))) {
					break;
				};
				if (!syntax->data.declaration.body) {
					LLVMBuildStore(builder, LLVMConstNull(llvm_type(compiler, variable->data.variable.type)), variable->data.variable.data.address);
					emit_initialize_type(emitter, variable->data.variable.type, variable->data.variable.data.address);
				}
				else if (syntax->data.declaration.body->data.statements && variable->data.variable.type->kind != TYPE_REFERENCE) {
					emit_initialize_type(emitter, variable->data.variable.type, variable->data.variable.data.address);
				};
				emit_statement(emitter, syntax->data.declaration.body);
			};
			break;
		case SYNTAX_RETURN:
			if (syntax->data.expression) {
				Syntax* expression := syntax->data.expression;
				Type* result := emitter->function->data.function.type->data.function.result;
				void* value = (void*)0;
				if (result->kind == TYPE_REFERENCE) {
					value = emit_address(emitter, expression);
				}
				else {
					value = emit_expression(emitter, expression);
					value = emit_cast(emitter, value, expression->type, result);
				};
				LLVMBuildRet(builder, value);
			}
			else {
				LLVMBuildRetVoid(builder);
			};
			break;
		case SYNTAX_BREAK:
			LLVMBuildBr(builder, emitter->flow->break_block);
			break;
		case SYNTAX_CONTINUE: {
			Flow* flow := emitter->flow;
			while (flow && flow->kind != FLOW_LOOP) {
				flow := flow->parent;
			};
			LLVMBuildBr(builder, flow->continue_block);
			break;
		};
		case SYNTAX_IF: {
			void* function := emitter->function->data.function.llvm_value;
			void* first = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "if.then\0");
			void* second = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "if.else\0");
			void* merge = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "if.end\0");
			Syntax* condition := syntax->data.branch.condition;
			LLVMBuildCondBr(builder, emit_truth(emitter, emit_expression(emitter, condition), condition->type), first, second);
			LLVMPositionBuilderAtEnd(builder, first);
			emit_statement(emitter, syntax->data.branch.first);
			i32 first_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(builder)) != (void*)0;
			emit_jump(emitter, merge);
			LLVMPositionBuilderAtEnd(builder, second);
			emit_statement(emitter, syntax->data.branch.second);
			i32 second_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(builder)) != (void*)0;
			emit_jump(emitter, merge);
			LLVMPositionBuilderAtEnd(builder, merge);
			if (first_stops && second_stops) {
				LLVMBuildUnreachable(builder);
			};
			break;
		};
		case SYNTAX_FOR:
		case SYNTAX_WHILE: {
			void* function := emitter->function->data.function.llvm_value;
			void* test = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "loop.test\0");
			void* body = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "loop.body\0");
			void* step = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "loop.step\0");
			void* end = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "loop.end\0");
			emit_statement(emitter, syntax->data.loop.initializer);
			emit_jump(emitter, test);
			LLVMPositionBuilderAtEnd(builder, test);
			Syntax* condition := syntax->data.loop.condition;
			if (condition) {
				LLVMBuildCondBr(builder, emit_truth(emitter, emit_expression(emitter, condition), condition->type), body, end);
			}
			else {
				LLVMBuildBr(builder, body);
			};
			Flow flow;
			flow.kind = FLOW_LOOP;
			flow.parent := emitter->flow;
			flow.break_block := end;
			flow.continue_block := step;
			emitter->flow = &flow;
			LLVMPositionBuilderAtEnd(builder, body);
			emit_statement(emitter, syntax->data.loop.body);
			emit_jump(emitter, step);
			LLVMPositionBuilderAtEnd(builder, step);
			if (syntax->data.loop.step) {
				emit_expression(emitter, syntax->data.loop.step);
			};
			emit_jump(emitter, test);
			emitter->flow := flow.parent;
			LLVMPositionBuilderAtEnd(builder, end);
			break;
		};
		case SYNTAX_SWITCH: {
			void* function := emitter->function->data.function.llvm_value;
			void* end = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "switch.end\0");
			void* fallback := end;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			CaseBlock* previous := emitter->cases;
			CaseBlock* cases = (CaseBlock*)0;
			u32 count = 0;
			while (statement) {
				if (statement->kind == SYNTAX_CASE) {
					CaseBlock* selection = (CaseBlock*)memory_allocate(compiler, sizeof(CaseBlock));
					selection->syntax := statement;
					selection->block = LLVMAppendBasicBlockInContext(compiler->llvm_context, function, "switch.case\0");
					selection->next := cases;
					if (!statement->data.selection_case.value) {
						fallback := selection->block;
					}
					else {
						count = count + 1;
					};
					cases = selection;
				};
				statement := statement->next;
			};
			void* instruction = LLVMBuildSwitch(builder, emit_expression(emitter, syntax->data.selection.value), fallback, count);
			CaseBlock* selection := cases;
			while (selection) {
				if (selection->syntax->data.selection_case.value) {
					Syntax* expression := selection->syntax->data.selection_case.value;
					u64 value = constant_integer(compiler, expression->scope, expression);
					value = constant_selector(value, expression->type);
					LLVMAddCase(instruction, LLVMConstInt(llvm_type(compiler, expression->type), value, 0), selection->block);
				};
				selection := selection->next;
			};
			Flow flow;
			flow.kind = FLOW_SWITCH;
			flow.parent := emitter->flow;
			flow.break_block := end;
			emitter->flow = &flow;
			emitter->cases = cases;
			emit_statement(emitter, syntax->data.selection.cases);
			emit_jump(emitter, end);
			emitter->flow := flow.parent;
			emitter->cases = previous;
			LLVMPositionBuilderAtEnd(builder, end);
			if (!emit_has_predecessor(end)) {
				LLVMBuildUnreachable(builder);
			};
			break;
		};
		case SYNTAX_CASE: {
			CaseBlock* selection := emitter->cases;
			while (selection && selection->syntax != syntax) {
				selection := selection->next;
			};
			if (selection) {
				emit_jump(emitter, selection->block);
				LLVMPositionBuilderAtEnd(builder, selection->block);
			};
			break;
		};
		default:
			emit_expression(emitter, syntax);
			break;
	};
};

struct LayoutVisit {
	Entity* entity;
	LayoutVisit* parent;
};

fn layout_validate(Compiler* compiler, Type* type, LayoutVisit* parent, Token token) {
	if (!type) {
		return;
	};
	if (type->kind == TYPE_VOID || type->kind == TYPE_FUNCTION) {
		compiler_error(compiler, token, "type has no value storage layout\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		layout_validate(compiler, type->data.array.element, parent, token);
		if (compiler->result == COMPILATION_FAILURE) {
			return;
		};

		u64 size = LLVMABISizeOfType(compiler->llvm_layout, llvm_type(compiler, type->data.array.element));
		u64 maximum = (u64)18446744073709551615;
		if (compiler->usize_type->data.bits < 64) {
			maximum = 1;
			i32 bit = 0;
			while (bit < compiler->usize_type->data.bits) {
				maximum = maximum * 2;
				bit = bit + 1;
			};
			maximum = maximum - 1;
		};
		if (size && type->data.array.count > maximum / size) {
			compiler_error(compiler, token, "array storage exceeds the native address range\0");
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};

	Entity* entity := type->data.entity;
	LayoutVisit* previous := parent;
	while (previous) {
		if (previous->entity == entity) {
			compiler_error(compiler, token, "record contains itself by value\0");
			return;
		};
		previous := previous->parent;
	};

	entity_resolve(compiler, entity);
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		compiler_error(compiler, token, "incomplete record has no storage layout\0");
		return;
	};

	Field* binding := entity->data.aggregate.fields;
	LayoutVisit visit;
	visit.entity := entity;
	visit.parent = parent;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base && compiler->result != COMPILATION_FAILURE) {
		layout_validate(compiler, entity_type(base->entity), &visit, base->name->token);
		base := base->next;
	};
	while (binding && compiler->result != COMPILATION_FAILURE) {
		layout_validate(compiler, entity_type(binding->entity), &visit, binding->entity->name);
		binding := binding->next;
	};
};

struct DeclarationIterator {
	Scope* scope;
};

fn declaration_next(DeclarationIterator* iterator, Binding* binding) -> Binding* {
	Scope* members = (Scope*)0;
	if (binding->entity->kind == ENTITY_NAMESPACE || binding->entity->kind == ENTITY_STRUCT || binding->entity->kind == ENTITY_UNION) {
		members = entity_members(binding->entity);
	};
	if (members && members->bindings) {
		iterator->scope = members;
		return iterator->scope->bindings;
	};
	while (!binding->next) {
		Entity* owner := iterator->scope->owner;
		if (!owner || (owner->kind != ENTITY_NAMESPACE && owner->kind != ENTITY_STRUCT && owner->kind != ENTITY_UNION)) {
			return (Binding*)0;
		};
		iterator->scope := iterator->scope->parent;
		binding := iterator->scope->bindings;
		while (binding && binding->entity != owner) {
			binding := binding->next;
		};
		if (!binding) {
			return (Binding*)0;
		};
	};
	return binding->next;
};

fn declarations_validate_block(Compiler* compiler, Syntax* module) {
	Syntax* statement := module->data.statements;
	while (statement && compiler->result != COMPILATION_FAILURE) {
		if (statement->kind != SYNTAX_DECLARATION) {
			compiler_error(compiler, statement->token, "module context requires declarations\0");
			return;
		};

		Entity* entity := statement->entity;
		if (statement->token.kind == TOKEN_NAMESPACE) {
			declarations_validate_block(compiler, statement->data.declaration.body);
		}
		else if (entity->kind == ENTITY_FUNCTION) {
			Type* declared = type_resolve(compiler, entity->scope, statement->data.declaration.type);
			if (!type_equal(declared, entity->data.function.type)) {
				compiler_error(compiler, statement->token, "conflicting function signature\0");
			};
			if (statement->data.declaration.body && statement != entity->declaration) {
				compiler_error(compiler, statement->token, "duplicate function definition\0");
			};
		}
		else if (entity->kind == ENTITY_VARIABLE) {
			if (entity->data.variable.storage != STORAGE_FIELD) {
				compiler_error(compiler, statement->token, "module variables are not supported in this bootstrap stage\0");
			};
		}
		else if (statement->data.declaration.body && statement != entity->declaration) {
			compiler_error(compiler, statement->token, "duplicate type definition\0");
		}
		else if ((entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION) && statement->data.declaration.body) {
			declarations_validate_block(compiler, statement->data.declaration.body);
		};
		statement := statement->next;
	};
};

fn declarations_validate(Compiler* compiler) {
	Syntax* module := compiler->declarations;
	while (module && compiler->result != COMPILATION_FAILURE) {
		declarations_validate_block(compiler, module);
		module := module->next;
	};
};

fn external_validate(Compiler* compiler, Entity* entity) {
	if (entity->data.function.body || (entity->scope && entity->scope->owner && (entity->scope->owner->kind == ENTITY_STRUCT || entity->scope->owner->kind == ENTITY_UNION))) {
		return;
	};
	DeclarationIterator iterator;
	iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && binding->entity != entity) {
		Entity* previous := binding->entity;
		if (previous->kind == ENTITY_FUNCTION && !previous->data.function.body && (!previous->scope || !previous->scope->owner || (previous->scope->owner->kind != ENTITY_STRUCT && previous->scope->owner->kind != ENTITY_UNION)) && token_same(previous->name, entity->name) && !type_equal(previous->data.function.type, entity->data.function.type)) {
			compiler_error(compiler, entity->name, "conflicting external C function signature\0");
			return;
		};
		binding = declaration_next(&iterator, binding);
	};
};

fn backend_analyze(Compiler* compiler) {
	DeclarationIterator iterator;
	iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		if (binding->entity->kind != ENTITY_VARIABLE) {
			entity_resolve(compiler, binding->entity);
		};
		binding = declaration_next(&iterator, binding);
	};

	declarations_validate(compiler);
	iterator.scope := compiler->module;
	binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		Entity* entity := binding->entity;
		if ((entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION) && entity->declaration && entity->declaration->data.declaration.body) {
			layout_validate(compiler, entity_type(entity), (LayoutVisit*)0, entity->name);
		};
		if (entity->kind == ENTITY_FUNCTION) {
			external_validate(compiler, entity);
			Type* signature := entity->data.function.type;
			if (!entity->data.function.body && type_aggregate(signature->data.function.result)) {
				compiler_error(compiler, entity->name, "external aggregate return requires C ABI lowering that is not supported yet\0");
			};
			if (signature->data.function.result->kind != TYPE_VOID) {
				layout_validate(compiler, signature->data.function.result, (LayoutVisit*)0, entity->name);
			};
			Parameter* parameter := signature->data.function.parameters;
			while (parameter && compiler->result != COMPILATION_FAILURE) {
				if (!entity->data.function.body && type_aggregate(parameter->type)) {
					compiler_error(compiler, entity->name, "external aggregate parameter requires C ABI lowering that is not supported yet\0");
					break;
				};
				layout_validate(compiler, parameter->type, (LayoutVisit*)0, entity->name);
				parameter := parameter->next;
			};
		};
		if (entity->kind == ENTITY_FUNCTION && entity->data.function.body) {
			Semantic semantic;
			semantic.compiler := compiler;
			semantic.scope := entity->scope;
			semantic.function := entity;
			semantic_statement(&semantic, entity->data.function.body);
		};
		binding = declaration_next(&iterator, binding);
	};
};

fn entity_name(Compiler* compiler, Entity* entity) -> char* {
	Scope* scope := entity->scope;
	char* parent = "\0";
	if (scope && scope->owner && (scope->owner->kind == ENTITY_NAMESPACE || scope->owner->kind == ENTITY_STRUCT || scope->owner->kind == ENTITY_UNION)) {
		parent = entity_name(compiler, scope->owner);
	};
	usize length = strlen(parent);
	usize separator = 0;
	if (length) {
		separator = 2;
	};
	char* name = (char*)memory_allocate(compiler, length + separator + entity->name.length + 1);
	if (!name) {
		return (char*)0;
	};
	memcpy((void*)name, (void*)parent, length);
	if (separator) {
		name[length] = ':';
		name[length + 1] = ':';
	};
	memcpy((void*)(name + length + separator), (void*)(entity->name.source->bytes + entity->name.begin), entity->name.length);
	return name;
};

fn emit_symbol(Compiler* compiler, Entity* entity) -> char* {
	if (!entity->data.function.body && (!entity->scope || !entity->scope->owner || (entity->scope->owner->kind != ENTITY_STRUCT && entity->scope->owner->kind != ENTITY_UNION))) {
		return memory_text(compiler, entity->name.source->bytes + entity->name.begin, entity->name.length);
	};
	char* qualified = entity_name(compiler, entity);
	if (compiler->output == OUTPUT_LIBRARY) {
		return qualified;
	};
	char* prefix = "rt.function.\0";
	usize prefix_length = strlen(prefix);
	usize length = strlen(qualified);
	char* name = (char*)memory_allocate(compiler, prefix_length + length + 1);
	if (!name) {
		return (char*)0;
	};
	memcpy((void*)name, (void*)prefix, prefix_length);
	memcpy((void*)(name + prefix_length), (void*)qualified, length);
	return name;
};

fn emit_function(Compiler* compiler, Entity* entity) {
	if (!entity->data.function.body) {
		return;
	};
	void* block = LLVMAppendBasicBlockInContext(compiler->llvm_context, entity->data.function.llvm_value, "entry\0");
	LLVMPositionBuilderAtEnd(compiler->llvm_builder, block);
	Emitter emitter;
	emitter.compiler := compiler;
	emitter.function := entity;
	Parameter* parameter := entity->data.function.type->data.function.parameters;
	u32 index = 0;
	while (parameter) {
		parameter->entity->data.variable.data.address = emit_slot(compiler, parameter->type);
		if (type_has_views(parameter->type) && (parameter->type->kind != TYPE_NAMED || parameter->type->data.entity->kind != ENTITY_UNION)) {
			void* incoming = emit_slot(compiler, parameter->type);
			LLVMBuildStore(compiler->llvm_builder, LLVMGetParam(entity->data.function.llvm_value, index), incoming);
			emit_initialize_type(&emitter, parameter->type, parameter->entity->data.variable.data.address);
			emit_payload_copy(&emitter, parameter->type, parameter->entity->data.variable.data.address, incoming);
		}
		else {
			LLVMBuildStore(compiler->llvm_builder, LLVMGetParam(entity->data.function.llvm_value, index), parameter->entity->data.variable.data.address);
		};
		index = index + 1;
		parameter := parameter->next;
	};
	emit_statement(&emitter, entity->data.function.body);
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(compiler->llvm_builder))) {
		if (entity->data.function.type->data.function.result->kind == TYPE_VOID) {
			LLVMBuildRetVoid(compiler->llvm_builder);
		}
		else {
			compiler_error(compiler, entity->name, "function can finish without returning a value\0");
		};
	};
};

fn entry_lookup(Compiler* compiler) -> Entity* {
	Source source;
	source.bytes := compiler->entry;
	source.length = strlen(compiler->entry);
	Token name;
	name.source = &source;
	Scope* scope := compiler->module;
	while (name.begin < source.length) {
		name.length = 0;
		while (name.begin + name.length < source.length && source.bytes[name.begin + name.length] != ':') {
			name.length = name.length + 1;
		};
		Entity* entity = scope_local(scope, name);
		if (!entity) {
			return (Entity*)0;
		};
		if (name.begin + name.length == source.length) {
			return entity;
		};
		scope = entity_members(entity);
		if (!scope || name.begin + name.length + 1 >= source.length || source.bytes[name.begin + name.length + 1] != ':') {
			return (Entity*)0;
		};
		name.begin = name.begin + name.length + 2;
	};
	return (Entity*)0;
};

fn emit_entry(Compiler* compiler) {
	Entity* entry = entry_lookup(compiler);
	if (!entry || entry->kind != ENTITY_FUNCTION || !entry->data.function.body) {
		Token token;
		if (compiler->declarations) {
			token := compiler->declarations->token;
		};
		compiler_error(compiler, token, "entry function is missing or has no definition\0");
		return;
	};
	Type* signature := entry->data.function.type;
	if (signature->data.function.result->kind != TYPE_VOID && !type_equal(signature->data.function.result, compiler->i32_type)) {
		compiler_error(compiler, entry->name, "entry function must return i32 or void\0");
		return;
	};
	Parameter* parameter := signature->data.function.parameters;
	void*[2] arguments {};
	void*[2] parameter_types {};
	parameter_types[0] = llvm_type(compiler, compiler->i32_type);
	parameter_types[1] = LLVMPointerTypeInContext(compiler->llvm_context, 0);
	if (parameter && (!parameter->next || parameter->next->next || !type_equal(parameter->type, compiler->i32_type) || !type_equal(parameter->next->type, type_pointer(compiler, type_pointer(compiler, compiler->char_type))))) {
		compiler_error(compiler, entry->name, "entry parameters must be empty or (i32, char**)\0");
		return;
	};
	void* main_type = LLVMFunctionType(parameter_types[0], &parameter_types[0], 2, 0);
	void* main_function = LLVMAddFunction(compiler->llvm_module, "main\0", main_type);
	void* block = LLVMAppendBasicBlockInContext(compiler->llvm_context, main_function, "entry\0");
	LLVMPositionBuilderAtEnd(compiler->llvm_builder, block);
	arguments[0] = LLVMGetParam(main_function, 0);
	arguments[1] = LLVMGetParam(main_function, 1);
	u32 count = 0;
	if (parameter) {
		count = 2;
	};
	char* name = "entry.result\0";
	if (signature->data.function.result->kind == TYPE_VOID) {
		name = "\0";
	};
	void* result = LLVMBuildCall2(compiler->llvm_builder, entry->data.function.llvm_type, entry->data.function.llvm_value, &arguments[0], count, name);
	if (signature->data.function.result->kind == TYPE_VOID) {
		result = LLVMConstInt(parameter_types[0], 0, 0);
	};
	LLVMBuildRet(compiler->llvm_builder, result);
};

fn backend_emit(Compiler* compiler) {
	DeclarationIterator iterator;
	iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		Entity* entity := binding->entity;
		if (entity->kind == ENTITY_FUNCTION) {
			Type* signature := entity->data.function.type;
			entity->data.function.llvm_type = llvm_type(compiler, signature);
			char* symbol = emit_symbol(compiler, entity);
			void* existing = LLVMGetNamedFunction(compiler->llvm_module, symbol);
			if (existing && LLVMGlobalGetValueType(existing) != entity->data.function.llvm_type) {
				compiler_error(compiler, entity->name, "conflicting native function signature\0");
				return;
			};
			if (!existing) {
				existing = LLVMAddFunction(compiler->llvm_module, symbol, entity->data.function.llvm_type);
			};
			entity->data.function.llvm_value = existing;
			void* extension = emit_extension(compiler, signature->data.function.result);
			if (extension) {
				LLVMAddAttributeAtIndex(entity->data.function.llvm_value, 0, extension);
			};
			Parameter* parameter := signature->data.function.parameters;
			u32 index = 1;
			while (parameter) {
				extension = emit_extension(compiler, parameter->type);
				if (extension) {
					LLVMAddAttributeAtIndex(entity->data.function.llvm_value, index, extension);
				};
				index = index + 1;
				parameter := parameter->next;
			};
		};
		binding = declaration_next(&iterator, binding);
	};
	iterator.scope := compiler->module;
	binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		if (binding->entity->kind == ENTITY_FUNCTION) {
			emit_function(compiler, binding->entity);
		};
		binding = declaration_next(&iterator, binding);
	};
	if (compiler->output == OUTPUT_EXECUTABLE && compiler->result != COMPILATION_FAILURE) {
		emit_entry(compiler);
	};
	if (compiler->result == COMPILATION_SUCCESS) {
		runtime_views_emit(compiler);
	};
};

fn semantic_statement(Semantic* semantic, Syntax* syntax) {
	Compiler* compiler := semantic->compiler;
	if (!syntax || compiler->result == COMPILATION_FAILURE) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_BLOCK: {
			Scope* outer := semantic->scope;
			if (syntax->scope) {
				semantic->scope = semantic_scope(semantic, syntax->scope);
				syntax->scope := semantic->scope;
			};
			Syntax* statement := syntax->data.statements;
			while (statement && compiler->result != COMPILATION_FAILURE) {
				semantic_statement(semantic, statement);
				statement := statement->next;
			};
			semantic->scope = outer;
			break;
		};
		case SYNTAX_DECLARATION:
			if (syntax->entity->kind == ENTITY_VARIABLE) {
				Entity* variable := syntax->entity;
				if (syntax->data.declaration.type) {
					variable->data.variable.type = type_resolve(compiler, semantic->scope, syntax->data.declaration.type);
				};
				variable->resolution = RESOLUTION_READY;
				if (!syntax->data.declaration.body && variable->data.variable.type && type_requires_union_choice(variable->data.variable.type)) {
					compiler_error(compiler, syntax->token, "automatic union member construction requires an explicit member initializer\0");
					return;
				};
				if (variable->data.variable.type && variable->data.variable.type->kind == TYPE_REFERENCE) {
					reference_initializer(compiler, syntax->data.declaration.body, variable, syntax->token);
					if (compiler->result == COMPILATION_FAILURE) {
						return;
					};
				}
				else {
					scope_define(compiler, semantic->scope, variable);
					if (variable->data.variable.type) {
						object_initializer_prepare(compiler, semantic->scope, variable, syntax->data.declaration.body, syntax->token);
					};
				};
				semantic_statement(semantic, syntax->data.declaration.body);
				if (variable->data.variable.type && variable->data.variable.type->kind == TYPE_REFERENCE) {
					scope_define(compiler, semantic->scope, variable);
				};
				if (!variable->data.variable.type || variable->data.variable.type->kind == TYPE_VOID || variable->data.variable.type->kind == TYPE_FUNCTION) {
					compiler_error(compiler, syntax->token, "variable requires a resolved storage type\0");
				};
				layout_validate(compiler, variable->data.variable.type, (LayoutVisit*)0, syntax->token);
			}
			else {
				entity_resolve(compiler, syntax->entity);
			};
			break;
		case SYNTAX_RETURN:
			if (!semantic->function) {
				compiler_error(compiler, syntax->token, "return requires a function context\0");
			}
			else {
				Type* result := semantic->function->data.function.type->data.function.result;
				if (syntax->data.expression) {
					semantic_expression(semantic, syntax->data.expression, result);
				}
				else if (result->kind != TYPE_VOID) {
					compiler_error(compiler, syntax->token, "return requires a result value\0");
				};
			};
			break;
		case SYNTAX_IF:
			if (!type_scalar(semantic_expression(semantic, syntax->data.branch.condition, compiler->bool_type))) {
				compiler_error(compiler, syntax->token, "condition requires a scalar value\0");
			};
			Scope* outer := semantic->scope;
			Scope* first = scope_snapshot(compiler, outer);
			semantic->scope := first;
			semantic_statement(semantic, syntax->data.branch.first);
			Scope* second = scope_snapshot(compiler, outer);
			semantic->scope := second;
			semantic_statement(semantic, syntax->data.branch.second);
			semantic->scope := outer;
			scope_merge_removals(compiler, outer, first);
			scope_merge_removals(compiler, outer, second);
			break;
		case SYNTAX_FOR:
		case SYNTAX_WHILE: {
			Flow flow;
			flow.kind = FLOW_LOOP;
			flow.parent := semantic->flow;
			semantic->flow = &flow;
			Scope* outer := semantic->scope;
			if (syntax->scope) {
				semantic->scope = semantic_scope(semantic, syntax->scope);
				syntax->scope := semantic->scope;
			};
			semantic_statement(semantic, syntax->data.loop.initializer);
			if (syntax->data.loop.condition) {
				if (!type_scalar(semantic_expression(semantic, syntax->data.loop.condition, compiler->bool_type))) {
					compiler_error(compiler, syntax->token, "condition requires a scalar value\0");
				};
			};
			semantic_statement(semantic, syntax->data.loop.body);
			if (syntax->data.loop.step) {
				semantic_expression(semantic, syntax->data.loop.step, (Type*)0);
			};
			semantic->scope = outer;
			semantic->flow := flow.parent;
			break;
		};
		case SYNTAX_SWITCH: {
			Type* type = semantic_expression(semantic, syntax->data.selection.value, (Type*)0);
			if (!type_integer(type)) {
				compiler_error(compiler, syntax->token, "switch requires an integer value\0");
				break;
			};
			selection_validate(semantic, syntax, type);
			Flow flow;
			flow.kind = FLOW_SWITCH;
			flow.parent := semantic->flow;
			semantic->flow = &flow;
			Type* outer := semantic->selection_type;
			semantic->selection_type = type;
			Scope* outer_scope := semantic->scope;
			Scope* merged = scope_snapshot(compiler, outer_scope);
			Scope* branch = scope_snapshot(compiler, outer_scope);
			semantic->scope := branch;
			Scope* cases = semantic_scope(semantic, syntax->data.selection.cases->scope);
			syntax->data.selection.cases->scope := cases;
			semantic->scope := cases;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			while (statement && compiler->result != COMPILATION_FAILURE) {
				if (statement->kind == SYNTAX_CASE) {
					scope_merge_removals(compiler, merged, branch);
					branch = scope_snapshot(compiler, outer_scope);
					cases->parent := branch;
				};
				semantic_statement(semantic, statement);
				statement := statement->next;
			};
			scope_merge_removals(compiler, merged, branch);
			scope_merge_removals(compiler, outer_scope, merged);
			semantic->scope = outer_scope;
			semantic->selection_type = outer;
			semantic->flow := flow.parent;
			break;
		};
		case SYNTAX_CASE:
			if (!semantic->flow || semantic->flow->kind != FLOW_SWITCH) {
				compiler_error(compiler, syntax->token, "case requires a switch context\0");
			};
			if (syntax->data.selection_case.value) {
				constant_integer(compiler, semantic->scope, syntax->data.selection_case.value);
			};
			break;
		case SYNTAX_BREAK:
		case SYNTAX_CONTINUE: {
			Flow* flow := semantic->flow;
			if (syntax->kind == SYNTAX_CONTINUE) {
				while (flow && flow->kind != FLOW_LOOP) {
					flow := flow->parent;
				};
			};
			if (!flow) {
				compiler_error(compiler, syntax->token, "flow statement has no enclosing target\0");
			};
			break;
		};
		default:
			semantic_expression(semantic, syntax, (Type*)0);
			break;
	};
};

fn LLVMGetVersion(u32* major, u32* minor, u32* patch);

fn backend_initialize(Compiler* compiler) -> i32 {
	Token token;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);
	if (major != 21 || minor != 1 || patch != 0) {
		compiler_error(compiler, token, "LLVM runtime version must be 21.1.0\0");
		return 0;
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	compiler->llvm_context = LLVMContextCreate();
	compiler->llvm_module = LLVMModuleCreateWithNameInContext("rutile\0", compiler->llvm_context);
	compiler->llvm_builder = LLVMCreateBuilderInContext(compiler->llvm_context);

	char* triple = LLVMGetDefaultTargetTriple();
	char* message;
	void* target;
	i32 target_failure = LLVMGetTargetFromTriple(triple, &target, &message);
	if (target_failure) {
		compiler_error(compiler, token, message);
		LLVMDisposeMessage(message);
	}
	else {
		compiler->llvm_machine = LLVMCreateTargetMachine(target, triple, "generic\0", "\0", compiler->optimization, 2, 0);
		if (!compiler->llvm_machine) {
			compiler_error(compiler, token, "cannot create LLVM target machine\0");
		}
		else {
			compiler->llvm_layout = LLVMCreateTargetDataLayout(compiler->llvm_machine);
			char* layout = LLVMCopyStringRepOfTargetData(compiler->llvm_layout);
			LLVMSetTarget(compiler->llvm_module, triple);
			LLVMSetDataLayout(compiler->llvm_module, layout);
			LLVMDisposeMessage(layout);
		};
	};

	LLVMDisposeMessage(triple);
	return compiler->result == COMPILATION_SUCCESS;
};

fn backend_verify(Compiler* compiler) -> i32 {
	char* message;
	i32 invalid = LLVMVerifyModule(compiler->llvm_module, 2, &message);
	if (invalid) {
		Token token;
		compiler_error(compiler, token, message);
	};
	if (message) {
		LLVMDisposeMessage(message);
	};
	return !invalid;
};

fn backend_optimize(Compiler* compiler) -> i32 {
	if (!backend_verify(compiler)) {
		return 0;
	};

	char*[4] pipelines {};
	pipelines[0] = "default<O0>\0";
	pipelines[1] = "default<O1>\0";
	pipelines[2] = "default<O2>\0";
	pipelines[3] = "default<O3>\0";
	void* options = LLVMCreatePassBuilderOptions();
	LLVMPassBuilderOptionsSetVerifyEach(options, 1);
	void* error = LLVMRunPasses(compiler->llvm_module, pipelines[compiler->optimization], compiler->llvm_machine, options);
	LLVMDisposePassBuilderOptions(options);
	if (error) {
		char* message = LLVMGetErrorMessage(error);
		Token token;
		compiler_error(compiler, token, message);
		LLVMDisposeErrorMessage(message);
		return 0;
	};

	return backend_verify(compiler);
};

fn backend_publish(Compiler* compiler, char* output_path) -> i32 {
	char* message;
	void* buffer;
	if (LLVMTargetMachineEmitToMemoryBuffer(compiler->llvm_machine, compiler->llvm_module, 1, &message, &buffer)) {
		Token token;
		compiler_error(compiler, token, message);
		LLVMDisposeMessage(message);
		return 0;
	};

	void* file = compiler->open_file(output_path, "wb\0");
	if (!file) {
		Token token;
		compiler_error(compiler, token, "cannot open native object output\0");
		LLVMDisposeMemoryBuffer(buffer);
		return 0;
	};

	usize size = LLVMGetBufferSize(buffer);
	usize written = fwrite((void*)LLVMGetBufferStart(buffer), 1, size, file);
	i32 closed = fclose(file);
	LLVMDisposeMemoryBuffer(buffer);
	if (written != size || closed) {
		Token token;
		compiler_error(compiler, token, "cannot write native object output\0");
		return 0;
	};
	return 1;
};

fn source_read(Compiler* compiler, char* path) -> Source* {
	Source* source = (Source*)memory_allocate(compiler, sizeof(Source));
	if (!source) {
		return (Source*)0;
	};
	source->path = memory_text(compiler, path, strlen(path));
	Token token;
	token.source := source;
	token.line = 1;
	token.column = 1;
	void* file = compiler->open_file(path, "rb\0");
	if (!file) {
		compiler_error(compiler, token, "cannot open source\0");
		return (Source*)0;
	};

	usize capacity = 4096;
	char* bytes = (char*)memory_allocate(compiler, capacity);
	usize maximum = (usize)(u64)18446744073709551615 / sizeof(Token) - 1;
	char[4096] chunk {};
	while (bytes) {
		usize count = fread((void*)&chunk[0], 1, sizeof(chunk), file);
		if (!count) {
			break;
		};
		if (count > maximum - source->length) {
			compiler_error(compiler, token, "source exceeds compiler address limits\0");
			break;
		};

		usize required = source->length + count + 1;
		if (required > capacity) {
			usize next_capacity := capacity;
			while (next_capacity < required) {
				if (next_capacity > maximum / 2) {
			next_capacity = required;
					break;
				};
				next_capacity = next_capacity * 2;
			};
			char* next = (char*)memory_allocate(compiler, next_capacity);
			if (!next) {
				break;
			};
			memcpy((void*)next, (void*)bytes, source->length);
			bytes = next;
			capacity = next_capacity;
		};

		memcpy((void*)(bytes + source->length), (void*)&chunk[0], count);
		source->length = source->length + count;
	};

	i32 failed = ferror(file);
	i32 closed = fclose(file);
	if (failed || closed || !bytes) {
		compiler_error(compiler, token, "cannot read source\0");
	};
	if (compiler->result == COMPILATION_FAILURE) {
		return (Source*)0;
	};
	bytes[source->length] = 0;
	source->bytes = bytes;
	return source;
};

fn backend_clear(Compiler* compiler) {
	if (compiler->llvm_layout) {
		LLVMDisposeTargetData(compiler->llvm_layout);
	};
	if (compiler->llvm_builder) {
		LLVMDisposeBuilder(compiler->llvm_builder);
	};
	if (compiler->llvm_module) {
		LLVMDisposeModule(compiler->llvm_module);
	};
	if (compiler->llvm_machine) {
		LLVMDisposeTargetMachine(compiler->llvm_machine);
	};
	if (compiler->llvm_context) {
		LLVMContextDispose(compiler->llvm_context);
	};

	while (compiler->allocations) {
		Allocation* allocation := compiler->allocations;
		compiler->allocations := allocation->next;
		free(allocation->memory);
		free((void*)allocation);
	};
	memset((void*)compiler, 0, sizeof(Compiler));
};

fn rutile_compiler_create() -> Compiler* {
	return (Compiler*)calloc(1, sizeof(Compiler));
};

fn rutile_compiler_destroy(Compiler* compiler) {
	if (!compiler) {
		return;
	};

	backend_clear(compiler);
	free((void*)compiler);
};

fn backend_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics, OutputKind output) -> i32 {
	if (!diagnostics) {
		diagnostics = platform_standard_error();
	};
	if (!compiler) {
		fputs("error: compiler context unavailable\n\0", diagnostics);
		return 1;
	};

	backend_clear(compiler);
	compiler->diagnostics = diagnostics;
	compiler->open_file = open_file;
	if (!compiler->open_file) {
		compiler->open_file = &fopen;
	};
	compiler->output = output;
	compiler->optimization := optimization;
	compiler->entry = "main\0";
	if (entry) {
		compiler->entry = memory_text(compiler, entry, strlen(entry));
	};
	Token token;
	if (optimization < 0 || optimization > 3) {
		compiler_error(compiler, token, "optimization level must be between 0 and 3\0");
	};
	if (!source_paths || !source_count) {
		compiler_error(compiler, token, "no source files\0");
	};
	if (!output_path) {
		compiler_error(compiler, token, "native object output path is required\0");
	};

	usize index = 0;
	Source* last;
	while (index < source_count && compiler->result != COMPILATION_FAILURE) {
		if (!source_paths[index] || !strcmp(source_paths[index], output_path)) {
			compiler_error(compiler, token, "output cannot overwrite a source file\0");
			break;
		};
		Source* source = source_read(compiler, source_paths[index]);
		if (!source) {
			break;
		};
		if (last) {
			last->next := source;
		}
		else {
			compiler->sources := source;
		};
		last = source;
		index = index + 1;
	};

	if (compiler->result != COMPILATION_FAILURE && backend_initialize(compiler)) {
		compiler_builtins(compiler, (i32)(LLVMPointerSize(compiler->llvm_layout) * 8));
		if (prepare_sources(compiler)) {
			Source* source := compiler->sources;
			Syntax* last_module;
			while (source && compiler->result != COMPILATION_FAILURE) {
				Syntax* module = parse_source(compiler, source);
				if (last_module) {
					last_module->next := module;
				}
				else {
					compiler->declarations := module;
				};
				last_module = module;
				source := source->next;
			};
		};
	};
	if (compiler->result != COMPILATION_FAILURE) {
		backend_analyze(compiler);
	};
	if (compiler->result != COMPILATION_FAILURE) {
		backend_emit(compiler);
	};
	if (compiler->result != COMPILATION_FAILURE && backend_optimize(compiler)) {
		backend_publish(compiler, output_path);
	};

	compiler->diagnostics = (void*)0;
	compiler->open_file = (((char*, char*) -> void*)*)0;
	return (i32)compiler->result;
};

fn rutile_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile(compiler, source_paths, source_count, output_path, open_file, entry, optimization, diagnostics, OUTPUT_EXECUTABLE);
};

fn rutile_compile_library(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile(compiler, source_paths, source_count, output_path, open_file, (char*)0, optimization, diagnostics, OUTPUT_LIBRARY);
};



