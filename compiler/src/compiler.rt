struct free_disposer {
};

fn free_disposer::dispose(void* pointer) {
	free($pointer);
};

template<typename T>
struct default_delete {
};

template<typename T>
fn default_delete<T>::dispose(T* pointer) {
	delete pointer;
};

template<typename T, typename Disposer = default_delete<T>>
struct unique_ptr {
	fn unique_ptr(unique_ptr& this) : [default];
	fn unique_ptr(unique_ptr& this, null* pointer);
	fn unique_ptr(unique_ptr& this, T* pointer);
	fn unique_ptr(unique_ptr& this, const unique_ptr& other) :[delete];
	fn operator=(unique_ptr& this, const unique_ptr& other) -> unique_ptr& :[delete];
	fn operator=(unique_ptr& this, unique_ptr other) -> unique_ptr&;
	fn ~unique_ptr(unique_ptr& this);

	fn get(const unique_ptr& this) -> T*;
	fn release(unique_ptr& this) -> T*;
	fn reset(unique_ptr& this, T* pointer);

	T* pointer;
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::unique_ptr(unique_ptr& this, null* pointer) {
	@this.pointer = $pointer;
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::unique_ptr(unique_ptr& this, T* pointer) {
	@this.pointer = $pointer;
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::operator=(unique_ptr& this, unique_ptr other) -> unique_ptr& {
	@this.reset(other.get());
	discard other;
	return @this;
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::~unique_ptr(unique_ptr& this) {
	if (!this.pointer) {
		return;
	};
	Disposer::dispose(T*(this.pointer));
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::get(const unique_ptr& this) -> T* {
	return T*(this.pointer);
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::release(unique_ptr& this) -> T* {
	T* pointer := this.pointer;
	@this.pointer = nullptr;
	return pointer;
};

template<typename T, typename Disposer>
fn unique_ptr<T, Disposer>::reset(unique_ptr& this, T* pointer) {
	T* previous := this.pointer;
	@this.pointer = $pointer;
	if (!previous) {
		return;
	};
	Disposer::dispose($previous);
};

template<typename T>
fn make_unique() -> unique_ptr<T> {
	return unique_ptr<T>(new T());
};

struct string_view {
	fn string_view(string_view& this) :[default];
	fn string_view(string_view& this, const char* data, usize size);
	fn string_view(string_view& this, const string& text) :[implicit];
	fn equal(const string_view& this, const string_view& other) -> bool;

	const char* data;
	usize size;
};

struct string {
	fn string(string& this) :[default];
	fn string(string& this, const string& other) :[delete];
	fn append(string& this, const string_view& text) -> bool;
	fn data(const string& this) -> const char*;
	fn release(string& this) -> char*;

	unique_ptr<char, free_disposer> storage;
	usize size;
	usize capacity;
};

fn string_view::string_view(string_view& this, const char* data, usize size) {
	@this.data = $data;
	@this.size = $size;
};

fn string_view::string_view(string_view& this, const string& text) {
	@this.data = text.data();
	@this.size := text.size;
};

fn string_view::equal(const string_view& this, const string_view& other) -> bool {
	return this.size == other.size && (!this.size || !memcmp(const char*(this.data), const char*(other.data), usize(this.size)));
};

fn string::data(const string& this) -> const char* {
	return this.storage.get();
};

fn string::release(string& this) -> char* {
	@this.size = 0;
	@this.capacity = 0;
	return @this.storage.release();
};

fn string::append(string& this, const string_view& text) -> bool {
	var maximum = ~usize(0);
	if (text.size > maximum - this.size - 1) {
		return false;
	};
	usize required = this.size + usize(text.size) + 1;
	if (required > this.capacity) {
		usize capacity := this.capacity;
		if (!capacity) {
			@capacity := required;
		};
		while (capacity < required) {
			if (capacity > maximum / 2) {
				@capacity := required;
				break;
			};
			@capacity = capacity * 2;
		};
		var memory = unique_ptr<char, free_disposer>((char*)malloc(usize(capacity)));
		if (!memory.get()) {
			return false;
		};
		if (this.size) {
			memcpy(memory.get(), this.storage.get(), usize(this.size));
		};
		memcpy(memory.get() + this.size, const char*(text.data), usize(text.size));
		@this.storage = $memory;
		@this.capacity := capacity;
	}
	else {
		memmove(this.storage.get() + this.size, const char*(text.data), usize(text.size));
	};
	@this.size = this.size + usize(text.size);
	@this.storage.pointer[this.size] = '\0';
	return true;
};

struct Arena {
	fn ~Arena(Arena& this);
	fn clear(Arena& this);
	fn adopt(Arena& this, void* memory) -> void*;

	Allocation* head;
};

fn Arena::~Arena(Arena& this) {
	@this.clear();
};

fn Arena::adopt(Arena& this, void* memory) -> void* {
	var storage = unique_ptr<void, free_disposer>($memory);
	if (!storage.get()) {
		return nullptr;
	};
	Allocation* allocation = (Allocation*)malloc(sizeof(Allocation));
	if (!allocation) {
		return nullptr;
	};
	void* result = @storage.release();
	@allocation->memory := result;
	@allocation->next := this.head;
	@this.head = $allocation;
	return result;
};

fn Arena::clear(Arena& this) {
	while (this.head) {
		Allocation* allocation := this.head;
		@this.head := allocation->next;
		free(void*(allocation->memory));
		free($allocation);
	};
};

// ============================================================================
// MODULE: IDENTITY MAP
// FUTURE FILE: core/identity_map.rt
// PURPOSE: Store arena-owned records by object identity and binding context.
// DEPENDS ON: Arena and C allocation.
// ============================================================================
template<typename T>
struct IdentityEntry {
	const void* key;
	const void* context;
	IdentityEntry* next;
	T value;
};

template<typename T>
struct IdentityMap {
	fn bucket(const IdentityMap& this, const void* key, const void* context) -> usize;
	fn find(IdentityMap& this, const void* key, const void* context) -> T*;
	fn define(IdentityMap& this, Arena& arena, const void* key, const void* context) -> T*;

	IdentityEntry<T>*[1024] buckets;
};

template<typename T>
fn IdentityMap<T>::bucket(const IdentityMap& this, const void* key, const void* context) -> usize {
	usize hash = ((usize)key >> 4) ^ (((usize)context >> 4) * 33);
	return hash % (sizeof(this.buckets) / sizeof(IdentityEntry<T>*));
};

template<typename T>
fn IdentityMap<T>::find(IdentityMap& this, const void* key, const void* context) -> T* {
	IdentityEntry<T>* entry := this.buckets[this.bucket((const void*)key, (const void*)context)];
	while (entry) {
		if (entry->key == key && entry->context == context) {
			return &entry->value;
		};
		@entry := entry->next;
	};
	return nullptr;
};

template<typename T>
fn IdentityMap<T>::define(IdentityMap& this, Arena& arena, const void* key, const void* context) -> T* {
	T* existing = @this.find((const void*)key, (const void*)context);
	if (existing) {
		return $existing;
	};

	IdentityEntry<T>* entry = (IdentityEntry<T>*)@arena.adopt(calloc(1, sizeof(IdentityEntry<T>)));
	if (!entry) {
		return nullptr;
	};
	usize bucket = this.bucket((const void*)key, (const void*)context);
	@entry->key = $key;
	@entry->context = $context;
	@entry->next := this.buckets[bucket];
	@this.buckets[bucket] := entry;
	return &entry->value;
};

