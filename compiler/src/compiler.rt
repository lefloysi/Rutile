fn LLVMMemoryBufferDisposer::dispose(LLVMOpaqueMemoryBuffer* handle) {
	LLVMDisposeMemoryBuffer($handle);
};

struct LLVMPassOptionsDisposer {
};

fn LLVMPassOptionsDisposer::dispose(LLVMOpaquePassBuilderOptions* handle) {
	LLVMDisposePassBuilderOptions($handle);
};

enum file_purpose : [i32] {
	source;
	object;
};

struct File {
	fn File(File& this, Compiler* compiler, char* path, file_purpose purpose, Token location);
	fn ~File(File& this);

	Compiler* compiler;
	void* handle;
	Token location;
	file_purpose purpose;
};

fn File::File(File& this, Compiler* compiler, char* path, file_purpose purpose, Token location) {
	@this.compiler = $compiler;
	@this.location = $location;
	@this.purpose := purpose;
	char* mode = "rb\0";
	char* failure = "cannot open source\0";
	if (purpose == file_purpose::object) {
		@mode = "wb\0";
		@failure = "cannot open native object output\0";
	};
	@this.handle = this.compiler->open_file($path, $mode);
	if (!this.handle) {
		compiler_error(@*this.compiler, this.location, (char*)failure);
	};
};

fn File::~File(File& this) {
	if (!this.handle) {
		return;
	};
	if (fclose(void*(this.handle))) {
		char* failure = "cannot read source\0";
		if (this.purpose == file_purpose::object) {
			@failure = "cannot write native object output\0";
		};
		compiler_error(@*this.compiler, this.location, (char*)failure);
	};
};

enum compilation_result : [i32] {
	success;
	failure;
};

enum output_kind : [i32] {
	executable;
	library;
};

// ============================================================================
// MODULE: BACKEND STATE
// FUTURE FILE: backend/context.rt
// PURPOSE: Own native entity representations, LLVM resources, and emission queues.
// DEPENDS ON: Entities, LLVM bindings, Compiler arena and allocation failure state.
// ============================================================================
struct BackendEntity {
	LLVMOpaqueValue* wrapper;
	LLVMOpaqueValue* value;
	LLVMOpaqueType* type;
	LLVMOpaqueType* body;
	RuntimeView* views;
};

struct BackendSyntax {
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* constructed;
};

struct BackendState {
	IdentityMap<BackendEntity> entities;
	IdentityMap<BackendSyntax> expressions;
	RuntimeView* runtime_views;
	RuntimeThunk* runtime_thunks;
	RuntimeWrapper* runtime_wrappers;
};

struct Backend :[BackendState] {
	fn clear(Backend& this);

	unique_ptr<LLVMOpaqueContext, LLVMContextDisposer> llvm_context;
	unique_ptr<LLVMOpaqueTargetMachine, LLVMTargetMachineDisposer> llvm_machine;
	unique_ptr<LLVMOpaqueModule, LLVMModuleDisposer> llvm_module;
	unique_ptr<LLVMOpaqueBuilder, LLVMBuilderDisposer> llvm_builder;
	unique_ptr<LLVMOpaqueTargetData, LLVMLayoutDisposer> llvm_layout;
};

struct SemanticState {
	IdentityMap<Type*> resolved_types;
};

struct CompilerState {
	Source* sources;
	Syntax* declarations;
	TemplateDeclaration* templates;
	Scope* module;
	((char* path, char* mode) -> void*)* open_file;
	void* diagnostics;
	char* entry;
	Type* void_type;
	Type* null_type;
	Type* bool_type;
	Type* i32_type;
	Type* usize_type;
	Type* char_type;
	DeclarationRule[4] declaration_rules;
	i32 optimization;
	compilation_result result;
	output_kind output;
};

struct Compiler :[CompilerState] {
	fn Compiler(Compiler& this);
	fn clear(Compiler& this);
	fn initialize(Compiler& this) -> i32;
	fn verify(Compiler& this) -> i32;
	fn optimize(Compiler& this) -> i32;
	fn analyze(Compiler& this);
	fn emit(Compiler& this);

	Arena allocations;
	Backend backend;
	SemanticState semantic;
};

fn Compiler::Compiler(Compiler& this) {
};

fn Backend::clear(Backend& this) {
	@this.llvm_layout.reset(nullptr);
	@this.llvm_builder.reset(nullptr);
	@this.llvm_module.reset(nullptr);
	@this.llvm_machine.reset(nullptr);
	@this.llvm_context.reset(nullptr);
	@((BackendState&)this) = BackendState();
};

fn Compiler::clear(Compiler& this) {
	@this.backend.clear();
	@this.semantic = SemanticState();
	@this.allocations.clear();
	@((CompilerState&)this) = CompilerState();
};

enum expression_context : [i32] {
	ordinary;
	argument;
};

struct Parser {
	Compiler* compiler;
	Scope* scope;
	Token* tokens;
	usize count;
	usize offset;
	usize pending_greater;
	expression_context context;
};

enum flow_kind : [i32] {
	function;
	loop;
	kw_switch;
};

struct Flow {
	Flow* parent;
	LLVMOpaqueBasicBlock* break_block;
	LLVMOpaqueBasicBlock* continue_block;
	flow_kind kind;
};

fn malloc(usize size) -> void*;
fn calloc(usize count, usize size) -> void*;
fn realloc(void* memory, usize size) -> void*;
fn free(void* memory);
fn memcpy(void* destination, const void* source, usize size) -> void*;
fn memmove(void* destination, const void* source, usize size) -> void*;
fn memset(void* destination, i32 value, usize size) -> void*;
fn memcmp(const void* first, const void* second, usize size) -> i32;
fn strlen(const char* text) -> usize;
fn strtod(char* text, char** end) -> f64;
fn trunc(f64 value) -> f64;
fn fopen(char* path, char* mode) -> void*;
fn fclose(void* file) -> i32;
fn fread(void* destination, usize size, usize count, void* file) -> usize;
fn fwrite(const void* source, usize size, usize count, void* file) -> usize;
fn ferror(void* file) -> i32;
fn fputs(const char* text, void* file) -> i32;
fn fprintf(void* file, const char* format, ...) -> i32;
fn strcmp(const char* first, const char* second) -> i32;
fn platform_standard_error() -> void*;

fn memory_allocate(Compiler& compiler, usize size) -> void* {
	void* memory = @compiler.allocations.adopt(calloc(1, $size));
	if (!memory) {
		@compiler.result = compilation_result::failure;
	};
	return memory;
};

template<typename T>
fn identity_record(Compiler& compiler, IdentityMap<T>& records, const void* key, const void* context) -> T* {
	T* record = @records.define(@compiler.allocations, $key, $context);
	if (!record) {
		@compiler.result = compilation_result::failure;
	};
	return $record;
};

fn memory_text(Compiler& compiler, const char* text, usize length) -> char* {
	char* copy = (char*)memory_allocate(@compiler, length + 1);
	if (!copy) {
		return nullptr;
	};

	memcpy(char*(copy), $text, $length);

	return $copy;
};

fn Token::text(const Token& this) -> string_view {
	if (!this.source) {
		return string_view();
	};
	return string_view(this.source->bytes.data + this.begin, usize(this.length));
};

fn token_is(const Token& token, const char* text) -> i32 {
	return token.source && token.text().equal(string_view(const char*(text), strlen(const char*(text))));
};

fn token_same(const Token& first, const Token& second) -> i32 {
	return first.source && second.source && first.text().equal(second.text());
};

fn compiler_error(Compiler& compiler, const Token& token, const char* message) {
	@compiler.result = compilation_result::failure;
	if (compiler.diagnostics) {
		const char* path = "<compiler>\0";
		if (token.source && token.source->path.data) {
			@path := token.source->path.data;
		};
		fprintf((void*)compiler.diagnostics, "%s:%llu:%llu: %s\n\0", $path, (u64)token.line, (u64)token.column, const char*(message));
	};
};

fn scope_create(Compiler& compiler, Scope* parent, context_kind context, Entity* owner) -> Scope* {
	Scope* scope = (Scope*)memory_allocate(@compiler, sizeof(Scope));
	if (!scope) {
		return nullptr;
	};

	@scope->compiler = &compiler;
	@scope->parent = $parent;
	@scope->context = $context;
	@scope->owner = $owner;
	@scope->bucket_count = 64;
	@scope->buckets = (Binding**)memory_allocate(@compiler, scope->bucket_count * sizeof(Binding*));
	if (!scope->buckets) {
		return nullptr;
	};

	return $scope;
};

fn token_hash(const Token& token) -> usize {
	usize hash = 5381;
	usize index = 0;

	while (index < token.length) {
		@hash = hash * 33 + (usize)token.source->bytes.data[token.begin + index];
		@index = index + 1;
	};

	return $hash;
};

fn scope_local(Scope* scope, const Token& name) -> Entity* {
	Binding* binding := scope->buckets[token_hash(name) % scope->bucket_count];

	while (binding) {
		if (token_same(binding->name, name)) {
			return (Entity*)binding->entity;
		};
		@binding := binding->hash_next;
	};

	return nullptr;
};

fn scope_lookup(Scope* scope, const Token& name) -> Entity* {
	while (scope) {
		Entity* entity = scope_local((Scope*)scope, name);
		if (entity) {
			return $entity;
		};
		if (scope->owner && scope->owner->kind == entity_kind::kw_struct) {
			@entity = associated_lookup(@*scope->compiler, (Entity*)scope->owner, name);
			if (entity || scope->compiler->result == compilation_result::failure) {
				return $entity;
			};
		};
		@scope := scope->parent;
	};

	return nullptr;
};

fn scope_bind_named(Compiler& compiler, Scope* scope, Token name, Entity* entity, Scope* declaration_scope, Source* source) -> i32 {
	Binding* binding = (Binding*)memory_allocate(@compiler, sizeof(Binding));
	if (!binding) {
		return 0;
	};

	usize bucket = token_hash(name) % scope->bucket_count;
	if (!entity->scope) {
		@entity->scope := scope;
	};
	@binding->name = $name;
	@binding->declaration_scope = $declaration_scope;
	@binding->source = $source;
	@binding->entity = $entity;
	@binding->hash_next := scope->buckets[bucket];
	@scope->buckets[bucket] := binding;
	if (scope->last_binding) {
		@scope->last_binding->next := binding;
	}
	else {
		@scope->bindings := binding;
	};
	@scope->last_binding = $binding;
	@scope->binding_count = scope->binding_count + 1;
	return 1;
};

fn scope_bind(Compiler& compiler, Scope* scope, Entity* entity) -> i32 {
	return scope_bind_named(@compiler, (Scope*)scope, Token(entity->name), (Entity*)entity, $scope, (Source*)entity->name.source);
};

fn scope_define(Compiler& compiler, Scope* scope, Entity* entity) -> i32 {
	if (scope_local((Scope*)scope, entity->name)) {
		compiler_error(@compiler, entity->name, "duplicate declaration\0");
		return 0;
	};

	return scope_bind(@compiler, $scope, $entity);
};

fn entity_create(Compiler& compiler, entity_kind kind, Token name) -> Entity* {
	Entity* entity = (Entity*)memory_allocate(@compiler, sizeof(Entity));
	if (!entity) {
		return nullptr;
	};

	@entity->kind = $kind;
	@entity->name = $name;
	if (entity->kind == entity_kind::function) {
		@entity->data.function.analysis = function_analysis::requested;
	};

	return $entity;
};

fn primitive_define(Compiler& compiler, char* name, type_kind kind, i32 bits) -> Type* {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen((char*)name);
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Type* type = (Type*)memory_allocate(@compiler, sizeof(Type));
	if (!type) {
		return nullptr;
	};

	if (kind == type_kind::kw_signed || kind == type_kind::kw_unsigned || kind == type_kind::kw_float) {
		@type->data.bits = (i32)bits;
	};
	@type->kind = $kind;
	Entity* entity = entity_create(@compiler, entity_kind::primitive, $token);
	if (!entity) {
		return nullptr;
	};

	@entity->state = resolution::ready;
	@entity->data.primitive.type := type;
	scope_define(@compiler, (Scope*)compiler.module, $entity);

	return $type;
};

fn boolean_define(Compiler& compiler, char* name, bool value) {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen((char*)name);
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Entity* entity = entity_create(@compiler, entity_kind::variable, $token);
	if (!entity) {
		return;
	};

	@entity->state = resolution::ready;
	@entity->data.variable.storage = storage_kind::constant;
	@entity->data.variable.type := compiler.bool_type;
	@entity->data.variable.data.integer = (u64)value;
	scope_define(@compiler, (Scope*)compiler.module, $entity);
};

fn compiler_builtins(Compiler& compiler, i32 pointer_bits) {
	declaration_rule_define(&compiler.declaration_rules[0], token_kind::kw_fn, entity_kind::function, context_kind::function);
	declaration_rule_define(&compiler.declaration_rules[1], token_kind::kw_struct, entity_kind::kw_struct, context_kind::kw_struct);
	declaration_rule_define(&compiler.declaration_rules[2], token_kind::kw_union, entity_kind::kw_union, context_kind::kw_union);
	declaration_rule_define(&compiler.declaration_rules[3], token_kind::kw_enum, entity_kind::kw_enum, context_kind::kw_enum);

	@compiler.module = scope_create(@compiler, nullptr, context_kind::module, nullptr);
	@compiler.void_type = primitive_define(@compiler, "void\0", type_kind::kw_void, 0);
	@compiler.null_type = primitive_define(@compiler, "null\0", type_kind::kw_null, 0);
	@compiler.bool_type = primitive_define(@compiler, "bool\0", type_kind::kw_bool, 0);
	boolean_define(@compiler, "false\0", false);
	boolean_define(@compiler, "true\0", true);
	@compiler.char_type = primitive_define(@compiler, "char\0", type_kind::kw_char, 0);
	primitive_define(@compiler, "i08\0", type_kind::kw_signed, 8);
	primitive_define(@compiler, "i16\0", type_kind::kw_signed, 16);
	@compiler.i32_type = primitive_define(@compiler, "i32\0", type_kind::kw_signed, 32);
	primitive_define(@compiler, "i64\0", type_kind::kw_signed, 64);
	primitive_define(@compiler, "u08\0", type_kind::kw_unsigned, 8);
	primitive_define(@compiler, "u16\0", type_kind::kw_unsigned, 16);
	primitive_define(@compiler, "u32\0", type_kind::kw_unsigned, 32);
	primitive_define(@compiler, "u64\0", type_kind::kw_unsigned, 64);
	@compiler.usize_type = primitive_define(@compiler, "usize\0", type_kind::kw_unsigned, $pointer_bits);
	primitive_define(@compiler, "f32\0", type_kind::kw_float, 32);
	primitive_define(@compiler, "f64\0", type_kind::kw_float, 64);
};

fn declaration_rule_define(DeclarationRule* rule, token_kind keyword, entity_kind entity, context_kind context) {
	@rule->keyword = $keyword;
	@rule->entity = $entity;
	@rule->context = $context;
};

fn declaration_rule(Compiler& compiler, token_kind token_kind) -> DeclarationRule* {
	usize count = sizeof(compiler.declaration_rules) / sizeof(DeclarationRule);
	usize index = 0;

	while (index < count) {
		if (compiler.declaration_rules[index].keyword == token_kind) {
			return &compiler.declaration_rules[index];
		};

		@index = index + 1;
	};

	return nullptr;
};

fn declaration_entity(Compiler& compiler, Scope* scope, entity_kind kind, const Token& name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, name);
	if (entity && entity->kind == entity_kind::kw_namespace && (kind == entity_kind::kw_struct || kind == entity_kind::kw_union)) {
		Scope* members = entity_members((Entity*)entity);
		@entity->kind := kind;
		@entity->state = resolution::pending;
		@entity->data.aggregate.type = nullptr;
		@entity->data.aggregate.scope = $members;
	};
	if (entity && entity->kind != kind) {
		compiler_error(@compiler, name, "conflicting declaration kind\0");
		return nullptr;
	};
	if (!entity) {
		@entity = entity_create(@compiler, (entity_kind)kind, Token(name));
		if (!entity) {
			return nullptr;
		};
		scope_define(@compiler, (Scope*)scope, (Entity*)entity);
	};
	if ((kind == entity_kind::kw_struct || kind == entity_kind::kw_union || kind == entity_kind::kw_enum) && !entity->data.aggregate.scope) {
		@entity->data.aggregate.scope = scope_create(@compiler, (Scope*)scope, context_kind::module, (Entity*)entity);
	};
	return $entity;
};

fn Parser::bases(Parser& this) -> BaseRelation* {
	BaseRelation* first = nullptr;
	BaseRelation* last = nullptr;
	while (true) {
		BaseRelation* base = (BaseRelation*)memory_allocate(@*this.compiler, sizeof(BaseRelation));
		if (@this.take(token_kind::kw_virtual)) {
			@base->kind = base_kind::kw_virtual;
		};
		@base->name = @this.name();
		if (last) {
			@last->next := base;
		}
		else {
			@first := base;
		};
		@last = $base;
		if (!@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	return $first;
};

fn namespace_define(Compiler& compiler, Scope* scope, Token name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, name);
	if (entity) {
		if (entity->kind != entity_kind::kw_namespace && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union) {
			compiler_error(@compiler, name, "namespace conflicts with another declaration\0");
			return nullptr;
		};
		return $entity;
	};

	@entity = entity_create(@compiler, entity_kind::kw_namespace, $name);
	if (!entity) {
		return nullptr;
	};
	@entity->data.namespace_entity.scope = scope_create(@compiler, (Scope*)scope, context_kind::module, (Entity*)entity);
	@entity->state = resolution::ready;
	scope_define(@compiler, $scope, (Entity*)entity);
	return $entity;
};

enum declaration_phase : [i32] {
	identities;
	members;
};

fn template_delimiter_end(Token* tokens, usize count, usize position) -> usize {
	usize depth = 0;
	usize grouping = 0;
	while (position < count) {
		token_kind kind := tokens[position].kind;
		if (kind == token_kind::punct_left_paren || kind == token_kind::punct_left_bracket || kind == token_kind::punct_left_brace) {
			@grouping = grouping + 1;
		};
		if (grouping && (kind == token_kind::punct_right_paren || kind == token_kind::punct_right_bracket || kind == token_kind::punct_right_brace)) {
			@grouping = grouping - 1;
		};
		if (grouping) {
			@position = position + 1;
			continue;
		};
		if (kind == token_kind::op_less) {
			@depth = depth + 1;
		}
		else if (kind == token_kind::op_greater || kind == token_kind::op_shift_right) {
			usize closing = 1;
			if (kind == token_kind::op_shift_right) {
				@closing = 2;
			};
			if (depth <= closing) {
				return position + 1;
			};
			@depth = depth - closing;
		};
		@position = position + 1;
	};
	return 0;
};

fn template_declaration_find(Compiler& compiler, Scope* scope, Token* tokens, usize start) -> TemplateDeclaration* {
	TemplateDeclaration* declaration := compiler.templates;
	while (declaration) {
		if (declaration->definition_scope == scope && declaration->tokens == tokens && declaration->start == start) {
			return declaration;
		};
		@declaration := declaration->next;
	};
	return nullptr;
};

fn Parser::template_register(Parser& this, Scope* scope, usize start) -> TemplateDeclaration* {
	TemplateDeclaration* existing = template_declaration_find(@*this.compiler, (Scope*)scope, (Token*)this.tokens, (usize)start);
	if (existing) {
		return existing;
	};
	if (scope->context != context_kind::module && scope->context != context_kind::kw_struct && scope->context != context_kind::kw_union) {
		compiler_error(@*this.compiler, this.tokens[start], "template declarations require module or aggregate scope\0");
		return nullptr;
	};
	Compiler& compiler = @*this.compiler;
	Token* tokens := this.tokens;
	usize count := this.count;
	if (start + 1 >= count || tokens[start + 1].kind != token_kind::op_less) {
		compiler_error(@compiler, tokens[start], "expected '<' after template\0");
		return nullptr;
	};
	usize end = template_delimiter_end((Token*)tokens, (usize)count, start + 1);
	if (!end || end >= count) {
		compiler_error(@compiler, tokens[start], "unterminated template parameter list\0");
		return nullptr;
	};
	if (end == start + 3) {
		compiler_error(@compiler, tokens[start], "explicit template specialization is not supported yet\0");
		return nullptr;
	};
	TemplateDeclaration* declaration = (TemplateDeclaration*)memory_allocate(@compiler, sizeof(TemplateDeclaration));
	@declaration->definition_scope := scope;
	@declaration->tokens := tokens;
	@declaration->count := count;
	@declaration->start := start;
	@declaration->begin := end;
	usize position = start + 2;
	TemplateParameter** link = &declaration->parameters;
	while (position + 1 < end) {
		TemplateParameter* parameter = (TemplateParameter*)memory_allocate(@compiler, sizeof(TemplateParameter));
		@parameter->tokens := tokens;
		@parameter->count := count;
		if (tokens[position].kind == token_kind::kw_typename || tokens[position].kind == token_kind::kw_class) {
			@parameter->kind = template_parameter_kind::type;
			@position = position + 1;
		}
		else {
			@parameter->kind = template_parameter_kind::value;
			@parameter->type_begin := position;
			@position = position + 1;
			while (position + 1 < end && tokens[position].kind != token_kind::identifier) {
				@position = position + 1;
			};
			@parameter->type_end := position;
		};
		if (position + 1 >= end || tokens[position].kind != token_kind::identifier) {
			compiler_error(@compiler, tokens[position], "expected template parameter name\0");
			return nullptr;
		};
		@parameter->name := tokens[position];
		TemplateParameter* previous := declaration->parameters;
		while (previous) {
			if (token_same(previous->name, parameter->name)) {
				compiler_error(@compiler, parameter->name, "duplicate template parameter\0");
				return nullptr;
			};
			@previous := previous->next;
		};
		@position = position + 1;
		if (tokens[position].kind == token_kind::op_assign) {
			@position = position + 1;
			@parameter->default_begin := position;
			usize depth = 0;
			while (position + 1 < end) {
				token_kind kind := tokens[position].kind;
				if (!depth && kind == token_kind::punct_comma) {
					break;
				};
				if (kind == token_kind::op_less || kind == token_kind::punct_left_paren || kind == token_kind::punct_left_bracket) {
					@depth = depth + 1;
				};
				if (depth && (kind == token_kind::op_greater || kind == token_kind::punct_right_paren || kind == token_kind::punct_right_bracket)) {
					@depth = depth - 1;
				};
				@position = position + 1;
			};
			@parameter->default_end := position;
		};
		@*link := parameter;
		@link = &parameter->next;
		if (position + 1 >= end) {
			break;
		};
		if (tokens[position].kind != token_kind::punct_comma) {
			compiler_error(@compiler, tokens[position], "expected ',' after template parameter\0");
			return nullptr;
		};
		@position = position + 1;
	};
	token_kind kind := tokens[end].kind;
	if (kind != token_kind::kw_struct && kind != token_kind::kw_union && kind != token_kind::kw_fn) {
		compiler_error(@compiler, tokens[end], "template requires a struct, union, or function declaration\0");
		return nullptr;
	};
	if (kind != token_kind::kw_fn) {
		TemplateParameter* parameter := declaration->parameters;
		TemplateParameter* defaulted = nullptr;
		while (parameter) {
			if (parameter->default_begin) {
				@defaulted := parameter;
			}
			else if (defaulted) {
				compiler_error(@compiler, parameter->name, "class template parameters after a default must also have defaults\0");
				return nullptr;
			};
			@parameter := parameter->next;
		};
	};
	@position = end + 1;
	if (tokens[position].kind != token_kind::identifier) {
		compiler_error(@compiler, tokens[position], "expected template declaration name\0");
		return nullptr;
	};
	Scope* owner := scope;
	template_declaration_role role = template_declaration_role::primary;
	Entity* pattern = scope_local((Scope*)owner, tokens[position]);
	while (tokens[position + 1].kind == token_kind::op_scope) {
		@owner = entity_members((Entity*)pattern);
		@position = position + 2;
		if (!owner) {
			compiler_error(@compiler, tokens[position], "qualified template owner has no scope\0");
			return nullptr;
		};
		@pattern = scope_local((Scope*)owner, tokens[position]);
	};
	if (kind == token_kind::kw_fn && tokens[position + 1].kind == token_kind::op_less) {
		@role = template_declaration_role::member;
		if (!pattern || pattern->kind != entity_kind::kw_template || pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
			compiler_error(@compiler, tokens[position], "template member requires a class template owner\0");
			return nullptr;
		};
	}
	else {
		if (pattern && pattern->kind != entity_kind::kw_template) {
			compiler_error(@compiler, tokens[position], "template conflicts with an existing entity\0");
			return nullptr;
		};
		if (!pattern) {
			@pattern = entity_create(@compiler, entity_kind::kw_template, Token(tokens[position]));
			@pattern->state = resolution::ready;
			@pattern->scope := owner;
			@pattern->data.template_pattern.declaration_kind := kind;
			@pattern->data.template_pattern.instances = scope_create(@compiler, (Scope*)owner, context_kind::module, (Entity*)pattern);
			scope_define(@compiler, (Scope*)owner, (Entity*)pattern);
		};
	};
	@declaration->pattern := pattern;
	@position := end;
	usize braces = 0;
	while (position < count) {
		token_kind current := tokens[position].kind;
		if (!braces && current == token_kind::punct_semicolon) {
			@position = position + 1;
			break;
		};
		if (current == token_kind::punct_left_brace) {
			@braces = braces + 1;
			if (role == template_declaration_role::primary && braces == 1) {
				if (pattern->data.template_pattern.definition && pattern->data.template_pattern.definition != declaration) {
					compiler_error(@compiler, tokens[start], "duplicate template definition\0");
					return nullptr;
				};
				@pattern->data.template_pattern.definition := declaration;
			};
		};
		if (current == token_kind::punct_right_brace && braces) {
			@braces = braces - 1;
		};
		if (current == token_kind::eof) {
			compiler_error(@compiler, tokens[start], "unterminated template declaration\0");
			return nullptr;
		};
		@position = position + 1;
	};
	@declaration->end := position;
	TemplateDeclaration** declaration_link = &compiler.templates;
	while (*declaration_link) {
		@declaration_link = &(*declaration_link)->next;
	};
	@*declaration_link := declaration;
	@declaration_link = &pattern->data.template_pattern.declarations;
	while (*declaration_link) {
		@declaration_link = &(*declaration_link)->pattern_next;
	};
	@*declaration_link := declaration;
	return declaration;
};

fn scope_identity_lookup(Scope* scope, const Token& name) -> Entity* {
	while (scope) {
		Entity* entity = scope_local((Scope*)scope, name);
		if (entity) {
			return $entity;
		};
		@scope := scope->parent;
	};
	return nullptr;
};

fn Parser::predeclare_range(Parser& this, Scope* scope, usize* position, declaration_phase phase) {
	while (*position + 1 < this.count && this.compiler->result != compilation_result::failure) {
		Token token := this.tokens[*position];
		if (token.kind == token_kind::kw_template) {
			TemplateDeclaration* declaration = @this.template_register((Scope*)scope, (usize)*position);
			if (!declaration) {
				return;
			};
			@*position := declaration->end;
			continue;
		};
		if (token.kind == token_kind::punct_right_brace || token.kind == token_kind::eof) {
			return;
		};
		if (token.kind == token_kind::kw_namespace) {
			@*position = *position + 1;
			Scope* members := scope;
			while (*position < this.count) {
				Token name := this.tokens[*position];
				if (name.kind != token_kind::identifier) {
					compiler_error(@*this.compiler, name, "expected namespace identifier\0");
					return;
				};
				Entity* entity = namespace_define(@*this.compiler, (Scope*)members, $name);
				if (!entity) {
					return;
				};
				@members = entity_members($entity);
				@*position = *position + 1;
				if (this.tokens[*position].kind != token_kind::op_scope) {
					break;
				};
				@*position = *position + 1;
			};
			if (this.tokens[*position].kind != token_kind::punct_left_brace) {
				compiler_error(@*this.compiler, this.tokens[*position], "expected namespace body\0");
				return;
			};
			@*position = *position + 1;
			@this.predeclare_range($members, (u64*)position, (declaration_phase)phase);
			@*position = *position + 1;
		}
		else {
			DeclarationRule* rule = declaration_rule(@*this.compiler, (token_kind)token.kind);
			Entity* declared = nullptr;
			if (rule && this.tokens[*position + 1].kind == token_kind::identifier) {
				usize name_position = *position + 1;
				Token name := this.tokens[name_position];
				Scope* owner := scope;
				while (name_position + 2 < this.count && this.tokens[name_position + 1].kind == token_kind::op_scope) {
					Entity* entity = nullptr;
					if (owner) {
						if (phase == declaration_phase::members) {
							@entity = scope_lookup((Scope*)owner, name);
						}
						else {
							@entity = scope_identity_lookup((Scope*)owner, name);
						};
					};
					@owner = entity_members($entity);
					@name_position = name_position + 2;
					if (rule->entity == entity_kind::function && this.tokens[name_position].kind == token_kind::op_tilde && name_position + 1 < this.count) {
						@name_position = name_position + 1;
					};
					@name := this.tokens[name_position];
				};
				if (owner) {
					i32 special = rule->entity == entity_kind::function && owner->owner && (owner->owner->kind == entity_kind::kw_struct || owner->owner->kind == entity_kind::kw_union) && (token_same(name, owner->owner->name) || token_is(name, "operator\0"));
					if (!special) {
						@declared = declaration_entity(@*this.compiler, (Scope*)owner, (entity_kind)rule->entity, name);
					};
					if (declared && declared->kind == entity_kind::kw_struct && !declared->data.aggregate.bases && name_position + 1 < this.count && this.tokens[name_position + 1].kind == token_kind::punct_colon) {
						Parser inheritance;
						@inheritance.compiler := this.compiler;
						@inheritance.scope := owner;
						@inheritance.tokens := this.tokens;
						@inheritance.count := this.count;
						@inheritance.offset = name_position + 2;
						@inheritance.require(token_kind::punct_left_bracket, "expected '[' after modifier colon\0");
						@declared->data.aggregate.bases = @inheritance.bases();
						@inheritance.require(token_kind::punct_right_bracket, "expected ']' after base relationships\0");
					};
				};
			};
			usize depth = 0;
			while (*position < this.count) {
				token_kind kind := this.tokens[*position].kind;
				if (!depth && (kind == token_kind::punct_semicolon || kind == token_kind::eof || kind == token_kind::punct_right_brace)) {
					break;
				};
				if (!depth && kind == token_kind::punct_left_brace && declared && (declared->kind == entity_kind::kw_struct || declared->kind == entity_kind::kw_union)) {
					@*position = *position + 1;
					@this.predeclare_range(entity_members((Entity*)declared), (u64*)position, (declaration_phase)phase);
					@*position = *position + 1;
					continue;
				};
				if (kind == token_kind::punct_left_brace) {
					@depth = depth + 1;
				};
				if (kind == token_kind::punct_right_brace && depth) {
					@depth = depth - 1;
				};
				@*position = *position + 1;
			};
		};
		if (this.tokens[*position].kind == token_kind::punct_semicolon) {
			@*position = *position + 1;
		};
	};
};

fn Parser::predeclare(Parser& this, declaration_phase phase) {
	usize position = 0;
	@this.predeclare_range((Scope*)this.scope, &position, $phase);
};

fn Lexer::peek(const Lexer& this, usize distance) -> char {
	if (this.offset + distance >= this.source->bytes.size) {
		return 0;
	};
	return (char)this.source->bytes.data[this.offset + distance];
};



fn Lexer::advance(Lexer& this) -> char {
	char value = this.peek(0);
	if (!value) {
		return 0;
	};

	@this.offset = this.offset + 1;
	if (value == '\n') {
		@this.line = this.line + 1;
		@this.column = 1;
	}
	else {
		@this.column = this.column + 1;
	};

	return $value;
};

fn lexer_alpha(char value) -> i32 {
	return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z') || value == '_';
};

fn lexer_digit(char value) -> i32 {
	return value >= '0' && value <= '9';
};

struct Keyword {
	fn Keyword(Keyword& this, char* text, token_kind kind);

	char* text;
	token_kind kind;
};

fn Keyword::Keyword(Keyword& this, char* text, token_kind kind) {
	@this.text = $text;
	@this.kind = $kind;
};

fn lexer_keywords(Keyword* keywords) {
	@keywords[0] = Keyword("fn\0", token_kind::kw_fn);
	@keywords[1] = Keyword("var\0", token_kind::kw_var);
	@keywords[2] = Keyword("struct\0", token_kind::kw_struct);
	@keywords[3] = Keyword("union\0", token_kind::kw_union);
	@keywords[4] = Keyword("enum\0", token_kind::kw_enum);
	@keywords[5] = Keyword("return\0", token_kind::kw_return);
	@keywords[6] = Keyword("if\0", token_kind::kw_if);
	@keywords[7] = Keyword("else\0", token_kind::kw_else);
	@keywords[8] = Keyword("while\0", token_kind::kw_while);
	@keywords[9] = Keyword("for\0", token_kind::kw_for);
	@keywords[10] = Keyword("switch\0", token_kind::kw_switch);
	@keywords[11] = Keyword("case\0", token_kind::kw_case);
	@keywords[12] = Keyword("default\0", token_kind::kw_default);
	@keywords[13] = Keyword("break\0", token_kind::kw_break);
	@keywords[14] = Keyword("continue\0", token_kind::kw_continue);
	@keywords[15] = Keyword("sizeof\0", token_kind::kw_sizeof);
	@keywords[16] = Keyword("namespace\0", token_kind::kw_namespace);
	@keywords[17] = Keyword("virtual\0", token_kind::kw_virtual);
	@keywords[18] = Keyword("override\0", token_kind::kw_override);
	@keywords[19] = Keyword("final\0", token_kind::kw_final);
	@keywords[20] = Keyword("const\0", token_kind::kw_const);
	@keywords[21] = Keyword("discard\0", token_kind::kw_discard);
	@keywords[22] = Keyword("delete\0", token_kind::kw_delete);
	@keywords[23] = Keyword("nullptr\0", token_kind::kw_nullptr);
	@keywords[24] = Keyword("template\0", token_kind::kw_template);
	@keywords[25] = Keyword("typename\0", token_kind::kw_typename);
	@keywords[26] = Keyword("class\0", token_kind::kw_class);
	@keywords[27] = Keyword("implicit\0", token_kind::kw_implicit);
	@keywords[28] = Keyword("new\0", token_kind::kw_new);
};

fn lexer_keyword(const Token& token, Keyword* keywords, usize count) -> token_kind {
	usize index = 0;

	while (index < count) {
		if (token_is(token, (char*)keywords[index].text)) {
			return (token_kind)keywords[index].kind;
		};
		@index = index + 1;
	};

	return token_kind::identifier;
};

fn lexer_operators(Keyword* operators) {
	@operators[0] = Keyword("...\0", token_kind::punct_ellipsis);
	@operators[1] = Keyword("->\0", token_kind::op_arrow);
	@operators[2] = Keyword(":=\0", token_kind::op_copy);
	@operators[3] = Keyword("==\0", token_kind::op_equal);
	@operators[4] = Keyword("!=\0", token_kind::op_not_equal);
	@operators[5] = Keyword("<=\0", token_kind::op_less_equal);
	@operators[6] = Keyword(">=\0", token_kind::op_greater_equal);
	@operators[7] = Keyword("&&\0", token_kind::op_and);
	@operators[8] = Keyword("||\0", token_kind::op_or);
	@operators[9] = Keyword("<<\0", token_kind::op_shift_left);
	@operators[10] = Keyword(">>\0", token_kind::op_shift_right);
	@operators[11] = Keyword("(\0", token_kind::punct_left_paren);
	@operators[12] = Keyword(")\0", token_kind::punct_right_paren);
	@operators[13] = Keyword("[\0", token_kind::punct_left_bracket);
	@operators[14] = Keyword("]\0", token_kind::punct_right_bracket);
	@operators[15] = Keyword("{\0", token_kind::punct_left_brace);
	@operators[16] = Keyword("}\0", token_kind::punct_right_brace);
	@operators[17] = Keyword(";\0", token_kind::punct_semicolon);
	@operators[18] = Keyword(",\0", token_kind::punct_comma);
	@operators[19] = Keyword("::\0", token_kind::op_scope);
	@operators[20] = Keyword(".\0", token_kind::op_dot);
	@operators[21] = Keyword("=\0", token_kind::op_assign);
	@operators[22] = Keyword("+\0", token_kind::op_plus);
	@operators[23] = Keyword("-\0", token_kind::op_minus);
	@operators[24] = Keyword("*\0", token_kind::op_star);
	@operators[25] = Keyword("/\0", token_kind::op_slash);
	@operators[26] = Keyword("%\0", token_kind::op_remainder);
	@operators[27] = Keyword("&\0", token_kind::op_ampersand);
	@operators[28] = Keyword("|\0", token_kind::op_pipe);
	@operators[29] = Keyword("^\0", token_kind::op_caret);
	@operators[30] = Keyword("!\0", token_kind::op_bang);
	@operators[31] = Keyword("~\0", token_kind::op_tilde);
	@operators[32] = Keyword("<\0", token_kind::op_less);
	@operators[33] = Keyword(">\0", token_kind::op_greater);
	@operators[34] = Keyword(":\0", token_kind::punct_colon);
	@operators[35] = Keyword("@\0", token_kind::op_access);
	@operators[36] = Keyword("$\0", token_kind::op_relocate);
};

fn Lexer::match_operator(Lexer& this, Token* token, Keyword* operators, usize count) -> i32 {
	usize index = 0;
	usize longest = 0;
	while (index < count) {
		usize length = strlen((char*)operators[index].text);
		if (length > longest && length <= this.source->bytes.size - token->begin && !memcmp((void*)(this.source->bytes.data + token->begin), (void*)operators[index].text, (u64)length)) {
			@longest = (u64)length;
			@token->kind := operators[index].kind;
		};
		@index = index + 1;
	};
	if (!longest) {
		return 0;
	};
	while (this.offset < token->begin + longest) {
		@this.advance();
	};
	return 1;
};

fn tokenize(Compiler& compiler, Source* source, Token** result, usize* count) -> i32 {
	Lexer lexer {
		@lexer.source := source;
		@lexer.offset = 0;
		@lexer.line = 1;
		@lexer.column = 1;
	};
	Token* tokens = (Token*)memory_allocate(@compiler, (source->bytes.size + 1) * sizeof(Token));
	usize used = 0;
	Keyword[29] keywords {};
	lexer_keywords(&keywords[0]);
	Keyword[37] operators {};
	lexer_operators(&operators[0]);
	usize operator_count = sizeof(operators) / sizeof(Keyword);
	while (true) {
		char value = lexer.peek(0);
		if (value == ' ' || value == '	' || value == '\n' || value == '\r') {
			@lexer.advance();
			continue;
		};
		if (value == '/' && lexer.peek(1) == '/') {
			while (lexer.peek(0) && lexer.peek(0) != '\n') {
				@lexer.advance();
			};
			continue;
		};
		Token token {
			@token.kind = token_kind::identifier;
			@token.length = 0;
			@token.source := source;
			@token.begin := lexer.offset;
			@token.line := lexer.line;
			@token.column := lexer.column;
		};
		if (value == '/' && lexer.peek(1) == '*') {
			@lexer.advance();
			@lexer.advance();
			while (lexer.peek(0) && !(lexer.peek(0) == '*' && lexer.peek(1) == '/')) {
				@lexer.advance();
			};
			if (!lexer.peek(0)) {
				compiler_error(@compiler, token, "unterminated comment\0");
				return 0;
			};
			@lexer.advance();
			@lexer.advance();
			continue;
		};
		if (!value) {
			if (lexer.offset < source->bytes.size) {
				compiler_error(@compiler, token, "NUL byte in source\0");
				return 0;
			};
			@token.kind = token_kind::eof;
			@tokens[used] := token;
			@*result := tokens;
			@*count = used + 1;
			return 1;
		};
		@lexer.advance();
		if (lexer_alpha((char)value)) {
			while (lexer_alpha(lexer.peek(0)) || lexer_digit(lexer.peek(0))) {
				@lexer.advance();
			};
			@token.length = lexer.offset - token.begin;
			@token.kind = lexer_keyword(token, &keywords[0], sizeof(keywords) / sizeof(Keyword));
		}
		else if (lexer_digit((char)value)) {
			@token.kind = token_kind::literal_number;
			while (lexer_digit(lexer.peek(0))) {
				@lexer.advance();
			};
			if (lexer.peek(0) == '.' && lexer_digit(lexer.peek(1))) {
				@lexer.advance();
				while (lexer_digit(lexer.peek(0))) {
					@lexer.advance();
				};
			};
			if (lexer.peek(0) == 'e' || lexer.peek(0) == 'E') {
				@lexer.advance();
				if (lexer.peek(0) == '+' || lexer.peek(0) == '-') {
					@lexer.advance();
				};
				if (!lexer_digit(lexer.peek(0))) {
					compiler_error(@compiler, token, "expected exponent digits\0");
					return 0;
				};
				while (lexer_digit(lexer.peek(0))) {
					@lexer.advance();
				};
			};
		}
		else if (value == '"') {
			@token.kind = token_kind::literal_string;
			while (lexer.peek(0) && lexer.peek(0) != '"') {
				if (lexer.peek(0) == '\n') {
					compiler_error(@compiler, token, "newline in string literal\0");
					return 0;
				};
				if (@lexer.advance() == '\\' && lexer.peek(0)) {
					@lexer.advance();
				};
			};
			if (!lexer.peek(0)) {
				compiler_error(@compiler, token, "unterminated string literal\0");
				return 0;
			};
			@lexer.advance();
		}
		else if (value == '\'') {
			@token.kind = token_kind::literal_number;
			char character = @lexer.advance();

			if (!character || character == '\'' || character == '\n' || character == '\r') {
				compiler_error(@compiler, token, "expected one character in literal\0");
				return 0;
			};

			if (character == '\\') {
				char escaped = @lexer.advance();

				if (!escaped || escaped == '\n' || escaped == '\r') {
					compiler_error(@compiler, token, "unterminated character escape\0");
					return 0;
				};
			};

			if (@lexer.advance() != '\'') {
				compiler_error(@compiler, token, "expected closing quote after character\0");
				return 0;
			};
		}
		else {
			if (!@lexer.match_operator(&token, &operators[0], (u64)operator_count)) {
				compiler_error(@compiler, token, "unknown source character\0");
				return 0;
			};
		};
		@token.length = lexer.offset - token.begin;
		@tokens[used] = $token;
		@used = used + 1;
	};
	return 0;
};

fn Parser::token(const Parser& this) -> Token {
	Token token := this.tokens[this.offset];
	if (this.pending_greater) {
		@token.kind = token_kind::op_greater;
		@token.begin = token.begin + 1;
		@token.length = 1;
		@token.column = token.column + 1;
	};
	return token;
};

fn Parser::at(const Parser& this, token_kind kind) -> i32 {
	return (this.token()).kind == kind;
};

fn Parser::take(Parser& this, token_kind kind) -> i32 {
	if (!this.at($kind)) {
		return 0;
	};

	if (this.offset + 1 < this.count) {
		@this.offset = this.offset + 1;
	};
	@this.pending_greater = 0;

	return 1;
};

fn Parser::require(Parser& this, token_kind kind, char* message) -> Token {
	Token token = this.token();

	if (!@this.take($kind)) {
		compiler_error(@*this.compiler, token, const char*(message));
	};

	return $token;
};

fn Parser::new_syntax(Parser& this, syntax_kind kind, Token token) -> Syntax* {
	Syntax* syntax = (Syntax*)memory_allocate(@*this.compiler, sizeof(Syntax));
	if (!syntax) {
		return nullptr;
	};

	@syntax->kind = $kind;
	@syntax->token = $token;

	return $syntax;
};

fn syntax_append(Syntax** first, Syntax** last, Syntax* node) {
	if (!node) {
		return;
	};

	if (*last) {
		(@*last)->next := node;
	}
	else {
		@*first := node;
	};
	@*last = $node;
};


fn Parser::signature_arrow(Parser& this, usize offset) -> usize {
	usize depth = 0;
	while (offset < this.count) {
		token_kind kind := this.tokens[offset].kind;
		if (kind == token_kind::punct_left_paren) {
			@depth = depth + 1;
		};
		if (kind == token_kind::punct_right_paren) {
			@depth = depth - 1;
			if (!depth) {
				if (offset + 1 < this.count && this.tokens[offset + 1].kind == token_kind::op_arrow) {
					return offset + 1;
				};
				return 0;
			};
		};
		@offset = offset + 1;
	};
	return 0;
};

fn entity_members(Entity* entity) -> Scope* {
	if (entity && entity->kind == entity_kind::primitive && entity->data.primitive.type->kind == type_kind::named) {
		return entity_members((Entity*)entity->data.primitive.type->data.entity);
	};
	if (entity && entity->kind == entity_kind::kw_template) {
		return (Scope*)entity->data.template_pattern.instances;
	};
	if (entity && entity->kind == entity_kind::kw_namespace) {
		return (Scope*)entity->data.namespace_entity.scope;
	};
	if (entity && (entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum)) {
		return (Scope*)entity->data.aggregate.scope;
	};
	return nullptr;
};

fn aggregate_header(Entity* entity) -> bool {
	return entity->data.aggregate.virtual_types || entity->data.aggregate.virtual_callables;
};

fn virtual_type_add(Compiler& compiler, Entity* owner, Entity* target) {
	VirtualType* current := owner->data.aggregate.virtual_types;
	VirtualType* last = nullptr;
	usize index = 0;
	while (current) {
		if (current->entity == target) {
			return;
		};
		@last := current;
		@current := current->next;
		@index = index + 1;
	};
	VirtualType* type = (VirtualType*)memory_allocate(@compiler, sizeof(VirtualType));
	@type->entity = $target;
	@type->index = $index;
	if (last) {
		@last->next = (VirtualType*)type;
	}
	else {
		@owner->data.aggregate.virtual_types = (VirtualType*)type;
	};
};

fn virtual_type_index(Entity* owner, Entity* target) -> usize {
	VirtualType* type := owner->data.aggregate.virtual_types;
	while (type && type->entity != target) {
		@type := type->next;
	};
	if (!type) {
		return 0;
	};
	return (u64)type->index;
};

fn bases_resolve(Compiler& compiler, Entity* record) {
	if (record->kind != entity_kind::kw_struct || record->data.aggregate.bases_resolution == resolution::ready) {
		return;
	};
	if (record->data.aggregate.bases_resolution == resolution::active) {
		compiler_error(@compiler, record->name, "cyclic base relationship\0");
		return;
	};
	@record->data.aggregate.bases_resolution = resolution::active;
	BaseRelation* base := record->data.aggregate.bases;
	usize component = 0;
	while (base && compiler.result != compilation_result::failure) {
		@base->entity = syntax_lookup((Scope*)record->scope, (Syntax*)base->name);
		if (!base->entity || base->entity->kind != entity_kind::kw_struct) {
			compiler_error(@compiler, base->name->token, "base relationship requires a struct entity\0");
			return;
		};
		BaseRelation* previous := record->data.aggregate.bases;
		while (previous != base) {
			if (previous->entity == base->entity) {
				compiler_error(@compiler, base->name->token, "duplicate direct base relationship\0");
				return;
			};
			@previous := previous->next;
		};
		bases_resolve(@compiler, (Entity*)base->entity);
		if (base->kind == base_kind::kw_virtual) {
			virtual_type_add(@compiler, (Entity*)record, (Entity*)base->entity);
		};
		VirtualType* inherited := base->entity->data.aggregate.virtual_types;
		while (inherited) {
			virtual_type_add(@compiler, (Entity*)record, (Entity*)inherited->entity);
			@inherited := inherited->next;
		};
		@base := base->next;
	};
	if (aggregate_header((Entity*)record)) {
		@component = 1;
	};
	@base := record->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@base->component := component;
			@component = component + 1;
		}
		else {
			@base->component = virtual_type_index((Entity*)record, (Entity*)base->entity);
		};
		@base := base->next;
	};
	@record->data.aggregate.bases_resolution = resolution::ready;
};

fn subobject_create(Compiler& compiler, CompleteGraph* graph, Entity* entity, subobject_kind kind) -> Subobject* {
	Subobject* object = (Subobject*)memory_allocate(@compiler, sizeof(Subobject));
	@object->entity = $entity;
	@object->kind := kind;
	if (graph->last_object) {
		@graph->last_object->next := object;
	}
	else {
		@graph->objects := object;
	};
	@graph->last_object := object;
	if (kind == subobject_kind::kw_virtual) {
		if (graph->last_virtual) {
			@object->component = graph->last_virtual->component + 1;
			@graph->last_virtual->virtual_next := object;
		}
		else {
			@object->component = 1;
			@graph->virtuals := object;
		};
		@graph->last_virtual := object;
	};
	return $object;
};


fn subobject_virtual(Compiler& compiler, CompleteGraph* graph, Entity* entity) -> Subobject* {
	Subobject* object := graph->virtuals;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->virtual_next;
	};
	@object = subobject_create(@compiler, (CompleteGraph*)graph, $entity, subobject_kind::kw_virtual);
	subobject_expand(@compiler, $graph, (Subobject*)object);
	return $object;
};

fn subobject_expand(Compiler& compiler, CompleteGraph* graph, Subobject* object) {
	BaseRelation* base := object->entity->data.aggregate.bases;
	SubobjectEdge* last = nullptr;
	while (base) {
		SubobjectEdge* edge = (SubobjectEdge*)memory_allocate(@compiler, sizeof(SubobjectEdge));
		@edge->relation := base;
		if (base->kind == base_kind::kw_virtual) {
			@edge->target = subobject_virtual(@compiler, (CompleteGraph*)graph, (Entity*)base->entity);
		}
		else {
			@edge->target = subobject_create(@compiler, (CompleteGraph*)graph, (Entity*)base->entity, subobject_kind::nonvirtual);
			subobject_expand(@compiler, (CompleteGraph*)graph, (Subobject*)edge->target);
		};
		if (last) {
			@last->next := edge;
		}
		else {
			@object->edges := edge;
		};
		@last = $edge;
		@base := base->next;
	};
};

fn complete_graph(Compiler& compiler, Entity* entity) -> CompleteGraph* {
	if (entity->data.aggregate.complete_graph) {
		return (CompleteGraph*)entity->data.aggregate.complete_graph;
	};
	bases_resolve(@compiler, (Entity*)entity);
	if (compiler.result == compilation_result::failure) {
		return nullptr;
	};
	CompleteGraph* graph = (CompleteGraph*)memory_allocate(@compiler, sizeof(CompleteGraph));
	@graph->entity := entity;
	@graph->root = subobject_create(@compiler, (CompleteGraph*)graph, (Entity*)entity, subobject_kind::root);
	@entity->data.aggregate.complete_graph := graph;
	subobject_expand(@compiler, (CompleteGraph*)graph, (Subobject*)graph->root);
	return $graph;
};

fn subobject_edge(Subobject* object, BaseRelation* relation) -> Subobject* {
	if (!object) {
		return nullptr;
	};
	SubobjectEdge* edge := object->edges;
	while (edge && edge->relation != relation) {
		@edge := edge->next;
	};
	if (!edge) {
		return nullptr;
	};
	return (Subobject*)edge->target;
};

fn subobject_path(Subobject* object, BasePath* path) -> Subobject* {
	while (path && object) {
		@object = subobject_edge((Subobject*)object, (BaseRelation*)path->relation);
		@path := path->next;
	};
	return $object;
};

struct SubobjectVisit {
	Subobject* object;
	SubobjectVisit* next;
};

fn base_paths_graph(Compiler& compiler, Subobject* object, Entity* target, BasePath* prefix, SubobjectVisit** visited, BaseSearch* result) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* current = (SubobjectVisit*)memory_allocate(@compiler, sizeof(SubobjectVisit));
	@current->object := object;
	@current->next := *visited;
	@*visited = $current;
	if (object->entity == target) {
		if (!result->count) {
			@result->path := prefix;
		};
		@result->count = result->count + 1;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* path = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
		@path->relation := edge->relation;
		if (prefix) {
			BasePath* first = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
			@*first := *prefix;
			BasePath* last := first;
			BasePath* next := prefix->next;
			while (next) {
				BasePath* copy = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
				@*copy := *next;
				@last->next := copy;
				@last = $copy;
				@next := next->next;
			};
			@last->next := path;
			@path = $first;
		};
		base_paths_graph(@compiler, (Subobject*)edge->target, (Entity*)target, $path, (SubobjectVisit**)visited, (BaseSearch*)result);
		@edge := edge->next;
	};
};

fn subobject_find_path(Compiler& compiler, Subobject* object, Subobject* target, BasePath** result) -> bool {
	if (object == target) {
		return true;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* tail = nullptr;
		if (subobject_find_path(@compiler, (Subobject*)edge->target, (Subobject*)target, &tail)) {
			BasePath* path = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
			@path->relation := edge->relation;
			@path->next = (BasePath*)tail;
			@*result = $path;
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn base_path_virtual(BasePath* path) -> bool {
	while (path) {
		if (path->relation->kind == base_kind::kw_virtual) {
			return true;
		};
		@path := path->next;
	};
	return false;
};

enum member_lookup_kind : [i32] {
	none;
	found;
	ambiguous;
};

struct LookupObject {
	Subobject* object;
	LookupObject* next;
};

struct MemberLookup {
	Entity* entity;
	LookupObject* objects;
	member_lookup_kind kind;
};

fn subobject_contains(Subobject* derived, Subobject* base) -> bool {
	if (derived == base) {
		return true;
	};
	SubobjectEdge* edge := derived->edges;
	while (edge) {
		if (subobject_contains((Subobject*)edge->target, (Subobject*)base)) {
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn lookup_dominates(LookupObject* derived, LookupObject* bases) -> bool {
	while (bases) {
		LookupObject* candidate := derived;
		while (candidate && !subobject_contains((Subobject*)candidate->object, (Subobject*)bases->object)) {
			@candidate := candidate->next;
		};
		if (!candidate) {
			return false;
		};
		@bases := bases->next;
	};
	return true;
};

fn lookup_objects_merge(Compiler& compiler, LookupObject** destination, LookupObject* source) {
	while (source) {
		LookupObject* existing := *destination;
		while (existing && existing->object != source->object) {
			@existing := existing->next;
		};
		if (!existing) {
			LookupObject* entry = (LookupObject*)memory_allocate(@compiler, sizeof(LookupObject));
			@entry->object := source->object;
			@entry->next := *destination;
			@*destination = $entry;
		};
		@source := source->next;
	};
};

fn member_find_object(Compiler& compiler, Subobject* object, const Token& name) -> MemberLookup {
	MemberLookup result;
	@result.entity = scope_local(entity_members((Entity*)object->entity), name);
	if (result.entity) {
		@result.kind = member_lookup_kind::found;
		@result.objects = (LookupObject*)memory_allocate(@compiler, sizeof(LookupObject));
		@result.objects->object := object;
		return $result;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		MemberLookup inherited = member_find_object(@compiler, (Subobject*)edge->target, name);
		if (inherited.kind == member_lookup_kind::none) {
			@edge := edge->next;
			continue;
		};
		if (result.kind == member_lookup_kind::none || lookup_dominates((LookupObject*)inherited.objects, (LookupObject*)result.objects)) {
			@result = MemberLookup(inherited);
		}
		else if (!lookup_dominates((LookupObject*)result.objects, (LookupObject*)inherited.objects)) {
			if (inherited.kind != member_lookup_kind::found || result.kind != member_lookup_kind::found || inherited.entity != result.entity) {
				@result.kind = member_lookup_kind::ambiguous;
				@result.entity = nullptr;
			};
			lookup_objects_merge(@compiler, &result.objects, (LookupObject*)inherited.objects);
		};
		@edge := edge->next;
	};
	return $result;
};

fn member_find(Compiler& compiler, Entity* owner, Token name) -> MemberLookup {
	if (owner->kind == entity_kind::kw_struct) {
		CompleteGraph* graph = complete_graph(@compiler, (Entity*)owner);
		if (graph) {
			return member_find_object(@compiler, (Subobject*)graph->root, name);
		};
	};
	MemberLookup result;
	@result.entity = scope_local(entity_members($owner), name);
	if (result.entity) {
		@result.kind = member_lookup_kind::found;
	};
	return $result;
};

fn associated_lookup(Compiler& compiler, Entity* owner, const Token& name) -> Entity* {
	MemberLookup result = member_find(@compiler, $owner, Token(name));
	if (result.kind == member_lookup_kind::ambiguous) {
		compiler_error(@compiler, name, "ambiguous inherited declaration\0");
		return nullptr;
	};
	return (Entity*)result.entity;
};

fn base_paths(Compiler& compiler, Entity* source, Entity* target, BaseSearch* result) {
	if (source == target) {
		@result->count = result->count + 1;
		return;
	};
	if (source->kind != entity_kind::kw_struct || target->kind != entity_kind::kw_struct) {
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $source);
	if (!graph) {
		return;
	};
	SubobjectVisit* visited = nullptr;
	base_paths_graph(@compiler, (Subobject*)graph->root, $target, nullptr, &visited, $result);
};

fn base_search(Compiler& compiler, Type* source, Type* target) -> BaseSearch {
	BaseSearch result;
	if (source && target && source->kind == type_kind::named && target->kind == type_kind::named) {
		base_paths(@compiler, (Entity*)source->data.entity, (Entity*)target->data.entity, &result);
	};
	return $result;
};

fn syntax_lookup(Scope* scope, Syntax* syntax) -> Entity* {
	if (!syntax) {
		return nullptr;
	};
	if (syntax->entity) {
		return (Entity*)syntax->entity;
	};
	if (syntax->kind == syntax_kind::expr_member) {
		Scope* members = entity_members(syntax_lookup((Scope*)scope, (Syntax*)syntax->data.member.object));
		if (!members) {
			return nullptr;
		};
		return associated_lookup(@*scope->compiler, (Entity*)members->owner, syntax->data.member.name);
	};
	if (syntax->kind != syntax_kind::expr_name) {
		return nullptr;
	};
	if (!syntax->data.expression) {
		return scope_lookup((Scope*)scope, syntax->token);
	};
	Scope* members = entity_members(syntax_lookup((Scope*)scope, (Syntax*)syntax->data.expression));
	if (!members) {
		return nullptr;
	};
	return associated_lookup(@*scope->compiler, (Entity*)members->owner, syntax->token);
};

fn template_arguments_equal(TemplateArgument* first, TemplateArgument* second) -> bool {
	while (first && second) {
		if (first->kind != second->kind || first->parameter != second->parameter || !type_equal((Type*)first->type, (Type*)second->type)) {
			return false;
		};
		if (first->kind == template_parameter_kind::value && first->value != second->value) {
			return false;
		};
		@first := first->next;
		@second := second->next;
	};
	return !first && !second;
};

fn template_bind(Compiler& compiler, Scope* scope, TemplateParameter* parameter, TemplateArgument* argument) {
	while (parameter && argument && compiler.result != compilation_result::failure) {
		if (!scope_local((Scope*)scope, parameter->name)) {
			entity_kind kind = entity_kind::primitive;
			if (parameter->kind == template_parameter_kind::value) {
				@kind = entity_kind::variable;
			};
			Entity* entity = entity_create(@compiler, $kind, Token(parameter->name));
			if (!entity) {
				return;
			};
			@entity->state = resolution::ready;
			@entity->template_parameter := argument->parameter;
			if (parameter->kind == template_parameter_kind::type) {
				@entity->data.primitive.type := argument->type;
			}
			else {
				@entity->data.variable.storage = storage_kind::constant;
				@entity->data.variable.type := argument->type;
				@entity->data.variable.data.integer := argument->value;
			};
			scope_define(@compiler, (Scope*)scope, $entity);
		};
		@parameter := parameter->next;
		@argument := argument->next;
	};
};

fn template_instance_name(Compiler& compiler, Token token, usize index) -> Token {
	char[22] digits {};
	@digits[sizeof(digits) - 1] = '\0';
	usize position = sizeof(digits) - 1;
	while (true) {
		@position = position - 1;
		@digits[position] = (char)((usize)'0' + index % 10);
		@index = index / 10;
		if (!index) {
			break;
		};
	};
	char* spelling = memory_text(@compiler, &digits[position], sizeof(digits) - position - 1);
	return token_synthetic(@compiler, $token, $spelling);
};

fn type_dependent(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == type_kind::parameter) {
		return true;
	};
	if (type->kind == type_kind::pointer || type->kind == type_kind::reference) {
		return type_dependent((Type*)type->data.element);
	};
	if (type->kind == type_kind::array) {
		return type_dependent((Type*)type->data.array.element);
	};
	if (type->kind == type_kind::named && type->data.entity->specialization) {
		TemplateArgument* argument := type->data.entity->specialization->arguments;
		while (argument) {
			if (argument->parameter || type_dependent((Type*)argument->type)) {
				return true;
			};
			@argument := argument->next;
		};
	};
	return false;
};

fn template_specialize(Compiler& compiler, Entity* pattern, TemplateArgument* arguments, const Token& token) -> Entity* {
	TemplateSpecialization* specialization := pattern->data.template_pattern.specializations;
	while (specialization) {
		if (template_arguments_equal((TemplateArgument*)specialization->arguments, (TemplateArgument*)arguments)) {
			return (Entity*)specialization->entity;
		};
		@specialization := specialization->next;
	};
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	Scope* instances := pattern->data.template_pattern.instances;
	Token name = template_instance_name(@compiler, Token(token), (usize)instances->binding_count);
	Entity* wrapper = nullptr;
	TemplateArgument* argument := arguments;
	while (argument) {
		if (argument->parameter || type_dependent((Type*)argument->type)) {
			@wrapper = entity_create(@compiler, entity_kind::kw_namespace, Token(name));
			@wrapper->state = resolution::ready;
			@wrapper->scope := instances;
			@wrapper->data.namespace_entity.scope = scope_create(@compiler, (Scope*)instances, context_kind::module, (Entity*)wrapper);
			break;
		};
		@argument := argument->next;
	};
	if (!wrapper) {
		@wrapper = namespace_define(@compiler, (Scope*)instances, Token(name));
	};
	if (!wrapper) {
		return nullptr;
	};
	Scope* scope = entity_members($wrapper);
	template_bind(@compiler, (Scope*)scope, (TemplateParameter*)declaration->parameters, (TemplateArgument*)arguments);
	@specialization = (TemplateSpecialization*)memory_allocate(@compiler, sizeof(TemplateSpecialization));
	@specialization->arguments := arguments;
	@specialization->scope := scope;
	@specialization->next := pattern->data.template_pattern.specializations;
	@pattern->data.template_pattern.specializations := specialization;
	Parser parser;
	@parser.compiler = &compiler;
	@parser.scope := scope;
	@parser.tokens := declaration->tokens;
	@parser.count = declaration->end + 1;
	@parser.offset := declaration->begin;
	usize position := declaration->begin;
	@parser.predeclare_range((Scope*)scope, &position, declaration_phase::identities);
	@specialization->entity = scope_local((Scope*)scope, pattern->name);
	if (!specialization->entity) {
		compiler_error(@compiler, token, "could not instantiate template declaration\0");
		return nullptr;
	};
	@specialization->entity->template_origin := pattern;
	@specialization->entity->specialization := specialization;
	@position := declaration->begin;
	@parser.predeclare_range((Scope*)scope, &position, declaration_phase::members);
	@parser.statement();
	TemplateDeclaration* extension := pattern->data.template_pattern.declarations;
	while (extension && compiler.result != compilation_result::failure) {
		if (extension != declaration && extension->tokens[extension->begin].kind == token_kind::kw_fn && pattern->data.template_pattern.declaration_kind != token_kind::kw_fn) {
			template_bind(@compiler, (Scope*)scope, (TemplateParameter*)extension->parameters, (TemplateArgument*)arguments);
			@parser.tokens := extension->tokens;
			@parser.count = extension->end + 1;
			@parser.offset := extension->begin;
			@parser.statement();
		};
		@extension := extension->pattern_next;
	};
	return (Entity*)specialization->entity;
};

fn template_validate(Compiler& compiler, Entity* pattern) {
	if (pattern->data.template_pattern.grammar != resolution::pending) {
		return;
	};
	@pattern->data.template_pattern.grammar = resolution::active;
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	Scope* scope = scope_create(@compiler, (Scope*)pattern->scope, context_kind::module, nullptr);
	TemplateArgument* arguments = nullptr;
	TemplateArgument** link = &arguments;
	TemplateParameter* parameter := declaration->parameters;
	while (parameter && compiler.result == compilation_result::success) {
		TemplateArgument* argument = (TemplateArgument*)memory_allocate(@compiler, sizeof(TemplateArgument));
		@argument->kind := parameter->kind;
		Entity* binding = entity_create(@compiler, entity_kind::primitive, Token(parameter->name));
		@binding->state = resolution::ready;
		@binding->template_parameter := parameter;
		if (parameter->kind == template_parameter_kind::type) {
			Type* type = type_new(@compiler, type_kind::parameter);
			@type->data.entity := binding;
			@binding->data.primitive.type := type;
			@argument->type := type;
		}
		else {
			Parser parser;
			@parser.compiler = &compiler;
			@parser.scope := scope;
			@parser.tokens := parameter->tokens;
			@parser.count := parameter->count;
			@parser.offset := parameter->type_begin;
			@binding->kind = entity_kind::variable;
			@binding->data.variable.storage = storage_kind::constant;
			@binding->data.variable.type = type_resolve(@compiler, (Scope*)scope, @parser.type());
			@binding->data.variable.data.integer = 1;
			if (!type_integer((Type*)binding->data.variable.type) && !type_dependent((Type*)binding->data.variable.type)) {
				compiler_error(@compiler, parameter->name, "non-type template parameter requires an integral type\0");
				return;
			};
			@argument->type := binding->data.variable.type;
			@argument->value = 1;
			@argument->parameter := parameter;
		};
		scope_define(@compiler, (Scope*)scope, $binding);
		@*link := argument;
		@link = &argument->next;
		@parameter := parameter->next;
	};
	template_specialize(@compiler, (Entity*)pattern, (TemplateArgument*)arguments, declaration->tokens[declaration->start]);
	@pattern->data.template_pattern.grammar = resolution::ready;
};

fn Parser::template_close(Parser& this) {
	if (!this.pending_greater && this.tokens[this.offset].kind == token_kind::op_shift_right) {
		@this.pending_greater = 1;
		return;
	};
	@this.require(token_kind::op_greater, "expected '>' after template arguments\0");
};

fn Parser::template_argument(Parser& this, TemplateParameter* parameter) -> TemplateArgument* {
	Compiler& compiler = @*this.compiler;
	TemplateArgument* argument = (TemplateArgument*)memory_allocate(@compiler, sizeof(TemplateArgument));
	@argument->kind := parameter->kind;
	if (parameter->kind == template_parameter_kind::type) {
		@argument->type = type_resolve(@compiler, (Scope*)this.scope, @this.type());
		return argument;
	};
	Parser declared;
	@declared.compiler = &compiler;
	@declared.scope := this.scope;
	@declared.tokens := parameter->tokens;
	@declared.count := parameter->count;
	@declared.offset := parameter->type_begin;
	@argument->type = type_resolve(@compiler, (Scope*)this.scope, @declared.type());
	if (!type_integer((Type*)argument->type)) {
		compiler_error(@compiler, parameter->name, "non-type template parameter requires an integral type\0");
		return argument;
	};
	expression_context context := this.context;
	@this.context = expression_context::argument;
	Syntax* value = @this.expression(1);
	@this.context = $context;
	if (value->kind == syntax_kind::expr_name) {
		Entity* entity = syntax_lookup((Scope*)this.scope, (Syntax*)value);
		if (entity) {
			@argument->parameter := entity->template_parameter;
		};
	};
	Semantic checking;
	@checking.compiler = &compiler;
	@checking.scope := this.scope;
	@checking.expression((Syntax*)value, (Type*)argument->type);
	@argument->value = constant_integer(@compiler, (Scope*)this.scope, (Syntax*)value);
	i32 bits = type_bits((Type*)argument->type);
	if (bits < 64) {
		u64 maximum = (u64)18446744073709551615 >> (u64)(64 - bits);
		if (type_unsigned((Type*)argument->type) || argument->type->kind == type_kind::kw_bool || argument->type->kind == type_kind::kw_char) {
			if (argument->value > maximum) {
				compiler_error(@compiler, value->token, "template argument is outside its parameter type range\0");
			};
		}
		else {
			@maximum = maximum / 2;
			i64 signed_value := (i64)argument->value;
			if (signed_value > (i64)maximum || signed_value < -(i64)maximum - 1) {
				compiler_error(@compiler, value->token, "template argument is outside its parameter type range\0");
			};
		};
	};
	return argument;
};

fn Parser::template_arguments(Parser& this, Entity* pattern, TemplateArgument** explicit_arguments) -> Entity* {
	Token token = @this.require(token_kind::op_less, "expected '<' before template arguments\0");
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	TemplateParameter* parameter := declaration->parameters;
	TemplateArgument* arguments = nullptr;
	TemplateArgument** link = &arguments;
	Scope* bindings = scope_create(@*this.compiler, (Scope*)this.scope, context_kind::local, nullptr);
	while (parameter && this.compiler->result != compilation_result::failure) {
		TemplateArgument* argument = nullptr;
		if (!this.at(token_kind::op_greater) && !this.at(token_kind::op_shift_right)) {
			@argument = @this.template_argument((TemplateParameter*)parameter);
		}
		else {
			if (!parameter->default_begin) {
				if (pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					break;
				};
				compiler_error(@*this.compiler, token, "not enough template arguments\0");
				return nullptr;
			};
			Parser defaults;
			@defaults.compiler := this.compiler;
			@defaults.scope := bindings;
			@defaults.tokens := parameter->tokens;
			@defaults.count := parameter->count;
			@defaults.offset := parameter->default_begin;
			@argument = @defaults.template_argument((TemplateParameter*)parameter);
		};
		@*link := argument;
		@link = &argument->next;
		template_bind(@*this.compiler, (Scope*)bindings, (TemplateParameter*)parameter, (TemplateArgument*)argument);
		@parameter := parameter->next;
		if (!@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	while (parameter && this.compiler->result != compilation_result::failure) {
		if (!parameter->default_begin) {
			if (pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
				break;
			};
			compiler_error(@*this.compiler, token, "not enough template arguments\0");
			return nullptr;
		};
		Parser defaults;
		@defaults.compiler := this.compiler;
		@defaults.scope := bindings;
		@defaults.tokens := parameter->tokens;
		@defaults.count := parameter->count;
		@defaults.offset := parameter->default_begin;
		TemplateArgument* argument = @defaults.template_argument((TemplateParameter*)parameter);
		@*link := argument;
		@link = &argument->next;
		template_bind(@*this.compiler, (Scope*)bindings, (TemplateParameter*)parameter, (TemplateArgument*)argument);
		@parameter := parameter->next;
	};
	@this.template_close();
	if (this.compiler->result == compilation_result::failure) {
		return nullptr;
	};
	@*explicit_arguments := arguments;
	if (parameter && pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
		return pattern;
	};
	return template_specialize(@*this.compiler, $pattern, (TemplateArgument*)arguments, token);
};

fn Parser::name_part(Parser& this) -> Syntax* {
	Token token = @this.require(token_kind::identifier, "expected identifier\0");
	Syntax* name = @this.new_syntax(syntax_kind::expr_name, $token);
	return name;
};

fn Parser::name(Parser& this) -> Syntax* {
	Syntax* name = @this.name_part();
	while (true) {
		Entity* entity = syntax_lookup((Scope*)this.scope, (Syntax*)name);
		if (entity && entity->template_origin && this.at(token_kind::op_less)) {
			@entity := entity->template_origin;
		};
		if (entity && entity->kind == entity_kind::kw_template && this.at(token_kind::op_less)) {
			@name->entity = @this.template_arguments((Entity*)entity, &name->template_arguments);
		};
		if (!@this.take(token_kind::op_scope)) {
			break;
		};
		if (@this.take(token_kind::op_tilde)) {
			Token member = @this.require(token_kind::identifier, "expected destructor type\0");
			if (!token_same(member, name->token)) {
				compiler_error(@*this.compiler, member, "destructor name must match its owning type\0");
			};
			Syntax* destruction = @this.new_syntax(syntax_kind::expr_destroy, Token(member));
			@destruction->data.cast.type := name;
			@this.require(token_kind::punct_left_paren, "expected '(' after destructor type\0");
			@destruction->data.cast.value = @this.expression(1);
			@this.require(token_kind::punct_right_paren, "destructor invocation requires exactly one receiver\0");
			return destruction;
		};
		Token member = @this.require(token_kind::identifier, "expected qualified identifier\0");
		Syntax* qualified = @this.new_syntax(syntax_kind::expr_name, $member);
		@qualified->data.expression := name;
		@name = $qualified;
	};
	return $name;
};

fn Parser::type_end(Parser& this, usize offset) -> usize {
	if (offset >= this.count) {
		return 0;
	};
	token_kind kind := this.tokens[offset].kind;
	if (kind == token_kind::kw_const) {
		return @this.type_end(offset + 1);
	};
	if (kind == token_kind::identifier) {
		usize name_begin := offset;
		Entity* entity = scope_lookup((Scope*)this.scope, this.tokens[offset]);
		@offset = offset + 1;
		while (entity) {
			if (entity->template_origin && offset < this.count && this.tokens[offset].kind == token_kind::op_less) {
				@entity := entity->template_origin;
			};
			if (entity->kind == entity_kind::kw_template && offset < this.count && this.tokens[offset].kind == token_kind::op_less) {
				if (entity->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					return 0;
				};
				@offset = template_delimiter_end((Token*)this.tokens, (usize)this.count, (usize)offset);
				if (!offset) {
					return 0;
				};
				if (offset < this.count && this.tokens[offset].kind == token_kind::op_scope) {
					Parser qualified;
					@qualified.compiler := this.compiler;
					@qualified.scope := this.scope;
					@qualified.tokens := this.tokens;
					@qualified.count := this.count;
					@qualified.offset := name_begin;
					Syntax* name = @qualified.name();
					Entity* member = syntax_lookup((Scope*)this.scope, (Syntax*)name);
					if (!member || (member->kind != entity_kind::primitive && member->kind != entity_kind::kw_struct && member->kind != entity_kind::kw_union && member->kind != entity_kind::kw_enum)) {
						return 0;
					};
					return @this.type_suffix_end((usize)qualified.offset);
				};
				return @this.type_suffix_end((usize)offset);
			};
			if (offset + 1 >= this.count || this.tokens[offset].kind != token_kind::op_scope || this.tokens[offset + 1].kind != token_kind::identifier) {
				break;
			};
			Scope* members = entity_members((Entity*)entity);
			if (!members) {
				return 0;
			};
			@entity = associated_lookup(@*this.compiler, (Entity*)members->owner, this.tokens[offset + 1]);
			@offset = offset + 2;
		};
		if (!entity) {
			return 0;
		};
		if (entity->kind == entity_kind::primitive || entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum) {
			return @this.type_suffix_end((u64)offset);
		};
		return 0;
	};
	if (kind != token_kind::punct_left_paren) {
		return 0;
	};

	usize arrow = @this.signature_arrow((u64)offset);
	if (!arrow) {
		usize end = @this.type_end(offset + 1);
		if (!end || end >= this.count || this.tokens[end].kind != token_kind::punct_right_paren) {
			return 0;
		};
		return @this.type_suffix_end(end + 1);
	};

	@offset = offset + 1;
	while (offset < arrow - 1) {
		if (this.tokens[offset].kind == token_kind::punct_ellipsis) {
			@offset = offset + 1;
			break;
		};
		@offset = @this.type_end((u64)offset);
		if (!offset || offset >= this.count) {
			return 0;
		};
		if (this.tokens[offset].kind == token_kind::identifier) {
			@offset = offset + 1;
		};
		if (offset == arrow - 1) {
			break;
		};
		if (offset >= this.count || this.tokens[offset].kind != token_kind::punct_comma) {
			return 0;
		};
		@offset = offset + 1;
	};
	if (offset != arrow - 1) {
		return 0;
	};
	return @this.type_end(arrow + 1);
};

fn Parser::type_suffix_end(Parser& this, usize offset) -> usize {
	while (offset < this.count) {
		token_kind kind := this.tokens[offset].kind;
		if (kind == token_kind::op_star || kind == token_kind::op_ampersand) {
			@offset = offset + 1;
			continue;
		};

		if (kind != token_kind::punct_left_bracket) {
			break;
		};
		if (offset + 2 >= this.count || (this.tokens[offset + 1].kind != token_kind::literal_number && this.tokens[offset + 1].kind != token_kind::identifier) || this.tokens[offset + 2].kind != token_kind::punct_right_bracket) {
			return 0;
		};

		@offset = offset + 3;
	};
	return $offset;
};

fn Parser::signature(Parser& this, Token token) -> Syntax* {
	Syntax* node = @this.new_syntax(syntax_kind::type_signature, $token);
	ParameterSyntax* last = nullptr;
	@this.require(token_kind::punct_left_paren, "expected '(' in signature\0");
	while (!this.at(token_kind::punct_right_paren) && !this.at(token_kind::eof) && this.compiler->result != compilation_result::failure) {
		if (@this.take(token_kind::punct_ellipsis)) {
			@node->data.signature.arity = parameter_arity::variadic;
			break;
		};
		ParameterSyntax* parameter = (ParameterSyntax*)memory_allocate(@*this.compiler, sizeof(ParameterSyntax));
		@parameter->type = @this.type();
		if (this.at(token_kind::identifier)) {
			@parameter->name = @this.require(token_kind::identifier, "expected parameter name\0");
		};
		if (last) {
			@last->next := parameter;
		}
		else {
			@node->data.signature.parameters := parameter;
		};
		@last = $parameter;
		if (!@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	@this.require(token_kind::punct_right_paren, "expected ')' after signature\0");
	if (@this.take(token_kind::op_arrow)) {
		@node->data.signature.result = @this.type();
	};
	return $node;
};

fn Parser::type(Parser& this) -> Syntax* {
	Token token = this.token();
	i32 constant = @this.take(token_kind::kw_const);
	Syntax* node;
	if (this.at(token_kind::punct_left_paren)) {
		if (@this.signature_arrow((u64)this.offset)) {
			return @this.signature(Token(token));
		};

		@this.take(token_kind::punct_left_paren);
		@node = @this.type();
		@this.require(token_kind::punct_right_paren, "expected ')' after grouped type\0");
	}
	else {
		@node = @this.name();
	};
	if (constant) {
		Syntax* qualified = @this.new_syntax(syntax_kind::kw_const, Token(token));
		@qualified->data.expression := node;
		@node = $qualified;
	};

	while (true) {
		Token modifier = this.token();
		if (@this.take(token_kind::op_star) || @this.take(token_kind::op_ampersand)) {
			syntax_kind kind = syntax_kind::type_pointer;
			if (modifier.kind == token_kind::op_ampersand) {
				@kind = syntax_kind::type_reference;
			};

			Syntax* modified = @this.new_syntax($kind, Token(modifier));
			@modified->data.expression := node;
			@node = $modified;
			continue;
		};

		if (!@this.take(token_kind::punct_left_bracket)) {
			break;
		};

		Syntax* modified = @this.new_syntax(syntax_kind::type_array, $modifier);
		@modified->data.array.count = this.token();
		if (!@this.take(token_kind::literal_number) && !@this.take(token_kind::identifier)) {
			compiler_error(@*this.compiler, modified->data.array.count, "array requires an explicit constant length\0");
		};
		@this.require(token_kind::punct_right_bracket, "expected ']' after array length\0");
		@modified->data.array.element := node;
		@node = $modified;
	};
	return $node;
};

fn literal_escape(Compiler& compiler, const Token& token, char value) -> char {
	switch (value) {
		case '0':
			return '\0';

		case 'n':
			return '\n';

		case 'r':
			return '\r';

		case 't':
			return '	';

		case '\\':
		case '"':
		case '\'':
			return $value;

		default:
			compiler_error(@compiler, token, "unsupported literal escape\0");
			return '\0';
	};
};

fn Parser::string(Parser& this, const Token& token) -> Syntax* {
	Syntax* node = @this.new_syntax(syntax_kind::literal_string, Token(token));
	char* bytes = (char*)memory_allocate(@*this.compiler, (u64)token.length);
	usize index = 1;
	usize length = 0;

	while (index + 1 < token.length) {
		char value := token.source->bytes.data[token.begin + index];
		@index = index + 1;

		if (value == '\\') {
			@value = literal_escape(@*this.compiler, token, (char)token.source->bytes.data[token.begin + index]);
			@index = index + 1;
		};

		@bytes[length] = $value;
		@length = length + 1;
	};

	@node->data.string = string_view($bytes, $length);
	return $node;
};

fn parser_precedence(token_kind operation) -> i32 {
	switch (operation) {
		case token_kind::op_assign:
			return 1;
		case token_kind::op_copy:
			return 1;
		case token_kind::op_or:
			return 2;
		case token_kind::op_and:
			return 3;
		case token_kind::op_pipe:
			return 4;
		case token_kind::op_caret:
			return 5;
		case token_kind::op_ampersand:
			return 6;
		case token_kind::op_equal:
			return 7;
		case token_kind::op_not_equal:
			return 7;
		case token_kind::op_less:
			return 8;
		case token_kind::op_greater:
			return 8;
		case token_kind::op_less_equal:
			return 8;
		case token_kind::op_greater_equal:
			return 8;
		case token_kind::op_shift_left:
			return 9;
		case token_kind::op_shift_right:
			return 9;
		case token_kind::op_plus:
			return 10;
		case token_kind::op_minus:
			return 10;
		case token_kind::op_star:
			return 11;
		case token_kind::op_slash:
			return 11;
		case token_kind::op_remainder:
			return 11;
		default:
			return 0;
	};
};

fn Parser::arguments(Parser& this, char* closing_message) -> Syntax* {
	Syntax* arguments = nullptr;
	Syntax* last = nullptr;
	while (!this.at(token_kind::punct_right_paren) && !this.at(token_kind::eof) && this.compiler->result != compilation_result::failure) {
		Syntax* argument = @this.expression(1);
		syntax_append(&arguments, &last, $argument);
		if (!@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	@this.require(token_kind::punct_right_paren, $closing_message);
	return $arguments;
};

fn Parser::typed_apply(Parser& this, Token token, char* opening_message) -> Syntax* {
	Syntax* application = @this.new_syntax(syntax_kind::expr_typed_apply, $token);
	@application->data.typed_apply.target = @this.type();
	@this.require(token_kind::punct_left_paren, $opening_message);
	@application->data.typed_apply.arguments = @this.arguments("expected ')' after construction arguments\0");
	return $application;
};

fn Parser::primary(Parser& this) -> Syntax* {
	Token token = this.token();
	usize type_end = @this.type_end((usize)this.offset);
	if (token.kind == token_kind::punct_left_paren && @this.signature_arrow((usize)this.offset)) {
		@type_end = 0;
	};
	if (type_end > this.offset + 1 && type_end < this.count && this.tokens[type_end].kind == token_kind::punct_left_paren && !(token.kind == token_kind::punct_left_paren && this.tokens[type_end - 1].kind == token_kind::punct_right_paren)) {
		return @this.typed_apply(Token(token), "expected '(' after construction type\0");
	};
	if (this.at(token_kind::identifier)) {
		return @this.name();
	};
	if (@this.take(token_kind::kw_nullptr)) {
		return @this.new_syntax(syntax_kind::kw_nullptr, $token);
	};
	if (@this.take(token_kind::literal_number)) {
		return @this.new_syntax(syntax_kind::literal_number, $token);
	};
	if (@this.take(token_kind::literal_string)) {
		return @this.string(token);
	};
	if (this.at(token_kind::punct_left_brace)) {
		return @this.block();
	};
	if (@this.take(token_kind::punct_left_paren)) {
		expression_context context := this.context;
		@this.context = expression_context::ordinary;
		Syntax* node = @this.expression(1);
		@this.context = $context;
		@this.require(token_kind::punct_right_paren, "expected ')' after expression\0");
		return $node;
	};
	compiler_error(@*this.compiler, token, "expected expression\0");
	return @this.new_syntax(syntax_kind::literal_number, $token);
};

fn Parser::type_at(Parser& this, usize offset) -> i32 {
	return !!@this.type_end($offset);
};

fn Parser::unary(Parser& this) -> Syntax* {
	Token token = this.token();
	if (@this.take(token_kind::kw_new)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_new, Token(token));
		@node->data.expression = @this.typed_apply(Token(token), "expected '(' after allocated type\0");
		return $node;
	};
	if (@this.take(token_kind::kw_delete)) {
		syntax_kind kind = syntax_kind::kw_delete;
		if (@this.take(token_kind::kw_discard)) {
			@kind = syntax_kind::expr_delete_discard;
		};
		Syntax* node = @this.new_syntax($kind, Token(token));
		@node->data.expression = @this.unary();
		return $node;
	};
	if (@this.take(token_kind::kw_discard)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_discard, Token(token));
		@node->data.expression = @this.name();
		return $node;
	};
	if (@this.take(token_kind::op_access) || @this.take(token_kind::op_relocate)) {
		syntax_kind kind = syntax_kind::expr_access;
		if (token.kind == token_kind::op_relocate) {
			@kind = syntax_kind::expr_relocate;
		};
		Syntax* node = @this.new_syntax($kind, Token(token));
		@node->data.expression = @this.unary();
		return $node;
	};
	if (@this.take(token_kind::kw_sizeof)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_sizeof, Token(token));
		@this.require(token_kind::punct_left_paren, "expected '(' after sizeof\0");
		if (@this.type_at((u64)this.offset)) {
			@node->data.expression = @this.type();
		}
		else {
			@node->data.expression = @this.expression(1);
		};
		@this.require(token_kind::punct_right_paren, "expected ')' after sizeof operand\0");
		return $node;
	};
	if (@this.take(token_kind::op_plus) || @this.take(token_kind::op_minus) || @this.take(token_kind::op_bang) || @this.take(token_kind::op_tilde) || @this.take(token_kind::op_star) || @this.take(token_kind::op_ampersand)) {
		Syntax* node = @this.new_syntax(syntax_kind::expr_unary, Token(token));
		@node->data.unary.operation := token.kind;
		@node->data.unary.value = @this.unary();
		return $node;
	};
	usize cast_end = 0;
	usize construction_end = @this.type_end((usize)this.offset);
	if (token.kind == token_kind::punct_left_paren && @this.signature_arrow((usize)this.offset)) {
		@construction_end = 0;
	};
	if (this.at(token_kind::punct_left_paren) && !(construction_end && construction_end < this.count && this.tokens[construction_end].kind == token_kind::punct_left_paren && this.tokens[construction_end - 1].kind != token_kind::punct_right_paren)) {
		@cast_end = @this.type_end(this.offset + 1);
	};
	if (cast_end && cast_end < this.count && this.tokens[cast_end].kind == token_kind::punct_right_paren) {
		@this.take(token_kind::punct_left_paren);
		Syntax* node = @this.new_syntax(syntax_kind::expr_cast, Token(token));
		@node->data.cast.type = @this.type();
		@this.require(token_kind::punct_right_paren, "expected ')' after cast type\0");
		@node->data.cast.value = @this.unary();
		return $node;
	};
	Syntax* value = @this.primary();
	while (this.compiler->result != compilation_result::failure) {
		Token operation = this.token();
		if (@this.take(token_kind::punct_left_paren)) {
			Syntax* call = @this.new_syntax(syntax_kind::expr_call, Token(operation));
			@call->data.call.callable := value;
			@call->data.call.arguments = @this.arguments("expected ')' after arguments\0");
			@value = $call;
		}
		else if (@this.take(token_kind::punct_left_bracket)) {
			Syntax* index = @this.new_syntax(syntax_kind::expr_index, Token(operation));
			@index->data.binary.left := value;
			@index->data.binary.right = @this.expression(1);
			@this.require(token_kind::punct_right_bracket, "expected ']' after index\0");
			@value = $index;
		}
		else if (@this.take(token_kind::op_dot) || @this.take(token_kind::op_arrow)) {
			if (@this.take(token_kind::op_tilde)) {
				Syntax* destruction = @this.new_syntax(syntax_kind::expr_destroy, Token(operation));
				if (operation.kind == token_kind::op_arrow) {
					Syntax* object = @this.new_syntax(syntax_kind::expr_unary, Token(operation));
					@object->data.unary.operation = token_kind::op_star;
					@object->data.unary.value := value;
					@value = $object;
				};
				@destruction->data.cast.value := value;
				@destruction->data.cast.type = @this.name();
				@this.require(token_kind::punct_left_paren, "expected '(' after destructor type\0");
				@this.require(token_kind::punct_right_paren, "destructor invocation takes no arguments\0");
				@value = $destruction;
				continue;
			};
			Syntax* member = @this.new_syntax(syntax_kind::expr_member, Token(operation));
			@member->data.member.object := value;
			Syntax* path = @this.name();
			@member->data.member.name := path->token;
			@member->data.member.qualifier := path->data.expression;
			@value = $member;
		}
		else {
			break;
		};
	};
	return $value;
};

fn Parser::expression(Parser& this, i32 minimum) -> Syntax* {
	Syntax* left = @this.unary();
	while (this.compiler->result != compilation_result::failure) {
		Token operation = this.token();
		if (this.context == expression_context::argument && (operation.kind == token_kind::op_greater || operation.kind == token_kind::op_shift_right)) {
			break;
		};
		i32 precedence = parser_precedence((token_kind)operation.kind);
		if (precedence < minimum) {
			break;
		};
		@this.take((token_kind)operation.kind);
		i32 next = precedence + 1;
		if (operation.kind == token_kind::op_assign || operation.kind == token_kind::op_copy) {
			@next = (i32)precedence;
		};
		Syntax* node = @this.new_syntax(syntax_kind::expr_binary, Token(operation));
		@node->data.binary.operation := operation.kind;
		@node->data.binary.left := left;
		@node->data.binary.right = @this.expression($next);
		@left = $node;
	};
	return $left;
};

fn Parser::variable(Parser& this) -> Syntax* {
	Token token = this.token();
	Syntax* node = @this.new_syntax(syntax_kind::node_declaration, $token);
	if (!@this.take(token_kind::kw_var)) {
		@node->data.declaration.type = @this.type();
	};
	@node->data.declaration.name = @this.require(token_kind::identifier, "expected declaration identifier\0");
	@node->entity = entity_create(@*this.compiler, entity_kind::variable, Token(node->data.declaration.name));
	@node->entity->declaration := node;
	if (this.scope->context == context_kind::module) {
		@node->entity->data.variable.storage = storage_kind::global;
	};
	if (this.scope->context == context_kind::kw_struct || this.scope->context == context_kind::kw_union) {
		@node->entity->data.variable.storage = storage_kind::field;
	};
	if (this.scope->context == context_kind::module || this.scope->context == context_kind::kw_struct || this.scope->context == context_kind::kw_union) {
		scope_define(@*this.compiler, (Scope*)this.scope, (Entity*)node->entity);
	}
	else {
		scope_bind(@*this.compiler, (Scope*)this.scope, (Entity*)node->entity);
	};
	if (this.at(token_kind::punct_left_brace)) {
		@node->data.declaration.body = @this.block();
		@node->data.declaration.body->scope->context = context_kind::initialization;
		@node->data.declaration.body->scope->owner := node->entity;
	};
	if (this.at(token_kind::op_copy) || this.at(token_kind::op_assign)) {
		Token operation = this.token();
		@this.take((token_kind)operation.kind);
		Syntax* block = @this.new_syntax(syntax_kind::node_block, Token(operation));
		@block->scope = scope_create(@*this.compiler, (Scope*)this.scope, context_kind::initialization, (Entity*)node->entity);
		Syntax* assignment = @this.new_syntax(syntax_kind::stmt_initialize, Token(operation));
		@assignment->data.binary.access = initialization_access::access;
		@assignment->data.binary.operation := operation.kind;
		@assignment->data.binary.left = @this.new_syntax(syntax_kind::expr_name, Token(node->data.declaration.name));
		@assignment->data.binary.left->entity := node->entity;
		@assignment->data.binary.right = @this.expression(1);
		@block->data.statements = $assignment;
		@node->data.declaration.body = $block;
	};
	@this.require(token_kind::punct_semicolon, "expected ';' after variable declaration\0");
	return $node;
};

fn Parser::declaration_start(Parser& this) -> i32 {
	if (this.at(token_kind::kw_var)) {
		return 1;
	};

	usize end = @this.type_end((u64)this.offset);
	if (end && this.at(token_kind::punct_left_paren) && this.tokens[end - 1].kind == token_kind::punct_right_paren) {
		return 0;
	};
	return end && end < this.count && this.tokens[end].kind == token_kind::identifier;
};

fn Parser::enum_block(Parser& this) -> Syntax* {
	Token token = @this.require(token_kind::punct_left_brace, "expected '{' after enum name\0");
	Syntax* block = @this.new_syntax(syntax_kind::node_block, $token);
	@block->scope := this.scope;
	Syntax* last = nullptr;
	while (!this.at(token_kind::punct_right_brace) && !this.at(token_kind::eof) && this.compiler->result != compilation_result::failure) {
		if (this.at(token_kind::kw_fn)) {
			Syntax* function = @this.named_declaration(declaration_rule(@*this.compiler, token_kind::kw_fn));
			syntax_append(&block->data.statements, &last, $function);
			continue;
		};
		Token name = @this.require(token_kind::identifier, "expected enum member identifier\0");
		Syntax* node = @this.new_syntax(syntax_kind::node_declaration, Token(name));
		@node->entity = entity_create(@*this.compiler, entity_kind::variable, Token(name));
		@node->data.declaration.name = $name;
		@node->entity->data.variable.storage = storage_kind::constant;
		@node->entity->declaration := node;
		scope_define(@*this.compiler, (Scope*)this.scope, (Entity*)node->entity);
		if (@this.take(token_kind::op_assign)) {
			@node->data.declaration.body = @this.expression(2);
		};
		syntax_append(&block->data.statements, &last, $node);
		if (!@this.take(token_kind::punct_semicolon) && !@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	@this.require(token_kind::punct_right_brace, "expected '}' after enum members\0");
	return $block;
};

fn token_synthetic(Compiler& compiler, Token location, const char* spelling) -> Token {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return $location;
	};
	@source->path := location.source->path;
	@source->bytes.size = strlen(const char*(spelling));
	@source->bytes.data = $spelling;
	@location.source = $source;
	@location.begin = 0;
	@location.length := location.source->bytes.size;
	@location.kind = token_kind::identifier;
	return $location;
};

fn Parser::receiver(Parser& this, Syntax* signature, Entity* owner) {
	ParameterSyntax* first := signature->data.signature.parameters;
	if (first && token_is(first->name, "this\0")) {
		return;
	};
	compiler_error(@*this.compiler, signature->token, "instance function requires an explicit 'this' reference parameter\0");
};

fn special_functions(Entity* owner, function_role role) -> Entity** {
	if (role == function_role::constructor) {
		return &owner->data.aggregate.constructors;
	};
	if (role == function_role::assignment) {
		return &owner->data.aggregate.assignments;
	};
	return &owner->data.aggregate.destructor;
};

fn Parser::special_register(Parser& this, Scope* owner, Syntax* declaration) {
	Entity* function := declaration->entity;
	function_role role := function->data.function.role;
	Type* signature = type_resolve(@*this.compiler, (Scope*)owner, (Syntax*)declaration->data.declaration.type);
	Entity** tail = special_functions((Entity*)owner->owner, (function_role)role);
	usize index = 0;
	while (*tail) {
		Entity* existing := *tail;
		Type* other = type_resolve(@*this.compiler, (Scope*)owner, (Syntax*)existing->declaration->data.declaration.type);
		if (type_equal((Type*)signature, $other)) {
			if (declaration->data.declaration.definition != function_definition::declaration && existing->declaration->data.declaration.definition != function_definition::declaration) {
				compiler_error(@*this.compiler, declaration->token, "duplicate special function definition\0");
				return;
			};
			if (function->data.function.conversion == constructor_conversion::kw_implicit) {
				@existing->data.function.conversion = constructor_conversion::kw_implicit;
			};
			@declaration->entity := existing;
			if (declaration->data.declaration.definition != function_definition::declaration) {
				@existing->declaration := declaration;
				if (declaration->data.declaration.body) {
					@declaration->data.declaration.body->scope->owner := existing;
				};
			};
			return;
		};
		@index = index + 1;
		@tail = &existing->data.function.overload_next;
	};
	if (role == function_role::destructor && index) {
		compiler_error(@*this.compiler, declaration->token, "a type has exactly one destructor signature\0");
		return;
	};
	@function->data.function.overload_index = $index;
	@*tail := function;
	Token alias = token_synthetic(@*this.compiler, Token(function->name), "<special-function>\0");
	scope_bind_named(@*this.compiler, (Scope*)owner, $alias, $function, $owner, (Source*)declaration->token.source);
};

fn Parser::block_scope(Parser& this, Scope* scope) -> Syntax* {
	Token token = @this.require(token_kind::punct_left_brace, "expected '{'\0");
	Syntax* node = @this.new_syntax(syntax_kind::node_block, $token);
	Scope* outer := this.scope;
	@node->scope := scope;
	@this.scope = $scope;
	Syntax* last = nullptr;
	while (!this.at(token_kind::punct_right_brace) && !this.at(token_kind::eof) && this.compiler->result != compilation_result::failure) {
		Syntax* statement = @this.statement();
		syntax_append(&node->data.statements, &last, $statement);
	};
	@this.require(token_kind::punct_right_brace, "expected '}' after block\0");
	@this.scope = $outer;
	return $node;
};

fn Parser::function_name(Parser& this, function_role* role) -> Syntax* {
	if (@this.take(token_kind::op_tilde)) {
		@*role = function_role::destructor;
	};
	Token token = @this.require(token_kind::identifier, "expected function identifier\0");
	Syntax* name = @this.new_syntax(syntax_kind::expr_name, $token);
	while (true) {
		Entity* entity = syntax_lookup((Scope*)this.scope, (Syntax*)name);
		if (entity && entity->template_origin && this.at(token_kind::op_less)) {
			@entity := entity->template_origin;
		};
		if (entity && entity->kind == entity_kind::kw_template && this.at(token_kind::op_less)) {
			@name->entity = @this.template_arguments((Entity*)entity, &name->template_arguments);
		};
		if (!@this.take(token_kind::op_scope)) {
			break;
		};
		if (*role == function_role::destructor) {
			compiler_error(@*this.compiler, name->token, "destructor name must be the final qualified component\0");
			return $name;
		};
		if (@this.take(token_kind::op_tilde)) {
			@*role = function_role::destructor;
		};
		Token member = @this.require(token_kind::identifier, "expected qualified function identifier\0");
		Syntax* qualified = @this.new_syntax(syntax_kind::expr_name, $member);
		@qualified->data.expression := name;
		@name = $qualified;
	};
	return $name;
};

fn scope_template_member(Scope* scope) -> bool {
	while (scope) {
		Entity* owner := scope->owner;
		if (owner && (owner->kind == entity_kind::kw_struct || owner->kind == entity_kind::kw_union) && owner->template_origin) {
			return true;
		};
		@scope := scope->parent;
	};
	return false;
};

fn Parser::named_declaration(Parser& this, DeclarationRule* rule) -> Syntax* {
	Token token = this.token();
	@this.take((token_kind)token.kind);
	Syntax* node = @this.new_syntax(syntax_kind::node_declaration, Token(token));
	function_role role = function_role::ordinary;
	if (token.kind == token_kind::kw_fn) {
		@node->data.declaration.path = @this.function_name(&role);
	}
	else {
		@node->data.declaration.path = @this.name();
	};
	@node->data.declaration.name := node->data.declaration.path->token;
	Scope* owner := this.scope;
	if (node->data.declaration.path->data.expression) {
		@owner = entity_members(syntax_lookup((Scope*)this.scope, (Syntax*)node->data.declaration.path->data.expression));
		if (!owner) {
			compiler_error(@*this.compiler, node->data.declaration.name, "qualified declaration owner has no associated scope\0");
			return $node;
		};
	};
	Entity* aggregate := owner->owner;
	if (token.kind == token_kind::kw_fn && role != function_role::destructor && aggregate && (aggregate->kind == entity_kind::kw_struct || aggregate->kind == entity_kind::kw_union || aggregate->kind == entity_kind::kw_enum)) {
		if (token_same(node->data.declaration.name, aggregate->name)) {
			@role = function_role::constructor;
		}
		else if (token_is(node->data.declaration.name, "operator\0") && @this.take(token_kind::op_assign)) {
			@role = function_role::assignment;
		};
	};
	if (role == function_role::destructor && (!aggregate || (aggregate->kind != entity_kind::kw_struct && aggregate->kind != entity_kind::kw_union && aggregate->kind != entity_kind::kw_enum) || !token_same(node->data.declaration.name, aggregate->name))) {
		compiler_error(@*this.compiler, token, "destructor name must match its owning type\0");
		return $node;
	};
	if (role != function_role::ordinary) {
		@node->entity = entity_create(@*this.compiler, entity_kind::function, Token(node->data.declaration.name));
		@node->entity->scope := owner;
		@node->entity->data.function.role := role;
	}
	else {
		@node->entity = declaration_entity(@*this.compiler, (Scope*)owner, (entity_kind)rule->entity, node->data.declaration.name);
	};
	if (!node->entity) {
		return $node;
	};
	if (token.kind == token_kind::kw_fn && aggregate && scope_template_member((Scope*)owner)) {
		@node->entity->data.function.analysis = function_analysis::unrequested;
	};
	if (token.kind != token_kind::kw_fn && @this.take(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, "expected '[' after modifier colon\0");
		if (token.kind == token_kind::kw_enum) {
			@node->data.declaration.type = @this.type();
			@this.require(token_kind::punct_right_bracket, "expected ']' after enum underlying type\0");
		}
		else if (token.kind != token_kind::kw_struct) {
			compiler_error(@*this.compiler, token, "base relationships require a struct declaration\0");
			return $node;
		}
		else {
			if (this.at(token_kind::punct_right_bracket)) {
				compiler_error(@*this.compiler, this.token(), "modifier list cannot be empty\0");
				return $node;
			};
			@node->data.declaration.bases = @this.bases();
			@this.require(token_kind::punct_right_bracket, "expected ']' after base relationships\0");
			if (!node->entity->data.aggregate.bases) {
				@node->entity->data.aggregate.bases := node->data.declaration.bases;
			};
			if (!this.at(token_kind::punct_left_brace)) {
				compiler_error(@*this.compiler, token, "base relationships require a struct definition\0");
				return $node;
			};
		};
	};
	if (token.kind == token_kind::kw_enum && !node->data.declaration.type) {
		compiler_error(@*this.compiler, token, "enum declaration requires an explicit underlying type ': [type]'\0");
		return $node;
	};
	if (token.kind == token_kind::kw_fn) {
		@node->data.declaration.type = @this.signature(Token(token));
		if ((role != function_role::ordinary || this.scope->context == context_kind::kw_struct || this.scope->context == context_kind::kw_union || this.scope->context == context_kind::kw_enum) && !node->data.declaration.path->data.expression) {
			@this.receiver((Syntax*)node->data.declaration.type, (Entity*)this.scope->owner);
		};
		if ((role == function_role::constructor || role == function_role::destructor) && node->data.declaration.type->data.signature.result) {
			compiler_error(@*this.compiler, token, "constructors and destructors have no return type\0");
		};
	};
	if (token.kind == token_kind::kw_fn) {
		if (@this.take(token_kind::punct_colon)) {
			@this.require(token_kind::punct_left_bracket, "expected '[' after modifier colon\0");
			if (this.at(token_kind::punct_right_bracket)) {
				compiler_error(@*this.compiler, this.token(), "modifier list cannot be empty\0");
				return $node;
			};
			while (this.compiler->result != compilation_result::failure) {
				Token modifier = this.token();
				if (@this.take(token_kind::kw_delete)) {
					if (node->data.declaration.definition != function_definition::declaration) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					@node->data.declaration.definition = function_definition::deleted;
				}
				else if (@this.take(token_kind::kw_default)) {
					if (node->data.declaration.definition != function_definition::declaration) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					@node->data.declaration.definition = function_definition::defaulted;
				}
				else if (@this.take(token_kind::kw_implicit)) {
					if (node->entity->data.function.conversion == constructor_conversion::kw_implicit) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					if (role != function_role::constructor) {
						compiler_error(@*this.compiler, modifier, "implicit applies only to constructors\0");
						return $node;
					};
					@node->entity->data.function.conversion = constructor_conversion::kw_implicit;
				}
				else if (@this.take(token_kind::kw_virtual)) {
					if (node->data.declaration.modification != function_modification::ordinary) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					@node->data.declaration.modification = function_modification::kw_virtual;
				}
				else if (@this.take(token_kind::kw_override)) {
					if (node->data.declaration.modification != function_modification::ordinary) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					@node->data.declaration.modification = function_modification::kw_override;
				}
				else if (@this.take(token_kind::kw_final)) {
					if (node->data.declaration.modification != function_modification::ordinary) {
						compiler_error(@*this.compiler, modifier, "duplicate or conflicting function modifier\0");
						return $node;
					};
					@node->data.declaration.modification = function_modification::kw_final;
				}
				else {
					compiler_error(@*this.compiler, modifier, "expected delete, default, implicit, virtual, override, or final modifier\0");
					return $node;
				};
				if (!@this.take(token_kind::punct_comma)) {
					break;
				};
			};
			@this.require(token_kind::punct_right_bracket, "expected ']' after function modifiers\0");
		};
		if (this.scope->context == context_kind::kw_struct && !node->data.declaration.path->data.expression) {
			@node->entity->data.function.interface_owner := this.scope->owner;
			if (node->entity->data.function.modification != function_modification::ordinary && node->entity->data.function.modification != node->data.declaration.modification) {
				compiler_error(@*this.compiler, token, "conflicting virtual relationship declarations\0");
			};
			@node->entity->data.function.modification := node->data.declaration.modification;
			if (node->data.declaration.modification != function_modification::ordinary && !node->entity->data.function.callable) {
				VirtualCallable* callable = (VirtualCallable*)memory_allocate(@*this.compiler, sizeof(VirtualCallable));
				@callable->function := node->entity;
				VirtualCallable** link = &this.scope->owner->data.aggregate.virtual_callables;
				while (*link) {
					@callable->index = callable->index + 1;
					@link = &(*link)->next;
				};
				@node->entity->data.function.callable := callable;
				@*link = $callable;
			};
		};
	};
	if (this.at(token_kind::punct_left_brace)) {
		if (token.kind == token_kind::kw_fn && role == function_role::ordinary && node->entity->declaration && (node->entity->declaration->data.declaration.body || node->entity->declaration->data.declaration.definition == function_definition::deleted)) {
			compiler_error(@*this.compiler, token, "duplicate function definition\0");
			return node;
		};
		if (node->data.declaration.definition == function_definition::deleted || node->data.declaration.definition == function_definition::defaulted) {
			compiler_error(@*this.compiler, token, "deleted or defaulted function cannot have a body\0");
			return $node;
		};
		if (token.kind == token_kind::kw_fn) {
			@node->data.declaration.definition = function_definition::definition;
		};
		Scope* outer := this.scope;
		context_kind context := rule->context;
		if (token.kind == token_kind::kw_struct || token.kind == token_kind::kw_union) {
			Scope* members = entity_members((Entity*)node->entity);
			@members->context := context;
			@node->data.declaration.body = @this.block_scope((Scope*)members);
			@members->context = context_kind::module;
		}
		else {
			if (token.kind == token_kind::kw_enum) {
				@this.scope = entity_members((Entity*)node->entity);
				@this.scope->context := context;
			}
			else {
				@this.scope = scope_create(@*this.compiler, (Scope*)owner, (context_kind)context, (Entity*)node->entity);
			};
			if (token.kind == token_kind::kw_fn) {
				ParameterSyntax* parameter := node->data.declaration.type->data.signature.parameters;
				while (parameter) {
					if (parameter->name.source) {
						Entity* entity = entity_create(@*this.compiler, entity_kind::variable, Token(parameter->name));
						@entity->data.variable.storage = storage_kind::parameter;
						scope_define(@*this.compiler, (Scope*)this.scope, (Entity*)entity);
						@parameter->entity = $entity;
					};
					@parameter := parameter->next;
				};
			};
			if (token.kind == token_kind::kw_enum) {
				@node->data.declaration.body = @this.enum_block();
			}
			else {
				@node->data.declaration.body = @this.block();
			};
			@node->data.declaration.body->scope->context := context;
			@node->data.declaration.body->scope->owner := node->entity;
		};
		@this.scope = $outer;
	};
	if (!node->entity->declaration || node->data.declaration.body || node->data.declaration.definition == function_definition::deleted || node->data.declaration.definition == function_definition::defaulted) {
		@node->entity->declaration := node;
	};
	if (role != function_role::ordinary) {
		@this.special_register((Scope*)owner, (Syntax*)node);
	};
	@this.require(token_kind::punct_semicolon, "expected ';' after declaration\0");
	return $node;
};

fn Parser::control_body(Parser& this) -> Syntax* {
	if (this.at(token_kind::punct_left_brace)) {
		Syntax* body = @this.block();
		if (!this.at(token_kind::kw_else)) {
			@this.require(token_kind::punct_semicolon, "expected ';' after control block\0");
		};
		return $body;
	};

	return @this.statement();
};

fn Parser::conditional(Parser& this) -> Syntax* {
	Token token = @this.require(token_kind::kw_if, "expected if\0");
	Syntax* node = @this.new_syntax(syntax_kind::kw_if, $token);
	@this.require(token_kind::punct_left_paren, "expected '(' after if\0");
	@node->data.branch.condition = @this.expression(1);
	@this.require(token_kind::punct_right_paren, "expected ')' after condition\0");
	@node->data.branch.first = @this.control_body();

	if (!@this.take(token_kind::kw_else)) {
		return $node;
	};

	if (this.at(token_kind::kw_if)) {
		@node->data.branch.second = @this.conditional();
		return $node;
	};

	@node->data.branch.second = @this.control_body();
	return $node;
};

fn Parser::namespace_(Parser& this) -> Syntax* {
	Token token = @this.require(token_kind::kw_namespace, "expected namespace\0");
	if (this.scope->context != context_kind::module) {
		compiler_error(@*this.compiler, token, "namespace requires module context\0");
		return nullptr;
	};

	Scope* outer := this.scope;
	Entity* entity = nullptr;
	while (true) {
		Token name = @this.require(token_kind::identifier, "expected namespace identifier\0");
		@entity = namespace_define(@*this.compiler, (Scope*)this.scope, $name);
		if (!entity) {
			return nullptr;
		};
		@this.scope = entity_members((Entity*)entity);
		if (!@this.take(token_kind::op_scope)) {
			break;
		};
	};

	Syntax* node = @this.new_syntax(syntax_kind::node_declaration, Token(token));
	@node->entity = $entity;
	@this.require(token_kind::punct_left_brace, "expected namespace body\0");
	Syntax* body = @this.new_syntax(syntax_kind::node_block, $token);
	@body->scope := this.scope;
	Syntax* last = nullptr;
	while (!this.at(token_kind::punct_right_brace) && !this.at(token_kind::eof) && this.compiler->result != compilation_result::failure) {
		Syntax* statement = @this.statement();
		syntax_append(&body->data.statements, &last, $statement);
	};
	@this.require(token_kind::punct_right_brace, "expected '}' after namespace\0");
	@this.require(token_kind::punct_semicolon, "expected ';' after namespace\0");
	@this.scope = $outer;
	@node->data.declaration.body = $body;
	return $node;
};

fn Parser::statement(Parser& this) -> Syntax* {
	if (this.at(token_kind::kw_template)) {
		TemplateDeclaration* declaration = @this.template_register((Scope*)this.scope, (usize)this.offset);
		if (!declaration) {
			return nullptr;
		};
		template_validate(@*this.compiler, (Entity*)declaration->pattern);
		Syntax* node = @this.new_syntax(syntax_kind::node_declaration, this.token());
		@node->entity := declaration->pattern;
		@this.offset := declaration->end;
		return node;
	};
	if (this.at(token_kind::kw_namespace)) {
		return @this.namespace_();
	};
	Token token = this.token();
	DeclarationRule* rule = declaration_rule(@*this.compiler, (token_kind)token.kind);

	if (rule) {
		return @this.named_declaration($rule);
	};
	if (@this.declaration_start()) {
		return @this.variable();
	};
	if (@this.take(token_kind::punct_semicolon)) {
		return @this.new_syntax(syntax_kind::node_block, Token(token));
	};
	if (this.at(token_kind::punct_left_brace)) {
		Syntax* node = @this.block();
		@this.require(token_kind::punct_semicolon, "expected ';' after block expression\0");
		return $node;
	};
	if (@this.take(token_kind::kw_return)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_return, Token(token));
		if (!this.at(token_kind::punct_semicolon)) {
			@node->data.expression = @this.expression(1);
		};
		@this.require(token_kind::punct_semicolon, "expected ';' after return\0");
		return $node;
	};
	if (@this.take(token_kind::kw_break) || @this.take(token_kind::kw_continue)) {
		syntax_kind kind = syntax_kind::kw_break;
		if (token.kind == token_kind::kw_continue) {
			@kind = syntax_kind::kw_continue;
		};
		@this.require(token_kind::punct_semicolon, "expected ';' after flow statement\0");
		return @this.new_syntax($kind, Token(token));
	};
	if (this.at(token_kind::kw_if)) {
		Syntax* node = @this.conditional();
		return $node;
	};
	if (@this.take(token_kind::kw_while)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_while, Token(token));
		@this.require(token_kind::punct_left_paren, "expected '(' after while\0");
		@node->data.loop.condition = @this.expression(1);
		@this.require(token_kind::punct_right_paren, "expected ')' after condition\0");
		@node->data.loop.body = @this.control_body();
		return $node;
	};
	if (@this.take(token_kind::kw_for)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_for, Token(token));
		Scope* outer := this.scope;
		@node->scope = scope_create(@*this.compiler, (Scope*)outer, context_kind::local, nullptr);
		@this.scope := node->scope;
		@this.require(token_kind::punct_left_paren, "expected '(' after for\0");
		if (@this.declaration_start()) {
			@node->data.loop.initializer = @this.variable();
		}
		else {
			if (!this.at(token_kind::punct_semicolon)) {
				@node->data.loop.initializer = @this.expression(1);
			};
			@this.require(token_kind::punct_semicolon, "expected ';' after for initializer\0");
		};
		if (!this.at(token_kind::punct_semicolon)) {
			@node->data.loop.condition = @this.expression(1);
		};
		@this.require(token_kind::punct_semicolon, "expected ';' after for condition\0");
		if (!this.at(token_kind::punct_right_paren)) {
			@node->data.loop.step = @this.expression(1);
		};
		@this.require(token_kind::punct_right_paren, "expected ')' after for step\0");
		@node->data.loop.body = @this.control_body();
		@this.scope = $outer;
		return $node;
	};
	if (@this.take(token_kind::kw_switch)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_switch, Token(token));
		@this.require(token_kind::punct_left_paren, "expected '(' after switch\0");
		@node->data.selection.value = @this.expression(1);
		@this.require(token_kind::punct_right_paren, "expected ')' after switch value\0");
		@node->data.selection.cases = @this.block();
		@this.require(token_kind::punct_semicolon, "expected ';' after switch block\0");
		return $node;
	};
	if (@this.take(token_kind::kw_case) || @this.take(token_kind::kw_default)) {
		Syntax* node = @this.new_syntax(syntax_kind::kw_case, Token(token));
		if (token.kind == token_kind::kw_case) {
			@node->data.selection_case.value = @this.expression(2);
		};
		@this.require(token_kind::punct_colon, "expected ':' after case label\0");
		return $node;
	};
	Syntax* node = @this.expression(1);
	@this.require(token_kind::punct_semicolon, "expected ';' after expression\0");
	return $node;
};

fn Parser::block(Parser& this) -> Syntax* {
	Scope* scope = scope_create(@*this.compiler, (Scope*)this.scope, context_kind::local, nullptr);
	return @this.block_scope($scope);
};

fn prepare_source(Compiler& compiler, Source* source) -> i32 {
	if (source->tokens) {
		return compiler.result == compilation_result::success;
	};
	if (!tokenize(@compiler, (Source*)source, &source->tokens, &source->token_count)) {
		return 0;
	};
	Parser parser {
		@parser.compiler = &compiler;
		@parser.scope := compiler.module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		@parser.offset = 0;
		@parser.pending_greater = 0;
		@parser.context = expression_context::ordinary;
	};
	@parser.predeclare(declaration_phase::identities);
	return compiler.result == compilation_result::success;
};

fn prepare_sources(Compiler& compiler) -> i32 {
	Source* source := compiler.sources;
	while (source) {
		if (!prepare_source(@compiler, (Source*)source)) {
			return 0;
		};
		@source := source->next;
	};
	@source := compiler.sources;
	while (source) {
		Parser parser;
		@parser.compiler = &compiler;
		@parser.scope := compiler.module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		@parser.predeclare(declaration_phase::members);
		@source := source->next;
	};
	return compiler.result == compilation_result::success;
};

fn parse_source(Compiler& compiler, Source* source) -> Syntax* {
	if (!prepare_source(@compiler, (Source*)source)) {
		return nullptr;
	};
	Parser parser {
		@parser.compiler = &compiler;
		@parser.scope := compiler.module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		@parser.offset = 0;
		@parser.pending_greater = 0;
		@parser.context = expression_context::ordinary;
	};
	Token token = parser.token();
	Syntax* module = @parser.new_syntax(syntax_kind::node_block, $token);
	@module->scope := compiler.module;
	Syntax* last = nullptr;
	while (!parser.at(token_kind::eof) && compiler.result != compilation_result::failure) {
		Syntax* statement = @parser.statement();
		syntax_append(&module->data.statements, &last, $statement);
	};
	return $module;
};

