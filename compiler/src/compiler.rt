			@this.expect((Syntax*)right, (Type*)b, (Type*)right_context);
			if (a->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				layout_validate(@compiler, (Type*)a->data.element, nullptr, syntax->token);
				if (!type_integer((Type*)b)) {
					compiler_error(@compiler, right->token, "pointer offset requires an integer\0");
				};
				@type := a;
				break;
			};
			if (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) {
				if ((!type_scalar((Type*)a) || !type_scalar((Type*)b)) && !(type_enum((Type*)a) && type_scalar(type_representation((Type*)a)) && type_value_equal((Type*)a, (Type*)b))) {
					compiler_error(@compiler, syntax->token, "comparison requires scalar operands or matching enum types\0");
				};
				@type := compiler.bool_type;
			}
			else {
				if (!type_numeric((Type*)a) || !type_value_equal((Type*)a, (Type*)b)) {
					compiler_error(@compiler, syntax->token, "arithmetic requires matching numeric operands\0");
				};
				if ((operation == token_kind::op_remainder || operation == token_kind::op_ampersand || operation == token_kind::op_pipe || operation == token_kind::op_caret || operation == token_kind::op_shift_left || operation == token_kind::op_shift_right) && !type_integer((Type*)a)) {
					compiler_error(@compiler, syntax->token, "operation requires integer operands\0");
				};
				@type = (Type*)a;
				if (type->kind == type_kind::kw_bool) {
					@type := compiler.i32_type;
				};
			};
			break;
		};
		case syntax_kind::expr_call: {
			Syntax* callable_syntax := syntax->data.call.callable;
			if (callable_syntax->kind == syntax_kind::expr_name) {
				Entity* callable_entity = syntax_lookup((Scope*)this.scope, (Syntax*)callable_syntax);
				if (callable_entity && callable_entity->kind == entity_kind::kw_template && callable_entity->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					@callable_entity = @this.template_deduce((Entity*)callable_entity, (Syntax*)callable_syntax, (Syntax*)syntax->data.call.arguments);
					if (!callable_entity) {
						return (Type*)compiler.void_type;
					};
					@callable_syntax->entity := callable_entity;
				};
				if (callable_entity && (callable_entity->kind == entity_kind::primitive || callable_entity->kind == entity_kind::kw_struct || callable_entity->kind == entity_kind::kw_union || callable_entity->kind == entity_kind::kw_enum)) {
					Syntax* arguments := syntax->data.call.arguments;
					Type* target = type_resolve(@compiler, (Scope*)this.scope, (Syntax*)callable_syntax);
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.destination = nullptr;
					@syntax->data.construction.target = (Type*)target;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = (Syntax*)arguments;
					return @this.expression((Syntax*)syntax, (Type*)expected);
				};
			};
			if (callable_syntax->kind == syntax_kind::expr_member) {
				Syntax* receiver = @this.method_receiver((Syntax*)callable_syntax);
				Type* owner := receiver->type;
				if (callable_syntax->data.member.qualifier) {
					@owner = type_resolve(@compiler, (Scope*)this.scope, (Syntax*)callable_syntax->data.member.qualifier);
					BaseSearch path = base_search(@compiler, (Type*)receiver->type, (Type*)owner);
					if (!path.count) {
						compiler_error(@compiler, callable_syntax->token, "qualified callable owner is not a base of its receiver\0");
						return (Type*)compiler.void_type;
					};
					@syntax->data.call.qualified_owner := owner->data.entity;
				};
				if (owner->kind == type_kind::named && (owner->data.entity->kind == entity_kind::kw_struct || owner->data.entity->kind == entity_kind::kw_union) && token_same(callable_syntax->data.member.name, owner->data.entity->name)) {
					if (owner->qualifier == type_qualifier::kw_const || (callable_syntax->token.kind != token_kind::op_arrow && (syntax_category((Syntax*)receiver) != value_category::storage || !syntax_mutable_access((Syntax*)receiver)))) {
						compiler_error(@compiler, callable_syntax->token, "construction requires mutable storage\0");
						return (Type*)compiler.void_type;
					};
					Syntax* arguments := syntax->data.call.arguments;
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.destination = $receiver;
					@syntax->data.construction.target := owner;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = $arguments;
					return @this.expression((Syntax*)syntax, (Type*)expected);
				};
				Entity* function = @this.receiver_callable((Type*)owner, Token(callable_syntax->data.member.name));
				if (function && function->kind == entity_kind::function) {
					entity_resolve(@compiler, (Entity*)function);
					Parameter* first := function->data.function.type->data.function.parameters;
					@syntax->data.call.receiver.value := receiver;
					if (first && token_is(first->name, "this\0")) {
						if (callable_syntax->data.member.qualifier && !type_equal((Type*)receiver->type, (Type*)owner)) {
							Type* reference = type_new(@compiler, type_kind::reference);
							@reference->data.element = (Type*)owner;
							@this.expect((Syntax*)receiver, (Type*)receiver->type, (Type*)reference);
						};
						@this.expect((Syntax*)receiver, (Type*)receiver->type, (Type*)first->type);
						@syntax->data.call.receiver.kind = receiver_kind::bind;
					}
					else {
						@syntax->data.call.receiver.kind = receiver_kind::evaluate;
					};
					Syntax* direct = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
					@direct->kind = syntax_kind::expr_name;
					@direct->token := callable_syntax->data.member.name;
					@direct->entity = (Entity*)function;
					@syntax->data.call.callable = (Syntax*)direct;
				};
			};
			Type* callable = @this.expression((Syntax*)syntax->data.call.callable, nullptr);
			if (callable->kind == type_kind::pointer) {
				@callable := callable->data.element;
			};
			if (callable->kind != type_kind::function) {
				compiler_error(@compiler, syntax->token, "call requires a function entity or function pointer\0");
				return (Type*)compiler.void_type;
			};
			if (callable->data.function.result->kind != type_kind::kw_void) {
				layout_validate(@compiler, (Type*)callable->data.function.result, nullptr, syntax->token);
			};
			Parameter* complete := callable->data.function.parameters;
			while (complete) {
				layout_validate(@compiler, (Type*)complete->type, nullptr, syntax->token);
				@complete := complete->next;
			};
			Parameter* parameter := callable->data.function.parameters;
			Syntax* direct := syntax->data.call.callable;
			if (syntax->data.call.receiver.kind == receiver_kind::none && direct->kind == syntax_kind::expr_name && !direct->data.expression && direct->entity && direct->entity->scope && direct->entity->scope->owner && (direct->entity->scope->owner->kind == entity_kind::kw_struct || direct->entity->scope->owner->kind == entity_kind::kw_union) && parameter && token_is(parameter->name, "this\0")) {
				Entity* current = scope_lookup((Scope*)this.scope, token_synthetic(@compiler, Token(direct->token), "this\0"));
				if (current) {
					Syntax* receiver = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
					@receiver->kind = syntax_kind::expr_name;
					@receiver->token := current->name;
					@receiver->entity = (Entity*)current;
					@this.expression((Syntax*)receiver, (Type*)parameter->type);
					@syntax->data.call.receiver.value = (Syntax*)receiver;
					@syntax->data.call.receiver.kind = receiver_kind::bind;
				};
			};
			if (syntax->data.call.receiver.kind == receiver_kind::bind) {
				@parameter := parameter->next;
			};
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (!parameter && callable->data.function.arity != parameter_arity::variadic) {
					compiler_error(@compiler, argument->token, "too many arguments\0");
					break;
				};
				Type* destination = nullptr;
				if (parameter) {
					@destination := parameter->type;
				};
				if (argument->kind == syntax_kind::node_block) {
					if (!parameter || !parameter->name.source) {
						compiler_error(@compiler, argument->token, "argument block requires a named parameter\0");
					}
					else {
						@argument->scope->context = context_kind::arguments;
						Entity* storage = entity_create(@compiler, entity_kind::variable, Token(parameter->name));
						@storage->state = resolution::ready;
						@storage->data.variable.type := destination;
						@storage->data.variable.storage = storage_kind::argument;
						@storage->declaration := argument;
						@argument->scope->owner := storage;
						if (destination->kind == type_kind::reference) {
							reference_initializer(@compiler, (Syntax*)argument, (Entity*)storage, Token(argument->token));
						}
						else {
							scope_define(@compiler, (Scope*)argument->scope, (Entity*)storage);
							object_initializer_prepare(@compiler, (Scope*)this.scope, (Entity*)storage, (Syntax*)argument, Token(argument->token));
						};
						@argument->entity = (Entity*)storage;
						@this.statement((Syntax*)argument);
						@argument->type = (Type*)destination;
					};
				}
				else {
					Type* actual = @this.expression((Syntax*)argument, (Type*)destination);
					if (!destination || destination->kind != type_kind::reference) {
						@this.owned((Syntax*)argument);
					};
					if (!parameter && type_aggregate((Type*)actual)) {
						compiler_error(@compiler, argument->token, "aggregate C variadic arguments require ABI lowering that is not supported yet\0");
					};
				};
				if (parameter) {
					@parameter := parameter->next;
				};
				@argument := argument->next;
			};
			if (parameter) {
				compiler_error(@compiler, syntax->token, "too few arguments\0");
			};
			@type = type_effective((Type*)callable->data.function.result);
			break;
		};
		case syntax_kind::node_block:
			@this.statement((Syntax*)syntax);
			@type := compiler.void_type;
			break;
		default:
			compiler_error(@compiler, syntax->token, "expected value expression\0");
			@type := compiler.void_type;
			break;
	};
	@type = type_effective((Type*)type);
	@syntax->type := type;
	return @this.expect($syntax, $type, $expected);
};

// ============================================================================
// MODULE: LLVM EMISSION
// FUTURE FILE: backend/emitter.rt
// PURPOSE: Construct native layouts and emit LLVM instructions and runtime metadata.
// DEPENDS ON: Backend, Compiler arena and diagnostics, semantic entities and layout.
// ============================================================================
fn llvm_body(Compiler& compiler, Entity* entity) -> LLVMOpaqueType* {
	BackendEntity* native = backend_entity_define(@compiler, (Entity*)entity);
	if (!native) {
		return nullptr;
	};
	if (native->body) {
		return LLVMOpaqueType*(native->body);
	};
	entity_resolve(@compiler, (Entity*)entity);
	LLVMOpaqueType* record = LLVMStructCreateNamed(compiler.backend.llvm_context.get(), "rt.body\0");
	@native->body := record;
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		return $record;
	};
	usize count := entity->data.aggregate.field_count;
	if (aggregate_header((Entity*)entity)) {
		@count = count + 1;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@count = count + 1;
		};
		@base := base->next;
	};
	LLVMOpaqueType** fields = (LLVMOpaqueType**)memory_allocate(@compiler, (count + 2) * sizeof(LLVMOpaqueType*));
	usize index = 0;
	if (aggregate_header((Entity*)entity)) {
		@fields[index] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
		@index = index + 1;
	};
	@base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@fields[index] = llvm_body(@compiler, (Entity*)base->entity);
			@index = index + 1;
		};
		@base := base->next;
	};
	Field* binding := entity->data.aggregate.fields;
	u64 maximum_size = 0;
	u32 maximum_alignment = 0;
	LLVMOpaqueType* aligned = nullptr;
	while (binding) {
		LLVMOpaqueType* field = llvm_type(@compiler, entity_type((Entity*)binding->entity));
		@fields[index] := field;
		@index = index + 1;
		if (entity->kind == entity_kind::kw_union) {
			u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(field));
			u32 alignment = LLVMABIAlignmentOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(field));
			if (size > maximum_size) {
				@maximum_size = (u64)size;
			};
			if (alignment > maximum_alignment) {
				@maximum_alignment = (u32)alignment;
				@aligned = LLVMOpaqueType*(field);
			};
		};
		@binding := binding->next;
	};
	if (entity->kind == entity_kind::kw_union && aligned) {
		u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(aligned));
		@fields[0] = LLVMOpaqueType*(aligned);
		@index = 1;
		if (maximum_size > size) {
			@fields[1] = LLVMArrayType2(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), maximum_size - size);
			@index = 2;
		};
	};
	if (!index) {
		@fields[0] = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8);
		@index = 1;
	};
	LLVMStructSetBody(LLVMOpaqueType*(record), $fields, (u32)index, 0);
	return $record;
};

fn backend_entity(Backend& backend, Entity* entity) -> BackendEntity* {
	return @backend.entities.find((const void*)entity, nullptr);
};

fn backend_entity_define(Compiler& compiler, Entity* entity) -> BackendEntity* {
	return identity_record<BackendEntity>(@compiler, @compiler.backend.entities, (const void*)entity, nullptr);
};

fn backend_syntax(Backend& backend, Syntax* syntax) -> BackendSyntax* {
	return @backend.expressions.find((const void*)syntax, nullptr);
};

fn backend_syntax_define(Compiler& compiler, Syntax* syntax) -> BackendSyntax* {
	return identity_record<BackendSyntax>(@compiler, @compiler.backend.expressions, (const void*)syntax, nullptr);
};

fn llvm_type(Compiler& compiler, Type* type) -> LLVMOpaqueType* {
	if (!type) {
		return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
	};
	switch (type->kind) {
		case type_kind::kw_void:
		case type_kind::kw_null:
			return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
		case type_kind::kw_char:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8);
		case type_kind::kw_bool:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1);
		case type_kind::kw_signed:
		case type_kind::kw_unsigned:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), (u32)type->data.bits);
		case type_kind::kw_float:
			if (type->data.bits == 32) {
				return LLVMFloatTypeInContext(compiler.backend.llvm_context.get());
			};
			return LLVMDoubleTypeInContext(compiler.backend.llvm_context.get());
		case type_kind::pointer:
		case type_kind::reference:
			return LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
		case type_kind::array:
			return LLVMArrayType2(llvm_type(@compiler, (Type*)type->data.array.element), (u64)type->data.array.count);
		case type_kind::function: {
			u32 count = 0;
			Parameter* parameter := type->data.function.parameters;
			while (parameter) {
				@count = count + 1;
				@parameter := parameter->next;
			};
			LLVMOpaqueType** parameters = (LLVMOpaqueType**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueType*));
			@parameter := type->data.function.parameters;
			u32 index = 0;
			while (parameter) {
				@parameters[index] = llvm_type(@compiler, (Type*)parameter->type);
				@index = index + 1;
				@parameter := parameter->next;
			};
			return LLVMFunctionType(llvm_type(@compiler, (Type*)type->data.function.result), $parameters, $count, type->data.function.arity == parameter_arity::variadic);
		};
		case type_kind::named: {
			Entity* entity := type->data.entity;
			if (entity->kind == entity_kind::kw_enum) {
				entity_resolve(@compiler, (Entity*)entity);
				return llvm_type(@compiler, (Type*)entity->data.enumeration.underlying);
			};
			BackendEntity* native = backend_entity_define(@compiler, (Entity*)entity);
			if (!native) {
				return nullptr;
			};
			if (native->type) {
				return LLVMOpaqueType*(native->type);
			};
			LLVMOpaqueType* body = llvm_body(@compiler, (Entity*)entity);
			if (!entity->data.aggregate.virtual_types) {
				@native->type := body;
				return $body;
			};
			LLVMOpaqueType* record = LLVMStructCreateNamed(compiler.backend.llvm_context.get(), entity_name(@compiler, (Entity*)entity));
			@native->type := record;
			CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
			usize count = 1;
			Subobject* object := graph->virtuals;
			while (object) {
				@count = count + 1;
				@object := object->virtual_next;
			};
			LLVMOpaqueType** components = (LLVMOpaqueType**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueType*));
			@components[0] = LLVMOpaqueType*(body);
			@object := graph->virtuals;
			while (object) {
				@components[object->component] = llvm_body(@compiler, (Entity*)object->entity);
				@object := object->virtual_next;
			};
			LLVMStructSetBody(LLVMOpaqueType*(record), LLVMOpaqueType**(components), (u32)count, 0);
			return $record;
		};
	};
	return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
};

fn emit_slot(Compiler& compiler, Type* type) -> LLVMOpaqueValue* {
	LLVMOpaqueBasicBlock* block = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock(compiler.backend.llvm_builder.get())));
	var storage_builder = unique_ptr<LLVMOpaqueBuilder, LLVMBuilderDisposer>(LLVMCreateBuilderInContext(compiler.backend.llvm_context.get()));
	LLVMOpaqueValue* first = LLVMGetFirstInstruction(LLVMOpaqueBasicBlock*(block));
	if (first) {
		LLVMPositionBuilderBefore(storage_builder.get(), LLVMOpaqueValue*(first));
	}
	else {
		LLVMPositionBuilderAtEnd(storage_builder.get(), LLVMOpaqueBasicBlock*(block));
	};
	LLVMOpaqueValue* slot = LLVMBuildAlloca(storage_builder.get(), llvm_type(@compiler, $type), "storage\0");

	return $slot;
};




fn subobject_offsets(Compiler& compiler, Subobject* object, u64 offset) {
	@object->offset := offset;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		if (edge->relation->kind == base_kind::nonvirtual) {
			u64 child = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)object->entity), (u32)edge->relation->component);
			subobject_offsets(@compiler, (Subobject*)edge->target, $child);
		};
		@edge := edge->next;
	};
};

fn complete_offsets(Compiler& compiler, CompleteGraph* graph) {
	LLVMOpaqueType* type = llvm_type(@compiler, entity_type((Entity*)graph->entity));
	subobject_offsets(@compiler, (Subobject*)graph->root, 0);
	Subobject* object := graph->virtuals;
	while (object) {
		u64 offset = LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(type), (u32)object->component);
		subobject_offsets(@compiler, (Subobject*)object, $offset);
		@object := object->virtual_next;
	};
};

fn virtual_callable_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualCallable* callable := entity->data.aggregate.virtual_callables;
	while (callable) {
		@count = count + 1;
		@callable := callable->next;
	};
	return $count;
};

fn virtual_base_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualType* type := entity->data.aggregate.virtual_types;
	while (type) {
		@count = count + 1;
		@type := type->next;
	};
	return $count;
};

fn runtime_view_type(Compiler& compiler, Entity* entity) -> LLVMOpaqueType* {
	LLVMOpaqueType*[2] fields {};
	@fields[0] = LLVMArrayType2(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)virtual_base_count((Entity*)entity));
	@fields[1] = LLVMArrayType2(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), (u64)virtual_callable_count($entity));
	return LLVMStructTypeInContext(compiler.backend.llvm_context.get(), &fields[0], 2, 0);
};

fn runtime_view_request(Compiler& compiler, CompleteGraph* graph, Subobject* object) -> LLVMOpaqueValue* {
	BackendEntity* native = backend_entity_define(@compiler, (Entity*)object->entity);
	if (!native) {
		return nullptr;
	};
	RuntimeView* existing := native->views;
	while (existing) {
		if (existing->object == object) {
			return LLVMOpaqueValue*(existing->value);
		};
		@existing := existing->next;
	};

	RuntimeView* request = (RuntimeView*)memory_allocate(@compiler, sizeof(RuntimeView));
	if (!request) {
		return nullptr;
	};
	LLVMOpaqueValue* view = LLVMAddGlobal(compiler.backend.llvm_module.get(), runtime_view_type(@compiler, (Entity*)object->entity), "rt.view\0");
	LLVMSetLinkage(LLVMOpaqueValue*(view), 9);
	LLVMSetGlobalConstant(LLVMOpaqueValue*(view), 1);
	@request->value := view;
	@request->graph = $graph;
	@request->object = $object;
	@request->next := native->views;
	@native->views := request;
	@request->pending_next := compiler.backend.runtime_views;
	@compiler.backend.runtime_views = $request;
	return $view;
};

fn emit_function_attributes(Compiler& compiler, LLVMOpaqueValue* function, Type* signature) {
	LLVMOpaqueAttributeRef* extension = emit_extension(@compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddAttributeAtIndex(LLVMOpaqueValue*(function), 0, LLVMOpaqueAttributeRef*(extension));
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension(@compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddAttributeAtIndex(LLVMOpaqueValue*(function), (u32)index, LLVMOpaqueAttributeRef*(extension));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn runtime_thunk_request(Compiler& compiler, CompleteGraph* graph, Subobject* receiver, VirtualCallable* callable) -> LLVMOpaqueValue* {
	VirtualTarget target = virtual_target(@compiler, $graph, (Subobject*)receiver, (Entity*)callable->function);
	if (target.function == callable->function && target.object == receiver) {
		return LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)target.function)->value);
	};
	RuntimeThunk* thunk = (RuntimeThunk*)memory_allocate(@compiler, sizeof(RuntimeThunk));
	@thunk->receiver = $receiver;
	@thunk->callable := callable;
	@thunk->target = $target;
	@thunk->function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.virtual.thunk\0", llvm_type(@compiler, (Type*)callable->function->data.function.type));
	LLVMSetLinkage(LLVMOpaqueValue*(thunk->function), 9);
	emit_function_attributes(@compiler, LLVMOpaqueValue*(thunk->function), (Type*)callable->function->data.function.type);
	@thunk->next := compiler.backend.runtime_thunks;
	@compiler.backend.runtime_thunks := thunk;
	return LLVMOpaqueValue*(thunk->function);
};

fn runtime_views_emit(Compiler& compiler) {
	while (compiler.backend.runtime_views && compiler.result != compilation_result::failure) {
		RuntimeView* view := compiler.backend.runtime_views;
		@compiler.backend.runtime_views := view->pending_next;
		complete_offsets(@compiler, (CompleteGraph*)view->graph);
		usize count = virtual_base_count((Entity*)view->object->entity);
		LLVMOpaqueValue** offsets = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		VirtualType* target := view->object->entity->data.aggregate.virtual_types;
		while (target) {
			Subobject* storage := view->graph->virtuals;
			while (storage && storage->entity != target->entity) {
				@storage := storage->virtual_next;
			};
			@offsets[target->index] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), storage->offset - view->object->offset, 0);
			@target := target->next;
		};
		LLVMOpaqueValue*[2] fields {};
		@fields[0] = LLVMConstArray2(llvm_type(@compiler, (Type*)compiler.usize_type), $offsets, (u64)count);
		@count = virtual_callable_count((Entity*)view->object->entity);
		LLVMOpaqueValue** functions = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		VirtualCallable* callable := view->object->entity->data.aggregate.virtual_callables;
		while (callable) {
			@functions[callable->index] = runtime_thunk_request(@compiler, (CompleteGraph*)view->graph, (Subobject*)view->object, (VirtualCallable*)callable);
			@callable := callable->next;
		};
		@fields[1] = LLVMConstArray2(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $functions, (u64)count);
		LLVMSetInitializer(LLVMOpaqueValue*(view->value), LLVMConstStructInContext(compiler.backend.llvm_context.get(), &fields[0], 2, 0));
	};
};

fn Emitter::byte_offset(Emitter& this, LLVMOpaqueValue* address, u64 offset) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), $offset, 0);
	return LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), $address, &index, 1, "subobject\0");
};

fn Emitter::base_address(Emitter& this, LLVMOpaqueValue* address, Entity* derived, BasePath* path, base_direction direction) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	u64 offset = 0;
	while (path) {
		BaseRelation* relation := path->relation;
		if (direction == base_direction::up && relation->kind == base_kind::kw_virtual) {
			LLVMOpaqueValue* header = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)derived), LLVMOpaqueValue*(address), 0, "view.storage\0");
			LLVMOpaqueValue* view = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "view\0");
			LLVMOpaqueValue* offsets = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), runtime_view_type(@compiler, (Entity*)derived), $view, 0, "virtual.offsets\0");
			LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)relation->component, 0);
			LLVMOpaqueValue* slot = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)compiler.usize_type), $offsets, &index, 1, "virtual.offset.storage\0");
			LLVMOpaqueValue* displacement = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)compiler.usize_type), $slot, "virtual.offset\0");
			@address = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), LLVMOpaqueValue*(address), &displacement, 1, "virtual.base\0");
		}
		else if (direction == base_direction::up) {
			@address = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)derived), LLVMOpaqueValue*(address), (u32)relation->component, "base\0");
		}
		else {
			@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)derived), (u32)relation->component);
		};
		@derived := relation->entity;
		@path := path->next;
	};
	if (direction == base_direction::down && offset) {
		LLVMOpaqueValue* integer = LLVMBuildPtrToInt(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(address), llvm_type(@compiler, (Type*)compiler.usize_type), "base.address\0");
		@integer = LLVMBuildSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(integer), LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)offset, 0), "derived.address\0");
		@address = LLVMBuildIntToPtr(LLVMOpaqueBuilder*(builder), $integer, LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "derived\0");
	};
	return $address;
};

fn Emitter::base_conversion(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Syntax* value := syntax->data.base_conversion.value;
	Type* source := value->type;
	LLVMOpaqueValue* address = nullptr;
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		@address = @this.expression((Syntax*)value);
		@source := source->data.element;
	}
	else {
		@address = @this.address((Syntax*)value);
	};
	Entity* derived := source->data.entity;
	if (syntax->data.base_conversion.direction == base_direction::down) {
		@derived := syntax->data.base_conversion.target->data.element->data.entity;
	};
	if (syntax->kind == syntax_kind::expr_base_pointer && base_path_virtual((BasePath*)syntax->data.base_conversion.path)) {
		LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
		LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "base.nonnull\0");
		LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "base.end\0");
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
		LLVMOpaqueValue* converted = @this.base_address(LLVMOpaqueValue*(address), (Entity*)derived, (BasePath*)syntax->data.base_conversion.path, (base_direction)syntax->data.base_conversion.direction);
		@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
		LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMTypeOf(LLVMOpaqueValue*(address)), "base.pointer\0");
		LLVMOpaqueValue*[2] values {};
		LLVMOpaqueBasicBlock*[2] blocks {};
		@values[0] = $null;
		@values[1] = $converted;
		@blocks[0] = $initial;
		@blocks[1] = $live;
		LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
		return $result;
	};
	LLVMOpaqueValue* result = @this.base_address(LLVMOpaqueValue*(address), $derived, (BasePath*)syntax->data.base_conversion.path, (base_direction)syntax->data.base_conversion.direction);
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		return LLVMBuildSelect(compiler.backend.llvm_builder.get(), $empty, $null, LLVMOpaqueValue*(result), "base.pointer\0");
	};
	return $result;
};

fn runtime_callable(Compiler& compiler, Entity* entity) -> LLVMOpaqueValue* {
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)entity);
	if (!entity->data.function.callable) {
		return LLVMOpaqueValue*(native->value);
	};
	if (native->wrapper) {
		return LLVMOpaqueValue*(native->wrapper);
	};
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.virtual.callable\0", llvm_type(@compiler, (Type*)entity->data.function.type));
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	emit_function_attributes(@compiler, LLVMOpaqueValue*(function), (Type*)entity->data.function.type);
	@native->wrapper := function;
	RuntimeWrapper* wrapper = (RuntimeWrapper*)memory_allocate(@compiler, sizeof(RuntimeWrapper));
	@wrapper->entity = $entity;
	@wrapper->next := compiler.backend.runtime_wrappers;
	@compiler.backend.runtime_wrappers = $wrapper;
	return $function;
};

fn Emitter::dispatch_target(Emitter& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Entity* owner := entity->data.function.interface_owner;
	LLVMOpaqueValue* header = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)owner), $receiver, 0, "virtual.header\0");
	LLVMOpaqueValue* view = LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "virtual.view\0");
	LLVMOpaqueValue* functions = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), runtime_view_type(@compiler, $owner), $view, 1, "virtual.functions\0");
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)entity->data.function.callable->index, 0);
	LLVMOpaqueValue* slot = LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $functions, &index, 1, "virtual.slot\0");
	return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $slot, "virtual.target\0");
};

fn Emitter::covariant_result(Emitter& this, LLVMOpaqueValue* value, Type* source, Type* target) -> LLVMOpaqueValue* {
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	Compiler& compiler = @*this.compiler;
	BaseSearch path = base_search(@compiler, (Type*)source->data.element, (Type*)target->data.element);
	if (source->kind == type_kind::reference) {
		return @this.base_address(LLVMOpaqueValue*(value), (Entity*)source->data.element->data.entity, (BasePath*)path.path, base_direction::up);
	};
	LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
	LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "return.nonnull\0");
	LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "return.end\0");
	LLVMOpaqueValue* null = LLVMConstNull(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0));
	LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(value), LLVMOpaqueValue*(null), "return.null\0");
	LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
	LLVMOpaqueValue* adjusted = @this.base_address($value, (Entity*)source->data.element->data.entity, (BasePath*)path.path, base_direction::up);
	@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
	LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "return.base\0");
	LLVMOpaqueValue*[2] values {};
	LLVMOpaqueBasicBlock*[2] blocks {};
	@values[0] = $null;
	@values[1] = $adjusted;
	@blocks[0] = $initial;
	@blocks[1] = $live;
	LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
	return $result;
};

fn covariance_adjustment_required(Compiler& compiler, Type* source, Type* target) -> bool {
	if (type_equal((Type*)source, (Type*)target)) {
		return false;
	};
	BaseSearch conversion = base_search(@compiler, (Type*)source->data.element, (Type*)target->data.element);
	Entity* current := source->data.element->data.entity;
	BasePath* path := conversion.path;
	u64 offset = 0;
	while (path) {
		if (path->relation->kind == base_kind::kw_virtual) {
			return true;
		};
		@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)current), (u32)path->relation->component);
		@current := path->relation->entity;
		@path := path->next;
	};
	return offset != 0;
};

fn Emitter::storage_address(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return LLVMOpaqueValue*(this.component_source);
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	switch (syntax->kind) {
		case syntax_kind::expr_construct:
			@this.expression((Syntax*)syntax);
			return LLVMOpaqueValue*(backend_syntax(@compiler.backend, (Syntax*)syntax)->constructed);
		case syntax_kind::expr_binary:
			if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
				return @this.special_call((Entity*)syntax->entity, @this.address((Syntax*)syntax->data.binary.left), (Syntax*)syntax->data.binary.right);
			};
			if (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy) {
				@this.expression((Syntax*)syntax);
				return LLVMOpaqueValue*(backend_syntax(@compiler.backend, (Syntax*)syntax)->address);
			};
			break;
		case syntax_kind::expr_access:
			return @this.storage_address((Syntax*)syntax->data.expression);
		case syntax_kind::expr_base_reference:
			return @this.base_conversion((Syntax*)syntax);
		case syntax_kind::expr_name:
			if (syntax->entity->kind == entity_kind::function) {
				return runtime_callable(@compiler, (Entity*)syntax->entity);
			};
			return LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)syntax->entity)->value);
		case syntax_kind::expr_cast:
			return @this.address((Syntax*)syntax->data.cast.value);
		case syntax_kind::expr_call:
			return @this.call((Syntax*)syntax);
		case syntax_kind::expr_unary:
			return @this.expression((Syntax*)syntax->data.unary.value);
		case syntax_kind::expr_member: {
			Syntax* object := syntax->data.member.object;
			Type* type := object->type;
			LLVMOpaqueValue* address = nullptr;
			if (syntax->token.kind == token_kind::op_arrow) {
				@address = @this.expression((Syntax*)object);
				@type := type->data.element;
			}
			else if (syntax_category((Syntax*)object) == value_category::storage) {
				@address = @this.address((Syntax*)object);
			}
			else {
				@address = @this.address((Syntax*)object);
			};
			Entity* owner := syntax->entity->data.variable.data.field.owner;
			if (type->data.entity != owner) {
				BaseSearch path = base_search(@compiler, (Type*)type, entity_type((Entity*)owner));
				@address = @this.base_address(LLVMOpaqueValue*(address), (Entity*)type->data.entity, (BasePath*)path.path, base_direction::up);
				@type = entity_type((Entity*)owner);
			};
			if (type->data.entity->kind == entity_kind::kw_union) {
				return $address;
			};
			LLVMOpaqueValue* field = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)type->data.entity), LLVMOpaqueValue*(address), (u32)syntax->entity->data.variable.data.field.index, "field\0");
			return $field;
		};
		case syntax_kind::expr_index: {
			Syntax* object := syntax->data.binary.left;
			LLVMOpaqueValue* index = @this.expression((Syntax*)syntax->data.binary.right);
			@index = @this.cast(LLVMOpaqueValue*(index), (Type*)syntax->data.binary.right->type, (Type*)compiler.usize_type);
			LLVMOpaqueValue*[2] indices {};
			if (object->type->kind == type_kind::array) {
				@indices[0] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), 0, 0);
				@indices[1] := index;
				return LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)object->type), @this.address((Syntax*)object), &indices[0], 2, "element\0");
			};
			@indices[0] = LLVMOpaqueValue*(index);
			return LLVMBuildGEP2($builder, llvm_type(@compiler, (Type*)object->type->data.element), @this.expression($object), &indices[0], 1, "element\0");
		};
	};
	compiler_error(@compiler, syntax->token, "expression has no storage address\0");
	return nullptr;
};

fn type_has_views(Type* type) -> bool {
	@type = type_representation(Type*(type));
	if (!type) {
		return false;
	};
	if (type->kind == type_kind::array) {
		return type_has_views((Type*)type->data.array.element);
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (aggregate_header((Entity*)entity)) {
		return true;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_has_views(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_has_views(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn type_requires_union_choice(Type* type) -> bool {
	return type_contains($type, type_property::union_selection);
};


fn Emitter::array_element(Emitter& this, Type* type, LLVMOpaqueValue* address, usize index) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueValue*[2] indices {};
	@indices[0] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), 0, 0);
	@indices[1] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)index, 0);
	return LLVMBuildGEP2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, $type), $address, &indices[0], 2, "array.element\0");
};

fn Emitter::initialize_body_fields(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		Type* type = entity_type((Entity*)field->entity);
		if (type_has_views((Type*)type)) {
			LLVMOpaqueValue* storage = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)field->entity->data.variable.data.field.index, "member.object\0");
			@this.initialize_type((Type*)type, $storage);
		};
		@field := field->next;
	};
};

fn Emitter::initialize_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	Compiler& compiler = @*this.compiler;
	if (type_enum((Type*)type)) {
		@this.initialize_type((Type*)type->data.entity->data.enumeration.underlying, $address);
		return;
	};
	if (!type_has_views((Type*)type)) {
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.initialize_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;

	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $entity);
	complete_offsets(@compiler, (CompleteGraph*)graph);
	Subobject* object := graph->objects;
	while (object) {
		LLVMOpaqueValue* storage = @this.byte_offset(LLVMOpaqueValue*(address), (u64)object->offset);
		if (aggregate_header((Entity*)object->entity)) {
			LLVMOpaqueValue* header = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)object->entity), LLVMOpaqueValue*(storage), 0, "view.storage\0");
			LLVMBuildStore(compiler.backend.llvm_builder.get(), runtime_view_request(@compiler, (CompleteGraph*)graph, (Subobject*)object), $header);
		};
		@this.initialize_body_fields((Entity*)object->entity, $storage);
		@object := object->next;
	};
};

fn Emitter::body_payload_copy(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)base->component, "copy.base.destination\0");
			LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)base->component, "copy.base.source\0");
			@this.body_payload_copy((Entity*)base->entity, $target, $origin);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)field->entity->data.variable.data.field.index, "copy.field.destination\0");
		LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)field->entity->data.variable.data.field.index, "copy.field.source\0");
		@this.payload_copy(entity_type((Entity*)field->entity), $target, $origin);
		@field := field->next;
	};
};

fn Emitter::payload_copy(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	Compiler& compiler = @*this.compiler;
	if (!type_has_views((Type*)type) || (type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_union)) {
		LLVMOpaqueValue* value = LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)type), LLVMOpaqueValue*(source), "copy.value\0");
		LLVMBuildStore(compiler.backend.llvm_builder.get(), $value, LLVMOpaqueValue*(destination));
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.payload_copy((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(destination), (u64)index), @this.array_element((Type*)type, LLVMOpaqueValue*(source), (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;
	@this.body_payload_copy((Entity*)entity, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
	CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
	Subobject* target := graph->virtuals;
	while (target) {
		BasePath* path = nullptr;
		subobject_find_path(@compiler, (Subobject*)graph->root, (Subobject*)target, &path);
		LLVMOpaqueValue* origin = @this.base_address(LLVMOpaqueValue*(source), (Entity*)entity, (BasePath*)path, base_direction::up);
		LLVMOpaqueValue* result = @this.base_address(LLVMOpaqueValue*(destination), (Entity*)entity, $path, base_direction::up);
		@this.body_payload_copy((Entity*)target->entity, $result, $origin);
		@target := target->virtual_next;
	};
};

fn Emitter::complete_read(Emitter& this, Type* type, LLVMOpaqueValue* source) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	if (!type_has_views((Type*)type) || (type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_union)) {
		return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)type), LLVMOpaqueValue*(source), "value\0");
	};
	LLVMOpaqueValue* value = emit_slot(@compiler, (Type*)type);
	@this.initialize_type((Type*)type, LLVMOpaqueValue*(value));
	@this.payload_copy((Type*)type, LLVMOpaqueValue*(value), $source);
	return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, $type), $value, "complete.value\0");
};

fn Emitter::value_read(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	return @this.complete_read((Type*)syntax->type, @this.address($syntax));
};

fn Emitter::truth(Emitter& this, LLVMOpaqueValue* value, Type* type) -> LLVMOpaqueValue* {
	@type = type_representation(Type*(type));
	LLVMOpaqueValue* zero = LLVMConstNull(llvm_type(@*this.compiler, (Type*)type));
	if (type->kind == type_kind::kw_float) {
		return LLVMBuildFCmp(this.compiler->backend.llvm_builder.get(), 14, LLVMOpaqueValue*(value), LLVMOpaqueValue*(zero), "truth\0");
	};
	return LLVMBuildICmp(this.compiler->backend.llvm_builder.get(), 33, $value, $zero, "truth\0");
};

fn Emitter::address(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_owned_component) {
		return LLVMOpaqueValue*(this.component_source);
	};
	if (syntax->kind == syntax_kind::expr_access) {
		return @this.address((Syntax*)syntax->data.expression);
	};
	if (syntax_category((Syntax*)syntax) == value_category::temporary) {
		LLVMOpaqueValue* value = @this.expression((Syntax*)syntax);
		BackendSyntax* native = backend_syntax(@this.compiler->backend, (Syntax*)syntax);
		if (!native) {
			return nullptr;
		};
		if (native->address) {
			return LLVMOpaqueValue*(native->address);
		};
		LLVMOpaqueValue* slot = emit_slot(@*this.compiler, (Type*)syntax->type);
		LLVMBuildStore(this.compiler->backend.llvm_builder.get(), $value, LLVMOpaqueValue*(slot));
		@native->address := slot;
		return $slot;
	};
	LLVMOpaqueValue* address = @this.storage_address((Syntax*)syntax);
	Type* storage = syntax_storage_type((Syntax*)syntax);
	if (storage && storage->kind == type_kind::reference && syntax->kind != syntax_kind::expr_call && syntax->kind != syntax_kind::expr_cast && syntax->kind != syntax_kind::expr_base_reference) {
		return LLVMBuildLoad2(this.compiler->backend.llvm_builder.get(), llvm_type(@*this.compiler, $storage), LLVMOpaqueValue*(address), "referent\0");
	};
	return $address;
};


fn Emitter::cast(Emitter& this, LLVMOpaqueValue* value, Type* source, Type* target) -> LLVMOpaqueValue* {
	@source = type_representation(Type*(source));
	@target = type_representation(Type*(target));
	LLVMOpaqueBuilder* builder := this.compiler->backend.llvm_builder.get();
	LLVMOpaqueType* type = llvm_type(@*this.compiler, (Type*)target);
	if (target->kind == type_kind::kw_bool && source->kind != type_kind::kw_bool) {
		return @this.truth(LLVMOpaqueValue*(value), (Type*)source);
	};
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	if (source->kind == type_kind::pointer || source->kind == type_kind::reference) {
		if (target->kind == type_kind::pointer || target->kind == type_kind::reference) {
			return $value;
		};
		return LLVMBuildPtrToInt(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (target->kind == type_kind::pointer || target->kind == type_kind::reference) {
		return LLVMBuildIntToPtr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (source->kind == type_kind::kw_float && target->kind == type_kind::kw_float) {
		return LLVMBuildFPCast(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (source->kind == type_kind::kw_float) {
		if (type_unsigned((Type*)target)) {
			return LLVMBuildFPToUI(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
		};
		return LLVMBuildFPToSI(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (target->kind == type_kind::kw_float) {
		if (type_unsigned((Type*)source) || source->kind == type_kind::kw_char) {
			return LLVMBuildUIToFP(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
		};
		return LLVMBuildSIToFP(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	return LLVMBuildIntCast2($builder, $value, $type, !(type_unsigned((Type*)source) || source->kind == type_kind::kw_char), "cast\0");
};

fn emit_extension(Compiler& compiler, Type* type) -> LLVMOpaqueAttributeRef* {
	@type = type_representation(Type*(type));
	if (!type_integer((Type*)type) || type_bits((Type*)type) >= 32) {
		return nullptr;
	};
	char* name = "signext\0";
	if (type_unsigned((Type*)type) || type->kind == type_kind::kw_char) {
		@name = "zeroext\0";
	};
	return LLVMCreateEnumAttribute(compiler.backend.llvm_context.get(), LLVMGetEnumAttributeKindForName((char*)name, strlen($name)), 0);
};

fn Emitter::binary(Emitter& this, Syntax* syntax, LLVMOpaqueValue* first, LLVMOpaqueValue* second) -> LLVMOpaqueValue* {
	LLVMOpaqueBuilder* builder := this.compiler->backend.llvm_builder.get();
	Type* type := syntax->data.binary.left->type;
	token_kind operation := syntax->data.binary.operation;
	if (operation != token_kind::op_equal && operation != token_kind::op_not_equal && operation != token_kind::op_less && operation != token_kind::op_greater && operation != token_kind::op_less_equal && operation != token_kind::op_greater_equal) {
		@type := syntax->type;
	};
	@type = type_representation(Type*(type));
	if (type->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
		@second = @this.cast(LLVMOpaqueValue*(second), (Type*)syntax->data.binary.right->type, (Type*)this.compiler->usize_type);
		if (operation == token_kind::op_minus) {
			@second = LLVMBuildNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(second), "negative\0");
		};
		return LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@*this.compiler, (Type*)type->data.element), LLVMOpaqueValue*(first), &second, 1, "offset\0");
	};
	if (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) {
		i32 predicate = 32;
		if (operation == token_kind::op_not_equal) {
			@predicate = 33;
		};
		if (operation == token_kind::op_greater) {
			@predicate = 38;
		};
		if (operation == token_kind::op_greater_equal) {
			@predicate = 39;
		};
		if (operation == token_kind::op_less) {
			@predicate = 40;
		};
		if (operation == token_kind::op_less_equal) {
			@predicate = 41;
		};
		LLVMOpaqueValue* result = nullptr;
		if (type->kind == type_kind::kw_float) {
			@predicate = 1;
			if (operation == token_kind::op_not_equal) {
				@predicate = 14;
			};
			if (operation == token_kind::op_greater) {
				@predicate = 2;
			};
			if (operation == token_kind::op_greater_equal) {
				@predicate = 3;
			};
			if (operation == token_kind::op_less) {
				@predicate = 4;
			};
			if (operation == token_kind::op_less_equal) {
				@predicate = 5;
			};
			@result = LLVMBuildFCmp(LLVMOpaqueBuilder*(builder), (i32)predicate, LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "compare\0");
		}
		else {
			if ((type_unsigned((Type*)type) || type->kind == type_kind::kw_char || type->kind == type_kind::pointer) && predicate >= 38) {
				@predicate = predicate - 4;
			};
			@result = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), (i32)predicate, LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "compare\0");
		};
		return $result;
	};
	if (type->kind == type_kind::kw_float) {
		switch (operation) {
			case token_kind::op_plus:
				return LLVMBuildFAdd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "sum\0");
			case token_kind::op_minus:
				return LLVMBuildFSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "difference\0");
			case token_kind::op_star:
				return LLVMBuildFMul(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "product\0");
			case token_kind::op_slash:
				return LLVMBuildFDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
		};
	};
	switch (operation) {
		case token_kind::op_plus:
			return LLVMBuildAdd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "sum\0");
		case token_kind::op_minus:
			return LLVMBuildSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "difference\0");
		case token_kind::op_star:
			return LLVMBuildMul(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "product\0");
		case token_kind::op_slash:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildUDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
			};
			return LLVMBuildSDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
		case token_kind::op_remainder:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildURem(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "remainder\0");
			};
			return LLVMBuildSRem(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "remainder\0");
		case token_kind::op_ampersand:
			return LLVMBuildAnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "and\0");
		case token_kind::op_pipe:
			return LLVMBuildOr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "or\0");
		case token_kind::op_caret:
			return LLVMBuildXor(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "xor\0");
		case token_kind::op_shift_left:
			return LLVMBuildShl(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "shift\0");
		case token_kind::op_shift_right:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildLShr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "shift\0");
			};
			return LLVMBuildAShr($builder, $first, $second, "shift\0");
	};
	compiler_error(@*this.compiler, syntax->token, "unsupported numeric operation\0");
	return nullptr;
};

fn Emitter::call(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	if (syntax->data.call.receiver.kind == receiver_kind::evaluate) {
		Syntax* object := syntax->data.call.receiver.value;
		if (syntax_category((Syntax*)object) == value_category::storage) {
			@this.address((Syntax*)object);
		}
		else {
			@this.expression((Syntax*)object);
		};
	};
	Syntax* callee := syntax->data.call.callable;
	Type* signature := callee->type;
	if (signature->kind == type_kind::pointer) {
		@signature := signature->data.element;
	};
	u32 count = 0;
	if (syntax->data.call.receiver.kind == receiver_kind::bind) {
		@count = 1;
	};
	Syntax* argument := syntax->data.call.arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	LLVMOpaqueValue** values = (LLVMOpaqueValue**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueValue*));
	Parameter* parameter := signature->data.function.parameters;
	@argument := syntax->data.call.arguments;
	u32 index = 0;
	if (syntax->data.call.receiver.kind == receiver_kind::bind) {
		Syntax* receiver := syntax->data.call.receiver.value;
		if (parameter->type->kind == type_kind::reference) {
			@values[0] = @this.address((Syntax*)receiver);
		}
		else {
			@values[0] = @this.expression((Syntax*)receiver);
		};
		@parameter := parameter->next;
		@index = 1;
	};
	while (argument) {
		LLVMOpaqueValue* value = nullptr;
		if (argument->kind == syntax_kind::node_block) {
			BackendEntity* storage = backend_entity_define(@compiler, (Entity*)argument->entity);
			if (!storage) {
				return nullptr;
			};
			@storage->value = emit_slot(@compiler, (Type*)argument->type);
			if (argument->data.statements && argument->type->kind != type_kind::reference) {
				@this.initialize_type((Type*)argument->type, LLVMOpaqueValue*(storage->value));
			};
			@this.statement((Syntax*)argument);
			@value = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)argument->type), LLVMOpaqueValue*(storage->value), "argument\0");
		}
		else if (parameter && parameter->type->kind == type_kind::reference) {
			@value = @this.address((Syntax*)argument);
		}
		else {
			@value = @this.expression((Syntax*)argument);
		};
		if (parameter && parameter->type->kind != type_kind::reference) {
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)argument->type, (Type*)parameter->type);
		};
		if (!parameter) {
			Type* promoted := argument->type;
			if (promoted->kind == type_kind::kw_float && promoted->data.bits == 32) {
				@promoted = type_new(@compiler, type_kind::kw_float);
				@promoted->data.bits = 64;
			}
			else if (type_integer((Type*)promoted) && type_bits((Type*)promoted) < 32) {
				@promoted := compiler.i32_type;
			};
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)argument->type, $promoted);
		};
		@values[index] = $value;
		@index = index + 1;
		@argument := argument->next;
		if (parameter) {
			@parameter := parameter->next;
		};
	};
	char* name = "call\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* target = nullptr;
	if (callee->kind == syntax_kind::expr_name && callee->entity && callee->entity->kind == entity_kind::function) {
		Entity* function := callee->entity;
		if (function->data.function.callable && !syntax->data.call.qualified_owner && !callee->data.expression) {
			@target = @this.dispatch_target((Entity*)function, LLVMOpaqueValue*(values[0]));
		}
		else {
			@target := backend_entity(@compiler.backend, (Entity*)function)->value;
		};
	}
	else {
		@target = @this.expression((Syntax*)callee);
	};
	LLVMOpaqueValue* call = LLVMBuildCall2($builder, llvm_type(@compiler, (Type*)signature), $target, $values, $count, $name);
	LLVMOpaqueAttributeRef* extension = emit_extension(@compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), 0, LLVMOpaqueAttributeRef*(extension));
	};
	@index = 1;
	@parameter := signature->data.function.parameters;
	while (parameter) {
		@extension = emit_extension(@compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), (u32)index, LLVMOpaqueAttributeRef*(extension));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
	return $call;
};

fn Emitter::special_call(Emitter& this, Entity* function, LLVMOpaqueValue* receiver, Syntax* arguments) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Type* signature := function->data.function.type;
	u32 count = 1;
	Syntax* argument := arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	LLVMOpaqueValue** values = (LLVMOpaqueValue**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueValue*));
	@values[0] = $receiver;
	Parameter* parameter := signature->data.function.parameters->next;
	@argument := arguments;
	u32 index = 1;
	while (argument && parameter) {
		if (parameter->type->kind == type_kind::reference) {
			@values[index] = @this.address((Syntax*)argument);
		}
		else {
			@values[index] = @this.cast(@this.expression((Syntax*)argument), (Type*)argument->type, (Type*)parameter->type);
		};
		@argument := argument->next;
		@parameter := parameter->next;
		@index = index + 1;
	};
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)function);
	char* name = "special.call\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), $values, $count, $name);
	emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), $signature);
	return $call;
};

fn Emitter::component_call(Emitter& this, Entity* function, LLVMOpaqueValue* receiver, Syntax* argument, LLVMOpaqueValue* source) -> LLVMOpaqueValue* {
	LLVMOpaqueValue* previous := this.component_source;
	@this.component_source = $source;
	LLVMOpaqueValue* result = @this.special_call($function, $receiver, $argument);
	@this.component_source = $previous;
	return $result;
};

fn type_requires_destruction(Type* type) -> bool {
	return type_contains($type, type_property::destruction);
};


fn Emitter::destroy_fields(Emitter& this, Field* field, LLVMOpaqueValue* address) {
	if (!field) {
		return;
	};
	@this.destroy_fields((Field*)field->next, LLVMOpaqueValue*(address));
	Entity* entity := field->entity;
	Entity* owner := entity->data.variable.data.field.owner;
	LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, $owner), $address, (u32)entity->data.variable.data.field.index, "destroy.field\0");
	@this.destroy_type(entity_type($entity), $member);
};


fn Emitter::destroy_bases(Emitter& this, Entity* owner, BaseRelation* base, LLVMOpaqueValue* address) {
	if (!base) {
		return;
	};
	@this.destroy_bases((Entity*)owner, (BaseRelation*)base->next, LLVMOpaqueValue*(address));
	if (base->kind == base_kind::nonvirtual) {
		LLVMOpaqueValue* subobject = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, (Entity*)owner), LLVMOpaqueValue*(address), (u32)base->component, "destroy.base\0");
		@this.destroy_body((Entity*)base->entity, $subobject);
	};
};

fn Emitter::destroy_body(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->data.aggregate.destructor) {
		if (entity->data.aggregate.destructor->data.function.definition == function_definition::deleted) {
			compiler_error(@*this.compiler, entity->name, "selected destructor is deleted\0");
			return;
		};
		if (entity->data.aggregate.destructor->data.function.definition != function_definition::defaulted) {
			@this.special_call((Entity*)entity->data.aggregate.destructor, LLVMOpaqueValue*(address), nullptr);
		};
	};
	if (entity->kind == entity_kind::kw_enum) {
		@this.destroy_type((Type*)entity->data.enumeration.underlying, $address);
		return;
	};
	if (entity->kind == entity_kind::kw_union) {
		if (!entity->data.aggregate.destructor || entity->data.aggregate.destructor->data.function.definition == function_definition::defaulted) {
			Field* field := entity->data.aggregate.fields;
			while (field) {
				if (type_requires_destruction(entity_type((Entity*)field->entity))) {
					compiler_error(@*this.compiler, entity->name, "union with nontrivial members requires an explicit destructor\0");
					return;
				};
				@field := field->next;
			};
		};
		return;
	};
	@this.destroy_fields((Field*)entity->data.aggregate.fields, LLVMOpaqueValue*(address));
	@this.destroy_bases((Entity*)entity, (BaseRelation*)entity->data.aggregate.bases, $address);
};

fn Emitter::destroy_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (!type_requires_destruction((Type*)type)) {
		return;
	};
	if (type->kind == type_kind::array) {
		u64 index := type->data.array.count;
		while (index) {
			@index = index - 1;
			@this.destroy_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (usize)index));
		};
		return;
	};
	if (type->kind != type_kind::named) {
		return;
	};
	Entity* entity := type->data.entity;
	if (type_has_views($type)) {
		compiler_error(@*this.compiler, entity->name, "nontrivial polymorphic lifetimes are not implemented\0");
		return;
	};
	@this.destroy_body($entity, $address);
};

fn Emitter::cleanups(Emitter& this, Syntax* syntax) {
	LifetimeCleanup* cleanup := syntax->cleanup;
	while (cleanup) {
		Entity* entity := cleanup->entity;
		@this.destroy_type(entity_type((Entity*)entity), LLVMOpaqueValue*(backend_entity(@this.compiler->backend, (Entity*)entity)->value));
		@cleanup := cleanup->next;
	};
};

fn aggregate_default_constructor(Entity* entity) -> Entity* {
	Entity* constructor := entity->data.aggregate.constructors;
	while (constructor) {
		Parameter* parameter := constructor->data.function.type->data.function.parameters;
		if (parameter && !parameter->next) {
			return $constructor;
		};
		@constructor := constructor->data.function.overload_next;
	};
	return nullptr;
};

fn type_has_lifecycle_callbacks(Type* type) -> bool {
	return type_contains($type, type_property::lifecycle_callbacks);
};

fn Emitter::lifetime_polymorphism_supported(Emitter& this, Type* type) -> bool {
	if (type_has_views((Type*)type) && type_has_lifecycle_callbacks((Type*)type)) {
		Token token;
		if (type->kind == type_kind::named) {
			@token := type->data.entity->name;
		};
		compiler_error(@*this.compiler, token, "nontrivial polymorphic lifetimes are not implemented\0");
		return false;
	};
	return true;
};


fn Emitter::default_body_members(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* subobject = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)base->component, "construct.base\0");
			@this.default_body((Entity*)base->entity, $subobject);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* member = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)field->entity->data.variable.data.field.index, "construct.field\0");
		@this.default_type(entity_type((Entity*)field->entity), $member);
		@field := field->next;
	};
};

fn Emitter::default_body(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	Entity* constructor = aggregate_default_constructor((Entity*)entity);
	if (!constructor || constructor->data.function.definition != function_definition::defaulted) {
		@this.default_body_members((Entity*)entity, LLVMOpaqueValue*(address));
	};
	if (constructor) {
		@this.special_call((Entity*)constructor, LLVMOpaqueValue*(address), nullptr);
	};
};

fn Emitter::default_members(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (!@this.lifetime_polymorphism_supported((Type*)type)) {
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	Entity* entity := type->data.entity;
	@this.default_body_members($entity, $address);
};

fn Emitter::default_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (type_enum((Type*)type)) {
		@this.default_type((Type*)type->data.entity->data.enumeration.underlying, $address);
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.default_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (u64)index));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	Entity* constructor = aggregate_default_constructor((Entity*)type->data.entity);
	if (!constructor || constructor->data.function.definition != function_definition::defaulted) {
		@this.default_members((Type*)type, LLVMOpaqueValue*(address));
	};
	if (constructor) {
		@this.special_call((Entity*)constructor, LLVMOpaqueValue*(address), nullptr);
	};
};

enum storage_extent : [i32] {
	body;
	complete;
};

fn Emitter::temporary_register(Emitter& this, Type* type, LLVMOpaqueValue* value, LLVMOpaqueValue* address) -> LLVMOpaqueValue* {
	Temporary* temporary = (Temporary*)memory_allocate(@*this.compiler, sizeof(Temporary));
	@temporary->type := type;
	if (!address) {
		@address = emit_slot(@*this.compiler, (Type*)type);
		LLVMBuildStore(this.compiler->backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(address));
	};
	@temporary->address := address;
	@temporary->next := this.temporaries;
	@this.temporaries = $temporary;
	return $address;
};

fn Emitter::storage_special(Emitter& this, Type* type, function_role role, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, syntax_kind kind, storage_extent extent) -> bool {
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return false;
	};
	Syntax* argument = (Syntax*)memory_allocate(@*this.compiler, sizeof(Syntax));
	if (!argument) {
		return false;
	};
	@argument->kind := kind;
	@argument->token := type->data.entity->name;
	@argument->type := type;
	@argument->use = value_use::transferred;
	if (kind == syntax_kind::expr_borrowed_component) {
		@argument->type = type_qualified(@*this.compiler, (Type*)type, type_qualifier::kw_const);
	};
	Semantic semantic;
	@semantic.compiler := this.compiler;
	@semantic.scope := this.compiler->module;
	Entity* function = @semantic.special_select((Entity*)type->data.entity, (function_role)role, (Syntax*)argument, Token(argument->token));
	if (!function) {
		return false;
	};
	if (function->data.function.definition == function_definition::defaulted) {
		storage_transfer operation = storage_transfer::copy_construct;
		if (role == function_role::assignment) {
			@operation = storage_transfer::copy_assign;
		};
		@this.transfer_members((Entity*)type->data.entity, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), $operation);
		if (role == function_role::assignment && kind == syntax_kind::expr_owned_component) {
			@this.destroy_type((Type*)type, LLVMOpaqueValue*(source));
		};
		return true;
	};
	if (role == function_role::constructor) {
		if (extent == storage_extent::complete) {
			@this.default_members((Type*)type, LLVMOpaqueValue*(destination));
		}
		else {
			@this.default_body_members((Entity*)type->data.entity, LLVMOpaqueValue*(destination));
		};
	};
	LLVMOpaqueValue* result = @this.component_call((Entity*)function, $destination, (Syntax*)argument, LLVMOpaqueValue*(source));
	Type* result_type := function->data.function.type->data.function.result;
	if (role == function_role::assignment && result_type->kind != type_kind::reference && type_requires_destruction((Type*)result_type)) {
		@this.temporary_register((Type*)result_type, LLVMOpaqueValue*(result), nullptr);
	};
	if (role == function_role::assignment && kind == syntax_kind::expr_owned_component && function->data.function.type->data.function.parameters->next->type->kind == type_kind::reference) {
		@this.destroy_type((Type*)type, LLVMOpaqueValue*(source));
	};
	return true;
};

enum storage_transfer : [i32] {
	copy_construct;
	assign;
	copy_assign;
};

fn Emitter::transfer_body(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	Type* type = entity_type((Entity*)entity);
	function_role role = function_role::constructor;
	syntax_kind argument = syntax_kind::expr_borrowed_component;
	if (operation == storage_transfer::assign || operation == storage_transfer::copy_assign) {
		@role = function_role::assignment;
		if (operation == storage_transfer::assign) {
			@argument = syntax_kind::expr_owned_component;
		};
	};
	if (@this.storage_special((Type*)type, $role, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), $argument, storage_extent::body)) {
		return;
	};
	@this.transfer_members($entity, $destination, $source, $operation);
};

fn Emitter::transfer_members(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	Type* type = entity_type((Entity*)entity);
	if (entity->kind == entity_kind::kw_union) {
		@this.payload_copy($type, $destination, $source);
		return;
	};

	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)base->component, "transfer.base.target\0");
			LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)base->component, "transfer.base.source\0");
			@this.transfer_body((Entity*)base->entity, $target, $origin, (storage_transfer)operation);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)field->entity->data.variable.data.field.index, "transfer.field.target\0");
		LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)field->entity->data.variable.data.field.index, "transfer.field.source\0");
		@this.transfer_type(entity_type((Entity*)field->entity), $target, $origin, (storage_transfer)operation);
		@field := field->next;
	};
};

fn Emitter::transfer_type(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	if (type_enum((Type*)type)) {
		@this.transfer_type((Type*)type->data.entity->data.enumeration.underlying, $destination, $source, $operation);
		return;
	};
	if (!@this.lifetime_polymorphism_supported((Type*)type)) {
		return;
	};
	if ((operation == storage_transfer::assign || operation == storage_transfer::copy_assign) && (type->qualifier == type_qualifier::kw_const || type->kind == type_kind::reference)) {
		Token token;
		compiler_error(@*this.compiler, token, "generated assignment cannot replace a const or reference component\0");
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.transfer_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(destination), (u64)index), @this.array_element((Type*)type, LLVMOpaqueValue*(source), (u64)index), (storage_transfer)operation);
			@index = index + 1;
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		@this.payload_copy($type, $destination, $source);
		return;
	};
	if (operation == storage_transfer::copy_construct && @this.storage_special((Type*)type, function_role::constructor, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), syntax_kind::expr_borrowed_component, storage_extent::complete)) {
		return;
	};
	if (type_has_views((Type*)type)) {
		@this.payload_copy($type, $destination, $source);
		return;
	};
	@this.transfer_body((Entity*)type->data.entity, $destination, $source, $operation);
};

fn Emitter::copy_construct_type(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	@this.transfer_type($type, $destination, $source, storage_transfer::copy_construct);
};

fn Emitter::assign_storage(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	@this.transfer_type($type, $destination, $source, storage_transfer::assign);
};

fn Emitter::failed_arguments(Emitter& this, Syntax* argument) {
	if (!argument) {
		return;
	};

	LLVMOpaqueValue* storage = nullptr;
	if (argument->use == value_use::transferred && type_requires_destruction((Type*)argument->type)) {
		@storage = @this.address((Syntax*)argument);
	}
	else {
		@this.expression((Syntax*)argument);
	};

	@this.failed_arguments((Syntax*)argument->next);
	if (storage) {
		@this.destroy_type((Type*)argument->type, LLVMOpaqueValue*(storage));
	};
};

fn Emitter::guard_temporaries(Emitter& this, Temporary* first, Temporary* boundary, LLVMOpaqueBasicBlock* created, LLVMOpaqueBasicBlock* skipped) {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueType* bool_type = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1);
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = $created;
	@blocks[1] = $skipped;
	while (first != boundary) {
		LLVMOpaqueValue*[2] values {};
		@values[0] := first->guard;
		if (!values[0]) {
			@values[0] = LLVMConstInt(LLVMOpaqueType*(bool_type), 1, 0);
		};
		@values[1] = LLVMConstInt(LLVMOpaqueType*(bool_type), 0, 0);
		LLVMOpaqueValue* guard = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(bool_type), "temporary.created\0");
		LLVMAddIncoming(LLVMOpaqueValue*(guard), &values[0], &blocks[0], 2);
		@first->guard = $guard;
		@first := first->next;
	};
};

fn Emitter::construct_at(Emitter& this, Syntax* syntax, LLVMOpaqueValue* slot) {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	Type* target := syntax->data.construction.target;
	Syntax* argument := syntax->data.construction.arguments;
	if (syntax->data.construction.constructor) {
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMConstNull(llvm_type(@compiler, (Type*)target)), LLVMOpaqueValue*(slot));
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		if (syntax->data.construction.constructor->data.function.definition != function_definition::defaulted) {
			@this.default_members((Type*)target, LLVMOpaqueValue*(slot));
		};
		@this.special_call((Entity*)syntax->data.construction.constructor, LLVMOpaqueValue*(slot), (Syntax*)argument);
	}
	else if (!argument) {
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMConstNull(llvm_type(@compiler, (Type*)target)), LLVMOpaqueValue*(slot));
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		@this.default_type((Type*)target, LLVMOpaqueValue*(slot));
	}
	else if (type_aggregate((Type*)target)) {
		LLVMOpaqueValue* source = @this.address((Syntax*)argument);
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		@this.copy_construct_type((Type*)target, LLVMOpaqueValue*(slot), LLVMOpaqueValue*(source));
	}
	else {
		LLVMOpaqueValue* value = @this.cast(@this.expression((Syntax*)argument), (Type*)argument->type, (Type*)target);
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(slot));
	};
};

fn Emitter::expression_value(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return @this.complete_read((Type*)syntax->type, LLVMOpaqueValue*(this.component_source));
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	LLVMOpaqueType* type = llvm_type(@compiler, (Type*)syntax->type);
	switch (syntax->kind) {
		case syntax_kind::kw_new: {
			Syntax* construction := syntax->data.expression;
			Type* target := construction->data.construction.target;
			LLVMOpaqueValue* memory = LLVMBuildMalloc(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)target), "new.storage\0");
			LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.construct\0");
			LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.end\0");
			LLVMOpaqueBasicBlock* failed = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.failed\0");
			LLVMOpaqueValue* empty = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), 32, LLVMOpaqueValue*(memory), LLVMConstNull(llvm_type(@compiler, (Type*)syntax->type)), "new.null\0");
			LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), $empty, LLVMOpaqueBasicBlock*(failed), LLVMOpaqueBasicBlock*(live));
			Temporary* boundary := this.temporaries;
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(live));
			@this.construct_at((Syntax*)construction, LLVMOpaqueValue*(memory));
			@live = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
			Temporary* success := this.temporaries;
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(failed));
			@this.failed_arguments((Syntax*)construction->data.construction.arguments);
			@failed = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $merge);
			@this.guard_temporaries((Temporary*)this.temporaries, (Temporary*)success, LLVMOpaqueBasicBlock*(failed), LLVMOpaqueBasicBlock*(live));
			@this.guard_temporaries($success, $boundary, $live, $failed);
			return $memory;
		};
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard: {
			Syntax* operand := syntax->data.expression;
			LLVMOpaqueValue* memory = @this.expression((Syntax*)operand);
			LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "delete.live\0");
			LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "delete.end\0");
			LLVMOpaqueValue* empty = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), 32, LLVMOpaqueValue*(memory), LLVMConstNull(llvm_type(@compiler, (Type*)operand->type)), "delete.null\0");
			LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $live);
			if (syntax->kind == syntax_kind::kw_delete) {
				@this.destroy_type((Type*)operand->type->data.element, LLVMOpaqueValue*(memory));
			};
			LLVMBuildFree(LLVMOpaqueBuilder*(builder), $memory);
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $merge);
			return nullptr;
		};
		case syntax_kind::expr_destroy:
			@this.destroy_type((Type*)syntax->data.cast.value->type, @this.address((Syntax*)syntax->data.cast.value));
			return nullptr;
		case syntax_kind::kw_discard:
			return nullptr;
		case syntax_kind::expr_construct: {
			Type* target := syntax->data.construction.target;
			LLVMOpaqueValue* slot = nullptr;
			if (syntax->data.construction.destination) {
				@slot = @this.address((Syntax*)syntax->data.construction.destination);
			}
			else {
				@slot = emit_slot(@compiler, (Type*)target);
			};
			@backend_syntax(@compiler.backend, (Syntax*)syntax)->constructed := slot;
			@this.construct_at((Syntax*)syntax, LLVMOpaqueValue*(slot));
			return LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, $target), $slot, "constructed\0");
		};
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
			return @this.expression((Syntax*)syntax->data.expression);
		case syntax_kind::expr_base_pointer:
			return @this.base_conversion((Syntax*)syntax);
		case syntax_kind::expr_base_reference:
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::kw_nullptr:
			return LLVMConstNull($type);
		case syntax_kind::literal_number:
			if (syntax->type->kind == type_kind::pointer) {
				return LLVMConstNull($type);
			};
			if (syntax->type->kind == type_kind::kw_bool) {
				return LLVMConstInt(LLVMOpaqueType*(type), number_truth(@compiler, syntax->token), 0);
			};
			if (syntax->type->kind == type_kind::kw_float) {
				if (syntax->token.source->bytes.data[syntax->token.begin] == '\'') {
					return LLVMConstReal(LLVMOpaqueType*(type), (f64)integer_spelling(@compiler, syntax->token, (u64)18446744073709551615));
				};
				char* text = memory_text(@compiler, syntax->token.source->bytes.data + syntax->token.begin, (u64)syntax->token.length);
				return LLVMConstReal(LLVMOpaqueType*(type), strtod($text, nullptr));
			};
			if (number_decimal(syntax->token)) {
				char* text = memory_text(@compiler, syntax->token.source->bytes.data + syntax->token.begin, usize(syntax->token.length));
				return LLVMConstInt(LLVMOpaqueType*(type), (u64)trunc(strtod($text, nullptr)), 0);
			};
			return LLVMConstInt(LLVMOpaqueType*(type), integer_spelling(@compiler, syntax->token, (u64)18446744073709551615), 0);
		case syntax_kind::literal_string: {
			LLVMOpaqueValue* value = LLVMConstStringInContext2(compiler.backend.llvm_context.get(), (char*)syntax->data.string.data, (u64)syntax->data.string.size, 1);
			LLVMOpaqueValue* global = LLVMAddGlobal(compiler.backend.llvm_module.get(), LLVMTypeOf(LLVMOpaqueValue*(value)), "string\0");
			LLVMSetInitializer(LLVMOpaqueValue*(global), LLVMOpaqueValue*(value));
			LLVMSetGlobalConstant(LLVMOpaqueValue*(global), 1);
			LLVMSetLinkage(LLVMOpaqueValue*(global), 9);
			return $global;
		};
		case syntax_kind::expr_name:
			if (syntax->entity->kind == entity_kind::function) {
				return runtime_callable(@compiler, (Entity*)syntax->entity);
			};
			if (syntax->entity->data.variable.storage == storage_kind::constant) {
				if (syntax->entity->data.variable.evaluation && syntax->entity->data.variable.evaluation->state == constant_state::constant) {
					return constant_llvm(@compiler, (ConstantValue*)syntax->entity->data.variable.evaluation->value);
				};
				return LLVMConstInt(LLVMOpaqueType*(type), (u64)syntax->entity->data.variable.data.integer, 0);
			};
			if (syntax->type->kind == type_kind::function) {
				return @this.address((Syntax*)syntax);
			};
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::expr_member:
		case syntax_kind::expr_index:
			if (syntax->type->kind == type_kind::function) {
				return @this.address((Syntax*)syntax);
			};
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::kw_sizeof:
			return LLVMConstInt($type, LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, (Type*)syntax->data.expression->type)), 0);
		case syntax_kind::expr_cast:
			return @this.cast(@this.expression((Syntax*)syntax->data.cast.value), (Type*)syntax->data.cast.value->type, (Type*)syntax->type);
		case syntax_kind::expr_unary: {
			token_kind operation := syntax->data.unary.operation;
			Syntax* operand := syntax->data.unary.value;
			if (operation == token_kind::op_ampersand) {
				if (operand->type->kind == type_kind::function) {
					return @this.expression((Syntax*)operand);
				};
				return @this.address((Syntax*)operand);
			};
			if (operation == token_kind::op_star) {
				if (syntax->type->kind == type_kind::function) {
					return @this.expression((Syntax*)operand);
				};
				return @this.value_read((Syntax*)syntax);
			};
			LLVMOpaqueValue* value = @this.expression((Syntax*)operand);
			if (operation == token_kind::op_bang) {
				@value = LLVMBuildNot(LLVMOpaqueBuilder*(builder), @this.truth(LLVMOpaqueValue*(value), (Type*)operand->type), "not\0");
				return $value;
			};
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)operand->type, (Type*)syntax->type);
			if (operation == token_kind::op_tilde) {
				return LLVMBuildNot(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "complement\0");
			};
			if (operation == token_kind::op_minus) {
				if (syntax->type->kind == type_kind::kw_float) {
					return LLVMBuildFNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "negative\0");
				};
				return LLVMBuildNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "negative\0");
			};
			return $value;
		};
		case syntax_kind::stmt_bind_reference: {
			Syntax* left := syntax->data.binary.left;
			LLVMOpaqueValue* referent = @this.address((Syntax*)syntax->data.binary.right);
			LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(referent), @this.storage_address((Syntax*)left));
			return $referent;
		};
		case syntax_kind::stmt_initialize:
		case syntax_kind::expr_binary: {
			token_kind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
				if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
					LLVMOpaqueValue* result = @this.special_call((Entity*)syntax->entity, @this.address((Syntax*)left), (Syntax*)right);
					Type* declared := syntax->entity->data.function.type->data.function.result;
					if (declared->kind == type_kind::reference) {
						return @this.complete_read((Type*)syntax->type, LLVMOpaqueValue*(result));
					};
					return $result;
				};
				if (type_aggregate((Type*)left->type)) {
					LLVMOpaqueValue* destination = nullptr;
					if (type_has_views((Type*)left->type)) {
						@destination = @this.address((Syntax*)left);
					};
					LLVMOpaqueValue* source = nullptr;
					if (syntax_category((Syntax*)right) == value_category::storage) {
						@source = @this.address((Syntax*)right);
					}
					else {
						LLVMOpaqueValue* value = @this.expression((Syntax*)right);
						@source = emit_slot(@compiler, (Type*)right->type);
						LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(source));
					};
					if (!destination) {
						@destination = @this.address((Syntax*)left);
					};
					@backend_syntax(@compiler.backend, (Syntax*)syntax)->address := destination;
					if (syntax->kind == syntax_kind::stmt_initialize) {
						if (left->kind != syntax_kind::expr_base_reference) {
							@this.initialize_type((Type*)left->type, LLVMOpaqueValue*(destination));
						};
						@this.payload_copy((Type*)left->type, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
					}
					else {
						@this.assign_storage((Type*)left->type, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
					};
					return @this.complete_read((Type*)left->type, $destination);
				};
				LLVMOpaqueValue* value = @this.expression((Syntax*)right);
				@value = @this.cast(LLVMOpaqueValue*(value), (Type*)right->type, (Type*)left->type);
				LLVMOpaqueValue* destination = @this.address((Syntax*)left);
				@backend_syntax(@compiler.backend, (Syntax*)syntax)->address := destination;
				LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(destination));
				return $value;
			};
			if (operation == token_kind::op_and || operation == token_kind::op_or) {
				LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
				LLVMOpaqueBasicBlock* rhs = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "logical.right\0");
				LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "logical.end\0");
				LLVMOpaqueValue* first = @this.truth(@this.expression((Syntax*)left), (Type*)left->type);
				@initial = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				if (operation == token_kind::op_and) {
					LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueBasicBlock*(rhs), LLVMOpaqueBasicBlock*(merge));
				}
				else {
					LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(rhs));
				};
				LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(rhs));
				Temporary* boundary := this.temporaries;
				LLVMOpaqueValue* second = @this.truth(@this.expression((Syntax*)right), (Type*)right->type);
				@rhs = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
				LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
				LLVMOpaqueValue* phi = LLVMBuildPhi(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), "logical\0");
				LLVMOpaqueValue*[2] values {};
				LLVMOpaqueBasicBlock*[2] blocks {};
				@values[0] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), (u64)(operation == token_kind::op_or), 0);
				@values[1] = LLVMOpaqueValue*(second);
				@blocks[0] = LLVMOpaqueBasicBlock*(initial);
				@blocks[1] = LLVMOpaqueBasicBlock*(rhs);
				LLVMAddIncoming(LLVMOpaqueValue*(phi), &values[0], &blocks[0], 2);
				Temporary* temporary := this.temporaries;
				while (temporary != boundary) {
					LLVMOpaqueValue* guard = LLVMBuildPhi(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), "temporary.created\0");
					@values[0] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), 0, 0);
					@values[1] := temporary->guard;
					if (!values[1]) {
						@values[1] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), 1, 0);
					};
					LLVMAddIncoming(LLVMOpaqueValue*(guard), &values[0], &blocks[0], 2);
					@temporary->guard = LLVMOpaqueValue*(guard);
					@temporary := temporary->next;
				};
				return $phi;
			};
			LLVMOpaqueValue* first = @this.expression((Syntax*)left);
			LLVMOpaqueValue* second = @this.expression((Syntax*)right);
			if (left->type->kind != type_kind::pointer) {
				Type* operand := left->type;
				if (operation != token_kind::op_equal && operation != token_kind::op_not_equal && operation != token_kind::op_less && operation != token_kind::op_greater && operation != token_kind::op_less_equal && operation != token_kind::op_greater_equal) {
					@operand := syntax->type;
				};
				@first = @this.cast(LLVMOpaqueValue*(first), (Type*)left->type, (Type*)operand);
				@second = @this.cast(LLVMOpaqueValue*(second), (Type*)right->type, (Type*)operand);
			};
			return @this.binary((Syntax*)syntax, $first, $second);
		};
		case syntax_kind::expr_call: {
			if (syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference && syntax->type->kind != type_kind::function) {
				return @this.value_read((Syntax*)syntax);
			};
			return @this.call((Syntax*)syntax);
		};
	};
	compiler_error(@compiler, syntax->token, "expression cannot be emitted\0");
	return nullptr;
};

fn Emitter::expression(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return @this.expression_value($syntax);
	};
	BackendSyntax* native = backend_syntax_define(@*this.compiler, (Syntax*)syntax);
	if (!native) {
		return nullptr;
	};
	@native->address = nullptr;
	LLVMOpaqueValue* value = @this.expression_value((Syntax*)syntax);
	if (syntax->kind == syntax_kind::expr_construct) {
		@native->address := native->constructed;
	}
	else if (syntax->kind == syntax_kind::expr_relocate) {
		@native->address = @this.address((Syntax*)syntax->data.expression);
	};
	if (!value || syntax->use == value_use::transferred || syntax_category((Syntax*)syntax) != value_category::temporary || !type_requires_destruction((Type*)syntax->type)) {
		return $value;
	};
	@native->address = @this.temporary_register((Type*)syntax->type, LLVMOpaqueValue*(value), LLVMOpaqueValue*(native->address));
	return $value;
};

fn Emitter::flush_temporaries(Emitter& this, Temporary* boundary) {
	Compiler& compiler = @*this.compiler;
	while (this.temporaries != boundary) {
		Temporary* temporary := this.temporaries;
		@this.temporaries := temporary->next;
		if (!temporary->guard) {
			@this.destroy_type((Type*)temporary->type, LLVMOpaqueValue*(temporary->address));
			continue;
		};
		LLVMOpaqueBasicBlock* destroy = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "temporary.destroy\0");
		LLVMOpaqueBasicBlock* continuation = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "temporary.end\0");
		LLVMBuildCondBr(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(temporary->guard), LLVMOpaqueBasicBlock*(destroy), LLVMOpaqueBasicBlock*(continuation));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $destroy);
		@this.destroy_type((Type*)temporary->type, LLVMOpaqueValue*(temporary->address));
		LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(continuation));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $continuation);
	};
};

fn Emitter::jump(Emitter& this, LLVMOpaqueBasicBlock* block) {
	LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.compiler->backend.llvm_builder.get());
	if (!LLVMGetBasicBlockTerminator($current)) {
		LLVMBuildBr(this.compiler->backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(block));
	};
};

fn emit_has_predecessor(LLVMOpaqueBasicBlock* target) -> i32 {
	LLVMOpaqueBasicBlock* block = LLVMGetFirstBasicBlock(LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(target)));
	while (block) {
		LLVMOpaqueValue* instruction = LLVMGetBasicBlockTerminator(LLVMOpaqueBasicBlock*(block));
		if (instruction) {
			u32 count = LLVMGetNumSuccessors(LLVMOpaqueValue*(instruction));
			u32 index = 0;
			while (index < count) {
				if (LLVMGetSuccessor(LLVMOpaqueValue*(instruction), (u32)index) == target) {
					return 1;
				};
				@index = index + 1;
			};
		};
		@block = LLVMGetNextBasicBlock(LLVMOpaqueBasicBlock*(block));
	};
	return 0;
};

fn Emitter::statement(Emitter& this, Syntax* syntax) {
	Compiler& compiler = @*this.compiler;
	if (!syntax || compiler.result == compilation_result::failure) {
		return;
	};
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	Temporary* temporaries := this.temporaries;
	if (syntax->kind != syntax_kind::kw_case && syntax->kind != syntax_kind::node_block && syntax->kind != syntax_kind::node_declaration && LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder)))) {
		return;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			Syntax* statement := syntax->data.statements;
			while (statement) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			break;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind == entity_kind::variable) {
				Entity* variable := syntax->entity;
				BackendEntity* storage = backend_entity_define(@compiler, (Entity*)variable);
				if (!storage) {
					return;
				};
				@storage->value = emit_slot(@compiler, (Type*)variable->data.variable.type);
				if (LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder)))) {
					break;
				};
				if (!syntax->data.declaration.body) {
					LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMConstNull(llvm_type(@compiler, (Type*)variable->data.variable.type)), LLVMOpaqueValue*(storage->value));
					@this.initialize_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
					@this.default_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
				}
				else if (syntax->data.declaration.body->data.statements && variable->data.variable.type->kind != type_kind::reference) {
					@this.initialize_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
				};
				@this.statement((Syntax*)syntax->data.declaration.body);
			};
			break;
		case syntax_kind::kw_return:
			if (syntax->data.expression) {
				Syntax* expression := syntax->data.expression;
				Type* result := this.function->data.function.type->data.function.result;
				LLVMOpaqueValue* value = nullptr;
				if (result->kind == type_kind::reference) {
					@value = @this.address((Syntax*)expression);
				}
				else {
					@value = @this.expression((Syntax*)expression);
					@value = @this.cast(LLVMOpaqueValue*(value), (Type*)expression->type, (Type*)result);
				};
				if (this.return_type && !type_equal((Type*)result, (Type*)this.return_type)) {
					@value = @this.covariant_result(LLVMOpaqueValue*(value), (Type*)result, (Type*)this.return_type);
				};
				@this.flush_temporaries(nullptr);
				@this.cleanups((Syntax*)syntax);
				LLVMBuildRet(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value));
			}
			else {
				@this.flush_temporaries(nullptr);
				@this.cleanups((Syntax*)syntax);
				LLVMBuildRetVoid(LLVMOpaqueBuilder*(builder));
			};
			break;
		case syntax_kind::kw_break:
			@this.cleanups((Syntax*)syntax);
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(this.flow->break_block));
			break;
		case syntax_kind::kw_continue: {
			Flow* flow := this.flow;
			while (flow && flow->kind != flow_kind::loop) {
				@flow := flow->parent;
			};
			@this.cleanups((Syntax*)syntax);
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(flow->continue_block));
			break;
		};
		case syntax_kind::kw_if: {
			LLVMOpaqueValue* function := this.llvm_function;
			LLVMOpaqueBasicBlock* first = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "if.then\0");
			LLVMOpaqueBasicBlock* second = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "if.else\0");
			LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "if.end\0");
			Syntax* condition := syntax->data.branch.condition;
			LLVMOpaqueValue* predicate = @this.truth(@this.expression((Syntax*)condition), (Type*)condition->type);
			@this.flush_temporaries((Temporary*)temporaries);
			LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(predicate), LLVMOpaqueBasicBlock*(first), LLVMOpaqueBasicBlock*(second));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(first));
			@this.statement((Syntax*)syntax->data.branch.first);
			i32 first_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder))) != nullptr;
			@this.jump(LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(second));
			@this.temporaries := temporaries;
			@this.statement((Syntax*)syntax->data.branch.second);
			i32 second_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder))) != nullptr;
			@this.jump(LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			@this.temporaries := temporaries;
			if (first_stops && second_stops) {
				LLVMBuildUnreachable(LLVMOpaqueBuilder*(builder));
			};
			break;
		};
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			LLVMOpaqueValue* function := this.llvm_function;
			LLVMOpaqueBasicBlock* test = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "loop.test\0");
			LLVMOpaqueBasicBlock* body = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "loop.body\0");
			LLVMOpaqueBasicBlock* step = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "loop.step\0");
			LLVMOpaqueBasicBlock* end = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "loop.end\0");
			@this.statement((Syntax*)syntax->data.loop.initializer);
			@this.jump(LLVMOpaqueBasicBlock*(test));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(test));
			Syntax* condition := syntax->data.loop.condition;
			if (condition) {
				LLVMOpaqueValue* predicate = @this.truth(@this.expression((Syntax*)condition), (Type*)condition->type);
				@this.flush_temporaries((Temporary*)temporaries);
				LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(predicate), LLVMOpaqueBasicBlock*(body), LLVMOpaqueBasicBlock*(end));
			}
			else {
				LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(body));
			};
			Flow flow;
			@flow.kind = flow_kind::loop;
			@flow.parent := this.flow;
			@flow.break_block := end;
			@flow.continue_block := step;
			@this.flow = &flow;
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(body));
			@this.statement((Syntax*)syntax->data.loop.body);
			@this.jump(LLVMOpaqueBasicBlock*(step));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(step));
			@this.temporaries := temporaries;
			if (syntax->data.loop.step) {
				@this.expression((Syntax*)syntax->data.loop.step);
				@this.flush_temporaries((Temporary*)temporaries);
			};
			@this.jump(LLVMOpaqueBasicBlock*(test));
			@this.flow := flow.parent;
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(end));
			@this.temporaries := temporaries;
			break;
		};
		case syntax_kind::kw_switch: {
			LLVMOpaqueValue* function := this.llvm_function;
			LLVMOpaqueBasicBlock* end = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "switch.end\0");
			LLVMOpaqueBasicBlock* fallback := end;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			CaseBlock* previous := this.cases;
			CaseBlock* cases = nullptr;
			u32 count = 0;
			while (statement) {
				if (statement->kind == syntax_kind::kw_case) {
					CaseBlock* selection = (CaseBlock*)memory_allocate(@compiler, sizeof(CaseBlock));
					@selection->syntax := statement;
					@selection->temporaries := temporaries;
					@selection->block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "switch.case\0");
					@selection->next := cases;
					if (!statement->data.selection_case.value) {
						@fallback := selection->block;
					}
					else {
						@count = count + 1;
					};
					@cases = (CaseBlock*)selection;
				};
				@statement := statement->next;
			};
			LLVMOpaqueValue* value = @this.expression((Syntax*)syntax->data.selection.value);
			@this.flush_temporaries((Temporary*)temporaries);
			LLVMOpaqueValue* instruction = LLVMBuildSwitch(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueBasicBlock*(fallback), (u32)count);
			CaseBlock* selection := cases;
			while (selection) {
				if (selection->syntax->data.selection_case.value) {
					Syntax* expression := selection->syntax->data.selection_case.value;
					u64 value = constant_integer(@compiler, (Scope*)expression->scope, (Syntax*)expression);
					@value = constant_selector((u64)value, (Type*)expression->type);
					LLVMAddCase(LLVMOpaqueValue*(instruction), LLVMConstInt(llvm_type(@compiler, (Type*)expression->type), (u64)value, 0), LLVMOpaqueBasicBlock*(selection->block));
				};
				@selection := selection->next;
			};
			Flow flow;
			@flow.kind = flow_kind::kw_switch;
			@flow.parent := this.flow;
			@flow.break_block := end;
			@this.flow = &flow;
			@this.cases = (CaseBlock*)cases;
			@this.statement((Syntax*)syntax->data.selection.cases);
			@this.jump(LLVMOpaqueBasicBlock*(end));
			@this.flow := flow.parent;
			@this.cases = (CaseBlock*)previous;
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(end));
			@this.temporaries := temporaries;
			if (!emit_has_predecessor(LLVMOpaqueBasicBlock*(end))) {
				LLVMBuildUnreachable(LLVMOpaqueBuilder*(builder));
			};
			break;
		};
		case syntax_kind::kw_case: {
			CaseBlock* selection := this.cases;
			while (selection && selection->syntax != syntax) {
				@selection := selection->next;
			};
			if (selection) {
				@this.jump(LLVMOpaqueBasicBlock*(selection->block));
				LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(selection->block));
				@this.temporaries := selection->temporaries;
			};
			break;
		};
		default:
			@this.expression((Syntax*)syntax);
			break;
	};
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock($builder))) {
		@this.flush_temporaries((Temporary*)temporaries);
		@this.cleanups((Syntax*)syntax);
	};
};

struct LayoutVisit {
	Entity* entity;
	LayoutVisit* parent;
};

fn layout_validate(Compiler& compiler, Type* type, LayoutVisit* parent, const Token& token) {
	if (!type) {
		return;
	};
	if (type_enum((Type*)type)) {
		if (type->data.entity->state != resolution::active || !type->data.entity->data.enumeration.underlying) {
			entity_resolve(@compiler, (Entity*)type->data.entity);
		};
		if (compiler.result == compilation_result::failure) {
			return;
		};
		layout_validate(@compiler, (Type*)type->data.entity->data.enumeration.underlying, $parent, token);
		return;
	};
	if (type->kind == type_kind::kw_void || type->kind == type_kind::kw_null || type->kind == type_kind::function) {
		compiler_error(@compiler, token, "type has no value storage layout\0");
		return;
	};
	if (type->kind == type_kind::array) {
		layout_validate(@compiler, (Type*)type->data.array.element, (LayoutVisit*)parent, token);
		if (compiler.result == compilation_result::failure) {
			return;
		};

		u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, (Type*)type->data.array.element));
		u64 maximum = 18446744073709551615;
		if (compiler.usize_type->data.bits < 64) {
			@maximum = 1;
			i32 bit = 0;
			while (bit < compiler.usize_type->data.bits) {
				@maximum = maximum * 2;
				@bit = bit + 1;
			};
			@maximum = maximum - 1;
		};
		if (size && type->data.array.count > maximum / size) {
			compiler_error(@compiler, token, "array storage exceeds the native address range\0");
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};

	Entity* entity := type->data.entity;
	LayoutVisit* previous := parent;
	while (previous) {
		if (previous->entity == entity) {
			compiler_error(@compiler, token, "record contains itself by value\0");
			return;
		};
		@previous := previous->parent;
	};

	entity_resolve(@compiler, (Entity*)entity);
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		compiler_error(@compiler, token, "incomplete record has no storage layout\0");
		return;
	};

	Field* binding := entity->data.aggregate.fields;
	LayoutVisit visit;
	@visit.entity := entity;
	@visit.parent = $parent;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type((Entity*)base->entity), &visit, base->name->token);
		@base := base->next;
	};
	while (binding && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type((Entity*)binding->entity), &visit, binding->entity->name);
		@binding := binding->next;
	};
};

struct DeclarationIterator {
	Scope* scope;
};

fn declaration_next(DeclarationIterator* iterator, Binding* binding) -> Binding* {
	Scope* members = nullptr;
	if (binding->entity->kind == entity_kind::kw_namespace || binding->entity->kind == entity_kind::kw_struct || binding->entity->kind == entity_kind::kw_union || binding->entity->kind == entity_kind::kw_enum || binding->entity->kind == entity_kind::kw_template) {
		@members = entity_members((Entity*)binding->entity);
	};
	if (members && members->bindings) {
		@iterator->scope = (Scope*)members;
		return (Binding*)iterator->scope->bindings;
	};
	while (!binding->next) {
		Entity* owner := iterator->scope->owner;
		if (!owner || (owner->kind != entity_kind::kw_namespace && owner->kind != entity_kind::kw_struct && owner->kind != entity_kind::kw_union && owner->kind != entity_kind::kw_enum && owner->kind != entity_kind::kw_template)) {
			return nullptr;
		};
		@iterator->scope := iterator->scope->parent;
		@binding := iterator->scope->bindings;
		while (binding && binding->entity != owner) {
			@binding := binding->next;
		};
		if (!binding) {
			return nullptr;
		};
	};
	return (Binding*)binding->next;
};

fn declarations_validate_block(Compiler& compiler, Syntax* module) {
	Syntax* statement := module->data.statements;
	while (statement && compiler.result != compilation_result::failure) {
		if (statement->kind != syntax_kind::node_declaration) {
			compiler_error(@compiler, statement->token, "module context requires declarations\0");
			return;
		};

		Entity* entity := statement->entity;
		if (statement->token.kind == token_kind::kw_namespace) {
			declarations_validate_block(@compiler, (Syntax*)statement->data.declaration.body);
		}
		else if (entity->kind == entity_kind::function) {
			Type* declared = type_resolve(@compiler, (Scope*)entity->scope, (Syntax*)statement->data.declaration.type);
			interface_receiver_validate(@compiler, (Entity*)entity, (Type*)declared, statement->token);
			if (statement->data.declaration.modification != function_modification::ordinary && (!entity->data.function.interface_owner || statement->data.declaration.modification != entity->data.function.modification)) {
				compiler_error(@compiler, statement->token, "virtual relationships require a matching struct interface declaration\0");
			};
			if (!type_equal($declared, (Type*)entity->data.function.type)) {
				compiler_error(@compiler, statement->token, "conflicting function signature\0");
			};
			if (statement->data.declaration.definition != function_definition::declaration && statement != entity->declaration) {
				compiler_error(@compiler, statement->token, "duplicate function definition\0");
			};
		}
		else if (entity->kind == entity_kind::variable) {
			if (entity->data.variable.storage == storage_kind::global) {
				global_variable_resolve(@compiler, (Entity*)entity);
			};
		}
		else if (statement->data.declaration.body && statement != entity->declaration) {
			compiler_error(@compiler, statement->token, "duplicate type definition\0");
		}
		else if ((entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union) && statement->data.declaration.body) {
			declarations_validate_block(@compiler, (Syntax*)statement->data.declaration.body);
		};
		@statement := statement->next;
	};
};

fn declarations_validate(Compiler& compiler) {
	Syntax* module := compiler.declarations;
	while (module && compiler.result != compilation_result::failure) {
		declarations_validate_block(@compiler, (Syntax*)module);
		@module := module->next;
	};
};

fn external_validate(Compiler& compiler, Entity* entity) {
	if (entity->data.function.body || (entity->scope && entity->scope->owner && (entity->scope->owner->kind == entity_kind::kw_struct || entity->scope->owner->kind == entity_kind::kw_union))) {
		return;
	};
	DeclarationIterator iterator;
	@iterator.scope := compiler.module;
	Binding* binding := compiler.module->bindings;
	while (binding && binding->entity != entity) {
		Entity* previous := binding->entity;
		if (previous->kind == entity_kind::function && !previous->data.function.body && (!previous->scope || !previous->scope->owner || (previous->scope->owner->kind != entity_kind::kw_struct && previous->scope->owner->kind != entity_kind::kw_union)) && token_same(previous->name, entity->name) && !type_equal((Type*)previous->data.function.type, (Type*)entity->data.function.type)) {
			compiler_error(@compiler, entity->name, "conflicting external C function signature\0");
			return;
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn virtual_signature_equal(Entity* first, Entity* second) -> bool {
	if (!token_same(first->name, second->name)) {
		return false;
	};
	Type* left := first->data.function.type;
	Type* right := second->data.function.type;
	if (!left || !right || left->data.function.arity != right->data.function.arity) {
		return false;
	};
	Parameter* a := left->data.function.parameters;
	Parameter* b := right->data.function.parameters;
	if (!a || !b || !token_is(a->name, "this\0") || !token_is(b->name, "this\0")) {
		return false;
	};
	@a := a->next;
	@b := b->next;
	while (a && b) {
		if (!type_equal((Type*)a->type, (Type*)b->type)) {
			return false;
		};
		@a := a->next;
		@b := b->next;
	};
	return !a && !b;
};

fn virtual_result_compatible(Compiler& compiler, Type* derived, Type* base) -> bool {
	if (type_equal((Type*)derived, (Type*)base)) {
		return true;
	};
	if (derived->kind != base->kind || (derived->kind != type_kind::pointer && derived->kind != type_kind::reference)) {
		return false;
	};
	return base_search(@compiler, (Type*)derived->data.element, (Type*)base->data.element).count == 1;
};

fn virtual_relationships(Compiler& compiler, Entity* function) {
	if (function->data.function.virtual_resolution == resolution::ready) {
		return;
	};
	@function->data.function.virtual_resolution = resolution::active;
	Entity* owner = nullptr;
	if (function->scope) {
		@owner := function->scope->owner;
	};
	if (!owner || owner->kind != entity_kind::kw_struct) {
		@function->data.function.virtual_resolution = resolution::ready;
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $owner);
	Subobject* object := graph->objects;
	while (object) {
		if (object != graph->root) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				Entity* inherited := callable->function;
				entity_resolve(@compiler, (Entity*)inherited);
				if (virtual_signature_equal((Entity*)function, (Entity*)inherited)) {
					OverrideLink* existing := function->data.function.overrides;
					while (existing && existing->function != inherited) {
						@existing := existing->next;
					};
					if (!existing) {
						OverrideLink* relation = (OverrideLink*)memory_allocate(@compiler, sizeof(OverrideLink));
						@relation->function := inherited;
						@relation->next := function->data.function.overrides;
						@function->data.function.overrides = $relation;
					};
					if (inherited->data.function.modification == function_modification::kw_final) {
						compiler_error(@compiler, function->name, "cannot override a final operation\0");
					};
					if (!virtual_result_compatible(@compiler, (Type*)function->data.function.type->data.function.result, (Type*)inherited->data.function.type->data.function.result)) {
						compiler_error(@compiler, function->name, "override has an incompatible return type\0");
					};
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	function_modification modification := function->data.function.modification;
	if (function->data.function.overrides && modification != function_modification::kw_override && modification != function_modification::kw_final) {
		compiler_error(@compiler, function->name, "matching inherited virtual operation requires explicit override or final\0");
	};
	if ((modification == function_modification::kw_override || modification == function_modification::kw_final) && !function->data.function.overrides) {
		compiler_error(@compiler, function->name, "override requires a matching inherited virtual operation\0");
	};
	if (modification != function_modification::ordinary && !function->data.function.interface_owner) {
		compiler_error(@compiler, function->name, "virtual relationships require a struct interface declaration\0");
	};
	@function->data.function.virtual_resolution = resolution::ready;
};

fn virtual_overrides(Entity* function, Entity* operation) -> bool {
	if (function == operation) {
		return true;
	};
	OverrideLink* relation := function->data.function.overrides;
	while (relation) {
		if (virtual_overrides((Entity*)relation->function, (Entity*)operation)) {
			return true;
		};
		@relation := relation->next;
	};
	return false;
};

struct VirtualCandidate {
	VirtualCandidate* next;
	VirtualTarget target;
};

fn virtual_target(Compiler& compiler, CompleteGraph* graph, Subobject* receiver, Entity* operation) -> VirtualTarget {
	VirtualCandidate* candidates = nullptr;
	Subobject* object := graph->objects;
	while (object) {
		if (subobject_contains((Subobject*)object, (Subobject*)receiver)) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				if (virtual_overrides((Entity*)callable->function, (Entity*)operation)) {
					VirtualCandidate* candidate = (VirtualCandidate*)memory_allocate(@compiler, sizeof(VirtualCandidate));
					@candidate->target.function := callable->function;
					@candidate->target.object := object;
					@candidate->next := candidates;
					@candidates = $candidate;
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	VirtualTarget result;
	VirtualCandidate* candidate := candidates;
	while (candidate) {
		VirtualCandidate* other := candidates;
		while (other && (other->target.object == candidate->target.object || !subobject_contains((Subobject*)other->target.object, (Subobject*)candidate->target.object))) {
			@other := other->next;
		};
		if (!other) {
			if (result.object && (result.object != candidate->target.object || result.function != candidate->target.function)) {
				compiler_error(@compiler, graph->entity->name, "virtual operation has multiple final overriders\0");
				return $result;
			};
			@result := candidate->target;
		};
		@candidate := candidate->next;
	};
	return $result;
};

fn virtual_validate(Compiler& compiler) {
	DeclarationIterator iterator;
	@iterator.scope := compiler.module;
	Binding* binding := compiler.module->bindings;
	while (binding && compiler.result != compilation_result::failure) {
		if (binding->entity->kind == entity_kind::function) {
			virtual_relationships(@compiler, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	@iterator.scope := compiler.module;
	@binding := compiler.module->bindings;
	while (binding && compiler.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if (entity->kind == entity_kind::kw_struct && entity->declaration && entity->declaration->data.declaration.body) {
			CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
			Subobject* object := graph->objects;
			while (object && compiler.result != compilation_result::failure) {
				VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
				while (callable && compiler.result != compilation_result::failure) {
					virtual_target(@compiler, (CompleteGraph*)graph, (Subobject*)object, (Entity*)callable->function);
					@callable := callable->next;
				};
				@object := object->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn global_variable_resolve(Compiler& compiler, Entity* entity) {
	if (entity->state == resolution::ready) {
		return;
	};
	if (entity->state == resolution::active) {
		compiler_error(@compiler, entity->name, "circular global initializer\0");
		return;
	};
	@entity->state = resolution::active;
	Semantic semantic;
	@semantic.compiler = &compiler;
	@semantic.scope := entity->scope;
	@semantic.statement((Syntax*)entity->declaration);
	if (compiler.result == compilation_result::failure) {
		return;
	};
	destruction_request((Type*)entity->data.variable.type);
	LifetimeAnalysis lifetime;
	@lifetime.compiler = &compiler;
	@lifetime.state.path = reachability::reachable;
	@lifetime.statement((Syntax*)entity->declaration->data.declaration.body);
	@entity->state = resolution::ready;
	if (entity->data.variable.type->qualifier == type_qualifier::kw_const) {
		ConstantContext context;
		@context.compiler = &compiler;
		@context.scope := entity->scope;
		constant_variable(@context, (Entity*)entity);
	};
};

fn semantic_function(Compiler& compiler, Entity* entity) {
	if ((!entity->data.function.body && entity->data.function.definition != function_definition::defaulted) || entity->data.function.analysis != function_analysis::requested) {
		return;
	};
	@entity->data.function.analysis = function_analysis::analyzing;
	Semantic semantic;
	@semantic.compiler = &compiler;
	@semantic.scope := entity->scope;
	@semantic.function := entity;
	if (entity->data.function.definition == function_definition::defaulted) {
		if (entity->data.function.role != function_role::destructor) {
			generated_operation operation = generated_operation::kw_default;
			if (entity->data.function.type->data.function.parameters->next) {
				@operation = generated_operation::copy;
			};
			if (entity->data.function.role == function_role::assignment) {
				@operation = generated_operation::copy_assignment;
			};
			@semantic.generated_operation_validate(entity_type((Entity*)entity->scope->owner), $operation, entity->name);
		};
		@entity->data.function.analysis = function_analysis::analyzed;
		return;
	};
	@semantic.statement((Syntax*)entity->data.function.body);
	if (compiler.result == compilation_result::success) {
		lifetime_function(@compiler, (Entity*)entity);
	};
	@entity->data.function.analysis = function_analysis::analyzed;
};

fn Compiler::analyze(Compiler& this) {
	DeclarationIterator iterator;
	@iterator.scope := this.module;
	Binding* binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		if (binding->entity->kind != entity_kind::variable) {
			entity_resolve(@this, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};

	declarations_validate(@this);
	virtual_validate(@this);
	@iterator.scope := this.module;
	@binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if ((entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union) && entity->declaration && entity->declaration->data.declaration.body) {
			layout_validate(@this, entity_type((Entity*)entity), nullptr, entity->name);
		};
		if (entity->kind == entity_kind::function) {
			external_validate(@this, (Entity*)entity);
			Type* signature := entity->data.function.type;
			if (!entity->data.function.body && type_aggregate((Type*)signature->data.function.result)) {
				compiler_error(@this, entity->name, "external aggregate return requires C ABI lowering that is not supported yet\0");
			};
			if (signature->data.function.result->kind != type_kind::kw_void) {
				layout_validate(@this, (Type*)signature->data.function.result, nullptr, entity->name);
			};
			Parameter* parameter := signature->data.function.parameters;
			while (parameter && this.result != compilation_result::failure) {
				if (!entity->data.function.body && type_aggregate((Type*)parameter->type)) {
					compiler_error(@this, entity->name, "external aggregate parameter requires C ABI lowering that is not supported yet\0");
					break;
				};
				layout_validate(@this, (Type*)parameter->type, nullptr, entity->name);
				@parameter := parameter->next;
			};
		};
		if (entity->kind == entity_kind::function && (entity->data.function.body || entity->data.function.definition == function_definition::defaulted)) {
			semantic_function(@this, (Entity*)entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	while (this.result == compilation_result::success) {
		usize pending = 0;
		@iterator.scope := this.module;
		@binding := this.module->bindings;
		while (binding && this.result == compilation_result::success) {
			Entity* entity := binding->entity;
			if (entity->kind != entity_kind::variable) {
				entity_resolve(@this, (Entity*)entity);
			};
			if (entity->kind == entity_kind::function && (entity->data.function.body || entity->data.function.definition == function_definition::defaulted) && entity->data.function.analysis == function_analysis::requested) {
				@pending = pending + 1;
				semantic_function(@this, (Entity*)entity);
			};
			@binding = declaration_next(&iterator, (Binding*)binding);
		};
		if (!pending) {
			break;
		};
	};
};

fn entity_name(Compiler& compiler, Entity* entity) -> char* {
	Scope* scope := entity->scope;
	char* parent = "\0";
	if (scope && scope->owner && (scope->owner->kind == entity_kind::kw_namespace || scope->owner->kind == entity_kind::kw_struct || scope->owner->kind == entity_kind::kw_union || scope->owner->kind == entity_kind::kw_template)) {
		@parent = entity_name(@compiler, (Entity*)scope->owner);
	};
	usize length = strlen((char*)parent);
	usize separator = 0;
	if (length) {
		@separator = 2;
	};
	char* name = (char*)memory_allocate(@compiler, length + separator + entity->name.length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy(char*(name), $parent, (u64)length);
	if (separator) {
		@name[length] = ':';
		@name[length + 1] = ':';
	};
	memcpy(name + length + separator, entity->name.source->bytes.data + entity->name.begin, (u64)entity->name.length);
	return $name;
};

fn emit_symbol(Compiler& compiler, Entity* entity) -> char* {
	if (!entity->data.function.body && (!entity->scope || !entity->scope->owner || (entity->scope->owner->kind != entity_kind::kw_struct && entity->scope->owner->kind != entity_kind::kw_union))) {
		return memory_text(@compiler, entity->name.source->bytes.data + entity->name.begin, (u64)entity->name.length);
	};
	char* qualified = entity_name(@compiler, (Entity*)entity);
	if (entity->data.function.role != function_role::ordinary) {
		char[22] digits {};
		usize position = sizeof(digits) - 1;
		usize index := entity->data.function.overload_index;
		while (true) {
			@position = position - 1;
			@digits[position] = (char)((usize)'0' + index % 10);
			@index = index / 10;
			if (!index) {
				break;
			};
		};
		usize length = strlen((char*)qualified);
		usize count = strlen(&digits[position]);
		char* name = (char*)memory_allocate(@compiler, length + count + 3);
		memcpy(char*(name), char*(qualified), (u64)length);
		@name[length] = '.';
		@name[length + 1] = (char)((i32)'a' + (i32)entity->data.function.role);
		memcpy(name + length + 2, &digits[position], count + 1);
		@qualified = $name;
	};
	if (compiler.output == output_kind::library) {
		return $qualified;
	};
	char* prefix = "rt.function.\0";
	usize prefix_length = strlen((char*)prefix);
	usize length = strlen((char*)qualified);
	char* name = (char*)memory_allocate(@compiler, prefix_length + length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy(char*(name), $prefix, (u64)prefix_length);
	memcpy(name + prefix_length, $qualified, $length);
	return $name;
};

fn emit_function_body(Compiler& compiler, Entity* entity, LLVMOpaqueValue* function, u64 receiver_offset, Type* return_type) {
	if ((!entity->data.function.body && entity->data.function.definition != function_definition::defaulted) || entity->data.function.analysis == function_analysis::unrequested) {
		return;
	};
	LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0");
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
	Emitter emitter;
	@emitter.llvm_function := function;
	@emitter.return_type = $return_type;
	@emitter.compiler = &compiler;
	@emitter.function := entity;
	if (entity->data.function.definition == function_definition::defaulted) {
		Entity* record := entity->scope->owner;
		LLVMOpaqueValue* destination = LLVMGetParam(LLVMOpaqueValue*(function), 0);
		Parameter* source := entity->data.function.type->data.function.parameters->next;
		if (!source && entity->data.function.role == function_role::constructor) {
			@emitter.default_body_members((Entity*)record, LLVMOpaqueValue*(destination));
		};
		if (source) {
			storage_transfer operation = storage_transfer::copy_construct;
			if (entity->data.function.role == function_role::assignment) {
				@operation = storage_transfer::copy_assign;
			};
			@emitter.transfer_members((Entity*)record, LLVMOpaqueValue*(destination), LLVMGetParam(LLVMOpaqueValue*(function), 1), $operation);
		};
		if (entity->data.function.role == function_role::assignment) {
			LLVMBuildRet(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(destination));
		}
		else {
			LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
		};
		return;
	};
	Parameter* parameter := entity->data.function.type->data.function.parameters;
	u32 index = 0;
	while (parameter) {
		LLVMOpaqueValue* value = LLVMGetParam(LLVMOpaqueValue*(function), (u32)index);
		if (!index && receiver_offset) {
			@value = @emitter.byte_offset(LLVMOpaqueValue*(value), (u64)receiver_offset);
		};
		BackendEntity* storage = backend_entity_define(@compiler, (Entity*)parameter->entity);
		if (!storage) {
			return;
		};
		@storage->value = emit_slot(@compiler, (Type*)parameter->type);
		if (type_has_views((Type*)parameter->type) && (parameter->type->kind != type_kind::named || parameter->type->data.entity->kind != entity_kind::kw_union)) {
			LLVMOpaqueValue* incoming = emit_slot(@compiler, (Type*)parameter->type);
			LLVMBuildStore(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(incoming));
			@emitter.initialize_type((Type*)parameter->type, LLVMOpaqueValue*(storage->value));
			@emitter.payload_copy((Type*)parameter->type, LLVMOpaqueValue*(storage->value), $incoming);
		}
		else {
			LLVMBuildStore(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(storage->value));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
	@emitter.statement((Syntax*)entity->data.function.body);
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(compiler.backend.llvm_builder.get()))) {
		if (entity->data.function.lifetime_exit == reachability::unreachable) {
			LLVMBuildUnreachable(compiler.backend.llvm_builder.get());
		}
		else if (entity->data.function.type->data.function.result->kind == type_kind::kw_void) {
			LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
		}
		else {
			compiler_error(@compiler, entity->name, "function can finish without returning a value\0");
		};
	};
};

fn emit_function(Compiler& compiler, Entity* entity) {
	if (entity->data.function.definition == function_definition::deleted) {
		return;
	};
	emit_function_body(@compiler, (Entity*)entity, LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)entity)->value), 0, nullptr);
};

fn emit_forward_attributes(Compiler& compiler, LLVMOpaqueValue* call, Type* signature) {
	LLVMOpaqueAttributeRef* extension = emit_extension(@compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), 0, LLVMOpaqueAttributeRef*(extension));
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension(@compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), (u32)index, LLVMOpaqueAttributeRef*(extension));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn emit_variadic_tail(Compiler& compiler, LLVMOpaqueValue* function, LLVMOpaqueValue* call) {
	LLVMOpaqueAttributeRef* attribute = LLVMCreateStringAttribute(compiler.backend.llvm_context.get(), "thunk\0", 5, "\0", 0);
	LLVMAddAttributeAtIndex($function, (u32)4294967295, $attribute);
	LLVMSetTailCallKind($call, 2);
};

fn emit_forward_return(Compiler& compiler, Type* result, LLVMOpaqueValue* call) {
	if (result->kind == type_kind::kw_void) {
		LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	}
	else {
		LLVMBuildRet(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(call));
	};
};

fn runtime_wrappers_emit(Compiler& compiler) {
	while (compiler.backend.runtime_wrappers && compiler.result != compilation_result::failure) {
		RuntimeWrapper* wrapper := compiler.backend.runtime_wrappers;
		@compiler.backend.runtime_wrappers := wrapper->next;
		Entity* entity := wrapper->entity;
		LLVMOpaqueValue* function := backend_entity(@compiler.backend, (Entity*)entity)->wrapper;
		Type* signature := entity->data.function.type;
		LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0");
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
		Emitter emitter;
		@emitter.llvm_function := function;
		@emitter.compiler = &compiler;
		@emitter.function := entity;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		LLVMOpaqueValue** arguments = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam(LLVMOpaqueValue*(function), (u32)index);
			@index = index + 1;
		};
		LLVMOpaqueValue* target = @emitter.dispatch_target($entity, LLVMOpaqueValue*(arguments[0]));
		char* name = "virtual.call\0";
		if (signature->data.function.result->kind == type_kind::kw_void) {
			@name = "\0";
		};
		LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)signature), $target, $arguments, (u32)count, $name);
		emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), (Type*)signature);
		if (signature->data.function.arity == parameter_arity::variadic) {
			emit_variadic_tail(@compiler, LLVMOpaqueValue*(function), LLVMOpaqueValue*(call));
		};
		emit_forward_return(@compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_thunks_emit(Compiler& compiler) {
	while (compiler.backend.runtime_thunks && compiler.result != compilation_result::failure) {
		RuntimeThunk* thunk := compiler.backend.runtime_thunks;
		@compiler.backend.runtime_thunks := thunk->next;
		Entity* implementation := thunk->target.function;
		BackendEntity* native = backend_entity(@compiler.backend, (Entity*)implementation);
		Type* signature := thunk->callable->function->data.function.type;
		Type* result := implementation->data.function.type->data.function.result;
		u64 offset = thunk->target.object->offset - thunk->receiver->offset;
		if (signature->data.function.arity == parameter_arity::variadic && covariance_adjustment_required(@compiler, (Type*)result, (Type*)signature->data.function.result)) {
			if (!implementation->data.function.body) {
				compiler_error(@compiler, implementation->name, "covariant variadic override requires an available implementation body\0");
				return;
			};
			emit_function_body(@compiler, (Entity*)implementation, LLVMOpaqueValue*(thunk->function), (u64)offset, (Type*)signature->data.function.result);
			continue;
		};
		LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(thunk->function), "entry\0");
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
		Emitter emitter;
		@emitter.llvm_function := thunk->function;
		@emitter.compiler = &compiler;
		@emitter.function := implementation;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		LLVMOpaqueValue** arguments = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam(LLVMOpaqueValue*(thunk->function), (u32)index);
			@index = index + 1;
		};
		@arguments[0] = @emitter.byte_offset(LLVMOpaqueValue*(arguments[0]), $offset);
		char* name = "override.call\0";
		if (result->kind == type_kind::kw_void) {
			@name = "\0";
		};
		LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), $arguments, (u32)count, $name);
		emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), (Type*)implementation->data.function.type);
		if (signature->data.function.arity == parameter_arity::variadic) {
			emit_variadic_tail(@compiler, LLVMOpaqueValue*(thunk->function), LLVMOpaqueValue*(call));
			emit_forward_return(@compiler, (Type*)signature->data.function.result, LLVMOpaqueValue*(call));
			continue;
		};
		if (!type_equal((Type*)result, (Type*)signature->data.function.result)) {
			@call = @emitter.covariant_result(LLVMOpaqueValue*(call), (Type*)result, (Type*)signature->data.function.result);
		};
		emit_forward_return(@compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_metadata_emit(Compiler& compiler) {
	while ((compiler.backend.runtime_views || compiler.backend.runtime_thunks || compiler.backend.runtime_wrappers) && compiler.result != compilation_result::failure) {
		runtime_wrappers_emit(@compiler);
		runtime_views_emit(@compiler);
		runtime_thunks_emit(@compiler);
	};
};

fn entry_lookup(Compiler& compiler) -> Entity* {
	Source source;
	@source.bytes.data := compiler.entry;
	@source.bytes.size = strlen((char*)compiler.entry);
	Token name;
	@name.source = &source;
	Scope* scope := compiler.module;
	while (name.begin < source.bytes.size) {
		@name.length = 0;
		while (name.begin + name.length < source.bytes.size && source.bytes.data[name.begin + name.length] != ':') {
			@name.length = name.length + 1;
		};
		Entity* entity = scope_local((Scope*)scope, name);
		if (!entity) {
			return nullptr;
		};
		if (name.begin + name.length == source.bytes.size) {
			return $entity;
		};
		@scope = entity_members($entity);
		if (!scope || name.begin + name.length + 1 >= source.bytes.size || source.bytes.data[name.begin + name.length + 1] != ':') {
			return nullptr;
		};
		@name.begin = name.begin + name.length + 2;
	};
	return nullptr;
};

fn emit_entry(Compiler& compiler) {
	Entity* entry = entry_lookup(@compiler);
	if (!entry || entry->kind != entity_kind::function || !entry->data.function.body) {
		Token token;
		if (compiler.declarations) {
			@token := compiler.declarations->token;
		};
		compiler_error(@compiler, token, "entry function is missing or has no definition\0");
		return;
	};
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)entry);
	Type* signature := entry->data.function.type;
	if (signature->data.function.result->kind != type_kind::kw_void && !type_equal((Type*)signature->data.function.result, (Type*)compiler.i32_type)) {
		compiler_error(@compiler, entry->name, "entry function must return i32 or void\0");
		return;
	};
	Parameter* parameter := signature->data.function.parameters;
	LLVMOpaqueValue*[2] arguments {};
	LLVMOpaqueType*[2] parameter_types {};
	@parameter_types[0] = llvm_type(@compiler, (Type*)compiler.i32_type);
	@parameter_types[1] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	if (parameter && (!parameter->next || parameter->next->next || !type_equal((Type*)parameter->type, (Type*)compiler.i32_type) || !type_equal((Type*)parameter->next->type, type_pointer(@compiler, type_pointer(@compiler, (Type*)compiler.char_type))))) {
		compiler_error(@compiler, entry->name, "entry parameters must be empty or (i32, char**)\0");
		return;
	};
	LLVMOpaqueType* main_type = LLVMFunctionType(LLVMOpaqueType*(parameter_types[0]), &parameter_types[0], 2, 0);
	LLVMOpaqueValue* main_function = LLVMAddFunction(compiler.backend.llvm_module.get(), "main\0", $main_type);
	LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(main_function), "entry\0");
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
	@arguments[0] = LLVMGetParam(LLVMOpaqueValue*(main_function), 0);
	@arguments[1] = LLVMGetParam($main_function, 1);
	u32 count = 0;
	if (parameter) {
		@count = 2;
	};
	char* name = "entry.result\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* result = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), &arguments[0], $count, $name);
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@result = LLVMConstInt(LLVMOpaqueType*(parameter_types[0]), 0, 0);
	};
	LLVMBuildRet(compiler.backend.llvm_builder.get(), $result);
};

fn emit_global_collect(Syntax* module, Entity** globals, usize* count) {
	Syntax* statement := module->data.statements;
	while (statement) {
		Entity* entity := statement->entity;
		if (statement->token.kind == token_kind::kw_namespace) {
			emit_global_collect((Syntax*)statement->data.declaration.body, Entity**(globals), usize*(count));
		}
		else if (entity && entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
			@globals[*count] := entity;
			@*count = *count + 1;
		};
		@statement := statement->next;
	};
};

fn emit_global_register(Compiler& compiler, LLVMOpaqueValue* function, const char* name) {
	LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 32);
	@fields[1] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	@fields[2] := fields[1];
	LLVMOpaqueType* record = LLVMStructTypeInContext(compiler.backend.llvm_context.get(), &fields[0], 3, 0);
	LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt(LLVMOpaqueType*(fields[0]), 65535, 0);
	@values[1] = $function;
	@values[2] = LLVMConstNull(LLVMOpaqueType*(fields[2]));
	LLVMOpaqueValue*[1] entries {};
	@entries[0] = LLVMConstNamedStruct(LLVMOpaqueType*(record), &values[0], 3);
	LLVMOpaqueValue* list = LLVMAddGlobal(compiler.backend.llvm_module.get(), LLVMArrayType2(LLVMOpaqueType*(record), 1), $name);
	LLVMSetInitializer(LLVMOpaqueValue*(list), LLVMConstArray2($record, &entries[0], 1));
	LLVMSetLinkage($list, 7);
};

fn emit_global_destructor(Compiler& compiler, Entity* entity) {
	Type* type := entity->data.variable.type;
	if (!type_requires_destruction((Type*)type)) {
		return;
	};

	LLVMOpaqueBasicBlock* continuation = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(compiler.backend.llvm_context.get()), nullptr, 0, 0);
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.global.destroy\0", $signature);
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0"));
	Emitter emitter;
	@emitter.compiler = &compiler;
	@emitter.llvm_function := function;
	@emitter.destroy_type($type, LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)entity)->value));
	LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $continuation);

	LLVMOpaqueType*[1] parameters {};
	@parameters[0] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	LLVMOpaqueType* registration_type = LLVMFunctionType(llvm_type(@compiler, (Type*)compiler.i32_type), &parameters[0], 1, 0);
	LLVMOpaqueValue* registration = LLVMGetNamedFunction(compiler.backend.llvm_module.get(), "atexit\0");
	if (!registration) {
		@registration = LLVMAddFunction(compiler.backend.llvm_module.get(), "atexit\0", LLVMOpaqueType*(registration_type));
	};
	if (LLVMGlobalGetValueType(LLVMOpaqueValue*(registration)) != registration_type) {
		compiler_error(@compiler, entity->name, "atexit declaration conflicts with global destruction registration\0");
		return;
	};
	LLVMBuildCall2(compiler.backend.llvm_builder.get(), $registration_type, $registration, &function, 1, "\0");
};

fn emit_global_initializers(Compiler& compiler, Entity** globals, usize count) {
	usize pending = 0;
	usize index = 0;
	while (index < count) {
		Entity* entity := globals[index];
		if (type_requires_destruction((Type*)entity->data.variable.type) || !entity->data.variable.evaluation || entity->data.variable.evaluation->state != constant_state::constant) {
			@pending = pending + 1;
		};
		@index = index + 1;
	};
	if (!pending) {
		return;
	};

	LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(compiler.backend.llvm_context.get()), nullptr, 0, 0);
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.global.initialize\0", $signature);
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0"));
	Emitter emitter;
	@emitter.compiler = &compiler;
	@emitter.llvm_function := function;

	@index = 0;
	while (index < count && compiler.result == compilation_result::success) {
		Entity* entity := globals[index];
		Type* type := entity->data.variable.type;
		LLVMOpaqueValue* address := backend_entity(@compiler.backend, (Entity*)entity)->value;
		if (!entity->data.variable.evaluation || entity->data.variable.evaluation->state != constant_state::constant) {
			Syntax* body := entity->declaration->data.declaration.body;
			if (!body) {
				@emitter.initialize_type((Type*)type, LLVMOpaqueValue*(address));
				@emitter.default_type((Type*)type, LLVMOpaqueValue*(address));
			}
			else {
				if (body->data.statements && type->kind != type_kind::reference) {
					@emitter.initialize_type((Type*)type, LLVMOpaqueValue*(address));
				};
				@emitter.statement((Syntax*)body);
			};
			@emitter.flush_temporaries(nullptr);
		};
		emit_global_destructor(@compiler, (Entity*)entity);
		@index = index + 1;
	};
	LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	emit_global_register(@compiler, $function, "llvm.global_ctors\0");
};

fn Compiler::emit(Compiler& this) {
	DeclarationIterator iterator;
	@iterator.scope := this.module;
	Binding* binding := this.module->bindings;
	usize global_count = 0;
	while (binding && this.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if (entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
			Type* type := entity->data.variable.type;
			LLVMOpaqueValue* address = LLVMAddGlobal(this.backend.llvm_module.get(), llvm_type(@this, (Type*)type), entity_name(@this, (Entity*)entity));
			BackendEntity* storage = backend_entity_define(@this, (Entity*)entity);
			if (!storage) {
				return;
			};
			@storage->value := address;
			LLVMSetLinkage(LLVMOpaqueValue*(address), 9);
			LLVMOpaqueValue* initializer = LLVMConstNull(llvm_type(@this, (Type*)type));
			ConstantEvaluation* evaluation := entity->data.variable.evaluation;
			if (evaluation && evaluation->state == constant_state::constant) {
				@initializer = constant_llvm(@this, (ConstantValue*)evaluation->value);
				if (type->qualifier == type_qualifier::kw_const && !type_requires_destruction((Type*)type)) {
					LLVMSetGlobalConstant(LLVMOpaqueValue*(address), 1);
				};
			};
			LLVMSetInitializer($address, $initializer);
			@global_count = global_count + 1;
		};
		if (entity->kind == entity_kind::function && entity->data.function.definition != function_definition::deleted) {
			BackendEntity* native = backend_entity_define(@this, (Entity*)entity);
			if (!native) {
				return;
			};
			Type* signature := entity->data.function.type;
			@native->type = llvm_type(@this, (Type*)signature);
			char* symbol = emit_symbol(@this, (Entity*)entity);
			LLVMOpaqueValue* existing = LLVMGetNamedFunction(this.backend.llvm_module.get(), (char*)symbol);
			if (existing && LLVMGlobalGetValueType(LLVMOpaqueValue*(existing)) != native->type) {
				compiler_error(@this, entity->name, "conflicting native function signature\0");
				return;
			};
			if (!existing) {
				@existing = LLVMAddFunction(this.backend.llvm_module.get(), (char*)symbol, LLVMOpaqueType*(native->type));
			};
			@native->value = $existing;
			LLVMOpaqueAttributeRef* extension = emit_extension(@this, (Type*)signature->data.function.result);
			if (extension) {
				LLVMAddAttributeAtIndex(LLVMOpaqueValue*(native->value), 0, LLVMOpaqueAttributeRef*(extension));
			};
			Parameter* parameter := signature->data.function.parameters;
			u32 index = 1;
			while (parameter) {
				@extension = emit_extension(@this, (Type*)parameter->type);
				if (extension) {
					LLVMAddAttributeAtIndex(LLVMOpaqueValue*(native->value), (u32)index, LLVMOpaqueAttributeRef*(extension));
				};
				@index = index + 1;
				@parameter := parameter->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	if (global_count) {
		Entity** globals = (Entity**)memory_allocate(@this, global_count * sizeof(Entity*));
		usize count = 0;
		Syntax* module := this.declarations;
		while (module) {
			emit_global_collect((Syntax*)module, Entity**(globals), &count);
			@module := module->next;
		};
		emit_global_initializers(@this, $globals, $count);
	};
	@iterator.scope := this.module;
	@binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		if (binding->entity->kind == entity_kind::function) {
			emit_function(@this, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	if (this.output == output_kind::executable && this.result != compilation_result::failure) {
		emit_entry(@this);
	};
	if (this.result == compilation_result::success) {
		runtime_metadata_emit(@this);
	};
};

fn lifetime_find(LifetimeState* state, Entity* entity) -> LifetimeObject* {
	LifetimeObject* object := state->objects;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->next;
	};
	return nullptr;
};

fn lifetime_clone(Compiler& compiler, LifetimeState* state) -> LifetimeState {
	LifetimeState result;
	@result.path := state->path;
	LifetimeObject** last = &result.objects;
	LifetimeObject* object := state->objects;
	while (object) {
		LifetimeObject* copy = (LifetimeObject*)memory_allocate(@compiler, sizeof(LifetimeObject));
		@copy->entity := object->entity;
		@copy->status := object->status;
		@*last := copy;
		@last = &copy->next;
		@object := object->next;
	};
	return $result;
};

fn lifetime_merge(Compiler& compiler, LifetimeState* destination, LifetimeState* incoming, const Token& token) {
	if (incoming->path == reachability::unreachable) {
		return;
	};
	if (destination->path == reachability::unreachable) {
		@*destination = lifetime_clone(@compiler, (LifetimeState*)incoming);
		return;
	};
	LifetimeObject* object := destination->objects;
	while (object && compiler.result != compilation_result::failure) {
		LifetimeObject* other = lifetime_find((LifetimeState*)incoming, (Entity*)object->entity);
		if ((!other && object->status == lifetime_status::alive) || (other && (object->status == lifetime_status::alive) != (other->status == lifetime_status::alive))) {
			compiler_error(@compiler, token, "inconsistent object lifetimes at reachable control-flow merge\0");
			return;
		};
		if (other && object->status != other->status) {
			@object->status = lifetime_status::ended;
		};
		@object := object->next;
	};
	@object := incoming->objects;
	while (object && compiler.result != compilation_result::failure) {
		if (!lifetime_find((LifetimeState*)destination, (Entity*)object->entity)) {
			if (object->status == lifetime_status::alive) {
				compiler_error(@compiler, token, "object construction does not reach every incoming control-flow path\0");
				return;
			};
			LifetimeObject* copy = (LifetimeObject*)memory_allocate(@compiler, sizeof(LifetimeObject));
			@copy->entity := object->entity;
			@copy->status := object->status;
			@copy->next := destination->objects;
			@destination->objects = $copy;
		};
		@object := object->next;
	};
};

fn LifetimeAnalysis::enter(LifetimeAnalysis& this, Entity* entity) {
	LifetimeObject* previous := this.state.objects;
	while (previous) {
		if (previous->entity->scope == entity->scope && token_same(previous->entity->name, entity->name) && previous->status == lifetime_status::alive) {
			compiler_error(@*this.compiler, entity->name, "duplicate live declaration\0");
			return;
		};
		@previous := previous->next;
	};
	LifetimeObject* object = (LifetimeObject*)memory_allocate(@*this.compiler, sizeof(LifetimeObject));
	@object->entity := entity;
	@object->status = lifetime_status::alive;
	@object->next := this.state.objects;
	@this.state.objects = $object;
};

fn LifetimeAnalysis::cleanup(LifetimeAnalysis& this, Syntax* syntax, LifetimeObject* boundary) {
	LifetimeCleanup** last = &syntax->cleanup;
	while (*last) {
		@last = &(*last)->next;
	};
	LifetimeObject* object := this.state.objects;
	while (object && (!boundary || object->entity != boundary->entity)) {
		Type* type = entity_type((Entity*)object->entity);
		if (object->status == lifetime_status::alive && type && type->kind != type_kind::reference) {
			destruction_request((Type*)type);
			LifetimeCleanup* cleanup = (LifetimeCleanup*)memory_allocate(@*this.compiler, sizeof(LifetimeCleanup));
			@cleanup->entity := object->entity;
			@*last := cleanup;
			@last = &cleanup->next;
		};
		@object := object->next;
	};
};

fn lifetime_trim(LifetimeState* state, LifetimeObject* boundary) {
	while (state->objects && (!boundary || state->objects->entity != boundary->entity)) {
		@state->objects := state->objects->next;
	};
};

fn lifetime_truth(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 1;
	};
	if (syntax->kind == syntax_kind::expr_name && syntax->entity && syntax->entity->kind == entity_kind::variable && syntax->entity->data.variable.storage == storage_kind::constant) {
		if (syntax->entity->data.variable.evaluation && syntax->entity->data.variable.evaluation->state == constant_state::constant) {
			return (i32)constant_truth((ConstantValue*)syntax->entity->data.variable.evaluation->value);
		};
		return !!syntax->entity->data.variable.data.integer;
	};
	if (syntax->kind == syntax_kind::literal_number && syntax->token.length == 1) {
		char value := syntax->token.source->bytes.data[syntax->token.begin];
		if (value >= '0' && value <= '9') {
			return value != '0';
		};
	};
	if (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_bang) {
		i32 value = lifetime_truth((Syntax*)syntax->data.unary.value);
		if (value >= 0) {
			return !value;
		};
	};
	return -1;
};


fn LifetimeAnalysis::nested_statement(LifetimeAnalysis& this, Syntax* syntax) {
	if (!syntax) {
		return;
	};
	LifetimeObject* boundary := this.state.objects;
	@this.statement((Syntax*)syntax);
	if (this.state.path == reachability::reachable) {
		@this.cleanup((Syntax*)syntax, (LifetimeObject*)boundary);
	};
	lifetime_trim(&this.state, $boundary);
};

fn LifetimeAnalysis::expression(LifetimeAnalysis& this, Syntax* syntax) {
	if (!syntax || this.state.path == reachability::unreachable || this.compiler->result == compilation_result::failure) {
		return;
	};
	if (syntax->use == value_use::observed && syntax_category((Syntax*)syntax) == value_category::temporary) {
		destruction_request((Type*)syntax->type);
	};
	switch (syntax->kind) {
		case syntax_kind::kw_new:
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard:
			@this.expression((Syntax*)syntax->data.expression);
			break;
		case syntax_kind::expr_construct: {
			@this.expression((Syntax*)syntax->data.construction.destination);
			Syntax* argument := syntax->data.construction.arguments;
			while (argument) {
				@this.expression((Syntax*)argument);
				@argument := argument->next;
			};
			break;
		};
		case syntax_kind::expr_name: {
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->entity);
			if (!object && syntax->entity && syntax->entity->kind == entity_kind::variable && (syntax->entity->data.variable.storage == storage_kind::local || syntax->entity->data.variable.storage == storage_kind::parameter || syntax->entity->data.variable.storage == storage_kind::argument)) {
				compiler_error(@*this.compiler, syntax->token, "object construction does not reach this use\0");
				return;
			};
			if (object && object->status != lifetime_status::alive) {
				const char* suffix = "' has been relocated\0";
				if (object->status == lifetime_status::discarded) {
					@suffix = "' has been discarded\0";
				}
				else if (object->status == lifetime_status::ended) {
					@suffix = "' is no longer available\0";
				};
				usize length := syntax->token.length;
				usize suffix_size = strlen(const char*(suffix)) + 1;
				char* message = (char*)memory_allocate(@*this.compiler, length + suffix_size + 1);
				if (!message) {
					return;
				};
				@message[0] = '\'';
				memcpy(message + 1, syntax->token.source->bytes.data + syntax->token.begin, (u64)length);
				memcpy(message + length + 1, $suffix, $suffix_size);
				compiler_error(@*this.compiler, syntax->token, $message);
			};
			break;
		};
		case syntax_kind::expr_relocate: {
			@this.expression((Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error(@*this.compiler, syntax->token, "relocation requires a live owned local binding\0");
				return;
			};
			@object->status = lifetime_status::relocated;
			break;
		};
		case syntax_kind::expr_access:
			@this.expression((Syntax*)syntax->data.expression);
			break;
		case syntax_kind::kw_discard: {
			@this.expression((Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error(@*this.compiler, syntax->token, "discard requires a live owned local binding\0");
				return;
			};
			@object->status = lifetime_status::discarded;
			break;
		};
		case syntax_kind::expr_member:
			@this.expression((Syntax*)syntax->data.member.object);
			break;
		case syntax_kind::expr_destroy:
		case syntax_kind::expr_cast:
			@this.expression((Syntax*)syntax->data.cast.value);
			break;
		case syntax_kind::expr_base_reference:
		case syntax_kind::expr_base_pointer:
			@this.expression((Syntax*)syntax->data.base_conversion.value);
			break;
		case syntax_kind::expr_unary:
			@this.expression((Syntax*)syntax->data.unary.value);
			break;
		case syntax_kind::stmt_initialize:
		case syntax_kind::stmt_bind_reference:
		case syntax_kind::expr_binary: {
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			token_kind operation := syntax->data.binary.operation;
			if (syntax->kind == syntax_kind::stmt_bind_reference || ((operation == token_kind::op_assign || operation == token_kind::op_copy) && !type_has_views((Type*)left->type) && !syntax->entity)) {
				@this.expression((Syntax*)right);
				@this.expression((Syntax*)left);
				return;
			};
			@this.expression((Syntax*)left);
			if (syntax->kind == syntax_kind::expr_binary && (operation == token_kind::op_and || operation == token_kind::op_or)) {
				i32 truth = lifetime_truth((Syntax*)left);
				if ((operation == token_kind::op_and && !truth) || (operation == token_kind::op_or && truth == 1)) {
					return;
				};
				LifetimeState skipped = lifetime_clone(@*this.compiler, &this.state);
				@this.expression((Syntax*)right);
				if (truth < 0) {
					lifetime_merge(@*this.compiler, &this.state, &skipped, syntax->token);
				};
				return;
			};
			@this.expression((Syntax*)right);
			break;
		};
		case syntax_kind::expr_index:
			@this.expression((Syntax*)syntax->data.binary.right);
			@this.expression((Syntax*)syntax->data.binary.left);
			break;
		case syntax_kind::expr_call: {
			@this.expression((Syntax*)syntax->data.call.receiver.value);
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (argument->kind == syntax_kind::node_block) {
					LifetimeObject* boundary := this.state.objects;
					@this.enter((Entity*)argument->entity);
					@this.statement((Syntax*)argument);
					lifetime_trim(&this.state, (LifetimeObject*)boundary);
				}
				else {
					@this.expression((Syntax*)argument);
				};
				@argument := argument->next;
			};
			@this.expression((Syntax*)syntax->data.call.callable);
			break;
		};
		case syntax_kind::node_block:
			@this.statement((Syntax*)syntax);
			break;
		default:
			break;
	};
};

fn LifetimeAnalysis::loop(LifetimeAnalysis& this, Syntax* syntax) {
	LifetimeObject* boundary := this.state.objects;
	@this.statement((Syntax*)syntax->data.loop.initializer);
	LifetimeState entry = lifetime_clone(@*this.compiler, &this.state);
	@this.expression((Syntax*)syntax->data.loop.condition);
	i32 truth = lifetime_truth((Syntax*)syntax->data.loop.condition);
	LifetimeState exits;
	if (truth != 1) {
		@exits = lifetime_clone(@*this.compiler, &this.state);
	};
	LifetimeControl control;
	@control.kind = flow_kind::loop;
	@control.boundary := this.state.objects;
	@control.parent := this.control;
	@this.control = &control;
	if (!truth) {
		@this.state.path = reachability::unreachable;
	};
	@this.nested_statement((Syntax*)syntax->data.loop.body);
	lifetime_merge(@*this.compiler, &this.state, &control.continues, syntax->token);
	@this.expression((Syntax*)syntax->data.loop.step);
	if (this.state.path == reachability::reachable) {
		lifetime_merge(@*this.compiler, &entry, &this.state, syntax->token);
	};
	lifetime_merge(@*this.compiler, &exits, &control.breaks, syntax->token);
	@this.state = $exits;
	@this.control := control.parent;
	if (this.state.path == reachability::reachable) {
		@this.cleanup((Syntax*)syntax, (LifetimeObject*)boundary);
	};
	lifetime_trim(&this.state, $boundary);
};

fn LifetimeAnalysis::switch_(LifetimeAnalysis& this, Syntax* syntax) {
	@this.expression((Syntax*)syntax->data.selection.value);
	LifetimeState dispatch = lifetime_clone(@*this.compiler, &this.state);
	LifetimeControl control;
	@control.kind = flow_kind::kw_switch;
	@control.boundary := this.state.objects;
	@control.parent := this.control;
	@this.control = &control;
	@this.state.path = reachability::unreachable;
	i32 defaults = 0;
	Syntax* statement := syntax->data.selection.cases->data.statements;
	while (statement && this.compiler->result != compilation_result::failure) {
		if (statement->kind == syntax_kind::kw_case) {
			lifetime_merge(@*this.compiler, &this.state, &dispatch, statement->token);
			if (!statement->data.selection_case.value) {
				@defaults = defaults + 1;
			};
		}
		else {
			@this.statement((Syntax*)statement);
		};
		@statement := statement->next;
	};
	if (this.state.path == reachability::reachable) {
		@this.cleanup((Syntax*)syntax->data.selection.cases, (LifetimeObject*)control.boundary);
	};
	lifetime_trim(&this.state, (LifetimeObject*)control.boundary);
	lifetime_merge(@*this.compiler, &this.state, &control.breaks, syntax->token);
	if (!defaults) {
		lifetime_merge(@*this.compiler, &this.state, &dispatch, syntax->token);
	};
	@this.control := control.parent;
};

fn LifetimeAnalysis::statement(LifetimeAnalysis& this, Syntax* syntax) {
	if (!syntax || this.state.path == reachability::unreachable || this.compiler->result == compilation_result::failure) {
		return;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			LifetimeObject* boundary := this.state.objects;
			Syntax* statement := syntax->data.statements;
			while (statement && this.compiler->result != compilation_result::failure) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			if (this.state.path == reachability::reachable) {
				@this.cleanup((Syntax*)syntax, (LifetimeObject*)boundary);
			};
			lifetime_trim(&this.state, (LifetimeObject*)boundary);
			break;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind == entity_kind::variable) {
				@this.enter((Entity*)syntax->entity);
				@this.statement((Syntax*)syntax->data.declaration.body);
			};
			break;
		case syntax_kind::kw_return:
			@this.expression((Syntax*)syntax->data.expression);
			@this.cleanup((Syntax*)syntax, nullptr);
			@this.state.path = reachability::unreachable;
			break;
		case syntax_kind::kw_if: {
			@this.expression((Syntax*)syntax->data.branch.condition);
			i32 truth = lifetime_truth((Syntax*)syntax->data.branch.condition);
			LifetimeState incoming = lifetime_clone(@*this.compiler, &this.state);
			if (!truth) {
				@this.state.path = reachability::unreachable;
			};
			@this.nested_statement((Syntax*)syntax->data.branch.first);
			LifetimeState first := this.state;
			@this.state = LifetimeState(incoming);
			if (truth == 1) {
				@this.state.path = reachability::unreachable;
			};
			@this.nested_statement((Syntax*)syntax->data.branch.second);
			lifetime_merge(@*this.compiler, &this.state, &first, syntax->token);
			break;
		};
		case syntax_kind::kw_for:
		case syntax_kind::kw_while:
			@this.loop((Syntax*)syntax);
			break;
		case syntax_kind::kw_switch:
			@this.switch_((Syntax*)syntax);
			break;
		case syntax_kind::kw_break:
		case syntax_kind::kw_continue: {
			LifetimeControl* control := this.control;
			while (control && syntax->kind == syntax_kind::kw_continue && control->kind != flow_kind::loop) {
				@control := control->parent;
			};
			if (!control) {
				return;
			};
			@this.cleanup((Syntax*)syntax, (LifetimeObject*)control->boundary);
			LifetimeState edge = lifetime_clone(@*this.compiler, &this.state);
			lifetime_trim(&edge, (LifetimeObject*)control->boundary);
			if (syntax->kind == syntax_kind::kw_continue) {
				lifetime_merge(@*this.compiler, &control->continues, &edge, syntax->token);
			}
			else {
				lifetime_merge(@*this.compiler, &control->breaks, &edge, syntax->token);
			};
			@this.state.path = reachability::unreachable;
			break;
		};
		default:
			@this.expression((Syntax*)syntax);
			break;
	};
};

fn lifetime_function(Compiler& compiler, Entity* entity) {
	LifetimeAnalysis analysis;
	@analysis.compiler = &compiler;
	@analysis.state.path = reachability::reachable;
	Parameter* parameter := entity->data.function.type->data.function.parameters;
	while (parameter) {
		@analysis.enter((Entity*)parameter->entity);
		@parameter := parameter->next;
	};
	@analysis.statement((Syntax*)entity->data.function.body);
	@entity->data.function.lifetime_exit := analysis.state.path;
	if (analysis.state.path == reachability::reachable) {
		@analysis.cleanup((Syntax*)entity->data.function.body, nullptr);
	};
};

fn Semantic::nested_statement(Semantic& this, Syntax* syntax) {
	Scope* outer := this.scope;
	@this.scope = scope_create(@*this.compiler, (Scope*)outer, context_kind::local, nullptr);
	@this.statement($syntax);
	@this.scope = $outer;
};

fn Semantic::statement(Semantic& this, Syntax* syntax) {
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	if (!syntax || compiler.result == compilation_result::failure) {
		return;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			Syntax* statement := syntax->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			@this.scope = &outer;
			break;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind == entity_kind::variable) {
				Entity* variable := syntax->entity;
				if (syntax->data.declaration.type) {
					@variable->data.variable.type = type_resolve(@compiler, (Scope*)this.scope, (Syntax*)syntax->data.declaration.type);
				};
				@variable->state = resolution::ready;
				if (!syntax->data.declaration.body && variable->data.variable.type) {
					@this.generated_operation_validate((Type*)variable->data.variable.type, generated_operation::kw_default, syntax->token);
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && variable->data.variable.type->kind == type_kind::named && (variable->data.variable.type->data.entity->kind == entity_kind::kw_struct || variable->data.variable.type->data.entity->kind == entity_kind::kw_union)) {
					@syntax->data.declaration.constructor = @this.special_select((Entity*)variable->data.variable.type->data.entity, function_role::constructor, nullptr, Token(syntax->token));
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && type_requires_union_choice((Type*)variable->data.variable.type)) {
					compiler_error(@compiler, syntax->token, "automatic union member construction requires an explicit member initializer\0");
					return;
				};
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					reference_initializer(@compiler, (Syntax*)syntax->data.declaration.body, (Entity*)variable, Token(syntax->token));
					if (compiler.result == compilation_result::failure) {
						return;
					};
				}
				else {
					scope_bind(@compiler, (Scope*)this.scope, (Entity*)variable);
					if (variable->data.variable.type) {
						object_initializer_prepare(@compiler, (Scope*)this.scope, (Entity*)variable, (Syntax*)syntax->data.declaration.body, Token(syntax->token));
					};
				};
				@this.statement((Syntax*)syntax->data.declaration.body);
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					scope_bind(@compiler, (Scope*)this.scope, (Entity*)variable);
				};
				if (!variable->data.variable.type || variable->data.variable.type->kind == type_kind::kw_void || variable->data.variable.type->kind == type_kind::kw_null || variable->data.variable.type->kind == type_kind::function) {
					compiler_error(@compiler, syntax->token, "variable requires a resolved storage type\0");
				};
				layout_validate(@compiler, (Type*)variable->data.variable.type, nullptr, syntax->token);
			}
			else {
				entity_resolve(@compiler, (Entity*)syntax->entity);
			};
			break;
		case syntax_kind::kw_return:
			if (!this.function) {
				compiler_error(@compiler, syntax->token, "return requires a function context\0");
			}
			else {
				Type* result := this.function->data.function.type->data.function.result;
				if (syntax->data.expression) {
					@this.expression((Syntax*)syntax->data.expression, (Type*)result);
				if (compiler.result == compilation_result::failure) {
					return;
				};
					if (result->kind != type_kind::reference) {
						Syntax* value := syntax->data.expression;
						if (value->kind == syntax_kind::expr_name && value->entity && value->entity->kind == entity_kind::variable && !storage_borrowed((Syntax*)value) && (value->entity->data.variable.storage == storage_kind::local || value->entity->data.variable.storage == storage_kind::parameter)) {
							Syntax* relocation = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
							@relocation->kind = syntax_kind::expr_relocate;
							@relocation->token := value->token;
							@relocation->type := value->type;
							@relocation->data.expression := value;
							@syntax->data.expression = $relocation;
						};
						@this.owned((Syntax*)syntax->data.expression);
					};
				}
				else if (result->kind != type_kind::kw_void) {
					compiler_error(@compiler, syntax->token, "return requires a result value\0");
				};
			};
			break;
		case syntax_kind::kw_if:
			if (!type_scalar(@this.expression((Syntax*)syntax->data.branch.condition, (Type*)compiler.bool_type))) {
				compiler_error(@compiler, syntax->token, "condition requires a scalar value\0");
			};
			@this.nested_statement((Syntax*)syntax->data.branch.first);
			@this.nested_statement((Syntax*)syntax->data.branch.second);
			break;
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			Flow flow;
			@flow.kind = flow_kind::loop;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			@this.statement((Syntax*)syntax->data.loop.initializer);
			if (syntax->data.loop.condition) {
				if (!type_scalar(@this.expression((Syntax*)syntax->data.loop.condition, (Type*)compiler.bool_type))) {
					compiler_error(@compiler, syntax->token, "condition requires a scalar value\0");
				};
			};
			@this.statement((Syntax*)syntax->data.loop.body);
			if (syntax->data.loop.step) {
				@this.expression((Syntax*)syntax->data.loop.step, nullptr);
			};
			@this.scope = &outer;
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_switch: {
			Type* type = @this.expression((Syntax*)syntax->data.selection.value, nullptr);
			if (!type_integer(type_representation((Type*)type))) {
				compiler_error(@compiler, syntax->token, "switch requires an integer value or an enum with integer underlying storage\0");
				break;
			};
			@this.selection_validate((Syntax*)syntax, (Type*)type);
			Flow flow;
			@flow.kind = flow_kind::kw_switch;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Type* outer := this.selection_type;
			@this.selection_type = (Type*)type;
			Scope& outer_scope = @*this.scope;
			Scope* created = @this.create_scope(*syntax->data.selection.cases->scope);
			if (!created) {
				return;
			};
			Scope& cases = @*created;
			@syntax->data.selection.cases->scope = &cases;
			@this.scope = &cases;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			@this.scope = &outer_scope;
			@this.selection_type = (Type*)outer;
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_case:
			if (!this.flow || this.flow->kind != flow_kind::kw_switch) {
				compiler_error(@compiler, syntax->token, "case requires a switch context\0");
			};
			if (syntax->data.selection_case.value) {
				constant_integer(@compiler, (Scope*)this.scope, (Syntax*)syntax->data.selection_case.value);
			};
			break;
		case syntax_kind::kw_break:
		case syntax_kind::kw_continue: {
			Flow* flow := this.flow;
			if (syntax->kind == syntax_kind::kw_continue) {
				while (flow && flow->kind != flow_kind::loop) {
					@flow := flow->parent;
				};
			};
			if (!flow) {
				compiler_error(@compiler, syntax->token, "flow statement has no enclosing target\0");
			};
			break;
		};
		default: {
			Type* type = @this.expression((Syntax*)syntax, nullptr);
			if (syntax->kind != syntax_kind::stmt_bind_reference && (type->kind == type_kind::named || type->kind == type_kind::array)) {
				layout_validate(@compiler, (Type*)type, nullptr, syntax->token);
			};
			break;
		};
	};
};

fn LLVMGetVersion(u32* major, u32* minor, u32* patch);

fn Compiler::initialize(Compiler& this) -> i32 {
	Token token;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);
	if (major != 21 || minor != 1 || patch != 0) {
		compiler_error(@this, token, "LLVM runtime version must be 21.1.0\0");
		return 0;
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.backend.llvm_context.pointer = LLVMContextCreate();
	if (!this.backend.llvm_context.pointer) {
		compiler_error(@this, token, "cannot create LLVM context\0");
		return 0;
	};
	@this.backend.llvm_module.pointer = LLVMModuleCreateWithNameInContext("rutile\0", this.backend.llvm_context.get());
	if (!this.backend.llvm_module.pointer) {
		compiler_error(@this, token, "cannot create LLVM module\0");
		return 0;
	};
	@this.backend.llvm_builder.pointer = LLVMCreateBuilderInContext(this.backend.llvm_context.get());
	if (!this.backend.llvm_builder.pointer) {
		compiler_error(@this, token, "cannot create LLVM builder\0");
		return 0;
	};

	var triple = unique_ptr<char, LLVMMessageDisposer>(LLVMGetDefaultTargetTriple());
	unique_ptr<char, LLVMMessageDisposer> message;
	LLVMTarget* target;
	if (!triple.pointer) {
		compiler_error(@this, token, "cannot obtain LLVM target triple\0");
		return 0;
	};
	if (LLVMGetTargetFromTriple((char*)triple.pointer, &target, &message.pointer)) {
		compiler_error(@this, token, (char*)message.pointer);
		return 0;
	};

	@this.backend.llvm_machine.pointer = LLVMCreateTargetMachine(LLVMTarget*(target), (char*)triple.pointer, "generic\0", "\0", (i32)this.optimization, 2, 0);
	if (!this.backend.llvm_machine.pointer) {
		compiler_error(@this, token, "cannot create LLVM target machine\0");
		return 0;
	};
	@this.backend.llvm_layout.pointer = LLVMCreateTargetDataLayout(this.backend.llvm_machine.get());
	if (!this.backend.llvm_layout.pointer) {
		compiler_error(@this, token, "cannot create LLVM target data layout\0");
		return 0;
	};
	var layout = unique_ptr<char, LLVMMessageDisposer>(LLVMCopyStringRepOfTargetData(this.backend.llvm_layout.get()));
	if (!layout.pointer) {
		compiler_error(@this, token, "cannot obtain LLVM target data layout\0");
		return 0;
	};
	LLVMSetTarget(this.backend.llvm_module.get(), (char*)triple.pointer);
	LLVMSetDataLayout(this.backend.llvm_module.get(), (char*)layout.pointer);
	return this.result == compilation_result::success;
};

fn Compiler::verify(Compiler& this) -> i32 {
	unique_ptr<char, LLVMMessageDisposer> message;
	i32 invalid = LLVMVerifyModule(this.backend.llvm_module.get(), 2, &message.pointer);
	if (invalid) {
		Token token;
		compiler_error(@this, token, (char*)message.pointer);
	};
	return !invalid;
};

fn Compiler::optimize(Compiler& this) -> i32 {
	if (!@this.verify()) {
		return 0;
	};

	char*[4] pipelines {};
	@pipelines[0] = "default<O0>\0";
	@pipelines[1] = "default<O1>\0";
	@pipelines[2] = "default<O2>\0";
	@pipelines[3] = "default<O3>\0";
	var options = unique_ptr<LLVMOpaquePassBuilderOptions, LLVMPassOptionsDisposer>(LLVMCreatePassBuilderOptions());
	if (!options.pointer) {
		Token token;
		compiler_error(@this, token, "cannot create LLVM pass options\0");
		return 0;
	};
	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 1);
	LLVMOpaqueError* error = LLVMRunPasses(this.backend.llvm_module.get(), (char*)pipelines[this.optimization], this.backend.llvm_machine.get(), options.get());
	if (error) {
		var message = unique_ptr<char, LLVMErrorMessageDisposer>(LLVMGetErrorMessage(LLVMOpaqueError*(error)));
		Token token;
		compiler_error(@this, token, (char*)message.pointer);
		return 0;
	};

	return @this.verify();
};

fn backend_publish(Compiler& compiler, char* output_path) -> i32 {
	unique_ptr<char, LLVMMessageDisposer> message;
	unique_ptr<LLVMOpaqueMemoryBuffer, LLVMMemoryBufferDisposer> buffer;
	if (LLVMTargetMachineEmitToMemoryBuffer(compiler.backend.llvm_machine.get(), compiler.backend.llvm_module.get(), 1, &message.pointer, &buffer.pointer)) {
		Token token;
		compiler_error(@compiler, token, (char*)message.pointer);
		return 0;
	};

	{
		Token token;
		var file = File(&compiler, $output_path, file_purpose::object, Token(token));
		if (!file.handle) {
			return 0;
		};
		usize size = LLVMGetBufferSize(buffer.get());
		usize written = fwrite(LLVMGetBufferStart(buffer.get()), 1, (u64)size, (void*)file.handle);
		if (written != size) {
			compiler_error(@compiler, token, "cannot write native object output\0");
			return 0;
		};
	};
	return compiler.result == compilation_result::success;
};

fn source_read(Compiler& compiler, char* path) -> Source* {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};
	@source->path = string_view(memory_text(@compiler, (char*)path, strlen((char*)path)), strlen((char*)path));
	Token token;
	@token.source := source;
	@token.line = 1;
	@token.column = 1;
	var bytes = string();
	{
		var file = File(&compiler, $path, file_purpose::source, Token(token));
		if (!file.handle) {
			return nullptr;
		};
		usize maximum = ~usize(0) / sizeof(Token) - 1;
		char[4096] chunk {};
		while (true) {
			usize count = fread(&chunk[0], 1, sizeof(chunk), void*(file.handle));
			if (!count) {
				break;
			};
			if (count > maximum - bytes.size || !@bytes.append(string_view(&chunk[0], usize(count)))) {
				compiler_error(@compiler, token, "source exceeds compiler address limits or memory is unavailable\0");
				return nullptr;
			};
		};
		if (ferror(void*(file.handle))) {
			compiler_error(@compiler, token, "cannot read source\0");
		};
	};
	if (compiler.result == compilation_result::failure) {
		return nullptr;
	};
	@source->bytes = bytes;
	@source->bytes.data = (char*)@compiler.allocations.adopt(@bytes.release());
	if (source->bytes.size && !source->bytes.data) {
		@compiler.result = compilation_result::failure;
		return nullptr;
	};
	return source;
};


fn rutile_compiler_session(((Compiler*, void*) -> i32)* callback, void* data) -> i32 {
	var compiler = make_unique<Compiler>();
	if (!compiler.get()) {
		return 1;
	};
	return callback(compiler.get(), $data);
};

fn backend_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics, output_kind output) -> i32 {
	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};
	if (!compiler) {
		fputs("compiler context unavailable\n\0", (void*)diagnostics);
		return 1;
	};

	@compiler->clear();
	@compiler->diagnostics = $diagnostics;
	@compiler->open_file = $open_file;
	if (!compiler->open_file) {
		@compiler->open_file = &fopen;
	};
	@compiler->output = $output;
	@compiler->optimization := optimization;
	@compiler->entry = "main\0";
	if (entry) {
		@compiler->entry = memory_text(@*compiler, (char*)entry, strlen((char*)entry));
	};
	Token token;
	if (optimization < 0 || optimization > 3) {
		compiler_error(@*compiler, token, "optimization level must be between 0 and 3\0");
	};
	if (!source_paths || !source_count) {
		compiler_error(@*compiler, token, "no source files\0");
	};
	if (!output_path) {
		compiler_error(@*compiler, token, "native object output path is required\0");
	};

	usize index = 0;
	Source* last;
	while (index < source_count && compiler->result != compilation_result::failure) {
		if (!source_paths[index] || !strcmp((char*)source_paths[index], (char*)output_path)) {
			compiler_error(@*compiler, token, "output cannot overwrite a source file\0");
			break;
		};
		Source* source = source_read(@*compiler, (char*)source_paths[index]);
		if (!source) {
			break;
		};
		if (last) {
			@last->next := source;
		}
		else {
			@compiler->sources := source;
		};
		@last = $source;
		@index = index + 1;
	};

	if (compiler->result != compilation_result::failure && @compiler->initialize()) {
		compiler_builtins(@*compiler, (i32)(LLVMPointerSize(compiler->backend.llvm_layout.get()) * 8));
		if (prepare_sources(@*compiler)) {
			Source* source := compiler->sources;
			Syntax* last_module;
			while (source && compiler->result != compilation_result::failure) {
				Syntax* module = parse_source(@*compiler, (Source*)source);
				if (last_module) {
					@last_module->next := module;
				}
				else {
					@compiler->declarations := module;
				};
				@last_module = $module;
				@source := source->next;
			};
		};
	};
	if (compiler->result != compilation_result::failure) {
		@compiler->analyze();
	};
	if (compiler->result != compilation_result::failure) {
		@compiler->emit();
	};
	if (compiler->result != compilation_result::failure && @compiler->optimize()) {
		backend_publish(@*compiler, (char*)output_path);
	};

	@compiler->diagnostics = nullptr;
	@compiler->open_file = (((char*, char*) -> void*)*)0;
	return (i32)compiler->result;
};

fn rutile_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile($compiler, $source_paths, $source_count, $output_path, $open_file, $entry, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, i32 optimization, void* diagnostics) -> i32 {
	var compiler = make_unique<Compiler>();
	return backend_compile(compiler.get(), $source_paths, $source_count, $output_path, $open_file, nullptr, $optimization, $diagnostics, output_kind::library);
};



