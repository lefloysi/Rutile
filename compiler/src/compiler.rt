template<typename T>
struct unique_ptr {
	fn unique_ptr(unique_ptr& this);
	fn unique_ptr(unique_ptr& this, null* pointer);
	fn unique_ptr(unique_ptr& this, T* pointer);
	fn unique_ptr(unique_ptr& this, const unique_ptr& other) : delete;
	fn operator=(unique_ptr& this, const unique_ptr& other) -> unique_ptr& : delete;
	fn operator=(unique_ptr& this, unique_ptr other) -> unique_ptr&;
	fn ~unique_ptr(unique_ptr& this);

	fn get(const unique_ptr& this) -> T*;
	fn release(unique_ptr& this) -> T*;
	fn reset(unique_ptr& this, T* pointer);

	T* pointer;
};

template<typename T>
fn unique_ptr<T>::unique_ptr(unique_ptr& this) {
	@this.pointer = nullptr;
};

template<typename T>
fn unique_ptr<T>::unique_ptr(unique_ptr& this, null* pointer) {
	@this.pointer = $pointer;
};

template<typename T>
fn unique_ptr<T>::unique_ptr(unique_ptr& this, T* pointer) {
	@this.pointer = $pointer;
};

template<typename T>
fn unique_ptr<T>::operator=(unique_ptr& this, unique_ptr other) -> unique_ptr& {
	@this.reset(other.get());
	discard other;
	return @this;
};

template<typename T>
fn unique_ptr<T>::~unique_ptr(unique_ptr& this) {
	free(void*(this.pointer));
};

template<typename T>
fn unique_ptr<T>::get(const unique_ptr& this) -> T* {
	return T*(this.pointer);
};

template<typename T>
fn unique_ptr<T>::release(unique_ptr& this) -> T* {
	T* pointer := this.pointer;
	@this.pointer = nullptr;
	return pointer;
};

template<typename T>
fn unique_ptr<T>::reset(unique_ptr& this, T* pointer) {
	T* previous := this.pointer;
	@this.pointer = $pointer;
	free($previous);
};

struct string_view {
	fn string_view(string_view& this);
	fn string_view(string_view& this, const char* data, usize size);
	fn string_view(string_view& this, const string& text) : implicit;
	fn equal(const string_view& this, const string_view& other) -> bool;

	const char* data;
	usize size;
};

struct string {
	fn string(string& this);
	fn string(string& this, const string& other) : delete;
	fn append(string& this, const string_view& text) -> bool;
	fn data(const string& this) -> const char*;
	fn release(string& this) -> char*;

	unique_ptr<char> storage;
	usize size;
	usize capacity;
};

fn string_view::string_view(string_view& this) {
};

fn string_view::string_view(string_view& this, const char* data, usize size) {
	@this.data = $data;
	@this.size = $size;
};

fn string_view::string_view(string_view& this, const string& text) {
	@this.data = text.data();
	@this.size := text.size;
};

fn string_view::equal(const string_view& this, const string_view& other) -> bool {
	return this.size == other.size && (!this.size || !memcmp(const char*(this.data), const char*(other.data), usize(this.size)));
};

fn string::string(string& this) {
};

fn string::data(const string& this) -> const char* {
	return this.storage.get();
};

fn string::release(string& this) -> char* {
	@this.size = 0;
	@this.capacity = 0;
	return @this.storage.release();
};

fn string::append(string& this, const string_view& text) -> bool {
	usize maximum = (usize)(u64)18446744073709551615;
	if (text.size > maximum - this.size - 1) {
		return false;
	};
	usize required = this.size + usize(text.size) + 1;
	if (required > this.capacity) {
		usize capacity := this.capacity;
		if (!capacity) {
			@capacity := required;
		};
		while (capacity < required) {
			if (capacity > maximum / 2) {
				@capacity := required;
				break;
			};
			@capacity = capacity * 2;
		};
		var memory = unique_ptr<char>((char*)malloc(usize(capacity)));
		if (!memory.get()) {
			return false;
		};
		if (this.size) {
			memcpy(memory.get(), this.storage.get(), usize(this.size));
		};
		memcpy(memory.get() + this.size, const char*(text.data), usize(text.size));
		@this.storage = $memory;
		@this.capacity := capacity;
	}
	else {
		memmove(this.storage.get() + this.size, const char*(text.data), usize(text.size));
	};
	@this.size = this.size + usize(text.size);
	@this.storage.pointer[this.size] = '\0';
	return true;
};

struct Arena {
	fn ~Arena(Arena& this);
	fn clear(Arena& this);
	fn adopt(Arena& this, void* memory) -> void*;

	Allocation* head;
};

fn Arena::~Arena(Arena& this) {
	@this.clear();
};

fn Arena::adopt(Arena& this, void* memory) -> void* {
	var storage = unique_ptr<void>($memory);
	if (!storage.get()) {
		return nullptr;
	};
	Allocation* allocation = (Allocation*)malloc(sizeof(Allocation));
	if (!allocation) {
		return nullptr;
	};
	void* result = @storage.release();
	@allocation->memory := result;
	@allocation->next := this.head;
	@this.head = $allocation;
	return result;
};

fn Arena::clear(Arena& this) {
	while (this.head) {
		Allocation* allocation := this.head;
		@this.head := allocation->next;
		free(void*(allocation->memory));
		free($allocation);
	};
};

template<typename T, typename Disposer>
struct owner {
	fn owner(owner& this);
	fn owner(owner& this, T* handle);
	fn owner(owner& this, const owner& other) : delete;
	fn ~owner(owner& this);

	fn reset(owner& this, T* handle);

	T* handle;
};

template<typename T, typename Disposer>
fn owner<T, Disposer>::owner(owner& this) {
};

template<typename T, typename Disposer>
fn owner<T, Disposer>::owner(owner& this, T* handle) {
	@this.handle = $handle;
};

template<typename T, typename Disposer>
fn owner<T, Disposer>::~owner(owner& this) {
	@this.reset(nullptr);
};

template<typename T, typename Disposer>
fn owner<T, Disposer>::reset(owner& this, T* handle) {
	T* previous := this.handle;
	@this.handle = $handle;
	Disposer::dispose($previous);
};

