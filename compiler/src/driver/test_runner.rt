struct TestFunction {
	rt::string name;
	usize parameters;
};

struct TestRunnerSource {
	fn collect(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix, var Diagnostics& diagnostics);
	fn generate(TestRunnerSource& this, var rt::string& output);
	fn registration(TestRunnerSource& this, var rt::string& output, usize count);
	fn configuration(TestRunnerSource& this, var rt::string& output);
	fn collect_registrations(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix);

	rt::buffer<TestFunction> tests;
	rt::buffer<usize> registration_counts;
	rt::string harness;
};

fn test_source_name(var rt::string& output, Syntax& syntax) {
	if (syntax.kind() == syntax_kind::qualified_name) {
		test_source_name(@output, *syntax.left());
		@output.append("::");
		test_source_name(@output, *syntax.right());
		return;
	};
	@output.append(syntax.token().text());
};

fn test_source_number(var rt::string& output, usize value) {
	if (value >= 10) {
		test_source_number(@output, value / 10);
	};
	rt::string_view digits = "0123456789";
	@output.append(digits.slice(value % 10, 1));
};

fn TestRunnerSource::collect(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix, var Diagnostics& diagnostics) {
	if (syntax.kind() == syntax_kind::function) {
		@this.collect_registrations(syntax, prefix);
		bool test = false;
		bool harness = false;
		usize index = 0;
		while (index < syntax.declaration_attributes().size()) {
			Syntax& attribute = *syntax.declaration_attributes().data()[index].get();
			@test = test || attribute.token().is("test");
			@harness = harness || attribute.token().is("harness");
			@index = index + 1;
		};
		if (!test && !harness) {
			return;
		};
		if (!syntax.function_body() || syntax.function_body()->kind() == syntax_kind::absent) {
			@diagnostics.error(syntax.token(), "test and harness attributes require a function definition");
			return;
		};
		var function = TestFunction();
		@function.parameters = syntax.function_parameters()->size();
		@function.name.append(prefix);
		test_source_name(@function.name, *syntax.function_name());
		if (harness) {
			if (!this.harness.empty()) {
				@diagnostics.error(syntax.token(), "a test target can define only one harness");
				return;
			};
			if (function.parameters) {
				@diagnostics.error(syntax.token(), "the test harness must accept no arguments");
			};
			@this.harness = rt::string(function.name.view());
			return;
		};
		@this.tests.push_back($function);
		return;
	};
	if (syntax.kind() == syntax_kind::namespace_body) {
		var nested = rt::string(prefix);
		test_source_name(@nested, *syntax.namespace_name());
		@nested.append("::");
		@this.collect(*syntax.namespace_members(), nested, @diagnostics);
		return;
	};
	if (syntax.kind() == syntax_kind::template_declaration) {
		@this.collect(*syntax.template_declaration(), prefix, @diagnostics);
		return;
	};
	if (syntax.kind() == syntax_kind::record) {
		return;
	};
	usize index = 0;
	while (index < syntax.size()) {
		@this.collect(*syntax.item(index), prefix, @diagnostics);
		@index = index + 1;
	};
};

fn TestRunnerSource::generate(TestRunnerSource& this, var rt::string& output) {
	@output.append("fn puts(char* text) -> i32; namespace rt { namespace test { struct assertion_error {}; var failures : i32 = 0; fn expect(bool condition) { if (!condition) { @failures = failures + 1; discard puts(\"expectation failed\\0\".data()); throw assertion_error(); }; }; ");
	this.configuration(@output);
	usize count = 0;
	if (this.tests.size()) {
		@count = this.tests.data()[0].parameters;
	};
	if (count) {
		@output.append("template<");
		usize index = 0;
		while (index < count) {
			if (index) {
				@output.append(", ");
			};
			@output.append("typename T");
			test_source_number(@output, index);
			@index = index + 1;
		};
		@output.append("> ");
	};
	@output.append("fn run(");
	usize index = 0;
	while (index < count) {
		if (index) {
			@output.append(", ");
		};
		@output.append("auto T");
		test_source_number(@output, index);
		@output.append("& argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append(") { ");
	@index = 0;
	while (index < this.tests.size()) {
		@output.append("if (selected(");
		test_source_number(@output, index);
		@output.append(")) { var failures_before : i32 = failures; discard puts(\"");
		@output.append(this.tests.data()[index].name.view());
		@output.append("\\0\".data()); try { ");
		@output.append(this.tests.data()[index].name.view());
		@output.append("(");
		usize argument = 0;
		while (argument < count) {
			if (argument) {
				@output.append(", ");
			};
			@output.append("@argument");
			test_source_number(@output, argument);
			@argument = argument + 1;
		};
		@output.append("); } catch (...) { if (failures == failures_before) { @failures = failures + 1; discard puts(\"uncaught error\\0\".data()); }; }; if (failures == failures_before) { discard puts(\"[PASS]\\0\".data()); } else { discard puts(\"[FAIL]\\0\".data()); }; } ");
		@index = index + 1;
	};
	@output.append("}; ");
	@index = 0;
	while (index < this.registration_counts.size()) {
		this.registration(@output, this.registration_counts.data()[index]);
		@index = index + 1;
	};
	@output.append("}; }; fn __rutile_test_main(i32 argument_count, char** arguments) -> i32 { if (!rt::test::configure(argument_count, arguments).has<void>()) { discard puts(\"usage: --shard-count N --shard-index I (N > 0, I < N)\\0\".data()); return 2; }; ");
	if (this.harness.empty()) {
		@output.append("rt::test::run(); ");
	}
	else {
		@output.append(this.harness.view());
		@output.append("(); ");
	};
	@output.append("if (rt::test::failures) { return 1; }; return 0; };");
};







fn TestRunnerSource::registration(TestRunnerSource& this, var rt::string& output, usize count) {
	@output.append("template<typename Callback");
	usize index = 0;
	while (index < count) {
		@output.append(", typename T");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append("> fn register(rt::string_view name, Callback callback");
	@index = 0;
	while (index < count) {
		@output.append(", auto T");
		test_source_number(@output, index);
		@output.append("& argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append(") { var label = rt::string(name); discard puts(label.c_str()); var failures_before : i32 = failures; try { callback(");
	@index = 0;
	while (index < count) {
		if (index) {
			@output.append(", ");
		};
		@output.append("@argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append("); } catch (...) { if (failures == failures_before) { @failures = failures + 1; discard puts(\"uncaught error\\0\".data()); }; }; if (failures == failures_before) { discard puts(\"[PASS]\\0\".data()); } else { discard puts(\"[FAIL]\\0\".data()); }; }; ");
};

fn TestRunnerSource::collect_registrations(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix) {
	if (syntax.kind() == syntax_kind::call) {
		var name = rt::string();
		test_source_name(@name, *syntax.callable());
		if ((name.view() == "rt::test::register" || prefix == "rt::test::" && name.view() == "register") && syntax.arguments()->size() >= 2) {
			usize count = syntax.arguments()->size() - 2;
			usize index = 0;
			while (index < this.registration_counts.size() && this.registration_counts.data()[index] != count) {
				@index = index + 1;
			};
			if (index == this.registration_counts.size()) {
				@this.registration_counts.push_back(count);
			};
		};
	};
	usize index = 0;
	while (index < syntax.size()) {
		@this.collect_registrations(*syntax.item(index), prefix);
		@index = index + 1;
	};
};




fn TestRunnerSource::configuration(TestRunnerSource& this, var rt::string& output) {
	@output.append("""
var shard_count : usize = 1;
var shard_index : usize = 0;
struct argument_error {};
using NumberResult = usize | argument_error;
using ConfigurationResult = void | argument_error;
fn selected(usize ordinal) -> bool {
	return ordinal % shard_count == shard_index;
};
fn parse_number(rt::string_view text) -> NumberResult {
	if (text.empty()) {
		return NumberResult(argument_error());
	};
	usize value = 0;
	for (usize index = 0; index < text.size(); @index = index + 1) {
		char digit = text.data()[index];
		if (digit < char(48) || digit > char(57)) {
			return NumberResult(argument_error());
		};
		usize number = static_cast<usize>(digit) - 48;
		if (value > (usize::max - number) / 10) {
			return NumberResult(argument_error());
		};
		@value = value * 10 + number;
	};
	return NumberResult($value);
};
fn configure(i32 argument_count, char** arguments) -> ConfigurationResult {
	bool count_seen = false;
	bool index_seen = false;
	for (i32 argument = 1; argument < argument_count; @argument = argument + 2) {
		var option = rt::from_c_string(arguments[argument]);
		if (argument + 1 >= argument_count) {
			return ConfigurationResult(argument_error());
		};
		var parsed = parse_number(rt::from_c_string(arguments[argument + 1]));
		if (parsed.has<argument_error>()) {
			return ConfigurationResult(argument_error());
		};
		if (option == "--shard-count") {
			if (count_seen) {
				return ConfigurationResult(argument_error());
			};
			@shard_count = parsed.get<usize>();
			@count_seen = true;
		}
		else if (option == "--shard-index") {
			if (index_seen) {
				return ConfigurationResult(argument_error());
			};
			@shard_index = parsed.get<usize>();
			@index_seen = true;
		}
		else {
			return ConfigurationResult(argument_error());
		};
	};
	if (!shard_count || shard_index >= shard_count) {
		return ConfigurationResult(argument_error());
	};
	return ConfigurationResult();
};
""");
};
