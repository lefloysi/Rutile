struct analysis_cancelled_error {};

using AnalysisResult = void | compilation_error | analysis_cancelled_error;


struct EditorTemplateSelection {
	rt::string path;
	usize anchor;
	rt::string arguments;
	SourceFile input;
	rt::unique<Syntax> syntax;
	rt::string label;
};

struct Analysis {
	fn Analysis(var Analysis& this) : [default];
	fn Analysis(var Analysis& this, var NativeFile* output);

	fn set_progress(var Analysis& this, CompilerProgress progress);
	fn enable_tests(var Analysis& this);
	fn add_source(var Analysis& this, rt::string_view path, rt::string_view text);
	fn load_source(var Analysis& this, rt::string_view path, FileOpener opener) -> CompilationResult;
	fn set_source_module(var Analysis& this, usize index, rt::string_view name, i32 access);
	fn analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult;
	fn request_template_context(var Analysis& this, rt::string_view path, usize anchor, rt::string_view arguments);
	fn template_context_label(Analysis& this) -> rt::string_view;
	fn analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult;

	fn source_count(Analysis& this) -> usize;
	fn source_path(Analysis& this, usize index) -> rt::string_view;
	fn syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>&;
	fn source_tokens(Analysis& this, usize index) -> rt::buffer<Token>*;
	fn source_comments(Analysis& this, usize index) -> rt::buffer<Token>*;
	fn primitive_name(Analysis& this, rt::string_view name) -> bool;
	fn source_text(Analysis& this, usize index) -> rt::string_view;
	fn semantics(Analysis& this) -> SemanticUnit*;
	fn diagnostics(Analysis& this) -> Diagnostics&;
	fn navigation(Analysis& this) -> NavigationIndex&;
	fn pointer_bits(Analysis& this) -> u32;

private:
	fn analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> AnalysisResult;

	rt::unique<EditorTemplateSelection> template_selection;
	CompilerProgress progress;
	SourceManager sources;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax;
	rt::unique<SemanticUnit> semantic_unit;
	Diagnostics messages;
	NavigationIndex index;
	u32 target_pointer_bits;
	bool tests_enabled;
};

fn Analysis::Analysis(var Analysis& this, var NativeFile* output) {
	@this.messages = Diagnostics($output);
};

fn Analysis::add_source(var Analysis& this, rt::string_view path, rt::string_view text) {
	var SourceFile* source = @this.sources.add(path, text);
	@this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::set_source_module(var Analysis& this, usize index, rt::string_view name, i32 access) {
	var SourceFile* source = @this.sources.at(index);
	if (!source) {
		compiler_panic("source module references an invalid source index");
	};
	@source->set_module(name, $access);
};

fn Analysis::load_source(var Analysis& this, rt::string_view path, FileOpener opener) -> CompilationResult {
	var reader = SourceReader($opener, @this.sources, @this.messages);
	var read = @reader.load(path);
	if (read.has<source_io_error>()) {
		return compilation_error();
	};
	var SourceFile* source = read.get<var SourceFile*>();
	@this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::source_count(Analysis& this) -> usize {
	return this.sources.count();
};

fn Analysis::source_path(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->path();
};

fn Analysis::source_text(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->text();
};

fn Analysis::semantics(Analysis& this) -> SemanticUnit* {
	return this.semantic_unit.get();
};

fn Analysis::diagnostics(Analysis& this) -> Diagnostics& {
	return this.messages;
};

fn Analysis::navigation(Analysis& this) -> NavigationIndex& {
	return this.index;
};

fn Analysis::pointer_bits(Analysis& this) -> u32 {
	return this.target_pointer_bits;
};

fn Analysis::source_tokens(Analysis& this, usize index) -> rt::buffer<Token>* {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return nullptr;
	};
	return &@source->tokens();
};

fn Analysis::source_comments(Analysis& this, usize index) -> rt::buffer<Token>* {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return nullptr;
	};
	return &@source->comments();
};

fn Analysis::primitive_name(Analysis& this, rt::string_view name) -> bool {
	return this.types.find_primitive(name) != nullptr;
};

fn Analysis::syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>& {
	return this.syntax;
};

fn Analysis::request_template_context(var Analysis& this, rt::string_view path, usize anchor, rt::string_view arguments) {
	rt::unique<EditorTemplateSelection> selection = rt::unique<EditorTemplateSelection>::make();
	@selection.get()->path = rt::string(path);
	@selection.get()->anchor = $anchor;
	@selection.get()->arguments = rt::string(arguments);
	@this.template_selection = $selection;
};

fn Analysis::template_context_label(Analysis& this) -> rt::string_view {
	if (!this.template_selection.get()) {
		return rt::string_view();
	};
	return this.template_selection.get()->label.view();
};

fn Analysis::set_progress(var Analysis& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn Analysis::enable_tests(var Analysis& this) {
	@this.tests_enabled = true;
};


