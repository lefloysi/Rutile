struct Compilation {
	fn Compilation(Compilation& this, const Compilation& other) : [delete];
	fn Compilation(Compilation& this, Compilation other) : [delete];
	fn Compilation(Compilation& this, NativeFile* diagnostics) {
		@this.diagnostics = Diagnostics($diagnostics);
	};
	fn run(Compilation& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, output_kind kind) -> i32;

private:
	fn failure(Compilation& this, const char* message) -> i32 {
		if (!this.diagnostics.failed()) {
			Token location;
			@this.diagnostics.error(location, message);
		};
		return 1;
	};

	Diagnostics diagnostics;
	SourceManager sources;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax_units;
	rt::unique<SemanticUnit> semantics;
	rt::unique<Backend> backend;
};

struct Compiler {
	fn compile(Compiler& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, NativeFile* diagnostics, output_kind kind) -> i32 {
		@this.current = rt::unique<Compilation>(new Compilation($diagnostics));
		if (!this.current.get()) {
			return 1;
		};
		return @this.current.get()->run($paths, $count, $output_path, $opener, $entry, $optimization, $kind);
	};

private:
	rt::unique<Compilation> current;
};

fn Compilation::run(Compilation& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, output_kind kind) -> i32 {
	Token location;
	if (!paths || !count) {
		@this.diagnostics.error(location, "no source files\0");
		return 1;
	};
	if (!output_path) {
		@this.diagnostics.error(location, "native object output path is required\0");
		return 1;
	};
	if (optimization < 0 || optimization > 3) {
		@this.diagnostics.error(location, "optimization level must be between 0 and 3\0");
		return 1;
	};
	var reader = SourceReader(FileOpener(opener), @this.sources, @this.diagnostics);
	usize index = 0;
	while (index < count) {
		char* path := paths[index];
		if (!path || rt::string_view(path) == rt::string_view(output_path)) {
			@this.diagnostics.error(location, "output cannot overwrite a source file\0");
			return 1;
		};
		SourceFile* source = @reader.load($path);
		if (!source) {
			return 1;
		};
		var lexer = Lexer(@*source);
		if (!@lexer.scan()) {
			@this.diagnostics.error(lexer.error_token(), lexer.error());
			return 1;
		};
		var parser = Parser(source->tokens());
		var unit = @parser.parse();
		if (!unit.get()) {
			@this.diagnostics.error(parser.error_token(), parser.error());
			return 1;
		};
		if (!@this.syntax_units.push_back($unit)) {
			@this.diagnostics.error(location, "syntax storage is unavailable\0");
			return 1;
		};
		@index = index + 1;
	};

	@this.backend = rt::unique<Backend>(new Backend(@this.diagnostics));
	if (!this.backend.get()) {
		@this.diagnostics.error(location, "backend storage is unavailable\0");
		return 1;
	};
	if (!@this.backend.get()->initialize($optimization)) {
		return @this.failure("internal compiler error: target initialization failed without a diagnostic\0");
	};
	var analyzer = Analyzer(@this.types, @this.diagnostics, this.backend.get()->pointer_bits());
	@this.semantics = @analyzer.analyze(this.syntax_units);
	if (!this.semantics.get() || this.diagnostics.failed()) {
		return @this.failure("internal compiler error: semantic analysis failed without a diagnostic\0");
	};
	var lifetimes = LifetimeAnalyzer(@this.diagnostics);
	if (!@lifetimes.validate(*this.semantics.get())) {
		return @this.failure("internal compiler error: lifetime analysis failed without a diagnostic\0");
	};
	var entry_name = rt::string_view("main\0");
	if (entry) {
		@entry_name = rt::string_view(entry);
	};
	if (!@this.backend.get()->emit(*this.semantics.get(), entry_name, $kind)) {
		return @this.failure("internal compiler error: native emission failed without a diagnostic\0");
	};
	var output = File(opener($output_path, "wb\0"));
	if (!output.is_open()) {
		@this.diagnostics.error(location, "cannot open native object output\0");
		return 1;
	};
	if (!@this.backend.get()->write(@output) || !@output.close()) {
		@this.diagnostics.error(location, "cannot write native object output\0");
		return 1;
	};
	return 0;
};
