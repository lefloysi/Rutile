struct RuntimeMutex;
fn runtime_mutex_create() -> var RuntimeMutex*;
fn runtime_mutex_destroy(var RuntimeMutex* mutex);
fn runtime_mutex_lock(var RuntimeMutex* mutex);
fn runtime_mutex_unlock(var RuntimeMutex* mutex);

struct Compiler;

struct ModuleSource {
	rt::string path;
	rt::string module_name;
	i32 access;
};

struct CompilerOperation {
	fn CompilerOperation(var CompilerOperation& this, var Compiler& compiler);
	fn CompilerOperation(var CompilerOperation& this, CompilerOperation& other) : [delete];
	fn CompilerOperation(var CompilerOperation& this, CompilerOperation other) : [delete];
	fn ~CompilerOperation(var CompilerOperation& this);
	fn acquired(CompilerOperation& this) -> bool;

private:
	var Compiler* compiler;
	bool locked;
};

enum analysis_publication : [u08] {
	published;
	obsolete;
	unavailable;
};

struct PublishedAnalysis {
	rt::unique<Analysis> analysis;
	usize readers;
	usize owners;
};

struct TargetAnalysis {
	rt::string key;
	u64 expected_revision;
	u64 published_revision;
	var PublishedAnalysis* published;
};

struct AnalysisLease {
	fn AnalysisLease(var AnalysisLease& this) : [default];
	fn AnalysisLease(var AnalysisLease& this, AnalysisLease& other) : [delete];
	fn operator=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn operator:=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry, u64 revision);
	fn ~AnalysisLease(var AnalysisLease& this);

	fn get(AnalysisLease& this) -> Analysis*;
	fn value(AnalysisLease& this) -> Analysis&;
	fn revision(AnalysisLease& this) -> u64;

private:
	var Compiler* owner;
	var PublishedAnalysis* entry;
	u64 published_revision;
};

struct Compilation {
	fn Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output, CompilerProgress progress);
	fn run(var Compilation& this, rt::string_view output_path, rt::string_view entry, i32 optimization, output_kind kind) -> i32;

private:
	CompilerProgress progress;
	Analysis* analysis;
	FileOpener opener;
	Diagnostics diagnostics;
	rt::unique<Backend> backend;

	fn failure(var Compilation& this, rt::string_view message) -> i32;
	fn output_failure(var Compilation& this, rt::string_view operation, rt::string_view path) -> i32;
};

struct Compiler {
	fn Compiler(var Compiler& this);
	fn ~Compiler(var Compiler& this);
	fn begin_operation(var Compiler& this) -> bool;
	fn end_operation(var Compiler& this);

	fn set_progress(var Compiler& this, CompilerProgress progress);
	fn clear_modules(var Compiler& this);
	fn add_module_source(var Compiler& this, rt::string_view path, rt::string_view name, i32 access) -> bool;
	fn next_editor_revision(var Compiler& this) -> u64;
	fn expect_target(var Compiler& this, rt::string_view key, u64 revision) -> bool;
	fn publish_target(var Compiler& this, rt::string_view key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication;
	fn publish_target_alias(var Compiler& this, rt::string_view key, u64 revision, Analysis& analysis) -> analysis_publication;
	fn acquire_target(var Compiler& this, rt::string_view key) -> AnalysisLease;
	fn acquire_current_target(var Compiler& this, rt::string_view key) -> AnalysisLease;
	fn emit_target(var Compiler& this, rt::string_view key, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;

	fn publish(var Compiler& this, rt::unique<Analysis> analysis) -> bool;
	fn acquire_analysis(var Compiler& this) -> AnalysisLease;
	fn release_analysis(var Compiler& this, var PublishedAnalysis& entry);
	fn emit_current(var Compiler& this, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;
	fn compile_sources(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::buffer<rt::string_view>& texts, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;
	fn compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;

private:
	fn collect_retired(var Compiler& this);
	fn finish_compilation(var Compiler& this, rt::unique<Analysis> analysis, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;

	CompilerProgress progress;
	rt::buffer<ModuleSource> module_sources;
	var RuntimeMutex* operation_mutex;
	var RuntimeMutex* publication_mutex;
	u64 editor_revision;
	rt::unordered_map<rt::string_view, rt::unique<TargetAnalysis>> targets;
	rt::buffer<rt::unique<PublishedAnalysis>> publications;
};

fn CompilerOperation::CompilerOperation(var CompilerOperation& this, var Compiler& compiler) {
	@this.compiler = &@compiler;
	@this.locked = @compiler.begin_operation();
};

fn CompilerOperation::~CompilerOperation(var CompilerOperation& this) {
	if (this.locked) {
		@this.compiler->end_operation();
	};
};

fn CompilerOperation::acquired(CompilerOperation& this) -> bool {
	return this.locked;
};

fn AnalysisLease::AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry, u64 revision) {
	@this.owner = &@owner;
	@this.entry = $entry;
	@this.published_revision = $revision;
};

fn AnalysisLease::~AnalysisLease(var AnalysisLease& this) {
	if (this.owner && this.entry) {
		@this.owner->release_analysis(@*this.entry);
	};
};

fn AnalysisLease::get(AnalysisLease& this) -> Analysis* {
	if (!this.entry) {
		return nullptr;
	};

	return this.entry->analysis.get();
};

fn AnalysisLease::value(AnalysisLease& this) -> Analysis& {
	return *this.get();
};

fn Compiler::Compiler(var Compiler& this) {
	@this.operation_mutex = runtime_mutex_create();
	@this.publication_mutex = runtime_mutex_create();
	@this.editor_revision = 0;
};

fn Compiler::~Compiler(var Compiler& this) {
	runtime_mutex_destroy(this.publication_mutex);
	runtime_mutex_destroy(this.operation_mutex);
};

fn Compiler::begin_operation(var Compiler& this) -> bool {
	if (!this.operation_mutex) {
		return false;
	};
	runtime_mutex_lock(this.operation_mutex);
	return true;
};

fn Compiler::end_operation(var Compiler& this) {
	runtime_mutex_unlock(this.operation_mutex);
};

fn AnalysisLease::revision(AnalysisLease& this) -> u64 {
	return this.published_revision;
};

fn Compiler::next_editor_revision(var Compiler& this) -> u64 {
	if (!this.publication_mutex) {
		return 0;
	};
	runtime_mutex_lock(this.publication_mutex);
	@this.editor_revision = this.editor_revision + 1;
	u64 revision = this.editor_revision;
	runtime_mutex_unlock(this.publication_mutex);
	return $revision;
};

fn Compiler::expect_target(var Compiler& this, rt::string_view key, u64 revision) -> bool {
	if (!this.publication_mutex) {
		return false;
	};

	var fresh = rt::unique<TargetAnalysis>::make();
	if (!fresh.get() || !@fresh.get()->key.append(key)) {
		return false;
	};
	@fresh.get()->expected_revision = revision;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (found) {
		if (revision < found->get()->expected_revision) {
			runtime_mutex_unlock(this.publication_mutex);
			return false;
		};
		@found->get()->expected_revision = revision;
		runtime_mutex_unlock(this.publication_mutex);
		return true;
	};

	var owned_key = fresh.get()->key.view();
	bool inserted = @this.targets.insert(owned_key, $fresh);
	runtime_mutex_unlock(this.publication_mutex);
	return $inserted;
};

fn Compiler::publish_target(var Compiler& this, rt::string_view key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication {
	if (!this.publication_mutex || !analysis.get()) {
		return analysis_publication::unavailable;
	};

	var next = rt::unique<PublishedAnalysis>::make();
	if (!next.get()) {
		return analysis_publication::unavailable;
	};
	@next.get()->analysis = $analysis;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (!found) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::unavailable;
	};

	var TargetAnalysis* target = found->get();
	if (target->expected_revision != revision) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::obsolete;
	};

	usize slot = 0;
	while (slot < this.publications.size() && this.publications.data()[slot].get()) {
		@slot = slot + 1;
	};
	if (slot == this.publications.size()) {
		if (!@this.publications.reserve(slot + 1) || !@this.publications.push_back(rt::unique<PublishedAnalysis>())) {
			runtime_mutex_unlock(this.publication_mutex);
			return analysis_publication::unavailable;
		};
	};
	var rt::unique<PublishedAnalysis>* entries = (@this.publications).data();
	@next.get()->owners = 1;
	var PublishedAnalysis* published = next.get();
	@entries[slot].reset(@next.release());
	if (target->published) {
		if (target->published->owners) {
			@target->published->owners = target->published->owners - 1;
		};
	};
	@target->published = $published;
	@target->published_revision = revision;
	runtime_mutex_unlock(this.publication_mutex);
	@this.collect_retired();
	return analysis_publication::published;
};

fn Compiler::publish_target_alias(var Compiler& this, rt::string_view key, u64 revision, Analysis& analysis) -> analysis_publication {
	if (!this.publication_mutex) {
		return analysis_publication::unavailable;
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (!found) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::unavailable;
	};
	var TargetAnalysis* target = found->get();
	if (target->expected_revision != revision) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::obsolete;
	};
	var PublishedAnalysis* shared = nullptr;
	usize index = 0;
	while (index < this.publications.size()) {
		var PublishedAnalysis* candidate = this.publications.data()[index].get();
		if (candidate && candidate->analysis.get() == &@analysis) {
			@shared = $candidate;
			break;
		};
		@index = index + 1;
	};
	if (!shared) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::unavailable;
	};
	@shared->owners = shared->owners + 1;
	if (target->published && target->published->owners) {
		@target->published->owners = target->published->owners - 1;
	};
	@target->published = $shared;
	@target->published_revision = revision;
	runtime_mutex_unlock(this.publication_mutex);
	@this.collect_retired();
	return analysis_publication::published;
};

fn Compiler::publish(var Compiler& this, rt::unique<Analysis> analysis) -> bool {
	var key = rt::string_view();
	if (!@this.expect_target(key, 0)) {
		return false;
	};

	return @this.publish_target(key, 0, $analysis) == analysis_publication::published;
};

fn Compiler::acquire_target(var Compiler& this, rt::string_view key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	u64 revision = 0;
	if (found) {
		@entry = found->get()->published;
		@revision = found->get()->published_revision;
	};

	if (entry) {
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry, $revision);
};

fn Compiler::acquire_current_target(var Compiler& this, rt::string_view key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	u64 revision = 0;
	if (found && found->get()->published && found->get()->expected_revision == found->get()->published_revision) {
		@entry = found->get()->published;
		@revision = found->get()->published_revision;
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry, $revision);
};

fn Compiler::acquire_analysis(var Compiler& this) -> AnalysisLease {
	return @this.acquire_target(rt::string_view());
};

fn Compiler::release_analysis(var Compiler& this, var PublishedAnalysis& entry) {
	runtime_mutex_lock(this.publication_mutex);
	if (entry.readers) {
		@entry.readers = entry.readers - 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
};

fn Compiler::collect_retired(var Compiler& this) {
	while (true) {
		rt::unique<PublishedAnalysis> garbage;
		runtime_mutex_lock(this.publication_mutex);
		usize index = 0;
		while (index < this.publications.size()) {
			var PublishedAnalysis* entry = this.publications.data()[index].get();
			if (entry && !entry->owners && !entry->readers) {
				var rt::unique<PublishedAnalysis>* entries = (@this.publications).data();
				@garbage.reset(@entries[index].release());
				break;
			};
			@index = index + 1;
		};
		runtime_mutex_unlock(this.publication_mutex);
		if (!garbage.get()) {
			break;
		};
		@garbage.reset(nullptr);
	};
};

fn Compilation::Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output, CompilerProgress progress) {
	@this.progress = $progress;
	@this.opener = $opener;
	@this.analysis = &@analysis;
	@this.diagnostics = Diagnostics($output);
};

fn Compilation::failure(var Compilation& this, rt::string_view message) -> i32 {
	if (!this.diagnostics.failed()) {
		Token location;
		@this.diagnostics.error(location, message);
	};

	return 1;
};

fn Compilation::output_failure(var Compilation& this, rt::string_view operation, rt::string_view path) -> i32 {
	var message = DiagnosticMessage();
	@message.text(operation);
	@message.text(" native object output ");
	@message.quoted(path);
	Token location;

	if (this.diagnostics.failed()) {
		@this.diagnostics.note(location, message.view());
	}
	else {
		@this.diagnostics.error(location, message.view());
	};

	return 1;
};

fn Compilation::run(var Compilation& this, rt::string_view output_path, rt::string_view entry, i32 optimization, output_kind kind) -> i32 {
	if (this.analysis->diagnostics().failed() || !this.analysis->semantics()) {
		return 1;
	};

	if (output_path.empty()) {
		return @this.failure("native object output path is required");
	};

	if (optimization < 0 || optimization > 3) {
		return @this.failure("optimization level must be between 0 and 3");
	};
	@this.backend = rt::unique<Backend>(new var Backend(@this.diagnostics));

	if (!this.backend.get() || !@this.backend.get()->initialize($optimization)) {
		return @this.failure("internal compiler error: target initialization failed without a diagnostic");
	};

	if (this.backend.get()->pointer_bits() != this.analysis->pointer_bits()) {
		return @this.failure("analysis target pointer width does not match the native output target");
	};

	@this.backend.get()->set_progress(this.progress);
	if (!@this.backend.get()->emit(*this.analysis->semantics(), entry, $kind)) {
		return @this.failure("internal compiler error: native emission failed without a diagnostic");
	};

	var native_output_path = rt::string(output_path);
	var output = File(this.opener(native_output_path.c_str(), "wb\0".data()));
	if (!output.is_open()) {
		return @this.output_failure("cannot open", output_path);
	};

	if (!@this.backend.get()->write(@output)) {
		return @this.output_failure("cannot write", output_path);
	};

	if (!@output.close()) {
		return @this.output_failure("cannot close", output_path);
	};

	return 0;
};

fn Compiler::emit_target(var Compiler& this, rt::string_view key, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var lease = @this.acquire_current_target(key);
	if (!lease.get()) {
		var errors = Diagnostics($diagnostics);
		Token location;
		@errors.error(location, "no current target analysis is available for native emission");
		return 1;
	};

	if (lease.value().diagnostics().failed()) {
		lease.value().diagnostics().replay(diagnostics);
		return 1;
	};

	var compilation = Compilation(lease.value(), &platform_open_utf8_file, $diagnostics, this.progress);
	return @compilation.run(output_path, entry, $optimization, $kind);
};

fn Compiler::emit_current(var Compiler& this, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	return @this.emit_target(rt::string_view(), output_path, entry, $optimization, $diagnostics, $kind);
};

fn Compiler::compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var errors = Diagnostics(diagnostics);
	Token location;

	if (!paths.size()) {
		@errors.error(location, "no source files");
		return 1;
	};

	if (output_path.empty()) {
		@errors.error(location, "native object output path is required");
		return 1;
	};

	var analysis = rt::unique<Analysis>(new var Analysis(diagnostics));
	if (!analysis.get()) {
		@errors.error(location, "analysis storage is unavailable");
		return 1;
	};

	@analysis.get()->set_progress(this.progress);
	this.progress.report("reading", 0, paths.size(), "");
	usize index = 0;
	while (index < paths.size()) {
		rt::string_view path := paths.data()[index];

		if (path.empty() || path == output_path) {
			@errors.error(location, "output cannot overwrite a source file");
			return 1;
		};
		if (!@analysis.get()->load_source(path, opener)) {
			return 1;
		};
		@index = index + 1;
		this.progress.report("reading", index, paths.size(), path);
	};

	return @this.finish_compilation($analysis, output_path, $opener, entry, $optimization, $diagnostics, $kind);
};

fn Compiler::finish_compilation(var Compiler& this, rt::unique<Analysis> analysis, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var errors = Diagnostics(diagnostics);
	Token location;
	if (kind == output_kind::tests) {
		@analysis.get()->enable_tests();
	};
	if (!@analysis.get()->analyze(static_cast<u32>(sizeof(usize) * 8), nullptr, nullptr)) {
		@errors.error(location, "internal compiler error: analysis could not complete");
		return 1;
	};

	var compilation = Compilation(*analysis.get(), opener, diagnostics, this.progress);
	i32 result = @compilation.run(output_path, entry, $optimization, $kind);

	if (!@this.publish($analysis)) {
		@errors.error(location, "could not publish the completed analysis");
		return 1;
	};

	return $result;
};

fn Compiler::set_progress(var Compiler& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn Compiler::clear_modules(var Compiler& this) {
	@this.module_sources.clear();
};

fn Compiler::add_module_source(var Compiler& this, rt::string_view path, rt::string_view name, i32 access) -> bool {
	ModuleSource source;
	@source.path = rt::string(path);
	@source.module_name = rt::string(name);
	@source.access = $access;
	return @this.module_sources.push_back($source);
};

fn Compiler::compile_sources(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::buffer<rt::string_view>& texts, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var errors = Diagnostics(diagnostics);
	Token location;
	if (!paths.size() || paths.size() != texts.size()) {
		@errors.error(location, "source paths and source texts must have matching nonzero counts");
		return 1;
	};
	if (output_path.empty()) {
		@errors.error(location, "native object output path is required");
		return 1;
	};
	var operation = CompilerOperation(@this);
	if (!operation.acquired()) {
		@errors.error(location, "compiler operation lock is unavailable");
		return 1;
	};
	var analysis = rt::unique<Analysis>(new var Analysis(diagnostics));
	if (!analysis.get()) {
		@errors.error(location, "analysis storage is unavailable");
		return 1;
	};
	@analysis.get()->set_progress(this.progress);
	this.progress.report("reading", 0, paths.size(), "");
	usize index = 0;
	while (index < paths.size()) {
		rt::string_view path := paths.data()[index];
		if (path.empty() || path == output_path) {
			@errors.error(location, "output cannot overwrite a source file");
			return 1;
		};
		if (!@analysis.get()->add_source(path, texts.data()[index])) {
			@errors.error(location, "source storage is unavailable");
			return 1;
		};
		usize module_index = 0;
		while (module_index < this.module_sources.size()) {
			ModuleSource& source = this.module_sources.data()[module_index];
			if (source.path.view() == path && !@analysis.get()->set_source_module(index, source.module_name.view(), source.access)) {
				return 1;
			};
			@module_index = module_index + 1;
		};
		@index = index + 1;
		this.progress.report("reading", index, paths.size(), path);
	};
	return @this.finish_compilation($analysis, output_path, $opener, entry, $optimization, $diagnostics, $kind);
};

