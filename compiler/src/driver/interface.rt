fn fopen(char* path, char* mode) -> var NativeFile*;

fn platform_standard_error() -> var NativeFile*;

fn report_compiler_internal_error(compiler_internal_error& error, var NativeFile* output) {
	if (!output) {
		@output = platform_standard_error();
	};
	discard fprintf(output, "internal compiler error: %s\n\0".data(), error.message.c_str());
};

fn "C" rutile_compiler_create() -> var Compiler* {
	try {
		rt::unique<Compiler> compiler = rt::unique<Compiler>::make();
		return @compiler.release();
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return nullptr;
	}
	catch (rt::allocation_error& error) {
		return nullptr;
	};
};

fn "C" rutile_compiler_destroy(var Compiler* compiler) {
	delete compiler;
};

fn "C" rutile_compiler_session(((var Compiler*, var void*) -> i32)* callback, var void* data) -> i32 {
	try {
		rt::unique<Compiler> compiler = rt::unique<Compiler>::make();


		return callback(compiler.get(), $data);
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compile(var Compiler* compiler, var char var** paths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics) -> i32 {
	try {
		if (!compiler) {
			return 1;
		};

		if (!opener) {
			@opener = &fopen;
		};

		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};

		rt::buffer<rt::string_view> source_paths;
		usize index = 0;

		while (paths && index < count) {
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@index = index + 1;
		};

		rt::string_view entry_name = "main";

		if (entry) {
			@entry_name = rt::from_c_string(entry);
		};

		var result = @compiler->compile(source_paths, rt::from_c_string(output_path), $opener, entry_name, $optimization, diagnostics, output_kind::executable);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compile_library(var char var** paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics) -> i32 {
	return rutile_compile_library_progress($paths, $count, $output_path, $opener, $optimization, $diagnostics, nullptr, nullptr);
};

fn "C" rutile_compile_library_progress(var char var** paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics, ProgressCallback callback, var void* context) -> i32 {
	try {
		Compiler compiler;
		rutile_compiler_set_progress(&@compiler, $callback, $context);

		if (!opener) {
			@opener = &fopen;
		};

		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};

		rt::buffer<rt::string_view> source_paths;
		usize index = 0;

		while (paths && index < count) {
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@index = index + 1;
		};

		var result = @compiler.compile(source_paths, rt::from_c_string(output_path), $opener, "main", $optimization, diagnostics, output_kind::library);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compiler_set_progress(var Compiler* compiler, ProgressCallback callback, var void* context) {
	if (!compiler) {
		return;
	};
	CompilerProgress progress;
	@progress.callback = $callback;
	@progress.context = $context;
	@compiler->set_progress($progress);
};

fn "C" rutile_compile_sources(var Compiler* compiler, var char var** paths, var char var** texts, usize* lengths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics, i32 library) -> i32 {
	try {
		if (!compiler || !paths || !texts || !lengths || !count) {
			return 1;
		};
		if (!opener) {
			@opener = &fopen;
		};
		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};
		rt::buffer<rt::string_view> source_paths;
		rt::buffer<rt::string_view> source_texts;
		usize index = 0;
		while (index < count) {
			if (!paths[index] || (!texts[index] && lengths[index])) {
				return 1;
			};
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@source_texts.push_back(rt::string_view(texts[index], lengths[index]));
			@index = index + 1;
		};
		rt::string_view entry_name = "main";
		if (entry) {
			@entry_name = rt::from_c_string(entry);
		};
		output_kind kind = output_kind::executable;
		if (library == 1) {
			@kind = output_kind::library;
		};
		if (library == 2) {
			@kind = output_kind::tests;
		};
		var result = @compiler->compile_sources(source_paths, source_texts, rt::from_c_string(output_path), $opener, entry_name, $optimization, diagnostics, $kind);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compiler_clear_modules(var Compiler* compiler) {
	if (compiler) {
		@compiler->clear_modules();
	};
};

fn "C" rutile_compiler_add_module_source(var Compiler* compiler, char* path, char* name, i32 access) -> i32 {
	try {
		if (!compiler || !path || !name) {
			return 1;
		};
		@compiler->add_module_source(rt::from_c_string(path), rt::from_c_string(name), $access);
		return 0;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};
