fn fprintf(var NativeFile* file, char* format, ...) -> i32;

struct compilation_error {
};

using CompilationResult = void | compilation_error;

struct compiler_internal_error {
	rt::string message;
};

fn compiler_panic(rt::string_view message) {
	compiler_internal_error error;
	@error.message = rt::string(message);
	throw $error;
};

enum diagnostic_state : [u08] {
	clean;
	failed;
};

enum diagnostic_message_state : [u08] {
	complete;
	unavailable;
};

struct DiagnosticMessage {
	fn text(var DiagnosticMessage& this, rt::string_view value);
	fn quoted(var DiagnosticMessage& this, rt::string_view value);
	fn number(var DiagnosticMessage& this, u64 value);
	fn view(DiagnosticMessage& this) -> rt::string_view;

private:
	rt::string contents;
	diagnostic_message_state state;
};

struct DiagnosticNote {
	Token location;
	rt::string message;
};

struct DiagnosticRecord {
	Token location;
	rt::string message;
	rt::buffer<DiagnosticNote> notes;
};

struct Diagnostics {
	fn Diagnostics(var Diagnostics& this) : [default];
	fn Diagnostics(var Diagnostics& this, var NativeFile* output);

	fn error(var Diagnostics& this, Token& location, rt::string_view message);
	fn syntax_error(var Diagnostics& this, Token& location, rt::string_view message);
	fn note(var Diagnostics& this, Token& location, rt::string_view message);
	fn replay(Diagnostics& this, var NativeFile* output);
	fn records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>&;
	fn set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context);
	fn cancelled(Diagnostics& this) -> bool;

	fn failed(Diagnostics& this) -> bool;

private:
	var NativeFile* output;
	diagnostic_state state;
	rt::buffer<DiagnosticRecord> messages;
	((var void*) -> i32)* cancellation;
	var void* cancellation_context;

	fn write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view severity, rt::string_view message);
};

fn DiagnosticMessage::text(var DiagnosticMessage& this, rt::string_view value) {
	if (this.state == diagnostic_message_state::complete) {
		@this.contents.append(value);
	};
};

fn DiagnosticMessage::quoted(var DiagnosticMessage& this, rt::string_view value) {
	@this.text("'");
	usize index = 0;
	while (index < value.size()) {
		char byte = value.data()[index];
		if (byte == '\n') {
			@this.text("\\n");
		}
		else if (byte == '\r') {
			@this.text("\\r");
		}
		else if (byte == '\t') {
			@this.text("\\t");
		}
		else if (byte == '\0') {
			@this.text("\\0");
		}
		else if (byte == '\\' || byte == '\'') {
			@this.text("\\");
			@this.text(rt::string_view(&@byte, 1));
		}
		else {
			@this.text(rt::string_view(&@byte, 1));
		};
		@index = index + 1;
	};
	@this.text("'");
};

fn DiagnosticMessage::number(var DiagnosticMessage& this, u64 value) {
	char[20] digits;
	usize begin = sizeof(digits);
	while (true) {
		@begin = begin - 1;
		@digits[begin] = static_cast<char>(value % 10 + static_cast<u64>('0'));
		@value = value / 10;
		if (!value) {
			break;
		};
	};
	@this.text(rt::string_view(&@digits[begin], sizeof(digits) - begin));
};

fn DiagnosticMessage::view(DiagnosticMessage& this) -> rt::string_view {
	if (this.state == diagnostic_message_state::unavailable) {
		return "cannot format diagnostic: insufficient memory";
	};
	return this.contents.view();
};

fn Diagnostics::Diagnostics(var Diagnostics& this, var NativeFile* output) {
	@this.output = $output;
};

fn Diagnostics::failed(Diagnostics& this) -> bool {
	return this.state == diagnostic_state::failed || this.cancelled();
};

fn Diagnostics::error(var Diagnostics& this, Token& location, rt::string_view message) {
	@this.state = diagnostic_state::failed;
	DiagnosticRecord record;
	@record.location := location;
	@record.message.append(message);
	@this.messages.push_back($record);
	this.write(this.output, location, "error", message);
};

fn Diagnostics::note(var Diagnostics& this, Token& location, rt::string_view message) {
	if (!this.messages.size()) {
		return;
	};
	DiagnosticNote note;
	@note.location := location;
	@note.message.append(message);
	var DiagnosticRecord* records = @this.messages.data();
	var DiagnosticRecord& record = @records[this.messages.size() - 1];
	@record.notes.push_back($note);
	this.write(this.output, location, "note", message);
};

fn Diagnostics::records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>& {
	return this.messages;
};

fn Diagnostics::set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context) {
	@this.cancellation = $callback;
	@this.cancellation_context = $context;
};

fn Diagnostics::cancelled(Diagnostics& this) -> bool {
	return this.cancellation && this.cancellation(this.cancellation_context) != 0;
};

fn Diagnostics::write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view severity, rt::string_view message) {

	if (!output) {
		return;
	};

	var path = "<compiler>";

	if (location.source) {
		@path = location.source->path();
	};

	usize path_size = path.size();
	usize message_size = message.size();

	if (path_size > static_cast<usize>(i32::max)) {
		@path_size = static_cast<usize>(i32::max);
	};

	if (message_size > static_cast<usize>(i32::max)) {
		@message_size = static_cast<usize>(i32::max);
	};

	discard fprintf(output, "%.*s:%llu:%llu: %.*s: %.*s\n\0".data(), static_cast<i32>($path_size), path.data(), u64(location.line), u64(location.column), static_cast<i32>(severity.size()), severity.data(), static_cast<i32>($message_size), message.data());
};

fn Diagnostics::replay(Diagnostics& this, var NativeFile* output) {
	usize index = 0;
	while (index < this.messages.size()) {
		DiagnosticRecord& record = this.messages.data()[index];
		this.write(output, record.location, "error", record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			DiagnosticNote& related = record.notes.data()[note];
			this.write(output, related.location, "note", related.message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
};

fn Diagnostics::syntax_error(var Diagnostics& this, Token& location, rt::string_view message) {
	var rendered = DiagnosticMessage();
	@rendered.text(message);
	if (location.source) {
		if (location.kind == token_kind::eof) {
			@rendered.text("; found end of file");
		}
		else if (location.length) {
			@rendered.text("; found ");
			@rendered.quoted(location.text());
		};
	};
	@this.error(location, rendered.view());
};
