enum value_category : [i32] {
	entity;
	storage;
	temporary;
};

struct Semantic {
	Compiler* compiler;
	Scope* scope;
	Entity* function;
	SemanticFlow* flow;
	Type* selection_type;
};

struct Emitter {
	MirScope* scope;
	LLVMOpaqueValue* llvm_function;
	LLVMOpaqueValue* component_source;
	Type* return_type;
	Compiler* compiler;
	Entity* function;
	Temporary* temporaries;
};

struct Temporary {
	Type* type;
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* guard;
	Temporary* next;
};

struct CaseValue {
	CaseValue* next;
	u64 value;
};

fn entity_type(Entity* entity) -> Type* {
	switch (entity->kind) {
		case entity_kind::primitive:
			return (Type*)entity->data.primitive.type;
		case entity_kind::kw_struct:
		case entity_kind::kw_union:
			return (Type*)entity->data.aggregate.type;
		case entity_kind::kw_enum:
			return (Type*)entity->data.enumeration.aggregate.type;
		case entity_kind::function:
			return (Type*)entity->data.function.type;
		case entity_kind::variable:
			return (Type*)entity->data.variable.type;
		default:
			return nullptr;
	};
};

// ============================================================================
// MODULE: TYPE STORAGE
// FUTURE FILE: semantic/types.rt
// PURPOSE: Publish complete type records and share identities with matching inputs.
// DEPENDS ON: Compiler arena, type representation, and semantic state.
// ============================================================================
fn type_key_equal(const Type& first, const Type& second) -> bool {
	if (first.kind != second.kind || first.qualifier != second.qualifier) {
		return false;
	};
	switch (first.kind) {
		case type_kind::named:
		case type_kind::parameter:
			return first.data.entity == second.data.entity;
		case type_kind::pointer:
		case type_kind::reference:
			return first.data.element == second.data.element;
		case type_kind::array:
			return first.data.array.element == second.data.array.element && first.data.array.count == second.data.array.count;
		case type_kind::function: {
			if (first.data.function.result != second.data.function.result || first.data.function.arity != second.data.function.arity) {
				return false;
			};
			Parameter* a := first.data.function.parameters;
			Parameter* b := second.data.function.parameters;
			while (a && b) {
				if (a->type != b->type) {
					return false;
				};
				@a := a->next;
				@b := b->next;
			};
			return !a && !b;
		};
		case type_kind::kw_signed:
		case type_kind::kw_unsigned:
		case type_kind::kw_float:
			return first.data.bits == second.data.bits;
		default:
			return true;
	};
};

fn type_intern(Compiler& compiler, const Type& value) -> Type* {
	usize hash = (usize)value.kind * 33 + (usize)value.qualifier;
	switch (value.kind) {
		case type_kind::named:
		case type_kind::parameter:
			@hash = hash * 33 + ((usize)value.data.entity >> 4);
			break;
		case type_kind::pointer:
		case type_kind::reference:
			@hash = hash * 33 + ((usize)value.data.element >> 4);
			break;
		case type_kind::array:
			@hash = (hash * 33 + ((usize)value.data.array.element >> 4)) * 33 + (usize)value.data.array.count;
			break;
		case type_kind::function: {
			@hash = (hash * 33 + ((usize)value.data.function.result >> 4)) * 33 + (usize)value.data.function.arity;
			Parameter* parameter := value.data.function.parameters;
			while (parameter) {
				@hash = hash * 33 + ((usize)parameter->type >> 4);
				@parameter := parameter->next;
			};
			break;
		};
		case type_kind::kw_signed:
		case type_kind::kw_unsigned:
		case type_kind::kw_float:
			@hash = hash * 33 + (usize)value.data.bits;
			break;
	};
	usize bucket = hash % (sizeof(compiler.semantic.types.buckets) / sizeof(TypeRecord*));
	TypeRecord* record := compiler.semantic.types.buckets[bucket];
	while (record) {
		if (type_key_equal(record->value, value)) {
			return &record->value;
		};
		@record := record->next;
	};

	@record = (TypeRecord*)memory_allocate(@compiler, sizeof(TypeRecord));
	if (!record) {
		return nullptr;
	};
	@record->value := value;
	@record->next := compiler.semantic.types.buckets[bucket];
	@compiler.semantic.types.buckets[bucket] := record;
	return &record->value;
};

fn type_primitive(Compiler& compiler, type_kind kind, i32 bits) -> Type* {
	Type value;
	@value.kind = $kind;
	@value.data.bits = $bits;
	return type_intern(@compiler, value);
};

fn type_entity(Compiler& compiler, type_kind kind, Entity* entity) -> Type* {
	Type value;
	@value.kind = $kind;
	@value.data.entity = $entity;
	return type_intern(@compiler, value);
};

fn type_indirect(Compiler& compiler, type_kind kind, Type* element) -> Type* {
	Type value;
	@value.kind = $kind;
	@value.data.element = $element;
	return type_intern(@compiler, value);
};

fn type_pointer(Compiler& compiler, Type* element) -> Type* {
	return type_indirect(@compiler, type_kind::pointer, $element);
};

fn type_array(Compiler& compiler, Type* element, u64 count) -> Type* {
	Type value;
	@value.kind = type_kind::array;
	@value.data.array.element = $element;
	@value.data.array.count = $count;
	return type_intern(@compiler, value);
};

fn type_function(Compiler& compiler, Type* result, Parameter* parameters, parameter_arity arity) -> Type* {
	Type value;
	@value.kind = type_kind::function;
	@value.data.function.result = $result;
	@value.data.function.parameters = $parameters;
	@value.data.function.arity = $arity;
	return type_intern(@compiler, value);
};

fn type_equal(Type* first, Type* second) -> i32 {
	if (first == second) {
		return 1;
	};
	if (!first || !second) {
		return 0;
	};
	return type_key_equal(*first, *second);
};

fn type_qualified(Compiler& compiler, Type* type, type_qualifier qualifier) -> Type* {
	if (type->qualifier == qualifier) {
		return $type;
	};
	Type value := *type;
	@value.qualifier = $qualifier;
	return type_intern(@compiler, value);
};

fn type_value_equal(Type* first, Type* second) -> bool {
	if (!first || !second) {
		return false;
	};
	Type a := *first;
	Type b := *second;
	@a.qualifier = type_qualifier::mutable;
	@b.qualifier = type_qualifier::mutable;
	return type_equal(&a, &b);
};

fn type_enum(Type* type) -> bool {
	return type && type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_enum;
};

fn type_representation(Type* type) -> Type* {
	while (type_enum((Type*)type) && type->data.entity->data.enumeration.underlying) {
		@type := type->data.entity->data.enumeration.underlying;
	};
	return $type;
};

fn type_numeric(Type* type) -> i32 {
	return type && (type->kind == type_kind::kw_char || type->kind == type_kind::kw_bool || type->kind == type_kind::kw_signed || type->kind == type_kind::kw_unsigned || type->kind == type_kind::kw_float);
};

fn type_integer(Type* type) -> i32 {
	return type_numeric((Type*)type) && type->kind != type_kind::kw_float;
};

fn type_null_pointer(Type* type) -> bool {
	return type && type->kind == type_kind::pointer && type->data.element->kind == type_kind::kw_null;
};
fn type_pointer_conversion(Type* source, Type* target) -> bool {
	if (!source || !target || source->kind != type_kind::pointer || target->kind != type_kind::pointer) {
		return false;
	};
	if (type_null_pointer((Type*)source)) {
		return true;
	};
	if (source->data.element->qualifier == type_qualifier::kw_const && target->data.element->qualifier != type_qualifier::kw_const) {
		return false;
	};
	return type_value_equal((Type*)source->data.element, (Type*)target->data.element) || (target->data.element->kind == type_kind::kw_void && source->data.element->kind != type_kind::function);
};

fn type_scalar(Type* type) -> i32 {
	return type_numeric((Type*)type) || (type && (type->kind == type_kind::pointer || type->kind == type_kind::reference));
};

fn type_aggregate(Type* type) -> i32 {
	@type = type_representation(Type*(type));
	if (!type) {
		return 0;
	};
	if (type->kind == type_kind::array) {
		return 1;
	};
	return type->kind == type_kind::named && (type->data.entity->kind == entity_kind::kw_struct || type->data.entity->kind == entity_kind::kw_union);
};

fn type_bits(Type* type) -> i32 {
	@type = type_representation(Type*(type));
	if (type->kind == type_kind::kw_bool) {
		return 1;
	};
	if (type->kind == type_kind::kw_char) {
		return 8;
	};
	if (type->kind == type_kind::named) {
		return 32;
	};
	return (i32)type->data.bits;
};

fn type_unsigned(Type* type) -> i32 {
	@type = type_representation(Type*(type));
	return type->kind == type_kind::kw_unsigned || type->kind == type_kind::kw_bool;
};

fn integer_spelling(Compiler& compiler, const Token& token, u64 maximum) -> u64 {
	if (token.length && token.source->bytes.data[token.begin] == '\'') {
		char character := token.source->bytes.data[token.begin + 1];

		if (character == '\\') {
			@character = literal_escape(@compiler, token, (char)token.source->bytes.data[token.begin + 2]);
		};

		u64 value = (u64)character;

		if (value > maximum) {
			compiler_error(@compiler, token, "character literal is outside the destination range\0");
			return 0;
		};

		return $value;
	};

	u64 result = 0;
	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes.data[token.begin + index];

		if (!lexer_digit((char)character)) {
			compiler_error(@compiler, token, "expected a decimal integer literal\0");
			return 0;
		};

		u64 digit = (u64)(character - '0');

		if (result > maximum / 10 || (result == maximum / 10 && digit > maximum % 10)) {
			compiler_error(@compiler, token, "integer literal is outside the destination range\0");
			return 0;
		};

		@result = result * 10 + digit;
		@index = index + 1;
	};
	return $result;
};

fn number_decimal(const Token& token) -> bool {
	if (token.length && token.source->bytes.data[token.begin] == '\'') {
		return false;
	};
	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes.data[token.begin + index];
		if (character == '.' || character == 'e' || character == 'E') {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn decimal_integer(Compiler& compiler, const Token& token, Type* type, bool negative) -> u64 {
	char* text = memory_text(@compiler, token.source->bytes.data + token.begin, usize(token.length));
	f64 value = trunc(strtod($text, nullptr));
	if (negative) {
		@value = -value;
	};
	f64 upper = 1;
	i32 bits = type_bits((Type*)type);
	if (!type_unsigned((Type*)type) && type->kind != type_kind::kw_char) {
		@bits = bits - 1;
	};
	while (bits) {
		@upper = upper * 2;
		@bits = bits - 1;
	};
	f64 lower = 0;
	if (!type_unsigned((Type*)type) && type->kind != type_kind::kw_char) {
		@lower = -upper;
	};
	if (value != value || value < lower || value >= upper) {
		compiler_error(@compiler, token, "number literal is outside the destination range\0");
		return 0;
	};
	if (value < 0) {
		return (u64)-value;
	};
	return (u64)value;
};

fn number_truth(Compiler& compiler, const Token& token) -> u64 {
	if (token.source->bytes.data[token.begin] == '\'') {
		return integer_spelling(@compiler, token, 255) != 0;
	};

	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes.data[token.begin + index];
		if (character == 'e' || character == 'E') {
			break;
		};
		if (character >= '1' && character <= '9') {
			return 1;
		};

		@index = index + 1;
	};

	return 0;
};

fn type_resolve(Compiler& compiler, Scope* scope, TypeSyntax* syntax) -> Type* {
	@syntax = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)syntax);
	if (!syntax) {
		return (Type*)compiler.void_type;
	};
	TypeResolution* cached = @compiler.semantic.resolved_types.find((const void*)syntax, (const void*)scope);
	if (cached) {
		return (Type*)cached->type;
	};
	Type* type = nullptr;
	TypeUse* use = nullptr;
	switch (syntax->kind) {
		case type_syntax_kind::qualified:
			@type = type_qualified(@compiler, type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.element), type_qualifier::kw_const);
			@use = type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.element);
			break;
		case type_syntax_kind::name: {
			Entity* entity = name_resolve(@compiler, (Scope*)scope, (NameSyntax*)syntax->data.name);
			if (!entity || (entity->kind != entity_kind::primitive && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union && entity->kind != entity_kind::kw_enum)) {
				compiler_error(@compiler, syntax->token, "identifier does not name a type entity\0");
				return (Type*)compiler.void_type;
			};
			if (!entity_type((Entity*)entity) && entity->kind != entity_kind::primitive) {
				Type* named = type_entity(@compiler, type_kind::named, (Entity*)entity);
				if (entity->kind == entity_kind::kw_enum) {
					@entity->data.enumeration.aggregate.type = (Type*)named;
				}
				else {
					@entity->data.aggregate.type = (Type*)named;
				};
			};
			@type = entity_type((Entity*)entity);
			if (entity->kind == entity_kind::primitive) {
				@use := entity->data.primitive.type_use;
			};
			break;
		};
		case type_syntax_kind::pointer:
		case type_syntax_kind::reference: {
			type_kind kind = type_kind::pointer;
			if (syntax->kind == type_syntax_kind::reference) {
				@kind = type_kind::reference;
			};
			@type = type_indirect(@compiler, (type_kind)kind, type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.element));
			@use = type_use_element(@compiler, type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.element));
			if ((kind == type_kind::pointer && type->data.element->kind == type_kind::reference) || (kind == type_kind::reference && (type->data.element->kind == type_kind::kw_void || type->data.element->kind == type_kind::kw_null || type->data.element->kind == type_kind::reference))) {
				compiler_error(@compiler, syntax->token, "reference requires an object or function referent type\0");
			};
			break;
		};
		case type_syntax_kind::array: {
			u64 count = 0;
			if (syntax->data.array.count.kind == token_kind::identifier) {
				Syntax length;
				@length.kind = syntax_kind::expr_name;
				@length.token := syntax->data.array.count;
				@count = constant_integer(@compiler, (Scope*)scope, &length);
			}
			else {
				@count = integer_spelling(@compiler, syntax->data.array.count, (u64)18446744073709551615);
			};
			@type = type_array(@compiler, type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.array.element), $count);
			@use = type_use_element(@compiler, type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.array.element));
			if (!type->data.array.count || type->data.array.element->kind == type_kind::kw_void || type->data.array.element->kind == type_kind::kw_null || type->data.array.element->kind == type_kind::function || type->data.array.element->kind == type_kind::reference) {
				compiler_error(@compiler, syntax->token, "array requires a positive length and a storage element type\0");
			};
			break;
		};
		case type_syntax_kind::function: {
			Type* result = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.signature.result);
			if (result->kind == type_kind::kw_null) {
				compiler_error(@compiler, syntax->token, "null is an unsized type and cannot be a function result\0");
			};
			@use = (TypeUse*)memory_allocate(@compiler, sizeof(TypeUse));
			if (!use) {
				return (Type*)compiler.void_type;
			};
			@use->data.callable.result = type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax->data.signature.result);
			ParameterUse** use_tail = &use->data.callable.parameters;
			Parameter* parameters = nullptr;
			Parameter* last = nullptr;
			ParameterSyntax* input := syntax->data.signature.parameters;
			while (input) {
				Parameter* parameter = (Parameter*)memory_allocate(@compiler, sizeof(Parameter));
				@parameter->type = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)input->type);
				ParameterUse* label = (ParameterUse*)memory_allocate(@compiler, sizeof(ParameterUse));
				if (!label) {
					return (Type*)compiler.void_type;
				};
				@label->name := input->name;
				@label->use = type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)input->type);
				@*use_tail := label;
				@use_tail = &label->next;
				if (parameter->type->kind == type_kind::kw_void || parameter->type->kind == type_kind::kw_null || parameter->type->kind == type_kind::function) {
					compiler_error(@compiler, input->type->token, "parameter requires a storage type\0");
				};
				if (last) {
					@last->next := parameter;
				}
				else {
					@parameters := parameter;
				};
				@last = (Parameter*)parameter;
				@input := input->next;
			};
			@type = type_function(@compiler, $result, $parameters, (parameter_arity)syntax->data.signature.arity);
			break;
		};
		default:
			compiler_error(@compiler, syntax->token, "expected type expression\0");
			@type := compiler.void_type;
			break;
	};
	if (compiler.result == compilation_result::failure) {
		return $type;
	};
	TypeResolution* resolved = identity_record<TypeResolution>(@compiler, @compiler.semantic.resolved_types, (const void*)syntax, (const void*)scope);
	if (!resolved) {
		return (Type*)compiler.void_type;
	};
	@resolved->type := type;
	@resolved->use = $use;
	return $type;
};

fn type_use_element(Compiler& compiler, TypeUse* element) -> TypeUse* {
	if (!element) {
		return nullptr;
	};
	TypeUse* use = (TypeUse*)memory_allocate(@compiler, sizeof(TypeUse));
	if (!use) {
		return nullptr;
	};
	@use->data.element = $element;
	return $use;
};

fn type_use_resolve(Compiler& compiler, Scope* scope, TypeSyntax* syntax) -> TypeUse* {
	@syntax = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)syntax);
	if (!syntax) {
		return nullptr;
	};
	type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax);
	TypeResolution* resolved = @compiler.semantic.resolved_types.find((const void*)syntax, (const void*)scope);
	if (!resolved) {
		return nullptr;
	};
	return (TypeUse*)resolved->use;
};

const usize constant_evaluation_depth_limit = 128;
const usize constant_evaluation_step_limit = 100000;

fn constant_failure(ConstantContext& context, const char* reason) -> ConstantValue* {
	if (!context.reason) {
		@context.reason := reason;
	};
	return nullptr;
};

fn constant_value(Compiler& compiler, Type* type) -> ConstantValue* {
	ConstantValue* value = (ConstantValue*)memory_allocate(@compiler, sizeof(ConstantValue));
	if (!value) {
		return nullptr;
	};
	@value->type = type_effective($type);
	return $value;
};

fn constant_zero(Compiler& compiler, Type* type) -> ConstantValue* {
	ConstantValue* value = constant_value(@compiler, (Type*)type);
	if (!value) {
		return nullptr;
	};
	if (type->kind == type_kind::array) {
		@value->kind = constant_kind::aggregate;
		@value->count := type->data.array.count;
		@value->data.elements = (ConstantValue**)memory_allocate(@compiler, value->count * sizeof(ConstantValue*));
		if (!value->data.elements) {
			return nullptr;
		};
		usize index = 0;
		while (index < value->count) {
			@value->data.elements[index] = constant_zero(@compiler, (Type*)type->data.array.element);
			if (!value->data.elements[index]) {
				return nullptr;
			};
			@index = index + 1;
		};
	};
	if (type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_struct) {
		@value->kind = constant_kind::aggregate;
		entity_resolve(@compiler, (Entity*)type->data.entity);
		@value->count := type->data.entity->data.aggregate.field_count;
		@value->data.elements = (ConstantValue**)memory_allocate(@compiler, value->count * sizeof(ConstantValue*));
		if (!value->data.elements) {
			return nullptr;
		};
		Field* field := type->data.entity->data.aggregate.fields;
		usize index = 0;
		while (field) {
			@value->data.elements[index] = constant_zero(@compiler, (Type*)field->entity->data.variable.type);
			if (!value->data.elements[index]) {
				return nullptr;
			};
			@index = index + 1;
			@field := field->next;
		};
	};
	return $value;
};

fn constant_copy(Compiler& compiler, ConstantValue* source) -> ConstantValue* {
	if (!source) {
		return nullptr;
	};
	ConstantValue* value = constant_value(@compiler, (Type*)source->type);
	if (!value) {
		return nullptr;
	};
	@value->data := source->data;
	@value->count := source->count;
	@value->kind := source->kind;
	if (source->count) {
		@value->data.elements = (ConstantValue**)memory_allocate(@compiler, source->count * sizeof(ConstantValue*));
		if (!value->data.elements) {
			return nullptr;
		};
		usize index = 0;
		while (index < source->count) {
			@value->data.elements[index] = constant_copy(@compiler, (ConstantValue*)source->data.elements[index]);
			if (!value->data.elements[index]) {
				return nullptr;
			};
			@index = index + 1;
		};
	};
	return $value;
};

fn constant_storage_supported(ConstantContext& context, Type* type) -> bool {
	@type = type_representation((Type*)type);
	if (type->kind == type_kind::array) {
		return constant_storage_supported(@context, (Type*)type->data.array.element);
	};
	if (type->kind != type_kind::named) {
		return true;
	};
	Entity* record := type->data.entity;
	if (record->kind != entity_kind::kw_struct || record->data.aggregate.bases || aggregate_header((Entity*)record)) {
		constant_failure(@context, "this aggregate layout requires runtime construction\0");
		return false;
	};
	Field* field := record->data.aggregate.fields;
	while (field) {
		if (type_has_lifecycle_callbacks((Type*)field->entity->data.variable.type)) {
			constant_failure(@context, "member lifecycle operations require runtime execution\0");
			return false;
		};
		@field := field->next;
	};
	return true;
};

fn constant_truth(ConstantValue* value) -> bool {
	if (value->kind == constant_kind::text) {
		return true;
	};
	if (type_representation((Type*)value->type)->kind == type_kind::kw_float) {
		return value->data.real != 0;
	};
	return value->data.integer != 0;
};

fn constant_convert(ConstantContext& context, ConstantValue* source, Type* target) -> ConstantValue* {
	if (!source || !target) {
		return $source;
	};
	@target = type_effective((Type*)target);
	Type* destination := target;
	@target = type_representation((Type*)target);
	Type* source_type = type_representation((Type*)source->type);
	if (target->kind == type_kind::pointer && source_type->kind != type_kind::pointer && source->data.integer) {
		return constant_failure(@context, "non-null integer-to-pointer conversion requires runtime execution\0");
	};
	if (source_type->kind == type_kind::pointer && target->kind != type_kind::pointer && target->kind != type_kind::kw_bool && (source->kind == constant_kind::text || source->data.integer)) {
		return constant_failure(@context, "pointer-to-number conversion requires runtime execution\0");
	};
	ConstantValue* value = constant_copy(@*context.compiler, (ConstantValue*)source);
	if (!value) {
		return nullptr;
	};
	@value->type = $destination;
	if (target->kind == type_kind::kw_bool) {
		@value->data.integer = (u64)constant_truth($source);
		return $value;
	};
	if (target->kind == type_kind::kw_float) {
		if (source_type->kind != type_kind::kw_float) {
			if (type_unsigned((Type*)source_type)) {
				@value->data.real := (f64)source->data.integer;
			}
			else {
				@value->data.real := (f64)(i64)source->data.integer;
			};
		};
		if (type_bits((Type*)target) == 32) {
			if (value->data.real > 340282346638528859811704183484516925440.0 || value->data.real < -340282346638528859811704183484516925440.0) {
				return constant_failure(@context, "floating-point constant is outside the f32 range\0");
			};
			@value->data.real := (f64)(f32)value->data.real;
		};
		return $value;
	};
	if (type_integer((Type*)target)) {
		if (source_type->kind == type_kind::kw_float) {
			if (source->data.real != source->data.real || source->data.real >= 18446744073709551616.0 || source->data.real < -9223372036854775808.0) {
				return constant_failure(@context, "floating-point constant is outside the integer range\0");
			};
			if (source->data.real < 0) {
				@value->data.integer := (u64)(i64)source->data.real;
			}
			else {
				@value->data.integer := (u64)source->data.real;
			};
		};
		@value->data.integer = constant_selector((u64)value->data.integer, (Type*)target);
		i32 bits = type_bits((Type*)target);
		if (!type_unsigned((Type*)target) && bits < 64 && (value->data.integer & (u64(1) << (u64)(bits - 1)))) {
			@value->data.integer = value->data.integer | (~u64(0) << (u64)bits);
		};
	};
	return $value;
};

fn constant_bind(ConstantContext& context, Entity* entity, ConstantValue* value) {
	ConstantBinding* binding = (ConstantBinding*)memory_allocate(@*context.compiler, sizeof(ConstantBinding));
	if (!binding) {
		return;
	};
	@binding->entity = $entity;
	@binding->value = $value;
	@binding->next := context.bindings;
	@context.bindings = $binding;
};

fn constant_initializer(Entity* entity) -> Syntax* {
	if (!entity->declaration) {
		return nullptr;
	};
	Syntax* body := entity->declaration->data.declaration.body;
	if (!body || body->kind != syntax_kind::node_block || !body->data.statements || body->data.statements->next) {
		return nullptr;
	};
	Syntax* statement := body->data.statements;
	if (statement->kind != syntax_kind::stmt_initialize && statement->kind != syntax_kind::expr_binary) {
		return nullptr;
	};
	return (Syntax*)statement->data.binary.right;
};

fn constant_variable(ConstantContext& context, Entity* entity) -> ConstantValue* {
	ConstantBinding* binding := context.bindings;
	while (binding) {
		if (binding->entity == entity) {
			return (ConstantValue*)binding->value;
		};
		@binding := binding->next;
	};
	if (entity->kind != entity_kind::variable) {
		return constant_failure(@context, "constant expression requires a value\0");
	};
	if (!entity->data.variable.type && entity->declaration && entity->declaration->data.declaration.type) {
		@entity->data.variable.type = type_resolve(@*context.compiler, (Scope*)entity->scope, (TypeSyntax*)entity->declaration->data.declaration.type);
		@entity->data.variable.type_use = type_use_resolve(@*context.compiler, (Scope*)entity->scope, (TypeSyntax*)entity->declaration->data.declaration.type);
	};
	Type* type := entity->data.variable.type;
	if (entity->data.variable.evaluation && entity->data.variable.evaluation->state == constant_state::constant) {
		return (ConstantValue*)entity->data.variable.evaluation->value;
	};
	if (entity->data.variable.storage == storage_kind::constant && !entity->data.variable.evaluation) {
		if (entity->state == resolution::pending && entity->scope && entity->scope->owner && entity->scope->owner->kind == entity_kind::kw_enum) {
			entity_resolve(@*context.compiler, (Entity*)entity->scope->owner);
		};
		if (entity->data.variable.evaluation && entity->data.variable.evaluation->state == constant_state::constant) {
			return (ConstantValue*)entity->data.variable.evaluation->value;
		};
		ConstantValue* value = constant_value(@*context.compiler, (Type*)entity->data.variable.type);
		if (!value) {
			return nullptr;
		};
		@value->data.integer := entity->data.variable.data.integer;
		return $value;
	};
	if (!type || type->qualifier != type_qualifier::kw_const) {
		return constant_failure(@context, "constant expression reads a runtime or mutable value\0");
	};
	if (!entity->data.variable.evaluation) {
		@entity->data.variable.evaluation = (ConstantEvaluation*)memory_allocate(@*context.compiler, sizeof(ConstantEvaluation));
	};
	ConstantEvaluation* evaluation := entity->data.variable.evaluation;
	if (!evaluation) {
		return nullptr;
	};
	if (evaluation->state == constant_state::evaluating) {
		@evaluation->state = constant_state::invalid;
		@evaluation->reason = "circular constant initializer\0";
		return constant_failure(@context, (const char*)evaluation->reason);
	};
	if (evaluation->state == constant_state::constant) {
		return (ConstantValue*)evaluation->value;
	};
	if (evaluation->state == constant_state::runtime || evaluation->state == constant_state::invalid) {
		return constant_failure(@context, (const char*)evaluation->reason);
	};
	if (context.depth >= constant_evaluation_depth_limit) {
		return constant_failure(@context, "constant evaluation exceeded the dependency-depth limit\0");
	};
	@evaluation->state = constant_state::evaluating;
	ConstantContext child;
	@child.compiler := context.compiler;
	@child.scope := entity->scope;
	@child.steps := context.steps;
	@child.depth = context.depth + 1;
	Syntax* initializer = constant_initializer((Entity*)entity);
	if (initializer) {
		@evaluation->value = constant_expression(@child, (Syntax*)initializer, (Type*)type);
	}
	else if (!entity->declaration->data.declaration.body) {
		if (constant_storage_supported(@child, (Type*)type)) {
			@evaluation->value = constant_zero(@*context.compiler, (Type*)type);
		};
		if (entity->declaration->data.declaration.constructor) {
			if (!constant_call(@child, (Entity*)entity->declaration->data.declaration.constructor, nullptr, (ConstantValue*)evaluation->value)) {
				@evaluation->value = nullptr;
			};
		};
	}
	else {
		constant_failure(@child, "initializer does not produce a compile-time value\0");
	};
	@context.steps := child.steps;
	if (evaluation->value) {
		@evaluation->state = constant_state::constant;
		return (ConstantValue*)evaluation->value;
	};
	@evaluation->reason := child.reason;
	if (!evaluation->reason) {
		@evaluation->reason = "initializer is not a constant expression\0";
	};
	if (evaluation->state != constant_state::invalid) {
		@evaluation->state = constant_state::runtime;
	};
	return constant_failure(@context, (const char*)evaluation->reason);
};

fn constant_lvalue(ConstantContext& context, Syntax* syntax) -> ConstantValue* {
	if (syntax->kind == syntax_kind::expr_access || syntax->kind == syntax_kind::expr_relocate || syntax->kind == syntax_kind::expr_borrowed_component) {
		return constant_lvalue(@context, (Syntax*)syntax->data.expression);
	};
	if (syntax->kind == syntax_kind::expr_name) {
		Entity* entity := syntax->entity;
		if (!entity) {
			@entity = syntax_lookup((Scope*)context.scope, (Syntax*)syntax);
		};
		if (!entity) {
			return constant_failure(@context, "unknown identifier in constant expression\0");
		};
		return constant_variable(@context, $entity);
	};
	if (syntax->kind == syntax_kind::expr_member) {
		ConstantValue* object = constant_lvalue(@context, (Syntax*)syntax->data.member.object);
		if (!object) {
			return nullptr;
		};
		Entity* field := syntax->entity;
		if (!field) {
			@field = scope_lookup(entity_members((Entity*)object->type->data.entity), syntax->data.member.name);
		};
		if (!field || field->kind != entity_kind::variable || field->data.variable.storage != storage_kind::field || field->data.variable.data.field.index >= object->count) {
			return constant_failure(@context, "constant member has no storage\0");
		};
		return (ConstantValue*)object->data.elements[field->data.variable.data.field.index];
	};
	if (syntax->kind == syntax_kind::expr_index) {
		ConstantValue* object = constant_lvalue(@context, (Syntax*)syntax->data.binary.left);
		ConstantValue* index = constant_expression(@context, (Syntax*)syntax->data.binary.right, (Type*)context.compiler->usize_type);
		if (!object || !index) {
			return nullptr;
		};
		if (index->data.integer >= object->count) {
			return constant_failure(@context, "constant array index is outside its bounds\0");
		};
		return (ConstantValue*)object->data.elements[index->data.integer];
	};
	return constant_failure(@context, "constant expression requires local storage\0");
};

fn constant_call(ConstantContext& context, Entity* function, Syntax* arguments, ConstantValue* receiver) -> ConstantValue* {
	if (!function || function->kind != entity_kind::function) {
		return constant_failure(@context, "indirect calls cannot be evaluated during compilation\0");
	};
	entity_resolve(@*context.compiler, (Entity*)function);
	if (!function->data.function.body) {
		return constant_failure(@context, "external function calls cannot be evaluated during compilation\0");
	};
	if (context.depth >= constant_evaluation_depth_limit) {
		return constant_failure(@context, "constant evaluation exceeded the call-depth limit\0");
	};
	function_request((Entity*)function);
	if (function->data.function.analysis == function_analysis::requested) {
		semantic_function(@*context.compiler, (Entity*)function);
	};
	ConstantContext child;
	@child.compiler := context.compiler;
	@child.scope := function->data.function.scope;
	@child.steps := context.steps;
	@child.depth = context.depth + 1;
	ParameterBinding* parameter := function->data.function.parameter_bindings;
	if (receiver && parameter) {
		constant_bind(@child, (Entity*)parameter->entity, (ConstantValue*)receiver);
		@parameter := parameter->next;
	};
	while (parameter && arguments) {
		Type* type = entity_type((Entity*)parameter->entity);
		if (type->kind != type_kind::reference && type_requires_destruction((Type*)type)) {
			return constant_failure(@context, "owned parameter destruction requires runtime execution\0");
		};
		ConstantValue* value = nullptr;
		if (type->kind == type_kind::reference) {
			@value = constant_lvalue(@context, (Syntax*)arguments);
		}
		else {
			@value = constant_expression(@context, (Syntax*)arguments, (Type*)type);
			@value = constant_copy(@*context.compiler, (ConstantValue*)value);
		};
		if (!value) {
			return nullptr;
		};
		constant_bind(@child, (Entity*)parameter->entity, $value);
		@arguments := arguments->next;
		@parameter := parameter->next;
	};
	if (parameter || arguments) {
		return constant_failure(@context, "constant call has an incompatible argument list\0");
	};
	constant_region(@child, (Syntax*)function->data.function.body);
	@context.steps := child.steps;
	if (child.reason) {
		return constant_failure(@context, (const char*)child.reason);
	};
	if (child.result) {
		return constant_convert(@context, (ConstantValue*)child.result, (Type*)function->data.function.type->data.function.result);
	};
	if (function->data.function.type->data.function.result->kind == type_kind::kw_void) {
		return constant_value(@*context.compiler, (Type*)context.compiler->void_type);
	};
	return constant_failure(@context, "constant function finished without returning a value\0");
};

fn constant_expression(ConstantContext& context, Syntax* syntax, Type* expected) -> ConstantValue* {
	if (!syntax || context.reason || context.compiler->result == compilation_result::failure) {
		return nullptr;
	};
	@context.steps = context.steps + 1;
	if (context.steps > constant_evaluation_step_limit) {
		return constant_failure(@context, "constant evaluation exceeded the execution-step limit\0");
	};
	Compiler& compiler = @*context.compiler;
	if (syntax->kind == syntax_kind::expr_typed_apply) {
		construction_resolve(@compiler, (Scope*)context.scope, (Syntax*)syntax);
		if (compiler.result == compilation_result::failure) {
			return nullptr;
		};
	};
	Type* type := syntax->type;
	if (!type) {
		@type := expected;
	};
	if (!type) {
		@type = entity_type(scope_lookup((Scope*)compiler.module, token_synthetic(@compiler, Token(syntax->token), "i64\0")));
	};
	switch (syntax->kind) {
		case syntax_kind::literal_number: {
			ConstantValue* value = constant_value(@compiler, (Type*)type);
			if (!value) {
				return nullptr;
			};
			if (syntax->token.source->bytes.data[syntax->token.begin] == '\'') {
				@value->type := compiler.char_type;
				@value->data.integer = integer_spelling(@compiler, syntax->token, 255);
			}
			else if (number_decimal(syntax->token) || type->kind == type_kind::kw_float) {
				char* text = memory_text(@compiler, syntax->token.source->bytes.data + syntax->token.begin, (usize)syntax->token.length);
				@value->data.real = strtod($text, nullptr);
				@value->type = entity_type(scope_lookup((Scope*)compiler.module, token_synthetic(@compiler, Token(syntax->token), "f64\0")));
			}
			else if (type->kind == type_kind::kw_bool) {
				@value->data.integer = number_truth(@compiler, syntax->token);
			}
			else {
				@value->data.integer = integer_spelling(@compiler, syntax->token, ~u64(0));
			};
			return constant_convert(@context, $value, (Type*)expected);
		};
		case syntax_kind::literal_string: {
			ConstantValue* value = constant_value(@compiler, (Type*)type);
			if (!value) {
				return nullptr;
			};
			@value->kind = constant_kind::text;
			@value->data.text := syntax->data.string;
			return $value;
		};
		case syntax_kind::kw_nullptr: {
			return constant_value(@compiler, (Type*)type);
		};
		case syntax_kind::expr_name:
		case syntax_kind::expr_member:
		case syntax_kind::expr_index:
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
		case syntax_kind::expr_borrowed_component:
			return constant_convert(@context, constant_lvalue(@context, (Syntax*)syntax), (Type*)expected);
		case syntax_kind::expr_cast: {
			Type* target := syntax->data.cast.resolved;
			if (!target) {
				@target = type_resolve(@compiler, (Scope*)context.scope, (TypeSyntax*)syntax->data.cast.type);
			};
			return constant_convert(@context, constant_expression(@context, (Syntax*)syntax->data.cast.value, (Type*)target), (Type*)target);
		};
		case syntax_kind::expr_construct: {
			Type* target := syntax->data.construction.target;
			if (!constant_storage_supported(@context, (Type*)target)) {
				return nullptr;
			};
			if (type_requires_destruction((Type*)target)) {
				return constant_failure(@context, "temporary destruction requires runtime execution\0");
			};
			Syntax* arguments := syntax->data.construction.arguments;
			if (!type_aggregate((Type*)target)) {
				if (arguments) {
					return constant_convert(@context, constant_expression(@context, (Syntax*)arguments, (Type*)target), (Type*)target);
				};
				return constant_zero(@compiler, (Type*)target);
			};
			ConstantValue* object = constant_zero(@compiler, (Type*)target);
			if (syntax->data.construction.constructor) {
				if (!constant_call(@context, (Entity*)syntax->data.construction.constructor, (Syntax*)arguments, (ConstantValue*)object)) {
					return nullptr;
				};
			}
			else if (arguments) {
				@object = constant_copy(@compiler, constant_expression(@context, (Syntax*)arguments, (Type*)target));
			};
			return $object;
		};
		case syntax_kind::expr_call: {
			Entity* function := syntax->data.call.callable->entity;
			if (!function) {
				@function = syntax_lookup((Scope*)context.scope, (Syntax*)syntax->data.call.callable);
			};
			ConstantValue* receiver = nullptr;
			if (syntax->data.call.receiver.kind == receiver_kind::bind) {
				@receiver = constant_lvalue(@context, (Syntax*)syntax->data.call.receiver.value);
			};
			return constant_convert(@context, constant_call(@context, $function, (Syntax*)syntax->data.call.arguments, $receiver), (Type*)expected);
		};
		case syntax_kind::expr_unary: {
			ConstantValue* value = constant_copy(@compiler, constant_expression(@context, (Syntax*)syntax->data.unary.value, (Type*)type));
			if (!value) {
				return nullptr;
			};
			switch (syntax->data.unary.operation) {
				case token_kind::op_plus:
					break;
				case token_kind::op_minus:
					if (value->type->kind == type_kind::kw_float) {
						@value->data.real = -value->data.real;
					}
					else {
						@value->data.integer = u64(0) - value->data.integer;
					};
					break;
				case token_kind::op_bang:
					@value->data.integer = (u64)!constant_truth((ConstantValue*)value);
					@value->type := compiler.bool_type;
					break;
				case token_kind::op_tilde:
					@value->data.integer = ~value->data.integer;
					break;
				default:
					return constant_failure(@context, "pointer operations require runtime storage\0");
			};
			return constant_convert(@context, $value, (Type*)expected);
		};
		case syntax_kind::stmt_bind_reference: {
			Syntax* name := syntax->data.binary.left;
			while (name->kind == syntax_kind::expr_access) {
				@name := name->data.expression;
			};
			if (!name->entity) {
				return constant_failure(@context, "constant reference requires a local binding\0");
			};
			ConstantValue* value = constant_lvalue(@context, (Syntax*)syntax->data.binary.right);
			constant_bind(@context, (Entity*)name->entity, (ConstantValue*)value);
			return $value;
		};
		case syntax_kind::stmt_initialize:
		case syntax_kind::expr_binary: {
			if (syntax->entity && syntax->entity->kind == entity_kind::function) {
				return constant_failure(@context, "assignment operator calls require runtime execution\0");
			};
			token_kind operation := syntax->data.binary.operation;
			if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
				ConstantValue* destination = constant_lvalue(@context, (Syntax*)syntax->data.binary.left);
				if (!destination) {
					return nullptr;
				};
				ConstantValue* source = constant_expression(@context, (Syntax*)syntax->data.binary.right, (Type*)destination->type);
				if (!source) {
					return nullptr;
				};
				@*destination := *constant_copy(@compiler, $source);
				return $destination;
			};
			Type* operand_type := syntax->data.binary.left->type;
			if (!operand_type) {
				@operand_type := type;
			};
			ConstantValue* first = constant_expression(@context, (Syntax*)syntax->data.binary.left, (Type*)operand_type);
			if (!first) {
				return nullptr;
			};
			if (type_representation((Type*)first->type)->kind == type_kind::pointer) {
				return constant_failure(@context, "pointer operations require runtime storage\0");
			};
			if ((operation == token_kind::op_and && !constant_truth((ConstantValue*)first)) || (operation == token_kind::op_or && constant_truth((ConstantValue*)first))) {
				ConstantValue* value = constant_value(@compiler, (Type*)compiler.bool_type);
				if (!value) {
					return nullptr;
				};
				@value->data.integer = (u64)(operation == token_kind::op_or);
				return $value;
			};
			ConstantValue* second = constant_expression(@context, (Syntax*)syntax->data.binary.right, (Type*)first->type);
			if (!second) {
				return nullptr;
			};
			ConstantValue* value = constant_value(@compiler, (Type*)type);
			if (!value) {
				return nullptr;
			};
			if (first->type->kind == type_kind::kw_float) {
				f64 a := first->data.real;
				f64 b := second->data.real;
				switch (operation) {
					case token_kind::op_plus:
						@value->data.real = a + b;
						break;
					case token_kind::op_minus:
						@value->data.real = a - b;
						break;
					case token_kind::op_star:
						@value->data.real = a * b;
						break;
					case token_kind::op_slash:
						if (!b) {
							return constant_failure(@context, "division by zero in constant expression\0");
						};
						@value->data.real = a / b; break;
					case token_kind::op_equal:
						@value->data.integer = (u64)(a == b);
						break;
					case token_kind::op_not_equal:
						@value->data.integer = (u64)(a != b);
						break;
					case token_kind::op_less:
						@value->data.integer = (u64)(a < b);
						break;
					case token_kind::op_greater:
						@value->data.integer = (u64)(a > b);
						break;
					case token_kind::op_less_equal:
						@value->data.integer = (u64)(a <= b);
						break;
					case token_kind::op_greater_equal:
						@value->data.integer = (u64)(a >= b);
						break;
					default:
						return constant_failure(@context, "unsupported floating-point constant operation\0");
				};
				return constant_convert(@context, $value, (Type*)expected);
			};
			u64 a := first->data.integer;
			u64 b := second->data.integer;
			if ((operation == token_kind::op_slash || operation == token_kind::op_remainder) && (!b || (!type_unsigned((Type*)first->type) && a == (u64)9223372036854775808 && b == ~u64(0)))) {
				return constant_failure(@context, "invalid division in constant expression\0");
			};
			if ((operation == token_kind::op_shift_left || operation == token_kind::op_shift_right) && b >= (u64)type_bits((Type*)first->type)) {
				return constant_failure(@context, "constant shift count is outside the integer width\0");
			};
			bool unsigned_ = (bool)type_unsigned((Type*)first->type);
			switch (operation) {
				case token_kind::op_plus:
					@value->data.integer = a + b;
					break;
				case token_kind::op_minus:
					@value->data.integer = a - b;
					break;
				case token_kind::op_star:
					@value->data.integer = a * b;
					break;
				case token_kind::op_ampersand:
					@value->data.integer = a & b;
					break;
				case token_kind::op_pipe:
					@value->data.integer = a | b;
					break;
				case token_kind::op_caret:
					@value->data.integer = a ^ b;
					break;
				case token_kind::op_shift_left:
					@value->data.integer = a << b;
					break;
				case token_kind::op_shift_right:
					if (unsigned_) {
						@value->data.integer = a >> b;
					}
					else {
						@value->data.integer = (u64)((i64)a >> (i64)b);
					};
					break;
				case token_kind::op_slash:
					if (unsigned_) {
						@value->data.integer = a / b;
					}
					else {
						@value->data.integer = (u64)((i64)a / (i64)b);
					};
					break;
				case token_kind::op_remainder:
					if (unsigned_) {
						@value->data.integer = a % b;
					}
					else {
						@value->data.integer = (u64)((i64)a % (i64)b);
					};
					break;
				case token_kind::op_equal:
					@value->data.integer = (u64)(a == b);
					break;
				case token_kind::op_not_equal:
					@value->data.integer = (u64)(a != b);
					break;
				case token_kind::op_less:
					if (unsigned_) {
						@value->data.integer = (u64)(a < b);
					}
					else {
						@value->data.integer = (u64)((i64)a < (i64)b);
					};
					break;
				case token_kind::op_greater:
					if (unsigned_) {
						@value->data.integer = (u64)(a > b);
					}
					else {
						@value->data.integer = (u64)((i64)a > (i64)b);
					};
					break;
				case token_kind::op_less_equal:
					if (unsigned_) {
						@value->data.integer = (u64)(a <= b);
					}
					else {
						@value->data.integer = (u64)((i64)a <= (i64)b);
					};
					break;
				case token_kind::op_greater_equal:
				if (unsigned_) {
					@value->data.integer = (u64)(a >= b);
				}
					else {
						@value->data.integer = (u64)((i64)a >= (i64)b);
					};
					break;
				case token_kind::op_and:
					@value->data.integer = (u64)(constant_truth((ConstantValue*)first) && constant_truth((ConstantValue*)second));
					break;
				case token_kind::op_or:
					@value->data.integer = (u64)(constant_truth((ConstantValue*)first) || constant_truth((ConstantValue*)second));
					break;
				default:
					return constant_failure(@context, "unsupported integer constant operation\0");
			};
			@value = constant_convert(@context, (ConstantValue*)value, (Type*)type);
			return constant_convert(@context, $value, (Type*)expected);
		};
		case syntax_kind::kw_sizeof: {
			ConstantValue* value = constant_value(@compiler, (Type*)compiler.usize_type);
			if (!value) {
				return nullptr;
			};
			Type* measured := syntax->data.sizeof_operand.measured;
			if (!measured) {
				@measured = type_resolve(@compiler, (Scope*)context.scope, (TypeSyntax*)syntax->data.sizeof_operand.type);
			};
			@value->data.integer = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, $measured));
			return $value;
		};
		default:
			return constant_failure(@context, "expression requires runtime execution\0");
	};
};

// MODULE: EXECUTABLE CONTROL FLOW
// FUTURE FILE: mir/control.rt
// PURPOSE: Resolve structured statements to shared executable blocks and edges.
// DEPENDS ON: typed HIR, semantic arena, constant case values.

enum mir_kind : [i32] {
	tick;
	evaluate;
	declare;
	branch;
	dispatch;
	jump;
	kw_return;
	exit;
};

enum mir_edge_kind : [i32] {
	ordinary;
	when_true;
	when_false;
	case_value;
	otherwise;
	backedge;
};

struct MirScope {
	MirScope* parent;
	Scope* bindings;
};

struct MirEdge {
	MirBlock* target;
	MirScope* retained_scope;
	MirEdge* next;
	LifetimeCleanup* cleanup;
	Token token;
	u64 selector;
	mir_edge_kind kind;
};

struct MirBlock {
	Syntax* value;
	MirScope* scope;
	MirEdge* edges;
	MirBlock* next;
	Token token;
	usize ticks;
	mir_kind kind;
};

struct MirRegion {
	MirBlock* entry;
	MirBlock* blocks;
	MirScope* scope;
	MirScope* parent;
	resolution state;
};

struct MirControl {
	MirBlock* breaking;
	MirBlock* continuing;
};

struct MirSource {
	Syntax* value;
	MirSource* next;
};

struct MirBuilder {
	Compiler* compiler;
	MirRegion* region;
};

fn mir_scope(Compiler& compiler, MirScope* parent, Scope* bindings) -> MirScope* {
	MirScope* scope = (MirScope*)memory_allocate(@compiler, sizeof(MirScope));
	if (scope) {
		@scope->parent = (MirScope*)parent;
		@scope->bindings = (Scope*)bindings;
	};
	return (MirScope*)scope;
};

fn mir_scope_contains(MirScope* scope, MirScope* nested) -> bool {
	while (nested && nested != scope) {
		@nested := nested->parent;
	};
	return nested == scope;
};

fn MirBuilder::block(MirBuilder& this, mir_kind kind, Syntax* value, MirScope* scope, const Token& token, usize ticks) -> MirBlock* {
	MirBlock* block = (MirBlock*)memory_allocate(@*this.compiler, sizeof(MirBlock));
	if (!block) {
		return nullptr;
	};
	@block->kind = (mir_kind)kind;
	@block->value = (Syntax*)value;
	@block->scope = (MirScope*)scope;
	@block->token := token;
	@block->ticks = (usize)ticks;
	@block->next := this.region->blocks;
	@this.region->blocks = (MirBlock*)block;
	return (MirBlock*)block;
};

fn MirBuilder::edge(MirBuilder& this, MirBlock* source, MirBlock* target, mir_edge_kind kind, const Token& token) -> MirEdge* {
	if (!source) {
		return nullptr;
	};
	MirEdge* edge = (MirEdge*)memory_allocate(@*this.compiler, sizeof(MirEdge));
	if (!edge) {
		return nullptr;
	};
	@edge->target = (MirBlock*)target;
	@edge->kind = (mir_edge_kind)kind;
	@edge->token := token;
	MirScope* retained = nullptr;
	if (target) {
		@retained := source->scope;
		while (retained && !mir_scope_contains((MirScope*)retained, (MirScope*)target->scope)) {
			@retained := retained->parent;
		};
	};
	@edge->retained_scope = (MirScope*)retained;
	@edge->next := source->edges;
	@source->edges = (MirEdge*)edge;
	return (MirEdge*)edge;
};

fn mir_reverse(Compiler& compiler, Syntax* statements) -> MirSource* {
	MirSource* reversed = nullptr;
	while (statements && compiler.result != compilation_result::failure) {
		MirSource* source = (MirSource*)memory_allocate(@compiler, sizeof(MirSource));
		if (!source) {
			return nullptr;
		};
		@source->value := statements;
		@source->next := reversed;
		@reversed := source;
		@statements := statements->next;
	};
	return (MirSource*)reversed;
};

fn MirBuilder::sequence(MirBuilder& this, Syntax* statements, MirScope* scope, MirBlock* next, const MirControl& control) -> MirBlock* {
	MirSource* reversed = mir_reverse(@*this.compiler, (Syntax*)statements);
	while (reversed && this.compiler->result != compilation_result::failure) {
		@next = @this.statement((Syntax*)reversed->value, (MirScope*)scope, (MirBlock*)next, control);
		@reversed := reversed->next;
	};
	return (MirBlock*)next;
};

fn MirBuilder::nested(MirBuilder& this, Syntax* syntax, MirScope* scope, MirBlock* next, const MirControl& control) -> MirBlock* {
	if (syntax && syntax->kind != syntax_kind::node_block) {
		@scope = mir_scope(@*this.compiler, (MirScope*)scope, nullptr);
	};
	return @this.statement((Syntax*)syntax, (MirScope*)scope, (MirBlock*)next, control);
};

fn MirBuilder::statement(MirBuilder& this, Syntax* syntax, MirScope* scope, MirBlock* next, const MirControl& control) -> MirBlock* {
	if (!syntax || this.compiler->result == compilation_result::failure) {
		return (MirBlock*)next;
	};
	MirBlock* block = nullptr;
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			MirScope* inner = mir_scope(@*this.compiler, (MirScope*)scope, (Scope*)syntax->scope);
			MirBlock* body = @this.sequence((Syntax*)syntax->data.statements, (MirScope*)inner, (MirBlock*)next, control);
			@block = @this.block(mir_kind::tick, nullptr, (MirScope*)inner, syntax->token, 1);
			@this.edge((MirBlock*)block, (MirBlock*)body, mir_edge_kind::ordinary, syntax->token);
			return (MirBlock*)block;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind != entity_kind::variable) {
				@block = @this.block(mir_kind::tick, nullptr, (MirScope*)scope, syntax->token, 1);
				break;
			};
			@next = @this.statement((Syntax*)syntax->data.declaration.body, (MirScope*)scope, (MirBlock*)next, control);
			@block = @this.block(mir_kind::declare, (Syntax*)syntax, (MirScope*)scope, syntax->token, 1);
			break;
		case syntax_kind::kw_return:
			@block = @this.block(mir_kind::kw_return, (Syntax*)syntax->data.expression, (MirScope*)scope, syntax->token, 1);
			@this.edge((MirBlock*)block, nullptr, mir_edge_kind::ordinary, syntax->token);
			return (MirBlock*)block;
		case syntax_kind::kw_break:
		case syntax_kind::kw_continue:
			if ((syntax->kind == syntax_kind::kw_break && !control.breaking) || (syntax->kind == syntax_kind::kw_continue && !control.continuing)) {
				compiler_error(@*this.compiler, syntax->token, "flow statement has no enclosing executable target\0");
				return nullptr;
			};
			@block = @this.block(mir_kind::jump, nullptr, (MirScope*)scope, syntax->token, 1);
			if (syntax->kind == syntax_kind::kw_break) {
				@this.edge((MirBlock*)block, (MirBlock*)control.breaking, mir_edge_kind::ordinary, syntax->token);
			}
			else {
				@this.edge((MirBlock*)block, (MirBlock*)control.continuing, mir_edge_kind::ordinary, syntax->token);
			};
			return (MirBlock*)block;
		case syntax_kind::kw_if: {
			@block = @this.block(mir_kind::branch, (Syntax*)syntax->data.branch.condition, (MirScope*)scope, syntax->token, 1);
			MirBlock* first = @this.nested((Syntax*)syntax->data.branch.first, (MirScope*)scope, (MirBlock*)next, control);
			MirBlock* second = @this.nested((Syntax*)syntax->data.branch.second, (MirScope*)scope, (MirBlock*)next, control);
			@this.edge((MirBlock*)block, (MirBlock*)first, mir_edge_kind::when_true, syntax->token);
			@this.edge((MirBlock*)block, (MirBlock*)second, mir_edge_kind::when_false, syntax->token);
			return (MirBlock*)block;
		};
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			MirScope* inner = mir_scope(@*this.compiler, (MirScope*)scope, (Scope*)syntax->scope);
			MirBlock* header = @this.block(mir_kind::branch, (Syntax*)syntax->data.loop.condition, (MirScope*)inner, syntax->token, 0);
			mir_kind kind = mir_kind::jump;
			if (syntax->data.loop.step) {
				@kind = mir_kind::evaluate;
			};
			MirBlock* step = @this.block((mir_kind)kind, (Syntax*)syntax->data.loop.step, (MirScope*)inner, syntax->token, (usize)(syntax->data.loop.step != nullptr));
			@this.edge((MirBlock*)step, (MirBlock*)header, mir_edge_kind::backedge, syntax->token);
			MirControl loop;
			@loop.breaking = (MirBlock*)next;
			@loop.continuing = (MirBlock*)step;
			MirBlock* body = @this.nested((Syntax*)syntax->data.loop.body, (MirScope*)inner, (MirBlock*)step, loop);
			@this.edge((MirBlock*)header, (MirBlock*)body, mir_edge_kind::when_true, syntax->token);
			@this.edge((MirBlock*)header, (MirBlock*)next, mir_edge_kind::when_false, syntax->token);
			MirBlock* initialization = @this.statement((Syntax*)syntax->data.loop.initializer, (MirScope*)inner, (MirBlock*)header, control);
			@block = @this.block(mir_kind::tick, nullptr, (MirScope*)inner, syntax->token, 1);
			@this.edge((MirBlock*)block, (MirBlock*)initialization, mir_edge_kind::ordinary, syntax->token);
			return (MirBlock*)block;
		};
		case syntax_kind::kw_switch: {
			@block = @this.block(mir_kind::dispatch, (Syntax*)syntax->data.selection.value, (MirScope*)scope, syntax->token, 1);
			MirScope* inner = mir_scope(@*this.compiler, (MirScope*)scope, (Scope*)syntax->data.selection.cases->scope);
			MirControl selection := control;
			@selection.breaking = (MirBlock*)next;
			MirSource* reversed = mir_reverse(@*this.compiler, (Syntax*)syntax->data.selection.cases->data.statements);
			MirBlock* body = (MirBlock*)next;
			MirEdge* fallback = nullptr;
			while (reversed && this.compiler->result != compilation_result::failure) {
				Syntax* statement := reversed->value;
				if (statement->kind == syntax_kind::kw_case) {
					MirBlock* label = @this.block(mir_kind::jump, nullptr, (MirScope*)inner, statement->token, 0);
					@this.edge((MirBlock*)label, (MirBlock*)body, mir_edge_kind::ordinary, statement->token);
					mir_edge_kind kind = mir_edge_kind::otherwise;
					if (statement->data.selection_case.value) {
						@kind = mir_edge_kind::case_value;
					};
					MirEdge* edge = @this.edge((MirBlock*)block, (MirBlock*)label, (mir_edge_kind)kind, statement->token);
					if (edge && statement->data.selection_case.value) {
						@edge->selector := statement->data.selection_case.selector;
					}
					else {
						@fallback = (MirEdge*)edge;
					};
					@body = (MirBlock*)label;
				}
				else {
					@body = @this.statement((Syntax*)statement, (MirScope*)inner, (MirBlock*)body, selection);
				};
				@reversed := reversed->next;
			};
			if (!fallback) {
				@this.edge((MirBlock*)block, (MirBlock*)next, mir_edge_kind::otherwise, syntax->token);
			};
			return (MirBlock*)block;
		};
		case syntax_kind::kw_case:
			@block = @this.block(mir_kind::tick, nullptr, (MirScope*)scope, syntax->token, 1);
			break;
		default:
			@block = @this.block(mir_kind::evaluate, (Syntax*)syntax, (MirScope*)scope, syntax->token, 1);
			break;
	};
	@this.edge((MirBlock*)block, (MirBlock*)next, mir_edge_kind::ordinary, syntax->token);
	return (MirBlock*)block;
};

fn mir_region(Compiler& compiler, Syntax* syntax, MirScope* parent) -> MirRegion* {
	if (!syntax || compiler.result == compilation_result::failure) {
		return nullptr;
	};
	MirRegion* region = identity_record<MirRegion>(@compiler, @compiler.semantic.regions, (const void*)syntax, (const void*)parent);
	if (!region || region->state == resolution::ready) {
		return (MirRegion*)region;
	};
	if (region->state == resolution::active) {
		compiler_error(@compiler, syntax->token, "recursive executable region construction\0");
		return nullptr;
	};
	@region->state = resolution::active;
	@region->parent = (MirScope*)parent;
	@region->scope = mir_scope(@compiler, (MirScope*)parent, nullptr);
	MirBuilder builder;
	@builder.compiler = &compiler;
	@builder.region = (MirRegion*)region;
	MirBlock* exit = @builder.block(mir_kind::exit, nullptr, (MirScope*)parent, syntax->token, 0);
	MirControl control;
	@region->entry = @builder.statement((Syntax*)syntax, (MirScope*)region->scope, (MirBlock*)exit, control);
	@region->state = resolution::ready;
	return (MirRegion*)region;
};

fn constant_declare(ConstantContext& context, Syntax* syntax) {
	Entity* variable := syntax->entity;
	Type* type := variable->data.variable.type;
	if (!type && syntax->data.declaration.type) {
		@type = type_resolve(@*context.compiler, (Scope*)context.scope, (TypeSyntax*)syntax->data.declaration.type);
	};
	if (!type) {
		constant_failure(@context, "constant local requires a resolved type\0");
		return;
	};
	if (type_requires_destruction((Type*)type)) {
		constant_failure(@context, "local destruction requires runtime execution\0");
		return;
	};
	if (!constant_storage_supported(@context, type_effective((Type*)type))) {
		return;
	};
	ConstantValue* value = constant_zero(@*context.compiler, type_effective((Type*)type));
	constant_bind(@context, (Entity*)variable, (ConstantValue*)value);
	if (!syntax->data.declaration.body && syntax->data.declaration.constructor) {
		constant_call(@context, (Entity*)syntax->data.declaration.constructor, nullptr, (ConstantValue*)value);
	};
};

fn constant_region(ConstantContext& context, Syntax* syntax) {
	if (!syntax || context.reason || context.compiler->result == compilation_result::failure) {
		return;
	};
	MirRegion* region = mir_region(@*context.compiler, (Syntax*)syntax, (MirScope*)context.mir_scope);
	if (!region) {
		return;
	};
	Scope* outer := context.scope;
	MirScope* outer_mir := context.mir_scope;
	MirBlock* block := region->entry;
	while (block && !context.reason && context.compiler->result == compilation_result::success) {
		@context.steps = context.steps + block->ticks;
		if (context.steps > constant_evaluation_step_limit) {
			constant_failure(@context, "constant evaluation exceeded the execution-step limit\0");
			break;
		};
		@context.mir_scope := block->scope;
		MirScope* scope := block->scope;
		while (scope && !scope->bindings) {
			@scope := scope->parent;
		};
		@context.scope := outer;
		if (scope) {
			@context.scope := scope->bindings;
		};
		if (block->kind == mir_kind::exit) {
			break;
		};
		if (block->kind == mir_kind::dispatch) {
			constant_failure(@context, "expression requires runtime execution\0");
			break;
		};
		if (block->kind == mir_kind::declare) {
			constant_declare(@context, (Syntax*)block->value);
		}
		else if (block->kind == mir_kind::kw_return) {
			if (block->value) {
				@context.result = constant_expression(@context, (Syntax*)block->value, nullptr);
			};
			break;
		}
		else if (block->kind == mir_kind::evaluate && block->value->kind != syntax_kind::kw_discard) {
			constant_expression(@context, (Syntax*)block->value, nullptr);
		};
		MirEdge* edge := block->edges;
		if (block->kind == mir_kind::branch) {
			i32 truth = 1;
			if (block->value) {
				ConstantValue* value = constant_expression(@context, (Syntax*)block->value, nullptr);
				if (!value) {
					break;
				};
				@truth = (i32)constant_truth((ConstantValue*)value);
			};
			while (edge && ((edge->kind == mir_edge_kind::when_true) != !!truth)) {
				@edge := edge->next;
			};
		};
		@block = nullptr;
		if (edge) {
			@block := edge->target;
		};
	};
	@context.scope = (Scope*)outer;
	@context.mir_scope = (MirScope*)outer_mir;
};

fn constant_llvm(Compiler& compiler, ConstantValue* value) -> LLVMOpaqueValue* {
	if (!value || compiler.result == compilation_result::failure) {
		return nullptr;
	};
	LLVMOpaqueType* type = llvm_type(@compiler, (Type*)value->type);
	Type* representation = type_representation((Type*)value->type);
	if (value->kind == constant_kind::text) {
		LLVMOpaqueValue* text = LLVMConstStringInContext2(compiler.backend.llvm_context.get(), const char*(value->data.text.data), usize(value->data.text.size), 1);
		LLVMOpaqueValue* global = LLVMAddGlobal(compiler.backend.llvm_module.get(), LLVMTypeOf(LLVMOpaqueValue*(text)), "constant.string\0");
		LLVMSetInitializer(LLVMOpaqueValue*(global), $text);
		LLVMSetGlobalConstant(LLVMOpaqueValue*(global), 1);
		LLVMSetLinkage(LLVMOpaqueValue*(global), 9);
		return $global;
	};
	if (representation->kind == type_kind::kw_float) {
		return LLVMConstReal($type, (f64)value->data.real);
	};
	if (representation->kind == type_kind::pointer) {
		return LLVMConstNull($type);
	};
	if (value->kind == constant_kind::aggregate) {
		LLVMOpaqueValue** elements = (LLVMOpaqueValue**)memory_allocate(@compiler, value->count * sizeof(LLVMOpaqueValue*));
		if (!elements) {
			return nullptr;
		};
		usize index = 0;
		while (index < value->count) {
			@elements[index] = constant_llvm(@compiler, (ConstantValue*)value->data.elements[index]);
			if (!elements[index]) {
				return nullptr;
			};
			@index = index + 1;
		};
		if (representation->kind == type_kind::array) {
			return LLVMConstArray2(llvm_type(@compiler, (Type*)representation->data.array.element), $elements, (u64)value->count);
		};
		return LLVMConstNamedStruct($type, $elements, (u32)value->count);
	};
	return LLVMConstInt($type, (u64)value->data.integer, 0);
};

fn constant_integer(Compiler& compiler, Scope* scope, Syntax* syntax) -> u64 {
	ConstantContext context;
	@context.compiler = &compiler;
	@context.scope = $scope;
	ConstantValue* value = constant_expression(@context, (Syntax*)syntax, nullptr);
	if (!value || !type_integer(type_representation((Type*)value->type))) {
		const char* reason = "expected an integer constant expression\0";
		if (context.reason) {
			@reason := context.reason;
		};
		compiler_error(@compiler, syntax->token, $reason);
		return 0;
	};
	return (u64)value->data.integer;
};

fn constant_selector(u64 value, Type* type) -> u64 {
	i32 bits = type_bits($type);
	if (bits >= 64) {
		return $value;
	};

	u64 maximum = 18446744073709551615;
	u64 shift = (u64)(64 - bits);
	return value & (maximum >> shift);
};

fn Semantic::selection_validate(Semantic& this, Syntax* syntax, Type* type) {
	Syntax* statement := syntax->data.selection.cases->data.statements;
	CaseValue* values = nullptr;
	Syntax* fallback = nullptr;
	while (statement && this.compiler->result != compilation_result::failure) {
		if (statement->kind != syntax_kind::kw_case) {
			@statement := statement->next;
			continue;
		};

		Syntax* expression := statement->data.selection_case.value;
		if (!expression) {
			if (fallback) {
				compiler_error(@*this.compiler, statement->token, "duplicate default label\0");
				return;
			};
			@fallback := statement;
			@statement := statement->next;
			continue;
		};

		@expression->type := type;
		@expression->scope := syntax->data.selection.cases->scope;
		u64 value = constant_integer(@*this.compiler, (Scope*)expression->scope, $expression);
		@value = constant_selector((u64)value, (Type*)type);
		@statement->data.selection_case.selector := value;
		CaseValue* previous := values;
		while (previous) {
			if (previous->value == value) {
				compiler_error(@*this.compiler, statement->token, "duplicate case value after conversion to the selector type\0");
				return;
			};
			@previous := previous->next;
		};

		CaseValue* selected = (CaseValue*)memory_allocate(@*this.compiler, sizeof(CaseValue));
		if (!selected) {
			return;
		};
		@selected->value = $value;
		@selected->next := values;
		@values = $selected;
		@statement := statement->next;
	};
};

fn function_receiver(Entity* function) -> bool {
	TypeUse* use := function->data.function.type_use;
	return use && use->data.callable.parameters && token_is(use->data.callable.parameters->name, "this\0");
};

fn type_use_child(TypeUse* use) -> TypeUse* {
	if (!use) {
		return nullptr;
	};
	return (TypeUse*)use->data.element;
};

fn type_use_result(TypeUse* use) -> TypeUse* {
	if (!use) {
		return nullptr;
	};
	return (TypeUse*)use->data.callable.result;
};

fn type_use_parameters(TypeUse* use) -> ParameterUse* {
	if (!use) {
		return nullptr;
	};
	return (ParameterUse*)use->data.callable.parameters;
};

fn type_use_effective(Type* type, TypeUse* use) -> TypeUse* {
	if (type && type->kind == type_kind::reference && use) {
		return (TypeUse*)use->data.element;
	};
	return $use;
};

fn entity_type_use(Entity* entity) -> TypeUse* {
	if (!entity) {
		return nullptr;
	};
	if (entity->kind == entity_kind::function) {
		return (TypeUse*)entity->data.function.type_use;
	};
	if (entity->kind == entity_kind::variable) {
		return type_use_effective((Type*)entity->data.variable.type, (TypeUse*)entity->data.variable.type_use);
	};
	return nullptr;
};

fn Semantic::expression_use(Semantic& this, Syntax* syntax) -> TypeUse* {
	if (!syntax) {
		return nullptr;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block:
		case syntax_kind::expr_name:
		case syntax_kind::expr_member:
			return entity_type_use((Entity*)syntax->entity);
		case syntax_kind::kw_new:
			return (TypeUse*)syntax->type_use;
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
			return @this.expression_use((Syntax*)syntax->data.expression);
		case syntax_kind::expr_cast:
			return type_use_effective((Type*)syntax->data.cast.resolved, (TypeUse*)syntax->data.cast.type_use);
		case syntax_kind::expr_construct:
			return type_use_effective((Type*)syntax->data.construction.target, (TypeUse*)syntax->data.construction.type_use);
		case syntax_kind::expr_index: {
			TypeUse* use = @this.expression_use((Syntax*)syntax->data.binary.left);
			if (use) {
				return (TypeUse*)use->data.element;
			};
			return nullptr;
		};
		case syntax_kind::expr_unary: {
			TypeUse* use = @this.expression_use((Syntax*)syntax->data.unary.value);
			if (syntax->data.unary.operation == token_kind::op_ampersand) {
				return (TypeUse*)syntax->type_use;
			};
			if (syntax->data.unary.operation == token_kind::op_star && use) {
				return (TypeUse*)use->data.element;
			};
			return nullptr;
		};
		case syntax_kind::expr_call: {
			Syntax* callee := syntax->data.call.callable;
			Type* type := callee->type;
			TypeUse* use = @this.expression_use((Syntax*)callee);
			if (type->kind == type_kind::pointer) {
				@type := type->data.element;
				if (use) {
					@use := use->data.element;
				};
			};
			if (use) {
				return type_use_effective((Type*)type->data.function.result, (TypeUse*)use->data.callable.result);
			};
			return nullptr;
		};
		case syntax_kind::stmt_initialize:
		case syntax_kind::stmt_bind_reference:
			return @this.expression_use((Syntax*)syntax->data.binary.left);
		case syntax_kind::expr_binary:
			if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
				TypeUse* function_use := syntax->entity->data.function.type_use;
				if (function_use) {
					return type_use_effective((Type*)syntax->entity->data.function.type->data.function.result, (TypeUse*)function_use->data.callable.result);
				};
				return nullptr;
			};
			if (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy || (syntax->type && syntax->type->kind == type_kind::pointer && syntax->data.binary.left->type->kind == type_kind::pointer)) {
				return @this.expression_use((Syntax*)syntax->data.binary.left);
			};
			if (syntax->type && syntax->type->kind == type_kind::pointer) {
				return @this.expression_use((Syntax*)syntax->data.binary.right);
			};
			return nullptr;
	};
	return nullptr;
};

fn interface_receiver_validate(Compiler& compiler, Entity* entity, Type* signature, const Token& token) {
	Entity* owner := entity->data.function.interface_owner;
	if (!owner && entity->data.function.role != function_role::ordinary && entity->scope) {
		@owner := entity->scope->owner;
	};
	if (!owner) {
		return;
	};
	Parameter* receiver := signature->data.function.parameters;
	if (!receiver || !function_receiver((Entity*)entity) || receiver->type->kind != type_kind::reference || receiver->type->data.element->kind != type_kind::named || receiver->type->data.element->data.entity != owner) {
		compiler_error(@compiler, token, "struct interface function requires its owning reference receiver named this\0");
		return;
	};
	if (entity->data.function.role == function_role::destructor && (receiver->next || receiver->type->data.element->qualifier == type_qualifier::kw_const || signature->data.function.arity != parameter_arity::fixed || signature->data.function.result->kind != type_kind::kw_void)) {
		compiler_error(@compiler, token, "destructor requires exactly one mutable owning-type reference receiver named this\0");
	};
};

fn defaulted_validate(Compiler& compiler, Entity* entity, Type* signature, const Token& token) {
	if (entity->data.function.definition != function_definition::defaulted) {
		return;
	};
	Parameter* receiver := signature->data.function.parameters;
	function_role role := entity->data.function.role;
	if (role == function_role::ordinary || !receiver || signature->data.function.arity != parameter_arity::fixed || receiver->type->kind != type_kind::reference || receiver->type->data.element->qualifier == type_qualifier::kw_const) {
		compiler_error(@compiler, token, "default applies only to a special member function\0");
		return;
	};
	if (role == function_role::destructor) {
		return;
	};
	Parameter* source := receiver->next;
	if (role == function_role::constructor && !source) {
		return;
	};
	if (!source || source->next || source->type->kind != type_kind::reference || !type_equal(type_qualified(@compiler, (Type*)source->type->data.element, type_qualifier::mutable), (Type*)receiver->type->data.element)) {
		compiler_error(@compiler, token, "defaulted copy operation requires one owning-type reference parameter\0");
		return;
	};
	if (role == function_role::assignment && (signature->data.function.result->kind != type_kind::reference || !type_equal((Type*)signature->data.function.result, (Type*)receiver->type))) {
		compiler_error(@compiler, token, "defaulted assignment must return its mutable owning-type reference\0");
	};
};

fn enum_constructor(Compiler& compiler, Entity* owner, Syntax* body) {
	Scope* owner_scope = entity_members((Entity*)owner);
	Token location := owner->name;
	Entity* function = entity_create(@compiler, entity_kind::function, Token(location));
	@function->scope := owner_scope;
	@function->data.function.role = function_role::constructor;
	Syntax* declaration = syntax_create(@compiler, syntax_kind::node_declaration, Token(location));
	@declaration->entity := function;
	@declaration->data.declaration.name := location;
	@declaration->data.declaration.definition = function_definition::definition;
	@function->declaration := declaration;
	Parameter* receiver = (Parameter*)memory_allocate(@compiler, sizeof(Parameter));
	Token receiver_token = token_synthetic(@compiler, Token(location), "this\0");
	@receiver->type = type_indirect(@compiler, type_kind::reference, entity_type((Entity*)owner));
	Parameter* value = (Parameter*)memory_allocate(@compiler, sizeof(Parameter));
	Token value_token = token_synthetic(@compiler, Token(location), "value\0");
	@value->type := owner->data.enumeration.underlying;
	@receiver->next := value;
	TypeUse* use = (TypeUse*)memory_allocate(@compiler, sizeof(TypeUse));
	ParameterUse* receiver_use = (ParameterUse*)memory_allocate(@compiler, sizeof(ParameterUse));
	ParameterUse* value_use = (ParameterUse*)memory_allocate(@compiler, sizeof(ParameterUse));
	if (!use || !receiver_use || !value_use) {
		return;
	};
	@receiver_use->name := receiver_token;
	@receiver_use->next := value_use;
	@value_use->name := value_token;
	@value_use->use := owner->data.enumeration.underlying_use;
	@use->data.callable.parameters = $receiver_use;
	@function->data.function.type_use = $use;
	@function->data.function.type = type_function(@compiler, (Type*)compiler.void_type, (Parameter*)receiver, parameter_arity::fixed);
	Scope* scope = scope_create(@compiler, (Scope*)owner_scope, context_kind::function, (Entity*)function);
	Entity* receiver_entity = entity_create(@compiler, entity_kind::variable, Token(receiver_token));
	@receiver_entity->data.variable.storage = storage_kind::parameter;
	@receiver_entity->data.variable.type := receiver->type;
	@receiver_entity->state = resolution::ready;
	scope_define(@compiler, (Scope*)scope, (Entity*)receiver_entity);
	Entity* value_entity = entity_create(@compiler, entity_kind::variable, Token(value_token));
	@value_entity->data.variable.storage = storage_kind::parameter;
	@value_entity->data.variable.type := value->type;
	@value_entity->state = resolution::ready;
	scope_define(@compiler, (Scope*)scope, (Entity*)value_entity);
	Syntax* receiver_name = syntax_create(@compiler, syntax_kind::expr_name, Token(receiver_token));
	@receiver_name->entity = $receiver_entity;
	Syntax* access = syntax_create(@compiler, syntax_kind::expr_access, Token(location));
	@access->data.expression = $receiver_name;
	Syntax* value_name = syntax_create(@compiler, syntax_kind::expr_name, Token(value_token));
	@value_name->entity = $value_entity;
	Syntax* relocate = syntax_create(@compiler, syntax_kind::expr_relocate, Token(location));
	@relocate->data.expression = $value_name;
	Syntax* cast = syntax_create(@compiler, syntax_kind::expr_cast, Token(location));
	@cast->data.cast.resolved = entity_type((Entity*)owner);
	@cast->data.cast.value = $relocate;
	Syntax* assignment = syntax_create(@compiler, syntax_kind::expr_binary, Token(location));
	@assignment->data.binary.operation = token_kind::op_assign;
	@assignment->data.binary.left = $access;
	@assignment->data.binary.right = $cast;
	Syntax* function_body = syntax_create(@compiler, syntax_kind::node_block, Token(location));
	@function_body->scope = $scope;
	@function_body->data.statements = $assignment;
	@declaration->data.declaration.body = $function_body;
	declaration_special_register(@compiler, (Scope*)owner_scope, (Syntax*)declaration);
	Syntax** tail = &body->data.statements;
	while (*tail) {
		@tail = &(*tail)->next;
	};
	@*tail = $declaration;
};

fn entity_resolve(Compiler& compiler, Entity* entity) {
	if (!entity || entity->state == resolution::ready) {
		return;
	};
	if (entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
		global_variable_resolve(@compiler, $entity);
		return;
	};
	if (entity->state == resolution::active) {
		compiler_error(@compiler, entity->name, "cyclic entity definition\0");
		return;
	};
	@entity->state = resolution::active;
	Syntax* declaration := entity->declaration;
	if (!declaration) {
		compiler_error(@compiler, entity->name, "entity has no declaration\0");
		return;
	};
	if (entity->kind == entity_kind::function) {
		@entity->data.function.type = function_type_resolve(@compiler, (Scope*)entity->scope, (Entity*)entity);
		interface_receiver_validate(@compiler, (Entity*)entity, (Type*)entity->data.function.type, declaration->token);
		Parameter* receiver := entity->data.function.type->data.function.parameters;
		Entity* owner = nullptr;
		if (entity->scope) {
			@owner := entity->scope->owner;
		};
		if (owner && (owner->kind == entity_kind::kw_struct || owner->kind == entity_kind::kw_union) && receiver && function_receiver((Entity*)entity) && (receiver->type->kind != type_kind::reference || receiver->type->data.element->kind != type_kind::named || receiver->type->data.element->data.entity != owner)) {
			compiler_error(@compiler, entity->name, "associated receiver must reference its owning type\0");
		};
		@entity->data.function.definition := declaration->data.declaration.definition;
		if (entity->data.function.definition == function_definition::defaulted) {
			@entity->data.function.analysis = function_analysis::unrequested;
		};
		defaulted_validate(@compiler, (Entity*)entity, (Type*)entity->data.function.type, declaration->token);
		@entity->data.function.body := declaration->data.declaration.body;
		if (entity->data.function.body) {
			@entity->data.function.scope := entity->data.function.body->scope;
			ParameterBinding** tail = &entity->data.function.parameter_bindings;
			Parameter* parameter := entity->data.function.type->data.function.parameters;
			ParameterUse* label := entity->data.function.type_use->data.callable.parameters;
			while (parameter) {
				if (!label || !label->name.source) {
					compiler_error(@compiler, entity->name, "function definition requires named parameters\0");
					break;
				};
				Entity* variable = scope_lookup((Scope*)entity->data.function.scope, label->name);
				if (!variable || variable->kind != entity_kind::variable) {
					compiler_error(@compiler, label->name, "function parameter binding is missing\0");
					return;
				};
				@variable->data.variable.type := parameter->type;
				@variable->data.variable.type_use := label->use;
				@variable->state = resolution::ready;

				ParameterBinding* binding = (ParameterBinding*)memory_allocate(@compiler, sizeof(ParameterBinding));
				if (!binding) {
					return;
				};
				@binding->entity = $variable;
				@*tail := binding;
				@tail = &binding->next;
				@parameter := parameter->next;
				@label := label->next;
			};
		};
	}
	else if (entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum) {
		if (!entity_type((Entity*)entity)) {
			Type* type = type_entity(@compiler, type_kind::named, (Entity*)entity);
			if (entity->kind == entity_kind::kw_enum) {
				@entity->data.enumeration.aggregate.type = (Type*)type;
			}
			else {
				@entity->data.aggregate.type = (Type*)type;
			};
		};
		if (entity->kind == entity_kind::kw_enum) {
			@entity->data.enumeration.underlying = type_resolve(@compiler, (Scope*)entity->scope, (TypeSyntax*)declaration->data.declaration.type);
			@entity->data.enumeration.underlying_use = type_use_resolve(@compiler, (Scope*)entity->scope, (TypeSyntax*)declaration->data.declaration.type);
			Type* underlying := entity->data.enumeration.underlying;
			if (!underlying || underlying->kind == type_kind::kw_void || underlying->kind == type_kind::kw_null || underlying->kind == type_kind::function || underlying->kind == type_kind::reference || underlying->qualifier == type_qualifier::kw_const || (type_enum((Type*)underlying) && underlying->data.entity == entity)) {
				compiler_error(@compiler, entity->name, "enum underlying type requires a complete mutable value representation\0");
				return;
			};
			if (type_enum((Type*)underlying)) {
				entity_resolve(@compiler, (Entity*)underlying->data.entity);
				if (compiler.result == compilation_result::failure) {
					return;
				};
			};
			layout_validate(@compiler, (Type*)underlying, nullptr, entity->name);
			if (compiler.result == compilation_result::failure) {
				return;
			};
		};
		bases_resolve(@compiler, (Entity*)entity);
		usize base_count = 0;
		if (aggregate_header((Entity*)entity)) {
			@base_count = 1;
		};
		usize component := base_count;
		BaseRelation* layout_base := entity->data.aggregate.bases;
		while (layout_base) {
			if (layout_base->kind == base_kind::nonvirtual) {
				@layout_base->component := component;
				@component = component + 1;
			};
			@layout_base := layout_base->next;
		};
		if (entity->kind == entity_kind::kw_struct) {
			BaseRelation* base := entity->data.aggregate.bases;
			while (base && compiler.result != compilation_result::failure) {
				entity_resolve(@compiler, (Entity*)base->entity);
				if (!base->entity->declaration || !base->entity->declaration->data.declaration.body) {
					compiler_error(@compiler, base->name->token, "base struct requires a complete definition\0");
					return;
				};
				if (base->kind == base_kind::nonvirtual) {
					@base_count = base_count + 1;
				};
				@base := base->next;
			};
		};
		Syntax* body := declaration->data.declaration.body;
		if (body) {
			Syntax* field := body->data.statements;
			usize index = 0;
			Field* last_field = nullptr;
			ConstantValue* next_value = nullptr;
			if (entity->kind == entity_kind::kw_enum && type_numeric((Type*)entity->data.enumeration.underlying)) {
				@next_value = constant_zero(@compiler, (Type*)entity->data.enumeration.underlying);
			};
			while (field) {
				if (field->kind != syntax_kind::node_declaration) {
					compiler_error(@compiler, field->token, "aggregate context requires declarations\0");
					break;
				};
				if (field->entity->kind != entity_kind::variable) {
					@field := field->next;
					continue;
				};
				Entity* variable := field->entity;
				if (entity->kind == entity_kind::kw_enum) {
					@variable->data.variable.type = entity_type((Entity*)entity);
					@variable->data.variable.storage = storage_kind::constant;
					ConstantValue* value = nullptr;
					if (field->data.declaration.body) {
						Semantic semantic;
						@semantic.compiler = &compiler;
						@semantic.scope := body->scope;
						Type* actual = @semantic.expression((Syntax*)field->data.declaration.body, (Type*)entity->data.enumeration.underlying);
						@semantic.expect((Syntax*)field->data.declaration.body, (Type*)actual, (Type*)entity->data.enumeration.underlying);
						if (compiler.result == compilation_result::failure) {
							return;
						};
						ConstantContext context;
						@context.compiler = &compiler;
						@context.scope := body->scope;
						@value = constant_expression(@context, (Syntax*)field->data.declaration.body, (Type*)entity->data.enumeration.underlying);
						if (!value) {
							compiler_error(@compiler, field->token, (const char*)context.reason);
							return;
						};
					};
					if (!field->data.declaration.body) {
						@value = constant_copy(@compiler, (ConstantValue*)next_value);
					};
					if (!value) {
						if (type_numeric((Type*)entity->data.enumeration.underlying)) {
							compiler_error(@compiler, field->token, "automatic enum numbering exceeds the underlying type range\0");
						}
						else {
							compiler_error(@compiler, field->token, "enum member with a non-primitive underlying type requires an initializer\0");
						};
						return;
					};
					@next_value = nullptr;
					Type* underlying := entity->data.enumeration.underlying;
					if (type_numeric((Type*)underlying)) {
						@next_value = constant_copy(@compiler, (ConstantValue*)value);
					};
					if (underlying->kind == type_kind::kw_float) {
						@next_value->data.real = next_value->data.real + 1;
					}
					else if (type_integer((Type*)underlying)) {
						u64 maximum = constant_selector(18446744073709551615, (Type*)underlying);
						if (!type_unsigned((Type*)underlying) && underlying->kind != type_kind::kw_char) {
							@maximum = maximum >> 1;
						};
						if (value->data.integer == maximum) {
							@next_value = nullptr;
						}
						else {
							@next_value->data.integer = next_value->data.integer + 1;
						};
					};
					if (type_integer((Type*)entity->data.enumeration.underlying)) {
						@variable->data.variable.data.integer := value->data.integer;
					};
					@value->type = entity_type((Entity*)entity);
					@variable->data.variable.evaluation = (ConstantEvaluation*)memory_allocate(@compiler, sizeof(ConstantEvaluation));
					@variable->data.variable.evaluation->state = constant_state::constant;
					@variable->data.variable.evaluation->value = $value;
				}
				else {
					@variable->data.variable.type = type_resolve(@compiler, (Scope*)body->scope, (TypeSyntax*)field->data.declaration.type);
					@variable->data.variable.type_use = type_use_resolve(@compiler, (Scope*)body->scope, (TypeSyntax*)field->data.declaration.type);
					if (entity->kind == entity_kind::kw_union && variable->data.variable.type->kind == type_kind::reference) {
						compiler_error(@compiler, field->token, "union cannot contain a reference field\0");
					};
					@variable->data.variable.storage = storage_kind::field;
					@variable->data.variable.data.field.owner := entity;
					@variable->data.variable.data.field.index = base_count + index;
					Field* representation = (Field*)memory_allocate(@compiler, sizeof(Field));
					@representation->entity := variable;
					if (last_field) {
						@last_field->next := representation;
					}
					else {
						@entity->data.aggregate.fields := representation;
					};
					@last_field = $representation;
					@index = index + 1;
				};
				@variable->state = resolution::ready;
				@field := field->next;
			};
			if (entity->kind == entity_kind::kw_enum) {
				@entity->data.enumeration.values := body->scope->bindings;
				enum_constructor(@compiler, (Entity*)entity, (Syntax*)body);
			}
			else {
				@entity->data.aggregate.field_count = (u64)index;
			};
		};
	}
	else if (entity->kind == entity_kind::variable) {
		if (declaration->data.declaration.type) {
			@entity->data.variable.type = type_resolve(@compiler, (Scope*)entity->scope, (TypeSyntax*)declaration->data.declaration.type);
			@entity->data.variable.type_use = type_use_resolve(@compiler, (Scope*)entity->scope, (TypeSyntax*)declaration->data.declaration.type);
		};
	};
	@entity->state = resolution::ready;
};

fn type_effective(Type* type) -> Type* {
	if (type && type->kind == type_kind::reference) {
		return (Type*)type->data.element;
	};
	return $type;
};

fn syntax_storage_type(Syntax* syntax) -> Type* {
	if (syntax->kind == syntax_kind::expr_binary && syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
		return (Type*)syntax->entity->data.function.type->data.function.result;
	};
	if (syntax->kind == syntax_kind::expr_access) {
		return syntax_storage_type((Syntax*)syntax->data.expression);
	};
	if (syntax->kind == syntax_kind::expr_base_reference || syntax->kind == syntax_kind::expr_base_pointer) {
		return (Type*)syntax->data.base_conversion.target;
	};
	if (syntax->entity && syntax->entity->kind == entity_kind::variable) {
		return entity_type((Entity*)syntax->entity);
	};
	if (syntax->kind == syntax_kind::expr_cast && syntax->data.cast.resolved && syntax->data.cast.resolved->kind == type_kind::reference) {
		return (Type*)syntax->data.cast.resolved;
	};
	if (syntax->kind == syntax_kind::expr_index) {
		Type* object := syntax->data.binary.left->type;
		if (object->kind == type_kind::array) {
			return (Type*)object->data.array.element;
		};
		return (Type*)object->data.element;
	};
	if (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star) {
		return (Type*)syntax->data.unary.value->type->data.element;
	};
	if (syntax->kind == syntax_kind::expr_call) {
		Type* callable := syntax->data.call.callable->type;
		if (callable->kind == type_kind::pointer) {
			@callable := callable->data.element;
		};
		return (Type*)callable->data.function.result;
	};
	return (Type*)syntax->type;
};

fn syntax_category(Syntax* syntax) -> value_category {
	if (syntax->kind == syntax_kind::expr_construct && syntax->data.construction.destination) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_borrowed_component) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_base_pointer && syntax->data.base_conversion.request == base_conversion_request::implicit_conversion) {
		return syntax_category((Syntax*)syntax->data.base_conversion.value);
	};
	if (syntax->kind == syntax_kind::stmt_initialize || syntax->kind == syntax_kind::stmt_bind_reference) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_binary && (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy) && !syntax->entity) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_binary && syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment && syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_access) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_name && syntax->entity && syntax->entity->kind == entity_kind::variable && syntax->entity->data.variable.storage != storage_kind::constant) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_base_reference || (syntax->kind == syntax_kind::expr_cast && syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference) || syntax->kind == syntax_kind::expr_member || syntax->kind == syntax_kind::expr_index || (syntax->kind == syntax_kind::expr_call && syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference) || (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star)) {
		return value_category::storage;
	};
	if (syntax->kind == syntax_kind::expr_name && syntax->entity && syntax->entity->kind != entity_kind::variable) {
		return value_category::entity;
	};
	return value_category::temporary;
};

fn syntax_mutable_access(Syntax* syntax) -> bool {
	if (!syntax || !syntax->type || syntax->type->qualifier == type_qualifier::kw_const) {
		return false;
	};
	if (syntax->kind == syntax_kind::expr_access || (syntax->kind == syntax_kind::expr_construct && syntax->data.construction.destination)) {
		return true;
	};
	if (syntax->kind == syntax_kind::expr_binary && (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy) && !syntax->entity) {
		return syntax_mutable_access((Syntax*)syntax->data.binary.left);
	};
	if (syntax->kind == syntax_kind::expr_member) {
		return syntax_mutable_access((Syntax*)syntax->data.member.object);
	};
	if (syntax->kind == syntax_kind::expr_index) {
		return syntax_mutable_access((Syntax*)syntax->data.binary.left);
	};
	if (syntax->kind == syntax_kind::expr_base_reference) {
		return syntax_mutable_access((Syntax*)syntax->data.base_conversion.value);
	};
	if (syntax->kind == syntax_kind::expr_cast && syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference) {
		return syntax_mutable_access((Syntax*)syntax->data.cast.value);
	};
	return false;
};

fn Semantic::owned(Semantic& this, Syntax* syntax) {
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	if (syntax_category((Syntax*)syntax) == value_category::storage) {
		compiler_error(@*this.compiler, syntax->token, "owned value requires an rvalue; relocate with '$' or construct a value\0");
		return;
	};
	@syntax->use = value_use::transferred;
};

fn function_request(Entity* function) {
	if (function && function->kind == entity_kind::function && function->data.function.analysis == function_analysis::unrequested) {
		@function->data.function.analysis = function_analysis::requested;
	};
};

fn destruction_request(Type* type) {
	if (!type) {
		return;
	};
	if (type->kind == type_kind::array) {
		destruction_request((Type*)type->data.array.element);
		return;
	};
	if (type->kind != type_kind::named) {
		return;
	};
	Entity* owner := type->data.entity;
	function_request((Entity*)owner->data.aggregate.destructor);
	if (owner->kind == entity_kind::kw_enum) {
		destruction_request((Type*)owner->data.enumeration.underlying);
		return;
	};
	if (owner->kind == entity_kind::kw_union) {
		return;
	};
	Field* field := owner->data.aggregate.fields;
	while (field) {
		destruction_request(entity_type((Entity*)field->entity));
		@field := field->next;
	};
	BaseRelation* base := owner->data.aggregate.bases;
	while (base) {
		destruction_request(entity_type((Entity*)base->entity));
		@base := base->next;
	};
};

fn Semantic::conversion_rank(Semantic& this, Syntax* argument, Type* expected, constructor_conversion conversion) -> i32 {
	Type* target := expected;
	i32 rank = 0;
	if (target->kind == type_kind::reference) {
		@target := target->data.element;
		if (target->qualifier != type_qualifier::kw_const && !syntax_mutable_access((Syntax*)argument)) {
			return -1;
		};
		if (syntax_category((Syntax*)argument) == value_category::temporary) {
			@rank = 1;
		};
	}
	else if (syntax_category((Syntax*)argument) == value_category::storage) {
		@rank = -1;
	};
	if (rank >= 0) {
		if (syntax_number_expression((Syntax*)argument)) {
			if (target->kind == type_kind::pointer && syntax_zero_pointer_constant((Syntax*)argument)) {
				return rank + 2;
			};
			if (type_numeric((Type*)target)) {
				return rank;
			};
		}
		else {
			Type* actual = @this.expression((Syntax*)argument, nullptr);
			if (type_value_equal((Type*)actual, (Type*)target)) {
				return rank;
			};
			if (type_pointer_conversion((Type*)actual, (Type*)target)) {
				return rank + 2;
			};
			if (expected->kind == type_kind::reference && base_search(@*this.compiler, (Type*)actual, (Type*)target).count == 1) {
				return rank;
			};
		};
	};
	if (conversion == constructor_conversion::kw_implicit || target->kind != type_kind::named || (target->data.entity->kind != entity_kind::kw_struct && target->data.entity->kind != entity_kind::kw_union) || (expected->kind == type_kind::reference && target->qualifier != type_qualifier::kw_const)) {
		return -1;
	};
	Entity* candidate := target->data.entity->data.aggregate.constructors;
	i32 best = 2147483647;
	while (candidate) {
		if (candidate->data.function.conversion == constructor_conversion::kw_implicit) {
			entity_resolve(@*this.compiler, (Entity*)candidate);
			Parameter* parameter := candidate->data.function.type->data.function.parameters;
			if (parameter && parameter->next && !parameter->next->next) {
				i32 nested = @this.conversion_rank((Syntax*)argument, (Type*)parameter->next->type, constructor_conversion::kw_implicit);
				if (nested >= 0 && nested < best) {
					@best := nested;
				};
			};
		};
		@candidate := candidate->data.function.overload_next;
	};
	if (best == 2147483647) {
		return -1;
	};
	return best + 16;
};

fn Semantic::conversion_select(Semantic& this, Entity* owner, function_role role, Syntax* arguments, const Token& token, constructor_conversion conversion) -> Entity* {
	Syntax* input := arguments;
	while (input) {
		if (!syntax_number_expression((Syntax*)input)) {
			@this.expression((Syntax*)input, nullptr);
		};
		@input := input->next;
	};
	Entity* candidate := *special_functions($owner, $role);
	Entity* selected = nullptr;
	i32 best = 2147483647;
	i32 matches = 0;
	while (candidate && this.compiler->result != compilation_result::failure) {
		if (conversion == constructor_conversion::kw_implicit && candidate->data.function.conversion != constructor_conversion::kw_implicit) {
			@candidate := candidate->data.function.overload_next;
			continue;
		};
		entity_resolve(@*this.compiler, (Entity*)candidate);
		Parameter* parameter := candidate->data.function.type->data.function.parameters;
		if (parameter) {
			@parameter := parameter->next;
		};
		Syntax* argument := arguments;
		i32 rank = 0;
		while (argument && parameter) {
			i32 score = @this.conversion_rank((Syntax*)argument, (Type*)parameter->type, (constructor_conversion)conversion);
			if (score < 0) {
				break;
			};
			@rank = rank + score;
			@parameter := parameter->next;
			@argument := argument->next;
		};
		if (!argument && !parameter) {
			if (rank < best) {
				@selected := candidate;
				@best = (i32)rank;
				@matches = 1;
			}
			else if (rank == best) {
				@matches = matches + 1;
			};
		};
		@candidate := candidate->data.function.overload_next;
	};
	if (matches > 1) {
		compiler_error(@*this.compiler, token, "ambiguous special function call\0");
		return nullptr;
	};
	if (selected && selected->data.function.definition == function_definition::deleted) {
		compiler_error(@*this.compiler, token, "selected function is deleted\0");
		return nullptr;
	};
	if (selected) {
		function_request((Entity*)selected);
		Parameter* parameter := selected->data.function.type->data.function.parameters->next;
		Syntax* argument := arguments;
		while (argument && parameter) {
			@this.expression((Syntax*)argument, (Type*)parameter->type);
			if (parameter->type->kind != type_kind::reference) {
				@this.owned((Syntax*)argument);
			}
			else {
				@argument->use = value_use::observed;
			};
			@argument := argument->next;
			@parameter := parameter->next;
		};
	};
	return $selected;
};

fn Semantic::special_select(Semantic& this, Entity* owner, function_role role, Syntax* arguments, Token token) -> Entity* {
	return @this.conversion_select($owner, $role, $arguments, token, constructor_conversion::kw_explicit);
};

fn construction_resolve(Compiler& compiler, Scope* scope, Syntax* syntax) {
	TypedApplySyntax parsed := syntax->data.typed_apply;
	Type* target = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)parsed.target);
	TypeUse* use = type_use_resolve(@compiler, $scope, (TypeSyntax*)parsed.target);
	if (compiler.result == compilation_result::failure) {
		return;
	};

	@syntax->kind = syntax_kind::expr_construct;
	@syntax->data.construction.destination = nullptr;
	@syntax->data.construction.target = $target;
	@syntax->data.construction.type_use = $use;
	@syntax->data.construction.constructor = nullptr;
	@syntax->data.construction.arguments := parsed.arguments;
};

fn syntax_construct(Compiler& compiler, Syntax* syntax, Type* target, TypeUse* use) {
	Syntax* argument = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
	@*argument := *syntax;
	@argument->next = nullptr;
	@argument->use = value_use::observed;
	@syntax->kind = syntax_kind::expr_construct;
	@syntax->type = nullptr;
	@syntax->type_use = nullptr;
	@syntax->entity = nullptr;
	@syntax->data.construction.destination = nullptr;
	@syntax->data.construction.target = $target;
	@syntax->data.construction.type_use = $use;
	@syntax->data.construction.constructor = nullptr;
	@syntax->data.construction.arguments = $argument;
};

enum generated_operation : [i32] {
	kw_default;
	copy;
	assignment;
	copy_assignment;
};

fn Semantic::operation_function(Semantic& this, Type* type, generated_operation operation, Token token) -> Entity* {
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return nullptr;
	};
	function_role role = function_role::constructor;
	Syntax input;
	@input.kind = syntax_kind::expr_borrowed_component;
	@input.type = type_qualified(@*this.compiler, (Type*)type, type_qualifier::kw_const);
	@input.token := token;
	@input.use = value_use::transferred;
	if (operation == generated_operation::assignment || operation == generated_operation::copy_assignment) {
		@role = function_role::assignment;
		@input.kind = syntax_kind::expr_owned_component;
		@input.type := type;
		if (operation == generated_operation::copy_assignment) {
			@input.kind = syntax_kind::expr_borrowed_component;
			@input.type = type_qualified(@*this.compiler, (Type*)type, type_qualifier::kw_const);
		};
	};
	Syntax* argument = &input;
	if (operation == generated_operation::kw_default) {
		@argument = nullptr;
	};
	return @this.special_select((Entity*)type->data.entity, $role, $argument, $token);
};

fn Semantic::operation_has_callback(Semantic& this, Type* type, generated_operation operation, const Token& token) -> bool {
	if (type_has_views((Type*)type)) {
		return true;
	};
	if (type->kind == type_kind::array) {
		return @this.operation_has_callback((Type*)type->data.array.element, (generated_operation)operation, token);
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return false;
	};
	Entity* function = @this.operation_function((Type*)type, (generated_operation)operation, Token(token));
	if (function && function->data.function.definition != function_definition::defaulted) {
		return true;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base) {
		if (@this.operation_has_callback(entity_type((Entity*)base->entity), (generated_operation)operation, token)) {
			return true;
		};
		@base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field) {
		if (@this.operation_has_callback(entity_type((Entity*)field->entity), (generated_operation)operation, token)) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn Semantic::constructor_members_validate(Semantic& this, Type* type, const Token& token) {
	if (type->kind != type_kind::named || type->data.entity->kind != entity_kind::kw_struct) {
		return;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base && this.compiler->result != compilation_result::failure) {
		@this.generated_operation_validate(entity_type((Entity*)base->entity), generated_operation::kw_default, token);
		@base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field && this.compiler->result != compilation_result::failure) {
		@this.generated_operation_validate(entity_type((Entity*)field->entity), generated_operation::kw_default, token);
		@field := field->next;
	};
};
fn Semantic::generated_operation_validate(Semantic& this, Type* type, generated_operation operation, const Token& token) {
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	if (type->kind == type_kind::reference) {
		if (operation != generated_operation::copy) {
			compiler_error(@*this.compiler, token, "generated operation cannot default-bind or assign a reference component\0");
		};
		return;
	};
	if ((operation == generated_operation::assignment || operation == generated_operation::copy_assignment) && type->qualifier == type_qualifier::kw_const) {
		compiler_error(@*this.compiler, token, "generated assignment cannot replace a const component\0");
		return;
	};
	if (type->kind == type_kind::array) {
		@this.generated_operation_validate((Type*)type->data.array.element, (generated_operation)operation, token);
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	Entity* function = @this.operation_function((Type*)type, (generated_operation)operation, Token(token));
	if (function && function->data.function.definition != function_definition::defaulted) {
		if (operation != generated_operation::assignment) {
			@this.constructor_members_validate((Type*)type, token);
		};
		if (operation != generated_operation::assignment && type_has_reference((Type*)type)) {
			compiler_error(@*this.compiler, token, "constructor reference-field binding syntax is not implemented\0");
		};
		return;
	};
	Entity* entity := type->data.entity;
	if (function && function->data.function.definition == function_definition::defaulted && operation == generated_operation::assignment) {
		@operation = generated_operation::copy_assignment;
	};
	if (!function && operation == generated_operation::kw_default && entity->data.aggregate.constructors) {
		compiler_error(@*this.compiler, token, "user-declared constructors suppress the generated default constructor\0");
		return;
	};
	if (entity->kind == entity_kind::kw_union) {
		if (operation == generated_operation::kw_default && entity->data.aggregate.fields) {
			Field* variant := entity->data.aggregate.fields;
			usize mutable_variants = 0;
			while (variant) {
				Type* member = entity_type((Entity*)variant->entity);
				while (member->kind == type_kind::array && member->qualifier != type_qualifier::kw_const) {
					@member := member->data.array.element;
				};
				if (member->qualifier != type_qualifier::kw_const) {
					@mutable_variants = mutable_variants + 1;
				};
				@variant := variant->next;
			};
			if (!mutable_variants) {
				compiler_error(@*this.compiler, token, "generated default constructor is deleted for a union with only const variant members\0");
				return;
			};
		};
		if (operation == generated_operation::kw_default && (type_has_reference((Type*)type) || type_requires_union_choice((Type*)type))) {
			compiler_error(@*this.compiler, token, "generated union construction requires explicit member initialization\0");
			return;
		};
		Field* field := entity->data.aggregate.fields;
		while (field) {
			Type* member = entity_type((Entity*)field->entity);
			if (@this.operation_has_callback((Type*)member, (generated_operation)operation, token)) {
				compiler_error(@*this.compiler, token, "generated union operation is deleted for a nontrivial variant member\0");
				return;
			};
			@this.generated_operation_validate($member, (generated_operation)operation, token);
			@field := field->next;
		};
		return;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		@this.generated_operation_validate(entity_type((Entity*)base->entity), (generated_operation)operation, token);
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		@this.generated_operation_validate(entity_type((Entity*)field->entity), (generated_operation)operation, token);
		@field := field->next;
	};
};

fn syntax_zero_pointer_constant(Syntax* syntax) -> bool {
	if (syntax->kind != syntax_kind::literal_number || !syntax->token.length) {
		return false;
	};
	usize index = 0;
	while (index < syntax->token.length) {
		if (syntax->token.source->bytes.data[syntax->token.begin + index] != '0') {
			return false;
		};
		@index = index + 1;
	};
	return true;
};
fn syntax_number_expression(Syntax* syntax) -> i32 {
	if (syntax->kind == syntax_kind::literal_number) {
		return 1;
	};
	if (syntax->kind == syntax_kind::expr_unary && (syntax->data.unary.operation == token_kind::op_plus || syntax->data.unary.operation == token_kind::op_minus)) {
		return syntax_number_expression((Syntax*)syntax->data.unary.value);
	};
	if (syntax->kind == syntax_kind::expr_binary && syntax->data.binary.operation != token_kind::op_assign && syntax->data.binary.operation != token_kind::op_copy) {
		return syntax_number_expression((Syntax*)syntax->data.binary.left) && syntax_number_expression((Syntax*)syntax->data.binary.right);
	};
	return 0;
};

fn storage_borrowed(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 0;
	};
	if (syntax_storage_type((Syntax*)syntax) && syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference) {
		return 1;
	};
	switch (syntax->kind) {
		case syntax_kind::expr_member:
		case syntax_kind::expr_index:
			return 1;
		case syntax_kind::expr_unary:
			return syntax->data.unary.operation == token_kind::op_star;
		default:
			return 0;
	};
};

fn Semantic::create_scope(Semantic& this, const Scope& parsed) -> Scope* {
	Scope* created = scope_create(@*this.compiler, Scope*(this.scope), context_kind(parsed.context), Entity*(parsed.owner));
	if (!created) {
		return nullptr;
	};
	Scope& scope = @*created;

	Binding* binding := parsed.bindings;
	while (binding) {
		Entity& entity = @*binding->entity;
		if (entity.kind != entity_kind::variable || entity.data.variable.storage == storage_kind::parameter || entity.data.variable.storage == storage_kind::argument || entity.data.variable.storage == storage_kind::constant) {
			scope_define(@*this.compiler, &scope, &entity);
		};
		@binding := binding->next;
	};

	if (parsed.context == context_kind::function && parsed.parent) {
		@binding := parsed.parent->bindings;
		while (binding) {
			if (binding->entity->kind == entity_kind::variable && binding->entity->data.variable.storage == storage_kind::parameter) {
				scope_define(@*this.compiler, &scope, Entity*(binding->entity));
			};
			@binding := binding->next;
		};
	};

	return &scope;
};

fn syntax_unaccess(Syntax* syntax) -> Syntax* {
	while (syntax && syntax->kind == syntax_kind::expr_access) {
		@syntax := syntax->data.expression;
	};
	return $syntax;
};

fn reference_initializer(Compiler& compiler, Syntax* body, Entity* variable, Token token) {
	Syntax* statement = nullptr;
	if (body) {
		@statement := body->data.statements;
	};
	while (statement) {
		Syntax* target = nullptr;
		if (statement->kind == syntax_kind::expr_binary || statement->kind == syntax_kind::stmt_initialize) {
			@target = syntax_unaccess((Syntax*)statement->data.binary.left);
		};
		if (target && (statement->data.binary.operation == token_kind::op_assign || statement->data.binary.operation == token_kind::op_copy) && target->kind == syntax_kind::expr_name && token_same(target->token, variable->name)) {
			@statement->kind = syntax_kind::stmt_initialize;
			@target->entity := variable;
			return;
		};
		@statement := statement->next;
	};
	compiler_error(@compiler, token, "reference requires a bound initializer\0");
};

union ReferencePathData {
	BaseRelation* base;
	Entity* entity;
	usize index;
};

struct ReferencePath {
	ReferencePath* parent;
	ReferencePathData data;
	syntax_kind kind;
};

fn reference_path_type(ReferencePath* path) -> Type* {
	if (path->kind == syntax_kind::expr_base_reference) {
		return entity_type((Entity*)path->data.base->entity);
	};
	if (path->kind == syntax_kind::expr_index) {
		return (Type*)reference_path_type((ReferencePath*)path->parent)->data.array.element;
	};
	return type_effective(entity_type((Entity*)path->data.entity));
};

fn reference_base_count(ReferencePath* path) -> usize {
	if (path->kind != syntax_kind::expr_base_reference) {
		return 0;
	};
	return 1 + reference_base_count((ReferencePath*)path->parent);
};

fn reference_base_at(ReferencePath* path, usize index) -> BaseRelation* {
	usize depth = reference_base_count((ReferencePath*)path);
	if (!depth || index >= depth) {
		return nullptr;
	};
	if (index + 1 == depth) {
		return (BaseRelation*)path->data.base;
	};
	return reference_base_at((ReferencePath*)path->parent, $index);
};

fn reference_bases_match(Compiler& compiler, ReferencePath* expected, Type* source, BasePath* first, BasePath* second) -> bool {
	CompleteGraph* graph = complete_graph(@compiler, (Entity*)source->data.entity);
	Subobject* actual = subobject_path(subobject_path((Subobject*)graph->root, $first), $second);
	Subobject* required := graph->root;
	usize index = 0;
	while (index < reference_base_count((ReferencePath*)expected)) {
		@required = subobject_edge((Subobject*)required, reference_base_at((ReferencePath*)expected, (u64)index));
		@index = index + 1;
	};
	return actual == required;
};

fn reference_cast_subobject(Compiler& compiler, Scope* scope, ReferencePath* root, CompleteGraph* graph, Syntax* storage) -> Subobject* {
	if (storage->kind != syntax_kind::expr_cast) {
		if (reference_path_matches(@compiler, (Scope*)scope, (ReferencePath*)root, (Syntax*)storage)) {
			return (Subobject*)graph->root;
		};
		return nullptr;
	};
	Type* selected := storage->data.cast.resolved;
	if (!selected) {
		@selected = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)storage->data.cast.type);
	};
	if (selected->kind != type_kind::reference || selected->data.element->kind != type_kind::named) {
		return nullptr;
	};
	Subobject* source = reference_cast_subobject(@compiler, $scope, $root, $graph, (Syntax*)storage->data.cast.value);
	if (!source) {
		return nullptr;
	};
	BaseSearch path = base_search(@compiler, entity_type((Entity*)source->entity), (Type*)selected->data.element);
	if (path.count != 1) {
		return nullptr;
	};
	return subobject_path($source, (BasePath*)path.path);
};

fn reference_path_matches(Compiler& compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	while (storage && storage->kind == syntax_kind::expr_access) {
		@storage := storage->data.expression;
	};
	if (storage && storage->kind == syntax_kind::expr_cast && path->kind == syntax_kind::expr_base_reference) {
		ReferencePath* root := path;
		while (root->kind == syntax_kind::expr_base_reference) {
			@root := root->parent;
		};
		Type* source = reference_path_type((ReferencePath*)root);
		CompleteGraph* graph = complete_graph(@compiler, (Entity*)source->data.entity);
		Subobject* actual = reference_cast_subobject(@compiler, (Scope*)scope, $root, (CompleteGraph*)graph, (Syntax*)storage);
		Subobject* required := graph->root;
		usize index = 0;
		while (index < reference_base_count((ReferencePath*)path)) {
			@required = subobject_edge((Subobject*)required, reference_base_at((ReferencePath*)path, (u64)index));
			@index = index + 1;
		};
		return actual && actual == required;
	};
	if (!storage || storage->kind != path->kind) {
		return false;
	};
	if (path->kind == syntax_kind::expr_name) {
		return token_same(storage->token, path->data.entity->name);
	};
	if (path->kind == syntax_kind::expr_member) {
		if (storage->token.kind == token_kind::op_arrow || !token_same(storage->data.member.name, path->data.entity->name)) {
			return false;
		};
		ReferencePath* object := path->parent;
		while (object->kind == syntax_kind::expr_base_reference) {
			@object := object->parent;
		};
		if (!reference_path_matches(@compiler, (Scope*)scope, (ReferencePath*)object, (Syntax*)storage->data.member.object)) {
			return false;
		};
		Type* source = reference_path_type($object);
		Type* owner = entity_type((Entity*)path->data.entity->data.variable.data.field.owner);
		Type* visible := source;
		if (storage->data.member.qualifier) {
			@visible = named_type(@compiler, (Scope*)scope, (Syntax*)storage->data.member.qualifier);
		};
		if (visible->kind != type_kind::named || associated_lookup(@compiler, (Entity*)visible->data.entity, storage->data.member.name) != path->data.entity) {
			return false;
		};
		BaseSearch first = base_search(@compiler, (Type*)source, (Type*)owner);
		BaseSearch second;
		if (storage->data.member.qualifier) {
			Type* selected = named_type(@compiler, (Scope*)scope, (Syntax*)storage->data.member.qualifier);
			@first = base_search(@compiler, (Type*)source, (Type*)selected);
			@second = base_search(@compiler, $selected, (Type*)owner);
			if (second.count != 1) {
				return false;
			};
		};
		if (first.count > 1 || second.count > 1) {
			compiler_error(@compiler, storage->token, "ambiguous inherited reference field subobject\0");
			return false;
		};
		return first.count == 1 && reference_bases_match(@compiler, (ReferencePath*)path->parent, (Type*)source, (BasePath*)first.path, (BasePath*)second.path);
	};
	if (path->kind == syntax_kind::expr_index) {
		return reference_path_matches(@compiler, (Scope*)scope, (ReferencePath*)path->parent, (Syntax*)storage->data.binary.left) && constant_integer(@compiler, (Scope*)scope, (Syntax*)storage->data.binary.right) == (u64)path->data.index;
	};
	return false;
};

enum type_property : [i32] {
	reference;
	union_selection;
	destruction;
	lifecycle_callbacks;
};

fn type_contains(Type* type, type_property property) -> bool {
	if (!type) {
		return false;
	};
	if (property == type_property::reference && type->kind == type_kind::reference) {
		return true;
	};
	if (type->kind == type_kind::array) {
		return type_contains((Type*)type->data.array.element, $property);
	};
	if (type->kind != type_kind::named) {
		return false;
	};

	Entity* entity := type->data.entity;
	switch (property) {
		case type_property::union_selection:
			if (entity->kind == entity_kind::kw_union) {
				return type_has_views((Type*)type) || type_contains((Type*)type, type_property::reference);
			};
			break;
		case type_property::destruction:
			if (entity->data.aggregate.destructor && entity->data.aggregate.destructor->data.function.definition != function_definition::defaulted) {
				return true;
			};
			break;
		case type_property::lifecycle_callbacks:
			Entity* constructor := entity->data.aggregate.constructors;
			while (constructor) {
				if (constructor->data.function.definition != function_definition::defaulted) {
					return true;
				};
				@constructor := constructor->data.function.overload_next;
			};
			Entity* assignment := entity->data.aggregate.assignments;
			while (assignment) {
				if (assignment->data.function.definition != function_definition::defaulted) {
					return true;
				};
				@assignment := assignment->data.function.overload_next;
			};
			if (entity->data.aggregate.destructor && entity->data.aggregate.destructor->data.function.definition != function_definition::defaulted) {
				return true;
			};
			break;
		case type_property::reference:
			break;
	};
	if (entity->kind == entity_kind::kw_enum) {
		return type_contains((Type*)entity->data.enumeration.underlying, $property);
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_contains(entity_type((Entity*)base->entity), (type_property)property)) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_contains(entity_type((Entity*)field->entity), (type_property)property)) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn type_has_reference(Type* type) -> bool {
	return type_contains($type, type_property::reference);
};

fn reference_path_contains(Compiler& compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	while (storage) {
		if (storage->kind == syntax_kind::expr_access) {
			@storage := storage->data.expression;
			continue;
		};
		if (reference_path_matches(@compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)storage)) {
			return true;
		};
		if (storage->kind == syntax_kind::expr_member && storage->token.kind != token_kind::op_arrow) {
			@storage := storage->data.member.object;
		}
		else if (storage->kind == syntax_kind::expr_index) {
			@storage := storage->data.binary.left;
		}
		else {
			break;
		};
	};
	return false;
};

fn reference_whole_prepare(Compiler& compiler, Scope* scope, ReferencePath* path, Syntax* body) -> bool {
	Syntax* statement = nullptr;
	if (body) {
		@statement := body->data.statements;
	};
	while (statement) {
		if ((statement->kind == syntax_kind::expr_binary || statement->kind == syntax_kind::stmt_initialize) && (statement->data.binary.operation == token_kind::op_assign || statement->data.binary.operation == token_kind::op_copy) && reference_path_matches(@compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)statement->data.binary.left)) {
			@statement->kind = syntax_kind::stmt_initialize;
			if (path->kind == syntax_kind::expr_name || path->kind == syntax_kind::expr_member) {
				@syntax_unaccess((Syntax*)statement->data.binary.left)->entity := path->data.entity;
			};
			return true;
		};
		@statement := statement->next;
	};
	return false;
};

fn reference_subobjects_bound(Compiler& compiler, Subobject* object, SubobjectVisit** visited) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate(@compiler, sizeof(SubobjectVisit));
	@visit->object := object;
	@visit->next := *visited;
	@*visited = $visit;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		reference_subobjects_bound(@compiler, (Subobject*)edge->target, (SubobjectVisit**)visited);
		@edge := edge->next;
	};
};

fn reference_subobjects_prepare(Compiler& compiler, Scope* scope, Subobject* object, ReferencePath* path, Syntax* body, const Token& token, SubobjectVisit** visited) {
	if (reference_whole_prepare(@compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)body)) {
		reference_subobjects_bound(@compiler, (Subobject*)object, (SubobjectVisit**)visited);
		return;
	};
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate(@compiler, sizeof(SubobjectVisit));
	@visit->object := object;
	@visit->next := *visited;
	@*visited = $visit;

	SubobjectEdge* edge := object->edges;
	while (edge && compiler.result != compilation_result::failure) {
		ReferencePath inherited;
		@inherited.kind = syntax_kind::expr_base_reference;
		@inherited.parent := path;
		@inherited.data.base := edge->relation;
		reference_subobjects_prepare(@compiler, (Scope*)scope, (Subobject*)edge->target, &inherited, (Syntax*)body, token, (SubobjectVisit**)visited);
		@edge := edge->next;
	};
	Field* field := object->entity->data.aggregate.fields;
	while (field && compiler.result != compilation_result::failure) {
		ReferencePath member;
		@member.kind = syntax_kind::expr_member;
		@member.parent := path;
		@member.data.entity := field->entity;
		reference_fields_prepare(@compiler, (Scope*)scope, entity_type((Entity*)field->entity), &member, (Syntax*)body, Token(token));
		@field := field->next;
	};
};

fn reference_fields_prepare(Compiler& compiler, Scope* scope, Type* type, ReferencePath* path, Syntax* body, Token token) {
	if (!type || compiler.result == compilation_result::failure || !type_has_reference((Type*)type)) {
		return;
	};
	if (reference_whole_prepare(@compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)body)) {
		return;
	};
	Syntax* statement = nullptr;
	if (type->kind == type_kind::reference) {
		compiler_error(@compiler, token, "object requires an initializer binding every reference field\0");
		return;
	};
	if (type->kind == type_kind::array) {
		ReferencePath element;
		@element.kind = syntax_kind::expr_index;
		@element.parent := path;
		usize index = 0;
		while (index < type->data.array.count && compiler.result != compilation_result::failure) {
			@element.data.index := index;
			reference_fields_prepare(@compiler, (Scope*)scope, (Type*)type->data.array.element, &element, (Syntax*)body, Token(token));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	entity_resolve(@compiler, (Entity*)type->data.entity);
	if (type->data.entity->kind == entity_kind::kw_union) {
		if (body) {
			@statement := body->data.statements;
		};
		while (statement) {
			if ((statement->kind == syntax_kind::expr_binary || statement->kind == syntax_kind::stmt_initialize) && (statement->data.binary.operation == token_kind::op_assign || statement->data.binary.operation == token_kind::op_copy)) {
				Field* field := type->data.entity->data.aggregate.fields;
				while (field) {
					ReferencePath member;
					@member.kind = syntax_kind::expr_member;
					@member.parent := path;
					@member.data.entity := field->entity;
					if (reference_path_contains(@compiler, (Scope*)scope, &member, (Syntax*)statement->data.binary.left)) {
						reference_fields_prepare(@compiler, (Scope*)scope, entity_type((Entity*)field->entity), &member, (Syntax*)body, Token(token));
						return;
					};
					@field := field->next;
				};
			};
			@statement := statement->next;
		};
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, (Entity*)type->data.entity);
	SubobjectVisit* visited = nullptr;
	reference_subobjects_prepare(@compiler, $scope, (Subobject*)graph->root, $path, $body, token, &visited);
};

fn object_initializer_prepare(Compiler& compiler, Scope* scope, Entity* variable, Syntax* body, Token token) {
	Type* type := entity_type((Entity*)variable);
	layout_validate(@compiler, (Type*)type, nullptr, token);
	if (compiler.result == compilation_result::failure) {
		return;
	};
	Syntax* whole = nullptr;
	if (body) {
		@whole := body->data.statements;
	};
	while (whole) {
		Syntax* target = nullptr;
		if (whole->kind == syntax_kind::expr_binary || whole->kind == syntax_kind::stmt_initialize) {
			@target = syntax_unaccess((Syntax*)whole->data.binary.left);
		};
		if (target && (whole->data.binary.operation == token_kind::op_assign || whole->data.binary.operation == token_kind::op_copy) && target->kind == syntax_kind::expr_name && token_same(target->token, variable->name)) {
			@whole->kind = syntax_kind::stmt_initialize;
			@target->entity := variable;
			return;
		};
		@whole := whole->next;
	};
	if (!type_has_reference((Type*)type)) {
		return;
	};
	ReferencePath root;
	@root.kind = syntax_kind::expr_name;
	@root.data.entity = $variable;
	reference_fields_prepare(@compiler, $scope, $type, &root, $body, $token);
};

fn syntax_base_count(Syntax* syntax) -> usize {
	if (syntax->kind != syntax_kind::expr_base_reference) {
		return 0;
	};
	usize count = syntax_base_count((Syntax*)syntax->data.base_conversion.value);
	BasePath* path := syntax->data.base_conversion.path;
	while (path) {
		@count = count + 1;
		@path := path->next;
	};
	return $count;
};

fn syntax_base_at(Syntax* syntax, usize index) -> BaseRelation* {
	if (syntax->kind != syntax_kind::expr_base_reference) {
		return nullptr;
	};
	usize before = syntax_base_count((Syntax*)syntax->data.base_conversion.value);
	if (index < before) {
		return syntax_base_at((Syntax*)syntax->data.base_conversion.value, (u64)index);
	};
	@index = index - before;
	BasePath* path := syntax->data.base_conversion.path;
	while (path && index) {
		@path := path->next;
		@index = index - 1;
	};
	if (!path) {
		return nullptr;
	};
	return (BaseRelation*)path->relation;
};

fn syntax_base_root(Syntax* syntax) -> Syntax* {
	while (syntax->kind == syntax_kind::expr_base_reference) {
		@syntax := syntax->data.base_conversion.value;
	};
	return $syntax;
};

fn storage_root_entity(Syntax* syntax) -> Entity* {
	while (syntax) {
		if (syntax->kind == syntax_kind::expr_access) {
			@syntax := syntax->data.expression;
		}
		else if (syntax->kind == syntax_kind::expr_base_reference) {
			@syntax := syntax->data.base_conversion.value;
		}
		else if (syntax->kind == syntax_kind::expr_member && syntax->token.kind != token_kind::op_arrow) {
			@syntax := syntax->data.member.object;
		}
		else if (syntax->kind == syntax_kind::expr_index && syntax->data.binary.left->type->kind == type_kind::array) {
			@syntax := syntax->data.binary.left;
		}
		else {
			break;
		};
	};
	if (!syntax || syntax->kind != syntax_kind::expr_name) {
		return nullptr;
	};
	return (Entity*)syntax->entity;
};

fn reference_storage_same(Compiler& compiler, Scope* scope, Syntax* first, Syntax* second) -> bool {
	while (first && first->kind == syntax_kind::expr_access) {
		@first := first->data.expression;
	};
	while (second && second->kind == syntax_kind::expr_access) {
		@second := second->data.expression;
	};
	if (!first || !second) {
		return false;
	};
	if (first->kind == syntax_kind::expr_base_reference || second->kind == syntax_kind::expr_base_reference) {
		Syntax* root = syntax_base_root((Syntax*)first);
		Syntax* other = syntax_base_root((Syntax*)second);
		Type* type = type_effective((Type*)root->type);
		if (!type || type->kind != type_kind::named || !type_equal((Type*)type, type_effective((Type*)other->type))) {
			return false;
		};
		CompleteGraph* graph = complete_graph(@compiler, (Entity*)type->data.entity);
		Subobject* left := graph->root;
		Subobject* right := graph->root;
		usize index = 0;
		while (index < syntax_base_count((Syntax*)first)) {
			@left = subobject_edge((Subobject*)left, syntax_base_at((Syntax*)first, (u64)index));
			@index = index + 1;
		};
		@index = 0;
		while (index < syntax_base_count((Syntax*)second)) {
			@right = subobject_edge((Subobject*)right, syntax_base_at((Syntax*)second, (u64)index));
			@index = index + 1;
		};
		if (left != right) {
			return false;
		};
		return reference_storage_same(@compiler, (Scope*)scope, syntax_base_root((Syntax*)first), syntax_base_root((Syntax*)second));
	};
	if (first->kind != second->kind) {
		return false;
	};
	if (first->kind == syntax_kind::expr_name) {
		return first->entity == second->entity;
	};
	if (first->kind == syntax_kind::expr_member) {
		return first->entity == second->entity && reference_storage_same(@compiler, (Scope*)scope, (Syntax*)first->data.member.object, (Syntax*)second->data.member.object);
	};
	if (first->kind == syntax_kind::expr_index) {
		return constant_integer(@compiler, (Scope*)scope, (Syntax*)first->data.binary.right) == constant_integer(@compiler, (Scope*)scope, (Syntax*)second->data.binary.right) && reference_storage_same(@compiler, (Scope*)scope, (Syntax*)first->data.binary.left, (Syntax*)second->data.binary.left);
	};
	return false;
};

fn reference_storage_contains(Compiler& compiler, Scope* scope, Syntax* parent, Syntax* storage) -> bool {
	while (storage) {
		if (storage->kind == syntax_kind::expr_access) {
			@storage := storage->data.expression;
			continue;
		};
		if (reference_storage_same(@compiler, (Scope*)scope, (Syntax*)parent, (Syntax*)storage)) {
			return true;
		};
		if (storage->kind == syntax_kind::expr_member) {
			@storage := storage->data.member.object;
		}
		else if (storage->kind == syntax_kind::expr_index) {
			@storage := storage->data.binary.left;
		}
		else if (storage->kind == syntax_kind::expr_base_reference) {
			@storage := storage->data.base_conversion.value;
		}
		else {
			break;
		};
	};
	return false;
};

fn Semantic::reference_read_validate(Semantic& this, Syntax* storage) {
	if (storage->token.kind == token_kind::op_arrow) {
		return;
	};
	Syntax* object := storage->data.member.object;
	while (object->kind == syntax_kind::expr_member || object->kind == syntax_kind::expr_index || object->kind == syntax_kind::expr_name || object->kind == syntax_kind::expr_base_reference) {
		if (object->kind == syntax_kind::expr_base_reference) {
			@object := object->data.base_conversion.value;
			continue;
		};
		Type* type = syntax_storage_type((Syntax*)object);
		if ((type && type->kind == type_kind::reference) || (object->kind == syntax_kind::expr_member && object->token.kind == token_kind::op_arrow)) {
			return;
		};
		if (object->kind == syntax_kind::expr_member) {
			@object := object->data.member.object;
		}
		else if (object->kind == syntax_kind::expr_index) {
			@object := object->data.binary.left;
		}
		else {
			break;
		};
	};
	Scope* scope := this.scope;
	while (scope) {
		if ((scope->context == context_kind::initialization || scope->context == context_kind::arguments) && scope->owner && scope->owner->kind == entity_kind::variable && scope->owner->declaration) {
			Syntax* body := scope->owner->declaration;
			if (body->kind == syntax_kind::node_declaration) {
				@body := body->data.declaration.body;
			};
			Syntax* root := storage;
			while (root->kind == syntax_kind::expr_member || root->kind == syntax_kind::expr_index || root->kind == syntax_kind::expr_base_reference) {
				if (root->kind == syntax_kind::expr_base_reference) {
					@root := root->data.base_conversion.value;
				}
				else if (root->kind == syntax_kind::expr_member) {
					@root := root->data.member.object;
				}
				else {
					@root := root->data.binary.left;
				};
			};
			if (root->kind != syntax_kind::expr_name || root->entity != scope->owner) {
				return;
			};
			Syntax* statement := body->data.statements;
			while (statement) {
				if (statement->kind == syntax_kind::stmt_bind_reference && reference_storage_same(@*this.compiler, (Scope*)this.scope, (Syntax*)statement->data.binary.left, (Syntax*)storage)) {
					return;
				};
				if (statement->kind == syntax_kind::stmt_initialize && statement->type && reference_storage_contains(@*this.compiler, (Scope*)this.scope, (Syntax*)statement->data.binary.left, (Syntax*)storage)) {
					return;
				};
				@statement := statement->next;
			};
			compiler_error(@*this.compiler, storage->token, "reference field must be bound before use\0");
			return;
		};
		@scope := scope->parent;
	};
};

fn Semantic::move(Semantic& this, Syntax* syntax) {
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	if (storage_borrowed((Syntax*)syntax)) {
		compiler_error(@*this.compiler, syntax->token, "cannot move a borrowed value\0");
		return;
	};
	while (syntax->kind == syntax_kind::expr_cast || syntax->kind == syntax_kind::expr_base_pointer) {
		if (syntax->kind == syntax_kind::expr_base_pointer) {
			@syntax := syntax->data.base_conversion.value;
		}
		else {
			@syntax := syntax->data.cast.value;
		};
	};
	if (storage_borrowed((Syntax*)syntax)) {
		compiler_error(@*this.compiler, syntax->token, "cannot move a borrowed value\0");
		return;
	};

	if (syntax->kind != syntax_kind::expr_name || !syntax->entity || syntax->entity->kind != entity_kind::variable || syntax->entity->data.variable.storage == storage_kind::constant) {
		return;
	};

};

fn syntax_base_conversion(Compiler& compiler, Syntax* syntax, Type* target, BasePath* path, base_direction direction) {
	Syntax* original = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
	@*original := *syntax;
	@original->next = nullptr;
	if (target->kind == type_kind::reference) {
		@syntax->kind = syntax_kind::expr_base_reference;
		@syntax->type := target->data.element;
	}
	else {
		@syntax->kind = syntax_kind::expr_base_pointer;
		@syntax->type := target;
	};
	@syntax->entity = nullptr;
	@syntax->data.base_conversion.value = $original;
	@syntax->data.base_conversion.target = $target;
	@syntax->data.base_conversion.path = $path;
	@syntax->data.base_conversion.direction = $direction;
	@syntax->data.base_conversion.request = base_conversion_request::implicit_conversion;
};

fn Semantic::base_conversion(Semantic& this, Syntax* syntax, Type* actual, Type* expected) -> bool {
	Type* source := actual;
	Type* target := expected->data.element;
	if (expected->kind == type_kind::pointer) {
		if (actual->kind != type_kind::pointer) {
			return false;
		};
		@source := actual->data.element;
	}
	else if (syntax_category((Syntax*)syntax) != value_category::storage) {
		return false;
	};
	BaseSearch result = base_search(@*this.compiler, $source, $target);
	if (result.count > 1) {
		compiler_error(@*this.compiler, syntax->token, "ambiguous base subobject conversion\0");
		return false;
	};
	if (!result.count) {
		return false;
	};
	syntax_base_conversion(@*this.compiler, $syntax, $expected, (BasePath*)result.path, base_direction::up);
	return true;
};

fn Semantic::expect(Semantic& this, Syntax* syntax, Type* actual, Type* expected) -> Type* {
	if (expected && actual && expected->kind == type_kind::reference) {
		if (expected->data.element->qualifier == type_qualifier::kw_const && type_pointer_conversion((Type*)actual, (Type*)expected->data.element)) {
			return $expected;
		};
		if (expected->data.element->qualifier != type_qualifier::kw_const && !syntax_mutable_access((Syntax*)syntax) && actual->kind != type_kind::function) {
			compiler_error(@*this.compiler, syntax->token, "mutable reference requires explicit '@' access\0");
		};
		if (type_value_equal((Type*)actual, (Type*)expected->data.element) && (syntax_category((Syntax*)syntax) == value_category::storage || expected->data.element->qualifier == type_qualifier::kw_const || actual->kind == type_kind::function)) {
			return $expected;
		};
	};
	if (expected && actual && !type_value_equal((Type*)actual, (Type*)expected)) {
		if ((expected->kind == type_kind::kw_bool && type_scalar((Type*)actual)) || (actual->kind == type_kind::kw_bool && type_numeric((Type*)expected))) {
			return $expected;
		};
		if ((expected->kind == type_kind::reference || expected->kind == type_kind::pointer) && @this.base_conversion((Syntax*)syntax, (Type*)actual, (Type*)expected)) {
			return $expected;
		};
		if (actual->kind == type_kind::pointer && expected->kind == type_kind::pointer) {
			if (type_null_pointer((Type*)actual)) {
				return $expected;
			};
			if (actual->data.element->qualifier == type_qualifier::kw_const && expected->data.element->qualifier != type_qualifier::kw_const) {
				compiler_error(@*this.compiler, syntax->token, "pointer conversion cannot discard const qualification\0");
				return $actual;
			};
			if (type_pointer_conversion((Type*)actual, (Type*)expected)) {
				return $expected;
			};
		};
		compiler_error(@*this.compiler, syntax->token, "expression type does not match its destination\0");
	};
	return $actual;
};

fn Semantic::base_cast(Semantic& this, Syntax* syntax, Syntax* value, Type* source, Type* target) -> bool {
	Type* actual := source;
	if (target->kind == type_kind::pointer) {
		if (source->kind != type_kind::pointer) {
			return false;
		};
		@actual := source->data.element;
	}
	else if (syntax_category((Syntax*)value) != value_category::storage) {
		compiler_error(@*this.compiler, syntax->token, "reference cast requires an existing referent\0");
		return false;
	};
	Type* destination := target->data.element;
	BaseSearch up = base_search(@*this.compiler, (Type*)actual, (Type*)destination);
	BaseSearch down;
	if (!up.count) {
		@down = base_search(@*this.compiler, (Type*)destination, (Type*)actual);
	};
	if (up.count > 1 || down.count > 1) {
		compiler_error(@*this.compiler, syntax->token, "ambiguous base subobject cast\0");
		return false;
	};
	if (!up.count && !down.count) {
		return false;
	};
	base_direction direction = base_direction::up;
	BasePath* path := up.path;
	if (down.count) {
		if (base_path_virtual((BasePath*)down.path)) {
			compiler_error(@*this.compiler, syntax->token, "downcast through a virtual base is invalid\0");
			return false;
		};
		@direction = base_direction::down;
		@path := down.path;
	};
	@syntax->data.base_conversion.value = $value;
	@syntax->data.base_conversion.target := target;
	@syntax->data.base_conversion.path = $path;
	@syntax->data.base_conversion.direction = $direction;
	@syntax->data.base_conversion.request = base_conversion_request::explicit_conversion;
	if (target->kind == type_kind::reference) {
		@syntax->kind = syntax_kind::expr_base_reference;
		@syntax->type := target->data.element;
	}
	else {
		@syntax->kind = syntax_kind::expr_base_pointer;
		@syntax->type = (Type*)target;
	};
	return true;
};

fn Semantic::member_project(Semantic& this, Syntax* member, Type* source, Type* target) -> Type* {
	if (type_value_equal((Type*)source, (Type*)target)) {
		return $source;
	};
	@target = type_qualified(@*this.compiler, (Type*)target, (type_qualifier)source->qualifier);
	Type* expected = nullptr;
	if (member->token.kind == token_kind::op_arrow) {
		@expected = type_pointer(@*this.compiler, (Type*)target);
	}
	else {
		@expected = type_indirect(@*this.compiler, type_kind::reference, (Type*)target);
	};
	if (!@this.base_conversion((Syntax*)member->data.member.object, (Type*)member->data.member.object->type, (Type*)expected)) {
		compiler_error(@*this.compiler, member->token, "member owner is not an unambiguous base of its receiver\0");
	};
	return (Type*)expected->data.element;
};

fn Semantic::member_object(Semantic& this, Syntax* member) -> Type* {
	Type* object = @this.expression((Syntax*)member->data.member.object, nullptr);
	if (member->token.kind == token_kind::op_arrow) {
		if (object->kind != type_kind::pointer) {
			compiler_error(@*this.compiler, member->token, "arrow member access requires a pointer\0");
			return (Type*)this.compiler->void_type;
		};
		@object := object->data.element;
	};
	if (!member->data.member.qualifier) {
		return $object;
	};
	Type* owner = named_type(@*this.compiler, (Scope*)this.scope, (Syntax*)member->data.member.qualifier);
	if (owner->kind != type_kind::named || (owner->data.entity->kind != entity_kind::kw_struct && owner->data.entity->kind != entity_kind::kw_union)) {
		compiler_error(@*this.compiler, member->token, "qualified instance access requires a record type\0");
		return (Type*)this.compiler->void_type;
	};
	return @this.member_project($member, $object, $owner);
};

fn Semantic::method_receiver(Semantic& this, Syntax* member) -> Syntax* {
	Syntax* receiver := member->data.member.object;
	Type* type = @this.expression((Syntax*)receiver, nullptr);
	if (member->token.kind != token_kind::op_arrow) {
		return $receiver;
	};
	if (type->kind != type_kind::pointer) {
		compiler_error(@*this.compiler, member->token, "arrow member access requires a pointer\0");
		return $receiver;
	};
	Syntax* object = (Syntax*)memory_allocate(@*this.compiler, sizeof(Syntax));
	@object->kind = syntax_kind::expr_unary;
	@object->token := member->token;
	@object->data.unary.operation = token_kind::op_star;
	@object->data.unary.value = $receiver;
	@object->type = type_effective((Type*)type->data.element);
	return $object;
};

fn Semantic::receiver_callable(Semantic& this, Type* type, Token name) -> Entity* {
	Entity* associated = nullptr;
	if (type->kind == type_kind::named && (type->data.entity->kind == entity_kind::kw_struct || type->data.entity->kind == entity_kind::kw_union || type->data.entity->kind == entity_kind::kw_enum)) {
		entity_resolve(@*this.compiler, (Entity*)type->data.entity);
		@associated = associated_lookup(@*this.compiler, (Entity*)type->data.entity, name);
	};
	if (associated) {
		return $associated;
	};
	Entity* lexical = scope_lookup((Scope*)this.scope, name);
	if (!lexical || lexical->kind != entity_kind::function) {
		return nullptr;
	};
	entity_resolve(@*this.compiler, (Entity*)lexical);
	Parameter* first := lexical->data.function.type->data.function.parameters;
	if (!first || !function_receiver((Entity*)lexical)) {
		return nullptr;
	};
	return $lexical;
};

fn template_argument_slot(TemplateParameter* parameters, TemplateArgument* arguments, TemplateParameter* parameter) -> TemplateArgument* {
	while (parameters && arguments) {
		if (parameters == parameter) {
			return arguments;
		};
		@parameters := parameters->next;
		@arguments := arguments->next;
	};
	return nullptr;
};

fn parameter_use_type(ParameterUse* use) -> TypeUse* {
	if (!use) {
		return nullptr;
	};
	return (TypeUse*)use->use;
};

fn template_unify(Compiler& compiler, Type* pattern, Type* actual, TypeUse* actual_use, TemplateParameter* parameters, TemplateArgument* arguments) -> bool {
	if (!pattern || !actual) {
		return false;
	};
	if (pattern->kind == type_kind::reference) {
		if (actual->kind == type_kind::reference) {
			@actual := actual->data.element;
			@actual_use = type_use_child((TypeUse*)actual_use);
		};
		return template_unify(@compiler, (Type*)pattern->data.element, (Type*)actual, (TypeUse*)actual_use, (TemplateParameter*)parameters, (TemplateArgument*)arguments);
	};
	if (pattern->kind == type_kind::parameter) {
		TemplateArgument* argument = template_argument_slot((TemplateParameter*)parameters, (TemplateArgument*)arguments, (TemplateParameter*)pattern->data.entity->template_parameter);
		if (!argument) {
			return false;
		};
		if (pattern->qualifier == type_qualifier::kw_const) {
			@actual = type_qualified(@compiler, (Type*)actual, type_qualifier::mutable);
		};
		if (argument->type) {
			return type_equal((Type*)argument->type, (Type*)actual);
		};
		@argument->type := actual;
		@argument->type_use = $actual_use;
		return true;
	};
	if (pattern->kind != actual->kind) {
		return false;
	};
	if (pattern->kind == type_kind::pointer) {
		return template_unify(@compiler, (Type*)pattern->data.element, (Type*)actual->data.element, type_use_child((TypeUse*)actual_use), (TemplateParameter*)parameters, (TemplateArgument*)arguments);
	};
	if (pattern->kind == type_kind::function) {
		if (pattern->data.function.arity != actual->data.function.arity || !template_unify(@compiler, (Type*)pattern->data.function.result, (Type*)actual->data.function.result, type_use_result((TypeUse*)actual_use), (TemplateParameter*)parameters, (TemplateArgument*)arguments)) {
			return false;
		};
		Parameter* first := pattern->data.function.parameters;
		Parameter* second := actual->data.function.parameters;
		ParameterUse* label = type_use_parameters((TypeUse*)actual_use);
		while (first && second) {
			if (!template_unify(@compiler, (Type*)first->type, (Type*)second->type, parameter_use_type((ParameterUse*)label), (TemplateParameter*)parameters, (TemplateArgument*)arguments)) {
				return false;
			};
			@first := first->next;
			@second := second->next;
			if (label) {
				@label := label->next;
			};
		};
		return !first && !second;
	};
	if (pattern->kind == type_kind::array) {
		return pattern->data.array.count == actual->data.array.count && template_unify(@compiler, (Type*)pattern->data.array.element, (Type*)actual->data.array.element, type_use_child((TypeUse*)actual_use), (TemplateParameter*)parameters, (TemplateArgument*)arguments);
	};
	if (pattern->kind == type_kind::named && pattern->data.entity->specialization && actual->data.entity->specialization && pattern->data.entity->template_origin == actual->data.entity->template_origin) {
		TemplateArgument* formal := pattern->data.entity->specialization->arguments;
		TemplateArgument* concrete := actual->data.entity->specialization->arguments;
		while (formal && concrete) {
			if (formal->kind != concrete->kind) {
				return false;
			};
			if (formal->kind == template_parameter_kind::type) {
				if (!template_unify(@compiler, (Type*)formal->type, (Type*)concrete->type, (TypeUse*)concrete->type_use, (TemplateParameter*)parameters, (TemplateArgument*)arguments)) {
					return false;
				};
			}
			else if (formal->parameter) {
				TemplateArgument* argument = template_argument_slot((TemplateParameter*)parameters, (TemplateArgument*)arguments, (TemplateParameter*)formal->parameter);
				if (!argument || (argument->type && argument->value != concrete->value)) {
					return false;
				};
				@argument->type := concrete->type;
				@argument->value := concrete->value;
			}
			else if (formal->value != concrete->value) {
				return false;
			};
			@formal := formal->next;
			@concrete := concrete->next;
		};
		return !formal && !concrete;
	};
	return type_value_equal((Type*)pattern, (Type*)actual);
};

fn Semantic::template_deduce(Semantic& this, Entity* pattern, Syntax* callable, Syntax* values) -> Entity* {
	Compiler& compiler = @*this.compiler;
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	Scope* scope = scope_create(@compiler, (Scope*)pattern->scope, context_kind::local, nullptr);
	TemplateArgument* arguments = nullptr;
	TemplateArgument** link = &arguments;
	TemplateArgument* explicit_argument := callable->template_arguments;
	TemplateParameter* parameter := declaration->parameters;
	while (parameter && compiler.result != compilation_result::failure) {
		TemplateArgument* argument = (TemplateArgument*)memory_allocate(@compiler, sizeof(TemplateArgument));
		@argument->kind := parameter->kind;
		if (explicit_argument) {
			@*argument := *explicit_argument;
			@argument->next = nullptr;
			@explicit_argument := explicit_argument->next;
		};
		@*link := argument;
		@link = &argument->next;
		Entity* binding = entity_create(@compiler, entity_kind::primitive, Token(parameter->name));
		@binding->state = resolution::ready;
		@binding->template_parameter := parameter;
		if (parameter->kind == template_parameter_kind::type) {
			Type* type := argument->type;
			if (!type) {
				@type = type_entity(@compiler, type_kind::parameter, (Entity*)binding);
			};
			@binding->data.primitive.type := type;
			@binding->data.primitive.type_use := argument->type_use;
		}
		else {
			@binding->kind = entity_kind::variable;
			@binding->data.variable.storage = storage_kind::constant;
			@binding->data.variable.type = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)parameter->type);
			@binding->data.variable.data.integer = 1;
			if (argument->type) {
				@binding->data.variable.data.integer := argument->value;
			};
		};
		scope_define(@compiler, (Scope*)scope, $binding);
		@parameter := parameter->next;
	};
	TypeSyntax* signature = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)declaration->signature);
	if (!signature) {
		return nullptr;
	};
	ParameterSyntax* formal := signature->data.signature.parameters;
	Syntax* value := values;
	while (formal && value && compiler.result != compilation_result::failure) {
		if (!syntax_number_expression((Syntax*)value)) {
			Type* actual = @this.expression((Syntax*)value, nullptr);
			TypeUse* actual_use = @this.expression_use((Syntax*)value);
			TypeSyntax* syntax = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)formal->type);
			if (!syntax || !actual || compiler.result == compilation_result::failure) {
				return nullptr;
			};
			if (syntax->kind == type_syntax_kind::reference) {
				@syntax := syntax->data.element;
			}
			else {
				@actual = type_qualified(@compiler, (Type*)actual, type_qualifier::mutable);
			};
			if (syntax->kind == type_syntax_kind::array && syntax->data.array.count.kind == token_kind::identifier && actual->kind == type_kind::array) {
				Entity* bound = scope_lookup((Scope*)scope, syntax->data.array.count);
				if (bound && bound->template_parameter) {
					TemplateArgument* argument = template_argument_slot((TemplateParameter*)declaration->parameters, (TemplateArgument*)arguments, (TemplateParameter*)bound->template_parameter);
					if (argument && argument->type && argument->value != actual->data.array.count) {
						compiler_error(@compiler, callable->token, "conflicting non-type template argument deduction\0");
						return nullptr;
					};
					@argument->type := bound->data.variable.type;
					@argument->value := actual->data.array.count;
					@syntax := syntax->data.array.element;
					@actual := actual->data.array.element;
					@actual_use = type_use_child((TypeUse*)actual_use);
				};
			};
			Type* expected = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)syntax);
			if (!template_unify(@compiler, (Type*)expected, (Type*)actual, (TypeUse*)actual_use, (TemplateParameter*)declaration->parameters, (TemplateArgument*)arguments)) {
				compiler_error(@compiler, callable->token, "conflicting function template argument deduction\0");
				return nullptr;
			};
		};
		@formal := formal->next;
		@value := value->next;
	};
	@parameter := declaration->parameters;
	TemplateArgument* argument := arguments;
	while (parameter && argument && compiler.result != compilation_result::failure) {
		if (!argument->type && parameter->default_argument) {
			TemplateArgument* default_argument = template_argument_resolve(@compiler, (Scope*)scope, (TemplateParameter*)parameter, (ArgumentSyntax*)parameter->default_argument);
			@argument->type := default_argument->type;
			@argument->type_use := default_argument->type_use;
			@argument->value := default_argument->value;
		};
		if (!argument->type || type_dependent((Type*)argument->type)) {
			compiler_error(@compiler, callable->token, "function template argument cannot be deduced; provide it explicitly\0");
			return nullptr;
		};
		Entity* binding = scope_local((Scope*)scope, parameter->name);
		if (parameter->kind == template_parameter_kind::type) {
			@binding->data.primitive.type := argument->type;
			@binding->data.primitive.type_use := argument->type_use;
		}
		else {
			@binding->data.variable.data.integer := argument->value;
		};
		@argument := argument->next;
		@parameter := parameter->next;
	};
	return template_specialize(@compiler, (Entity*)pattern, (TemplateArgument*)arguments, callable->token);
};

fn Semantic::address(Semantic& this, Syntax* syntax) -> Type* {
	if (syntax->kind == syntax_kind::expr_access) {
		Type* type = @this.address((Syntax*)syntax->data.expression);
		if (syntax_category((Syntax*)syntax->data.expression) != value_category::storage || type->qualifier == type_qualifier::kw_const) {
			compiler_error(@*this.compiler, syntax->token, "mutable access requires mutable storage\0");
		};
		@syntax->type := type;
		return $type;
	};
	if (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star) {
		Type* pointer = @this.expression((Syntax*)syntax->data.unary.value, nullptr);
		if (pointer->kind != type_kind::pointer) {
			compiler_error(@*this.compiler, syntax->token, "dereference requires a pointer\0");
			return (Type*)this.compiler->void_type;
		};
		Type* type := pointer->data.element;
		if (type->kind == type_kind::kw_void || type->kind == type_kind::kw_null) {
			compiler_error(@*this.compiler, syntax->token, "dereference requires an object or function type\0");
		};
		@syntax->type := type;
		return $type;
	};
	return @this.expression($syntax, nullptr);
};

fn Semantic::expression(Semantic& this, Syntax* syntax, Type* expected) -> Type* {
	Compiler& compiler = @*this.compiler;
	if (!syntax) {
		return (Type*)compiler.void_type;
	};
	if (syntax->kind == syntax_kind::expr_typed_apply) {
		construction_resolve(@compiler, (Scope*)this.scope, (Syntax*)syntax);
		if (compiler.result == compilation_result::failure) {
			return (Type*)compiler.void_type;
		};
	};
	Type* target := expected;
	if (target && target->kind == type_kind::reference && target->data.element->qualifier == type_qualifier::kw_const) {
		@target := target->data.element;
	};
	if (target && target->kind == type_kind::named && (target->data.entity->kind == entity_kind::kw_struct || target->data.entity->kind == entity_kind::kw_union) && syntax->kind != syntax_kind::expr_construct) {
		Type* actual = nullptr;
		if (!syntax_number_expression((Syntax*)syntax)) {
			@actual = @this.expression((Syntax*)syntax, nullptr);
		};
		if (!actual || !type_value_equal((Type*)actual, (Type*)target)) {
			Syntax* next := syntax->next;
			@syntax->next = nullptr;
			Entity* constructor = @this.conversion_select((Entity*)target->data.entity, function_role::constructor, (Syntax*)syntax, syntax->token, constructor_conversion::kw_implicit);
			@syntax->next = $next;
			if (constructor) {
				value_use argument_use := syntax->use;
				syntax_construct(@compiler, (Syntax*)syntax, (Type*)target, nullptr);
				@syntax->data.construction.arguments->use = $argument_use;
				@syntax->use = value_use::observed;
				@syntax->data.construction.constructor = $constructor;
				Type* converted = @this.expression((Syntax*)syntax, nullptr);
				return @this.expect((Syntax*)syntax, $converted, (Type*)expected);
			};
		};
	};
	if (expected && expected->kind == type_kind::reference && syntax_number_expression((Syntax*)syntax)) {
		Type* actual = @this.expression((Syntax*)syntax, (Type*)expected->data.element);
		return @this.expect((Syntax*)syntax, $actual, (Type*)expected);
	};
	if (expected && expected->kind == type_kind::reference && (syntax->kind == syntax_kind::expr_access || (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_star))) {
		Type* actual = @this.address((Syntax*)syntax);
		return @this.expect((Syntax*)syntax, $actual, $expected);
	};
	if (syntax->type) {
		return @this.expect((Syntax*)syntax, (Type*)syntax->type, (Type*)expected);
	};
	Type* type = nullptr;
	switch (syntax->kind) {
		case syntax_kind::kw_new: {
			Syntax* construction := syntax->data.expression;
			Type* allocated = @this.expression((Syntax*)construction, nullptr);
			if (compiler.result == compilation_result::failure) {
				return (Type*)compiler.void_type;
			};
			@construction->use = value_use::transferred;
			Syntax* argument := construction->data.construction.arguments;
			while (argument) {
				if (argument->use == value_use::transferred) {
					destruction_request((Type*)argument->type);
				};
				@argument := argument->next;
			};
			if (allocated->kind == type_kind::array || allocated->kind == type_kind::kw_void || allocated->kind == type_kind::kw_null || allocated->kind == type_kind::reference || allocated->kind == type_kind::function) {
				compiler_error(@compiler, syntax->token, "new requires a complete non-array object type\0");
			};
			layout_validate(@compiler, (Type*)allocated, nullptr, syntax->token);
			@type = type_pointer(@compiler, $allocated);
			@syntax->type_use = type_use_element(@compiler, (TypeUse*)construction->data.construction.type_use);
			break;
		};
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard: {
			Type* pointer = @this.expression((Syntax*)syntax->data.expression, nullptr);
			if (pointer->kind != type_kind::pointer || pointer->data.element->kind == type_kind::function || pointer->data.element->kind == type_kind::array) {
				compiler_error(@compiler, syntax->token, "delete requires an object pointer\0");
				@type := compiler.void_type;
				break;
			};
			if (syntax->kind == syntax_kind::kw_delete && pointer->data.element->kind != type_kind::kw_null) {
				if (pointer->data.element->kind == type_kind::kw_void) {
					compiler_error(@compiler, syntax->token, "delete requires a complete object type\0");
				};
				layout_validate(@compiler, (Type*)pointer->data.element, nullptr, syntax->token);
				destruction_request((Type*)pointer->data.element);
			};
			@type := compiler.void_type;
			break;
		};
		case syntax_kind::kw_nullptr:
			@type = type_pointer(@compiler, (Type*)compiler.null_type);
			break;
		case syntax_kind::expr_destroy: {
			Type* target := syntax->data.cast.resolved;
			if (!target) {
				@target = type_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.cast.type);
			};
			Type* actual = @this.address((Syntax*)syntax->data.cast.value);
			if (target->kind != type_kind::named || (target->data.entity->kind != entity_kind::kw_struct && target->data.entity->kind != entity_kind::kw_union) || !type_value_equal((Type*)actual, (Type*)target)) {
				compiler_error(@compiler, syntax->token, "destructor type must match the object type\0");
			};
			if (syntax_category((Syntax*)syntax->data.cast.value) != value_category::storage || !syntax_mutable_access((Syntax*)syntax->data.cast.value)) {
				compiler_error(@compiler, syntax->token, "destructor invocation requires explicit '@' access to storage\0");
			};
			layout_validate(@compiler, (Type*)target, nullptr, syntax->token);
			destruction_request((Type*)target);
			@type := compiler.void_type;
			break;
		};
		case syntax_kind::kw_discard:
			@this.expression((Syntax*)syntax->data.expression, nullptr);
			if (syntax->data.expression->kind != syntax_kind::expr_name || !syntax->data.expression->entity || syntax->data.expression->entity->kind != entity_kind::variable || storage_borrowed((Syntax*)syntax->data.expression) || (syntax->data.expression->entity->data.variable.storage != storage_kind::local && syntax->data.expression->entity->data.variable.storage != storage_kind::parameter)) {
				compiler_error(@compiler, syntax->token, "discard requires a directly owned local identifier\0");
			};
			@type := compiler.void_type;
			break;
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate: {
			Syntax* operand := syntax->data.expression;
			if (syntax->kind == syntax_kind::expr_access && operand->kind == syntax_kind::expr_destroy) {
				Syntax* access = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
				@access->kind = syntax_kind::expr_access;
				@access->token := syntax->token;
				@access->data.expression := operand->data.cast.value;
				@operand->data.cast.value = $access;
				Syntax* next := syntax->next;
				@*syntax := *operand;
				@syntax->next = $next;
				return @this.expression((Syntax*)syntax, (Type*)expected);
			};
			if (syntax->kind == syntax_kind::expr_access && operand->kind == syntax_kind::expr_call && operand->data.call.callable->kind == syntax_kind::expr_member) {
				Syntax* member := operand->data.call.callable;
				Syntax* receiver = @this.method_receiver((Syntax*)member);
				Type* owner := receiver->type;
				if (member->data.member.qualifier) {
					@owner = named_type(@compiler, (Scope*)this.scope, (Syntax*)member->data.member.qualifier);
				};
				if (owner->kind == type_kind::named && (owner->data.entity->kind == entity_kind::kw_struct || owner->data.entity->kind == entity_kind::kw_union) && token_same(member->data.member.name, owner->data.entity->name)) {
					Syntax* access = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
					@access->kind = syntax_kind::expr_access;
					@access->token := syntax->token;
					@access->data.expression = $receiver;
					@member->data.member.object = $access;
					@member->token.kind = token_kind::op_dot;
					Syntax* next := syntax->next;
					@*syntax := *operand;
					@syntax->next = $next;
					return @this.expression((Syntax*)syntax, (Type*)expected);
				};
				Entity* function = @this.receiver_callable((Type*)owner, Token(member->data.member.name));
				if (function && function->kind == entity_kind::function) {
					entity_resolve(@compiler, (Entity*)function);
					Parameter* first := function->data.function.type->data.function.parameters;
					if (first && function_receiver((Entity*)function)) {
						Syntax* access = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
						@access->kind = syntax_kind::expr_access;
						@access->token := syntax->token;
						@access->data.expression = $receiver;
						@member->data.member.object = $access;
						@member->token.kind = token_kind::op_dot;
						Syntax* next := syntax->next;
						@*syntax := *operand;
						@syntax->next = $next;
						return @this.expression((Syntax*)syntax, (Type*)expected);
					};
				};
			};
			@type = @this.expression((Syntax*)operand, nullptr);
			if (syntax_category((Syntax*)operand) != value_category::storage) {
				compiler_error(@compiler, syntax->token, "reference access and relocation require an existing object\0");
			};
			if (syntax->kind == syntax_kind::expr_access && type->qualifier == type_qualifier::kw_const) {
				compiler_error(@compiler, syntax->token, "immutable object cannot provide mutable access\0");
			};
			if (syntax->kind == syntax_kind::expr_relocate && (operand->kind != syntax_kind::expr_name || !operand->entity || operand->entity->kind != entity_kind::variable || storage_borrowed((Syntax*)operand))) {
				compiler_error(@compiler, syntax->token, "relocation requires an owned local binding\0");
			};
			break;
		};
		case syntax_kind::expr_construct: {
			@type := syntax->data.construction.target;
			if (type->kind == type_kind::kw_null) {
				compiler_error(@compiler, syntax->token, "null is an unsized type and cannot be constructed\0");
				break;
			};
			Syntax* argument := syntax->data.construction.arguments;
			if (type->kind == type_kind::named && (type->data.entity->kind == entity_kind::kw_struct || type->data.entity->kind == entity_kind::kw_union || type->data.entity->kind == entity_kind::kw_enum)) {
				if (!syntax->data.construction.constructor) {
				@syntax->data.construction.constructor = @this.special_select((Entity*)type->data.entity, function_role::constructor, (Syntax*)argument, Token(syntax->token));
				};
				if (syntax->data.construction.constructor || compiler.result == compilation_result::failure) {
					if (syntax->data.construction.constructor && syntax->data.construction.constructor->data.function.definition != function_definition::defaulted) {
						@this.constructor_members_validate((Type*)type, syntax->token);
					};
					if (syntax->data.construction.constructor && type_has_reference((Type*)type)) {
						compiler_error(@compiler, syntax->token, "constructor reference-field binding syntax is not implemented\0");
					};
					break;
				};
			};
			if (!argument) {
				@this.generated_operation_validate((Type*)type, generated_operation::kw_default, syntax->token);
				break;
			};
			if (argument->next) {
				compiler_error(@compiler, syntax->token, "generated construction requires zero or one argument\0");
				break;
			};
			Type* context := type;
			if (type_enum((Type*)type)) {
				entity_resolve(@compiler, (Entity*)type->data.entity);
				@context := type->data.entity->data.enumeration.underlying;
			};
			Type* argument_context = nullptr;
			if (syntax_number_expression((Syntax*)argument)) {
				@argument_context := context;
			};
			Type* actual = @this.expression((Syntax*)argument, (Type*)argument_context);
			if (type_enum((Type*)type) && type_value_equal((Type*)actual, (Type*)type)) {
				@context := type;
			};
			if (!type_enum((Type*)actual) || ((!type_numeric((Type*)type) || !type_numeric(type_representation((Type*)actual))) && !type_value_equal((Type*)type, type_representation((Type*)actual)))) {
				@this.expect((Syntax*)argument, (Type*)actual, (Type*)context);
			};
			@this.generated_operation_validate((Type*)type, generated_operation::copy, syntax->token);
			break;
		};
		case syntax_kind::expr_name:
			if (!syntax->entity) {
				@syntax->entity = syntax_lookup((Scope*)this.scope, (Syntax*)syntax);
			};
			if (!syntax->entity) {
				compiler_error(@compiler, syntax->token, "unknown identifier\0");
				return (Type*)compiler.void_type;
			};
			if (syntax->entity->kind != entity_kind::variable && syntax->entity->kind != entity_kind::function) {
				compiler_error(@compiler, syntax->token, "type entity is not a runtime value\0");
				return (Type*)compiler.void_type;
			};
			entity_resolve(@compiler, (Entity*)syntax->entity);
			if (syntax->entity->kind == entity_kind::function) {
				function_request((Entity*)syntax->entity);
			};
			if (syntax->entity->kind == entity_kind::function && syntax->entity->data.function.definition == function_definition::deleted) {
				compiler_error(@compiler, syntax->token, "selected function is deleted\0");
			};
			if (syntax->entity->kind == entity_kind::variable && syntax->entity->data.variable.storage == storage_kind::field) {
				Token name := syntax->token;
				Entity* receiver = scope_lookup((Scope*)this.scope, token_synthetic(@compiler, Token(name), "this\0"));
				if (!receiver || receiver->kind != entity_kind::variable) {
					compiler_error(@compiler, name, "field access requires an instance receiver\0");
					return (Type*)compiler.void_type;
				};
				Syntax* object = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
				@object->kind = syntax_kind::expr_name;
				@object->token := receiver->name;
				@object->entity = (Entity*)receiver;
				@syntax->kind = syntax_kind::expr_member;
				@syntax->data.member.object = (Syntax*)object;
				@syntax->data.member.name = Token(name);
				return @this.expression((Syntax*)syntax, (Type*)expected);
			};
			@type = type_effective(entity_type((Entity*)syntax->entity));
			break;
		case syntax_kind::literal_number:
			if (expected && expected->kind == type_kind::pointer && syntax_zero_pointer_constant((Syntax*)syntax)) {
				@type := expected;
				break;
			};
			if (!expected || !type_numeric((Type*)expected)) {
				compiler_error(@compiler, syntax->token, "number literal requires a numeric destination type\0");
				return (Type*)compiler.void_type;
			};
			@type := expected;
			if (type_integer((Type*)type) && type->kind != type_kind::kw_bool && number_decimal(syntax->token)) {
				decimal_integer(@compiler, syntax->token, (Type*)type, false);
			}
			else if (type_integer((Type*)type) && type->kind != type_kind::kw_bool) {
				u64 maximum = 18446744073709551615;
				i32 bits = type_bits((Type*)type);
				if (bits < 64) {
					@maximum = 1;
					i32 bit = 0;
					while (bit < bits) {
						@maximum = maximum * 2;
						@bit = bit + 1;
					};
					@maximum = maximum - 1;
				};
				if (!type_unsigned((Type*)type) && type->kind != type_kind::kw_char) {
					@maximum = maximum / 2;
				};
				integer_spelling(@compiler, syntax->token, (u64)maximum);
			};
			break;
		case syntax_kind::literal_string:
			@type = type_pointer(@compiler, (Type*)compiler.char_type);
			break;
		case syntax_kind::expr_cast: {
			@type := syntax->data.cast.resolved;
			if (syntax->data.cast.type) {
				@type = type_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.cast.type);
				@syntax->data.cast.resolved := type;
				@syntax->data.cast.type_use = type_use_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.cast.type);
			};
			if (type->kind == type_kind::reference) {
				Syntax* value := syntax->data.cast.value;
				Type* source = @this.expression((Syntax*)value, nullptr);
				if (@this.base_cast((Syntax*)syntax, (Syntax*)value, (Type*)source, (Type*)type)) {
					@type := syntax->type;
				}
				else {
					@this.expect((Syntax*)value, (Type*)source, (Type*)type);
				};
				break;
			};
			Type* source = nullptr;
			if (syntax_number_expression((Syntax*)syntax->data.cast.value)) {
				Type* context := type;
				if (type->kind == type_kind::pointer) {
					@context := compiler.usize_type;
				};
				if (type_enum((Type*)type)) {
					entity_resolve(@compiler, (Entity*)type->data.entity);
					@context := type->data.entity->data.enumeration.underlying;
				};
				@source = @this.expression((Syntax*)syntax->data.cast.value, (Type*)context);
			}
			else {
				@source = @this.expression((Syntax*)syntax->data.cast.value, nullptr);
			};
			if (source->kind == type_kind::named || source->kind == type_kind::array) {
				layout_validate(@compiler, (Type*)source, nullptr, syntax->token);
			};
			if (type->kind == type_kind::pointer && source->kind == type_kind::pointer && @this.base_cast((Syntax*)syntax, (Syntax*)syntax->data.cast.value, (Type*)source, (Type*)type)) {
				break;
			};
			if ((!type_scalar((Type*)type) && !type_enum((Type*)type)) || (!type_scalar((Type*)source) && !type_enum((Type*)source))) {
				if (!type_value_equal(type_representation((Type*)type), type_representation((Type*)source))) {
				compiler_error(@compiler, syntax->token, "cast requires scalar types\0");
				};
			};
			if (((type->kind == type_kind::pointer || type->kind == type_kind::reference) && source->kind == type_kind::kw_float) || ((source->kind == type_kind::pointer || source->kind == type_kind::reference) && type->kind == type_kind::kw_float)) {
				compiler_error(@compiler, syntax->token, "pointer casts require an integer or pointer counterpart\0");
			};
			break;
		};
		case syntax_kind::kw_sizeof: {
			Type* measured = nullptr;
			if (syntax->data.sizeof_operand.type) {
				@measured = type_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.sizeof_operand.type);
			}
			else {
				@measured = @this.expression((Syntax*)syntax->data.sizeof_operand.value, nullptr);
			};
			@measured = type_effective((Type*)measured);
			@syntax->data.sizeof_operand.measured := measured;
			if (!measured || measured->kind == type_kind::kw_void || measured->kind == type_kind::kw_null || measured->kind == type_kind::function) {
				compiler_error(@compiler, syntax->token, "sizeof requires a storage type\0");
			};
			layout_validate(@compiler, $measured, nullptr, syntax->token);
			@type := compiler.usize_type;
			break;
		};
		case syntax_kind::expr_member: {
			Entity* owner = syntax_lookup((Scope*)this.scope, (Syntax*)syntax->data.member.object);
			if (owner && (owner->kind == entity_kind::kw_enum || owner->kind == entity_kind::kw_struct || owner->kind == entity_kind::kw_union || owner->kind == entity_kind::kw_namespace)) {
				entity_resolve(@compiler, (Entity*)owner);
				Entity* member = associated_lookup(@compiler, (Entity*)owner, syntax->data.member.name);
				if (!member) {
					compiler_error(@compiler, syntax->data.member.name, "unknown member of this entity\0");
					return (Type*)compiler.void_type;
				};
				@syntax->token := syntax->data.member.name;
				@syntax->data.expression = nullptr;
				@syntax->entity = $member;
				@syntax->kind = syntax_kind::expr_name;
				return @this.expression((Syntax*)syntax, (Type*)expected);
			};
			Type* object = @this.member_object((Syntax*)syntax);
			if (object->kind != type_kind::named || (object->data.entity->kind != entity_kind::kw_struct && object->data.entity->kind != entity_kind::kw_union)) {
				compiler_error(@compiler, syntax->token, "member access requires a record\0");
				return (Type*)compiler.void_type;
			};
			entity_resolve(@compiler, (Entity*)object->data.entity);
			layout_validate(@compiler, (Type*)object, nullptr, syntax->token);
			if (compiler.result == compilation_result::failure) {
				return (Type*)compiler.void_type;
			};
			@syntax->entity = associated_lookup(@compiler, (Entity*)object->data.entity, syntax->data.member.name);
			if (!syntax->entity) {
				compiler_error(@compiler, syntax->data.member.name, "unknown record field\0");
				return (Type*)compiler.void_type;
			};
			if (syntax->entity->kind == entity_kind::variable && syntax->entity->data.variable.storage == storage_kind::field) {
				@this.member_project((Syntax*)syntax, (Type*)object, entity_type((Entity*)syntax->entity->data.variable.data.field.owner));
			};
			if (syntax->entity->kind != entity_kind::variable || syntax->entity->data.variable.storage != storage_kind::field) {
				compiler_error(@compiler, syntax->token, "associated declaration is not instance field storage\0");
				return (Type*)compiler.void_type;
			};
			if (entity_type((Entity*)syntax->entity)->kind == type_kind::reference) {
				@this.reference_read_validate((Syntax*)syntax);
			};
			@type = type_effective(entity_type((Entity*)syntax->entity));
			if (object->qualifier == type_qualifier::kw_const && entity_type((Entity*)syntax->entity)->kind != type_kind::reference) {
				@type = type_qualified(@compiler, (Type*)type, type_qualifier::kw_const);
			};
			break;
		};
		case syntax_kind::expr_index: {
			Type* object = @this.expression((Syntax*)syntax->data.binary.left, nullptr);
			Type* index_context = nullptr;
			if (syntax_number_expression((Syntax*)syntax->data.binary.right)) {
				@index_context := compiler.usize_type;
			};
			Type* index = @this.expression((Syntax*)syntax->data.binary.right, (Type*)index_context);
			if (!type_integer((Type*)index)) {
				compiler_error(@compiler, syntax->token, "index requires an integer\0");
			};
			if (object->kind == type_kind::array) {
				@type := object->data.array.element;
				if (object->qualifier == type_qualifier::kw_const) {
					@type = type_qualified(@compiler, (Type*)type, type_qualifier::kw_const);
				};
			}
			else if (object->kind == type_kind::pointer) {
				@type := object->data.element;
			}
			else {
				compiler_error(@compiler, syntax->token, "index requires an array or pointer\0");
				@type := compiler.void_type;
			};
			layout_validate(@compiler, (Type*)type, nullptr, syntax->token);
			break;
		};
		case syntax_kind::expr_unary: {
			token_kind operation := syntax->data.unary.operation;
			Type* context := expected;
			if (context && context->kind == type_kind::kw_bool && !syntax_number_expression((Syntax*)syntax->data.unary.value) && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				@context = type_primitive(@compiler, type_kind::kw_float, 64);
			};
			if (operation == token_kind::op_ampersand || operation == token_kind::op_star) {
				@context = nullptr;
			};
			if (operation == token_kind::op_bang) {
				@context := compiler.bool_type;
			};
			Type* operand = nullptr;
			if (operation == token_kind::op_minus && syntax->data.unary.value->kind == syntax_kind::literal_number && context && type_integer((Type*)context) && context->kind != type_kind::kw_bool && number_decimal(syntax->data.unary.value->token)) {
				decimal_integer(@compiler, syntax->data.unary.value->token, (Type*)context, true);
				@syntax->data.unary.value->type := context;
				@operand := context;
			}
			else if (operation == token_kind::op_minus && syntax->data.unary.value->kind == syntax_kind::literal_number && context && context->kind == type_kind::kw_signed) {
				Type* magnitude = type_primitive(@compiler, type_kind::kw_unsigned, (i32)context->data.bits);
				@this.expression((Syntax*)syntax->data.unary.value, (Type*)magnitude);

				u64 maximum = 1;
				i32 bit = 1;
				while (bit < context->data.bits) {
					@maximum = maximum * 2;
					@bit = bit + 1;
				};
				integer_spelling(@compiler, syntax->data.unary.value->token, (u64)maximum);
				@syntax->data.unary.value->type := context;
				@operand = (Type*)context;
			}
			else if (operation == token_kind::op_ampersand) {
				@operand = @this.address((Syntax*)syntax->data.unary.value);
			}
			else {
				@operand = @this.expression((Syntax*)syntax->data.unary.value, (Type*)context);
			};
			if (operation == token_kind::op_ampersand) {
				if (syntax_category((Syntax*)syntax->data.unary.value) != value_category::storage && operand->kind != type_kind::function) {
					compiler_error(@compiler, syntax->token, "address-of requires storage or a function entity\0");
				};
				@type = type_pointer(@compiler, (Type*)operand);
				@syntax->type_use = type_use_element(@compiler, @this.expression_use((Syntax*)syntax->data.unary.value));
			}
			else if (operation == token_kind::op_star) {
				if (operand->kind != type_kind::pointer) {
					compiler_error(@compiler, syntax->token, "dereference requires a pointer\0");
					@type := compiler.void_type;
				}
				else {
					@type := operand->data.element;
					if (type->kind != type_kind::function) {
						layout_validate(@compiler, (Type*)type, nullptr, syntax->token);
					};
				};
			}
			else if (operation == token_kind::op_bang) {
				if (!type_scalar((Type*)operand)) {
					compiler_error(@compiler, syntax->token, "logical negation requires a scalar\0");
				};
				@type := compiler.bool_type;
			}
			else {
				if (!type_numeric((Type*)operand) || (operation == token_kind::op_tilde && !type_integer((Type*)operand))) {
					compiler_error(@compiler, syntax->token, "unary operation requires a numeric operand\0");
				};
				@type = (Type*)operand;
				if (type->kind == type_kind::kw_bool && !syntax_number_expression((Syntax*)syntax->data.unary.value)) {
					@type := compiler.i32_type;
				};
			};
			break;
		};
		case syntax_kind::stmt_initialize:
		case syntax_kind::expr_binary: {
			token_kind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
				Syntax* storage = syntax_unaccess((Syntax*)left);
				if (syntax->kind == syntax_kind::stmt_initialize && storage->entity && entity_type((Entity*)storage->entity) && entity_type((Entity*)storage->entity)->kind == type_kind::reference) {
					if (syntax->data.binary.access != initialization_access::access && left->kind != syntax_kind::expr_access) {
						compiler_error(@compiler, left->token, "reference initialization requires explicit '@' access\0");
					};
					Type* reference := entity_type((Entity*)storage->entity);
					if (storage->kind == syntax_kind::expr_member) {
						Type* object = @this.member_object((Syntax*)storage);
						@this.member_project((Syntax*)storage, (Type*)object, entity_type((Entity*)storage->entity->data.variable.data.field.owner));
					};
					@this.expression((Syntax*)right, (Type*)reference);
					if (syntax_category((Syntax*)right) != value_category::storage && storage->entity->data.variable.storage != storage_kind::argument) {
						compiler_error(@compiler, right->token, "a named reference cannot bind a temporary\0");
					};
					if (storage->entity->data.variable.storage != storage_kind::field) {
						scope_define(@compiler, (Scope*)this.scope, (Entity*)storage->entity);
					};
					@left->type := reference->data.element;
					@storage->type := reference->data.element;
					@syntax->kind = syntax_kind::stmt_bind_reference;
					@type := reference->data.element;
					break;
				};

				Type* destination = @this.expression((Syntax*)left, nullptr);
				Type* source_type = nullptr;
				if (left->entity && left->entity->kind == entity_kind::variable && !left->entity->data.variable.type) {
					@source_type = @this.expression((Syntax*)right, nullptr);
					@destination := source_type;
					@left->entity->data.variable.type := destination;
					@left->entity->data.variable.type_use = @this.expression_use((Syntax*)right);
					@left->type := destination;
				};
				if (syntax_category((Syntax*)left) != value_category::storage) {
					compiler_error(@compiler, left->token, "assignment requires writable storage\0");
				};
				if (syntax->data.binary.access != initialization_access::access && !syntax_mutable_access((Syntax*)left)) {
					compiler_error(@compiler, left->token, "assignment requires explicit '@' mutable access\0");
				};
				if (operation == token_kind::op_assign && syntax->kind != syntax_kind::stmt_initialize && destination->kind == type_kind::named && (destination->data.entity->kind == entity_kind::kw_struct || destination->data.entity->kind == entity_kind::kw_union) && syntax_number_expression((Syntax*)right)) {
					Entity* assignment = @this.special_select((Entity*)destination->data.entity, function_role::assignment, (Syntax*)right, Token(syntax->token));
					if (assignment) {
						@syntax->entity := assignment;
						@type = type_effective((Type*)assignment->data.function.type->data.function.result);
						break;
					};
				};
				if (operation == token_kind::op_copy) {
					syntax_construct(@compiler, (Syntax*)right, (Type*)destination, @this.expression_use((Syntax*)left));
					@source_type = @this.expression((Syntax*)right, (Type*)destination);
				}
				else if (!source_type) {
					Type* context = nullptr;
					if (syntax_number_expression((Syntax*)right)) {
						@context := destination;
					};
					@source_type = @this.expression((Syntax*)right, (Type*)context);
				if (compiler.result == compilation_result::failure) {
					return (Type*)compiler.void_type;
				};
				};
				if (syntax->kind != syntax_kind::stmt_initialize && destination->kind == type_kind::named && (destination->data.entity->kind == entity_kind::kw_struct || destination->data.entity->kind == entity_kind::kw_union)) {
					Entity* assignment = @this.special_select((Entity*)destination->data.entity, function_role::assignment, (Syntax*)right, Token(syntax->token));
					if (assignment) {
						@syntax->entity := assignment;
						@type = type_effective((Type*)assignment->data.function.type->data.function.result);
						break;
					};
				};
				@this.expression((Syntax*)right, (Type*)destination);
				@this.owned((Syntax*)right);
				@this.expect((Syntax*)right, (Type*)right->type, (Type*)destination);
				if (left->entity && left->entity->kind == entity_kind::variable && left->entity->data.variable.storage == storage_kind::field && left->entity->data.variable.data.field.owner->kind == entity_kind::kw_union && !type_has_reference((Type*)destination)) {
					Scope* context := this.scope;
					while (context && context->context != context_kind::initialization && context->context != context_kind::arguments) {
						@context := context->parent;
					};
					if (context && context->owner == storage_root_entity((Syntax*)left) && entity_type((Entity*)context->owner)->kind != type_kind::reference) {
						@syntax->kind = syntax_kind::stmt_initialize;
					};
				};
				if (syntax->kind != syntax_kind::stmt_initialize) {
					@this.generated_operation_validate((Type*)destination, generated_operation::assignment, syntax->token);
				};
				if (operation == token_kind::op_assign) {
					@this.move((Syntax*)right);
				};
				@type = (Type*)destination;
				break;
			};
			if (operation == token_kind::op_and || operation == token_kind::op_or) {
				Type* a = @this.expression((Syntax*)left, (Type*)compiler.bool_type);
				Type* b = @this.expression((Syntax*)right, (Type*)compiler.bool_type);
				if (!type_scalar((Type*)a) || !type_scalar((Type*)b)) {
					compiler_error(@compiler, syntax->token, "logical operation requires scalars\0");
				};
				@type := compiler.bool_type;
				break;
			};

			Type* operand := expected;
			if (operand && operand->kind == type_kind::kw_bool && syntax_number_expression((Syntax*)left) && syntax_number_expression((Syntax*)right)) {
				@operand = type_primitive(@compiler, type_kind::kw_float, 64);
			};
			Type* a = nullptr;
			Type* b = nullptr;
			if (!syntax_number_expression((Syntax*)left)) {
				@a = @this.expression((Syntax*)left, nullptr);
				@operand := a;
			}
			else if (!syntax_number_expression((Syntax*)right)) {
				@b = @this.expression((Syntax*)right, nullptr);
				@operand := b;
			};
			if (!a) {
				@a = @this.expression((Syntax*)left, (Type*)operand);
			};

			Type* right_context := operand;
			if (a->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				@right_context = nullptr;
				if (syntax_number_expression((Syntax*)right)) {
					@right_context := compiler.usize_type;
				};
			};
			if (!b) {
				@b = @this.expression((Syntax*)right, (Type*)right_context);
			};
			if (a->kind == type_kind::pointer && b->kind == type_kind::pointer && (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) && !type_equal((Type*)a, (Type*)b)) {
				BaseSearch forward = base_search(@compiler, (Type*)b->data.element, (Type*)a->data.element);
				BaseSearch reverse = base_search(@compiler, (Type*)a->data.element, (Type*)b->data.element);
				if (forward.count == 1) {
					@this.expect((Syntax*)right, (Type*)b, (Type*)a);
					@b := a;
				}
				else if (reverse.count == 1 || type_pointer_conversion((Type*)a, (Type*)b)) {
					@this.expect((Syntax*)left, (Type*)a, (Type*)b);
					@a := b;
					@right_context := b;
				};
			};
			@this.expect((Syntax*)right, (Type*)b, (Type*)right_context);
			if (a->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
				layout_validate(@compiler, (Type*)a->data.element, nullptr, syntax->token);
				if (!type_integer((Type*)b)) {
					compiler_error(@compiler, right->token, "pointer offset requires an integer\0");
				};
				@type := a;
				break;
			};
			if (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) {
				if ((!type_scalar((Type*)a) || !type_scalar((Type*)b)) && !(type_enum((Type*)a) && type_scalar(type_representation((Type*)a)) && type_value_equal((Type*)a, (Type*)b))) {
					compiler_error(@compiler, syntax->token, "comparison requires scalar operands or matching enum types\0");
				};
				@type := compiler.bool_type;
			}
			else {
				if (!type_numeric((Type*)a) || !type_value_equal((Type*)a, (Type*)b)) {
					compiler_error(@compiler, syntax->token, "arithmetic requires matching numeric operands\0");
				};
				if ((operation == token_kind::op_remainder || operation == token_kind::op_ampersand || operation == token_kind::op_pipe || operation == token_kind::op_caret || operation == token_kind::op_shift_left || operation == token_kind::op_shift_right) && !type_integer((Type*)a)) {
					compiler_error(@compiler, syntax->token, "operation requires integer operands\0");
				};
				@type = (Type*)a;
				if (type->kind == type_kind::kw_bool) {
					@type := compiler.i32_type;
				};
			};
			break;
		};
		case syntax_kind::expr_call: {
			Syntax* callable_syntax := syntax->data.call.callable;
			if (callable_syntax->kind == syntax_kind::expr_name) {
				Entity* callable_entity = syntax_lookup((Scope*)this.scope, (Syntax*)callable_syntax);
				if (callable_entity && callable_entity->kind == entity_kind::kw_template && callable_entity->data.template_pattern.declaration_kind == token_kind::kw_fn) {
					@callable_entity = @this.template_deduce((Entity*)callable_entity, (Syntax*)callable_syntax, (Syntax*)syntax->data.call.arguments);
					if (!callable_entity) {
						return (Type*)compiler.void_type;
					};
					@callable_syntax->entity := callable_entity;
				};
				if (callable_entity && (callable_entity->kind == entity_kind::primitive || callable_entity->kind == entity_kind::kw_struct || callable_entity->kind == entity_kind::kw_union || callable_entity->kind == entity_kind::kw_enum)) {
					Syntax* arguments := syntax->data.call.arguments;
					Type* target = named_type(@compiler, (Scope*)this.scope, (Syntax*)callable_syntax);
					TypeUse* target_use = nullptr;
					if (callable_entity->kind == entity_kind::primitive) {
						@target_use := callable_entity->data.primitive.type_use;
					};
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.destination = nullptr;
					@syntax->data.construction.target = (Type*)target;
					@syntax->data.construction.type_use = $target_use;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = (Syntax*)arguments;
					return @this.expression((Syntax*)syntax, (Type*)expected);
				};
			};
			if (callable_syntax->kind == syntax_kind::expr_member) {
				Syntax* receiver = @this.method_receiver((Syntax*)callable_syntax);
				Type* owner := receiver->type;
				if (callable_syntax->data.member.qualifier) {
					@owner = named_type(@compiler, (Scope*)this.scope, (Syntax*)callable_syntax->data.member.qualifier);
					BaseSearch path = base_search(@compiler, (Type*)receiver->type, (Type*)owner);
					if (!path.count) {
						compiler_error(@compiler, callable_syntax->token, "qualified callable owner is not a base of its receiver\0");
						return (Type*)compiler.void_type;
					};
					@syntax->data.call.qualified_owner := owner->data.entity;
				};
				if (owner->kind == type_kind::named && (owner->data.entity->kind == entity_kind::kw_struct || owner->data.entity->kind == entity_kind::kw_union) && token_same(callable_syntax->data.member.name, owner->data.entity->name)) {
					if (owner->qualifier == type_qualifier::kw_const || (callable_syntax->token.kind != token_kind::op_arrow && (syntax_category((Syntax*)receiver) != value_category::storage || !syntax_mutable_access((Syntax*)receiver)))) {
						compiler_error(@compiler, callable_syntax->token, "construction requires mutable storage\0");
						return (Type*)compiler.void_type;
					};
					Syntax* arguments := syntax->data.call.arguments;
					@syntax->kind = syntax_kind::expr_construct;
					@syntax->data.construction.type_use = @this.expression_use((Syntax*)receiver);
					@syntax->data.construction.destination = $receiver;
					@syntax->data.construction.target := owner;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = $arguments;
					return @this.expression((Syntax*)syntax, (Type*)expected);
				};
				Entity* function = @this.receiver_callable((Type*)owner, Token(callable_syntax->data.member.name));
				if (function && function->kind == entity_kind::function) {
					entity_resolve(@compiler, (Entity*)function);
					Parameter* first := function->data.function.type->data.function.parameters;
					@syntax->data.call.receiver.value := receiver;
					if (first && function_receiver((Entity*)function)) {
						if (callable_syntax->data.member.qualifier && !type_equal((Type*)receiver->type, (Type*)owner)) {
							Type* reference = type_indirect(@compiler, type_kind::reference, (Type*)owner);
							@this.expect((Syntax*)receiver, (Type*)receiver->type, (Type*)reference);
						};
						@this.expect((Syntax*)receiver, (Type*)receiver->type, (Type*)first->type);
						@syntax->data.call.receiver.kind = receiver_kind::bind;
					}
					else {
						@syntax->data.call.receiver.kind = receiver_kind::evaluate;
					};
					Syntax* direct = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
					@direct->kind = syntax_kind::expr_name;
					@direct->token := callable_syntax->data.member.name;
					@direct->entity = (Entity*)function;
					@syntax->data.call.callable = (Syntax*)direct;
				};
			};
			Type* callable = @this.expression((Syntax*)syntax->data.call.callable, nullptr);
			TypeUse* callable_use = @this.expression_use((Syntax*)syntax->data.call.callable);
			if (callable->kind == type_kind::pointer) {
				@callable := callable->data.element;
				if (callable_use) {
					@callable_use := callable_use->data.element;
				};
			};
			if (callable->kind != type_kind::function) {
				compiler_error(@compiler, syntax->token, "call requires a function entity or function pointer\0");
				return (Type*)compiler.void_type;
			};
			if (callable->data.function.result->kind != type_kind::kw_void) {
				layout_validate(@compiler, (Type*)callable->data.function.result, nullptr, syntax->token);
			};
			Parameter* complete := callable->data.function.parameters;
			while (complete) {
				layout_validate(@compiler, (Type*)complete->type, nullptr, syntax->token);
				@complete := complete->next;
			};
			Parameter* parameter := callable->data.function.parameters;
			ParameterUse* label = nullptr;
			if (callable_use) {
				@label := callable_use->data.callable.parameters;
			};
			Syntax* direct := syntax->data.call.callable;
			if (syntax->data.call.receiver.kind == receiver_kind::none && direct->kind == syntax_kind::expr_name && !direct->data.expression && direct->entity && direct->entity->scope && direct->entity->scope->owner && (direct->entity->scope->owner->kind == entity_kind::kw_struct || direct->entity->scope->owner->kind == entity_kind::kw_union) && parameter && label && token_is(label->name, "this\0")) {
				Entity* current = scope_lookup((Scope*)this.scope, token_synthetic(@compiler, Token(direct->token), "this\0"));
				if (current) {
					Syntax* receiver = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
					@receiver->kind = syntax_kind::expr_name;
					@receiver->token := current->name;
					@receiver->entity = (Entity*)current;
					@this.expression((Syntax*)receiver, (Type*)parameter->type);
					@syntax->data.call.receiver.value = (Syntax*)receiver;
					@syntax->data.call.receiver.kind = receiver_kind::bind;
				};
			};
			if (syntax->data.call.receiver.kind == receiver_kind::bind) {
				@parameter := parameter->next;
				if (label) {
					@label := label->next;
				};
			};
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (!parameter && callable->data.function.arity != parameter_arity::variadic) {
					compiler_error(@compiler, argument->token, "too many arguments\0");
					break;
				};
				Type* destination = nullptr;
				if (parameter) {
					@destination := parameter->type;
				};
				if (argument->kind == syntax_kind::node_block) {
					if (!parameter || !label || !label->name.source) {
						compiler_error(@compiler, argument->token, "argument block requires a named parameter\0");
					}
					else {
						@argument->scope->context = context_kind::arguments;
						Entity* storage = entity_create(@compiler, entity_kind::variable, Token(label->name));
						@storage->state = resolution::ready;
						@storage->data.variable.type := destination;
						@storage->data.variable.type_use := label->use;
						@storage->data.variable.storage = storage_kind::argument;
						@storage->declaration := argument;
						@argument->scope->owner := storage;
						if (destination->kind == type_kind::reference) {
							reference_initializer(@compiler, (Syntax*)argument, (Entity*)storage, Token(argument->token));
						}
						else {
							scope_define(@compiler, (Scope*)argument->scope, (Entity*)storage);
							object_initializer_prepare(@compiler, (Scope*)this.scope, (Entity*)storage, (Syntax*)argument, Token(argument->token));
						};
						@argument->entity = (Entity*)storage;
						@this.statement((Syntax*)argument);
						@argument->type = (Type*)destination;
					};
				}
				else {
					Type* actual = @this.expression((Syntax*)argument, (Type*)destination);
					if (!destination || destination->kind != type_kind::reference) {
						@this.owned((Syntax*)argument);
					};
					if (!parameter && type_aggregate((Type*)actual)) {
						compiler_error(@compiler, argument->token, "aggregate C variadic arguments require ABI lowering that is not supported yet\0");
					};
				};
				if (parameter) {
					@parameter := parameter->next;
				};
				if (label) {
					@label := label->next;
				};
				@argument := argument->next;
			};
			if (parameter) {
				compiler_error(@compiler, syntax->token, "too few arguments\0");
			};
			@type = type_effective((Type*)callable->data.function.result);
			break;
		};
		case syntax_kind::node_block:
			@this.statement((Syntax*)syntax);
			@type := compiler.void_type;
			break;
		default:
			compiler_error(@compiler, syntax->token, "expected value expression\0");
			@type := compiler.void_type;
			break;
	};
	@type = type_effective((Type*)type);
	@syntax->type := type;
	return @this.expect($syntax, $type, $expected);
};

// ============================================================================
// MODULE: LLVM EMISSION
// FUTURE FILE: backend/emitter.rt
// PURPOSE: Construct native layouts and emit LLVM instructions and runtime metadata.
// DEPENDS ON: Backend, Compiler arena and diagnostics, semantic entities and layout.
// ============================================================================
fn llvm_body(Compiler& compiler, Entity* entity) -> LLVMOpaqueType* {
	BackendEntity* native = backend_entity_define(@compiler, (Entity*)entity);
	if (!native) {
		return nullptr;
	};
	if (native->body) {
		return LLVMOpaqueType*(native->body);
	};
	entity_resolve(@compiler, (Entity*)entity);
	LLVMOpaqueType* record = LLVMStructCreateNamed(compiler.backend.llvm_context.get(), "rt.body\0");
	@native->body := record;
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		return $record;
	};
	usize count := entity->data.aggregate.field_count;
	if (aggregate_header((Entity*)entity)) {
		@count = count + 1;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@count = count + 1;
		};
		@base := base->next;
	};
	LLVMOpaqueType** fields = (LLVMOpaqueType**)memory_allocate(@compiler, (count + 2) * sizeof(LLVMOpaqueType*));
	usize index = 0;
	if (aggregate_header((Entity*)entity)) {
		@fields[index] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
		@index = index + 1;
	};
	@base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@fields[index] = llvm_body(@compiler, (Entity*)base->entity);
			@index = index + 1;
		};
		@base := base->next;
	};
	Field* binding := entity->data.aggregate.fields;
	u64 maximum_size = 0;
	u32 maximum_alignment = 0;
	LLVMOpaqueType* aligned = nullptr;
	while (binding) {
		LLVMOpaqueType* field = llvm_type(@compiler, entity_type((Entity*)binding->entity));
		@fields[index] := field;
		@index = index + 1;
		if (entity->kind == entity_kind::kw_union) {
			u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(field));
			u32 alignment = LLVMABIAlignmentOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(field));
			if (size > maximum_size) {
				@maximum_size = (u64)size;
			};
			if (alignment > maximum_alignment) {
				@maximum_alignment = (u32)alignment;
				@aligned = LLVMOpaqueType*(field);
			};
		};
		@binding := binding->next;
	};
	if (entity->kind == entity_kind::kw_union && aligned) {
		u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(aligned));
		@fields[0] = LLVMOpaqueType*(aligned);
		@index = 1;
		if (maximum_size > size) {
			@fields[1] = LLVMArrayType2(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), maximum_size - size);
			@index = 2;
		};
	};
	if (!index) {
		@fields[0] = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8);
		@index = 1;
	};
	LLVMStructSetBody(LLVMOpaqueType*(record), $fields, (u32)index, 0);
	return $record;
};

fn backend_entity(Backend& backend, Entity* entity) -> BackendEntity* {
	return @backend.entities.find((const void*)entity, nullptr);
};

fn backend_entity_define(Compiler& compiler, Entity* entity) -> BackendEntity* {
	return identity_record<BackendEntity>(@compiler, @compiler.backend.entities, (const void*)entity, nullptr);
};

fn backend_syntax(Backend& backend, Syntax* syntax) -> BackendSyntax* {
	return @backend.expressions.find((const void*)syntax, nullptr);
};

fn backend_syntax_define(Compiler& compiler, Syntax* syntax) -> BackendSyntax* {
	return identity_record<BackendSyntax>(@compiler, @compiler.backend.expressions, (const void*)syntax, nullptr);
};

fn llvm_type(Compiler& compiler, Type* type) -> LLVMOpaqueType* {
	if (!type) {
		return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
	};
	switch (type->kind) {
		case type_kind::kw_void:
		case type_kind::kw_null:
			return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
		case type_kind::kw_char:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8);
		case type_kind::kw_bool:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1);
		case type_kind::kw_signed:
		case type_kind::kw_unsigned:
			return LLVMIntTypeInContext(compiler.backend.llvm_context.get(), (u32)type->data.bits);
		case type_kind::kw_float:
			if (type->data.bits == 32) {
				return LLVMFloatTypeInContext(compiler.backend.llvm_context.get());
			};
			return LLVMDoubleTypeInContext(compiler.backend.llvm_context.get());
		case type_kind::pointer:
		case type_kind::reference:
			return LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
		case type_kind::array:
			return LLVMArrayType2(llvm_type(@compiler, (Type*)type->data.array.element), (u64)type->data.array.count);
		case type_kind::function: {
			u32 count = 0;
			Parameter* parameter := type->data.function.parameters;
			while (parameter) {
				@count = count + 1;
				@parameter := parameter->next;
			};
			LLVMOpaqueType** parameters = (LLVMOpaqueType**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueType*));
			@parameter := type->data.function.parameters;
			u32 index = 0;
			while (parameter) {
				@parameters[index] = llvm_type(@compiler, (Type*)parameter->type);
				@index = index + 1;
				@parameter := parameter->next;
			};
			return LLVMFunctionType(llvm_type(@compiler, (Type*)type->data.function.result), $parameters, $count, type->data.function.arity == parameter_arity::variadic);
		};
		case type_kind::named: {
			Entity* entity := type->data.entity;
			if (entity->kind == entity_kind::kw_enum) {
				entity_resolve(@compiler, (Entity*)entity);
				return llvm_type(@compiler, (Type*)entity->data.enumeration.underlying);
			};
			BackendEntity* native = backend_entity_define(@compiler, (Entity*)entity);
			if (!native) {
				return nullptr;
			};
			if (native->type) {
				return LLVMOpaqueType*(native->type);
			};
			LLVMOpaqueType* body = llvm_body(@compiler, (Entity*)entity);
			if (!entity->data.aggregate.virtual_types) {
				@native->type := body;
				return $body;
			};
			LLVMOpaqueType* record = LLVMStructCreateNamed(compiler.backend.llvm_context.get(), entity_name(@compiler, (Entity*)entity));
			@native->type := record;
			CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
			usize count = 1;
			Subobject* object := graph->virtuals;
			while (object) {
				@count = count + 1;
				@object := object->virtual_next;
			};
			LLVMOpaqueType** components = (LLVMOpaqueType**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueType*));
			@components[0] = LLVMOpaqueType*(body);
			@object := graph->virtuals;
			while (object) {
				@components[object->component] = llvm_body(@compiler, (Entity*)object->entity);
				@object := object->virtual_next;
			};
			LLVMStructSetBody(LLVMOpaqueType*(record), LLVMOpaqueType**(components), (u32)count, 0);
			return $record;
		};
	};
	return LLVMVoidTypeInContext(compiler.backend.llvm_context.get());
};

fn emit_slot(Compiler& compiler, Type* type) -> LLVMOpaqueValue* {
	LLVMOpaqueBasicBlock* block = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock(compiler.backend.llvm_builder.get())));
	var storage_builder = unique_ptr<LLVMOpaqueBuilder, LLVMBuilderDisposer>(LLVMCreateBuilderInContext(compiler.backend.llvm_context.get()));
	LLVMOpaqueValue* first = LLVMGetFirstInstruction(LLVMOpaqueBasicBlock*(block));
	if (first) {
		LLVMPositionBuilderBefore(storage_builder.get(), LLVMOpaqueValue*(first));
	}
	else {
		LLVMPositionBuilderAtEnd(storage_builder.get(), LLVMOpaqueBasicBlock*(block));
	};
	LLVMOpaqueValue* slot = LLVMBuildAlloca(storage_builder.get(), llvm_type(@compiler, $type), "storage\0");

	return $slot;
};

fn subobject_offsets(Compiler& compiler, Subobject* object, u64 offset) {
	@object->offset := offset;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		if (edge->relation->kind == base_kind::nonvirtual) {
			u64 child = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)object->entity), (u32)edge->relation->component);
			subobject_offsets(@compiler, (Subobject*)edge->target, $child);
		};
		@edge := edge->next;
	};
};

fn complete_offsets(Compiler& compiler, CompleteGraph* graph) {
	LLVMOpaqueType* type = llvm_type(@compiler, entity_type((Entity*)graph->entity));
	subobject_offsets(@compiler, (Subobject*)graph->root, 0);
	Subobject* object := graph->virtuals;
	while (object) {
		u64 offset = LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), LLVMOpaqueType*(type), (u32)object->component);
		subobject_offsets(@compiler, (Subobject*)object, $offset);
		@object := object->virtual_next;
	};
};

fn virtual_callable_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualCallable* callable := entity->data.aggregate.virtual_callables;
	while (callable) {
		@count = count + 1;
		@callable := callable->next;
	};
	return $count;
};

fn virtual_base_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualType* type := entity->data.aggregate.virtual_types;
	while (type) {
		@count = count + 1;
		@type := type->next;
	};
	return $count;
};

fn runtime_view_type(Compiler& compiler, Entity* entity) -> LLVMOpaqueType* {
	LLVMOpaqueType*[2] fields {};
	@fields[0] = LLVMArrayType2(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)virtual_base_count((Entity*)entity));
	@fields[1] = LLVMArrayType2(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), (u64)virtual_callable_count($entity));
	return LLVMStructTypeInContext(compiler.backend.llvm_context.get(), &fields[0], 2, 0);
};

fn runtime_view_request(Compiler& compiler, CompleteGraph* graph, Subobject* object) -> LLVMOpaqueValue* {
	BackendEntity* native = backend_entity_define(@compiler, (Entity*)object->entity);
	if (!native) {
		return nullptr;
	};
	RuntimeView* existing := native->views;
	while (existing) {
		if (existing->object == object) {
			return LLVMOpaqueValue*(existing->value);
		};
		@existing := existing->next;
	};

	RuntimeView* request = (RuntimeView*)memory_allocate(@compiler, sizeof(RuntimeView));
	if (!request) {
		return nullptr;
	};
	LLVMOpaqueValue* view = LLVMAddGlobal(compiler.backend.llvm_module.get(), runtime_view_type(@compiler, (Entity*)object->entity), "rt.view\0");
	LLVMSetLinkage(LLVMOpaqueValue*(view), 9);
	LLVMSetGlobalConstant(LLVMOpaqueValue*(view), 1);
	@request->value := view;
	@request->graph = $graph;
	@request->object = $object;
	@request->next := native->views;
	@native->views := request;
	@request->pending_next := compiler.backend.runtime_views;
	@compiler.backend.runtime_views = $request;
	return $view;
};

fn emit_function_attributes(Compiler& compiler, LLVMOpaqueValue* function, Type* signature) {
	LLVMOpaqueAttributeRef* extension = emit_extension(@compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddAttributeAtIndex(LLVMOpaqueValue*(function), 0, LLVMOpaqueAttributeRef*(extension));
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension(@compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddAttributeAtIndex(LLVMOpaqueValue*(function), (u32)index, LLVMOpaqueAttributeRef*(extension));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn runtime_thunk_request(Compiler& compiler, CompleteGraph* graph, Subobject* receiver, VirtualCallable* callable) -> LLVMOpaqueValue* {
	VirtualTarget target = virtual_target(@compiler, $graph, (Subobject*)receiver, (Entity*)callable->function);
	if (target.function == callable->function && target.object == receiver) {
		return LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)target.function)->value);
	};
	RuntimeThunk* thunk = (RuntimeThunk*)memory_allocate(@compiler, sizeof(RuntimeThunk));
	@thunk->receiver = $receiver;
	@thunk->callable := callable;
	@thunk->target = $target;
	@thunk->function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.virtual.thunk\0", llvm_type(@compiler, (Type*)callable->function->data.function.type));
	LLVMSetLinkage(LLVMOpaqueValue*(thunk->function), 9);
	emit_function_attributes(@compiler, LLVMOpaqueValue*(thunk->function), (Type*)callable->function->data.function.type);
	@thunk->next := compiler.backend.runtime_thunks;
	@compiler.backend.runtime_thunks := thunk;
	return LLVMOpaqueValue*(thunk->function);
};

fn runtime_views_emit(Compiler& compiler) {
	while (compiler.backend.runtime_views && compiler.result != compilation_result::failure) {
		RuntimeView* view := compiler.backend.runtime_views;
		@compiler.backend.runtime_views := view->pending_next;
		complete_offsets(@compiler, (CompleteGraph*)view->graph);
		usize count = virtual_base_count((Entity*)view->object->entity);
		LLVMOpaqueValue** offsets = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		VirtualType* target := view->object->entity->data.aggregate.virtual_types;
		while (target) {
			Subobject* storage := view->graph->virtuals;
			while (storage && storage->entity != target->entity) {
				@storage := storage->virtual_next;
			};
			@offsets[target->index] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), storage->offset - view->object->offset, 0);
			@target := target->next;
		};
		LLVMOpaqueValue*[2] fields {};
		@fields[0] = LLVMConstArray2(llvm_type(@compiler, (Type*)compiler.usize_type), $offsets, (u64)count);
		@count = virtual_callable_count((Entity*)view->object->entity);
		LLVMOpaqueValue** functions = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		VirtualCallable* callable := view->object->entity->data.aggregate.virtual_callables;
		while (callable) {
			@functions[callable->index] = runtime_thunk_request(@compiler, (CompleteGraph*)view->graph, (Subobject*)view->object, (VirtualCallable*)callable);
			@callable := callable->next;
		};
		@fields[1] = LLVMConstArray2(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $functions, (u64)count);
		LLVMSetInitializer(LLVMOpaqueValue*(view->value), LLVMConstStructInContext(compiler.backend.llvm_context.get(), &fields[0], 2, 0));
	};
};

fn Emitter::byte_offset(Emitter& this, LLVMOpaqueValue* address, u64 offset) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), $offset, 0);
	return LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), $address, &index, 1, "subobject\0");
};

fn Emitter::base_address(Emitter& this, LLVMOpaqueValue* address, Entity* derived, BasePath* path, base_direction direction) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	u64 offset = 0;
	while (path) {
		BaseRelation* relation := path->relation;
		if (direction == base_direction::up && relation->kind == base_kind::kw_virtual) {
			LLVMOpaqueValue* header = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)derived), LLVMOpaqueValue*(address), 0, "view.storage\0");
			LLVMOpaqueValue* view = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "view\0");
			LLVMOpaqueValue* offsets = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), runtime_view_type(@compiler, (Entity*)derived), $view, 0, "virtual.offsets\0");
			LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)relation->component, 0);
			LLVMOpaqueValue* slot = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)compiler.usize_type), $offsets, &index, 1, "virtual.offset.storage\0");
			LLVMOpaqueValue* displacement = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)compiler.usize_type), $slot, "virtual.offset\0");
			@address = LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 8), LLVMOpaqueValue*(address), &displacement, 1, "virtual.base\0");
		}
		else if (direction == base_direction::up) {
			@address = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)derived), LLVMOpaqueValue*(address), (u32)relation->component, "base\0");
		}
		else {
			@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)derived), (u32)relation->component);
		};
		@derived := relation->entity;
		@path := path->next;
	};
	if (direction == base_direction::down && offset) {
		LLVMOpaqueValue* integer = LLVMBuildPtrToInt(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(address), llvm_type(@compiler, (Type*)compiler.usize_type), "base.address\0");
		@integer = LLVMBuildSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(integer), LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)offset, 0), "derived.address\0");
		@address = LLVMBuildIntToPtr(LLVMOpaqueBuilder*(builder), $integer, LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "derived\0");
	};
	return $address;
};

fn Emitter::base_conversion(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Syntax* value := syntax->data.base_conversion.value;
	Type* source := value->type;
	LLVMOpaqueValue* address = nullptr;
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		@address = @this.expression((Syntax*)value);
		@source := source->data.element;
	}
	else {
		@address = @this.address((Syntax*)value);
	};
	Entity* derived := source->data.entity;
	if (syntax->data.base_conversion.direction == base_direction::down) {
		@derived := syntax->data.base_conversion.target->data.element->data.entity;
	};
	if (syntax->kind == syntax_kind::expr_base_pointer && base_path_virtual((BasePath*)syntax->data.base_conversion.path)) {
		LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
		LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "base.nonnull\0");
		LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "base.end\0");
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
		LLVMOpaqueValue* converted = @this.base_address(LLVMOpaqueValue*(address), (Entity*)derived, (BasePath*)syntax->data.base_conversion.path, (base_direction)syntax->data.base_conversion.direction);
		@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
		LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
		LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMTypeOf(LLVMOpaqueValue*(address)), "base.pointer\0");
		LLVMOpaqueValue*[2] values {};
		LLVMOpaqueBasicBlock*[2] blocks {};
		@values[0] = $null;
		@values[1] = $converted;
		@blocks[0] = $initial;
		@blocks[1] = $live;
		LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
		return $result;
	};
	LLVMOpaqueValue* result = @this.base_address(LLVMOpaqueValue*(address), $derived, (BasePath*)syntax->data.base_conversion.path, (base_direction)syntax->data.base_conversion.direction);
	if (syntax->kind == syntax_kind::expr_base_pointer) {
		LLVMOpaqueValue* null = LLVMConstNull(LLVMTypeOf(LLVMOpaqueValue*(address)));
		LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(address), LLVMOpaqueValue*(null), "base.null\0");
		return LLVMBuildSelect(compiler.backend.llvm_builder.get(), $empty, $null, LLVMOpaqueValue*(result), "base.pointer\0");
	};
	return $result;
};

fn runtime_callable(Compiler& compiler, Entity* entity) -> LLVMOpaqueValue* {
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)entity);
	if (!entity->data.function.callable) {
		return LLVMOpaqueValue*(native->value);
	};
	if (native->wrapper) {
		return LLVMOpaqueValue*(native->wrapper);
	};
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.virtual.callable\0", llvm_type(@compiler, (Type*)entity->data.function.type));
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	emit_function_attributes(@compiler, LLVMOpaqueValue*(function), (Type*)entity->data.function.type);
	@native->wrapper := function;
	RuntimeWrapper* wrapper = (RuntimeWrapper*)memory_allocate(@compiler, sizeof(RuntimeWrapper));
	@wrapper->entity = $entity;
	@wrapper->next := compiler.backend.runtime_wrappers;
	@compiler.backend.runtime_wrappers = $wrapper;
	return $function;
};

fn Emitter::dispatch_target(Emitter& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Entity* owner := entity->data.function.interface_owner;
	LLVMOpaqueValue* header = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)owner), $receiver, 0, "virtual.header\0");
	LLVMOpaqueValue* view = LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $header, "virtual.view\0");
	LLVMOpaqueValue* functions = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), runtime_view_type(@compiler, $owner), $view, 1, "virtual.functions\0");
	LLVMOpaqueValue* index = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)entity->data.function.callable->index, 0);
	LLVMOpaqueValue* slot = LLVMBuildGEP2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $functions, &index, 1, "virtual.slot\0");
	return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), $slot, "virtual.target\0");
};

fn Emitter::covariant_result(Emitter& this, LLVMOpaqueValue* value, Type* source, Type* target) -> LLVMOpaqueValue* {
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	Compiler& compiler = @*this.compiler;
	BaseSearch path = base_search(@compiler, (Type*)source->data.element, (Type*)target->data.element);
	if (source->kind == type_kind::reference) {
		return @this.base_address(LLVMOpaqueValue*(value), (Entity*)source->data.element->data.entity, (BasePath*)path.path, base_direction::up);
	};
	LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
	LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "return.nonnull\0");
	LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), $function, "return.end\0");
	LLVMOpaqueValue* null = LLVMConstNull(LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0));
	LLVMOpaqueValue* empty = LLVMBuildICmp(compiler.backend.llvm_builder.get(), 32, LLVMOpaqueValue*(value), LLVMOpaqueValue*(null), "return.null\0");
	LLVMBuildCondBr(compiler.backend.llvm_builder.get(), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(live));
	LLVMOpaqueValue* adjusted = @this.base_address($value, (Entity*)source->data.element->data.entity, (BasePath*)path.path, base_direction::up);
	@live = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(merge));
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $merge);
	LLVMOpaqueValue* result = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0), "return.base\0");
	LLVMOpaqueValue*[2] values {};
	LLVMOpaqueBasicBlock*[2] blocks {};
	@values[0] = $null;
	@values[1] = $adjusted;
	@blocks[0] = $initial;
	@blocks[1] = $live;
	LLVMAddIncoming(LLVMOpaqueValue*(result), &values[0], &blocks[0], 2);
	return $result;
};

fn covariance_adjustment_required(Compiler& compiler, Type* source, Type* target) -> bool {
	if (type_equal((Type*)source, (Type*)target)) {
		return false;
	};
	BaseSearch conversion = base_search(@compiler, (Type*)source->data.element, (Type*)target->data.element);
	Entity* current := source->data.element->data.entity;
	BasePath* path := conversion.path;
	u64 offset = 0;
	while (path) {
		if (path->relation->kind == base_kind::kw_virtual) {
			return true;
		};
		@offset = offset + LLVMOffsetOfElement(compiler.backend.llvm_layout.get(), llvm_body(@compiler, (Entity*)current), (u32)path->relation->component);
		@current := path->relation->entity;
		@path := path->next;
	};
	return offset != 0;
};

fn Emitter::storage_address(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return LLVMOpaqueValue*(this.component_source);
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	switch (syntax->kind) {
		case syntax_kind::expr_construct:
			@this.expression((Syntax*)syntax);
			return LLVMOpaqueValue*(backend_syntax(@compiler.backend, (Syntax*)syntax)->constructed);
		case syntax_kind::expr_binary:
			if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
				return @this.special_call((Entity*)syntax->entity, @this.address((Syntax*)syntax->data.binary.left), (Syntax*)syntax->data.binary.right);
			};
			if (syntax->data.binary.operation == token_kind::op_assign || syntax->data.binary.operation == token_kind::op_copy) {
				@this.expression((Syntax*)syntax);
				return LLVMOpaqueValue*(backend_syntax(@compiler.backend, (Syntax*)syntax)->address);
			};
			break;
		case syntax_kind::expr_access:
			return @this.storage_address((Syntax*)syntax->data.expression);
		case syntax_kind::expr_base_reference:
			return @this.base_conversion((Syntax*)syntax);
		case syntax_kind::expr_name:
			if (syntax->entity->kind == entity_kind::function) {
				return runtime_callable(@compiler, (Entity*)syntax->entity);
			};
			return LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)syntax->entity)->value);
		case syntax_kind::expr_cast:
			return @this.address((Syntax*)syntax->data.cast.value);
		case syntax_kind::expr_call:
			return @this.call((Syntax*)syntax);
		case syntax_kind::expr_unary:
			return @this.expression((Syntax*)syntax->data.unary.value);
		case syntax_kind::expr_member: {
			Syntax* object := syntax->data.member.object;
			Type* type := object->type;
			LLVMOpaqueValue* address = nullptr;
			if (syntax->token.kind == token_kind::op_arrow) {
				@address = @this.expression((Syntax*)object);
				@type := type->data.element;
			}
			else if (syntax_category((Syntax*)object) == value_category::storage) {
				@address = @this.address((Syntax*)object);
			}
			else {
				@address = @this.address((Syntax*)object);
			};
			Entity* owner := syntax->entity->data.variable.data.field.owner;
			if (type->data.entity != owner) {
				BaseSearch path = base_search(@compiler, (Type*)type, entity_type((Entity*)owner));
				@address = @this.base_address(LLVMOpaqueValue*(address), (Entity*)type->data.entity, (BasePath*)path.path, base_direction::up);
				@type = entity_type((Entity*)owner);
			};
			if (type->data.entity->kind == entity_kind::kw_union) {
				return $address;
			};
			LLVMOpaqueValue* field = LLVMBuildStructGEP2(LLVMOpaqueBuilder*(builder), llvm_body(@compiler, (Entity*)type->data.entity), LLVMOpaqueValue*(address), (u32)syntax->entity->data.variable.data.field.index, "field\0");
			return $field;
		};
		case syntax_kind::expr_index: {
			Syntax* object := syntax->data.binary.left;
			LLVMOpaqueValue* index = @this.expression((Syntax*)syntax->data.binary.right);
			@index = @this.cast(LLVMOpaqueValue*(index), (Type*)syntax->data.binary.right->type, (Type*)compiler.usize_type);
			LLVMOpaqueValue*[2] indices {};
			if (object->type->kind == type_kind::array) {
				@indices[0] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), 0, 0);
				@indices[1] := index;
				return LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)object->type), @this.address((Syntax*)object), &indices[0], 2, "element\0");
			};
			@indices[0] = LLVMOpaqueValue*(index);
			return LLVMBuildGEP2($builder, llvm_type(@compiler, (Type*)object->type->data.element), @this.expression($object), &indices[0], 1, "element\0");
		};
	};
	compiler_error(@compiler, syntax->token, "expression has no storage address\0");
	return nullptr;
};

fn type_has_views(Type* type) -> bool {
	@type = type_representation(Type*(type));
	if (!type) {
		return false;
	};
	if (type->kind == type_kind::array) {
		return type_has_views((Type*)type->data.array.element);
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (aggregate_header((Entity*)entity)) {
		return true;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_has_views(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_has_views(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn type_requires_union_choice(Type* type) -> bool {
	return type_contains($type, type_property::union_selection);
};

fn Emitter::array_element(Emitter& this, Type* type, LLVMOpaqueValue* address, usize index) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueValue*[2] indices {};
	@indices[0] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), 0, 0);
	@indices[1] = LLVMConstInt(llvm_type(@compiler, (Type*)compiler.usize_type), (u64)index, 0);
	return LLVMBuildGEP2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, $type), $address, &indices[0], 2, "array.element\0");
};

fn Emitter::initialize_body_fields(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		Type* type = entity_type((Entity*)field->entity);
		if (type_has_views((Type*)type)) {
			LLVMOpaqueValue* storage = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)field->entity->data.variable.data.field.index, "member.object\0");
			@this.initialize_type((Type*)type, $storage);
		};
		@field := field->next;
	};
};

fn Emitter::initialize_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	Compiler& compiler = @*this.compiler;
	if (type_enum((Type*)type)) {
		@this.initialize_type((Type*)type->data.entity->data.enumeration.underlying, $address);
		return;
	};
	if (!type_has_views((Type*)type)) {
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.initialize_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;

	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $entity);
	complete_offsets(@compiler, (CompleteGraph*)graph);
	Subobject* object := graph->objects;
	while (object) {
		LLVMOpaqueValue* storage = @this.byte_offset(LLVMOpaqueValue*(address), (u64)object->offset);
		if (aggregate_header((Entity*)object->entity)) {
			LLVMOpaqueValue* header = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)object->entity), LLVMOpaqueValue*(storage), 0, "view.storage\0");
			LLVMBuildStore(compiler.backend.llvm_builder.get(), runtime_view_request(@compiler, (CompleteGraph*)graph, (Subobject*)object), $header);
		};
		@this.initialize_body_fields((Entity*)object->entity, $storage);
		@object := object->next;
	};
};

fn Emitter::body_payload_copy(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)base->component, "copy.base.destination\0");
			LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)base->component, "copy.base.source\0");
			@this.body_payload_copy((Entity*)base->entity, $target, $origin);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)field->entity->data.variable.data.field.index, "copy.field.destination\0");
		LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)field->entity->data.variable.data.field.index, "copy.field.source\0");
		@this.payload_copy(entity_type((Entity*)field->entity), $target, $origin);
		@field := field->next;
	};
};

fn Emitter::payload_copy(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	Compiler& compiler = @*this.compiler;
	if (!type_has_views((Type*)type) || (type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_union)) {
		LLVMOpaqueValue* value = LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)type), LLVMOpaqueValue*(source), "copy.value\0");
		LLVMBuildStore(compiler.backend.llvm_builder.get(), $value, LLVMOpaqueValue*(destination));
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.payload_copy((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(destination), (u64)index), @this.array_element((Type*)type, LLVMOpaqueValue*(source), (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;
	@this.body_payload_copy((Entity*)entity, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
	CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
	Subobject* target := graph->virtuals;
	while (target) {
		BasePath* path = nullptr;
		subobject_find_path(@compiler, (Subobject*)graph->root, (Subobject*)target, &path);
		LLVMOpaqueValue* origin = @this.base_address(LLVMOpaqueValue*(source), (Entity*)entity, (BasePath*)path, base_direction::up);
		LLVMOpaqueValue* result = @this.base_address(LLVMOpaqueValue*(destination), (Entity*)entity, $path, base_direction::up);
		@this.body_payload_copy((Entity*)target->entity, $result, $origin);
		@target := target->virtual_next;
	};
};

fn Emitter::complete_read(Emitter& this, Type* type, LLVMOpaqueValue* source) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	if (!type_has_views((Type*)type) || (type->kind == type_kind::named && type->data.entity->kind == entity_kind::kw_union)) {
		return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)type), LLVMOpaqueValue*(source), "value\0");
	};
	LLVMOpaqueValue* value = emit_slot(@compiler, (Type*)type);
	@this.initialize_type((Type*)type, LLVMOpaqueValue*(value));
	@this.payload_copy((Type*)type, LLVMOpaqueValue*(value), $source);
	return LLVMBuildLoad2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, $type), $value, "complete.value\0");
};

fn Emitter::value_read(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	return @this.complete_read((Type*)syntax->type, @this.address($syntax));
};

fn Emitter::truth(Emitter& this, LLVMOpaqueValue* value, Type* type) -> LLVMOpaqueValue* {
	@type = type_representation(Type*(type));
	LLVMOpaqueValue* zero = LLVMConstNull(llvm_type(@*this.compiler, (Type*)type));
	if (type->kind == type_kind::kw_float) {
		return LLVMBuildFCmp(this.compiler->backend.llvm_builder.get(), 14, LLVMOpaqueValue*(value), LLVMOpaqueValue*(zero), "truth\0");
	};
	return LLVMBuildICmp(this.compiler->backend.llvm_builder.get(), 33, $value, $zero, "truth\0");
};

fn Emitter::address(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_owned_component) {
		return LLVMOpaqueValue*(this.component_source);
	};
	if (syntax->kind == syntax_kind::expr_access) {
		return @this.address((Syntax*)syntax->data.expression);
	};
	if (syntax_category((Syntax*)syntax) == value_category::temporary) {
		LLVMOpaqueValue* value = @this.expression((Syntax*)syntax);
		BackendSyntax* native = backend_syntax(@this.compiler->backend, (Syntax*)syntax);
		if (!native) {
			return nullptr;
		};
		if (native->address) {
			return LLVMOpaqueValue*(native->address);
		};
		LLVMOpaqueValue* slot = emit_slot(@*this.compiler, (Type*)syntax->type);
		LLVMBuildStore(this.compiler->backend.llvm_builder.get(), $value, LLVMOpaqueValue*(slot));
		@native->address := slot;
		return $slot;
	};
	LLVMOpaqueValue* address = @this.storage_address((Syntax*)syntax);
	Type* storage = syntax_storage_type((Syntax*)syntax);
	if (storage && storage->kind == type_kind::reference && syntax->kind != syntax_kind::expr_call && syntax->kind != syntax_kind::expr_cast && syntax->kind != syntax_kind::expr_base_reference) {
		return LLVMBuildLoad2(this.compiler->backend.llvm_builder.get(), llvm_type(@*this.compiler, $storage), LLVMOpaqueValue*(address), "referent\0");
	};
	return $address;
};

fn Emitter::cast(Emitter& this, LLVMOpaqueValue* value, Type* source, Type* target) -> LLVMOpaqueValue* {
	@source = type_representation(Type*(source));
	@target = type_representation(Type*(target));
	LLVMOpaqueBuilder* builder := this.compiler->backend.llvm_builder.get();
	LLVMOpaqueType* type = llvm_type(@*this.compiler, (Type*)target);
	if (target->kind == type_kind::kw_bool && source->kind != type_kind::kw_bool) {
		return @this.truth(LLVMOpaqueValue*(value), (Type*)source);
	};
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	if (source->kind == type_kind::pointer || source->kind == type_kind::reference) {
		if (target->kind == type_kind::pointer || target->kind == type_kind::reference) {
			return $value;
		};
		return LLVMBuildPtrToInt(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (target->kind == type_kind::pointer || target->kind == type_kind::reference) {
		return LLVMBuildIntToPtr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (source->kind == type_kind::kw_float && target->kind == type_kind::kw_float) {
		return LLVMBuildFPCast(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (source->kind == type_kind::kw_float) {
		if (type_unsigned((Type*)target)) {
			return LLVMBuildFPToUI(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
		};
		return LLVMBuildFPToSI(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	if (target->kind == type_kind::kw_float) {
		if (type_unsigned((Type*)source) || source->kind == type_kind::kw_char) {
			return LLVMBuildUIToFP(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
		};
		return LLVMBuildSIToFP(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueType*(type), "cast\0");
	};
	return LLVMBuildIntCast2($builder, $value, $type, !(type_unsigned((Type*)source) || source->kind == type_kind::kw_char), "cast\0");
};

fn emit_extension(Compiler& compiler, Type* type) -> LLVMOpaqueAttributeRef* {
	@type = type_representation(Type*(type));
	if (!type_integer((Type*)type) || type_bits((Type*)type) >= 32) {
		return nullptr;
	};
	char* name = "signext\0";
	if (type_unsigned((Type*)type) || type->kind == type_kind::kw_char) {
		@name = "zeroext\0";
	};
	return LLVMCreateEnumAttribute(compiler.backend.llvm_context.get(), LLVMGetEnumAttributeKindForName((char*)name, strlen($name)), 0);
};

fn Emitter::binary(Emitter& this, Syntax* syntax, LLVMOpaqueValue* first, LLVMOpaqueValue* second) -> LLVMOpaqueValue* {
	LLVMOpaqueBuilder* builder := this.compiler->backend.llvm_builder.get();
	Type* type := syntax->data.binary.left->type;
	token_kind operation := syntax->data.binary.operation;
	if (operation != token_kind::op_equal && operation != token_kind::op_not_equal && operation != token_kind::op_less && operation != token_kind::op_greater && operation != token_kind::op_less_equal && operation != token_kind::op_greater_equal) {
		@type := syntax->type;
	};
	@type = type_representation(Type*(type));
	if (type->kind == type_kind::pointer && (operation == token_kind::op_plus || operation == token_kind::op_minus)) {
		@second = @this.cast(LLVMOpaqueValue*(second), (Type*)syntax->data.binary.right->type, (Type*)this.compiler->usize_type);
		if (operation == token_kind::op_minus) {
			@second = LLVMBuildNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(second), "negative\0");
		};
		return LLVMBuildGEP2(LLVMOpaqueBuilder*(builder), llvm_type(@*this.compiler, (Type*)type->data.element), LLVMOpaqueValue*(first), &second, 1, "offset\0");
	};
	if (operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_greater || operation == token_kind::op_less_equal || operation == token_kind::op_greater_equal) {
		i32 predicate = 32;
		if (operation == token_kind::op_not_equal) {
			@predicate = 33;
		};
		if (operation == token_kind::op_greater) {
			@predicate = 38;
		};
		if (operation == token_kind::op_greater_equal) {
			@predicate = 39;
		};
		if (operation == token_kind::op_less) {
			@predicate = 40;
		};
		if (operation == token_kind::op_less_equal) {
			@predicate = 41;
		};
		LLVMOpaqueValue* result = nullptr;
		if (type->kind == type_kind::kw_float) {
			@predicate = 1;
			if (operation == token_kind::op_not_equal) {
				@predicate = 14;
			};
			if (operation == token_kind::op_greater) {
				@predicate = 2;
			};
			if (operation == token_kind::op_greater_equal) {
				@predicate = 3;
			};
			if (operation == token_kind::op_less) {
				@predicate = 4;
			};
			if (operation == token_kind::op_less_equal) {
				@predicate = 5;
			};
			@result = LLVMBuildFCmp(LLVMOpaqueBuilder*(builder), (i32)predicate, LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "compare\0");
		}
		else {
			if ((type_unsigned((Type*)type) || type->kind == type_kind::kw_char || type->kind == type_kind::pointer) && predicate >= 38) {
				@predicate = predicate - 4;
			};
			@result = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), (i32)predicate, LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "compare\0");
		};
		return $result;
	};
	if (type->kind == type_kind::kw_float) {
		switch (operation) {
			case token_kind::op_plus:
				return LLVMBuildFAdd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "sum\0");
			case token_kind::op_minus:
				return LLVMBuildFSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "difference\0");
			case token_kind::op_star:
				return LLVMBuildFMul(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "product\0");
			case token_kind::op_slash:
				return LLVMBuildFDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
		};
	};
	switch (operation) {
		case token_kind::op_plus:
			return LLVMBuildAdd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "sum\0");
		case token_kind::op_minus:
			return LLVMBuildSub(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "difference\0");
		case token_kind::op_star:
			return LLVMBuildMul(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "product\0");
		case token_kind::op_slash:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildUDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
			};
			return LLVMBuildSDiv(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "quotient\0");
		case token_kind::op_remainder:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildURem(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "remainder\0");
			};
			return LLVMBuildSRem(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "remainder\0");
		case token_kind::op_ampersand:
			return LLVMBuildAnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "and\0");
		case token_kind::op_pipe:
			return LLVMBuildOr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "or\0");
		case token_kind::op_caret:
			return LLVMBuildXor(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "xor\0");
		case token_kind::op_shift_left:
			return LLVMBuildShl(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "shift\0");
		case token_kind::op_shift_right:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildLShr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueValue*(second), "shift\0");
			};
			return LLVMBuildAShr($builder, $first, $second, "shift\0");
	};
	compiler_error(@*this.compiler, syntax->token, "unsupported numeric operation\0");
	return nullptr;
};

fn Emitter::call(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	if (syntax->data.call.receiver.kind == receiver_kind::evaluate) {
		Syntax* object := syntax->data.call.receiver.value;
		if (syntax_category((Syntax*)object) == value_category::storage) {
			@this.address((Syntax*)object);
		}
		else {
			@this.expression((Syntax*)object);
		};
	};
	Syntax* callee := syntax->data.call.callable;
	Type* signature := callee->type;
	if (signature->kind == type_kind::pointer) {
		@signature := signature->data.element;
	};
	u32 count = 0;
	if (syntax->data.call.receiver.kind == receiver_kind::bind) {
		@count = 1;
	};
	Syntax* argument := syntax->data.call.arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	LLVMOpaqueValue** values = (LLVMOpaqueValue**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueValue*));
	Parameter* parameter := signature->data.function.parameters;
	@argument := syntax->data.call.arguments;
	u32 index = 0;
	if (syntax->data.call.receiver.kind == receiver_kind::bind) {
		Syntax* receiver := syntax->data.call.receiver.value;
		if (parameter->type->kind == type_kind::reference) {
			@values[0] = @this.address((Syntax*)receiver);
		}
		else {
			@values[0] = @this.expression((Syntax*)receiver);
		};
		@parameter := parameter->next;
		@index = 1;
	};
	while (argument) {
		LLVMOpaqueValue* value = nullptr;
		if (argument->kind == syntax_kind::node_block) {
			BackendEntity* storage = backend_entity_define(@compiler, (Entity*)argument->entity);
			if (!storage) {
				return nullptr;
			};
			@storage->value = emit_slot(@compiler, (Type*)argument->type);
			if (argument->data.statements && argument->type->kind != type_kind::reference) {
				@this.initialize_type((Type*)argument->type, LLVMOpaqueValue*(storage->value));
			};
			@this.region((Syntax*)argument);
			@value = LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)argument->type), LLVMOpaqueValue*(storage->value), "argument\0");
		}
		else if (parameter && parameter->type->kind == type_kind::reference) {
			@value = @this.address((Syntax*)argument);
		}
		else {
			@value = @this.expression((Syntax*)argument);
		};
		if (parameter && parameter->type->kind != type_kind::reference) {
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)argument->type, (Type*)parameter->type);
		};
		if (!parameter) {
			Type* promoted := argument->type;
			if (promoted->kind == type_kind::kw_float && promoted->data.bits == 32) {
				@promoted = type_primitive(@compiler, type_kind::kw_float, 64);
			}
			else if (type_integer((Type*)promoted) && type_bits((Type*)promoted) < 32) {
				@promoted := compiler.i32_type;
			};
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)argument->type, $promoted);
		};
		@values[index] = $value;
		@index = index + 1;
		@argument := argument->next;
		if (parameter) {
			@parameter := parameter->next;
		};
	};
	char* name = "call\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* target = nullptr;
	if (callee->kind == syntax_kind::expr_name && callee->entity && callee->entity->kind == entity_kind::function) {
		Entity* function := callee->entity;
		if (function->data.function.callable && !syntax->data.call.qualified_owner && !callee->data.expression) {
			@target = @this.dispatch_target((Entity*)function, LLVMOpaqueValue*(values[0]));
		}
		else {
			@target := backend_entity(@compiler.backend, (Entity*)function)->value;
		};
	}
	else {
		@target = @this.expression((Syntax*)callee);
	};
	LLVMOpaqueValue* call = LLVMBuildCall2($builder, llvm_type(@compiler, (Type*)signature), $target, $values, $count, $name);
	emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), (Type*)signature);
	return $call;
};

fn Emitter::special_call(Emitter& this, Entity* function, LLVMOpaqueValue* receiver, Syntax* arguments) -> LLVMOpaqueValue* {
	Compiler& compiler = @*this.compiler;
	Type* signature := function->data.function.type;
	u32 count = 1;
	Syntax* argument := arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	LLVMOpaqueValue** values = (LLVMOpaqueValue**)memory_allocate(@compiler, (usize)count * sizeof(LLVMOpaqueValue*));
	@values[0] = $receiver;
	Parameter* parameter := signature->data.function.parameters->next;
	@argument := arguments;
	u32 index = 1;
	while (argument && parameter) {
		if (parameter->type->kind == type_kind::reference) {
			@values[index] = @this.address((Syntax*)argument);
		}
		else {
			@values[index] = @this.cast(@this.expression((Syntax*)argument), (Type*)argument->type, (Type*)parameter->type);
		};
		@argument := argument->next;
		@parameter := parameter->next;
		@index = index + 1;
	};
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)function);
	char* name = "special.call\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), $values, $count, $name);
	emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), $signature);
	return $call;
};

fn Emitter::component_call(Emitter& this, Entity* function, LLVMOpaqueValue* receiver, Syntax* argument, LLVMOpaqueValue* source) -> LLVMOpaqueValue* {
	LLVMOpaqueValue* previous := this.component_source;
	@this.component_source = $source;
	LLVMOpaqueValue* result = @this.special_call($function, $receiver, $argument);
	@this.component_source = $previous;
	return $result;
};

fn type_requires_destruction(Type* type) -> bool {
	return type_contains($type, type_property::destruction);
};

fn Emitter::destroy_fields(Emitter& this, Field* field, LLVMOpaqueValue* address) {
	if (!field) {
		return;
	};
	@this.destroy_fields((Field*)field->next, LLVMOpaqueValue*(address));
	Entity* entity := field->entity;
	Entity* owner := entity->data.variable.data.field.owner;
	LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, $owner), $address, (u32)entity->data.variable.data.field.index, "destroy.field\0");
	@this.destroy_type(entity_type($entity), $member);
};

fn Emitter::destroy_bases(Emitter& this, Entity* owner, BaseRelation* base, LLVMOpaqueValue* address) {
	if (!base) {
		return;
	};
	@this.destroy_bases((Entity*)owner, (BaseRelation*)base->next, LLVMOpaqueValue*(address));
	if (base->kind == base_kind::nonvirtual) {
		LLVMOpaqueValue* subobject = LLVMBuildStructGEP2(this.compiler->backend.llvm_builder.get(), llvm_body(@*this.compiler, (Entity*)owner), LLVMOpaqueValue*(address), (u32)base->component, "destroy.base\0");
		@this.destroy_body((Entity*)base->entity, $subobject);
	};
};

fn Emitter::destroy_body(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->data.aggregate.destructor) {
		if (entity->data.aggregate.destructor->data.function.definition == function_definition::deleted) {
			compiler_error(@*this.compiler, entity->name, "selected destructor is deleted\0");
			return;
		};
		if (entity->data.aggregate.destructor->data.function.definition != function_definition::defaulted) {
			@this.special_call((Entity*)entity->data.aggregate.destructor, LLVMOpaqueValue*(address), nullptr);
		};
	};
	if (entity->kind == entity_kind::kw_enum) {
		@this.destroy_type((Type*)entity->data.enumeration.underlying, $address);
		return;
	};
	if (entity->kind == entity_kind::kw_union) {
		if (!entity->data.aggregate.destructor || entity->data.aggregate.destructor->data.function.definition == function_definition::defaulted) {
			Field* field := entity->data.aggregate.fields;
			while (field) {
				if (type_requires_destruction(entity_type((Entity*)field->entity))) {
					compiler_error(@*this.compiler, entity->name, "union with nontrivial members requires an explicit destructor\0");
					return;
				};
				@field := field->next;
			};
		};
		return;
	};
	@this.destroy_fields((Field*)entity->data.aggregate.fields, LLVMOpaqueValue*(address));
	@this.destroy_bases((Entity*)entity, (BaseRelation*)entity->data.aggregate.bases, $address);
};

fn Emitter::destroy_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (!type_requires_destruction((Type*)type)) {
		return;
	};
	if (type->kind == type_kind::array) {
		u64 index := type->data.array.count;
		while (index) {
			@index = index - 1;
			@this.destroy_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (usize)index));
		};
		return;
	};
	if (type->kind != type_kind::named) {
		return;
	};
	Entity* entity := type->data.entity;
	if (type_has_views($type)) {
		compiler_error(@*this.compiler, entity->name, "nontrivial polymorphic lifetimes are not implemented\0");
		return;
	};
	@this.destroy_body($entity, $address);
};

fn aggregate_default_constructor(Entity* entity) -> Entity* {
	Entity* constructor := entity->data.aggregate.constructors;
	while (constructor) {
		Parameter* parameter := constructor->data.function.type->data.function.parameters;
		if (parameter && !parameter->next) {
			return $constructor;
		};
		@constructor := constructor->data.function.overload_next;
	};
	return nullptr;
};

fn type_has_lifecycle_callbacks(Type* type) -> bool {
	return type_contains($type, type_property::lifecycle_callbacks);
};

fn Emitter::lifetime_polymorphism_supported(Emitter& this, Type* type) -> bool {
	if (type_has_views((Type*)type) && type_has_lifecycle_callbacks((Type*)type)) {
		Token token;
		if (type->kind == type_kind::named) {
			@token := type->data.entity->name;
		};
		compiler_error(@*this.compiler, token, "nontrivial polymorphic lifetimes are not implemented\0");
		return false;
	};
	return true;
};

fn Emitter::default_body_members(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	if (entity->kind == entity_kind::kw_union) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* subobject = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)base->component, "construct.base\0");
			@this.default_body((Entity*)base->entity, $subobject);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* member = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(address), (u32)field->entity->data.variable.data.field.index, "construct.field\0");
		@this.default_type(entity_type((Entity*)field->entity), $member);
		@field := field->next;
	};
};

fn Emitter::default_body(Emitter& this, Entity* entity, LLVMOpaqueValue* address) {
	Entity* constructor = aggregate_default_constructor((Entity*)entity);
	if (!constructor || constructor->data.function.definition != function_definition::defaulted) {
		@this.default_body_members((Entity*)entity, LLVMOpaqueValue*(address));
	};
	if (constructor) {
		@this.special_call((Entity*)constructor, LLVMOpaqueValue*(address), nullptr);
	};
};

fn Emitter::default_members(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (!@this.lifetime_polymorphism_supported((Type*)type)) {
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	Entity* entity := type->data.entity;
	@this.default_body_members($entity, $address);
};

fn Emitter::default_type(Emitter& this, Type* type, LLVMOpaqueValue* address) {
	if (type_enum((Type*)type)) {
		@this.default_type((Type*)type->data.entity->data.enumeration.underlying, $address);
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.default_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(address), (u64)index));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};
	Entity* constructor = aggregate_default_constructor((Entity*)type->data.entity);
	if (!constructor || constructor->data.function.definition != function_definition::defaulted) {
		@this.default_members((Type*)type, LLVMOpaqueValue*(address));
	};
	if (constructor) {
		@this.special_call((Entity*)constructor, LLVMOpaqueValue*(address), nullptr);
	};
};

enum storage_extent : [i32] {
	body;
	complete;
};

fn Emitter::temporary_register(Emitter& this, Type* type, LLVMOpaqueValue* value, LLVMOpaqueValue* address) -> LLVMOpaqueValue* {
	Temporary* temporary = (Temporary*)memory_allocate(@*this.compiler, sizeof(Temporary));
	@temporary->type := type;
	if (!address) {
		@address = emit_slot(@*this.compiler, (Type*)type);
		LLVMBuildStore(this.compiler->backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(address));
	};
	@temporary->address := address;
	@temporary->next := this.temporaries;
	@this.temporaries = $temporary;
	return $address;
};

fn Emitter::storage_special(Emitter& this, Type* type, function_role role, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, syntax_kind kind, storage_extent extent) -> bool {
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return false;
	};
	Syntax* argument = (Syntax*)memory_allocate(@*this.compiler, sizeof(Syntax));
	if (!argument) {
		return false;
	};
	@argument->kind := kind;
	@argument->token := type->data.entity->name;
	@argument->type := type;
	@argument->use = value_use::transferred;
	if (kind == syntax_kind::expr_borrowed_component) {
		@argument->type = type_qualified(@*this.compiler, (Type*)type, type_qualifier::kw_const);
	};
	Semantic semantic;
	@semantic.compiler := this.compiler;
	@semantic.scope := this.compiler->module;
	Entity* function = @semantic.special_select((Entity*)type->data.entity, (function_role)role, (Syntax*)argument, Token(argument->token));
	if (!function) {
		return false;
	};
	if (function->data.function.definition == function_definition::defaulted) {
		storage_transfer operation = storage_transfer::copy_construct;
		if (role == function_role::assignment) {
			@operation = storage_transfer::copy_assign;
		};
		@this.transfer_members((Entity*)type->data.entity, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), $operation);
		if (role == function_role::assignment && kind == syntax_kind::expr_owned_component) {
			@this.destroy_type((Type*)type, LLVMOpaqueValue*(source));
		};
		return true;
	};
	if (role == function_role::constructor) {
		if (extent == storage_extent::complete) {
			@this.default_members((Type*)type, LLVMOpaqueValue*(destination));
		}
		else {
			@this.default_body_members((Entity*)type->data.entity, LLVMOpaqueValue*(destination));
		};
	};
	LLVMOpaqueValue* result = @this.component_call((Entity*)function, $destination, (Syntax*)argument, LLVMOpaqueValue*(source));
	Type* result_type := function->data.function.type->data.function.result;
	if (role == function_role::assignment && result_type->kind != type_kind::reference && type_requires_destruction((Type*)result_type)) {
		@this.temporary_register((Type*)result_type, LLVMOpaqueValue*(result), nullptr);
	};
	if (role == function_role::assignment && kind == syntax_kind::expr_owned_component && function->data.function.type->data.function.parameters->next->type->kind == type_kind::reference) {
		@this.destroy_type((Type*)type, LLVMOpaqueValue*(source));
	};
	return true;
};

enum storage_transfer : [i32] {
	copy_construct;
	assign;
	copy_assign;
};

fn Emitter::transfer_body(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	Type* type = entity_type((Entity*)entity);
	function_role role = function_role::constructor;
	syntax_kind argument = syntax_kind::expr_borrowed_component;
	if (operation == storage_transfer::assign || operation == storage_transfer::copy_assign) {
		@role = function_role::assignment;
		if (operation == storage_transfer::assign) {
			@argument = syntax_kind::expr_owned_component;
		};
	};
	if (@this.storage_special((Type*)type, $role, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), $argument, storage_extent::body)) {
		return;
	};
	@this.transfer_members($entity, $destination, $source, $operation);
};

fn Emitter::transfer_members(Emitter& this, Entity* entity, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	Type* type = entity_type((Entity*)entity);
	if (entity->kind == entity_kind::kw_union) {
		@this.payload_copy($type, $destination, $source);
		return;
	};

	Compiler& compiler = @*this.compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)base->component, "transfer.base.target\0");
			LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)base->component, "transfer.base.source\0");
			@this.transfer_body((Entity*)base->entity, $target, $origin, (storage_transfer)operation);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		LLVMOpaqueValue* target = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(destination), (u32)field->entity->data.variable.data.field.index, "transfer.field.target\0");
		LLVMOpaqueValue* origin = LLVMBuildStructGEP2(compiler.backend.llvm_builder.get(), llvm_body(@compiler, (Entity*)entity), LLVMOpaqueValue*(source), (u32)field->entity->data.variable.data.field.index, "transfer.field.source\0");
		@this.transfer_type(entity_type((Entity*)field->entity), $target, $origin, (storage_transfer)operation);
		@field := field->next;
	};
};

fn Emitter::transfer_type(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, storage_transfer operation) {
	if (type_enum((Type*)type)) {
		@this.transfer_type((Type*)type->data.entity->data.enumeration.underlying, $destination, $source, $operation);
		return;
	};
	if (!@this.lifetime_polymorphism_supported((Type*)type)) {
		return;
	};
	if ((operation == storage_transfer::assign || operation == storage_transfer::copy_assign) && (type->qualifier == type_qualifier::kw_const || type->kind == type_kind::reference)) {
		Token token;
		compiler_error(@*this.compiler, token, "generated assignment cannot replace a const or reference component\0");
		return;
	};
	if (type->kind == type_kind::array) {
		usize index = 0;
		while (index < type->data.array.count) {
			@this.transfer_type((Type*)type->data.array.element, @this.array_element((Type*)type, LLVMOpaqueValue*(destination), (u64)index), @this.array_element((Type*)type, LLVMOpaqueValue*(source), (u64)index), (storage_transfer)operation);
			@index = index + 1;
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		@this.payload_copy($type, $destination, $source);
		return;
	};
	if (operation == storage_transfer::copy_construct && @this.storage_special((Type*)type, function_role::constructor, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source), syntax_kind::expr_borrowed_component, storage_extent::complete)) {
		return;
	};
	if (type_has_views((Type*)type)) {
		@this.payload_copy($type, $destination, $source);
		return;
	};
	@this.transfer_body((Entity*)type->data.entity, $destination, $source, $operation);
};

fn Emitter::copy_construct_type(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	@this.transfer_type($type, $destination, $source, storage_transfer::copy_construct);
};

fn Emitter::assign_storage(Emitter& this, Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) {
	@this.transfer_type($type, $destination, $source, storage_transfer::assign);
};

fn Emitter::failed_arguments(Emitter& this, Syntax* argument) {
	if (!argument) {
		return;
	};

	LLVMOpaqueValue* storage = nullptr;
	if (argument->use == value_use::transferred && type_requires_destruction((Type*)argument->type)) {
		@storage = @this.address((Syntax*)argument);
	}
	else {
		@this.expression((Syntax*)argument);
	};

	@this.failed_arguments((Syntax*)argument->next);
	if (storage) {
		@this.destroy_type((Type*)argument->type, LLVMOpaqueValue*(storage));
	};
};

fn Emitter::guard_temporaries(Emitter& this, Temporary* first, Temporary* boundary, LLVMOpaqueBasicBlock* created, LLVMOpaqueBasicBlock* skipped) {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueType* bool_type = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1);
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = $created;
	@blocks[1] = $skipped;
	while (first != boundary) {
		LLVMOpaqueValue*[2] values {};
		@values[0] := first->guard;
		if (!values[0]) {
			@values[0] = LLVMConstInt(LLVMOpaqueType*(bool_type), 1, 0);
		};
		@values[1] = LLVMConstInt(LLVMOpaqueType*(bool_type), 0, 0);
		LLVMOpaqueValue* guard = LLVMBuildPhi(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(bool_type), "temporary.created\0");
		LLVMAddIncoming(LLVMOpaqueValue*(guard), &values[0], &blocks[0], 2);
		@first->guard = $guard;
		@first := first->next;
	};
};

fn Emitter::construct_at(Emitter& this, Syntax* syntax, LLVMOpaqueValue* slot) {
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	Type* target := syntax->data.construction.target;
	Syntax* argument := syntax->data.construction.arguments;
	if (syntax->data.construction.constructor) {
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMConstNull(llvm_type(@compiler, (Type*)target)), LLVMOpaqueValue*(slot));
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		if (syntax->data.construction.constructor->data.function.definition != function_definition::defaulted) {
			@this.default_members((Type*)target, LLVMOpaqueValue*(slot));
		};
		@this.special_call((Entity*)syntax->data.construction.constructor, LLVMOpaqueValue*(slot), (Syntax*)argument);
	}
	else if (!argument) {
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMConstNull(llvm_type(@compiler, (Type*)target)), LLVMOpaqueValue*(slot));
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		@this.default_type((Type*)target, LLVMOpaqueValue*(slot));
	}
	else if (type_aggregate((Type*)target)) {
		LLVMOpaqueValue* source = @this.address((Syntax*)argument);
		@this.initialize_type((Type*)target, LLVMOpaqueValue*(slot));
		@this.copy_construct_type((Type*)target, LLVMOpaqueValue*(slot), LLVMOpaqueValue*(source));
	}
	else {
		LLVMOpaqueValue* value = @this.cast(@this.expression((Syntax*)argument), (Type*)argument->type, (Type*)target);
		LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(slot));
	};
};

fn Emitter::expression_value(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return @this.complete_read((Type*)syntax->type, LLVMOpaqueValue*(this.component_source));
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	LLVMOpaqueType* type = llvm_type(@compiler, (Type*)syntax->type);
	switch (syntax->kind) {
		case syntax_kind::kw_new: {
			Syntax* construction := syntax->data.expression;
			Type* target := construction->data.construction.target;
			LLVMOpaqueValue* memory = LLVMBuildMalloc(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, (Type*)target), "new.storage\0");
			LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.construct\0");
			LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.end\0");
			LLVMOpaqueBasicBlock* failed = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "new.failed\0");
			LLVMOpaqueValue* empty = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), 32, LLVMOpaqueValue*(memory), LLVMConstNull(llvm_type(@compiler, (Type*)syntax->type)), "new.null\0");
			LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), $empty, LLVMOpaqueBasicBlock*(failed), LLVMOpaqueBasicBlock*(live));
			Temporary* boundary := this.temporaries;
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(live));
			@this.construct_at((Syntax*)construction, LLVMOpaqueValue*(memory));
			@live = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
			Temporary* success := this.temporaries;
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(failed));
			@this.failed_arguments((Syntax*)construction->data.construction.arguments);
			@failed = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $merge);
			@this.guard_temporaries((Temporary*)this.temporaries, (Temporary*)success, LLVMOpaqueBasicBlock*(failed), LLVMOpaqueBasicBlock*(live));
			@this.guard_temporaries($success, $boundary, $live, $failed);
			return $memory;
		};
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard: {
			Syntax* operand := syntax->data.expression;
			LLVMOpaqueValue* memory = @this.expression((Syntax*)operand);
			LLVMOpaqueBasicBlock* live = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "delete.live\0");
			LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "delete.end\0");
			LLVMOpaqueValue* empty = LLVMBuildICmp(LLVMOpaqueBuilder*(builder), 32, LLVMOpaqueValue*(memory), LLVMConstNull(llvm_type(@compiler, (Type*)operand->type)), "delete.null\0");
			LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), $empty, LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(live));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $live);
			if (syntax->kind == syntax_kind::kw_delete) {
				@this.destroy_type((Type*)operand->type->data.element, LLVMOpaqueValue*(memory));
			};
			LLVMBuildFree(LLVMOpaqueBuilder*(builder), $memory);
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
			LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), $merge);
			return nullptr;
		};
		case syntax_kind::expr_destroy:
			@this.destroy_type((Type*)syntax->data.cast.value->type, @this.address((Syntax*)syntax->data.cast.value));
			return nullptr;
		case syntax_kind::kw_discard:
			return nullptr;
		case syntax_kind::expr_construct: {
			Type* target := syntax->data.construction.target;
			LLVMOpaqueValue* slot = nullptr;
			if (syntax->data.construction.destination) {
				@slot = @this.address((Syntax*)syntax->data.construction.destination);
			}
			else {
				@slot = emit_slot(@compiler, (Type*)target);
			};
			@backend_syntax(@compiler.backend, (Syntax*)syntax)->constructed := slot;
			@this.construct_at((Syntax*)syntax, LLVMOpaqueValue*(slot));
			return LLVMBuildLoad2(LLVMOpaqueBuilder*(builder), llvm_type(@compiler, $target), $slot, "constructed\0");
		};
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
			return @this.expression((Syntax*)syntax->data.expression);
		case syntax_kind::expr_base_pointer:
			return @this.base_conversion((Syntax*)syntax);
		case syntax_kind::expr_base_reference:
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::kw_nullptr:
			return LLVMConstNull($type);
		case syntax_kind::literal_number:
			if (syntax->type->kind == type_kind::pointer) {
				return LLVMConstNull($type);
			};
			if (syntax->type->kind == type_kind::kw_bool) {
				return LLVMConstInt(LLVMOpaqueType*(type), number_truth(@compiler, syntax->token), 0);
			};
			if (syntax->type->kind == type_kind::kw_float) {
				if (syntax->token.source->bytes.data[syntax->token.begin] == '\'') {
					return LLVMConstReal(LLVMOpaqueType*(type), (f64)integer_spelling(@compiler, syntax->token, (u64)18446744073709551615));
				};
				char* text = memory_text(@compiler, syntax->token.source->bytes.data + syntax->token.begin, (u64)syntax->token.length);
				return LLVMConstReal(LLVMOpaqueType*(type), strtod($text, nullptr));
			};
			if (number_decimal(syntax->token)) {
				char* text = memory_text(@compiler, syntax->token.source->bytes.data + syntax->token.begin, usize(syntax->token.length));
				return LLVMConstInt(LLVMOpaqueType*(type), (u64)trunc(strtod($text, nullptr)), 0);
			};
			return LLVMConstInt(LLVMOpaqueType*(type), integer_spelling(@compiler, syntax->token, (u64)18446744073709551615), 0);
		case syntax_kind::literal_string: {
			LLVMOpaqueValue* value = LLVMConstStringInContext2(compiler.backend.llvm_context.get(), (char*)syntax->data.string.data, (u64)syntax->data.string.size, 1);
			LLVMOpaqueValue* global = LLVMAddGlobal(compiler.backend.llvm_module.get(), LLVMTypeOf(LLVMOpaqueValue*(value)), "string\0");
			LLVMSetInitializer(LLVMOpaqueValue*(global), LLVMOpaqueValue*(value));
			LLVMSetGlobalConstant(LLVMOpaqueValue*(global), 1);
			LLVMSetLinkage(LLVMOpaqueValue*(global), 9);
			return $global;
		};
		case syntax_kind::expr_name:
			if (syntax->entity->kind == entity_kind::function) {
				return runtime_callable(@compiler, (Entity*)syntax->entity);
			};
			if (syntax->entity->data.variable.storage == storage_kind::constant) {
				if (syntax->entity->data.variable.evaluation && syntax->entity->data.variable.evaluation->state == constant_state::constant) {
					return constant_llvm(@compiler, (ConstantValue*)syntax->entity->data.variable.evaluation->value);
				};
				return LLVMConstInt(LLVMOpaqueType*(type), (u64)syntax->entity->data.variable.data.integer, 0);
			};
			if (syntax->type->kind == type_kind::function) {
				return @this.address((Syntax*)syntax);
			};
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::expr_member:
		case syntax_kind::expr_index:
			if (syntax->type->kind == type_kind::function) {
				return @this.address((Syntax*)syntax);
			};
			return @this.value_read((Syntax*)syntax);
		case syntax_kind::kw_sizeof:
			return LLVMConstInt($type, LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, (Type*)syntax->data.sizeof_operand.measured)), 0);
		case syntax_kind::expr_cast:
			return @this.cast(@this.expression((Syntax*)syntax->data.cast.value), (Type*)syntax->data.cast.value->type, (Type*)syntax->type);
		case syntax_kind::expr_unary: {
			token_kind operation := syntax->data.unary.operation;
			Syntax* operand := syntax->data.unary.value;
			if (operation == token_kind::op_ampersand) {
				if (operand->type->kind == type_kind::function) {
					return @this.expression((Syntax*)operand);
				};
				return @this.address((Syntax*)operand);
			};
			if (operation == token_kind::op_star) {
				if (syntax->type->kind == type_kind::function) {
					return @this.expression((Syntax*)operand);
				};
				return @this.value_read((Syntax*)syntax);
			};
			LLVMOpaqueValue* value = @this.expression((Syntax*)operand);
			if (operation == token_kind::op_bang) {
				@value = LLVMBuildNot(LLVMOpaqueBuilder*(builder), @this.truth(LLVMOpaqueValue*(value), (Type*)operand->type), "not\0");
				return $value;
			};
			@value = @this.cast(LLVMOpaqueValue*(value), (Type*)operand->type, (Type*)syntax->type);
			if (operation == token_kind::op_tilde) {
				return LLVMBuildNot(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "complement\0");
			};
			if (operation == token_kind::op_minus) {
				if (syntax->type->kind == type_kind::kw_float) {
					return LLVMBuildFNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "negative\0");
				};
				return LLVMBuildNeg(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), "negative\0");
			};
			return $value;
		};
		case syntax_kind::stmt_bind_reference: {
			Syntax* left := syntax->data.binary.left;
			LLVMOpaqueValue* referent = @this.address((Syntax*)syntax->data.binary.right);
			LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(referent), @this.storage_address((Syntax*)left));
			return $referent;
		};
		case syntax_kind::stmt_initialize:
		case syntax_kind::expr_binary: {
			token_kind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
				if (syntax->entity && syntax->entity->kind == entity_kind::function && syntax->entity->data.function.role == function_role::assignment) {
					LLVMOpaqueValue* result = @this.special_call((Entity*)syntax->entity, @this.address((Syntax*)left), (Syntax*)right);
					Type* declared := syntax->entity->data.function.type->data.function.result;
					if (declared->kind == type_kind::reference) {
						return @this.complete_read((Type*)syntax->type, LLVMOpaqueValue*(result));
					};
					return $result;
				};
				if (type_aggregate((Type*)left->type)) {
					LLVMOpaqueValue* destination = nullptr;
					if (type_has_views((Type*)left->type)) {
						@destination = @this.address((Syntax*)left);
					};
					LLVMOpaqueValue* source = nullptr;
					if (syntax_category((Syntax*)right) == value_category::storage) {
						@source = @this.address((Syntax*)right);
					}
					else {
						LLVMOpaqueValue* value = @this.expression((Syntax*)right);
						@source = emit_slot(@compiler, (Type*)right->type);
						LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(source));
					};
					if (!destination) {
						@destination = @this.address((Syntax*)left);
					};
					@backend_syntax(@compiler.backend, (Syntax*)syntax)->address := destination;
					if (syntax->kind == syntax_kind::stmt_initialize) {
						if (left->kind != syntax_kind::expr_base_reference) {
							@this.initialize_type((Type*)left->type, LLVMOpaqueValue*(destination));
						};
						@this.payload_copy((Type*)left->type, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
					}
					else {
						@this.assign_storage((Type*)left->type, LLVMOpaqueValue*(destination), LLVMOpaqueValue*(source));
					};
					return @this.complete_read((Type*)left->type, $destination);
				};
				LLVMOpaqueValue* value = @this.expression((Syntax*)right);
				@value = @this.cast(LLVMOpaqueValue*(value), (Type*)right->type, (Type*)left->type);
				LLVMOpaqueValue* destination = @this.address((Syntax*)left);
				@backend_syntax(@compiler.backend, (Syntax*)syntax)->address := destination;
				LLVMBuildStore(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueValue*(destination));
				return $value;
			};
			if (operation == token_kind::op_and || operation == token_kind::op_or) {
				LLVMOpaqueBasicBlock* initial = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				LLVMOpaqueValue* function = LLVMGetBasicBlockParent(LLVMOpaqueBasicBlock*(initial));
				LLVMOpaqueBasicBlock* rhs = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "logical.right\0");
				LLVMOpaqueBasicBlock* merge = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "logical.end\0");
				LLVMOpaqueValue* first = @this.truth(@this.expression((Syntax*)left), (Type*)left->type);
				@initial = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				if (operation == token_kind::op_and) {
					LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueBasicBlock*(rhs), LLVMOpaqueBasicBlock*(merge));
				}
				else {
					LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(first), LLVMOpaqueBasicBlock*(merge), LLVMOpaqueBasicBlock*(rhs));
				};
				LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(rhs));
				Temporary* boundary := this.temporaries;
				LLVMOpaqueValue* second = @this.truth(@this.expression((Syntax*)right), (Type*)right->type);
				@rhs = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
				LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
				LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(merge));
				LLVMOpaqueValue* phi = LLVMBuildPhi(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), "logical\0");
				LLVMOpaqueValue*[2] values {};
				LLVMOpaqueBasicBlock*[2] blocks {};
				@values[0] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), (u64)(operation == token_kind::op_or), 0);
				@values[1] = LLVMOpaqueValue*(second);
				@blocks[0] = LLVMOpaqueBasicBlock*(initial);
				@blocks[1] = LLVMOpaqueBasicBlock*(rhs);
				LLVMAddIncoming(LLVMOpaqueValue*(phi), &values[0], &blocks[0], 2);
				Temporary* temporary := this.temporaries;
				while (temporary != boundary) {
					LLVMOpaqueValue* guard = LLVMBuildPhi(LLVMOpaqueBuilder*(builder), LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), "temporary.created\0");
					@values[0] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), 0, 0);
					@values[1] := temporary->guard;
					if (!values[1]) {
						@values[1] = LLVMConstInt(LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 1), 1, 0);
					};
					LLVMAddIncoming(LLVMOpaqueValue*(guard), &values[0], &blocks[0], 2);
					@temporary->guard = LLVMOpaqueValue*(guard);
					@temporary := temporary->next;
				};
				return $phi;
			};
			LLVMOpaqueValue* first = @this.expression((Syntax*)left);
			LLVMOpaqueValue* second = @this.expression((Syntax*)right);
			if (left->type->kind != type_kind::pointer) {
				Type* operand := left->type;
				if (operation != token_kind::op_equal && operation != token_kind::op_not_equal && operation != token_kind::op_less && operation != token_kind::op_greater && operation != token_kind::op_less_equal && operation != token_kind::op_greater_equal) {
					@operand := syntax->type;
				};
				@first = @this.cast(LLVMOpaqueValue*(first), (Type*)left->type, (Type*)operand);
				@second = @this.cast(LLVMOpaqueValue*(second), (Type*)right->type, (Type*)operand);
			};
			return @this.binary((Syntax*)syntax, $first, $second);
		};
		case syntax_kind::expr_call: {
			if (syntax_storage_type((Syntax*)syntax)->kind == type_kind::reference && syntax->type->kind != type_kind::function) {
				return @this.value_read((Syntax*)syntax);
			};
			return @this.call((Syntax*)syntax);
		};
	};
	compiler_error(@compiler, syntax->token, "expression cannot be emitted\0");
	return nullptr;
};

fn Emitter::expression(Emitter& this, Syntax* syntax) -> LLVMOpaqueValue* {
	if (syntax->kind == syntax_kind::expr_borrowed_component || syntax->kind == syntax_kind::expr_owned_component) {
		return @this.expression_value($syntax);
	};
	BackendSyntax* native = backend_syntax_define(@*this.compiler, (Syntax*)syntax);
	if (!native) {
		return nullptr;
	};
	@native->address = nullptr;
	LLVMOpaqueValue* value = @this.expression_value((Syntax*)syntax);
	if (syntax->kind == syntax_kind::expr_construct) {
		@native->address := native->constructed;
	}
	else if (syntax->kind == syntax_kind::expr_relocate) {
		@native->address = @this.address((Syntax*)syntax->data.expression);
	};
	if (!value || syntax->use == value_use::transferred || syntax_category((Syntax*)syntax) != value_category::temporary || !type_requires_destruction((Type*)syntax->type)) {
		return $value;
	};
	@native->address = @this.temporary_register((Type*)syntax->type, LLVMOpaqueValue*(value), LLVMOpaqueValue*(native->address));
	return $value;
};

fn Emitter::flush_temporaries(Emitter& this, Temporary* boundary) {
	Compiler& compiler = @*this.compiler;
	while (this.temporaries != boundary) {
		Temporary* temporary := this.temporaries;
		@this.temporaries := temporary->next;
		if (!temporary->guard) {
			@this.destroy_type((Type*)temporary->type, LLVMOpaqueValue*(temporary->address));
			continue;
		};
		LLVMOpaqueBasicBlock* destroy = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "temporary.destroy\0");
		LLVMOpaqueBasicBlock* continuation = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "temporary.end\0");
		LLVMBuildCondBr(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(temporary->guard), LLVMOpaqueBasicBlock*(destroy), LLVMOpaqueBasicBlock*(continuation));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $destroy);
		@this.destroy_type((Type*)temporary->type, LLVMOpaqueValue*(temporary->address));
		LLVMBuildBr(compiler.backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(continuation));
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $continuation);
	};
};

fn Emitter::jump(Emitter& this, LLVMOpaqueBasicBlock* block) {
	LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.compiler->backend.llvm_builder.get());
	if (!LLVMGetBasicBlockTerminator($current)) {
		LLVMBuildBr(this.compiler->backend.llvm_builder.get(), LLVMOpaqueBasicBlock*(block));
	};
};

struct BackendMirBlock {
	LLVMOpaqueBasicBlock* value;
};

fn Emitter::cleanups(Emitter& this, LifetimeCleanup* cleanup) {
	while (cleanup) {
		Entity* entity := cleanup->entity;
		@this.destroy_type(entity_type((Entity*)entity), LLVMOpaqueValue*(backend_entity(@this.compiler->backend, (Entity*)entity)->value));
		@cleanup := cleanup->next;
	};
};

fn Emitter::mir_target(Emitter& this, MirEdge* edge, IdentityMap<BackendMirBlock>& blocks) -> LLVMOpaqueBasicBlock* {
	BackendMirBlock* target = @blocks.find((const void*)edge->target, nullptr);
	if (!target) {
		compiler_error(@*this.compiler, edge->token, "control edge has no native target\0");
		return nullptr;
	};
	if (!edge->cleanup) {
		return LLVMOpaqueBasicBlock*(target->value);
	};
	Compiler& compiler = @*this.compiler;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	LLVMOpaqueBasicBlock* previous = LLVMGetInsertBlock(LLVMOpaqueBuilder*(builder));
	LLVMOpaqueBasicBlock* cleanup = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "edge.cleanup\0");
	LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(cleanup));
	@this.cleanups((LifetimeCleanup*)edge->cleanup);
	LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(target->value));
	LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(previous));
	return LLVMOpaqueBasicBlock*(cleanup);
};

fn Emitter::declare(Emitter& this, Syntax* syntax) {
	Entity* variable := syntax->entity;
	BackendEntity* storage = backend_entity_define(@*this.compiler, (Entity*)variable);
	if (!storage) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	if (!syntax->data.declaration.body) {
		LLVMBuildStore(compiler.backend.llvm_builder.get(), LLVMConstNull(llvm_type(@compiler, (Type*)variable->data.variable.type)), LLVMOpaqueValue*(storage->value));
		@this.initialize_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
		@this.default_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
	}
	else if (syntax->data.declaration.body->data.statements && variable->data.variable.type->kind != type_kind::reference) {
		@this.initialize_type((Type*)variable->data.variable.type, LLVMOpaqueValue*(storage->value));
	};
};

fn Emitter::region(Emitter& this, Syntax* syntax) {
	if (!syntax || this.compiler->result == compilation_result::failure) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	MirRegion* region = mir_region(@compiler, (Syntax*)syntax, (MirScope*)this.scope);
	if (!region || compiler.result == compilation_result::failure) {
		return;
	};
	MirScope* previous_scope := this.scope;
	Temporary* boundary := this.temporaries;
	LLVMOpaqueBuilder* builder := compiler.backend.llvm_builder.get();
	IdentityMap<BackendMirBlock> blocks;
	MirBlock* block := region->blocks;
	while (block && compiler.result == compilation_result::success) {
		BackendMirBlock* native = identity_record<BackendMirBlock>(@compiler, @blocks, (const void*)block, nullptr);
		if (!native) {
			return;
		};
		if (block->kind == mir_kind::declare) {
			Entity* variable := block->value->entity;
			BackendEntity* storage = backend_entity_define(@compiler, (Entity*)variable);
			if (!storage) {
				return;
			};
			@storage->value = emit_slot(@compiler, (Type*)variable->data.variable.type);
		};
		@native->value = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "mir.block\0");
		@block := block->next;
	};
	LLVMOpaqueBasicBlock* continuation = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(this.llvm_function), "mir.end\0");
	BackendMirBlock* entry = @blocks.find((const void*)region->entry, nullptr);
	@this.jump(LLVMOpaqueBasicBlock*(entry->value));
	@block := region->blocks;
	while (block && compiler.result == compilation_result::success) {
		BackendMirBlock* native = @blocks.find((const void*)block, nullptr);
		LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(native->value));
		@this.scope := block->scope;
		@this.temporaries := boundary;
		if (block->kind == mir_kind::exit) {
			LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(continuation));
			@block := block->next;
			continue;
		};
		LLVMOpaqueValue* value = nullptr;
		if (block->kind == mir_kind::declare) {
			@this.declare((Syntax*)block->value);
		}
		else if (block->value) {
			if (block->kind == mir_kind::kw_return && this.function->data.function.type->data.function.result->kind == type_kind::reference) {
				@value = @this.address((Syntax*)block->value);
			}
			else {
				@value = @this.expression((Syntax*)block->value);
			};
		};
		if (block->kind == mir_kind::kw_return) {
			if (block->value) {
				Type* result := this.function->data.function.type->data.function.result;
				if (result->kind != type_kind::reference) {
					@value = @this.cast(LLVMOpaqueValue*(value), (Type*)block->value->type, (Type*)result);
				};
				if (this.return_type && !type_equal((Type*)result, (Type*)this.return_type)) {
					@value = @this.covariant_result(LLVMOpaqueValue*(value), (Type*)result, (Type*)this.return_type);
				};
			};
			@this.flush_temporaries(nullptr);
			@this.cleanups((LifetimeCleanup*)block->edges->cleanup);
			if (block->value) {
				LLVMBuildRet(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value));
			}
			else {
				LLVMBuildRetVoid(LLVMOpaqueBuilder*(builder));
			};
		}
		else {
			@this.flush_temporaries((Temporary*)boundary);
			MirEdge* edge := block->edges;
			if (block->kind == mir_kind::branch) {
				LLVMOpaqueBasicBlock* first = nullptr;
				LLVMOpaqueBasicBlock* second = nullptr;
				while (edge) {
					if (edge->kind == mir_edge_kind::when_true) {
						@first = @this.mir_target((MirEdge*)edge, @blocks);
					}
					else {
						@second = @this.mir_target((MirEdge*)edge, @blocks);
					};
					@edge := edge->next;
				};
				if (block->value) {
					LLVMBuildCondBr(LLVMOpaqueBuilder*(builder), @this.truth(LLVMOpaqueValue*(value), (Type*)block->value->type), LLVMOpaqueBasicBlock*(first), LLVMOpaqueBasicBlock*(second));
				}
				else {
					LLVMBuildBr(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(first));
				};
			}
			else if (block->kind == mir_kind::dispatch) {
				LLVMOpaqueBasicBlock* fallback = nullptr;
				u32 count = 0;
				while (edge) {
					if (edge->kind == mir_edge_kind::otherwise) {
						@fallback = @this.mir_target((MirEdge*)edge, @blocks);
					}
					else {
						@count = count + 1;
					};
					@edge := edge->next;
				};
				LLVMOpaqueValue* instruction = LLVMBuildSwitch(LLVMOpaqueBuilder*(builder), LLVMOpaqueValue*(value), LLVMOpaqueBasicBlock*(fallback), (u32)count);
				@edge := block->edges;
				while (edge) {
					if (edge->kind == mir_edge_kind::case_value) {
						LLVMAddCase(LLVMOpaqueValue*(instruction), LLVMConstInt(llvm_type(@compiler, (Type*)block->value->type), (u64)edge->selector, 0), @this.mir_target((MirEdge*)edge, @blocks));
					};
					@edge := edge->next;
				};
			}
			else if (edge) {
				LLVMBuildBr(LLVMOpaqueBuilder*(builder), @this.mir_target((MirEdge*)edge, @blocks));
			};
		};
		@block := block->next;
	};
	@this.scope := previous_scope;
	@this.temporaries := boundary;
	LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder*(builder), LLVMOpaqueBasicBlock*(continuation));
};

struct LayoutVisit {
	Entity* entity;
	LayoutVisit* parent;
};

fn layout_validate(Compiler& compiler, Type* type, LayoutVisit* parent, const Token& token) {
	if (!type) {
		return;
	};
	if (type_enum((Type*)type)) {
		if (type->data.entity->state != resolution::active || !type->data.entity->data.enumeration.underlying) {
			entity_resolve(@compiler, (Entity*)type->data.entity);
		};
		if (compiler.result == compilation_result::failure) {
			return;
		};
		layout_validate(@compiler, (Type*)type->data.entity->data.enumeration.underlying, $parent, token);
		return;
	};
	if (type->kind == type_kind::kw_void || type->kind == type_kind::kw_null || type->kind == type_kind::function) {
		compiler_error(@compiler, token, "type has no value storage layout\0");
		return;
	};
	if (type->kind == type_kind::array) {
		layout_validate(@compiler, (Type*)type->data.array.element, (LayoutVisit*)parent, token);
		if (compiler.result == compilation_result::failure) {
			return;
		};

		u64 size = LLVMABISizeOfType(compiler.backend.llvm_layout.get(), llvm_type(@compiler, (Type*)type->data.array.element));
		u64 maximum = 18446744073709551615;
		if (compiler.usize_type->data.bits < 64) {
			@maximum = 1;
			i32 bit = 0;
			while (bit < compiler.usize_type->data.bits) {
				@maximum = maximum * 2;
				@bit = bit + 1;
			};
			@maximum = maximum - 1;
		};
		if (size && type->data.array.count > maximum / size) {
			compiler_error(@compiler, token, "array storage exceeds the native address range\0");
		};
		return;
	};
	if (type->kind != type_kind::named || type->data.entity->kind == entity_kind::kw_enum) {
		return;
	};

	Entity* entity := type->data.entity;
	LayoutVisit* previous := parent;
	while (previous) {
		if (previous->entity == entity) {
			compiler_error(@compiler, token, "record contains itself by value\0");
			return;
		};
		@previous := previous->parent;
	};

	entity_resolve(@compiler, (Entity*)entity);
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		compiler_error(@compiler, token, "incomplete record has no storage layout\0");
		return;
	};

	Field* binding := entity->data.aggregate.fields;
	LayoutVisit visit;
	@visit.entity := entity;
	@visit.parent = $parent;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type((Entity*)base->entity), &visit, base->name->token);
		@base := base->next;
	};
	while (binding && compiler.result != compilation_result::failure) {
		layout_validate(@compiler, entity_type((Entity*)binding->entity), &visit, binding->entity->name);
		@binding := binding->next;
	};
};

struct DeclarationIterator {
	Scope* scope;
};

fn declaration_next(DeclarationIterator* iterator, Binding* binding) -> Binding* {
	Scope* members = nullptr;
	if (binding->entity->kind == entity_kind::kw_namespace || binding->entity->kind == entity_kind::kw_struct || binding->entity->kind == entity_kind::kw_union || binding->entity->kind == entity_kind::kw_enum || binding->entity->kind == entity_kind::kw_template) {
		@members = entity_members((Entity*)binding->entity);
	};
	if (members && members->bindings) {
		@iterator->scope = (Scope*)members;
		return (Binding*)iterator->scope->bindings;
	};
	while (!binding->next) {
		Entity* owner := iterator->scope->owner;
		if (!owner || (owner->kind != entity_kind::kw_namespace && owner->kind != entity_kind::kw_struct && owner->kind != entity_kind::kw_union && owner->kind != entity_kind::kw_enum && owner->kind != entity_kind::kw_template)) {
			return nullptr;
		};
		@iterator->scope := iterator->scope->parent;
		@binding := iterator->scope->bindings;
		while (binding && binding->entity != owner) {
			@binding := binding->next;
		};
		if (!binding) {
			return nullptr;
		};
	};
	return (Binding*)binding->next;
};

fn declarations_validate_block(Compiler& compiler, Syntax* module) {
	Syntax* statement := module->data.statements;
	while (statement && compiler.result != compilation_result::failure) {
		if (statement->kind != syntax_kind::node_declaration) {
			compiler_error(@compiler, statement->token, "module context requires declarations\0");
			return;
		};

		Entity* entity := statement->entity;
		if (statement->token.kind == token_kind::kw_namespace) {
			declarations_validate_block(@compiler, (Syntax*)statement->data.declaration.body);
		}
		else if (entity->kind == entity_kind::function) {
			Type* declared = type_resolve(@compiler, (Scope*)entity->scope, (TypeSyntax*)statement->data.declaration.type);
			interface_receiver_validate(@compiler, (Entity*)entity, (Type*)declared, statement->token);
			if (statement->data.declaration.modification != function_modification::ordinary && (!entity->data.function.interface_owner || statement->data.declaration.modification != entity->data.function.modification)) {
				compiler_error(@compiler, statement->token, "virtual relationships require a matching struct interface declaration\0");
			};
			if (!type_equal($declared, (Type*)entity->data.function.type)) {
				compiler_error(@compiler, statement->token, "conflicting function signature\0");
			};
			if (statement->data.declaration.definition != function_definition::declaration && statement != entity->declaration) {
				compiler_error(@compiler, statement->token, "duplicate function definition\0");
			};
		}
		else if (entity->kind == entity_kind::variable) {
			if (entity->data.variable.storage == storage_kind::global) {
				global_variable_resolve(@compiler, (Entity*)entity);
			};
		}
		else if (statement->data.declaration.body && statement != entity->declaration) {
			compiler_error(@compiler, statement->token, "duplicate type definition\0");
		}
		else if ((entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union) && statement->data.declaration.body) {
			declarations_validate_block(@compiler, (Syntax*)statement->data.declaration.body);
		};
		@statement := statement->next;
	};
};

fn declarations_validate(Compiler& compiler) {
	Syntax* module := compiler.declarations;
	while (module && compiler.result != compilation_result::failure) {
		declarations_validate_block(@compiler, (Syntax*)module);
		@module := module->next;
	};
};

fn external_validate(Compiler& compiler, Entity* entity) {
	if (entity->data.function.body || (entity->scope && entity->scope->owner && (entity->scope->owner->kind == entity_kind::kw_struct || entity->scope->owner->kind == entity_kind::kw_union))) {
		return;
	};
	DeclarationIterator iterator;
	@iterator.scope := compiler.module;
	Binding* binding := compiler.module->bindings;
	while (binding && binding->entity != entity) {
		Entity* previous := binding->entity;
		if (previous->kind == entity_kind::function && !previous->data.function.body && (!previous->scope || !previous->scope->owner || (previous->scope->owner->kind != entity_kind::kw_struct && previous->scope->owner->kind != entity_kind::kw_union)) && token_same(previous->name, entity->name) && !type_equal((Type*)previous->data.function.type, (Type*)entity->data.function.type)) {
			compiler_error(@compiler, entity->name, "conflicting external C function signature\0");
			return;
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn virtual_signature_equal(Entity* first, Entity* second) -> bool {
	if (!token_same(first->name, second->name)) {
		return false;
	};
	Type* left := first->data.function.type;
	Type* right := second->data.function.type;
	if (!left || !right || left->data.function.arity != right->data.function.arity) {
		return false;
	};
	Parameter* a := left->data.function.parameters;
	Parameter* b := right->data.function.parameters;
	if (!a || !b || !function_receiver((Entity*)first) || !function_receiver((Entity*)second)) {
		return false;
	};
	@a := a->next;
	@b := b->next;
	while (a && b) {
		if (!type_equal((Type*)a->type, (Type*)b->type)) {
			return false;
		};
		@a := a->next;
		@b := b->next;
	};
	return !a && !b;
};

fn virtual_result_compatible(Compiler& compiler, Type* derived, Type* base) -> bool {
	if (type_equal((Type*)derived, (Type*)base)) {
		return true;
	};
	if (derived->kind != base->kind || (derived->kind != type_kind::pointer && derived->kind != type_kind::reference)) {
		return false;
	};
	return base_search(@compiler, (Type*)derived->data.element, (Type*)base->data.element).count == 1;
};

fn virtual_relationships(Compiler& compiler, Entity* function) {
	if (function->data.function.virtual_resolution == resolution::ready) {
		return;
	};
	@function->data.function.virtual_resolution = resolution::active;
	Entity* owner = nullptr;
	if (function->scope) {
		@owner := function->scope->owner;
	};
	if (!owner || owner->kind != entity_kind::kw_struct) {
		@function->data.function.virtual_resolution = resolution::ready;
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $owner);
	Subobject* object := graph->objects;
	while (object) {
		if (object != graph->root) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				Entity* inherited := callable->function;
				entity_resolve(@compiler, (Entity*)inherited);
				if (virtual_signature_equal((Entity*)function, (Entity*)inherited)) {
					OverrideLink* existing := function->data.function.overrides;
					while (existing && existing->function != inherited) {
						@existing := existing->next;
					};
					if (!existing) {
						OverrideLink* relation = (OverrideLink*)memory_allocate(@compiler, sizeof(OverrideLink));
						@relation->function := inherited;
						@relation->next := function->data.function.overrides;
						@function->data.function.overrides = $relation;
					};
					if (inherited->data.function.modification == function_modification::kw_final) {
						compiler_error(@compiler, function->name, "cannot override a final operation\0");
					};
					if (!virtual_result_compatible(@compiler, (Type*)function->data.function.type->data.function.result, (Type*)inherited->data.function.type->data.function.result)) {
						compiler_error(@compiler, function->name, "override has an incompatible return type\0");
					};
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	function_modification modification := function->data.function.modification;
	if (function->data.function.overrides && modification != function_modification::kw_override && modification != function_modification::kw_final) {
		compiler_error(@compiler, function->name, "matching inherited virtual operation requires explicit override or final\0");
	};
	if ((modification == function_modification::kw_override || modification == function_modification::kw_final) && !function->data.function.overrides) {
		compiler_error(@compiler, function->name, "override requires a matching inherited virtual operation\0");
	};
	if (modification != function_modification::ordinary && !function->data.function.interface_owner) {
		compiler_error(@compiler, function->name, "virtual relationships require a struct interface declaration\0");
	};
	@function->data.function.virtual_resolution = resolution::ready;
};

fn virtual_overrides(Entity* function, Entity* operation) -> bool {
	if (function == operation) {
		return true;
	};
	OverrideLink* relation := function->data.function.overrides;
	while (relation) {
		if (virtual_overrides((Entity*)relation->function, (Entity*)operation)) {
			return true;
		};
		@relation := relation->next;
	};
	return false;
};

struct VirtualCandidate {
	VirtualCandidate* next;
	VirtualTarget target;
};

fn virtual_target(Compiler& compiler, CompleteGraph* graph, Subobject* receiver, Entity* operation) -> VirtualTarget {
	VirtualCandidate* candidates = nullptr;
	Subobject* object := graph->objects;
	while (object) {
		if (subobject_contains((Subobject*)object, (Subobject*)receiver)) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				if (virtual_overrides((Entity*)callable->function, (Entity*)operation)) {
					VirtualCandidate* candidate = (VirtualCandidate*)memory_allocate(@compiler, sizeof(VirtualCandidate));
					@candidate->target.function := callable->function;
					@candidate->target.object := object;
					@candidate->next := candidates;
					@candidates = $candidate;
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	VirtualTarget result;
	VirtualCandidate* candidate := candidates;
	while (candidate) {
		VirtualCandidate* other := candidates;
		while (other && (other->target.object == candidate->target.object || !subobject_contains((Subobject*)other->target.object, (Subobject*)candidate->target.object))) {
			@other := other->next;
		};
		if (!other) {
			if (result.object && (result.object != candidate->target.object || result.function != candidate->target.function)) {
				compiler_error(@compiler, graph->entity->name, "virtual operation has multiple final overriders\0");
				return $result;
			};
			@result := candidate->target;
		};
		@candidate := candidate->next;
	};
	return $result;
};

fn virtual_validate(Compiler& compiler) {
	DeclarationIterator iterator;
	@iterator.scope := compiler.module;
	Binding* binding := compiler.module->bindings;
	while (binding && compiler.result != compilation_result::failure) {
		if (binding->entity->kind == entity_kind::function) {
			virtual_relationships(@compiler, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	@iterator.scope := compiler.module;
	@binding := compiler.module->bindings;
	while (binding && compiler.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if (entity->kind == entity_kind::kw_struct && entity->declaration && entity->declaration->data.declaration.body) {
			CompleteGraph* graph = complete_graph(@compiler, (Entity*)entity);
			Subobject* object := graph->objects;
			while (object && compiler.result != compilation_result::failure) {
				VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
				while (callable && compiler.result != compilation_result::failure) {
					virtual_target(@compiler, (CompleteGraph*)graph, (Subobject*)object, (Entity*)callable->function);
					@callable := callable->next;
				};
				@object := object->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn global_variable_resolve(Compiler& compiler, Entity* entity) {
	if (entity->state == resolution::ready) {
		return;
	};
	if (entity->state == resolution::active) {
		compiler_error(@compiler, entity->name, "circular global initializer\0");
		return;
	};
	@entity->state = resolution::active;
	Semantic semantic;
	@semantic.compiler = &compiler;
	@semantic.scope := entity->scope;
	@semantic.statement((Syntax*)entity->declaration);
	if (compiler.result == compilation_result::failure) {
		return;
	};
	destruction_request((Type*)entity->data.variable.type);
	LifetimeAnalysis lifetime;
	@lifetime.compiler = &compiler;
	@lifetime.state.path = reachability::reachable;
	@lifetime.region(mir_region(@compiler, (Syntax*)entity->declaration->data.declaration.body, nullptr));
	@entity->state = resolution::ready;
	if (entity->data.variable.type->qualifier == type_qualifier::kw_const) {
		ConstantContext context;
		@context.compiler = &compiler;
		@context.scope := entity->scope;
		constant_variable(@context, (Entity*)entity);
	};
};

fn semantic_function(Compiler& compiler, Entity* entity) {
	if ((!entity->data.function.body && entity->data.function.definition != function_definition::defaulted) || entity->data.function.analysis != function_analysis::requested) {
		return;
	};
	@entity->data.function.analysis = function_analysis::analyzing;
	Semantic semantic;
	@semantic.compiler = &compiler;
	@semantic.scope := entity->scope;
	@semantic.function := entity;
	if (entity->data.function.definition == function_definition::defaulted) {
		if (entity->data.function.role != function_role::destructor) {
			generated_operation operation = generated_operation::kw_default;
			if (entity->data.function.type->data.function.parameters->next) {
				@operation = generated_operation::copy;
			};
			if (entity->data.function.role == function_role::assignment) {
				@operation = generated_operation::copy_assignment;
			};
			@semantic.generated_operation_validate(entity_type((Entity*)entity->scope->owner), $operation, entity->name);
		};
		@entity->data.function.analysis = function_analysis::analyzed;
		return;
	};
	@semantic.statement((Syntax*)entity->data.function.body);
	if (compiler.result == compilation_result::success) {
		lifetime_function(@compiler, (Entity*)entity);
	};
	@entity->data.function.analysis = function_analysis::analyzed;
};

fn Compiler::analyze(Compiler& this) {
	DeclarationIterator iterator;
	@iterator.scope := this.module;
	Binding* binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		if (binding->entity->kind != entity_kind::variable) {
			entity_resolve(@this, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};

	declarations_validate(@this);
	virtual_validate(@this);
	@iterator.scope := this.module;
	@binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if (entity->kind != entity_kind::variable) {
			entity_resolve(@this, (Entity*)entity);
			if (this.result == compilation_result::failure) {
				return;
			};
		};
		if ((entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union) && entity->declaration && entity->declaration->data.declaration.body) {
			layout_validate(@this, entity_type((Entity*)entity), nullptr, entity->name);
		};
		if (entity->kind == entity_kind::function) {
			external_validate(@this, (Entity*)entity);
			Type* signature := entity->data.function.type;
			if (!entity->data.function.body && type_aggregate((Type*)signature->data.function.result)) {
				compiler_error(@this, entity->name, "external aggregate return requires C ABI lowering that is not supported yet\0");
			};
			if (signature->data.function.result->kind != type_kind::kw_void) {
				layout_validate(@this, (Type*)signature->data.function.result, nullptr, entity->name);
			};
			Parameter* parameter := signature->data.function.parameters;
			while (parameter && this.result != compilation_result::failure) {
				if (!entity->data.function.body && type_aggregate((Type*)parameter->type)) {
					compiler_error(@this, entity->name, "external aggregate parameter requires C ABI lowering that is not supported yet\0");
					break;
				};
				layout_validate(@this, (Type*)parameter->type, nullptr, entity->name);
				@parameter := parameter->next;
			};
		};
		if (entity->kind == entity_kind::function && (entity->data.function.body || entity->data.function.definition == function_definition::defaulted)) {
			semantic_function(@this, (Entity*)entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	while (this.result == compilation_result::success) {
		usize pending = 0;
		@iterator.scope := this.module;
		@binding := this.module->bindings;
		while (binding && this.result == compilation_result::success) {
			Entity* entity := binding->entity;
			if (entity->kind != entity_kind::variable) {
				entity_resolve(@this, (Entity*)entity);
			};
			if (entity->kind == entity_kind::function && (entity->data.function.body || entity->data.function.definition == function_definition::defaulted) && entity->data.function.analysis == function_analysis::requested) {
				@pending = pending + 1;
				semantic_function(@this, (Entity*)entity);
			};
			@binding = declaration_next(&iterator, (Binding*)binding);
		};
		if (!pending) {
			break;
		};
	};
};

fn entity_name(Compiler& compiler, Entity* entity) -> char* {
	Scope* scope := entity->scope;
	char* parent = "\0";
	if (scope && scope->owner && (scope->owner->kind == entity_kind::kw_namespace || scope->owner->kind == entity_kind::kw_struct || scope->owner->kind == entity_kind::kw_union || scope->owner->kind == entity_kind::kw_template)) {
		@parent = entity_name(@compiler, (Entity*)scope->owner);
	};
	usize length = strlen((char*)parent);
	usize separator = 0;
	if (length) {
		@separator = 2;
	};
	char* name = (char*)memory_allocate(@compiler, length + separator + entity->name.length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy(char*(name), $parent, (u64)length);
	if (separator) {
		@name[length] = ':';
		@name[length + 1] = ':';
	};
	memcpy(name + length + separator, entity->name.source->bytes.data + entity->name.begin, (u64)entity->name.length);
	return $name;
};

fn emit_symbol(Compiler& compiler, Entity* entity) -> char* {
	if (!entity->data.function.body && (!entity->scope || !entity->scope->owner || (entity->scope->owner->kind != entity_kind::kw_struct && entity->scope->owner->kind != entity_kind::kw_union))) {
		return memory_text(@compiler, entity->name.source->bytes.data + entity->name.begin, (u64)entity->name.length);
	};
	char* qualified = entity_name(@compiler, (Entity*)entity);
	if (entity->data.function.role != function_role::ordinary) {
		char[22] digits {};
		usize position = sizeof(digits) - 1;
		usize index := entity->data.function.overload_index;
		while (true) {
			@position = position - 1;
			@digits[position] = (char)((usize)'0' + index % 10);
			@index = index / 10;
			if (!index) {
				break;
			};
		};
		usize length = strlen((char*)qualified);
		usize count = strlen(&digits[position]);
		char* name = (char*)memory_allocate(@compiler, length + count + 3);
		memcpy(char*(name), char*(qualified), (u64)length);
		@name[length] = '.';
		@name[length + 1] = (char)((i32)'a' + (i32)entity->data.function.role);
		memcpy(name + length + 2, &digits[position], count + 1);
		@qualified = $name;
	};
	if (compiler.output == output_kind::library) {
		return $qualified;
	};
	char* prefix = "rt.function.\0";
	usize prefix_length = strlen((char*)prefix);
	usize length = strlen((char*)qualified);
	char* name = (char*)memory_allocate(@compiler, prefix_length + length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy(char*(name), $prefix, (u64)prefix_length);
	memcpy(name + prefix_length, $qualified, $length);
	return $name;
};

fn emit_function_body(Compiler& compiler, Entity* entity, LLVMOpaqueValue* function, u64 receiver_offset, Type* return_type) {
	if ((!entity->data.function.body && entity->data.function.definition != function_definition::defaulted) || entity->data.function.analysis == function_analysis::unrequested) {
		return;
	};
	LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0");
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
	Emitter emitter;
	@emitter.llvm_function := function;
	@emitter.return_type = $return_type;
	@emitter.compiler = &compiler;
	@emitter.function := entity;
	if (entity->data.function.definition == function_definition::defaulted) {
		Entity* record := entity->scope->owner;
		LLVMOpaqueValue* destination = LLVMGetParam(LLVMOpaqueValue*(function), 0);
		Parameter* source := entity->data.function.type->data.function.parameters->next;
		if (!source && entity->data.function.role == function_role::constructor) {
			@emitter.default_body_members((Entity*)record, LLVMOpaqueValue*(destination));
		};
		if (source) {
			storage_transfer operation = storage_transfer::copy_construct;
			if (entity->data.function.role == function_role::assignment) {
				@operation = storage_transfer::copy_assign;
			};
			@emitter.transfer_members((Entity*)record, LLVMOpaqueValue*(destination), LLVMGetParam(LLVMOpaqueValue*(function), 1), $operation);
		};
		if (entity->data.function.role == function_role::assignment) {
			LLVMBuildRet(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(destination));
		}
		else {
			LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
		};
		return;
	};
	ParameterBinding* parameter := entity->data.function.parameter_bindings;
	u32 index = 0;
	while (parameter) {
		Type* type = entity_type((Entity*)parameter->entity);
		LLVMOpaqueValue* value = LLVMGetParam(LLVMOpaqueValue*(function), (u32)index);
		if (!index && receiver_offset) {
			@value = @emitter.byte_offset(LLVMOpaqueValue*(value), (u64)receiver_offset);
		};
		BackendEntity* storage = backend_entity_define(@compiler, (Entity*)parameter->entity);
		if (!storage) {
			return;
		};
		@storage->value = emit_slot(@compiler, (Type*)type);
		if (type_has_views((Type*)type) && (type->kind != type_kind::named || type->data.entity->kind != entity_kind::kw_union)) {
			LLVMOpaqueValue* incoming = emit_slot(@compiler, (Type*)type);
			LLVMBuildStore(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(incoming));
			@emitter.initialize_type((Type*)type, LLVMOpaqueValue*(storage->value));
			@emitter.payload_copy((Type*)type, LLVMOpaqueValue*(storage->value), $incoming);
		}
		else {
			LLVMBuildStore(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(value), LLVMOpaqueValue*(storage->value));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
	@emitter.region((Syntax*)entity->data.function.body);
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock(compiler.backend.llvm_builder.get()))) {
		if (entity->data.function.lifetime_exit == reachability::unreachable) {
			LLVMBuildUnreachable(compiler.backend.llvm_builder.get());
		}
		else if (entity->data.function.type->data.function.result->kind == type_kind::kw_void) {
			LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
		}
		else {
			compiler_error(@compiler, entity->name, "function can finish without returning a value\0");
		};
	};
};

fn emit_function(Compiler& compiler, Entity* entity) {
	if (entity->data.function.definition == function_definition::deleted) {
		return;
	};
	emit_function_body(@compiler, (Entity*)entity, LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)entity)->value), 0, nullptr);
};

fn emit_forward_attributes(Compiler& compiler, LLVMOpaqueValue* call, Type* signature) {
	LLVMOpaqueAttributeRef* extension = emit_extension(@compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), 0, LLVMOpaqueAttributeRef*(extension));
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension(@compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute(LLVMOpaqueValue*(call), (u32)index, LLVMOpaqueAttributeRef*(extension));
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn emit_variadic_tail(Compiler& compiler, LLVMOpaqueValue* function, LLVMOpaqueValue* call) {
	LLVMOpaqueAttributeRef* attribute = LLVMCreateStringAttribute(compiler.backend.llvm_context.get(), "thunk\0", 5, "\0", 0);
	LLVMAddAttributeAtIndex($function, (u32)4294967295, $attribute);
	LLVMSetTailCallKind($call, 2);
};

fn emit_forward_return(Compiler& compiler, Type* result, LLVMOpaqueValue* call) {
	if (result->kind == type_kind::kw_void) {
		LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	}
	else {
		LLVMBuildRet(compiler.backend.llvm_builder.get(), LLVMOpaqueValue*(call));
	};
};

fn runtime_wrappers_emit(Compiler& compiler) {
	while (compiler.backend.runtime_wrappers && compiler.result != compilation_result::failure) {
		RuntimeWrapper* wrapper := compiler.backend.runtime_wrappers;
		@compiler.backend.runtime_wrappers := wrapper->next;
		Entity* entity := wrapper->entity;
		LLVMOpaqueValue* function := backend_entity(@compiler.backend, (Entity*)entity)->wrapper;
		Type* signature := entity->data.function.type;
		LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0");
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
		Emitter emitter;
		@emitter.llvm_function := function;
		@emitter.compiler = &compiler;
		@emitter.function := entity;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		LLVMOpaqueValue** arguments = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam(LLVMOpaqueValue*(function), (u32)index);
			@index = index + 1;
		};
		LLVMOpaqueValue* target = @emitter.dispatch_target($entity, LLVMOpaqueValue*(arguments[0]));
		char* name = "virtual.call\0";
		if (signature->data.function.result->kind == type_kind::kw_void) {
			@name = "\0";
		};
		LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), llvm_type(@compiler, (Type*)signature), $target, $arguments, (u32)count, $name);
		emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), (Type*)signature);
		if (signature->data.function.arity == parameter_arity::variadic) {
			emit_variadic_tail(@compiler, LLVMOpaqueValue*(function), LLVMOpaqueValue*(call));
		};
		emit_forward_return(@compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_thunks_emit(Compiler& compiler) {
	while (compiler.backend.runtime_thunks && compiler.result != compilation_result::failure) {
		RuntimeThunk* thunk := compiler.backend.runtime_thunks;
		@compiler.backend.runtime_thunks := thunk->next;
		Entity* implementation := thunk->target.function;
		BackendEntity* native = backend_entity(@compiler.backend, (Entity*)implementation);
		Type* signature := thunk->callable->function->data.function.type;
		Type* result := implementation->data.function.type->data.function.result;
		u64 offset = thunk->target.object->offset - thunk->receiver->offset;
		if (signature->data.function.arity == parameter_arity::variadic && covariance_adjustment_required(@compiler, (Type*)result, (Type*)signature->data.function.result)) {
			if (!implementation->data.function.body) {
				compiler_error(@compiler, implementation->name, "covariant variadic override requires an available implementation body\0");
				return;
			};
			emit_function_body(@compiler, (Entity*)implementation, LLVMOpaqueValue*(thunk->function), (u64)offset, (Type*)signature->data.function.result);
			continue;
		};
		LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(thunk->function), "entry\0");
		LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
		Emitter emitter;
		@emitter.llvm_function := thunk->function;
		@emitter.compiler = &compiler;
		@emitter.function := implementation;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		LLVMOpaqueValue** arguments = (LLVMOpaqueValue**)memory_allocate(@compiler, count * sizeof(LLVMOpaqueValue*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam(LLVMOpaqueValue*(thunk->function), (u32)index);
			@index = index + 1;
		};
		@arguments[0] = @emitter.byte_offset(LLVMOpaqueValue*(arguments[0]), $offset);
		char* name = "override.call\0";
		if (result->kind == type_kind::kw_void) {
			@name = "\0";
		};
		LLVMOpaqueValue* call = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), $arguments, (u32)count, $name);
		emit_forward_attributes(@compiler, LLVMOpaqueValue*(call), (Type*)implementation->data.function.type);
		if (signature->data.function.arity == parameter_arity::variadic) {
			emit_variadic_tail(@compiler, LLVMOpaqueValue*(thunk->function), LLVMOpaqueValue*(call));
			emit_forward_return(@compiler, (Type*)signature->data.function.result, LLVMOpaqueValue*(call));
			continue;
		};
		if (!type_equal((Type*)result, (Type*)signature->data.function.result)) {
			@call = @emitter.covariant_result(LLVMOpaqueValue*(call), (Type*)result, (Type*)signature->data.function.result);
		};
		emit_forward_return(@compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_metadata_emit(Compiler& compiler) {
	while ((compiler.backend.runtime_views || compiler.backend.runtime_thunks || compiler.backend.runtime_wrappers) && compiler.result != compilation_result::failure) {
		runtime_wrappers_emit(@compiler);
		runtime_views_emit(@compiler);
		runtime_thunks_emit(@compiler);
	};
};

fn entry_lookup(Compiler& compiler) -> Entity* {
	Source source;
	@source.bytes.data := compiler.entry;
	@source.bytes.size = strlen((char*)compiler.entry);
	Token name;
	@name.source = &source;
	Scope* scope := compiler.module;
	while (name.begin < source.bytes.size) {
		@name.length = 0;
		while (name.begin + name.length < source.bytes.size && source.bytes.data[name.begin + name.length] != ':') {
			@name.length = name.length + 1;
		};
		Entity* entity = scope_local((Scope*)scope, name);
		if (!entity) {
			return nullptr;
		};
		if (name.begin + name.length == source.bytes.size) {
			return $entity;
		};
		@scope = entity_members($entity);
		if (!scope || name.begin + name.length + 1 >= source.bytes.size || source.bytes.data[name.begin + name.length + 1] != ':') {
			return nullptr;
		};
		@name.begin = name.begin + name.length + 2;
	};
	return nullptr;
};

fn emit_entry(Compiler& compiler) {
	Entity* entry = entry_lookup(@compiler);
	if (!entry || entry->kind != entity_kind::function || !entry->data.function.body) {
		Token token;
		if (compiler.declarations) {
			@token := compiler.declarations->token;
		};
		compiler_error(@compiler, token, "entry function is missing or has no definition\0");
		return;
	};
	BackendEntity* native = backend_entity(@compiler.backend, (Entity*)entry);
	Type* signature := entry->data.function.type;
	if (signature->data.function.result->kind != type_kind::kw_void && !type_equal((Type*)signature->data.function.result, (Type*)compiler.i32_type)) {
		compiler_error(@compiler, entry->name, "entry function must return i32 or void\0");
		return;
	};
	Parameter* parameter := signature->data.function.parameters;
	LLVMOpaqueValue*[2] arguments {};
	LLVMOpaqueType*[2] parameter_types {};
	@parameter_types[0] = llvm_type(@compiler, (Type*)compiler.i32_type);
	@parameter_types[1] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	if (parameter && (!parameter->next || parameter->next->next || !type_equal((Type*)parameter->type, (Type*)compiler.i32_type) || !type_equal((Type*)parameter->next->type, type_pointer(@compiler, type_pointer(@compiler, (Type*)compiler.char_type))))) {
		compiler_error(@compiler, entry->name, "entry parameters must be empty or (i32, char**)\0");
		return;
	};
	LLVMOpaqueType* main_type = LLVMFunctionType(LLVMOpaqueType*(parameter_types[0]), &parameter_types[0], 2, 0);
	LLVMOpaqueValue* main_function = LLVMAddFunction(compiler.backend.llvm_module.get(), "main\0", $main_type);
	LLVMOpaqueBasicBlock* block = LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(main_function), "entry\0");
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $block);
	@arguments[0] = LLVMGetParam(LLVMOpaqueValue*(main_function), 0);
	@arguments[1] = LLVMGetParam($main_function, 1);
	u32 count = 0;
	if (parameter) {
		@count = 2;
	};
	char* name = "entry.result\0";
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@name = "\0";
	};
	LLVMOpaqueValue* result = LLVMBuildCall2(compiler.backend.llvm_builder.get(), LLVMOpaqueType*(native->type), LLVMOpaqueValue*(native->value), &arguments[0], $count, $name);
	if (signature->data.function.result->kind == type_kind::kw_void) {
		@result = LLVMConstInt(LLVMOpaqueType*(parameter_types[0]), 0, 0);
	};
	LLVMBuildRet(compiler.backend.llvm_builder.get(), $result);
};

fn emit_global_collect(Syntax* module, Entity** globals, usize* count) {
	Syntax* statement := module->data.statements;
	while (statement) {
		Entity* entity := statement->entity;
		if (statement->token.kind == token_kind::kw_namespace) {
			emit_global_collect((Syntax*)statement->data.declaration.body, Entity**(globals), usize*(count));
		}
		else if (entity && entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
			@globals[*count] := entity;
			@*count = *count + 1;
		};
		@statement := statement->next;
	};
};

fn emit_global_register(Compiler& compiler, LLVMOpaqueValue* function, const char* name) {
	LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(compiler.backend.llvm_context.get(), 32);
	@fields[1] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	@fields[2] := fields[1];
	LLVMOpaqueType* record = LLVMStructTypeInContext(compiler.backend.llvm_context.get(), &fields[0], 3, 0);
	LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt(LLVMOpaqueType*(fields[0]), 65535, 0);
	@values[1] = $function;
	@values[2] = LLVMConstNull(LLVMOpaqueType*(fields[2]));
	LLVMOpaqueValue*[1] entries {};
	@entries[0] = LLVMConstNamedStruct(LLVMOpaqueType*(record), &values[0], 3);
	LLVMOpaqueValue* list = LLVMAddGlobal(compiler.backend.llvm_module.get(), LLVMArrayType2(LLVMOpaqueType*(record), 1), $name);
	LLVMSetInitializer(LLVMOpaqueValue*(list), LLVMConstArray2($record, &entries[0], 1));
	LLVMSetLinkage($list, 7);
};

fn emit_global_destructor(Compiler& compiler, Entity* entity) {
	Type* type := entity->data.variable.type;
	if (!type_requires_destruction((Type*)type)) {
		return;
	};

	LLVMOpaqueBasicBlock* continuation = LLVMGetInsertBlock(compiler.backend.llvm_builder.get());
	LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(compiler.backend.llvm_context.get()), nullptr, 0, 0);
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.global.destroy\0", $signature);
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0"));
	Emitter emitter;
	@emitter.compiler = &compiler;
	@emitter.llvm_function := function;
	@emitter.destroy_type($type, LLVMOpaqueValue*(backend_entity(@compiler.backend, (Entity*)entity)->value));
	LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), $continuation);

	LLVMOpaqueType*[1] parameters {};
	@parameters[0] = LLVMPointerTypeInContext(compiler.backend.llvm_context.get(), 0);
	LLVMOpaqueType* registration_type = LLVMFunctionType(llvm_type(@compiler, (Type*)compiler.i32_type), &parameters[0], 1, 0);
	LLVMOpaqueValue* registration = LLVMGetNamedFunction(compiler.backend.llvm_module.get(), "atexit\0");
	if (!registration) {
		@registration = LLVMAddFunction(compiler.backend.llvm_module.get(), "atexit\0", LLVMOpaqueType*(registration_type));
	};
	if (LLVMGlobalGetValueType(LLVMOpaqueValue*(registration)) != registration_type) {
		compiler_error(@compiler, entity->name, "atexit declaration conflicts with global destruction registration\0");
		return;
	};
	LLVMBuildCall2(compiler.backend.llvm_builder.get(), $registration_type, $registration, &function, 1, "\0");
};

fn emit_global_initializers(Compiler& compiler, Entity** globals, usize count) {
	usize pending = 0;
	usize index = 0;
	while (index < count) {
		Entity* entity := globals[index];
		if (type_requires_destruction((Type*)entity->data.variable.type) || !entity->data.variable.evaluation || entity->data.variable.evaluation->state != constant_state::constant) {
			@pending = pending + 1;
		};
		@index = index + 1;
	};
	if (!pending) {
		return;
	};

	LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(compiler.backend.llvm_context.get()), nullptr, 0, 0);
	LLVMOpaqueValue* function = LLVMAddFunction(compiler.backend.llvm_module.get(), "rt.global.initialize\0", $signature);
	LLVMSetLinkage(LLVMOpaqueValue*(function), 9);
	LLVMPositionBuilderAtEnd(compiler.backend.llvm_builder.get(), LLVMAppendBasicBlockInContext(compiler.backend.llvm_context.get(), LLVMOpaqueValue*(function), "entry\0"));
	Emitter emitter;
	@emitter.compiler = &compiler;
	@emitter.llvm_function := function;

	@index = 0;
	while (index < count && compiler.result == compilation_result::success) {
		Entity* entity := globals[index];
		Type* type := entity->data.variable.type;
		LLVMOpaqueValue* address := backend_entity(@compiler.backend, (Entity*)entity)->value;
		if (!entity->data.variable.evaluation || entity->data.variable.evaluation->state != constant_state::constant) {
			Syntax* body := entity->declaration->data.declaration.body;
			if (!body) {
				@emitter.initialize_type((Type*)type, LLVMOpaqueValue*(address));
				@emitter.default_type((Type*)type, LLVMOpaqueValue*(address));
			}
			else {
				if (body->data.statements && type->kind != type_kind::reference) {
					@emitter.initialize_type((Type*)type, LLVMOpaqueValue*(address));
				};
				@emitter.region((Syntax*)body);
			};
			@emitter.flush_temporaries(nullptr);
		};
		emit_global_destructor(@compiler, (Entity*)entity);
		@index = index + 1;
	};
	LLVMBuildRetVoid(compiler.backend.llvm_builder.get());
	emit_global_register(@compiler, $function, "llvm.global_ctors\0");
};

fn Compiler::emit(Compiler& this) {
	DeclarationIterator iterator;
	@iterator.scope := this.module;
	Binding* binding := this.module->bindings;
	usize global_count = 0;
	while (binding && this.result != compilation_result::failure) {
		Entity* entity := binding->entity;
		if (entity->kind == entity_kind::variable && entity->data.variable.storage == storage_kind::global) {
			Type* type := entity->data.variable.type;
			LLVMOpaqueValue* address = LLVMAddGlobal(this.backend.llvm_module.get(), llvm_type(@this, (Type*)type), entity_name(@this, (Entity*)entity));
			BackendEntity* storage = backend_entity_define(@this, (Entity*)entity);
			if (!storage) {
				return;
			};
			@storage->value := address;
			LLVMSetLinkage(LLVMOpaqueValue*(address), 9);
			LLVMOpaqueValue* initializer = LLVMConstNull(llvm_type(@this, (Type*)type));
			ConstantEvaluation* evaluation := entity->data.variable.evaluation;
			if (evaluation && evaluation->state == constant_state::constant) {
				@initializer = constant_llvm(@this, (ConstantValue*)evaluation->value);
				if (type->qualifier == type_qualifier::kw_const && !type_requires_destruction((Type*)type)) {
					LLVMSetGlobalConstant(LLVMOpaqueValue*(address), 1);
				};
			};
			LLVMSetInitializer($address, $initializer);
			@global_count = global_count + 1;
		};
		if (entity->kind == entity_kind::function && entity->data.function.definition != function_definition::deleted) {
			BackendEntity* native = backend_entity_define(@this, (Entity*)entity);
			if (!native) {
				return;
			};
			Type* signature := entity->data.function.type;
			@native->type = llvm_type(@this, (Type*)signature);
			char* symbol = emit_symbol(@this, (Entity*)entity);
			LLVMOpaqueValue* existing = LLVMGetNamedFunction(this.backend.llvm_module.get(), (char*)symbol);
			if (existing && LLVMGlobalGetValueType(LLVMOpaqueValue*(existing)) != native->type) {
				compiler_error(@this, entity->name, "conflicting native function signature\0");
				return;
			};
			if (!existing) {
				@existing = LLVMAddFunction(this.backend.llvm_module.get(), (char*)symbol, LLVMOpaqueType*(native->type));
			};
			@native->value = $existing;
			LLVMOpaqueAttributeRef* extension = emit_extension(@this, (Type*)signature->data.function.result);
			if (extension) {
				LLVMAddAttributeAtIndex(LLVMOpaqueValue*(native->value), 0, LLVMOpaqueAttributeRef*(extension));
			};
			Parameter* parameter := signature->data.function.parameters;
			u32 index = 1;
			while (parameter) {
				@extension = emit_extension(@this, (Type*)parameter->type);
				if (extension) {
					LLVMAddAttributeAtIndex(LLVMOpaqueValue*(native->value), (u32)index, LLVMOpaqueAttributeRef*(extension));
				};
				@index = index + 1;
				@parameter := parameter->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	if (global_count) {
		Entity** globals = (Entity**)memory_allocate(@this, global_count * sizeof(Entity*));
		usize count = 0;
		Syntax* module := this.declarations;
		while (module) {
			emit_global_collect((Syntax*)module, Entity**(globals), &count);
			@module := module->next;
		};
		emit_global_initializers(@this, $globals, $count);
	};
	@iterator.scope := this.module;
	@binding := this.module->bindings;
	while (binding && this.result != compilation_result::failure) {
		if (binding->entity->kind == entity_kind::function) {
			emit_function(@this, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	if (this.output == output_kind::executable && this.result != compilation_result::failure) {
		emit_entry(@this);
	};
	if (this.result == compilation_result::success) {
		runtime_metadata_emit(@this);
	};
};

fn lifetime_find(LifetimeState* state, Entity* entity) -> LifetimeObject* {
	LifetimeObject* object := state->objects;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->next;
	};
	return nullptr;
};

fn lifetime_clone(Compiler& compiler, LifetimeState* state) -> LifetimeState {
	LifetimeState result;
	@result.path := state->path;
	LifetimeObject** last = &result.objects;
	LifetimeObject* object := state->objects;
	while (object) {
		LifetimeObject* copy = (LifetimeObject*)memory_allocate(@compiler, sizeof(LifetimeObject));
		@copy->entity := object->entity;
		@copy->scope := object->scope;
		@copy->status := object->status;
		@*last := copy;
		@last = &copy->next;
		@object := object->next;
	};
	return $result;
};

fn lifetime_merge(Compiler& compiler, LifetimeState* destination, LifetimeState* incoming, const Token& token) {
	if (incoming->path == reachability::unreachable) {
		return;
	};
	if (destination->path == reachability::unreachable) {
		@*destination = lifetime_clone(@compiler, (LifetimeState*)incoming);
		return;
	};
	LifetimeObject* object := destination->objects;
	while (object && compiler.result != compilation_result::failure) {
		LifetimeObject* other = lifetime_find((LifetimeState*)incoming, (Entity*)object->entity);
		if ((!other && object->status == lifetime_status::alive) || (other && (object->status == lifetime_status::alive) != (other->status == lifetime_status::alive))) {
			compiler_error(@compiler, token, "inconsistent object lifetimes at reachable control-flow merge\0");
			return;
		};
		if (other && object->status != other->status) {
			@object->status = lifetime_status::ended;
		};
		@object := object->next;
	};
	@object := incoming->objects;
	while (object && compiler.result != compilation_result::failure) {
		if (!lifetime_find((LifetimeState*)destination, (Entity*)object->entity)) {
			if (object->status == lifetime_status::alive) {
				compiler_error(@compiler, token, "object construction does not reach every incoming control-flow path\0");
				return;
			};
			LifetimeObject* copy = (LifetimeObject*)memory_allocate(@compiler, sizeof(LifetimeObject));
			@copy->entity := object->entity;
		@copy->scope := object->scope;
			@copy->status := object->status;
			@copy->next := destination->objects;
			@destination->objects = $copy;
		};
		@object := object->next;
	};
};

fn LifetimeAnalysis::enter(LifetimeAnalysis& this, Entity* entity) {
	LifetimeObject* previous := this.state.objects;
	while (previous) {
		if (previous->entity->scope == entity->scope && token_same(previous->entity->name, entity->name) && previous->status == lifetime_status::alive) {
			compiler_error(@*this.compiler, entity->name, "duplicate live declaration\0");
			return;
		};
		@previous := previous->next;
	};
	LifetimeObject* object = (LifetimeObject*)memory_allocate(@*this.compiler, sizeof(LifetimeObject));
	@object->entity := entity;
	@object->scope := this.scope;
	@object->status = lifetime_status::alive;
	@object->next := this.state.objects;
	@this.state.objects = $object;
};

fn lifetime_trim(LifetimeState* state, LifetimeObject* boundary) {
	while (state->objects && (!boundary || state->objects->entity != boundary->entity)) {
		@state->objects := state->objects->next;
	};
};

fn lifetime_truth(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 1;
	};
	if (syntax->kind == syntax_kind::expr_name && syntax->entity && syntax->entity->kind == entity_kind::variable && syntax->entity->data.variable.storage == storage_kind::constant) {
		if (syntax->entity->data.variable.evaluation && syntax->entity->data.variable.evaluation->state == constant_state::constant) {
			return (i32)constant_truth((ConstantValue*)syntax->entity->data.variable.evaluation->value);
		};
		return !!syntax->entity->data.variable.data.integer;
	};
	if (syntax->kind == syntax_kind::literal_number && syntax->token.length == 1) {
		char value := syntax->token.source->bytes.data[syntax->token.begin];
		if (value >= '0' && value <= '9') {
			return value != '0';
		};
	};
	if (syntax->kind == syntax_kind::expr_unary && syntax->data.unary.operation == token_kind::op_bang) {
		i32 value = lifetime_truth((Syntax*)syntax->data.unary.value);
		if (value >= 0) {
			return !value;
		};
	};
	return -1;
};

fn LifetimeAnalysis::expression(LifetimeAnalysis& this, Syntax* syntax) {
	if (!syntax || this.state.path == reachability::unreachable || this.compiler->result == compilation_result::failure) {
		return;
	};
	if (syntax->use == value_use::observed && syntax_category((Syntax*)syntax) == value_category::temporary) {
		destruction_request((Type*)syntax->type);
	};
	switch (syntax->kind) {
		case syntax_kind::kw_new:
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard:
			@this.expression((Syntax*)syntax->data.expression);
			break;
		case syntax_kind::expr_construct: {
			@this.expression((Syntax*)syntax->data.construction.destination);
			Syntax* argument := syntax->data.construction.arguments;
			while (argument) {
				@this.expression((Syntax*)argument);
				@argument := argument->next;
			};
			break;
		};
		case syntax_kind::expr_name: {
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->entity);
			if (!object && syntax->entity && syntax->entity->kind == entity_kind::variable && (syntax->entity->data.variable.storage == storage_kind::local || syntax->entity->data.variable.storage == storage_kind::parameter || syntax->entity->data.variable.storage == storage_kind::argument)) {
				compiler_error(@*this.compiler, syntax->token, "object construction does not reach this use\0");
				return;
			};
			if (object && object->status != lifetime_status::alive) {
				const char* suffix = "' has been relocated\0";
				if (object->status == lifetime_status::discarded) {
					@suffix = "' has been discarded\0";
				}
				else if (object->status == lifetime_status::ended) {
					@suffix = "' is no longer available\0";
				};
				usize length := syntax->token.length;
				usize suffix_size = strlen(const char*(suffix)) + 1;
				char* message = (char*)memory_allocate(@*this.compiler, length + suffix_size + 1);
				if (!message) {
					return;
				};
				@message[0] = '\'';
				memcpy(message + 1, syntax->token.source->bytes.data + syntax->token.begin, (u64)length);
				memcpy(message + length + 1, $suffix, $suffix_size);
				compiler_error(@*this.compiler, syntax->token, $message);
			};
			break;
		};
		case syntax_kind::expr_relocate: {
			@this.expression((Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error(@*this.compiler, syntax->token, "relocation requires a live owned local binding\0");
				return;
			};
			@object->status = lifetime_status::relocated;
			break;
		};
		case syntax_kind::expr_access:
			@this.expression((Syntax*)syntax->data.expression);
			break;
		case syntax_kind::kw_discard: {
			@this.expression((Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&this.state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error(@*this.compiler, syntax->token, "discard requires a live owned local binding\0");
				return;
			};
			@object->status = lifetime_status::discarded;
			break;
		};
		case syntax_kind::expr_member:
			@this.expression((Syntax*)syntax->data.member.object);
			break;
		case syntax_kind::expr_destroy:
		case syntax_kind::expr_cast:
			@this.expression((Syntax*)syntax->data.cast.value);
			break;
		case syntax_kind::expr_base_reference:
		case syntax_kind::expr_base_pointer:
			@this.expression((Syntax*)syntax->data.base_conversion.value);
			break;
		case syntax_kind::expr_unary:
			@this.expression((Syntax*)syntax->data.unary.value);
			break;
		case syntax_kind::stmt_initialize:
		case syntax_kind::stmt_bind_reference:
		case syntax_kind::expr_binary: {
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			token_kind operation := syntax->data.binary.operation;
			if (syntax->kind == syntax_kind::stmt_bind_reference || ((operation == token_kind::op_assign || operation == token_kind::op_copy) && !type_has_views((Type*)left->type) && !syntax->entity)) {
				@this.expression((Syntax*)right);
				@this.expression((Syntax*)left);
				return;
			};
			@this.expression((Syntax*)left);
			if (syntax->kind == syntax_kind::expr_binary && (operation == token_kind::op_and || operation == token_kind::op_or)) {
				i32 truth = lifetime_truth((Syntax*)left);
				if ((operation == token_kind::op_and && !truth) || (operation == token_kind::op_or && truth == 1)) {
					return;
				};
				LifetimeState skipped = lifetime_clone(@*this.compiler, &this.state);
				@this.expression((Syntax*)right);
				if (truth < 0) {
					lifetime_merge(@*this.compiler, &this.state, &skipped, syntax->token);
				};
				return;
			};
			@this.expression((Syntax*)right);
			break;
		};
		case syntax_kind::expr_index:
			@this.expression((Syntax*)syntax->data.binary.right);
			@this.expression((Syntax*)syntax->data.binary.left);
			break;
		case syntax_kind::expr_call: {
			@this.expression((Syntax*)syntax->data.call.receiver.value);
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (argument->kind == syntax_kind::node_block) {
					LifetimeObject* boundary := this.state.objects;
					@this.enter((Entity*)argument->entity);
					@this.region(mir_region(@*this.compiler, (Syntax*)argument, (MirScope*)this.scope));
					lifetime_trim(&this.state, (LifetimeObject*)boundary);
				}
				else {
					@this.expression((Syntax*)argument);
				};
				@argument := argument->next;
			};
			@this.expression((Syntax*)syntax->data.call.callable);
			break;
		};
		case syntax_kind::node_block:
			@this.region(mir_region(@*this.compiler, (Syntax*)syntax, (MirScope*)this.scope));
			break;
		default:
			break;
	};
};

struct MirLifetimeBlock {
	MirBlock* block;
	MirLifetimeBlock* next;
	LifetimeState incoming;
	usize pending;
	resolution state;
};

fn mir_lifetime_find(MirLifetimeBlock* blocks, MirBlock* block) -> MirLifetimeBlock* {
	while (blocks && blocks->block != block) {
		@blocks := blocks->next;
	};
	return $blocks;
};

fn LifetimeAnalysis::edge(LifetimeAnalysis& this, MirEdge* edge) {
	@edge->cleanup = nullptr;
	LifetimeCleanup** last = &edge->cleanup;
	while (this.state.objects && !mir_scope_contains((MirScope*)this.state.objects->scope, (MirScope*)edge->retained_scope)) {
		LifetimeObject* object := this.state.objects;
		if (this.state.path == reachability::reachable && object->status == lifetime_status::alive) {
			Type* type = entity_type((Entity*)object->entity);
			if (type && type->kind != type_kind::reference) {
				destruction_request((Type*)type);
				LifetimeCleanup* cleanup = (LifetimeCleanup*)memory_allocate(@*this.compiler, sizeof(LifetimeCleanup));
				if (!cleanup) {
					return;
				};
				@cleanup->entity := object->entity;
				@*last := cleanup;
				@last = &cleanup->next;
			};
		};
		@this.state.objects := object->next;
	};
};

fn LifetimeAnalysis::region(LifetimeAnalysis& this, MirRegion* region) {
	if (!region || this.compiler->result == compilation_result::failure || this.state.path == reachability::unreachable) {
		return;
	};
	MirScope* outer := this.scope;
	MirLifetimeBlock* records = nullptr;
	MirBlock* block := region->blocks;
	while (block) {
		MirLifetimeBlock* record = (MirLifetimeBlock*)memory_allocate(@*this.compiler, sizeof(MirLifetimeBlock));
		if (!record) {
			return;
		};
		@record->block := block;
		@record->next := records;
		@records = $record;
		@block := block->next;
	};
	MirLifetimeBlock* entry = mir_lifetime_find((MirLifetimeBlock*)records, (MirBlock*)region->entry);
	if (!entry) {
		return;
	};
	@entry->incoming = lifetime_clone(@*this.compiler, &this.state);
	MirLifetimeBlock* record := records;
	while (record) {
		MirEdge* edge := record->block->edges;
		while (edge) {
			if (edge->target && edge->kind != mir_edge_kind::backedge) {
				MirLifetimeBlock* target = mir_lifetime_find((MirLifetimeBlock*)records, (MirBlock*)edge->target);
				@target->pending = target->pending + 1;
			};
			@edge := edge->next;
		};
		@record := record->next;
	};
	LifetimeState exits;
	usize remaining = 0;
	@record := records;
	while (record) {
		@remaining = remaining + 1;
		@record := record->next;
	};
	while (remaining && this.compiler->result != compilation_result::failure) {
		@record := records;
		while (record && (record->state == resolution::ready || record->pending)) {
			@record := record->next;
		};
		if (!record) {
			compiler_error(@*this.compiler, region->entry->token, "cyclic forward control flow in MIR\0");
			return;
		};
		@record->state = resolution::ready;
		@remaining = remaining - 1;
		@this.state = lifetime_clone(@*this.compiler, &record->incoming);
		@block := record->block;
		@this.scope := block->scope;
		i32 truth = -1;
		if (this.state.path == reachability::reachable) {
			switch (block->kind) {
				case mir_kind::declare:
					if (block->value->entity->kind == entity_kind::variable) {
						@this.enter((Entity*)block->value->entity);
					};
					break;
				case mir_kind::kw_return:
					@this.expression((Syntax*)block->value);
					break;
				case mir_kind::evaluate:
				case mir_kind::dispatch:
					@this.expression((Syntax*)block->value);
					break;
				case mir_kind::branch:
					@this.expression((Syntax*)block->value);
					@truth = lifetime_truth((Syntax*)block->value);
					break;
				case mir_kind::exit:
					lifetime_merge(@*this.compiler, &exits, &this.state, block->token);
					break;
				default:
					break;
			};
		};
		LifetimeState outgoing = lifetime_clone(@*this.compiler, &this.state);
		MirEdge* edge := block->edges;
		while (edge && this.compiler->result != compilation_result::failure) {
			@this.state = lifetime_clone(@*this.compiler, &outgoing);
			if ((edge->kind == mir_edge_kind::when_true && !truth) || (edge->kind == mir_edge_kind::when_false && truth == 1)) {
				@this.state.path = reachability::unreachable;
			};
			@this.edge((MirEdge*)edge);
			if (edge->target) {
				MirLifetimeBlock* target = mir_lifetime_find((MirLifetimeBlock*)records, (MirBlock*)edge->target);
				if (edge->kind == mir_edge_kind::backedge) {
					LifetimeState anchor = lifetime_clone(@*this.compiler, &target->incoming);
					lifetime_merge(@*this.compiler, &anchor, &this.state, edge->token);
				}
				else {
					lifetime_merge(@*this.compiler, &target->incoming, &this.state, edge->token);
					@target->pending = target->pending - 1;
				};
			};
			@edge := edge->next;
		};
	};
	@this.state = $exits;
	@this.scope = $outer;
};

fn lifetime_function(Compiler& compiler, Entity* entity) {
	MirRegion* region = mir_region(@compiler, (Syntax*)entity->data.function.body, nullptr);
	if (!region) {
		return;
	};
	LifetimeAnalysis analysis;
	@analysis.compiler = &compiler;
	@analysis.scope := region->scope;
	@analysis.state.path = reachability::reachable;
	ParameterBinding* parameter := entity->data.function.parameter_bindings;
	while (parameter) {
		@analysis.enter((Entity*)parameter->entity);
		@parameter := parameter->next;
	};
	@analysis.region($region);
	@entity->data.function.lifetime_exit := analysis.state.path;
};

fn Semantic::nested_statement(Semantic& this, Syntax* syntax) {
	Scope* outer := this.scope;
	@this.scope = scope_create(@*this.compiler, (Scope*)outer, context_kind::local, nullptr);
	@this.statement($syntax);
	@this.scope = $outer;
};

fn Semantic::statement(Semantic& this, Syntax* syntax) {
	if (this.compiler->result == compilation_result::failure) {
		return;
	};
	Compiler& compiler = @*this.compiler;
	if (!syntax || compiler.result == compilation_result::failure) {
		return;
	};
	switch (syntax->kind) {
		case syntax_kind::node_block: {
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			Syntax* statement := syntax->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			@this.scope = &outer;
			break;
		};
		case syntax_kind::node_declaration:
			if (syntax->entity->kind == entity_kind::variable) {
				Entity* variable := syntax->entity;
				if (syntax->data.declaration.type) {
					@variable->data.variable.type = type_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.declaration.type);
					@variable->data.variable.type_use = type_use_resolve(@compiler, (Scope*)this.scope, (TypeSyntax*)syntax->data.declaration.type);
				};
				@variable->state = resolution::ready;
				if (!syntax->data.declaration.body && variable->data.variable.type) {
					@this.generated_operation_validate((Type*)variable->data.variable.type, generated_operation::kw_default, syntax->token);
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && variable->data.variable.type->kind == type_kind::named && (variable->data.variable.type->data.entity->kind == entity_kind::kw_struct || variable->data.variable.type->data.entity->kind == entity_kind::kw_union)) {
					@syntax->data.declaration.constructor = @this.special_select((Entity*)variable->data.variable.type->data.entity, function_role::constructor, nullptr, Token(syntax->token));
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && type_requires_union_choice((Type*)variable->data.variable.type)) {
					compiler_error(@compiler, syntax->token, "automatic union member construction requires an explicit member initializer\0");
					return;
				};
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					reference_initializer(@compiler, (Syntax*)syntax->data.declaration.body, (Entity*)variable, Token(syntax->token));
					if (compiler.result == compilation_result::failure) {
						return;
					};
				}
				else {
					scope_bind(@compiler, (Scope*)this.scope, (Entity*)variable);
					if (variable->data.variable.type) {
						object_initializer_prepare(@compiler, (Scope*)this.scope, (Entity*)variable, (Syntax*)syntax->data.declaration.body, Token(syntax->token));
					};
				};
				@this.statement((Syntax*)syntax->data.declaration.body);
				if (variable->data.variable.type && variable->data.variable.type->kind == type_kind::reference) {
					scope_bind(@compiler, (Scope*)this.scope, (Entity*)variable);
				};
				if (!variable->data.variable.type || variable->data.variable.type->kind == type_kind::kw_void || variable->data.variable.type->kind == type_kind::kw_null || variable->data.variable.type->kind == type_kind::function) {
					compiler_error(@compiler, syntax->token, "variable requires a resolved storage type\0");
				};
				layout_validate(@compiler, (Type*)variable->data.variable.type, nullptr, syntax->token);
			}
			else {
				entity_resolve(@compiler, (Entity*)syntax->entity);
			};
			break;
		case syntax_kind::kw_return:
			if (!this.function) {
				compiler_error(@compiler, syntax->token, "return requires a function context\0");
			}
			else {
				Type* result := this.function->data.function.type->data.function.result;
				if (syntax->data.expression) {
					@this.expression((Syntax*)syntax->data.expression, (Type*)result);
				if (compiler.result == compilation_result::failure) {
					return;
				};
					if (result->kind != type_kind::reference) {
						Syntax* value := syntax->data.expression;
						if (value->kind == syntax_kind::expr_name && value->entity && value->entity->kind == entity_kind::variable && !storage_borrowed((Syntax*)value) && (value->entity->data.variable.storage == storage_kind::local || value->entity->data.variable.storage == storage_kind::parameter)) {
							Syntax* relocation = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
							@relocation->kind = syntax_kind::expr_relocate;
							@relocation->token := value->token;
							@relocation->type := value->type;
							@relocation->data.expression := value;
							@syntax->data.expression = $relocation;
						};
						@this.owned((Syntax*)syntax->data.expression);
					};
				}
				else if (result->kind != type_kind::kw_void) {
					compiler_error(@compiler, syntax->token, "return requires a result value\0");
				};
			};
			break;
		case syntax_kind::kw_if:
			if (!type_scalar(@this.expression((Syntax*)syntax->data.branch.condition, (Type*)compiler.bool_type))) {
				compiler_error(@compiler, syntax->token, "condition requires a scalar value\0");
			};
			@this.nested_statement((Syntax*)syntax->data.branch.first);
			@this.nested_statement((Syntax*)syntax->data.branch.second);
			break;
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			SemanticFlow flow;
			@flow.kind = flow_kind::loop;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Scope& outer = @*this.scope;
			if (syntax->scope) {
				Scope* created = @this.create_scope(*syntax->scope);
				if (!created) {
					return;
				};
				Scope& scope = @*created;
				@this.scope = &scope;
				@syntax->scope = &scope;
			};
			@this.statement((Syntax*)syntax->data.loop.initializer);
			if (syntax->data.loop.condition) {
				if (!type_scalar(@this.expression((Syntax*)syntax->data.loop.condition, (Type*)compiler.bool_type))) {
					compiler_error(@compiler, syntax->token, "condition requires a scalar value\0");
				};
			};
			@this.statement((Syntax*)syntax->data.loop.body);
			if (syntax->data.loop.step) {
				@this.expression((Syntax*)syntax->data.loop.step, nullptr);
			};
			@this.scope = &outer;
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_switch: {
			Type* type = @this.expression((Syntax*)syntax->data.selection.value, nullptr);
			if (!type_integer(type_representation((Type*)type))) {
				compiler_error(@compiler, syntax->token, "switch requires an integer value or an enum with integer underlying storage\0");
				break;
			};
			@this.selection_validate((Syntax*)syntax, (Type*)type);
			SemanticFlow flow;
			@flow.kind = flow_kind::kw_switch;
			@flow.parent := this.flow;
			@this.flow = &flow;
			Type* outer := this.selection_type;
			@this.selection_type = (Type*)type;
			Scope& outer_scope = @*this.scope;
			Scope* created = @this.create_scope(*syntax->data.selection.cases->scope);
			if (!created) {
				return;
			};
			Scope& cases = @*created;
			@syntax->data.selection.cases->scope = &cases;
			@this.scope = &cases;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			while (statement && compiler.result != compilation_result::failure) {
				@this.statement((Syntax*)statement);
				@statement := statement->next;
			};
			@this.scope = &outer_scope;
			@this.selection_type = (Type*)outer;
			@this.flow := flow.parent;
			break;
		};
		case syntax_kind::kw_case:
			if (!this.flow || this.flow->kind != flow_kind::kw_switch) {
				compiler_error(@compiler, syntax->token, "case requires a switch context\0");
			};
			if (syntax->data.selection_case.value) {
				constant_integer(@compiler, (Scope*)this.scope, (Syntax*)syntax->data.selection_case.value);
			};
			break;
		case syntax_kind::kw_break:
		case syntax_kind::kw_continue: {
			SemanticFlow* flow := this.flow;
			if (syntax->kind == syntax_kind::kw_continue) {
				while (flow && flow->kind != flow_kind::loop) {
					@flow := flow->parent;
				};
			};
			if (!flow) {
				compiler_error(@compiler, syntax->token, "flow statement has no enclosing target\0");
			};
			break;
		};
		default: {
			Type* type = @this.expression((Syntax*)syntax, nullptr);
			if (syntax->kind != syntax_kind::stmt_bind_reference && (type->kind == type_kind::named || type->kind == type_kind::array)) {
				layout_validate(@compiler, (Type*)type, nullptr, syntax->token);
			};
			break;
		};
	};
};

fn LLVMGetVersion(u32* major, u32* minor, u32* patch);

fn Compiler::initialize(Compiler& this) -> i32 {
	Token token;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);
	if (major != 21 || minor != 1 || patch != 0) {
		compiler_error(@this, token, "LLVM runtime version must be 21.1.0\0");
		return 0;
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.backend.llvm_context.pointer = LLVMContextCreate();
	if (!this.backend.llvm_context.pointer) {
		compiler_error(@this, token, "cannot create LLVM context\0");
		return 0;
	};
	@this.backend.llvm_module.pointer = LLVMModuleCreateWithNameInContext("rutile\0", this.backend.llvm_context.get());
	if (!this.backend.llvm_module.pointer) {
		compiler_error(@this, token, "cannot create LLVM module\0");
		return 0;
	};
	@this.backend.llvm_builder.pointer = LLVMCreateBuilderInContext(this.backend.llvm_context.get());
	if (!this.backend.llvm_builder.pointer) {
		compiler_error(@this, token, "cannot create LLVM builder\0");
		return 0;
	};

	var triple = unique_ptr<char, LLVMMessageDisposer>(LLVMGetDefaultTargetTriple());
	unique_ptr<char, LLVMMessageDisposer> message;
	LLVMTarget* target;
	if (!triple.pointer) {
		compiler_error(@this, token, "cannot obtain LLVM target triple\0");
		return 0;
	};
	if (LLVMGetTargetFromTriple((char*)triple.pointer, &target, &message.pointer)) {
		compiler_error(@this, token, (char*)message.pointer);
		return 0;
	};

	@this.backend.llvm_machine.pointer = LLVMCreateTargetMachine(LLVMTarget*(target), (char*)triple.pointer, "generic\0", "\0", (i32)this.optimization, 2, 0);
	if (!this.backend.llvm_machine.pointer) {
		compiler_error(@this, token, "cannot create LLVM target machine\0");
		return 0;
	};
	@this.backend.llvm_layout.pointer = LLVMCreateTargetDataLayout(this.backend.llvm_machine.get());
	if (!this.backend.llvm_layout.pointer) {
		compiler_error(@this, token, "cannot create LLVM target data layout\0");
		return 0;
	};
	var layout = unique_ptr<char, LLVMMessageDisposer>(LLVMCopyStringRepOfTargetData(this.backend.llvm_layout.get()));
	if (!layout.pointer) {
		compiler_error(@this, token, "cannot obtain LLVM target data layout\0");
		return 0;
	};
	LLVMSetTarget(this.backend.llvm_module.get(), (char*)triple.pointer);
	LLVMSetDataLayout(this.backend.llvm_module.get(), (char*)layout.pointer);
	return this.result == compilation_result::success;
};

fn Compiler::verify(Compiler& this) -> i32 {
	unique_ptr<char, LLVMMessageDisposer> message;
	i32 invalid = LLVMVerifyModule(this.backend.llvm_module.get(), 2, &message.pointer);
	if (invalid) {
		Token token;
		compiler_error(@this, token, (char*)message.pointer);
	};
	return !invalid;
};

fn Compiler::optimize(Compiler& this) -> i32 {
	if (!@this.verify()) {
		return 0;
	};

	char*[4] pipelines {};
	@pipelines[0] = "default<O0>\0";
	@pipelines[1] = "default<O1>\0";
	@pipelines[2] = "default<O2>\0";
	@pipelines[3] = "default<O3>\0";
	var options = unique_ptr<LLVMOpaquePassBuilderOptions, LLVMPassOptionsDisposer>(LLVMCreatePassBuilderOptions());
	if (!options.pointer) {
		Token token;
		compiler_error(@this, token, "cannot create LLVM pass options\0");
		return 0;
	};
	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 1);
	LLVMOpaqueError* error = LLVMRunPasses(this.backend.llvm_module.get(), (char*)pipelines[this.optimization], this.backend.llvm_machine.get(), options.get());
	if (error) {
		var message = unique_ptr<char, LLVMErrorMessageDisposer>(LLVMGetErrorMessage(LLVMOpaqueError*(error)));
		Token token;
		compiler_error(@this, token, (char*)message.pointer);
		return 0;
	};

	return @this.verify();
};

fn backend_publish(Compiler& compiler, char* output_path) -> i32 {
	unique_ptr<char, LLVMMessageDisposer> message;
	unique_ptr<LLVMOpaqueMemoryBuffer, LLVMMemoryBufferDisposer> buffer;
	if (LLVMTargetMachineEmitToMemoryBuffer(compiler.backend.llvm_machine.get(), compiler.backend.llvm_module.get(), 1, &message.pointer, &buffer.pointer)) {
		Token token;
		compiler_error(@compiler, token, (char*)message.pointer);
		return 0;
	};

	{
		Token token;
		var file = File(&compiler, $output_path, file_purpose::object, Token(token));
		if (!file.handle) {
			return 0;
		};
		usize size = LLVMGetBufferSize(buffer.get());
		usize written = fwrite(LLVMGetBufferStart(buffer.get()), 1, (u64)size, (void*)file.handle);
		if (written != size) {
			compiler_error(@compiler, token, "cannot write native object output\0");
			return 0;
		};
	};
	return compiler.result == compilation_result::success;
};

fn source_read(Compiler& compiler, char* path) -> Source* {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};
	@source->path = string_view(memory_text(@compiler, (char*)path, strlen((char*)path)), strlen((char*)path));
	Token token;
	@token.source := source;
	@token.line = 1;
	@token.column = 1;
	var bytes = string();
	{
		var file = File(&compiler, $path, file_purpose::source, Token(token));
		if (!file.handle) {
			return nullptr;
		};
		usize maximum = ~usize(0) / sizeof(Token) - 1;
		char[4096] chunk {};
		while (true) {
			usize count = fread(&chunk[0], 1, sizeof(chunk), void*(file.handle));
			if (!count) {
				break;
			};
			if (count > maximum - bytes.size || !@bytes.append(string_view(&chunk[0], usize(count)))) {
				compiler_error(@compiler, token, "source exceeds compiler address limits or memory is unavailable\0");
				return nullptr;
			};
		};
		if (ferror(void*(file.handle))) {
			compiler_error(@compiler, token, "cannot read source\0");
		};
	};
	if (compiler.result == compilation_result::failure) {
		return nullptr;
	};
	@source->bytes = bytes;
	@source->bytes.data = (char*)@compiler.allocations.adopt(@bytes.release());
	if (source->bytes.size && !source->bytes.data) {
		@compiler.result = compilation_result::failure;
		return nullptr;
	};
	return source;
};

fn rutile_compiler_session(((Compiler*, void*) -> i32)* callback, void* data) -> i32 {
	var compiler = make_unique<Compiler>();
	if (!compiler.get()) {
		return 1;
	};
	return callback(compiler.get(), $data);
};

fn backend_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics, output_kind output) -> i32 {
	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};
	if (!compiler) {
		fputs("compiler context unavailable\n\0", (void*)diagnostics);
		return 1;
	};

	@compiler->clear();
	@compiler->diagnostics = $diagnostics;
	@compiler->open_file = $open_file;
	if (!compiler->open_file) {
		@compiler->open_file = &fopen;
	};
	@compiler->output = $output;
	@compiler->optimization := optimization;
	@compiler->entry = "main\0";
	if (entry) {
		@compiler->entry = memory_text(@*compiler, (char*)entry, strlen((char*)entry));
	};
	Token token;
	if (optimization < 0 || optimization > 3) {
		compiler_error(@*compiler, token, "optimization level must be between 0 and 3\0");
	};
	if (!source_paths || !source_count) {
		compiler_error(@*compiler, token, "no source files\0");
	};
	if (!output_path) {
		compiler_error(@*compiler, token, "native object output path is required\0");
	};

	usize index = 0;
	Source* last;
	while (index < source_count && compiler->result != compilation_result::failure) {
		if (!source_paths[index] || !strcmp((char*)source_paths[index], (char*)output_path)) {
			compiler_error(@*compiler, token, "output cannot overwrite a source file\0");
			break;
		};
		Source* source = source_read(@*compiler, (char*)source_paths[index]);
		if (!source) {
			break;
		};
		if (last) {
			@last->next := source;
		}
		else {
			@compiler->sources := source;
		};
		@last = $source;
		@index = index + 1;
	};

	if (compiler->result != compilation_result::failure && @compiler->initialize()) {
		compiler_builtins(@*compiler, (i32)(LLVMPointerSize(compiler->backend.llvm_layout.get()) * 8));
		if (prepare_sources(@*compiler)) {
			Source* source := compiler->sources;
			Syntax* last_module;
			while (source && compiler->result != compilation_result::failure) {
				Syntax* module = parse_source(@*compiler, (Source*)source);
				if (last_module) {
					@last_module->next := module;
				}
				else {
					@compiler->declarations := module;
				};
				@last_module = $module;
				@source := source->next;
			};
		};
	};
	if (compiler->result != compilation_result::failure) {
		@compiler->analyze();
	};
	if (compiler->result != compilation_result::failure) {
		@compiler->emit();
	};
	if (compiler->result != compilation_result::failure && @compiler->optimize()) {
		backend_publish(@*compiler, (char*)output_path);
	};

	@compiler->diagnostics = nullptr;
	@compiler->open_file = (((char*, char*) -> void*)*)0;
	return (i32)compiler->result;
};

fn rutile_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile($compiler, $source_paths, $source_count, $output_path, $open_file, $entry, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, i32 optimization, void* diagnostics) -> i32 {
	var compiler = make_unique<Compiler>();
	return backend_compile(compiler.get(), $source_paths, $source_count, $output_path, $open_file, nullptr, $optimization, $diagnostics, output_kind::library);
};

