enum file_purpose : [i32] {
	source;
	object;
};

struct File {
	fn File(File& this, Compiler* compiler, char* path, file_purpose purpose, Token location);
	fn ~File(File& this);

	Compiler* compiler;
	void* handle;
	Token location;
	file_purpose purpose;
};

fn File::File(File& this, Compiler* compiler, char* path, file_purpose purpose, Token location) {
	@this.compiler = $compiler;
	@this.location = $location;
	@this.purpose := purpose;
	char* mode = "rb\0";
	char* failure = "cannot open source\0";
	if (purpose == file_purpose::object) {
		@mode = "wb\0";
		@failure = "cannot open native object output\0";
	};
	@this.handle = this.compiler->open_file($path, $mode);
	if (!this.handle) {
		compiler_error(@*this.compiler, this.location, (char*)failure);
	};
};

fn File::~File(File& this) {
	if (!this.handle) {
		return;
	};
	if (fclose(void*(this.handle))) {
		char* failure = "cannot read source\0";
		if (this.purpose == file_purpose::object) {
			@failure = "cannot write native object output\0";
		};
		compiler_error(@*this.compiler, this.location, (char*)failure);
	};
};

enum compilation_result : [i32] {
	success;
	failure;
};

enum output_kind : [i32] {
	executable;
	library;
};

// ============================================================================
// MODULE: BACKEND STATE
// FUTURE FILE: backend/context.rt
// PURPOSE: Own native entity representations, LLVM resources, and emission queues.
// DEPENDS ON: Entities, LLVM bindings, Compiler arena and allocation failure state.
// ============================================================================
struct BackendEntity {
	LLVMOpaqueValue* wrapper;
	LLVMOpaqueValue* value;
	LLVMOpaqueType* type;
	LLVMOpaqueType* body;
	RuntimeView* views;
};

struct BackendSyntax {
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* constructed;
};

struct BackendState {
	IdentityMap<BackendEntity> entities;
	IdentityMap<BackendSyntax> expressions;
	RuntimeView* runtime_views;
	RuntimeThunk* runtime_thunks;
	RuntimeWrapper* runtime_wrappers;
};

struct Backend :[BackendState] {
	fn clear(Backend& this);

	unique_ptr<LLVMOpaqueContext, LLVMContextDisposer> llvm_context;
	unique_ptr<LLVMOpaqueTargetMachine, LLVMTargetMachineDisposer> llvm_machine;
	unique_ptr<LLVMOpaqueModule, LLVMModuleDisposer> llvm_module;
	unique_ptr<LLVMOpaqueBuilder, LLVMBuilderDisposer> llvm_builder;
	unique_ptr<LLVMOpaqueTargetData, LLVMLayoutDisposer> llvm_layout;
};

struct NameResolution {
	Entity* entity;
	TemplateArgument* arguments;
};

struct SemanticState {
	IdentityMap<MirRegion> regions;
	IdentityMap<NameResolution> resolved_names;
	IdentityMap<SourceBinding> source_bindings;
	TypeStore types;
	IdentityMap<TypeResolution> resolved_types;
};

struct CompilerState {
	Source* sources;
	Syntax* declarations;
	TemplateDeclaration* templates;
	Scope* module;
	((char* path, char* mode) -> void*)* open_file;
	void* diagnostics;
	char* entry;
	Type* void_type;
	Type* null_type;
	Type* bool_type;
	Type* i32_type;
	Type* usize_type;
	Type* char_type;
	DeclarationRule[4] declaration_rules;
	i32 optimization;
	compilation_result result;
	output_kind output;
};

struct Compiler :[CompilerState] {
	fn Compiler(Compiler& this);
	fn clear(Compiler& this);
	fn initialize(Compiler& this) -> i32;
	fn verify(Compiler& this) -> i32;
	fn optimize(Compiler& this) -> i32;
	fn analyze(Compiler& this);
	fn emit(Compiler& this);

	Arena allocations;
	Backend backend;
	SemanticState semantic;
};

fn Compiler::Compiler(Compiler& this) {
};

fn Backend::clear(Backend& this) {
	@this.llvm_layout.reset(nullptr);
	@this.llvm_builder.reset(nullptr);
	@this.llvm_module.reset(nullptr);
	@this.llvm_machine.reset(nullptr);
	@this.llvm_context.reset(nullptr);
	@((BackendState&)this) = BackendState();
};

fn Compiler::clear(Compiler& this) {
	@this.backend.clear();
	@this.semantic = SemanticState();
	@this.allocations.clear();
	@((CompilerState&)this) = CompilerState();
};

enum expression_context : [i32] {
	ordinary;
	argument;
};

struct ParseFailure {
	Token token;
	const char* message;
	usize offset;
	usize pending_greater;
};

enum parse_choice_kind : [i32] {
	type;
	template_name;
};

struct ParseChoice {
	TypeSyntax* type;
	NameSyntax* name;
	usize offset;
	usize pending_greater;
	parse_choice_kind kind;
};

struct Parser {
	ParseFailure failure;
	ParseMemoStore* memo;
	Compiler* compiler;
	Token* tokens;
	usize count;
	usize offset;
	usize pending_greater;
	expression_context context;
};

enum flow_kind : [i32] {
	function;
	loop;
	kw_switch;
};

struct SemanticFlow {
	SemanticFlow* parent;
	flow_kind kind;
};

fn malloc(usize size) -> void*;
fn calloc(usize count, usize size) -> void*;
fn realloc(void* memory, usize size) -> void*;
fn free(void* memory);
fn memcpy(void* destination, const void* source, usize size) -> void*;
fn memmove(void* destination, const void* source, usize size) -> void*;
fn memset(void* destination, i32 value, usize size) -> void*;
fn memcmp(const void* first, const void* second, usize size) -> i32;
fn strlen(const char* text) -> usize;
fn strtod(char* text, char** end) -> f64;
fn trunc(f64 value) -> f64;
fn fopen(char* path, char* mode) -> void*;
fn fclose(void* file) -> i32;
fn fread(void* destination, usize size, usize count, void* file) -> usize;
fn fwrite(const void* source, usize size, usize count, void* file) -> usize;
fn ferror(void* file) -> i32;
fn fputs(const char* text, void* file) -> i32;
fn fprintf(void* file, const char* format, ...) -> i32;
fn strcmp(const char* first, const char* second) -> i32;
fn platform_standard_error() -> void*;

fn memory_allocate(Compiler& compiler, usize size) -> void* {
	void* memory = @compiler.allocations.adopt(calloc(1, $size));
	if (!memory) {
		@compiler.result = compilation_result::failure;
	};
	return memory;
};

template<typename T>
fn identity_record(Compiler& compiler, IdentityMap<T>& records, const void* key, const void* context) -> T* {
	T* record = @records.define(@compiler.allocations, $key, $context);
	if (!record) {
		@compiler.result = compilation_result::failure;
	};
	return $record;
};

fn memory_text(Compiler& compiler, const char* text, usize length) -> char* {
	char* copy = (char*)memory_allocate(@compiler, length + 1);
	if (!copy) {
		return nullptr;
	};

	memcpy(char*(copy), $text, $length);

	return $copy;
};

fn Token::text(const Token& this) -> string_view {
	if (!this.source) {
		return string_view();
	};
	return string_view(this.source->bytes.data + this.begin, usize(this.length));
};

fn token_is(const Token& token, const char* text) -> i32 {
	return token.source && token.text().equal(string_view(const char*(text), strlen(const char*(text))));
};

fn token_same(const Token& first, const Token& second) -> i32 {
	return first.source && second.source && first.text().equal(second.text());
};

fn compiler_error(Compiler& compiler, const Token& token, const char* message) {
	@compiler.result = compilation_result::failure;
	if (compiler.diagnostics) {
		const char* path = "<compiler>\0";
		if (token.source && token.source->path.data) {
			@path := token.source->path.data;
		};
		fprintf((void*)compiler.diagnostics, "%s:%llu:%llu: %s\n\0", $path, (u64)token.line, (u64)token.column, const char*(message));
	};
};

fn scope_create(Compiler& compiler, Scope* parent, context_kind context, Entity* owner) -> Scope* {
	Scope* scope = (Scope*)memory_allocate(@compiler, sizeof(Scope));
	if (!scope) {
		return nullptr;
	};

	@scope->compiler = &compiler;
	@scope->parent = $parent;
	@scope->context = $context;
	@scope->owner = $owner;
	@scope->bucket_count = 64;
	@scope->buckets = (Binding**)memory_allocate(@compiler, scope->bucket_count * sizeof(Binding*));
	if (!scope->buckets) {
		return nullptr;
	};

	return $scope;
};

fn token_hash(const Token& token) -> usize {
	usize hash = 5381;
	usize index = 0;

	while (index < token.length) {
		@hash = hash * 33 + (usize)token.source->bytes.data[token.begin + index];
		@index = index + 1;
	};

	return $hash;
};

fn scope_local(Scope* scope, const Token& name) -> Entity* {
	Binding* binding := scope->buckets[token_hash(name) % scope->bucket_count];

	while (binding) {
		if (token_same(binding->name, name)) {
			return (Entity*)binding->entity;
		};
		@binding := binding->hash_next;
	};

	return nullptr;
};

fn scope_lookup(Scope* scope, const Token& name) -> Entity* {
	while (scope) {
		Entity* entity = scope_local((Scope*)scope, name);
		if (entity) {
			return $entity;
		};
		if (scope->owner && scope->owner->kind == entity_kind::kw_struct) {
			@entity = associated_lookup(@*scope->compiler, (Entity*)scope->owner, name);
			if (entity || scope->compiler->result == compilation_result::failure) {
				return $entity;
			};
		};
		@scope := scope->parent;
	};

	return nullptr;
};

fn scope_bind_named(Compiler& compiler, Scope* scope, Token name, Entity* entity, Scope* declaration_scope, Source* source) -> i32 {
	Binding* binding = (Binding*)memory_allocate(@compiler, sizeof(Binding));
	if (!binding) {
		return 0;
	};

	usize bucket = token_hash(name) % scope->bucket_count;
	if (!entity->scope) {
		@entity->scope := scope;
	};
	@binding->name = $name;
	@binding->declaration_scope = $declaration_scope;
	@binding->source = $source;
	@binding->entity = $entity;
	@binding->hash_next := scope->buckets[bucket];
	@scope->buckets[bucket] := binding;
	if (scope->last_binding) {
		@scope->last_binding->next := binding;
	}
	else {
		@scope->bindings := binding;
	};
	@scope->last_binding = $binding;
	@scope->binding_count = scope->binding_count + 1;
	return 1;
};

fn scope_bind(Compiler& compiler, Scope* scope, Entity* entity) -> i32 {
	return scope_bind_named(@compiler, (Scope*)scope, Token(entity->name), (Entity*)entity, $scope, (Source*)entity->name.source);
};

fn scope_define(Compiler& compiler, Scope* scope, Entity* entity) -> i32 {
	if (scope_local((Scope*)scope, entity->name)) {
		compiler_error(@compiler, entity->name, "duplicate declaration\0");
		return 0;
	};

	return scope_bind(@compiler, $scope, $entity);
};

fn entity_create(Compiler& compiler, entity_kind kind, Token name) -> Entity* {
	Entity* entity = (Entity*)memory_allocate(@compiler, sizeof(Entity));
	if (!entity) {
		return nullptr;
	};

	@entity->kind = $kind;
	@entity->name = $name;
	if (entity->kind == entity_kind::function) {
		@entity->data.function.analysis = function_analysis::requested;
	};

	return $entity;
};

fn primitive_define(Compiler& compiler, char* name, type_kind kind, i32 bits) -> Type* {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen((char*)name);
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Type* type = type_primitive(@compiler, $kind, $bits);
	if (!type) {
		return nullptr;
	};
	Entity* entity = entity_create(@compiler, entity_kind::primitive, $token);
	if (!entity) {
		return nullptr;
	};

	@entity->state = resolution::ready;
	@entity->data.primitive.type := type;
	scope_define(@compiler, (Scope*)compiler.module, $entity);

	return $type;
};

fn boolean_define(Compiler& compiler, char* name, bool value) {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return;
	};

	@source->path.data = "<builtins>\0";
	@source->bytes.size = strlen((char*)name);
	@source->bytes.data = $name;
	Token token;
	@token.kind = token_kind::identifier;
	@token.length := source->bytes.size;
	@token.source = $source;
	Entity* entity = entity_create(@compiler, entity_kind::variable, $token);
	if (!entity) {
		return;
	};

	@entity->state = resolution::ready;
	@entity->data.variable.storage = storage_kind::constant;
	@entity->data.variable.type := compiler.bool_type;
	@entity->data.variable.data.integer = (u64)value;
	scope_define(@compiler, (Scope*)compiler.module, $entity);
};

fn compiler_builtins(Compiler& compiler, i32 pointer_bits) {
	declaration_rule_define(&compiler.declaration_rules[0], token_kind::kw_fn, entity_kind::function, context_kind::function);
	declaration_rule_define(&compiler.declaration_rules[1], token_kind::kw_struct, entity_kind::kw_struct, context_kind::kw_struct);
	declaration_rule_define(&compiler.declaration_rules[2], token_kind::kw_union, entity_kind::kw_union, context_kind::kw_union);
	declaration_rule_define(&compiler.declaration_rules[3], token_kind::kw_enum, entity_kind::kw_enum, context_kind::kw_enum);

	@compiler.module = scope_create(@compiler, nullptr, context_kind::module, nullptr);
	@compiler.void_type = primitive_define(@compiler, "void\0", type_kind::kw_void, 0);
	@compiler.null_type = primitive_define(@compiler, "null\0", type_kind::kw_null, 0);
	@compiler.bool_type = primitive_define(@compiler, "bool\0", type_kind::kw_bool, 0);
	boolean_define(@compiler, "false\0", false);
	boolean_define(@compiler, "true\0", true);
	@compiler.char_type = primitive_define(@compiler, "char\0", type_kind::kw_char, 0);
	primitive_define(@compiler, "i08\0", type_kind::kw_signed, 8);
	primitive_define(@compiler, "i16\0", type_kind::kw_signed, 16);
	@compiler.i32_type = primitive_define(@compiler, "i32\0", type_kind::kw_signed, 32);
	primitive_define(@compiler, "i64\0", type_kind::kw_signed, 64);
	primitive_define(@compiler, "u08\0", type_kind::kw_unsigned, 8);
	primitive_define(@compiler, "u16\0", type_kind::kw_unsigned, 16);
	primitive_define(@compiler, "u32\0", type_kind::kw_unsigned, 32);
	primitive_define(@compiler, "u64\0", type_kind::kw_unsigned, 64);
	@compiler.usize_type = primitive_define(@compiler, "usize\0", type_kind::kw_unsigned, $pointer_bits);
	primitive_define(@compiler, "f32\0", type_kind::kw_float, 32);
	primitive_define(@compiler, "f64\0", type_kind::kw_float, 64);
};

fn declaration_rule_define(DeclarationRule* rule, token_kind keyword, entity_kind entity, context_kind context) {
	@rule->keyword = $keyword;
	@rule->entity = $entity;
	@rule->context = $context;
};

fn declaration_rule(Compiler& compiler, token_kind token_kind) -> DeclarationRule* {
	usize count = sizeof(compiler.declaration_rules) / sizeof(DeclarationRule);
	usize index = 0;

	while (index < count) {
		if (compiler.declaration_rules[index].keyword == token_kind) {
			return &compiler.declaration_rules[index];
		};

		@index = index + 1;
	};

	return nullptr;
};

fn declaration_entity(Compiler& compiler, Scope* scope, entity_kind kind, const Token& name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, name);
	if (entity && entity->kind == entity_kind::kw_namespace && (kind == entity_kind::kw_struct || kind == entity_kind::kw_union)) {
		Scope* members = entity_members((Entity*)entity);
		@entity->kind := kind;
		@entity->state = resolution::pending;
		@entity->data.aggregate.type = nullptr;
		@entity->data.aggregate.scope = $members;
	};
	if (entity && entity->kind != kind) {
		compiler_error(@compiler, name, "conflicting declaration kind\0");
		return nullptr;
	};
	if (!entity) {
		@entity = entity_create(@compiler, (entity_kind)kind, Token(name));
		if (!entity) {
			return nullptr;
		};
		scope_define(@compiler, (Scope*)scope, (Entity*)entity);
	};
	if ((kind == entity_kind::kw_struct || kind == entity_kind::kw_union || kind == entity_kind::kw_enum) && !entity->data.aggregate.scope) {
		@entity->data.aggregate.scope = scope_create(@compiler, (Scope*)scope, context_kind::module, (Entity*)entity);
	};
	return $entity;
};

fn namespace_define(Compiler& compiler, Scope* scope, Token name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, name);
	if (entity) {
		if (entity->kind != entity_kind::kw_namespace && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union) {
			compiler_error(@compiler, name, "namespace conflicts with another declaration\0");
			return nullptr;
		};
		return $entity;
	};

	@entity = entity_create(@compiler, entity_kind::kw_namespace, $name);
	if (!entity) {
		return nullptr;
	};
	@entity->data.namespace_entity.scope = scope_create(@compiler, (Scope*)scope, context_kind::module, (Entity*)entity);
	@entity->state = resolution::ready;
	scope_define(@compiler, $scope, (Entity*)entity);
	return $entity;
};

enum declaration_phase : [i32] {
	identities;
	members;
};

fn Lexer::peek(const Lexer& this, usize distance) -> char {
	if (this.offset + distance >= this.source->bytes.size) {
		return 0;
	};
	return (char)this.source->bytes.data[this.offset + distance];
};

fn Lexer::advance(Lexer& this) -> char {
	char value = this.peek(0);
	if (!value) {
		return 0;
	};

	@this.offset = this.offset + 1;
	if (value == '\n') {
		@this.line = this.line + 1;
		@this.column = 1;
	}
	else {
		@this.column = this.column + 1;
	};

	return $value;
};

fn lexer_alpha(char value) -> i32 {
	return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z') || value == '_';
};

fn lexer_digit(char value) -> i32 {
	return value >= '0' && value <= '9';
};

struct Keyword {
	fn Keyword(Keyword& this, char* text, token_kind kind);

	char* text;
	token_kind kind;
};

fn Keyword::Keyword(Keyword& this, char* text, token_kind kind) {
	@this.text = $text;
	@this.kind = $kind;
};

fn lexer_keywords(Keyword* keywords) {
	@keywords[0] = Keyword("fn\0", token_kind::kw_fn);
	@keywords[1] = Keyword("var\0", token_kind::kw_var);
	@keywords[2] = Keyword("struct\0", token_kind::kw_struct);
	@keywords[3] = Keyword("union\0", token_kind::kw_union);
	@keywords[4] = Keyword("enum\0", token_kind::kw_enum);
	@keywords[5] = Keyword("return\0", token_kind::kw_return);
	@keywords[6] = Keyword("if\0", token_kind::kw_if);
	@keywords[7] = Keyword("else\0", token_kind::kw_else);
	@keywords[8] = Keyword("while\0", token_kind::kw_while);
	@keywords[9] = Keyword("for\0", token_kind::kw_for);
	@keywords[10] = Keyword("switch\0", token_kind::kw_switch);
	@keywords[11] = Keyword("case\0", token_kind::kw_case);
	@keywords[12] = Keyword("default\0", token_kind::kw_default);
	@keywords[13] = Keyword("break\0", token_kind::kw_break);
	@keywords[14] = Keyword("continue\0", token_kind::kw_continue);
	@keywords[15] = Keyword("sizeof\0", token_kind::kw_sizeof);
	@keywords[16] = Keyword("namespace\0", token_kind::kw_namespace);
	@keywords[17] = Keyword("virtual\0", token_kind::kw_virtual);
	@keywords[18] = Keyword("override\0", token_kind::kw_override);
	@keywords[19] = Keyword("final\0", token_kind::kw_final);
	@keywords[20] = Keyword("const\0", token_kind::kw_const);
	@keywords[21] = Keyword("discard\0", token_kind::kw_discard);
	@keywords[22] = Keyword("delete\0", token_kind::kw_delete);
	@keywords[23] = Keyword("nullptr\0", token_kind::kw_nullptr);
	@keywords[24] = Keyword("template\0", token_kind::kw_template);
	@keywords[25] = Keyword("typename\0", token_kind::kw_typename);
	@keywords[26] = Keyword("class\0", token_kind::kw_class);
	@keywords[27] = Keyword("implicit\0", token_kind::kw_implicit);
	@keywords[28] = Keyword("new\0", token_kind::kw_new);
};

fn lexer_keyword(const Token& token, Keyword* keywords, usize count) -> token_kind {
	usize index = 0;

	while (index < count) {
		if (token_is(token, (char*)keywords[index].text)) {
			return (token_kind)keywords[index].kind;
		};
		@index = index + 1;
	};

	return token_kind::identifier;
};

fn lexer_operators(Keyword* operators) {
	@operators[0] = Keyword("...\0", token_kind::punct_ellipsis);
	@operators[1] = Keyword("->\0", token_kind::op_arrow);
	@operators[2] = Keyword(":=\0", token_kind::op_copy);
	@operators[3] = Keyword("==\0", token_kind::op_equal);
	@operators[4] = Keyword("!=\0", token_kind::op_not_equal);
	@operators[5] = Keyword("<=\0", token_kind::op_less_equal);
	@operators[6] = Keyword(">=\0", token_kind::op_greater_equal);
	@operators[7] = Keyword("&&\0", token_kind::op_and);
	@operators[8] = Keyword("||\0", token_kind::op_or);
	@operators[9] = Keyword("<<\0", token_kind::op_shift_left);
	@operators[10] = Keyword(">>\0", token_kind::op_shift_right);
	@operators[11] = Keyword("(\0", token_kind::punct_left_paren);
	@operators[12] = Keyword(")\0", token_kind::punct_right_paren);
	@operators[13] = Keyword("[\0", token_kind::punct_left_bracket);
	@operators[14] = Keyword("]\0", token_kind::punct_right_bracket);
	@operators[15] = Keyword("{\0", token_kind::punct_left_brace);
	@operators[16] = Keyword("}\0", token_kind::punct_right_brace);
	@operators[17] = Keyword(";\0", token_kind::punct_semicolon);
	@operators[18] = Keyword(",\0", token_kind::punct_comma);
	@operators[19] = Keyword("::\0", token_kind::op_scope);
	@operators[20] = Keyword(".\0", token_kind::op_dot);
	@operators[21] = Keyword("=\0", token_kind::op_assign);
	@operators[22] = Keyword("+\0", token_kind::op_plus);
	@operators[23] = Keyword("-\0", token_kind::op_minus);
	@operators[24] = Keyword("*\0", token_kind::op_star);
	@operators[25] = Keyword("/\0", token_kind::op_slash);
	@operators[26] = Keyword("%\0", token_kind::op_remainder);
	@operators[27] = Keyword("&\0", token_kind::op_ampersand);
	@operators[28] = Keyword("|\0", token_kind::op_pipe);
	@operators[29] = Keyword("^\0", token_kind::op_caret);
	@operators[30] = Keyword("!\0", token_kind::op_bang);
	@operators[31] = Keyword("~\0", token_kind::op_tilde);
	@operators[32] = Keyword("<\0", token_kind::op_less);
	@operators[33] = Keyword(">\0", token_kind::op_greater);
	@operators[34] = Keyword(":\0", token_kind::punct_colon);
	@operators[35] = Keyword("@\0", token_kind::op_access);
	@operators[36] = Keyword("$\0", token_kind::op_relocate);
};

fn Lexer::match_operator(Lexer& this, Token* token, Keyword* operators, usize count) -> i32 {
	usize index = 0;
	usize longest = 0;
	while (index < count) {
		usize length = strlen((char*)operators[index].text);
		if (length > longest && length <= this.source->bytes.size - token->begin && !memcmp((void*)(this.source->bytes.data + token->begin), (void*)operators[index].text, (u64)length)) {
			@longest = (u64)length;
			@token->kind := operators[index].kind;
		};
		@index = index + 1;
	};
	if (!longest) {
		return 0;
	};
	while (this.offset < token->begin + longest) {
		@this.advance();
	};
	return 1;
};

fn tokenize(Compiler& compiler, Source* source, Token** result, usize* count) -> i32 {
	Lexer lexer {
		@lexer.source := source;
		@lexer.offset = 0;
		@lexer.line = 1;
		@lexer.column = 1;
	};
	Token* tokens = (Token*)memory_allocate(@compiler, (source->bytes.size + 1) * sizeof(Token));
	usize used = 0;
	Keyword[29] keywords {};
	lexer_keywords(&keywords[0]);
	Keyword[37] operators {};
	lexer_operators(&operators[0]);
	usize operator_count = sizeof(operators) / sizeof(Keyword);
	while (true) {
		char value = lexer.peek(0);
		if (value == ' ' || value == '	' || value == '\n' || value == '\r') {
			@lexer.advance();
			continue;
		};
		if (value == '/' && lexer.peek(1) == '/') {
			while (lexer.peek(0) && lexer.peek(0) != '\n') {
				@lexer.advance();
			};
			continue;
		};
		Token token {
			@token.kind = token_kind::identifier;
			@token.length = 0;
			@token.source := source;
			@token.begin := lexer.offset;
			@token.line := lexer.line;
			@token.column := lexer.column;
		};
		if (value == '/' && lexer.peek(1) == '*') {
			@lexer.advance();
			@lexer.advance();
			while (lexer.peek(0) && !(lexer.peek(0) == '*' && lexer.peek(1) == '/')) {
				@lexer.advance();
			};
			if (!lexer.peek(0)) {
				compiler_error(@compiler, token, "unterminated comment\0");
				return 0;
			};
			@lexer.advance();
			@lexer.advance();
			continue;
		};
		if (!value) {
			if (lexer.offset < source->bytes.size) {
				compiler_error(@compiler, token, "NUL byte in source\0");
				return 0;
			};
			@token.kind = token_kind::eof;
			@tokens[used] := token;
			@*result := tokens;
			@*count = used + 1;
			return 1;
		};
		@lexer.advance();
		if (lexer_alpha((char)value)) {
			while (lexer_alpha(lexer.peek(0)) || lexer_digit(lexer.peek(0))) {
				@lexer.advance();
			};
			@token.length = lexer.offset - token.begin;
			@token.kind = lexer_keyword(token, &keywords[0], sizeof(keywords) / sizeof(Keyword));
		}
		else if (lexer_digit((char)value)) {
			@token.kind = token_kind::literal_number;
			while (lexer_digit(lexer.peek(0))) {
				@lexer.advance();
			};
			if (lexer.peek(0) == '.' && lexer_digit(lexer.peek(1))) {
				@lexer.advance();
				while (lexer_digit(lexer.peek(0))) {
					@lexer.advance();
				};
			};
			if (lexer.peek(0) == 'e' || lexer.peek(0) == 'E') {
				@lexer.advance();
				if (lexer.peek(0) == '+' || lexer.peek(0) == '-') {
					@lexer.advance();
				};
				if (!lexer_digit(lexer.peek(0))) {
					compiler_error(@compiler, token, "expected exponent digits\0");
					return 0;
				};
				while (lexer_digit(lexer.peek(0))) {
					@lexer.advance();
				};
			};
		}
		else if (value == '"') {
			@token.kind = token_kind::literal_string;
			while (lexer.peek(0) && lexer.peek(0) != '"') {
				if (lexer.peek(0) == '\n') {
					compiler_error(@compiler, token, "newline in string literal\0");
					return 0;
				};
				if (@lexer.advance() == '\\' && lexer.peek(0)) {
					@lexer.advance();
				};
			};
			if (!lexer.peek(0)) {
				compiler_error(@compiler, token, "unterminated string literal\0");
				return 0;
			};
			@lexer.advance();
		}
		else if (value == '\'') {
			@token.kind = token_kind::literal_number;
			char character = @lexer.advance();

			if (!character || character == '\'' || character == '\n' || character == '\r') {
				compiler_error(@compiler, token, "expected one character in literal\0");
				return 0;
			};

			if (character == '\\') {
				char escaped = @lexer.advance();

				if (!escaped || escaped == '\n' || escaped == '\r') {
					compiler_error(@compiler, token, "unterminated character escape\0");
					return 0;
				};
			};

			if (@lexer.advance() != '\'') {
				compiler_error(@compiler, token, "expected closing quote after character\0");
				return 0;
			};
		}
		else {
			if (!@lexer.match_operator(&token, &operators[0], (u64)operator_count)) {
				compiler_error(@compiler, token, "unknown source character\0");
				return 0;
			};
		};
		@token.length = lexer.offset - token.begin;
		@tokens[used] = $token;
		@used = used + 1;
	};
	return 0;
};

fn Parser::failed(const Parser& this) -> i32 {
	return this.failure.message || this.compiler->result == compilation_result::failure;
};

fn Parser::error(Parser& this, const Token& token, const char* message) {
	if (this.failure.message) {
		return;
	};
	@this.failure.token := token;
	@this.failure.message = $message;
	@this.failure.offset := this.offset;
	@this.failure.pending_greater := this.pending_greater;
};

fn Parser::token(const Parser& this) -> Token {
	Token token := this.tokens[this.offset];
	if (this.pending_greater) {
		@token.kind = token_kind::op_greater;
		@token.begin = token.begin + 1;
		@token.length = 1;
		@token.column = token.column + 1;
	};
	return token;
};

fn Parser::at(const Parser& this, token_kind kind) -> i32 {
	return (this.token()).kind == kind;
};

fn Parser::take(Parser& this, token_kind kind) -> i32 {
	if (!this.at($kind)) {
		return 0;
	};

	if (this.offset + 1 < this.count) {
		@this.offset = this.offset + 1;
	};
	@this.pending_greater = 0;

	return 1;
};

fn Parser::require(Parser& this, token_kind kind, char* message) -> Token {
	Token token = this.token();

	if (!@this.take($kind)) {
		@this.error(Token(token), const char*(message));
	};

	return $token;
};

fn syntax_append(Syntax** first, Syntax** last, Syntax* node) {
	if (!node) {
		return;
	};

	if (*last) {
		(@*last)->next := node;
	}
	else {
		@*first := node;
	};
	@*last = $node;
};

fn Parser::signature_arrow(Parser& this, usize offset) -> usize {
	usize depth = 0;
	while (offset < this.count) {
		token_kind kind := this.tokens[offset].kind;
		if (kind == token_kind::punct_left_paren) {
			@depth = depth + 1;
		};
		if (kind == token_kind::punct_right_paren) {
			@depth = depth - 1;
			if (!depth) {
				if (offset + 1 < this.count && this.tokens[offset + 1].kind == token_kind::op_arrow) {
					return offset + 1;
				};
				return 0;
			};
		};
		@offset = offset + 1;
	};
	return 0;
};

fn entity_members(Entity* entity) -> Scope* {
	if (entity && entity->kind == entity_kind::primitive && entity->data.primitive.type->kind == type_kind::named) {
		return entity_members((Entity*)entity->data.primitive.type->data.entity);
	};
	if (entity && entity->kind == entity_kind::kw_template) {
		return (Scope*)entity->data.template_pattern.instances;
	};
	if (entity && entity->kind == entity_kind::kw_namespace) {
		return (Scope*)entity->data.namespace_entity.scope;
	};
	if (entity && (entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum)) {
		return (Scope*)entity->data.aggregate.scope;
	};
	return nullptr;
};

fn aggregate_header(Entity* entity) -> bool {
	return entity->data.aggregate.virtual_types || entity->data.aggregate.virtual_callables;
};

fn virtual_type_add(Compiler& compiler, Entity* owner, Entity* target) {
	VirtualType* current := owner->data.aggregate.virtual_types;
	VirtualType* last = nullptr;
	usize index = 0;
	while (current) {
		if (current->entity == target) {
			return;
		};
		@last := current;
		@current := current->next;
		@index = index + 1;
	};
	VirtualType* type = (VirtualType*)memory_allocate(@compiler, sizeof(VirtualType));
	@type->entity = $target;
	@type->index = $index;
	if (last) {
		@last->next = (VirtualType*)type;
	}
	else {
		@owner->data.aggregate.virtual_types = (VirtualType*)type;
	};
};

fn virtual_type_index(Entity* owner, Entity* target) -> usize {
	VirtualType* type := owner->data.aggregate.virtual_types;
	while (type && type->entity != target) {
		@type := type->next;
	};
	if (!type) {
		return 0;
	};
	return (u64)type->index;
};

fn bases_resolve(Compiler& compiler, Entity* record) {
	if (record->kind != entity_kind::kw_struct || record->data.aggregate.bases_resolution == resolution::ready) {
		return;
	};
	if (record->data.aggregate.bases_resolution == resolution::active) {
		compiler_error(@compiler, record->name, "cyclic base relationship\0");
		return;
	};
	@record->data.aggregate.bases_resolution = resolution::active;
	BaseRelation* base := record->data.aggregate.bases;
	usize component = 0;
	while (base && compiler.result != compilation_result::failure) {
		@base->entity = name_resolve(@compiler, (Scope*)record->scope, (NameSyntax*)base->name);
		if (!base->entity || base->entity->kind != entity_kind::kw_struct) {
			compiler_error(@compiler, base->name->token, "base relationship requires a struct entity\0");
			return;
		};
		BaseRelation* previous := record->data.aggregate.bases;
		while (previous != base) {
			if (previous->entity == base->entity) {
				compiler_error(@compiler, base->name->token, "duplicate direct base relationship\0");
				return;
			};
			@previous := previous->next;
		};
		bases_resolve(@compiler, (Entity*)base->entity);
		if (base->kind == base_kind::kw_virtual) {
			virtual_type_add(@compiler, (Entity*)record, (Entity*)base->entity);
		};
		VirtualType* inherited := base->entity->data.aggregate.virtual_types;
		while (inherited) {
			virtual_type_add(@compiler, (Entity*)record, (Entity*)inherited->entity);
			@inherited := inherited->next;
		};
		@base := base->next;
	};
	if (aggregate_header((Entity*)record)) {
		@component = 1;
	};
	@base := record->data.aggregate.bases;
	while (base) {
		if (base->kind == base_kind::nonvirtual) {
			@base->component := component;
			@component = component + 1;
		}
		else {
			@base->component = virtual_type_index((Entity*)record, (Entity*)base->entity);
		};
		@base := base->next;
	};
	@record->data.aggregate.bases_resolution = resolution::ready;
};

fn subobject_create(Compiler& compiler, CompleteGraph* graph, Entity* entity, subobject_kind kind) -> Subobject* {
	Subobject* object = (Subobject*)memory_allocate(@compiler, sizeof(Subobject));
	@object->entity = $entity;
	@object->kind := kind;
	if (graph->last_object) {
		@graph->last_object->next := object;
	}
	else {
		@graph->objects := object;
	};
	@graph->last_object := object;
	if (kind == subobject_kind::kw_virtual) {
		if (graph->last_virtual) {
			@object->component = graph->last_virtual->component + 1;
			@graph->last_virtual->virtual_next := object;
		}
		else {
			@object->component = 1;
			@graph->virtuals := object;
		};
		@graph->last_virtual := object;
	};
	return $object;
};

fn subobject_virtual(Compiler& compiler, CompleteGraph* graph, Entity* entity) -> Subobject* {
	Subobject* object := graph->virtuals;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->virtual_next;
	};
	@object = subobject_create(@compiler, (CompleteGraph*)graph, $entity, subobject_kind::kw_virtual);
	subobject_expand(@compiler, $graph, (Subobject*)object);
	return $object;
};

fn subobject_expand(Compiler& compiler, CompleteGraph* graph, Subobject* object) {
	BaseRelation* base := object->entity->data.aggregate.bases;
	SubobjectEdge* last = nullptr;
	while (base) {
		SubobjectEdge* edge = (SubobjectEdge*)memory_allocate(@compiler, sizeof(SubobjectEdge));
		@edge->relation := base;
		if (base->kind == base_kind::kw_virtual) {
			@edge->target = subobject_virtual(@compiler, (CompleteGraph*)graph, (Entity*)base->entity);
		}
		else {
			@edge->target = subobject_create(@compiler, (CompleteGraph*)graph, (Entity*)base->entity, subobject_kind::nonvirtual);
			subobject_expand(@compiler, (CompleteGraph*)graph, (Subobject*)edge->target);
		};
		if (last) {
			@last->next := edge;
		}
		else {
			@object->edges := edge;
		};
		@last = $edge;
		@base := base->next;
	};
};

fn complete_graph(Compiler& compiler, Entity* entity) -> CompleteGraph* {
	if (entity->data.aggregate.complete_graph) {
		return (CompleteGraph*)entity->data.aggregate.complete_graph;
	};
	bases_resolve(@compiler, (Entity*)entity);
	if (compiler.result == compilation_result::failure) {
		return nullptr;
	};
	CompleteGraph* graph = (CompleteGraph*)memory_allocate(@compiler, sizeof(CompleteGraph));
	@graph->entity := entity;
	@graph->root = subobject_create(@compiler, (CompleteGraph*)graph, (Entity*)entity, subobject_kind::root);
	@entity->data.aggregate.complete_graph := graph;
	subobject_expand(@compiler, (CompleteGraph*)graph, (Subobject*)graph->root);
	return $graph;
};

fn subobject_edge(Subobject* object, BaseRelation* relation) -> Subobject* {
	if (!object) {
		return nullptr;
	};
	SubobjectEdge* edge := object->edges;
	while (edge && edge->relation != relation) {
		@edge := edge->next;
	};
	if (!edge) {
		return nullptr;
	};
	return (Subobject*)edge->target;
};

fn subobject_path(Subobject* object, BasePath* path) -> Subobject* {
	while (path && object) {
		@object = subobject_edge((Subobject*)object, (BaseRelation*)path->relation);
		@path := path->next;
	};
	return $object;
};

struct SubobjectVisit {
	Subobject* object;
	SubobjectVisit* next;
};

fn base_paths_graph(Compiler& compiler, Subobject* object, Entity* target, BasePath* prefix, SubobjectVisit** visited, BaseSearch* result) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* current = (SubobjectVisit*)memory_allocate(@compiler, sizeof(SubobjectVisit));
	@current->object := object;
	@current->next := *visited;
	@*visited = $current;
	if (object->entity == target) {
		if (!result->count) {
			@result->path := prefix;
		};
		@result->count = result->count + 1;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* path = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
		@path->relation := edge->relation;
		if (prefix) {
			BasePath* first = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
			@*first := *prefix;
			BasePath* last := first;
			BasePath* next := prefix->next;
			while (next) {
				BasePath* copy = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
				@*copy := *next;
				@last->next := copy;
				@last = $copy;
				@next := next->next;
			};
			@last->next := path;
			@path = $first;
		};
		base_paths_graph(@compiler, (Subobject*)edge->target, (Entity*)target, $path, (SubobjectVisit**)visited, (BaseSearch*)result);
		@edge := edge->next;
	};
};

fn subobject_find_path(Compiler& compiler, Subobject* object, Subobject* target, BasePath** result) -> bool {
	if (object == target) {
		return true;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* tail = nullptr;
		if (subobject_find_path(@compiler, (Subobject*)edge->target, (Subobject*)target, &tail)) {
			BasePath* path = (BasePath*)memory_allocate(@compiler, sizeof(BasePath));
			@path->relation := edge->relation;
			@path->next = (BasePath*)tail;
			@*result = $path;
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn base_path_virtual(BasePath* path) -> bool {
	while (path) {
		if (path->relation->kind == base_kind::kw_virtual) {
			return true;
		};
		@path := path->next;
	};
	return false;
};

enum member_lookup_kind : [i32] {
	none;
	found;
	ambiguous;
};

struct LookupObject {
	Subobject* object;
	LookupObject* next;
};

struct MemberLookup {
	Entity* entity;
	LookupObject* objects;
	member_lookup_kind kind;
};

fn subobject_contains(Subobject* derived, Subobject* base) -> bool {
	if (derived == base) {
		return true;
	};
	SubobjectEdge* edge := derived->edges;
	while (edge) {
		if (subobject_contains((Subobject*)edge->target, (Subobject*)base)) {
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn lookup_dominates(LookupObject* derived, LookupObject* bases) -> bool {
	while (bases) {
		LookupObject* candidate := derived;
		while (candidate && !subobject_contains((Subobject*)candidate->object, (Subobject*)bases->object)) {
			@candidate := candidate->next;
		};
		if (!candidate) {
			return false;
		};
		@bases := bases->next;
	};
	return true;
};

fn lookup_objects_merge(Compiler& compiler, LookupObject** destination, LookupObject* source) {
	while (source) {
		LookupObject* existing := *destination;
		while (existing && existing->object != source->object) {
			@existing := existing->next;
		};
		if (!existing) {
			LookupObject* entry = (LookupObject*)memory_allocate(@compiler, sizeof(LookupObject));
			@entry->object := source->object;
			@entry->next := *destination;
			@*destination = $entry;
		};
		@source := source->next;
	};
};

fn member_find_object(Compiler& compiler, Subobject* object, const Token& name) -> MemberLookup {
	MemberLookup result;
	@result.entity = scope_local(entity_members((Entity*)object->entity), name);
	if (result.entity) {
		@result.kind = member_lookup_kind::found;
		@result.objects = (LookupObject*)memory_allocate(@compiler, sizeof(LookupObject));
		@result.objects->object := object;
		return $result;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		MemberLookup inherited = member_find_object(@compiler, (Subobject*)edge->target, name);
		if (inherited.kind == member_lookup_kind::none) {
			@edge := edge->next;
			continue;
		};
		if (result.kind == member_lookup_kind::none || lookup_dominates((LookupObject*)inherited.objects, (LookupObject*)result.objects)) {
			@result = MemberLookup(inherited);
		}
		else if (!lookup_dominates((LookupObject*)result.objects, (LookupObject*)inherited.objects)) {
			if (inherited.kind != member_lookup_kind::found || result.kind != member_lookup_kind::found || inherited.entity != result.entity) {
				@result.kind = member_lookup_kind::ambiguous;
				@result.entity = nullptr;
			};
			lookup_objects_merge(@compiler, &result.objects, (LookupObject*)inherited.objects);
		};
		@edge := edge->next;
	};
	return $result;
};

fn member_find(Compiler& compiler, Entity* owner, Token name) -> MemberLookup {
	if (owner->kind == entity_kind::kw_struct) {
		CompleteGraph* graph = complete_graph(@compiler, (Entity*)owner);
		if (graph) {
			return member_find_object(@compiler, (Subobject*)graph->root, name);
		};
	};
	MemberLookup result;
	@result.entity = scope_local(entity_members($owner), name);
	if (result.entity) {
		@result.kind = member_lookup_kind::found;
	};
	return $result;
};

fn associated_lookup(Compiler& compiler, Entity* owner, const Token& name) -> Entity* {
	MemberLookup result = member_find(@compiler, $owner, Token(name));
	if (result.kind == member_lookup_kind::ambiguous) {
		compiler_error(@compiler, name, "ambiguous inherited declaration\0");
		return nullptr;
	};
	return (Entity*)result.entity;
};

fn base_paths(Compiler& compiler, Entity* source, Entity* target, BaseSearch* result) {
	if (source == target) {
		@result->count = result->count + 1;
		return;
	};
	if (source->kind != entity_kind::kw_struct || target->kind != entity_kind::kw_struct) {
		return;
	};
	CompleteGraph* graph = complete_graph(@compiler, $source);
	if (!graph) {
		return;
	};
	SubobjectVisit* visited = nullptr;
	base_paths_graph(@compiler, (Subobject*)graph->root, $target, nullptr, &visited, $result);
};

fn base_search(Compiler& compiler, Type* source, Type* target) -> BaseSearch {
	BaseSearch result;
	if (source && target && source->kind == type_kind::named && target->kind == type_kind::named) {
		base_paths(@compiler, (Entity*)source->data.entity, (Entity*)target->data.entity, &result);
	};
	return $result;
};

fn template_apply(Compiler& compiler, Scope* scope, Entity* pattern, ArgumentListSyntax* sources, const Token& token, TemplateArgument** explicit_arguments) -> Entity* {
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	TemplateParameter* parameter := declaration->parameters;
	ArgumentListSyntax* source := sources;
	TemplateArgument* arguments = nullptr;
	TemplateArgument** tail = &arguments;
	Scope* bindings = scope_create(@compiler, (Scope*)scope, context_kind::local, nullptr);
	while (parameter && compiler.result != compilation_result::failure) {
		@source = argument_list_select(@compiler, (Scope*)scope, (ArgumentListSyntax*)source);
		ArgumentSyntax* input = nullptr;
		Scope* context := bindings;
		if (source && source->first) {
			@input := source->first;
			@context := scope;
		}
		else {
			@input := parameter->default_argument;
		};
		if (!input && pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
			break;
		};
		if (!input) {
			compiler_error(@compiler, token, "not enough template arguments\0");
			return nullptr;
		};
		TemplateArgument* argument = template_argument_resolve(@compiler, $context, (TemplateParameter*)parameter, $input);
		if (!argument) {
			return nullptr;
		};
		@*tail := argument;
		@tail = &argument->next;
		template_bind(@compiler, (Scope*)bindings, (TemplateParameter*)parameter, (TemplateArgument*)argument);
		if (source && source->first) {
			@source := source->rest;
		};
		@parameter := parameter->next;
	};
	@source = argument_list_select(@compiler, (Scope*)scope, (ArgumentListSyntax*)source);
	if (source && source->first) {
		compiler_error(@compiler, token, "too many template arguments\0");
		return nullptr;
	};
	@*explicit_arguments := arguments;
	if (parameter) {
		return pattern;
	};
	return template_specialize(@compiler, $pattern, $arguments, token);
};

fn name_lookup(Compiler& compiler, Scope* scope, NameSyntax* name, TemplateArgument** arguments) -> Entity* {
	if (!name) {
		return nullptr;
	};
	Entity* entity = nullptr;
	if (name->qualifier) {
		Entity* owner = name_resolve(@compiler, (Scope*)scope, (NameSyntax*)name->qualifier);
		if (!owner || !entity_members((Entity*)owner)) {
			return nullptr;
		};
		@entity = associated_lookup(@compiler, $owner, name->token);
	}
	else {
		@entity = scope_lookup((Scope*)scope, name->token);
	};
	if (!name->arguments || !entity) {
		return entity;
	};
	if (entity->template_origin) {
		@entity := entity->template_origin;
	};
	if (entity->kind != entity_kind::kw_template) {
		compiler_error(@compiler, name->token, "template arguments require a template entity\0");
		return nullptr;
	};
	return template_apply(@compiler, $scope, $entity, (ArgumentListSyntax*)name->arguments, name->token, $arguments);
};

fn name_binding_resolve(Compiler& compiler, Scope* scope, NameSyntax* name) -> NameResolution* {
	if (!name) {
		return nullptr;
	};
	NameResolution* resolved = @compiler.semantic.resolved_names.find((const void*)name, (const void*)scope);
	if (resolved) {
		return $resolved;
	};
	TemplateArgument* arguments = nullptr;
	NameSyntax* selected = name_source_select(@compiler, (Scope*)scope, (NameSyntax*)name);
	if (!selected) {
		return nullptr;
	};
	Entity* entity = name_lookup(@compiler, (Scope*)scope, $selected, &arguments);
	if (!entity || compiler.result == compilation_result::failure) {
		return nullptr;
	};
	@resolved = identity_record<NameResolution>(@compiler, @compiler.semantic.resolved_names, (const void*)name, (const void*)scope);
	if (!resolved) {
		return nullptr;
	};
	@resolved->entity = $entity;
	@resolved->arguments = $arguments;
	return $resolved;
};

fn name_resolve(Compiler& compiler, Scope* scope, NameSyntax* name) -> Entity* {
	NameResolution* resolved = name_binding_resolve(@compiler, $scope, $name);
	if (!resolved) {
		return nullptr;
	};
	return (Entity*)resolved->entity;
};

fn named_type(Compiler& compiler, Scope* scope, Syntax* syntax) -> Type* {
	Entity* entity = syntax_lookup((Scope*)scope, (Syntax*)syntax);
	if (!entity || (entity->kind != entity_kind::primitive && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union && entity->kind != entity_kind::kw_enum)) {
		compiler_error(@compiler, syntax->token, "identifier does not name a type entity\0");
		return (Type*)compiler.void_type;
	};
	Type* type = entity_type((Entity*)entity);
	if (!type && entity->kind != entity_kind::primitive) {
		@type = type_entity(@compiler, type_kind::named, (Entity*)entity);
		@entity->data.aggregate.type := type;
	};
	return $type;
};

fn function_type_resolve(Compiler& compiler, Scope* scope, Entity* function) -> Type* {
	TypeSyntax* signature := function->declaration->data.declaration.type;
	if (signature) {
		@function->data.function.type_use = type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)signature);
		return type_resolve(@compiler, (Scope*)scope, $signature);
	};
	return (Type*)function->data.function.type;
};

fn syntax_lookup(Scope* scope, Syntax* syntax) -> Entity* {
	if (!syntax) {
		return nullptr;
	};
	if (syntax->entity) {
		return (Entity*)syntax->entity;
	};
	if (syntax->kind == syntax_kind::expr_member) {
		Scope* members = entity_members(syntax_lookup((Scope*)scope, (Syntax*)syntax->data.member.object));
		if (!members) {
			return nullptr;
		};
		return associated_lookup(@*scope->compiler, (Entity*)members->owner, syntax->data.member.name);
	};
	if (syntax->kind != syntax_kind::expr_name) {
		return nullptr;
	};
	if (syntax->source_name) {
		NameResolution* resolved = name_binding_resolve(@*scope->compiler, (Scope*)scope, (NameSyntax*)syntax->source_name);
		if (!resolved) {
			return nullptr;
		};
		@syntax->template_arguments := resolved->arguments;
		return (Entity*)resolved->entity;
	};
	if (!syntax->data.expression) {
		return scope_lookup((Scope*)scope, syntax->token);
	};
	Scope* members = entity_members(syntax_lookup((Scope*)scope, (Syntax*)syntax->data.expression));
	if (!members) {
		return nullptr;
	};
	return associated_lookup(@*scope->compiler, (Entity*)members->owner, syntax->token);
};

fn template_arguments_equal(TemplateArgument* first, TemplateArgument* second) -> bool {
	while (first && second) {
		if (first->kind != second->kind || first->parameter != second->parameter || !type_equal((Type*)first->type, (Type*)second->type)) {
			return false;
		};
		if (first->kind == template_parameter_kind::value && first->value != second->value) {
			return false;
		};
		@first := first->next;
		@second := second->next;
	};
	return !first && !second;
};

fn template_bind(Compiler& compiler, Scope* scope, TemplateParameter* parameter, TemplateArgument* argument) {
	while (parameter && argument && compiler.result != compilation_result::failure) {
		if (!scope_local((Scope*)scope, parameter->name)) {
			entity_kind kind = entity_kind::primitive;
			if (parameter->kind == template_parameter_kind::value) {
				@kind = entity_kind::variable;
			};
			Entity* entity = entity_create(@compiler, $kind, Token(parameter->name));
			if (!entity) {
				return;
			};
			@entity->state = resolution::ready;
			@entity->template_parameter := argument->parameter;
			if (parameter->kind == template_parameter_kind::type) {
				@entity->data.primitive.type := argument->type;
				@entity->data.primitive.type_use := argument->type_use;
			}
			else {
				@entity->data.variable.storage = storage_kind::constant;
				@entity->data.variable.type := argument->type;
				@entity->data.variable.data.integer := argument->value;
			};
			scope_define(@compiler, (Scope*)scope, $entity);
		};
		@parameter := parameter->next;
		@argument := argument->next;
	};
};

fn template_instance_name(Compiler& compiler, Token token, usize index) -> Token {
	char[22] digits {};
	@digits[sizeof(digits) - 1] = '\0';
	usize position = sizeof(digits) - 1;
	while (true) {
		@position = position - 1;
		@digits[position] = (char)((usize)'0' + index % 10);
		@index = index / 10;
		if (!index) {
			break;
		};
	};
	char* spelling = memory_text(@compiler, &digits[position], sizeof(digits) - position - 1);
	return token_synthetic(@compiler, $token, $spelling);
};

fn type_dependent(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == type_kind::parameter) {
		return true;
	};
	if (type->kind == type_kind::pointer || type->kind == type_kind::reference) {
		return type_dependent((Type*)type->data.element);
	};
	if (type->kind == type_kind::array) {
		return type_dependent((Type*)type->data.array.element);
	};
	if (type->kind == type_kind::named && type->data.entity->specialization) {
		TemplateArgument* argument := type->data.entity->specialization->arguments;
		while (argument) {
			if (argument->parameter || type_dependent((Type*)argument->type)) {
				return true;
			};
			@argument := argument->next;
		};
	};
	return false;
};

fn Parser::template_close(Parser& this) {
	if (!this.pending_greater && this.tokens[this.offset].kind == token_kind::op_shift_right) {
		@this.pending_greater = 1;
		return;
	};
	@this.require(token_kind::op_greater, "expected '>' after template arguments\0");
};

fn template_argument_resolve(Compiler& compiler, Scope* scope, TemplateParameter* parameter, ArgumentSyntax* source) -> TemplateArgument* {
	TemplateArgument* argument = (TemplateArgument*)memory_allocate(@compiler, sizeof(TemplateArgument));
	if (!argument || !source) {
		return nullptr;
	};
	@argument->kind := parameter->kind;
	if (parameter->kind == template_parameter_kind::type) {
		if (!source->type || !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)source->type_guard)) {
			compiler_error(@compiler, parameter->name, "expected type template argument\0");
			return argument;
		};
		@argument->type = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)source->type);
		@argument->type_use = type_use_resolve(@compiler, (Scope*)scope, (TypeSyntax*)source->type);
		return argument;
	};
	@argument->type = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)parameter->type);
	if (!type_integer((Type*)argument->type)) {
		compiler_error(@compiler, parameter->name, "non-type template parameter requires an integral type\0");
		return argument;
	};
	if (!source->value || !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)source->value_guard)) {
		compiler_error(@compiler, parameter->name, "expected value template argument\0");
		return argument;
	};
	Syntax* value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->value);
	if (!value) {
		compiler_error(@compiler, parameter->name, "expected value template argument\0");
		return argument;
	};
	if (value->kind == syntax_kind::expr_name) {
		Entity* entity = syntax_lookup((Scope*)scope, (Syntax*)value);
		if (entity) {
			@argument->parameter := entity->template_parameter;
		};
	};
	Semantic checking;
	@checking.compiler = &compiler;
	@checking.scope := scope;
	@checking.expression((Syntax*)value, (Type*)argument->type);
	@argument->value = constant_integer(@compiler, (Scope*)scope, (Syntax*)value);
	i32 bits = type_bits((Type*)argument->type);
	if (bits < 64) {
		u64 maximum = (u64)18446744073709551615 >> (u64)(64 - bits);
		if (type_unsigned((Type*)argument->type) || argument->type->kind == type_kind::kw_bool || argument->type->kind == type_kind::kw_char) {
			if (argument->value > maximum) {
				compiler_error(@compiler, value->token, "template argument is outside its parameter type range\0");
			};
		}
		else {
			@maximum = maximum / 2;
			i64 signed_value := (i64)argument->value;
			if (signed_value > (i64)maximum || signed_value < -(i64)maximum - 1) {
				compiler_error(@compiler, value->token, "template argument is outside its parameter type range\0");
			};
		};
	};
	return argument;
};

fn syntax_create(Compiler& compiler, syntax_kind kind, Token token) -> Syntax* {
	Syntax* syntax = (Syntax*)memory_allocate(@compiler, sizeof(Syntax));
	if (!syntax) {
		return nullptr;
	};
	@syntax->kind = $kind;
	@syntax->token = $token;
	return $syntax;
};

fn literal_string_create(Compiler& compiler, const Token& token) -> Syntax* {
	Syntax* node = syntax_create(@compiler, syntax_kind::literal_string, Token(token));
	char* bytes = (char*)memory_allocate(@compiler, (usize)token.length);
	if (!node || !bytes) {
		return nullptr;
	};
	usize index = 1;
	usize length = 0;
	while (index + 1 < token.length) {
		char value := token.source->bytes.data[token.begin + index];
		@index = index + 1;
		if (value == '\\') {
			@value = literal_escape(@compiler, token, (char)token.source->bytes.data[token.begin + index]);
			@index = index + 1;
		};
		@bytes[length] = $value;
		@length = length + 1;
	};
	@node->data.string = string_view($bytes, $length);
	return $node;
};

struct ValueBinary {
	ValueSyntax* left;
	ValueSyntax* right;
	token_kind operation;
};

struct ValueCall {
	ValueSyntax* callable;
	ValueSyntax* arguments;
};

struct ValueMember {
	ValueSyntax* object;
	NameSyntax* name;
};

struct ValueTyped {
	TypeSyntax* type;
	ValueSyntax* value;
};

struct ValueDeclaration {
	TypeSyntax* type;
	Token name;
	ValueSyntax* body;
	token_kind initialization;
};

struct ValueBranch {
	ValueSyntax* condition;
	ValueSyntax* first;
	ValueSyntax* second;
};

struct ValueLoop {
	ValueSyntax* initializer;
	ValueSyntax* condition;
	ValueSyntax* step;
	ValueSyntax* body;
};

struct ValueSelection {
	ValueSyntax* value;
	ValueSyntax* cases;
};

union ValueSyntaxData {
	SourceDeclaration* source_declaration;
	SourceChoice* choice;
	SourceExpression* chain;
	ParseFailure* error;
	NameSyntax* name;
	ValueSyntax* expression;
	ValueSyntax* statements;
	ValueBinary binary;
	ValueCall call;
	ValueMember member;
	ValueTyped typed;
	ValueDeclaration declaration;
	ValueBranch branch;
	ValueLoop loop;
	ValueSelection selection;
};

struct ValueSyntax {
	ValueSyntax* next;
	Token token;
	ValueSyntaxData data;
	syntax_kind kind;
};

fn value_name(Compiler& compiler, NameSyntax* name) -> ValueSyntax* {
	ValueSyntax* value = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
	if (!value) {
		return nullptr;
	};
	@value->kind = syntax_kind::expr_name;
	@value->token := name->token;
	@value->data.name = (NameSyntax*)name;
	return (ValueSyntax*)value;
};

fn name_lower(Compiler& compiler, Scope* scope, NameSyntax* name) -> Syntax* {
	if (!name) {
		return nullptr;
	};
	Syntax* node = syntax_create(@compiler, syntax_kind::expr_name, Token(name->token));
	if (!node) {
		return nullptr;
	};
	@node->source_name = (NameSyntax*)name;

	return (Syntax*)node;
};

fn Parser::new_value(Parser& this, syntax_kind kind, Token token) -> ValueSyntax* {
	ValueSyntax* value = (ValueSyntax*)memory_allocate(@*this.compiler, sizeof(ValueSyntax));
	if (!value) {
		return nullptr;
	};
	@value->kind = (syntax_kind)kind;
	@value->token = Token(token);
	return (ValueSyntax*)value;
};

// A tail operation has a vacant left/callee/object edge; it is NEVER mutated.
// Nodes are immutable after their containing source parse completes.

struct ParseCursor {
	usize offset;
	usize pending_greater;
};

enum parse_guard_kind : [i32] {
	never;
	decision;
	conjunction;
	disjunction;
	negation;
};

enum source_delimiter : [i32] {
	ordinary;
	statement;
	paren;
	index;
	call_argument;
	template_argument;
	enum_member;
	for_clause;
	case_label;
};

struct ParseGuard {
	ParseChoice choice;
	ParseGuard* left;
	ParseGuard* right;
	parse_guard_kind kind;
	i32 selected;
};

struct SourceArm {
	ParseGuard* guard;
	ValueSyntax* value;
	SourceArm* next;
};

struct SourceChoice {
	SourceArm* first;
};

enum expression_tail_kind : [i32] {
	stop;
	operation;
	choice;
};

struct TailArm {
	ParseGuard* guard;
	ExpressionTail* tail;
	TailArm* next;
};

struct ExpressionTail {
	ValueSyntax* operation;
	ExpressionTail* next;
	TailArm* choices;
	expression_tail_kind kind;
};

struct SourceExpression {
	ValueSyntax* head;
	ExpressionTail* tail;
};

template<typename T>
struct ParseResult {
	T* value;
	ParseGuard* guard;
	ParseCursor end;
	ParseResult<T>* next;
};

template<typename T>
fn parse_result_find(ParseResult<T>* result, const ParseCursor& end) -> ParseResult<T>* {
	while (result && !parse_cursor_equal(result->end, end)) {
		@result := result->next;
	};
	return (ParseResult<T>*)result;
};

template<typename T>
fn parse_result_push(Compiler& compiler, ParseResult<T>** results, T* value, ParseGuard* guard, const ParseCursor& end) -> ParseResult<T>* {
	ParseResult<T>* result = (ParseResult<T>*)memory_allocate(@compiler, sizeof(ParseResult<T>));
	if (!result) {
		return nullptr;
	};
	@result->value = (T*)value;
	@result->guard = (ParseGuard*)guard;
	@result->end := end;
	@result->next := *results;
	@*results = (ParseResult<T>*)result;
	return (ParseResult<T>*)result;
};

template<typename T>
fn parse_result_add(Compiler& compiler, ParseResult<T>** results, T* value, ParseGuard* guard, const ParseCursor& end, ((Compiler&, T*, ParseGuard*, T*, ParseGuard*)->T*)* pack) {
	ParseResult<T>* existing = parse_result_find<T>(ParseResult<T>*( *results), end);
	if (!existing) {
		parse_result_push<T>(@compiler, (ParseResult<T>**)results, (T*)value, (ParseGuard*)guard, end);
		return;
	};
	T* packed = pack(@compiler, T*(existing->value), ParseGuard*(existing->guard), (T*)value, (ParseGuard*)guard);
	if (!packed) {
		return;
	};
	@existing->value = (T*)packed;
	@existing->guard = parse_guard(@compiler, parse_guard_kind::disjunction, ParseGuard*(existing->guard), (ParseGuard*)guard);
};

fn pack_value(Compiler& compiler, ValueSyntax* left, ParseGuard* left_guard, ValueSyntax* right, ParseGuard* right_guard) -> ValueSyntax* {
	SourceChoice* choice = (SourceChoice*)memory_allocate(@compiler, sizeof(SourceChoice));
	ValueSyntax* packed = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
	if (!choice || !packed) {
		return nullptr;
	};
	@choice->first = parse_arm(@compiler, ValueSyntax*(left), ParseGuard*(left_guard), nullptr);
	@choice->first = parse_arm(@compiler, (ValueSyntax*)right, (ParseGuard*)right_guard, SourceArm*(choice->first));
	@packed->kind = syntax_kind::source_choice;
	@packed->token := left->token;
	@packed->data.choice = (SourceChoice*)choice;
	return (ValueSyntax*)packed;
};

fn pack_tail(Compiler& compiler, ExpressionTail* left, ParseGuard* left_guard, ExpressionTail* right, ParseGuard* right_guard) -> ExpressionTail* {
	ExpressionTail* packed = (ExpressionTail*)memory_allocate(@compiler, sizeof(ExpressionTail));
	TailArm* first = (TailArm*)memory_allocate(@compiler, sizeof(TailArm));
	TailArm* second = (TailArm*)memory_allocate(@compiler, sizeof(TailArm));
	if (!packed || !first || !second) {
		return nullptr;
	};
	@first->tail := left;
	@first->guard := left_guard;
	@second->tail = (ExpressionTail*)right;
	@second->guard := right_guard;
	@second->next = (TailArm*)first;
	@packed->kind = expression_tail_kind::choice;
	@packed->choices = (TailArm*)second;
	return (ExpressionTail*)packed;
};

fn pack_type(Compiler& compiler, TypeSyntax* left, ParseGuard* left_guard, TypeSyntax* right, ParseGuard* right_guard) -> TypeSyntax* {
	TypeChoice* first = (TypeChoice*)memory_allocate(@compiler, sizeof(TypeChoice));
	TypeChoice* second = (TypeChoice*)memory_allocate(@compiler, sizeof(TypeChoice));
	TypeSyntax* packed = (TypeSyntax*)memory_allocate(@compiler, sizeof(TypeSyntax));
	if (!first || !second || !packed) {
		return nullptr;
	};
	@first->type := left;
	@first->guard := left_guard;
	@second->type = (TypeSyntax*)right;
	@second->guard := right_guard;
	@second->next = (TypeChoice*)first;
	@packed->kind = type_syntax_kind::choice;
	@packed->token := left->token;
	@packed->data.choices = (TypeChoice*)second;
	return (TypeSyntax*)packed;
};

fn pack_name(Compiler& compiler, NameSyntax* left, ParseGuard* left_guard, NameSyntax* right, ParseGuard* right_guard) -> NameSyntax* {
	NameSyntax* packed = (NameSyntax*)memory_allocate(@compiler, sizeof(NameSyntax));
	NameChoice* first = (NameChoice*)memory_allocate(@compiler, sizeof(NameChoice));
	NameChoice* second = (NameChoice*)memory_allocate(@compiler, sizeof(NameChoice));
	if (!packed || !first || !second) {
		return nullptr;
	};
	@first->name := left;
	@first->guard := left_guard;
	@second->name = (NameSyntax*)right;
	@second->guard := right_guard;
	@second->next = (NameChoice*)first;
	@packed->token := left->token;
	@packed->choices = (NameChoice*)second;
	return (NameSyntax*)packed;
};

fn pack_arguments(Compiler& compiler, ArgumentListSyntax* left, ParseGuard* left_guard, ArgumentListSyntax* right, ParseGuard* right_guard) -> ArgumentListSyntax* {
	ArgumentListSyntax* packed = (ArgumentListSyntax*)memory_allocate(@compiler, sizeof(ArgumentListSyntax));
	ArgumentListArm* first = (ArgumentListArm*)memory_allocate(@compiler, sizeof(ArgumentListArm));
	ArgumentListArm* second = (ArgumentListArm*)memory_allocate(@compiler, sizeof(ArgumentListArm));
	if (!packed || !first || !second) {
		return nullptr;
	};
	@first->arguments := left;
	@first->guard := left_guard;
	@second->arguments = (ArgumentListSyntax*)right;
	@second->guard := right_guard;
	@second->next = (ArgumentListArm*)first;
	@packed->choices = (ArgumentListArm*)second;
	return (ArgumentListSyntax*)packed;
};

struct ParseFailureArm {
	ParseFailure failure;
	ParseGuard* guard;
	ParseFailureArm* next;
};

fn parse_failure_record(Compiler& compiler, ParseFailureArm** failures, const ParseFailure& failure, ParseGuard* guard) {
	if (!failure.message) {
		return;
	};
	ParseFailureArm* arm = (ParseFailureArm*)memory_allocate(@compiler, sizeof(ParseFailureArm));
	if (!arm) {
		return;
	};
	@arm->failure := failure;
	@arm->guard = (ParseGuard*)guard;
	@arm->next := *failures;
	@*failures = (ParseFailureArm*)arm;
};

fn Parser::value_results_finish(Parser& this, ParseResult<ValueSyntax>* result, ParseFailureArm* failures) -> ParseResult<ValueSyntax>* {
	@this.failure = ParseFailure();
	while (failures && this.compiler->result != compilation_result::failure) {
		if (result) {
			parse_results_failure(@*this.compiler, &result, failures->failure, ParseGuard*(failures->guard));
		}
		else if (!this.failure.message || failures->failure.offset > this.failure.offset || (failures->failure.offset == this.failure.offset && failures->failure.pending_greater > this.failure.pending_greater)) {
			@this.failure := failures->failure;
		};
		@failures := failures->next;
	};
	return (ParseResult<ValueSyntax>*)result;
};

enum parse_memo_kind : [i32] {
	enum_members;
	function_name;
	type;
	signature_parameters;
	source_name;
	neutral_argument;
	argument_list;
	argument_sequence;
	tail;
	expression;
	arguments;
	statement;
	statements;
	block;
};

fn parse_decision(Compiler& compiler, TypeSyntax* type, NameSyntax* name, const ParseCursor& cursor, i32 selected) -> ParseGuard* {
	ParseGuard* result = (ParseGuard*)memory_allocate(@compiler, sizeof(ParseGuard));
	if (!result) {
		return nullptr;
	};
	@result->kind = parse_guard_kind::decision;
	@result->selected = (i32)selected;
	@result->choice.type = (TypeSyntax*)type;
	@result->choice.name = (NameSyntax*)name;
	@result->choice.offset := cursor.offset;
	@result->choice.pending_greater := cursor.pending_greater;
	if (result->choice.name) {
		@result->choice.kind = parse_choice_kind::template_name;
	};

	return (ParseGuard*)result;
};

fn parser_cursor(const Parser& parser) -> ParseCursor {
	ParseCursor result;
	@result.offset := parser.offset;
	@result.pending_greater := parser.pending_greater;
	return $result;
};

fn parse_results_guard(Compiler& compiler, ParseResult<ValueSyntax>* results, ParseGuard* guard) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* guarded = nullptr;
	while (results && compiler.result != compilation_result::failure) {
		ParseGuard* combined = parse_guard(@compiler, parse_guard_kind::conjunction, ParseGuard*(results->guard), (ParseGuard*)guard);
		parse_result_add<ValueSyntax>(@compiler, &guarded, ValueSyntax*(results->value), (ParseGuard*)combined, results->end, &pack_value);
		@results := results->next;
	};
	return (ParseResult<ValueSyntax>*)guarded;
};

fn parse_results_merge(Compiler& compiler, ParseResult<ValueSyntax>** destination, ParseResult<ValueSyntax>* source) {
	while (source && compiler.result != compilation_result::failure) {
		parse_result_add<ValueSyntax>(@compiler, (ParseResult<ValueSyntax>**)destination, ValueSyntax*(source->value), ParseGuard*(source->guard), source->end, &pack_value);
		@source := source->next;
	};
};

fn Parser::value_single_result(Parser& this, ValueSyntax* value) -> ParseResult<ValueSyntax>* {
	if (!value || this.failed()) {
		return nullptr;
	};
	ParseResult<ValueSyntax>* result = nullptr;
	parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)value, nullptr, parser_cursor(this), &pack_value);
	return (ParseResult<ValueSyntax>*)result;
};

// Parses an argument suffix through its closing delimiter. Lists are persistent.
fn Parser::value_argument_parse(Parser& this, token_kind closing, i32 delimiter) -> ParseResult<ValueSyntax>* {
	if (@this.take((token_kind)closing)) {
		ParseResult<ValueSyntax>* empty = (ParseResult<ValueSyntax>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ValueSyntax>));
		if (empty) {
			@empty->end = parser_cursor(this);
		};
		return (ParseResult<ValueSyntax>*)empty;
	};
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	ParseResult<ValueSyntax>* first = @this.value_expression_results(1, (i32)delimiter);
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (first && this.compiler->result != compilation_result::failure) {
		Parser suffix := this;
		@suffix.failure = ParseFailure();
		@suffix.offset := first->end.offset;
		@suffix.pending_greater := first->end.pending_greater;
		ParseResult<ValueSyntax>* rest = nullptr;
		if (@suffix.take((token_kind)closing)) {
			@rest = (ParseResult<ValueSyntax>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ValueSyntax>));
			if (rest) {
				@rest->end = parser_cursor(suffix);
			};
		}
		else if (@suffix.take(token_kind::punct_comma)) {
			@rest = @suffix.value_argument_results((token_kind)closing, (i32)delimiter);
		}
		else {
			@suffix.error(suffix.token(), "expected ',' or closing argument delimiter\0");
		};
		parse_failure_record(@*this.compiler, &failures, suffix.failure, ParseGuard*(first->guard));
		while (rest && this.compiler->result != compilation_result::failure) {
			ValueSyntax* list = @this.new_value(syntax_kind::source_list, Token(first->value->token));
			if (!list) {
				return nullptr;
			};
			@list->data.binary.left := first->value;
			@list->data.binary.right := rest->value;
			ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(first->guard), ParseGuard*(rest->guard));
			parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)list, (ParseGuard*)guard, rest->end, &pack_value);
			@rest := rest->next;
		};
		@first := first->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn value_member_operation(Compiler& compiler, const Token& token, ValueSyntax* name) -> ValueSyntax* {
	if (!name || name->kind == syntax_kind::source_error) {
		return name;
	};
	ValueSyntax* member = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
	if (!member) {
		return nullptr;
	};
	@member->token := token;
	if (name->kind == syntax_kind::source_choice) {
		SourceChoice* choice = (SourceChoice*)memory_allocate(@compiler, sizeof(SourceChoice));
		if (!choice) {
			return nullptr;
		};
		@member->kind = syntax_kind::source_choice;
		@member->data.choice := choice;
		SourceArm** tail = &choice->first;
		SourceArm* arm := name->data.choice->first;
		while (arm && compiler.result != compilation_result::failure) {
			SourceArm* mapped = parse_arm(@compiler, value_member_operation(@compiler, token, (ValueSyntax*)arm->value), (ParseGuard*)arm->guard, nullptr);
			if (!mapped) {
				return nullptr;
			};
			@*tail := mapped;
			@tail = &mapped->next;
			@arm := arm->next;
		};
		return (ValueSyntax*)member;
	};
	@member->kind = syntax_kind::expr_member;
	@member->data.member.name := name->data.name;
	return (ValueSyntax*)member;
};

fn Parser::value_postfix_operation_results(Parser& this, i32 delimiter) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	ParseResult<ValueSyntax>* result = nullptr;
	if (@this.take(token_kind::punct_left_paren)) {
		ParseResult<ValueSyntax>* arguments = @this.value_argument_results(token_kind::punct_right_paren, (i32)source_delimiter::call_argument);
		while (arguments && this.compiler->result != compilation_result::failure) {
			ValueSyntax* call = @this.new_value(syntax_kind::expr_call, Token(token));
			if (!call) {
				return nullptr;
			};
			@call->data.call.arguments := arguments->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)call, ParseGuard*(arguments->guard), arguments->end, &pack_value);
			@arguments := arguments->next;
		};
		return (ParseResult<ValueSyntax>*)result;
	};
	if (@this.take(token_kind::punct_left_bracket)) {
		ParseFailureArm* failures = nullptr;
		ParseResult<ValueSyntax>* indexes = @this.value_expression_results(1, (i32)source_delimiter::index);
		parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
		while (indexes && this.compiler->result != compilation_result::failure) {
			Parser suffix := this;
			@suffix.failure = ParseFailure();
			@suffix.offset := indexes->end.offset;
			@suffix.pending_greater := indexes->end.pending_greater;
			@suffix.require(token_kind::punct_right_bracket, "expected ']' after index\0");
			parse_failure_record(@*this.compiler, &failures, suffix.failure, ParseGuard*(indexes->guard));
			if (!suffix.failed()) {
				ValueSyntax* index = @this.new_value(syntax_kind::expr_index, Token(token));
				if (!index) {
					return nullptr;
				};
				@index->data.binary.right := indexes->value;
				parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)index, ParseGuard*(indexes->guard), parser_cursor(suffix), &pack_value);
			};
			@indexes := indexes->next;
		};
		return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
	};
	@this.take((token_kind)token.kind);
	if (@this.take(token_kind::op_tilde)) {
		ParseFailureArm* failures = nullptr;
		ParseResult<TypeSyntax>* types = @this.type_results();
		parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
		while (types && this.compiler->result != compilation_result::failure) {
			Parser candidate := this;
			@candidate.failure = ParseFailure();
			@candidate.offset := types->end.offset;
			@candidate.pending_greater := types->end.pending_greater;
			@candidate.require(token_kind::punct_left_paren, "expected '(' after destructor type\0");
			@candidate.require(token_kind::punct_right_paren, "destructor invocation takes no arguments\0");
			parse_failure_record(@*this.compiler, &failures, candidate.failure, (ParseGuard*)types->guard);
			if (!candidate.failed()) {
				ValueSyntax* destruction = @this.new_value(syntax_kind::expr_destroy, Token(token));
				if (!destruction) {
					return nullptr;
				};
				@destruction->data.typed.type := types->value;
				parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)destruction, (ParseGuard*)types->guard, parser_cursor(candidate), &pack_value);
			};
			@types := types->next;
		};
		return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
	};
	ParseResult<ValueSyntax>* names = @this.value_name_results();
	while (names && this.compiler->result != compilation_result::failure) {
		ValueSyntax* member = value_member_operation(@*this.compiler, token, (ValueSyntax*)names->value);
		if (!member) {
			return nullptr;
		};
		parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)member, ParseGuard*(names->guard), names->end, &pack_value);
		@names := names->next;
	};
	return (ParseResult<ValueSyntax>*)result;
};

fn parse_cursor_equal(const ParseCursor& first, const ParseCursor& second) -> bool {
	return first.offset == second.offset && first.pending_greater == second.pending_greater;
};

fn parse_guard(Compiler& compiler, parse_guard_kind kind, ParseGuard* left, ParseGuard* right) -> ParseGuard* {
	if (kind == parse_guard_kind::negation || kind == parse_guard_kind::never) {
		if (kind == parse_guard_kind::negation && left && left->kind == parse_guard_kind::never) {
			return nullptr;
		};
		if (kind == parse_guard_kind::negation && left && left->kind == parse_guard_kind::negation) {
			return (ParseGuard*)left->left;
		};
		ParseGuard* result = (ParseGuard*)memory_allocate(@compiler, sizeof(ParseGuard));
		if (!result) {
			return nullptr;
		};
		@result->kind = (parse_guard_kind)kind;
		@result->left = (ParseGuard*)left;

		return (ParseGuard*)result;
	};
	if (left == right) {
		return (ParseGuard*)left;
	};
	if (kind == parse_guard_kind::conjunction) {
		if (!left) {
			return (ParseGuard*)right;
		};
		if (!right) {
			return (ParseGuard*)left;
		};
	}
	else if (!left || !right) {
		return nullptr;
	};
	ParseGuard* result = (ParseGuard*)memory_allocate(@compiler, sizeof(ParseGuard));
	if (!result) {
		return nullptr;
	};
	@result->kind = (parse_guard_kind)kind;
	@result->left = (ParseGuard*)left;
	@result->right = (ParseGuard*)right;

	return (ParseGuard*)result;
};

fn parse_guard_matches(Compiler& compiler, Scope* scope, ParseGuard* guard) -> bool {
	if (!guard) {
		return true;
	};
	switch (guard->kind) {
		case parse_guard_kind::never:
			return false;
		case parse_guard_kind::decision:
			return parse_choice_matches(@compiler, (Scope*)scope, guard->choice) == guard->selected;
		case parse_guard_kind::conjunction:
			return parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)guard->left) && parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)guard->right);
		case parse_guard_kind::disjunction:
			return parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)guard->left) || parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)guard->right);
		case parse_guard_kind::negation:
			return !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)guard->left);
	};
	return false;
};

fn parse_arm(Compiler& compiler, ValueSyntax* value, ParseGuard* guard, SourceArm* next) -> SourceArm* {
	SourceArm* arm = (SourceArm*)memory_allocate(@compiler, sizeof(SourceArm));
	if (!arm) {
		return nullptr;
	};
	@arm->value = (ValueSyntax*)value;
	@arm->guard = (ParseGuard*)guard;
	@arm->next = (SourceArm*)next;

	return (SourceArm*)arm;
};

// An error arm is diagnostic-only. It borrows successful siblings' continuation
// endpoints, never represents another successful parse or consumes source tokens.
// Retain it when a syntactically failed branch is selected by name resolution.
fn parse_results_failure(Compiler& compiler, ParseResult<ValueSyntax>** results, const ParseFailure& failure, ParseGuard* guard) {
	if (!failure.message) {
		return;
	};
	ParseResult<ValueSyntax>* sibling := *results;
	while (sibling && compiler.result != compilation_result::failure) {
		ParseFailure* saved = (ParseFailure*)memory_allocate(@compiler, sizeof(ParseFailure));
		ValueSyntax* error = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
		if (!saved || !error) {
			return;
		};
		@*saved := failure;
		@error->kind = syntax_kind::source_error;
		@error->token := failure.token;
		@error->data.error = (ParseFailure*)saved;
		parse_result_add<ValueSyntax>(@compiler, (ParseResult<ValueSyntax>**)results, (ValueSyntax*)error, (ParseGuard*)guard, sibling->end, &pack_value);
		@sibling := sibling->next;
	};
};

struct ParseMemoStore {
	ParseMemo** buckets;
	Token* tokens;
	usize count;
};

struct ParseMemo {
	FunctionNameParseResult* function_names;
	ParseResult<TypeSyntax>* types;
	ParameterParseResult* parameters;
	ParseResult<NameSyntax>* names;
	ParseResult<ArgumentSyntax>* neutral_arguments;
	ParseResult<ArgumentListSyntax>* argument_lists;
	ParseResult<ExpressionTail>* tails;
	ParseResult<ValueSyntax>* results;
	ParseMemo* next;
	ParseFailure failure;
	usize offset;
	usize pending_greater;
	i32 minimum;
	i32 delimiter;
	resolution state;
	parse_memo_kind kind;
};

fn Parser::memo_initialize(Parser& this, Source& source) -> bool {
	if (source.parsing) {
		@this.memo := source.parsing;
		return true;
	};
	if (!source.token_count || source.token_count > ~usize(0) / sizeof(ParseMemo*)) {
		compiler_error(@*this.compiler, this.token(), "source token count exceeds parser storage capacity\0");
		return false;
	};
	ParseMemoStore* store = (ParseMemoStore*)memory_allocate(@*this.compiler, sizeof(ParseMemoStore));
	if (!store) {
		return false;
	};
	@store->buckets = (ParseMemo**)memory_allocate(@*this.compiler, source.token_count * sizeof(ParseMemo*));
	if (!store->buckets) {
		return false;
	};
	@store->tokens := source.tokens;
	@store->count := source.token_count;
	@source.parsing := store;
	@this.memo = (ParseMemoStore*)store;
	return true;
};

fn Parser::memo_begin(Parser& this, parse_memo_kind kind, i32 minimum, i32 delimiter, const char* cycle_message) -> ParseMemo* {
	ParseMemo* memo = @this.memo_record((parse_memo_kind)kind, (i32)minimum, (i32)delimiter);
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		@this.failure := memo->failure;
		return (ParseMemo*)memo;
	};
	if (memo->state == resolution::active) {
		if (cycle_message) {
			@this.error(this.token(), (const char*)cycle_message);
		};
		return nullptr;
	};
	return (ParseMemo*)memo;
};

fn Parser::memo_finish(Parser& this, ParseMemo* memo) {
	@memo->failure := this.failure;
	@memo->state = resolution::ready;
};

fn Parser::memo_record(Parser& this, parse_memo_kind kind, i32 minimum, i32 delimiter) -> ParseMemo* {
	ParseMemoStore* store := this.memo;
	if (!store || store->tokens != this.tokens || this.offset >= store->count) {
		@this.error(this.token(), "source parse cursor has no matching memo owner\0");
		return nullptr;
	};
	ParseMemo* record := store->buckets[this.offset];
	while (record) {
		if (record->kind == kind && record->pending_greater == this.pending_greater && record->minimum == minimum && record->delimiter == delimiter) {
			return (ParseMemo*)record;
		};
		@record := record->next;
	};
	@record = (ParseMemo*)memory_allocate(@*this.compiler, sizeof(ParseMemo));
	if (!record) {
		return nullptr;
	};
	@record->offset := this.offset;
	@record->pending_greater := this.pending_greater;
	@record->minimum = (i32)minimum;
	@record->delimiter = (i32)delimiter;
	@record->kind = (parse_memo_kind)kind;
	@record->next := store->buckets[this.offset];
	@store->buckets[this.offset] = (ParseMemo*)record;
	return (ParseMemo*)store->buckets[this.offset];
};

fn Parser::value_tail_results(Parser& this, i32 minimum, i32 delimiter) -> ParseResult<ExpressionTail>* {
	ParseMemo* record = @this.memo_begin(parse_memo_kind::tail, (i32)minimum, (i32)delimiter, "non-consuming source parse cycle\0");
	if (!record) {
		return nullptr;
	};
	if (record->state == resolution::ready) {
		return (ParseResult<ExpressionTail>*)record->tails;
	};

	@record->state = resolution::active;
	@record->tails = @this.value_tail_parse((i32)record->minimum, (i32)record->delimiter);
	@this.memo_finish((ParseMemo*)record);
	@this.offset := record->offset;
	@this.pending_greater := record->pending_greater;
	return (ParseResult<ExpressionTail>*)record->tails;
};

fn Parser::value_tails_finish(Parser& this, ParseResult<ExpressionTail>* result, ParseFailureArm* failures) -> ParseResult<ExpressionTail>* {
	@this.failure = ParseFailure();
	while (failures && this.compiler->result != compilation_result::failure) {
		ParseResult<ExpressionTail>* sibling := result;
		if (!sibling && (!this.failure.message || failures->failure.offset > this.failure.offset || (failures->failure.offset == this.failure.offset && failures->failure.pending_greater > this.failure.pending_greater))) {
			@this.failure := failures->failure;
		};
		while (sibling && this.compiler->result != compilation_result::failure) {
			ParseFailure* saved = (ParseFailure*)memory_allocate(@*this.compiler, sizeof(ParseFailure));
			ValueSyntax* error = @this.new_value(syntax_kind::source_error, Token(failures->failure.token));
			ExpressionTail* tail = (ExpressionTail*)memory_allocate(@*this.compiler, sizeof(ExpressionTail));
			if (!saved || !error || !tail) {
				return nullptr;
			};
			@*saved := failures->failure;
			@error->data.error = (ParseFailure*)saved;
			@tail->kind = expression_tail_kind::operation;
			@tail->operation = (ValueSyntax*)error;
			parse_result_add<ExpressionTail>(@*this.compiler, &result, (ExpressionTail*)tail, ParseGuard*(failures->guard), sibling->end, &pack_tail);
			@sibling := sibling->next;
		};
		@failures := failures->next;
	};
	return (ParseResult<ExpressionTail>*)result;
};

// Postfix grammar returns operation nodes whose receiver/callee edge is vacant.
// It recursively packs argument/index expressions before returning their cursor.
// Binary grammar reuses the existing precedence table and assignment associativity.
fn Parser::value_tail_parse(Parser& this, i32 minimum, i32 delimiter) -> ParseResult<ExpressionTail>* {
	Token token = this.token();
	ParseResult<ValueSyntax>* operations = nullptr;
	ParseFailureArm* failures = nullptr;
	if (delimiter == (i32)source_delimiter::template_argument && (token.kind == token_kind::op_greater || token.kind == token_kind::op_shift_right)) {
		ParseResult<ExpressionTail>* result = (ParseResult<ExpressionTail>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ExpressionTail>));
		if (result) {
			@result->end = parser_cursor(this);
		};
		return (ParseResult<ExpressionTail>*)result;
	};
	if (token.kind == token_kind::punct_left_paren || token.kind == token_kind::punct_left_bracket || token.kind == token_kind::op_dot || token.kind == token_kind::op_arrow) {
		@operations = @this.value_postfix_operation_results((i32)delimiter);
	}
	else {
		i32 precedence = parser_precedence((token_kind)token.kind);
		if (!precedence || precedence < minimum) {
			ParseResult<ExpressionTail>* result = (ParseResult<ExpressionTail>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ExpressionTail>));
			if (result) {
				@result->end.offset := this.offset;
				@result->end.pending_greater := this.pending_greater;
			};
			return (ParseResult<ExpressionTail>*)result;
		};
		@this.take((token_kind)token.kind);
		i32 right_minimum = precedence + 1;
		if (token.kind == token_kind::op_assign || token.kind == token_kind::op_copy) {
			@right_minimum := precedence;
		};
		ParseResult<ValueSyntax>* right = @this.value_expression_results((i32)right_minimum, (i32)delimiter);
		while (right && this.compiler->result != compilation_result::failure) {
			ValueSyntax* operation = (ValueSyntax*)memory_allocate(@*this.compiler, sizeof(ValueSyntax));
			if (!operation) {
				return nullptr;
			};
			@operation->kind = syntax_kind::expr_binary;
			@operation->token := token;
			@operation->data.binary.operation := token.kind;
			@operation->data.binary.right := right->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &operations, (ValueSyntax*)operation, ParseGuard*(right->guard), right->end, &pack_value);
			@right := right->next;
		};
	};
	ParseResult<ExpressionTail>* results = nullptr;
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	ParseResult<ValueSyntax>* operation := operations;
	while (operation && this.compiler->result != compilation_result::failure) {
		Parser suffix := this;
		@suffix.failure = ParseFailure();
		@suffix.offset := operation->end.offset;
		@suffix.pending_greater := operation->end.pending_greater;
		ParseResult<ExpressionTail>* rest = @suffix.value_tail_results((i32)minimum, (i32)delimiter);
		parse_failure_record(@*this.compiler, &failures, suffix.failure, ParseGuard*(operation->guard));
		while (rest && this.compiler->result != compilation_result::failure) {
			ExpressionTail* tail = (ExpressionTail*)memory_allocate(@*this.compiler, sizeof(ExpressionTail));
			if (!tail) {
				return nullptr;
			};
			@tail->kind = expression_tail_kind::operation;
			@tail->operation := operation->value;
			@tail->next := rest->value;
			ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(operation->guard), ParseGuard*(rest->guard));
			parse_result_add<ExpressionTail>(@*this.compiler, &results, (ExpressionTail*)tail, (ParseGuard*)guard, rest->end, &pack_tail);
			@rest := rest->next;
		};
		@operation := operation->next;
	};
	return @this.value_tails_finish((ParseResult<ExpressionTail>*)results, (ParseFailureArm*)failures);
};

fn Parser::value_expression_parse(Parser& this, i32 minimum, i32 delimiter) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	ParseResult<ValueSyntax>* head = @this.value_head_results((i32)delimiter);
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (head && this.compiler->result != compilation_result::failure) {
		Parser suffix := this;
		@suffix.failure = ParseFailure();
		@suffix.offset := head->end.offset;
		@suffix.pending_greater := head->end.pending_greater;
		ParseResult<ExpressionTail>* tail = @suffix.value_tail_results((i32)minimum, (i32)delimiter);
		parse_failure_record(@*this.compiler, &failures, suffix.failure, ParseGuard*(head->guard));
		while (tail && this.compiler->result != compilation_result::failure) {
			SourceExpression* chain = (SourceExpression*)memory_allocate(@*this.compiler, sizeof(SourceExpression));
			ValueSyntax* expression = (ValueSyntax*)memory_allocate(@*this.compiler, sizeof(ValueSyntax));
			if (!chain || !expression) {
				return nullptr;
			};
			@chain->head := head->value;
			@chain->tail := tail->value;
			@expression->kind = syntax_kind::source_expression_chain;
			@expression->token := head->value->token;
			@expression->data.chain = (SourceExpression*)chain;
			ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(head->guard), ParseGuard*(tail->guard));
			parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)expression, (ParseGuard*)guard, tail->end, &pack_value);
			@tail := tail->next;
		};
		@head := head->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn Parser::value_result_query(Parser& this, parse_memo_kind kind, i32 minimum, i32 delimiter) -> ParseResult<ValueSyntax>* {
	ParseMemo* record = @this.memo_begin((parse_memo_kind)kind, (i32)minimum, (i32)delimiter, "non-consuming source parse cycle\0");
	if (!record) {
		return nullptr;
	};
	if (record->state == resolution::ready) {
		return (ParseResult<ValueSyntax>*)record->results;
	};

	@record->state = resolution::active;
	if (record->kind == parse_memo_kind::arguments) {
		@record->results = @this.value_argument_parse((token_kind)record->minimum, (i32)record->delimiter);
	}
	else {
		@record->results = @this.value_expression_parse((i32)record->minimum, (i32)record->delimiter);
	};
	@this.memo_finish((ParseMemo*)record);
	@this.offset := record->offset;
	@this.pending_greater := record->pending_greater;
	return (ParseResult<ValueSyntax>*)record->results;
};

fn Parser::value_expression_results(Parser& this, i32 minimum, i32 delimiter) -> ParseResult<ValueSyntax>* {
	return @this.value_result_query(parse_memo_kind::expression, (i32)minimum, (i32)delimiter);
};

fn Parser::value_argument_results(Parser& this, token_kind closing, i32 delimiter) -> ParseResult<ValueSyntax>* {
	return @this.value_result_query(parse_memo_kind::arguments, (i32)closing, (i32)delimiter);
};

fn parse_delimiter_matches(const Parser& parser, source_delimiter delimiter) -> bool {
	Token token = parser.token();
	switch (delimiter) {
		case source_delimiter::ordinary:
			return true;
		case source_delimiter::statement:
		case source_delimiter::for_clause:
			return token.kind == token_kind::punct_semicolon;
		case source_delimiter::paren:
			return token.kind == token_kind::punct_right_paren;
		case source_delimiter::index:
			return token.kind == token_kind::punct_right_bracket;
		case source_delimiter::call_argument:
			return token.kind == token_kind::punct_comma || token.kind == token_kind::punct_right_paren;
		case source_delimiter::template_argument:
			return token.kind == token_kind::punct_comma || token.kind == token_kind::op_greater || token.kind == token_kind::op_shift_right;
		case source_delimiter::enum_member:
			return token.kind == token_kind::punct_comma || token.kind == token_kind::punct_semicolon || token.kind == token_kind::punct_right_brace;
		case source_delimiter::case_label:
			return token.kind == token_kind::punct_colon;
	};
	return false;
};

fn Parser::value_until_results(Parser& this, i32 minimum, source_delimiter delimiter) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* candidates = @this.value_expression_results((i32)minimum, (i32)delimiter);
	ParseResult<ValueSyntax>* result = nullptr;
	while (candidates && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.offset := candidates->end.offset;
		@ending.pending_greater := candidates->end.pending_greater;
		if (parse_delimiter_matches(ending, (source_delimiter)delimiter)) {
			parse_result_add<ValueSyntax>(@*this.compiler, &result, ValueSyntax*(candidates->value), ParseGuard*(candidates->guard), candidates->end, &pack_value);
		};
		@candidates := candidates->next;
	};
	return (ParseResult<ValueSyntax>*)result;
};

fn source_choice_select(Compiler& compiler, Scope* scope, const SourceChoice& choice) -> ValueSyntax* {
	SourceArm* arm := choice.first;
	while (arm && compiler.result != compilation_result::failure) {
		if (parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)arm->guard)) {
			return (ValueSyntax*)arm->value;
		};
		@arm := arm->next;
	};
	if (compiler.result != compilation_result::failure) {
		Token token;
		if (choice.first && choice.first->value) {
			@token := choice.first->value->token;
		};
		compiler_error(@compiler, token, "no source interpretation matches the current scope\0");
	};
	return nullptr;
};

fn source_tail_lower(Compiler& compiler, Scope* scope, ExpressionTail* tail, Syntax* left) -> Syntax* {
	while (tail && compiler.result != compilation_result::failure) {
		if (tail->kind == expression_tail_kind::stop) {
			return (Syntax*)left;
		};
		if (tail->kind == expression_tail_kind::choice) {
			TailArm* arm := tail->choices;
			while (arm && !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)arm->guard)) {
				@arm := arm->next;
			};
			if (!arm) {
				compiler_error(@compiler, left->token, "no expression continuation matches the current scope\0");
				return nullptr;
			};
			@tail := arm->tail;
			continue;
		};
		@left = value_lower_operation(@compiler, (Scope*)scope, (ValueSyntax*)tail->operation, (Syntax*)left);
		@tail := tail->next;
	};
	return (Syntax*)left;
};

fn Parser::value_wrap_results(Parser& this, syntax_kind kind, Token token, ParseResult<ValueSyntax>* inputs, TypeSyntax* type) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* results = nullptr;
	while (inputs && this.compiler->result != compilation_result::failure) {
		ValueSyntax* value = @this.new_value((syntax_kind)kind, Token(token));
		if (!value) {
			return nullptr;
		};
		if (kind == syntax_kind::expr_unary) {
			@value->data.binary.operation := token.kind;
			@value->data.binary.left := inputs->value;
		}
		else if (kind == syntax_kind::expr_cast || kind == syntax_kind::expr_typed_apply || kind == syntax_kind::kw_sizeof) {
			@value->data.typed.type := type;
			@value->data.typed.value := inputs->value;
		}
		else {
			@value->data.expression := inputs->value;
		};
		parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)value, ParseGuard*(inputs->guard), inputs->end, &pack_value);
		@inputs := inputs->next;
	};
	return (ParseResult<ValueSyntax>*)results;
};

fn Parser::value_type_application_results(Parser& this, Token token) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	ParseResult<TypeSyntax>* types = @this.type_results();
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (types && this.compiler->result != compilation_result::failure) {
		Parser candidate := this;
		@candidate.failure = ParseFailure();
		@candidate.offset := types->end.offset;
		@candidate.pending_greater := types->end.pending_greater;
		@candidate.require(token_kind::punct_left_paren, "expected '(' after construction type\0");
		if (!candidate.failed()) {
			ParseResult<ValueSyntax>* arguments = @candidate.value_argument_results(token_kind::punct_right_paren, (i32)source_delimiter::call_argument);
			ParseResult<ValueSyntax>* applications = @candidate.value_wrap_results(syntax_kind::expr_typed_apply, Token(token), (ParseResult<ValueSyntax>*)arguments, (TypeSyntax*)types->value);
			@applications = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)applications, (ParseGuard*)types->guard);
			parse_results_merge(@*this.compiler, &results, (ParseResult<ValueSyntax>*)applications);
		};
		parse_failure_record(@*this.compiler, &failures, candidate.failure, (ParseGuard*)types->guard);
		@types := types->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::value_parenthesized_results(Parser& this, Token token) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	@this.take(token_kind::punct_left_paren);
	ParseResult<ValueSyntax>* inside = @this.value_expression_results(1, 0);
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (inside && this.compiler->result != compilation_result::failure) {
		Parser closing := this;
		@closing.failure = ParseFailure();
		@closing.offset := inside->end.offset;
		@closing.pending_greater := inside->end.pending_greater;
		@closing.require(token_kind::punct_right_paren, "expected ')' after expression\0");
		parse_failure_record(@*this.compiler, &failures, closing.failure, ParseGuard*(inside->guard));
		if (!closing.failed()) {
			parse_result_add<ValueSyntax>(@*this.compiler, &result, ValueSyntax*(inside->value), ParseGuard*(inside->guard), parser_cursor(closing), &pack_value);
		};
		@inside := inside->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn Parser::value_sizeof_results(Parser& this, Token token) -> ParseResult<ValueSyntax>* {
	@this.require(token_kind::punct_left_paren, "expected '(' after sizeof\0");
	if (this.failed()) {
		return nullptr;
	};
	ParseCursor begin = parser_cursor(this);
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	ParseGuard* expression_guard = nullptr;
	Parser typed := this;
	ParseResult<TypeSyntax>* types = @typed.type_results();
	while (types && this.compiler->result != compilation_result::failure) {
		ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)types->guard, parse_decision(@*this.compiler, (TypeSyntax*)types->value, nullptr, begin, 1));
		@expression_guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)expression_guard, parse_guard_not(@*this.compiler, (ParseGuard*)guard));
		Parser candidate := this;
		@candidate.failure = ParseFailure();
		@candidate.offset := types->end.offset;
		@candidate.pending_greater := types->end.pending_greater;
		@candidate.require(token_kind::punct_right_paren, "expected ')' after sizeof type\0");
		parse_failure_record(@*this.compiler, &failures, candidate.failure, (ParseGuard*)guard);
		if (!candidate.failed()) {
			ValueSyntax* value = @this.new_value(syntax_kind::kw_sizeof, Token(token));
			if (!value) {
				return nullptr;
			};
			@value->data.typed.type := types->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)value, (ParseGuard*)guard, parser_cursor(candidate), &pack_value);
		};
		@types := types->next;
	};
	ParseResult<ValueSyntax>* operands = @this.value_until_results(1, source_delimiter::paren);
	parse_failure_record(@*this.compiler, &failures, this.failure, (ParseGuard*)expression_guard);
	while (operands && this.compiler->result != compilation_result::failure) {
		Parser candidate := this;
		@candidate.failure = ParseFailure();
		@candidate.offset := operands->end.offset;
		@candidate.pending_greater := operands->end.pending_greater;
		@candidate.require(token_kind::punct_right_paren, "expected ')' after sizeof operand\0");
		ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)operands->guard, (ParseGuard*)expression_guard);
		parse_failure_record(@*this.compiler, &failures, candidate.failure, (ParseGuard*)guard);
		if (!candidate.failed()) {
			ValueSyntax* value = @this.new_value(syntax_kind::kw_sizeof, Token(token));
			if (!value) {
				return nullptr;
			};
			@value->data.typed.value := operands->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)value, (ParseGuard*)guard, parser_cursor(candidate), &pack_value);
		};
		@operands := operands->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::value_head_results(Parser& this, i32 delimiter) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	ParseCursor begin = parser_cursor(this);
	if (@this.take(token_kind::kw_new)) {
		return @this.value_wrap_results(syntax_kind::kw_new, Token(token), @this.value_type_application_results(Token(token)), nullptr);
	};
	if (@this.take(token_kind::kw_sizeof)) {
		return @this.value_sizeof_results(Token(token));
	};
	if (@this.take(token_kind::kw_discard)) {
		return @this.value_wrap_results(syntax_kind::kw_discard, Token(token), @this.value_name_results(), nullptr);
	};
	if (@this.take(token_kind::kw_delete) || @this.take(token_kind::op_access) || @this.take(token_kind::op_relocate) || @this.take(token_kind::op_plus) || @this.take(token_kind::op_minus) || @this.take(token_kind::op_bang) || @this.take(token_kind::op_tilde) || @this.take(token_kind::op_star) || @this.take(token_kind::op_ampersand)) {
		syntax_kind kind = syntax_kind::expr_unary;
		if (token.kind == token_kind::kw_delete) {
			@kind = syntax_kind::kw_delete;
			if (@this.take(token_kind::kw_discard)) {
				@kind = syntax_kind::expr_delete_discard;
			};
		}
		else if (token.kind == token_kind::op_access) {
			@kind = syntax_kind::expr_access;
		}
		else if (token.kind == token_kind::op_relocate) {
			@kind = syntax_kind::expr_relocate;
		};
		return @this.value_wrap_results((syntax_kind)kind, Token(token), @this.value_expression_results(12, (i32)delimiter), nullptr);
	};
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	ParseGuard* ordinary_guard = nullptr;
	if ((token.kind == token_kind::identifier || token.kind == token_kind::kw_const || token.kind == token_kind::punct_left_paren) && !(token.kind == token_kind::punct_left_paren && @this.signature_arrow((usize)begin.offset))) {
		Parser typed := this;
		ParseResult<TypeSyntax>* types = @typed.type_results();
		while (types && this.compiler->result != compilation_result::failure) {
			Parser application := this;
			@application.failure = ParseFailure();
			@application.offset := types->end.offset;
			@application.pending_greater := types->end.pending_greater;
			if (types->end.offset > begin.offset + 1 && application.at(token_kind::punct_left_paren) && !(token.kind == token_kind::punct_left_paren && this.tokens[types->end.offset - 1].kind == token_kind::punct_right_paren)) {
				ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)types->guard, parse_decision(@*this.compiler, (TypeSyntax*)types->value, nullptr, begin, 1));
				@ordinary_guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)ordinary_guard, parse_guard_not(@*this.compiler, (ParseGuard*)guard));
				@application.take(token_kind::punct_left_paren);
				ParseResult<ValueSyntax>* arguments = @application.value_argument_results(token_kind::punct_right_paren, (i32)source_delimiter::call_argument);
				ParseResult<ValueSyntax>* applications = @application.value_wrap_results(syntax_kind::expr_typed_apply, Token(token), (ParseResult<ValueSyntax>*)arguments, (TypeSyntax*)types->value);
				@applications = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)applications, (ParseGuard*)guard);
				parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)applications);
				parse_failure_record(@*this.compiler, &failures, application.failure, (ParseGuard*)guard);
			};
			@types := types->next;
		};
	};
	if (token.kind == token_kind::punct_left_paren) {
		Parser prefix := this;
		@prefix.take(token_kind::punct_left_paren);
		ParseResult<TypeSyntax>* types = @prefix.type_results();
		ParseGuard* group_guard := ordinary_guard;
		while (types && this.compiler->result != compilation_result::failure) {
			Parser cast := this;
			@cast.failure = ParseFailure();
			@cast.offset := types->end.offset;
			@cast.pending_greater := types->end.pending_greater;
			if (@cast.take(token_kind::punct_right_paren)) {
				ParseGuard* role = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)types->guard, parse_decision(@*this.compiler, (TypeSyntax*)types->value, nullptr, begin, 1));
				@group_guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)group_guard, parse_guard_not(@*this.compiler, (ParseGuard*)role));
				ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)ordinary_guard, (ParseGuard*)role);
				ParseResult<ValueSyntax>* operand = @cast.value_expression_results(12, (i32)delimiter);
				ParseResult<ValueSyntax>* casts = @cast.value_wrap_results(syntax_kind::expr_cast, Token(token), (ParseResult<ValueSyntax>*)operand, (TypeSyntax*)types->value);
				@casts = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)casts, (ParseGuard*)guard);
				parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)casts);
				parse_failure_record(@*this.compiler, &failures, cast.failure, (ParseGuard*)guard);
			};
			@types := types->next;
		};
		ParseResult<ValueSyntax>* grouped = @this.value_parenthesized_results(Token(token));
		parse_failure_record(@*this.compiler, &failures, this.failure, (ParseGuard*)group_guard);
		@grouped = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)grouped, (ParseGuard*)group_guard);
		parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)grouped);
		return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
	};
	ParseResult<ValueSyntax>* ordinary = nullptr;
	if (token.kind == token_kind::identifier) {
		@ordinary = @this.value_name_results();
	}
	else if (@this.take(token_kind::literal_number)) {
		@ordinary = @this.value_single_result(@this.new_value(syntax_kind::literal_number, Token(token)));
	}
	else if (@this.take(token_kind::literal_string)) {
		@ordinary = @this.value_single_result(@this.new_value(syntax_kind::literal_string, Token(token)));
	}
	else if (@this.take(token_kind::kw_nullptr)) {
		@ordinary = @this.value_single_result(@this.new_value(syntax_kind::kw_nullptr, Token(token)));
	}
	else if (token.kind == token_kind::punct_left_brace) {
		@ordinary = @this.source_block_results();
	}
	else if (!result) {
		@this.error(Token(token), "expected expression\0");
	};
	parse_failure_record(@*this.compiler, &failures, this.failure, (ParseGuard*)ordinary_guard);
	@ordinary = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)ordinary, (ParseGuard*)ordinary_guard);
	parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)ordinary);
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn parse_choice_name(Compiler& compiler, Scope* scope, NameSyntax* name, i32 application) -> Entity* {
	@name = name_source_select(@compiler, (Scope*)scope, (NameSyntax*)name);
	if (!name) {
		return nullptr;
	};
	Entity* entity = nullptr;
	if (!name->qualifier) {
		@entity = scope_lookup((Scope*)scope, name->token);
	}
	else {
		Entity* owner = parse_choice_name(@compiler, (Scope*)scope, (NameSyntax*)name->qualifier, 1);
		if (!owner) {
			return nullptr;
		};
		Scope* members = entity_members((Entity*)owner);
		if (!members) {
			return nullptr;
		};
		@entity = associated_lookup(@compiler, (Entity*)members->owner, name->token);
	};
	if (application && entity && name->arguments && entity->kind == entity_kind::kw_template) {
		return name_resolve(@compiler, (Scope*)scope, (NameSyntax*)name);
	};
	return (Entity*)entity;
};

fn parse_type_matches(Compiler& compiler, Scope* scope, TypeSyntax* type) -> i32 {
	if (!type) {
		return 1;
	};
	while (type) {
		@type = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)type);
		if (!type) {
			return 0;
		};
		switch (type->kind) {
			case type_syntax_kind::qualified:
			case type_syntax_kind::pointer:
			case type_syntax_kind::reference:
				@type := type->data.element;
				continue;
			case type_syntax_kind::array:
				@type := type->data.array.element;
				continue;
			case type_syntax_kind::function: {
				ParameterSyntax* parameter := type->data.signature.parameters;
				while (parameter) {
					if (!parse_type_matches(@compiler, (Scope*)scope, (TypeSyntax*)parameter->type)) {
						return 0;
					};
					@parameter := parameter->next;
				};
				return parse_type_matches(@compiler, (Scope*)scope, (TypeSyntax*)type->data.signature.result);
			};
			case type_syntax_kind::name: {
				Entity* entity = parse_choice_name(@compiler, (Scope*)scope, (NameSyntax*)type->data.name, 0);
				return entity && (entity->kind == entity_kind::primitive || entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union || entity->kind == entity_kind::kw_enum || (entity->kind == entity_kind::kw_template && entity->data.template_pattern.declaration_kind != token_kind::kw_fn));
			};
		};
	};
	return 0;
};

fn parse_choice_matches(Compiler& compiler, Scope* scope, const ParseChoice& choice) -> i32 {
	if (choice.kind == parse_choice_kind::template_name) {
		NameSyntax name := *choice.name;
		@name.arguments = nullptr;
		Entity* entity = parse_choice_name(@compiler, (Scope*)scope, &name, 0);
		return entity && (entity->kind == entity_kind::kw_template || entity->template_origin);
	};
	return parse_type_matches(@compiler, (Scope*)scope, (TypeSyntax*)choice.type);
};

fn value_lower_operation(Compiler& compiler, Scope* scope, ValueSyntax* operation, Syntax* left) -> Syntax* {
	if (operation->kind == syntax_kind::source_error) {
		compiler_error(@compiler, operation->data.error->token, (const char*)operation->data.error->message);
		return nullptr;
	};
	if (operation->kind == syntax_kind::source_choice) {
		ValueSyntax* selected = source_choice_select(@compiler, (Scope*)scope, *operation->data.choice);
		if (!selected) {
			return nullptr;
		};
		return value_lower_operation(@compiler, (Scope*)scope, (ValueSyntax*)selected, (Syntax*)left);
	};
	Syntax* result = syntax_create(@compiler, (syntax_kind)operation->kind, Token(operation->token));
	if (!result) {
		return nullptr;
	};
	switch (operation->kind) {
		case syntax_kind::expr_binary:
		case syntax_kind::expr_index:
			@result->data.binary.left = (Syntax*)left;
			@result->data.binary.right = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)operation->data.binary.right);
			@result->data.binary.operation := operation->data.binary.operation;
			break;
		case syntax_kind::expr_call:
			@result->data.call.callable = (Syntax*)left;
			@result->data.call.arguments = value_lower_list(@compiler, (Scope*)scope, (ValueSyntax*)operation->data.call.arguments);
			break;
		case syntax_kind::expr_member:
			@result->data.member.object = (Syntax*)left;
			@result->data.member.name := operation->data.member.name->token;
			@result->data.member.qualifier = name_lower(@compiler, (Scope*)scope, (NameSyntax*)operation->data.member.name->qualifier);
			break;
		case syntax_kind::expr_destroy:
			if (operation->token.kind == token_kind::op_arrow) {
				Syntax* object = syntax_create(@compiler, syntax_kind::expr_unary, Token(operation->token));
				if (!object) {
					return nullptr;
				};
				@object->data.unary.operation = token_kind::op_star;
				@object->data.unary.value = (Syntax*)left;
				@left = (Syntax*)object;
			};
			@result->data.cast.type := operation->data.typed.type;
			@result->data.cast.value = (Syntax*)left;
			break;
	};
	return (Syntax*)result;
};

// type_resolve/type_use_resolve select source choices before using source fields.
// All direct source signature metadata readers must select the source type first.

struct TypeChoice {
	TypeSyntax* type;
	ParseGuard* guard;
	TypeChoice* next;
};

struct ParameterParseResult {
	ParameterSyntax* parameters;
	ParseGuard* guard;
	ParseCursor end;
	ParameterParseResult* next;
	parameter_arity arity;
};

fn type_source_select(Compiler& compiler, Scope* scope, TypeSyntax* type) -> TypeSyntax* {
	while (type && type->kind == type_syntax_kind::choice && compiler.result != compilation_result::failure) {
		TypeChoice* choice := type->data.choices;
		while (choice && !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)choice->guard)) {
			@choice := choice->next;
		};
		if (!choice) {
			compiler_error(@compiler, type->token, "no type interpretation matches the current scope\0");
			return nullptr;
		};
		@type := choice->type;
	};
	return (TypeSyntax*)type;
};

fn type_guarded(Compiler& compiler, TypeSyntax* type, ParseGuard* guard) -> TypeSyntax* {
	if (!type || !guard) {
		return (TypeSyntax*)type;
	};
	TypeChoice* choice = (TypeChoice*)memory_allocate(@compiler, sizeof(TypeChoice));
	TypeSyntax* result = (TypeSyntax*)memory_allocate(@compiler, sizeof(TypeSyntax));
	if (!choice || !result) {
		return nullptr;
	};
	@choice->type := type;
	@choice->guard = (ParseGuard*)guard;
	@result->kind = type_syntax_kind::choice;
	@result->token := type->token;
	@result->data.choices = (TypeChoice*)choice;
	return (TypeSyntax*)result;
};

fn type_signature_has_result(TypeSyntax* type) -> i32 {
	if (!type) {
		return false;
	};
	if (type->kind == type_syntax_kind::choice) {
		TypeChoice* choice := type->data.choices;
		while (choice) {
			if (type_signature_has_result(TypeSyntax*(choice->type))) {
				return true;
			};
			@choice := choice->next;
		};
		return false;
	};
	return type->kind == type_syntax_kind::function && type->data.signature.result != nullptr;
};

fn parameter_results_add(Compiler& compiler, ParameterParseResult** results, ParameterSyntax* parameters, parameter_arity arity, ParseGuard* guard, const ParseCursor& end) {
	ParameterParseResult* result = (ParameterParseResult*)memory_allocate(@compiler, sizeof(ParameterParseResult));
	if (!result) {
		return;
	};
	@result->parameters = (ParameterSyntax*)parameters;
	@result->arity = (parameter_arity)arity;
	@result->guard = (ParseGuard*)guard;
	@result->end := end;
	@result->next := *results;
	@*results = (ParameterParseResult*)result;
};

fn parser_failure_merge(Parser& parser, const ParseFailure& failure) {
	if (failure.message && (!parser.failure.message || failure.offset > parser.failure.offset || (failure.offset == parser.failure.offset && failure.pending_greater > parser.failure.pending_greater))) {
		@parser.failure := failure;
	};
};

fn Parser::parameter_results(Parser& this) -> ParameterParseResult* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::signature_parameters, 0, 0, nullptr);
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParameterParseResult*)memo->parameters;
	};

	@memo->state = resolution::active;
	ParameterParseResult* results = nullptr;
	Parser ending := this;
	if (@ending.take(token_kind::punct_right_paren)) {
		parameter_results_add(@*this.compiler, &results, nullptr, parameter_arity::fixed, nullptr, parser_cursor(ending));
	}
	else if (@ending.take(token_kind::punct_ellipsis)) {
		@ending.require(token_kind::punct_right_paren, "expected ')' after variadic signature\0");
		if (!ending.failed()) {
			parameter_results_add(@*this.compiler, &results, nullptr, parameter_arity::variadic, nullptr, parser_cursor(ending));
		};
	}
	else {
		ParseResult<TypeSyntax>* types = @ending.type_results();
		while (types && this.compiler->result != compilation_result::failure) {
			Parser candidate := this;
			@candidate.failure = ParseFailure();
			@candidate.offset := types->end.offset;
			@candidate.pending_greater := types->end.pending_greater;
			Token name;
			if (candidate.at(token_kind::identifier)) {
				@name = @candidate.require(token_kind::identifier, "expected parameter name\0");
			};
			ParameterParseResult* rest = nullptr;
			if (@candidate.take(token_kind::punct_comma)) {
				@rest = @candidate.parameter_results();
			}
			else {
				@candidate.require(token_kind::punct_right_paren, "expected ')' after signature\0");
				if (!candidate.failed()) {
					parameter_results_add(@*this.compiler, &rest, nullptr, parameter_arity::fixed, nullptr, parser_cursor(candidate));
				};
			};
			parser_failure_merge(@ending, candidate.failure);
			while (rest && this.compiler->result != compilation_result::failure) {
				ParameterSyntax* parameter = (ParameterSyntax*)memory_allocate(@*this.compiler, sizeof(ParameterSyntax));
				if (!parameter) {
					return nullptr;
				};
				@parameter->type := types->value;
				@parameter->name := name;
				@parameter->next := rest->parameters;
				parameter_results_add(@*this.compiler, &results, (ParameterSyntax*)parameter, (parameter_arity)rest->arity, parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(types->guard), ParseGuard*(rest->guard)), rest->end);
				@rest := rest->next;
			};
			@types := types->next;
		};
	};
	if (results) {
		@this.failure = ParseFailure();
	}
	else {
		parser_failure_merge(@this, ending.failure);
	};
	@memo->parameters := results;
	@this.memo_finish((ParseMemo*)memo);
	return (ParameterParseResult*)results;
};

fn Parser::signature_results(Parser& this, Token token) -> ParseResult<TypeSyntax>* {
	Parser opening := this;
	@opening.require(token_kind::punct_left_paren, "expected '(' in signature\0");
	if (opening.failed()) {
		parser_failure_merge(@this, opening.failure);
		return nullptr;
	};
	ParameterParseResult* parameters = @opening.parameter_results();
	ParseResult<TypeSyntax>* results = nullptr;
	while (parameters && this.compiler->result != compilation_result::failure) {
		Parser candidate := this;
		@candidate.failure = ParseFailure();
		@candidate.offset := parameters->end.offset;
		@candidate.pending_greater := parameters->end.pending_greater;
		ParseResult<TypeSyntax>* returns = nullptr;
		if (@candidate.take(token_kind::op_arrow)) {
			@returns = @candidate.type_results();
		}
		else {
			parse_result_add<TypeSyntax>(@*this.compiler, &returns, nullptr, nullptr, parser_cursor(candidate), &pack_type);
		};
		parser_failure_merge(@opening, candidate.failure);
		while (returns && this.compiler->result != compilation_result::failure) {
			TypeSyntax* signature = @this.new_type(type_syntax_kind::function, Token(token));
			if (!signature) {
				return nullptr;
			};
			@signature->data.signature.parameters := parameters->parameters;
			@signature->data.signature.arity := parameters->arity;
			@signature->data.signature.result := returns->value;
			parse_result_add<TypeSyntax>(@*this.compiler, &results, (TypeSyntax*)signature, parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(parameters->guard), ParseGuard*(returns->guard)), returns->end, &pack_type);
			@returns := returns->next;
		};
		@parameters := parameters->next;
	};
	if (results) {
		@this.failure = ParseFailure();
	}
	else {
		parser_failure_merge(@this, opening.failure);
	};
	return (ParseResult<TypeSyntax>*)results;
};

fn Parser::type_suffix_results(Parser& this, TypeSyntax* type, ParseGuard* guard, ParseResult<TypeSyntax>** results) {
	while (!this.failed()) {
		Token token = this.token();
		if (@this.take(token_kind::op_star) || @this.take(token_kind::op_ampersand)) {
			type_syntax_kind kind = type_syntax_kind::pointer;
			if (token.kind == token_kind::op_ampersand) {
				@kind = type_syntax_kind::reference;
			};
			TypeSyntax* modified = @this.new_type((type_syntax_kind)kind, Token(token));
			if (!modified) {
				return;
			};
			@modified->data.element := type;
			@type = (TypeSyntax*)modified;
			continue;
		};
		if (@this.take(token_kind::punct_left_bracket)) {
			TypeSyntax* modified = @this.new_type(type_syntax_kind::array, Token(token));
			if (!modified) {
				return;
			};
			@modified->data.array.element := type;
			@modified->data.array.count = this.token();
			if (!@this.take(token_kind::literal_number) && !@this.take(token_kind::identifier)) {
				@this.error(modified->data.array.count, "array requires an explicit constant length\0");
				return;
			};
			@this.require(token_kind::punct_right_bracket, "expected ']' after array length\0");
			@type = (TypeSyntax*)modified;
			continue;
		};
		parse_result_add<TypeSyntax>(@*this.compiler, (ParseResult<TypeSyntax>**)results, (TypeSyntax*)type, (ParseGuard*)guard, parser_cursor(this), &pack_type);
		return;
	};
};

fn Parser::type_results(Parser& this) -> ParseResult<TypeSyntax>* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::type, 0, 0, nullptr);
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParseResult<TypeSyntax>*)memo->types;
	};

	@memo->state = resolution::active;
	Parser prefix := this;
	Token token = prefix.token();
	i32 constant = @prefix.take(token_kind::kw_const);
	ParseResult<TypeSyntax>* heads = nullptr;
	ParseResult<TypeSyntax>* results = nullptr;
	if (prefix.at(token_kind::punct_left_paren)) {
		Parser grouped := prefix;
		@grouped.take(token_kind::punct_left_paren);
		ParseResult<TypeSyntax>* inner = @grouped.type_results();
		while (inner && this.compiler->result != compilation_result::failure) {
			Parser ending := prefix;
			@ending.failure = ParseFailure();
			@ending.offset := inner->end.offset;
			@ending.pending_greater := inner->end.pending_greater;
			@ending.require(token_kind::punct_right_paren, "expected ')' after grouped type\0");
			if (!ending.failed() && !ending.at(token_kind::op_arrow)) {
				parse_result_add<TypeSyntax>(@*this.compiler, &heads, TypeSyntax*(inner->value), ParseGuard*(inner->guard), parser_cursor(ending), &pack_type);
			};
			parser_failure_merge(@grouped, ending.failure);
			@inner := inner->next;
		};
		Parser callable := prefix;
		@callable.failure = ParseFailure();
		ParseResult<TypeSyntax>* signatures = @callable.signature_results(Token(token));
		while (signatures && this.compiler->result != compilation_result::failure) {
			// A bare function type has an arrow. Preserve the old early return:
			// a leading const does not qualify this ungrouped signature.
			TypeSyntax* signature := signatures->value;
			if (type_signature_has_result(TypeSyntax*(signature))) {
				parse_result_add<TypeSyntax>(@*this.compiler, &results, (TypeSyntax*)signature, ParseGuard*(signatures->guard), signatures->end, &pack_type);
			};
			@signatures := signatures->next;
		};
		parser_failure_merge(@prefix, grouped.failure);
		parser_failure_merge(@prefix, callable.failure);
	}
	else if (prefix.at(token_kind::identifier)) {
		ParseResult<NameSyntax>* names = @prefix.source_name_results();
		while (names && this.compiler->result != compilation_result::failure) {
			TypeSyntax* type = @this.new_type(type_syntax_kind::name, Token(token));
			if (!type) {
				return nullptr;
			};
			@type->data.name := names->value;
			parse_result_add<TypeSyntax>(@*this.compiler, &heads, (TypeSyntax*)type, ParseGuard*(names->guard), names->end, &pack_type);
			@names := names->next;
		};
	}
	else {
		@prefix.error(Token(token), "expected type\0");
	};
	while (heads && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := heads->end.offset;
		@ending.pending_greater := heads->end.pending_greater;
		TypeSyntax* type := heads->value;
		if (constant) {
			TypeSyntax* qualified = @this.new_type(type_syntax_kind::qualified, Token(token));
			if (!qualified) {
				return nullptr;
			};
			@qualified->data.element := type;
			@type = (TypeSyntax*)qualified;
		};
		@ending.type_suffix_results((TypeSyntax*)type, ParseGuard*(heads->guard), &results);
		parser_failure_merge(@prefix, ending.failure);
		@heads := heads->next;
	};
	if (results) {
		@this.failure = ParseFailure();
	}
	else {
		parser_failure_merge(@this, prefix.failure);
	};
	@memo->types := results;
	@this.memo_finish((ParseMemo*)memo);
	return (ParseResult<TypeSyntax>*)results;
};

struct NameChoice {
	NameSyntax* name;
	ParseGuard* guard;
	NameChoice* next;
};

struct ArgumentListArm {
	ArgumentListSyntax* arguments;
	ParseGuard* guard;
	ArgumentListArm* next;
};

fn neutral_argument_add(Compiler& compiler, ParseResult<ArgumentSyntax>** results, TypeSyntax* type, ValueSyntax* value, ParseGuard* guard, const ParseCursor& end) {
	ParseResult<ArgumentSyntax>* existing = parse_result_find<ArgumentSyntax>((ParseResult<ArgumentSyntax>*)*results, end);
	if (!existing) {
		ArgumentSyntax* argument = (ArgumentSyntax*)memory_allocate(@compiler, sizeof(ArgumentSyntax));
		if (!argument) {
			return;
		};
		@existing = parse_result_push<ArgumentSyntax>(@compiler, (ParseResult<ArgumentSyntax>**)results, (ArgumentSyntax*)argument, (ParseGuard*)guard, end);
		if (!existing) {
			return;
		};
	}
	else {
		@existing->guard = parse_guard(@compiler, parse_guard_kind::disjunction, ParseGuard*(existing->guard), ParseGuard*(guard));
	};
	if (type) {
		@existing->value->type = (TypeSyntax*)type;
		@existing->value->type_guard = (ParseGuard*)guard;
		return;
	};
	@existing->value->value = (ValueSyntax*)value;
	@existing->value->value_guard = (ParseGuard*)guard;
};

fn Parser::source_argument_results(Parser& this) -> ParseResult<ArgumentSyntax>* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::neutral_argument, 0, (i32)source_delimiter::template_argument, "non-consuming template argument parse cycle\0");
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParseResult<ArgumentSyntax>*)memo->neutral_arguments;
	};

	@memo->state = resolution::active;
	ParseResult<ArgumentSyntax>* result = nullptr;
	ParseResult<TypeSyntax>* types = @this.type_results();
	ParseFailure type_failure := this.failure;
	while (types && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.offset := types->end.offset;
		@ending.pending_greater := types->end.pending_greater;
		if (ending.at(token_kind::punct_comma) || ending.at(token_kind::op_greater) || ending.at(token_kind::op_shift_right)) {
			neutral_argument_add(@*this.compiler, &result, TypeSyntax*(types->value), nullptr, (ParseGuard*)types->guard, types->end);
		};
		@types := types->next;
	};
	@this.failure = ParseFailure();
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	ParseResult<ValueSyntax>* values = @this.value_until_results(1, source_delimiter::template_argument);
	while (values && this.compiler->result != compilation_result::failure) {
		neutral_argument_add(@*this.compiler, &result, nullptr, ValueSyntax*(values->value), ParseGuard*(values->guard), values->end);
		@values := values->next;
	};
	if (result) {
		@this.failure = ParseFailure();
	}
	else if (type_failure.message && (!this.failure.message || type_failure.offset > this.failure.offset || (type_failure.offset == this.failure.offset && type_failure.pending_greater > this.failure.pending_greater))) {
		@this.failure := type_failure;
	};
	@memo->neutral_arguments = (ParseResult<ArgumentSyntax>*)result;
	@this.memo_finish((ParseMemo*)memo);
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	return (ParseResult<ArgumentSyntax>*)memo->neutral_arguments;
};

fn Parser::source_argument_sequence_results(Parser& this) -> ParseResult<ArgumentListSyntax>* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::argument_sequence, 0, (i32)source_delimiter::template_argument, "non-consuming template argument list cycle\0");
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParseResult<ArgumentListSyntax>*)memo->argument_lists;
	};

	@memo->state = resolution::active;
	ParseResult<ArgumentListSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	if (this.at(token_kind::op_greater) || this.at(token_kind::op_shift_right)) {
		@this.template_close();
		ArgumentListSyntax* empty = (ArgumentListSyntax*)memory_allocate(@*this.compiler, sizeof(ArgumentListSyntax));
		if (empty && !this.failed()) {
			parse_result_add<ArgumentListSyntax>(@*this.compiler, &result, (ArgumentListSyntax*)empty, nullptr, parser_cursor(this), &pack_arguments);
		};
	}
	else {
		ParseResult<ArgumentSyntax>* first = @this.source_argument_results();
		parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
		while (first && this.compiler->result != compilation_result::failure) {
			Parser ending := this;
			@ending.failure = ParseFailure();
			@ending.offset := first->end.offset;
			@ending.pending_greater := first->end.pending_greater;
			ParseResult<ArgumentListSyntax>* rest = nullptr;
			if (@ending.take(token_kind::punct_comma)) {
				@rest = @ending.source_argument_sequence_results();
			}
			else if (ending.at(token_kind::op_greater) || ending.at(token_kind::op_shift_right)) {
				@ending.template_close();
				ArgumentListSyntax* empty = (ArgumentListSyntax*)memory_allocate(@*this.compiler, sizeof(ArgumentListSyntax));
				if (empty) {
					parse_result_add<ArgumentListSyntax>(@*this.compiler, &rest, (ArgumentListSyntax*)empty, nullptr, parser_cursor(ending), &pack_arguments);
				};
			}
			else {
				@ending.error(ending.token(), "expected ',' or '>' after template argument\0");
			};
			parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(first->guard));
			while (rest && this.compiler->result != compilation_result::failure) {
				ArgumentListSyntax* cons = (ArgumentListSyntax*)memory_allocate(@*this.compiler, sizeof(ArgumentListSyntax));
				if (!cons) {
					return nullptr;
				};
				@cons->first := first->value;
				@cons->rest := rest->value;
				ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(first->guard), ParseGuard*(rest->guard));
				parse_result_add<ArgumentListSyntax>(@*this.compiler, &result, (ArgumentListSyntax*)cons, (ParseGuard*)guard, rest->end, &pack_arguments);
				@rest := rest->next;
			};
			@first := first->next;
		};
	};
	@this.failure = ParseFailure();
	while (failures && this.compiler->result != compilation_result::failure) {
		ParseResult<ArgumentListSyntax>* sibling := result;
		if (!sibling && (!this.failure.message || failures->failure.offset > this.failure.offset)) {
			@this.failure := failures->failure;
		};
		while (sibling && this.compiler->result != compilation_result::failure) {
			ArgumentListSyntax* error = (ArgumentListSyntax*)memory_allocate(@*this.compiler, sizeof(ArgumentListSyntax));
			ParseFailure* saved = (ParseFailure*)memory_allocate(@*this.compiler, sizeof(ParseFailure));
			if (!error || !saved) {
				return nullptr;
			};
			@*saved := failures->failure;
			@error->error = (ParseFailure*)saved;
			parse_result_add<ArgumentListSyntax>(@*this.compiler, &result, (ArgumentListSyntax*)error, ParseGuard*(failures->guard), sibling->end, &pack_arguments);
			@sibling := sibling->next;
		};
		@failures := failures->next;
	};
	@memo->argument_lists = (ParseResult<ArgumentListSyntax>*)result;
	@this.memo_finish((ParseMemo*)memo);
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	return (ParseResult<ArgumentListSyntax>*)memo->argument_lists;
};

fn Parser::source_argument_list_results(Parser& this) -> ParseResult<ArgumentListSyntax>* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::argument_list, 0, (i32)source_delimiter::template_argument, "non-consuming template argument opener cycle\0");
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParseResult<ArgumentListSyntax>*)memo->argument_lists;
	};

	@memo->state = resolution::active;
	@this.require(token_kind::op_less, "expected '<' before template arguments\0");
	if (!this.failed()) {
		@memo->argument_lists = @this.source_argument_sequence_results();
	};
	@this.memo_finish((ParseMemo*)memo);
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	return (ParseResult<ArgumentListSyntax>*)memo->argument_lists;
};

fn Parser::source_name_continue(Parser& this, NameSyntax* name, ParseGuard* guard, ParseResult<NameSyntax>** results) {
	if (this.at(token_kind::op_scope) && this.offset + 1 < this.count && this.tokens[this.offset + 1].kind == token_kind::op_tilde) {
		parse_result_add<NameSyntax>(@*this.compiler, (ParseResult<NameSyntax>**)results, (NameSyntax*)name, (ParseGuard*)guard, parser_cursor(this), &pack_name);
		return;
	};
	if (@this.take(token_kind::op_scope)) {
		@this.source_name_part_results((NameSyntax*)name, (ParseGuard*)guard, (ParseResult<NameSyntax>**)results);
		return;
	};
	parse_result_add<NameSyntax>(@*this.compiler, (ParseResult<NameSyntax>**)results, (NameSyntax*)name, (ParseGuard*)guard, parser_cursor(this), &pack_name);
};

fn Parser::source_name_part_results(Parser& this, NameSyntax* qualifier, ParseGuard* guard, ParseResult<NameSyntax>** results) {
	NameSyntax* part = (NameSyntax*)memory_allocate(@*this.compiler, sizeof(NameSyntax));
	if (!part) {
		return;
	};
	@part->token = @this.require(token_kind::identifier, "expected identifier in type name\0");
	@part->qualifier = (NameSyntax*)qualifier;
	if (this.failed()) {
		return;
	};
	Parser plain := this;
	if (!this.at(token_kind::op_less)) {
		@plain.source_name_continue((NameSyntax*)part, (ParseGuard*)guard, (ParseResult<NameSyntax>**)results);
		@this.failure := plain.failure;
		return;
	};
	ParseGuard* application = parse_decision(@*this.compiler, nullptr, (NameSyntax*)part, parser_cursor(this), 1);
	ParseGuard* ordinary = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, parse_guard_not(@*this.compiler, (ParseGuard*)application));
	@plain.source_name_continue((NameSyntax*)part, (ParseGuard*)ordinary, (ParseResult<NameSyntax>**)results);
	ParseGuard* applied_guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, (ParseGuard*)application);
	ParseResult<ArgumentListSyntax>* applications = @this.source_argument_list_results();
	ParseFailure applied_failure := this.failure;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, applied_failure, (ParseGuard*)applied_guard);
	while (applications && this.compiler->result != compilation_result::failure) {
		NameSyntax* applied = (NameSyntax*)memory_allocate(@*this.compiler, sizeof(NameSyntax));
		if (!applied) {
			return;
		};
		@applied->token := part->token;
		@applied->qualifier := part->qualifier;
		@applied->arguments := applications->value;
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := applications->end.offset;
		@ending.pending_greater := applications->end.pending_greater;
		ParseGuard* selected = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)applied_guard, ParseGuard*(applications->guard));
		@ending.source_name_continue((NameSyntax*)applied, (ParseGuard*)selected, (ParseResult<NameSyntax>**)results);
		parse_failure_record(@*this.compiler, &failures, ending.failure, (ParseGuard*)selected);
		if (ending.failure.message && (!applied_failure.message || ending.failure.offset > applied_failure.offset)) {
			@applied_failure := ending.failure;
		};
		@applications := applications->next;
	};
	while (failures && this.compiler->result != compilation_result::failure) {
		ParseResult<NameSyntax>* sibling := *results;
		ParseGuard* selected := failures->guard;
		while (sibling && this.compiler->result != compilation_result::failure) {
			NameSyntax* error = (NameSyntax*)memory_allocate(@*this.compiler, sizeof(NameSyntax));
			ParseFailure* saved = (ParseFailure*)memory_allocate(@*this.compiler, sizeof(ParseFailure));
			if (!error || !saved) {
				return;
			};
			@*saved := failures->failure;
			@error->token := part->token;
			@error->error = (ParseFailure*)saved;
			parse_result_add<NameSyntax>(@*this.compiler, (ParseResult<NameSyntax>**)results, (NameSyntax*)error, (ParseGuard*)selected, sibling->end, &pack_name);
			@sibling := sibling->next;
		};
		@failures := failures->next;
	};
	if (*results) {
		@this.failure = ParseFailure();
	}
	else {
		@this.failure := applied_failure;
	};
};

fn Parser::source_name_results(Parser& this) -> ParseResult<NameSyntax>* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::source_name, 0, 0, "non-consuming source name parse cycle\0");
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (ParseResult<NameSyntax>*)memo->names;
	};

	@memo->state = resolution::active;
	ParseResult<NameSyntax>* result = nullptr;
	@this.source_name_part_results(nullptr, nullptr, &result);
	@memo->names = (ParseResult<NameSyntax>*)result;
	@this.memo_finish((ParseMemo*)memo);
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	return (ParseResult<NameSyntax>*)memo->names;
};

fn name_source_select(Compiler& compiler, Scope* scope, NameSyntax* name) -> NameSyntax* {
	while (name && compiler.result != compilation_result::failure) {
		if (name->error) {
			compiler_error(@compiler, name->error->token, (const char*)name->error->message);
			return nullptr;
		};
		if (!name->choices) {
			return (NameSyntax*)name;
		};
		NameChoice* arm := name->choices;
		while (arm && !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)arm->guard)) {
			@arm := arm->next;
		};
		if (!arm) {
			compiler_error(@compiler, name->token, "no type name interpretation matches the current scope\0");
			return nullptr;
		};
		@name := arm->name;
	};
	return nullptr;
};

fn argument_list_select(Compiler& compiler, Scope* scope, ArgumentListSyntax* arguments) -> ArgumentListSyntax* {
	while (arguments && compiler.result != compilation_result::failure) {
		if (arguments->error) {
			compiler_error(@compiler, arguments->error->token, (const char*)arguments->error->message);
			return nullptr;
		};
		if (!arguments->choices) {
			return (ArgumentListSyntax*)arguments;
		};
		ArgumentListArm* arm := arguments->choices;
		while (arm && !parse_guard_matches(@compiler, (Scope*)scope, (ParseGuard*)arm->guard)) {
			@arm := arm->next;
		};
		if (!arm) {
			Token token;
			compiler_error(@compiler, token, "no template argument list interpretation matches the current scope\0");
			return nullptr;
		};
		@arguments := arm->arguments;
	};
	return nullptr;
};

fn parse_name_result(Parser& parser, NameSyntax* part, ParseGuard* guard, ParseResult<ValueSyntax>** results) {
	if (parser.failed()) {
		return;
	};
	if (@parser.take(token_kind::op_scope)) {
		if (@parser.take(token_kind::op_tilde)) {
			@parser.value_static_destructor((NameSyntax*)part, (ParseGuard*)guard, (ParseResult<ValueSyntax>**)results);
			return;
		};
		@parser.value_name_part((NameSyntax*)part, (ParseGuard*)guard, (ParseResult<ValueSyntax>**)results);
		return;
	};
	ParseCursor end;
	@end.offset := parser.offset;
	@end.pending_greater := parser.pending_greater;
	parse_result_add<ValueSyntax>(@*parser.compiler, (ParseResult<ValueSyntax>**)results, value_name(@*parser.compiler, (NameSyntax*)part), (ParseGuard*)guard, end, &pack_value);
};

fn Parser::value_name_part(Parser& this, NameSyntax* qualifier, ParseGuard* guard, ParseResult<ValueSyntax>** results) {
	NameSyntax* part = (NameSyntax*)memory_allocate(@*this.compiler, sizeof(NameSyntax));
	if (!part) {
		return;
	};
	@part->token = @this.require(token_kind::identifier, "expected qualified identifier\0");
	@part->qualifier = (NameSyntax*)qualifier;
	if (this.failed()) {
		return;
	};
	if (!this.at(token_kind::op_less)) {
		parse_name_result(@this, (NameSyntax*)part, (ParseGuard*)guard, (ParseResult<ValueSyntax>**)results);
		return;
	};
	ParseChoice choice;
	@choice.kind = parse_choice_kind::template_name;
	@choice.name := part;
	@choice.offset := this.offset;
	@choice.pending_greater := this.pending_greater;
	ParseGuard* plain = (ParseGuard*)memory_allocate(@*this.compiler, sizeof(ParseGuard));
	ParseGuard* applied = (ParseGuard*)memory_allocate(@*this.compiler, sizeof(ParseGuard));
	if (!plain || !applied) {
		return;
	};
	@plain->kind = parse_guard_kind::decision;
	@plain->choice := choice;
	@applied->kind = parse_guard_kind::decision;
	@applied->choice = ParseChoice(choice);
	@applied->selected = 1;
	ParseCursor end;
	@end.offset := this.offset;
	@end.pending_greater := this.pending_greater;
	parse_result_add<ValueSyntax>(@*this.compiler, (ParseResult<ValueSyntax>**)results, value_name(@*this.compiler, (NameSyntax*)part), parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, (ParseGuard*)plain), end, &pack_value);
	Parser candidate := this;
	ParseResult<ArgumentListSyntax>* arguments = @candidate.source_argument_list_results();
	ParseGuard* positive = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, (ParseGuard*)applied);
	while (arguments && this.compiler->result != compilation_result::failure) {
		NameSyntax* application = (NameSyntax*)memory_allocate(@*this.compiler, sizeof(NameSyntax));
		if (!application) {
			return;
		};
		@application->token := part->token;
		@application->qualifier := part->qualifier;
		@application->arguments := arguments->value;
		Parser suffix := this;
		@suffix.failure = ParseFailure();
		@suffix.offset := arguments->end.offset;
		@suffix.pending_greater := arguments->end.pending_greater;
		ParseGuard* selected = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)positive, (ParseGuard*)arguments->guard);
		parse_name_result(@suffix, (NameSyntax*)application, (ParseGuard*)selected, (ParseResult<ValueSyntax>**)results);
		if (suffix.failure.message) {
			parse_results_failure(@*this.compiler, (ParseResult<ValueSyntax>**)results, suffix.failure, (ParseGuard*)selected);
		};
		@arguments := arguments->next;
	};
	if (candidate.failure.message) {
		parse_results_failure(@*this.compiler, (ParseResult<ValueSyntax>**)results, candidate.failure, (ParseGuard*)positive);
	};
};

fn Parser::value_name_results(Parser& this) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* results = nullptr;
	@this.value_name_part(nullptr, nullptr, &results);
	return (ParseResult<ValueSyntax>*)results;
};

fn Parser::value_static_destructor(Parser& this, NameSyntax* owner, ParseGuard* guard, ParseResult<ValueSyntax>** results) {
	Token token = @this.require(token_kind::identifier, "expected destructor type\0");
	if (!token_same(token, owner->token)) {
		@this.error(Token(token), "destructor name must match its owning type\0");
		return;
	};
	@this.require(token_kind::punct_left_paren, "expected '(' after destructor type\0");
	if (this.failed()) {
		return;
	};
	TypeSyntax* type = @this.new_type(type_syntax_kind::name, Token(owner->token));
	if (!type) {
		return;
	};
	@type->data.name = (NameSyntax*)owner;
	ParseResult<ValueSyntax>* receivers = @this.value_until_results(1, source_delimiter::paren);
	while (receivers && this.compiler->result != compilation_result::failure) {
		Parser candidate := this;
		@candidate.failure = ParseFailure();
		@candidate.offset := receivers->end.offset;
		@candidate.pending_greater := receivers->end.pending_greater;
		@candidate.require(token_kind::punct_right_paren, "destructor invocation requires exactly one receiver\0");
		if (!candidate.failed()) {
			ValueSyntax* value = @candidate.new_value(syntax_kind::expr_destroy, Token(token));
			if (!value) {
				return;
			};
			@value->data.typed.type := type;
			@value->data.typed.value := receivers->value;
			ParseGuard* selected = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, (ParseGuard*)receivers->guard);
			parse_result_add<ValueSyntax>(@*this.compiler, (ParseResult<ValueSyntax>**)results, (ValueSyntax*)value, (ParseGuard*)selected, parser_cursor(candidate), &pack_value);
		};
		@receivers := receivers->next;
	};
};

enum source_rule_kind : [i32] {
	end;
	require;
	expression;
	optional_expression;
	block;
	control;
	initializer;
	alternative;
};

struct SourceRule {
	const char* message;
	SourceRule* next;
	source_rule_kind kind;
	token_kind token;
	source_delimiter delimiter;
	i32 minimum;
};

fn parse_guard_not(Compiler& compiler, ParseGuard* guard) -> ParseGuard* {
	ParseGuard* result = (ParseGuard*)memory_allocate(@compiler, sizeof(ParseGuard));
	if (!result) {
		return nullptr;
	};
	@result->kind = parse_guard_kind::negation;
	@result->left = (ParseGuard*)guard;

	return (ParseGuard*)result;
};

fn source_guarded(Compiler& compiler, ValueSyntax* value, ParseGuard* guard) -> ValueSyntax* {
	if (!guard) {
		return (ValueSyntax*)value;
	};
	SourceChoice* choice = (SourceChoice*)memory_allocate(@compiler, sizeof(SourceChoice));
	ValueSyntax* result = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
	if (!choice || !result) {
		return nullptr;
	};
	@choice->first = parse_arm(@compiler, (ValueSyntax*)value, (ParseGuard*)guard, nullptr);
	if (!choice->first) {
		return nullptr;
	};
	@result->kind = syntax_kind::source_choice;
	if (choice->first->value) {
		@result->token := choice->first->value->token;
	};
	@result->data.choice = (SourceChoice*)choice;
	return (ValueSyntax*)result;
};

fn source_part(Compiler& compiler, ValueSyntax* value, ValueSyntax* previous) -> ValueSyntax* {
	ValueSyntax* part = (ValueSyntax*)memory_allocate(@compiler, sizeof(ValueSyntax));
	if (!part) {
		return nullptr;
	};
	@part->kind = syntax_kind::source_list;
	if (value) {
		@part->token := value->token;
	}
	else if (previous) {
		@part->token := previous->token;
	};
	@part->data.binary.left = (ValueSyntax*)value;
	@part->data.binary.right = (ValueSyntax*)previous;

	return (ValueSyntax*)part;
};

fn source_part_at(ValueSyntax* parts, usize index) -> ValueSyntax* {
	while (parts && index) {
		@parts := parts->data.binary.right;
		@index = index - 1;
	};
	if (!parts) {
		return nullptr;
	};
	return (ValueSyntax*)parts->data.binary.left;
};

fn Parser::statement_result(Parser& this, syntax_kind kind, Token token, ValueSyntax* parts) -> ParseResult<ValueSyntax>* {
	ValueSyntax* node = @this.new_value((syntax_kind)kind, Token(token));
	ParseResult<ValueSyntax>* result = (ParseResult<ValueSyntax>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ValueSyntax>));
	if (!node || !result) {
		return nullptr;
	};
	switch (kind) {
		case syntax_kind::kw_if:
			@node->data.branch.second = source_part_at((ValueSyntax*)parts, 0);
			@node->data.branch.first = source_part_at((ValueSyntax*)parts, 1);
			@node->data.branch.condition = source_part_at((ValueSyntax*)parts, 2);
			break;
		case syntax_kind::kw_while:
			@node->data.loop.body = source_part_at((ValueSyntax*)parts, 0);
			@node->data.loop.condition = source_part_at((ValueSyntax*)parts, 1);
			break;
		case syntax_kind::kw_for:
			@node->data.loop.body = source_part_at((ValueSyntax*)parts, 0);
			@node->data.loop.step = source_part_at((ValueSyntax*)parts, 1);
			@node->data.loop.condition = source_part_at((ValueSyntax*)parts, 2);
			@node->data.loop.initializer = source_part_at((ValueSyntax*)parts, 3);
			break;
		case syntax_kind::kw_switch:
			@node->data.selection.cases = source_part_at((ValueSyntax*)parts, 0);
			@node->data.selection.value = source_part_at((ValueSyntax*)parts, 1);
			break;
		case syntax_kind::node_block:
			@node->data.statements = source_part_at((ValueSyntax*)parts, 0);
			break;
		default:
			@node->data.expression = source_part_at((ValueSyntax*)parts, 0);
			break;
	};
	@result->value = (ValueSyntax*)node;
	@result->end = parser_cursor(this);
	return (ParseResult<ValueSyntax>*)result;
};

fn Parser::empty_result(Parser& this) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* result = (ParseResult<ValueSyntax>*)memory_allocate(@*this.compiler, sizeof(ParseResult<ValueSyntax>));
	if (result) {
		@result->end = parser_cursor(this);
	};
	return (ParseResult<ValueSyntax>*)result;
};

fn Parser::statement_rule_results(Parser& this, SourceRule* rule, syntax_kind kind, Token token, ValueSyntax* parts) -> ParseResult<ValueSyntax>* {
	if (!rule || rule->kind == source_rule_kind::end) {
		return @this.statement_result((syntax_kind)kind, Token(token), (ValueSyntax*)parts);
	};
	if (rule->kind == source_rule_kind::require) {
		@this.require((token_kind)rule->token, (char*)rule->message);
		if (this.failed()) {
			return nullptr;
		};
		return @this.statement_rule_results((SourceRule*)rule->next, (syntax_kind)kind, Token(token), (ValueSyntax*)parts);
	};
	ParseResult<ValueSyntax>* children = nullptr;
	switch (rule->kind) {
		case source_rule_kind::optional_expression: {
			if (parse_delimiter_matches(this, (source_delimiter)rule->delimiter)) {
				@children = @this.empty_result();
			}
			else {
				@children = @this.value_until_results((i32)rule->minimum, (source_delimiter)rule->delimiter);
			};
			break;
		};
		case source_rule_kind::expression:
			@children = @this.value_until_results((i32)rule->minimum, (source_delimiter)rule->delimiter);
			break;
		case source_rule_kind::block:
			@children = @this.source_block_results();
			break;
		case source_rule_kind::control:
			@children = @this.source_control_results();
			break;
		case source_rule_kind::initializer:
			@children = @this.source_initializer_results();
			break;
		case source_rule_kind::alternative:
			if (@this.take(token_kind::kw_else)) {
				@children = @this.source_control_results();
			}
			else {
				@children = @this.empty_result();
			};
			break;
	};
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (children && this.compiler->result != compilation_result::failure) {
		Parser continuation := this;
		@continuation.failure = ParseFailure();
		@continuation.offset := children->end.offset;
		@continuation.pending_greater := children->end.pending_greater;
		ValueSyntax* operands = source_part(@*this.compiler, (ValueSyntax*)children->value, (ValueSyntax*)parts);
		ParseResult<ValueSyntax>* next = @continuation.statement_rule_results((SourceRule*)rule->next, (syntax_kind)kind, Token(token), (ValueSyntax*)operands);
		parse_failure_record(@*this.compiler, &failures, continuation.failure, ParseGuard*(children->guard));
		@next = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)next, ParseGuard*(children->guard));
		parse_results_merge(@*this.compiler, &results, (ParseResult<ValueSyntax>*)next);
		@children := children->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn source_rule(SourceRule& rule, source_rule_kind kind, SourceRule* next, token_kind token, source_delimiter delimiter, const char* message) {
	@rule.kind = (source_rule_kind)kind;
	@rule.next = (SourceRule*)next;
	@rule.token = (token_kind)token;
	@rule.delimiter = (source_delimiter)delimiter;
	@rule.minimum = 1;
	@rule.message = (const char*)message;
};

fn Parser::source_initializer_results(Parser& this) -> ParseResult<ValueSyntax>* {
	if (@this.take(token_kind::punct_semicolon)) {
		return @this.empty_result();
	};
	return @this.source_simple_results();
};

fn Parser::source_terminated_results(Parser& this, ParseResult<ValueSyntax>* values, token_kind closing, const char* message) -> ParseResult<ValueSyntax>* {
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	while (values && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := values->end.offset;
		@ending.pending_greater := values->end.pending_greater;
		@ending.require((token_kind)closing, (char*)message);
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(values->guard));
		if (!ending.failed()) {
			parse_result_add<ValueSyntax>(@*this.compiler, &result, ValueSyntax*(values->value), ParseGuard*(values->guard), parser_cursor(ending), &pack_value);
		};
		@values := values->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn Parser::source_statement_results(Parser& this) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	if (token.kind == token_kind::kw_template || token.kind == token_kind::kw_namespace || declaration_rule(@*this.compiler, (token_kind)token.kind)) {
		return @this.source_declaration_results();
	};
	if (@this.take(token_kind::punct_semicolon)) {
		return @this.statement_result(syntax_kind::node_block, Token(token), nullptr);
	};
	if (this.at(token_kind::punct_left_brace)) {
		return @this.source_terminated_results(@this.source_block_results(), token_kind::punct_semicolon, "expected ';' after block expression\0");
	};
	SourceRule[9] rules {};
	syntax_kind kind = syntax_kind::node_block;
	SourceRule* first = nullptr;
	switch (token.kind) {
		case token_kind::kw_if:
			@kind = syntax_kind::kw_if;
			source_rule(@rules[4], source_rule_kind::alternative, nullptr, token_kind::eof, source_delimiter::ordinary, nullptr);
			source_rule(@rules[3], source_rule_kind::control, &rules[4], token_kind::eof, source_delimiter::ordinary, nullptr);
			@first = &rules[0];
			break;
		case token_kind::kw_while:
			@kind = syntax_kind::kw_while;
			source_rule(@rules[3], source_rule_kind::control, nullptr, token_kind::eof, source_delimiter::ordinary, nullptr);
			@first = &rules[0];
			break;
		case token_kind::kw_switch:
			@kind = syntax_kind::kw_switch;
			source_rule(@rules[4], source_rule_kind::require, nullptr, token_kind::punct_semicolon, source_delimiter::ordinary, "expected ';' after switch block\0");
			source_rule(@rules[3], source_rule_kind::block, &rules[4], token_kind::eof, source_delimiter::ordinary, nullptr);
			@first = &rules[0];
			break;
		case token_kind::kw_for:
			@kind = syntax_kind::kw_for;
			source_rule(@rules[0], source_rule_kind::require, &rules[1], token_kind::punct_left_paren, source_delimiter::ordinary, "expected '(' after for\0");
			source_rule(@rules[1], source_rule_kind::initializer, &rules[2], token_kind::eof, source_delimiter::ordinary, nullptr);
			source_rule(@rules[2], source_rule_kind::optional_expression, &rules[3], token_kind::eof, source_delimiter::statement, nullptr);
			source_rule(@rules[3], source_rule_kind::require, &rules[4], token_kind::punct_semicolon, source_delimiter::ordinary, "expected ';' after for condition\0");
			source_rule(@rules[4], source_rule_kind::optional_expression, &rules[5], token_kind::eof, source_delimiter::paren, nullptr);
			source_rule(@rules[5], source_rule_kind::require, &rules[6], token_kind::punct_right_paren, source_delimiter::ordinary, "expected ')' after for step\0");
			source_rule(@rules[6], source_rule_kind::control, nullptr, token_kind::eof, source_delimiter::ordinary, nullptr);
			@first = &rules[0];
			break;
		case token_kind::kw_return:
			@kind = syntax_kind::kw_return;
			source_rule(@rules[0], source_rule_kind::optional_expression, &rules[1], token_kind::eof, source_delimiter::statement, nullptr);
			source_rule(@rules[1], source_rule_kind::require, nullptr, token_kind::punct_semicolon, source_delimiter::ordinary, "expected ';' after return\0");
			@first = &rules[0];
			break;
		case token_kind::kw_case:
			@kind = syntax_kind::kw_case;
			source_rule(@rules[0], source_rule_kind::expression, &rules[1], token_kind::eof, source_delimiter::case_label, nullptr);
			@rules[0].minimum = 2;
			source_rule(@rules[1], source_rule_kind::require, nullptr, token_kind::punct_colon, source_delimiter::ordinary, "expected ':' after case label\0");
			@first = &rules[0];
			break;
		case token_kind::kw_default:
			@kind = syntax_kind::kw_case;
			source_rule(@rules[0], source_rule_kind::require, nullptr, token_kind::punct_colon, source_delimiter::ordinary, "expected ':' after default label\0");
			@first = &rules[0];
			break;
		case token_kind::kw_break:
		case token_kind::kw_continue:
			@kind = syntax_kind::kw_break;
			if (token.kind == token_kind::kw_continue) {
				@kind = syntax_kind::kw_continue;
			};
			source_rule(@rules[0], source_rule_kind::require, nullptr, token_kind::punct_semicolon, source_delimiter::ordinary, "expected ';' after flow statement\0");
			@first = &rules[0];
			break;
		default:
			return @this.source_simple_results();
	};
	if (kind == syntax_kind::kw_if || kind == syntax_kind::kw_while || kind == syntax_kind::kw_switch) {
		source_rule(@rules[0], source_rule_kind::require, &rules[1], token_kind::punct_left_paren, source_delimiter::ordinary, "expected '(' after control keyword\0");
		source_rule(@rules[1], source_rule_kind::expression, &rules[2], token_kind::eof, source_delimiter::paren, nullptr);
		source_rule(@rules[2], source_rule_kind::require, &rules[3], token_kind::punct_right_paren, source_delimiter::ordinary, "expected ')' after condition\0");
	};
	@this.take((token_kind)token.kind);
	return @this.statement_rule_results((SourceRule*)first, (syntax_kind)kind, Token(token), nullptr);
};

struct SourceSequenceWork {
	ParseMemo* memo;
	ParseResult<ValueSyntax>* edges;
	SourceSequenceWork* next;
	SourceSequenceWork* pending;
};

fn source_sequence_schedule(Compiler& compiler, ParseMemo* memo, SourceSequenceWork** work, SourceSequenceWork** pending) {
	if (!memo || memo->state != resolution::pending) {
		return;
	};
	SourceSequenceWork* item = (SourceSequenceWork*)memory_allocate(@compiler, sizeof(SourceSequenceWork));
	if (!item) {
		return;
	};
	@item->memo := memo;
	@item->pending := *pending;
	@*pending := item;
	SourceSequenceWork** position := work;
	while (*position && ((*position)->memo->offset > memo->offset || ((*position)->memo->offset == memo->offset && (*position)->memo->pending_greater > memo->pending_greater))) {
		@position = &(*position)->next;
	};
	@item->next := *position;
	@*position := item;
	@memo->state = resolution::active;
};

fn Parser::source_sequence_query(Parser& this, token_kind closing, parse_memo_kind kind) -> ParseResult<ValueSyntax>* {
	ParseMemo* root = @this.memo_record((parse_memo_kind)kind, 0, (i32)closing);
	if (!root) {
		return nullptr;
	};
	if (root->state == resolution::ready) {
		@this.failure := root->failure;
		return (ParseResult<ValueSyntax>*)root->results;
	};
	if (root->state == resolution::active) {
		@this.error(this.token(), "non-consuming source sequence cycle\0");
		return nullptr;
	};
	SourceSequenceWork* work = nullptr;
	SourceSequenceWork* pending = nullptr;
	source_sequence_schedule(@*this.compiler, (ParseMemo*)root, &work, &pending);
	while (pending && this.compiler->result != compilation_result::failure) {
		SourceSequenceWork* item := pending;
		@pending := item->pending;
		Parser parser := this;
		@parser.failure = ParseFailure();
		@parser.offset := item->memo->offset;
		@parser.pending_greater := item->memo->pending_greater;
		if (parser.at((token_kind)closing)) {
			if (closing != token_kind::eof) {
				@parser.take((token_kind)closing);
			};
			@item->memo->results = @parser.empty_result();
			@item->memo->state = resolution::ready;
			continue;
		};
		if (parser.at(token_kind::eof)) {
			@parser.error(parser.token(), "expected '}' after source sequence\0");
		}
		else if (kind == parse_memo_kind::enum_members) {
			@item->edges = @parser.source_enum_member_results();
		}
		else {
			@item->edges = @parser.source_statement_results();
		};
		@item->memo->failure := parser.failure;
		ParseResult<ValueSyntax>* edge := item->edges;
		while (edge && this.compiler->result != compilation_result::failure) {
			@parser.failure = ParseFailure();
			@parser.offset := edge->end.offset;
			@parser.pending_greater := edge->end.pending_greater;
			if (parser.offset < item->memo->offset || (parser.offset == item->memo->offset && parser.pending_greater <= item->memo->pending_greater)) {
				@parser.error(parser.token(), "source sequence item did not consume source\0");
				@item->memo->failure := parser.failure;
			}
			else {
				ParseMemo* suffix = @parser.memo_record((parse_memo_kind)kind, 0, (i32)closing);
				source_sequence_schedule(@*this.compiler, (ParseMemo*)suffix, &work, &pending);
			};
			@edge := edge->next;
		};
	};
	while (work && this.compiler->result != compilation_result::failure) {
		ParseMemo* memo := work->memo;
		if (memo->state != resolution::ready) {
			Parser parser := this;
			@parser.failure := memo->failure;
			ParseResult<ValueSyntax>* result = nullptr;
			ParseFailureArm* failures = nullptr;
			parse_failure_record(@*this.compiler, &failures, parser.failure, nullptr);
			ParseResult<ValueSyntax>* edge := work->edges;
			while (edge && this.compiler->result != compilation_result::failure) {
				@parser.failure = ParseFailure();
				@parser.offset := edge->end.offset;
				@parser.pending_greater := edge->end.pending_greater;
				ParseMemo* suffix = @parser.memo_record((parse_memo_kind)kind, 0, (i32)closing);
				if (suffix && suffix->state == resolution::ready) {
					parse_failure_record(@*this.compiler, &failures, suffix->failure, (ParseGuard*)edge->guard);
					ParseResult<ValueSyntax>* rest := suffix->results;
					while (rest && this.compiler->result != compilation_result::failure) {
						ValueSyntax* list = source_part(@*this.compiler, (ValueSyntax*)edge->value, (ValueSyntax*)rest->value);
						parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)list, (ParseGuard*)edge->guard, rest->end, &pack_value);
						@rest := rest->next;
					};
				};
				@edge := edge->next;
			};
			@result = @parser.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
			ParseResult<ValueSyntax>* packed := result;
			while (packed && this.compiler->result != compilation_result::failure) {
				@packed->value = source_guarded(@*this.compiler, (ValueSyntax*)packed->value, (ParseGuard*)packed->guard);
				@packed->guard = nullptr;
				@packed := packed->next;
			};
			@memo->results := result;
			@memo->failure := parser.failure;
			@memo->state = resolution::ready;
		};
		@work := work->next;
	};
	@this.failure := root->failure;
	return (ParseResult<ValueSyntax>*)root->results;
};

fn Parser::source_sequence_results(Parser& this, token_kind closing) -> ParseResult<ValueSyntax>* {
	return @this.source_sequence_query((token_kind)closing, parse_memo_kind::statements);
};

fn Parser::source_block_results(Parser& this) -> ParseResult<ValueSyntax>* {
	Token token = @this.require(token_kind::punct_left_brace, "expected '{'\0");
	if (this.failed()) {
		return nullptr;
	};
	ParseResult<ValueSyntax>* statements = @this.source_sequence_results(token_kind::punct_right_brace);
	ParseResult<ValueSyntax>* result = nullptr;
	while (statements && this.compiler->result != compilation_result::failure) {
		ValueSyntax* block = @this.new_value(syntax_kind::node_block, Token(token));
		if (!block) {
			return nullptr;
		};
		@block->data.statements := statements->value;
		parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)block, ParseGuard*(statements->guard), statements->end, &pack_value);
		@statements := statements->next;
	};
	return (ParseResult<ValueSyntax>*)result;
};

fn Parser::source_file_results(Parser& this) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	ParseResult<ValueSyntax>* statements = @this.source_sequence_results(token_kind::eof);
	ParseResult<ValueSyntax>* result = nullptr;
	while (statements && this.compiler->result != compilation_result::failure) {
		ValueSyntax* block = @this.new_value(syntax_kind::node_block, Token(token));
		if (!block) {
			return nullptr;
		};
		@block->data.statements := statements->value;
		parse_result_add<ValueSyntax>(@*this.compiler, &result, (ValueSyntax*)block, ParseGuard*(statements->guard), statements->end, &pack_value);
		@statements := statements->next;
	};
	return (ParseResult<ValueSyntax>*)result;
};

fn Parser::source_control_results(Parser& this) -> ParseResult<ValueSyntax>* {
	if (!this.at(token_kind::punct_left_brace)) {
		return @this.source_statement_results();
	};
	ParseResult<ValueSyntax>* blocks = @this.source_block_results();
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	while (blocks && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := blocks->end.offset;
		@ending.pending_greater := blocks->end.pending_greater;
		if (!ending.at(token_kind::kw_else)) {
			@ending.require(token_kind::punct_semicolon, "expected ';' after control block\0");
		};
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(blocks->guard));
		if (!ending.failed()) {
			parse_result_add<ValueSyntax>(@*this.compiler, &results, ValueSyntax*(blocks->value), ParseGuard*(blocks->guard), parser_cursor(ending), &pack_value);
		};
		@blocks := blocks->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::source_variable_tail_results(Parser& this, TypeSyntax* type, Token token) -> ParseResult<ValueSyntax>* {
	Token name = @this.require(token_kind::identifier, "expected declaration identifier\0");
	if (this.failed()) {
		return nullptr;
	};
	token_kind initialization = token_kind::eof;
	ParseResult<ValueSyntax>* bodies = nullptr;
	if (this.at(token_kind::punct_left_brace)) {
		@bodies = @this.source_block_results();
	}
	else if (this.at(token_kind::op_assign) || this.at(token_kind::op_copy)) {
		@initialization := this.token().kind;
		@this.take((token_kind)initialization);
		@bodies = @this.value_until_results(1, source_delimiter::statement);
	}
	else {
		@bodies = @this.empty_result();
	};
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (bodies && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := bodies->end.offset;
		@ending.pending_greater := bodies->end.pending_greater;
		@ending.require(token_kind::punct_semicolon, "expected ';' after variable declaration\0");
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(bodies->guard));
		if (!ending.failed()) {
			ValueSyntax* value = @this.new_value(syntax_kind::node_declaration, Token(token));
			if (!value) {
				return nullptr;
			};
			@value->data.declaration.type := type;
			@value->data.declaration.name := name;
			@value->data.declaration.initialization := initialization;
			@value->data.declaration.body := bodies->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)value, ParseGuard*(bodies->guard), parser_cursor(ending), &pack_value);
		};
		@bodies := bodies->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::source_simple_results(Parser& this) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	if (@this.take(token_kind::kw_var)) {
		return @this.source_variable_tail_results(nullptr, Token(token));
	};
	ParseCursor begin = parser_cursor(this);
	Parser typed := this;
	ParseResult<TypeSyntax>* types = @typed.type_results();
	ParseGuard* expression_guard = nullptr;
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	while (types && this.compiler->result != compilation_result::failure) {
		Parser declaration := this;
		@declaration.failure = ParseFailure();
		@declaration.offset := types->end.offset;
		@declaration.pending_greater := types->end.pending_greater;
		if (declaration.at(token_kind::identifier) && !(token.kind == token_kind::punct_left_paren && types->end.offset && !types->end.pending_greater && this.tokens[types->end.offset - 1].kind == token_kind::punct_right_paren)) {
			ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(types->guard), parse_decision(@*this.compiler, TypeSyntax*(types->value), nullptr, begin, 1));
			@expression_guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)expression_guard, parse_guard_not(@*this.compiler, ParseGuard*(guard)));
			ParseResult<ValueSyntax>* values = @declaration.source_variable_tail_results(TypeSyntax*(types->value), Token(token));
			parse_failure_record(@*this.compiler, &failures, declaration.failure, ParseGuard*(guard));
			@values = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)values, (ParseGuard*)guard);
			parse_results_merge(@*this.compiler, &results, (ParseResult<ValueSyntax>*)values);
		};
		@types := types->next;
	};
	ParseResult<ValueSyntax>* expressions = @this.value_until_results(1, source_delimiter::statement);
	parse_failure_record(@*this.compiler, &failures, this.failure, ParseGuard*(expression_guard));
	while (expressions && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := expressions->end.offset;
		@ending.pending_greater := expressions->end.pending_greater;
		@ending.require(token_kind::punct_semicolon, "expected ';' after expression\0");
		ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(expressions->guard), (ParseGuard*)expression_guard);
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(guard));
		if (!ending.failed()) {
			parse_result_add<ValueSyntax>(@*this.compiler, &results, ValueSyntax*(expressions->value), (ParseGuard*)guard, parser_cursor(ending), &pack_value);
		};
		@expressions := expressions->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn value_lower_sequence(Compiler& compiler, Scope* scope, ValueSyntax* source, Syntax** first, Syntax** last) {
	while (source && compiler.result != compilation_result::failure) {
		if (source->kind == syntax_kind::source_choice) {
			@source = source_choice_select(@compiler, (Scope*)scope, *source->data.choice);
			continue;
		}
		else if (source->kind == syntax_kind::source_list) {
			value_lower_sequence(@compiler, (Scope*)scope, (ValueSyntax*)source->data.binary.left, (Syntax**)first, (Syntax**)last);
			@source := source->data.binary.right;
			continue;
		}
		else {
			syntax_append((Syntax**)first, (Syntax**)last, value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source));
		};
		@source := source->next;
	};
};

fn value_lower_list(Compiler& compiler, Scope* scope, ValueSyntax* source) -> Syntax* {
	Syntax* first = nullptr;
	Syntax* last = nullptr;
	value_lower_sequence(@compiler, (Scope*)scope, (ValueSyntax*)source, &first, &last);
	return (Syntax*)first;
};

fn value_lower(Compiler& compiler, Scope* scope, ValueSyntax* source) -> Syntax* {
	if (!source || compiler.result == compilation_result::failure) {
		return nullptr;
	};
	if (source->kind == syntax_kind::source_error) {
		compiler_error(@compiler, source->data.error->token, (const char*)source->data.error->message);
		return nullptr;
	};
	if (source->kind == syntax_kind::source_choice) {
		return value_lower(@compiler, (Scope*)scope, source_choice_select(@compiler, (Scope*)scope, *source->data.choice));
	};
	if (source->kind == syntax_kind::source_expression_chain) {
		Syntax* head = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.chain->head);
		return source_tail_lower(@compiler, (Scope*)scope, (ExpressionTail*)source->data.chain->tail, (Syntax*)head);
	};
	if (source->kind == syntax_kind::node_source_declaration) {
		return source_declaration_lower(@compiler, (Scope*)scope, (SourceDeclaration*)source->data.source_declaration);
	};
	if (source->kind == syntax_kind::expr_name) {
		return name_lower(@compiler, (Scope*)scope, (NameSyntax*)source->data.name);
	};
	if (source->kind == syntax_kind::literal_string) {
		return literal_string_create(@compiler, source->token);
	};
	Syntax* node = syntax_create(@compiler, (syntax_kind)source->kind, Token(source->token));
	if (!node) {
		return nullptr;
	};
	switch (source->kind) {
		case syntax_kind::node_block: {
			Scope* local = scope_create(@compiler, (Scope*)scope, context_kind::local, nullptr);
			if (!local) {
				return nullptr;
			};
			@node->scope := local;
			@node->data.statements = value_lower_list(@compiler, (Scope*)local, (ValueSyntax*)source->data.statements);
			break;
		};
		case syntax_kind::node_declaration: {
			@node->data.declaration.type := source->data.declaration.type;
			@node->data.declaration.name := source->data.declaration.name;
			Entity* variable = entity_create(@compiler, entity_kind::variable, Token(source->data.declaration.name));
			if (!variable) {
				return nullptr;
			};
			@node->entity := variable;
			@variable->declaration := node;
			if (scope->context == context_kind::kw_enum) {
				@variable->data.variable.storage = storage_kind::constant;
				scope_define(@compiler, (Scope*)scope, (Entity*)variable);
				@node->data.declaration.body = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.declaration.body);
				break;
			};
			if (scope->context == context_kind::module) {
				@variable->data.variable.storage = storage_kind::global;
			};
			if (scope->context == context_kind::kw_struct || scope->context == context_kind::kw_union) {
				@variable->data.variable.storage = storage_kind::field;
			};
			if (scope->context == context_kind::module || scope->context == context_kind::kw_struct || scope->context == context_kind::kw_union) {
				scope_define(@compiler, (Scope*)scope, (Entity*)variable);
			}
			else {
				scope_bind(@compiler, (Scope*)scope, (Entity*)variable);
			};
			if (source->data.declaration.initialization == token_kind::op_assign || source->data.declaration.initialization == token_kind::op_copy) {
				Syntax* block = syntax_create(@compiler, syntax_kind::node_block, Token(source->token));
				@block->scope = scope_create(@compiler, (Scope*)scope, context_kind::initialization, (Entity*)variable);
				Syntax* assignment = syntax_create(@compiler, syntax_kind::stmt_initialize, Token(source->token));
				@assignment->data.binary.access = initialization_access::access;
				@assignment->data.binary.operation := source->data.declaration.initialization;
				@assignment->data.binary.left = syntax_create(@compiler, syntax_kind::expr_name, Token(variable->name));
				@assignment->data.binary.left->entity := variable;
				@assignment->data.binary.right = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.declaration.body);
				@block->data.statements = (Syntax*)assignment;
				@node->data.declaration.body = (Syntax*)block;
			}
			else {
				@node->data.declaration.body = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.declaration.body);
				if (node->data.declaration.body) {
					@node->data.declaration.body->scope->context = context_kind::initialization;
					@node->data.declaration.body->scope->owner = (Entity*)variable;
				};
			};
			break;
		};
		case syntax_kind::expr_typed_apply:
			@node->data.typed_apply.target := source->data.typed.type;
			@node->data.typed_apply.arguments = value_lower_list(@compiler, (Scope*)scope, (ValueSyntax*)source->data.typed.value);
			break;
		case syntax_kind::expr_cast:
		case syntax_kind::expr_destroy:
			@node->data.cast.type := source->data.typed.type;
			@node->data.cast.value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.typed.value);
			break;
		case syntax_kind::kw_sizeof:
			@node->data.sizeof_operand.type := source->data.typed.type;
			@node->data.sizeof_operand.value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.typed.value);
			break;
		case syntax_kind::expr_call:
			@node->data.call.callable = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.call.callable);
			@node->data.call.arguments = value_lower_list(@compiler, (Scope*)scope, (ValueSyntax*)source->data.call.arguments);
			break;
		case syntax_kind::expr_member: {
			@node->data.member.object = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.member.object);
			@node->data.member.name := source->data.member.name->token;
			@node->data.member.qualifier = name_lower(@compiler, (Scope*)scope, (NameSyntax*)source->data.member.name->qualifier);
			break;
		};
		case syntax_kind::expr_binary:
		case syntax_kind::expr_index:
			@node->data.binary.operation := source->data.binary.operation;
			@node->data.binary.left = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.binary.left);
			@node->data.binary.right = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.binary.right);
			break;
		case syntax_kind::expr_unary:
			@node->data.unary.operation := source->data.binary.operation;
			@node->data.unary.value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.binary.left);
			break;
		case syntax_kind::kw_if:
			@node->data.branch.condition = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.branch.condition);
			@node->data.branch.first = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.branch.first);
			@node->data.branch.second = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.branch.second);
			break;
		case syntax_kind::kw_switch:
			@node->data.selection.value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.selection.value);
			@node->data.selection.cases = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.selection.cases);
			break;
		case syntax_kind::kw_case:
			@node->data.selection_case.value = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.expression);
			break;
		case syntax_kind::kw_for:
		case syntax_kind::kw_while: {
			Scope* local := scope;
			if (source->kind == syntax_kind::kw_for) {
				@local = scope_create(@compiler, (Scope*)scope, context_kind::local, nullptr);
				@node->scope := local;
			};
			@node->data.loop.initializer = value_lower(@compiler, (Scope*)local, (ValueSyntax*)source->data.loop.initializer);
			@node->data.loop.condition = value_lower(@compiler, (Scope*)local, (ValueSyntax*)source->data.loop.condition);
			@node->data.loop.step = value_lower(@compiler, (Scope*)local, (ValueSyntax*)source->data.loop.step);
			@node->data.loop.body = value_lower(@compiler, (Scope*)local, (ValueSyntax*)source->data.loop.body);
			break;
		};
		case syntax_kind::kw_return:
		case syntax_kind::kw_new:
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard:
		case syntax_kind::kw_discard:
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
			@node->data.expression = value_lower(@compiler, (Scope*)scope, (ValueSyntax*)source->data.expression);
			break;
	};
	return (Syntax*)node;
};

struct SourceBase {
	NameSyntax* name;
	SourceBase* next;
	base_kind kind;
};

struct SourceDeclaration {
	Token token;
	NameSyntax* path;
	TypeSyntax* type;
	SourceBase* bases;
	ValueSyntax* body;
	TemplateParameter* parameters;
	function_definition definition;
	function_modification modification;
	constructor_conversion conversion;
	function_role spelling;
};

enum source_binding_kind : [i32] {
	declaration;
	instance;
};

struct SourceBinding {
	Entity* entity;
	Scope* owner;
	Syntax* lowered;
	source_binding_kind kind;
};

struct FunctionNameParseResult {
	NameSyntax* name;
	function_role spelling;
	ParseGuard* guard;
	ParseCursor end;
	FunctionNameParseResult* next;
};

fn name_guarded(Compiler& compiler, NameSyntax* name, ParseGuard* guard) -> NameSyntax* {
	if (!guard || !name) {
		return (NameSyntax*)name;
	};
	NameSyntax* result = (NameSyntax*)memory_allocate(@compiler, sizeof(NameSyntax));
	NameChoice* arm = (NameChoice*)memory_allocate(@compiler, sizeof(NameChoice));
	if (!result || !arm) {
		return nullptr;
	};
	@arm->name := name;
	@arm->guard = (ParseGuard*)guard;
	@result->token := name->token;
	@result->choices = (NameChoice*)arm;
	return (NameSyntax*)result;
};

fn function_names_add(Compiler& compiler, FunctionNameParseResult** results, NameSyntax* name, function_role spelling, ParseGuard* guard, const ParseCursor& end) {
	FunctionNameParseResult* existing := *results;
	while (existing && (!parse_cursor_equal(existing->end, end) || existing->spelling != spelling)) {
		@existing := existing->next;
	};
	if (!existing) {
		FunctionNameParseResult* result = (FunctionNameParseResult*)memory_allocate(@compiler, sizeof(FunctionNameParseResult));
		if (!result) {
			return;
		};
		@result->name = (NameSyntax*)name;
		@result->spelling = (function_role)spelling;
		@result->guard = (ParseGuard*)guard;
		@result->end := end;
		@result->next := *results;
		@*results = (FunctionNameParseResult*)result;
		return;
	};
	ParseResult<NameSyntax>* packed = nullptr;
	parse_result_add<NameSyntax>(@compiler, &packed, NameSyntax*(existing->name), ParseGuard*(existing->guard), end, &pack_name);
	parse_result_add<NameSyntax>(@compiler, &packed, (NameSyntax*)name, (ParseGuard*)guard, end, &pack_name);
	if (!packed) {
		return;
	};
	@existing->name := packed->value;
	@existing->guard = parse_guard(@compiler, parse_guard_kind::disjunction, ParseGuard*(existing->guard), (ParseGuard*)guard);
};

fn function_name_qualified(Compiler& compiler, NameSyntax* name, NameSyntax* qualifier) -> NameSyntax* {
	NameSyntax* result = (NameSyntax*)memory_allocate(@compiler, sizeof(NameSyntax));
	if (!result) {
		return nullptr;
	};
	@*result := *name;
	if (!name->choices) {
		@result->qualifier = (NameSyntax*)qualifier;
		return (NameSyntax*)result;
	};
	@result->choices = nullptr;
	NameChoice** tail = &result->choices;
	NameChoice* source := name->choices;
	while (source && compiler.result != compilation_result::failure) {
		NameChoice* arm = (NameChoice*)memory_allocate(@compiler, sizeof(NameChoice));
		if (!arm) {
			return nullptr;
		};
		@arm->guard := source->guard;
		@arm->name = function_name_qualified(@compiler, (NameSyntax*)source->name, (NameSyntax*)qualifier);
		@*tail := arm;
		@tail = &arm->next;
		@source := source->next;
	};
	return (NameSyntax*)result;
};

fn Parser::source_function_name_results(Parser& this) -> FunctionNameParseResult* {
	ParseMemo* memo = @this.memo_begin(parse_memo_kind::function_name, 0, 0, "non-consuming function name parse cycle\0");
	if (!memo) {
		return nullptr;
	};
	if (memo->state == resolution::ready) {
		return (FunctionNameParseResult*)memo->function_names;
	};

	@memo->state = resolution::active;
	function_role initial = function_role::ordinary;
	if (@this.take(token_kind::op_tilde)) {
		@initial = function_role::destructor;
	};
	ParseResult<NameSyntax>* names = @this.source_name_results();
	FunctionNameParseResult* result = nullptr;
	ParseFailure failure := this.failure;
	while (names && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := names->end.offset;
		@ending.pending_greater := names->end.pending_greater;
		if (initial == function_role::destructor && (names->value->qualifier || ending.at(token_kind::op_scope))) {
			@ending.error(names->value->token, "destructor name must be the final qualified component\0");
		}
		else if (@ending.take(token_kind::op_scope)) {
			@ending.require(token_kind::op_tilde, "expected destructor marker after qualified owner\0");
			ParseResult<NameSyntax>* destructors = nullptr;
			if (!ending.failed()) {
				@destructors = @ending.source_name_results();
			};
			while (destructors && this.compiler->result != compilation_result::failure) {
				Parser terminal := ending;
				@terminal.failure = ParseFailure();
				@terminal.offset := destructors->end.offset;
				@terminal.pending_greater := destructors->end.pending_greater;
				if (destructors->value->qualifier || terminal.at(token_kind::op_scope)) {
					@terminal.error(destructors->value->token, "destructor name must be the final qualified component\0");
				}
				else {
					NameSyntax* destructor = function_name_qualified(@*this.compiler, (NameSyntax*)destructors->value, (NameSyntax*)names->value);
					if (!destructor) {
						return nullptr;
					};
					ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, ParseGuard*(names->guard), ParseGuard*(destructors->guard));
					function_names_add(@*this.compiler, &result, (NameSyntax*)destructor, function_role::destructor, (ParseGuard*)guard, parser_cursor(terminal));
				};
				if (terminal.failure.message && (!failure.message || terminal.failure.offset > failure.offset)) {
					@failure := terminal.failure;
				};
				@destructors := destructors->next;
			};
		}
		else {
			function_role spelling := initial;
			if (token_is(names->value->token, "operator\0") && @ending.take(token_kind::op_assign)) {
				@spelling = function_role::assignment;
			};
			function_names_add(@*this.compiler, &result, NameSyntax*(names->value), (function_role)spelling, ParseGuard*(names->guard), parser_cursor(ending));
		};
		if (ending.failure.message && (!failure.message || ending.failure.offset > failure.offset)) {
			@failure := ending.failure;
		};
		@names := names->next;
	};
	if (result) {
		@this.failure = ParseFailure();
	}
	else {
		@this.failure := failure;
	};
	@memo->function_names = (FunctionNameParseResult*)result;
	@this.memo_finish((ParseMemo*)memo);
	@this.offset := memo->offset;
	@this.pending_greater := memo->pending_greater;
	return (FunctionNameParseResult*)memo->function_names;
};

fn Parser::source_enum_member_results(Parser& this) -> ParseResult<ValueSyntax>* {
	if (this.at(token_kind::kw_fn)) {
		return @this.source_declaration_results();
	};
	Parser member := this;
	Token name = @member.require(token_kind::identifier, "expected enum member identifier\0");
	if (member.failed()) {
		@this.failure := member.failure;
		return nullptr;
	};
	ParseResult<ValueSyntax>* values = nullptr;
	if (@member.take(token_kind::op_assign)) {
		@values = @member.value_until_results(2, source_delimiter::enum_member);
	}
	else {
		@values = @member.empty_result();
	};
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, member.failure, nullptr);
	while (values && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := values->end.offset;
		@ending.pending_greater := values->end.pending_greater;
		if (!@ending.take(token_kind::punct_semicolon) && !@ending.take(token_kind::punct_comma) && !ending.at(token_kind::punct_right_brace)) {
			@ending.error(ending.token(), "expected '}' after enum members\0");
		};
		if (!ending.failed()) {
			ValueSyntax* node = @this.new_value(syntax_kind::node_declaration, Token(name));
			if (!node) {
				return nullptr;
			};
			@node->data.declaration.name := name;
			@node->data.declaration.body := values->value;
			parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)node, ParseGuard*(values->guard), parser_cursor(ending), &pack_value);
		};
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(values->guard));
		@values := values->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::source_enum_members_results(Parser& this) -> ParseResult<ValueSyntax>* {
	return @this.source_sequence_query(token_kind::punct_right_brace, parse_memo_kind::enum_members);
};

fn Parser::source_enum_body_results(Parser& this) -> ParseResult<ValueSyntax>* {
	Parser opening := this;
	Token token = @opening.require(token_kind::punct_left_brace, "expected '{' after enum name\0");
	if (opening.failed()) {
		@this.failure := opening.failure;
		return nullptr;
	};
	ParseResult<ValueSyntax>* members = @opening.source_enum_members_results();
	@this.failure := opening.failure;
	ParseResult<ValueSyntax>* results = nullptr;
	while (members && this.compiler->result != compilation_result::failure) {
		ValueSyntax* block = @this.new_value(syntax_kind::node_block, Token(token));
		if (!block) {
			return nullptr;
		};
		@block->data.statements := members->value;
		parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)block, ParseGuard*(members->guard), members->end, &pack_value);
		@members := members->next;
	};
	return (ParseResult<ValueSyntax>*)results;
};

fn source_header_copy(Compiler& compiler, SourceDeclaration* source) -> SourceDeclaration* {
	SourceDeclaration* result = (SourceDeclaration*)memory_allocate(@compiler, sizeof(SourceDeclaration));
	if (result) {
		@*result := *source;
	};
	return (SourceDeclaration*)result;
};

fn Parser::source_parameter_rest(Parser& this, TemplateParameter* parameter, ParseGuard* guard, ParseResult<TemplateParameter>** results) {
	ParseResult<TemplateParameter>* rest = nullptr;
	if (@this.take(token_kind::punct_comma) && !this.at(token_kind::op_greater) && !this.at(token_kind::op_shift_right)) {
		@rest = @this.source_parameter_results();
	}
	else {
		@this.template_close();
		if (this.failed()) {
			return;
		};
		@rest = (ParseResult<TemplateParameter>*)memory_allocate(@*this.compiler, sizeof(ParseResult<TemplateParameter>));
		if (rest) {
			@rest->end = parser_cursor(this);
		};
	};
	while (rest && this.compiler->result != compilation_result::failure) {
		TemplateParameter* suffix := rest->value;
		while (suffix) {
			if (token_same(parameter->name, suffix->name)) {
				@this.error(parameter->name, "duplicate template parameter\0");
				return;
			};
			@suffix := suffix->next;
		};
		TemplateParameter* prefix = (TemplateParameter*)memory_allocate(@*this.compiler, sizeof(TemplateParameter));
		if (!prefix) {
			return;
		};
		@*prefix := *parameter;
		@prefix->next := rest->value;
		ParseGuard* selected = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)guard, (ParseGuard*)rest->guard);
		parse_result_push<TemplateParameter>(@*this.compiler, (ParseResult<TemplateParameter>**)results, (TemplateParameter*)prefix, (ParseGuard*)selected, rest->end);
		@rest := rest->next;
	};
};

fn Parser::source_parameter_default_results(Parser& this, TemplateParameter* parameter, ParseResult<TemplateParameter>** results) {
	@parameter->name = @this.require(token_kind::identifier, "expected template parameter name\0");
	if (this.failed()) {
		return;
	};
	if (!@this.take(token_kind::op_assign)) {
		@this.source_parameter_rest((TemplateParameter*)parameter, nullptr, (ParseResult<TemplateParameter>**)results);
		return;
	};
	ParseResult<ArgumentSyntax>* defaults = @this.source_argument_results();
	while (defaults && this.compiler->result != compilation_result::failure) {
		if ((parameter->kind == template_parameter_kind::type && !defaults->value->type) || (parameter->kind == template_parameter_kind::value && !defaults->value->value)) {
			@defaults := defaults->next;
			continue;
		};
		ParseGuard* role := defaults->value->value_guard;
		if (parameter->kind == template_parameter_kind::type) {
			@role := defaults->value->type_guard;
		};
		ParseGuard* selected = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)defaults->guard, (ParseGuard*)role);
		Parser continuation := this;
		@continuation.failure = ParseFailure();
		@continuation.offset := defaults->end.offset;
		@continuation.pending_greater := defaults->end.pending_greater;
		TemplateParameter* input = (TemplateParameter*)memory_allocate(@*this.compiler, sizeof(TemplateParameter));
		if (!input) {
			return;
		};
		@*input := *parameter;
		@input->default_argument := defaults->value;
		@continuation.source_parameter_rest((TemplateParameter*)input, (ParseGuard*)selected, (ParseResult<TemplateParameter>**)results);
		@defaults := defaults->next;
	};
};

fn Parser::source_parameter_results(Parser& this) -> ParseResult<TemplateParameter>* {
	ParseResult<TemplateParameter>* result = nullptr;
	if (@this.take(token_kind::kw_typename) || @this.take(token_kind::kw_class)) {
		TemplateParameter* parameter = (TemplateParameter*)memory_allocate(@*this.compiler, sizeof(TemplateParameter));
		if (!parameter) {
			return nullptr;
		};
		@parameter->kind = template_parameter_kind::type;
		@this.source_parameter_default_results((TemplateParameter*)parameter, &result);
		return (ParseResult<TemplateParameter>*)result;
	};
	ParseResult<TypeSyntax>* types = @this.type_results();
	while (types && this.compiler->result != compilation_result::failure) {
		Parser continuation := this;
		@continuation.failure = ParseFailure();
		@continuation.offset := types->end.offset;
		@continuation.pending_greater := types->end.pending_greater;
		TemplateParameter* parameter = (TemplateParameter*)memory_allocate(@*this.compiler, sizeof(TemplateParameter));
		if (!parameter) {
			return nullptr;
		};
		@parameter->kind = template_parameter_kind::value;
		@parameter->type = type_guarded(@*this.compiler, TypeSyntax*(types->value), ParseGuard*(types->guard));
		@continuation.source_parameter_default_results((TemplateParameter*)parameter, &result);
		@types := types->next;
	};
	return (ParseResult<TemplateParameter>*)result;
};

fn Parser::source_parameters_results(Parser& this) -> ParseResult<TemplateParameter>* {
	@this.require(token_kind::kw_template, "expected template\0");
	@this.require(token_kind::op_less, "expected '<' after template\0");
	if (this.at(token_kind::op_greater) || this.at(token_kind::op_shift_right)) {
		@this.error(this.token(), "explicit template specialization is not supported yet\0");
		return nullptr;
	};
	return @this.source_parameter_results();
};

fn Parser::source_bases_results(Parser& this) -> ParseResult<SourceBase>* {
	base_kind kind = base_kind::nonvirtual;
	if (@this.take(token_kind::kw_virtual)) {
		@kind = base_kind::kw_virtual;
	};
	ParseResult<SourceBase>* result = nullptr;
	ParseResult<NameSyntax>* names = @this.source_name_results();
	while (names && this.compiler->result != compilation_result::failure) {
		Parser continuation := this;
		@continuation.failure = ParseFailure();
		@continuation.offset := names->end.offset;
		@continuation.pending_greater := names->end.pending_greater;
		ParseResult<SourceBase>* rest = nullptr;
		if (@continuation.take(token_kind::punct_comma)) {
			@rest = @continuation.source_bases_results();
		}
		else {
			@rest = (ParseResult<SourceBase>*)memory_allocate(@*this.compiler, sizeof(ParseResult<SourceBase>));
			if (rest) {
				@rest->end = parser_cursor(continuation);
			};
		};
		while (rest && this.compiler->result != compilation_result::failure) {
			SourceBase* base = (SourceBase*)memory_allocate(@*this.compiler, sizeof(SourceBase));
			if (!base) {
				return nullptr;
			};
			@base->name = name_guarded(@*this.compiler, NameSyntax*(names->value), ParseGuard*(names->guard));
			@base->kind := kind;
			@base->next := rest->value;
			parse_result_push<SourceBase>(@*this.compiler, &result, (SourceBase*)base, (ParseGuard*)rest->guard, rest->end);
			@rest := rest->next;
		};
		@names := names->next;
	};
	return (ParseResult<SourceBase>*)result;
};

fn Parser::source_function_modifiers(Parser& this, SourceDeclaration& declaration) {
	if (!@this.take(token_kind::punct_colon)) {
		return;
	};
	@this.require(token_kind::punct_left_bracket, "expected '[' after modifier colon\0");
	if (this.at(token_kind::punct_right_bracket)) {
		@this.error(this.token(), "modifier list cannot be empty\0");
		return;
	};
	while (!this.failed()) {
		Token modifier = this.token();
		if (@this.take(token_kind::kw_delete) || @this.take(token_kind::kw_default)) {
			if (declaration.definition != function_definition::declaration) {
				@this.error(modifier, "duplicate or conflicting function modifier\0");
				return;
			};
			if (modifier.kind == token_kind::kw_delete) {
				@declaration.definition = function_definition::deleted;
			}
			else {
				@declaration.definition = function_definition::defaulted;
			};
		}
		else if (@this.take(token_kind::kw_implicit)) {
			if (declaration.conversion == constructor_conversion::kw_implicit) {
				@this.error(modifier, "duplicate or conflicting function modifier\0");
				return;
			};
			@declaration.conversion = constructor_conversion::kw_implicit;
		}
		else if (@this.take(token_kind::kw_virtual) || @this.take(token_kind::kw_override) || @this.take(token_kind::kw_final)) {
			if (declaration.modification != function_modification::ordinary) {
				@this.error(modifier, "duplicate or conflicting function modifier\0");
				return;
			};
			if (modifier.kind == token_kind::kw_virtual) {
				@declaration.modification = function_modification::kw_virtual;
			}
			else if (modifier.kind == token_kind::kw_override) {
				@declaration.modification = function_modification::kw_override;
			}
			else {
				@declaration.modification = function_modification::kw_final;
			};
		}
		else {
			@this.error(modifier, "expected delete, default, implicit, virtual, override, or final modifier\0");
			return;
		};
		if (!@this.take(token_kind::punct_comma)) {
			break;
		};
	};
	@this.require(token_kind::punct_right_bracket, "expected ']' after function modifiers\0");
};

fn Parser::source_header_body_results(Parser& this, SourceDeclaration* header) -> ParseResult<ValueSyntax>* {
	if (header->token.kind == token_kind::kw_fn) {
		@this.source_function_modifiers(@*header);
	};
	if (this.failed()) {
		return nullptr;
	};
	ParseResult<ValueSyntax>* bodies = nullptr;
	if (this.at(token_kind::punct_left_brace)) {
		if (header->definition == function_definition::deleted || header->definition == function_definition::defaulted) {
			@this.error(header->token, "deleted or defaulted function cannot have a body\0");
			return nullptr;
		};
		if (header->token.kind == token_kind::kw_enum) {
			@bodies = @this.source_enum_body_results();
		}
		else {
			@bodies = @this.source_block_results();
		};
	}
	else if (header->token.kind == token_kind::kw_namespace) {
		@this.error(this.token(), "expected namespace body\0");
		return nullptr;
	}
	else {
		@bodies = @this.empty_result();
	};
	ParseResult<ValueSyntax>* results = nullptr;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (bodies && this.compiler->result != compilation_result::failure) {
		Parser ending := this;
		@ending.failure = ParseFailure();
		@ending.offset := bodies->end.offset;
		@ending.pending_greater := bodies->end.pending_greater;
		SourceDeclaration* declaration = source_header_copy(@*this.compiler, (SourceDeclaration*)header);
		if (!declaration) {
			return nullptr;
		};
		@declaration->body := bodies->value;
		if (declaration->body && declaration->token.kind == token_kind::kw_fn) {
			@declaration->definition = function_definition::definition;
		};
		if (declaration->bases && !declaration->body) {
			@ending.error(declaration->token, "base relationships require a struct definition\0");
		};
		if (declaration->parameters && declaration->token.kind != token_kind::kw_fn) {
			TemplateParameter* parameter := declaration->parameters;
			TemplateParameter* defaulted = nullptr;
			while (parameter) {
				if (parameter->default_argument) {
					@defaulted := parameter;
				}
				else if (defaulted) {
					@ending.error(parameter->name, "class template parameters after a default must also have defaults\0");
					break;
				};
				@parameter := parameter->next;
			};
		};
		@ending.require(token_kind::punct_semicolon, "expected ';' after declaration\0");
		parse_failure_record(@*this.compiler, &failures, ending.failure, ParseGuard*(bodies->guard));
		if (!ending.failed()) {
			ValueSyntax* node = @this.new_value(syntax_kind::node_source_declaration, Token(declaration->token));
			if (!node) {
				return nullptr;
			};
			@node->data.source_declaration = (SourceDeclaration*)declaration;
			parse_result_add<ValueSyntax>(@*this.compiler, &results, (ValueSyntax*)node, ParseGuard*(bodies->guard), parser_cursor(ending), &pack_value);
		};
		@bodies := bodies->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)results, (ParseFailureArm*)failures);
};

fn Parser::source_header_modifiers_results(Parser& this, SourceDeclaration* header) -> ParseResult<ValueSyntax>* {
	if (header->token.kind == token_kind::kw_fn || !@this.take(token_kind::punct_colon)) {
		if (header->token.kind == token_kind::kw_enum) {
			@this.error(header->token, "enum declaration requires an explicit underlying type ': [type]'\0");
			return nullptr;
		};
		return @this.source_header_body_results((SourceDeclaration*)header);
	};
	@this.require(token_kind::punct_left_bracket, "expected '[' after modifier colon\0");
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	if (header->token.kind == token_kind::kw_enum) {
		ParseResult<TypeSyntax>* types = @this.type_results();
		while (types && this.compiler->result != compilation_result::failure) {
			Parser continuation := this;
			@continuation.failure = ParseFailure();
			@continuation.offset := types->end.offset;
			@continuation.pending_greater := types->end.pending_greater;
			@continuation.require(token_kind::punct_right_bracket, "expected ']' after enum underlying type\0");
			SourceDeclaration* declaration = source_header_copy(@*this.compiler, (SourceDeclaration*)header);
			if (!declaration) {
				return nullptr;
			};
			@declaration->type = type_guarded(@*this.compiler, TypeSyntax*(types->value), ParseGuard*(types->guard));
			ParseResult<ValueSyntax>* outputs = @continuation.source_header_body_results((SourceDeclaration*)declaration);
			@outputs = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)outputs, (ParseGuard*)types->guard);
			parse_failure_record(@*this.compiler, &failures, continuation.failure, (ParseGuard*)types->guard);
			parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)outputs);
			@types := types->next;
		};
	}
	else if (header->token.kind == token_kind::kw_struct) {
		if (this.at(token_kind::punct_right_bracket)) {
			@this.error(this.token(), "modifier list cannot be empty\0");
			return nullptr;
		};
		ParseResult<SourceBase>* bases = @this.source_bases_results();
		while (bases && this.compiler->result != compilation_result::failure) {
			Parser continuation := this;
			@continuation.failure = ParseFailure();
			@continuation.offset := bases->end.offset;
			@continuation.pending_greater := bases->end.pending_greater;
			@continuation.require(token_kind::punct_right_bracket, "expected ']' after base relationships\0");
			SourceDeclaration* declaration = source_header_copy(@*this.compiler, (SourceDeclaration*)header);
			if (!declaration) {
				return nullptr;
			};
			@declaration->bases := bases->value;
			ParseResult<ValueSyntax>* outputs = @continuation.source_header_body_results((SourceDeclaration*)declaration);
			@outputs = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)outputs, ParseGuard*(bases->guard));
			parse_failure_record(@*this.compiler, &failures, continuation.failure, ParseGuard*(bases->guard));
			parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)outputs);
			@bases := bases->next;
		};
	}
	else {
		@this.error(header->token, "base relationships require a struct declaration\0");
	};
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn Parser::source_named_header_results(Parser& this, TemplateParameter* parameters) -> ParseResult<ValueSyntax>* {
	Token token = this.token();
	@this.take((token_kind)token.kind);
	if (parameters && token.kind != token_kind::kw_fn && token.kind != token_kind::kw_struct && token.kind != token_kind::kw_union) {
		@this.error(token, "template requires a struct, union, or function declaration\0");
		return nullptr;
	};
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	if (token.kind == token_kind::kw_fn) {
		FunctionNameParseResult* names = @this.source_function_name_results();
		while (names && this.compiler->result != compilation_result::failure) {
			Parser signature := this;
			@signature.failure = ParseFailure();
			@signature.offset := names->end.offset;
			@signature.pending_greater := names->end.pending_greater;
			ParseResult<TypeSyntax>* types = @signature.signature_results(Token(token));
			while (types && this.compiler->result != compilation_result::failure) {
				Parser continuation := this;
				@continuation.failure = ParseFailure();
				@continuation.offset := types->end.offset;
				@continuation.pending_greater := types->end.pending_greater;
				SourceDeclaration* declaration = (SourceDeclaration*)memory_allocate(@*this.compiler, sizeof(SourceDeclaration));
				if (!declaration) {
					return nullptr;
				};
				@declaration->token := token;
				@declaration->parameters := parameters;
				@declaration->path = name_guarded(@*this.compiler, NameSyntax*(names->name), ParseGuard*(names->guard));
				@declaration->spelling := names->spelling;
				@declaration->type = type_guarded(@*this.compiler, TypeSyntax*(types->value), ParseGuard*(types->guard));
				ParseGuard* guard = parse_guard(@*this.compiler, parse_guard_kind::conjunction, (ParseGuard*)names->guard, (ParseGuard*)types->guard);
				ParseResult<ValueSyntax>* outputs = @continuation.source_header_modifiers_results((SourceDeclaration*)declaration);
				@outputs = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)outputs, (ParseGuard*)guard);
				parse_failure_record(@*this.compiler, &failures, continuation.failure, (ParseGuard*)guard);
				parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)outputs);
				@types := types->next;
			};
			parse_failure_record(@*this.compiler, &failures, signature.failure, (ParseGuard*)names->guard);
			@names := names->next;
		};
	}
	else {
		ParseResult<NameSyntax>* names = @this.source_name_results();
		while (names && this.compiler->result != compilation_result::failure) {
			Parser continuation := this;
			@continuation.failure = ParseFailure();
			@continuation.offset := names->end.offset;
			@continuation.pending_greater := names->end.pending_greater;
			SourceDeclaration* declaration = (SourceDeclaration*)memory_allocate(@*this.compiler, sizeof(SourceDeclaration));
			if (!declaration) {
				return nullptr;
			};
			@declaration->token := token;
			@declaration->parameters := parameters;
			@declaration->path = name_guarded(@*this.compiler, NameSyntax*(names->value), ParseGuard*(names->guard));
			ParseResult<ValueSyntax>* outputs = @continuation.source_header_modifiers_results((SourceDeclaration*)declaration);
			parse_failure_record(@*this.compiler, &failures, continuation.failure, nullptr);
			parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)outputs);
			@names := names->next;
		};
	};
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn Parser::source_declaration_results(Parser& this) -> ParseResult<ValueSyntax>* {
	if (!this.at(token_kind::kw_template)) {
		return @this.source_named_header_results(nullptr);
	};
	ParseResult<TemplateParameter>* parameters = @this.source_parameters_results();
	ParseResult<ValueSyntax>* result = nullptr;
	ParseFailureArm* failures = nullptr;
	parse_failure_record(@*this.compiler, &failures, this.failure, nullptr);
	while (parameters && this.compiler->result != compilation_result::failure) {
		Parser continuation := this;
		@continuation.failure = ParseFailure();
		@continuation.offset := parameters->end.offset;
		@continuation.pending_greater := parameters->end.pending_greater;
		ParseResult<ValueSyntax>* outputs = @continuation.source_named_header_results(TemplateParameter*(parameters->value));
		@outputs = parse_results_guard(@*this.compiler, (ParseResult<ValueSyntax>*)outputs, ParseGuard*(parameters->guard));
		parse_failure_record(@*this.compiler, &failures, continuation.failure, ParseGuard*(parameters->guard));
		parse_results_merge(@*this.compiler, &result, (ParseResult<ValueSyntax>*)outputs);
		@parameters := parameters->next;
	};
	return @this.value_results_finish((ParseResult<ValueSyntax>*)result, (ParseFailureArm*)failures);
};

fn source_namespace_scope(Compiler& compiler, Scope* scope, NameSyntax* path) -> Scope* {
	@path = name_source_select(@compiler, (Scope*)scope, (NameSyntax*)path);
	if (!path) {
		return nullptr;
	};
	if (path->qualifier) {
		@scope = source_namespace_scope(@compiler, (Scope*)scope, (NameSyntax*)path->qualifier);
		if (!scope) {
			return nullptr;
		};
	};
	Entity* entity = namespace_define(@compiler, (Scope*)scope, Token(path->token));
	if (!entity) {
		return nullptr;
	};
	return entity_members((Entity*)entity);
};

fn source_bases_lower(Compiler& compiler, SourceBase* source) -> BaseRelation* {
	BaseRelation* first = nullptr;
	BaseRelation** tail = &first;
	while (source) {
		BaseRelation* base = (BaseRelation*)memory_allocate(@compiler, sizeof(BaseRelation));
		if (!base) {
			return nullptr;
		};
		@base->kind := source->kind;
		@base->name := source->name;
		@*tail := base;
		@tail = &base->next;
		@source := source->next;
	};
	return (BaseRelation*)first;
};

fn source_declaration_role(Scope* owner, SourceDeclaration* source) -> function_role {
	if (source->token.kind != token_kind::kw_fn) {
		return function_role::ordinary;
	};
	if (source->spelling != function_role::ordinary) {
		return (function_role)source->spelling;
	};
	Entity* aggregate := owner->owner;
	if (aggregate && (aggregate->kind == entity_kind::kw_struct || aggregate->kind == entity_kind::kw_union || aggregate->kind == entity_kind::kw_enum) && token_same(source->path->token, aggregate->name)) {
		return function_role::constructor;
	};
	return function_role::ordinary;
};

struct SourceTraversal {
	ValueSyntax* value;
	SourceTraversal* next;
};

struct SourceVisit {
	resolution state;
};

fn source_traversal_push(Compiler& compiler, SourceTraversal** pending, ValueSyntax* value) {
	if (!value) {
		return;
	};
	SourceTraversal* item = (SourceTraversal*)memory_allocate(@compiler, sizeof(SourceTraversal));
	if (!item) {
		return;
	};
	@item->value := value;
	@item->next := *pending;
	@*pending := item;
};

fn source_collect_sequence(Compiler& compiler, Scope* scope, ValueSyntax* source, declaration_phase phase) {
	IdentityMap<SourceVisit> visited;
	SourceTraversal* pending = nullptr;
	source_traversal_push(@compiler, &pending, (ValueSyntax*)source);
	while (pending && compiler.result != compilation_result::failure) {
		@source := pending->value;
		@pending := pending->next;
		while (source && compiler.result != compilation_result::failure) {
			SourceVisit* visit = identity_record<SourceVisit>(@compiler, @visited, (const void*)source, (const void*)scope);
			if (!visit || visit->state == resolution::ready) {
				break;
			};
			@visit->state = resolution::ready;
			if (source->kind == syntax_kind::source_list) {
				source_traversal_push(@compiler, &pending, (ValueSyntax*)source->data.binary.right);
				@source := source->data.binary.left;
				continue;
			};
			if (source->kind == syntax_kind::source_choice) {
				SourceArm* arm := source->data.choice->first;
				while (arm) {
					source_traversal_push(@compiler, &pending, (ValueSyntax*)arm->value);
					@arm := arm->next;
				};
			}
			else if (source->kind == syntax_kind::node_source_declaration) {
				source_collect_declaration(@compiler, (Scope*)scope, (SourceDeclaration*)source->data.source_declaration, (declaration_phase)phase);
			};
			@source := source->next;
		};
	};
};

fn source_collect_block(Compiler& compiler, Scope* scope, ValueSyntax* block, declaration_phase phase) {
	if (!block) {
		return;
	};
	source_collect_sequence(@compiler, (Scope*)scope, (ValueSyntax*)block->data.statements, (declaration_phase)phase);
};

fn source_collect_declaration(Compiler& compiler, Scope* scope, SourceDeclaration* source, declaration_phase phase) -> SourceBinding* {
	SourceBinding* binding = identity_record<SourceBinding>(@compiler, @compiler.semantic.source_bindings, (const void*)source, (const void*)scope);
	if (!binding) {
		return nullptr;
	};
	if (source->parameters && binding->kind != source_binding_kind::instance) {
		if (!binding->entity) {
			@binding->entity = source_template_register(@compiler, (Scope*)scope, (SourceDeclaration*)source);
			@binding->owner := scope;
		};
		return (SourceBinding*)binding;
	};
	NameSyntax* path = name_source_select(@compiler, (Scope*)scope, (NameSyntax*)source->path);
	if (!path) {
		return nullptr;
	};
	if (source->token.kind == token_kind::kw_namespace) {
		if (scope->context != context_kind::module) {
			compiler_error(@compiler, source->token, "namespace requires module context\0");
			return nullptr;
		};
		Scope* members = source_namespace_scope(@compiler, (Scope*)scope, (NameSyntax*)source->path);
		if (!members) {
			return nullptr;
		};
		@binding->entity := members->owner;
		@binding->owner := scope;
		source_collect_block(@compiler, (Scope*)members, (ValueSyntax*)source->body, (declaration_phase)phase);
		return (SourceBinding*)binding;
	};
	Scope* owner := scope;
	if (path->qualifier && phase == declaration_phase::identities) {
		return (SourceBinding*)binding;
	};
	if (path->qualifier) {
		Entity* entity = name_resolve(@compiler, (Scope*)scope, (NameSyntax*)path->qualifier);
		@owner = entity_members((Entity*)entity);
		if (!owner) {
			if (phase == declaration_phase::identities) {
				return (SourceBinding*)binding;
			};
			compiler_error(@compiler, path->token, "qualified declaration owner has no associated scope\0");
			return nullptr;
		};
	};
	@binding->owner := owner;
	DeclarationRule* rule = declaration_rule(@compiler, (token_kind)source->token.kind);
	function_role role = source_declaration_role((Scope*)owner, (SourceDeclaration*)source);
	if (rule && role == function_role::ordinary && !binding->entity) {
		@binding->entity = declaration_entity(@compiler, (Scope*)owner, (entity_kind)rule->entity, Token(path->token));
	};
	Entity* entity := binding->entity;
	if (entity && entity->kind == entity_kind::kw_struct && source->bases && !entity->data.aggregate.bases) {
		@entity->data.aggregate.bases = source_bases_lower(@compiler, (SourceBase*)source->bases);
	};
	if (entity && source->body && (entity->kind == entity_kind::kw_struct || entity->kind == entity_kind::kw_union)) {
		source_collect_block(@compiler, entity_members((Entity*)entity), (ValueSyntax*)source->body, (declaration_phase)phase);
	};
	return (SourceBinding*)binding;
};

fn source_block_lower(Compiler& compiler, Scope* scope, ValueSyntax* source) -> Syntax* {
	if (!source) {
		return nullptr;
	};
	Syntax* block = syntax_create(@compiler, syntax_kind::node_block, Token(source->token));
	if (!block) {
		return nullptr;
	};
	@block->scope := scope;
	@block->data.statements = value_lower_list(@compiler, (Scope*)scope, (ValueSyntax*)source->data.statements);
	return (Syntax*)block;
};

// Call after all module identities/member declarations have been collected, when
// lowering a source template declaration. Never instantiate a dummy specialization.
// This pass checks names and declaration shape; it deliberately does not resolve
// ordinary field storage types (an unused void& field is accepted by the seed).

fn generic_entity_dependent(Entity* entity) -> bool {
	if (!entity) {
		return false;
	};
	if (entity->template_parameter) {
		return true;
	};
	return entity->kind == entity_kind::primitive && type_dependent((Type*)entity->data.primitive.type);
};

fn generic_type_dependent(Scope* scope, TypeSyntax* type) -> bool {
	if (!type) {
		return false;
	};
	switch (type->kind) {
		case type_syntax_kind::choice: {
			TypeChoice* choice := type->data.choices;
			while (choice) {
				if (generic_type_dependent((Scope*)scope, (TypeSyntax*)choice->type)) {
					return true;
				};
				@choice := choice->next;
			};
			return false;
		};
		case type_syntax_kind::name:
			return generic_name_dependent((Scope*)scope, (NameSyntax*)type->data.name);
		case type_syntax_kind::qualified:
		case type_syntax_kind::pointer:
		case type_syntax_kind::reference:
			return generic_type_dependent((Scope*)scope, (TypeSyntax*)type->data.element);
		case type_syntax_kind::array:
			return generic_type_dependent((Scope*)scope, (TypeSyntax*)type->data.array.element) || (type->data.array.count.kind == token_kind::identifier && generic_entity_dependent(scope_lookup((Scope*)scope, type->data.array.count)));
		case type_syntax_kind::function: {
			if (generic_type_dependent((Scope*)scope, (TypeSyntax*)type->data.signature.result)) {
				return true;
			};
			ParameterSyntax* parameter := type->data.signature.parameters;
			while (parameter) {
				if (generic_type_dependent((Scope*)scope, (TypeSyntax*)parameter->type)) {
					return true;
				};
				@parameter := parameter->next;
			};
			return false;
		};
	};
	return false;
};

fn generic_value_dependent(Scope* scope, ValueSyntax* value) -> bool {
	if (!value) {
		return false;
	};
	switch (value->kind) {
		case syntax_kind::source_choice: {
			SourceArm* arm := value->data.choice->first;
			while (arm) {
				if (generic_value_dependent((Scope*)scope, (ValueSyntax*)arm->value)) {
					return true;
				};
				@arm := arm->next;
			};
			return false;
		};
		case syntax_kind::source_expression_chain:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.chain->head) || generic_tail_dependent((Scope*)scope, (ExpressionTail*)value->data.chain->tail);
		case syntax_kind::node_block:
			return generic_value_list_dependent((Scope*)scope, (ValueSyntax*)value->data.statements);
		case syntax_kind::node_declaration:
			return generic_type_dependent((Scope*)scope, (TypeSyntax*)value->data.declaration.type) || generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.declaration.body);
		case syntax_kind::expr_name:
			return generic_name_dependent((Scope*)scope, (NameSyntax*)value->data.name);
		case syntax_kind::expr_destroy:
		case syntax_kind::expr_cast:
		case syntax_kind::expr_typed_apply:
		case syntax_kind::kw_sizeof:
			return generic_type_dependent((Scope*)scope, (TypeSyntax*)value->data.typed.type) || generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.typed.value);
		case syntax_kind::expr_call:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.call.callable) || generic_value_list_dependent((Scope*)scope, (ValueSyntax*)value->data.call.arguments);
		case syntax_kind::expr_member:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.member.object) || generic_name_dependent((Scope*)scope, (NameSyntax*)value->data.member.name);
		case syntax_kind::source_list:
		case syntax_kind::expr_binary:
		case syntax_kind::expr_index:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.binary.left) || generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.binary.right);
		case syntax_kind::expr_unary:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.binary.left);
		case syntax_kind::kw_new:
		case syntax_kind::kw_delete:
		case syntax_kind::expr_delete_discard:
		case syntax_kind::kw_discard:
		case syntax_kind::expr_access:
		case syntax_kind::expr_relocate:
			return generic_value_dependent((Scope*)scope, (ValueSyntax*)value->data.expression);
	};
	return false;
};

fn generic_value_list_dependent(Scope* scope, ValueSyntax* value) -> bool {
	while (value) {
		if (generic_value_dependent((Scope*)scope, (ValueSyntax*)value)) {
			return true;
		};
		@value := value->next;
	};
	return false;
};

fn generic_name_dependent(Scope* scope, NameSyntax* name) -> bool {
	if (!name) {
		return false;
	};
	NameChoice* choice := name->choices;
	while (choice) {
		if (generic_name_dependent((Scope*)scope, (NameSyntax*)choice->name)) {
			return true;
		};
		@choice := choice->next;
	};
	if (name->qualifier && generic_name_dependent((Scope*)scope, (NameSyntax*)name->qualifier)) {
		return true;
	};
	if (!name->qualifier && generic_entity_dependent(scope_lookup((Scope*)scope, name->token))) {
		return true;
	};
	return generic_arguments_dependent((Scope*)scope, (ArgumentListSyntax*)name->arguments);
};

fn generic_arguments_dependent(Scope* scope, ArgumentListSyntax* arguments) -> bool {
	while (arguments) {
		ArgumentListArm* choice := arguments->choices;
		while (choice) {
			if (generic_arguments_dependent((Scope*)scope, (ArgumentListSyntax*)choice->arguments)) {
				return true;
			};
			@choice := choice->next;
		};
		ArgumentSyntax* argument := arguments->first;
		if (argument && (generic_type_dependent((Scope*)scope, (TypeSyntax*)argument->type) || generic_value_dependent((Scope*)scope, (ValueSyntax*)argument->value))) {
			return true;
		};
		@arguments := arguments->rest;
	};
	return false;
};

fn generic_tail_dependent(Scope* scope, ExpressionTail* tail) -> bool {
	while (tail) {
		TailArm* choice := tail->choices;
		while (choice) {
			if (generic_tail_dependent((Scope*)scope, (ExpressionTail*)choice->tail)) {
				return true;
			};
			@choice := choice->next;
		};
		if (generic_value_dependent((Scope*)scope, (ValueSyntax*)tail->operation)) {
			return true;
		};
		@tail := tail->next;
	};
	return false;
};

fn generic_type_names_validate(Compiler& compiler, Scope* scope, TypeSyntax* type) {
	if (!type || compiler.result == compilation_result::failure) {
		return;
	};
	if (!generic_type_role_safe((Scope*)scope, (TypeSyntax*)type)) {
		return;
	};
	@type = type_source_select(@compiler, (Scope*)scope, (TypeSyntax*)type);
	if (!type) {
		return;
	};
	switch (type->kind) {
		case type_syntax_kind::name: {
			NameSyntax* name := type->data.name;
			if (generic_name_dependent((Scope*)scope, (NameSyntax*)name)) {
				return;
			};
			Entity* entity = name_resolve(@compiler, (Scope*)scope, (NameSyntax*)name);
			if (!entity || (entity->kind != entity_kind::primitive && entity->kind != entity_kind::kw_struct && entity->kind != entity_kind::kw_union && entity->kind != entity_kind::kw_enum && entity->kind != entity_kind::kw_template)) {
				if (compiler.result != compilation_result::failure) {
					compiler_error(@compiler, name->token, "identifier does not name a type entity\0");
				};
			};
			break;
		};
		case type_syntax_kind::qualified:
		case type_syntax_kind::pointer:
		case type_syntax_kind::reference:
			generic_type_names_validate(@compiler, (Scope*)scope, (TypeSyntax*)type->data.element);
			break;
		case type_syntax_kind::array:
			generic_type_names_validate(@compiler, (Scope*)scope, (TypeSyntax*)type->data.array.element);
			break;
		case type_syntax_kind::function: {
			generic_type_names_validate(@compiler, (Scope*)scope, (TypeSyntax*)type->data.signature.result);
			ParameterSyntax* parameter := type->data.signature.parameters;
			while (parameter && compiler.result != compilation_result::failure) {
				generic_type_names_validate(@compiler, (Scope*)scope, (TypeSyntax*)parameter->type);
				@parameter := parameter->next;
			};
			break;
		};
	};
};

fn generic_parameters_scope(Compiler& compiler, Scope* parent, TemplateParameter* parameters) -> Scope* {
	Scope* scope = scope_create(@compiler, (Scope*)parent, context_kind::module, nullptr);
	if (!scope) {
		return nullptr;
	};
	TemplateParameter* parameter := parameters;
	while (parameter && compiler.result != compilation_result::failure) {
		Entity* entity = entity_create(@compiler, entity_kind::primitive, Token(parameter->name));
		if (!entity) {
			return nullptr;
		};
		@entity->state = resolution::ready;
		@entity->template_parameter := parameter;
		if (parameter->kind == template_parameter_kind::type) {
			@entity->data.primitive.type = type_entity(@compiler, type_kind::parameter, (Entity*)entity);
		}
		else {
			Type* type = type_resolve(@compiler, (Scope*)scope, (TypeSyntax*)parameter->type);
			if (compiler.result == compilation_result::failure) {
				return nullptr;
			};
			if (!type_integer((Type*)type) && !type_dependent((Type*)type)) {
				compiler_error(@compiler, parameter->name, "non-type template parameter requires an integral type\0");
				return nullptr;
			};
			@entity->kind = entity_kind::variable;
			@entity->data.variable.storage = storage_kind::constant;
			@entity->data.variable.type = (Type*)type;
		};
		scope_define(@compiler, (Scope*)scope, (Entity*)entity);
		@parameter := parameter->next;
	};
	return (Scope*)scope;
};

fn generic_name_role_safe(Scope* scope, NameSyntax* name) -> bool {
	if (!name) {
		return true;
	};
	NameChoice* choice := name->choices;
	while (choice) {
		if (!generic_guard_safe((Scope*)scope, (ParseGuard*)choice->guard) || !generic_name_role_safe((Scope*)scope, (NameSyntax*)choice->name)) {
			return false;
		};
		@choice := choice->next;
	};
	return !name->qualifier || !generic_name_dependent((Scope*)scope, (NameSyntax*)name->qualifier);
};

fn generic_type_role_safe(Scope* scope, TypeSyntax* type) -> bool {
	if (!type) {
		return true;
	};
	switch (type->kind) {
		case type_syntax_kind::choice: {
			TypeChoice* choice := type->data.choices;
			while (choice) {
				if (!generic_guard_safe((Scope*)scope, (ParseGuard*)choice->guard) || !generic_type_role_safe((Scope*)scope, (TypeSyntax*)choice->type)) {
					return false;
				};
				@choice := choice->next;
			};
			return true;
		};
		case type_syntax_kind::name: return generic_name_role_safe((Scope*)scope, (NameSyntax*)type->data.name);
		case type_syntax_kind::qualified:
		case type_syntax_kind::pointer:
		case type_syntax_kind::reference: return generic_type_role_safe((Scope*)scope, (TypeSyntax*)type->data.element);
		case type_syntax_kind::array: return generic_type_role_safe((Scope*)scope, (TypeSyntax*)type->data.array.element);
		case type_syntax_kind::function: {
			ParameterSyntax* parameter := type->data.signature.parameters;
			while (parameter) {
				if (!generic_type_role_safe((Scope*)scope, (TypeSyntax*)parameter->type)) {
					return false;
				};
				@parameter := parameter->next;
			};
			return generic_type_role_safe((Scope*)scope, (TypeSyntax*)type->data.signature.result);
		};
	};
	return true;
};

fn generic_guard_safe(Scope* scope, ParseGuard* guard) -> bool {
	if (!guard) {
		return true;
	};
	if (guard->kind == parse_guard_kind::decision) {
		if (guard->choice.kind == parse_choice_kind::template_name) {
			return generic_name_role_safe((Scope*)scope, (NameSyntax*)guard->choice.name);
		};
		return generic_type_role_safe((Scope*)scope, (TypeSyntax*)guard->choice.type);
	};
	return generic_guard_safe((Scope*)scope, (ParseGuard*)guard->left) && generic_guard_safe((Scope*)scope, (ParseGuard*)guard->right);
};

fn generic_members_validate(Compiler& compiler, Scope* members, ValueSyntax* statement, declaration_phase phase) {
	while (statement && compiler.result != compilation_result::failure) {
		if (statement->kind == syntax_kind::source_list) {
			generic_members_validate(@compiler, (Scope*)members, (ValueSyntax*)statement->data.binary.left, (declaration_phase)phase);
			@statement := statement->data.binary.right;
			continue;
		};
		if (statement->kind == syntax_kind::source_choice) {
			SourceArm* arm := statement->data.choice->first;
			while (arm) {
				if (!generic_guard_safe((Scope*)members, (ParseGuard*)arm->guard)) {
					return;
				};
				@arm := arm->next;
			};
			@statement = source_choice_select(@compiler, (Scope*)members, *statement->data.choice);
			continue;
		};
		if (statement->kind == syntax_kind::source_error) {
			compiler_error(@compiler, statement->data.error->token, (const char*)statement->data.error->message);
			return;
		};
		if (statement->kind == syntax_kind::node_source_declaration) {
			SourceDeclaration* declaration := statement->data.source_declaration;
			NameSyntax* path = name_declaration_spelling((NameSyntax*)declaration->path);
			if (phase == declaration_phase::identities) {
				if (declaration->token.kind == token_kind::kw_fn && !path->qualifier && generic_type_role_safe((Scope*)members, (TypeSyntax*)declaration->type)) {
					TypeSyntax* signature = type_source_select(@compiler, (Scope*)members, (TypeSyntax*)declaration->type);
					if (!signature) {
						return;
					};
					ParameterSyntax* first := signature->data.signature.parameters;
					if (!first || !token_is(first->name, "this\0")) {
						compiler_error(@compiler, declaration->token, "instance function requires an explicit 'this' reference parameter\0");
						return;
					};
				};
				if (declaration->token.kind == token_kind::kw_struct || declaration->token.kind == token_kind::kw_union || declaration->token.kind == token_kind::kw_enum) {
					Entity* nested = scope_local((Scope*)members, path->token);
					if (!nested) {
						@nested = entity_create(@compiler, entity_kind::primitive, Token(path->token));
						if (!nested) {
							return;
						};
						@nested->state = resolution::ready;
						@nested->data.primitive.type = type_entity(@compiler, type_kind::parameter, (Entity*)nested);
						scope_define(@compiler, (Scope*)members, (Entity*)nested);
					};
				};
			}
			else {
				generic_declaration_validate(@compiler, (Scope*)members, (SourceDeclaration*)declaration);
			};
		}
		else if (phase == declaration_phase::members && statement->kind == syntax_kind::node_declaration) {
			generic_type_names_validate(@compiler, (Scope*)members, (TypeSyntax*)statement->data.declaration.type);
			Entity* field = entity_create(@compiler, entity_kind::variable, Token(statement->data.declaration.name));
			if (!field) {
				return;
			};
			@field->state = resolution::ready;
			@field->data.variable.storage = storage_kind::field;
			scope_define(@compiler, (Scope*)members, (Entity*)field);
		};
		@statement := statement->next;
	};
};

fn generic_declaration_validate(Compiler& compiler, Scope* scope, SourceDeclaration* source) {
	if (!source || compiler.result == compilation_result::failure) {
		return;
	};
	if (source->parameters) {
		@scope = generic_parameters_scope(@compiler, (Scope*)scope, (TemplateParameter*)source->parameters);
		if (!scope) {
			return;
		};
	};
	if (!source->body || (source->token.kind != token_kind::kw_struct && source->token.kind != token_kind::kw_union)) {
		return;
	};
	Scope* lexical = scope_create(@compiler, (Scope*)scope, context_kind::module, nullptr);
	if (!lexical) {
		return;
	};
	Scope* members = scope_create(@compiler, (Scope*)lexical, context_kind::module, nullptr);
	if (!members) {
		return;
	};
	// A symbolic owning type makes its unqualified self name visible without
	// creating a fake specialization or choosing concrete generic values.
	Entity* self = entity_create(@compiler, entity_kind::primitive, Token(source->path->token));
	if (!self) {
		return;
	};
	@self->state = resolution::ready;
	@self->data.primitive.type = type_entity(@compiler, type_kind::parameter, (Entity*)self);
	scope_define(@compiler, (Scope*)members->parent, (Entity*)self);
	generic_members_validate(@compiler, (Scope*)members, (ValueSyntax*)source->body->data.statements, declaration_phase::identities);
	generic_members_validate(@compiler, (Scope*)members, (ValueSyntax*)source->body->data.statements, declaration_phase::members);
};

fn source_declaration_lower(Compiler& compiler, Scope* scope, SourceDeclaration* source) -> Syntax* {
	SourceBinding* binding = source_collect_declaration(@compiler, (Scope*)scope, (SourceDeclaration*)source, declaration_phase::members);
	if (!binding || compiler.result == compilation_result::failure) {
		return nullptr;
	};
	if (binding->lowered) {
		return (Syntax*)binding->lowered;
	};
	Syntax* node = syntax_create(@compiler, syntax_kind::node_declaration, Token(source->token));
	if (!node) {
		return nullptr;
	};
	@binding->lowered := node;
	if (source->parameters && binding->kind != source_binding_kind::instance) {
		generic_declaration_validate(@compiler, (Scope*)scope, (SourceDeclaration*)source);
		@node->entity := binding->entity;
		return (Syntax*)node;
	};
	NameSyntax* path = name_source_select(@compiler, (Scope*)scope, (NameSyntax*)source->path);
	if (!path) {
		return nullptr;
	};
	Scope* owner := binding->owner;
	if (source->token.kind == token_kind::kw_namespace) {
		@node->entity := binding->entity;
		@node->data.declaration.body = source_block_lower(@compiler, entity_members((Entity*)binding->entity), (ValueSyntax*)source->body);
		return (Syntax*)node;
	};
	TypeSyntax* signature = nullptr;
	if (source->token.kind == token_kind::kw_fn) {
		@signature = type_source_select(@compiler, (Scope*)owner, (TypeSyntax*)source->type);
		if (!signature) {
			return nullptr;
		};
	};
	function_role role = source_declaration_role((Scope*)owner, (SourceDeclaration*)source);
	Entity* aggregate := owner->owner;
	if (role == function_role::assignment && (!aggregate || (aggregate->kind != entity_kind::kw_struct && aggregate->kind != entity_kind::kw_union && aggregate->kind != entity_kind::kw_enum))) {
		compiler_error(@compiler, source->token, "assignment function requires an aggregate owner\0");
		return nullptr;
	};
	if (role == function_role::destructor && (!aggregate || (aggregate->kind != entity_kind::kw_struct && aggregate->kind != entity_kind::kw_union && aggregate->kind != entity_kind::kw_enum) || !token_same(path->token, aggregate->name))) {
		compiler_error(@compiler, source->token, "destructor name must match its owning type\0");
		return nullptr;
	};
	Entity* entity := binding->entity;
	if (role != function_role::ordinary && !entity) {
		@entity = entity_create(@compiler, entity_kind::function, Token(path->token));
		if (!entity) {
			return nullptr;
		};
		@entity->scope := owner;
		@entity->data.function.role := role;
		@binding->entity := entity;
	};
	if (!entity) {
		return nullptr;
	};
	@node->entity := entity;
	@node->data.declaration.path = name_lower(@compiler, (Scope*)scope, (NameSyntax*)source->path);
	@node->data.declaration.name := path->token;
	@node->data.declaration.type := source->type;
	@node->data.declaration.definition := source->definition;
	@node->data.declaration.modification := source->modification;
	if (source->token.kind == token_kind::kw_fn) {
		if (aggregate && scope_template_member((Scope*)owner)) {
			@entity->data.function.analysis = function_analysis::unrequested;
		};
		if ((role != function_role::ordinary || scope->context == context_kind::kw_struct || scope->context == context_kind::kw_union || scope->context == context_kind::kw_enum) && !path->qualifier) {
			ParameterSyntax* first := signature->data.signature.parameters;
			if (!first || !token_is(first->name, "this\0")) {
				compiler_error(@compiler, source->token, "instance function requires an explicit 'this' reference parameter\0");
				return nullptr;
			};
		};
		if ((role == function_role::constructor || role == function_role::destructor) && signature->data.signature.result) {
			compiler_error(@compiler, source->token, "constructors and destructors have no return type\0");
			return nullptr;
		};
		if (source->conversion == constructor_conversion::kw_implicit) {
			if (role != function_role::constructor) {
				compiler_error(@compiler, source->token, "implicit applies only to constructors\0");
				return nullptr;
			};
			@entity->data.function.conversion = constructor_conversion::kw_implicit;
		};
		if (scope->context == context_kind::kw_struct && !path->qualifier) {
			@entity->data.function.interface_owner := scope->owner;
			if (entity->data.function.modification != function_modification::ordinary && entity->data.function.modification != source->modification) {
				compiler_error(@compiler, source->token, "conflicting virtual relationship declarations\0");
				return nullptr;
			};
			@entity->data.function.modification := source->modification;
			if (source->modification != function_modification::ordinary && !entity->data.function.callable) {
				VirtualCallable* callable = (VirtualCallable*)memory_allocate(@compiler, sizeof(VirtualCallable));
				if (!callable) {
					return nullptr;
				};
				@callable->function := entity;
				VirtualCallable** tail = &scope->owner->data.aggregate.virtual_callables;
				while (*tail) {
					@callable->index = callable->index + 1;
					@tail = &(*tail)->next;
				};
				@entity->data.function.callable := callable;
				@*tail = (VirtualCallable*)callable;
			};
		};
	};
	if (source->body) {
		if (source->token.kind == token_kind::kw_fn && role == function_role::ordinary && entity->declaration && (entity->declaration->data.declaration.body || entity->declaration->data.declaration.definition == function_definition::deleted)) {
			compiler_error(@compiler, source->token, "duplicate function definition\0");
			return nullptr;
		};
		if (source->token.kind == token_kind::kw_struct || source->token.kind == token_kind::kw_union) {
			Scope* members = entity_members((Entity*)entity);
			@members->context = context_kind::kw_struct;
			if (source->token.kind == token_kind::kw_union) {
				@members->context = context_kind::kw_union;
			};
			@node->data.declaration.bases := entity->data.aggregate.bases;
			@node->data.declaration.body = source_block_lower(@compiler, (Scope*)members, (ValueSyntax*)source->body);
			@members->context = context_kind::module;
		}
		else if (source->token.kind == token_kind::kw_enum) {
			Scope* members = entity_members((Entity*)entity);
			@members->context = context_kind::kw_enum;
			@node->data.declaration.body = source_block_lower(@compiler, (Scope*)members, (ValueSyntax*)source->body);
		}
		else {
			Scope* parameters = scope_create(@compiler, (Scope*)owner, context_kind::function, (Entity*)entity);
			ParameterSyntax* parameter := signature->data.signature.parameters;
			while (parameter && compiler.result != compilation_result::failure) {
				if (parameter->name.source) {
					Entity* variable = entity_create(@compiler, entity_kind::variable, Token(parameter->name));
					if (!variable) {
						return nullptr;
					};
					@variable->data.variable.storage = storage_kind::parameter;
					scope_define(@compiler, (Scope*)parameters, (Entity*)variable);
				};
				@parameter := parameter->next;
			};
			Scope* body = scope_create(@compiler, (Scope*)parameters, context_kind::function, (Entity*)entity);
			@node->data.declaration.body = source_block_lower(@compiler, (Scope*)body, (ValueSyntax*)source->body);
		};
	};
	if (!entity->declaration || source->body || source->definition == function_definition::deleted || source->definition == function_definition::defaulted) {
		@entity->declaration := node;
	};
	if (role != function_role::ordinary) {
		declaration_special_register(@compiler, (Scope*)owner, (Syntax*)node);
	};
	return (Syntax*)node;
};

fn name_declaration_spelling(NameSyntax* name) -> NameSyntax* {
	while (name && name->choices) {
		@name := name->choices->name;
	};
	return (NameSyntax*)name;
};

fn source_template_qualifier(NameSyntax* name) -> NameSyntax* {
	while (name) {
		@name = name_declaration_spelling((NameSyntax*)name);
		if (name->arguments) {
			return (NameSyntax*)name;
		};
		@name := name->qualifier;
	};
	return nullptr;
};

fn source_template_register(Compiler& compiler, Scope* scope, SourceDeclaration* source) -> Entity* {
	if (scope->context != context_kind::module && scope->context != context_kind::kw_struct && scope->context != context_kind::kw_union) {
		compiler_error(@compiler, source->token, "template declarations require module or aggregate scope\0");
		return nullptr;
	};
	NameSyntax* path = name_declaration_spelling((NameSyntax*)source->path);
	NameSyntax* member = nullptr;
	if (source->token.kind == token_kind::kw_fn) {
		@member = source_template_qualifier((NameSyntax*)path->qualifier);
	};
	NameSyntax* name = (NameSyntax*)path;
	if (member) {
		@name := member;
	};
	Scope* owner := scope;
	if (name->qualifier) {
		@owner = entity_members(name_resolve(@compiler, (Scope*)scope, (NameSyntax*)name->qualifier));
		if (!owner) {
			compiler_error(@compiler, name->token, "qualified template owner has no scope\0");
			return nullptr;
		};
	};
	Entity* pattern = scope_local((Scope*)owner, name->token);
	if (member) {
		if (!pattern || pattern->kind != entity_kind::kw_template || pattern->data.template_pattern.declaration_kind == token_kind::kw_fn) {
			compiler_error(@compiler, name->token, "template member requires a class template owner\0");
			return nullptr;
		};
	}
	else {
		if (pattern && pattern->kind != entity_kind::kw_template) {
			compiler_error(@compiler, name->token, "template conflicts with an existing entity\0");
			return nullptr;
		};
		if (!pattern) {
			@pattern = entity_create(@compiler, entity_kind::kw_template, Token(name->token));
			if (!pattern) {
				return nullptr;
			};
			@pattern->state = resolution::ready;
			@pattern->scope := owner;
			@pattern->data.template_pattern.declaration_kind := source->token.kind;
			@pattern->data.template_pattern.instances = scope_create(@compiler, (Scope*)owner, context_kind::module, (Entity*)pattern);
			scope_define(@compiler, (Scope*)owner, (Entity*)pattern);
		};
	};
	TemplateDeclaration* declaration = (TemplateDeclaration*)memory_allocate(@compiler, sizeof(TemplateDeclaration));
	if (!declaration) {
		return nullptr;
	};
	@declaration->source := source;
	@declaration->signature := source->type;
	@declaration->parameters := source->parameters;
	@declaration->definition_scope := scope;
	@declaration->pattern := pattern;
	if (!member && source->body) {
		if (pattern->data.template_pattern.definition) {
			compiler_error(@compiler, source->token, "duplicate template definition\0");
			return nullptr;
		};
		@pattern->data.template_pattern.definition := declaration;
	};
	TemplateDeclaration** tail = &compiler.templates;
	while (*tail) {
		@tail = &(*tail)->next;
	};
	@*tail := declaration;
	@tail = &pattern->data.template_pattern.declarations;
	while (*tail) {
		@tail = &(*tail)->pattern_next;
	};
	@*tail = (TemplateDeclaration*)declaration;
	return (Entity*)pattern;
};

fn template_specialize(Compiler& compiler, Entity* pattern, TemplateArgument* arguments, const Token& token) -> Entity* {
	TemplateSpecialization* specialization := pattern->data.template_pattern.specializations;
	while (specialization) {
		if (template_arguments_equal((TemplateArgument*)specialization->arguments, (TemplateArgument*)arguments)) {
			return (Entity*)specialization->entity;
		};
		@specialization := specialization->next;
	};
	TemplateDeclaration* declaration := pattern->data.template_pattern.definition;
	if (!declaration) {
		@declaration := pattern->data.template_pattern.declarations;
	};
	Scope* instances := pattern->data.template_pattern.instances;
	Token name = template_instance_name(@compiler, Token(token), (usize)instances->binding_count);
	Entity* wrapper = nullptr;
	TemplateArgument* argument := arguments;
	while (argument) {
		if (argument->parameter || type_dependent((Type*)argument->type)) {
			@wrapper = entity_create(@compiler, entity_kind::kw_namespace, Token(name));
			if (!wrapper) {
				return nullptr;
			};
			@wrapper->state = resolution::ready;
			@wrapper->scope := instances;
			@wrapper->data.namespace_entity.scope = scope_create(@compiler, (Scope*)instances, context_kind::module, (Entity*)wrapper);
			break;
		};
		@argument := argument->next;
	};
	if (!wrapper) {
		@wrapper = namespace_define(@compiler, (Scope*)instances, Token(name));
	};
	if (!wrapper) {
		return nullptr;
	};
	Scope* scope = entity_members((Entity*)wrapper);
	template_bind(@compiler, (Scope*)scope, (TemplateParameter*)declaration->parameters, (TemplateArgument*)arguments);
	@specialization = (TemplateSpecialization*)memory_allocate(@compiler, sizeof(TemplateSpecialization));
	SourceBinding* binding = identity_record<SourceBinding>(@compiler, @compiler.semantic.source_bindings, (const void*)declaration->source, (const void*)scope);
	if (!specialization || !binding) {
		return nullptr;
	};
	@specialization->arguments := arguments;
	@specialization->scope := scope;
	@specialization->next := pattern->data.template_pattern.specializations;
	@pattern->data.template_pattern.specializations := specialization;
	@binding->kind = source_binding_kind::instance;
	source_collect_declaration(@compiler, (Scope*)scope, (SourceDeclaration*)declaration->source, declaration_phase::identities);
	@specialization->entity := binding->entity;
	if (!specialization->entity) {
		compiler_error(@compiler, token, "could not instantiate template declaration\0");
		return nullptr;
	};
	@specialization->entity->template_origin := pattern;
	@specialization->entity->specialization := specialization;
	source_collect_declaration(@compiler, (Scope*)scope, (SourceDeclaration*)declaration->source, declaration_phase::members);
	source_declaration_lower(@compiler, (Scope*)scope, (SourceDeclaration*)declaration->source);
	TemplateDeclaration* extension := pattern->data.template_pattern.declarations;
	while (extension && compiler.result != compilation_result::failure) {
		if (extension != declaration && extension->source->token.kind == token_kind::kw_fn && pattern->data.template_pattern.declaration_kind != token_kind::kw_fn) {
			template_bind(@compiler, (Scope*)scope, (TemplateParameter*)extension->parameters, (TemplateArgument*)arguments);
			SourceBinding* member = identity_record<SourceBinding>(@compiler, @compiler.semantic.source_bindings, (const void*)extension->source, (const void*)scope);
			if (!member) {
				return nullptr;
			};
			@member->kind = source_binding_kind::instance;
			source_collect_declaration(@compiler, (Scope*)scope, (SourceDeclaration*)extension->source, declaration_phase::members);
			source_declaration_lower(@compiler, (Scope*)scope, (SourceDeclaration*)extension->source);
		};
		@extension := extension->pattern_next;
	};
	return (Entity*)specialization->entity;
};
fn declaration_special_register(Compiler& compiler, Scope* owner, Syntax* declaration) {
	Entity* function := declaration->entity;
	function_role role := function->data.function.role;
	Type* signature = function_type_resolve(@compiler, (Scope*)owner, (Entity*)function);
	Entity** tail = special_functions((Entity*)owner->owner, (function_role)role);
	usize index = 0;
	while (*tail) {
		Entity* existing := *tail;
		Type* other = function_type_resolve(@compiler, (Scope*)owner, (Entity*)existing);
		if (type_equal((Type*)signature, (Type*)other)) {
			if (declaration->data.declaration.definition != function_definition::declaration && existing->declaration->data.declaration.definition != function_definition::declaration) {
				compiler_error(@compiler, declaration->token, "duplicate special function definition\0");
				return;
			};
			if (function->data.function.conversion == constructor_conversion::kw_implicit) {
				@existing->data.function.conversion = constructor_conversion::kw_implicit;
			};
			@declaration->entity := existing;
			if (declaration->data.declaration.definition != function_definition::declaration) {
				@existing->declaration := declaration;
				if (declaration->data.declaration.body) {
					@declaration->data.declaration.body->scope->owner := existing;
				};
			};
			return;
		};
		@index = index + 1;
		@tail = &existing->data.function.overload_next;
	};
	if (role == function_role::destructor && index) {
		compiler_error(@compiler, declaration->token, "a type has exactly one destructor signature\0");
		return;
	};
	@function->data.function.overload_index = (usize)index;
	@*tail := function;
	Token alias = token_synthetic(@compiler, Token(function->name), "<special-function>\0");
	scope_bind_named(@compiler, (Scope*)owner, Token(alias), (Entity*)function, (Scope*)owner, (Source*)declaration->token.source);
};

fn Parser::new_type(Parser& this, type_syntax_kind kind, Token token) -> TypeSyntax* {
	TypeSyntax* node = (TypeSyntax*)memory_allocate(@*this.compiler, sizeof(TypeSyntax));
	if (!node) {
		return nullptr;
	};
	@node->kind = (type_syntax_kind)kind;
	@node->token = Token(token);
	return (TypeSyntax*)node;
};

fn literal_escape(Compiler& compiler, const Token& token, char value) -> char {
	switch (value) {
		case '0':
			return '\0';

		case 'n':
			return '\n';

		case 'r':
			return '\r';

		case 't':
			return '	';

		case '\\':
		case '"':
		case '\'':
			return $value;

		default:
			compiler_error(@compiler, token, "unsupported literal escape\0");
			return '\0';
	};
};

fn parser_precedence(token_kind operation) -> i32 {
	switch (operation) {
		case token_kind::op_assign:
			return 1;
		case token_kind::op_copy:
			return 1;
		case token_kind::op_or:
			return 2;
		case token_kind::op_and:
			return 3;
		case token_kind::op_pipe:
			return 4;
		case token_kind::op_caret:
			return 5;
		case token_kind::op_ampersand:
			return 6;
		case token_kind::op_equal:
			return 7;
		case token_kind::op_not_equal:
			return 7;
		case token_kind::op_less:
			return 8;
		case token_kind::op_greater:
			return 8;
		case token_kind::op_less_equal:
			return 8;
		case token_kind::op_greater_equal:
			return 8;
		case token_kind::op_shift_left:
			return 9;
		case token_kind::op_shift_right:
			return 9;
		case token_kind::op_plus:
			return 10;
		case token_kind::op_minus:
			return 10;
		case token_kind::op_star:
			return 11;
		case token_kind::op_slash:
			return 11;
		case token_kind::op_remainder:
			return 11;
		default:
			return 0;
	};
};

fn token_synthetic(Compiler& compiler, Token location, const char* spelling) -> Token {
	Source* source = (Source*)memory_allocate(@compiler, sizeof(Source));
	if (!source) {
		return Token(location);
	};
	@source->path := location.source->path;
	@source->bytes.size = strlen(const char*(spelling));
	@source->bytes.data = (const char*)spelling;
	@location.source = (Source*)source;
	@location.begin = 0;
	@location.length := location.source->bytes.size;
	@location.kind = token_kind::identifier;
	return Token(location);
};

fn special_functions(Entity* owner, function_role role) -> Entity** {
	if (role == function_role::constructor) {
		return &owner->data.aggregate.constructors;
	};
	if (role == function_role::assignment) {
		return &owner->data.aggregate.assignments;
	};
	return &owner->data.aggregate.destructor;
};

fn scope_template_member(Scope* scope) -> bool {
	while (scope) {
		Entity* owner := scope->owner;
		if (owner && (owner->kind == entity_kind::kw_struct || owner->kind == entity_kind::kw_union) && owner->template_origin) {
			return true;
		};
		@scope := scope->parent;
	};
	return false;
};

fn prepare_source(Compiler& compiler, Source* source) -> i32 {
	if (source->parsed) {
		return compiler.result == compilation_result::success;
	};
	if (!source->tokens && !tokenize(@compiler, (Source*)source, &source->tokens, &source->token_count)) {
		return 0;
	};
	Parser parser;
	@parser.compiler = &compiler;
	@parser.tokens := source->tokens;
	@parser.count := source->token_count;
	if (!@parser.memo_initialize(@*source)) {
		return 0;
	};
	ParseResult<ValueSyntax>* parsed = @parser.source_file_results();
	if (parser.failure.message) {
		compiler_error(@compiler, parser.failure.token, const char*(parser.failure.message));
	};
	if (compiler.result == compilation_result::failure) {
		return 0;
	};
	if (!parsed || parsed->next || parsed->end.offset + 1 != source->token_count || parsed->end.pending_greater) {
		compiler_error(@compiler, parser.token(), "source file did not reach one complete interpretation\0");
		return 0;
	};
	@source->parsed := parsed->value;
	return 1;
};

fn prepare_sources(Compiler& compiler) -> i32 {
	Source* source := compiler.sources;
	while (source && compiler.result != compilation_result::failure) {
		if (!prepare_source(@compiler, (Source*)source)) {
			return 0;
		};
		@source := source->next;
	};
	@source := compiler.sources;
	while (source && compiler.result != compilation_result::failure) {
		source_collect_block(@compiler, (Scope*)compiler.module, (ValueSyntax*)source->parsed, declaration_phase::identities);
		@source := source->next;
	};
	@source := compiler.sources;
	while (source && compiler.result != compilation_result::failure) {
		source_collect_block(@compiler, (Scope*)compiler.module, (ValueSyntax*)source->parsed, declaration_phase::members);
		@source := source->next;
	};
	return compiler.result == compilation_result::success;
};

fn parse_source(Compiler& compiler, Source* source) -> Syntax* {
	if (!prepare_source(@compiler, (Source*)source)) {
		return nullptr;
	};
	return source_block_lower(@compiler, (Scope*)compiler.module, (ValueSyntax*)source->parsed);
};

fn LLVMContextCreate() -> LLVMOpaqueContext*;
fn LLVMContextDispose(LLVMOpaqueContext* context);
fn LLVMModuleCreateWithNameInContext(const char* name, LLVMOpaqueContext* context) -> LLVMOpaqueModule*;
fn LLVMDisposeModule(LLVMOpaqueModule* module);
fn LLVMCreateBuilderInContext(LLVMOpaqueContext* context) -> LLVMOpaqueBuilder*;
fn LLVMDisposeBuilder(LLVMOpaqueBuilder* builder);
fn LLVMInitializeX86TargetInfo();
fn LLVMInitializeX86Target();
fn LLVMInitializeX86TargetMC();
fn LLVMInitializeX86AsmPrinter();
fn LLVMGetDefaultTargetTriple() -> char*;
fn LLVMGetTargetFromTriple(const char* triple, LLVMTarget** target, char** message) -> i32;
fn LLVMCreateTargetMachine(LLVMTarget* target, const char* triple, const char* cpu, const char* features, i32 level, i32 relocation, i32 model) -> LLVMOpaqueTargetMachine*;
fn LLVMDisposeTargetMachine(LLVMOpaqueTargetMachine* machine);
fn LLVMCreateTargetDataLayout(LLVMOpaqueTargetMachine* machine) -> LLVMOpaqueTargetData*;
fn LLVMDisposeTargetData(LLVMOpaqueTargetData* layout);
fn LLVMCopyStringRepOfTargetData(LLVMOpaqueTargetData* layout) -> char*;
fn LLVMPointerSize(LLVMOpaqueTargetData* layout) -> u32;
fn LLVMABISizeOfType(LLVMOpaqueTargetData* layout, LLVMOpaqueType* type) -> u64;
fn LLVMABIAlignmentOfType(LLVMOpaqueTargetData* layout, LLVMOpaqueType* type) -> u32;
fn LLVMOffsetOfElement(LLVMOpaqueTargetData* layout, LLVMOpaqueType* type, u32 index) -> u64;
fn LLVMSetTarget(LLVMOpaqueModule* module, const char* triple);
fn LLVMSetDataLayout(LLVMOpaqueModule* module, const char* layout);
fn LLVMDisposeMessage(char* message);
fn LLVMVoidTypeInContext(LLVMOpaqueContext* context) -> LLVMOpaqueType*;
fn LLVMIntTypeInContext(LLVMOpaqueContext* context, u32 bits) -> LLVMOpaqueType*;
fn LLVMFloatTypeInContext(LLVMOpaqueContext* context) -> LLVMOpaqueType*;
fn LLVMDoubleTypeInContext(LLVMOpaqueContext* context) -> LLVMOpaqueType*;
fn LLVMPointerTypeInContext(LLVMOpaqueContext* context, u32 address_space) -> LLVMOpaqueType*;
fn LLVMArrayType2(LLVMOpaqueType* element, u64 count) -> LLVMOpaqueType*;
