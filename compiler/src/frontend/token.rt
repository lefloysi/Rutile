enum token_kind : [i32] {
	identifier;
	literal_number;
	literal_string;
	kw_fn;
	kw_using;
	kw_const;
	kw_discard;
	kw_delete;
	kw_new;
	kw_implicit;
	kw_nullptr;
	kw_template;
	kw_typename;
	kw_class;
	kw_var;
	kw_struct;
	kw_union;
	kw_enum;
	kw_namespace;
	kw_virtual;
	kw_override;
	kw_final;
	kw_return;
	kw_if;
	kw_else;
	kw_while;
	kw_for;
	kw_switch;
	kw_case;
	kw_default;
	kw_break;
	kw_continue;
	kw_sizeof;
	op_arrow;
	op_copy;
	op_equal;
	op_not_equal;
	op_less_equal;
	op_greater_equal;
	op_and;
	op_or;
	op_shift_left;
	op_shift_right;
	punct_ellipsis;
	punct_left_paren;
	punct_right_paren;
	punct_left_bracket;
	punct_right_bracket;
	punct_left_brace;
	punct_right_brace;
	punct_semicolon;
	punct_comma;
	punct_colon;
	op_scope;
	op_dot;
	op_assign;
	op_plus;
	op_minus;
	op_star;
	op_slash;
	op_remainder;
	op_ampersand;
	op_pipe;
	op_caret;
	op_bang;
	op_tilde;
	op_access;
	op_relocate;
	op_less;
	op_greater;
	eof;
};

struct Token {
	fn text(Token& this) -> rt::string_view;
	fn is(Token& this, rt::string_view spelling) -> bool;
	fn same(Token& this, Token& other) -> bool;

	var SourceFile* source;
	usize begin;
	usize length;
	usize line;
	usize column;
	token_kind kind;
};

fn Token::text(Token& this) -> rt::string_view {
	if (!this.source) {
		return rt::string_view();
	};

	var source = this.source->text();

	if (this.begin > source.size() || this.length > source.size() - this.begin) {
		return rt::string_view();
	};

	return rt::string_view(source.data() + this.begin, this.length);
};

fn Token::is(Token& this, rt::string_view spelling) -> bool {
	return this.source && this.text() == spelling;
};

fn Token::same(Token& this, Token& other) -> bool {
	return this.source && other.source && this.text() == other.text();
};
