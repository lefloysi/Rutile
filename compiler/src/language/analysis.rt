struct AnalysisCancellationScope {
	fn AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics);
	fn ~AnalysisCancellationScope(var AnalysisCancellationScope& this);

private:
	var Diagnostics* diagnostics;
};

fn AnalysisCancellationScope::AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn AnalysisCancellationScope::~AnalysisCancellationScope(var AnalysisCancellationScope& this) {
	@this.diagnostics->set_cancellation(nullptr, nullptr);
};

fn Analysis::analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, false);
};

fn Analysis::analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, true);
};

fn Analysis::analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> AnalysisResult {
	@this.messages.set_cancellation(cancelled, context);
	var cancellation_scope = AnalysisCancellationScope(@this.messages);
	@this.target_pointer_bits = pointer_bits;
	@this.semantic_unit = rt::unique<SemanticUnit>::make();
	Token location;
	if (pointer_bits != 32 && pointer_bits != 64) {
		@this.messages.error(location, "language analysis requires a 32-bit or 64-bit target");
		return AnalysisResult(compilation_error());
	};
	Diagnostics parse_errors;
	this.progress.report("parsing", 0, this.sources.count(), "");
	usize index = 0;
	while (index < this.sources.count()) {
		if (this.messages.cancelled()) {
			return AnalysisResult(analysis_cancelled_error());
		};
		var SourceFile* file = @this.sources.at(index);
		var lexer = Lexer(@*file);
		if (!(@lexer.scan()).has<void>()) {
			@parse_errors.syntax_error(lexer.error_token(), lexer.error());
			@index = index + 1;
			continue;
		};
		var parser = Parser(file->tokens());
		@parser.set_cancellation(cancelled, context);
		ParseResult parsed;
		if (editor) {
			@parsed = @parser.parse_editor();
			usize issue = 0;
			while (issue < parser.issues().size()) {
				@parse_errors.syntax_error(parser.issues().data()[issue].location, parser.issues().data()[issue].message.view());
				@issue = issue + 1;
			};
		}
		else {
			@parsed = @parser.parse();
		};
		if (parsed.has<compilation_error>()) {
			if (this.messages.cancelled()) {
				return AnalysisResult(analysis_cancelled_error());
			};
			@parse_errors.syntax_error(parser.error_token(), parser.error());
		}
		else {
			var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
			@this.syntax.push_back(rt::unique<Syntax>(@tree.release()));
		};
		@index = index + 1;
		this.progress.report("parsing", index, this.sources.count(), file->path());
	};
	if (this.tests_enabled) {
		var runner = TestRunnerSource();
		usize root = 0;
		while (root < this.syntax.size()) {
			Syntax& syntax = *this.syntax.data()[root].get();
			if (!syntax.token().source || !syntax.token().source->imported()) {
				@runner.collect(syntax, "", @this.messages);
			};
			@root = root + 1;
		};
		var generated = rt::string();
		runner.generate(@generated);
		@this.add_source("<generated-test-runner>", generated.view());
		var SourceFile* file = @this.sources.at(this.sources.count() - 1);
		rt::string_view module = "__rutile_test_runtime";
		usize source = 0;
		while (source + 1 < this.sources.count()) {
			SourceFile& input = *this.sources.at(source);
			if (!input.imported() && !input.module_name().empty()) {
				@module = input.module_name();
				break;
			};
			@source = source + 1;
		};
		@file->set_module(module, 0);
		@file->mark_compiler_generated();
		var lexer = Lexer(@*file);
		if (!(@lexer.scan()).has<void>()) {
			@this.messages.syntax_error(lexer.error_token(), lexer.error());
			return AnalysisResult(compilation_error());
		};
		var parser = Parser(file->tokens());
		var parsed = @parser.parse();
		if (parsed.has<compilation_error>()) {
			@this.messages.syntax_error(parser.error_token(), parser.error());
			return AnalysisResult(compilation_error());
		};
		var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
		@this.syntax.push_back(rt::unique<Syntax>(@tree.release()));
	};
	var analyzer = Analyzer(@this.types, @this.messages, $pointer_bits);
	@analyzer.set_progress(this.progress);
	@analyzer.set_editor($editor);
	var analyzed = @analyzer.analyze_into(@*this.semantic_unit.get(), this.syntax);
	if (!analyzed.has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
		compiler_panic("semantic analysis failed without a diagnostic");
	};
	if (analyzed.has<void>() && this.template_selection.get()) {
		var EditorTemplateSelection& selection = @*this.template_selection.get();
		rt::string input;
		@input.append("using __context = __arguments<");
		@input.append(selection.arguments.view());
		@input.append(">;");
		@selection.input.assign(selection.path.view(), input.view());
		var lexer = Lexer(@selection.input);
		if (!(@lexer.scan()).has<void>()) {
			@this.messages.syntax_error(lexer.error_token(), lexer.error());
			@analyzed = CompilationResult(compilation_error());
		}
		else {
			var parser = Parser(selection.input.tokens());
			@parser.set_cancellation(cancelled, context);
			var parsed = @parser.parse();
			if (parsed.has<rt::unique<Syntax>>()) {
				var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
				@selection.syntax = rt::unique<Syntax>(@tree.release());
			};
			if (parsed.has<compilation_error>()) {
				@this.messages.syntax_error(parser.error_token(), parser.error());
				@analyzed = CompilationResult(compilation_error());
			}
			else if (selection.syntax.get()->size() != 1 || selection.syntax.get()->item(0)->kind() != syntax_kind::using_alias) {
				@this.messages.error(location, "enter only template arguments, without declarations or statements");
				@analyzed = CompilationResult(compilation_error());
			}
			else {
				usize source = 0;
				while (source < this.sources.count() && this.sources.at(source)->path() != selection.path.view()) {
					@source = source + 1;
				};
				var Syntax* applied = selection.syntax.get()->item(0)->alias_type();
				while (applied->kind() == syntax_kind::type_name) {
					@applied = applied->designated_type();
				};
				if (source == this.sources.count() || applied->kind() != syntax_kind::template_apply) {
					@this.messages.error(location, "cannot read the template argument list");
					@analyzed = CompilationResult(compilation_error());
				}
				else {
					@analyzed = @analyzer.editor_template_context(@*this.semantic_unit.get(), @*(@this.sources).at(source), selection.anchor, @*applied->arguments(), @selection.label);
				};
			};
		};
	};
	if (analyzed.has<void>()) {
		var facts = InferredFacts(@this.messages);
		if (!(@facts.validate(@*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
			compiler_panic("inferred fact analysis failed without a diagnostic");
		};
		this.progress.report("lifetimes", 0, 1, "");
		var lifetimes = LifetimeAnalyzer(@this.messages);
		if (!(@lifetimes.validate(*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
			compiler_panic("lifetime analysis failed without a diagnostic");
		};
		this.progress.report("lifetimes", 1, 1, "");
		if (!this.messages.failed()) {
			this.progress.report("reference-loans", 0, 1, "");
			var loans = ReferenceLoanAnalyzer(@this.messages);
			if (!(@loans.validate(*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
				compiler_panic("reference loan analysis failed without a diagnostic");
			};
			this.progress.report("reference-loans", 1, 1, "");
		};
	};
	if (this.messages.cancelled()) {
		return AnalysisResult(analysis_cancelled_error());
	};
	rt::buffer<DiagnosticRecord>& records = parse_errors.records();
	@index = 0;
	while (index < records.size()) {
		DiagnosticRecord& record = records.data()[index];
		@this.messages.error(record.location, record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			@this.messages.note(record.notes.data()[note].location, record.notes.data()[note].message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
	@this.index.build(*this.semantic_unit.get());
	if (this.messages.failed()) {
		return AnalysisResult(compilation_error());
	};
	return AnalysisResult();
};



