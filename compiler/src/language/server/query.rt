fn LanguageWorkspace::old_offset(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize current, var usize& original) -> bool {
	LanguageIndexedSource& input = index.sources.data()[source];
	var LanguageDocument* document = @this.document_key(input.key.view());
	if (!document) {
		if (input.version.has_value()) {
			return false;
		};
		@original = $current;
		return true;
	};
	if (!input.version.has_value() || input.revision < document->opened_revision) {
		return false;
	};

	usize edit = document->edits.size();
	while (edit) {
		@edit = edit - 1;
		LanguageEdit& change = document->edits.data()[edit];
		if (change.revision <= input.revision) {
			break;
		};
		if (current < change.begin) {
			continue;
		};
		if (current < change.begin + change.inserted) {
			return false;
		};
		@current = current - change.inserted + change.end - change.begin;
	};
	@original = $current;
	return true;
};

fn LanguageWorkspace::mapped(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& input, var SourceRange& output) -> bool {
	if (input.source >= index.sources.size()) {
		return false;
	};
	@output = SourceRange(input);
	LanguageIndexedSource& source = index.sources.data()[input.source];
	var LanguageDocument* document = @this.document_key(source.key.view());
	if (!document) {
		return !source.version.has_value();
	};
	if (!source.version.has_value() || source.revision < document->opened_revision) {
		return false;
	};

	usize edit = 0;
	while (edit < document->edits.size()) {
		LanguageEdit& change = document->edits.data()[edit];
		@edit = edit + 1;
		if (change.revision <= source.revision || output.end <= change.begin) {
			continue;
		};
		if (output.begin < change.end || change.begin == change.end && output.begin < change.begin && change.begin < output.end) {
			return false;
		};
		@output.begin = output.begin - (change.end - change.begin) + change.inserted;
		@output.end = output.end - (change.end - change.begin) + change.inserted;
	};
	return true;
};

fn LanguageWorkspace::location(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& range) -> rt::unique<rt::json_value> {
	SourceRange current;
	if (!@this.mapped(index, range, @current)) {
		return rt::unique<rt::json_value>();
	};
	LanguageIndexedSource& source = index.sources.data()[range.source];
	LanguageText* text = &@source.text;
	var LanguageDocument* document = @this.document_key(source.key.view());
	if (document) {
		@text = &@document->text;
	};

	var result = rt::json_value::make_object();
	if (!result.get() || !@result.get()->set("uri", rt::json_value::make_string(source.uri.view())) || !@result.get()->set("range", LanguageJson::range(*text, usize(current.begin), usize(current.end)))) {
		return rt::unique<rt::json_value>();
	};
	return $result;
};

fn LanguageWorkspace::bindings(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var rt::buffer<u64>& result) -> bool {
	rt::json_value* document = parameters.member("textDocument");
	rt::json_value* position = parameters.member("position");
	if (!document || !position) {
		return false;
	};
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(LanguageJson::text(*document, "uri"), @path) || !LanguageUri::key(path.view(), @key)) {
		return false;
	};
	var found = index.source_ids.find(key.view());
	if (!found) {
		return true;
	};
	usize source = *found;
	LanguageText* text = &@index.sources.data()[source].text;
	var LanguageDocument* open = @this.document_key(key.view());
	if (open) {
		@text = &@open->text;
	};
	i64 line = LanguageJson::integer(*position, "line", -1);
	i64 character = LanguageJson::integer(*position, "character", -1);
	if (line < 0 || character < 0) {
		return false;
	};
	usize current = text->offset(static_cast<usize>(line), static_cast<usize>(character));
	usize original = 0;
	if (!@this.old_offset(index, usize(source), usize(current), @original)) {
		return true;
	};

	usize first = 0;
	usize last = index.occurrences.size();
	while (first < last) {
		usize middle = first + (last - first) / 2;
		NavigationOccurrence& candidate = index.occurrences.data()[middle];
		if (candidate.range.source < source || candidate.range.source == source && candidate.range.begin <= original) {
			@first = middle + 1;
		}
		else {
			@last = $middle;
		};
	};
	u64 selected_context = @this.template_context(index, parameters);
	usize boundary = first;
	usize pass = 0;
	while (pass < 2 && !result.size()) {
		usize selected_width = usize::max;
		u32 selected_role = 0;
		@first = boundary;
		while (first) {
			@first = first - 1;
			NavigationOccurrence& candidate = index.occurrences.data()[first];
			if (candidate.range.source != source || candidate.range.end < original) {
				break;
			};
			if (selected_context && candidate.context && index.template_owner(u64(candidate.context)) != selected_context) {
				continue;
			};
			SourceRange mapped;
			if (!@this.mapped(index, candidate.range, @mapped)) {
				continue;
			};
			bool contains = mapped.begin <= current && current < mapped.end;
			bool selected_end = pass == 1 && mapped.begin < mapped.end && current == mapped.end;
			if (contains || selected_end) {
				usize width = mapped.end - mapped.begin;
				u32 role = candidate.roles & 16;
				if (width > selected_width || width == selected_width && role < selected_role) {
					continue;
				};
				if (width < selected_width || role > selected_role) {
					@result.clear();
					@selected_width = $width;
					@selected_role = $role;
				};
				usize duplicate = 0;
				while (duplicate < result.size() && result.data()[duplicate] != candidate.symbol) {
					@duplicate = duplicate + 1;
				};
				if (duplicate == result.size() && !@result.push_back(u64(candidate.symbol))) {
					return false;
				};
			};
		};
		@pass = pass + 1;
	};
	return true;
};

fn LanguageWorkspace::contains(rt::string_view text, rt::string_view part) -> bool {
	if (part.size() > text.size()) {
		return false;
	};
	usize offset = 0;
	while (offset <= text.size() - part.size()) {
		if (rt::string_view(text.data() + offset, part.size()) == part) {
			return true;
		};
		@offset = offset + 1;
	};
	return false;
};

fn LanguageWorkspace::measured(var LanguageWorkspace& this, rt::unique<rt::json_value> result, u64 started) -> rt::unique<rt::json_value> {
	@this.queries = this.queries + 1;
	@this.query_nanoseconds = this.query_nanoseconds + runtime_clock_nanoseconds() - started;
	return $result;
};

fn LanguageWorkspace::append_location(var rt::json_value& result, rt::unique<rt::json_value> location, var rt::unordered_map<rt::string_view, bool>& seen, var rt::buffer<rt::string>& keys) -> bool {
	if (!location.get()) {
		return true;
	};
	rt::string key;
	if (!rt::json_write(*location.get(), @key)) {
		return false;
	};
	if (seen.find(key.view())) {
		return true;
	};
	if (!@keys.push_back($key) || !@seen.insert(keys.data()[keys.size() - 1].view(), true)) {
		return false;
	};
	return @result.append($location);
};

fn LanguageWorkspace::query(var LanguageWorkspace& this, rt::string_view method, rt::json_value& parameters) -> rt::unique<rt::json_value> {
	u64 started = runtime_clock_nanoseconds();
	@this.receive();
	var LanguageIndex* index = this.published.get();
	if (index && (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range")) {
		return @this.measured(@this.tokens(*index, parameters, method == "textDocument/semanticTokens/range"), $started);
	};
	if (index && method == "textDocument/completion") {
		return @this.measured(@this.completion(*index, parameters), $started);
	};
	if (!index || index->generation < this.minimum_semantic_generation) {
		if (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range") {
			var empty = rt::json_parse("{\"data\":[]}");
			return @this.measured(@empty.release(), $started);
		};
		if (method == "textDocument/hover" || method == "textDocument/signatureHelp") {
			return @this.measured(rt::json_value::make_null(), $started);
		};
		return @this.measured(rt::json_value::make_array(), $started);
	};
	if (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range") {
		return @this.measured(@this.tokens(*index, parameters, method == "textDocument/semanticTokens/range"), $started);
	};

	if (method == "rutile/templateContexts" || method == "rutile/selectTemplateContext") {
		return @this.measured(@this.template_contexts(*index, parameters, method == "rutile/selectTemplateContext"), $started);
	};

	if (method == "textDocument/signatureHelp") {
		return @this.measured(@this.signature(*index, parameters), $started);
	};

	var result = rt::json_value::make_array();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	if (method == "workspace/symbol" || method == "textDocument/documentSymbol") {
		usize source = usize::max;
		if (method == "textDocument/documentSymbol") {
			rt::json_value* identity = parameters.member("textDocument");
			rt::string path;
			rt::string key;
			if (!identity || !LanguageUri::decode(LanguageJson::text(*identity, "uri"), @path) || !LanguageUri::key(path.view(), @key)) {
				return rt::unique<rt::json_value>();
			};
			var found = index->source_ids.find(key.view());
			if (!found) {
				return @this.measured($result, $started);
			};
			@source = *found;
		};
		var filter = LanguageJson::text(parameters, "query");
		usize number = 0;
		while (number < index->symbols.size()) {
			LanguageIndexedSymbol& symbol = index->symbols.data()[number];
			@number = number + 1;
			if ((symbol.value.flags & 4) || source != usize::max && symbol.value.declaration.source != source || !LanguageWorkspace::contains(symbol.name.view(), filter)) {
				continue;
			};
			var location = @this.location(*index, symbol.value.declaration);
			if (!location.get()) {
				continue;
			};
			var information = rt::json_value::make_object();
			if (!information.get() || !@information.get()->set("name", rt::json_value::make_string(symbol.name.view())) || !@information.get()->set("kind", rt::json_value::make_unsigned(static_cast<u64>(symbol.value.kind))) || !@information.get()->set("location", $location) || !@result.get()->append($information)) {
				return rt::unique<rt::json_value>();
			};
		};
		return @this.measured($result, $started);
	};

	rt::buffer<u64> bindings;
	if (!@this.bindings(*index, parameters, @bindings)) {
		return rt::unique<rt::json_value>();
	};
	if (method == "textDocument/hover") {
		return @this.measured(@this.hover(*index, parameters, bindings), $started);
	};

	rt::unordered_map<rt::string_view, bool> seen;
	rt::buffer<rt::string> location_keys;
	usize binding = 0;
	while (binding < bindings.size()) {
		u64 id = bindings.data()[binding];
		@binding = binding + 1;
		var found = index->symbol_ids.find(id);
		if (!found) {
			continue;
		};
		if (method == "textDocument/references") {
			var references = index->references.find(id);
			if (!references) {
				continue;
			};
			rt::json_value* context = parameters.member("context");
			rt::json_value* include = nullptr;
			if (context) {
				@include = context->member("includeDeclaration");
			};
			usize occurrence = 0;
			while (occurrence < references->size()) {
				NavigationOccurrence& item = index->occurrences.data()[references->data()[occurrence]];
				@occurrence = occurrence + 1;
				if ((item.roles & 1) && (!include || !include->boolean())) {
					continue;
				};
				var location = @this.location(*index, item.range);
				if (!LanguageWorkspace::append_location(@*result.get(), $location, @seen, @location_keys)) {
					return rt::unique<rt::json_value>();
				};
			};
		}
		else {
			if (method == "textDocument/typeDefinition") {
				u64 target = index->identity(index->symbols.data()[*found].type_symbol);
				var type = index->symbol_ids.find(target);
				if (!type) {
					continue;
				};
				@found = type;
			};
			NavigationSymbol& destination = index->symbols.data()[*found].value;
			SourceRange range := destination.declaration;
			if (
				(method == "textDocument/definition" || method == "textDocument/typeDefinition")
				&& (destination.flags & 1)
			) {
				usize source = 0;
				usize offset = 0;
				if (
					@this.cursor(*index, parameters, @source, @offset)
					&& source == destination.declaration.source
					&& destination.declaration.begin <= offset
					&& offset <= destination.declaration.end
				) {
					@range = SourceRange(destination.definition);
				};
			};
			var location = @this.location(*index, range);
			if (!LanguageWorkspace::append_location(@*result.get(), $location, @seen, @location_keys)) {
				return rt::unique<rt::json_value>();
			};
		};
	};
	return @this.measured($result, $started);
};

fn LanguageWorkspace::status(var LanguageWorkspace& this) -> rt::unique<rt::json_value> {
	@this.receive();
	var result = rt::json_value::make_object();
	var documents = rt::json_value::make_array();
	if (!result.get() || !documents.get()) {
		return rt::unique<rt::json_value>();
	};
	usize index = 0;
	while (index < this.documents.size()) {
		LanguageDocument& document = *this.documents.data()[index].get();
		var information = rt::json_value::make_object();
		if (!information.get() || !@information.get()->set("uri", rt::json_value::make_string(document.uri.view())) || !@information.get()->set("version", rt::json_value::make_integer(i64(document.version)))) {
			return rt::unique<rt::json_value>();
		};
		var version = rt::json_value::make_null();
		if (this.published.get()) {
			var found = this.published.get()->source_ids.find(document.key.view());
			if (found && this.published.get()->sources.data()[*found].version.has_value()) {
				@version = rt::json_value::make_integer(i64(this.published.get()->sources.data()[*found].version.value()));
			};
		};
		if (!@information.get()->set("indexedVersion", $version) || !@documents.get()->append($information)) {
			return rt::unique<rt::json_value>();
		};
		@index = index + 1;
	};
	u64 generation = 0;
	u64 build = 0;
	if (this.published.get()) {
		@generation = this.published.get()->generation;
		@build = this.published.get()->build_nanoseconds;
	};
	u64 phase = runtime_atomic_load(this.analysis_phase);
	rt::string_view phase_name = "idle";
	switch (phase) {
		case 1: @phase_name = "loadingSources"; break;
		case 2: @phase_name = "compilerAnalysis"; break;
		case 3: @phase_name = "copyingIndex"; break;
		case 4: @phase_name = "sortingIndex"; break;
		case 5: @phase_name = "failed"; break;
	};
	u64 elapsed = 0;
	u64 began = runtime_atomic_load(this.phase_started);
	if (phase && began) {
		@elapsed = runtime_clock_nanoseconds() - began;
	};
	if (!@result.get()->set("analysisPhase", rt::json_value::make_string(phase_name)) || !@result.get()->set("phaseNanoseconds", rt::json_value::make_unsigned($elapsed))) {
		return rt::unique<rt::json_value>();
	};
	if (!@result.get()->set("generation", rt::json_value::make_unsigned(runtime_atomic_load(this.generation))) || !@result.get()->set("indexedGeneration", rt::json_value::make_unsigned(u64(generation))) || !@result.get()->set("indexBuildNanoseconds", rt::json_value::make_unsigned($build)) || !@result.get()->set("queries", rt::json_value::make_unsigned(u64(this.queries))) || !@result.get()->set("lookupNanoseconds", rt::json_value::make_unsigned(u64(this.query_nanoseconds))) || !@result.get()->set("bindingsCurrent", rt::json_value::make_boolean(this.published.get() && generation >= this.minimum_semantic_generation)) || !@result.get()->set("documents", $documents)) {
		return rt::unique<rt::json_value>();
	};
	return $result;
};
