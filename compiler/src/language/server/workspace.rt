fn rutile_editor_source_update(char* path, char* text, usize size);
fn rutile_editor_sources_clear();

struct RuntimeCondition;
struct RuntimeThread;
struct RuntimeAtomic;

fn runtime_condition_create() -> var RuntimeCondition*;
fn runtime_condition_destroy(var RuntimeCondition* condition);
fn runtime_condition_wait(var RuntimeCondition* condition, var RuntimeMutex* mutex, u32 milliseconds) -> i32;
fn runtime_condition_notify(var RuntimeCondition* condition);
fn runtime_thread_start(((var void*) -> i32)* callback, var void* context) -> var RuntimeThread*;
fn runtime_thread_join(var RuntimeThread* thread);
fn runtime_atomic_create(u64 value) -> var RuntimeAtomic*;
fn runtime_atomic_destroy(var RuntimeAtomic* value);
fn runtime_atomic_load(RuntimeAtomic* value) -> u64;
fn runtime_atomic_store(var RuntimeAtomic* destination, u64 value);
fn runtime_atomic_fetch_add(var RuntimeAtomic* destination, u64 value) -> u64;
fn runtime_clock_nanoseconds() -> u64;
fn kiln_project_sources(char* root, ((var void*, char*, char*, i32) -> i32)* add, var void* context, ((var void*, char*) -> void)* diagnostic) -> i32;
fn kiln_project_sources_revision() -> u64;

struct LanguageEdit {
	u64 revision;
	usize begin;
	usize end;
	usize inserted;
};

struct LanguageDocument {
	rt::string uri;
	rt::string path;
	rt::string key;
	LanguageText text;
	i64 version;
	u64 revision;
	u64 opened_revision;
	rt::buffer<LanguageEdit> edits;
	rt::string template_context;
	rt::optional<usize> template_anchor;
	rt::string template_arguments;
};

enum language_group_kind : [u08] {
	target;
	test_target;
	loose;
	analysis;
	standard;
};

struct LanguageGroup {
	language_group_kind kind;
	rt::string name;
	rt::buffer<rt::string> paths;
};

struct LanguageJob {
	u64 generation;
	u64 configuration;
	rt::string root;
	rt::buffer<LanguageDocument> documents;
};

struct LanguageSemanticToken {
	SourceRange range;
	u32 type;
	u32 modifiers;
};

struct LanguageIndexedSource {
	rt::string uri;
	rt::string key;
	LanguageText text;
	rt::optional<i64> version;
	u64 revision;
	rt::unique<rt::json_value> diagnostics;
	rt::buffer<LanguageSemanticToken> tokens;
	rt::unordered_map<usize, usize> token_offsets;
};

struct LanguageIndexedParameter {
	rt::string name;
	rt::string detail;
};

struct LanguageIndexedSymbol {
	NavigationSymbol value;
	u32 semantic_type;
	u64 type_symbol;
	rt::buffer<LanguageIndexedParameter> parameters;
	rt::string name;
	rt::string detail;
};

struct LanguageTemplate {
	SourceRange range;
	SourceRange anchor;
	rt::string name;
	rt::buffer<rt::string> parameters;
};

struct LanguageTemplateResult {
	rt::string key;
	usize anchor;
	rt::string arguments;
	rt::string label;
	rt::string error;
};

struct LanguageIndex {
	fn source(var LanguageIndex& this, Analysis& analysis, usize source, LanguageJob& job) -> usize;
	fn append(var LanguageIndex& this, Analysis& analysis, LanguageJob& job);
	fn finish(var LanguageIndex& this);
	fn append_templates(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping);
	fn classify_source(var LanguageIndex& this, Analysis& analysis, usize original, usize target);
	fn classify_syntax(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping, Syntax& syntax);
	fn classify_bindings(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping);
	fn identity(LanguageIndex& this, u64 id) -> u64;
	fn template_owner(LanguageIndex& this, u64 context) -> u64;
	fn before(NavigationOccurrence& first, NavigationOccurrence& second) -> bool;

	u64 generation;
	u64 build_nanoseconds;
	bool semantic_failed;
	u64 symbol_base;
	u64 scope_base;
	rt::buffer<NavigationScope> scopes;
	rt::unordered_map<u64, usize> scope_ids;
	rt::unordered_map<u64, rt::buffer<usize>> scope_members;
	rt::buffer<NavigationBinding> scope_bindings;
	rt::buffer<NavigationCall> calls;
	rt::buffer<NavigationReceiver> receivers;
	rt::buffer<LanguageIndexedSource> sources;
	rt::unordered_map<rt::string, usize> source_ids;
	rt::buffer<LanguageIndexedSymbol> symbols;
	rt::unordered_map<u64, usize> symbol_ids;
	rt::buffer<NavigationOccurrence> occurrences;
	rt::unordered_map<u64, rt::buffer<usize>> references;
	rt::unique<rt::json_value> diagnostics;
	rt::buffer<rt::string> targets;
	rt::buffer<LanguageTemplate> templates;
	rt::buffer<LanguageTemplateResult> template_results;
	rt::unique<LanguageIndex> retired_next;
};

struct LanguageCancellation {
	var RuntimeAtomic* generation;
	var RuntimeAtomic* stopped;
	u64 expected;
};

struct LanguageWorkspace {
	fn LanguageWorkspace(var LanguageWorkspace& this, var Compiler& compiler, var LanguageProtocol& protocol, rt::string_view root);
	fn LanguageWorkspace(var LanguageWorkspace& this, LanguageWorkspace& other) : [delete];
	fn LanguageWorkspace(var LanguageWorkspace& this, LanguageWorkspace other) : [delete];
	fn ~LanguageWorkspace(var LanguageWorkspace& this);
	fn ready(LanguageWorkspace& this) -> bool;
	fn configure(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn open(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn change(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn close(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn refresh(var LanguageWorkspace& this);
	fn refresh_sources(var LanguageWorkspace& this);
	fn cancel(var LanguageWorkspace& this);
	fn query(var LanguageWorkspace& this, rt::string_view method, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn status(var LanguageWorkspace& this) -> rt::unique<rt::json_value>;

	fn target_key(rt::string_view root, LanguageGroup& group, var rt::string& key);

private:
	fn schedule(var LanguageWorkspace& this);
	fn run(var LanguageWorkspace& this) -> i32;
	fn report_failure(var LanguageWorkspace& this, LanguageJob& job, rt::string_view message);
	fn analyze(var LanguageWorkspace& this, var LanguageJob& job) -> rt::unique<LanguageIndex>;
	fn analyze_group(var LanguageWorkspace& this, var LanguageGroup& group, var LanguageJob& job, var LanguageIndex& index) -> CompilationResult;
	fn receive(var LanguageWorkspace& this);
	fn retire(var LanguageWorkspace& this, rt::unique<LanguageIndex> index);
	fn collect_retired(var LanguageWorkspace& this);
	fn document(var LanguageWorkspace& this, rt::string_view uri) -> var LanguageDocument*;
	fn document_key(var LanguageWorkspace& this, rt::string_view key) -> var LanguageDocument*;
	fn cursor(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var usize& source, var usize& offset) -> LanguageRequestResult;
	fn completion(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn completion_visible(var LanguageWorkspace& this, LanguageIndex& index, NavigationSymbol& symbol) -> bool;
	fn tokens(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool ranged) -> rt::unique<rt::json_value>;
	fn overlay_token(var LanguageWorkspace& this, LanguageIndex& index, rt::string_view key, SourceRange& current, LanguageText& text, var u32& type, var u32& modifiers) -> bool;
	fn signature_item(LanguageIndex& index, NavigationCall& call, u64 identity, usize offset) -> rt::unique<rt::json_value>;
	fn signature(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn mapped(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& input, var SourceRange& output) -> bool;
	fn old_offset(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize current, var usize& original) -> bool;
	fn location(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& range) -> rt::unique<rt::json_value>;
	fn bindings(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var rt::buffer<u64>& result) -> LanguageRequestResult;
	fn template_contexts(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool select) -> rt::unique<rt::json_value>;
	fn template_context(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> u64;
	fn template_context(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize offset) -> u64;
	fn hover(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, rt::buffer<u64>& bindings) -> rt::unique<rt::json_value>;
	fn notify(var LanguageWorkspace& this, rt::string_view method, rt::unique<rt::json_value> parameters);
	fn measured(var LanguageWorkspace& this, rt::unique<rt::json_value> result, u64 started) -> rt::unique<rt::json_value>;
	fn contains(rt::string_view text, rt::string_view part) -> bool;
	fn append_location(var rt::json_value& result, rt::unique<rt::json_value> location, var rt::unordered_map<rt::string, bool>& seen);
	fn add_project(var void* context, char* group, char* path, i32 kind) -> i32;
	fn project_error(var void* context, char* text);
	fn worker(var void* context) -> i32;
	fn cancelled(var void* context) -> i32;

	var Compiler* compiler;
	var LanguageProtocol* protocol;
	var RuntimeMutex* jobs_mutex;
	var RuntimeMutex* publication_mutex;
	var RuntimeCondition* wake;
	var RuntimeThread* thread;
	var RuntimeAtomic* generation;
	var RuntimeAtomic* stopped;
	var RuntimeAtomic* analysis_phase;
	var RuntimeAtomic* phase_started;
	rt::string root;
	u64 configuration;
	u64 cached_configuration;
	u64 sources_revision;
	u64 revision;
	u64 minimum_semantic_generation;
	u64 queries;
	u64 query_nanoseconds;
	rt::buffer<rt::unique<LanguageDocument>> documents;
	rt::unordered_map<rt::string_view, var LanguageDocument*> document_names;
	rt::buffer<LanguageGroup> groups;
	rt::buffer<rt::string> known_targets;
	rt::string discovery_error;
	rt::unique<LanguageJob> pending;
	rt::unique<LanguageIndex> published;
	rt::unique<LanguageIndex> highlight_fallback;
	rt::unique<LanguageIndex> incoming;
	rt::unique<LanguageIndex> retired;
};

fn LanguageWorkspace::LanguageWorkspace(var LanguageWorkspace& this, var Compiler& compiler, var LanguageProtocol& protocol, rt::string_view root) {
	@this.compiler = &@compiler;
	@this.protocol = &@protocol;
	@this.root = rt::string(root);
	@this.configuration = 1;
	@this.sources_revision = kiln_project_sources_revision();
	@this.jobs_mutex = runtime_mutex_create();
	@this.publication_mutex = runtime_mutex_create();
	@this.wake = runtime_condition_create();
	@this.generation = runtime_atomic_create(0);
	@this.analysis_phase = runtime_atomic_create(0);
	@this.phase_started = runtime_atomic_create(0);
	@this.stopped = runtime_atomic_create(0);
	if (this.jobs_mutex && this.publication_mutex && this.wake && this.generation && this.stopped && this.analysis_phase && this.phase_started) {
		@this.thread = runtime_thread_start(&LanguageWorkspace::worker, &@this);
	};
};

fn LanguageWorkspace::~LanguageWorkspace(var LanguageWorkspace& this) {
	rutile_editor_sources_clear();
	@this.cancel();
	if (this.thread) {
		runtime_thread_join(this.thread);
	};
	if (this.publication_mutex) {
		@this.collect_retired();
	};
	if (this.wake) {
		runtime_condition_destroy(this.wake);
	};
	if (this.jobs_mutex) {
		runtime_mutex_destroy(this.jobs_mutex);
	};
	if (this.publication_mutex) {
		runtime_mutex_destroy(this.publication_mutex);
	};
	if (this.analysis_phase) {
		runtime_atomic_destroy(this.analysis_phase);
	};
	if (this.phase_started) {
		runtime_atomic_destroy(this.phase_started);
	};
	if (this.generation) {
		runtime_atomic_destroy(this.generation);
	};
	if (this.stopped) {
		runtime_atomic_destroy(this.stopped);
	};
};

fn LanguageWorkspace::ready(LanguageWorkspace& this) -> bool {
	return this.thread != nullptr;
};

fn LanguageWorkspace::cancel(var LanguageWorkspace& this) {
	if (this.stopped) {
		runtime_atomic_store(this.stopped, 1);
	};
	if (this.generation) {
		discard runtime_atomic_fetch_add(this.generation, 1);
	};
	if (this.wake) {
		runtime_condition_notify(this.wake);
	};
};

fn LanguageWorkspace::worker(var void* context) -> i32 {
	var LanguageWorkspace& workspace = @*reinterpret_cast<var LanguageWorkspace*>(context);
	try {
		return @workspace.run();
	}
	catch (rt::allocation_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker stopped because allocation failed.\n\0".data());
		return 2;
	}
	catch (rt::json_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker stopped because JSON processing failed.\n\0".data());
		return 1;
	}
	catch (compiler_internal_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker internal failure: %s\n\0".data(), error.message.c_str());
		return 2;
	}
	catch (language_transport_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker transport failure: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
		return 1;
	};
};

fn LanguageWorkspace::cancelled(var void* context) -> i32 {
	var LanguageCancellation* cancellation = reinterpret_cast<var LanguageCancellation*>(context);
	return static_cast<i32>(runtime_atomic_load(cancellation->stopped) || runtime_atomic_load(cancellation->generation) != cancellation->expected);
};

fn LanguageWorkspace::run(var LanguageWorkspace& this) -> i32 {
	while (true) {
		@this.collect_retired();
		runtime_mutex_lock(this.jobs_mutex);
		while (!this.pending.get() && !runtime_atomic_load(this.stopped)) {
			discard runtime_condition_wait(this.wake, this.jobs_mutex, 100);
			runtime_mutex_unlock(this.jobs_mutex);
			@this.collect_retired();
			runtime_mutex_lock(this.jobs_mutex);
		};
		if (runtime_atomic_load(this.stopped)) {
			runtime_mutex_unlock(this.jobs_mutex);
			return 0;
		};
		var job = rt::unique<LanguageJob>(@this.pending.release());
		runtime_mutex_unlock(this.jobs_mutex);

		try {
			var index = @this.analyze(@*job.get());
			if (!index.get() && !runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
				runtime_atomic_store(this.analysis_phase, 5);
			};
			if (!index.get() || runtime_atomic_load(this.stopped) || runtime_atomic_load(this.generation) != job.get()->generation) {
				continue;
			};

			if (index.get()->diagnostics.get()) {
				usize item = 0;
				while (item < index.get()->diagnostics.get()->size() && !runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
					@this.notify("textDocument/publishDiagnostics", index.get()->diagnostics.get()->item(item)->clone());
					@item = item + 1;
				};
			};

			rt::unique<LanguageIndex> obsolete;
			runtime_mutex_lock(this.publication_mutex);
			@obsolete = rt::unique<LanguageIndex>(@this.incoming.release());
			runtime_atomic_store(this.analysis_phase, 0);
			@this.incoming = $index;
			runtime_mutex_unlock(this.publication_mutex);
			if (!runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
				var parameters = rt::json_value::make_object();
				if (parameters.get()) {
					@parameters.get()->set("generation", rt::json_value::make_unsigned(u64(job.get()->generation)));
					@this.notify("rutile/semanticTokensChanged", $parameters);
				};
			};
		}
		catch (rt::allocation_error& error) {
			@this.report_failure(*job.get(), "Language analysis failed: allocation could not be satisfied.");
		}
		catch (rt::json_error& error) {
			@this.report_failure(*job.get(), error.message);
		}
		catch (compiler_internal_error& error) {
			@this.report_failure(*job.get(), error.message.view());
		};
	};
};

fn LanguageWorkspace::report_failure(var LanguageWorkspace& this, LanguageJob& job, rt::string_view message) {
	if (runtime_atomic_load(this.stopped) || runtime_atomic_load(this.generation) != job.generation) {
		return;
	};
	runtime_atomic_store(this.analysis_phase, 5);
	try {
		var diagnostic = rt::json_value::make_object();
		@diagnostic.get()->set("type", rt::json_value::make_unsigned(1));
		@diagnostic.get()->set("message", rt::json_value::make_string(message));
		@this.notify("window/logMessage", $diagnostic);
		var completion = rt::json_value::make_object();
		@completion.get()->set("generation", rt::json_value::make_unsigned(u64(job.generation)));
		@this.notify("rutile/semanticTokensChanged", $completion);
	}
	catch (rt::allocation_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis failed; allocation prevented reporting the diagnostic.\n\0".data());
		try {
			@this.protocol->send("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":\"Language analysis failed because allocation could not be satisfied.\"}}");
			@this.protocol->send("{\"jsonrpc\":\"2.0\",\"method\":\"rutile/semanticTokensChanged\",\"params\":{}}");
		}
		catch (rt::allocation_error& failure) {
			discard fprintf(platform_standard_error(), "Language analysis completion could not be sent because allocation failed.\n\0".data());
		};
	}
	catch (rt::json_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis failed; diagnostic JSON could not be produced.\n\0".data());
	}
	catch (language_transport_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis diagnostic transport failed: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
	};
};
fn LanguageWorkspace::receive(var LanguageWorkspace& this) {
	rt::unique<LanguageIndex> next;
	runtime_mutex_lock(this.publication_mutex);
	@next = rt::unique<LanguageIndex>(@this.incoming.release());
	runtime_mutex_unlock(this.publication_mutex);
	if (next.get()) {
		usize target = 0;
		while (target < next.get()->targets.size()) {
			rt::string& key = next.get()->targets.data()[target];
			usize existing = 0;
			while (existing < this.known_targets.size() && this.known_targets.data()[existing].view() != key.view()) {
				@existing = existing + 1;
			};
			if (existing == this.known_targets.size()) {
				@this.known_targets.push_back(rt::string(key));
			};
			@target = target + 1;
		};
	};
	if (next.get() && next.get()->generation >= this.minimum_semantic_generation) {
		var previous = rt::unique<LanguageIndex>(@this.published.release());
		if (next.get()->semantic_failed && previous.get() && !previous.get()->semantic_failed) {
			var obsolete = rt::unique<LanguageIndex>(@this.highlight_fallback.release());
			@this.highlight_fallback = rt::unique<LanguageIndex>(@previous.release());
			@this.retire($obsolete);
		};
		if (!next.get()->semantic_failed) {
			var obsolete = rt::unique<LanguageIndex>(@this.highlight_fallback.release());
			@this.retire($obsolete);
		};
		@this.published = $next;
		@this.retire($previous);
	}
	else {
		@this.retire($next);
	};
};

fn LanguageWorkspace::retire(var LanguageWorkspace& this, rt::unique<LanguageIndex> index) {
	if (!index.get()) {
		return;
	};
	runtime_mutex_lock(this.publication_mutex);
	@index.get()->retired_next = rt::unique<LanguageIndex>(@this.retired.release());
	@this.retired = $index;
	runtime_mutex_unlock(this.publication_mutex);
	runtime_condition_notify(this.wake);
};

fn LanguageWorkspace::collect_retired(var LanguageWorkspace& this) {
	rt::unique<LanguageIndex> garbage;
	runtime_mutex_lock(this.publication_mutex);
	@garbage = rt::unique<LanguageIndex>(@this.retired.release());
	runtime_mutex_unlock(this.publication_mutex);
	while (garbage.get()) {
		var next = rt::unique<LanguageIndex>(@garbage.get()->retired_next.release());
		@garbage.reset(nullptr);
		@garbage = $next;
	};
};

fn LanguageWorkspace::schedule(var LanguageWorkspace& this) {
	if (runtime_atomic_load(this.stopped)) {
		return;
	};
	if (!this.ready()) {
		compiler_panic("language worker is unavailable while scheduling analysis");
	};
	@this.receive();
	rt::unique<LanguageJob> job = rt::unique<LanguageJob>::make();
	if (!job.get()) {
		compiler_panic("language server schedule invariant failed");
	};
	@job.get()->root.append(this.root.view());

	u64 revision = @this.compiler->next_editor_revision();
	if (!revision) {
		compiler_panic("language server schedule invariant failed");
	};
	@job.get()->generation = revision;
	runtime_atomic_store(this.generation, $revision);
	@job.get()->configuration = this.configuration;
	usize target = 0;
	while (target < this.known_targets.size()) {
		if (!(@this.compiler->expect_target(this.known_targets.data()[target].view(), u64(job.get()->generation))).has<void>()) {
			return;
		};
		@target = target + 1;
	};
	usize index = 0;
	while (index < this.documents.size()) {
		if (this.published.get()) {
			var LanguageDocument& document = @*(@this.documents).data()[index].get();
			var source = this.published.get()->source_ids.find(document.key);
			if (source) {
				u64 revision = this.published.get()->sources.data()[*source].revision;
				if (this.highlight_fallback.get()) {
					var fallback = this.highlight_fallback.get()->source_ids.find(document.key);
					if (fallback && this.highlight_fallback.get()->sources.data()[*fallback].revision < revision) {
						@revision = this.highlight_fallback.get()->sources.data()[*fallback].revision;
					};
				};
				usize first = 0;
				while (first < document.edits.size() && document.edits.data()[first].revision <= revision) {
					@first = first + 1;
				};
				usize remaining = document.edits.size() - first;
				usize item = 0;
				while (first && item < remaining) {
					@(@document.edits).data()[item] = LanguageEdit(document.edits.data()[first + item]);
					@item = item + 1;
				};
				while (document.edits.size() > remaining) {
					@document.edits.pop_back();
				};
			};
		};
		@job.get()->documents.push_back(LanguageDocument(*this.documents.data()[index].get()));
		@index = index + 1;
	};

	rt::unique<LanguageJob> obsolete;
	runtime_mutex_lock(this.jobs_mutex);
	@obsolete = rt::unique<LanguageJob>(@this.pending.release());
	@this.pending = $job;
	runtime_mutex_unlock(this.jobs_mutex);
	runtime_condition_notify(this.wake);
};

fn LanguageWorkspace::configure(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	var uri = LanguageJson::text(parameters, "rootUri");
	if (!uri.empty()) {
		rt::string path;
		if (!LanguageUri::decode(uri, @path).has<void>()) {
			return language_request_error();
		};
		@this.root = $path;
	};
	@this.configuration = this.configuration + 1;
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::document_key(var LanguageWorkspace& this, rt::string_view key) -> var LanguageDocument* {
	var found = this.document_names.find(key);
	if (found) {
		return *found;
	};
	return nullptr;
};

fn LanguageWorkspace::document(var LanguageWorkspace& this, rt::string_view uri) -> var LanguageDocument* {
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(uri, @path).has<void>()) {
		return nullptr;
	};
	LanguageUri::key(path.view(), @key);
	return @this.document_key(key.view());
};

fn LanguageWorkspace::open(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	if (!identity) {
		return language_request_error();
	};
	var uri = LanguageJson::text(*identity, "uri");
	rt::unique<LanguageDocument> document = rt::unique<LanguageDocument>::make();
	if (!document.get()) {
		compiler_panic("language document allocation returned no document");
	};
	@document.get()->uri.append(uri);
	if (!LanguageUri::decode(uri, @document.get()->path).has<void>()) {
		return language_request_error();
	};
	LanguageUri::key(document.get()->path.view(), @document.get()->key);
	@document.get()->text.assign(LanguageJson::text(*identity, "text"));
	@document.get()->version = LanguageJson::integer(*identity, "version", 0);
	@this.revision = this.revision + 1;
	@document.get()->revision = this.revision;
	@document.get()->opened_revision = this.revision;

	usize existing = 0;
	while (existing < this.documents.size() && this.documents.data()[existing].get()->key.view() != document.get()->key.view()) {
		@existing = existing + 1;
	};
	if (existing < this.documents.size()) {
		discard @this.document_names.erase(this.documents.data()[existing].get()->key.view());
		if (!@this.document_names.insert(document.get()->key.view(), document.get())) {
			compiler_panic("language document replacement could not be registered");
		};
		@(@this.documents).data()[existing] = $document;
	}
	else {
		var LanguageDocument* added = document.get();
		@this.documents.push_back($document);
		if (!@this.document_names.insert(added->key.view(), (var LanguageDocument*(added)))) {
			@this.documents.pop_back();
			compiler_panic("new language document could not be registered");
		};
	};
	var LanguageDocument* opened = @this.document(uri);
	if (opened) {
		rutile_editor_source_update(opened->path.c_str(), opened->text.view().data(), opened->text.view().size());
	};
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::change(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	rt::json_value* changes = parameters.member("contentChanges");
	if (!identity || !changes || changes->kind() != rt::json_kind::array) {
		return language_request_error();
	};
	var LanguageDocument* document = @this.document(LanguageJson::text(*identity, "uri"));
	i64 version = LanguageJson::integer(*identity, "version", -1);
	if (!document) {
		return language_request_error();
	};
	if (version <= document->version) {
		return;
	};

	usize index = 0;
	while (index < changes->size()) {
		rt::json_value* change = changes->item(index);
		rt::json_value* range = change->member("range");
		usize begin = 0;
		usize end = document->text.view().size();
		if (range) {
			rt::json_value* start = range->member("start");
			rt::json_value* finish = range->member("end");
			if (!start || !finish) {
				return language_request_error();
			};
			@begin = document->text.offset(static_cast<usize>(LanguageJson::integer(*start, "line", 0)), static_cast<usize>(LanguageJson::integer(*start, "character", 0)));
			@end = document->text.offset(static_cast<usize>(LanguageJson::integer(*finish, "line", 0)), static_cast<usize>(LanguageJson::integer(*finish, "character", 0)));
		};
		if (end < begin) {
			return language_request_error();
		};

		var inserted = LanguageJson::text(*change, "text");
		var original = document->text.view();
		usize prefix = 0;
		while (prefix < end && (original.data()[prefix] == ' ' || original.data()[prefix] == '\r' || original.data()[prefix] == '\n' || original.data()[prefix] == '\t')) {
			@prefix = prefix + 1;
		};
		usize trivia = 0;
		while (trivia < inserted.size() && (inserted.data()[trivia] == ' ' || inserted.data()[trivia] == '\r' || inserted.data()[trivia] == '\n' || inserted.data()[trivia] == '\t')) {
			@trivia = trivia + 1;
		};
		if (prefix != end || trivia != inserted.size()) {
			@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
		};

		rt::string replacement;
		@replacement.append(rt::string_view(original.data(), usize(begin)));
		@replacement.append(inserted);
		@replacement.append(rt::string_view(original.data() + end, original.size() - end));
		LanguageEdit edit;
		@this.revision = this.revision + 1;
		@edit.revision = this.revision;
		@edit.begin = usize(begin);
		@edit.end = usize(end);
		@edit.inserted = inserted.size();
		@document->revision = this.revision;
		if (document->template_anchor.has_value()) {
			usize anchor = document->template_anchor.value();
			if (anchor >= end) {
				@document->template_anchor = rt::optional<usize>(anchor - (end - begin) + inserted.size());
			}
			else if (anchor >= begin) {
				@document->template_anchor.reset();
				@document->template_arguments.clear();
			};
		};
		@document->edits.push_back($edit);
		@document->text.assign(replacement.view());
		@index = index + 1;
	};
	@document->version = $version;
	rutile_editor_source_update(document->path.c_str(), document->text.view().data(), document->text.view().size());
	@this.schedule();
};

fn LanguageWorkspace::close(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	if (!identity) {
		return language_request_error();
	};
	var uri = LanguageJson::text(*identity, "uri");
	var LanguageDocument* document = @this.document(uri);
	usize index = 0;
	while (index < this.documents.size()) {
		if (this.documents.data()[index].get() == document) {
			rutile_editor_source_update(document->path.c_str(), nullptr, 0);
			discard @this.document_names.erase(document->key.view());
			usize last = this.documents.size() - 1;
			if (index != last) {
				@(@this.documents).data()[index] = rt::unique<LanguageDocument>(@(@this.documents).data()[last].release());
			};
			@this.documents.pop_back();
			break;
		};
		@index = index + 1;
	};

	var notification = rt::json_value::make_object();
	if (notification.get()) {
		@notification.get()->set("uri", rt::json_value::make_string(uri));
		@notification.get()->set("diagnostics", rt::json_value::make_array());
		@this.notify("textDocument/publishDiagnostics", $notification);
	};
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::refresh(var LanguageWorkspace& this) {
	@this.sources_revision = kiln_project_sources_revision();
	@this.configuration = this.configuration + 1;
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::refresh_sources(var LanguageWorkspace& this) {
	if (!(this.sources_revision == kiln_project_sources_revision())) {
		@this.refresh();
	};
};

fn LanguageWorkspace::notify(var LanguageWorkspace& this, rt::string_view method, rt::unique<rt::json_value> parameters) {
	var message = LanguageJson::notification(method, $parameters);
	rt::string output;
	if (!message.get()) {
		compiler_panic("language server notify invariant failed");
	};
	rt::json_write(*message.get(), @output);
	@this.protocol->send(output.view());
};
