enum language_server_state : [u08] {
	uninitialized;
	running;
	shutdown;
	exited_clean;
	exited_unclean;
};

struct LanguageServer {
	fn LanguageServer(var LanguageServer& this, var LanguageProtocol& protocol, var LanguageWorkspace& workspace);
	fn run(var LanguageServer& this) -> i32;

private:
	fn dispatch(var LanguageServer& this, rt::json_value& message);
	fn send(var LanguageServer& this, rt::unique<rt::json_value> message);
	fn error(var LanguageServer& this, rt::json_value& id, i64 code, rt::string_view text);
	fn initialize(var LanguageServer& this, rt::json_value& id, rt::json_value& parameters);
	fn description() -> rt::json_document;

	var LanguageProtocol* protocol;
	var LanguageWorkspace* workspace;
	language_server_state state;
};

fn LanguageServer::LanguageServer(var LanguageServer& this, var LanguageProtocol& protocol, var LanguageWorkspace& workspace) {
	@this.protocol = &@protocol;
	@this.workspace = &@workspace;
};

fn LanguageServer::send(var LanguageServer& this, rt::unique<rt::json_value> message) {
	rt::string text;
	if (!message.get()) {
		compiler_panic("language server send invariant failed");
	};
	rt::json_write(*message.get(), @text);
	@this.protocol->send(text.view());
};

fn LanguageServer::error(var LanguageServer& this, rt::json_value& id, i64 code, rt::string_view text) {
	@this.send(LanguageJson::failure(id, $code, text));
};

fn LanguageServer::description() -> rt::json_document {
	return rt::json_parse("{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":2,\"save\":{\"includeText\":false}},\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"declarationProvider\":true,\"referencesProvider\":true,\"hoverProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"function\",\"method\",\"keyword\",\"comment\",\"string\",\"number\",\"operator\",\"controlKeyword\",\"decorator\"],\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"static\",\"deprecated\",\"abstract\",\"async\",\"modification\",\"documentation\",\"defaultLibrary\"]},\"range\":true,\"full\":true},\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\",\">\",\"_\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}},\"serverInfo\":{\"name\":\"Rutile Language Server\"}}");
};

fn LanguageServer::initialize(var LanguageServer& this, rt::json_value& id, rt::json_value& parameters) {
	if (this.state != language_server_state::uninitialized) {
		@this.error(id, -32600, "language server is already initialized");
		return;
	};
	if (!(@this.workspace->configure(parameters)).has<void>()) {
		@this.error(id, -32602, "initialize requires a valid project file URI");
		return;
	};

	var description = LanguageServer::description();
	if (!description.has<rt::unique<rt::json_value>>()) {
		compiler_panic("language server initialize invariant failed");
	};
	rt::unique<rt::json_value> result = $description;
	rt::json_value* options = parameters.member("initializationOptions");
	rt::json_value* custom_colors = nullptr;
	if (options) {
		@custom_colors = options->member("rutileSemanticColors");
	};
	if (custom_colors && custom_colors->boolean()) {
		var filtered = rt::json_value::make_object();
		if (!filtered.get()) {
			compiler_panic("language server initialize invariant failed");
		};

		rt::json_value* capabilities = result.get()->member("capabilities");
		usize index = 0;
		while (index < capabilities->size()) {
			var key = capabilities->key(index);
			if (key != "semanticTokensProvider") {
				@filtered.get()->set(key, capabilities->member(key)->clone());
			};
			@index = index + 1;
		};
		@result.get()->set("capabilities", $filtered);
	};
	@this.state = language_server_state::running;
	@this.send(LanguageJson::response(id, $result));
};

fn LanguageServer::dispatch(var LanguageServer& this, rt::json_value& message) {
	if (this.state == language_server_state::running) {
		@this.workspace->refresh_sources();
	};
	var absent = rt::json_value::make_null();
	if (!absent.get()) {
		compiler_panic("language server dispatch invariant failed");
	};
	rt::json_value* supplied_id = message.member("id");
	rt::json_value* id = supplied_id;
	if (!id) {
		@id = absent.get();
	};
	var method = LanguageJson::text(message, "method");
	if (message.kind() != rt::json_kind::object || LanguageJson::text(message, "jsonrpc") != "2.0" || method.empty() || id->kind() != rt::json_kind::number && id->kind() != rt::json_kind::string && id->kind() != rt::json_kind::null_value) {
		@this.error(*absent.get(), -32600, "invalid JSON-RPC request");
		return;
	};
	var empty = rt::json_value::make_object();
	rt::json_value* parameters = message.member("params");
	if (!parameters) {
		@parameters = empty.get();
	};
	if (!parameters) {
		compiler_panic("language server dispatch invariant failed");
	};

	if (method == "exit") {
		if (this.state == language_server_state::shutdown) {
			@this.state = language_server_state::exited_clean;
		}
		else {
			@this.state = language_server_state::exited_unclean;
		};
		@this.workspace->cancel();
		return;
	};
	if (method == "$/cancelRequest") {
		// Indexed requests finish on this dispatch thread; obsolete analysis is
		// cancelled separately through its generation callback.
		return;
	};
	if (this.state == language_server_state::shutdown) {
		if (supplied_id) {
			@this.error(*id, -32600, "language server has shut down");
		};
		return;
	};
	if (method == "initialize") {
		@this.initialize(*id, *parameters);
		return;
	};
	if (this.state == language_server_state::uninitialized) {
		if (supplied_id) {
			@this.error(*id, -32002, "language server is not initialized");
		};
		return;
	};
	if (method == "shutdown") {
		@this.state = language_server_state::shutdown;
		@this.workspace->cancel();
		@this.send(LanguageJson::response(*id, rt::json_value::make_null()));
		return;
	};

	if (method == "textDocument/didOpen" || method == "textDocument/didChange" || method == "textDocument/didClose") {
		LanguageRequestResult accepted;
		if (method == "textDocument/didOpen") {
			@accepted = @this.workspace->open(*parameters);
		}
		else if (method == "textDocument/didChange") {
			@accepted = @this.workspace->change(*parameters);
		}
		else {
			@accepted = @this.workspace->close(*parameters);
		};
		if (accepted.has<language_request_error>() && supplied_id) {
			@this.error(*id, -32602, "invalid document update parameters or unavailable workspace storage");
			return;
		};
		return;
	};
	if (method == "textDocument/didSave" || method == "workspace/didChangeWatchedFiles") {
		@this.workspace->refresh();
		return;
	};
	if (method == "rutile/semanticTokensLegend") {
		var description = LanguageServer::description();
		if (!description.has<rt::unique<rt::json_value>>()) {
			compiler_panic("language server dispatch invariant failed");
		};
		rt::json_value* legend = description.get<rt::unique<rt::json_value>>().get()->member("capabilities")->member("semanticTokensProvider")->member("legend");
		@this.send(LanguageJson::response(*id, legend->clone()));
		return;
	};
	if (method == "rutile/indexStatus") {
		@this.send(LanguageJson::response(*id, @this.workspace->status()));
		return;
	};
	if (method == "rutile/templateContexts" || method == "rutile/selectTemplateContext" || method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range" || method == "textDocument/typeDefinition" || method == "textDocument/completion" || method == "textDocument/signatureHelp" || method == "textDocument/definition" || method == "textDocument/declaration" || method == "textDocument/references" || method == "textDocument/hover" || method == "textDocument/documentSymbol" || method == "workspace/symbol") {
		var result = @this.workspace->query(method, *parameters);
		if (!result.get()) {
			@this.error(*id, -32602, "navigation requires a valid document URI and position");
			return;
		};
		@this.send(LanguageJson::response(*id, $result));
		var status = @this.workspace->status();
		if (status.get()) {
			rt::json_value* current = status.get()->member("generation");
			rt::json_value* indexed = status.get()->member("indexedGeneration");
			if (current && indexed && current->text() != indexed->text()) {
				@this.send(LanguageJson::notification("rutile/indexStatus", $status));
				return;
			};
		};
		return;
	};
	if (supplied_id) {
		@this.error(*id, -32601, "method is not implemented");
	};
};

fn LanguageServer::run(var LanguageServer& this) -> i32 {
	while (this.state != language_server_state::exited_clean && this.state != language_server_state::exited_unclean) {
		rt::string body;
		language_frame_status status = @this.protocol->read(@body);
		if (status == language_frame_status::end_of_stream) {
			break;
		};
		if (status == language_frame_status::error) {
			var id = rt::json_value::make_null();
			if (id.get()) {
				@this.error(*id.get(), -32700, this.protocol->error());
			};
			return 1;
		};

		var document = rt::json_parse(body.view());
		if (document.has<rt::allocation_error>()) {
			throw rt::allocation_error(document.get<rt::allocation_error>());
		};
		if (document.has<rt::json_error>()) {
			var id = rt::json_value::make_null();
			if (!id.get()) {
				return 1;
			}
			else {
				@this.error(*id.get(), -32700, document.get<rt::json_error>().message);
			};
			continue;
		};
		@this.dispatch(*document.get<rt::unique<rt::json_value>>().get());
	};
	@this.workspace->cancel();
	if (this.state == language_server_state::shutdown || this.state == language_server_state::exited_clean) {
		return 0;
	};
	return 1;
};

fn "C" rutile_language_server_main(var Compiler* compiler, var NativeFile* input, var NativeFile* output, char* root) -> i32 {
	try {
		if (!compiler || !input || !output || !root) {
			return 1;
		};
		var protocol = rt::unique<LanguageProtocol>(new LanguageProtocol(@*input, @*output));
		if (!protocol.get()) {
			rt::allocation_error error;
			@error.requested_bytes = sizeof(LanguageProtocol);
			throw $error;
		};
		if (!protocol.get()->ready()) {
			compiler_panic("language protocol synchronization could not be initialized");
		};
		var workspace = rt::unique<LanguageWorkspace>(new LanguageWorkspace(@*compiler, @*protocol.get(), rt::from_c_string(root)));
		if (!workspace.get()) {
			rt::allocation_error error;
			@error.requested_bytes = sizeof(LanguageWorkspace);
			throw $error;
		};
		if (!workspace.get()->ready()) {
			compiler_panic("language workspace worker could not be initialized");
		};
		var server = LanguageServer(@*protocol.get(), @*workspace.get());
		return @server.run();
	}
	catch (rt::allocation_error& error) {
		return 2;
	}
	catch (rt::json_error& error) {
		return 1;
	}
	catch (compiler_internal_error& error) {
		discard fprintf(platform_standard_error(), "Language server internal failure: %s\n\0".data(), error.message.c_str());
		return 2;
	}
	catch (language_transport_error& error) {
		discard fprintf(platform_standard_error(), "Language server transport failure: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
		return 1;
	};
};

fn kiln_emit_target(var Compiler* compiler, char* root, char* name, var char* output, var char* entry, i32 optimization, var NativeFile* diagnostics) -> CompilationResult {
	if (!compiler || !root || !name) {
		var errors = Diagnostics(diagnostics);
		Token location;
		@errors.error(location, "compiler, workspace root, and target name are required for native emission");
		return compilation_error();
	};
	LanguageGroup group;
	@group.kind = language_group_kind::target;
	rt::string key;
	@group.name.append(rt::from_c_string(name));
	LanguageWorkspace::target_key(rt::from_c_string(root), group, @key);
	rt::string_view entry_name = "main";
	if (entry) {
		@entry_name = rt::from_c_string(entry);
	};
	return @compiler->emit_target(key.view(), rt::from_c_string(output), entry_name, $optimization, $diagnostics, output_kind::executable);
};

using TargetSourceCallback = ((var void*, char*, char*, usize) -> void)*;

fn kiln_target_sources(var Compiler* compiler, char* root, char* name, TargetSourceCallback callback, var void* context, var NativeFile* diagnostics) -> i32 {
	if (!compiler || !root || !name || !callback) {
		return 1;
	};
	LanguageGroup group;
	@group.kind = language_group_kind::target;
	rt::string key;
	@group.name.append(rt::from_c_string(name));
	LanguageWorkspace::target_key(rt::from_c_string(root), group, @key);
	var lease = @compiler->acquire_current_target(key.view());
	if (!lease.get()) {
		var errors = Diagnostics(diagnostics);
		Token location;
		@errors.error(location, "no current target analysis is available for native emission");
		return 1;
	};
	if (lease.value().diagnostics().failed()) {
		lease.value().diagnostics().replay(diagnostics);
		return 1;
	};
	usize index = 0;
	while (index < lease.value().source_count()) {
		var path = rt::string(lease.value().source_path(index));
		rt::string_view text = lease.value().source_text(index);
		callback(context, path.c_str(), text.data(), text.size());
		@index = index + 1;
	};
	return 0;
};
