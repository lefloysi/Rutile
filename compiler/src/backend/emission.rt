fn Backend::entry(var Backend& this, var Entity* entity) -> CompilationResult {
	FunctionSignature& signature = entity->type()->signature();
	bool runtime_entry = entity->name() == "__rutile_runtime_main" || entity->name() == "__rutile_test_main";

	if ((!runtime_entry && signature.parameters().size()) || (signature.result()->kind() != type_kind::void_type && !signature.result()->kind().is_integer())) {
		var message = DiagnosticMessage();
		@message.text("executable entry '");
		diagnostic_entity(@message, *entity);
		@message.text("' requires no parameters and an integer or void result; declared signature is '");
		diagnostic_type(@message, *entity->type());
		@message.text("'");
		return @this.error(entity->token(), message.view());
	};

	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.context(), 32);
	var LLVMOpaqueType*[2] parameters {};
	@parameters[0] = integer;
	@parameters[1] = LLVMPointerTypeInContext(this.context(), 0);
	u32 parameter_count = 0;
	if (runtime_entry) {
		@parameter_count = 2;
	};
	var LLVMOpaqueType* type = LLVMFunctionType((var LLVMOpaqueType*(integer)), &@parameters[0], parameter_count, 0);
	if (LLVMGetNamedFunction(this.module(), "main\0".data()) || LLVMGetNamedGlobal(this.module(), "main\0".data())) {
		return @this.error(entity->token(), "generated executable entry conflicts with the native symbol 'main'");
	};
	var LLVMOpaqueValue* main = LLVMAddFunction(this.module(), "main\0".data(), type);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), main, "entry\0".data()));
	var LLVMOpaqueValue*[2] arguments {};
	if (runtime_entry) {
		@arguments[0] = LLVMGetParam(main, 0);
		@arguments[1] = LLVMGetParam(main, 1);
	};
	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), this.symbol(entity), &@arguments[0], parameter_count, "\0".data());

	if (signature.result()->kind() == type_kind::void_type) {
		@result = LLVMConstInt(integer, 0, 0);
	}
	else if (@this.type(signature.result()) != integer) {
		u32 bits = signature.result()->bits();

		if (signature.result()->kind() == type_kind::boolean) {
			@bits = 1;
		};

		if (signature.result()->kind() == type_kind::character) {
			@bits = 8;
		};

		if (bits > 32) {
			@result = LLVMBuildTrunc(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		}
		else if (signature.result()->kind() == type_kind::unsigned_integer || signature.result()->kind() == type_kind::boolean) {
			@result = LLVMBuildZExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		}
		else {
			@result = LLVMBuildSExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		};
	};

	discard LLVMBuildRet(this.builder(), result);

};

fn Backend::emit(var Backend& this, SemanticUnit& unit, rt::string_view entry, output_kind output) -> CompilationResult {
	if (output != output_kind::library) {
		if (output == output_kind::tests) {
			@entry = "__rutile_test_main";
		};
		var Entity* selected = unit.root_scope()->lookup(entry);

		if (!selected || selected->kind() != entity_kind::function || !selected->body() || selected->body()->kind() == semantic_kind::noop) {
			Token location;
			var message = DiagnosticMessage();
			@message.text("executable entry ");
			@message.quoted(entry);
			@message.text(" requires a defined function; ");
			if (!selected) {
				@message.text("the requested name is not declared");
			}
			else {
				@location = selected->token();
				@message.text("selected declaration is ");
				diagnostic_entity_kind(@message, selected->kind());
				@message.text(" '");
				diagnostic_entity(@message, *selected);
				@message.text("'");
				if (selected->kind() == entity_kind::function) {
					@message.text(" of type '");
					diagnostic_type(@message, *selected->type());
					@message.text("' without a definition");
				};
			};
			return @this.error(location, message.view());
		};

		@this.selected_entry = selected->canonical();
	};

	this.progress.report("declaring", 0, unit.entities().size(), "");
	usize index = 0;

	while (index < unit.entities().size()) {
		if (!(@this.declare(unit.entities().data()[index].get())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("declaring", index, unit.entities().size(), "");
	};

	usize function_count = 0;
	if (!(@this.declare_fact_contexts(unit.fact_contexts())).has<void>()) {
		return compilation_error();
	};
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			@function_count = function_count + 1;
		};

		@index = index + 1;
	};

	this.progress.report("functions", 0, function_count, "");
	@index = 0;
	usize compiled_functions = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			var emitter = FunctionEmitter(@this, this.implementation(entity), entity->type()->signature().result());
			DiagnosticMessage detail;
			diagnostic_entity(@detail, *entity);
			this.progress.report("compiling-function", compiled_functions, function_count, detail.view());

			if (!(@emitter.emit(entity)).has<void>()) {
				if (!this.failed()) {
					DiagnosticMessage failure;
					@failure.text("native emission failed without a diagnostic while compiling '");
					diagnostic_entity(@failure, *entity);
					@failure.text("'");
					compiler_panic(failure.view());
				};
				return compilation_error();
			};

			@compiled_functions = compiled_functions + 1;
			this.progress.report("compiling-function", compiled_functions, function_count, detail.view());
		};

		@index = index + 1;
	};

	if (!(@this.emit_fact_contexts()).has<void>()) {
		return compilation_error();
	};
	this.progress.report("dispatch", 0, unit.entities().size(), "");
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary && !(@this.emit_dispatch(entity)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("dispatch", index, unit.entities().size(), "");
	};

	var LLVMOpaqueValue* initialize;
	this.progress.report("initializing", 0, unit.entities().size(), "");
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && !entity->imported_definition() && entity->kind() == entity_kind::global) {
			if (!initialize) {
				@initialize = LLVMAddFunction(this.module(), "rt.initialize\0".data(), LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage((var LLVMOpaqueValue*(initialize)), 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), (var LLVMOpaqueValue*(initialize)), "entry\0".data()));
			};

			var emitter = FunctionEmitter(@this, (var LLVMOpaqueValue*(initialize)), nullptr);

			if (!(@emitter.initialize_value(entity->type(), this.symbol(entity), entity->body())).has<void>() || !(@emitter.finish_expression()).has<void>()) {
				return compilation_error();
			};
		};

		@index = index + 1;
		this.progress.report("initializing", index, unit.entities().size(), "");
	};

	if (initialize) {
		discard LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(initialize, "llvm.global_ctors");
	};

	var LLVMOpaqueValue* finalize;
	@index = unit.entities().size();

	while (index) {
		@index = index - 1;
		var Entity* entity = unit.entities().data()[index].get();
		this.progress.report("finalizing", unit.entities().size() - index, unit.entities().size(), "");

		if (entity->canonical() == entity && !entity->imported_definition() && entity->kind() == entity_kind::global && FunctionEmitter::needs_destruction(entity->type())) {
			if (!finalize) {
				@finalize = LLVMAddFunction(this.module(), "rt.finalize\0".data(), LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage(finalize, 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), finalize, "entry\0".data()));
			};

			var emitter = FunctionEmitter(@this, finalize, nullptr);

			if (!(@emitter.destroy(entity->type(), this.symbol(entity))).has<void>()) {
				return compilation_error();
			};
		};
	};

	if (finalize) {
		discard LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(finalize, "llvm.global_dtors");
	};

	if (output != output_kind::library) {
		if (!(@this.entry(this.selected_entry)).has<void>()) {
			return compilation_error();
		};
	};

	u32 unwind_kind = LLVMGetEnumAttributeKindForName("uwtable\0".data(), 7);
	var LLVMOpaqueAttributeRef* unwind = LLVMCreateEnumAttribute(this.context(), $unwind_kind, 2);
	var LLVMOpaqueValue* function = LLVMGetFirstFunction(this.module());
	while (function) {
		if (LLVMCountBasicBlocks(function)) {
			LLVMAddAttributeAtIndex(function, u32::max, unwind);
		};
		@function = LLVMGetNextFunction(function);
	};
	@this.verify();
};

fn Backend::register_lifecycle(var Backend& this, var LLVMOpaqueValue* function, rt::string_view name) {
	var LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(this.context(), 32);
	@fields[1] = LLVMPointerTypeInContext(this.context(), 0);
	@fields[2] := fields[1];
	var LLVMOpaqueType* record = LLVMStructTypeInContext(this.context(), &@fields[0], 3, 0);
	var LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt((var LLVMOpaqueType*(fields[0])), 65535, 0);
	@values[1] = function;
	@values[2] = LLVMConstNull((var LLVMOpaqueType*(fields[2])));
	var LLVMOpaqueValue*[1] records {};
	@records[0] = LLVMConstNamedStruct((var LLVMOpaqueType*(record)), &@values[0], 3);
	var native_name = rt::string(name);
	var LLVMOpaqueValue* global = LLVMAddGlobal(this.module(), LLVMArrayType2((var LLVMOpaqueType*(record)), 1), native_name.c_str());
	LLVMSetInitializer(global, LLVMConstArray2(record, &@records[0], 1));
	LLVMSetLinkage(global, 7);
};


