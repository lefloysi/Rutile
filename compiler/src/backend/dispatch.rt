fn Backend::implementation(Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].implementation;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::field_index(Backend& this, var Entity* entity, usize index) -> u32 {
	return static_cast<u32>(entity->bases().size() + static_cast<usize>(entity->owns_dispatch()) + index);
};

fn Backend::table(var Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = 0;

	while (index < this.tables.size()) {
		if (this.tables.data()[index].source == entity) {
			return this.tables.data()[index].value;
		};

		@index = index + 1;
	};

	rt::buffer<var LLVMOpaqueValue*> functions;
	@index = 0;

	while (index < entity->virtual_functions().size()) {
		var Entity* function = entity->virtual_functions().data()[index];
		var LLVMOpaqueValue* implementation = this.implementation(function);

		if (!implementation) {
			discard @this.error(function->token(), "virtual implementation has no prepared native declaration");
			return nullptr;
		};

		@functions.push_back(implementation);

		@index = index + 1;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* contents = LLVMConstArray2(pointer, (@functions).data(), functions.size());
	var LLVMOpaqueValue* value = LLVMAddGlobal(this.module(), LLVMTypeOf(contents), "rt.vtable\0".data());
	LLVMSetInitializer(value, contents);
	LLVMSetGlobalConstant(value, 1);
	LLVMSetLinkage(value, 9);
	NativeTable table;
	@table.source = entity;
	@table.value = value;

	@this.tables.push_back($table);

	return value;
};

fn Backend::dispatch_target(var Backend& this, var Entity* entity, var LLVMOpaqueValue* receiver) -> var LLVMOpaqueValue* {
	var Entity* owner = entity->scope()->owner()->virtual_owner();

	if (!owner || !receiver) {
		discard @this.error(entity->token(), "virtual dispatch has no owning receiver layout");
		return nullptr;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.builder(), @this.type(owner->type()), receiver, static_cast<u32>(owner->bases().size()), "dispatch.header\0".data());
	var LLVMOpaqueValue* table = LLVMBuildLoad2(this.builder(), pointer, header, "dispatch.table\0".data());
	var LLVMOpaqueValue* index = LLVMConstInt(LLVMIntTypeInContext(this.context(), this.pointer_bits()), entity->virtual_slot(), 0);
	var LLVMOpaqueValue* slot = LLVMBuildGEP2(this.builder(), pointer, table, &@index, 1, "dispatch.slot\0".data());

	return LLVMBuildLoad2(this.builder(), pointer, slot, "dispatch.target\0".data());
};

fn Backend::emit_dispatch(var Backend& this, var Entity* entity) -> CompilationResult {
	FunctionSignature& signature = entity->type()->signature();

	if (!signature.parameters().size() || signature.parameters().data()[0]->kind() != type_kind::reference || signature.arity() == parameter_arity::variadic) {
		return @this.error(entity->token(), "virtual dispatch requires a fixed signature with an object receiver");
	};

	var LLVMOpaqueValue* function = this.symbol(entity);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), function, "entry\0".data()));
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < signature.parameters().size()) {
		@arguments.push_back(LLVMGetParam(function, static_cast<u32>(index)));

		@index = index + 1;
	};

	var LLVMOpaqueValue* target = @this.dispatch_target(entity, arguments.data()[0]);

	if (!target) {
		return compilation_error();
	};

	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), target, (@arguments).data(), static_cast<u32>(arguments.size()), "\0".data());

	if (signature.result()->kind() == type_kind::void_type) {
		discard LLVMBuildRetVoid(this.builder());
	}
	else {
		discard LLVMBuildRet(this.builder(), result);
	};

};

fn FunctionEmitter::initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	var Entity* record = type->entity();
	var Entity* owner = record->virtual_owner();

	if (!owner) {
		return;
	};

	var LLVMOpaqueValue* table = @this.backend->table(record);

	if (!table) {
		return compilation_error();
	};

	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(owner->type()), address, static_cast<u32>(owner->bases().size()), "initialize.dispatch\0".data());
	discard LLVMBuildStore(this.backend->builder(), table, header);

};
