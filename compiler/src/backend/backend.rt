struct NativeType {
	const Type* source;
	LLVMOpaqueType* value;
};

struct NativeEntity {
	Entity* source;
	LLVMOpaqueValue* value;
	LLVMOpaqueValue* implementation;
};

struct NativeTable {
	Entity* source;
	LLVMOpaqueValue* value;
};

struct Backend {
	fn Backend(Backend& this, Diagnostics& diagnostics);
	fn ~Backend(Backend& this);
	fn initialize(Backend& this, i32 optimization) -> bool;
	fn emit(Backend& this, const SemanticUnit& unit, const rt::string_view& entry, output_kind output) -> bool;
	fn write(Backend& this, File& output) -> bool;
	fn pointer_bits(const Backend& this) -> u32;
	fn type(Backend& this, const Type* source) -> LLVMOpaqueType*;
	fn symbol(const Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn implementation(const Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn table(Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn field_index(const Backend& this, Entity* entity, usize index) -> u32;
	fn context(const Backend& this) -> LLVMOpaqueContext*;
	fn module(const Backend& this) -> LLVMOpaqueModule*;
	fn builder(const Backend& this) -> LLVMOpaqueBuilder*;
	fn layout(const Backend& this) -> LLVMOpaqueTargetData*;
	fn error(Backend& this, const Token& token, const rt::string_view& message) -> bool;
	fn failed(const Backend& this) -> bool;

private:
	fn verify(Backend& this) -> bool;
	fn optimize(Backend& this) -> bool;
	fn declare(Backend& this, Entity* entity) -> bool;
	fn required(const Backend& this, Entity* entity) -> bool;
	fn external_signature(Backend& this, Entity* entity) -> bool;
	fn emit_dispatch(Backend& this, Entity* entity) -> bool;
	fn dispatch_target(Backend& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue*;
	fn entry(Backend& this, Entity* entity) -> bool;
	fn register_lifecycle(Backend& this, LLVMOpaqueValue* function, const char* name);

	Diagnostics* diagnostics;
	Entity* selected_entry;
	i32 optimization;
	rt::unique<LLVMOpaqueContext, ContextDisposer> native_context;
	rt::unique<LLVMOpaqueTargetMachine, MachineDisposer> native_machine;
	rt::unique<LLVMOpaqueModule, ModuleDisposer> native_module;
	rt::unique<LLVMOpaqueBuilder, BuilderDisposer> native_builder;
	rt::unique<LLVMOpaqueTargetData, LayoutDisposer> native_layout;
	rt::buffer<NativeType> types;
	rt::buffer<NativeEntity> entities;
	rt::buffer<NativeTable> tables;
};

fn Backend::Backend(Backend& this, Diagnostics& diagnostics) {
	@this.diagnostics = &diagnostics;
};

fn Backend::~Backend(Backend& this) {
	@this.native_layout.reset(nullptr);
	@this.native_builder.reset(nullptr);
	@this.native_module.reset(nullptr);
	@this.native_machine.reset(nullptr);
	@this.native_context.reset(nullptr);
};

fn Backend::context(const Backend& this) -> LLVMOpaqueContext* {
	return this.native_context.get();
};

fn Backend::module(const Backend& this) -> LLVMOpaqueModule* {
	return this.native_module.get();
};

fn Backend::builder(const Backend& this) -> LLVMOpaqueBuilder* {
	return this.native_builder.get();
};

fn Backend::layout(const Backend& this) -> LLVMOpaqueTargetData* {
	return this.native_layout.get();
};

fn Backend::failed(const Backend& this) -> bool {
	return this.diagnostics->failed();
};

fn Backend::error(Backend& this, const Token& token, const rt::string_view& message) -> bool {
	@this.diagnostics->error(token, message);
	return false;
};

fn Backend::pointer_bits(const Backend& this) -> u32 {
	if (!this.native_layout.get()) {
		return 0;
	};
	return LLVMPointerSize(this.native_layout.get()) * 8;
};

fn Backend::initialize(Backend& this, i32 optimization) -> bool {
	Token location;
	if (optimization < 0 || optimization > 3) {
		return @this.error(location, rt::string_view("optimization level must be between 0 and 3\0"));
	};
	@this.optimization = $optimization;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);
	if (major != 21 || minor != 1 || patch != 0) {
		return @this.error(location, rt::string_view("LLVM runtime version must be 21.1.0\0"));
	};
	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.native_context.reset(LLVMContextCreate());
	if (!this.context()) {
		return @this.error(location, rt::string_view("cannot create LLVM context\0"));
	};
	@this.native_module.reset(LLVMModuleCreateWithNameInContext("rutile\0", this.context()));
	@this.native_builder.reset(LLVMCreateBuilderInContext(this.context()));
	if (!this.module() || !this.builder()) {
		return @this.error(location, rt::string_view("cannot create LLVM module or builder\0"));
	};
	var triple = rt::unique<char, MessageDisposer>(LLVMGetDefaultTargetTriple());
	if (!triple.get()) {
		return @this.error(location, rt::string_view("cannot obtain target triple\0"));
	};
	LLVMTarget* target;
	char* failure;
	if (LLVMGetTargetFromTriple(triple.get(), &target, &failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);
		return @this.error(location, rt::string_view(message.get()));
	};
	@this.native_machine.reset(LLVMCreateTargetMachine(target, triple.get(), "generic\0", "\0", i32(this.optimization), 2, 0));
	if (!this.native_machine.get()) {
		return @this.error(location, rt::string_view("cannot create target machine\0"));
	};
	@this.native_layout.reset(LLVMCreateTargetDataLayout(this.native_machine.get()));
	if (!this.layout()) {
		return @this.error(location, rt::string_view("cannot create target layout\0"));
	};
	var layout = rt::unique<char, MessageDisposer>(LLVMCopyStringRepOfTargetData(this.layout()));
	if (!layout.get()) {
		return @this.error(location, rt::string_view("cannot describe target layout\0"));
	};
	LLVMSetTarget(this.module(), triple.get());
	LLVMSetDataLayout(this.module(), layout.get());
	return true;
};

fn Backend::verify(Backend& this) -> bool {
	char* failure;
	if (!LLVMVerifyModule(this.module(), 2, &failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);
		return true;
	};
	var message = rt::unique<char, MessageDisposer>(failure);
	Token location;
	return @this.error(location, rt::string_view(message.get()));
};

fn Backend::optimize(Backend& this) -> bool {
	if (!@this.verify()) {
		return false;
	};
	var options = rt::unique<LLVMOpaquePassBuilderOptions, PassOptionsDisposer>(LLVMCreatePassBuilderOptions());
	Token location;
	if (!options.get()) {
		return @this.error(location, rt::string_view("cannot create optimization options\0"));
	};
	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 1);
	const char* pipeline = "default<O0>\0";
	switch (this.optimization) {
		case 1:
			@pipeline = "default<O1>\0";
			break;
		case 2:
			@pipeline = "default<O2>\0";
			break;
		case 3:
			@pipeline = "default<O3>\0";
			break;
	};
	LLVMOpaqueError* error = LLVMRunPasses(this.module(), pipeline, this.native_machine.get(), options.get());
	if (error) {
		var message = rt::unique<char, ErrorMessageDisposer>(LLVMGetErrorMessage(error));
		return @this.error(location, rt::string_view(message.get()));
	};
	return @this.verify();
};

fn Backend::write(Backend& this, File& output) -> bool {
	if (this.failed() || !@this.optimize()) {
		return false;
	};
	LLVMOpaqueMemoryBuffer* bytes;
	char* failure;
	Token location;
	if (LLVMTargetMachineEmitToMemoryBuffer(this.native_machine.get(), this.module(), 1, &failure, &bytes)) {
		var message = rt::unique<char, MessageDisposer>(failure);
		return @this.error(location, rt::string_view(message.get()));
	};
	var buffer = rt::unique<LLVMOpaqueMemoryBuffer, BufferDisposer>(bytes);
	if (!@output.write(rt::string_view(LLVMGetBufferStart(buffer.get()), LLVMGetBufferSize(buffer.get())))) {
		return @this.error(location, rt::string_view("cannot write native object output\0"));
	};
	return true;
};
