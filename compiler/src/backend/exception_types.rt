		};
		@destructor = native_exception_thunk(@this, type, destructor_name.view(), false);
		if (!destructor) {
			return nullptr;
		};
	};
	var LLVMOpaqueType* info_type = LLVMStructTypeInContext(this.context(), &@fields[0], 4, 0);
	var LLVMOpaqueValue*[4] info {};
	u64 attributes = 0;
	if (pointee_const) {
		@attributes = 1;
	};
	@info[0] = LLVMConstInt(integer, attributes, 0);
	@info[1] = native_exception_rva(@this, destructor);
	@info[2] = LLVMConstNull(integer);
	@info[3] = native_exception_rva(@this, catchable_array);
	return native_exception_global(@this, "", symbol_name.view(), LLVMConstNamedStruct(info_type, &@info[0], 4));
};
