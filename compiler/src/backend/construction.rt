fn FunctionEmitter::construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() > 1) {
		var LLVMOpaqueValue* storage = @this.address(expression);

		if (!storage) {
			return nullptr;
		};

		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "reconstructed\0".data());
	};

	var LLVMOpaqueValue* storage = @this.slot(expression->type());

	if (!storage || !(@this.construct_into(expression, storage)).has<void>()) {
		return nullptr;
	};
	@this.remember(expression, storage);

	return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "constructed\0".data());
};

fn FunctionEmitter::construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> CompilationResult {
	usize begin = this.unwinds.size();
	if (!(@this.construct_body(expression, storage)).has<void>()) {
		return compilation_error();
	};
	@this.forget_unwinds(begin);
};

fn FunctionEmitter::construct_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> CompilationResult {
	if (expression->integer()) {
		return @this.construct_variant_body(expression, storage);
	};

	Type* type = expression->type();
	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());

	if (!native) {
		return compilation_error();
	};
	if (expression->operation() == token_kind::punct_left_brace) {
		discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), storage);
		return;
	};

	var SemanticExpression* arguments = expression->item(0);
	var LLVMOpaqueValue* value = LLVMConstNull(native);
	var Entity* constructor = expression->entity();

	if (constructor) {
		if (constructor->definition() != function_definition::defaulted || constructor->parameters().size() != 2) {
			discard LLVMBuildStore(this.backend->builder(), value, storage);
		};

		rt::buffer<var LLVMOpaqueValue*> inputs;

		@inputs.push_back(storage);

		usize index = 0;

		while (index < arguments->size()) {
			var LLVMOpaqueValue* argument;

			if (constructor->parameters().data()[index + 1]->type()->kind() == type_kind::reference) {
				@argument = @this.address(arguments->item(index));
			}
			else {
				@argument = @this.value(arguments->item(index));
			};

			if (!argument) {
				return compilation_error();
			};

			@inputs.push_back(argument);

			@index = index + 1;
		};

		@index = 0;
		while (index < arguments->size()) {
			if (constructor->parameters().data()[index + 1]->type()->kind() != type_kind::reference) {
				@this.consume(arguments->item(index));
			};
			@index = index + 1;
		};
		if (!@this.native_call(@this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), (@inputs).data(), static_cast<u32>(inputs.size()))) {
			return compilation_error();
		};

		return;
	};

	if (!arguments || !arguments->size()) {
		return @this.initialize(type, storage);
	};

	if (type->kind().is_scalar() || (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type))) {
		if (!type->kind().is_scalar() && arguments->item(0)->category() == value_category::place) {
			var LLVMOpaqueValue* source = @this.address(arguments->item(0));

			if (!source) {
				return compilation_error();
			};

			return @this.copy_initialize(type, storage, source);
		};

		@value = @this.take(arguments->item(0));

		if (!value) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), value, storage);

		return;
	};

	discard LLVMBuildStore(this.backend->builder(), value, storage);
	usize index = 0;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		if (type->entity()->bases().size()) {
			var message = DiagnosticMessage();
			@message.text("base aggregate argument initialization is not implemented for type '");
			diagnostic_type(@message, *type);
			@message.text("' with argument types (");
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(", ");
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(")");
			return @this.backend->error(expression->token(), message.view());
		};

		if (type->entity()->layout() == record_layout::overlapping) {
			var message = DiagnosticMessage();
			@message.text("union aggregate argument selection is not implemented for type '");
			diagnostic_type(@message, *type);
			@message.text("' with argument types (");
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(", ");
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(")");
			return @this.backend->error(expression->token(), message.view());
		};

		if (!(@this.initialize_dispatch(type, storage)).has<void>()) {
			return compilation_error();
		};

		while (index < type->entity()->fields().size()) {
			var Entity* field = type->entity()->fields().data()[index];
			var LLVMOpaqueValue* destination = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(type->entity(), index), "aggregate.field\0".data());

			if (!(@this.initialize_value(field->type(), destination, arguments->item(index))).has<void>()) {
				return compilation_error();
			};
			@this.retain_unwind(field->type(), destination, nullptr, nullptr);

			@index = index + 1;
		};

		return;
	};

	while (index < arguments->size()) {
		var LLVMOpaqueValue* element = @this.take(arguments->item(index));

		if (!element) {
			return compilation_error();
		};

		@value = LLVMBuildInsertValue(this.backend->builder(), value, element, static_cast<u32>(index), "aggregate\0".data());
		@index = index + 1;
	};

	discard LLVMBuildStore(this.backend->builder(), value, storage);

};

fn FunctionEmitter::allocation_result(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* pointer, var LLVMOpaqueValue* bytes, bool array) -> var LLVMOpaqueValue* {
	Type* type = expression->type();
	var Entity* record = type->entity();
	var Entity* storage_field = record->find_member("_storage");
	var Entity* index_field = record->find_member("_index");
	Type* error_type = variant_flow_type(type, 1);
	if (!storage_field || !index_field || !error_type) {
		discard @this.backend->error(expression->token(), "allocation result requires pointer and allocation_error alternatives");
		return nullptr;
	};
	var Entity* requested_field = error_type->entity()->find_member("requested_bytes");
	var Entity* kind_field = error_type->entity()->find_member("kind");
	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	var LLVMOpaqueType* error_native = @this.backend->type(error_type, expression->token());
	var LLVMOpaqueType* tag_type = @this.backend->type(index_field->type(), expression->token());
	if (!requested_field || !kind_field || !native || !error_native || !tag_type) {
		discard @this.backend->error(expression->token(), "allocation_error requires requested_bytes and kind fields");
		return nullptr;
	};
	rt::string_view kind_name = "single";
	if (array) {
		@kind_name = "array";
	};
	var Entity* category = kind_field->type()->entity()->members()->local(kind_name);
	if (!category) {
		discard @this.backend->error(expression->token(), "allocation_kind requires single and array enumerators");
		return nullptr;
	};
	var LLVMOpaqueValue* result = @this.slot(type);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), result);
	var LLVMOpaqueValue* payload = LLVMBuildStructGEP2(this.backend->builder(), native, result, this.backend->field_index(record, storage_field->index()), "allocation.payload\0".data());
	var LLVMOpaqueValue* tag = LLVMBuildStructGEP2(this.backend->builder(), native, result, this.backend->field_index(record, index_field->index()), "allocation.tag\0".data());
	var LLVMOpaqueBasicBlock* success = @this.block("allocation.success");
	var LLVMOpaqueBasicBlock* failure = @this.block("allocation.failure");
	var LLVMOpaqueBasicBlock* after = @this.block("allocation.after");
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, pointer, LLVMConstNull(LLVMTypeOf(pointer)), "allocation.exists\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), exists, success, failure);
	LLVMPositionBuilderAtEnd(this.backend->builder(), success);
	discard LLVMBuildStore(this.backend->builder(), pointer, payload);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(tag_type, 1, 0), tag);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), failure);
	if (!(@this.initialize(error_type, payload)).has<void>()) {
		return nullptr;
	};
	var LLVMOpaqueValue* requested = LLVMBuildStructGEP2(this.backend->builder(), error_native, payload, this.backend->field_index(error_type->entity(), requested_field->index()), "allocation.requested\0".data());
	discard LLVMBuildStore(this.backend->builder(), bytes, requested);
	var LLVMOpaqueValue* kind = LLVMBuildStructGEP2(this.backend->builder(), error_native, payload, this.backend->field_index(error_type->entity(), kind_field->index()), "allocation.kind\0".data());
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(@this.backend->type(kind_field->type(), expression->token()), category->integer(), 0), kind);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(tag_type, 2, 0), tag);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	@this.remember(expression, result);
	return LLVMBuildLoad2(this.backend->builder(), native, result, "allocation.result\0".data());
};

fn FunctionEmitter::allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() != 1) {
		return @this.allocate_array(expression);
	};

	Type* element = expression->item(0)->type();
	var LLVMOpaqueType* type = @this.backend->type(element, expression->token());

	if (!type) {
		return nullptr;
	};

	var LLVMOpaqueValue* bytes = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), LLVMABISizeOfType(this.backend->layout(), type), 0);
	var LLVMOpaqueValue* pointer = @this.native_allocate(bytes);
	if (expression->item(0)->kind() == semantic_kind::noop) {
		return @this.allocation_result(expression, pointer, bytes, false);
	};
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, pointer, LLVMConstNull(LLVMTypeOf(pointer)), "new.exists\0".data());
	var LLVMOpaqueBasicBlock* initialize = @this.block("new.initialize");
	var LLVMOpaqueBasicBlock* after = @this.block("new.after");
	discard LLVMBuildCondBr(this.backend->builder(), exists, (var LLVMOpaqueBasicBlock*(initialize)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);
	usize unwind_begin = this.unwinds.size();
	@this.retain_unwind(element, nullptr, nullptr, pointer);

	if (!(@this.construct_into(expression->item(0), pointer)).has<void>()) {
		return nullptr;
	};
	@this.forget_unwinds(unwind_begin);

	discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.allocation_result(expression, pointer, bytes, false);
};
