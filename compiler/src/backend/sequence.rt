fn FunctionEmitter::sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> CompilationResult {
	usize bindings = this.bindings.size();
	usize temporaries = this.temporaries.size();

	if (!(@this.statement(expression->item(0))).has<void>() || !(@this.statement(expression->item(1))).has<void>()) {
		return CompilationResult(compilation_error());
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), "control transfer within a sequence initializer is not implemented");
	};

	var SemanticExpression* yielded = expression->item(2);

	if (expression->type()->kind() == type_kind::void_type) {
		if (!(@this.statement(yielded)).has<void>()) {
			return CompilationResult(compilation_error());
		};
	}
	else if (form == native_evaluation::address) {
		@result = @this.address(yielded);
	}
	else if (yielded->category() == value_category::consumable) {
		@result = @this.take(yielded);
	}
	else {
		@result = @this.value(yielded);
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), "control transfer within a sequence yield is not implemented");
	};

	if (expression->type()->kind() != type_kind::void_type && !result) {
		return CompilationResult(compilation_error());
	};

	if (!(@this.cleanup_temporaries(temporaries)).has<void>() || !(@this.leave_scope(bindings)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	@this.forget_temporaries(temporaries);

	return CompilationResult();
};
