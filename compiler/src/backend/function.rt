struct NativeBinding {
	var Entity* entity;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
	usize order;
};

struct NativeTemporary {
	var SemanticExpression* expression;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
	usize order;
};

struct NativeAssignment {
	var LLVMOpaqueValue* value;
	var LLVMOpaqueValue* address;
};

struct NativeControl {
	var LLVMOpaqueBasicBlock* leave;
	var LLVMOpaqueBasicBlock* resume;
	var NativeControl* parent;
	var NativeCatch* catches;
	var NativeHandler* handlers;
	usize binding_boundary;
	usize leave_edges;
};

struct NativeUnwind {
	Type* type;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* count;
	var LLVMOpaqueValue* allocation;
	usize order;
};

struct NativeHandler {
	var LLVMOpaqueBasicBlock* destination;
	var LLVMOpaqueValue* parent_pad;
	var NativeHandler* parent;
	usize bindings;
	usize temporaries;
	usize unwinds;
};

struct NativeCatch {
	var LLVMOpaqueValue* pad;
	var LLVMOpaqueValue* parent_pad;
	var NativeCatch* parent;
	var NativeHandler* handlers;
	var LLVMOpaqueBasicBlock* unwind;
	usize bindings;
	usize temporaries;
	usize unwinds;
};

struct NativeUnwindRoute {
	usize revision;
	usize depth;
	var LLVMOpaqueValue* pad;
	var NativeHandler* handler;
	var LLVMOpaqueBasicBlock* destination;
};

enum native_evaluation : [u08] {
	value;
	address;
};

struct FunctionEmitter {
	fn FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result);

	fn emit(var FunctionEmitter& this, var Entity* function) -> CompilationResult;
	fn set_fact_context(var FunctionEmitter& this, InferredFunctionContext* context);
	fn integer_fact(FunctionEmitter& this, SemanticExpression& expression, var u64& value) -> bool;
	fn condition_fact(FunctionEmitter& this, SemanticExpression& expression, var bool& value) -> bool;
	fn alternative_fact(FunctionEmitter& this, SemanticExpression& expression) -> u64;
	fn statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn value(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn variant_cast_address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address);
	fn destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn destroy_exception(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn needs_destruction(Type* type) -> bool;

	fn take(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn construct_variant_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_value(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* value) -> CompilationResult;

	fn finish_expression(var FunctionEmitter& this) -> CompilationResult;
	fn copy_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn move_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn copy_representation(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;

private:
	fn storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn terminated(FunctionEmitter& this) -> bool;
	fn block(var FunctionEmitter& this, rt::string_view name) -> var LLVMOpaqueBasicBlock*;

	fn slot(var FunctionEmitter& this, Type* type) -> var LLVMOpaqueValue*;
	fn native_slot(var FunctionEmitter& this, var LLVMOpaqueType* type) -> var LLVMOpaqueValue*;

	fn live_flag(var FunctionEmitter& this) -> var LLVMOpaqueValue*;
	fn set_live(var FunctionEmitter& this, var SemanticExpression* expression, bool live);
	fn consume(var FunctionEmitter& this, var SemanticExpression* expression);
	fn remember(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address);
	fn temporary(FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn cleanup_temporaries(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn cleanup_bindings(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn guarded_destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* live) -> CompilationResult;
	fn forget_temporaries(var FunctionEmitter& this, usize begin);
	fn leave_scope(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn native_call(var FunctionEmitter& this, var LLVMOpaqueType* type, var LLVMOpaqueValue* function, var LLVMOpaqueValue var** arguments, u32 count) -> var LLVMOpaqueValue*;
	fn native_allocate(var FunctionEmitter& this, var LLVMOpaqueValue* bytes) -> var LLVMOpaqueValue*;
	fn native_free(var FunctionEmitter& this, var LLVMOpaqueValue* address) -> var LLVMOpaqueValue*;
	fn unwind_destination(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock*;
	fn unwind_cleanup(var FunctionEmitter& this, usize bindings, usize temporaries, usize unwinds) -> CompilationResult;
	fn retain_unwind(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* count, var LLVMOpaqueValue* allocation);
	fn forget_unwinds(var FunctionEmitter& this, usize begin);
	fn exception_try(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn catch_handler(var FunctionEmitter& this, var SemanticExpression* source, var LLVMOpaqueValue* dispatch, var LLVMOpaqueBasicBlock* after, var LLVMOpaqueBasicBlock* unwind, var LLVMOpaqueValue* descriptor) -> CompilationResult;
	fn exception_throw(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn exit_cleanup(var FunctionEmitter& this, usize bindings, var NativeCatch* catches, var NativeHandler* handlers) -> CompilationResult;
	fn terminate_handler(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock*;
	fn retain_components(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address);

	fn scoped_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;

	fn generated(var FunctionEmitter& this, var Entity* function) -> CompilationResult;
	fn generated_variant(var FunctionEmitter& this, var Entity* function, Type* type, var LLVMOpaqueValue* destination) -> CompilationResult;
	fn variant_transfer(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, bool assign) -> CompilationResult;
	fn initialize_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn copy_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn transfer_elements(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, component_transfer operation) -> CompilationResult;
	fn copy_assign(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn copy_assign_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;

	fn binding_live(var FunctionEmitter& this, var Entity* entity, bool live);

	fn evaluate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn truth(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* type) -> var LLVMOpaqueValue*;
	fn convert(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* source, Type* target) -> var LLVMOpaqueValue*;
	fn binary(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn assign(var FunctionEmitter& this, var SemanticExpression* expression) -> NativeAssignment;
	fn logical(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn loop(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn selection(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> CompilationResult;
	fn validate_switch_item(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;

	fn construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn construct_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn copy_initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn initialize_value_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* value) -> CompilationResult;

	fn allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn allocation_result(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* pointer, var LLVMOpaqueValue* bytes, bool array) -> var LLVMOpaqueValue*;
	fn allocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn deallocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn destroy_range(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* memory, var LLVMOpaqueValue* count) -> CompilationResult;
	fn allocation_prefix(var FunctionEmitter& this, Type* type) -> u64;

	fn representation(Type* type) -> Type*;

	var Backend* backend;
	InferredFunctionContext* fact_context;
	var LLVMOpaqueValue* function;
	var LLVMOpaqueValue* variant_payload_address;
	var LLVMOpaqueValue* variant_payload_live;
	Type* result;
	var NativeControl* active_control;
	var NativeHandler* active_handler;
	var NativeHandler* function_handler;
	var LLVMOpaqueValue* active_pad;
	var NativeCatch* active_catch;
	usize unwind_depth;
	usize lifetime_order;
	usize lifetime_revision;
	rt::buffer<NativeBinding> bindings;
	rt::buffer<NativeTemporary> temporaries;
	rt::buffer<NativeUnwind> unwinds;
	rt::buffer<NativeUnwindRoute> unwind_routes;
};

fn FunctionEmitter::FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result) {
	@this.backend = &@backend;
	@this.function = function;
	@this.result = result;
};

fn FunctionEmitter::terminated(FunctionEmitter& this) -> bool {
	var LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());

	return current && LLVMGetBasicBlockTerminator(current) != nullptr;
};

fn FunctionEmitter::block(var FunctionEmitter& this, rt::string_view name) -> var LLVMOpaqueBasicBlock* {
	var native_name = rt::string(name);
	return LLVMAppendBasicBlockInContext(this.backend->context(), this.function, native_name.c_str());
};

fn FunctionEmitter::bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address) {
	NativeBinding binding;
	@binding.entity = entity;
	@binding.address = address;
	@this.lifetime_order = this.lifetime_order + 1;
	@binding.order = this.lifetime_order;

	if (FunctionEmitter::needs_destruction(entity->type())) {
		@binding.live = @this.live_flag();

		if (!binding.live) {
			compiler_panic("cannot create a native binding lifetime flag");
		};

		discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), binding.live);
	};

	@this.bindings.push_back($binding);
	@this.lifetime_revision = this.lifetime_revision + 1;

};

fn FunctionEmitter::storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].address;
		};
	};

	return this.backend->symbol(entity);
};

fn FunctionEmitter::emit(var FunctionEmitter& this, var Entity* function) -> CompilationResult {
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block("entry"));
	NativeHandler boundary;
	if (function->nonthrowing() && native_windows_exceptions(*this.backend)) {
		var LLVMOpaqueBasicBlock* entry = LLVMGetInsertBlock(this.backend->builder());
		@boundary.destination = @this.terminate_handler();
		@this.active_handler = &@boundary;
		@this.function_handler = &@boundary;
		LLVMPositionBuilderAtEnd(this.backend->builder(), entry);
	};
	usize index = 0;

	while (index < function->parameters().size()) {
		var Entity* parameter = function->parameters().data()[index];
		var LLVMOpaqueValue* slot = @this.slot(parameter->type());

		if (!slot) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), LLVMGetParam(this.function, static_cast<u32>(index)), (var LLVMOpaqueValue*(slot)));

		@this.bind(parameter, slot);

		@index = index + 1;
	};

	if (function->definition() == function_definition::defaulted) {
		return @this.generated(function);
	};
	if (function->role() == function_role::destructor && function->nonthrowing()) {
		Type* type = function->parameters().data()[0]->type()->element();
		@this.retain_components(type, LLVMGetParam(this.function, 0));
	};

	if (function->role() == function_role::constructor) {
		Type* type = function->parameters().data()[0]->type()->element();

		if (!(@this.initialize_members(type, LLVMGetParam(this.function, 0))).has<void>()) {
			return compilation_error();
		};
	};

	if (!(@this.statement(function->body())).has<void>()) {
		return compilation_error();
	};

	if (this.terminated()) {
		return;
	};

	if (function->completion() == function_completion::no_fallthrough) {
		discard LLVMBuildUnreachable(this.backend->builder());

		return;
	};

	if (this.result->kind() == type_kind::void_type) {
		if (!(@this.cleanup_bindings(0)).has<void>()) {
			return compilation_error();
		};

		discard LLVMBuildRetVoid(this.backend->builder());

		return;
	};

	var message = DiagnosticMessage();
	@message.text("non-void function reaches the end without a result: '");
	diagnostic_entity(@message, *function);
	@message.text("' has result type '");
	diagnostic_type(@message, *this.result);
	@message.text("'");
	return @this.backend->error(function->token(), message.view());
};

fn FunctionEmitter::address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::variant_cast:
			return @this.variant_cast_address(expression);
		case semantic_kind::variant_payload:
			return this.variant_payload_address;
		case semantic_kind::name: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueValue* address = this.storage((var Entity*(entity)));

			if (!address) {
				discard @this.backend->error(expression->token(), "entity has no native storage");
				return nullptr;
			};

			if (entity->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(entity->type()), address, "reference\0".data());
			};

			return address;
		};

		case semantic_kind::access:
			return @this.address(expression->item(0));
		case semantic_kind::dereference:
			return @this.value(expression->item(0));
		case semantic_kind::call: {
			Type* callable = expression->item(0)->type();

			if (callable->kind() == type_kind::pointer) {
				@callable = callable->element();
			};

			if (callable->signature().result()->kind() == type_kind::reference) {
				return @this.call(expression);
			};

			break;
		};

		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy) {
				var assigned = @this.assign(expression);

				return assigned.address;
			};

			break;
		case semantic_kind::member: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);

			if (!address) {
				return nullptr;
			};

			var LLVMOpaqueValue* field = address;
			Type* owner = expression->entity()->scope()->owner()->type();

			if (owner->entity()->layout() == record_layout::sequential) {
				var LLVMOpaqueType* native = @this.backend->type(owner, expression->token());
				if (!native) {
					return nullptr;
				};
				@field = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(owner->entity(), expression->entity()->index()), "field\0".data());
			};

			if (expression->entity()->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->entity()->type()), field, "field.reference\0".data());
			};

			return field;
		};

		case semantic_kind::index: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* index = @this.value(expression->item(1));

			if (!index) {
				return nullptr;
			};

			Type* offset_type = expression->item(1)->type()->representation();
			bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
			@index = LLVMBuildIntCast2(this.backend->builder(), index, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "element.offset\0".data());

			rt::buffer<var LLVMOpaqueValue*> indices;
			var LLVMOpaqueValue* base;
			Type* element = object->type();

			if (element->kind() == type_kind::array) {
				@base = @this.address(object);

				@indices.push_back(LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 0, 0));
			}
			else {
				@base = @this.value(object);
				@element = element->element();
			};

			if (!base) {
				return nullptr;
			};

			@indices.push_back(index);

			var LLVMOpaqueType* native = @this.backend->type(element, expression->token());
			if (!native) {
				return nullptr;
			};
			return LLVMBuildGEP2(this.backend->builder(), native, base, (@indices).data(), static_cast<u32>(indices.size()), "element\0".data());
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				return @this.address(expression->item(0));
			};

			break;
		case semantic_kind::construction:
			if (expression->size() > 1) {
				var LLVMOpaqueValue* storage = @this.address(expression->item(1));

				if (!storage || !(@this.construct_into(expression, storage)).has<void>()) {
					return nullptr;
				};

				@this.set_live(expression->item(1), true);

				return storage;
			};

			discard @this.value(expression);

			return this.temporary(expression);
		case semantic_kind::sequence:
			if (expression->category() == value_category::place) {
				var LLVMOpaqueValue* result;

				if (!(@this.sequence(expression, native_evaluation::address, @result)).has<void>()) {
					return nullptr;
				};

				return result;
			};

			break;
	};

	if (expression->category() == value_category::consumable) {
		var LLVMOpaqueValue* value = @this.value(expression);

		if (!value) {
			return nullptr;
		};

		var LLVMOpaqueValue* storage = this.temporary(expression);

		if (storage) {
			return storage;
		};

		@storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		discard LLVMBuildStore(this.backend->builder(), value, storage);

		@this.remember(expression, storage);

		return storage;
	};

	discard @this.backend->error(expression->token(), "expression does not designate native storage");
	return nullptr;
};

fn FunctionEmitter::call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* callable = expression->item(0);
	Type* type = callable->type();

	if (type->kind() == type_kind::pointer) {
		@type = type->element();
	};

	if (type->kind() != type_kind::function) {
		discard @this.backend->error(expression->token(), "call target has no native function signature");
		return nullptr;
	};

	var LLVMOpaqueValue* function = @this.value(callable);

	if (!function) {
		return nullptr;
	};

	FunctionSignature& signature = type->signature();
	var SemanticExpression* source_arguments = expression->item(1);
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < source_arguments->size()) {
		var SemanticExpression* source = source_arguments->item(index);

		if (index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic && !source->type()->representation()->kind().is_scalar()) {
			var message = DiagnosticMessage();
			@message.text("aggregate variadic argument ");
			@message.number(u64(index + 1));
			@message.text(" of type '");
			diagnostic_type(@message, *source->type());
			@message.text("' requires unsupported C ABI lowering for callable '");
			if (callable->entity()) {
				diagnostic_entity(@message, *callable->entity());
			}
			else {
				diagnostic_type(@message, *type);
			};
			@message.text("'");
			discard @this.backend->error(source->token(), message.view());
			return nullptr;
		};

		var LLVMOpaqueValue* argument;

		if (index < signature.parameters().size() && signature.parameters().data()[index]->kind() == type_kind::reference) {
			@argument = @this.address(source);
		}
		else {
			@argument = @this.value(source);

			if (argument && index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic) {
				Type* type = FunctionEmitter::representation(source->type());

				if (type->kind() == type_kind::floating_point && type->bits() == 32) {
					@argument = LLVMBuildFPExt(this.backend->builder(), argument, LLVMDoubleTypeInContext(this.backend->context()), "vararg.float\0".data());
				}
				else if (type->kind() == type_kind::boolean || type->kind() == type_kind::character || (type->kind().is_integer() && type->bits() < 32)) {
					bool signed_value = type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean;
					@argument = LLVMBuildIntCast2(this.backend->builder(), argument, LLVMIntTypeInContext(this.backend->context(), 32), static_cast<i32>($signed_value), "vararg.integer\0".data());
				};
			};
		};

		if (!argument) {
			return nullptr;
		};

		@arguments.push_back(argument);

		@index = index + 1;
	};

	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	if (!native) {
		return nullptr;
	};
	@index = 0;
	while (index < source_arguments->size()) {
		if (index >= signature.parameters().size() || signature.parameters().data()[index]->kind() != type_kind::reference) {
			@this.consume(source_arguments->item(index));
		};
		@index = index + 1;
	};
	var LLVMOpaqueValue* specialized = this.backend->redirected_call(*expression, this.fact_context);
	if (specialized) {
		@function = specialized;
	};
	return @this.native_call(native, function, (@arguments).data(), static_cast<u32>(arguments.size()));
};

fn FunctionEmitter::native_slot(var FunctionEmitter& this, var LLVMOpaqueType* native) -> var LLVMOpaqueValue* {
	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		compiler_panic("cannot create a native storage builder");
	};

	var LLVMOpaqueBasicBlock* entry = LLVMGetEntryBasicBlock(this.function);
	var LLVMOpaqueValue* first = LLVMGetFirstInstruction((var LLVMOpaqueBasicBlock*(entry)));

	if (first) {
		LLVMPositionBuilderBefore(builder.get(), first);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), entry);
	};

	var LLVMOpaqueValue* storage = LLVMBuildAlloca(builder.get(), native, "storage\0".data());
	if (!storage) {
		compiler_panic("cannot allocate native storage");
	};
	return storage;
};
