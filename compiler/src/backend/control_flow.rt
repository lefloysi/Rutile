fn FunctionEmitter::conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	var SemanticExpression* condition = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = @this.truth(@this.value(condition), condition->type());

	if (!truth) {
		return CompilationResult(compilation_error());
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* yes = @this.block("if.yes");
	var LLVMOpaqueBasicBlock* no = @this.block("if.no");
	var LLVMOpaqueBasicBlock* after = @this.block("if.after");
	discard LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(yes)), (var LLVMOpaqueBasicBlock*(no)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), yes);

	if (!(@this.scoped_statement(expression->item(1))).has<void>()) {
		return CompilationResult(compilation_error());
	};

	bool yes_returns = this.terminated();

	if (!yes_returns) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), no);

	if (!(@this.scoped_statement(expression->item(2))).has<void>()) {
		return CompilationResult(compilation_error());
	};

	bool no_returns = this.terminated();

	if (!no_returns) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (yes_returns && no_returns) {
		discard LLVMBuildUnreachable(this.backend->builder());
	};

	return CompilationResult();
};

fn FunctionEmitter::loop(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	usize scope_boundary = this.bindings.size();
	usize condition_index = 0;
	usize body_index = 1;

	if (expression->kind() == semantic_kind::for_loop) {
		if (!(@this.statement(expression->item(0))).has<void>()) {
			return CompilationResult(compilation_error());
		};

		@condition_index = 1;
		@body_index = 3;
	};

	var LLVMOpaqueBasicBlock* test = @this.block("loop.condition");
	var LLVMOpaqueBasicBlock* body = @this.block("loop.body");
	var LLVMOpaqueBasicBlock* step = test;

	if (expression->kind() == semantic_kind::for_loop) {
		@step = @this.block("loop.step");
	};

	var LLVMOpaqueBasicBlock* after = @this.block("loop.after");
	discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	var SemanticExpression* condition = expression->item(condition_index);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0);

	if (condition && condition->kind() != semantic_kind::noop) {
		@truth = @this.truth(@this.value(condition), condition->type());
	};

	if (!truth) {
		return CompilationResult(compilation_error());
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	@this.forget_temporaries(temporary_boundary);
	discard LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(body)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	NativeControl loop;
	@loop.leave := after;
	@loop.resume := step;
	@loop.parent := this.active_control;
	@loop.catches = this.active_catch;
	@loop.handlers = this.active_handler;
	@loop.binding_boundary = this.bindings.size();
	@this.active_control = &@loop;
	var emitted = @this.scoped_statement(expression->item(body_index));
	@this.active_control := loop.parent;

	if (emitted.has<compilation_error>()) {
		return CompilationResult(compilation_error());
	};

	if (!this.terminated()) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(step)));
	};

	if (expression->kind() == semantic_kind::for_loop) {
		LLVMPositionBuilderAtEnd(this.backend->builder(), step);

		if (!(@this.statement(expression->item(2))).has<void>()) {
			return CompilationResult(compilation_error());
		};

		if (!this.terminated()) {
			discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
		};
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return CompilationResult();
	};
	if (expression->kind() == semantic_kind::variant_cast && expression->type()->kind() == type_kind::void_type) {
		if (@this.variant_cast_address(expression) != nullptr) {
			return CompilationResult();
		};
		return CompilationResult(compilation_error());
	};

	if (this.backend->failed()) {
		return CompilationResult(compilation_error());
	};

	switch (expression->kind()) {
		case semantic_kind::statements: {
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!(@this.statement(expression->item(index))).has<void>()) {
					return CompilationResult(compilation_error());
				};

				@index = index + 1;
			};

			return CompilationResult();
		};

		case semantic_kind::sequence:
			if (expression->type()->kind() == type_kind::void_type) {
				var LLVMOpaqueValue* result;

				return @this.sequence(expression, native_evaluation::value, @result);
			};

			break;
		case semantic_kind::brace: {
			usize scope_boundary = this.bindings.size();
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!(@this.statement(expression->item(index))).has<void>()) {
					return CompilationResult(compilation_error());
				};

				@index = index + 1;
			};

			return @this.leave_scope(scope_boundary);
		};

		case semantic_kind::variable: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueType* type = @this.backend->type(entity->type(), entity->token());

			if (!type) {
				return CompilationResult(compilation_error());
			};

			var LLVMOpaqueValue* slot = @this.slot(entity->type());

			if (!slot) {
				return CompilationResult(compilation_error());
			};
			@this.bind((var Entity*(entity)), (var LLVMOpaqueValue*(slot)));

			@this.binding_live(entity, false);

			if (!(@this.initialize_value(entity->type(), slot, expression->item(0))).has<void>()) {
				return CompilationResult(compilation_error());
			};

			@this.binding_live(entity, true);
			return CompilationResult();
		};

		case semantic_kind::return_value: {
			if (this.result->kind() == type_kind::void_type) {
				var SemanticExpression* operand = expression->item(0);

				if (operand && operand->kind() != semantic_kind::noop && !(@this.statement(operand)).has<void>()) {
					return CompilationResult(compilation_error());
				};
				if (this.terminated()) {
					return CompilationResult();
				};

				if (!(@this.exit_cleanup(0, nullptr, this.function_handler)).has<void>()) {
					return CompilationResult(compilation_error());
				};

				discard LLVMBuildRetVoid(this.backend->builder());

				return CompilationResult();
			};

			var LLVMOpaqueValue* value;

			if (this.result->kind() == type_kind::reference) {
				@value = @this.address(expression->item(0));
			}
			else {
				@value = @this.take(expression->item(0));
			};

			if (!value) {
				return CompilationResult(compilation_error());
			};

			usize unwind_begin = this.unwinds.size();
			if (FunctionEmitter::needs_destruction(this.result)) {
				var LLVMOpaqueValue* storage = @this.slot(this.result);
				if (!storage) {
					return CompilationResult(compilation_error());
				};
				discard LLVMBuildStore(this.backend->builder(), value, storage);
				@this.retain_unwind(this.result, storage, nullptr, nullptr);
			};
			if (!(@this.exit_cleanup(0, nullptr, this.function_handler)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			@this.forget_unwinds(unwind_begin);
			discard LLVMBuildRet(this.backend->builder(), value);

			return CompilationResult();
		};

		case semantic_kind::conditional:
			return @this.conditional(expression);
		case semantic_kind::exception_try:
			return @this.exception_try(expression);
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
			return @this.exception_throw(expression);
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);
			if (!address) {
				return CompilationResult(compilation_error());
			};
			@this.set_live(object, false);
			return @this.destroy(object->type(), address);
		};

		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(expression);
		case semantic_kind::switch_expression:
			return @this.selection(expression);
		case semantic_kind::break_loop:
		case semantic_kind::continue_loop: {
			var NativeControl* target = this.active_control;

			if (expression->kind() == semantic_kind::continue_loop) {
				while (target && !target->resume) {
					@target = target->parent;
				};
			};

			if (!target) {
				return @this.backend->error(expression->token(), "control transfer has no enclosing native destination");
			};

			if (!(@this.exit_cleanup(target->binding_boundary, target->catches, target->handlers)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			if (expression->kind() == semantic_kind::break_loop) {
				@target->leave_edges = target->leave_edges + 1;
				discard LLVMBuildBr(this.backend->builder(), target->leave);
			}
			else {
				discard LLVMBuildBr(this.backend->builder(), target->resume);
			};

			return CompilationResult();
		};
	};

	if (@this.value(expression) != nullptr) {
		return CompilationResult();
	};
	return CompilationResult(compilation_error());
};

fn FunctionEmitter::statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return CompilationResult();
	};

	usize begin = this.temporaries.size();

	if (!(@this.lower_statement(expression)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	if (!this.terminated() && !(@this.cleanup_temporaries(begin)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	@this.forget_temporaries(begin);

	return CompilationResult();
};
