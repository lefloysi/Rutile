fn LLVMConstReal(LLVMOpaqueType* type, f64 value) -> LLVMOpaqueValue*;
fn LLVMConstNull(LLVMOpaqueType* type) -> LLVMOpaqueValue*;
fn LLVMConstStringInContext2(LLVMOpaqueContext* context, const char* text, usize length, i32 no_terminator) -> LLVMOpaqueValue*;
