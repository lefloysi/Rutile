fn LLVMAddGlobal(LLVMOpaqueModule* module, LLVMOpaqueType* type, const char* name) -> LLVMOpaqueValue*;
fn LLVMSetInitializer(LLVMOpaqueValue* global, LLVMOpaqueValue* initializer);
fn LLVMSetGlobalConstant(LLVMOpaqueValue* global, i32 immutable);
