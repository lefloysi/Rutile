fn FunctionEmitter::variant_cast_address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* receiver = expression->item(0);
	Type* owner = receiver->type();
	var Entity* storage_field = owner->entity()->find_member("_storage");
	var Entity* index_field = owner->entity()->find_member("_index");
	var LLVMOpaqueValue* object = @this.address(receiver);
	var LLVMOpaqueType* native = @this.backend->type(owner, expression->token());
	if (!object || !native || !storage_field || !index_field) {
		return nullptr;
	};
	var LLVMOpaqueValue* storage = LLVMBuildStructGEP2(this.backend->builder(), native, object, this.backend->field_index(owner->entity(), storage_field->index()), "variant.payload\0".data());
	TemplatePack* alternatives = owner->entity()->template_arguments()->arguments.data()[0].pack;
	Type* selected = alternatives->elements.data()[usize(expression->integer() - 1)].type;
	if (storage && this.alternative_fact(*expression) == expression->integer()) {
		if (selected->kind() == type_kind::reference) {
			return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(selected), storage, "variant.reference\0".data());
		};
		return storage;
	};
	var LLVMOpaqueValue* tag_address = LLVMBuildStructGEP2(this.backend->builder(), native, object, this.backend->field_index(owner->entity(), index_field->index()), "variant.tag.address\0".data());
	var LLVMOpaqueType* tag_type = @this.backend->type(index_field->type(), expression->token());
	if (!storage || !tag_address || !tag_type) {
		return nullptr;
	};
	var LLVMOpaqueValue* tag = LLVMBuildLoad2(this.backend->builder(), tag_type, tag_address, "variant.tag\0".data());
	var LLVMOpaqueBasicBlock* success = @this.block("variant.cast.success");
	var LLVMOpaqueBasicBlock* invalid = @this.block("variant.cast.invalid");
	var LLVMOpaqueValue* dispatch = LLVMBuildSwitch(this.backend->builder(), tag, invalid, static_cast<u32>(expression->size() - 1));
	LLVMAddCase(dispatch, LLVMConstInt(tag_type, expression->integer(), 0), success);
	usize index = 1;
	while (index < expression->size()) {
		if (u64(index) != expression->integer()) {
			var LLVMOpaqueBasicBlock* mismatch = @this.block("variant.cast.mismatch");
			LLVMAddCase(dispatch, LLVMConstInt(tag_type, u64(index), 0), mismatch);
			LLVMPositionBuilderAtEnd(this.backend->builder(), mismatch);
			var LLVMOpaqueValue* previous = this.variant_payload_address;
			var LLVMOpaqueValue* previous_live = this.variant_payload_live;
			@this.variant_payload_address = storage;
			@this.variant_payload_live = nullptr;
			if (receiver->category() == value_category::consumable) {
				for (usize temporary_index = this.temporaries.size(); temporary_index; @temporary_index = temporary_index - 1) {
					NativeTemporary& temporary = this.temporaries.data()[temporary_index - 1];
					if (temporary.expression == receiver) {
						@this.variant_payload_live = temporary.live;
						break;
					};
				};
			};
			var emitted = @this.statement(expression->item(index));
			@this.variant_payload_address = previous;
			@this.variant_payload_live = previous_live;
			if (emitted.has<compilation_error>()) {
				return nullptr;
			};
		};
		@index = index + 1;
	};
	LLVMPositionBuilderAtEnd(this.backend->builder(), invalid);
	discard LLVMBuildUnreachable(this.backend->builder());
	LLVMPositionBuilderAtEnd(this.backend->builder(), success);
	if (selected->kind() == type_kind::reference) {
		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(selected), storage, "variant.reference\0".data());
	};
	return storage;
};
