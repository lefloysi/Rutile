// Local reference loans. Raw-pointer storage is deliberately outside this analysis.
struct ReferenceLoanPlace {
	bool reference_contents;
	var Entity* root;
	var Entity* field;
	var Entity* through;
	var SemanticExpression* element;
};

fn reference_loan_overlap(ReferenceLoanPlace& first, ReferenceLoanPlace& second) -> bool {
	if (first.reference_contents != second.reference_contents || first.root != second.root || first.field && second.field && first.field != second.field) {
		return false;
	};
	if (first.element && second.element) {
		u64 left = 0;
		u64 right = 0;
		bool known_left = first.element->constant_integer(@left) || first.element->inferred_integer(@left);
		bool known_right = second.element->constant_integer(@right) || second.element->inferred_integer(@right);
		if (known_left && known_right && left != right) {
			return false;
		};
	};
	return true;
};

enum reference_loan_access : [u08] {
	read;
	write;
};

enum reference_loan_phase : [u08] {
	collect;
	validate;
};

struct ReferenceLoan {
	ReferenceSlotPath holding;
	var Entity* binding;
	var Entity* stored_field;
	usize creation;
	ReferenceLoanPlace place;
	type_qualifier permission;
	rt::buffer<usize> escapes;
};

struct ReferenceLoanSubstitution {
	var Entity* parameter;
	rt::buffer<ReferenceLoanPlace> places;
};

fn reference_loan_members_at(Type& type, usize depth) -> bool {
	if (depth > 16) {
		return true;
	};
	if (type.kind() == type_kind::array) {
		return type.count() && reference_loan_members_at(*type.element(), depth + 1);
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return false;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		Type* member = type.entity()->fields().data()[index]->type();
		if (member->kind() == type_kind::reference || reference_loan_members_at(*member, depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_loan_members(Type& type) -> bool {
	return reference_loan_members_at(type, 0);
};

fn reference_loan_permission(Type& type, usize depth) -> type_qualifier {
	if (type.kind() == type_kind::array) {
		return reference_loan_permission(*type.element(), depth + 1);
	};
	if (type.kind() == type_kind::reference) {
		return type.element()->qualifier();
	};
	if (depth > 16 || !reference_loan_members(type)) {
		return type_qualifier::immutable;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		if (reference_loan_permission(*type.entity()->fields().data()[index]->type(), depth + 1) == type_qualifier::mutable) {
			return type_qualifier::mutable;
		};
		@index = index + 1;
	};
	return type_qualifier::immutable;
};

enum reference_walk_task_kind : [u08] {
	walk;
	storage;
	array_aggregate;
	record_aggregate;
	reference_binding;
	call_post;
};

struct ReferenceWalkTask {
	reference_walk_task_kind kind;
	var SemanticExpression* expression;
	reference_loan_access access;
	fn ReferenceWalkTask(var ReferenceWalkTask& this, reference_walk_task_kind kind, var SemanticExpression* expression, reference_loan_access access);
};

fn ReferenceWalkTask::ReferenceWalkTask(var ReferenceWalkTask& this, reference_walk_task_kind kind, var SemanticExpression* expression, reference_loan_access access) {
	@this.kind = $kind;
	@this.expression = expression;
	@this.access = $access;
};

struct ReferenceLoanAnalyzer {
	fn ReferenceLoanAnalyzer(var ReferenceLoanAnalyzer& this, var Diagnostics& diagnostics);
	fn validate(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult;

	private:
	fn collect(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression);
	fn position(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> usize;
	fn build_graph(var ReferenceLoanAnalyzer& this, Entity& function);
	fn reachable(var ReferenceLoanAnalyzer& this, usize source, usize target, usize kill, var Entity* cleanup_owner) -> bool;
	fn active(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& expression) -> bool;
	fn active_at(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, usize point) -> bool;
	fn owner_live_at(var ReferenceLoanAnalyzer& this, var Entity* owner, usize target) -> bool;
	fn validate_ends(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn loan_store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceLoan& loan, usize definition) -> bool;
	fn retain_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn retain_special_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn retain_constructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth, reference_initialization_kind mode, var SemanticExpression* initialization) -> CompilationResult;
	fn retain_destructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth) -> CompilationResult;
	fn retain_effect_capture(var ReferenceLoanAnalyzer& this, var Entity& function, var Entity* owner, var SemanticExpression* arguments, usize position, SemanticExpression& location) -> CompilationResult;
	fn prepare_captures(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn capture_walk(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var Entity& function) -> CompilationResult;
	fn contextual_capture(var ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool;
	fn captures(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument) -> bool;
	fn capture_mode(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool;
	fn place(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> ReferenceLoanPlace;
	fn places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult;
	fn returned_places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult;
	fn initializer(ReferenceLoanAnalyzer& this, SemanticExpression& expression, Entity& binding) -> var SemanticExpression*;
	fn aggregate(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult;
	fn array_aggregate(var ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> CompilationResult;
	fn content_sources(var ReferenceLoanAnalyzer& this, Type& type, SemanticExpression* source, var rt::buffer<ReferenceContentRoot>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, ReferenceSlotPath& holding, var Entity* symbolic, usize depth) -> CompilationResult;
	fn stored_contents(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var bool& found) -> CompilationResult;
	fn holding_use(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, var SemanticExpression& expression) -> bool;
	fn loan_definition(ReferenceLoanAnalyzer& this, ReferenceLoan& loan) -> usize;
	fn reaching_contents(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& use) -> bool;
	fn append_array_loan(var ReferenceLoanAnalyzer& this, ReferenceLoan loan);
	fn refresh_array_aliases(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn returned_local_places(var ReferenceLoanAnalyzer& this, var Entity& function, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, usize depth) -> CompilationResult;
	fn prepare_unknowns(var ReferenceLoanAnalyzer& this, SemanticUnit& unit);
	fn collect_unknowns(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn unknown_event(var ReferenceLoanAnalyzer& this, var Entity* root, ReferenceSlotPath& holding, usize position);
	fn raw_targets(var ReferenceLoanAnalyzer& this, SemanticExpression& pointer, usize operation, usize depth) -> CompilationResult;
	fn raw_write(var ReferenceLoanAnalyzer& this, SemanticExpression& destination, usize operation) -> CompilationResult;
	fn visible_raw_targets(var ReferenceLoanAnalyzer& this, usize operation) -> CompilationResult;
	fn unknown_path(var ReferenceLoanAnalyzer& this, ReferenceUnknownContent& event, ReferenceStoreSlot& slot, usize target) -> bool;
	fn raw_address_context(ReferenceLoanAnalyzer& this, SemanticExpression& expression, usize depth) -> bool;
	fn check_unknown(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, reference_loan_access access) -> CompilationResult;
	fn assignment(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult;
	fn store_slot(ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, usize depth) -> ReferenceStoreSlot;
	fn store_expression(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult;
	fn store_walk(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult;
	fn retain_stores(var ReferenceLoanAnalyzer& this, var SemanticExpression& body) -> CompilationResult;
	fn prepare_stores(var ReferenceLoanAnalyzer& this, SemanticUnit& unit);
	fn validate_stores(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceStoreEffect& effect) -> bool;
	fn defaults(var ReferenceLoanAnalyzer& this, Type& type, var rt::buffer<ReferenceLoanPlace>& output, usize depth) -> CompilationResult;
	fn check_place(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, ReferenceLoanPlace& target, reference_loan_access access) -> CompilationResult;
	fn check(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, reference_loan_access access) -> CompilationResult;
	fn reference_binding(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult;
	fn return_validation(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult;
	fn call_post(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult;
	fn walk(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult;
	fn error(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::string_view message) -> CompilationResult;

	var Diagnostics* diagnostics;
	rt::buffer<var SemanticExpression*> expressions;
	rt::buffer<ReferenceLoan> loans;
	rt::buffer<ReferenceStoreEffect> stores;
	rt::buffer<var Entity*> store_functions;
	rt::buffer<ReferenceCapture> captures_summary;
	rt::buffer<var Entity*> return_functions;
	rt::buffer<var Entity*> raw_functions;
	rt::buffer<var Entity*> raw_globals;
	rt::buffer<ReferenceUnknownContent> unknowns;
	var SemanticExpression* function_body;
	FactGraph graph;
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	rt::buffer<usize> first_edges;
	rt::buffer<usize> next_edges;
	usize visit_generation;
	Type* return_type;
	reference_loan_phase phase;
};

fn ReferenceLoanAnalyzer::ReferenceLoanAnalyzer(var ReferenceLoanAnalyzer& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn ReferenceLoanAnalyzer::error(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::string_view message) -> CompilationResult {
	@this.diagnostics->error(expression.token(), message);
	return CompilationResult(compilation_error());
};

fn ReferenceLoanAnalyzer::collect(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) {
	if (!expression) {
		return;
	};
	@this.expressions.push_back(expression);
	usize index = 0;
	while (index < expression->size()) {
		@this.collect(expression->item(index));
		@index = index + 1;
	};
	return;
};

fn ReferenceLoanAnalyzer::position(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> usize {
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		if (this.graph.nodes.data()[index].kind == fact_node_kind::expression && this.graph.nodes.data()[index].expression == &expression) {
			return index;
		};
		@index = index + 1;
	};
	return fact_no_node();
};

fn ReferenceLoanAnalyzer::build_graph(var ReferenceLoanAnalyzer& this, Entity& function) {
	@this.graph.build_function(function);
	@this.first_edges.clear();
	@this.next_edges.clear();
	@this.visited.clear();
	@this.visit_generation = 0;
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		@this.first_edges.push_back(fact_no_node());
		@this.visited.push_back(0);
		@index = index + 1;
	};
	@index = 0;
	while (index < this.graph.edges.size()) {
		@this.next_edges.push_back(fact_no_node());
		@index = index + 1;
	};
	@index = this.graph.edges.size();
	while (index) {
		@index = index - 1;
		FactEdge& edge = this.graph.edges.data()[index];
		@(@this.next_edges).data()[index] = this.first_edges.data()[edge.source];
		@(@this.first_edges).data()[edge.source] = index;
	};
	return;
};

fn ReferenceLoanAnalyzer::reachable(var ReferenceLoanAnalyzer& this, usize source, usize target, usize kill, var Entity* cleanup_owner) -> bool {
	if (source == fact_no_node() || target == fact_no_node()) {
		// Opaque graph regions must not prematurely end a loan.
		return true;
	};
	@this.pending.clear();
	if (this.visit_generation == usize::max) {
		usize index = 0;
		while (index < this.visited.size()) {
			@(@this.visited).data()[index] = 0;
			@index = index + 1;
		};
		@this.visit_generation = 0;
	};
	@this.visit_generation = this.visit_generation + 1;
	@this.pending.push_back(source);
	usize next = 0;
	while (next < this.pending.size()) {
		usize node = this.pending.data()[next];
		@next = next + 1;
		if (node == target) {
			return true;
		};
		if (node == kill && node != source) {
			continue;
		};
		if (cleanup_owner && node != source) {
			if (this.graph.nodes.data()[node].kind == fact_node_kind::lifetime_end && this.graph.nodes.data()[node].owner == cleanup_owner) {
				continue;
			};
			var SemanticExpression* operation = this.graph.nodes.data()[node].expression;
			if (operation && (operation->kind() == semantic_kind::relocation || operation->kind() == semantic_kind::destruction) && operation->size() && operation->item(0)->owned_binding() == cleanup_owner) {
				continue;
			};
		};
		if (this.visited.data()[node] == this.visit_generation) {
			continue;
		};
		@(@this.visited).data()[node] = this.visit_generation;
		usize index = this.first_edges.data()[node];
		while (index != fact_no_node()) {
			FactEdge& edge = this.graph.edges.data()[index];
			if (fact_semantic_edge_feasible(edge)) {
				@this.pending.push_back(usize(edge.target));
			};
			@index = this.next_edges.data()[index];
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::active(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& expression) -> bool {
	return @this.active_at(loan, this.position(expression));
};

fn ReferenceLoanAnalyzer::active_at(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, usize point) -> bool {
	usize definition = usize(loan.creation);
	usize index = 0;
	while (definition == fact_no_node() && index < this.graph.nodes.size()) {
		var SemanticExpression* candidate = this.graph.nodes.data()[index].expression;
		if (this.graph.nodes.data()[index].kind == fact_node_kind::expression && candidate && candidate->kind() == semantic_kind::variable && candidate->entity() == loan.binding) {
			@definition = index;
			break;
		};
		@index = index + 1;
	};
	if (definition != fact_no_node() && !@this.reachable(this.graph.entry, definition, fact_no_node(), nullptr)) {
		return false;
	};
	var Entity* cleanup_owner = nullptr;
	if (loan.stored_field) {
		@cleanup_owner = loan.binding;
	};
	if (!@this.reachable(definition, point, fact_no_node(), cleanup_owner) || !@this.loan_store_path(definition, point, loan, definition)) {
		return false;
	};
	@index = 0;
	while (index < loan.escapes.size()) {
		if (@this.reachable(loan.escapes.data()[index], point, definition, nullptr)) {
			return true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* use = this.expressions.data()[index];
		if (loan.binding && @this.holding_use(loan, @*use) && @this.reachable(point, this.position(*use), definition, cleanup_owner) && @this.loan_store_path(point, this.position(*use), loan, definition)) {
			return true;
		};
		@index = index + 1;
	};
	// A holder's custom destructor may read its reference members even after
	// the last explicit name use. Cleanup nodes identify the owned variable.
	@index = 0;
	while (loan.binding && loan.stored_field && index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::opaque && node.owner == loan.binding && @this.reachable(point, index, definition, loan.binding) && @this.loan_store_path(point, index, loan, definition)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::retain_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* call = this.expressions.data()[index];
		@index = index + 1;
		if (call->kind() != semantic_kind::call || call->size() < 2 || !@this.reachable(this.graph.entry, this.position(*call), fact_no_node(), nullptr)) {
			continue;
		};
		Type* signature = call->item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function) {
			continue;
		};
		var SemanticExpression* arguments = call->item(1);
		usize argument = 0;
		while (argument < arguments->size() && argument < signature->signature().parameters().size()) {
			Type* parameter = signature->signature().parameters().data()[argument];
			var SemanticExpression* actual = arguments->item(argument);
			@argument = argument + 1;
			if (!(parameter->kind() == type_kind::reference || reference_loan_members(*parameter)) || !@this.contextual_capture(*call, argument - 1, false) && !@this.contextual_capture(*call, argument - 1, true)) {
				continue;
			};
			usize mode = 0;
			while (mode < 2) {
				bool contents = mode == 1;
				@mode = mode + 1;
				if (!@this.contextual_capture(*call, argument - 1, contents)) {
					continue;
				};
				rt::buffer<ReferenceLoanPlace> targets;
				rt::buffer<ReferenceLoanSubstitution> substitutions;
				if (!contents && reference_capture_aggregate(parameter) && actual->owned_binding()) {
					ReferenceLoanPlace owner;
					@owner.root = actual->owned_binding();
					@targets.push_back($owner);
				}
				else if (!(@this.places(*actual, @targets, @substitutions, nullptr, 0)).has<void>()) {
					return @this.error(*call, "reference escape provenance storage is unavailable");
				};
				usize candidate = 0;
				while (candidate < targets.size()) {
					ReferenceLoanPlace& target = targets.data()[candidate];

					// Opaque retention outlives any local reference binding or holder.
					 {
						ReferenceLoan escaped;
						@escaped.creation = this.position(*call);
						@escaped.place.root = target.root;
						@escaped.place.reference_contents = target.reference_contents || contents && target.root && target.root->kind() == entity_kind::parameter && reference_capture_aggregate(target.root->type());
						@escaped.place.field = target.field;
						@escaped.place.element = target.element;
						@escaped.place.through = target.through;
						@escaped.permission = reference_loan_permission(*parameter, 0);
						@escaped.escapes.push_back(usize(escaped.creation));
						@this.loans.push_back($escaped);
					};
					@candidate = candidate + 1;
				};
			};
		};
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::place(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> ReferenceLoanPlace {
	ReferenceLoanPlace result;
	if (expression.kind() == semantic_kind::name) {
		var Entity* binding = expression.entity();
		if (!binding || !binding->type() || binding->type()->kind() == type_kind::pointer) {
			return $result;
		};
		usize index = this.loans.size();
		while (index) {
			@index = index - 1;
			if (this.loans.data()[index].binding == binding) {
				@result.root = this.loans.data()[index].place.root;
				@result.reference_contents = this.loans.data()[index].place.reference_contents;
				@result.field = this.loans.data()[index].place.field;
				@result.element = this.loans.data()[index].place.element;
				@result.through = binding;
				return $result;
			};
		};
		@result.root = binding;
		if (binding->type()->kind() == type_kind::reference) {
			@result.through = binding;
		};
		return $result;
	};
	if (expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast || expression.kind() == semantic_kind::variant_payload) {
		return this.place(*expression.item(0));
	};
	if (expression.kind() == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		@result = this.place(*expression.item(0));
		// Keep the outermost field; deeper fields conservatively overlap.
		var Entity* field = expression.entity();
		var Entity* owner = nullptr;
		if (field) {
			@owner = field->member_owner();
		};
		if (!result.field && (!owner || owner->layout() != record_layout::overlapping)) {
			@result.field = expression.entity();
		};
		return $result;
	};
	if (expression.kind() == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		@result = this.place(*expression.item(0));
		var Entity* owner = expression.item(0)->owned_binding();
		if (owner && owner->kind() == entity_kind::local && owner->type()->kind() == type_kind::array && result.root == owner && !result.field) {
			@result.element = expression.item(1);
		};
		return $result;
	};
	return $result;
};

fn ReferenceLoanAnalyzer::initializer(ReferenceLoanAnalyzer& this, SemanticExpression& expression, Entity& binding) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding) {
		return expression.item(0);
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* found = this.initializer(*expression.item(index), binding);
		if (found) {
			return found;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn ReferenceLoanAnalyzer::returned_places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult {
	if (expression.kind() == semantic_kind::return_value) {
		if (!expression.size()) {
			return CompilationResult();
		};
		return @this.places(*expression.item(0), @output, @substitutions, context, depth + 1);
	};
	usize index = 0;
	while (index < expression.size()) {
		if (!(@this.returned_places(*expression.item(index), @output, @substitutions, context, depth)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		@index = index + 1;
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult {
	if (depth > 16) {
		return @this.error(expression, "reference provenance analysis limit exceeded");
	};
	semantic_kind kind = expression.kind();
	if (kind == semantic_kind::name && reference_loan_members(*expression.type()) && (!context || context->body() == this.function_body)) {
		bool found = false;
		if (!(@this.stored_contents(expression, @output, @found)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		if (found) {
			return CompilationResult();
		};
	};
	if (kind == semantic_kind::name) {
		var Entity* binding = expression.entity();
		usize index = substitutions.size();
		while (index) {
			@index = index - 1;
			ReferenceLoanSubstitution& substitution = substitutions.data()[index];
			if (substitution.parameter == binding) {
				usize candidate = 0;
				while (candidate < substitution.places.size()) {
					ReferenceLoanPlace mapped;
					@mapped.root = substitution.places.data()[candidate].root;
					@mapped.reference_contents = substitution.places.data()[candidate].reference_contents;
					@mapped.field = substitution.places.data()[candidate].field;
					@mapped.element = substitution.places.data()[candidate].element;
					@mapped.through = substitution.places.data()[candidate].through;
					@output.push_back($mapped);
					@candidate = candidate + 1;
				};
				return CompilationResult();
			};
		};
		if (context && binding && binding->kind() == entity_kind::local && (binding->type()->kind() == type_kind::reference || reference_loan_members(*binding->type()))) {
			var SemanticExpression* source = this.initializer(*context->body(), *binding);
			if (!source) {
				return CompilationResult();
			};
			return @this.places(*source, @output, @substitutions, context, depth + 1);
		};
		bool found = false;
		@index = 0;
		while (index < this.loans.size()) {
			ReferenceLoan& loan = this.loans.data()[index];
			if (loan.binding == binding) {
				ReferenceLoanPlace mapped;
				@mapped.root = loan.place.root;
				@mapped.reference_contents = loan.place.reference_contents;
				@mapped.field = loan.place.field;
				@mapped.element = loan.place.element;
				@mapped.through = binding;
				@output.push_back($mapped);
				@found = true;
			};
			@index = index + 1;
		};
		if (found) {
			return CompilationResult();
		};
	};
	if (kind == semantic_kind::access || kind == semantic_kind::cast || kind == semantic_kind::relocation || kind == semantic_kind::variant_payload || kind == semantic_kind::variant_cast) {
		return @this.places(*expression.item(0), @output, @substitutions, context, depth + 1);
	};
	if (kind == semantic_kind::index && reference_loan_members(*expression.type()) || kind == semantic_kind::member && expression.entity() && (expression.entity()->type()->kind() == type_kind::reference || reference_loan_members(*expression.type()))) {
		bool found = false;
		if (!(@this.stored_contents(@expression, @output, @found)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		if (found) {
			return CompilationResult();
		};
	};
	if (kind == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		usize first = output.size();
		if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		var Entity* owner = expression.item(0)->owned_binding();
		while (first < output.size()) {
			var ReferenceLoanPlace* target = (@output).data() + first;
			if (owner && owner->kind() == entity_kind::local && owner->type()->kind() == type_kind::array && target->root == owner && !target->field) {
				@target->element = expression.item(1);
			};
			@first = first + 1;
		};
		return CompilationResult();
	};
	if (kind == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		var Entity* aggregate_binding = expression.item(0)->owned_binding();
		var Entity* selected = expression.entity();
		if (aggregate_binding && selected && (selected->type()->kind() == type_kind::reference || reference_loan_members(*selected->type()))) {
			bool found = false;
			usize index = 0;
			while (index < this.loans.size()) {
				ReferenceLoan& loan = this.loans.data()[index];
				if (loan.binding == aggregate_binding && loan.stored_field == selected) {
					ReferenceLoanPlace mapped;
					@mapped.root = loan.place.root;
					@mapped.reference_contents = loan.place.reference_contents;
					@mapped.field = loan.place.field;
					@mapped.element = loan.place.element;
					@mapped.through = aggregate_binding;
					@output.push_back($mapped);
					@found = true;
				};
				@index = index + 1;
			};
			if (found) {
				return CompilationResult();
			};
		};
		if (selected && selected->type()->kind() == type_kind::reference) {
			usize first = output.size();
			if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			while (first < output.size()) {
				var ReferenceLoanPlace* target = (@output).data() + first;
				if (target->root && target->root->kind() == entity_kind::parameter && reference_capture_aggregate(target->root->type())) {
					@target->reference_contents = true;
				};
				@first = first + 1;
			};
			return CompilationResult();
		};
		usize first = output.size();
		if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		var Entity* field = expression.entity();
		var Entity* owner = nullptr;
		if (field) {
			@owner = field->member_owner();
		};
		while (first < output.size()) {
			var ReferenceLoanPlace* target = (@output).data() + first;
			if (!target->field && (!owner || owner->layout() != record_layout::overlapping)) {
				@target->field = field;
			};
			@first = first + 1;
		};
		return CompilationResult();
	};
	if (kind == semantic_kind::construction && expression.type()->kind() == type_kind::array && reference_loan_members(*expression.type())) {
		rt::buffer<ReferenceContentRoot> roots;
		ReferenceSlotPath path;
		if (!(@this.content_sources(*expression.type(), &expression, @roots, @substitutions, context, path, nullptr, depth + 1)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		usize index = 0;
		while (index < roots.size()) {
			ReferenceLoanPlace root;
			@root.root = roots.data()[index].referent.root;
			@root.reference_contents = roots.data()[index].referent.reference_contents;
			@root.field = roots.data()[index].referent.field;
			@root.element = roots.data()[index].referent.element;
			@root.through = roots.data()[index].referent.through;
			@output.push_back($root);
			@index = index + 1;
		};
		return CompilationResult();
	};
	if (kind == semantic_kind::construction && reference_loan_members(*expression.type()) && expression.size()) {
		var SemanticExpression* arguments = expression.item(0);
		if (variant_instance(*expression.type()->entity()) && expression.integer() && arguments->size()) {
			return @this.places(*arguments->item(0), @output, @substitutions, context, depth + 1);
		};
		bool custom = expression.entity() && expression.entity()->definition() != function_definition::defaulted;
		if (!custom && arguments->size() == 1 && arguments->item(0)->type()->same_shape(*expression.type())) {
			return @this.places(*arguments->item(0), @output, @substitutions, context, depth + 1);
		};
		usize index = 0;
		while (index < expression.type()->entity()->fields().size()) {
			var Entity* field = expression.type()->entity()->fields().data()[index];
			var SemanticExpression* value = field->body();
			if (!custom && index < arguments->size()) {
				@value = arguments->item(index);
			};
			if (field->type()->kind() == type_kind::reference || reference_loan_members(*field->type())) {
				if (value) {
					if (!(@this.places(*value, @output, @substitutions, context, depth + 1)).has<void>()) {
						return CompilationResult(compilation_error());
					};
				}
				else if (!(@this.defaults(*field->type(), @output, depth + 1)).has<void>()) {
					return CompilationResult(compilation_error());
				};
			};
			@index = index + 1;
		};
		return CompilationResult();
	};
	var Entity* returned_function = expression.entity();
	if (returned_function && returned_function->kind() == entity_kind::function) {
		@returned_function = returned_function->canonical();
	};
	if (kind == semantic_kind::call && returned_function && returned_function->dispatch() == function_dispatch::ordinary && returned_function->body() && (returned_function->type()->signature().result()->kind() == type_kind::reference || reference_loan_members(*returned_function->type()->signature().result()))) {
		var Entity* callee = returned_function;
		var SemanticExpression* arguments = expression.item(1);
		usize boundary = substitutions.size();
		usize index = 0;
		while (index < callee->parameters().size() && index < arguments->size()) {
			ReferenceLoanSubstitution substitution;
			@substitution.parameter = callee->parameters().data()[index];
			if ((substitution.parameter->type()->kind() == type_kind::reference || reference_loan_members(*substitution.parameter->type())) && !(@this.places(*arguments->item(index), @substitution.places, @substitutions, context, depth + 1)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			@substitutions.push_back($substitution);
			@index = index + 1;
		};
		bool valid = false;
		if (reference_returns_local(*callee->body())) {
			@valid = (@this.returned_local_places(@*callee, @output, @substitutions, depth + 1)).has<void>();
		}
		else {
			@valid = (@this.returned_places(*callee->body(), @output, @substitutions, callee, depth + 1)).has<void>();
		};
		while (substitutions.size() > boundary) {
			@substitutions.pop_back();
		};
		if (valid) {
			return CompilationResult();
		};
		return CompilationResult(compilation_error());
	};
	var target = this.place(expression);
	if (target.root) {
		@output.push_back($target);
		return CompilationResult();
	}
	else {
		return CompilationResult();
	};
};

fn ReferenceLoanAnalyzer::defaults(var ReferenceLoanAnalyzer& this, Type& type, var rt::buffer<ReferenceLoanPlace>& output, usize depth) -> CompilationResult {
	if (depth > 16) {
		return CompilationResult(compilation_error());
	};
	if (!reference_loan_members(type)) {
		return CompilationResult();
	};
	if (type.kind() == type_kind::array) {
		if (!type.count()) {
			return CompilationResult();
		};
		return @this.defaults(*type.element(), @output, depth + 1);
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		var Entity* field = type.entity()->fields().data()[index];
		@index = index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		if (field->body()) {
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*field->body(), @output, @substitutions, nullptr, depth + 1)).has<void>()) {
				return CompilationResult(compilation_error());
			};
		}
		else if (!(@this.defaults(*field->type(), @output, depth + 1)).has<void>()) {
			return CompilationResult(compilation_error());
		};
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::aggregate(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult {
	Type* type = expression.entity()->type();
	var SemanticExpression* source = expression.item(0);
	if (!source || source->kind() != semantic_kind::construction || !source->size()) {
		return CompilationResult();
	};
	var SemanticExpression* arguments = source->item(0);
	if (variant_instance(*type->entity())) {
		if (this.phase != reference_loan_phase::collect) {
			return @this.walk(source, reference_loan_access::read);
		};
		rt::buffer<ReferenceLoanPlace> targets;
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		if (!(@this.places(*source, @targets, @substitutions, nullptr, 0)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		var Entity* field = nullptr;
		usize field_index = 0;
		while (field_index < type->entity()->fields().size()) {
			var Entity* candidate = type->entity()->fields().data()[field_index];
			if (reference_loan_members(*candidate->type())) {
				@field = candidate;
				break;
			};
			@field_index = field_index + 1;
		};
		usize index = 0;
		while (field && index < targets.size()) {
			ReferenceLoan loan;
			@loan.binding = expression.entity();
			@loan.stored_field = field;
			@loan.creation = fact_no_node();
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = reference_loan_permission(*type, 0);
			@this.loans.push_back($loan);
			@index = index + 1;
		};
		return CompilationResult();
	};
	bool custom = source->entity() && source->entity()->definition() != function_definition::defaulted;
	// Compiler-generated aggregate transfer preserves reference member provenance.
	if (!custom && arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type)) {
		var SemanticExpression* other = arguments->item(0);
		while ((other->kind() == semantic_kind::relocation || other->kind() == semantic_kind::access || other->kind() == semantic_kind::cast) && other->size()) {
			@other = other->item(0);
		};
		if (this.phase != reference_loan_phase::collect) {
			return CompilationResult();
		};
		if (other->kind() != semantic_kind::name) {
			rt::buffer<ReferenceLoanPlace> targets;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*other, @targets, @substitutions, nullptr, 0)).has<void>()) {
				return @this.error(expression, "returned aggregate provenance storage is unavailable");
			};
			usize field_index = 0;
			while (field_index < type->entity()->fields().size()) {
				var Entity* field = type->entity()->fields().data()[field_index];
				@field_index = field_index + 1;
				if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
					continue;
				};
				usize index = 0;
				while (index < targets.size()) {
					ReferenceLoan loan;
					@loan.binding = expression.entity();
					@loan.stored_field = field;
					@loan.creation = fact_no_node();
					@loan.place.root = targets.data()[index].root;
					@loan.place.reference_contents = targets.data()[index].reference_contents;
					@loan.place.field = targets.data()[index].field;
					@loan.place.element = targets.data()[index].element;
					@loan.place.through = targets.data()[index].through;
					@loan.permission = reference_loan_permission(*field->type(), 0);
					@this.loans.push_back($loan);
					@index = index + 1;
				};
			};
			return CompilationResult();
		};
		usize count = this.loans.size();
		usize index = 0;
		while (index < count) {
			if (this.loans.data()[index].binding == other->entity() && this.loans.data()[index].stored_field) {
				ReferenceLoan loan;
				@loan.binding = expression.entity();
				@loan.stored_field = this.loans.data()[index].stored_field;
				reference_slot_copy(this.loans.data()[index].holding, @loan.holding);
				@loan.creation = fact_no_node();
				@loan.place.root = this.loans.data()[index].place.root;
				@loan.place.reference_contents = this.loans.data()[index].place.reference_contents;
				@loan.place.field = this.loans.data()[index].place.field;
				@loan.place.element = this.loans.data()[index].place.element;
				@loan.place.through = this.loans.data()[index].place.through;
				@loan.permission = this.loans.data()[index].permission;
				@this.loans.push_back($loan);
			};
			@index = index + 1;
		};
		return CompilationResult();
	};
	usize field_index = 0;
	while (field_index < type->entity()->fields().size()) {
		var Entity* field = type->entity()->fields().data()[field_index];
		var SemanticExpression* argument = field->body();
		if (!custom && field_index < arguments->size()) {
			@argument = arguments->item(field_index);
		};
		@field_index = field_index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		type_qualifier permission = reference_loan_permission(*field->type(), 0);
		reference_loan_access required = reference_loan_access::read;
		if (permission == type_qualifier::mutable) {
			@required = reference_loan_access::write;
		};
		if (this.phase == reference_loan_phase::validate) {
			if (argument && !(@this.walk(argument, required)).has<void>()) {
				return CompilationResult(compilation_error());
			};
		};
		rt::buffer<ReferenceLoanPlace> targets;
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		bool known = true;
		if (argument) {
			@known = (@this.places(*argument, @targets, @substitutions, nullptr, 0)).has<void>();
		}
		else {
			@known = (@this.defaults(*field->type(), @targets, 0)).has<void>();
		};
		if (!known) {
			return @this.error(expression, "reference member provenance storage is unavailable");
		};
		usize index = 0;
		while (index < targets.size()) {
			if (this.phase == reference_loan_phase::validate) {
				ReferenceLoanPlace& target = targets.data()[index];
				usize other = 0;
				while (other < this.loans.size()) {
					ReferenceLoan& existing = this.loans.data()[other];
					if (existing.binding == expression.entity() && existing.stored_field != field && reference_loan_overlap(existing.place, target) && (existing.permission == type_qualifier::mutable || permission == type_qualifier::mutable)) {
						return @this.error(expression, "reference members contain conflicting loans");
					};
					@other = other + 1;
				};
				@index = index + 1;
				continue;
			};
			ReferenceLoan loan;
			@loan.binding = expression.entity();
			@loan.stored_field = field;
			@loan.creation = fact_no_node();
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = permission;
			@this.loans.push_back($loan);
			@index = index + 1;
		};
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::assignment(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult {
	if (this.phase != reference_loan_phase::collect || !expression.entity() || expression.entity()->role() != function_role::assignment || expression.entity()->definition() != function_definition::defaulted) {
		return CompilationResult();
	};
	var SemanticExpression* arguments = expression.item(1);
	if (arguments->size() != 2 || !reference_loan_members(*arguments->item(0)->type())) {
		return CompilationResult();
	};
	var Entity* destination = arguments->item(0)->owned_binding();
	if (!destination) {
		return CompilationResult();
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(*arguments->item(1), @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(expression, "assigned reference provenance storage is unavailable");
	};
	usize field_index = 0;
	while (field_index < destination->type()->entity()->fields().size()) {
		var Entity* field = destination->type()->entity()->fields().data()[field_index];
		@field_index = field_index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		usize index = 0;
		while (index < targets.size()) {
			ReferenceLoan loan;
			@loan.binding = destination;
			@loan.stored_field = field;
			@loan.creation = this.position(expression);
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = reference_loan_permission(*field->type(), 0);
			@this.loans.push_back($loan);
			@index = index + 1;
		};
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::check(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, reference_loan_access access) -> CompilationResult {
	if (this.phase == reference_loan_phase::collect) {
		return CompilationResult();
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(expression, @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		if (!(@this.check_place(@expression, targets.data()[index], access)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		@index = index + 1;
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::check_place(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, ReferenceLoanPlace& target, reference_loan_access access) -> CompilationResult {
	usize index = 0;
	while (index < this.loans.size()) {
		ReferenceLoan& loan = this.loans.data()[index];
		if (reference_loan_overlap(loan.place, target) && (!loan.binding || loan.binding != target.through) && @this.active(loan, expression)) {
			// A reborrow may access through its parent; direct use of the parent is
			// still checked against every outstanding child loan.
			bool parent = false;
			var Entity* through = target.through;
			usize depth = this.loans.size();
			while (through && depth) {
				usize candidate = 0;
				var Entity* next = nullptr;
				while (candidate < this.loans.size()) {
					if (this.loans.data()[candidate].binding == through) {
						@next = this.loans.data()[candidate].place.through;
					};
					@candidate = candidate + 1;
				};
				if (loan.binding && next == loan.binding) {
					@parent = true;
					break;
				};
				@through = next;
				@depth = depth - 1;
			};
			if (!parent && (access == reference_loan_access::write || loan.permission == type_qualifier::mutable)) {
				if (loan.binding) {
					@this.diagnostics->note(loan.binding->token(), "conflicting reference is declared here and used later");
				};
				return @this.error(expression, "access conflicts with a live reference loan");
			};
		};
		@index = index + 1;
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::reference_binding(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult {
	var SemanticExpression* initializer = expression->item(0);
	type_qualifier permission = expression->entity()->type()->element()->qualifier();
	if (this.phase == reference_loan_phase::validate) {
		return CompilationResult();
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	bool object = false;
	if (reference_loan_members(*expression->entity()->type()->element())) {
		rt::buffer<ReferenceStoreBinding> bindings;
		var slot = this.store_slot(*initializer, bindings, nullptr, 0);
		if (slot.root && reference_array_members(*slot.root->type(), 0)) {
			ReferenceLoanPlace target;
			@target.root = slot.root;
			usize projection = 0;
			while (projection < slot.path.size) {
				ReferenceSlotStep& step = slot.path.steps[projection];
				if (step.kind == reference_slot_step_kind::field && !target.field) {
					@target.field = step.field;
				};
				if (step.kind != reference_slot_step_kind::field && !target.element) {
					@target.element = step.index;
				};
				@projection = projection + 1;
			};
			@targets.push_back($target);
			@object = true;
		};
	};
	if (!object && !(@this.places(*initializer, @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(*expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		ReferenceLoan loan;
		@loan.binding = expression->entity();
		@loan.creation = fact_no_node();
		@loan.place.root = targets.data()[index].root;
		@loan.place.reference_contents = targets.data()[index].reference_contents;
		@loan.place.field = targets.data()[index].field;
		@loan.place.element = targets.data()[index].element;
		@loan.place.through = targets.data()[index].through;
		@loan.permission = permission;
		@this.loans.push_back($loan);
		@index = index + 1;
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::return_validation(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult {
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(*expression->item(0), @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(*expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		var Entity* root = targets.data()[index].root;
		if (root && (root->kind() == entity_kind::local || root->kind() == entity_kind::parameter && root->type()->kind() != type_kind::reference)) {
			return @this.error(*expression, "returned reference refers to local storage");
		};
		@index = index + 1;
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::call_post(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult {
	Type* signature = expression->item(0)->type();
	if (signature->kind() == type_kind::pointer) {
		@signature = signature->element();
	};
	if (!(@this.assignment(@*expression)).has<void>()) {
		return CompilationResult(compilation_error());
	};
	if (signature->kind() == type_kind::function && signature->signature().result()->kind() == type_kind::reference) {
		return @this.check(@*expression, access);
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::walk(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult {
	rt::buffer<ReferenceWalkTask> pending;
	@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, expression, access));
	while (pending.size()) {
		ReferenceWalkTask task = pending.data()[pending.size() - 1];
		@pending.pop_back();
		var SemanticExpression* current = task.expression;
		if (!current) {
			continue;
		};
		semantic_kind kind = current->kind();
		if (task.kind == reference_walk_task_kind::array_aggregate) {
			if (!(@this.array_aggregate(*current)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::record_aggregate) {
			if (!(@this.aggregate(@*current)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::reference_binding) {
			if (!(@this.reference_binding(current)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::call_post) {
			if (!(@this.call_post(current, task.access)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::storage) {
			if (kind == semantic_kind::name) {
				continue;
			};
			if (kind == semantic_kind::index) {
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(1), reference_loan_access::read));
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current->item(0), reference_loan_access::read));
				continue;
			};
			if (kind == semantic_kind::member || kind == semantic_kind::access || kind == semantic_kind::cast || kind == semantic_kind::variant_payload) {
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current->item(0), reference_loan_access::read));
				continue;
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current, reference_loan_access::read));
			continue;
		};
		bool structural = kind == semantic_kind::brace || kind == semantic_kind::statements || kind == semantic_kind::sequence || kind == semantic_kind::conditional || kind == semantic_kind::while_loop || kind == semantic_kind::for_loop || kind == semantic_kind::exception_try || kind == semantic_kind::exception_handler || kind == semantic_kind::switch_expression || kind == semantic_kind::case_label;
		if (!structural && this.phase == reference_loan_phase::validate && this.position(*current) != fact_no_node() && !@this.reachable(this.graph.entry, this.position(*current), fact_no_node(), nullptr)) {
			continue;
		};
		if (this.phase == reference_loan_phase::validate && !(@this.check_unknown(*current, task.access)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		if (kind == semantic_kind::variant_cast) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), task.access));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && reference_array_members(*current->entity()->type(), 0)) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::array_aggregate, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && current->entity()->type()->kind() == type_kind::named && current->entity()->type()->entity()->kind() == entity_kind::record) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::record_aggregate, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && current->entity()->type()->kind() == type_kind::reference) {
			reference_loan_access required = reference_loan_access::read;
			if (current->entity()->type()->element()->qualifier() == type_qualifier::mutable) {
				@required = reference_loan_access::write;
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::reference_binding, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), required));
			continue;
		};
		if (this.phase == reference_loan_phase::validate && kind == semantic_kind::return_value && (this.return_type->kind() == type_kind::reference || reference_loan_members(*this.return_type)) && current->size()) {
			if (!(@this.return_validation(current)).has<void>()) {
				return CompilationResult(compilation_error());
			};
		};
		if (kind == semantic_kind::relocation || kind == semantic_kind::destruction) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::write));
			continue;
		};
		if (kind == semantic_kind::call && current->size() >= 2) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::call_post, current, task.access));
			Type* signature = current->item(0)->type();
			if (signature->kind() == type_kind::pointer) {
				@signature = signature->element();
			};
			var SemanticExpression* arguments = current->item(1);
			usize argument = arguments->size();
			while (argument) {
				@argument = argument - 1;
				reference_loan_access required = reference_loan_access::read;
				if (signature->kind() == type_kind::function && argument < signature->signature().parameters().size()) {
					Type* parameter = signature->signature().parameters().data()[argument];
					if (parameter->kind() == type_kind::reference && parameter->element()->qualifier() == type_qualifier::mutable) {
						@required = reference_loan_access::write;
					};
				};
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, arguments->item(argument), required));
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::binary && (current->operation() == token_kind::op_assign || current->operation() == token_kind::op_copy)) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::write));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(1), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::name || kind == semantic_kind::member || kind == semantic_kind::index || kind == semantic_kind::access || kind == semantic_kind::variant_payload || kind == semantic_kind::cast && current->category() == value_category::place) {
			if (!(@this.check(@*current, task.access)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current, reference_loan_access::read));
			continue;
		};
		usize child = current->size();
		while (child) {
			@child = child - 1;
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(child), reference_loan_access::read));
		};
	};
	return CompilationResult();
};

fn ReferenceLoanAnalyzer::validate(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	@this.prepare_stores(unit);
	if ((@this.prepare_captures(unit)).has<void>()) {
		@this.prepare_unknowns(unit);
	}
	else {
		return CompilationResult(compilation_error());
	};
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;
		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};
		@this.expressions.clear();
		@this.loans.clear();
		@this.stores.clear();
		@this.function_body = function->body();
		@this.return_type = function->type()->signature().result();
		@this.phase = reference_loan_phase::collect;
		@this.build_graph(*function);
		@this.collect(function->body());
		if (!(@this.walk(function->body(), reference_loan_access::read)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		@this.phase = reference_loan_phase::validate;
		if (!(@this.retain_stores(@*function->body())).has<void>() || !(@this.refresh_array_aliases()).has<void>() || !(@this.collect_unknowns()).has<void>() || !(@this.retain_escapes()).has<void>() || !(@this.retain_special_escapes()).has<void>() || !(@this.walk(function->body(), reference_loan_access::read)).has<void>() || !(@this.validate_stores()).has<void>() || !(@this.validate_ends()).has<void>()) {
			return CompilationResult(compilation_error());
		};
	};
	return CompilationResult();
};
