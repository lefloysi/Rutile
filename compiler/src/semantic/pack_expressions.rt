fn Analyzer::template_engine(var Analyzer& this) -> var TemplateEngine* {
	return &@this.templates;
};

fn Analyzer::null_member_pack(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity* pack, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!receiver.get()) {
		var Entity* object = scope.lookup("this");
		if (!object || object->type()->kind() != type_kind::reference || object->type()->element()->kind() != type_kind::named || object->type()->element()->entity() != pack->scope()->owner()) {
			@this.error(&@syntax, "member pack access requires its instance receiver");
			return rt::unique<SemanticExpression>();
		};
		@receiver = @this.node(semantic_kind::name, object->type()->element(), &@syntax);
		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};
		@receiver.get()->bind(object, value_category::place);
	};
	Type* marker = pack->pack()->elements.data()[this.folded_field_index].type;
	Type* null_type = @this.types->pointer(@this.types->qualified(*marker, type_qualifier::immutable));
	var result = @this.node(semantic_kind::sequence, null_type, &@syntax);
	if (!result.get() || !(@result.get()->append($receiver)).has<void>() || !(@result.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@result.get()->append(@this.node(semantic_kind::null_pointer, null_type, &@syntax))).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	return @this.convert($result, expected, @syntax);
};

fn Analyzer::pack_declaration(var Analyzer& this, var Scope& scope, var Syntax& syntax, var TemplatePack var*& pack) -> CompilationResult {
	var Syntax* signature = @this.templates.signature(@this, @scope, @*syntax.variable_type());
	var Syntax* initializer = syntax.variable_initializer();
	if (!signature || initializer->kind() != syntax_kind::unary || initializer->token().kind != token_kind::op_assign) {
		@this.error(&@syntax, "a compile-time pack binding requires a signature and '= <arguments>' initializer");
		return compilation_error();
	};
	@pack = @this.templates.pack(@this, @scope, @*initializer->operand());
	if (pack && (@this.templates.validate_pack(@this, @scope, @*signature, @*pack)).has<void>()) {
		return;
	};
	return compilation_error();
};

fn Analyzer::fold_binding(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity var*& binding) -> CompilationResult {
	if (syntax.kind() == syntax_kind::pack_fold) {
		return;
	};
	if (syntax.kind() == syntax_kind::member) {
		var receiver = @this.expression(@scope, @*syntax.member_object(), rt::optional_ref<const Type>());
		if (!receiver.get()) {
			return compilation_error();
		};
		Type* owner = receiver.get()->type();
		if (syntax.token().kind == token_kind::op_arrow && owner->kind() == type_kind::pointer) {
			@owner = owner->element();
		};
		if (owner->kind() == type_kind::named) {
			var Entity* member = owner->entity()->find_member(syntax.member_name()->token().text());
			if (member && member->kind() == entity_kind::field_pack) {
				if (!this.accessible_at(*member, @scope, syntax.token())) {
					@this.error(&@syntax, "member pack is not accessible from this scope");
					@this.note(member->token(), "member pack is declared here");
					return compilation_error();
				};
				if (binding && binding != member) {
					@this.error(&@syntax, "a fold pattern must reference one pack");
					return compilation_error();
				};
				@binding = member;
				return;
			};
		};
	};
	if (syntax.kind() == syntax_kind::name || syntax.kind() == syntax_kind::qualified_name) {
		var Entity* entity = @this.lookup(@scope, @syntax);
		if (entity && (entity->kind() == entity_kind::pack_binding || entity->kind() == entity_kind::field_pack)) {
			if (entity->kind() == entity_kind::field_pack && !this.accessible_at(*entity, @scope, syntax.token())) {
				@this.error(&@syntax, "member pack is not accessible from this scope");
				@this.note(entity->token(), "member pack is declared here");
				return compilation_error();
			};
			if (binding && binding != entity) {
				@this.error(&@syntax, "a fold pattern must reference one pack");
				return compilation_error();
			};
			if (!(@this.resolve(entity)).has<void>()) {
				return compilation_error();
			};
			@binding = entity;
			return;
		};
	};
	usize child = 0;
	while (child < syntax.size()) {
		if (!(@this.fold_binding(@scope, @*syntax.item(child), @binding)).has<void>()) {
			return compilation_error();
		};
		@child = child + 1;
	};
};

fn Analyzer::pack_fold(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var Entity* binding = nullptr;
	var Syntax* pattern = syntax.pack_operand();
	while (pattern->kind() == syntax_kind::grouping) {
		@pattern = pattern->operand();
	};
	var TemplatePack* pack = nullptr;
	if (pattern->kind() == syntax_kind::pack_literal) {
		@pack = @this.templates.pack(@this, @scope, @*pattern);
	}
	else if ((@this.fold_binding(@scope, @*pattern, @binding)).has<void>() && binding) {
		@pack = binding->pack();
	};
	if (!pack) {
		@this.error(&@syntax, "fold expression requires a pack in its pattern");
		return rt::unique<SemanticExpression>();
	};
	token_kind operation = syntax.token().kind;
	if (!pack->elements.size()) {
		if (operation == token_kind::punct_comma) {
			return @this.convert(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax), expected, @syntax);
		};
		if (operation != token_kind::op_and && operation != token_kind::op_or) {
			@this.error(&@syntax, "empty pack has no identity for this fold operator");
			return rt::unique<SemanticExpression>();
		};
		var identity = @this.node(semantic_kind::literal_integer, this.types->find_primitive("bool"), &@syntax);
		if (identity.get()) {
			@identity.get()->set_integer(static_cast<u64>(operation == token_kind::op_and));
		};
		return @this.convert($identity, expected, @syntax);
	};
	rt::buffer<rt::unique<SemanticExpression>> values;
	usize index = 0;
	while (index < pack->elements.size()) {
		if (binding && binding->kind() == entity_kind::field_pack) {
			var Entity* previous = this.folded_field_pack;
			usize previous_index = this.folded_field_index;
			@this.folded_field_pack = binding;
			@this.folded_field_index = index;
			var value = @this.expression(@scope, @*pattern, rt::optional_ref<const Type>());
			@this.folded_field_pack = previous;
			@this.folded_field_index = previous_index;
			if (value.get()) {
				@values.push_back($value);
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			@index = index + 1;
			continue;
		};
		if (!binding) {
			var value = @this.templates.pack_value(@this, pack->elements.data()[index], @syntax);
			if (value.get()) {
				@values.push_back($value);
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			@index = index + 1;
			continue;
		};
		var Scope* iteration = @this.unit->create_scope(&@scope, nullptr);
		if (!iteration) {
			return rt::unique<SemanticExpression>();
		};
		TemplateArgument& argument = pack->elements.data()[index];
		entity_kind kind = entity_kind::constant;
		if (argument.kind == template_argument_kind::type) {
			@kind = entity_kind::type_parameter;
		};
		var Entity* element = @this.unit->create_entity($kind, binding->token(), &@syntax, iteration);
		if (element) {
			@element->set_name(binding->name());
		}
		else {
			return rt::unique<SemanticExpression>();
		};
		@element->set_type(argument.type);
		if (argument.type_use.has_value()) {
			@element->set_type_use(argument.type_use.value());
		};
		if (argument.kind == template_argument_kind::value) {
			var value = @this.templates.pack_value(@this, argument, @syntax);
			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};
			@element->set_body($value);
		};
		@element->set_state(entity_state::ready);
		var Entity* previous_pack = this.folded_pack;
		var Entity* previous_argument = this.folded_argument;
		@this.folded_pack = binding;
		@this.folded_argument = element;
		var value = @this.expression(@*iteration, @*pattern, rt::optional_ref<const Type>());
		@this.folded_pack = $previous_pack;
		@this.folded_argument = $previous_argument;
		if (value.get()) {
			@values.push_back($value);
		}
		else {
			return rt::unique<SemanticExpression>();
		};
		@index = index + 1;
	};
	if (operation == token_kind::punct_comma) {
		@index = values.size() - 1;
		var result = rt::unique<SemanticExpression>(@(@values).data()[index].release());
		while (index) {
			@index = index - 1;
			var sequence = @this.node(semantic_kind::sequence, result.get()->type(), &@syntax);
			if (!sequence.get()) {
				return rt::unique<SemanticExpression>();
			};
			@sequence.get()->set_category(result.get()->category());
			@sequence.get()->set_mutable_access(result.get()->mutable_access());
			if (!(@sequence.get()->append(rt::unique<SemanticExpression>(@(@values).data()[index].release()))).has<void>() || !(@sequence.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@sequence.get()->append(rt::unique<SemanticExpression>(@result.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@result = $sequence;
		};
		return @this.convert($result, expected, @syntax);
	};
	@index = values.size() - 1;
	var result = rt::unique<SemanticExpression>(@(@values).data()[index].release());
	while (index) {
		@index = index - 1;
		var left = rt::unique<SemanticExpression>(@(@values).data()[index].release());
		@result = @this.binary_values(@scope, @syntax, $left, rt::unique<SemanticExpression>(@result.release()), rt::optional_ref<const Type>());
		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};
	};
	return @this.convert($result, expected, @syntax);
};
