fn Analyzer::select(Analyzer& this, Entity* group, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity* {
	rt::buffer<Entity*> candidates;
	const rt::buffer<Entity*>& bindings = group->scope()->bindings();
	usize index = 0;
	while (index < bindings.size()) {
		Entity* candidate = bindings.data()[index];

		if (candidate->kind() == entity_kind::function && candidate->name() == group->name()) {
			if (!@candidates.push_back(Entity*(candidate))) {
				@this.error(&syntax, "out of memory collecting function candidates\0");

				return nullptr;
			};
		};

		@index = index + 1;
	};

	return @this.select_candidates(candidates, arguments, $skipped, $mode, @syntax);
};

fn Analyzer::select_candidates(Analyzer& this, const rt::buffer<Entity*>& bindings, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity* {
	Entity* selected = nullptr;
	i32 best = i32::max;
	i32 best_origin = 2;
	bool ambiguous = false;
	rt::buffer<Entity*> seen;
	usize index = 0;
	while (index < bindings.size()) {
		Entity* candidate = bindings.data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return nullptr;
		};

		@candidate = candidate->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != candidate) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back(Entity*(candidate))) {
			@this.error(&syntax, "out of memory ranking overload candidates\0");

			return nullptr;
		};

		if (mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (candidate->parameters().size() < skipped) {
			continue;
		};

		usize fixed = candidate->parameters().size() - skipped;
		bool variadic = candidate->type()->signature().arity() == parameter_arity::variadic;

		if (arguments.size() < fixed || !variadic && arguments.size() != fixed) {
			continue;
		};

		i32 rank = 0;

		if (variadic) {
			@rank = 16;
		};

		usize argument = 0;

		while (argument < fixed) {
			i32 component = @this.argument_rank(*arguments.data()[argument].get(), *candidate->parameters().data()[argument + skipped]->type());

			if (component < 0) {
				@rank = -1;
				break;
			};

			@rank = rank + component;
			@argument = argument + 1;
		};

		i32 origin = 0;

		if (candidate->origin() == declaration_origin::compiler_supplied) {
			@origin = 1;
		};

		if (rank < 0 || rank > best || rank == best && origin > best_origin) {
			continue;
		};

		if (rank == best && origin == best_origin) {
			@ambiguous = true;
			continue;
		};

		@best_origin = origin;
		@best := rank;
		@selected := candidate;
		@ambiguous = false;
	};

	if (ambiguous) {
		@this.error(&syntax, "function selection is ambiguous\0");

		return nullptr;
	};

	return $selected;
};

fn Analyzer::overloaded(Analyzer& this, Scope& scope, Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	rt::buffer<Entity*> candidates;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function && candidate->kind() != entity_kind::template_pattern) {
			continue;
		};

		if (candidate->state() == entity_state::ready && candidate->kind() == entity_kind::function) {
			if (candidate->operator_kind() != syntax.token().kind) {
				continue;
			};
		}
		else {
			Syntax* declaration = candidate->declaration();

			if (!declaration) {
				continue;
			};

			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};

			if (declaration->kind() != syntax_kind::function) {
				continue;
			};

			Syntax* name = declaration->function_name();

			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};

			if (name->kind() != syntax_kind::operator_name || name->operator_token().kind != syntax.token().kind) {
				continue;
			};
		};

		bool visible = false;
		Scope* enclosing = &scope;

		while (enclosing) {
			if (candidate->scope() == enclosing) {
				@visible = true;
			};

			@enclosing = enclosing->parent();
		};

		usize argument = 0;

		while (argument < arguments.size()) {
			const Type* type = arguments.data()[argument].get()->type();

			if (type->kind() == type_kind::named) {
				Entity* owner = type->entity();

				if (candidate->scope() == owner->members() || candidate->scope() == owner->scope()) {
					@visible = true;
				};
			};

			@argument = argument + 1;
		};

		if (!visible) {
			continue;
		};

		if (candidate->kind() == entity_kind::template_pattern) {
			@candidate = @this.templates.deduce(@this, @scope, @*candidate, arguments);

			if (!candidate) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!@candidates.push_back(Entity*(candidate))) {
			@this.error(&syntax, "out of memory collecting operator candidates\0");

			return rt::unique<SemanticExpression>();
		};
	};

	Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @syntax);

	if (!selected) {
		@this.error(&syntax, "operator has no unique applicable function\0");

		return rt::unique<SemanticExpression>();
	};

	if (selected->definition() == function_definition::deleted || !this.accessible(*selected, @scope)) {
		@this.error(&syntax, "selected operator is deleted or inaccessible\0");

		return rt::unique<SemanticExpression>();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), &syntax);

	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	@callable.get()->bind(Entity*(selected), value_category::place);

	return @this.invoke(@syntax, selected, $callable, $arguments, expected);
};
