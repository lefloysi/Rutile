enum entity_kind : [u08] {
	function;
	global;
	local;
	parameter;
	record;
	field;
	enumeration;
	enumerator;
	namespace_body;
	alias;
	type_parameter;
	template_pattern;
};

enum entity_state : [u08] {
	declared;
	resolving;
	ready;
};

enum binding_lifetime : [u08] {
	live;
	consumed;
};

enum function_definition : [u08] {
	declaration;
	user_defined;
	defaulted;
	deleted;
};

enum function_role : [u08] {
	ordinary;
	constructor;
	destructor;
	assignment;
	conversion;
};

enum conversion_mode : [u08] {
	explicit_only;
	implicit_allowed;
};

enum access_kind : [u08] {
	public_access;
	protected_access;
	private_access;
};

enum record_layout : [u08] {
	sequential;
	overlapping;
};

enum function_dispatch : [u08] {
	ordinary;
	virtual_function;
	override_function;
	final_function;
};

enum declaration_origin : [u08] {
	source;
	compiler_supplied;
};

struct Scope;

struct Entity {
	fn virtual_owner(const Entity& this) -> Entity*;
	fn owns_dispatch(const Entity& this) -> bool {
		return this.virtual_functions().size() && (!this.bases().size() || !this.bases().data()[0]->entity()->virtual_functions().size());
	};
	fn virtual_functions(const Entity& this) -> const rt::buffer<Entity*>& {
		return this.dispatch_table;
	};
	fn add_virtual(Entity& this, Entity* function) -> bool {
		return @this.dispatch_table.push_back($function);
	};
	fn replace_virtual(Entity& this, usize index, Entity& function) {
		var entries = (@this.dispatch_table).data();
		@entries[index] = &function;
	};
	fn dispatch(const Entity& this) -> function_dispatch {
		if (this.final_specified) {
			return function_dispatch::final_function;
		};
		if (this.override_specified) {
			return function_dispatch::override_function;
		};
		if (this.virtual_specified) {
			return function_dispatch::virtual_function;
		};
		return function_dispatch::ordinary;
	};
	fn declares_virtual(const Entity& this) -> bool {
		return this.virtual_specified;
	};
	fn requires_override(const Entity& this) -> bool {
		return this.override_specified;
	};
	fn is_final(const Entity& this) -> bool {
		return this.final_specified;
	};
	fn set_dispatch(Entity& this, function_dispatch dispatch) {
		if (dispatch == function_dispatch::virtual_function) {
			@this.virtual_specified = true;
		};
		if (dispatch == function_dispatch::override_function) {
			@this.override_specified = true;
		};
		if (dispatch == function_dispatch::final_function) {
			@this.final_specified = true;
		};
	};
	fn merge_dispatch(Entity& this, const Entity& source) {
		@this.virtual_specified = this.virtual_specified || source.virtual_specified;
		@this.override_specified = this.override_specified || source.override_specified;
		@this.final_specified = this.final_specified || source.final_specified;
	};
	fn virtual_slot(const Entity& this) -> usize {
		return this.dispatch_slot;
	};
	fn set_virtual_slot(Entity& this, usize slot) {
		@this.dispatch_slot = $slot;
	};
	fn dispatch_required(const Entity& this) -> bool {
		return this.dispatch_live;
	};
	fn require_dispatch(Entity& this) {
		@this.dispatch_live = true;
	};
	fn find_member(const Entity& this, const rt::string_view& name) -> Entity*;
	fn bases(const Entity& this) -> const rt::buffer<const Type*>& {
		return this.base_types;
	};
	fn add_base(Entity& this, const Type* type) -> bool {
		return @this.base_types.push_back($type);
	};
	fn Entity(Entity& this, entity_kind kind, const Token& token, Syntax* source, Scope* scope) {
		@this.category = $kind;
		@this.location := token;
		@this.source = $source;
		@this.declaration_scope = $scope;
	};
	fn kind(const Entity& this) -> entity_kind {
		return entity_kind(this.category);
	};
	fn layout(const Entity& this) -> record_layout {
		if (this.declaration() && this.declaration()->token().kind == token_kind::kw_union) {
			return record_layout::overlapping;
		};
		return record_layout::sequential;
	};
	fn denotes_type(const Entity& this) -> bool {
		switch (this.kind()) {
			case entity_kind::record:
			case entity_kind::enumeration:
			case entity_kind::alias:
			case entity_kind::type_parameter:
				return true;
			case entity_kind::template_pattern:
				return this.declaration()->kind() == syntax_kind::template_declaration && (this.declaration()->template_declaration()->kind() == syntax_kind::record || this.declaration()->template_declaration()->kind() == syntax_kind::using_alias);
			default:
				return false;
		};
	};
	fn member_owner(const Entity& this) -> Entity* {
		if (this.kind() == entity_kind::alias || this.kind() == entity_kind::type_parameter) {
			if (!this.type() || this.type()->kind() != type_kind::named) {
				return nullptr;
			};
			return this.type()->entity();
		};
		if (this.members()) {
			return const_cast<Entity*>(&this);
		};
		return nullptr;
	};
	fn instantiated(const Entity& this) -> bool {
		return this.template_instance;
	};
	fn set_instantiated(Entity& this) {
		@this.template_instance = true;
	};
	fn body_state(const Entity& this) -> entity_state {
		return entity_state(this.body_resolution);
	};
	fn set_body_state(Entity& this, entity_state state) {
		@this.body_resolution = $state;
	};
	fn canonical(const Entity& this) -> Entity* {
		if (this.previous_declaration) {
			return this.previous_declaration->canonical();
		};
		return const_cast<Entity*>(&this);
	};
	fn token(const Entity& this) -> Token {
		return Token(this.location);
	};
	fn name(const Entity& this) -> rt::string_view {
		if (!this.generated_name.empty()) {
			return this.generated_name.view();
		};
		return this.location.text();
	};
	fn set_name(Entity& this, const rt::string_view& name) -> bool {
		return @this.generated_name.append(name);
	};
	fn origin(const Entity& this) -> declaration_origin {
		return declaration_origin(this.declaration_origin_kind);
	};
	fn set_origin(Entity& this, declaration_origin origin) {
		@this.declaration_origin_kind = $origin;
	};
	fn type(const Entity& this) -> const Type* {
		return this.value_type;
	};
	fn declaration(const Entity& this) -> Syntax* {
		return this.source;
	};
	fn scope(const Entity& this) -> Scope* {
		return this.declaration_scope;
	};
	fn resolution_scope(const Entity& this) -> Scope* {
		if (this.definition_scope) {
			return this.definition_scope;
		};
		return this.declaration_scope;
	};
	fn set_resolution_scope(Entity& this, Scope* scope) {
		@this.definition_scope = $scope;
	};
	fn members(const Entity& this) -> Scope* {
		return this.member_scope;
	};
	fn body(const Entity& this) -> SemanticExpression* {
		return this.implementation.get();
	};
	fn parameters(const Entity& this) -> const rt::buffer<Entity*>& {
		return this.arguments;
	};
	fn fields(const Entity& this) -> const rt::buffer<Entity*>& {
		return this.member_fields;
	};
	fn index(const Entity& this) -> usize {
		return this.position;
	};
	fn state(const Entity& this) -> entity_state {
		return entity_state(this.resolution);
	};
	fn lifetime(const Entity& this) -> binding_lifetime {
		return binding_lifetime(this.validity);
	};
	fn integer(const Entity& this) -> u64 {
		return this.constant_value;
	};
	fn underlying(const Entity& this) -> const Type* {
		return this.underlying_type;
	};
	fn destructor(const Entity& this) -> Entity* {
		if (!this.finalizer) {
			return nullptr;
		};
		return this.finalizer->canonical();
	};
	fn default_constructor(const Entity& this) -> Entity* {
		return this.default_initializer;
	};
	fn copy_constructor(const Entity& this) -> Entity* {
		return this.copy_initializer;
	};
	fn move_constructor(const Entity& this) -> Entity* {
		return this.move_initializer;
	};
	fn set_default_constructor(Entity& this, Entity* function) {
		@this.default_initializer = $function;
	};
	fn set_copy_constructor(Entity& this, Entity* function) {
		@this.copy_initializer = $function;
	};
	fn set_move_constructor(Entity& this, Entity* function) {
		@this.move_initializer = $function;
	};
	fn definition(const Entity& this) -> function_definition {
		return function_definition(this.body_kind);
	};
	fn role(const Entity& this) -> function_role {
		return function_role(this.function_kind);
	};
	fn conversion(const Entity& this) -> conversion_mode {
		return conversion_mode(this.conversion_kind);
	};
	fn access(const Entity& this) -> access_kind {
		return access_kind(this.visibility);
	};
	fn set_access(Entity& this, access_kind access) {
		@this.visibility = $access;
	};
	fn operator_kind(const Entity& this) -> token_kind {
		return token_kind(this.operator_symbol);
	};
	fn set_operator_kind(Entity& this, token_kind operation) {
		@this.operator_symbol = $operation;
	};
	fn set_definition(Entity& this, function_definition definition) {
		@this.body_kind = $definition;
	};
	fn set_role(Entity& this, function_role role) {
		@this.function_kind = $role;
	};
	fn set_conversion(Entity& this, conversion_mode mode) {
		@this.conversion_kind = $mode;
	};
	fn set_destructor(Entity& this, Entity* function) {
		@this.finalizer = $function;
	};
	fn set_type(Entity& this, const Type* type) {
		@this.value_type = $type;
	};
	fn merge_into(Entity& this, Entity* canonical) {
		@this.previous_declaration = $canonical;
	};
	fn replace_declaration(Entity& this, Syntax* syntax) {
		@this.source = $syntax;
	};
	fn adopt_definition(Entity& this, const Entity& source) -> bool {
		@this.source = source.declaration();
		@this.member_scope = source.members();
		@this.body_kind = source.definition();
		@this.function_kind = source.role();
		if (source.conversion() == conversion_mode::implicit_allowed) {
			@this.conversion_kind = conversion_mode::implicit_allowed;
		};
		@this.arguments.clear();
		usize index = 0;
		while (index < source.parameters().size()) {
			if (!@this.arguments.push_back(source.parameters().data()[index])) {
				return false;
			};
			@index = index + 1;
		};
		return true;
	};
	fn set_members(Entity& this, Scope* scope) {
		@this.member_scope = $scope;
	};
	fn set_body(Entity& this, rt::unique<SemanticExpression> body) {
		@this.implementation = $body;
	};
	fn set_state(Entity& this, entity_state state) {
		@this.resolution = $state;
	};
	fn set_lifetime(Entity& this, binding_lifetime lifetime) {
		@this.validity = $lifetime;
	};
	fn set_integer(Entity& this, u64 value) {
		@this.constant_value = $value;
	};
	fn set_underlying(Entity& this, const Type* type) {
		@this.underlying_type = $type;
	};
	fn set_index(Entity& this, usize index) {
		@this.position = $index;
	};
	fn add_parameter(Entity& this, Entity* parameter) -> bool {
		return @this.arguments.push_back($parameter);
	};
	fn add_field(Entity& this, Entity* field) -> bool {
		return @this.member_fields.push_back($field);
	};

private:
	entity_kind category;
	declaration_origin declaration_origin_kind;
	rt::string generated_name;
	entity_state resolution;
	entity_state body_resolution;
	bool template_instance;
	bool virtual_specified;
	bool override_specified;
	bool final_specified;
	bool dispatch_live;
	usize dispatch_slot;
	function_definition body_kind;
	function_role function_kind;
	conversion_mode conversion_kind;
	access_kind visibility;
	token_kind operator_symbol;
	binding_lifetime validity;
	Token location;
	Syntax* source;
	Scope* declaration_scope;
	Scope* definition_scope;
	Scope* member_scope;
	Entity* previous_declaration;
	Entity* finalizer;
	Entity* default_initializer;
	Entity* copy_initializer;
	Entity* move_initializer;
	const Type* value_type;
	const Type* underlying_type;
	usize position;
	u64 constant_value;
	rt::buffer<Entity*> arguments;
	rt::buffer<Entity*> member_fields;
	rt::buffer<const Type*> base_types;
	rt::buffer<Entity*> dispatch_table;
	rt::unique<SemanticExpression> implementation;
};

fn Entity::find_member(const Entity& this, const rt::string_view& name) -> Entity* {
	if (!this.members()) {
		return nullptr;
	};
	Entity* result = this.members()->local(name);
	if (result || this.bases().size() != 1) {
		return result;
	};
	Entity* base = this.bases().data()[0]->entity();
	if (base->name() == name) {
		return $base;
	};
	return base->find_member(name);
};
fn Entity::virtual_owner(const Entity& this) -> Entity* {
	if (!this.virtual_functions().size()) {
		return nullptr;
	};
	if (this.bases().size() && this.bases().data()[0]->entity()->virtual_functions().size()) {
		return this.bases().data()[0]->entity()->virtual_owner();
	};
	return const_cast<Entity*>(&this);
};
