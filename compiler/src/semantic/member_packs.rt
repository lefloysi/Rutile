fn Analyzer::collect_member_pack(var Analyzer& this, var Scope& scope, var Syntax& declaration) -> CompilationResult {
	var Entity* owner = scope.owner();
	if (!owner || owner->kind() != entity_kind::record) {
		@this.error(&@declaration, "member pack declaration requires record scope");
		return CompilationResult(compilation_error());
	};
	var Syntax* name = declaration.variable_name();
	if (name->kind() != syntax_kind::name || scope.local(name->token().text())) {
		@this.error(name, "member pack requires a distinct unqualified name");
		return CompilationResult(compilation_error());
	};
	if (declaration.variable_initializer()->kind() != syntax_kind::absent) {
		@this.error(&@declaration, "member pack declaration cannot have an initializer");
		return CompilationResult(compilation_error());
	};
	var Entity* members = @this.unit->create_entity(entity_kind::field_pack, name->token(), &@declaration, &@scope);
	if (!members) {
		return CompilationResult(compilation_error());
	};
	@members->set_access(scope.access());
	@owner->add_field(members);
	return CompilationResult();
};

fn Analyzer::resolve_member_pack(var Analyzer& this, var Entity& members) -> CompilationResult {
	var Scope* scope = members.scope();
	var Entity* owner = scope->owner();
	var Syntax* declaration = members.declaration();
	var Syntax* name = declaration->variable_name();
	var TemplatePack* elements = @this.templates.pack(@this, @*scope, @*declaration->variable_type()->item(0));
	if (!elements) {
		return CompilationResult(compilation_error());
	};
	@members.set_pack(elements);
	usize index = 0;
	while (index < elements->elements.size()) {
		TemplateArgument& argument = elements->elements.data()[index];
		if (argument.kind != template_argument_kind::type || !argument.type) {
			@this.error(declaration, "member pack requires type arguments");
			return CompilationResult(compilation_error());
		};
		Type* type = argument.type;
		if ((type->kind() == type_kind::null_type || type->kind() == type_kind::void_type && owner->scope() && owner->scope()->owner() && variant_instance(*owner->scope()->owner())) && owner->layout() == record_layout::overlapping) {
			// Storage-free alternatives retain their pack position and discriminant.
			@members.add_field(nullptr);
			@index = index + 1;
			continue;
		};
		if (type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function) {
			@this.error(declaration, "member pack element requires object storage or a reference");
			return CompilationResult(compilation_error());
		};
		Type* storage_type = type;
		while (storage_type->kind() == type_kind::array) {
			@storage_type = storage_type->element();
		};
		if (storage_type->kind() == type_kind::named && storage_type->entity()->kind() == entity_kind::record && (storage_type->entity()->state() == entity_state::resolving || storage_type->entity()->declaration()->record_members()->kind() == syntax_kind::noop || !storage_type->has_layout())) {
			@this.error(declaration, "member pack element requires a complete nonrecursive storage type");
			return CompilationResult(compilation_error());
		};
		var field_name = DiagnosticMessage();
		@field_name.text(members.name());
		@field_name.text("[");
		@field_name.number(u64(index));
		@field_name.text("]");
		var Entity* field = @this.unit->create_entity(entity_kind::field, name->token(), declaration, scope);
		if (field) {
			@field->set_name(field_name.view());
		}
		else {
			return CompilationResult(compilation_error());
		};
		@field->set_origin(declaration_origin::compiler_supplied);
		@field->set_access(members.access());
		@field->set_type(type);
		if (argument.type_use.has_value()) {
			@field->set_type_use(argument.type_use.value());
		};
		@field->set_integer(u64(index));
		@field->set_state(entity_state::ready);
		@field->set_body_state(entity_state::ready);
		@members.add_field(field);
		@index = index + 1;
	};
	@members.set_state(entity_state::ready);
	@members.set_body_state(entity_state::ready);
	return CompilationResult();
};

fn Analyzer::expand_member_packs(var Analyzer& this, var Entity& record) -> CompilationResult {
	rt::buffer<var Entity*> fields;
	usize index = 0;
	while (index < record.fields().size()) {
		var Entity* member = record.fields().data()[index];
		@index = index + 1;
		if (member->kind() != entity_kind::field_pack) {
			@member->set_index(fields.size());
			@fields.push_back(member);
			continue;
		};
		if (!(@this.resolve(member)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		usize element = 0;
		while (element < member->fields().size()) {
			var Entity* field = member->fields().data()[element];
			@element = element + 1;
			if (!field) {
				continue;
			};
			@field->set_index(fields.size());
			@fields.push_back(field);
		};
	};
	@record.set_fields($fields);
	return CompilationResult();
};
