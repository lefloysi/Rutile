enum function_fact_kind : [u08] {
	unknown;
	integer;
	entry_place;
	binary;
	unary;
	cast;
	variant;
};

struct FunctionFactExpression {
	function_fact_kind kind;
	u64 integer;
	var SemanticExpression* place;
	token_kind operation;
	usize left;
	usize right;
	Type* type;
};

struct FactPathCondition {
	usize value;
	bool truth;
};

enum function_fact_effect : [u08] {
	known_write;
	scoped_havoc;
};

struct FactWrite {
	var SemanticExpression* target;
	usize value;
	function_fact_effect kind;
};

struct FunctionFactOutcome {
	var SemanticExpression* return_expression;
	usize result;
	rt::buffer<FactPathCondition> conditions;
	rt::buffer<FactWrite> writes;
};

struct FunctionFactSummary {
	var Entity* function;
	rt::buffer<FunctionFactExpression> expressions;
	rt::buffer<FunctionFactOutcome> outcomes;
	rt::buffer<rt::unique<SemanticExpression>> projected_places;
	bool opaque;
};

struct FunctionFactBinding {
	var SemanticExpression* expression;
	usize value;
};

struct FunctionFactPath {
	rt::buffer<FactPathCondition> conditions;
	rt::buffer<FactWrite> writes;
	rt::buffer<FunctionFactBinding> bindings;
	bool returned;
	fn copy_from(var FunctionFactPath& this, FunctionFactPath& other);
};

fn FunctionFactPath::copy_from(var FunctionFactPath& this, FunctionFactPath& other) {
	@this.returned = other.returned;
	usize binding = 0;
	while (binding < other.bindings.size()) {
		@this.bindings.push_back(FunctionFactBinding(other.bindings.data()[binding]));
		@binding = binding + 1;
	};
	usize index = 0;
	while (index < other.conditions.size()) {
		@this.conditions.push_back(FactPathCondition(other.conditions.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.writes.size()) {
		@this.writes.push_back(FactWrite(other.writes.data()[index]));
		@index = index + 1;
	};
};

fn function_fact_unwrap(var SemanticExpression* expression) -> var SemanticExpression* {
	while (expression && expression->size() == 1 && (expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::cast && expression->category() == value_category::place && expression->type()->same_shape(*expression->item(0)->type()))) {
		@expression = expression->item(0);
	};
	return expression;
};

fn function_fact_same_place(var SemanticExpression* left, var SemanticExpression* right) -> bool {
	var SemanticExpression* first = function_fact_unwrap(left);
	var SemanticExpression* second = function_fact_unwrap(right);
	if (!first || !second) {
		return false;
	};
	if ((first->kind() == semantic_kind::name || first->kind() == semantic_kind::variable) && (second->kind() == semantic_kind::name || second->kind() == semantic_kind::variable)) {
		return first->entity() == second->entity();
	};
	return first->kind() == semantic_kind::member && second->kind() == semantic_kind::member && first->entity() == second->entity() && function_fact_same_place(first->item(0), second->item(0));
};

fn function_fact_root(var SemanticExpression* expression) -> var Entity* {
	@expression = function_fact_unwrap(expression);
	while (expression && expression->kind() == semantic_kind::member) {
		if (expression->entity() && expression->entity()->type()->kind() == type_kind::reference) {
			return nullptr;
		};
		var SemanticExpression* receiver = function_fact_unwrap(expression->item(0));
		Type* type = receiver->type();
		if (type->kind() == type_kind::reference) {
			@type = type->element();
		};
		if (type->kind() == type_kind::pointer || type->kind() == type_kind::named && type->entity()->layout() == record_layout::overlapping) {
			return nullptr;
		};
		@expression = receiver;
	};
	if (expression && (expression->kind() == semantic_kind::name || expression->kind() == semantic_kind::variable)) {
		return expression->entity();
	};
	return nullptr;
};

fn function_fact_contains_place(SemanticExpression* prefix, SemanticExpression* place) -> bool {
	var SemanticExpression* current = function_fact_unwrap(const_cast<var SemanticExpression*>(place));
	while (current) {
		if (function_fact_same_place(const_cast<var SemanticExpression*>(prefix), current)) {
			return true;
		};
		if (current->kind() != semantic_kind::member || current->size() != 1) {
			return false;
		};
		@current = function_fact_unwrap(current->item(0));
	};
	return false;
};

fn function_fact_reverse_comparison(token_kind operation) -> token_kind {
	switch (operation) {
		case token_kind::op_less:
			return token_kind::op_greater;
		case token_kind::op_less_equal:
			return token_kind::op_greater_equal;
		case token_kind::op_greater:
			return token_kind::op_less;
		case token_kind::op_greater_equal:
			return token_kind::op_less_equal;
	};
	return operation;
};

fn function_fact_truth(FunctionFactSummary& summary, usize value, usize depth) -> fact_truth {
	if (!value || value > summary.expressions.size() || depth > 32) {
		return fact_truth::unknown;
	};
	FunctionFactExpression& expression = summary.expressions.data()[value - 1];
	if (expression.kind == function_fact_kind::integer) {
		if (expression.integer) {
			return fact_truth::proven;
		};
		return fact_truth::disproven;
	};
	if (expression.kind == function_fact_kind::cast && expression.left && (expression.type->kind() == type_kind::boolean || expression.type->same_shape(*summary.expressions.data()[expression.left - 1].type))) {
		return function_fact_truth(summary, expression.left, depth + 1);
	};
	if (expression.kind == function_fact_kind::unary && expression.operation == token_kind::op_bang) {
		fact_truth child = function_fact_truth(summary, expression.left, depth + 1);
		if (child == fact_truth::proven) {
			return fact_truth::disproven;
		};
		if (child == fact_truth::disproven) {
			return fact_truth::proven;
		};
	};
	return fact_truth::unknown;
};

fn function_fact_unsigned_bound(FunctionFactSummary& summary, usize value, FunctionFactPath& path, usize depth) -> IntegerRange {
	if (!value || value > summary.expressions.size() || depth > 32) {
		return IntegerRange();
	};
	FunctionFactExpression& expression = summary.expressions.data()[value - 1];
	if (expression.kind == function_fact_kind::integer) {
		return fact_constant(expression.type, expression.integer);
	};
	if (expression.kind == function_fact_kind::cast && expression.left && expression.type->same_shape(*summary.expressions.data()[expression.left - 1].type)) {
		return function_fact_unsigned_bound(summary, expression.left, path, depth + 1);
	};
	Type* type = expression.type->representation();
	if (expression.kind != function_fact_kind::entry_place || type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean && type->kind() != type_kind::character) {
		return IntegerRange();
	};
	IntegerRange range = fact_range(0, fact_limit(type));
	usize index = 0;
	while (index < path.conditions.size()) {
		FactPathCondition& source = path.conditions.data()[index];
		usize condition = source.value;
		bool truth = source.truth;
		usize wrappers = 0;
		while (condition && condition <= summary.expressions.size() && wrappers < 32) {
			FunctionFactExpression& wrapper = summary.expressions.data()[condition - 1];
			if (wrapper.kind == function_fact_kind::unary && wrapper.operation == token_kind::op_bang) {
				@truth = !truth;
				@condition = wrapper.left;
			}
			else if (wrapper.kind == function_fact_kind::cast && wrapper.left && wrapper.type->kind() == type_kind::boolean && summary.expressions.data()[wrapper.left - 1].type->kind() == type_kind::boolean) {
				@condition = wrapper.left;
			}
			else {
				break;
			};
			@wrappers = wrappers + 1;
		};
		if (condition && condition <= summary.expressions.size()) {
			FunctionFactExpression& guard = summary.expressions.data()[condition - 1];
			if (guard.kind == function_fact_kind::binary && guard.left && guard.right && summary.expressions.data()[guard.left - 1].type->same_shape(*expression.type) && summary.expressions.data()[guard.right - 1].type->same_shape(*expression.type)) {
				FunctionFactExpression& first = summary.expressions.data()[guard.left - 1];
				FunctionFactExpression& second = summary.expressions.data()[guard.right - 1];
				token_kind operation = guard.operation;
				usize constant = 0;
				if (first.kind == function_fact_kind::entry_place && second.kind == function_fact_kind::integer && function_fact_same_place(first.place, expression.place)) {
					@constant = guard.right;
				}
				else if (second.kind == function_fact_kind::entry_place && first.kind == function_fact_kind::integer && function_fact_same_place(second.place, expression.place)) {
					@constant = guard.left;
					@operation = function_fact_reverse_comparison(operation);
				};
				if (constant) {
					FunctionFactExpression& bound = summary.expressions.data()[constant - 1];
					IntegerRange limit = fact_constant(bound.type, bound.integer);
					if (!truth) {
						@operation = fact_inverse(operation);
					};
					if (limit.available != fact_truth::unknown && limit.sign != integer_range_sign::negative) {
						if (operation == token_kind::op_less && limit.lower && range.upper >= limit.lower) {
							@range.upper = limit.lower - 1;
						};
						if (operation == token_kind::op_less_equal && range.upper > limit.lower) {
							@range.upper = limit.lower;
						};
						if (operation == token_kind::op_greater && limit.lower != u64::max && range.lower <= limit.lower) {
							@range.lower = limit.lower + 1;
						};
						if (operation == token_kind::op_greater_equal && range.lower < limit.lower) {
							@range.lower = limit.lower;
						};
						if (operation == token_kind::op_equal) {
							if (range.lower < limit.lower) {
								@range.lower = limit.lower;
							};
							if (range.upper > limit.lower) {
								@range.upper = limit.lower;
							};
						};
						if (operation == token_kind::op_not_equal) {
							if (range.upper == limit.lower && range.upper) {
								@range.upper = range.upper - 1;
							};
							if (range.lower == limit.lower && range.lower != u64::max) {
								@range.lower = range.lower + 1;
							};
						};
					};
				};
			};
		};
		@index = index + 1;
	};
	if (range.lower > range.upper) {
		return IntegerRange();
	};
	return $range;
};

fn function_fact_unknown_binary(token_kind operation) -> bool {
	return operation == token_kind::op_star || operation == token_kind::op_slash
		|| operation == token_kind::op_remainder || operation == token_kind::op_shift_left
		|| operation == token_kind::op_shift_right || operation == token_kind::op_ampersand
		|| operation == token_kind::op_pipe || operation == token_kind::op_caret;
};

struct FunctionFactSummaries {
	rt::buffer<rt::unique<FunctionFactSummary>> summaries;
	fn validate(var FunctionFactSummaries& this, SemanticUnit& unit);
	fn find(FunctionFactSummaries& this, Entity* function) -> var FunctionFactSummary*;
	fn build(var FunctionFactSummaries& this, var Entity& function);
	fn expression(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> usize;
	fn walk(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths);
	fn finish(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* returned, usize result, FunctionFactPath& path);
	fn import_value(var FunctionFactSummaries& this, var FunctionFactSummary& summary, FunctionFactSummary& callee, usize value, var SemanticExpression& call, var FunctionFactPath& path, usize depth) -> usize;
	fn payload_safe(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> bool;
	fn expand_call(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* call, var rt::buffer<rt::unique<FunctionFactPath>>& paths);
	fn scoped_array_write(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* target, var SemanticExpression* value, var FunctionFactPath& path);
	fn expand_boolean(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths, usize depth);
};

fn function_fact_clone_place(var SemanticExpression* source) -> rt::unique<SemanticExpression> {
	@source = function_fact_unwrap(source);
	if (!source || source->kind() != semantic_kind::name && source->kind() != semantic_kind::member) {
		return rt::unique<SemanticExpression>();
	};
	var token = source->token();
	var result = SemanticExpression::make(source->kind(), source->type(), token);
	@result.get()->bind(source->entity(), value_category::place);
	if (source->kind() == semantic_kind::member) {
		var child = function_fact_clone_place(source->item(0));
		if (!child.get()) {
			return rt::unique<SemanticExpression>();
		};
		if (!(@result.get()->append($child)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
	};
	return $result;
};

fn function_fact_project_place(FunctionFactSummary& callee, var SemanticExpression* source, var SemanticExpression& call) -> rt::unique<SemanticExpression> {
	@source = function_fact_unwrap(source);
	if (!source) {
		return rt::unique<SemanticExpression>();
	};
	if (source->kind() == semantic_kind::name) {
		usize parameter = 0;
		while (parameter < callee.function->parameters().size()) {
			if (source->entity() == callee.function->parameters().data()[parameter]) {
				if (call.size() != 2 || parameter >= call.item(1)->size()) {
					return rt::unique<SemanticExpression>();
				};
				return function_fact_clone_place(call.item(1)->item(parameter));
			};
			@parameter = parameter + 1;
		};
		return function_fact_clone_place(source);
	};
	if (source->kind() != semantic_kind::member) {
		return rt::unique<SemanticExpression>();
	};
	var token = source->token();
	var result = SemanticExpression::make(semantic_kind::member, source->type(), token);
	@result.get()->bind(source->entity(), value_category::place);
	var child = function_fact_project_place(callee, source->item(0), @call);
	if (!child.get()) {
		return rt::unique<SemanticExpression>();
	};
	if (!(@result.get()->append($child)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	return $result;
};

fn FunctionFactSummaries::find(FunctionFactSummaries& this, Entity* function) -> var FunctionFactSummary* {
	if (!function) {
		return nullptr;
	};
	@function = function->canonical();
	usize index = this.summaries.size();
	while (index) {
		@index = index - 1;
		if (this.summaries.data()[index].get()->function == function) {
			return this.summaries.data()[index].get();
		};
	};
	return nullptr;
};

fn FunctionFactSummaries::expression(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> usize {
	if (!expression || summary.expressions.size() >= 4096) {
		@summary.opaque = true;
		return 0;
	};
	usize binding = path.bindings.size();
	while (binding) {
		@binding = binding - 1;
		if (path.bindings.data()[binding].expression == expression) {
			return path.bindings.data()[binding].value;
		};
	};
	FunctionFactExpression result;
	@result.type = expression->type();
	u64 integer = 0;
	if (expression->constant_integer(@integer)) {
		@result.kind = function_fact_kind::integer;
		@result.integer = integer;
	}
	else if (expression->kind() == semantic_kind::access && expression->size() == 1) {
		return @this.expression(@summary, expression->item(0), @path);
	}
	else if (expression->kind() == semantic_kind::construction && !expression->entity() && expression->type()->representation()->kind().is_numeric() && expression->size() == 1 && expression->item(0)->kind() == semantic_kind::brace && expression->item(0)->size() <= 1) {
		if (!expression->item(0)->size()) {
			@result.kind = function_fact_kind::integer;
			@result.integer = 0;
		}
		else {
			@result.kind = function_fact_kind::cast;
			@result.left = @this.expression(@summary, expression->item(0)->item(0), @path);
		};
	}
	else if (expression->kind() == semantic_kind::cast && expression->size() == 1 && expression->type()->kind() == type_kind::named && variant_instance(*expression->type()->entity()) && expression->type()->same_shape(*expression->item(0)->type())) {
		return @this.expression(@summary, expression->item(0), @path);
	}
	else if (expression->kind() == semantic_kind::construction && !expression->entity() && expression->integer() && expression->type()->kind() == type_kind::named && variant_instance(*expression->type()->entity())) {
		var Entity* destructor = expression->type()->entity()->destructor();
		if (destructor && destructor->definition() != function_definition::defaulted) {
			@summary.opaque = true;
			return 0;
		};
		usize child = 0;
		while (child < expression->size()) {
			if (!@this.payload_safe(@summary, expression->item(child), @path)) {
				@summary.opaque = true;
				return 0;
			};
			@child = child + 1;
		};
		@result.kind = function_fact_kind::variant;
		@result.integer = expression->integer();
	}
	else if (expression->kind() == semantic_kind::name || expression->kind() == semantic_kind::member) {
		usize index = path.writes.size();
		while (index) {
			@index = index - 1;
			FactWrite& effect = path.writes.data()[index];
			if (effect.kind == function_fact_effect::scoped_havoc && (function_fact_contains_place(effect.target, expression) || function_fact_contains_place(expression, effect.target))) {
				@result.kind = function_fact_kind::unknown;
				@summary.expressions.push_back($result);
				return summary.expressions.size();
			};
			if (function_fact_same_place(expression, effect.target)) {
				return effect.value;
			};
		};
		var Entity* root = function_fact_root(expression);
		if (!root || root->kind() != entity_kind::parameter && root->kind() != entity_kind::global) {
			@summary.opaque = true;
			return 0;
		};
		@result.kind = function_fact_kind::entry_place;
		@result.place = expression;
	}
	else if (expression->kind() == semantic_kind::call && expression->entity() && expression->size() == 2) {
		var FunctionFactSummary* callee = this.find(expression->entity());
		if (!callee || callee->opaque || callee->outcomes.size() != 1 || callee->outcomes.data()[0].writes.size()) {
			@summary.opaque = true;
			return 0;
		};
		// Even unused arguments execute. Check every argument for opaque effects.
		usize argument = 0;
		while (argument < expression->item(1)->size()) {
			discard @this.expression(@summary, expression->item(1)->item(argument), @path);
			@argument = argument + 1;
		};
		// A read-only callee can restrict its normal continuation even when
		// its other paths throw. Substitute those guards through wrappers.
		FunctionFactOutcome& outcome = callee->outcomes.data()[0];
		usize condition = 0;
		while (condition < outcome.conditions.size()) {
			FactPathCondition guard;
			@guard.value = @this.import_value(@summary, *callee, outcome.conditions.data()[condition].value, @*expression, @path, 0);
			@guard.truth = outcome.conditions.data()[condition].truth;
			@path.conditions.push_back($guard);
			@condition = condition + 1;
		};
		if (!outcome.result) {
			return 0;
		};
		return @this.import_value(@summary, *callee, callee->outcomes.data()[0].result, @*expression, @path, 0);
	}
	else if ((expression->kind() == semantic_kind::index || expression->kind() == semantic_kind::dereference) && expression->type()->representation()->kind().is_scalar()) {
		// A memory read has an unknown value, but does not erase the guards
		// on paths that return normally. Its operands still execute.
		usize child = 0;
		while (child < expression->size()) {
			discard @this.expression(@summary, expression->item(child), @path);
			@child = child + 1;
		};
		@result.kind = function_fact_kind::unknown;
	}
	else if ((expression->kind() == semantic_kind::binary && expression->size() == 2) || (expression->kind() == semantic_kind::unary && expression->size() == 1) || (expression->kind() == semantic_kind::cast && expression->size() == 1)) {
		@result.operation = expression->operation();
		if (expression->kind() == semantic_kind::binary && !function_fact_unknown_binary(result.operation) && result.operation != token_kind::op_plus && result.operation != token_kind::op_minus && result.operation != token_kind::op_less && result.operation != token_kind::op_less_equal && result.operation != token_kind::op_greater && result.operation != token_kind::op_greater_equal && result.operation != token_kind::op_equal && result.operation != token_kind::op_not_equal) {
			@summary.opaque = true;
			return 0;
		};
		if (expression->kind() == semantic_kind::unary && result.operation != token_kind::op_bang && result.operation != token_kind::op_minus && result.operation != token_kind::op_plus) {
			@summary.opaque = true;
			return 0;
		};
		@result.kind = function_fact_kind::binary;
		if (expression->kind() == semantic_kind::binary && function_fact_unknown_binary(result.operation)) {
			@result.kind = function_fact_kind::unknown;
		}
		else if (expression->kind() == semantic_kind::cast) {
			@result.kind = function_fact_kind::cast;
		}
		else if (expression->kind() == semantic_kind::unary) {
			@result.kind = function_fact_kind::unary;
		};
		@result.left = @this.expression(@summary, expression->item(0), @path);
		if (expression->size() == 2) {
			@result.right = @this.expression(@summary, expression->item(1), @path);
		};
	}
	else {
		@summary.opaque = true;
		return 0;
	};
	@summary.expressions.push_back($result);
	return summary.expressions.size();
};

fn FunctionFactSummaries::payload_safe(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> bool {
	if (!expression) {
		return false;
	};
	if (expression->kind() == semantic_kind::construction) {
		Type* type = expression->type();
		if (expression->entity() && expression->entity()->definition() != function_definition::defaulted) {
			return false;
		};
		if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			var Entity* record = type->entity();
			var Entity* destructor = record->destructor();
			if (record->fields().size() || record->bases().size() || destructor && destructor->definition() != function_definition::defaulted) {
				return false;
			};
		}
		else if (!type->representation()->kind().is_scalar()) {
			return false;
		};
	}
	else if (expression->kind() != semantic_kind::brace && expression->kind() != semantic_kind::cast && expression->kind() != semantic_kind::access) {
		discard @this.expression(@summary, expression, @path);
		return !summary.opaque;
	};
	usize child = 0;
	while (child < expression->size()) {
		if (!@this.payload_safe(@summary, expression->item(child), @path)) {
			return false;
		};
		@child = child + 1;
	};
	return true;
};

fn FunctionFactSummaries::import_value(var FunctionFactSummaries& this, var FunctionFactSummary& summary, FunctionFactSummary& callee, usize value, var SemanticExpression& call, var FunctionFactPath& path, usize depth) -> usize {
	if (!value || value > callee.expressions.size() || depth > 64) {
		@summary.opaque = true;
		return 0;
	};
	FunctionFactExpression result = FunctionFactExpression(callee.expressions.data()[value - 1]);
	if (result.kind == function_fact_kind::entry_place) {
		var SemanticExpression* source = function_fact_unwrap(result.place);
		usize parameter = 0;
		while (source->kind() == semantic_kind::name && parameter < callee.function->parameters().size()) {
			if (source->entity() == callee.function->parameters().data()[parameter]) {
				if (source->entity()->type()->kind() == type_kind::reference) {
					var projected = function_fact_clone_place(call.item(1)->item(parameter));
					if (!projected.get()) {
						@summary.opaque = true;
						return 0;
					};
					var SemanticExpression* place = projected.get();
					@summary.projected_places.push_back($projected);
					return @this.expression(@summary, place, @path);
				};
				return @this.expression(@summary, call.item(1)->item(parameter), @path);
			};
			@parameter = parameter + 1;
		};
		var projected = function_fact_project_place(callee, source, @call);
		if (!projected.get()) {
			@summary.opaque = true;
			return 0;
		};
		var SemanticExpression* place = projected.get();
		@summary.projected_places.push_back($projected);
		return @this.expression(@summary, place, @path);
	};
	if (result.left) {
		@result.left = @this.import_value(@summary, callee, result.left, @call, @path, depth + 1);
	};
	if (result.right) {
		@result.right = @this.import_value(@summary, callee, result.right, @call, @path, depth + 1);
	};
	if (summary.expressions.size() >= 4096) {
		@summary.opaque = true;
		return 0;
	}
	else {
		@summary.expressions.push_back($result);
	};
	return summary.expressions.size();
};

fn FunctionFactSummaries::finish(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* returned, usize result, FunctionFactPath& path) {
	FunctionFactOutcome outcome;
	@outcome.return_expression = returned;
	@outcome.result = result;
	usize index = 0;
	while (index < path.conditions.size()) {
		@outcome.conditions.push_back(FactPathCondition(path.conditions.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < path.writes.size()) {
		FactWrite& write = path.writes.data()[index];
		var Entity* root = function_fact_root(write.target);
		if (root && (root->kind() == entity_kind::global || root->kind() == entity_kind::parameter && root->type()->kind() == type_kind::reference)) {
			@outcome.writes.push_back(FactWrite(write));
		};
		@index = index + 1;
	};
	@summary.outcomes.push_back($outcome);
};

// Initially compose calls only when their evaluation occupies a whole value
// position. Nested effectful call operands retain the conservative fallback.
fn function_fact_direct_call(var SemanticExpression* expression) -> var SemanticExpression* {
	while (expression && expression->size() == 1 && (expression->kind() == semantic_kind::cast || expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::unary)) {
		@expression = expression->item(0);
	};
	if (expression && expression->kind() == semantic_kind::call) {
		return expression;
	};
	return nullptr;
};

fn function_fact_contains_call(SemanticExpression* expression) -> bool {
	if (expression->kind() == semantic_kind::call) {
		return true;
	};
	usize child = 0;
	while (child < expression->size()) {
		if (function_fact_contains_call(expression->item(child))) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn FunctionFactSummaries::expand_call(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* call, var rt::buffer<rt::unique<FunctionFactPath>>& paths) {
	if (!call) {
		return;
	};
	var FunctionFactSummary* callee = this.find(call->entity());
	if (!callee || callee->opaque || call->size() != 2 || call->item(0)->kind() != semantic_kind::name || call->item(0)->entity()->canonical() != callee->function || callee->function->dispatch() != function_dispatch::ordinary || call->item(1)->size() != callee->function->parameters().size()) {
		@summary.opaque = true;
		return;
	};
	usize argument = 0;
	while (argument < call->item(1)->size()) {
		if (function_fact_contains_call(call->item(1)->item(argument))) {
			@summary.opaque = true;
			return;
		};
		@argument = argument + 1;
	};
	rt::buffer<rt::unique<FunctionFactPath>> expanded;
	usize index = 0;
	while (index < paths.size()) {
		if (expanded.size() >= 64) {
			@summary.opaque = true;
			return;
		};
		FunctionFactPath& source = *paths.data()[index].get();
		if (source.returned) {
			rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
			@retained.get()->copy_from(source);
			@expanded.push_back($retained);
		}
		else {
			FunctionFactPath entry;
			@entry.copy_from(source);
			@argument = 0;
			while (argument < call->item(1)->size()) {
				FunctionFactBinding binding;
				@binding.expression = call->item(1)->item(argument);
				@binding.value = @this.expression(@summary, binding.expression, @entry);
				@entry.bindings.push_back($binding);
				@argument = argument + 1;
			};
			if (summary.opaque) {
				return;
			};
			usize outcome = 0;
			while (outcome < callee->outcomes.size()) {
				if (expanded.size() >= 64) {
					@summary.opaque = true;
					return;
				};
				FunctionFactOutcome& selected = callee->outcomes.data()[outcome];
				rt::unique<FunctionFactPath> branch = rt::unique<FunctionFactPath>::make();
				@branch.get()->copy_from(entry);
				usize condition = 0;
				while (condition < selected.conditions.size()) {
					FactPathCondition guard;
					@guard.truth = selected.conditions.data()[condition].truth;
					@guard.value = @this.import_value(@summary, *callee, selected.conditions.data()[condition].value, @*call, @entry, 0);
					@branch.get()->conditions.push_back($guard);
					@condition = condition + 1;
				};
				// Import against the frozen call entry, before installing writes.
				FunctionFactBinding returned;
				@returned.expression = call;
				if (selected.result) {
					@returned.value = @this.import_value(@summary, *callee, selected.result, @*call, @entry, 0);
				};
				usize write = 0;
				while (write < selected.writes.size()) {
					var projected = function_fact_project_place(*callee, selected.writes.data()[write].target, @*call);
					if (!projected.get() || !function_fact_root(projected.get())) {
						@summary.opaque = true;
						return;
					};
					FactWrite effect;
					@effect.target = projected.get();
					@effect.kind = selected.writes.data()[write].kind;
					if (effect.kind == function_fact_effect::known_write) {
						@effect.value = @this.import_value(@summary, *callee, selected.writes.data()[write].value, @*call, @entry, 0);
					};
					@summary.projected_places.push_back($projected);
					@branch.get()->writes.push_back($effect);
					@write = write + 1;
				};
				if (summary.opaque) {
					return;
				};
				@branch.get()->bindings.push_back($returned);
				@expanded.push_back($branch);
				@outcome = outcome + 1;
			};
		};
		@index = index + 1;
	};
	@paths = $expanded;
};

fn FunctionFactSummaries::expand_boolean(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths, usize depth) {
	if (!paths.size()) {
		return;
	};
	if (!expression || expression->type()->kind() != type_kind::boolean || depth > 32) {
		@summary.opaque = true;
		return;
	};
	if (expression->kind() == semantic_kind::binary && (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or)) {
		@this.expand_boolean(@summary, expression->item(0), @paths, depth + 1);
		if (summary.opaque) {
			return;
		};
		rt::buffer<rt::unique<FunctionFactPath>> selected;
		rt::buffer<rt::unique<FunctionFactPath>> continuing;
		usize index = 0;
		while (index < paths.size()) {
			var FunctionFactPath& path = @*(@paths).data()[index].get();
			if (path.returned) {
				@selected.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
			}
			else {
				usize left = @this.expression(@summary, expression->item(0), @path);
				fact_truth truth = function_fact_truth(summary, left, 0);
				if (truth == fact_truth::unknown) {
					@summary.opaque = true;
					return;
				};
				bool skip = expression->operation() == token_kind::op_and && truth == fact_truth::disproven || expression->operation() == token_kind::op_or && truth == fact_truth::proven;
				if (skip) {
					FunctionFactBinding binding;
					@binding.expression = expression;
					@binding.value = left;
					@path.bindings.push_back($binding);
					@selected.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
				}
				else {
					@continuing.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
				};
			};
			@index = index + 1;
		};
		@this.expand_boolean(@summary, expression->item(1), @continuing, depth + 1);
		if (summary.opaque) {
			return;
		};
		@index = 0;
		while (index < continuing.size()) {
			if (selected.size() >= 64) {
				@summary.opaque = true;
				return;
			};
			var FunctionFactPath& path = @*(@continuing).data()[index].get();
			if (!path.returned) {
				FunctionFactBinding binding;
				@binding.expression = expression;
				@binding.value = @this.expression(@summary, expression->item(1), @path);
				@path.bindings.push_back($binding);
			};
			@selected.push_back(rt::unique<FunctionFactPath>(@((@continuing).data()[index]).release()));
			@index = index + 1;
		};
		@paths = $selected;
		return;
	};
	@this.expand_call(@summary, function_fact_direct_call(expression), @paths);
	if (summary.opaque) {
		return;
	};
	rt::buffer<rt::unique<FunctionFactPath>> branches;
	usize index = 0;
	while (index < paths.size()) {
		var FunctionFactPath& source = @*(@paths).data()[index].get();
		if (source.returned) {
			if (branches.size() >= 64) {
				@summary.opaque = true;
				return;
			};
			rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
			@retained.get()->copy_from(source);
			@branches.push_back($retained);
		}
		else {
			usize value = @this.expression(@summary, expression, @source);
			if (summary.opaque) {
				return;
			};
			fact_truth known = function_fact_truth(summary, value, 0);
			usize truth = 0;
			while (truth < 2) {
				if (known == fact_truth::unknown || (known == fact_truth::proven) == (truth != 0)) {
					if (branches.size() >= 64 || summary.expressions.size() >= 4096) {
						@summary.opaque = true;
						return;
					};
					rt::unique<FunctionFactPath> branch = rt::unique<FunctionFactPath>::make();
					@branch.get()->copy_from(source);
					if (known == fact_truth::unknown) {
						FactPathCondition guard;
						@guard.value = value;
						@guard.truth = truth != 0;
						@branch.get()->conditions.push_back($guard);
					};
					FunctionFactExpression constant;
					@constant.kind = function_fact_kind::integer;
					@constant.type = expression->type();
					@constant.integer = truth;
					@summary.expressions.push_back($constant);
					FunctionFactBinding binding;
					@binding.expression = expression;
					@binding.value = summary.expressions.size();
					@branch.get()->bindings.push_back($binding);
					@branches.push_back($branch);
				};
				@truth = truth + 1;
			};
		};
		@index = index + 1;
	};
	@paths = $branches;
};

fn FunctionFactSummaries::scoped_array_write(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* target, var SemanticExpression* value, var FunctionFactPath& path) {
	discard @this.expression(@summary, value, @path);
	var SemanticExpression* index = function_fact_unwrap(target);
	if (summary.opaque || !index || index->kind() != semantic_kind::index || index->size() != 2 || index->item(0)->type()->kind() != type_kind::array || !index->item(0)->type()->element()->representation()->kind().is_integer() || !function_fact_root(index->item(0))) {
		@summary.opaque = true;
		return;
	};
	usize evaluated = @this.expression(@summary, index->item(1), @path);
	IntegerRange bound = function_fact_unsigned_bound(summary, evaluated, path, 0);
	if (summary.opaque || bound.available == fact_truth::unknown || bound.sign == integer_range_sign::negative || bound.upper >= index->item(0)->type()->count()) {
		@summary.opaque = true;
		return;
	};
	FactWrite effect;
	@effect.target = index->item(0);
	@effect.kind = function_fact_effect::scoped_havoc;
	@path.writes.push_back($effect);
};

fn FunctionFactSummaries::walk(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths) {
	if (!expression || summary.opaque) {
		return;
	};
	semantic_kind kind = expression->kind();
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() == type_kind::reference) {
		@summary.opaque = true;
		return;
	};
	if (kind == semantic_kind::brace || kind == semantic_kind::statements) {
		usize child = 0;
		while (child < expression->size()) {
			@this.walk(@summary, expression->item(child), @paths);
			@child = child + 1;
		};
		return;
	};
	var SemanticExpression* evaluated = expression;
	if (kind == semantic_kind::conditional || kind == semantic_kind::variable || kind == semantic_kind::return_value) {
		if (expression->size()) {
			@evaluated = expression->item(0);
		};
	}
	else if (kind == semantic_kind::binary && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
		@evaluated = expression->item(1);
	};
	if (evaluated->kind() == semantic_kind::binary && (evaluated->operation() == token_kind::op_and || evaluated->operation() == token_kind::op_or)) {
		@this.expand_boolean(@summary, evaluated, @paths, 0);
	}
	else {
		@this.expand_call(@summary, function_fact_direct_call(evaluated), @paths);
	};
	if (summary.opaque) {
		return;
	};
	if (kind == semantic_kind::conditional) {
		rt::buffer<rt::unique<FunctionFactPath>> branches;
		usize index = 0;
		while (index < paths.size()) {
			var FunctionFactPath& source = @*(@paths).data()[index].get();
			if (source.returned) {
				rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
				@retained.get()->copy_from(source);
				@branches.push_back($retained);
			}
			else {
				usize condition = @this.expression(@summary, expression->item(0), @source);
				usize branch = 0;
				while (branch < 2) {
					fact_truth known = function_fact_truth(summary, condition, 0);
					if (known != fact_truth::unknown && (known == fact_truth::proven) != !branch) {
						@branch = branch + 1;
						continue;
					};
					rt::unique<FunctionFactPath> state = rt::unique<FunctionFactPath>::make();
					@state.get()->copy_from(source);
					FactPathCondition fact;
					@fact.value = condition;
					@fact.truth = !branch;
					@state.get()->conditions.push_back($fact);
					rt::buffer<rt::unique<FunctionFactPath>> selected;
					@selected.push_back($state);
					@this.walk(@summary, expression->item(branch + 1), @selected);
					usize selected_index = 0;
					while (selected_index < selected.size()) {
						@branches.push_back(rt::unique<FunctionFactPath>(@((@selected).data()[selected_index]).release()));
						@selected_index = selected_index + 1;
					};
					@branch = branch + 1;
				};
			};
			@index = index + 1;
		};
		@paths = $branches;
		if (paths.size() > 64) {
			@summary.opaque = true;
		};
		return;
	};
	usize index = 0;
	while (index < paths.size()) {
		var FunctionFactPath& path = @*(@paths).data()[index].get();
		if (!path.returned) {
			if (kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow) {
				// This path has no normal continuation. A throw does not itself
				// describe a violated language rule or classify an API outcome.
				@path.returned = true;
			}
			else if (kind == semantic_kind::return_value) {
				usize result = 0;
				if (expression->size()) {
					@result = @this.expression(@summary, expression->item(0), @path);
				};
				@this.finish(@summary, expression, result, path);
				@path.returned = true;
			}
			else if (kind == semantic_kind::variable || kind == semantic_kind::binary && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
				var SemanticExpression* target = expression;
				var SemanticExpression* value = expression->item(0);
				if (kind == semantic_kind::binary) {
					@target = expression->item(0);
					@value = expression->item(1);
				};
				if (!function_fact_root(target)) {
					@this.scoped_array_write(@summary, target, value, @path);
				}
				else {
					FactWrite write;
					@write.target = target;
					@write.value = @this.expression(@summary, value, @path);
					@path.writes.push_back($write);
				};
			}
			else if (kind != semantic_kind::noop) {
				discard @this.expression(@summary, expression, @path);
			};
		};
		@index = index + 1;
	};
};

fn FunctionFactSummaries::build(var FunctionFactSummaries& this, var Entity& function) {
	rt::unique<FunctionFactSummary> summary = rt::unique<FunctionFactSummary>::make();
	@summary.get()->function = &@function;
	if (function.dispatch() != function_dispatch::ordinary) {
		// A statically selected declaration does not identify a virtual target.
		@summary.get()->opaque = true;
	};
	usize parameter = 0;
	while (parameter < function.parameters().size()) {
		Type* type = function.parameters().data()[parameter]->type();
		// Destruction of value parameters is implicit in the semantic body.
		// Until those cleanup effects are summarized, aggregate parameters
		// cannot be treated as a read-only call merely from their statements.
		if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record || type->kind() == type_kind::array) {
			@summary.get()->opaque = true;
		};
		@parameter = parameter + 1;
	};
	if (!function.body()) {
		@summary.get()->opaque = true;
	}
	else {
		rt::buffer<rt::unique<FunctionFactPath>> paths;
		rt::unique<FunctionFactPath> initial = rt::unique<FunctionFactPath>::make();
		@paths.push_back($initial);
		@this.walk(@*summary.get(), function.body(), @paths);
		usize index = 0;
		while (!summary.get()->opaque && index < paths.size()) {
			FunctionFactPath& path = *paths.data()[index].get();
			if (!(path.returned)) {
				@this.finish(@*summary.get(), nullptr, 0, path);
			};
			@index = index + 1;
		};
		// Without call-site alias partitioning, two reference parameters or a
		// global and a reference may denote the same storage. Do not summarize
		// mutations using independently substituted entry values in that case.
		usize references = 0;
		@index = 0;
		while (index < function.parameters().size()) {
			if (function.parameters().data()[index]->type()->kind() == type_kind::reference) {
				@references = references + 1;
			};
			@index = index + 1;
		};
		bool globals = false;
		@index = 0;
		while (index < summary.get()->expressions.size()) {
			FunctionFactExpression& value = summary.get()->expressions.data()[index];
			if (value.kind == function_fact_kind::entry_place) {
				var Entity* root = function_fact_root(value.place);
				if (root && root->kind() == entity_kind::global) {
					@globals = true;
				};
			};
			@index = index + 1;
		};
		@index = 0;
		while (index < summary.get()->outcomes.size()) {
			FunctionFactOutcome& outcome = summary.get()->outcomes.data()[index];
			usize write = 0;
			while (write < outcome.writes.size()) {
				var Entity* root = function_fact_root(outcome.writes.data()[write].target);
				if (root && root->kind() == entity_kind::global) {
					@globals = true;
				};
				@write = write + 1;
			};
			if (outcome.writes.size() && (references > 1 || references && globals)) {
				@summary.get()->opaque = true;
			};
			@index = index + 1;
		};
	};
	usize existing = 0;
	while (existing < this.summaries.size()) {
		if (this.summaries.data()[existing].get()->function == &@function) {
			@((@this.summaries).data()[existing]) = $summary;
			return;
		};
		@existing = existing + 1;
	};
	@this.summaries.push_back($summary);
};

fn FunctionFactSummaries::validate(var FunctionFactSummaries& this, SemanticUnit& unit) {
	@this.summaries.clear();
	while (true) {
		bool changed = false;
		usize index = 0;
		while (index < unit.entities().size()) {
			var Entity* entity = unit.entities().data()[index].get();
			if (entity->kind() == entity_kind::function) {
				@entity = entity->canonical();
			};
			var FunctionFactSummary* previous = this.find(entity);
			if (entity->kind() == entity_kind::function && (!previous || previous->opaque)) {
				@this.build(@*entity);
				var FunctionFactSummary* resolved = this.find(entity);
				if (resolved && !resolved->opaque) {
					@changed = true;
				};
			};
			@index = index + 1;
		};
		if (!changed) {
			break;
		};
	};
};
