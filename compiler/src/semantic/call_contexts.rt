// Context inputs describe already evaluated scalar arguments. Version numbers
// are caller-local and are translated to fresh formal parameter versions.
struct FactContextInput {
	var Entity* parameter;
	FactValue value;
};

struct FactContextRelation {
	usize left;
	usize right;
	token_kind operation;
};

struct FactContextRequest {
	var SemanticExpression* call;
	var Entity* function;
	rt::buffer<FactContextInput> inputs;
	rt::buffer<FactContextRelation> relations;
};

fn fact_context_condition(FactGraph& graph, SemanticExpression* expression) -> bool {
	usize index = 0;
	while (index < graph.edges.size()) {
		FactEdge& edge = graph.edges.data()[index];
		if (edge.condition == expression && (edge.kind == fact_edge_kind::when_true || edge.kind == fact_edge_kind::when_false)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_context_check_walk(SemanticExpression* expression, usize depth, usize calls, var usize& budget, var rt::buffer<var Entity*>& visited) -> bool {
	if (!expression || depth > 64 || !budget) {
		return false;
	};
	@budget = budget - 1;
	if (expression->kind() == semantic_kind::conditional || expression->kind() == semantic_kind::variant_cast || expression->kind() == semantic_kind::while_loop || expression->kind() == semantic_kind::for_loop) {
		return true;
	};
	var Entity* target = expression->entity();
	if (target && target->kind() == entity_kind::function) {
		@target = target->canonical();
	};
	if (expression->kind() == semantic_kind::call && target && target->dispatch() == function_dispatch::ordinary && target->body() && calls < 8) {
		usize prior = 0;
		while (prior < visited.size() && visited.data()[prior] != target) {
			@prior = prior + 1;
		};
		if (prior == visited.size()) {
			@visited.push_back(target);
			bool found = fact_context_check_walk(target->body(), 0, calls + 1, @budget, @visited);
			@visited.pop_back();
			if (found) {
				return true;
			};
		};
	};
	usize index = 0;
	while (index < expression->size()) {
		if (fact_context_check_walk(expression->item(index), depth + 1, calls, @budget, @visited)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_context_has_check(SemanticExpression* expression, usize depth) -> bool {
	usize budget = 512;
	rt::buffer<var Entity*> visited;
	return fact_context_check_walk(expression, depth, 0, @budget, @visited);
};

fn fact_context_operation(usize index) -> token_kind {
	switch (index) {
		case 0: return token_kind::op_less;
		case 1: return token_kind::op_less_equal;
		case 2: return token_kind::op_greater;
		case 3: return token_kind::op_greater_equal;
		case 4: return token_kind::op_equal;
	};
	return token_kind::op_not_equal;
};

fn fact_context_comparison(token_kind operation, FactValue& left, FactValue& right, FactState& state) -> fact_truth {
	fact_truth result = fact_compare_values(operation, left, right);
	usize index = 0;
	while (result == fact_truth::unknown && left.version && right.version && index < state.relations.size()) {
		FactRelation& relation = state.relations.data()[index];
		if (relation.left == left.version && relation.right == right.version) {
			if (relation.operation == operation) {
				return fact_truth::proven;
			};
			if (relation.operation == fact_inverse(operation)) {
				return fact_truth::disproven;
			};
		};
		@index = index + 1;
	};
	return result;
};

fn InferredFacts::context_seed(var InferredFacts& this, var FactState& state) {
	usize input = 0;
	while (input < this.context_inputs.size()) {
		FactContextInput& seed = this.context_inputs.data()[input];
		usize place = 0;
		while (place < this.places.size()) {
			FactPlace& storage = this.places.data()[place];
			if (!storage.parent && storage.root == seed.parameter) {
				var FactValue& value = @((@state.places).data()[place]);
				@value.range := seed.value.range;
				@value.alternative = seed.value.alternative;
			};
			@place = place + 1;
		};
		@input = input + 1;
	};
	usize index = 0;
	while (index < this.context_relations.size()) {
		FactContextRelation& seed = this.context_relations.data()[index];
		FactRelation relation;
		@relation.operation = seed.operation;
		usize place = 0;
		while (place < this.places.size()) {
			FactPlace& storage = this.places.data()[place];
			if (!storage.parent) {
				if (storage.root == this.context_inputs.data()[seed.left].parameter) {
					@relation.left = state.places.data()[place].version;
				};
				if (storage.root == this.context_inputs.data()[seed.right].parameter) {
					@relation.right = state.places.data()[place].version;
				};
			};
			@place = place + 1;
		};
		if (relation.left) {
			if (relation.right) {
				@state.relations.push_back($relation);
			};
		};
		@index = index + 1;
	};
	return;
};

fn InferredFacts::context_override(var InferredFacts& this, var SemanticExpression& expression, inferred_override_kind kind, u64 value) {
	InferredExpressionFact fact;
	@fact.expression = &@expression;
	@fact.kind = $kind;
	@fact.value = $value;
	@this.context_output->overrides.push_back($fact);
	return;
};

fn InferredFacts::context_capture(var InferredFacts& this, var SemanticExpression& call, FactState& state) {
	var Entity* function = call.entity();
	if (function) {
		@function = function->canonical();
	};
	if (this.context_requests.size() >= 512 || !function || function == this.analyzed_function || function->dispatch() != function_dispatch::ordinary || function->role() != function_role::ordinary || function->definition() != function_definition::user_defined || !function->body() || function->parameters().size() > 16 || call.size() != 2 || call.item(0)->kind() != semantic_kind::name || (!call.item(0)->entity() || call.item(0)->entity()->canonical() != function) || call.item(1)->size() != function->parameters().size() || !fact_context_has_check(function->body(), 0)) {
		return;
	};
	var request = rt::unique<FactContextRequest>::make();
	@request.get()->call = &@call;
	@request.get()->function = function;
	bool useful = false;
	usize parameter = 0;
	while (parameter < function->parameters().size()) {
		var Entity* formal = function->parameters().data()[parameter];
		Type* type = formal->type();
		// Reference-field seeding needs an alias partition. Until then, keep
		// reference-receiver and reference-parameter calls on their original ABI.
		if (type->kind() == type_kind::reference) {
			return;
		};
		if (type->representation()->kind().is_integer() || aggregate_access_kind(type) == 2) {
			FactContextInput input;
			@input.parameter = formal;
			@input.value = state.value(call.item(1)->item(parameter));
			if (input.value.alternative || input.value.range.available != fact_truth::unknown && (input.value.range.lower || input.value.range.upper != fact_limit(type) || input.value.range.sign == integer_range_sign::negative)) {
				@useful = true;
			};
			@request.get()->inputs.push_back($input);
		};
		@parameter = parameter + 1;
	};
	usize left = 0;
	while (left < request.get()->inputs.size()) {
		usize right = 0;
		while (right < request.get()->inputs.size()) {
			if (left != right && request.get()->inputs.data()[left].parameter->type()->representation()->kind().is_integer() && request.get()->inputs.data()[right].parameter->type()->representation()->kind().is_integer()) {
				usize operation = 0;
				while (operation < 6) {
					token_kind predicate = fact_context_operation(operation);
					if (fact_context_comparison(predicate, request.get()->inputs.data()[left].value, request.get()->inputs.data()[right].value, state) == fact_truth::proven) {
						FactContextRelation relation;
						@relation.left = left;
						@relation.right = right;
						@relation.operation = predicate;
						@request.get()->relations.push_back($relation);
						@useful = true;
					};
					@operation = operation + 1;
				};
			};
			@right = right + 1;
		};
		@left = left + 1;
	};
	if (!useful) {
		return;
	};
	@this.context_requests.push_back($request);
	return;
};

fn fact_context_equal(InferredFunctionContext& left, InferredFunctionContext& right) -> bool {
	if (left.function != right.function || left.overrides.size() != right.overrides.size() || left.calls.size() != right.calls.size()) {
		return false;
	};
	usize index = 0;
	while (index < left.overrides.size()) {
		InferredExpressionFact& first = left.overrides.data()[index];
		InferredExpressionFact& second = right.overrides.data()[index];
		if (first.expression != second.expression || first.kind != second.kind || first.value != second.value) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < left.calls.size()) {
		if (left.calls.data()[index].expression != right.calls.data()[index].expression || left.calls.data()[index].context != right.calls.data()[index].context) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

struct FactContextPlanner {
	var InferredFacts* root;
	var InferredContextSet* output;
	rt::buffer<var Entity*> active;
	usize attempts;
	fn plan(var FactContextPlanner& this, FactContextRequest& request, var usize& result) -> CompilationResult;
};

fn FactContextPlanner::plan(var FactContextPlanner& this, FactContextRequest& request, var usize& result) -> CompilationResult {
	@result = 0;
	if (this.attempts >= 512 || this.output->contexts.size() >= 256 || this.active.size() >= 32) {
		return CompilationResult();
	};
	usize index = 0;
	while (index < this.active.size()) {
		if (this.active.data()[index] == request.function) {
			return CompilationResult();
		};
		@index = index + 1;
	};
	usize count = 0;
	@index = 0;
	while (index < this.output->contexts.size()) {
		if (this.output->contexts.data()[index].get()->function == request.function) {
			@count = count + 1;
		};
		@index = index + 1;
	};
	if (count >= 16) {
		return CompilationResult();
	};
	@this.attempts = this.attempts + 1;
	var context = rt::unique<InferredFunctionContext>::make();
	@this.active.push_back(request.function);
	@context.get()->function = request.function;
	var worker = InferredFacts(@*this.root->diagnostics);
	@worker.summary_source = &this.root->summary_cache();
	@worker.analyzed_function = request.function;
	@worker.context_output = context.get();
	@index = 0;
	while (index < request.inputs.size()) {
		@worker.context_inputs.push_back(FactContextInput(request.inputs.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < request.relations.size()) {
		@worker.context_relations.push_back(FactContextRelation(request.relations.data()[index]));
		@index = index + 1;
	};
	if (!(@worker.analyze(request.function->body())).has<void>()) {
		return CompilationResult(compilation_error());
	};
	@index = 0;
	while (index < worker.context_requests.size()) {
		usize nested = 0;
		if (!(@this.plan(*worker.context_requests.data()[index].get(), @nested)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		if (nested) {
			InferredCallBinding binding;
			@binding.expression = worker.context_requests.data()[index].get()->call;
			@binding.context = nested;
			@context.get()->calls.push_back($binding);
		};
		@index = index + 1;
	};
	@this.active.pop_back();
	if (!context.get()->overrides.size() && !context.get()->calls.size()) {
		return CompilationResult();
	};
	@index = 0;
	while (index < this.output->contexts.size()) {
		if (fact_context_equal(*this.output->contexts.data()[index].get(), *context.get())) {
			@result = index + 1;
			return CompilationResult();
		};
		@index = index + 1;
	};
	// Nested planning may have filled the budget while this parent was pending.
	if (this.output->contexts.size() >= 256) {
		return CompilationResult();
	};
	@this.output->contexts.push_back($context);
	@result = this.output->contexts.size();
	return CompilationResult();
};

fn fact_build_contexts(var InferredFacts& root, var InferredContextSet& output) -> CompilationResult {
	@output.calls.clear();
	@output.contexts.clear();
	FactContextPlanner planner;
	@planner.root = &@root;
	@planner.output = &@output;
	usize index = 0;
	while (index < root.context_requests.size()) {
		FactContextRequest& request = *root.context_requests.data()[index].get();
		usize context = 0;
		if (!(@planner.plan(request, @context)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		if (context) {
			InferredCallBinding binding;
			@binding.expression = request.call;
			@binding.context = context;
			@output.calls.push_back($binding);
		};
		@index = index + 1;
	};
	return CompilationResult();
};
