fn TypeStore::register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) -> bool {
	Type* type = @this.primitive($kind, $bits);

	if (!type) {
		return false;
	};

	return @names.insert($name, $type);
};

fn TypeStore::initialize_primitives(var TypeStore& this, u32 pointer_bits) -> bool {
	rt::unordered_map<rt::string_view, Type*> names;

	if (!@names.reserve(20)) {
		return false;
	};

	if (false
		|| !@this.register_primitive(@names, "void", type_kind::void_type, 0)
		|| !@this.register_primitive(@names, "null", type_kind::null_type, 0)
		|| !@this.register_primitive(@names, "bool", type_kind::boolean, 1)
		|| !@this.register_primitive(@names, "char", type_kind::character, 8)
		|| !@this.register_primitive(@names, "usize", type_kind::unsigned_integer, pointer_bits)
		|| !@this.register_primitive(@names, "ptrdiff", type_kind::signed_integer, pointer_bits)
		|| !@this.register_primitive(@names, "i8", type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, "i08", type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, "i16", type_kind::signed_integer, 16)
		|| !@this.register_primitive(@names, "i32", type_kind::signed_integer, 32)
		|| !@this.register_primitive(@names, "i64", type_kind::signed_integer, 64)
		|| !@this.register_primitive(@names, "u8", type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, "u08", type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, "u16", type_kind::unsigned_integer, 16)
		|| !@this.register_primitive(@names, "u32", type_kind::unsigned_integer, 32)
		|| !@this.register_primitive(@names, "u64", type_kind::unsigned_integer, 64)
		|| !@this.register_primitive(@names, "f32", type_kind::floating_point, 32)
		|| !@this.register_primitive(@names, "f64", type_kind::floating_point, 64)
		) {
		return false;
	};

	@this.primitive_names = $names;

	return true;
};

fn TypeStore::find_primitive(TypeStore& this, rt::string_view name) -> Type* {
	var found = this.primitive_names.find(name);

	if (!found) {
		return nullptr;
	};

	return *found;
};
