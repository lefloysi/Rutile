fn TypeStore::primitive_spelling(usize index) -> rt::string_view {
	switch (index) {
		case 0:
			return "void";
		case 1:
			return "null";
		case 2:
			return "bool";
		case 3:
			return "char";
		case 4:
			return "usize";
		case 5:
			return "ptrdiff";
		case 6:
			return "i8";
		case 7:
			return "i08";
		case 8:
			return "i16";
		case 9:
			return "i32";
		case 10:
			return "i64";
		case 11:
			return "u8";
		case 12:
			return "u08";
		case 13:
			return "u16";
		case 14:
			return "u32";
		case 15:
			return "u64";
		case 16:
			return "f32";
		case 17:
			return "f64";
		default:
			return rt::string_view();
	};
};
fn TypeStore::register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) {
	Type* type = @this.primitive($kind, $bits);

	if (!type) {
		compiler_panic("Primitive type construction produced no type.");
	};

	bool inserted = @names.insert($name, $type);
	if (!inserted) {
		compiler_panic("A primitive type name was registered twice.");
	};
};

fn TypeStore::initialize_primitives(var TypeStore& this, u32 pointer_bits) {
	rt::unordered_map<rt::string_view, Type*> names;

	@names.reserve(20);

	@this.register_primitive(@names, primitive_spelling(0), type_kind::void_type, 0);
	@this.register_primitive(@names, primitive_spelling(1), type_kind::null_type, 0);
	@this.register_primitive(@names, primitive_spelling(2), type_kind::boolean, 1);
	@this.register_primitive(@names, primitive_spelling(3), type_kind::character, 8);
	@this.register_primitive(@names, primitive_spelling(4), type_kind::unsigned_integer, pointer_bits);
	@this.register_primitive(@names, primitive_spelling(5), type_kind::signed_integer, pointer_bits);
	@this.register_primitive(@names, primitive_spelling(6), type_kind::signed_integer, 8);
	@this.register_primitive(@names, primitive_spelling(7), type_kind::signed_integer, 8);
	@this.register_primitive(@names, primitive_spelling(8), type_kind::signed_integer, 16);
	@this.register_primitive(@names, primitive_spelling(9), type_kind::signed_integer, 32);
	@this.register_primitive(@names, primitive_spelling(10), type_kind::signed_integer, 64);
	@this.register_primitive(@names, primitive_spelling(11), type_kind::unsigned_integer, 8);
	@this.register_primitive(@names, primitive_spelling(12), type_kind::unsigned_integer, 8);
	@this.register_primitive(@names, primitive_spelling(13), type_kind::unsigned_integer, 16);
	@this.register_primitive(@names, primitive_spelling(14), type_kind::unsigned_integer, 32);
	@this.register_primitive(@names, primitive_spelling(15), type_kind::unsigned_integer, 64);
	@this.register_primitive(@names, primitive_spelling(16), type_kind::floating_point, 32);
	@this.register_primitive(@names, primitive_spelling(17), type_kind::floating_point, 64);

	@this.primitive_names = $names;


};

fn TypeStore::find_primitive(TypeStore& this, rt::string_view name) -> Type* {
	var found = this.primitive_names.find(name);

	if (!found) {
		return nullptr;
	};

	return *found;
};
