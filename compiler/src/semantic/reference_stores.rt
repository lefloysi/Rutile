// Reference-slot identity is distinct from the objects referenced by that slot.
struct ReferenceStoreSlot {
	var Entity* root;
	var Entity* field;
	var SemanticExpression* expression;
};

struct ReferenceStoreBinding {
	var Entity* parameter;
	ReferenceStoreSlot slot;
};

struct ReferenceStoreEffect {
	var SemanticExpression* site;
	ReferenceStoreSlot slot;
	var Entity* field;
	ReferenceLoanPlace referent;
	type_qualifier permission;
	bool definite;
};

fn reference_store_calls(SemanticExpression& expression, rt::buffer<var Entity*>& functions) -> bool {
	if (expression.kind() == semantic_kind::call && expression.entity() && expression.entity()->dispatch() == function_dispatch::ordinary) {
		var Entity* callee = expression.entity();
		if (callee->role() == function_role::assignment && callee->definition() == function_definition::defaulted && expression.item(1)->size() == 2 && reference_loan_members(*expression.item(1)->item(0)->type())) {
			return true;
		};
		usize index = 0;
		while (index < functions.size()) {
			if (functions.data()[index] == callee) {
				return true;
			};
			@index = index + 1;
		};
	};
	usize index = 0;
	while (index < expression.size()) {
		if (reference_store_calls(*expression.item(index), functions)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::prepare_stores(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> bool {
	@this.store_functions.clear();
	while (true) {
		usize previous = this.store_functions.size();
		usize index = 0;
		while (index < unit.entities().size()) {
			var Entity* function = unit.entities().data()[index].get();
			@index = index + 1;
			if (function->kind() != entity_kind::function || !function->body() || function->dispatch() != function_dispatch::ordinary) {
				continue;
			};
			usize existing = 0;
			while (existing < this.store_functions.size() && this.store_functions.data()[existing] != function) {
				@existing = existing + 1;
			};
			if (existing == this.store_functions.size() && reference_store_calls(*function->body(), this.store_functions) && !@this.store_functions.push_back(function)) {
				return @this.error(*function->body(), "reference store call graph storage is unavailable");
			};
		};
		if (previous == this.store_functions.size()) {
			break;
		};
	};
	return true;
};

fn reference_store_contains(SemanticExpression& scope, SemanticExpression& expression) -> bool {
	if (&scope == &expression) {
		return true;
	};
	usize index = 0;
	while (index < scope.size()) {
		if (reference_store_contains(*scope.item(index), expression)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_store_region(var SemanticExpression& expression, Entity& binding, var SemanticExpression* region) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::brace || expression.kind() == semantic_kind::sequence || expression.kind() == semantic_kind::for_loop) {
		@region = &@expression;
	};
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding) {
		return region;
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* found = reference_store_region(@*expression.item(index), binding, region);
		if (found) {
			return found;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn reference_store_same(ReferenceStoreSlot& first, ReferenceStoreSlot& second) -> bool {
	return first.root == second.root && first.field == second.field;
};

fn reference_store_graph_path(FactGraph& graph, usize source, usize target, usize avoid) -> bool {
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	if (!@pending.push_back(source)) {
		return true;
	};
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize node = pending.data()[cursor];
		@cursor = cursor + 1;
		if (node == target) {
			return true;
		};
		bool seen = false;
		usize index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == node) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		if (!@visited.push_back(node)) {
			return true;
		};
		@index = 0;
		while (index < graph.edges.size()) {
			FactEdge& edge = graph.edges.data()[index];
			bool truth = false;
			bool feasible = true;
			if (edge.condition && edge.condition->constant_truth(@truth)) {
				@feasible = !(edge.kind == fact_edge_kind::when_true && !truth || edge.kind == fact_edge_kind::when_false && truth);
			};
			if (node == avoid && edge.kind != fact_edge_kind::exceptional) {
				@feasible = false;
			};
			if (edge.source == node && feasible && !@pending.push_back(usize(edge.target))) {
				return true;
			};
			@index = index + 1;
		};
	};
	return false;
};

fn reference_store_required(Entity& function, SemanticExpression& operation) -> bool {
	if (!function.body()) {
		return false;
	};
	FactGraph graph;
	if (!@graph.build(function.body())) {
		return false;
	};
	usize node = fact_no_node();
	usize index = 0;
	while (index < graph.nodes.size()) {
		if (graph.nodes.data()[index].kind == fact_node_kind::expression && graph.nodes.data()[index].expression == &operation) {
			@node = index;
			break;
		};
		@index = index + 1;
	};
	return node != fact_no_node() && reference_store_graph_path(graph, usize(graph.entry), usize(graph.normal_exit), fact_no_node()) && !reference_store_graph_path(graph, usize(graph.entry), usize(graph.normal_exit), node);
};

fn ReferenceLoanAnalyzer::store_slot(ReferenceLoanAnalyzer& this, var SemanticExpression& expression, rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, usize depth) -> ReferenceStoreSlot {
	ReferenceStoreSlot slot;
	if (depth > 16) {
		return $slot;
	};
	if (expression.kind() == semantic_kind::name && expression.entity()) {
		var Entity* binding = expression.entity();
		usize index = bindings.size();
		while (index) {
			@index = index - 1;
			if (bindings.data()[index].parameter == binding) {
				@slot.root = bindings.data()[index].slot.root;
				@slot.field = bindings.data()[index].slot.field;
				@slot.expression = bindings.data()[index].slot.expression;
				return $slot;
			};
		};
		if (binding->type()->kind() == type_kind::reference && binding->kind() != entity_kind::parameter) {
			var SemanticExpression* source = binding->body();
			if (binding->kind() == entity_kind::local) {
				var SemanticExpression* body = this.function_body;
				if (context) {
					@body = context->body();
				};
				@source = this.initializer(*body, *binding);
			};
			if (source) {
				return this.store_slot(@*source, bindings, context, depth + 1);
			};
			return $slot;
		};
		@slot.root = binding;
		@slot.expression = &@expression;
		return $slot;
	};
	if (expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast || expression.kind() == semantic_kind::relocation) {
		return this.store_slot(@*expression.item(0), bindings, context, depth + 1);
	};
	if (expression.kind() == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		@slot = this.store_slot(@*expression.item(0), bindings, context, depth + 1);
		if (!slot.field) {
			@slot.field = expression.entity();
		};
		@slot.expression = &@expression;
		return $slot;
	};
	if (expression.kind() == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		return this.store_slot(@*expression.item(0), bindings, context, depth + 1);
	};
	return $slot;
};

fn ReferenceLoanAnalyzer::store_walk(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> bool {
	if (depth > 16) {
		return @this.error(expression, "reference store summary exceeds the analysis depth limit");
	};
	if (expression.kind() == semantic_kind::call && expression.entity() && expression.entity()->dispatch() == function_dispatch::ordinary) {
		var Entity* callee = expression.entity();
		var SemanticExpression* arguments = expression.item(1);
		var SemanticExpression* event = site;
		if (!event) {
			@event = &@expression;
		};
		bool required = definite;
		if (context) {
			@required = required && reference_store_required(*context, expression);
		};
		if (callee->role() == function_role::assignment && callee->definition() == function_definition::defaulted && arguments->size() == 2 && reference_loan_members(*arguments->item(0)->type())) {
			var slot = this.store_slot(@*arguments->item(0), bindings, context, 0);
			if (slot.root) {
				rt::buffer<ReferenceLoanPlace> targets;
				if (!@this.places(*arguments->item(1), @targets, @substitutions, context, 0)) {
					return false;
				};
				usize field_index = 0;
				while (field_index < arguments->item(0)->type()->entity()->fields().size()) {
					var Entity* field = arguments->item(0)->type()->entity()->fields().data()[field_index];
					@field_index = field_index + 1;
					if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
						continue;
					};
					usize target = 0;
					while (target < targets.size()) {
						ReferenceStoreEffect effect;
						@effect.site = event;
						@effect.slot.root = slot.root;
						@effect.slot.field = slot.field;
						@effect.slot.expression = slot.expression;
						@effect.field = field;
						@effect.referent.root = targets.data()[target].root;
						@effect.referent.reference_contents = targets.data()[target].reference_contents;
						@effect.referent.field = targets.data()[target].field;
						@effect.referent.through = targets.data()[target].through;
						@effect.referent.element = targets.data()[target].element;
						@effect.permission = reference_loan_permission(*field->type(), 0);
						@effect.definite = required && !fact_cleanup_effects(arguments->item(0)->type(), 0);
						usize existing = 0;
						while (existing < this.stores.size()) {
							ReferenceStoreEffect& previous = this.stores.data()[existing];
							if (previous.site == effect.site && previous.field == effect.field && reference_store_same(previous.slot, effect.slot) && previous.referent.root == effect.referent.root && previous.referent.field == effect.referent.field && previous.referent.element == effect.referent.element) {
								break;
							};
							@existing = existing + 1;
						};
						if (existing == this.stores.size() && !@this.stores.push_back($effect)) {
							return false;
						};
						@target = target + 1;
					};
				};
			};
		}
		else if (callee->body()) {
			usize candidate = 0;
			while (candidate < this.store_functions.size() && this.store_functions.data()[candidate] != callee) {
				@candidate = candidate + 1;
			};
			if (candidate == this.store_functions.size()) {
				usize child = 0;
				while (child < expression.size()) {
					if (!@this.store_walk(@*expression.item(child), @substitutions, @bindings, context, site, definite, depth)) {
						return false;
					};
					@child = child + 1;
				};
				return true;
			};
			usize boundary = substitutions.size();
			usize slot_boundary = bindings.size();
			usize parameter = 0;
			while (parameter < callee->parameters().size() && parameter < arguments->size()) {
				ReferenceLoanSubstitution substitution;
				@substitution.parameter = callee->parameters().data()[parameter];
				ReferenceStoreBinding binding;
				@binding.parameter = substitution.parameter;
				if (substitution.parameter->type()->kind() == type_kind::reference) {
					if (!@this.places(*arguments->item(parameter), @substitution.places, @substitutions, context, 0)) {
						return false;
					};
					@binding.slot = this.store_slot(@*arguments->item(parameter), bindings, context, 0);
				}
				else {
					ReferenceLoanPlace owned;
					@owned.root = substitution.parameter;
					if (!@substitution.places.push_back($owned)) {
						return false;
					};
					@binding.slot.root = substitution.parameter;
				};
				if (!@substitutions.push_back($substitution) || !@bindings.push_back($binding)) {
					return false;
				};
				@parameter = parameter + 1;
			};
			if (!@this.store_walk(@*callee->body(), @substitutions, @bindings, callee, event, required, depth + 1)) {
				return false;
			};
			while (substitutions.size() > boundary) {
				@substitutions.pop_back();
			};
			while (bindings.size() > slot_boundary) {
				@bindings.pop_back();
			};
		};
	};
	usize child = 0;
	while (child < expression.size()) {
		if (!@this.store_walk(@*expression.item(child), @substitutions, @bindings, context, site, definite, depth)) {
			return false;
		};
		@child = child + 1;
	};
	return true;
};

fn ReferenceLoanAnalyzer::retain_stores(var ReferenceLoanAnalyzer& this, var SemanticExpression& body) -> bool {
	usize iteration = 0;
	while (iteration < 16) {
		usize previous = this.stores.size();
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		rt::buffer<ReferenceStoreBinding> bindings;
		if (!@this.store_walk(@body, @substitutions, @bindings, nullptr, nullptr, true, 0)) {
			return @this.error(body, "reference store summary storage is unavailable");
		};
		usize index = previous;
		while (index < this.stores.size()) {
			ReferenceStoreEffect& effect = this.stores.data()[index];
			ReferenceLoan loan;
			@loan.binding = effect.slot.root;
			@loan.stored_field = effect.field;
			if (effect.slot.field) {
				@loan.stored_field = effect.slot.field;
			};
			@loan.creation = this.position(*effect.site);
			@loan.place.root = effect.referent.root;
			@loan.place.reference_contents = effect.referent.reference_contents;
			@loan.place.field = effect.referent.field;
			@loan.place.through = effect.referent.through;
			@loan.place.element = effect.referent.element;
			@loan.permission = effect.permission;
			if (loan.binding && loan.place.root && !@this.loans.push_back($loan)) {
				return @this.error(*effect.site, "reference store loan storage is unavailable");
			};
			@index = index + 1;
		};
		if (previous == this.stores.size()) {
			return true;
		};
		@iteration = iteration + 1;
	};
	return @this.error(body, "reference store analysis did not converge within the analysis limit");
};

fn ReferenceLoanAnalyzer::store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceStoreEffect& effect) -> bool {
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	if (source == fact_no_node() || target == fact_no_node() || !@pending.push_back(source)) {
		return true;
	};
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize node = pending.data()[cursor];
		@cursor = cursor + 1;
		bool killed = false;
		usize index = 0;
		while (node != source && index < this.stores.size()) {
			ReferenceStoreEffect& replacement = this.stores.data()[index];
			if (replacement.definite && replacement.site != effect.site && replacement.slot.root == effect.slot.root && (!replacement.slot.field || replacement.slot.field == effect.slot.field) && this.position(*replacement.site) == node) {
				@killed = true;
				break;
			};
			@index = index + 1;
		};
		if (node != source && this.graph.nodes.data()[node].kind == fact_node_kind::lifetime_end && this.graph.nodes.data()[node].owner == effect.slot.root) {
			continue;
		};
		if (node == target) {
			return true;
		};
		bool seen = false;
		@index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == node) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		if (!@visited.push_back(node)) {
			return true;
		};
		@index = 0;
		while (index < this.graph.edges.size()) {
			FactEdge& edge = this.graph.edges.data()[index];
			bool truth = false;
			bool feasible = true;
			if (edge.condition && edge.condition->constant_truth(@truth)) {
				@feasible = !(edge.kind == fact_edge_kind::when_true && !truth || edge.kind == fact_edge_kind::when_false && truth);
			};
			// A verified replacement kills the old slot value only after normal
			// completion. An exceptional exit may precede the actual store.
			if (killed && edge.kind != fact_edge_kind::exceptional) {
				@feasible = false;
			};
			if (edge.source == node && feasible && !@pending.push_back(usize(edge.target))) {
				return true;
			};
			@index = index + 1;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::validate_stores(var ReferenceLoanAnalyzer& this) -> bool {
	usize index = 0;
	while (index < this.stores.size()) {
		ReferenceStoreEffect& effect = this.stores.data()[index];
		@index = index + 1;
		var Entity* source = effect.referent.root;
		var Entity* destination = effect.slot.root;
		if (effect.referent.reference_contents || !source || !destination || source->kind() == entity_kind::global || source->kind() == entity_kind::parameter && source->type()->kind() == type_kind::reference || source->kind() != entity_kind::local && source->kind() != entity_kind::parameter) {
			continue;
		};
		var SemanticExpression* region = reference_store_region(@*this.function_body, *source, this.function_body);
		if (!region && source->kind() == entity_kind::parameter && source->scope() && source->scope()->owner() && source->scope()->owner()->body() == this.function_body) {
			@region = this.function_body;
		};
		bool external = destination->kind() == entity_kind::global || destination->kind() == entity_kind::parameter && destination->type()->kind() == type_kind::reference;
		usize creation = this.position(*effect.site);
		if (external && (@this.store_path(creation, usize(this.graph.normal_exit), effect) || @this.store_path(creation, usize(this.graph.exceptional_exit), effect))) {
			return @this.error(*effect.site, "stored reference may outlive its referent");
		};
		usize node_index = 0;
		while (node_index < this.graph.nodes.size()) {
			FactNode& node = this.graph.nodes.data()[node_index];
			var SemanticExpression* use = node.expression;
			bool reads = use && use->kind() == semantic_kind::name && use->entity() == destination;
			bool cleanup = node.kind == fact_node_kind::opaque && use && use->kind() == semantic_kind::variable && use->entity() == destination;
			bool outside = !region || use && !reference_store_contains(*region, *use);
			if (cleanup && source->scope() == destination->scope() && destination->token().begin < source->token().begin) {
				@outside = true;
			};
			if (reads && outside) {
				usize replacement_index = 0;
				while (replacement_index < this.stores.size()) {
					ReferenceStoreEffect& replacement = this.stores.data()[replacement_index];
					if (replacement.definite && replacement.site != effect.site && reference_store_same(replacement.slot, effect.slot) && replacement.slot.expression && reference_store_contains(*replacement.slot.expression, *use)) {
						@reads = false;
					};
					@replacement_index = replacement_index + 1;
				};
			};
			if ((reads || cleanup || external && use && use->kind() == semantic_kind::call) && outside && @this.store_path(creation, node_index, effect)) {
				return @this.error(*effect.site, "stored reference may outlive its referent");
			};
			@node_index = node_index + 1;
		};
	};
	return true;
};
