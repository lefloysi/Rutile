// The graph owns no semantic expressions. Its source pointers remain valid for the
// lifetime of the analyzed semantic function.
enum fact_node_kind : [u08] {
	entry;
	expression;
	merge;
	normal_exit;
	exceptional_exit;
	opaque;
	lifetime_begin;
	lifetime_end;
	fallthrough_exit;
};

enum fact_evaluation : [u08] {
	value;
	storage;
};

enum fact_edge_kind : [u08] {
	next;
	when_true;
	when_false;
	exceptional;
	backedge;
};

struct FactNode {
	fact_node_kind kind;
	var SemanticExpression* expression;
	var Entity* owner;
	var SemanticExpression* region;
	fact_evaluation evaluation;
};

struct FactEdge {
	usize source;
	usize target;
	fact_edge_kind kind;
	var SemanticExpression* condition;
};

fn fact_no_node() -> usize {
	return 18446744073709551615;
};

// Subsequent semantic passes may consume generic facts after numeric analysis
// has converged. Numeric worklists must use their own current abstract state.
fn fact_semantic_edge_feasible(FactEdge& edge) -> bool {
	if (!edge.condition || edge.kind != fact_edge_kind::when_true && edge.kind != fact_edge_kind::when_false) {
		return true;
	};
	bool truth = false;
	bool known = edge.condition->constant_truth(@truth);
	if (!known) {
		@known = edge.condition->inferred_condition(@truth);
	};
	if (!known) {
		u64 value = 0;
		if (edge.condition->inferred_integer(@value)) {
			@truth = value != 0;
			@known = true;
		};
	};
	if (!known) {
		return true;
	};
	return (edge.kind == fact_edge_kind::when_true) == truth;
};

fn fact_cleanup_effects(Type* type, usize depth) -> bool {
	if (!type || depth > 32) {
		return true;
	};
	if (type->kind() == type_kind::array) {
		return fact_cleanup_effects(type->element(), depth + 1);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return false;
	};
	var Entity* record = type->entity();
	var Entity* destructor = record->destructor();
	if (destructor && destructor->definition() != function_definition::defaulted) {
		return true;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (fact_cleanup_effects(record->bases().data()[index], depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (fact_cleanup_effects(record->fields().data()[index]->type(), depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_collect_cleanup(var SemanticExpression* expression, var rt::buffer<var SemanticExpression*>& owners) {
	if (!expression) {
		return;
	};
	if (expression->kind() == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference) {
		@owners.push_back(expression);
		return;
	};
	if (expression->kind() == semantic_kind::statements) {
		usize index = 0;
		while (index < expression->size()) {
			fact_collect_cleanup(expression->item(index), @owners);
			@index = index + 1;
		};
	};
	return;
};

fn fact_temporary_source(var SemanticExpression* expression, bool nested) -> var SemanticExpression* {
	if (!expression) {
		return nullptr;
	};
	semantic_kind kind = expression->kind();
	// initialize_value_body constructs a matching consumable initializer
	// directly in owned variable storage. Only its arguments can create
	// full-expression temporaries; the outer object ends at scope cleanup.
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference && expression->size()) {
		var SemanticExpression* initializer = expression->item(0);
		if (initializer->kind() == semantic_kind::construction && initializer->category() == value_category::consumable && expression->entity()->type()->same_shape(*initializer->type())) {
			usize child = 0;
			while (child < initializer->size()) {
				var SemanticExpression* temporary = fact_temporary_source(initializer->item(child), true);
				if (temporary) {
					return temporary;
				};
				@child = child + 1;
			};
			return nullptr;
		};
	};
	if (kind == semantic_kind::conditional || kind == semantic_kind::while_loop || kind == semantic_kind::for_loop || kind == semantic_kind::switch_expression || kind == semantic_kind::exception_try || kind == semantic_kind::sequence || kind == semantic_kind::statements || kind == semantic_kind::return_value || kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow || kind == semantic_kind::brace && !nested) {
		return nullptr;
	};
	if ((kind == semantic_kind::construction || kind == semantic_kind::call) && expression->type()->kind() != type_kind::reference && fact_cleanup_effects(expression->type(), 0)) {
		return expression;
	};
	usize child = 0;
	while (child < expression->size()) {
		var SemanticExpression* source = fact_temporary_source(expression->item(child), true);
		if (source) {
			return source;
		};
		@child = child + 1;
	};
	return nullptr;
};

struct FactGraph {
	rt::buffer<FactNode> nodes;
	rt::buffer<FactEdge> edges;
	usize entry;
	usize normal_exit;
	usize exceptional_exit;
	usize fallthrough_exit;
	usize return_target;

	fn build(var FactGraph& this, var SemanticExpression* body);
	fn build_function(var FactGraph& this, Entity& function);
	fn add_node(var FactGraph& this, fact_node_kind kind, var SemanticExpression* expression, var usize& result);
	fn add_lifetime(var FactGraph& this, fact_node_kind kind, var Entity* owner, var SemanticExpression* expression, var usize& result);
	fn owner_cleanup(var FactGraph& this, var Entity* owner, var SemanticExpression* expression, usize target, usize exception_target, var usize& result);
	fn connect(var FactGraph& this, usize source, usize target, fact_edge_kind kind, var SemanticExpression* condition);
	fn lower(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn lower_contents(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn lower_scope(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn full_expression(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn cleanup_target(var FactGraph& this, var SemanticExpression* handler, usize target, usize exception_target, var usize& result);
};

fn FactGraph::add_node(var FactGraph& this, fact_node_kind kind, var SemanticExpression* expression, var usize& result) {
	@result = this.nodes.size();
	FactNode node;
	@node.kind = $kind;
	@node.expression = $expression;
	@this.nodes.push_back($node);
	return;
};

fn FactGraph::add_lifetime(var FactGraph& this, fact_node_kind kind, var Entity* owner, var SemanticExpression* expression, var usize& result) {
	@this.add_node(kind, expression, @result);
	@(@this.nodes).data()[result].owner = owner;
	return;
};

fn FactGraph::owner_cleanup(var FactGraph& this, var Entity* owner, var SemanticExpression* expression, usize target, usize exception_target, var usize& result) {
	if (target == fact_no_node()) {
		@result = fact_no_node();
		return;
	};
	@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @result);
	@this.connect(result, target, fact_edge_kind::next, nullptr);
	if (!fact_cleanup_effects(owner->type(), 0)) {
		return;
	};
	usize normal = result;
	usize exceptional = 0;
	@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @exceptional);
	@this.connect(exceptional, exception_target, fact_edge_kind::exceptional, nullptr);
	@this.add_node(fact_node_kind::opaque, expression, @result);
	@(@this.nodes).data()[result].owner = owner;
	@this.connect(result, normal, fact_edge_kind::next, nullptr);
	@this.connect(result, exceptional, fact_edge_kind::exceptional, nullptr);
	return;
};

fn FactGraph::connect(var FactGraph& this, usize source, usize target, fact_edge_kind kind, var SemanticExpression* condition) {
	if (source == fact_no_node() || target == fact_no_node()) {
		return;
	};
	FactEdge edge;
	@edge.source = $source;
	@edge.target = $target;
	@edge.kind = $kind;
	// The initial entry is connected before the loop header is annotated.
	// Later header entries include continues from increment expressions and
	// their cleanup chains, and must retain backedge lifetime validation.
	if (edge.kind == fact_edge_kind::next && this.nodes.data()[edge.target].region) {
		@edge.kind = fact_edge_kind::backedge;
	};
	@edge.condition = $condition;
	@this.edges.push_back($edge);
	return;
};

fn FactGraph::build(var FactGraph& this, var SemanticExpression* body) {
	@this.nodes.clear();
	@this.edges.clear();
	@this.add_node(fact_node_kind::entry, nullptr, @this.entry);
	@this.add_node(fact_node_kind::normal_exit, nullptr, @this.normal_exit);
	@this.add_node(fact_node_kind::exceptional_exit, nullptr, @this.exceptional_exit);
	usize current = this.entry;
	@this.return_target = this.normal_exit;
	@this.lower(body, @current, fact_no_node(), fact_no_node(), this.exceptional_exit);
	@this.add_node(fact_node_kind::fallthrough_exit, nullptr, @this.fallthrough_exit);
	@this.connect(current, this.fallthrough_exit, fact_edge_kind::next, nullptr);
	@this.connect(this.fallthrough_exit, this.normal_exit, fact_edge_kind::next, nullptr);
	return;
};

fn FactGraph::build_function(var FactGraph& this, Entity& function) {
	@this.nodes.clear();
	@this.edges.clear();
	@this.add_node(fact_node_kind::entry, nullptr, @this.entry);
	@this.add_node(fact_node_kind::normal_exit, nullptr, @this.normal_exit);
	@this.add_node(fact_node_kind::exceptional_exit, nullptr, @this.exceptional_exit);
	usize normal = this.normal_exit;
	usize exceptional = this.exceptional_exit;
	usize current = this.entry;
	usize index = 0;
	while (index < function.parameters().size()) {
		var Entity* parameter = function.parameters().data()[index];
		@index = index + 1;
		if (parameter->type()->kind() == type_kind::reference) {
			continue;
		};
		usize begin = 0;
		@this.add_lifetime(fact_node_kind::lifetime_begin, parameter, nullptr, @begin);
		@this.connect(current, begin, fact_edge_kind::next, nullptr);
		@current = begin;
		@this.owner_cleanup(parameter, nullptr, normal, exceptional, @normal);
		@this.owner_cleanup(parameter, nullptr, exceptional, exceptional, @exceptional);
	};
	@this.return_target = normal;
	@this.lower(function.body(), @current, fact_no_node(), fact_no_node(), exceptional);
	@this.add_node(fact_node_kind::fallthrough_exit, nullptr, @this.fallthrough_exit);
	@this.connect(current, this.fallthrough_exit, fact_edge_kind::next, nullptr);
	@this.connect(this.fallthrough_exit, normal, fact_edge_kind::next, nullptr);
	return;
};

fn FactGraph::cleanup_target(var FactGraph& this, var SemanticExpression* handler, usize target, usize exception_target, var usize& result) {
	if (target == fact_no_node()) {
		@result = fact_no_node();
		return;
	};
	if (handler && handler->kind() == semantic_kind::variable && handler->entity() && handler->entity()->type()->kind() != type_kind::reference) {
		@this.owner_cleanup(handler->entity(), handler, target, exception_target, @result);
		return;
	};
	@this.add_node(fact_node_kind::opaque, handler, @result);
	@this.connect(result, target, fact_edge_kind::next, nullptr);
	@this.connect(result, exception_target, fact_edge_kind::exceptional, nullptr);
	return;
};

fn FactGraph::lower(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (expression && (expression->kind() == semantic_kind::brace || expression->kind() == semantic_kind::sequence || expression->kind() == semantic_kind::for_loop || expression->kind() == semantic_kind::switch_expression)) {
		@this.lower_scope(expression, @current, break_target, continue_target, exception_target);
		return;
	};
	@this.lower_contents(expression, @current, break_target, continue_target, exception_target);
	return;
};

fn FactGraph::full_expression(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	@this.lower(expression, @current, break_target, continue_target, exception_target);
	var SemanticExpression* source = fact_temporary_source(expression, false);
	if (!source || current == fact_no_node()) {
		return;
	};
	usize cleanup = 0;
	@this.add_node(fact_node_kind::opaque, source, @cleanup);
	@this.connect(current, cleanup, fact_edge_kind::next, nullptr);
	@this.connect(cleanup, exception_target, fact_edge_kind::exceptional, nullptr);
	@current = cleanup;
	return;
};

fn FactGraph::lower_scope(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (!expression || current == fact_no_node()) {
		return;
	};
	rt::buffer<var SemanticExpression*> owners;
	var SemanticExpression* declarations = expression;
	if (expression->kind() == semantic_kind::switch_expression) {
		@declarations = expression->item(1);
	};
	if (expression->kind() == semantic_kind::for_loop) {
		fact_collect_cleanup(expression->item(0), @owners);
	}
	else if (declarations && (declarations->kind() == semantic_kind::brace || declarations->kind() == semantic_kind::sequence || declarations->kind() == semantic_kind::statements)) {
		usize child = 0;
		while (child < declarations->size()) {
			fact_collect_cleanup(declarations->item(child), @owners);
			@child = child + 1;
		};
	}
	else {
		fact_collect_cleanup(declarations, @owners);
	};
	if (!owners.size()) {
		@this.lower_contents(expression, @current, break_target, continue_target, exception_target);
		var SemanticExpression* temporary = fact_temporary_source(expression, false);
		if (!temporary || current == fact_no_node()) {
			return;
		};
		usize cleanup = 0;
		@this.add_node(fact_node_kind::opaque, temporary, @cleanup);
		@this.connect(current, cleanup, fact_edge_kind::next, nullptr);
		@this.connect(cleanup, exception_target, fact_edge_kind::exceptional, nullptr);
		@current = cleanup;
		return;
	};
	usize after = 0;
	@this.add_node(fact_node_kind::merge, nullptr, @after);
	usize normal = after;
	usize leaving = break_target;
	usize continuing = continue_target;
	usize exceptional = exception_target;
	usize saved_return = this.return_target;
	usize owner = 0;
	while (owner < owners.size()) {
		var SemanticExpression* declaration = owners.data()[owner];
		@this.cleanup_target(declaration, normal, exceptional, @normal);
		@this.cleanup_target(declaration, leaving, exceptional, @leaving);
		@this.cleanup_target(declaration, continuing, exceptional, @continuing);
		@this.cleanup_target(declaration, this.return_target, exceptional, @this.return_target);
		@this.cleanup_target(declaration, exceptional, exceptional, @exceptional);
		@owner = owner + 1;
	};
	// Cleanup nodes are may-effects: declarations bypassed by a branch, or
	// already relocated, can add conservative edges but never invent facts.
	@this.lower_contents(expression, @current, leaving, continuing, exceptional);
	@this.return_target = saved_return;
	@this.connect(current, normal, fact_edge_kind::next, nullptr);
	@current = after;
	return;
};

fn FactGraph::lower_contents(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (!expression || current == fact_no_node()) {
		return;
	};
	semantic_kind kind = expression->kind();
	if (kind == semantic_kind::brace || kind == semantic_kind::statements || kind == semantic_kind::sequence) {
		usize child = 0;
		while (child < expression->size()) {
			@this.full_expression(expression->item(child), @current, break_target, continue_target, exception_target);
			@child = child + 1;
		};
		usize container = 0;
		@this.add_node(fact_node_kind::expression, expression, @container);
		@this.connect(current, container, fact_edge_kind::next, nullptr);
		@current = container;
		return;
	};
	if (kind == semantic_kind::conditional || kind == semantic_kind::binary && (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or)) {
		@this.full_expression(expression->item(0), @current, break_target, continue_target, exception_target);
		usize first = 0;
		usize second = 0;
		usize merge = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @first);
		@this.add_node(fact_node_kind::merge, nullptr, @second);
		@this.add_node(fact_node_kind::merge, nullptr, @merge);
		@this.connect(current, first, fact_edge_kind::when_true, expression->item(0));
		@this.connect(current, second, fact_edge_kind::when_false, expression->item(0));
		if (kind == semantic_kind::conditional || expression->operation() == token_kind::op_and) {
			@this.lower_scope(expression->item(1), @first, break_target, continue_target, exception_target);
		};
		if (kind == semantic_kind::conditional) {
			@this.lower_scope(expression->item(2), @second, break_target, continue_target, exception_target);
		}
		else if (expression->operation() == token_kind::op_or) {
			@this.full_expression(expression->item(1), @second, break_target, continue_target, exception_target);
		};
		@this.connect(first, merge, fact_edge_kind::next, nullptr);
		@this.connect(second, merge, fact_edge_kind::next, nullptr);
		@current = merge;
		return;
	};
	if (kind == semantic_kind::while_loop || kind == semantic_kind::for_loop) {
		bool is_for = kind == semantic_kind::for_loop;
		if (is_for) {
			@this.full_expression(expression->item(0), @current, break_target, continue_target, exception_target);
		};
		usize header = 0;
		usize body = 0;
		usize step = 0;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @header);
		@this.add_node(fact_node_kind::merge, nullptr, @body);
		@this.add_node(fact_node_kind::merge, nullptr, @step);
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		@this.connect(current, header, fact_edge_kind::next, nullptr);
		@(@this.nodes).data()[header].region = expression;
		usize test_index = 0;
		usize body_index = 1;
		if (is_for) {
			@test_index = 1;
			@body_index = 3;
		};
		var SemanticExpression* test = expression->item(test_index);
		@current = header;
		@this.full_expression(test, @current, break_target, continue_target, exception_target);
		@this.connect(current, body, fact_edge_kind::when_true, test);
		if (is_for) {
			if (test->kind() != semantic_kind::noop) {
				@this.connect(current, after, fact_edge_kind::when_false, test);
			};
		}
		else {
			@this.connect(current, after, fact_edge_kind::when_false, test);
		};
		@current = body;
		@this.lower_scope(expression->item(body_index), @current, after, step, exception_target);
		@this.connect(current, step, fact_edge_kind::next, nullptr);
		@current = step;
		if (is_for) {
			@this.full_expression(expression->item(2), @current, after, header, exception_target);
		};
		@this.connect(current, header, fact_edge_kind::backedge, nullptr);
		@current = after;
		return;
	};
	if (kind == semantic_kind::exception_try) {
		usize dispatch = 0;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @dispatch);
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		@this.lower_scope(expression->item(0), @current, break_target, continue_target, dispatch);
		@this.connect(current, after, fact_edge_kind::next, nullptr);
		usize catch_all = fact_no_node();
		usize handler_index = 1;
		while (handler_index < expression->size()) {
			var SemanticExpression* handler = expression->item(handler_index);
			usize handler_entry = 0;
			@this.add_node(fact_node_kind::expression, handler, @handler_entry);
			@this.connect(dispatch, handler_entry, fact_edge_kind::next, nullptr);
			if (handler->type()->kind() == type_kind::void_type) {
				@catch_all = handler_index;
			};
			@current = handler_entry;
			Type* caught = handler->type();
			if (caught->kind() == type_kind::reference) {
				@caught = caught->element();
			};
			bool cleanup = caught->kind() == type_kind::void_type || caught->kind() == type_kind::named && caught->entity()->kind() == entity_kind::record;
			usize handler_break = break_target;
			usize handler_continue = continue_target;
			usize saved_return = this.return_target;
			usize handler_after = after;
			if (cleanup) {
				@this.cleanup_target(handler, after, exception_target, @handler_after);
				@this.cleanup_target(handler, break_target, exception_target, @handler_break);
				@this.cleanup_target(handler, continue_target, exception_target, @handler_continue);
				@this.cleanup_target(handler, saved_return, exception_target, @this.return_target);
			};
			// A handler's own exceptions belong to the enclosing try, never
			// to another handler of the same dispatch.
			@this.lower_scope(handler->item(0), @current, handler_break, handler_continue, exception_target);
			@this.return_target = saved_return;
			// Catch completion can destroy an exception object. Without its
			// dynamic type, a catch-all or record catch has opaque cleanup.
			@this.connect(current, handler_after, fact_edge_kind::next, nullptr);
			@handler_index = handler_index + 1;
		};
		if (catch_all == fact_no_node()) {
			@this.connect(dispatch, exception_target, fact_edge_kind::exceptional, nullptr);
		};
		@current = after;
		return;
	};
	if (kind == semantic_kind::switch_expression) {
		var SemanticExpression* selector = expression->item(0);
		var SemanticExpression* body = expression->item(1);
		@this.full_expression(selector, @current, break_target, continue_target, exception_target);
		if (!body || body->kind() != semantic_kind::brace) {
			return;
		};
		usize dispatch = current;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		rt::buffer<usize> labels;
		usize fallback = fact_no_node();
		usize selected = fact_no_node();
		u64 selector_value = 0;
		bool known = selector->constant_integer(@selector_value);
		usize item = 0;
		while (item < body->size()) {
			var SemanticExpression* source = body->item(item);
			usize label = fact_no_node();
			if (source->kind() == semantic_kind::case_label) {
				@this.add_node(fact_node_kind::merge, source, @label);
				if (source->token().kind == token_kind::kw_default) {
					@fallback = label;
				}
				else if (known && source->integer() == selector_value) {
					@selected = label;
				};
				if (!known) {
					@this.connect(dispatch, label, fact_edge_kind::next, nullptr);
				};
			};
			@labels.push_back($label);
			@item = item + 1;
		};
		if (known) {
			if (selected == fact_no_node()) {
				@selected = fallback;
			};
			if (selected == fact_no_node()) {
				@selected = after;
			};
			@this.connect(dispatch, selected, fact_edge_kind::next, nullptr);
		}
		else if (fallback == fact_no_node()) {
			@this.connect(dispatch, after, fact_edge_kind::next, nullptr);
		};
		@current = fact_no_node();
		@item = 0;
		while (item < body->size()) {
			if (body->item(item)->kind() == semantic_kind::case_label) {
				usize label = labels.data()[item];
				@this.connect(current, label, fact_edge_kind::next, nullptr);
				@current = label;
			}
			else {
				@this.full_expression(body->item(item), @current, after, continue_target, exception_target);
			};
			@item = item + 1;
		};
		@this.connect(current, after, fact_edge_kind::next, nullptr);
		@current = after;
		return;
	};
	usize index = 0;
	usize children = expression->size();
	// Cast fallback children describe exceptional dispatch alternatives; they
	// are not evaluations on the continuing path through the selected payload.
	if (kind == semantic_kind::variant_cast && children) {
		@children = 1;
	};
	while (index < children) {
		usize child = index;
		// Primitive assignment evaluates its value before computing the destination.
		if (kind == semantic_kind::binary && children == 2 && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
			@child = 1 - index;
		};
		// Indexed addresses evaluate the subscript before the base. Placement
		// construction computes its destination before constructor arguments.
		if (children == 2 && (kind == semantic_kind::index || kind == semantic_kind::construction)) {
			@child = 1 - index;
		};
		usize begin = this.nodes.size();
		@this.lower(expression->item(child), @current, break_target, continue_target, exception_target);
		if (kind == semantic_kind::construction && children > 1 && child == 1) {
			var Entity* owner = expression->item(child)->owned_binding();
			while (begin < this.nodes.size()) {
				var FactNode& lowered = @(@this.nodes).data()[begin];
				if (owner && lowered.kind == fact_node_kind::expression && lowered.expression && lowered.expression->kind() == semantic_kind::name && lowered.expression->entity() == owner) {
					@lowered.evaluation = fact_evaluation::storage;
				};
				@begin = begin + 1;
			};
		};
		@index = index + 1;
	};
	usize node = 0;
	@this.add_node(fact_node_kind::expression, expression, @node);
	@this.connect(current, node, fact_edge_kind::next, nullptr);
	@current = node;
	if (kind == semantic_kind::call || kind == semantic_kind::construction || kind == semantic_kind::allocation || kind == semantic_kind::destruction || kind == semantic_kind::variant_cast) {
		usize exceptional = exception_target;
		var Entity* ending = nullptr;
		if (kind == semantic_kind::destruction && expression->size()) {
			@ending = expression->item(0)->owned_binding();
		};
		if (ending) {
			@this.add_lifetime(fact_node_kind::lifetime_end, ending, expression, @exceptional);
			@this.connect(exceptional, exception_target, fact_edge_kind::exceptional, nullptr);
		};
		@this.connect(node, exceptional, fact_edge_kind::exceptional, nullptr);
	};
	var Entity* owner = nullptr;
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference) {
		@owner = expression->entity();
	}
	else if (kind == semantic_kind::construction && expression->size() > 1) {
		@owner = expression->item(1)->owned_binding();
	};
	if (owner) {
		usize begin = 0;
		@this.add_lifetime(fact_node_kind::lifetime_begin, owner, expression, @begin);
		@this.connect(current, begin, fact_edge_kind::next, nullptr);
		@current = begin;
	};
	if ((kind == semantic_kind::relocation || kind == semantic_kind::destruction) && expression->size()) {
		@owner = expression->item(0)->owned_binding();
		if (owner) {
			usize end = 0;
			@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @end);
			@this.connect(current, end, fact_edge_kind::next, nullptr);
			@current = end;
		};
	};
	usize target = fact_no_node();
	if (kind == semantic_kind::return_value) {
		@target = this.return_target;
		var SemanticExpression* temporary = fact_temporary_source(expression->item(0), true);
		if (temporary) {
			@this.cleanup_target(temporary, target, exception_target, @target);
		};
	}
	else if (kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow) {
		@this.connect(node, exception_target, fact_edge_kind::exceptional, nullptr);
		@current = fact_no_node();
		return;
	}
	else if (kind == semantic_kind::break_loop) {
		@target = break_target;
	}
	else if (kind == semantic_kind::continue_loop) {
		@target = continue_target;
	};
	if (target != fact_no_node()) {
		@this.connect(node, target, fact_edge_kind::next, nullptr);
		@current = fact_no_node();
	};
	return;
};
