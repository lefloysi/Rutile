fn Analyzer::configure_variant_default(var Analyzer& this, var Entity& record) -> CompilationResult {
	if (!variant_instance(record)) {
		return CompilationResult();
	};
	TemplateInstantiation* instance = record.template_arguments();
	if (instance->arguments.size() != 1 || !instance->arguments.data()[0].pack) {
		return CompilationResult(compilation_error());
	};
	var TemplatePack* elements = instance->arguments.data()[0].pack;
	configure_variant_copy(@record);
	bool available = elements->elements.size() && variant_default_constructible(elements->elements.data()[0].type);
	usize index = 0;
	while (index < record.members()->bindings().size()) {
		var Entity* member = record.members()->bindings().data()[index];
		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->parameters().size() == 1 && !available) {
			@member->set_definition(function_definition::deleted);
		};
		@index = index + 1;
	};
	if (!available) {
		return CompilationResult();
	};
	var Entity* constructor = @this.supply_special(&@record, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);
	if (!constructor) {
		return CompilationResult(compilation_error());
	};
	@constructor->set_definition(function_definition::defaulted);
	@record.set_default_constructor(constructor);
	var Entity* tag = record.find_member("_index");
	if (!tag || !(@this.resolve(tag)).has<void>()) {
		return CompilationResult(compilation_error());
	};
	Token location = tag->token();
	var initializer = SemanticExpression::make(semantic_kind::literal_integer, tag->type(), location);
	if (!initializer.get()) {
		return CompilationResult(compilation_error());
	};
	@initializer.get()->set_integer(1);
	@tag->set_body($initializer);
	@tag->set_body_state(entity_state::ready);
	return CompilationResult();
};
