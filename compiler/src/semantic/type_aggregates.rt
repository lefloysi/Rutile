fn materialize_tuple(var Analyzer& analyzer, var Entity& record, TemplatePack& elements) -> bool {
	usize index = 0;
	while (index < elements.elements.size()) {
		TemplateArgument& element = elements.elements.data()[index];
		if (element.kind != template_argument_kind::type || !element.type) {
			@analyzer.error(record.declaration(), "aggregate storage requires type arguments");
			return false;
		};
		if (element.type->kind() == type_kind::null_type && record.layout() == record_layout::overlapping) {
			@index = index + 1;
			continue;
		};
		if (element.type->kind() == type_kind::void_type || element.type->kind() == type_kind::null_type || element.type->kind() == type_kind::function) {
			@analyzer.error(record.declaration(), "aggregate element requires object storage or a reference");
			return false;
		};
		Type* storage_type = element.type;
		while (storage_type->kind() == type_kind::array) {
			@storage_type = storage_type->element();
		};
		if (storage_type->kind() == type_kind::named && storage_type->entity()->kind() == entity_kind::record && (storage_type->entity()->state() == entity_state::resolving || !storage_type->has_layout())) {
			@analyzer.error(record.declaration(), "aggregate element requires a complete nonrecursive storage type");
			return false;
		};

		var name = DiagnosticMessage();
		@name.text("_element");
		@name.number(u64(index));
		Token location = record.token();
		var Entity* field = @analyzer.semantic_unit()->create_entity(entity_kind::field, location, nullptr, record.members());
		if (!field || !@field->set_name(name.view())) {
			@analyzer.error(record.declaration(), "cannot materialize aggregate element storage");
			return false;
		};

		@field->set_origin(declaration_origin::compiler_supplied);
		@field->set_access(access_kind::private_access);
		@field->set_type(element.type);
		@field->set_index(record.fields().size());
		@field->set_integer(u64(index));
		@field->set_state(entity_state::ready);
		@field->set_body_state(entity_state::ready);
		if (!@record.add_field(field)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn materialize_variant(var Analyzer& analyzer, var Entity& record, TemplatePack& elements) -> bool {
	var Entity* storage = record.find_member("Storage");
	if (!storage || storage->kind() != entity_kind::record || storage->layout() != record_layout::overlapping || !storage->members()) {
		@analyzer.error(record.declaration(), "variant requires a nested storage union");
		return false;
	};
	return materialize_tuple(@analyzer, @*storage, elements);
};

fn Analyzer::configure_variant_default(var Analyzer& this, var Entity& record) -> bool {
	if (!variant_instance(record)) {
		return true;
	};
	TemplateInstantiation* instance = record.template_arguments();
	if (instance->arguments.size() != 1 || !instance->arguments.data()[0].pack) {
		return false;
	};
	var TemplatePack* elements = instance->arguments.data()[0].pack;
	configure_variant_copy(@record);
	bool available = elements->elements.size() && variant_default_constructible(elements->elements.data()[0].type);
	usize index = 0;
	while (index < record.members()->bindings().size()) {
		var Entity* member = record.members()->bindings().data()[index];
		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->parameters().size() == 1 && !available) {
			@member->set_definition(function_definition::deleted);
		};
		@index = index + 1;
	};
	if (!available) {
		return true;
	};
	var Entity* constructor = @this.supply_special(&@record, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);
	if (!constructor) {
		return false;
	};
	@constructor->set_definition(function_definition::defaulted);
	@record.set_default_constructor(constructor);
	var Entity* tag = record.find_member("_index");
	if (!tag || !@this.resolve(tag)) {
		return false;
	};
	Token location = tag->token();
	var initializer = rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::literal_integer, tag->type(), location));
	if (!initializer.get()) {
		return false;
	};
	@initializer.get()->set_integer(1);
	@tag->set_body($initializer);
	@tag->set_body_state(entity_state::ready);
	return true;
};
