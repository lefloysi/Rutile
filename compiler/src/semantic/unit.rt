struct AssociatedScope {
	const Type* type;
	Entity* owner;
};

struct SemanticUnit {
	fn associate(SemanticUnit& this, const Type& type, Entity& owner) -> bool;
	fn canonical_use(SemanticUnit& this, const Type& type) -> const TypeUse*;
	fn retype_use(SemanticUnit& this, const TypeUse& source, const Type& type) -> const TypeUse*;
	fn describe_type(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, const Type& type) -> const TypeUse*;
	fn describe_entity(SemanticUnit& this, Analyzer& analyzer, Entity& entity) -> bool;
	fn describe_expression(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, SemanticExpression& expression) -> bool;
	fn leaf_use(SemanticUnit& this, const Type& type) -> const TypeUse*;
	fn indirect_use(SemanticUnit& this, const Type& type, const TypeUse& element) -> const TypeUse*;
	fn function_use(SemanticUnit& this, const Type& type, rt::buffer<ParameterUse> parameters, const TypeUse& result) -> const TypeUse*;
	fn create_scope(SemanticUnit& this, Scope* parent, Entity* owner) -> Scope*;
	fn create_entity(SemanticUnit& this, entity_kind kind, const Token& token, Syntax* syntax, Scope* scope) -> Entity*;

	fn associated_owner(const SemanticUnit& this, const Type& type) -> Entity*;
	fn entities(const SemanticUnit& this) -> const rt::buffer<rt::unique<Entity>>&;
	fn root_scope(const SemanticUnit& this) -> Scope*;

private:
	fn retain_use(SemanticUnit& this, rt::unique<TypeUse> use) -> const TypeUse*;

	fn available_use(const SemanticUnit& this, const SemanticExpression& expression) -> const TypeUse*;

	rt::buffer<AssociatedScope> associated_scopes;
	rt::buffer<rt::unique<TypeUse>> type_uses;
	rt::buffer<rt::unique<FunctionUse>> function_uses;
	Scope* global_scope;
	rt::buffer<rt::unique<Scope>> scopes;
	rt::buffer<rt::unique<Entity>> declarations;
};

fn SemanticUnit::entities(const SemanticUnit& this) -> const rt::buffer<rt::unique<Entity>>& {
	return this.declarations;
};

fn SemanticUnit::root_scope(const SemanticUnit& this) -> Scope* {
	return this.global_scope;
};

fn SemanticUnit::create_scope(SemanticUnit& this, Scope* parent, Entity* owner) -> Scope* {
	var owned = rt::unique<Scope>(new Scope($parent, $owner));
	Scope* result = owned.get();

	if (!result) {
		return nullptr;
	};

	if (!@this.scopes.push_back($owned)) {
		return nullptr;
	};

	if (!this.global_scope) {
		@this.global_scope := result;
	};

	return $result;
};

fn SemanticUnit::create_entity(SemanticUnit& this, entity_kind kind, const Token& token, Syntax* syntax, Scope* scope) -> Entity* {
	var owned = rt::unique<Entity>(new Entity($kind, token, $syntax, scope));
	Entity* result = owned.get();

	if (!result) {
		return nullptr;
	};

	@result->set_access(scope->access());

	if (scope->owner() && scope->owner()->instantiated()) {
		@result->set_instantiated();
	};

	if (!@this.declarations.push_back($owned)) {
		return nullptr;
	};

	if (!@scope->define(Entity*(result))) {
		return nullptr;
	};

	return $result;
};
