struct Scope {
	fn Scope(var Scope& this, var Scope* parent, var Entity* owner);

	fn set_access(var Scope& this, access_kind access);
	fn define(var Scope& this, var Entity* entity);

	fn parent(Scope& this) -> var Scope*;
	fn owner(Scope& this) -> var Entity*;
	fn bindings(Scope& this) -> rt::buffer<var Entity*>&;
	fn access(Scope& this) -> access_kind;
	fn local(Scope& this, rt::string_view name) -> var Entity*;
	fn local_declaration(Scope& this, rt::string_view name, SourceFile* source, entity_kind category) -> var Entity*;
	fn local_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity*;
	fn lookup_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity*;
	fn lookup(Scope& this, rt::string_view name) -> var Entity*;

private:
	var Scope* enclosing;
	var Entity* declaration_owner;
	access_kind visibility;
	rt::buffer<var Entity*> names;
};

fn Scope::Scope(var Scope& this, var Scope* parent, var Entity* owner) {
	@this.enclosing = $parent;
	@this.declaration_owner = $owner;
};

fn Scope::parent(Scope& this) -> var Scope* {
	return this.enclosing;
};

fn Scope::owner(Scope& this) -> var Entity* {
	return this.declaration_owner;
};

fn Scope::bindings(Scope& this) -> rt::buffer<var Entity*>& {
	return this.names;
};

fn Scope::access(Scope& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Scope::set_access(var Scope& this, access_kind access) {
	@this.visibility = $access;
};

fn Scope::local(Scope& this, rt::string_view name) -> var Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity := this.names.data()[index];

		if (entity->name() == name) {
			return $entity;
		};
	};

	return nullptr;
};

fn same_source_module(SourceFile* first, SourceFile* second) -> bool {
	if (!first || !second) {
		return first == second;
	};
	return first->module_name() == second->module_name();
};

fn Scope::local_declaration(Scope& this, rt::string_view name, SourceFile* source, entity_kind category) -> var Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity = this.names.data()[index];
		if (entity->name() == name && (same_source_module(entity->token().source, source) || category == entity_kind::namespace_body && entity->kind() == entity_kind::namespace_body)) {
			return entity;
		};
	};
	return nullptr;
};

fn Scope::local_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity* {
	var Entity* result = nullptr;
	i32 best = 0;
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity = this.names.data()[index];
		if (entity->name() != name) {
			continue;
		};
		i32 rank = 1;
		if (entity->module_exported() || entity->token().source && entity->token().source->test_access()) {
			@rank = 2;
		};
		if (same_source_module(entity->token().source, source)) {
			@rank = 3;
		};
		if (rank > best) {
			@result = entity;
			@best = rank;
			@ambiguous = false;
		}
		else if (rank == best && rank >= 2 && !same_source_module(entity->token().source, result->token().source) && entity->canonical() != result->canonical()) {
			@ambiguous = true;
		};
	};
	return result;
};

fn Scope::lookup_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};
	var Entity* result = this.local_from(name, source, @ambiguous);
	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};
	if (result || !this.enclosing) {
		return result;
	};
	return this.enclosing->lookup_from(name, source, @ambiguous);
};

fn Scope::lookup(Scope& this, rt::string_view name) -> var Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};

	var Entity* result = this.local(name);

	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};

	if (result || !this.enclosing) {
		return $result;
	};

	return this.enclosing->lookup(name);
};

fn Scope::define(var Scope& this, var Entity* entity) {
	@this.names.push_back($entity);
	return;
};
