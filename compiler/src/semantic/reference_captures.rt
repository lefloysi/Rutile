// Capture summaries grow monotonically over the finite set of formal references.
// Recursion without a path to an opaque capture contributes no captures.
struct ReferenceCapture {
	bool contents;
	var Entity* function;
	var Entity* parameter;
};

fn reference_capture_initializer(SemanticExpression& expression, Entity& binding) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding && expression.size()) {
		return expression.item(0);
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* result = reference_capture_initializer(*expression.item(index), binding);
		if (result) {
			return result;
		};
		@index = index + 1;
	};
	return nullptr;
};

// Trace reference-producing syntax without recursively expanding callees. Alias
// cycles terminate on binding identity; call summaries themselves use a fixed point.
fn reference_capture_depends(SemanticExpression& expression, Entity& binding, ReferenceLoanAnalyzer& analyzer, Entity& function, var rt::buffer<var Entity*>& visited) -> bool {
	if (expression.kind() == semantic_kind::dereference) {
		return false;
	};
	if (expression.kind() == semantic_kind::name) {
		var Entity* name = expression.entity();
		if (name == &binding) {
			return true;
		};
		if (!name || name->kind() != entity_kind::local || !(name->type()->kind() == type_kind::reference || reference_loan_members(*name->type()))) {
			return false;
		};
		usize index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == name) {
				return false;
			};
			@index = index + 1;
		};
		@visited.push_back(name);
		var SemanticExpression* source = reference_capture_initializer(*function.body(), *name);
		return source && reference_capture_depends(*source, binding, analyzer, function, @visited);
	};
	if (expression.kind() == semantic_kind::member || expression.kind() == semantic_kind::index) {
		if (expression.size() && expression.item(0)->type()->kind() == type_kind::pointer) {
			return false;
		};
		return expression.size() && reference_capture_depends(*expression.item(0), binding, analyzer, function, @visited);
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_capture_depends(*expression.item(child), binding, analyzer, function, @visited)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_capture_aggregate(Type* type) -> bool {
	if (type->kind() == type_kind::reference) {
		@type = type->element();
	};
	return reference_loan_members(*type);
};

fn ReferenceLoanAnalyzer::captures(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument) -> bool {
	return this.capture_mode(call, argument, false) || this.capture_mode(call, argument, true);
};

fn ReferenceLoanAnalyzer::capture_mode(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool {
	if (this.capture_parent) {
		return this.capture_parent->capture_mode(call, argument, contents);
	};
	var Entity* callee = call.entity();
	if (callee) {
		@callee = callee->canonical();
	};
	// The generated testing helper invokes its callback synchronously. For a known
	// callback, propagate that function's capture effects rather than the opaque
	// callback parameter's conservative generic effects.
	if (callee && callee->token().source && callee->token().source->compiler_generated() && callee->token().is("register") && argument >= 2 && call.item(1)->size() > 1) {
		var Entity* callback = reference_dispatch_callable(*call.item(1)->item(1), this.function_body, 0);
		if (callback && callback->dispatch() == function_dispatch::ordinary && callback->body() && argument - 2 < callback->parameters().size()) {
			usize index = 0;
			while (index < this.captures_summary.size()) {
				ReferenceCapture& capture = this.captures_summary.data()[index];
				if (capture.function == callback && capture.parameter == callback->parameters().data()[argument - 2] && capture.contents == contents) {
					return true;
				};
				@index = index + 1;
			};
			return false;
		};
	};
	if (!callee || callee->dispatch() != function_dispatch::ordinary || !callee->body() && callee->definition() != function_definition::defaulted) {
		Type* signature = call.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function || argument >= signature->signature().parameters().size()) {
			return true;
		};
		Type* parameter = signature->signature().parameters().data()[argument];
		if (contents) {
			return reference_capture_aggregate(parameter);
		};
		return parameter->kind() == type_kind::reference;
	};
	if (callee->definition() == function_definition::defaulted) {
		return false;
	};

	if (argument >= callee->parameters().size()) {
		return true;
	};
	usize index = 0;
	while (index < this.captures_summary.size()) {
		ReferenceCapture& capture = this.captures_summary.data()[index];
		if (capture.function == callee && capture.parameter == callee->parameters().data()[argument] && capture.contents == contents) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::capture_walk(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var Entity& function) -> CompilationResult {
	var ReferenceLoanAnalyzer* summary = &@this;
	if (this.capture_parent) {
		@summary = this.capture_parent;
	};
	if (expression.kind() == semantic_kind::call && expression.size() >= 2 && (!this.capture_parent || @this.reachable(this.graph.entry, this.position(expression), fact_no_node(), nullptr))) {
		Type* signature = expression.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() == type_kind::function) {
			usize argument = 0;
			while (argument < expression.item(1)->size() && argument < signature->signature().parameters().size()) {
				Type* parameter = signature->signature().parameters().data()[argument];
				if ((parameter->kind() == type_kind::reference || reference_loan_members(*parameter)) && this.captures(expression, argument)) {
					usize mode = 0;
					while (mode < 2) {
						bool contents = mode == 1;
						@mode = mode + 1;
						if (!this.capture_mode(expression, argument, contents)) {
							continue;
						};
						rt::buffer<ReferenceLoanPlace> roots;
						rt::buffer<ReferenceLoanSubstitution> substitutions;
						if (!(@this.places(*expression.item(1)->item(argument), @roots, @substitutions, &@function, 0)).has<void>()) {
							return compilation_error();
						};
						usize formal = 0;
						while (formal < function.parameters().size()) {
							var Entity* binding = function.parameters().data()[formal];
							@formal = formal + 1;
							if (!(binding->type()->kind() == type_kind::reference || reference_loan_members(*binding->type()))) {
								continue;
							};
							rt::buffer<var Entity*> aliases;
							bool captured_contents = contents && reference_capture_aggregate(binding->type());
							bool captured = reference_capture_depends(*expression.item(1)->item(argument), *binding, this, function, @aliases);
							usize root = 0;
							while (root < roots.size()) {
								if (roots.data()[root].root == binding) {
									@captured = true;
									if (roots.data()[root].reference_contents && (contents || !reference_capture_aggregate(expression.item(1)->item(argument)->type()))) {
										@captured_contents = true;
									};
								};
								@root = root + 1;
							};
							if (!captured) {
								continue;
							};
							usize existing = 0;
							while (existing < summary->captures_summary.size()) {
								ReferenceCapture& previous = summary->captures_summary.data()[existing];
								if (previous.function == &function && previous.parameter == binding && previous.contents == captured_contents) {
									break;
								};
								@existing = existing + 1;
							};
							if (existing == summary->captures_summary.size()) {
								ReferenceCapture capture;
								@capture.function = &@function;
								@capture.parameter = binding;
								@capture.contents = captured_contents;
								@summary->captures_summary.push_back($capture);
							};
						};
					};
				};
				@argument = argument + 1;
			};
		};
	};
	usize child = 0;
	while (child < expression.size()) {
		if (!(@this.capture_walk(*expression.item(child), @function)).has<void>()) {
			return compilation_error();
		};
		@child = child + 1;
	};
};

struct ReferenceCaptureContext {
	var Entity* function;
	rt::unique<ReferenceLoanAnalyzer> analyzer;
	usize base_loans;
};

fn ReferenceLoanAnalyzer::prepare_captures(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	@this.capture_resolution = entity_state::resolving;
	@this.captures_summary.clear();
	rt::buffer<ReferenceCaptureContext> contexts;
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;
		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};
		ReferenceCaptureContext context;
		@context.function = function;
		@context.analyzer = rt::unique<ReferenceLoanAnalyzer>(new ReferenceLoanAnalyzer(@*this.diagnostics));
		if (!context.analyzer.get()) {
			throw rt::allocation_error();
		};
		var ReferenceLoanAnalyzer& state = @*context.analyzer.get();
		@state.capture_parent = &@this;
		@state.function_body = function->body();
		@state.return_type = function->type()->signature().result();
		@state.phase = reference_loan_phase::collect;
		usize store_function = 0;
		while (store_function < this.store_functions.size()) {
			@state.store_functions.push_back(this.store_functions.data()[store_function]);
			@store_function = store_function + 1;
		};
		@state.build_graph(*function);
		@state.collect(function->body());
		usize parameter = 0;
		while (parameter < function->parameters().size()) {
			var Entity* formal = function->parameters().data()[parameter];
			@parameter = parameter + 1;
			Type* contents_type = formal->type();
			if (contents_type->kind() == type_kind::reference) {
				@contents_type = contents_type->element();
			};
			if (function->role() == function_role::constructor && parameter == 1 || !reference_loan_members(*contents_type)) {
				continue;
			};
			rt::buffer<ReferenceContentRoot> roots;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			ReferenceSlotPath holding;
			if (!(@state.content_sources(*contents_type, nullptr, @roots, @substitutions, function, holding, formal, 0)).has<void>()) {
				return compilation_error();
			};
			usize root = 0;
			while (root < roots.size()) {
				ReferenceContentRoot& source = roots.data()[root];
				ReferenceLoan loan;
				@loan.binding = formal;
				@loan.stored_field = source.field;
				reference_slot_copy(source.holding, @loan.holding);
				@loan.creation = state.graph.entry;
				@loan.place.root = formal;
				@loan.place.reference_contents = true;
				@loan.permission = source.permission;
				@state.loans.push_back($loan);
				@root = root + 1;
			};
		};
		if (!(@state.walk(function->body(), reference_loan_access::read)).has<void>() || !(@state.retain_stores(@*function->body())).has<void>() || !(@state.refresh_array_aliases()).has<void>()) {
			return compilation_error();
		};
		@context.base_loans = state.loans.size();
		@contexts.push_back($context);
	};
	while (true) {
		usize previous = this.captures_summary.size();
		@index = 0;
		while (index < contexts.size()) {
			ReferenceCaptureContext& context = contexts.data()[index];
			var ReferenceLoanAnalyzer& state = @*context.analyzer.get();
			while (state.loans.size() > context.base_loans) {
				@state.loans.pop_back();
			};
			if (!(@state.capture_walk(*context.function->body(), @*context.function)).has<void>() || !(@state.retain_special_escapes()).has<void>()) {
				return compilation_error();
			};
			usize loan_index = context.base_loans;
			while (loan_index < state.loans.size()) {
				ReferenceLoan& loan = state.loans.data()[loan_index];
				@loan_index = loan_index + 1;
				if (!loan.escapes.size() || !loan.place.root || !@state.reachable(state.graph.entry, usize(loan.creation), fact_no_node(), nullptr)) {
					continue;
				};
				usize formal = 0;
				while (formal < context.function->parameters().size()) {
					var Entity* parameter = context.function->parameters().data()[formal];
					@formal = formal + 1;
					if (loan.place.root != parameter) {
						continue;
					};
					usize existing = 0;
					while (existing < this.captures_summary.size()) {
						ReferenceCapture& capture = this.captures_summary.data()[existing];
						if (capture.function == context.function && capture.parameter == parameter && capture.contents == loan.place.reference_contents) {
							break;
						};
						@existing = existing + 1;
					};
					if (existing == this.captures_summary.size()) {
						ReferenceCapture capture;
						@capture.function = context.function;
						@capture.parameter = parameter;
						@capture.contents = loan.place.reference_contents;
						@this.captures_summary.push_back($capture);
					};
				};
			};
			@index = index + 1;
		};
		if (previous == this.captures_summary.size()) {
			@this.capture_resolution = entity_state::ready;
			return;
		};
	};
};
