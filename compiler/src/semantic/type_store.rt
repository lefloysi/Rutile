struct TypeEntry {
	Type value;
	var TypeEntry* next;
};

struct TypeStore {
	fn TypeStore(var TypeStore& this) : [default];
	fn TypeStore(var TypeStore& this, TypeStore& other) : [delete];
	fn TypeStore(var TypeStore& this, TypeStore other) : [default];

	fn operator=(var TypeStore& this, TypeStore& other) -> var TypeStore& : [delete];
	fn operator=(var TypeStore& this, TypeStore other) -> var TypeStore& : [default];
	fn primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type*;
	fn initialize_primitives(var TypeStore& this, u32 pointer_bits) -> bool;
	fn primitive_spelling(usize index) -> rt::string_view;
	fn named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type*;
	fn pointer(var TypeStore& this, Type* element) -> Type*;
	fn reference(var TypeStore& this, Type* element) -> Type*;
	fn array(var TypeStore& this, Type* element, u64 count) -> Type*;
	fn function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type*;
	fn qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type*;
	fn clear(var TypeStore& this);

	fn find_primitive(TypeStore& this, rt::string_view name) -> Type*;

private:
	fn register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) -> bool;
	fn intern(var TypeStore& this, Type key) -> Type*;
	fn rehash(var TypeStore& this, usize count) -> bool;

	fn find(TypeStore& this, Type& key) -> Type*;

	rt::buffer<rt::unique<FunctionSignature>> signatures;
	rt::buffer<rt::unique<TypeEntry>> entries;
	rt::buffer<var TypeEntry*> buckets;
	rt::unordered_map<rt::string_view, Type*> primitive_names;
};

fn TypeStore::find(TypeStore& this, Type& key) -> Type* {
	if (!this.buckets.size()) {
		return nullptr;
	};

	var TypeEntry* entry := this.buckets.data()[key.hash() % this.buckets.size()];

	while (entry) {
		if (entry->value.equals(key)) {
			return &@entry->value;
		};

		@entry := entry->next;
	};

	return nullptr;
};

fn TypeStore::rehash(var TypeStore& this, usize count) -> bool {
	rt::buffer<var TypeEntry*> replacement;

	if (!@replacement.reserve(usize(count))) {
		return false;
	};

	usize index = 0;
	while (index < count) {
		if (!@replacement.push_back(nullptr)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;
	var TypeEntry var** buckets = (@replacement).data();

	while (index < this.entries.size()) {
		var TypeEntry* entry = this.entries.data()[index].get();
		usize bucket = entry->value.hash() % count;
		@entry->next := buckets[bucket];
		@buckets[bucket] := entry;
		@index = index + 1;
	};

	@this.buckets = $replacement;

	return true;
};

fn TypeStore::intern(var TypeStore& this, Type key) -> Type* {
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!this.buckets.size()) {
		if (!@this.rehash(64)) {
			return nullptr;
		};
	}
	else if (this.entries.size() >= this.buckets.size()) {
		if (this.buckets.size() > usize::max / 2 || !@this.rehash(this.buckets.size() * 2)) {
			return nullptr;
		};
	};

	var owner = rt::unique<TypeEntry>::make();

	if (!owner.get()) {
		return nullptr;
	};

	var TypeEntry* entry = owner.get();
	@entry->value = $key;

	if (!@this.entries.push_back($owner)) {
		return nullptr;
	};

	usize bucket = entry->value.hash() % this.buckets.size();
	var TypeEntry var** buckets = (@this.buckets).data();
	@entry->next := buckets[bucket];
	@buckets[bucket] := entry;

	return &@entry->value;
};

fn TypeStore::primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type* {
	TypeShape shape;
	@shape.bits = $bits;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type* {
	TypeShape shape;
	@shape.entity = $entity;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::pointer(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::pointer, $shape));
};

fn TypeStore::reference(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::reference, $shape));
};

fn TypeStore::array(var TypeStore& this, Type* element, u64 count) -> Type* {
	TypeShape shape;
	@shape.array.element = $element;
	@shape.array.count = $count;

	return @this.intern(Type(type_kind::array, $shape));
};

fn TypeStore::function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type* {
	var signature = rt::unique<FunctionSignature>(new var FunctionSignature($result, $parameters, $arity));

	if (!signature.get()) {
		return nullptr;
	};

	TypeShape shape;
	@shape.signature = signature.get();
	var key = Type(type_kind::function, $shape);
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!@this.signatures.push_back($signature)) {
		return nullptr;
	};

	return @this.intern($key);
};

fn TypeStore::qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type* {
	return @this.intern(type.qualified($qualifier));
};

fn TypeStore::clear(var TypeStore& this) {
	@this.primitive_names.clear();
	@this.buckets.clear();
	@this.entries.clear();
	@this.signatures.clear();
};
