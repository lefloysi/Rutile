enum reference_initialization_kind : [u08] {
	initialize;
	copy;
	relocate;
};

// Special members have implicit receivers rather than ordinary call arguments.
fn ReferenceLoanAnalyzer::retain_effect_capture(var ReferenceLoanAnalyzer& this, var Entity& function, var Entity* owner, var SemanticExpression* arguments, usize position, SemanticExpression& location) -> bool {
	var Entity* implementation = function.canonical();
	if (implementation != &function) {
		return @this.retain_effect_capture(@*implementation, owner, arguments, position, location);
	};
	usize index = 0;
	bool opaque = function.definition() != function_definition::defaulted && (!function.body() || function.dispatch() != function_dispatch::ordinary);
	usize count = this.captures_summary.size();
	if (opaque) {
		@count = count + function.parameters().size() * 2;
	};
	while (index < count) {
		ReferenceCapture capture;
		if (index < this.captures_summary.size()) {
			ReferenceCapture& known = this.captures_summary.data()[index];
			@capture.function = known.function;
			@capture.parameter = known.parameter;
			@capture.contents = known.contents;
		}
		else {
			usize offset = index - this.captures_summary.size();
			@capture.function = &@function;
			@capture.parameter = function.parameters().data()[offset / 2];
			@capture.contents = offset % 2 == 1;
			if (capture.contents && !reference_capture_aggregate(capture.parameter->type()) || !capture.contents && capture.parameter->type()->kind() != type_kind::reference) {
				@index = index + 1;
				continue;
			};
		};
		@index = index + 1;
		if (capture.function != &function) {
			continue;
		};
		if (owner && position != fact_no_node() && this.graph.nodes.data()[position].kind == fact_node_kind::opaque && !@this.owner_live_at(owner, position)) {
			continue;
		};

		usize parameter = 0;
		while (parameter < function.parameters().size() && function.parameters().data()[parameter] != capture.parameter) {
			@parameter = parameter + 1;
		};
		rt::buffer<ReferenceLoanPlace> targets;
		if (parameter == 0 && owner) {
			if (capture.contents) {
				usize loan_index = 0;
				while (loan_index < this.loans.size()) {
					ReferenceLoan& loan = this.loans.data()[loan_index];
					if (loan.binding == owner && loan.stored_field) {
						ReferenceLoanPlace target;
						@target.root = loan.place.root;
						@target.reference_contents = loan.place.reference_contents;
						@target.field = loan.place.field;
						@target.element = loan.place.element;
						if (!@targets.push_back($target)) {
							return false;
						};
					};
					@loan_index = loan_index + 1;
				};
			}
			else {
				if (function.role() == function_role::constructor && (owner->kind() == entity_kind::local || owner->kind() == entity_kind::parameter)) {
					@this.error(location, "constructor reference capture may outlive local storage");
					if (opaque) {
						@this.diagnostics->note(function.token(), "constructor body is unavailable to reference analysis");
					}
					else {
						@this.diagnostics->note(function.token(), "constructor receiver may escape through this function");
					};
					return false;
				};
				ReferenceLoanPlace target;
				@target.root = owner;
				if (!@targets.push_back($target)) {
					return false;
				};
			};
		}
		else if (parameter && arguments && parameter - 1 < arguments->size()) {
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!@this.places(*arguments->item(parameter - 1), @targets, @substitutions, nullptr, 0)) {
				return false;
			};
		};
		usize candidate = 0;
		while (candidate < targets.size()) {
			ReferenceLoanPlace& target = targets.data()[candidate];
			ReferenceLoan escaped;
			@escaped.creation = position;
			@escaped.place.root = target.root;
			@escaped.place.reference_contents = target.reference_contents;
			@escaped.place.field = target.field;
			@escaped.place.element = target.element;
			@escaped.permission = reference_loan_permission(*capture.parameter->type(), 0);
			if (!@escaped.escapes.push_back(usize(position)) || !@this.loans.push_back($escaped)) {
				return @this.error(location, "special member capture storage is unavailable");
			};
			@candidate = candidate + 1;
		};
	};
	return true;
};

fn ReferenceLoanAnalyzer::retain_special_escapes(var ReferenceLoanAnalyzer& this) -> bool {
	usize index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* expression = this.expressions.data()[index];
		@index = index + 1;
		var SemanticExpression* construction = expression;
		var Entity* owner = nullptr;
		if (expression->kind() == semantic_kind::variable && expression->size()) {
			@construction = expression->item(0);
			@owner = expression->entity();
		}
		else if (expression->kind() == semantic_kind::construction && expression->size() > 1) {
			@owner = expression->item(1)->owned_binding();
		};
		if (owner && construction->kind() == semantic_kind::construction && construction->entity() && !@this.retain_effect_capture(@*construction->entity(), owner, construction->item(0), this.position(*construction), *expression)) {
			return false;
		};
		if (owner && construction->kind() == semantic_kind::construction && !@this.retain_constructor_captures(owner->type(), owner, this.position(*construction), *expression, 0, reference_initialization_kind::initialize, construction)) {
			return false;
		};

	};
	@index = 0;
	while (index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::opaque && node.owner) {
			var SemanticExpression* location = node.expression;
			if (!location) {
				@location = this.function_body;
			};
			if (!@this.retain_destructor_captures(node.owner->type(), node.owner, index, *location, 0)) {
				return false;
			};
		};
		@index = index + 1;
	};
	return true;
};

fn ReferenceLoanAnalyzer::retain_destructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth) -> bool {
	if (depth > 32) {
		return @this.error(location, "special member capture analysis limit exceeded");
	};
	if (type->kind() == type_kind::reference) {
		return true;
	};
	if (type->kind() == type_kind::array) {
		return @this.retain_destructor_captures(type->element(), owner, position, location, depth + 1);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* record = type->entity();
	if (record->destructor() && !@this.retain_effect_capture(@*record->destructor(), owner, nullptr, position, location)) {
		return false;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!@this.retain_destructor_captures(record->bases().data()[index], owner, position, location, depth + 1)) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (!@this.retain_destructor_captures(record->fields().data()[index]->type(), owner, position, location, depth + 1)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};


// Follow the same selected initialization path as backend initialize_members and
// copy_members. Generated relocation transfers representation without invoking
// member constructors; a custom constructor initializes its members normally.
fn ReferenceLoanAnalyzer::retain_constructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth, reference_initialization_kind mode, var SemanticExpression* initialization) -> bool {
	if (depth > 32) {
		return @this.error(location, "special member capture analysis limit exceeded");
	};
	if (type->kind() == type_kind::reference) {
		return true;
	};
	if (initialization && initialization->kind() == semantic_kind::construction) {
		var Entity* selected = initialization->entity();
		if (selected) {
			@selected = selected->canonical();
		};
		if (selected) {
			@mode = reference_initialization_kind::initialize;
			if (selected->definition() == function_definition::defaulted && selected->parameters().size() == 2) {
				@mode = reference_initialization_kind::relocate;
				if (selected->parameters().data()[1]->type()->kind() == type_kind::reference) {
					@mode = reference_initialization_kind::copy;
				};
			};
		}
		else if (initialization->size() && initialization->item(0)->size() == 1 && initialization->item(0)->item(0)->type()->same_shape(*type)) {
			@mode = reference_initialization_kind::relocate;
			if (initialization->item(0)->item(0)->category() == value_category::place) {
				@mode = reference_initialization_kind::copy;
			};
		};
	};
	if (mode == reference_initialization_kind::relocate) {
		return true;
	};
	if (type->kind() == type_kind::array) {
		return @this.retain_constructor_captures(type->element(), owner, position, location, depth + 1, mode, nullptr);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record || type->entity()->layout() == record_layout::overlapping) {
		return true;
	};
	var Entity* record = type->entity();
	usize member = 0;
	while (member < record->bases().size() + record->fields().size()) {
		Type* child = nullptr;
		var SemanticExpression* value = nullptr;
		if (member < record->bases().size()) {
			@child = record->bases().data()[member];
		}
		else {
			var Entity* field = record->fields().data()[member - record->bases().size()];
			@child = field->type();
			if (mode == reference_initialization_kind::initialize) {
				@value = field->body();
			};
		};
		if (mode == reference_initialization_kind::initialize && initialization && !initialization->entity() && initialization->kind() == semantic_kind::construction && initialization->size() && member < initialization->item(0)->size()) {
			@value = initialization->item(0)->item(member);
		};
		@member = member + 1;
		Type* element = child;
		while (element->kind() == type_kind::array) {
			@element = element->element();
		};
		if (element->kind() == type_kind::reference) {
			continue;
		};
		reference_initialization_kind child_mode = mode;
		if (element->kind() == type_kind::named && element->entity()->kind() == entity_kind::record) {
			var Entity* constructor = element->entity()->default_constructor();
			var SemanticExpression* arguments = nullptr;
			if (mode == reference_initialization_kind::copy) {
				@constructor = element->entity()->copy_constructor();
			}
			else if (value) {
				@constructor = nullptr;
				if (value->kind() == semantic_kind::construction) {
					@constructor = value->entity();
					@arguments = value->item(0);
				}
				else {
					@constructor = element->entity()->move_constructor();
					@child_mode = reference_initialization_kind::relocate;
				};
			};
			if (constructor) {
				@constructor = constructor->canonical();
			};
			if (constructor && constructor->definition() != function_definition::defaulted && constructor->definition() != function_definition::deleted) {
				if (!constructor->body() && !arguments && constructor->parameters().size() > 1) {
					return @this.error(location, "implicit constructor capture provenance is unavailable");
				};
				usize capture_index = 0;
				while (!arguments && capture_index < this.captures_summary.size()) {
					ReferenceCapture& capture = this.captures_summary.data()[capture_index];
					if (capture.function == constructor && constructor->parameters().size() && capture.parameter != constructor->parameters().data()[0]) {
						return @this.error(location, "implicit constructor capture provenance is unavailable");
					};
					@capture_index = capture_index + 1;
				};
				if (!@this.retain_effect_capture(@*constructor, owner, arguments, position, location)) {
					return false;
				};
				@child_mode = reference_initialization_kind::initialize;
				@value = nullptr;
			};
		};
		if (!@this.retain_constructor_captures(child, owner, position, location, depth + 1, child_mode, value)) {
			return false;
		};
	};
	return true;
};
