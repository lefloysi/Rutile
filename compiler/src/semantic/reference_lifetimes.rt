// Lifetime state follows the same exceptional and cleanup edges as loan uses.
struct ReferenceLifetimeVisit {
	usize node;
	bool live;
};

fn ReferenceLoanAnalyzer::owner_live_at(var ReferenceLoanAnalyzer& this, var Entity* owner, usize target) -> bool {
	rt::buffer<ReferenceLifetimeVisit> pending;
	rt::buffer<ReferenceLifetimeVisit> visited;
	ReferenceLifetimeVisit initial;
	@initial.node = this.graph.entry;
	@pending.push_back($initial);
	usize cursor = 0;
	while (cursor < pending.size()) {
		ReferenceLifetimeVisit state = pending.data()[cursor];
		@cursor = cursor + 1;
		if (state.node == target && state.live) {
			return true;
		};
		bool seen = false;
		usize index = 0;
		while (index < visited.size()) {
			ReferenceLifetimeVisit& previous = visited.data()[index];
			if (previous.node == state.node && previous.live == state.live) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		@visited.push_back(ReferenceLifetimeVisit(state));
		FactNode& node = this.graph.nodes.data()[state.node];
		if (node.owner == owner) {
			if (node.kind == fact_node_kind::lifetime_begin) {
				@state.live = true;
			};
			if (node.kind == fact_node_kind::lifetime_end) {
				@state.live = false;
			};
		};
		@index = 0;
		while (index < this.graph.edges.size()) {
			FactEdge& edge = this.graph.edges.data()[index];
			bool feasible = fact_semantic_edge_feasible(edge);
			if (edge.source == state.node && feasible) {
				ReferenceLifetimeVisit next;
				@next.node = edge.target;
				@next.live = state.live;
				@pending.push_back($next);
			};
			@index = index + 1;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::loan_store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceLoan& loan, usize definition) -> bool {
	if (!loan.stored_field || definition == fact_no_node()) {
		return true;
	};
	ReferenceStoreEffect effect;
	@effect.site = this.graph.nodes.data()[definition].expression;
	@effect.slot.root = loan.binding;
	reference_slot_copy(loan.holding, @effect.slot.path);
	if (!effect.slot.path.size && loan.stored_field) {
		if (!reference_slot_field(@effect.slot.path, loan.stored_field).has<void>()) {
			return true;
		};
	};
	return @this.store_path(source, target, effect);
};

fn ReferenceLoanAnalyzer::validate_ends(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::lifetime_end && node.owner) {
			usize loan_index = 0;
			while (loan_index < this.loans.size()) {
				ReferenceLoan& loan = this.loans.data()[loan_index];
				if (!loan.place.reference_contents && loan.place.root == node.owner && @this.active_at(loan, index) && @this.owner_live_at(node.owner, index)) {
					var SemanticExpression* location = node.expression;
					if (!location) {
						@location = this.function_body;
					};
					return @this.error(*location, "object lifetime ends while a dependent reference loan is active");
				};
				@loan_index = loan_index + 1;
			};
		};
		@index = index + 1;
	};
	return CompilationResult();
};
