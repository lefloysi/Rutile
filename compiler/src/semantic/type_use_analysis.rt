fn SemanticUnit::canonical_use(SemanticUnit& this, const Type& type) -> const TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		const TypeUse* element = @this.canonical_use(*type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function) {
		return @this.leaf_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		const TypeUse* element = @this.canonical_use(*type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.canonical_use(*type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::retype_use(SemanticUnit& this, const TypeUse& source, const Type& type) -> const TypeUse* {
	if (&source.type() == &type) {
		return &source;
	};

	if (source.type().kind() != type.kind()) {
		return @this.canonical_use(type);
	};

	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		const TypeUse* element = @this.retype_use(source.element(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function || source.callable().parameters().size() != type.signature().parameters().size()) {
		return @this.canonical_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		const ParameterUse& previous = source.callable().parameters().data()[index];
		const TypeUse* element = @this.retype_use(previous.type(), *type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(previous.name()), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.retype_use(source.callable().result(), *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_type(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, const Type& type) -> const TypeUse* {
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_name || kind == syntax_kind::type_const || kind == syntax_kind::type_auto) {
		return @this.describe_type(@analyzer, @scope, *syntax.designated_type(), type);
	};

	if ((kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array) && (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array)) {
		const TypeUse* element = @this.describe_type(@analyzer, @scope, *syntax.designated_type(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Entity* entity = @analyzer.lookup(@scope, @*(const_cast<Syntax*>(&syntax)));

		if (entity && entity->type_use().has_value()) {
			return @this.retype_use(entity->type_use().value(), type);
		};
	};

	if ((kind != syntax_kind::type_function && kind != syntax_kind::function) || type.kind() != type_kind::function) {
		return @this.canonical_use(type);
	};

	Syntax* inputs = syntax.function_type_parameters();
	Syntax* output = syntax.function_type_result();

	if (kind == syntax_kind::function) {
		@inputs = syntax.function_parameters();
		@output = syntax.function_result();
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		Syntax* parameter = inputs->item(index);
		const TypeUse* element = @this.describe_type(@analyzer, @scope, *parameter->parameter_type(), *type.signature().parameters().data()[index]);

		if (!element) {
			return nullptr;
		};

		rt::optional<ParameterLabel> name;

		if (parameter->parameter_name()->kind() != syntax_kind::absent) {
			Token location = parameter->parameter_name()->token();
			@name = rt::optional<ParameterLabel>(ParameterLabel(location, location.text()));
		};

		if (!@parameters.push_back(ParameterUse($name, *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.describe_type(@analyzer, @scope, *output, *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_entity(SemanticUnit& this, Analyzer& analyzer, Entity& entity) -> bool {
	if (!entity.type() || entity.type_use().has_value() || entity.kind() == entity_kind::template_pattern) {
		return true;
	};

	Syntax* source = entity.declaration();
	const TypeUse* use = nullptr;

	if (entity.kind() == entity_kind::function) {
		rt::buffer<ParameterUse> parameters;
		usize index = 0;
		while (index < entity.parameters().size()) {
			Entity* parameter = entity.parameters().data()[index];

			if (!@this.describe_entity(@analyzer, @*parameter) || !parameter->type_use().has_value()) {
				return false;
			};

			rt::optional<ParameterLabel> name;

			if (!parameter->name().empty()) {
				@name = rt::optional<ParameterLabel>(ParameterLabel(parameter->token(), parameter->name()));
			};

			if (!@parameters.push_back(ParameterUse($name, parameter->type_use().value()))) {
				return false;
			};

			@index = index + 1;
		};

		const TypeUse* result = nullptr;

		if (source && source->kind() == syntax_kind::function) {
			@result = @this.describe_type(@analyzer, @*entity.resolution_scope(), *source->function_result(), *entity.type()->signature().result());
		}
		else {
			@result = @this.canonical_use(*entity.type()->signature().result());
		};

		if (!result) {
			return false;
		};

		@use = @this.function_use(*entity.type(), $parameters, *result);
	}
	else if (!source) {
		@use = @this.canonical_use(*entity.type());
	}
	else {
		if (entity.kind() == entity_kind::alias) {
			@source = source->alias_type();
		}
		else if (entity.kind() == entity_kind::local || entity.kind() == entity_kind::global || entity.kind() == entity_kind::field) {
			@source = source->variable_type();
		}
		else if (entity.kind() == entity_kind::parameter) {
			@source = source->parameter_type();
		};

		@use = @this.describe_type(@analyzer, @*entity.resolution_scope(), *source, *entity.type());
	};

	if (!use) {
		return false;
	};

	@entity.set_type_use(*use);

	return true;
};

fn SemanticUnit::available_use(const SemanticUnit& this, const SemanticExpression& expression) -> const TypeUse* {
	if (expression.type_use().has_value()) {
		return expression.type_use().get();
	};

	Entity* binding = expression.entity();

	if (binding && binding->type_use().has_value()) {
		return &binding->type_use().value().effective();
	};

	return nullptr;
};

fn SemanticUnit::describe_expression(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, SemanticExpression& expression) -> bool {
	if (expression.type_use().has_value()) {
		return true;
	};

	semantic_kind kind = expression.kind();

	if (kind == semantic_kind::variable) {
		Entity* entity = expression.entity();
		const TypeUse* use = nullptr;
		Syntax* declaration = entity->declaration();

		if (declaration->kind() == syntax_kind::variable && declaration->variable_type()->kind() != syntax_kind::absent) {
			@use = @this.describe_type(@analyzer, @scope, *declaration->variable_type(), *entity->type());
		}
		else {
			@use = this.available_use(*expression.item(0));
		};

		if (use) {
			@entity->set_type_use(*use);
		};

		return true;
	};

	if (expression.type()->kind() == type_kind::void_type) {
		return true;
	};

	const TypeUse* use = this.available_use(expression);

	if (kind == semantic_kind::address) {
		const TypeUse* child = this.available_use(*expression.item(0));

		if (child) {
			@use = @this.indirect_use(*expression.type(), *child);
		};
	}
	else if (kind == semantic_kind::access || kind == semantic_kind::relocation || kind == semantic_kind::cast) {
		@use = this.available_use(*expression.item(0));

		if (syntax.kind() == syntax_kind::cast) {
			const Type* target = @analyzer.type(@scope, @*syntax.cast_type());

			if (!target) {
				return false;
			};

			@use = @this.describe_type(@analyzer, @scope, *syntax.cast_type(), *target);

			if (use) {
				@use = &use->effective();
			};
		};
	}
	else if (kind == semantic_kind::dereference || kind == semantic_kind::index) {
		const TypeUse* child = this.available_use(*expression.item(0));

		if (child && (child->type().kind() == type_kind::pointer || child->type().kind() == type_kind::array)) {
			@use = &child->element().effective();
		};
	}
	else if (kind == semantic_kind::binary) {
		if (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy || expression.type()->kind() == type_kind::pointer) {
			@use = this.available_use(*expression.item(0));

			if (!use || use->type().kind() != expression.type()->kind()) {
				@use = this.available_use(*expression.item(1));
			};
		};
	}
	else if (kind == semantic_kind::sequence && expression.size()) {
		@use = this.available_use(*expression.item(expression.size() - 1));
	}
	else if (kind == semantic_kind::call) {
		const TypeUse* callable = this.available_use(*expression.item(0));

		if (callable && callable->type().kind() == type_kind::pointer) {
			@callable = &callable->element();
		};

		if (callable && callable->type().kind() == type_kind::function) {
			@use = &callable->callable().result().effective();
		};
	};

	if (use) {
		@use = @this.retype_use(*use, *expression.type());
	}
	else {
		@use = @this.canonical_use(*expression.type());
	};

	if (!use) {
		return false;
	};

	@expression.set_type_use(*use);

	return true;
};

fn Analyzer::resolve(Analyzer& this, Entity* entity) -> bool {
	if (!@this.resolve_impl(entity)) {
		return false;
	};

	return @this.unit->describe_entity(@this, @*entity);
};

fn Analyzer::expression(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var result = @this.expression_impl(@scope, @syntax, expected);

	if (!result.get()) {
		return $result;
	};

	if (!@this.unit->describe_expression(@this, @scope, syntax, @*result.get())) {
		@this.error(&syntax, "could not describe the expression's type use\0");

		return rt::unique<SemanticExpression>();
	};

	return $result;
};
