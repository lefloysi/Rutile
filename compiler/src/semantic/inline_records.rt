fn SemanticUnit::inline_record(SemanticUnit& this, Syntax& syntax, Scope& scope) -> var Entity* {
	usize index = 0;
	while (index < this.inline_records.size()) {
		InlineRecord& record = this.inline_records.data()[index];
		if (record.syntax == &@syntax && record.scope == &@scope) {
			return record.entity;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn SemanticUnit::retain_inline_record(var SemanticUnit& this, var Syntax& syntax, var Scope& scope, var Entity& entity) -> bool {
	InlineRecord record;
	@record.syntax = &@syntax;
	@record.scope = &@scope;
	@record.entity = &@entity;
	return @this.inline_records.push_back($record);
};

fn Analyzer::inline_record_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type* {
	var Entity* record = this.unit->inline_record(syntax, scope);
	if (record) {
		if (!@this.resolve(record)) {
			return nullptr;
		};
		return record->type();
	};
	var Syntax* name = syntax.record_name();
	if (name->kind() != syntax_kind::absent) {
		if (name->kind() != syntax_kind::name) {
			@this.error(name, "inline record requires an unqualified name");
			return nullptr;
		};
		if (!@this.collect(@scope, @syntax)) {
			return nullptr;
		};
		@record = scope.local(name->token().text());
	}
	else {
		if (syntax.record_members()->kind() == syntax_kind::noop) {
			@this.error(&@syntax, "anonymous record type requires a definition");
			return nullptr;
		};
		var identity = DiagnosticMessage();
		@identity.text("inline-record[");
		@identity.number(u64(this.unit->entities().size()));
		@identity.text("]");
		@record = @this.unit->create_entity(entity_kind::record, syntax.token(), &@syntax, &@scope);
		if (!record || !@record->set_name(identity.view())) {
			@this.error(&@syntax, "cannot store anonymous record identity");
			return nullptr;
		};
		@record->set_origin(declaration_origin::compiler_supplied);
		var Scope* members = @this.unit->create_scope(&@scope, record);
		if (!members) {
			@this.error(&@syntax, "cannot store anonymous record scope");
			return nullptr;
		};
		@record->set_members(members);
	};
	if (!record || !@this.unit->retain_inline_record(@syntax, @scope, @*record)) {
		@this.error(&@syntax, "cannot store inline record identity");
		return nullptr;
	};
	if (name->kind() == syntax_kind::absent && !@this.collect(@*record->members(), @*syntax.record_members())) {
		return nullptr;
	};
	if (!@this.resolve(record)) {
		return nullptr;
	};
	return record->type();
};
