fn variant_instance(Entity& record) -> bool {
	TemplateInstantiation* arguments = record.template_arguments();
	if (!arguments || !arguments->pattern || arguments->pattern->name() != "variant") {
		return false;
	};
	var Scope* scope = arguments->pattern->scope();
	return scope && scope->owner() && scope->owner()->kind() == entity_kind::namespace_body && scope->owner()->name() == "rt";
};

fn Analyzer::construct_variant(var Analyzer& this, var Syntax& syntax, Type* type, var rt::buffer<rt::unique<SemanticExpression>>& raw, var bool& handled) -> rt::unique<SemanticExpression> {
	@handled = false;
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record || !variant_instance(*type->entity()) || !raw.size()) {
		return rt::unique<SemanticExpression>();
	};
	if (raw.size() == 1 && raw.data()[0].get()->type()->same_shape(*type)) {
		return rt::unique<SemanticExpression>();
	};
	@handled = true;
	if (!(@this.resolve(type->entity())).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	if (raw.size() != 1) {
		@this.error(&@syntax, "variant construction requires exactly one alternative value");
		return rt::unique<SemanticExpression>();
	};
	if (raw.data()[0].get()->kind() == semantic_kind::null_pointer || raw.data()[0].get()->type()->kind() == type_kind::void_type) {
		bool void_value = raw.data()[0].get()->type()->kind() == type_kind::void_type;
		TemplateInstantiation* instance = type->entity()->template_arguments();
		var TemplatePack* elements = instance->arguments.data()[0].pack;
		usize empty_position = elements->elements.size();
		usize position = 0;
		while (position < elements->elements.size()) {
			if (elements->elements.data()[position].type && (void_value && elements->elements.data()[position].type->kind() == type_kind::void_type || !void_value && elements->elements.data()[position].type->kind() == type_kind::null_type)) {
				if (empty_position != elements->elements.size()) {
					@this.error(&@syntax, "variant construction type matches more than one alternative");
					return rt::unique<SemanticExpression>();
				};
				@empty_position = position;
			};
			@position = position + 1;
		};
		if (empty_position != elements->elements.size()) {
			var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);
			var result = @this.node(semantic_kind::construction, type, &@syntax);
			if (!arguments.get() || !result.get() || !(@result.get()->append($arguments)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@result.get()->set_integer(u64(empty_position + 1));
			if (void_value) {
				var sequence = @this.node(semantic_kind::sequence, type, &@syntax);
				if (!sequence.get() || !(@sequence.get()->append(rt::unique<SemanticExpression>(@raw.data()[0].release()))).has<void>() || !(@sequence.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@sequence.get()->append($result)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};
				return $sequence;
			};
			return $result;
		};
	};

	var Entity* storage = type->entity()->find_member("_storage");
	if (!storage || !(@this.resolve(storage)).has<void>() || storage->type()->kind() != type_kind::named || !(@this.resolve(storage->type()->entity())).has<void>()) {
		@this.error(&@syntax, "rt::variant requires its standard alternative storage declaration");
		return rt::unique<SemanticExpression>();
	};
	var Entity* alternatives = storage->type()->entity();
	usize selected = alternatives->fields().size();
	usize index = 0;
	while (index < alternatives->fields().size()) {
		Type* candidate = alternatives->fields().data()[index]->type();
		if (candidate->same_shape(*raw.data()[0].get()->type()) || candidate->kind() == type_kind::reference && candidate->element()->same_shape(*raw.data()[0].get()->type()) && @this.argument_rank(*raw.data()[0].get(), *candidate) >= 0) {
			if (selected != alternatives->fields().size()) {
				@this.error(&@syntax, "variant construction type matches more than one alternative");
				return rt::unique<SemanticExpression>();
			};
			@selected = index;
		};
		@index = index + 1;
	};
	if (selected == alternatives->fields().size()) {
		@this.error(&@syntax, "variant construction value type is not an alternative");
		return rt::unique<SemanticExpression>();
	};

	Type* alternative = alternatives->fields().data()[selected]->type();
	if (alternative->kind() != type_kind::reference && raw.data()[0].get()->category() == value_category::place && !(@this.prepare_copy(alternative)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	rt::buffer<rt::unique<SemanticExpression>> payload_arguments;
	@payload_arguments.push_back(rt::unique<SemanticExpression>(@raw.data()[0].release()));
	rt::unique<SemanticExpression> payload;
	if (alternative->kind() == type_kind::reference) {
		var rt::unique<SemanticExpression>* values = (@payload_arguments).data();
		@payload = rt::unique<SemanticExpression>(@values[0].release());
	}
	else {
		@payload = @this.construct_values(@syntax, alternative, $payload_arguments);
	};
	var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);
	var result = @this.node(semantic_kind::construction, type, &@syntax);
	if (!payload.get() || !arguments.get() || !result.get() || !(@arguments.get()->append($payload)).has<void>() || !(@result.get()->append($arguments)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	@result.get()->set_integer(alternatives->fields().data()[selected]->integer() + 1);
	return $result;
};
