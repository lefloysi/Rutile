fn LifetimeAnalyzer::selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!(@this.walk(expression->item(0), @state)).has<void>()) {
		return compilation_error();
	};

	var SemanticExpression* body = expression->item(1);

	if (body->kind() != semantic_kind::brace) {
		return;
	};

	usize boundary = state.size();
	u64 condition = 0;
	bool known = expression->item(0)->constant_integer(@condition);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		var SemanticExpression* label = body->item(index);

		if (label->kind() == semantic_kind::case_label) {
			if (label->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (known && label->integer() == condition) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	FlowState combined;

	@combined.copy_from(state);

	if (fallback < body->size() || known && selected < body->size()) {
		@combined.leave(flow_exit::unreachable);
	};

	LoopFlow selection;
	@selection.region = flow_region::selection;
	@selection.parent := this.active_loop;
	@selection.break_boundary := boundary;
	var scope = LoopScope(@this.active_loop, @selection);
	@index = 0;

	while (index < body->size()) {
		if (body->item(index)->kind() != semantic_kind::case_label || known && index != selected) {
			@index = index + 1;
			continue;
		};

		FlowState path;

		@path.copy_from(state);

		usize next = index + 1;

		while (next < body->size() && !path.exited()) {
			if (body->item(next)->kind() != semantic_kind::case_label && !(@this.walk(body->item(next), @path)).has<void>()) {
				return compilation_error();
			};

			@next = next + 1;
		};

		if (!path.exited() && !(@this.save(@selection.breaks, @path, boundary, expression)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < selection.breaks.size()) {
		FlowState previous;

		@previous.copy_from(combined);
		if (!((@this.merge(@combined, @previous, @*selection.breaks.data()[index].get(), expression)).has<void>())) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@state.copy_from(combined);
};
