enum object_lifetime : [u08] {
	live;
	relocated;
	discarded;
	destroyed;
	indeterminate;
};

enum flow_exit : [u08] {
	none;
	unreachable;
	return_function;
	break_loop;
	continue_loop;
	throw_exception;
};

enum flow_region : [u08] {
	loop;
	selection;
};

struct LiveBinding {
	var Entity* entity;
	object_lifetime lifetime;
	rt::optional_ref<Entity> referent;
};

struct FlowState {
	fn declare(var FlowState& this, var Entity* entity);
	fn copy_from(var FlowState& this, FlowState& other);
	fn truncate(var FlowState& this, usize size);
	fn leave(var FlowState& this, flow_exit exit);
	fn resume(var FlowState& this);

	fn size(FlowState& this) -> usize;
	fn at(var FlowState& this, usize index) -> var LiveBinding*;
	fn find(var FlowState& this, var Entity* entity) -> var LiveBinding*;
	fn exited(FlowState& this) -> bool;

private:
	rt::buffer<LiveBinding> bindings;
	flow_exit exit;
};

struct LoopFlow {
	flow_region region;
	usize break_boundary;
	usize continue_boundary;
	var LoopFlow* parent;
	rt::buffer<rt::unique<FlowState>> breaks;
	rt::buffer<rt::unique<FlowState>> continues;
};

struct LoopScope {
	fn LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop);
	fn ~LoopScope(var LoopScope& this);

private:
	var LoopFlow var** current;
	var LoopFlow* previous;
};

struct ExceptionFlow {
	usize boundary;
	var ExceptionFlow* parent;
	rt::buffer<rt::unique<FlowState>> entries;
};

struct LifetimeAnalyzer {
	fn LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics);

	fn sequence(var LifetimeAnalyzer& this, var SemanticExpression& expression, var FlowState& state) -> CompilationResult;
	fn validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn validate_graph(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn validate_legacy(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;

	fn storage_owner(LifetimeAnalyzer& this, SemanticExpression& expression, var FlowState& state) -> rt::optional_ref<Entity>;

private:
	fn error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view message) -> CompilationResult;
	fn binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view reason, Entity& entity) -> CompilationResult;
	fn walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> CompilationResult;
	fn validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> CompilationResult;
	fn conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> CompilationResult;
	fn exceptions(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn exceptional_edge(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn graph_function(var LifetimeAnalyzer& this, var Entity& function) -> CompilationResult;
	fn graph_transfer(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, var GraphLifetimeState& state);
	fn graph_check(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, GraphLifetimeState& state) -> CompilationResult;

	var Diagnostics* diagnostics;
	var LoopFlow* active_loop;
	var ExceptionFlow* active_exception;
};

fn LifetimeAnalyzer::exceptional_edge(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!this.active_exception || state.exited()) {
		return CompilationResult();
	};
	return @this.save(@this.active_exception->entries, @state, usize(this.active_exception->boundary), expression);
};

fn LifetimeAnalyzer::exceptions(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	ExceptionFlow region;
	@region.boundary = state.size();
	@region.parent = this.active_exception;
	@this.active_exception = &@region;
	FlowState normal;
	@normal.copy_from(state);
	bool valid = (@this.walk(expression->item(0), @normal)).has<void>();
	@this.active_exception = region.parent;
	if (!valid) {
		return CompilationResult(compilation_error());
	};
	@normal.truncate(usize(region.boundary));
	@state.copy_from(normal);
	if (!region.entries.size()) {
		return CompilationResult();
	};
	FlowState incoming;
	@incoming.copy_from(*region.entries.data()[0].get());
	usize edge = 1;
	while (edge < region.entries.size()) {
		FlowState previous;
		@previous.copy_from(incoming);
		if (!((@this.merge(@incoming, @previous, @*region.entries.data()[edge].get(), expression)).has<void>())) {
			return CompilationResult(compilation_error());
		};
		@edge = edge + 1;
	};
	usize index = 1;
	while (index < expression->size()) {
		var SemanticExpression* handler = expression->item(index);
		FlowState caught;
		@caught.copy_from(incoming);
		if (handler->entity()) {
			@caught.declare(handler->entity());
		};
		if (!(@this.walk(handler->item(0), @caught)).has<void>()) {
			return CompilationResult(compilation_error());
		};
		@caught.truncate(usize(region.boundary));
		FlowState previous;
		@previous.copy_from(state);
		if (!((@this.merge(@state, @previous, @caught, expression)).has<void>())) {
			return CompilationResult(compilation_error());
		};
		@index = index + 1;
	};
	var SemanticExpression* last = expression->item(expression->size() - 1);
	if (last->type()->kind() != type_kind::void_type && !(@this.exceptional_edge(expression, @incoming)).has<void>()) {
		return CompilationResult(compilation_error());
	};
	return CompilationResult();
};

fn LifetimeAnalyzer::error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view message) -> CompilationResult {
	Token token;

	if (expression) {
		@token = expression->token();
	};

	@this.diagnostics->error(token, message);
	return CompilationResult(compilation_error());
};

fn LifetimeAnalyzer::binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view reason, Entity& entity) -> CompilationResult {
	if (this.diagnostics->failed()) {
		return CompilationResult(compilation_error());
	};
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text("; object '");
	diagnostic_entity(@message, entity);
	@message.text("' has type '");
	diagnostic_type(@message, *entity.type());
	@message.text("'");
	Token location = entity.token();
	if (expression) {
		@location = expression->token();
	};
	@this.diagnostics->error(location, message.view());
	@this.diagnostics->note(entity.token(), "object is declared here");
	return CompilationResult(compilation_error());
};

fn LifetimeAnalyzer::merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> CompilationResult {
	if (first.exited() && second.exited()) {
		@destination.copy_from(first);
		return CompilationResult();
	};

	if (first.exited()) {
		@destination.copy_from(second);
		return CompilationResult();
	};

	if (second.exited()) {
		@destination.copy_from(first);
		return CompilationResult();
	};

	usize index = 0;
	while (index < destination.size()) {
		var LiveBinding* binding = @destination.at(index);
		var LiveBinding* a = @first.find(binding->entity);
		var LiveBinding* b = @second.find(binding->entity);

		if (!a || !b) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable control-flow merge", *binding->entity);
		};

		if (a->lifetime == object_lifetime::indeterminate || b->lifetime == object_lifetime::indeterminate || (a->lifetime == object_lifetime::live) != (b->lifetime == object_lifetime::live)) {
			@binding->lifetime = object_lifetime::indeterminate;
		}
		else {
			@binding->lifetime = object_lifetime(a->lifetime);
		};

		if (a->referent.get() != b->referent.get() || !a->referent.has_value()) {
			@binding->referent.reset();
		}
		else {
			@binding->referent.bind(@*a->referent.get());
		};

		@index = index + 1;
	};

	return CompilationResult();
};

fn LifetimeAnalyzer::validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> CompilationResult {
	usize index = 0;
	while (index < entry.size()) {
		var LiveBinding* binding = @entry.at(index);
		var LiveBinding* repeated = @incoming.find(binding->entity);

		if (!repeated || (binding->lifetime == object_lifetime::indeterminate) != (repeated->lifetime == object_lifetime::indeterminate) || (binding->lifetime == object_lifetime::live) != (repeated->lifetime == object_lifetime::live)) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable loop backedge", *binding->entity);
		};

		@index = index + 1;
	};

	return CompilationResult();
};

fn LifetimeAnalyzer::conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!(@this.walk(expression->item(0), @state)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	bool truth = false;

	if (expression->item(0)->constant_truth(@truth)) {
		if (truth) {
			return @this.walk(expression->item(1), @state);
		};

		return @this.walk(expression->item(2), @state);
	};

	FlowState first;
	FlowState second;

	@first.copy_from(state);
	@second.copy_from(state);

	if (!(@this.walk(expression->item(1), @first)).has<void>() || !(@this.walk(expression->item(2), @second)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	return @this.merge(@state, @first, @second, $expression);
};

fn LifetimeAnalyzer::storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	var Entity* owner = expression->owned_binding();

	if (!owner) {
		return @this.walk(expression, @state);
	};

	if (!@state.find(owner)) {
		return @this.binding_error(expression, "object storage does not reach this construction", *owner);
	};

	return CompilationResult();
};

fn LifetimeAnalyzer::save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> CompilationResult {
	var snapshot = rt::unique<FlowState>::make();

	@snapshot.get()->copy_from(state);

	@snapshot.get()->truncate($boundary);
	@snapshot.get()->resume();

	@exits.push_back($snapshot);

	return CompilationResult();
};

fn LifetimeAnalyzer::loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	bool is_for = expression->kind() == semantic_kind::for_loop;
	usize boundary = state.size();

	if (is_for && !(@this.walk(expression->item(0), @state)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	FlowState entry;

	@entry.copy_from(state);

	usize condition = 0;
	usize body = 1;

	if (is_for) {
		@condition = 1;
		@body = 3;
	};

	var SemanticExpression* test = expression->item(condition);

	if (!(@this.walk(test, @state)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	bool truth = true;
	bool known = is_for && test->kind() == semantic_kind::noop;

	if (!known) {
		@known = test->constant_truth(@truth);
	};

	if (known && !truth) {
		@state.truncate(boundary);

		return CompilationResult();
	};

	FlowState repeated;

	@repeated.copy_from(state);

	LoopFlow loop;
	@loop.parent := this.active_loop;
	@loop.break_boundary := boundary;
	@loop.continue_boundary = state.size();
	var scope = LoopScope(@this.active_loop, @loop);

	if (!(@this.walk(expression->item(body), @repeated)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	if (!repeated.exited() && !(@this.save(@loop.continues, @repeated, loop.continue_boundary, expression)).has<void>()) {
		return CompilationResult(compilation_error());
	};

	usize body_exits = loop.continues.size();
	usize index = 0;
	while (index < body_exits) {
		var FlowState& backedge = @*loop.continues.data()[index].get();

		if (is_for && !(@this.walk(expression->item(2), @backedge)).has<void>()) {
			return CompilationResult(compilation_error());
		};

		if (!backedge.exited()) {
			if (!(@this.validate_backedge(@entry, @backedge, expression)).has<void>()) {
				return CompilationResult(compilation_error());
			};
		};

		@index = index + 1;
	};

	while (index < loop.continues.size()) {
		if (!(@this.validate_backedge(@entry, @*loop.continues.data()[index].get(), expression)).has<void>()) {
			return CompilationResult(compilation_error());
		};

		@index = index + 1;
	};

	@state.truncate(boundary);
	bool has_exit = !known || !truth;
	@index = 0;

	while (index < loop.breaks.size()) {
		var FlowState& leaving = @*loop.breaks.data()[index].get();

		if (!has_exit) {
			@state.copy_from(leaving);

			@has_exit = true;
		}
		else {
			FlowState previous;

			@previous.copy_from(state);
			if (!((@this.merge(@state, @previous, @leaving, expression)).has<void>())) {
				return CompilationResult(compilation_error());
			};
		};

		@index = index + 1;
	};

	if (!has_exit) {
		@state.leave(flow_exit::unreachable);
	};

	return CompilationResult();
};

fn LifetimeAnalyzer::walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!expression || state.exited()) {
		return CompilationResult();
	};

	switch (expression->kind()) {
		case semantic_kind::exception_try:
			return @this.exceptions(expression, @state);
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
			if (expression->size() && !(@this.walk(expression->item(0), @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			@state.leave(flow_exit::throw_exception);
			return CompilationResult();
		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or) {
				if (!(@this.walk(expression->item(0), @state)).has<void>()) {
					return CompilationResult(compilation_error());
				};

				bool truth = false;

				if (expression->item(0)->constant_truth(@truth)) {
					if (expression->operation() == token_kind::op_and && !truth || expression->operation() == token_kind::op_or && truth) {
						return CompilationResult();
					};

					return @this.walk(expression->item(1), @state);
				};

				FlowState skipped;
				FlowState evaluated;

				@skipped.copy_from(state);
				@evaluated.copy_from(state);

				if (!(@this.walk(expression->item(1), @evaluated)).has<void>()) {
					return CompilationResult(compilation_error());
				};

				return @this.merge(@state, @skipped, @evaluated, $expression);
			};

			break;
		case semantic_kind::conditional:
			return @this.conditional($expression, @state);
		case semantic_kind::switch_expression:
			return @this.selection(expression, @state);
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop($expression, @state);
		case semantic_kind::sequence:
			return @this.sequence(@*expression, @state);
		case semantic_kind::name: {
			var Entity* entity = expression->entity();

			if (!entity || (entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter)) {
				return CompilationResult();
			};

			var LiveBinding* binding = @state.find($entity);
			var owner = this.storage_owner(*expression, @state);

			if (owner.has_value()) {
				@binding = @state.find(owner.get());
			};

			if (!binding) {
				return @this.binding_error(expression, "object construction does not reach this use", *expression->entity());
			};

			if (binding->lifetime == object_lifetime::destroyed) {
				return @this.binding_error(expression, "object has been destroyed", *binding->entity);
			};

			if (binding->lifetime != object_lifetime::live) {
				if (binding->lifetime == object_lifetime::relocated) {
					return @this.binding_error(expression, "object has been relocated", *binding->entity);
				};
				if (binding->lifetime == object_lifetime::discarded) {
					return @this.binding_error(expression, "object has been discarded", *binding->entity);
				};
				return @this.binding_error(expression, "object lifetime differs across reachable control-flow paths", *binding->entity);
			};

			return CompilationResult();
		};
		case semantic_kind::variable: {
			if (!(@this.walk(expression->item(0), @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			var owner = this.storage_owner(*expression->item(0), @state);

			@state.declare(expression->entity());

			if (expression->entity()->type()->kind() == type_kind::reference && owner.has_value()) {
				var LiveBinding* binding = @state.find(expression->entity());
				@binding->referent.bind(@*owner.get());
			};

			return CompilationResult();
		};
		case semantic_kind::relocation: {
			var SemanticExpression* source = expression->item(0);

			if (!(@this.walk(source, @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			var Entity* owner = source->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::relocated;
				};
			};

			return CompilationResult();
		};
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);

			if (!(@this.walk(object, @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			var Entity* owner = object->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::destroyed;
				};
			};

			return CompilationResult();
		};
		case semantic_kind::construction: {
			if (expression->size() < 2) {
				if (!(@this.walk(expression->item(0), @state)).has<void>()) {
					return CompilationResult(compilation_error());
				};
				return @this.exceptional_edge(expression, @state);
			};

			var SemanticExpression* destination = expression->item(1);

			if (!(@this.storage(destination, @state)).has<void>() || !(@this.walk(expression->item(0), @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};
			var Entity* owner = destination->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::live;
				};
			};

			return CompilationResult();
		};
		case semantic_kind::return_value:
			if (!(@this.walk(expression->item(0), @state)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			@state.leave(flow_exit::return_function);

			return CompilationResult();
		case semantic_kind::break_loop:
			if (!this.active_loop) {
				return @this.error(expression, "break requires an enclosing loop or switch");
			};
			if (!(@this.save(@this.active_loop->breaks, @state, usize(this.active_loop->break_boundary), expression)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			@state.leave(flow_exit::break_loop);

			return CompilationResult();
		case semantic_kind::continue_loop: {
			var LoopFlow* loop = this.active_loop;

			while (loop && loop->region == flow_region::selection) {
				@loop = loop->parent;
			};

			if (!loop) {
				return @this.error(expression, "continue requires an enclosing loop");
			};
			if (!(@this.save(@loop->continues, @state, usize(loop->continue_boundary), expression)).has<void>()) {
				return CompilationResult(compilation_error());
			};

			@state.leave(flow_exit::continue_loop);

			return CompilationResult();
		};
		default:
			break;
	};

	usize boundary = state.size();
	usize index = 0;
	while (index < expression->size()) {
		if (!(@this.walk(expression->item(index), @state)).has<void>()) {
			return CompilationResult(compilation_error());
		};

		@index = index + 1;
	};

	if (expression->kind() == semantic_kind::call || expression->kind() == semantic_kind::allocation || expression->kind() == semantic_kind::deallocation || expression->kind() == semantic_kind::array_deallocation) {
		if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
			return CompilationResult(compilation_error());
		};
	};
	if (expression->kind() == semantic_kind::brace) {
		@state.truncate(boundary);
	};

	return CompilationResult();
};

fn LifetimeAnalyzer::validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	return @this.validate_graph(unit);
};

fn LifetimeAnalyzer::validate_legacy(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;

		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};

		FlowState state;
		usize parameter = 0;

		while (parameter < function->parameters().size()) {
			@state.declare(function->parameters().data()[parameter]);

			@parameter = parameter + 1;
		};

		if (!(@this.walk(function->body(), @state)).has<void>()) {
			return CompilationResult(compilation_error());
		};

		function_completion completion = function_completion::reaches_end;

		if (state.exited()) {
			@completion = function_completion::no_fallthrough;
		};

		@function->set_completion($completion);
	};

	return CompilationResult();
};

fn FlowState::size(FlowState& this) -> usize {
	return this.bindings.size();
};

fn FlowState::at(var FlowState& this, usize index) -> var LiveBinding* {
	return (@this.bindings).data() + index;
};

fn FlowState::find(var FlowState& this, var Entity* entity) -> var LiveBinding* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return (@this.bindings).data() + index;
		};
	};

	return nullptr;
};

fn FlowState::declare(var FlowState& this, var Entity* entity) {
	LiveBinding binding;
	@binding.entity = $entity;
	@binding.lifetime = object_lifetime::live;

	@this.bindings.push_back($binding);
	return;
};

fn FlowState::copy_from(var FlowState& this, FlowState& other) {
	@this.bindings.clear();
	@this.exit = flow_exit(other.exit);
	usize index = 0;
	while (index < other.bindings.size()) {
		LiveBinding binding := other.bindings.data()[index];

		@this.bindings.push_back($binding);

		@index = index + 1;
	};

	return;
};

fn FlowState::truncate(var FlowState& this, usize size) {
	while (this.bindings.size() > size) {
		@this.bindings.pop_back();
	};
};

fn FlowState::exited(FlowState& this) -> bool {
	return this.exit != flow_exit::none;
};

fn FlowState::leave(var FlowState& this, flow_exit exit) {
	@this.exit = $exit;
};

fn FlowState::resume(var FlowState& this) {
	@this.exit = flow_exit::none;
};

fn LoopScope::LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop) {
	@this.current = &@current;
	@this.previous := current;
	@current = &@loop;
};

fn LoopScope::~LoopScope(var LoopScope& this) {
	@*this.current := this.previous;
};

fn LifetimeAnalyzer::LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};
