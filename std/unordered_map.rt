namespace rt {
	template<typename T>
	export union unordered_slot {
		fn unordered_slot(var unordered_slot& this) : [default];
		fn ~unordered_slot(var unordered_slot& this) : [default];

		u08 empty;
		T object;
	};

	template<typename K, typename V>
	export struct unordered_node {
		fn unordered_node(var unordered_node& this, K key, V value, usize code);
		fn ~unordered_node(var unordered_node& this);

		unordered_slot<K> key;
		unordered_slot<V> value;
		var unordered_node* next;
		usize hash_code;
	};

	// Equal must define an equivalence relation; equivalent keys must have equal hashes.
	// Hash and Equal are called through const references and must remain stable while keys are stored.
	// Key storage borrowed by a key (such as string_view bytes) must remain valid and unchanged.
	// Insert consumes both arguments, returning false for an existing key and allocation_error on storage failure.
	// Pointers returned by find survive insert/reserve and moves of their owning map.
	// Erase invalidates only the erased value; clear and destruction invalidate all values.
	template<typename K, typename V, typename Hash = default_hash<K>, typename Equal = default_equal<K>>
	export struct unordered_map {
		fn unordered_map(var unordered_map& this);
		fn unordered_map(var unordered_map& this, Hash hash, Equal equal);
		fn unordered_map(var unordered_map& this, unordered_map& other) : [delete];
		fn operator=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];
		fn operator:=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];
		fn ~unordered_map(var unordered_map& this);

		fn insert(var unordered_map& this, K key, V value) -> bool | allocation_error;
		fn erase(var unordered_map& this, K& key) -> bool;
		fn clear(var unordered_map& this);
		fn reserve(var unordered_map& this, usize required) -> void | allocation_error;

		fn size(unordered_map& this) -> usize;
		fn empty(unordered_map& this) -> bool;
		fn find(auto unordered_map& this, K& key) -> const[this] V*;

	private:
		buffer<var unordered_node<K, V>*> buckets;
		unordered_slot<Hash> hasher;
		unordered_slot<Equal> comparison;
		usize length;
	};

	template<typename K, typename V>
	export fn unordered_node<K, V>::unordered_node(var unordered_node& this, K key, V value, usize code) {
		@this.key.object.K($key);
		@this.value.object.V($value);
		@this.hash_code = $code;
	};

	template<typename K, typename V>
	export fn unordered_node<K, V>::~unordered_node(var unordered_node& this) {
		@this.value.object.~V();
		@this.key.object.~K();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash();
		@this.comparison.object.Equal();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this, Hash hash, Equal equal) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash($hash);
		@this.comparison.object.Equal($equal);
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::~unordered_map(var unordered_map& this) {
		@this.clear();
		@this.comparison.object.~Equal();
		@this.hasher.object.~Hash();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::size(unordered_map& this) -> usize {
		return this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::empty(unordered_map& this) -> bool {
		return !this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::find(auto unordered_map& this, K& key) -> const[this] V* {
		if (!this.buckets.size()) {
			return nullptr;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		var unordered_node<K, V>* node = this.buckets.data()[index];
		while (node) {
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				return const_cast<const[this] V*>(&@node->value.object);
			};

			@node = node->next;
		};

		return nullptr;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::insert(var unordered_map& this, K key, V value) -> bool | allocation_error {
		using Result = bool | allocation_error;
		if (this.find(key)) {
			return Result(false);
		};

		if (this.length == usize::max) {
			allocation_error error;
			@error.requested_bytes = usize::max;
			return Result($error);
		};

		usize code = this.hasher.object.hash(key);
		var reserved = @this.reserve(this.length + 1);
		if (reserved.has<allocation_error>()) {
			return Result(reserved.get<allocation_error>());
		};

		using Node = unordered_node<K, V>;
		var Node* node = static_cast<var Node*>(malloc(sizeof(Node)));
		if (!node) {
			allocation_error error;
			@error.requested_bytes = sizeof(Node);
			return Result($error);
		};

		@node->Node($key, $value, $code);

		usize index = node->hash_code % this.buckets.size();

		@node->next = this.buckets.data()[index];
		@(@this.buckets).data()[index] = node;
		@this.length = this.length + 1;

		return Result(true);
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::erase(var unordered_map& this, K& key) -> bool {
		if (!this.buckets.size()) {
			return false;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		var (var unordered_node<K, V>*)* link = &@(@this.buckets).data()[index];
		while (*link) {
			var unordered_node<K, V>* node = *link;
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				@*link = node->next;

				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@this.length = this.length - 1;

				return true;
			};

			@link = &@node->next;
		};

		return false;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::clear(var unordered_map& this) {
		usize index = 0;
		while (index < this.buckets.size()) {
			var unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				var unordered_node<K, V>* next = node->next;
				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@node = next;
			};

			@(@this.buckets).data()[index] = nullptr;
			@index = index + 1;
		};

		@this.length = 0;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	export fn unordered_map<K, V, Hash, Equal>::reserve(var unordered_map& this, usize required) -> void | allocation_error {
		using Result = void | allocation_error;
		if (required <= this.buckets.size()) {
			return Result();
		};

		usize maximum = usize::max / sizeof(var unordered_node<K, V>*);
		if (required > maximum) {
			allocation_error error;
			@error.requested_bytes = usize::max;
			return Result($error);
		};

		usize count = $required;
		if (count < 8) {
			@count = 8;
		};

		if (this.buckets.size() <= (maximum >> 1)) {
			usize grown = this.buckets.size() << 1;
			if (grown > count) {
				@count = grown;
			};
		};

		buffer<var unordered_node<K, V>*> replacement;
		var reserved = @replacement.reserve(count);
		if (reserved.has<allocation_error>()) {
			return $reserved;
		};

		usize index = 0;
		while (index < count) {
			var appended = @replacement.push_back(nullptr);
			if (appended.has<allocation_error>()) {
				return $appended;
			};

			@index = index + 1;
		};

		@index = 0;
		while (index < this.buckets.size()) {
			var unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				var unordered_node<K, V>* next = node->next;
				usize bucket = node->hash_code % count;

				@node->next = replacement.data()[bucket];
				@(@replacement).data()[bucket] = node;
				@node = next;
			};

			@index = index + 1;
		};

		@this.buckets = $replacement;

		return Result();
	};
};
