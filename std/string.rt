fn malloc(usize size) -> var void*;

fn free(void* memory);

fn memcpy(var void* destination, void* source, usize size) -> var void*;

fn memmove(var void* destination, void* source, usize size) -> var void*;

namespace rt {
	union string_storage {
		fn string_storage(var string_storage& this) : [default];
		fn ~string_storage(var string_storage& this) : [default];

		char[16] inline_bytes;
		var char* heap;
	};

	export struct string {
		fn string(var string& this) : [default];
		fn string(var string& this, string& other);
		fn string(var string& this, string_view text);
		fn ~string(var string& this);

		fn operator:=(var string& this, string& other) -> var string&;
		fn clear(var string& this);
		fn append(var string& this, string_view text) -> void | allocation_error;
		// The requested capacity excludes the terminating NUL byte.
		fn reserve(var string& this, usize required) -> void | allocation_error;

		fn size(string& this) -> usize;
		fn capacity(string& this) -> usize;
		fn empty(string& this) -> bool;
		fn data(auto string& this) -> const[this] char*;
		fn c_str(string& this) -> char*;
		fn view(string& this) -> string_view;
		fn contains(string& this, string_view text) -> bool;
		fn trim(string& this) -> string_view;

	private:
		string_storage storage;
		usize length;
		// Zero selects inline storage; heap capacity excludes the terminating NUL.
		usize heap_capacity;
	};

	export fn string_view::string_view(var string_view& this, string& text) {
		@this.bytes = text.data();
		@this.length = text.size();
	};

	export fn operator+(string_view first, string_view second) -> string {
		string result;
		if (second.size() > usize::max - first.size()) {
			allocation_error error;
			@error.requested_bytes = usize::max;
			throw $error;
		};
		var reserved = @result.reserve(first.size() + second.size());
		if (reserved.has<allocation_error>()) {
			throw allocation_error(reserved.get<allocation_error>());
		};
		@result.append(first);
		@result.append(second);
		return $result;
	};

	export fn string::reserve(var string& this, usize required) -> void | allocation_error {
		using Result = void | allocation_error;
		if (required <= this.capacity()) {
			return Result();
		};

		usize maximum = usize::max - 1;
		if (required > maximum) {
			allocation_error error;
			@error.requested_bytes = required;
			return Result($error);
		};

		usize count = $required;
		usize capacity = this.capacity();
		usize half = capacity >> 1;
		if (capacity > maximum - half) {
			@count = $maximum;
		}
		else if (capacity + half > count) {
			@count = capacity + half;
		};

		var char* replacement = static_cast<var char*>(malloc(count + 1));
		if (!replacement) {
			allocation_error error;
			@error.requested_bytes = count + 1;
			return Result($error);
		};

		@replacement = static_cast<var char*>(memcpy(replacement, this.data(), this.length + 1));
		if (this.heap_capacity) {
			free(this.storage.heap);
		};

		@this.storage.heap = $replacement;
		@this.heap_capacity = $count;

		return Result();
	};

	export fn string::append(var string& this, string_view text) -> void | allocation_error {
		using Result = void | allocation_error;
		if (text.empty()) {
			return Result();
		};

		if (text.size() > usize::max - this.length - 1) {
			allocation_error error;
			@error.requested_bytes = usize::max;
			return Result($error);
		};

		char* source = text.data();
		usize address = reinterpret_cast<usize>(source);
		usize begin = reinterpret_cast<usize>(this.data());
		bool aliases = address >= begin && address - begin <= this.length;
		usize offset = 0;
		if (aliases) {
			@offset = address - begin;
		};

		usize length = this.length + text.size();
		var reserved = @this.reserve(length);
		if (reserved.has<allocation_error>()) {
			return $reserved;
		};

		var char* destination = (@this).data();
		if (aliases) {
			@source = destination + offset;
		};

		var char* appended = static_cast<var char*>(memmove(destination + this.length, source, text.size()));
		@appended[text.size()] = '\0';
		@this.length = $length;

		return Result();
	};

	export fn string::string(var string& this, string& other) {
		var appended = @this.append(other.view());
		if (appended.has<allocation_error>()) {
			throw allocation_error(appended.get<allocation_error>());
		};
	};

	export fn string::string(var string& this, string_view text) {
		var appended = @this.append(text);
		if (appended.has<allocation_error>()) {
			throw allocation_error(appended.get<allocation_error>());
		};
	};

	export fn string::~string(var string& this) {
		if (this.heap_capacity) {
			free(this.storage.heap);
		};
	};

	export fn string::operator:=(var string& this, string& other) -> var string& {
		string replacement;
		var appended = @replacement.append(other.view());
		if (appended.has<allocation_error>()) {
			throw allocation_error(appended.get<allocation_error>());
		};

		@this = $replacement;

		return @this;
	};

	export fn string::size(string& this) -> usize {
		return this.length;
	};

	export fn string::capacity(string& this) -> usize {
		if (this.heap_capacity) {
			return this.heap_capacity;
		};

		return 15;
	};

	export fn string::empty(string& this) -> bool {
		return !this.length;
	};

	export fn string::data(auto string& this) -> const[this] char* {
		if (this.heap_capacity) {
			return this.storage.heap;
		};

		return &@this.storage.inline_bytes[0];
	};

	export fn string::c_str(string& this) -> char* {
		return this.data();
	};

	export fn string::view(string& this) -> string_view {
		return string_view(this.data(), this.length);
	};

	export fn string::contains(string& this, string_view text) -> bool {
		string_view view = this;
		return view.contains(text);
	};

	export fn string::trim(string& this) -> string_view {
		string_view view = this;
		return view.trim();
	};

	export fn string::clear(var string& this) {
		@this.length = 0;
		var char* bytes = (@this).data();
		@bytes[0] = '\0';
	};
};
