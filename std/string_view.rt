namespace rt {
	export struct string_view {
		fn string_view(var string_view& this) : [default];
		fn string_view(var string_view& this, string_view& other) : [implicit, default];
		fn string_view(var string_view& this, string& text) : [implicit];
		fn string_view(var string_view& this, char* data, usize size);

		fn data(string_view& this) -> char*;
		fn size(string_view& this) -> usize;
		fn empty(string_view& this) -> bool;
		fn slice(string_view& this, usize begin, usize count) -> string_view;
		fn compare(string_view& this, string_view other) -> i32;
		fn contains(string_view& this, string_view text) -> bool;
		fn trim(string_view& this) -> string_view;

	private:
		char* bytes;
		usize length;
	};

	export fn operator==(string_view first, string_view second) -> bool {
		return !first.compare(second);
	};

	export fn operator!=(string_view first, string_view second) -> bool {
		return first.compare(second) != 0;
	};

	export fn operator<(string_view first, string_view second) -> bool {
		return first.compare(second) < 0;
	};

	export fn operator<=(string_view first, string_view second) -> bool {
		return first.compare(second) <= 0;
	};

	export fn operator>(string_view first, string_view second) -> bool {
		return first.compare(second) > 0;
	};

	export fn operator>=(string_view first, string_view second) -> bool {
		return first.compare(second) >= 0;
	};

	export fn string_view::string_view(var string_view& this, char* data, usize size) {
		@this.bytes = $data;
		@this.length = $size;
	};

	export fn from_c_string(char* text) -> string_view {
		usize length = 0;
		while (text && text[length]) {
			@length = length + 1;
		};
		return string_view(text, length);
	};

	export fn string_view::data(string_view& this) -> char* {
		return this.bytes;
	};

	export fn string_view::size(string_view& this) -> usize {
		return this.length;
	};

	export fn string_view::empty(string_view& this) -> bool {
		return !this.length;
	};

	export fn string_view::slice(string_view& this, usize begin, usize count) -> string_view {
		return string_view(this.bytes + begin, $count);
	};

	export fn string_view::compare(string_view& this, string_view other) -> i32 {
		usize count := this.length;
		if (other.length < count) {
			@count := other.length;
		};

		usize index = 0;
		while (index < count) {
			char first_byte := this.bytes[index];
			char second_byte := other.bytes[index];
			u08 first = static_cast<u08>($first_byte);
			u08 second = static_cast<u08>($second_byte);
			if (first < second) {
				return -1;
			};

			if (first > second) {
				return 1;
			};

			@index = index + 1;
		};

		if (this.length < other.length) {
			return -1;
		};

		if (this.length > other.length) {
			return 1;
		};

		return 0;
	};

	export fn string_view::trim(string_view& this) -> string_view {
		usize begin = 0;
		usize end = this.length;
		for (; begin < end; @begin = begin + 1) {
			char value = this.bytes[begin];
			if (value != ' ' && value != '\t' && value != '\r' && value != '\n' && value != char(11) && value != char(12)) {
				break;
			};
		};
		for (; end > begin; @end = end - 1) {
			char value = this.bytes[end - 1];
			if (value != ' ' && value != '\t' && value != '\r' && value != '\n' && value != char(11) && value != char(12)) {
				break;
			};
		};
		return this.slice(begin, end - begin);
	};

	export fn string_view::contains(string_view& this, string_view text) -> bool {
		if (text.size() > this.length) {
			return false;
		};
		usize last = this.length - text.size();
		usize index = 0;
		while (true) {
			if (this.slice(index, text.size()) == text) {
				return true;
			};
			if (index == last) {
				return false;
			};
			@index = index + 1;
		};
	};
};
