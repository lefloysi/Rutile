namespace rt {
	template<typename T>
	export fn swap(var T& first, var T& second) {
		if (&first == &second) {
			return;
		};
		var T* first_pointer = &@first;
		var T* second_pointer = &@second;
		T temporary = $*first_pointer;
		@first_pointer[0].T($second_pointer[0]);
		@second_pointer[0].T($temporary);
	};
};
