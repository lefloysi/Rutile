namespace rt {
	fn mix_hash(u64 value) -> usize {
		@value = (value ^ (value >> 30)) * 13787848793156543929;
		@value = (value ^ (value >> 27)) * 10723151780598845931;
		return static_cast<usize>(value ^ (value >> 31));
	};

	template<typename K>
	struct integer_hash {
		fn hash(const integer_hash& this, const K& value) -> usize {
			return mix_hash(static_cast<u64>(value));
		};
	};
	template<typename T>
	struct pointer_hash {
		fn hash(const pointer_hash& this, const T* value) -> usize {
			return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));
		};
	};
	struct f32_hash {
		fn hash(const f32_hash& this, const f32& value) -> usize {
			if (value == 0.0) {
				return 0;
			};
			return mix_hash(static_cast<u64>(*reinterpret_cast<const u32*>(&value)));
		};
	};
	struct f64_hash {
		fn hash(const f64_hash& this, const f64& value) -> usize {
			if (value == 0.0) {
				return 0;
			};
			return mix_hash(*reinterpret_cast<const u64*>(&value));
		};
	};
	struct string_view_hash {
		fn hash(const string_view_hash& this, const string_view& value) -> usize {
			u64 result = 14695981039346656037;
			usize index = 0;
			while (index < value.size()) {
				char byte = value.data()[index];
				@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * 1099511628211;
				@index = index + 1;
			};
			return static_cast<usize>(result);
		};
	};
};
