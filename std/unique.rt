namespace rt {
	template<typename T>
	struct default_delete {
		fn dispose(T* pointer) {
			delete pointer;
		};
	};

	template<typename T, typename D = default_delete<T>>
	struct unique {
		fn unique(unique& this) : [default];
		fn unique(unique& this, T* pointer) {
			@this.pointer = $pointer;
		};
		fn unique(unique& this, const unique& other) : [delete];
		fn operator=(unique& this, const unique& other) -> unique& : [delete];
		fn unique(unique& this, unique other) : [default];
		fn operator=(unique& this, unique other) -> unique& : [default];
		fn ~unique(unique& this) {
			@this.reset(nullptr);
		};

		fn get(const unique& this) -> T* {
			return this.pointer;
		};
		fn release(unique& this) -> T* {
			T* result := this.pointer;
			@this.pointer = nullptr;
			return $result;
		};
		fn reset(unique& this, T* pointer) {
			T* previous := this.pointer;
			@this.pointer = $pointer;
			D::dispose($previous);
		};
		fn make() -> unique {
			return unique(new T());
		};

	private:
		T* pointer;
	};
};
