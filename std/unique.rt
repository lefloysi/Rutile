namespace rt {
	template<typename T>
	export struct default_delete {
		fn dispose(var T* pointer);
	};

	template<typename T, typename D = default_delete<T>>
	export struct unique {
		fn unique(var unique& this) : [default];
		fn unique(var unique& this, var T* pointer);
		fn unique(var unique& this, unique& other) : [delete];
		fn operator=(var unique& this, unique& other) -> var unique& : [delete];
		fn operator:=(var unique& this, unique& other) -> var unique& : [delete];
		fn ~unique(var unique& this);
		fn make() -> unique | allocation_error;

		fn release(var unique& this) -> var T*;
		fn reset(var unique& this, var T* pointer);

		fn get(unique& this) -> var T*;

	private:
		var T* pointer;
	};

	template<typename T>
	export fn default_delete<T>::dispose(var T* pointer) {
		delete pointer;
	};

	template<typename T, typename D>
	export fn unique<T, D>::unique(var unique& this, var T* pointer) {
		@this.pointer = $pointer;
	};

	template<typename T, typename D>
	export fn unique<T, D>::~unique(var unique& this) {
		@this.reset(nullptr);
	};

	template<typename T, typename D>
	export fn unique<T, D>::get(unique& this) -> var T* {
		return this.pointer;
	};

	template<typename T, typename D>
	export fn unique<T, D>::release(var unique& this) -> var T* {
		var T* result := this.pointer;

		@this.pointer = nullptr;

		return $result;
	};

	template<typename T, typename D>
	export fn unique<T, D>::reset(var unique& this, var T* pointer) {
		var T* previous := this.pointer;

		@this.pointer = $pointer;
		D::dispose($previous);
	};

	template<typename T, typename D>
	export fn unique<T, D>::make() -> unique | allocation_error {
		var T* pointer = new T();
		return unique($pointer);
	};
};
