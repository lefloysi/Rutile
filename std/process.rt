struct NativeProcess;
struct ProcessBuffer {
	char* data;
	usize size;
	i32 error;
};
struct ProcessStart {
	var NativeProcess* handle;
	i32 error;
};
struct ProcessOutput {
	i32 state;
	i32 exit_code;
	ProcessBuffer output;
	ProcessBuffer error;
};
fn rutile_process_start(char** arguments, usize count, char* directory, char** environment, usize environment_count, var ProcessStart* result);
fn rutile_process_write(var NativeProcess* process, char* bytes, usize size) -> i32;
fn rutile_process_close_input(var NativeProcess* process);
fn rutile_process_read(var NativeProcess* process, u32 timeout_ms) -> ProcessBuffer*;
fn rutile_process_wait(var NativeProcess* process, u32 timeout_ms) -> ProcessOutput*;
fn rutile_process_dispose(var NativeProcess* process);

namespace rt::sys {
	export struct launch_error {
	};

	export struct timeout_error {
	};

	export struct io_error {
	};

	export struct invalid_environment_error {
	};
	export struct Command {
		rt::buffer<rt::string> arguments;
		rt::string working_directory;
		rt::string input;
		u32 timeout_ms = 30000;
		rt::buffer<rt::string> environment_overrides;

		fn Command(var Command& this, rt::string_view executable);
		fn argument(var Command& this, rt::string_view value) -> void | rt::allocation_error;
		fn environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error;
	};

	export struct Result {
		i32 exit_code = -1;
		rt::string output;
		rt::string error;
	};

	export struct Session {
		fn Session(var Session& this) : [default];
		fn Session(var Session& this, var NativeProcess* process);
		fn Session(var Session& this, Session& other) : [delete];
		fn ~Session(var Session& this);
		fn valid(Session& this) -> bool;
		fn write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error;
		fn close_input(var Session& this);
		fn read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error;
		fn wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error;

	private:
		var NativeProcess* handle;
	};

	export fn Command::Command(var Command& this, rt::string_view executable) {
		var appended = @this.arguments.push_back(rt::string(executable));
		if (appended.has<rt::allocation_error>()) {
			throw rt::allocation_error(appended.get<rt::allocation_error>());
		};
	};

	export fn Command::argument(var Command& this, rt::string_view value) -> void | rt::allocation_error {
		using Result = void | rt::allocation_error;
		try {
			return @this.arguments.push_back(rt::string(value));
		}
		catch (rt::allocation_error error) {
			return Result($error);
		};
	};

	export fn Command::environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error {
		using Result = void | invalid_environment_error | rt::allocation_error;
		if (name.empty() || name.contains("=") || name.contains("\0") || value.contains("\0")) {
			invalid_environment_error error;
			return Result($error);
		};
		try {
			var appended = @this.environment_overrides.push_back(name + "=" + value);
			if (appended.has<rt::allocation_error>()) {
				return Result(appended.get<rt::allocation_error>());
			};
			return Result();
		}
		catch (rt::allocation_error error) {
			return Result($error);
		};
	};

	export fn Session::Session(var Session& this, var NativeProcess* process) {
		@this.handle = $process;
	};

	export fn Session::~Session(var Session& this) {
		rutile_process_dispose(this.handle);
	};

	export fn Session::valid(Session& this) -> bool {
		return this.handle != nullptr;
	};

	export fn Session::write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error {
		using Result = void | io_error | rt::allocation_error;
		if (!this.handle) {
			io_error error;
			return Result($error);
		};
		i32 failure = rutile_process_write(this.handle, input.data(), input.size());
		if (failure == 3) {
			rt::allocation_error error;
			return Result($error);
		};
		if (failure) {
			io_error error;
			return Result($error);
		};
		return Result();
	};
	export fn Session::close_input(var Session& this) {
		if (this.handle) {
			rutile_process_close_input(this.handle);
		};
	};

	export fn Session::read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error {
		using Outcome = rt::string | io_error | rt::allocation_error;
		if (!this.handle) {
			io_error error;
			return Outcome($error);
		};
		var output = rutile_process_read(this.handle, timeout_ms);
		if (output->error == 3) {
			rt::allocation_error error;
			return Outcome($error);
		};
		if (output->error) {
			io_error error;
			return Outcome($error);
		};
		rt::string bytes;
		var copied = @bytes.append(rt::string_view(output->data, output->size));
		if (copied.has<rt::allocation_error>()) {
			return Outcome(copied.get<rt::allocation_error>());
		};
		return Outcome($bytes);
	};

	export fn Session::wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {
		using Outcome = Result | launch_error | timeout_error | io_error | rt::allocation_error;
		if (!this.handle) {
			launch_error error;
			return Outcome($error);
		};
		var output = rutile_process_wait(this.handle, timeout_ms);
		if (output->state == 3) {
			rt::allocation_error error;
			return Outcome($error);
		};
		if (output->state == 4) {
			io_error error;
			return Outcome($error);
		};
		if (output->state == 1) {
			launch_error error;
			return Outcome($error);
		};
		if (output->state == 2) {
			timeout_error error;
			return Outcome($error);
		};
		Result result;
		@result.exit_code = output->exit_code;
		var copied_output = @result.output.append(rt::string_view(output->output.data, output->output.size));
		if (copied_output.has<rt::allocation_error>()) {
			return Outcome(copied_output.get<rt::allocation_error>());
		};
		var copied_error = @result.error.append(rt::string_view(output->error.data, output->error.size));
		if (copied_error.has<rt::allocation_error>()) {
			return Outcome(copied_error.get<rt::allocation_error>());
		};
		return Outcome($result);
	};

	export fn start(Command& command) -> Session | launch_error | rt::allocation_error {
		using Outcome = Session | launch_error | rt::allocation_error;
		rt::buffer<char*> pointers;
		for (usize index = 0; index < command.arguments.size(); @index = index + 1) {
			var appended = @pointers.push_back(command.arguments.data()[index].c_str());
			if (appended.has<rt::allocation_error>()) {
				return Outcome(appended.get<rt::allocation_error>());
			};
		};
		rt::buffer<char*> environment;
		for (usize index = 0; index < command.environment_overrides.size(); @index = index + 1) {
			var appended = @environment.push_back(command.environment_overrides.data()[index].c_str());
			if (appended.has<rt::allocation_error>()) {
				return Outcome(appended.get<rt::allocation_error>());
			};
		};
		ProcessStart started;
		rutile_process_start(pointers.data(), pointers.size(), command.working_directory.c_str(), environment.data(), environment.size(), &@started);
		if (started.error == 3) {
			rt::allocation_error error;
			return Outcome($error);
		};
		if (started.error || !started.handle) {
			launch_error error;
			return Outcome($error);
		};
		return Outcome(Session(started.handle));
	};

	export fn cmd(Command& command) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {
		using Outcome = Result | launch_error | timeout_error | io_error | rt::allocation_error;
		var started = start(command);
		if (started.has<launch_error>()) {
			return Outcome(started.get<launch_error>());
		};
		if (started.has<rt::allocation_error>()) {
			return Outcome(started.get<rt::allocation_error>());
		};
		var Session& session = (@started).get<Session>();
		var written = @session.write(command.input);
		if (written.has<io_error>()) {
			return Outcome(written.get<io_error>());
		};
		if (written.has<rt::allocation_error>()) {
			return Outcome(written.get<rt::allocation_error>());
		};
		@session.close_input();
		return @session.wait(command.timeout_ms);
	};
};
