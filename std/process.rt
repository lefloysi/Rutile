struct Process;
fn rutile_process_start(char** arguments, usize count, char* directory, char** environment, usize environment_count, var void* result);
fn rutile_process_write(var Process* process, char* bytes, usize size, var void* result);
fn rutile_process_close_input(var Process* process);
fn rutile_process_read(var Process* process, u32 timeout_ms, var void* result);
fn rutile_process_wait(var Process* process, u32 timeout_ms, var void* result);
fn rutile_process_dispose(var Process* process);

namespace rt::sys {
	export struct launch_error : [rt::error] {
		fn description(launch_error& this) -> rt::string_view : [override];
	};

	export fn launch_error::description(launch_error& this) -> rt::string_view {
		return "The process could not be started.";
	};

	export struct timeout_error : [rt::error] {
		fn description(timeout_error& this) -> rt::string_view : [override];
	};

	export fn timeout_error::description(timeout_error& this) -> rt::string_view {
		return "The process timed out.";
	};

	export struct io_error : [rt::error] {
		fn description(io_error& this) -> rt::string_view : [override];
	};

	export fn io_error::description(io_error& this) -> rt::string_view {
		return "The process I/O operation failed.";
	};

	export struct invalid_environment_error : [rt::error] {
		fn description(invalid_environment_error& this) -> rt::string_view : [override];
	};

	export fn invalid_environment_error::description(invalid_environment_error& this) -> rt::string_view {
		return "The process environment entry is invalid.";
	};
	export struct Command {
		rt::buffer<rt::string> arguments;
		rt::string working_directory;
		rt::string input;
		u32 timeout_ms = 30000;
		rt::buffer<rt::string> environment_overrides;

		fn Command(var Command& this, rt::string_view executable);
		fn argument(var Command& this, rt::string_view value) -> void | rt::allocation_error;
		fn environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error;
	};

	export struct Result {
		i32 exit_code = 0;
		rt::string output;
		rt::string error;
	};

	export struct Session {
		fn Session(var Session& this) : [default];
		fn Session(var Session& this, var Process* process);
		fn Session(var Session& this, Session& other) : [delete];
		fn ~Session(var Session& this);
		fn valid(Session& this) -> bool;
		fn write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error;
		fn close_input(var Session& this);
		fn read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error;
		fn wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error;

	private:
		var Process* handle = nullptr;
	};

	export fn Command::Command(var Command& this, rt::string_view executable) {
		@this.arguments.push_back(rt::string(executable));
	};

	export fn Command::argument(var Command& this, rt::string_view value) -> void | rt::allocation_error {
		rt::string argument;
		@argument.append(value);
		@this.arguments.push_back($argument);
	};

	export fn Command::environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error {
		if (name.empty() || name.contains("=") || name.contains("\0") || value.contains("\0")) {
			invalid_environment_error error;
			return $error;
		};
		@this.environment_overrides.push_back(name + "=" + value);
	};

	export fn Session::Session(var Session& this, var Process* process) {
		@this.handle = $process;
	};

	export fn Session::~Session(var Session& this) {
		rutile_process_dispose(this.handle);
	};

	export fn Session::valid(Session& this) -> bool {
		return this.handle != nullptr;
	};

	using WriteResult = void | io_error | rt::allocation_error;
	using ReadResult = rt::string | io_error | rt::allocation_error;
	using WaitResult = Result | launch_error | timeout_error | io_error | rt::allocation_error;
	using StartResult = Session | launch_error | rt::allocation_error;

	fn "C" rutile_process_start_complete(var void* storage, var Process* process) {
		@*reinterpret_cast<var StartResult*>(storage) = Session(process);
	};
	fn "C" rutile_process_start_launch_error(var void* storage) {
		@*reinterpret_cast<var StartResult*>(storage) = launch_error();
	};
	fn "C" rutile_process_start_allocation_error(var void* storage, usize bytes) {
		rt::allocation_error error;
		@error.requested_bytes = bytes;
		@*reinterpret_cast<var StartResult*>(storage) = $error;
	};
	fn "C" rutile_process_write_complete(var void* storage) {
		@*reinterpret_cast<var WriteResult*>(storage) = WriteResult();
	};
	fn "C" rutile_process_write_io_error(var void* storage) {
		@*reinterpret_cast<var WriteResult*>(storage) = io_error();
	};
	fn "C" rutile_process_write_allocation_error(var void* storage, usize bytes) {
		rt::allocation_error error;
		@error.kind = rt::allocation_kind::array;
		@error.requested_bytes = bytes;
		@*reinterpret_cast<var WriteResult*>(storage) = $error;
	};
	fn "C" rutile_process_read_complete(var void* storage, char* bytes, usize size) -> usize {
		var ReadResult& result = @*reinterpret_cast<var ReadResult*>(storage);
		rt::string text;
		var appended = @text.append(rt::string_view(bytes, size));
		if (appended.has<rt::allocation_error>()) {
			@result = appended.get<rt::allocation_error>();
			return 0;
		};
		@result = $text;
		return $size;
	};
	fn "C" rutile_process_read_io_error(var void* storage) {
		@*reinterpret_cast<var ReadResult*>(storage) = io_error();
	};
	fn "C" rutile_process_read_allocation_error(var void* storage, usize bytes) {
		rt::allocation_error error;
		@error.kind = rt::allocation_kind::array;
		@error.requested_bytes = bytes;
		@*reinterpret_cast<var ReadResult*>(storage) = $error;
	};
	fn "C" rutile_process_wait_complete(var void* storage, i32 exit_code, char* output, usize output_size, char* error, usize error_size) {
		var WaitResult& outcome = @*reinterpret_cast<var WaitResult*>(storage);
		Result result;
		@result.exit_code = $exit_code;
		var copied_output = @result.output.append(rt::string_view(output, output_size));
		if (copied_output.has<rt::allocation_error>()) {
			@outcome = copied_output.get<rt::allocation_error>();
			return;
		};
		var copied_error = @result.error.append(rt::string_view(error, error_size));
		if (copied_error.has<rt::allocation_error>()) {
			@outcome = copied_error.get<rt::allocation_error>();
			return;
		};
		@outcome = $result;
	};
	fn "C" rutile_process_wait_timeout_error(var void* storage) {
		@*reinterpret_cast<var WaitResult*>(storage) = timeout_error();
	};
	fn "C" rutile_process_wait_io_error(var void* storage) {
		@*reinterpret_cast<var WaitResult*>(storage) = io_error();
	};
	fn "C" rutile_process_wait_allocation_error(var void* storage, usize bytes) {
		rt::allocation_error error;
		@error.kind = rt::allocation_kind::array;
		@error.requested_bytes = bytes;
		@*reinterpret_cast<var WaitResult*>(storage) = $error;
	};

	export fn Session::write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error {
		if (!this.handle) {
			return io_error();
		};
		WriteResult result;
		rutile_process_write(this.handle, input.data(), input.size(), &@result);
		return $result;
	};

	export fn Session::close_input(var Session& this) {
		if (this.handle) {
			rutile_process_close_input(this.handle);
		};
	};

	export fn Session::read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error {
		if (!this.handle) {
			return io_error();
		};
		ReadResult result;
		rutile_process_read(this.handle, timeout_ms, &@result);
		return $result;
	};

	export fn Session::wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {
		if (!this.handle) {
			return launch_error();
		};
		WaitResult result;
		rutile_process_wait(this.handle, timeout_ms, &@result);
		return $result;
	};

	export fn start(Command& command) -> Session | launch_error | rt::allocation_error {
		rt::buffer<char*> pointers;
		for (usize index = 0; index < command.arguments.size(); @index = index + 1) {
			@pointers.push_back(command.arguments.data()[index].c_str());
		};
		rt::buffer<char*> environment;
		for (usize index = 0; index < command.environment_overrides.size(); @index = index + 1) {
			@environment.push_back(command.environment_overrides.data()[index].c_str());
		};
		StartResult result;
		rutile_process_start(pointers.data(), pointers.size(), command.working_directory.c_str(), environment.data(), environment.size(), &@result);
		return $result;
	};

	export fn cmd(Command& command) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {
		var started = start(command);
		if (started.has<launch_error>()) {
			return started.get<launch_error>();
		};
		if (started.has<rt::allocation_error>()) {
			return started.get<rt::allocation_error>();
		};
		var Session& session = (@started).get<Session>();
		@session.write(command.input);
		@session.close_input();
		return @session.wait(command.timeout_ms);
	};
};
