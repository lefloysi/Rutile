namespace rt {
	export struct empty_buffer_error : [error] {
		fn description(empty_buffer_error& this) -> string_view : [override];
	};

	export fn empty_buffer_error::description(empty_buffer_error& this) -> string_view {
		return "Cannot remove an element from an empty buffer.";
	};

	template<typename T>
	export struct buffer {
		fn buffer(var buffer& this) : [default];
		fn buffer(var buffer& this, buffer& other);
		fn ~buffer(var buffer& this);

		fn operator=(var buffer& this, buffer& other) -> var buffer&;
		fn operator:=(var buffer& this, buffer& other) -> var buffer&;
		fn reserve(var buffer& this, usize required) -> void | allocation_error;
		fn push_back(var buffer& this, T value) -> void | allocation_error;
		fn pop_back(var buffer& this) -> void | empty_buffer_error;
		fn clear(var buffer& this);

		fn data(auto buffer& this) -> const[this] T*;
		fn size(buffer& this) -> usize;
		fn capacity(buffer& this) -> usize;

	private:
		fn copy_from(var buffer& this, buffer& other) -> void | allocation_error;

		var T* _storage;
		usize _size;
		usize _capacity;
	};

	template<typename T>
	export fn buffer<T>::buffer(var buffer& this, buffer& other) {
		@this.copy_from(other);
	};

	template<typename T>
	export fn buffer<T>::operator=(var buffer& this, buffer& other) -> var buffer& {
		buffer replacement;
		@replacement.copy_from(other);

		@this = $replacement;

		return @this;
	};

	template<typename T>
	export fn buffer<T>::copy_from(var buffer& this, buffer& other) -> void | allocation_error {
		@this.reserve(other._size);

		for (; this._size < other._size; @this._size = this._size + 1) {
			@this._storage[this._size].T(other._storage[this._size]);
		};
	};

	template<typename T>
	export fn buffer<T>::operator:=(var buffer& this, buffer& other) -> var buffer& {
		return @this = other;
	};

	template<typename T>
	export fn buffer<T>::~buffer(var buffer& this) {
		@this.clear();
		delete[] this._storage;
	};

	template<typename T>
	export fn buffer<T>::reserve(var buffer& this, usize required) -> void | allocation_error {
		if (required <= this._capacity) {
			return;
		};

		const usize element_size = sizeof(T);
		usize maximum = usize::max;
		if (element_size) {
			@maximum = usize::max / element_size;
		};
		if (required > maximum) {
			allocation_error error;
			@error.kind = allocation_kind::array;
			@error.requested_bytes = usize::max;
			return $error;
		};

		usize count = grow_capacity(this._capacity, required, maximum, this._capacity);

		var T* replacement = new T[count]{};

		for (usize index = 0; index < this._size; @index = index + 1) {
			@replacement[index].T($(this._storage[index]));
		};

		delete[] this._storage;
		@this._storage = $replacement;
		@this._capacity = $count;
	};

	template<typename T>
	export fn buffer<T>::push_back(var buffer& this, T value) -> void | allocation_error {
		if (this._size == usize::max) {
			allocation_error error;
			@error.kind = allocation_kind::array;
			@error.requested_bytes = usize::max;
			return $error;
		};

		@this.reserve(this._size + 1);

		@this._storage[this._size].T($value);
		@this._size = this._size + 1;
	};

	template<typename T>
	export fn buffer<T>::pop_back(var buffer& this) -> void | empty_buffer_error {
		if (!this._size) {
			return empty_buffer_error();
		};

		@this._size = this._size - 1;
		@this._storage[this._size].~T();
	};

	template<typename T>
	export fn buffer<T>::clear(var buffer& this) {
		for (usize index = 0; index < this._size; @index = index + 1) {
			@this._storage[index].~T();
		};

		@this._size = 0;
	};

	template<typename T>
	export fn buffer<T>::size(buffer& this) -> usize {
		return this._size;
	};

	template<typename T>
	export fn buffer<T>::capacity(buffer& this) -> usize {
		return this._capacity;
	};

	template<typename T>
	export fn buffer<T>::data(auto buffer& this) -> const[this] T* {
		return this._storage;
	};

	template<typename T>
	export struct span {
		fn span(var span& this, T* data, usize size);
		fn data(span& this) -> T*;
		fn size(span& this) -> usize;
		fn empty(span& this) -> bool;

	private:
		T* elements;
		usize count;
	};

	template<typename T>
	export fn span<T>::span(var span<T>& this, T* data, usize size) {
		@this.elements = $data;
		@this.count = $size;
	};

	template<typename T>
	export fn span<T>::data(span<T>& this) -> T* {
		return this.elements;
	};

	template<typename T>
	export fn span<T>::size(span<T>& this) -> usize {
		return this.count;
	};

	template<typename T>
	export fn span<T>::empty(span<T>& this) -> bool {
		return !this.count;
	};
};
