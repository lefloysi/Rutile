fn rutile_runtime_report_error(char* bytes, usize size);

namespace rt {
	export enum byte : [u08] {
	};

	export struct error {
		fn error(var error& this) : [default];
		fn error(var error& this, string_view message);
		fn description(error& this) -> string_view : [virtual];
	private:
		string _message;
	};

	export fn error::error(var error& this, string_view message) {
		@this._message = string(message);
	};

	export fn error::description(error& this) -> string_view {
		if (this._message.empty()) {
			return "Runtime error.";
		};
		return this._message.view();
	};

	export enum allocation_kind : [u08] {
		unknown;
		single;
		array;
	};

	export struct allocation_error : [error] {
		fn description(allocation_error& this) -> string_view : [override];
		usize requested_bytes;
		allocation_kind kind;
	};

	export fn allocation_error::description(allocation_error& this) -> string_view {
		return "Memory allocation failed.";
	};

	export fn grow_capacity(usize capacity, usize required, usize maximum, usize increment) -> usize {
		usize grown = maximum;
		if (capacity <= maximum && increment <= maximum - capacity) {
			@grown = capacity + increment;
		};
		if (required > grown) {
			return required;
		};
		return grown;
	};

};

namespace rt::runtime {
	export using result = void | rt::error;
	export using entry = ((rt::span<rt::string_view>) -> result)*;

	fn report_error(rt::string_view description) -> i32 {
		rutile_runtime_report_error(description.data(), description.size());
		return 1;
	};

	export fn run(i32 count, char** arguments, entry application) -> i32 {
		try {
			var views = rt::buffer<rt::string_view>();
			for (i32 index = 1; index < count; @index = index + 1) {
				@views.push_back(rt::from_c_string(arguments[index]));
			};
			var argument_views = rt::span<rt::string_view>(views.data(), views.size());
			application(argument_views);
			return 0;
		}
		catch (rt::error& failure) {
			return report_error(failure.description());
		}
		catch (...) {
			return report_error("Unhandled non-standard exception.");
		};
	};
};
