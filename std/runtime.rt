namespace rt {
	export enum byte : [u08] {
	};

	export struct error {
		fn error(var error& this) : [default];
		fn error(var error& this, string_view message);
		fn description(error& this) -> string_view : [virtual];
	private:
		string _message;
	};

	export fn error::error(var error& this, string_view message) {
		@this._message = string(message);
	};

	export fn error::description(error& this) -> string_view {
		if (this._message.empty()) {
			return "Runtime error.";
		};
		return this._message.view();
	};

	export enum allocation_kind : [u08] {
		unknown;
		single;
		array;
	};

	export struct allocation_error : [error] {
		fn description(allocation_error& this) -> string_view : [override];
		usize requested_bytes;
		allocation_kind kind;
	};

	export fn allocation_error::description(allocation_error& this) -> string_view {
		return "Memory allocation failed.";
	};

	export fn grow_capacity(usize capacity, usize required, usize maximum, usize increment) -> usize {
		usize grown = maximum;
		if (capacity <= maximum && increment <= maximum - capacity) {
			@grown = capacity + increment;
		};
		if (required > grown) {
			return required;
		};
		return grown;
	};

	export enum ExitCode : [i32] {
		success;
		failure;
	};
};
