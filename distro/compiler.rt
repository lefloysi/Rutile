		LLVMDisposePassBuilderOptions(value);
	};
};

fn FunctionEmitter::sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> CompilationResult {
	usize bindings = this.bindings.size();
	usize temporaries = this.temporaries.size();

	if (!(@this.statement(expression->item(0))).has<void>() || !(@this.statement(expression->item(1))).has<void>()) {
		return compilation_error();
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), "control transfer within a sequence initializer is not implemented");
	};

	var SemanticExpression* yielded = expression->item(2);

	if (expression->type()->kind() == type_kind::void_type) {
		if (!(@this.statement(yielded)).has<void>()) {
			return compilation_error();
		};
	}
	else if (form == native_evaluation::address) {
		@result = @this.address(yielded);
	}
	else if (yielded->category() == value_category::consumable) {
		@result = @this.take(yielded);
	}
	else {
		@result = @this.value(yielded);
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), "control transfer within a sequence yield is not implemented");
	};

	if (expression->type()->kind() != type_kind::void_type && !result) {
		return compilation_error();
	};

	if (!(@this.cleanup_temporaries(temporaries)).has<void>() || !(@this.leave_scope(bindings)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(temporaries);

};

fn FunctionEmitter::selection(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	var SemanticExpression* condition = expression->item(0);
	var SemanticExpression* body = expression->item(1);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* value = @this.value(condition);

	if (!value || !(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(temporary_boundary);

	if (!body) {
		return;
	};

	if (body->kind() != semantic_kind::brace) {
		return @this.validate_switch_item(body);
	};

	var LLVMOpaqueBasicBlock* after = @this.block("switch.after");
	var LLVMOpaqueBasicBlock* otherwise = after;
	rt::buffer<var LLVMOpaqueBasicBlock*> labels;
	usize index = 0;
	u32 count = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);
		var LLVMOpaqueBasicBlock* destination;

		if (item->kind() == semantic_kind::case_label) {
			@destination = @this.block("switch.case");

			if (item->token().kind == token_kind::kw_default) {
				@otherwise = destination;
			}
			else {
				@count = count + 1;
			};
		}
		else if (!(@this.validate_switch_item(item)).has<void>()) {
			return compilation_error();
		};

		@labels.push_back(destination);

		@index = index + 1;
	};

	var LLVMOpaqueValue* instruction = LLVMBuildSwitch(this.backend->builder(), value, otherwise, count);
	@index = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label && item->token().kind != token_kind::kw_default) {
			var LLVMOpaqueValue* constant = LLVMConstInt(@this.backend->type(condition->type()), item->integer(), 0);
			LLVMAddCase(instruction, constant, labels.data()[index]);
		};

		@index = index + 1;
	};

	usize scope_boundary = this.bindings.size();
	NativeControl control;
	@control.leave = after;
	@control.parent = this.active_control;
	@control.catches = this.active_catch;
	@control.handlers = this.active_handler;
	@control.binding_boundary = scope_boundary;

	if (otherwise == after) {
		@control.leave_edges = 1;
	};

	@this.active_control = &@control;
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block("switch.unreachable"));
	@index = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label) {
			if (!this.terminated()) {
				discard LLVMBuildBr(this.backend->builder(), labels.data()[index]);
			};

			LLVMPositionBuilderAtEnd(this.backend->builder(), labels.data()[index]);
		}
		else if (!(@this.statement(item)).has<void>()) {
			@this.active_control = control.parent;

			return compilation_error();
		};

		@index = index + 1;
	};

	@this.active_control = control.parent;

	if (!this.terminated()) {
		@control.leave_edges = control.leave_edges + 1;
		discard LLVMBuildBr(this.backend->builder(), after);
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (!control.leave_edges) {
		discard LLVMBuildUnreachable(this.backend->builder());
	};

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::validate_switch_item(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (expression->kind() == semantic_kind::switch_expression) {
		return;
	};

	if (expression->kind() == semantic_kind::case_label) {
		return @this.backend->error(expression->token(), "nested case label lowering is not implemented");
	};

	usize index = 0;

	while (index < expression->size()) {
		if (!(@this.validate_switch_item(expression->item(index))).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn FunctionEmitter::variant_cast_address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* receiver = expression->item(0);
	Type* owner = receiver->type();
	var Entity* storage_field = owner->entity()->find_member("_storage");
	var Entity* index_field = owner->entity()->find_member("_index");
	var LLVMOpaqueValue* object = @this.address(receiver);
	var LLVMOpaqueType* native = @this.backend->type(owner, expression->token());
	if (!object || !native || !storage_field || !index_field) {
		return nullptr;
	};
	var LLVMOpaqueValue* storage = LLVMBuildStructGEP2(this.backend->builder(), native, object, this.backend->field_index(owner->entity(), storage_field->index()), "variant.payload\0".data());
	TemplatePack* alternatives = owner->entity()->template_arguments()->arguments.data()[0].pack;
	Type* selected = alternatives->elements.data()[usize(expression->integer() - 1)].type;
	if (storage && this.alternative_fact(*expression) == expression->integer()) {
		if (selected->kind() == type_kind::reference) {
			return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(selected), storage, "variant.reference\0".data());
		};
		return storage;
	};
	var LLVMOpaqueValue* tag_address = LLVMBuildStructGEP2(this.backend->builder(), native, object, this.backend->field_index(owner->entity(), index_field->index()), "variant.tag.address\0".data());
	var LLVMOpaqueType* tag_type = @this.backend->type(index_field->type(), expression->token());
	if (!storage || !tag_address || !tag_type) {
		return nullptr;
	};
	var LLVMOpaqueValue* tag = LLVMBuildLoad2(this.backend->builder(), tag_type, tag_address, "variant.tag\0".data());
	var LLVMOpaqueBasicBlock* success = @this.block("variant.cast.success");
	var LLVMOpaqueBasicBlock* invalid = @this.block("variant.cast.invalid");
	var LLVMOpaqueValue* dispatch = LLVMBuildSwitch(this.backend->builder(), tag, invalid, static_cast<u32>(expression->size() - 1));
	LLVMAddCase(dispatch, LLVMConstInt(tag_type, expression->integer(), 0), success);
	usize index = 1;
	while (index < expression->size()) {
		if (u64(index) != expression->integer()) {
			var LLVMOpaqueBasicBlock* mismatch = @this.block("variant.cast.mismatch");
			LLVMAddCase(dispatch, LLVMConstInt(tag_type, u64(index), 0), mismatch);
			LLVMPositionBuilderAtEnd(this.backend->builder(), mismatch);
			var LLVMOpaqueValue* previous = this.variant_payload_address;
			var LLVMOpaqueValue* previous_live = this.variant_payload_live;
			@this.variant_payload_address = storage;
			@this.variant_payload_live = nullptr;
			if (receiver->category() == value_category::consumable) {
				for (usize temporary_index = this.temporaries.size(); temporary_index; @temporary_index = temporary_index - 1) {
					NativeTemporary& temporary = this.temporaries.data()[temporary_index - 1];
					if (temporary.expression == receiver) {
						@this.variant_payload_live = temporary.live;
						break;
					};
				};
			};
			var emitted = @this.statement(expression->item(index));
			@this.variant_payload_address = previous;
			@this.variant_payload_live = previous_live;
			if (emitted.has<compilation_error>()) {
				return nullptr;
			};
		};
		@index = index + 1;
	};
	LLVMPositionBuilderAtEnd(this.backend->builder(), invalid);
	discard LLVMBuildUnreachable(this.backend->builder());
	LLVMPositionBuilderAtEnd(this.backend->builder(), success);
	if (selected->kind() == type_kind::reference) {
		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(selected), storage, "variant.reference\0".data());
	};
	return storage;
};

fn FunctionEmitter::construct_variant_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> CompilationResult {
	Type* type = expression->type();
	var Entity* owner = type->entity();
	var Entity* alternatives_field = owner->find_member("_storage");
	var Entity* index_field = owner->find_member("_index");
	usize selected = usize(expression->integer() - 1);
	if (!alternatives_field || !index_field || alternatives_field->type()->kind() != type_kind::named) {
		return @this.backend->error(expression->token(), "invalid variant construction storage");
	};
	var Entity* alternative_field = nullptr;
	usize index = 0;
	while (index < alternatives_field->type()->entity()->fields().size()) {
		var Entity* field = alternatives_field->type()->entity()->fields().data()[index];
		if (field->integer() == u64(selected)) {
			@alternative_field = field;
			break;
		};
		@index = index + 1;
	};
	if (!alternative_field && expression->item(0)->size()) {
		return @this.backend->error(expression->token(), "variant construction alternative storage is unavailable");
	};

	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	if (!native) {
		return compilation_error();
	};
	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), storage);
	if (alternative_field) {
		var LLVMOpaqueValue* alternative_address = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(owner, alternatives_field->index()), "variant.storage\0".data());
		Type* alternative = alternative_field->type();
		if (!(@this.initialize_value(alternative, alternative_address, expression->item(0)->item(0))).has<void>()) {
			return compilation_error();
		};
	};
	var LLVMOpaqueValue* index_address = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(owner, index_field->index()), "variant.index\0".data());
	var LLVMOpaqueType* index_type = @this.backend->type(index_field->type(), expression->token());
	if (!index_type) {
		return compilation_error();
	};
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(index_type, expression->integer(), 0), index_address);
};

fn Backend::type(var Backend& this, Type* source) -> var LLVMOpaqueType* {
	Token origin;
	return @this.type(source, origin);
};

fn Backend::type(var Backend& this, Type* source, Token& origin) -> var LLVMOpaqueType* {
	if (!source || this.failed()) {
		return nullptr;
	};

	usize index = 0;

	while (index < this.types.size()) {
		Type* stored = this.types.data()[index].source;

		if (stored == source || (stored->kind() == type_kind::named && source->kind() == type_kind::named && stored->entity() == source->entity())) {
			return this.types.data()[index].value;
		};

		@index = index + 1;
	};

	var LLVMOpaqueType* result;

	switch (source->kind()) {
		case type_kind::void_type:
			@result = LLVMVoidTypeInContext(this.context());
			break;
		case type_kind::boolean:
			@result = LLVMIntTypeInContext(this.context(), 1);
			break;
		case type_kind::character:
			@result = LLVMIntTypeInContext(this.context(), 8);
			break;
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
			@result = LLVMIntTypeInContext(this.context(), source->bits());
			break;
		case type_kind::floating_point:
			@result = LLVMDoubleTypeInContext(this.context());

			if (source->bits() == 32) {
				@result = LLVMFloatTypeInContext(this.context());
			};

			break;
		case type_kind::pointer:
		case type_kind::reference:
			@result = LLVMPointerTypeInContext(this.context(), 0);
			break;
		case type_kind::array: {
			var LLVMOpaqueType* element = @this.type(source->element(), origin);

			if (!element) {
				return nullptr;
			};

			u64 element_size = LLVMABISizeOfType(this.layout(), element);
			u64 maximum = (u64::max) >> (64 - static_cast<u64>(this.pointer_bits()));

			if (element_size && source->count() > maximum / element_size) {
				var message = DiagnosticMessage();
				@message.text("array storage size exceeds target address space for type '");
				diagnostic_type(@message, *source);
				@message.text("': ");
				@message.number(source->count());
				@message.text(" elements of ");
				@message.number(element_size);
				@message.text(" bytes exceed the ");
				@message.number(u64(this.pointer_bits()));
				@message.text("-bit target limit of ");
				@message.number(maximum);
				@message.text(" bytes");
				discard @this.error(origin, message.view());
				return nullptr;
			};

			@result = LLVMArrayType2(element, source->count());
			break;
		};

		case type_kind::function: {
			FunctionSignature& signature = source->signature();
			rt::buffer<var LLVMOpaqueType*> parameters;
			@index = 0;

			while (index < signature.parameters().size()) {
				var LLVMOpaqueType* parameter = @this.type(signature.parameters().data()[index], origin);

				if (!parameter) {
					return nullptr;
				};
				@parameters.push_back(parameter);

				@index = index + 1;
			};

			var LLVMOpaqueType* result_type = @this.type(signature.result(), origin);

			if (!result_type) {
				return nullptr;
			};

			@result = LLVMFunctionType(result_type, (@parameters).data(), static_cast<u32>(parameters.size()), static_cast<i32>(signature.arity() == parameter_arity::variadic));
			break;
		};

		case type_kind::named: {
			var Entity* record = source->entity();

			if (record && record->kind() == entity_kind::enumeration) {
				@result = @this.type(record->underlying(), origin);
				break;
			};

			if (!record || record->kind() != entity_kind::record) {
				Token location;
				discard @this.error(location, "native named type requires a resolved record");
				return nullptr;
			};

			rt::string name;

			@name.append(record->name());

			@result = LLVMStructCreateNamed(this.context(), name.c_str());
			NativeType native;
			@native.source := source;
			@native.value := result;

			@this.types.push_back($native);

			rt::buffer<var LLVMOpaqueType*> fields;
			@index = 0;

			while (index < record->bases().size()) {
				var LLVMOpaqueType* base = @this.type(record->bases().data()[index], record->token());

				if (!base) {
					return nullptr;
				};
				@fields.push_back(base);

				@index = index + 1;
			};

			if (record->owns_dispatch()) {
				@fields.push_back(LLVMPointerTypeInContext(this.context(), 0));
			};

			@index = 0;

			while (index < record->fields().size()) {
				var LLVMOpaqueType* field = @this.type(record->fields().data()[index]->type(), record->fields().data()[index]->token());

				if (!field) {
					return nullptr;
				};
				@fields.push_back(field);

				@index = index + 1;
			};

			if (record->layout() == record_layout::overlapping && fields.size()) {
				var LLVMOpaqueType* aligned = fields.data()[0];
				u64 maximum = 0;
				u64 alignment = 1;
				@index = 0;

				while (index < fields.size()) {
					var LLVMOpaqueType* field = fields.data()[index];
					u64 size = LLVMABISizeOfType(this.layout(), field);
					u64 field_alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.layout(), field));

					if (size > maximum) {
						@maximum = size;
					};

					if (field_alignment > alignment) {
						@alignment = field_alignment;
						@aligned = field;
					};

					@index = index + 1;
				};

				@maximum = (maximum + alignment - 1) / alignment * alignment;
				@fields.clear();

				@fields.push_back(aligned);

				u64 occupied = LLVMABISizeOfType(this.layout(), aligned);

				if (maximum > occupied) {
					var LLVMOpaqueType* padding = LLVMArrayType2(LLVMIntTypeInContext(this.context(), 8), maximum - occupied);

					@fields.push_back(padding);
				};
			};

			LLVMStructSetBody((var LLVMOpaqueType*(result)), (@fields).data(), static_cast<u32>(fields.size()), 0);

			return result;
		};

		default: {
			Token location;
			discard @this.error(location, "type has no native representation");
			return nullptr;
		};
	};

	NativeType native;
	@native.source = source;
	@native.value := result;

	@this.types.push_back($native);

	return result;
};

fn Backend::symbol(Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].value;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::declare(var Backend& this, var Entity* entity) -> CompilationResult {
	if (!this.required(entity) || this.symbol((var Entity*(entity)))) {
		return;
	};

	if (!entity->type()) {
		return @this.error(entity->token(), "native declaration has no resolved type");
	};

	if (entity->kind() == entity_kind::function && (entity->definition() == function_definition::declaration || entity->linkage() == function_linkage::c) && !(@this.external_signature(entity)).has<void>()) {
		return compilation_error();
	};

	rt::string name;
	var spelling = entity->name();

	if (this.selected_entry && spelling == "main" && entity->linkage() != function_linkage::c) {
		@spelling = "rt.user.main";

		if (entity == this.selected_entry) {
			@spelling = "rt.entry";
		};
	};

	@name.append(spelling);
	Token module_token = entity->token();
	if (module_token.source && !module_token.source->module_name().empty() && entity->linkage() != function_linkage::c && (entity->kind() == entity_kind::global || entity->definition() != function_definition::declaration)) {
		DiagnosticMessage identity;
		@identity.text("rt.module.");
		@identity.text(module_token.source->module_name());
		@identity.text(".");
		diagnostic_entity(@identity, *entity);
		@identity.text(":");
		diagnostic_type(@identity, *entity->type());
		native_entity_modules(@identity, *entity);
		native_type_modules(@identity, *entity->type());
		@name = rt::string(identity.view());
	};

	if (entity->kind() == entity_kind::function) {
		usize parameter = 0;
		while (parameter < entity->parameters().size()) {
			var Entity* argument = entity->parameters().data()[parameter];
			if (!@this.type(argument->type(), argument->token())) {
				return compilation_error();
			};
			@parameter = parameter + 1;
		};
	};
	var LLVMOpaqueType* type = @this.type(entity->type(), entity->token());

	if (!type) {
		return compilation_error();
	};

	var LLVMOpaqueValue* value;

	if (entity->kind() == entity_kind::function) {
		if (entity->linkage() == function_linkage::c && LLVMGetNamedGlobal(this.module(), name.c_str())) {
			return @this.error(entity->token(), "C linkage function conflicts with an existing native global symbol");
		};
		if (entity->linkage() == function_linkage::c || entity->definition() == function_definition::declaration && (!entity->scope() || !entity->scope()->owner() || entity->scope()->owner()->kind() != entity_kind::record)) {
			@value = LLVMGetNamedFunction(this.module(), name.c_str());
			if (value) {
				usize previous = 0;
				while (previous < this.entities.size()) {
					var Entity* previous_source = this.entities.data()[previous].source;
					var LLVMOpaqueValue* previous_value = this.entities.data()[previous].value;
					if (previous_value == value && @this.type(previous_source->type()) != type) {
						return @this.error(entity->token(), "external symbol has incompatible native signatures");
					};
					if (previous_value == value && previous_source->canonical() != entity->canonical() && previous_source->definition() != function_definition::declaration && entity->definition() != function_definition::declaration) {
						return @this.error(entity->token(), "C linkage function conflicts with an existing native definition");
					};
					@previous = previous + 1;
				};
			};
		};
		if (!value) {
			@value = LLVMAddFunction(this.module(), name.c_str(), type);
		};
	}
	else {
		var LLVMOpaqueValue* function = LLVMGetNamedFunction(this.module(), name.c_str());
		if (function) {
			for (usize index = 0; index < this.entities.size(); @index = index + 1) {
				if (this.entities.data()[index].value == function && this.entities.data()[index].source->linkage() == function_linkage::c) {
					return @this.error(entity->token(), "native global symbol conflicts with a C linkage function");
				};
			};
		};
		@value = LLVMAddGlobal(this.module(), (var LLVMOpaqueType*(type)), name.c_str());
		if (!entity->imported_definition()) {
			LLVMSetInitializer((var LLVMOpaqueValue*(value)), LLVMConstNull(type));
		};
	};

	NativeEntity native;
	@native.source = entity;
	@native.value = value;
	@native.implementation = value;
	if (module_token.source && !module_token.source->module_name().empty() && (entity->instantiated() || entity->origin() == declaration_origin::compiler_supplied)) {
		LLVMSetLinkage(value, 3);
		LLVMSetComdat(value, LLVMGetOrInsertComdat(this.module(), name.c_str()));
	};

	if (entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary) {
		rt::string wrapper;

		@wrapper.append("rt.dispatch.");
		@wrapper.append(name.view());

		@native.value = LLVMAddFunction(this.module(), wrapper.c_str(), type);
	};

	@this.entities.push_back($native);

};

fn Backend::required(Backend& this, var Entity* entity) -> bool {
	if (entity->canonical() != entity || (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global)) {
		return false;
	};

	if (entity->kind() == entity_kind::function && (entity->instantiated() || entity->origin() == declaration_origin::compiler_supplied) && entity->body_state() != entity_state::ready) {
		return false;
	};

	return true;
};

// A null source destroys the active payload; otherwise it copy constructs that payload.
fn FunctionEmitter::variant_transfer(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, bool assign) -> CompilationResult {
	var Entity* record = type->entity();
	var Entity* storage_field = record->find_member("_storage");
	var Entity* tag_field = record->find_member("_index");
	if (!storage_field || !tag_field || storage_field->type()->kind() != type_kind::named) {
		return @this.backend->error(record->token(), "variant special member requires payload storage and a tag");
	};
	var LLVMOpaqueType* native = @this.backend->type(type, record->token());
	var LLVMOpaqueType* tag_type = @this.backend->type(tag_field->type(), tag_field->token());
	if (!native || !tag_type) {
		return compilation_error();
	};
	var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, this.backend->field_index(record, storage_field->index()), "variant.payload\0".data());
	var LLVMOpaqueValue* output_tag = LLVMBuildStructGEP2(this.backend->builder(), native, destination, this.backend->field_index(record, tag_field->index()), "variant.tag.address\0".data());
	var LLVMOpaqueValue* input = output;
	var LLVMOpaqueValue* input_tag = output_tag;
	if (source) {
		@input = LLVMBuildStructGEP2(this.backend->builder(), native, source, this.backend->field_index(record, storage_field->index()), "variant.copy.payload\0".data());
		@input_tag = LLVMBuildStructGEP2(this.backend->builder(), native, source, this.backend->field_index(record, tag_field->index()), "variant.copy.tag.address\0".data());
	};
	var LLVMOpaqueValue* tag = LLVMBuildLoad2(this.backend->builder(), tag_type, input_tag, "variant.active\0".data());
	var LLVMOpaqueBasicBlock* after = @this.block("variant.transfer.after");
	var LLVMOpaqueBasicBlock* invalid = @this.block("variant.transfer.invalid");
	var Entity* storage = storage_field->type()->entity();
	var LLVMOpaqueValue* dispatch = LLVMBuildSwitch(this.backend->builder(), tag, invalid, static_cast<u32>(storage->fields().size()));
	TemplatePack& alternatives = *record->template_arguments()->arguments.data()[0].pack;
	usize index = 0;
	while (index < alternatives.elements.size()) {
		if (alternatives.elements.data()[index].type->kind() == type_kind::null_type || alternatives.elements.data()[index].type->kind() == type_kind::void_type) {
			LLVMAddCase(dispatch, LLVMConstInt(tag_type, u64(index + 1), 0), after);
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < storage->fields().size()) {
		var Entity* alternative = storage->fields().data()[index];
		var LLVMOpaqueBasicBlock* active = @this.block("variant.transfer.active");
		LLVMAddCase(dispatch, LLVMConstInt(tag_type, alternative->integer() + 1, 0), active);
		LLVMPositionBuilderAtEnd(this.backend->builder(), active);
		if (source) {
			if (assign) {
				if (!(@this.copy_assign(alternative->type(), output, input)).has<void>()) {
					return compilation_error();
				};
			}
			else {
				if (!(@this.copy_initialize(alternative->type(), output, input)).has<void>()) {
					return compilation_error();
				};
			};
		}
		else {
			if (!(@this.destroy(alternative->type(), output)).has<void>()) {
				return compilation_error();
			};
		};
		discard LLVMBuildBr(this.backend->builder(), after);
		@index = index + 1;
	};
	LLVMPositionBuilderAtEnd(this.backend->builder(), invalid);
	discard LLVMBuildUnreachable(this.backend->builder());
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	if (source && !assign) {
		discard LLVMBuildStore(this.backend->builder(), tag, output_tag);
	};
};

fn FunctionEmitter::generated_variant(var FunctionEmitter& this, var Entity* function, Type* type, var LLVMOpaqueValue* destination) -> CompilationResult {
	if (function->role() == function_role::constructor && function->parameters().size() == 1) {
		var Entity* record = type->entity();
		TemplatePack& alternatives = *record->template_arguments()->arguments.data()[0].pack;
		if (!alternatives.elements.size()) {
			return @this.backend->error(function->token(), "variant default construction requires a first alternative");
		};
		var Entity* storage_field = record->find_member("_storage");
		var Entity* tag_field = record->find_member("_index");
		var LLVMOpaqueType* native = @this.backend->type(type, function->token());
		var LLVMOpaqueType* tag_type = @this.backend->type(tag_field->type(), tag_field->token());
		if (!native || !tag_type) {
			return compilation_error();
		};
		Type* first = alternatives.elements.data()[0].type;
		if (first->kind() != type_kind::null_type && first->kind() != type_kind::void_type) {
			var LLVMOpaqueValue* payload = LLVMBuildStructGEP2(this.backend->builder(), native, destination, this.backend->field_index(record, storage_field->index()), "variant.default.payload\0".data());
			if (!(@this.initialize(first, payload)).has<void>()) {
				return compilation_error();
			};
		};
		var LLVMOpaqueValue* tag = LLVMBuildStructGEP2(this.backend->builder(), native, destination, this.backend->field_index(record, tag_field->index()), "variant.default.tag\0".data());
		discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(tag_type, 1, 0), tag);
	}
	else if (function->role() == function_role::destructor) {
		if (!(@this.variant_transfer(type, destination, nullptr, false)).has<void>()) {
			return compilation_error();
		};
	}
	else {
		if (function->parameters().size() != 2) {
			return @this.backend->error(function->token(), "variant special member requires one source object");
		};
		var Entity* parameter = function->parameters().data()[1];
		bool copy = parameter->type()->kind() == type_kind::reference;
		var LLVMOpaqueValue* source = this.storage(parameter);
		if (copy) {
			@source = LLVMGetParam(this.function, 1);
		};
		var LLVMOpaqueBasicBlock* complete;
		var LLVMOpaqueValue* replacement;
		usize unwind_begin = this.unwinds.size();
		if (function->role() == function_role::assignment) {
			var LLVMOpaqueBasicBlock* replace = @this.block("variant.assign.replace");
			@complete = @this.block("variant.assign.complete");
			if (copy) {
				discard LLVMBuildBr(this.backend->builder(), replace);
			}
			else {
				discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 32, destination, source, "variant.same.object\0".data()), complete, replace);
			};
			LLVMPositionBuilderAtEnd(this.backend->builder(), replace);
			if (copy) {
				var Entity* tag_field = type->entity()->find_member("_index");
				var LLVMOpaqueType* native = @this.backend->type(type, function->token());
				var LLVMOpaqueType* tag_type = @this.backend->type(tag_field->type(), tag_field->token());
				u32 field_index = this.backend->field_index(type->entity(), tag_field->index());
				var LLVMOpaqueValue* output_tag = LLVMBuildStructGEP2(this.backend->builder(), native, destination, field_index, "variant.assign.target.tag.address\0".data());
				var LLVMOpaqueValue* input_tag = LLVMBuildStructGEP2(this.backend->builder(), native, source, field_index, "variant.assign.source.tag.address\0".data());
				var LLVMOpaqueValue* left = LLVMBuildLoad2(this.backend->builder(), tag_type, output_tag, "variant.assign.target.tag\0".data());
				var LLVMOpaqueValue* right = LLVMBuildLoad2(this.backend->builder(), tag_type, input_tag, "variant.assign.source.tag\0".data());
				var LLVMOpaqueBasicBlock* assign = @this.block("variant.assign.active");
				var LLVMOpaqueBasicBlock* reconstruct = @this.block("variant.assign.reconstruct");
				discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 32, left, right, "variant.same.alternative\0".data()), assign, reconstruct);
				LLVMPositionBuilderAtEnd(this.backend->builder(), assign);
				if (!(@this.variant_transfer(type, destination, source, true)).has<void>()) {
					return compilation_error();
				};
				discard LLVMBuildBr(this.backend->builder(), complete);
				LLVMPositionBuilderAtEnd(this.backend->builder(), reconstruct);
				@replacement = @this.slot(type);
				if (!replacement || !(@this.variant_transfer(type, replacement, source, false)).has<void>()) {
					return compilation_error();
				};
				@this.retain_unwind(type, replacement, nullptr, nullptr);
			};
			if (!(@this.variant_transfer(type, destination, nullptr, false)).has<void>()) {
				return compilation_error();
			};
		};
		if (replacement) {
			if (!(@this.copy_representation(type, destination, replacement)).has<void>()) {
				return compilation_error();
			};
			@this.forget_unwinds(unwind_begin);
		}
		else if (copy) {
			if (!(@this.variant_transfer(type, destination, source, false)).has<void>()) {
				return compilation_error();
			};
		}
		else {
			if (!(@this.copy_representation(type, destination, source)).has<void>()) {
				return compilation_error();
			};
			@this.binding_live(parameter, false);
		};
		if (complete) {
			discard LLVMBuildBr(this.backend->builder(), complete);
			LLVMPositionBuilderAtEnd(this.backend->builder(), complete);
		};
	};
	if (!(@this.cleanup_bindings(0)).has<void>()) {
		return compilation_error();
	};
	if (this.result->kind() == type_kind::void_type) {
		discard LLVMBuildRetVoid(this.backend->builder());
	}
	else if (this.result->kind() == type_kind::reference) {
		discard LLVMBuildRet(this.backend->builder(), destination);
	}
	else {
		discard LLVMBuildRet(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), @this.backend->type(this.result, function->token()), destination, "variant.result\0".data()));
	};
};

struct analysis_cancelled_error {};

using AnalysisResult = void | compilation_error | analysis_cancelled_error;


struct EditorTemplateSelection {
	rt::string path;
	usize anchor;
	rt::string arguments;
	SourceFile input;
	rt::unique<Syntax> syntax;
	rt::string label;
};

struct Analysis {
	fn Analysis(var Analysis& this) : [default];
	fn Analysis(var Analysis& this, var NativeFile* output);

	fn set_progress(var Analysis& this, CompilerProgress progress);
	fn enable_tests(var Analysis& this);
	fn add_source(var Analysis& this, rt::string_view path, rt::string_view text);
	fn load_source(var Analysis& this, rt::string_view path, FileOpener opener) -> CompilationResult;
	fn set_source_module(var Analysis& this, usize index, rt::string_view name, i32 access);
	fn analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult;
	fn request_template_context(var Analysis& this, rt::string_view path, usize anchor, rt::string_view arguments);
	fn template_context_label(Analysis& this) -> rt::string_view;
	fn analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult;

	fn source_count(Analysis& this) -> usize;
	fn source_path(Analysis& this, usize index) -> rt::string_view;
	fn syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>&;
	fn source_tokens(Analysis& this, usize index) -> rt::buffer<Token>*;
	fn source_comments(Analysis& this, usize index) -> rt::buffer<Token>*;
	fn primitive_name(Analysis& this, rt::string_view name) -> bool;
	fn source_text(Analysis& this, usize index) -> rt::string_view;
	fn semantics(Analysis& this) -> SemanticUnit*;
	fn diagnostics(Analysis& this) -> Diagnostics&;
	fn navigation(Analysis& this) -> NavigationIndex&;
	fn pointer_bits(Analysis& this) -> u32;

private:
	fn analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> AnalysisResult;

	rt::unique<EditorTemplateSelection> template_selection;
	CompilerProgress progress;
	SourceManager sources;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax;
	rt::unique<SemanticUnit> semantic_unit;
	Diagnostics messages;
	NavigationIndex index;
	u32 target_pointer_bits;
	bool tests_enabled;
};

fn Analysis::Analysis(var Analysis& this, var NativeFile* output) {
	@this.messages = Diagnostics($output);
};

fn Analysis::add_source(var Analysis& this, rt::string_view path, rt::string_view text) {
	var SourceFile* source = @this.sources.add(path, text);
	@this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::set_source_module(var Analysis& this, usize index, rt::string_view name, i32 access) {
	var SourceFile* source = @this.sources.at(index);
	if (!source) {
		compiler_panic("source module references an invalid source index");
	};
	@source->set_module(name, $access);
};

fn Analysis::load_source(var Analysis& this, rt::string_view path, FileOpener opener) -> CompilationResult {
	var reader = SourceReader($opener, @this.sources, @this.messages);
	var read = @reader.load(path);
	if (read.has<source_io_error>()) {
		return compilation_error();
	};
	var SourceFile* source = read.get<var SourceFile*>();
	@this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::source_count(Analysis& this) -> usize {
	return this.sources.count();
};

fn Analysis::source_path(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->path();
};

fn Analysis::source_text(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->text();
};

fn Analysis::semantics(Analysis& this) -> SemanticUnit* {
	return this.semantic_unit.get();
};

fn Analysis::diagnostics(Analysis& this) -> Diagnostics& {
	return this.messages;
};

fn Analysis::navigation(Analysis& this) -> NavigationIndex& {
	return this.index;
};

fn Analysis::pointer_bits(Analysis& this) -> u32 {
	return this.target_pointer_bits;
};

fn Analysis::source_tokens(Analysis& this, usize index) -> rt::buffer<Token>* {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return nullptr;
	};
	return &@source->tokens();
};

fn Analysis::source_comments(Analysis& this, usize index) -> rt::buffer<Token>* {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return nullptr;
	};
	return &@source->comments();
};

fn Analysis::primitive_name(Analysis& this, rt::string_view name) -> bool {
	return this.types.find_primitive(name) != nullptr;
};

fn Analysis::syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>& {
	return this.syntax;
};

fn Analysis::request_template_context(var Analysis& this, rt::string_view path, usize anchor, rt::string_view arguments) {
	rt::unique<EditorTemplateSelection> selection = rt::unique<EditorTemplateSelection>::make();
	@selection.get()->path = rt::string(path);
	@selection.get()->anchor = $anchor;
	@selection.get()->arguments = rt::string(arguments);
	@this.template_selection = $selection;
};

fn Analysis::template_context_label(Analysis& this) -> rt::string_view {
	if (!this.template_selection.get()) {
		return rt::string_view();
	};
	return this.template_selection.get()->label.view();
};

fn Analysis::set_progress(var Analysis& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn Analysis::enable_tests(var Analysis& this) {
	@this.tests_enabled = true;
};



struct RuntimeMutex;
fn runtime_mutex_create() -> var RuntimeMutex*;
fn runtime_mutex_destroy(var RuntimeMutex* mutex);
fn runtime_mutex_lock(var RuntimeMutex* mutex);
fn runtime_mutex_unlock(var RuntimeMutex* mutex);

struct stale_analysis_error {};

using AnalysisExpectation = void | stale_analysis_error;

struct Compiler;

struct ModuleSource {
	rt::string path;
	rt::string module_name;
	i32 access;
};

struct CompilerOperation {
	fn CompilerOperation(var CompilerOperation& this, var Compiler& compiler);
	fn CompilerOperation(var CompilerOperation& this, CompilerOperation& other) : [delete];
	fn CompilerOperation(var CompilerOperation& this, CompilerOperation other) : [delete];
	fn ~CompilerOperation(var CompilerOperation& this);

private:
	var Compiler* compiler;
};

enum analysis_publication : [u08] {
	published;
	obsolete;
};

struct PublishedAnalysis {
	rt::unique<Analysis> analysis;
	usize readers;
	usize owners;
};

struct TargetAnalysis {
	rt::string key;
	u64 expected_revision;
	u64 published_revision;
	var PublishedAnalysis* published;
};

struct AnalysisLease {
	fn AnalysisLease(var AnalysisLease& this) : [default];
	fn AnalysisLease(var AnalysisLease& this, AnalysisLease& other) : [delete];
	fn operator=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn operator:=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry, u64 revision);
	fn ~AnalysisLease(var AnalysisLease& this);

	fn get(AnalysisLease& this) -> Analysis*;
	fn value(AnalysisLease& this) -> Analysis&;
	fn revision(AnalysisLease& this) -> u64;

private:
	var Compiler* owner;
	var PublishedAnalysis* entry;
	u64 published_revision;
};

struct Compilation {
	fn Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output, CompilerProgress progress);
	fn run(var Compilation& this, rt::string_view output_path, rt::string_view entry, i32 optimization, output_kind kind) -> CompilationResult;

private:
	CompilerProgress progress;
	Analysis* analysis;
	FileOpener opener;
	Diagnostics diagnostics;
	rt::unique<Backend> backend;

	fn failure(var Compilation& this, rt::string_view message) -> CompilationResult;
	fn output_failure(var Compilation& this, rt::string_view operation, rt::string_view path) -> CompilationResult;
};

struct Compiler {
	fn Compiler(var Compiler& this);
	fn ~Compiler(var Compiler& this);
	fn begin_operation(var Compiler& this);
	fn end_operation(var Compiler& this);

	fn set_progress(var Compiler& this, CompilerProgress progress);
	fn clear_modules(var Compiler& this);
	fn add_module_source(var Compiler& this, rt::string_view path, rt::string_view name, i32 access);
	fn next_editor_revision(var Compiler& this) -> u64;
	fn expect_target(var Compiler& this, rt::string_view key, u64 revision) -> AnalysisExpectation;
	fn publish_target(var Compiler& this, rt::string_view key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication;
	fn publish_target_alias(var Compiler& this, rt::string_view key, u64 revision, Analysis& analysis) -> analysis_publication;
	fn acquire_target(var Compiler& this, rt::string_view key) -> AnalysisLease;
	fn acquire_current_target(var Compiler& this, rt::string_view key) -> AnalysisLease;
	fn emit_target(var Compiler& this, rt::string_view key, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult;

	fn publish(var Compiler& this, rt::unique<Analysis> analysis);
	fn acquire_analysis(var Compiler& this) -> AnalysisLease;
	fn release_analysis(var Compiler& this, var PublishedAnalysis& entry);
	fn emit_current(var Compiler& this, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult;
	fn compile_sources(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::buffer<rt::string_view>& texts, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult;
	fn compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult;

private:
	fn collect_retired(var Compiler& this);
	fn finish_compilation(var Compiler& this, rt::unique<Analysis> analysis, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult;

	CompilerProgress progress;
	rt::buffer<ModuleSource> module_sources;
	var RuntimeMutex* operation_mutex;
	var RuntimeMutex* publication_mutex;
	u64 editor_revision;
	rt::unordered_map<rt::string_view, rt::unique<TargetAnalysis>> targets;
	rt::buffer<rt::unique<PublishedAnalysis>> publications;
};

fn CompilerOperation::CompilerOperation(var CompilerOperation& this, var Compiler& compiler) {
	@this.compiler = &@compiler;
	@compiler.begin_operation();
};

fn CompilerOperation::~CompilerOperation(var CompilerOperation& this) {
	@this.compiler->end_operation();
};


fn AnalysisLease::AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry, u64 revision) {
	@this.owner = &@owner;
	@this.entry = $entry;
	@this.published_revision = $revision;
};

fn AnalysisLease::~AnalysisLease(var AnalysisLease& this) {
	if (this.owner && this.entry) {
		@this.owner->release_analysis(@*this.entry);
	};
};

fn AnalysisLease::get(AnalysisLease& this) -> Analysis* {
	if (!this.entry) {
		return nullptr;
	};

	return this.entry->analysis.get();
};

fn AnalysisLease::value(AnalysisLease& this) -> Analysis& {
	return *this.get();
};

fn Compiler::Compiler(var Compiler& this) {
	@this.operation_mutex = runtime_mutex_create();
	if (!this.operation_mutex) {
		throw rt::allocation_error();
	};
	@this.publication_mutex = runtime_mutex_create();
	if (!this.publication_mutex) {
		runtime_mutex_destroy(this.operation_mutex);
		@this.operation_mutex = nullptr;
		throw rt::allocation_error();
	};
	@this.editor_revision = 0;
};

fn Compiler::~Compiler(var Compiler& this) {
	runtime_mutex_destroy(this.publication_mutex);
	runtime_mutex_destroy(this.operation_mutex);
};

fn Compiler::begin_operation(var Compiler& this) {
	runtime_mutex_lock(this.operation_mutex);
};

fn Compiler::end_operation(var Compiler& this) {
	runtime_mutex_unlock(this.operation_mutex);
};

fn AnalysisLease::revision(AnalysisLease& this) -> u64 {
	return this.published_revision;
};

fn Compiler::next_editor_revision(var Compiler& this) -> u64 {
	runtime_mutex_lock(this.publication_mutex);
	@this.editor_revision = this.editor_revision + 1;
	u64 revision = this.editor_revision;
	runtime_mutex_unlock(this.publication_mutex);
	return $revision;
};

fn Compiler::expect_target(var Compiler& this, rt::string_view key, u64 revision) -> AnalysisExpectation {

	rt::unique<TargetAnalysis> fresh = rt::unique<TargetAnalysis>::make();
	@fresh.get()->key.append(key);
	@fresh.get()->expected_revision = revision;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (found) {
		if (revision < found->get()->expected_revision) {
			runtime_mutex_unlock(this.publication_mutex);
			return stale_analysis_error();
		};
		@found->get()->expected_revision = revision;
		runtime_mutex_unlock(this.publication_mutex);
		return;
	};

	var owned_key = fresh.get()->key.view();
	bool inserted = false;
	try {
		@inserted = @this.targets.insert(owned_key, $fresh);
	}
	catch (rt::allocation_error& error) {
		runtime_mutex_unlock(this.publication_mutex);
		throw rt::allocation_error(error);
	};
	runtime_mutex_unlock(this.publication_mutex);
	if (!inserted) {
		compiler_panic("target is already registered");
	};
};

fn Compiler::publish_target(var Compiler& this, rt::string_view key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication {
	if (!analysis.get()) {
		compiler_panic("cannot publish an empty analysis");
	};

	rt::unique<PublishedAnalysis> next = rt::unique<PublishedAnalysis>::make();
	@next.get()->analysis = $analysis;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (!found) {
		runtime_mutex_unlock(this.publication_mutex);
		compiler_panic("analysis publication requires a registered target and retained analysis");
	};

	var TargetAnalysis* target = found->get();
	if (target->expected_revision != revision) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::obsolete;
	};

	usize slot = 0;
	while (slot < this.publications.size() && this.publications.data()[slot].get()) {
		@slot = slot + 1;
	};
	if (slot == this.publications.size()) {
		try {
			@this.publications.reserve(slot + 1);
			@this.publications.push_back(rt::unique<PublishedAnalysis>());
		}
		catch (rt::allocation_error& error) {
			runtime_mutex_unlock(this.publication_mutex);
			throw rt::allocation_error(error);
		};
	};
	var rt::unique<PublishedAnalysis>* entries = (@this.publications).data();
	@next.get()->owners = 1;
	var PublishedAnalysis* published = next.get();
	@entries[slot].reset(@next.release());
	if (target->published) {
		if (target->published->owners) {
			@target->published->owners = target->published->owners - 1;
		};
	};
	@target->published = $published;
	@target->published_revision = revision;
	runtime_mutex_unlock(this.publication_mutex);
	@this.collect_retired();
	return analysis_publication::published;
};

fn Compiler::publish_target_alias(var Compiler& this, rt::string_view key, u64 revision, Analysis& analysis) -> analysis_publication {
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (!found) {
		runtime_mutex_unlock(this.publication_mutex);
		compiler_panic("analysis publication requires a registered target and retained analysis");
	};
	var TargetAnalysis* target = found->get();
	if (target->expected_revision != revision) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::obsolete;
	};
	var PublishedAnalysis* shared = nullptr;
	usize index = 0;
	while (index < this.publications.size()) {
		var PublishedAnalysis* candidate = this.publications.data()[index].get();
		if (candidate && candidate->analysis.get() == &@analysis) {
			@shared = $candidate;
			break;
		};
		@index = index + 1;
	};
	if (!shared) {
		runtime_mutex_unlock(this.publication_mutex);
		compiler_panic("analysis publication requires a registered target and retained analysis");
	};
	@shared->owners = shared->owners + 1;
	if (target->published && target->published->owners) {
		@target->published->owners = target->published->owners - 1;
	};
	@target->published = $shared;
	@target->published_revision = revision;
	runtime_mutex_unlock(this.publication_mutex);
	@this.collect_retired();
	return analysis_publication::published;
};

fn Compiler::publish(var Compiler& this, rt::unique<Analysis> analysis) {
	var key = rt::string_view();
	if (!(@this.expect_target(key, 0)).has<void>()) {
		compiler_panic("default analysis publication has an unexpected revision");
	};
	if (@this.publish_target(key, 0, $analysis) == analysis_publication::obsolete) {
		compiler_panic("default analysis publication became obsolete");
	};
};

fn Compiler::acquire_target(var Compiler& this, rt::string_view key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	u64 revision = 0;
	if (found) {
		@entry = found->get()->published;
		@revision = found->get()->published_revision;
	};

	if (entry) {
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry, $revision);
};

fn Compiler::acquire_current_target(var Compiler& this, rt::string_view key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	u64 revision = 0;
	if (found && found->get()->published && found->get()->expected_revision == found->get()->published_revision) {
		@entry = found->get()->published;
		@revision = found->get()->published_revision;
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry, $revision);
};

fn Compiler::acquire_analysis(var Compiler& this) -> AnalysisLease {
	return @this.acquire_target(rt::string_view());
};

fn Compiler::release_analysis(var Compiler& this, var PublishedAnalysis& entry) {
	runtime_mutex_lock(this.publication_mutex);
	if (entry.readers) {
		@entry.readers = entry.readers - 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
};

fn Compiler::collect_retired(var Compiler& this) {
	while (true) {
		rt::unique<PublishedAnalysis> garbage;
		runtime_mutex_lock(this.publication_mutex);
		usize index = 0;
		while (index < this.publications.size()) {
			var PublishedAnalysis* entry = this.publications.data()[index].get();
			if (entry && !entry->owners && !entry->readers) {
				var rt::unique<PublishedAnalysis>* entries = (@this.publications).data();
				@garbage.reset(@entries[index].release());
				break;
			};
			@index = index + 1;
		};
		runtime_mutex_unlock(this.publication_mutex);
		if (!garbage.get()) {
			break;
		};
		@garbage.reset(nullptr);
	};
};

fn Compilation::Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output, CompilerProgress progress) {
	@this.progress = $progress;
	@this.opener = $opener;
	@this.analysis = &@analysis;
	@this.diagnostics = Diagnostics($output);
};

fn Compilation::failure(var Compilation& this, rt::string_view message) -> CompilationResult {
	if (!this.diagnostics.failed()) {
		Token location;
		@this.diagnostics.error(location, message);
	};

	return compilation_error();
};

fn Compilation::output_failure(var Compilation& this, rt::string_view operation, rt::string_view path) -> CompilationResult {
	var message = DiagnosticMessage();
	@message.text(operation);
	@message.text(" native object output ");
	@message.quoted(path);
	Token location;

	if (this.diagnostics.failed()) {
		@this.diagnostics.note(location, message.view());
	}
	else {
		@this.diagnostics.error(location, message.view());
	};

	return compilation_error();
};

fn Compilation::run(var Compilation& this, rt::string_view output_path, rt::string_view entry, i32 optimization, output_kind kind) -> CompilationResult {
	if (this.analysis->diagnostics().failed() || !this.analysis->semantics()) {
		return compilation_error();
	};

	if (output_path.empty()) {
		return @this.failure("native object output path is required");
	};

	if (optimization < 0 || optimization > 3) {
		return @this.failure("optimization level must be between 0 and 3");
	};
	@this.backend = rt::unique<Backend>(new Backend(@this.diagnostics));
	if (!this.backend.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Backend);
		throw $error;
	};

	if (!(@this.backend.get()->initialize($optimization)).has<void>()) {
		if (!this.diagnostics.failed()) {
			compiler_panic("target initialization failed without a diagnostic");
		};
		return compilation_error();
	};

	if (this.backend.get()->pointer_bits() != this.analysis->pointer_bits()) {
		return @this.failure("analysis target pointer width does not match the native output target");
	};

	@this.backend.get()->set_progress(this.progress);
	if (!(@this.backend.get()->emit(*this.analysis->semantics(), entry, $kind)).has<void>()) {
		if (!this.diagnostics.failed()) {
			compiler_panic("native emission failed without a diagnostic");
		};
		return compilation_error();
	};

	var native_output_path = rt::string(output_path);
	var output = File(this.opener(native_output_path.c_str(), "wb\0".data()));
	if (!output.is_open()) {
		return @this.output_failure("cannot open", output_path);
	};

	if (!(@this.backend.get()->write(@output)).has<void>()) {
		return @this.output_failure("cannot write", output_path);
	};

	if (!(@output.close()).has<void>()) {
		return @this.output_failure("cannot close", output_path);
	};

};

fn Compiler::emit_target(var Compiler& this, rt::string_view key, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult {
	var lease = @this.acquire_current_target(key);
	if (!lease.get()) {
		var errors = Diagnostics($diagnostics);
		Token location;
		@errors.error(location, "no current target analysis is available for native emission");
		return compilation_error();
	};

	if (lease.value().diagnostics().failed()) {
		lease.value().diagnostics().replay(diagnostics);
		return compilation_error();
	};

	var compilation = Compilation(lease.value(), &platform_open_utf8_file, $diagnostics, this.progress);
	return @compilation.run(output_path, entry, $optimization, $kind);
};

fn Compiler::emit_current(var Compiler& this, rt::string_view output_path, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult {
	return @this.emit_target(rt::string_view(), output_path, entry, $optimization, $diagnostics, $kind);
};

fn Compiler::compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult {
	var errors = Diagnostics(diagnostics);
	Token location;

	if (!paths.size()) {
		@errors.error(location, "no source files");
		return compilation_error();
	};

	if (output_path.empty()) {
		@errors.error(location, "native object output path is required");
		return compilation_error();
	};

	var analysis = rt::unique<Analysis>(new Analysis(diagnostics));
	if (!analysis.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Analysis);
		throw $error;
	};

	@analysis.get()->set_progress(this.progress);
	this.progress.report("reading", 0, paths.size(), "");
	usize index = 0;
	while (index < paths.size()) {
		rt::string_view path := paths.data()[index];

		if (path.empty() || path == output_path) {
			@errors.error(location, "output cannot overwrite a source file");
			return compilation_error();
		};
		if (!(@analysis.get()->load_source(path, opener)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
		this.progress.report("reading", index, paths.size(), path);
	};

	return @this.finish_compilation($analysis, output_path, $opener, entry, $optimization, $diagnostics, $kind);
};

fn Compiler::finish_compilation(var Compiler& this, rt::unique<Analysis> analysis, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult {
	var errors = Diagnostics(diagnostics);
	Token location;
	if (kind == output_kind::tests) {
		@analysis.get()->enable_tests();
	};
	if (!(@analysis.get()->analyze(static_cast<u32>(sizeof(usize) * 8), nullptr, nullptr)).has<void>()) {
		@this.publish($analysis);
		return compilation_error();
	};

	var compilation = Compilation(*analysis.get(), opener, diagnostics, this.progress);
	var result = @compilation.run(output_path, entry, $optimization, $kind);

	@this.publish($analysis);

	return $result;
};

fn Compiler::set_progress(var Compiler& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn Compiler::clear_modules(var Compiler& this) {
	@this.module_sources.clear();
};

fn Compiler::add_module_source(var Compiler& this, rt::string_view path, rt::string_view name, i32 access) {
	ModuleSource source;
	@source.path = rt::string(path);
	@source.module_name = rt::string(name);
	@source.access = $access;
	@this.module_sources.push_back($source);
};

fn Compiler::compile_sources(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::buffer<rt::string_view>& texts, rt::string_view output_path, FileOpener opener, rt::string_view entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> CompilationResult {
	var errors = Diagnostics(diagnostics);
	Token location;
	if (!paths.size() || paths.size() != texts.size()) {
		@errors.error(location, "source paths and source texts must have matching nonzero counts");
		return compilation_error();
	};
	if (output_path.empty()) {
		@errors.error(location, "native object output path is required");
		return compilation_error();
	};
	var operation = CompilerOperation(@this);
	var analysis = rt::unique<Analysis>(new Analysis(diagnostics));
	if (!analysis.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Analysis);
		throw $error;
	};
	@analysis.get()->set_progress(this.progress);
	this.progress.report("reading", 0, paths.size(), "");
	usize index = 0;
	while (index < paths.size()) {
		rt::string_view path := paths.data()[index];
		if (path.empty() || path == output_path) {
			@errors.error(location, "output cannot overwrite a source file");
			return compilation_error();
		};
		@analysis.get()->add_source(path, texts.data()[index]);
		usize module_index = 0;
		while (module_index < this.module_sources.size()) {
			ModuleSource& source = this.module_sources.data()[module_index];
			if (source.path.view() == path) {
				@analysis.get()->set_source_module(index, source.module_name.view(), source.access);
			};
			@module_index = module_index + 1;
		};
		@index = index + 1;
		this.progress.report("reading", index, paths.size(), path);
	};
	return @this.finish_compilation($analysis, output_path, $opener, entry, $optimization, $diagnostics, $kind);
};


fn fprintf(var NativeFile* file, char* format, ...) -> i32;

struct compilation_error {
};

using CompilationResult = void | compilation_error;

struct compiler_internal_error {
	rt::string message;
};

fn compiler_panic(rt::string_view message) {
	compiler_internal_error error;
	@error.message = rt::string(message);
	throw $error;
};

enum diagnostic_state : [u08] {
	clean;
	failed;
};

enum diagnostic_message_state : [u08] {
	complete;
	unavailable;
};

struct DiagnosticMessage {
	fn text(var DiagnosticMessage& this, rt::string_view value);
	fn quoted(var DiagnosticMessage& this, rt::string_view value);
	fn number(var DiagnosticMessage& this, u64 value);
	fn view(DiagnosticMessage& this) -> rt::string_view;

private:
	rt::string contents;
	diagnostic_message_state state;
};

struct DiagnosticNote {
	Token location;
	rt::string message;
};

struct DiagnosticRecord {
	Token location;
	rt::string message;
	rt::buffer<DiagnosticNote> notes;
};

struct Diagnostics {
	fn Diagnostics(var Diagnostics& this) : [default];
	fn Diagnostics(var Diagnostics& this, var NativeFile* output);

	fn error(var Diagnostics& this, Token& location, rt::string_view message);
	fn syntax_error(var Diagnostics& this, Token& location, rt::string_view message);
	fn note(var Diagnostics& this, Token& location, rt::string_view message);
	fn replay(Diagnostics& this, var NativeFile* output);
	fn records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>&;
	fn set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context);
	fn cancelled(Diagnostics& this) -> bool;

	fn failed(Diagnostics& this) -> bool;

private:
	var NativeFile* output;
	diagnostic_state state;
	rt::buffer<DiagnosticRecord> messages;
	((var void*) -> i32)* cancellation;
	var void* cancellation_context;

	fn write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view severity, rt::string_view message);
};

fn DiagnosticMessage::text(var DiagnosticMessage& this, rt::string_view value) {
	if (this.state == diagnostic_message_state::complete) {
		@this.contents.append(value);
	};
};

fn DiagnosticMessage::quoted(var DiagnosticMessage& this, rt::string_view value) {
	@this.text("'");
	usize index = 0;
	while (index < value.size()) {
		char byte = value.data()[index];
		if (byte == '\n') {
			@this.text("\\n");
		}
		else if (byte == '\r') {
			@this.text("\\r");
		}
		else if (byte == '\t') {
			@this.text("\\t");
		}
		else if (byte == '\0') {
			@this.text("\\0");
		}
		else if (byte == '\\' || byte == '\'') {
			@this.text("\\");
			@this.text(rt::string_view(&@byte, 1));
		}
		else {
			@this.text(rt::string_view(&@byte, 1));
		};
		@index = index + 1;
	};
	@this.text("'");
};

fn DiagnosticMessage::number(var DiagnosticMessage& this, u64 value) {
	char[20] digits;
	usize begin = sizeof(digits);
	while (true) {
		@begin = begin - 1;
		@digits[begin] = static_cast<char>(value % 10 + static_cast<u64>('0'));
		@value = value / 10;
		if (!value) {
			break;
		};
	};
	@this.text(rt::string_view(&@digits[begin], sizeof(digits) - begin));
};

fn DiagnosticMessage::view(DiagnosticMessage& this) -> rt::string_view {
	if (this.state == diagnostic_message_state::unavailable) {
		return "cannot format diagnostic: insufficient memory";
	};
	return this.contents.view();
};

fn Diagnostics::Diagnostics(var Diagnostics& this, var NativeFile* output) {
	@this.output = $output;
};

fn Diagnostics::failed(Diagnostics& this) -> bool {
	return this.state == diagnostic_state::failed || this.cancelled();
};

fn Diagnostics::error(var Diagnostics& this, Token& location, rt::string_view message) {
	@this.state = diagnostic_state::failed;
	DiagnosticRecord record;
	@record.location := location;
	@record.message.append(message);
	@this.messages.push_back($record);
	this.write(this.output, location, "error", message);
};

fn Diagnostics::note(var Diagnostics& this, Token& location, rt::string_view message) {
	if (!this.messages.size()) {
		return;
	};
	DiagnosticNote note;
	@note.location := location;
	@note.message.append(message);
	var DiagnosticRecord* records = @this.messages.data();
	var DiagnosticRecord& record = @records[this.messages.size() - 1];
	@record.notes.push_back($note);
	this.write(this.output, location, "note", message);
};

fn Diagnostics::records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>& {
	return this.messages;
};

fn Diagnostics::set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context) {
	@this.cancellation = $callback;
	@this.cancellation_context = $context;
};

fn Diagnostics::cancelled(Diagnostics& this) -> bool {
	return this.cancellation && this.cancellation(this.cancellation_context) != 0;
};

fn Diagnostics::write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view severity, rt::string_view message) {

	if (!output) {
		return;
	};

	var path = "<compiler>";

	if (location.source) {
		@path = location.source->path();
	};

	usize path_size = path.size();
	usize message_size = message.size();

	if (path_size > static_cast<usize>(i32::max)) {
		@path_size = static_cast<usize>(i32::max);
	};

	if (message_size > static_cast<usize>(i32::max)) {
		@message_size = static_cast<usize>(i32::max);
	};

	discard fprintf(output, "%.*s:%llu:%llu: %.*s: %.*s\n\0".data(), static_cast<i32>($path_size), path.data(), u64(location.line), u64(location.column), static_cast<i32>(severity.size()), severity.data(), static_cast<i32>($message_size), message.data());
};

fn Diagnostics::replay(Diagnostics& this, var NativeFile* output) {
	usize index = 0;
	while (index < this.messages.size()) {
		DiagnosticRecord& record = this.messages.data()[index];
		this.write(output, record.location, "error", record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			DiagnosticNote& related = record.notes.data()[note];
			this.write(output, related.location, "note", related.message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
};

fn Diagnostics::syntax_error(var Diagnostics& this, Token& location, rt::string_view message) {
	var rendered = DiagnosticMessage();
	@rendered.text(message);
	if (location.source) {
		if (location.kind == token_kind::eof) {
			@rendered.text("; found end of file");
		}
		else if (location.length) {
			@rendered.text("; found ");
			@rendered.quoted(location.text());
		};
	};
	@this.error(location, rendered.view());
};

struct NativeFile;

struct file_io_error {
	rt::string_view operation;
};

using FileResult = void | file_io_error;
using FileReadResult = usize | file_io_error;

fn platform_open_utf8_file(const char* path, const char* mode) -> var NativeFile*;
fn fclose(var NativeFile* file) -> i32;
fn fread(var void* destination, usize size, usize count, var NativeFile* file) -> usize;
fn fwrite(const void* source, usize size, usize count, var NativeFile* file) -> usize;
fn ferror(var NativeFile* file) -> i32;

using FileOpener = ((const char*, const char*) -> var NativeFile*)*;

struct FileCloser {
	fn dispose(var NativeFile* file);
};

struct File {
	fn File(var File& this, var NativeFile* file);
	fn File(var File& this, const File& other) : [delete];
	fn File(var File& this, File other) : [default];

	fn operator=(var File& this, const File& other) -> var File& : [delete];
	fn operator=(var File& this, File other) -> var File& : [default];
	fn read(var File& this, var char* destination, usize capacity) -> FileReadResult;
	fn write(var File& this, rt::string_view bytes) -> FileResult;
	fn close(var File& this) -> FileResult;

	fn is_open(const File& this) -> bool;
	fn failed(const File& this) -> bool;

private:
	rt::unique<NativeFile, FileCloser> handle;
};

fn FileCloser::dispose(var NativeFile* file) {
	if (file) {
		discard fclose($file);
	};
};

fn File::File(var File& this, var NativeFile* file) {
	@this.handle = rt::unique<NativeFile, FileCloser>($file);
};

fn File::is_open(const File& this) -> bool {
	return this.handle.get() != nullptr;
};

fn File::failed(const File& this) -> bool {
	return !this.handle.get() || ferror(this.handle.get());
};

fn File::read(var File& this, var char* destination, usize capacity) -> FileReadResult {
	if (!this.handle.get()) {
		return file_io_error("cannot read a closed file");
	};
	usize count = fread($destination, 1, $capacity, this.handle.get());
	if (ferror(this.handle.get())) {
		return file_io_error("cannot read");
	};
	return $count;
};

fn File::write(var File& this, rt::string_view bytes) -> FileResult {
	if (!this.handle.get() || fwrite(bytes.data(), 1, bytes.size(), this.handle.get()) != bytes.size()) {
		return file_io_error("cannot write");
	};
};

fn File::close(var File& this) -> FileResult {
	var NativeFile* handle = @this.handle.release();

	if (!handle) {
		return;
	};

	if (fclose($handle)) {
		return file_io_error("cannot close");
	};
};

fn fopen(char* path, char* mode) -> var NativeFile*;

fn platform_standard_error() -> var NativeFile*;

fn report_compiler_internal_error(compiler_internal_error& error, var NativeFile* output) {
	if (!output) {
		@output = platform_standard_error();
	};
	discard fprintf(output, "internal compiler error: %s\n\0".data(), error.message.c_str());
};

fn "C" rutile_compiler_create() -> var Compiler* {
	try {
		rt::unique<Compiler> compiler = rt::unique<Compiler>::make();
		return @compiler.release();
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return nullptr;
	}
	catch (rt::allocation_error& error) {
		return nullptr;
	};
};

fn "C" rutile_compiler_destroy(var Compiler* compiler) {
	delete compiler;
};

fn "C" rutile_compiler_session(((var Compiler*, var void*) -> i32)* callback, var void* data) -> i32 {
	try {
		rt::unique<Compiler> compiler = rt::unique<Compiler>::make();


		return callback(compiler.get(), $data);
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compile(var Compiler* compiler, var char var** paths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics) -> i32 {
	try {
		if (!compiler) {
			return 1;
		};

		if (!opener) {
			@opener = &fopen;
		};

		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};

		rt::buffer<rt::string_view> source_paths;
		usize index = 0;

		while (paths && index < count) {
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@index = index + 1;
		};

		rt::string_view entry_name = "main";

		if (entry) {
			@entry_name = rt::from_c_string(entry);
		};

		var result = @compiler->compile(source_paths, rt::from_c_string(output_path), $opener, entry_name, $optimization, diagnostics, output_kind::executable);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compile_library(var char var** paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics) -> i32 {
	return rutile_compile_library_progress($paths, $count, $output_path, $opener, $optimization, $diagnostics, nullptr, nullptr);
};

fn "C" rutile_compile_library_progress(var char var** paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics, ProgressCallback callback, var void* context) -> i32 {
	try {
		Compiler compiler;
		rutile_compiler_set_progress(&@compiler, $callback, $context);

		if (!opener) {
			@opener = &fopen;
		};

		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};

		rt::buffer<rt::string_view> source_paths;
		usize index = 0;

		while (paths && index < count) {
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@index = index + 1;
		};

		var result = @compiler.compile(source_paths, rt::from_c_string(output_path), $opener, "main", $optimization, diagnostics, output_kind::library);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compiler_set_progress(var Compiler* compiler, ProgressCallback callback, var void* context) {
	if (!compiler) {
		return;
	};
	CompilerProgress progress;
	@progress.callback = $callback;
	@progress.context = $context;
	@compiler->set_progress($progress);
};

fn "C" rutile_compile_sources(var Compiler* compiler, var char var** paths, var char var** texts, usize* lengths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics, i32 library) -> i32 {
	try {
		if (!compiler || !paths || !texts || !lengths || !count) {
			return 1;
		};
		if (!opener) {
			@opener = &fopen;
		};
		if (!diagnostics) {
			@diagnostics = platform_standard_error();
		};
		rt::buffer<rt::string_view> source_paths;
		rt::buffer<rt::string_view> source_texts;
		usize index = 0;
		while (index < count) {
			if (!paths[index] || (!texts[index] && lengths[index])) {
				return 1;
			};
			@source_paths.push_back(rt::from_c_string(paths[index]));
			@source_texts.push_back(rt::string_view(texts[index], lengths[index]));
			@index = index + 1;
		};
		rt::string_view entry_name = "main";
		if (entry) {
			@entry_name = rt::from_c_string(entry);
		};
		output_kind kind = output_kind::executable;
		if (library == 1) {
			@kind = output_kind::library;
		};
		if (library == 2) {
			@kind = output_kind::tests;
		};
		var result = @compiler->compile_sources(source_paths, source_texts, rt::from_c_string(output_path), $opener, entry_name, $optimization, diagnostics, $kind);
		if (result.has<void>()) {
			return 0;
		};
		return 1;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, diagnostics);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn "C" rutile_compiler_clear_modules(var Compiler* compiler) {
	if (compiler) {
		@compiler->clear_modules();
	};
};

fn "C" rutile_compiler_add_module_source(var Compiler* compiler, char* path, char* name, i32 access) -> i32 {
	try {
		if (!compiler || !path || !name) {
			return 1;
		};
		@compiler->add_module_source(rt::from_c_string(path), rt::from_c_string(name), $access);
		return 0;
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return 3;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

fn rutile_compiler_version() -> char*;

struct InterfaceSource {
	rt::string path;
	rt::string text;
	rt::string module;
	i32 access;
};

struct interface_error {
	rt::string_view message;
};

using InterfaceResult = rt::buffer<InterfaceSource> | interface_error | rt::allocation_error;

fn invalid_interface(rt::string_view message) -> InterfaceResult {
	interface_error error;
	@error.message = message;
	return $error;
};

fn interface_allocation_failure(usize bytes) -> InterfaceResult {
	rt::allocation_error error;
	@error.requested_bytes = bytes;
	return $error;
};

fn decode_interface(rt::string_view bytes, rt::string_view compiler_version, u32 pointer_bits, bool test_access) -> InterfaceResult {
	try {
		var document = rt::json_parse(bytes);
		if (document.has<rt::allocation_error>()) {
			return document.get<rt::allocation_error>();
		};
		if (document.has<rt::json_error>()) {
			return invalid_interface("Malformed Rutile interface JSON.");
		};
		var root = document.get<rt::unique<rt::json_value>>().get();
		var format = root->member("format");
		var version = root->member("compiler");
		var bits = root->member("pointer_bits");
		var module = root->member("module");
		var declarations = root->member("declarations");
		if (!format || !bits || !version || version->kind() != rt::json_kind::string || version->text() != compiler_version) {
			return invalid_interface("Interface compiler version and target must match.");
		};
		var format_value = format->integer();
		var bits_value = bits->integer();
		if (!format_value.has<i64>() || format_value.get<i64>() != 1 || !bits_value.has<i64>() || bits_value.get<i64>() != static_cast<i64>(pointer_bits)) {
			return invalid_interface("Interface compiler version and target must match.");
		};
		if (!module || module->kind() != rt::json_kind::string || !declarations || declarations->kind() != rt::json_kind::array) {
			return invalid_interface("Interface module and declarations are required.");
		};
		rt::buffer<InterfaceSource> sources;
		for (usize index = 0; index < declarations->size(); @index = index + 1) {
			var record = declarations->item(index);
			var owner = record->member("module");
			var path = record->member("path");
			var text = record->member("text");
			if (!owner || owner->kind() != rt::json_kind::string || !path || path->kind() != rt::json_kind::string || !text || text->kind() != rt::json_kind::string) {
				return invalid_interface("Interface declarations require module, path, and text strings.");
			};
			i32 access = 1;
			if (test_access && !module->text().empty() && owner->text() == module->text()) {
				@access = 2;
			};
			bool duplicate = false;
			for (usize previous = 0; previous < sources.size(); @previous = previous + 1) {
				var InterfaceSource& existing = @((@sources).data()[previous]);
				if (existing.module == owner->text() && existing.path == path->text()) {
					if (existing.text != text->text()) {
						return invalid_interface("Conflicting versions of imported module.");
					};
					if (access > existing.access) {
						@existing.access = access;
					};
					@duplicate = true;
					break;
				};
			};
			if (duplicate) {
				continue;
			};
			InterfaceSource source;
			@source.path.append(path->text());
			@source.text.append(text->text());
			@source.module.append(owner->text());
			@source.access = access;
			@sources.push_back($source);
		};
		return $sources;
	}
	catch (rt::allocation_error& error) {
		return error;
	};
};

fn "C" rutile_decode_interface(char* bytes, usize size, char* version, u32 pointer_bits, bool test_access, ((var void*, char*, char*, usize, char*, i32) -> i32)* append, var void* context) -> i32 {
	try {
		var result = decode_interface(rt::string_view(bytes, size), rt::from_c_string(version), pointer_bits, test_access);
		if (result.has<interface_error>()) {
			return 1;
		};
		if (result.has<rt::allocation_error>()) {
			return 2;
		};
		rt::buffer<InterfaceSource>& sources = result.get<rt::buffer<InterfaceSource>>();
		for (usize index = 0; index < sources.size(); @index = index + 1) {
			InterfaceSource& source = sources.data()[index];
			if (!append(context, source.path.c_str(), source.text.c_str(), source.text.size(), source.module.c_str(), source.access)) {
				return 2;
			};
		};
		return 0;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

using InterfaceEncoding = rt::string | interface_error | rt::allocation_error;

fn encode_interface(rt::string_view module, rt::buffer<InterfaceSource>& sources, rt::string_view compiler_version, u32 pointer_bits) -> InterfaceEncoding {
	try {
		var root = rt::json_value::make_object();
		var declarations = rt::json_value::make_array();
		rt::allocation_error failure;
		for (usize index = 0; index < sources.size(); @index = index + 1) {
			InterfaceSource& source = sources.data()[index];
			var record = rt::json_value::make_object();
			@record.get()->set("path", rt::json_value::make_string(source.path));
			@record.get()->set("text", rt::json_value::make_string(source.text));
			@record.get()->set("module", rt::json_value::make_string(source.module));
			@declarations.get()->append($record);
		};
		@root.get()->set("format", rt::json_value::make_integer(1));
		@root.get()->set("compiler", rt::json_value::make_string(compiler_version));
		@root.get()->set("pointer_bits", rt::json_value::make_unsigned(u64(pointer_bits)));
		@root.get()->set("module", rt::json_value::make_string(module));
		@root.get()->set("declarations", $declarations);
		rt::string output;
		rt::json_write(*root.get(), @output);
		return $output;
	}
	catch (rt::allocation_error& error) {
		return error;
	}
	catch (rt::json_error& error) {
		interface_error failure;
		@failure.message = error.message;
		return $failure;
	};
};

fn "C" rutile_encode_interface(char* module, char** paths, char** texts, usize* lengths, char** owners, usize count, char* version, u32 pointer_bits, ((var void*, char*, usize) -> i32)* write, var void* context) -> i32 {
	try {
		rt::buffer<InterfaceSource> sources;
		for (usize index = 0; index < count; @index = index + 1) {
			InterfaceSource source;
			@source.path.append(rt::from_c_string(paths[index]));
			@source.text.append(rt::string_view(texts[index], lengths[index]));
			@source.module.append(rt::from_c_string(owners[index]));
			@sources.push_back($source);
		};
		var result = encode_interface(rt::from_c_string(module), sources, rt::from_c_string(version), pointer_bits);
		if (result.has<interface_error>()) {
			return 1;
		};
		if (result.has<rt::allocation_error>()) {
			return 2;
		};
		rt::string& bytes = result.get<rt::string>();
		if (!write(context, bytes.c_str(), bytes.size())) {
			return 2;
		};
		return 0;
	}
	catch (rt::allocation_error& error) {
		return 2;
	};
};

enum output_kind : [u08] {
	executable;
	library;
	tests;
};


using ProgressCallback = ((var void*, char*, usize, usize, char*) -> void)*;

struct CompilerProgress {
	fn CompilerProgress(var CompilerProgress& this) : [default];
	fn CompilerProgress(var CompilerProgress& this, CompilerProgress& other) : [implicit, default];
	fn report(CompilerProgress& this, rt::string_view phase, usize completed, usize total, rt::string_view detail);

	ProgressCallback callback;
	var void* context;
};

fn CompilerProgress::report(CompilerProgress& this, rt::string_view phase, usize completed, usize total, rt::string_view detail) {
	if (!this.callback) {
		return;
	};
	var phase_text = rt::string(phase);
	var detail_text = rt::string(detail);
	this.callback(this.context, phase_text.c_str(), $completed, $total, detail_text.c_str());
};



struct source_io_error {
	rt::string path;
	rt::string_view operation;
};

using SourceReadResult = var SourceFile* | source_io_error;

struct SourceReader {
	fn SourceReader(var SourceReader& this, FileOpener opener, var SourceManager& sources, var Diagnostics& diagnostics);

	fn load(var SourceReader& this, rt::string_view path) -> SourceReadResult;

private:
	fn error(var SourceReader& this, rt::string_view path, rt::string_view operation) -> source_io_error;
	FileOpener opener;
	var SourceManager* sources;
	var Diagnostics* diagnostics;
};

fn SourceReader::error(var SourceReader& this, rt::string_view path, rt::string_view operation) -> source_io_error {
	var message = DiagnosticMessage();
	@message.text(operation);
	@message.text(" source file ");
	@message.quoted(path);
	Token location;
	@this.diagnostics->error(location, message.view());
	return source_io_error(rt::string(path), operation);
};

fn SourceReader::SourceReader(var SourceReader& this, FileOpener opener, var SourceManager& sources, var Diagnostics& diagnostics) {
	@this.opener = $opener;
	@this.sources = &@sources;
	@this.diagnostics = &@diagnostics;
};

fn SourceReader::load(var SourceReader& this, rt::string_view path) -> SourceReadResult {
	var native_path = rt::string(path);
	var file = File(this.opener(native_path.c_str(), "rb\0".data()));

	if (!file.is_open()) {
		return @this.error(path, "cannot open");
	};

	rt::string contents;
	char[4096] chunk {};

	while (true) {
		var read = @file.read(&@chunk[0], sizeof(chunk));
		if (read.has<file_io_error>()) {
			return @this.error(path, read.get<file_io_error>().operation);
		};
		usize count = read.get<usize>();

		if (!count) {
			break;
		};

		@contents.append(rt::string_view(&@chunk[0], $count));
	};

	var closed = @file.close();
	if (closed.has<file_io_error>()) {
		return @this.error(path, closed.get<file_io_error>().operation);
	};

	var SourceFile* source = @this.sources->add(path, contents.view());

	return $source;
};

struct TestFunction {
	rt::string name;
	usize parameters;
};

struct TestRunnerSource {
	fn collect(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix, var Diagnostics& diagnostics);
	fn generate(TestRunnerSource& this, var rt::string& output);
	fn registration(TestRunnerSource& this, var rt::string& output, usize count);
	fn configuration(TestRunnerSource& this, var rt::string& output);
	fn collect_registrations(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix);

	rt::buffer<TestFunction> tests;
	rt::buffer<usize> registration_counts;
	rt::string harness;
};

fn test_source_name(var rt::string& output, Syntax& syntax) {
	if (syntax.kind() == syntax_kind::qualified_name) {
		test_source_name(@output, *syntax.left());
		@output.append("::");
		test_source_name(@output, *syntax.right());
		return;
	};
	@output.append(syntax.token().text());
};

fn test_source_number(var rt::string& output, usize value) {
	if (value >= 10) {
		test_source_number(@output, value / 10);
	};
	rt::string_view digits = "0123456789";
	@output.append(digits.slice(value % 10, 1));
};

fn TestRunnerSource::collect(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix, var Diagnostics& diagnostics) {
	if (syntax.kind() == syntax_kind::function) {
		@this.collect_registrations(syntax, prefix);
		bool test = false;
		bool harness = false;
		usize index = 0;
		while (index < syntax.declaration_attributes().size()) {
			Syntax& attribute = *syntax.declaration_attributes().data()[index].get();
			@test = test || attribute.token().is("test");
			@harness = harness || attribute.token().is("harness");
			@index = index + 1;
		};
		if (!test && !harness) {
			return;
		};
		if (!syntax.function_body() || syntax.function_body()->kind() == syntax_kind::absent) {
			@diagnostics.error(syntax.token(), "test and harness attributes require a function definition");
			return;
		};
		var function = TestFunction();
		@function.parameters = syntax.function_parameters()->size();
		@function.name.append(prefix);
		test_source_name(@function.name, *syntax.function_name());
		if (harness) {
			if (!this.harness.empty()) {
				@diagnostics.error(syntax.token(), "a test target can define only one harness");
				return;
			};
			if (function.parameters) {
				@diagnostics.error(syntax.token(), "the test harness must accept no arguments");
			};
			@this.harness = rt::string(function.name.view());
			return;
		};
		@this.tests.push_back($function);
		return;
	};
	if (syntax.kind() == syntax_kind::namespace_body) {
		var nested = rt::string(prefix);
		test_source_name(@nested, *syntax.namespace_name());
		@nested.append("::");
		@this.collect(*syntax.namespace_members(), nested, @diagnostics);
		return;
	};
	if (syntax.kind() == syntax_kind::template_declaration) {
		@this.collect(*syntax.template_declaration(), prefix, @diagnostics);
		return;
	};
	if (syntax.kind() == syntax_kind::record) {
		return;
	};
	usize index = 0;
	while (index < syntax.size()) {
		@this.collect(*syntax.item(index), prefix, @diagnostics);
		@index = index + 1;
	};
};

fn TestRunnerSource::generate(TestRunnerSource& this, var rt::string& output) {
	@output.append("fn puts(char* text) -> i32; namespace rt { namespace test { struct assertion_error {}; var failures : i32 = 0; fn expect(bool condition) { if (!condition) { @failures = failures + 1; discard puts(\"expectation failed\\0\".data()); throw assertion_error(); }; }; ");
	this.configuration(@output);
	usize count = 0;
	if (this.tests.size()) {
		@count = this.tests.data()[0].parameters;
	};
	if (count) {
		@output.append("template<");
		usize index = 0;
		while (index < count) {
			if (index) {
				@output.append(", ");
			};
			@output.append("typename T");
			test_source_number(@output, index);
			@index = index + 1;
		};
		@output.append("> ");
	};
	@output.append("fn run(");
	usize index = 0;
	while (index < count) {
		if (index) {
			@output.append(", ");
		};
		@output.append("auto T");
		test_source_number(@output, index);
		@output.append("& argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append(") { ");
	@index = 0;
	while (index < this.tests.size()) {
		@output.append("if (selected(");
		test_source_number(@output, index);
		@output.append(")) { var failures_before : i32 = failures; discard puts(\"");
		@output.append(this.tests.data()[index].name.view());
		@output.append("\\0\".data()); try { ");
		@output.append(this.tests.data()[index].name.view());
		@output.append("(");
		usize argument = 0;
		while (argument < count) {
			if (argument) {
				@output.append(", ");
			};
			@output.append("@argument");
			test_source_number(@output, argument);
			@argument = argument + 1;
		};
		@output.append("); } catch (...) { if (failures == failures_before) { @failures = failures + 1; discard puts(\"uncaught error\\0\".data()); }; }; if (failures == failures_before) { discard puts(\"[PASS]\\0\".data()); } else { discard puts(\"[FAIL]\\0\".data()); }; } ");
		@index = index + 1;
	};
	@output.append("}; ");
	@index = 0;
	while (index < this.registration_counts.size()) {
		this.registration(@output, this.registration_counts.data()[index]);
		@index = index + 1;
	};
	@output.append("}; }; fn __rutile_test_main(i32 argument_count, char** arguments) -> i32 { if (!rt::test::configure(argument_count, arguments).has<void>()) { discard puts(\"usage: --shard-count N --shard-index I (N > 0, I < N)\\0\".data()); return 2; }; ");
	if (this.harness.empty()) {
		@output.append("rt::test::run(); ");
	}
	else {
		@output.append(this.harness.view());
		@output.append("(); ");
	};
	@output.append("if (rt::test::failures) { return 1; }; return 0; };");
};







fn TestRunnerSource::registration(TestRunnerSource& this, var rt::string& output, usize count) {
	@output.append("template<typename Callback");
	usize index = 0;
	while (index < count) {
		@output.append(", typename T");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append("> fn register(rt::string_view name, Callback callback");
	@index = 0;
	while (index < count) {
		@output.append(", auto T");
		test_source_number(@output, index);
		@output.append("& argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append(") { var label = rt::string(name); discard puts(label.c_str()); var failures_before : i32 = failures; try { callback(");
	@index = 0;
	while (index < count) {
		if (index) {
			@output.append(", ");
		};
		@output.append("@argument");
		test_source_number(@output, index);
		@index = index + 1;
	};
	@output.append("); } catch (...) { if (failures == failures_before) { @failures = failures + 1; discard puts(\"uncaught error\\0\".data()); }; }; if (failures == failures_before) { discard puts(\"[PASS]\\0\".data()); } else { discard puts(\"[FAIL]\\0\".data()); }; }; ");
};

fn TestRunnerSource::collect_registrations(var TestRunnerSource& this, Syntax& syntax, rt::string_view prefix) {
	if (syntax.kind() == syntax_kind::call) {
		var name = rt::string();
		test_source_name(@name, *syntax.callable());
		if ((name.view() == "rt::test::register" || prefix == "rt::test::" && name.view() == "register") && syntax.arguments()->size() >= 2) {
			usize count = syntax.arguments()->size() - 2;
			usize index = 0;
			while (index < this.registration_counts.size() && this.registration_counts.data()[index] != count) {
				@index = index + 1;
			};
			if (index == this.registration_counts.size()) {
				@this.registration_counts.push_back(count);
			};
		};
	};
	usize index = 0;
	while (index < syntax.size()) {
		@this.collect_registrations(*syntax.item(index), prefix);
		@index = index + 1;
	};
};




fn TestRunnerSource::configuration(TestRunnerSource& this, var rt::string& output) {
	@output.append("""
var shard_count : usize = 1;
var shard_index : usize = 0;
struct argument_error {};
using NumberResult = usize | argument_error;
using ConfigurationResult = void | argument_error;
fn selected(usize ordinal) -> bool {
	return ordinal % shard_count == shard_index;
};
fn parse_number(rt::string_view text) -> NumberResult {
	if (text.empty()) {
		return argument_error();
	};
	usize value = 0;
	for (usize index = 0; index < text.size(); @index = index + 1) {
		char digit = text.data()[index];
		if (digit < char(48) || digit > char(57)) {
			return argument_error();
		};
		usize number = static_cast<usize>(digit) - 48;
		if (value > (usize::max - number) / 10) {
			return argument_error();
		};
		@value = value * 10 + number;
	};
	return $value;
};
fn configure(i32 argument_count, char** arguments) -> ConfigurationResult {
	bool count_seen = false;
	bool index_seen = false;
	for (i32 argument = 1; argument < argument_count; @argument = argument + 2) {
		var option = rt::from_c_string(arguments[argument]);
		if (argument + 1 >= argument_count) {
			return argument_error();
		};
		var parsed = parse_number(rt::from_c_string(arguments[argument + 1]));
		if (parsed.has<argument_error>()) {
			return argument_error();
		};
		if (option == "--shard-count") {
			if (count_seen) {
				return argument_error();
			};
			@shard_count = parsed.get<usize>();
			@count_seen = true;
		}
		else if (option == "--shard-index") {
			if (index_seen) {
				return argument_error();
			};
			@shard_index = parsed.get<usize>();
			@index_seen = true;
		}
		else {
			return argument_error();
		};
	};
	if (!shard_count || shard_index >= shard_count) {
		return argument_error();
	};
};
""");
};

struct Lexer {
	fn Lexer(var Lexer& this, var SourceFile& source);

	fn scan(var Lexer& this) -> CompilationResult;
	fn keyword_spelling(token_kind kind) -> rt::string_view;

	fn error(Lexer& this) -> rt::string_view;
	fn error_token(Lexer& this) -> Token;

private:
	var SourceFile* source;
	usize offset;
	usize line;
	usize column;
	rt::string_view failure;
	Token failure_token;

	fn advance(var Lexer& this) -> char;
	fn fail(var Lexer& this, Token& token, rt::string_view message) -> CompilationResult;
	fn trivia(var Lexer& this) -> CompilationResult;
	fn number(var Lexer& this, Token& token) -> CompilationResult;
	fn quoted(var Lexer& this, Token& token, char quote) -> CompilationResult;
	fn symbol(var Lexer& this, var Token& token) -> CompilationResult;
	fn identifier_kind(rt::string_view spelling) -> token_kind;
	fn identifier_start(char value) -> bool;
	fn digit(char value) -> bool;

	fn peek(Lexer& this, usize distance) -> char;
	fn location(Lexer& this) -> Token;
};

fn Lexer::Lexer(var Lexer& this, var SourceFile& source) {
	@this.source = &@source;
	@this.line = 1;
	@this.column = 1;
};

fn Lexer::peek(Lexer& this, usize distance) -> char {
	var text = this.source->text();

	if (this.offset >= text.size() || distance >= text.size() - this.offset) {
		return 0;
	};

	return text.data()[this.offset + distance];
};

fn Lexer::advance(var Lexer& this) -> char {
	char value = this.peek(0);

	if (!value) {
		return 0;
	};

	@this.offset = this.offset + 1;

	if (value == '\n') {
		@this.line = this.line + 1;
		@this.column = 1;
	}
	else {
		@this.column = this.column + 1;
	};

	return value;
};

fn Lexer::location(Lexer& this) -> Token {
	Token token;
	@token.source = this.source;
	@token.begin = this.offset;
	@token.line = this.line;
	@token.column = this.column;

	return $token;
};

fn Lexer::fail(var Lexer& this, Token& token, rt::string_view message) -> CompilationResult {
	@this.failure = rt::string_view(message);
	@this.failure_token = Token(token);
	usize size = this.source->text().size();
	if (token.begin <= size) {
		usize consumed = 0;
		if (this.offset >= token.begin) {
			@consumed = this.offset - token.begin;
		};
		if (consumed > this.failure_token.length) {
			@this.failure_token.length = consumed;
		};
		if (!this.failure_token.length && token.begin < size) {
			@this.failure_token.length = 1;
		};
		if (this.failure_token.length > size - token.begin) {
			@this.failure_token.length = size - token.begin;
		};
		if (token.begin == size) {
			@this.failure_token.kind = token_kind::eof;
		};
	};

	return compilation_error();
};

fn Lexer::error(Lexer& this) -> rt::string_view {
	return rt::string_view(this.failure);
};

fn Lexer::error_token(Lexer& this) -> Token {
	return Token(this.failure_token);
};

fn Lexer::identifier_start(char value) -> bool {
	return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || value == '_';
};

fn Lexer::digit(char value) -> bool {
	return value >= '0' && value <= '9';
};

fn Lexer::keyword_spelling(token_kind kind) -> rt::string_view {
	switch (kind) {
		case token_kind::kw_fn:
			return "fn";
		case token_kind::kw_using:
			return "using";
		case token_kind::kw_const:
			return "const";
		case token_kind::kw_discard:
			return "discard";
		case token_kind::kw_delete:
			return "delete";
		case token_kind::kw_new:
			return "new";
		case token_kind::kw_implicit:
			return "implicit";
		case token_kind::kw_nullptr:
			return "nullptr";
		case token_kind::kw_export:
			return "export";
		case token_kind::kw_template:
			return "template";
		case token_kind::kw_typename:
			return "typename";
		case token_kind::kw_class:
			return "class";
		case token_kind::kw_var:
			return "var";
		case token_kind::kw_struct:
			return "struct";
		case token_kind::kw_union:
			return "union";
		case token_kind::kw_enum:
			return "enum";
		case token_kind::kw_namespace:
			return "namespace";
		case token_kind::kw_virtual:
			return "virtual";
		case token_kind::kw_override:
			return "override";
		case token_kind::kw_final:
			return "final";
		case token_kind::kw_return:
			return "return";
		case token_kind::kw_try:
			return "try";
		case token_kind::kw_catch:
			return "catch";
		case token_kind::kw_throw:
			return "throw";
		case token_kind::kw_noexcept:
			return "noexcept";
		case token_kind::kw_if:
			return "if";
		case token_kind::kw_else:
			return "else";
		case token_kind::kw_while:
			return "while";
		case token_kind::kw_for:
			return "for";
		case token_kind::kw_switch:
			return "switch";
		case token_kind::kw_case:
			return "case";
		case token_kind::kw_default:
			return "default";
		case token_kind::kw_break:
			return "break";
		case token_kind::kw_continue:
			return "continue";
		case token_kind::kw_sizeof:
			return "sizeof";
		default:
			return rt::string_view();
	};
};

fn Lexer::identifier_kind(rt::string_view spelling) -> token_kind {
	i32 value = static_cast<i32>(token_kind::kw_fn);
	while (value <= static_cast<i32>(token_kind::kw_sizeof)) {
		var kind = static_cast<token_kind>(value);
		if (keyword_spelling(kind) == spelling) {
			return $kind;
		};
		@value = value + 1;
	};
	return token_kind::identifier;
};

fn Lexer::trivia(var Lexer& this) -> CompilationResult {
	while (true) {
		char value = this.peek(0);

		if (value == ' ' || value == '\t' || value == '\r' || value == '\n') {
			discard @this.advance();
			continue;
		};

		if (value != '/') {
			break;
		};

		if (this.peek(1) == '/') {
			var start = this.location();
			while (this.peek(0) && this.peek(0) != '\n') {
				discard @this.advance();
			};
			@start.length = this.offset - start.begin;
			@this.source->append_comment(Token(start));

			continue;
		};

		if (this.peek(1) != '*') {
			break;
		};

		var start = this.location();
		discard @this.advance();
		discard @this.advance();

		while (true) {
			if (!this.peek(0)) {
				@start.length = this.offset - start.begin;
				@this.source->append_comment(Token(start));
				return @this.fail(start, "unterminated comment");
			};

			if (this.peek(0) == '*' && this.peek(1) == '/') {
				discard @this.advance();
				discard @this.advance();
				break;
			};

			discard @this.advance();
		};
		@start.length = this.offset - start.begin;
		@this.source->append_comment(Token(start));
	};

};

fn Lexer::number(var Lexer& this, Token& token) -> CompilationResult {
	while (Lexer::digit(this.peek(0))) {
		discard @this.advance();
	};

	if (this.peek(0) == '.' && Lexer::digit(this.peek(1))) {
		discard @this.advance();

		while (Lexer::digit(this.peek(0))) {
			discard @this.advance();
		};
	};

	if (this.peek(0) != 'e' && this.peek(0) != 'E') {
		return;
	};

	discard @this.advance();

	if (this.peek(0) == '+' || this.peek(0) == '-') {
		discard @this.advance();
	};

	if (!Lexer::digit(this.peek(0))) {
		return @this.fail(token, "expected exponent digits");
	};

	while (Lexer::digit(this.peek(0))) {
		discard @this.advance();
	};

};

fn Lexer::quoted(var Lexer& this, Token& token, char quote) -> CompilationResult {
	discard @this.advance();
	if (quote == '"' && this.peek(0) == '"' && this.peek(1) == '"') {
		discard @this.advance();
		discard @this.advance();
		while (true) {
			if (!this.peek(0)) {
				return @this.fail(token, "unterminated raw string literal");
			};
			if (this.peek(0) == '"' && this.peek(1) == '"' && this.peek(2) == '"') {
				discard @this.advance();
				discard @this.advance();
				discard @this.advance();
				return;
			};
			discard @this.advance();
		};
	};

	if (quote == '\'') {
		char value = @this.advance();

		if (!value || value == '\'' || value == '\n' || value == '\r') {
			return @this.fail(token, "expected one character in literal");
		};

		if (value == '\\') {
			char escaped = @this.advance();

			if (!escaped || escaped == '\n' || escaped == '\r') {
				return @this.fail(token, "unterminated character escape");
			};
		};

		if (@this.advance() != '\'') {
			return @this.fail(token, "expected closing quote after character");
		};

		return;
	};

	while (this.peek(0) != '"') {
		if (!this.peek(0)) {
			return @this.fail(token, "unterminated string literal");
		};

		if (this.peek(0) == '\n') {
			return @this.fail(token, "newline in string literal");
		};

		if (@this.advance() == '\\' && this.peek(0)) {
			discard @this.advance();
		};
	};

	discard @this.advance();

};

fn Lexer::symbol(var Lexer& this, var Token& token) -> CompilationResult {
	usize width = 1;
	char next = this.peek(1);

	switch (this.peek(0)) {
		case '(':
			@token.kind = token_kind::punct_left_paren;
			break;
		case ')':
			@token.kind = token_kind::punct_right_paren;
			break;
		case '[':
			@token.kind = token_kind::punct_left_bracket;
			break;
		case ']':
			@token.kind = token_kind::punct_right_bracket;
			break;
		case '{':
			@token.kind = token_kind::punct_left_brace;
			break;
		case '}':
			@token.kind = token_kind::punct_right_brace;
			break;
		case ';':
			@token.kind = token_kind::punct_semicolon;
			break;
		case ',':
			@token.kind = token_kind::punct_comma;
			break;
		case '+':
			@token.kind = token_kind::op_plus;
			if (next == '=') {
				@token.kind = token_kind::op_plus_assign;
				@width = 2;
			};
			break;
		case '*':
			@token.kind = token_kind::op_star;
			break;
		case '/':
			@token.kind = token_kind::op_slash;
			break;
		case '%':
			@token.kind = token_kind::op_remainder;
			break;
		case '^':
			@token.kind = token_kind::op_caret;
			break;
		case '~':
			@token.kind = token_kind::op_tilde;
			break;
		case '@':
			@token.kind = token_kind::op_access;
			break;
		case '$':
			@token.kind = token_kind::op_relocate;
			break;
		case ':':
			@token.kind = token_kind::punct_colon;

			if (next == ':') {
				@token.kind = token_kind::op_scope;
				@width = 2;
			};

			if (next == '=') {
				@token.kind = token_kind::op_copy;
				@width = 2;
			};

			break;
		case '-':
			@token.kind = token_kind::op_minus;

			if (next == '>') {
				@token.kind = token_kind::op_arrow;
				@width = 2;
			};

			break;
		case '=':
			@token.kind = token_kind::op_assign;

			if (next == '=') {
				@token.kind = token_kind::op_equal;
				@width = 2;
			};

			break;
		case '!':
			@token.kind = token_kind::op_bang;

			if (next == '=') {
				@token.kind = token_kind::op_not_equal;
				@width = 2;
			};

			break;
		case '<':
			@token.kind = token_kind::op_less;

			if (next == '=') {
				@token.kind = token_kind::op_less_equal;
				@width = 2;
			};

			if (next == '<') {
				@token.kind = token_kind::op_shift_left;
				@width = 2;
			};

			break;
		case '>':
			@token.kind = token_kind::op_greater;

			if (next == '=') {
				@token.kind = token_kind::op_greater_equal;
				@width = 2;
			};

			if (next == '>') {
				@token.kind = token_kind::op_shift_right;
				@width = 2;
			};

			break;
		case '&':
			@token.kind = token_kind::op_ampersand;

			if (next == '&') {
				@token.kind = token_kind::op_and;
				@width = 2;
			};

			break;
		case '|':
			@token.kind = token_kind::op_pipe;

			if (next == '|') {
				@token.kind = token_kind::op_or;
				@width = 2;
			};

			break;
		case '.':
			@token.kind = token_kind::op_dot;

			if (next == '.' && this.peek(2) == '.') {
				@token.kind = token_kind::punct_ellipsis;
				@width = 3;
			};

			break;
		default:
			return @this.fail(token, "unknown source character");
	};

	usize consumed = 0;

	while (consumed < width) {
		discard @this.advance();
		@consumed = consumed + 1;
	};

};

fn Lexer::scan(var Lexer& this) -> CompilationResult {
	@this.offset = 0;
	@this.line = 1;
	@this.column = 1;
	@this.failure = rt::string_view();
	@this.failure_token = Token();
	@this.source->clear_tokens();

	while (true) {
		if (!(@this.trivia()).has<void>()) {
			return compilation_error();
		};

		var token = this.location();
		char value = this.peek(0);

		if (!value) {
			if (this.offset < this.source->text().size()) {
				return @this.fail(token, "NUL byte in source");
			};

			@token.kind = token_kind::eof;
		}
		else if (Lexer::identifier_start(value)) {
			while (Lexer::identifier_start(this.peek(0)) || Lexer::digit(this.peek(0))) {
				discard @this.advance();
			};

			@token.length = this.offset - token.begin;
			@token.kind = Lexer::identifier_kind(token.text());
		}
		else if (Lexer::digit(value)) {
			@token.kind = token_kind::literal_number;

			if (!(@this.number(token)).has<void>()) {
				return compilation_error();
			};
		}
		else if (value == '"' || value == '\'') {
			@token.kind = token_kind::literal_string;

			if (value == '\'') {
				@token.kind = token_kind::literal_number;
			};

			if (!(@this.quoted(token, value)).has<void>()) {
				@token.length = this.offset - token.begin;
				if (token.length) {
					@this.source->append_token(Token(token));
				};
				return compilation_error();
			};
		}
		else {
			if (!(@this.symbol(@token)).has<void>()) {
				return compilation_error();
			};
		};

		@token.length = this.offset - token.begin;

		@this.source->append_token(Token(token));

		if (token.kind == token_kind::eof) {
			break;
		};
	};

};

enum parse_mode : [u08] {
	strict;
	editor;
};

struct ParseIssue {
	Token location;
	rt::string message;
};

enum name_role : [u08] {
	designator;
	value;
};

struct ParseChoices {
	rt::buffer<usize> operators;

	fn contains(ParseChoices& this, usize position) -> bool;
	fn extended(ParseChoices& this, usize position) -> rt::unique<ParseChoices>;
	fn same(ParseChoices& this, ParseChoices& other) -> bool;
};

using ParseResult = rt::unique<Syntax> | compilation_error;

struct Parser {
	fn Parser(var Parser& this, rt::buffer<Token>& tokens);

	fn parse(var Parser& this) -> ParseResult;
	fn parse_editor(var Parser& this) -> ParseResult;
	fn issues(Parser& this) -> rt::buffer<ParseIssue>&;
	fn set_cancellation(var Parser& this, ((var void*) -> i32)* callback, var void* context);

	fn error(Parser& this) -> rt::string_view;
	fn error_token(Parser& this) -> Token;

private:
	rt::buffer<Token>* tokens;
	usize offset;
	parse_mode mode;
	rt::buffer<ParseIssue> recovery_issues;
	usize pending_greater;
	usize pending_less;
	ParseChoices* selections;
	var rt::buffer<usize>* discoveries;
	((var void*) -> i32)* cancellation;
	var void* cancellation_context;
	fn cancelled(var Parser& this) -> bool;
	fn parse_impl(var Parser& this) -> rt::unique<Syntax>;
	fn recovery_boundary(Parser& this) -> bool;
	fn synchronize(var Parser& this, usize start);
	fn collect_issues(var Parser& this, Syntax& syntax) -> CompilationResult;
	rt::string_view failure;
	Token failure_location;

	fn peek(Parser& this) -> Token;
	fn take(var Parser& this) -> Token;
	fn accept(var Parser& this, token_kind& kind) -> bool;
	fn require(var Parser& this, token_kind& kind, rt::string_view message) -> CompilationResult;
	fn fail(var Parser& this, rt::string_view message);

	fn node(var Parser& this, syntax_kind kind, Token& token) -> rt::unique<Syntax>;
	fn absent(var Parser& this) -> rt::unique<Syntax>;
	fn add(var Parser& this, var Syntax& parent, rt::unique<Syntax> child) -> CompilationResult;
	fn factor(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn factor_group(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn alternative_add(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> CompilationResult;

	fn expression(var Parser& this, i32 minimum) -> rt::unique<Syntax>;
	fn primary(var Parser& this) -> rt::unique<Syntax>;
	fn postfix(var Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax>;
	fn sequence(var Parser& this, Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax>;
	fn arguments(var Parser& this, token_kind close) -> rt::unique<Syntax>;

	fn type(var Parser& this) -> rt::unique<Syntax>;
	fn type_binary(var Parser& this, i32 minimum) -> rt::unique<Syntax>;
	fn type_atom(var Parser& this) -> rt::unique<Syntax>;
	fn pack_signature(var Parser& this) -> rt::unique<Syntax>;
	fn pack_literal(var Parser& this) -> rt::unique<Syntax>;
	fn template_arguments(var Parser& this) -> rt::unique<Syntax>;
	fn open_template(var Parser& this) -> CompilationResult;
	fn close_template(var Parser& this) -> CompilationResult;
	fn name_part(var Parser& this, name_role& role) -> rt::unique<Syntax>;
	fn name_in(var Parser& this, name_role& role) -> rt::unique<Syntax>;
	fn name(var Parser& this) -> rt::unique<Syntax>;
	fn precedence(token_kind& kind) -> i32;

	fn attribute_declaration(var Parser& this) -> rt::unique<Syntax>;
	fn statement_one(var Parser& this) -> rt::unique<Syntax>;
	fn statement(var Parser& this) -> rt::unique<Syntax>;
	fn variable(var Parser& this) -> rt::unique<Syntax>;
	fn parameters(var Parser& this) -> rt::unique<Syntax>;
	fn parameter(var Parser& this) -> rt::unique<Syntax>;
	fn parameter_one(var Parser& this) -> rt::unique<Syntax>;
	fn function(var Parser& this) -> rt::unique<Syntax>;
	fn record(var Parser& this) -> rt::unique<Syntax>;
	fn enumeration(var Parser& this) -> rt::unique<Syntax>;
	fn namespace_body(var Parser& this) -> rt::unique<Syntax>;
	fn template_declaration(var Parser& this) -> rt::unique<Syntax>;
	fn control(var Parser& this) -> rt::unique<Syntax>;
	fn exception_statement(var Parser& this) -> rt::unique<Syntax>;
	fn exception_spec(var Parser& this) -> rt::unique<Syntax>;
};

fn Parser::Parser(var Parser& this, rt::buffer<Token>& tokens) {
	@this.tokens = &@tokens;
};

fn Parser::set_cancellation(var Parser& this, ((var void*) -> i32)* callback, var void* context) {
	@this.cancellation = $callback;
	@this.cancellation_context = $context;
};

fn Parser::cancelled(var Parser& this) -> bool {
	if (this.cancellation && this.cancellation(this.cancellation_context)) {
		@this.fail("analysis cancelled");
		return true;
	};
	return false;
};

fn Parser::error(Parser& this) -> rt::string_view {
	if (this.failure.empty()) {
		return rt::string_view();
	};

	return this.failure;
};

fn Parser::error_token(Parser& this) -> Token {
	return Token(this.failure_location);
};

fn Parser::peek(Parser& this) -> Token {
	if (this.pending_less) {
		Token remainder := this.tokens->data()[this.offset - 1];
		@remainder.kind = token_kind::op_less;
		@remainder.begin = remainder.begin + 1;
		@remainder.length = 1;
		return $remainder;
	};
	if (this.pending_greater) {
		Token remainder := this.tokens->data()[this.offset - 1];
		@remainder.kind = token_kind::op_greater;
		@remainder.begin = remainder.begin + 1;
		@remainder.length = 1;

		return $remainder;
	};

	if (this.offset < this.tokens->size()) {
		return Token(this.tokens->data()[this.offset]);
	};

	Token token;
	@token.kind = token_kind::eof;

	return $token;
};

fn Parser::take(var Parser& this) -> Token {
	Token token = this.peek();

	if (this.pending_less) {
		@this.pending_less = this.pending_less - 1;
		return $token;
	};

	if (this.pending_greater) {
		@this.pending_greater = this.pending_greater - 1;

		return $token;
	};

	if (token.kind != token_kind::eof) {
		@this.offset = this.offset + 1;
	};

	return $token;
};

fn Parser::accept(var Parser& this, token_kind& kind) -> bool {
	if (this.peek().kind != kind) {
		return false;
	};

	discard @this.take();

	return true;
};

fn Parser::require(var Parser& this, token_kind& kind, rt::string_view message) -> CompilationResult {
	if (@this.accept(kind)) {
		return;
	};

	if (this.mode == parse_mode::editor && kind == token_kind::punct_semicolon && (this.peek().kind == token_kind::eof || this.peek().kind == token_kind::punct_right_brace)) {
		return;
	};
	@this.fail(message);
	return compilation_error();
};

fn Parser::fail(var Parser& this, rt::string_view message) {
	if (this.failure.empty()) {
		@this.failure := message;
		@this.failure_location = this.peek();
	};
};

fn Parser::node(var Parser& this, syntax_kind kind, Token& token) -> rt::unique<Syntax> {
	var result = rt::unique<Syntax>(new Syntax($kind, token));
	if (!result.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Syntax);
		throw $error;
	};
	return $result;
};

fn Parser::absent(var Parser& this) -> rt::unique<Syntax> {
	return @this.node(syntax_kind::absent, this.peek());
};

fn Parser::add(var Parser& this, var Syntax& parent, rt::unique<Syntax> child) -> CompilationResult {
	if (!child.get()) {
		return compilation_error();
	};

	return @parent.append($child);
};

fn Parser::precedence(token_kind& kind) -> i32 {
	switch (kind) {
		case token_kind::op_assign:
		case token_kind::op_plus_assign:
		case token_kind::op_copy:
			return 1;
		case token_kind::op_or:
			return 2;
		case token_kind::op_and:
			return 3;
		case token_kind::op_pipe:
			return 4;
		case token_kind::op_caret:
			return 5;
		case token_kind::op_ampersand:
			return 6;
		case token_kind::op_equal:
		case token_kind::op_not_equal:
			return 7;
		case token_kind::op_less:
		case token_kind::op_greater:
		case token_kind::op_less_equal:
		case token_kind::op_greater_equal:
			return 8;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			return 9;
		case token_kind::op_plus:
		case token_kind::op_minus:
			return 10;
		case token_kind::op_star:
		case token_kind::op_slash:
		case token_kind::op_remainder:
			return 11;
		default:
			return 0;
	};
};

fn Parser::issues(Parser& this) -> rt::buffer<ParseIssue>& {
	return this.recovery_issues;
};

fn Parser::parse_editor(var Parser& this) -> ParseResult {
	var strict = @this.parse();

	if (strict.has<rt::unique<Syntax>>() || @this.cancelled()) {
		return $strict;
	};

	ParseIssue first_issue;
	@first_issue.location := this.failure_location;
	@first_issue.message = rt::string(this.error());

	@this.recovery_issues.push_back($first_issue);
	@this.offset = 0;
	@this.pending_greater = 0;
	@this.pending_less = 0;
	@this.failure = rt::string_view();
	@this.mode = parse_mode::editor;
	var result = @this.parse_impl();

	if (!result.get() || !(@this.collect_issues(*result.get())).has<void>()) {
		return compilation_error();
	};

	return $result;
};

fn Parser::recovery_boundary(Parser& this) -> bool {
	token_kind kind = this.peek().kind;
	return kind == token_kind::punct_semicolon || kind == token_kind::punct_right_brace || kind == token_kind::punct_right_paren || kind == token_kind::punct_right_bracket || kind == token_kind::punct_comma || kind == token_kind::eof;
};

fn Parser::synchronize(var Parser& this, usize start) {
	@this.offset = start;
	@this.pending_greater = 0;
	@this.pending_less = 0;
	usize braces = 0;

	while (this.peek().kind != token_kind::eof) {
		if (@this.cancelled()) {
			return;
		};
		token_kind kind = this.peek().kind;

		if (!braces && kind == token_kind::punct_right_brace) {
			break;
		};
		if (!braces && this.offset > start && (kind == token_kind::kw_fn || kind == token_kind::kw_struct || kind == token_kind::kw_class || kind == token_kind::kw_namespace || kind == token_kind::kw_template)) {
			break;
		};

		discard @this.take();

		if (kind == token_kind::punct_left_brace) {
			@braces = braces + 1;
		}
		else if (kind == token_kind::punct_right_brace && braces) {
			@braces = braces - 1;
		}
		else if (kind == token_kind::punct_semicolon && !braces) {
			break;
		};
	};
};

fn Parser::collect_issues(var Parser& this, Syntax& syntax) -> CompilationResult {
	if (@this.cancelled()) {
		return compilation_error();
	};
	rt::string_view message;

	if (syntax.kind() == syntax_kind::error_expression) {
		@message = "incomplete expression or declaration";
	}
	else if ((syntax.kind() == syntax_kind::member || syntax.kind() == syntax_kind::qualified_name) && syntax.item(1)->kind() == syntax_kind::absent) {
		@message = "expected a member name after the access operator";
	};

	if (!message.empty()) {
		Token token = syntax.token();
		usize index = 0;

		while (index < this.recovery_issues.size() && (this.recovery_issues.data()[index].location.source != token.source || this.recovery_issues.data()[index].location.begin != token.begin)) {
			@index = index + 1;
		};
		if (index == this.recovery_issues.size()) {
			ParseIssue issue;
			@issue.location := token;
			@issue.message = rt::string(message);

			@this.recovery_issues.push_back($issue);
		};
	};

	usize index = 0;

	while (index < syntax.size()) {
		if (!(@this.collect_issues(*syntax.item(index))).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn Parser::parse(var Parser& this) -> ParseResult {
	@this.mode = parse_mode::strict;
	var result = @this.parse_impl();
	if (!result.get()) {
		return compilation_error();
	};
	return $result;
};

fn Parser::parse_impl(var Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::unit, this.peek());

	while (this.peek().kind != token_kind::eof && this.failure.empty()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		usize before = this.offset;

		if (!(@this.add(@*result.get(), @this.statement())).has<void>()) {
			break;
		};

		if (this.offset == before) {
			if (this.mode == parse_mode::editor && this.peek().kind != token_kind::eof) {
				discard @this.take();
				continue;
			};
			@this.fail("parser did not consume a declaration");
		};
	};

	if (this.failure.empty() && !result.get()->complete()) {
		@this.fail("incomplete syntax structure");
	};

	if (!this.failure.empty()) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::sequence(var Parser& this, Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax> {
	var result = @this.node($kind, opening);

	while (this.peek().kind != close && this.peek().kind != token_kind::eof && this.failure.empty()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		usize before = this.offset;

		if (!(@this.add(@*result.get(), @this.statement())).has<void>()) {
			return rt::unique<Syntax>();
		};
		if (this.offset == before) {
			if (this.mode == parse_mode::editor) {
				discard @this.take();
			}
			else {
				@this.fail("parser did not consume a statement");
			};
		};
	};

	if (this.mode == parse_mode::editor && this.peek().kind == token_kind::eof) {
		discard @this.add(@*result.get(), @this.node(syntax_kind::error_expression, this.peek()));
		return $result;
	};

	if (!(@this.require($close, "expected closing delimiter")).has<void>()) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::arguments(var Parser& this, token_kind close) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(close)) {
		return $result;
	};

	while (this.failure.empty()) {
		var argument = rt::unique<Syntax>();

		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			@argument = @this.node(syntax_kind::error_expression, this.peek());
		}
		else {
			@argument = @this.expression(1);
		};
		if (!(@this.add(@*result.get(), $argument)).has<void>()) {
			return rt::unique<Syntax>();
		};

		if (@this.accept(close)) {
			return $result;
		};

		if (this.mode == parse_mode::editor && @this.recovery_boundary() && this.peek().kind != token_kind::punct_comma) {
			discard @this.add(@*result.get(), @this.node(syntax_kind::error_expression, this.peek()));
			return $result;
		};

		if (!(@this.require(token_kind::punct_comma, "expected ',' between arguments")).has<void>()) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::open_template(var Parser& this) -> CompilationResult {
	if (@this.accept(token_kind::op_less)) {
		return;
	};
	if (@this.accept(token_kind::op_shift_left)) {
		@this.pending_less = 1;
		return;
	};
	@this.fail("expected '<'");
	return compilation_error();
};

fn Parser::close_template(var Parser& this) -> CompilationResult {
	if (@this.accept(token_kind::op_greater)) {
		return;
	};

	if (@this.accept(token_kind::op_shift_right)) {
		@this.pending_greater = 1;

		return;
	};

	@this.fail("expected '>' after template arguments");
	return compilation_error();
};

fn Parser::template_arguments(var Parser& this) -> rt::unique<Syntax> {
	var arguments = @this.node(syntax_kind::list, this.peek());

	while (this.failure.empty() && this.peek().kind != token_kind::op_greater && this.peek().kind != token_kind::op_shift_right) {
		var type_parser = Parser(*this.tokens);
		@type_parser.offset = this.offset;
		@type_parser.pending_greater = this.pending_greater;
		@type_parser.pending_less = this.pending_less;
	@type_parser.selections = this.selections;
	@type_parser.discoveries = this.discoveries;
		var type = @type_parser.type();
		if (type.get() && type_parser.failure.empty() && @type_parser.accept(token_kind::punct_ellipsis)) {
			var expanded = @type_parser.node(syntax_kind::pack_expansion, type.get()->token());
			discard @type_parser.add(@*expanded.get(), rt::unique<Syntax>(@type.release()));
			@type = $expanded;
		};
		var value_parser = Parser(*this.tokens);
		@value_parser.offset = this.offset;
		@value_parser.pending_greater = this.pending_greater;
		@value_parser.pending_less = this.pending_less;
	@value_parser.selections = this.selections;
	@value_parser.discoveries = this.discoveries;
		var value = @value_parser.expression(10);

		if (type.get() && type_parser.failure.empty() && (type_parser.peek().kind == token_kind::punct_comma || type_parser.peek().kind == token_kind::op_greater || type_parser.peek().kind == token_kind::op_shift_right)) {
			@this.offset = type_parser.offset;
			@this.pending_greater = type_parser.pending_greater;
			@this.pending_less = type_parser.pending_less;
	@this.selections = type_parser.selections;
	@this.discoveries = type_parser.discoveries;

			if (value.get() && value_parser.failure.empty() && value_parser.offset == type_parser.offset && value_parser.pending_greater == type_parser.pending_greater && value_parser.pending_less == type_parser.pending_less) {
				var alternatives = @this.node(syntax_kind::ambiguity, type.get()->token());
				discard @this.add(@*alternatives.get(), rt::unique<Syntax>(@type.release()));
				discard @this.add(@*alternatives.get(), rt::unique<Syntax>(@value.release()));
				discard @this.add(@*arguments.get(), rt::unique<Syntax>(@alternatives.release()));
			}
			else {
				discard @this.add(@*arguments.get(), rt::unique<Syntax>(@type.release()));
			};
		}
		else if (value.get() && value_parser.failure.empty()) {
			@this.offset = value_parser.offset;
			@this.pending_greater = value_parser.pending_greater;
			@this.pending_less = value_parser.pending_less;
	@this.selections = value_parser.selections;
	@this.discoveries = value_parser.discoveries;
			discard @this.add(@*arguments.get(), rt::unique<Syntax>(@value.release()));
		}
		else {
			@this.fail("expected template argument");
			break;
		};

		if (!@this.accept(token_kind::punct_comma)) {
			break;
		};
	};

	return $arguments;
};

fn Parser::name_part(var Parser& this, name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();

	if (@this.accept(token_kind::op_tilde)) {
		var destructor = @this.node(syntax_kind::unary, first);
		Token identifier = this.peek();
		discard @this.require(token_kind::identifier, "expected destructor type name");
		discard @this.add(@*destructor.get(), @this.node(syntax_kind::name, $identifier));

		return $destructor;
	};

	if (!(@this.require(token_kind::identifier, "expected identifier")).has<void>()) {
		return rt::unique<Syntax>();
	};

	var conversion_type = @this.absent();
	var operator_symbol = @this.absent();
	var operator_suffix = @this.absent();

	if (first.is("operator")) {
		usize beginning = this.offset;
		Token operation = @this.take();
		@operator_symbol = @this.node(syntax_kind::name, operation);

		if (operation.kind == token_kind::punct_left_paren) {
			discard @this.require(token_kind::punct_right_paren, "expected ')' in operator name");
		}
		else if (operation.kind == token_kind::punct_left_bracket) {
			discard @this.require(token_kind::punct_right_bracket, "expected ']' in operator name");
		}
		else if ((operation.kind == token_kind::kw_new || operation.kind == token_kind::kw_delete) && @this.accept(token_kind::punct_left_bracket)) {
			@operator_suffix = @this.node(syntax_kind::operator_array, this.peek());
			discard @this.require(token_kind::punct_right_bracket, "expected ']' in allocation operator name");
		};

		if (operation.kind == token_kind::literal_string) {
			@operator_suffix = @this.node(syntax_kind::name, this.peek());
			discard @this.require(token_kind::identifier, "expected literal operator suffix");
		}
		else if (operation.kind == token_kind::identifier || operation.kind == token_kind::kw_var || operation.kind == token_kind::kw_const) {
			var conversion = Parser(*this.tokens);
		@conversion.set_cancellation(this.cancellation, this.cancellation_context);
	@conversion.mode = this.mode;
			@conversion.offset = beginning;
			var target = @conversion.type();

			if (target.get() && conversion.failure.empty()) {
				@conversion_type = $target;
				@this.offset = conversion.offset;
				@this.pending_greater = conversion.pending_greater;
				@this.pending_less = conversion.pending_less;

			};
		};

		Token end := this.tokens->data()[this.offset - 1];
		@first.length = end.begin + end.length - first.begin;
	};

	syntax_kind category = syntax_kind::name;

	if (operator_symbol.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::operator_name;
	};

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::conversion_name;
	};

	var result = @this.node($category, first);

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		discard @this.add(@*result.get(), rt::unique<Syntax>(@conversion_type.release()));
	}
	else if (operator_symbol.get()->kind() != syntax_kind::absent) {
		discard @this.add(@*result.get(), rt::unique<Syntax>(@operator_symbol.release()));
		discard @this.add(@*result.get(), rt::unique<Syntax>(@operator_suffix.release()));
	};

	if (this.peek().kind != token_kind::op_less && this.peek().kind != token_kind::op_shift_left) {
		return $result;
	};

	var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
	@candidate.offset = this.offset;
	@candidate.pending_greater = this.pending_greater;
	@candidate.pending_less = this.pending_less;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
	discard @candidate.open_template();
	var arguments = @candidate.template_arguments();

	if (!(@candidate.close_template()).has<void>() || !candidate.failure.empty()) {
		return $result;
	};

	if (role == name_role::value) {
		if (this.selections && this.selections->contains(usize(this.offset))) {
			return $result;
		};

		if (this.discoveries) {
			@this.discoveries->push_back(usize(this.offset));
		};
	};

	var applied = @this.node(syntax_kind::template_apply, first);
	discard @this.add(@*applied.get(), rt::unique<Syntax>(@result.release()));
	discard @this.add(@*applied.get(), rt::unique<Syntax>(@arguments.release()));
	@this.offset = candidate.offset;
	@this.pending_greater = candidate.pending_greater;
	@this.pending_less = candidate.pending_less;

	return $applied;
};

fn Parser::name(var Parser& this) -> rt::unique<Syntax> {
	return @this.name_in(name_role::designator);
};

fn Parser::name_in(var Parser& this, name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();
	var result = @this.name_part(role);

	while (this.peek().kind == token_kind::op_scope) {
		Token separator = @this.take();
		var path = @this.node(syntax_kind::qualified_name, first);
		if (this.mode == parse_mode::editor && this.peek().kind != token_kind::identifier && this.peek().kind != token_kind::kw_new && this.peek().kind != token_kind::kw_delete) {
			@path = @this.node(syntax_kind::qualified_name, separator);
			discard @this.add(@*path.get(), rt::unique<Syntax>(@result.release()));
			discard @this.add(@*path.get(), @this.absent());
		}
		else {
			discard @this.add(@*path.get(), rt::unique<Syntax>(@result.release()));
			discard @this.add(@*path.get(), @this.name_part(role));
		};
		@result = rt::unique<Syntax>(@path.release());
	};

	return $result;
};

fn Parser::type(var Parser& this) -> rt::unique<Syntax> {
	return @this.type_binary(1);
};

fn Parser::type_binary(var Parser& this, i32 minimum) -> rt::unique<Syntax> {
	var left = @this.type_atom();
	while (left.get() && this.failure.empty()) {
		Token operation = this.peek();
		i32 precedence = 0;
		if (operation.kind == token_kind::op_pipe) {
			@precedence = 1;
		}
		else if (operation.kind == token_kind::op_ampersand) {
			@precedence = 2;
		};
		if (!precedence || precedence < minimum) {
			break;
		};
		discard @this.take();
		syntax_kind kind = syntax_kind::type_variant;
		if (operation.kind == token_kind::op_ampersand) {
			@kind = syntax_kind::type_tuple;
		};
		var combined = @this.node($kind, operation);
		discard @this.add(@*combined.get(), rt::unique<Syntax>(@left.release()));
		if (!(@this.add(@*combined.get(), @this.type_binary(precedence + 1))).has<void>()) {
			return rt::unique<Syntax>();
		};
		@left = $combined;
	};
	return $left;
};

fn Parser::type_atom(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	bool automatic = start.kind == token_kind::identifier && start.is("auto");

	if (automatic) {
		discard @this.take();
	};

	bool qualified = @this.accept(token_kind::kw_const);
	bool mutable_type = false;
	if (!qualified) {
		@mutable_type = @this.accept(token_kind::kw_var);
		@qualified = mutable_type;
	};
	var condition = @this.absent();

	if (qualified && @this.accept(token_kind::punct_left_bracket)) {
		@condition = @this.expression(1);
		discard @this.require(token_kind::punct_right_bracket, "expected ']' after qualifier condition");
	};

	var result = @this.absent();

	if (@this.accept(token_kind::punct_left_paren)) {
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.pending_less = this.pending_less;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
		var parameters = @candidate.parameters();
		var exception = @candidate.exception_spec();

		if (parameters.get() && candidate.failure.empty() && @candidate.accept(token_kind::op_arrow)) {
			@result = @this.node(syntax_kind::type_function, start);
			discard @this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
			discard @this.add(@*result.get(), @candidate.type());
			discard @this.add(@*result.get(), $exception);
			@this.offset = candidate.offset;
			@this.pending_greater = candidate.pending_greater;
			@this.pending_less = candidate.pending_less;

			if (!candidate.failure.empty()) {
				@this.fail(candidate.failure);
			};
		}
		else {
			var grouped = @this.node(syntax_kind::type_grouping, start);
			discard @this.add(@*grouped.get(), @this.type());
			discard @this.require(token_kind::punct_right_paren, "expected ')' after grouped type");
			@result = $grouped;
		};
	}
	else if (this.peek().kind == token_kind::kw_struct || this.peek().kind == token_kind::kw_class || this.peek().kind == token_kind::kw_union) {
		@result = @this.record();
	}
	else {
		@result = @this.node(syntax_kind::type_name, start);

		if (!(@this.add(@*result.get(), @this.name())).has<void>()) {
			return rt::unique<Syntax>();
		};
	};

	if (qualified) {
		syntax_kind qualifier_kind = syntax_kind::type_const;
		if (mutable_type) {
			@qualifier_kind = syntax_kind::type_mutable;
		};
		var constant = @this.node($qualifier_kind, start);
		discard @this.add(@*constant.get(), rt::unique<Syntax>(@result.release()));
		discard @this.add(@*constant.get(), rt::unique<Syntax>(@condition.release()));
		@result = $constant;
	};

	if (automatic) {
		var inferred = @this.node(syntax_kind::type_auto, start);
		discard @this.add(@*inferred.get(), rt::unique<Syntax>(@result.release()));
		@result = $inferred;
	};

	while (this.failure.empty()) {
		Token suffix = this.peek();
		bool mutable_pointer = suffix.kind == token_kind::kw_var;
		if (mutable_pointer) {
			discard @this.take();
			if (this.peek().kind != token_kind::op_star) {
				@this.fail("a suffix var qualifier shall precede a pointer '*'; use a grouped type to qualify another type constructor");
				return rt::unique<Syntax>();
			};
		};
		syntax_kind kind = syntax_kind::absent;

		if (@this.accept(token_kind::op_star)) {
			@kind = syntax_kind::type_pointer;
		}
		else if (suffix.kind == token_kind::op_ampersand) {
			// A reference suffix and a tuple separator share '&'. Keep complete
			// grammar continuations so declaration names never depend on spacing.
			usize choice = this.tokens->size() * 2 + this.offset;
			if (this.selections && this.selections->contains(choice)) {
				break;
			};
			bool type_follows = false;
			if (this.offset + 1 < this.tokens->size()) {
				token_kind next = this.tokens->data()[this.offset + 1].kind;
				@type_follows = next == token_kind::identifier || next == token_kind::kw_const || next == token_kind::kw_var || next == token_kind::punct_left_paren || next == token_kind::kw_struct || next == token_kind::kw_class || next == token_kind::kw_union;
			};
			if (type_follows && this.discoveries) {
				@this.discoveries->push_back(choice);
			};
			discard @this.take();
			@kind = syntax_kind::type_reference;
		}
		else if (@this.accept(token_kind::punct_left_bracket)) {
			var array = @this.node(syntax_kind::type_array, suffix);
			discard @this.add(@*array.get(), rt::unique<Syntax>(@result.release()));
			discard @this.add(@*array.get(), @this.expression(1));
			discard @this.require(token_kind::punct_right_bracket, "expected ']' after array extent");
			@result = rt::unique<Syntax>(@array.release());
			continue;
		}
		else {
			break;
		};

		var indirect = @this.node($kind, suffix);
		discard @this.add(@*indirect.get(), rt::unique<Syntax>(@result.release()));
		@result = rt::unique<Syntax>(@indirect.release());
		if (mutable_pointer) {
			var qualifier = @this.node(syntax_kind::type_mutable, suffix);
			discard @this.add(@*qualifier.get(), rt::unique<Syntax>(@result.release()));
			discard @this.add(@*qualifier.get(), @this.absent());
			@result = rt::unique<Syntax>(@qualifier.release());
		};
	};

	return $result;
};

fn Parser::expression(var Parser& this, i32 minimum) -> rt::unique<Syntax> {
	if (this.mode == parse_mode::editor && minimum > 1 && this.peek().kind == token_kind::punct_semicolon) {
		return @this.node(syntax_kind::error_expression, this.peek());
	};
	var left = @this.primary();

	if (!left.get()) {
		return $left;
	};

	@left = @this.postfix(rt::unique<Syntax>(@left.release()));

	while (this.failure.empty()) {
		Token operation = this.peek();
		if ((Parser::precedence(operation.kind) > 0 || operation.kind == token_kind::punct_comma) && this.offset + 1 < this.tokens->size() && this.tokens->data()[this.offset + 1].kind == token_kind::punct_ellipsis) {
			break;
		};
		i32 precedence = Parser::precedence(operation.kind);

		if (!precedence || precedence < minimum) {
			break;
		};

		discard @this.take();
		i32 next = precedence + 1;

		if (precedence == 1) {
			@next = precedence;
		};

		var binary = @this.node(syntax_kind::binary, operation);
		discard @this.add(@*binary.get(), rt::unique<Syntax>(@left.release()));

		var right = rt::unique<Syntax>();

		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			@right = @this.node(syntax_kind::error_expression, this.peek());
		}
		else {
			@right = @this.expression($next);
		};

		if (!(@this.add(@*binary.get(), $right)).has<void>()) {
			return rt::unique<Syntax>();
		};

		@left = $binary;
	};

	return $left;
};

fn Parser::postfix(var Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax> {
	while (this.failure.empty()) {
		Token token = this.peek();

		if (@this.accept(token_kind::punct_ellipsis)) {
			var expanded = @this.node(syntax_kind::pack_expansion, token);
			discard @this.add(@*expanded.get(), rt::unique<Syntax>(@value.release()));
			@value = $expanded;
			continue;
		};

		if (@this.accept(token_kind::punct_left_paren)) {
			var call = @this.node(syntax_kind::call, token);
			discard @this.add(@*call.get(), rt::unique<Syntax>(@value.release()));
			discard @this.add(@*call.get(), @this.arguments(token_kind::punct_right_paren));
			@value = rt::unique<Syntax>(@call.release());
			continue;
		};

		if (@this.accept(token_kind::punct_left_bracket)) {
			var index = @this.node(syntax_kind::index, token);
			discard @this.add(@*index.get(), rt::unique<Syntax>(@value.release()));
			discard @this.add(@*index.get(), @this.expression(1));
			discard @this.require(token_kind::punct_right_bracket, "expected ']' after index");
			@value = rt::unique<Syntax>(@index.release());
			continue;
		};

		if (token.kind == token_kind::op_dot || token.kind == token_kind::op_arrow) {
			discard @this.take();
			var member = @this.node(syntax_kind::member, token);
			discard @this.add(@*member.get(), rt::unique<Syntax>(@value.release()));
			Token tilde = this.peek();

			if (@this.accept(token_kind::op_tilde)) {
				var destructor = @this.node(syntax_kind::unary, tilde);
				discard @this.add(@*destructor.get(), @this.type());
				discard @this.add(@*member.get(), rt::unique<Syntax>(@destructor.release()));
			}
			else if (this.mode == parse_mode::editor && this.peek().kind != token_kind::identifier) {
				discard @this.add(@*member.get(), @this.absent());
			}
			else {
				discard @this.add(@*member.get(), @this.name());
			};

			@value = rt::unique<Syntax>(@member.release());
			continue;
		};

		break;
	};

	return $value;
};

fn Parser::pack_literal(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	discard @this.open_template();
	var arguments = @this.template_arguments();
	discard @this.close_template();
	var result = @this.node(syntax_kind::pack_literal, start);
	usize index = 0;
	while (arguments.get() && index < arguments.get()->size()) {
		discard @this.add(@*result.get(), @arguments.get()->take_item(index));
		@index = index + 1;
	};
	return $result;
};

fn Parser::pack_signature(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	discard @this.open_template();
	var result = @this.node(syntax_kind::pack_signature, start);
	while (this.failure.empty() && this.peek().kind != token_kind::op_greater && this.peek().kind != token_kind::op_shift_right) {
		Token location = this.peek();
		var type = @this.absent();
		if (!@this.accept(token_kind::kw_typename)) {
			@type = @this.type();
		};
		syntax_kind kind = syntax_kind::pack_signature_element;
		if (@this.accept(token_kind::punct_ellipsis)) {
			@kind = syntax_kind::pack_signature_variadic_element;
		};
		var element = @this.node(kind, location);
		discard @this.add(@*element.get(), $type);
		discard @this.add(@*result.get(), $element);
		if (!@this.accept(token_kind::punct_comma)) {
			break;
		};
		if (kind == syntax_kind::pack_signature_variadic_element) {
			@this.fail("variadic pack signature element must be last");
		};
	};
	discard @this.close_template();
	return $result;
};

fn Parser::primary(var Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (this.mode == parse_mode::editor && @this.recovery_boundary() && token.kind != token_kind::punct_semicolon) {
		return @this.node(syntax_kind::error_expression, token);
	};

	if (token.kind == token_kind::identifier || token.kind == token_kind::kw_var || token.kind == token_kind::kw_const || token.kind == token_kind::kw_struct || token.kind == token_kind::kw_class || token.kind == token_kind::kw_union) {
		// Type suffixes and value operators share tokens. Enumerate both complete
		// continuations instead of deciding whether an identifier denotes a type here.
		usize choice = this.tokens->size() + this.offset;

		if (!this.selections || !this.selections->contains(choice)) {
			var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
			@candidate.offset = this.offset;
			@candidate.pending_greater = this.pending_greater;
			@candidate.pending_less = this.pending_less;
			@candidate.selections = this.selections;
			@candidate.discoveries = this.discoveries;
			var type = @candidate.type();

			if (type.get() && candidate.failure.empty() && type.get()->kind() != syntax_kind::type_name && candidate.peek().kind == token_kind::punct_left_paren) {
				if (this.discoveries) {
					@this.discoveries->push_back(choice);
				};

				@this.offset = candidate.offset;
				@this.pending_greater = candidate.pending_greater;
				@this.pending_less = candidate.pending_less;

				return $type;
			};
		};
	};

	switch (token.kind) {
		case token_kind::op_less:
		case token_kind::op_shift_left:
			return @this.pack_literal();
		case token_kind::kw_noexcept: {
			discard @this.take();
			var result = @this.node(syntax_kind::exception_query, token);
			discard @this.require(token_kind::punct_left_paren, "expected '(' after noexcept");
			discard @this.add(@*result.get(), @this.expression(1));
			discard @this.require(token_kind::punct_right_paren, "expected ')' after noexcept operand");
			return $result;
		};
		case token_kind::identifier:
			if (token.is("static_cast") || token.is("reinterpret_cast") || token.is("const_cast") || token.is("dynamic_cast")) {
				discard @this.take();
				var cast = @this.node(syntax_kind::cast, token);
				discard @this.require(token_kind::op_less, "expected '<' in named cast");
				discard @this.add(@*cast.get(), @this.type());
				discard @this.close_template();
				discard @this.require(token_kind::punct_left_paren, "expected '(' in named cast");
				discard @this.add(@*cast.get(), @this.expression(1));
				discard @this.require(token_kind::punct_right_paren, "expected ')' in named cast");

				return $cast;
			};

			return @this.name_in(name_role::value);
		case token_kind::literal_number:
			discard @this.take();

			return @this.node(syntax_kind::number, $token);
		case token_kind::literal_string:
			discard @this.take();

			return @this.node(syntax_kind::string, $token);
		case token_kind::kw_nullptr:
			discard @this.take();

			return @this.node(syntax_kind::null_pointer, $token);
		case token_kind::punct_semicolon:
			discard @this.take();

			return @this.node(syntax_kind::noop, $token);
		case token_kind::punct_left_brace:
			discard @this.take();

			return @this.sequence($token, token_kind::punct_right_brace, syntax_kind::brace);
		case token_kind::punct_left_bracket:
			discard @this.take();
			var array = @this.node(syntax_kind::array, $token);
			discard @this.add(@*array.get(), @this.arguments(token_kind::punct_right_bracket));

			return $array;
		case token_kind::punct_left_paren: {
			usize choice = this.tokens->size() * 3 + this.offset;
			if (!this.selections || !this.selections->contains(choice)) {
				var candidate = Parser(*this.tokens);
				@candidate.set_cancellation(this.cancellation, this.cancellation_context);
				@candidate.mode = this.mode;
				@candidate.offset = this.offset;
				@candidate.pending_greater = this.pending_greater;
				@candidate.pending_less = this.pending_less;
				@candidate.selections = this.selections;
				@candidate.discoveries = this.discoveries;
				discard @candidate.take();
				var target = @candidate.type();
				if (target.get() && candidate.failure.empty() && @candidate.accept(token_kind::punct_right_paren)) {
					var Syntax* constructed = target.get();
					while (constructed->kind() == syntax_kind::type_grouping) {
						@constructed = constructed->operand();
					};
					if ((constructed->kind() == syntax_kind::type_tuple || constructed->kind() == syntax_kind::type_variant) && candidate.peek().kind == token_kind::punct_left_paren) {
						@this.offset = candidate.offset;
						@this.pending_greater = candidate.pending_greater;
						@this.pending_less = candidate.pending_less;
						return $target;
					};
					var operand = @candidate.primary();
					if (operand.get() && candidate.failure.empty()) {
						@operand = @candidate.postfix(rt::unique<Syntax>(@operand.release()));
						if (operand.get() && candidate.failure.empty()) {
							if (this.discoveries) {
								@this.discoveries->push_back(choice);
							};
							var cast = @this.node(syntax_kind::cast, token);
							discard @this.add(@*cast.get(), rt::unique<Syntax>(@target.release()));
							discard @this.add(@*cast.get(), rt::unique<Syntax>(@operand.release()));
							@this.offset = candidate.offset;
							@this.pending_greater = candidate.pending_greater;
							@this.pending_less = candidate.pending_less;
							return $cast;
						};
					};
				};
			};
			discard @this.take();
			var grouped = @this.node(syntax_kind::grouping, token);
			var pattern = @this.expression(1);
			Token operation = this.peek();
			if (Parser::precedence(operation.kind) > 0 || operation.kind == token_kind::punct_comma) {
				discard @this.take();
				discard @this.require(token_kind::punct_ellipsis, "expected '...' in fold expression");
				@grouped = @this.node(syntax_kind::pack_fold, operation);
			};
			discard @this.add(@*grouped.get(), $pattern);
			discard @this.require(token_kind::punct_right_paren, "expected ')' after expression");

			return $grouped;
		};

		case token_kind::kw_struct:
		case token_kind::kw_class:
		case token_kind::kw_union:
			return @this.record();
		case token_kind::kw_if:
		case token_kind::kw_while:
		case token_kind::kw_for:
		case token_kind::kw_switch:
			return @this.control();
		case token_kind::kw_break:
		case token_kind::kw_continue:
			discard @this.take();

			if (token.kind == token_kind::kw_break) {
				return @this.node(syntax_kind::break_loop, $token);
			};

			return @this.node(syntax_kind::continue_loop, $token);
		case token_kind::kw_throw:
		case token_kind::kw_return: {
			discard @this.take();
			syntax_kind category = syntax_kind::return_value;
			if (token.kind == token_kind::kw_throw) {
				@category = syntax_kind::exception_throw;
			};
			var result = @this.node($category, $token);

			if (this.peek().kind == token_kind::punct_semicolon) {
				discard @this.add(@*result.get(), @this.absent());
			}
			else {
				discard @this.add(@*result.get(), @this.expression(1));
			};

			return $result;
		};

		case token_kind::op_plus:
		case token_kind::op_minus:
		case token_kind::op_star:
		case token_kind::op_ampersand:
		case token_kind::op_bang:
		case token_kind::op_tilde:
		case token_kind::op_access:
		case token_kind::op_relocate: {
			discard @this.take();
			var unary = @this.node(syntax_kind::unary, $token);
			discard @this.add(@*unary.get(), @this.expression(12));

			return $unary;
		};

		case token_kind::kw_sizeof: {
			discard @this.take();
			var type_parser = Parser(*this.tokens);
		discard @type_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@type_parser.mode = this.mode;
			@type_parser.offset = this.offset;
			@type_parser.pending_greater = this.pending_greater;
			@type_parser.pending_less = this.pending_less;
	@type_parser.selections = this.selections;
	@type_parser.discoveries = this.discoveries;
			var type = @type_parser.absent();

			if (@type_parser.accept(token_kind::punct_left_paren)) {
				@type = @type_parser.type();
				discard @type_parser.require(token_kind::punct_right_paren, "expected ')' after sizeof type");
			}
			else {
				discard @type_parser.fail("expected sizeof type");
			};

			var value = @this.expression(12);

			if (type.get() && type_parser.failure.empty()) {
				var measured_type = @this.node(syntax_kind::sizeof_type, token);
				discard @this.add(@*measured_type.get(), rt::unique<Syntax>(@type.release()));

				if (value.get() && this.failure.empty() && this.offset == type_parser.offset && this.pending_greater == type_parser.pending_greater && this.pending_less == type_parser.pending_less) {
					var measured_value = @this.node(syntax_kind::unary, token);
					discard @this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));
					var alternatives = @this.node(syntax_kind::ambiguity, token);
					discard @this.add(@*alternatives.get(), $measured_type);
					discard @this.add(@*alternatives.get(), $measured_value);

					return $alternatives;
				};

				@this.offset = type_parser.offset;
				@this.pending_greater = type_parser.pending_greater;
				@this.pending_less = type_parser.pending_less;

				@this.failure = rt::string_view();

				return $measured_type;
			};

			var measured_value = @this.node(syntax_kind::unary, token);
			discard @this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));

			return $measured_value;
		};

		case token_kind::kw_discard: {
			discard @this.take();
			var discard_expression = @this.node(syntax_kind::discard_value, token);
			discard @this.add(@*discard_expression.get(), @this.expression(12));

			return $discard_expression;
		};

		case token_kind::kw_delete: {
			discard @this.take();
			syntax_kind kind = syntax_kind::deallocation;

			if (@this.accept(token_kind::punct_left_bracket)) {
				discard @this.require(token_kind::punct_right_bracket, "expected ']' in delete[]");
				@kind = syntax_kind::array_deallocation;
			};

			var deletion = @this.node($kind, token);
			discard @this.add(@*deletion.get(), @this.expression(12));

			return $deletion;
		};

		case token_kind::kw_new: {
			discard @this.take();
			var allocation = @this.node(syntax_kind::allocation, $token);
			var allocated_type = @this.type();
			bool array = allocated_type.get() && allocated_type.get()->kind() == syntax_kind::type_array;
			discard @this.add(@*allocation.get(), $allocated_type);

			if (@this.accept(token_kind::punct_left_paren)) {
				discard @this.add(@*allocation.get(), @this.arguments(token_kind::punct_right_paren));
			}
			else if (this.peek().kind == token_kind::punct_left_brace) {
				var opening = @this.take();
				discard @this.add(@*allocation.get(), @this.node(syntax_kind::list, opening));
				if (!(@this.require(token_kind::punct_right_brace, "uninitialized allocation requires empty '{}' delimiters")).has<void>()) {
					return rt::unique<Syntax>();
				};
			}
			else {
				if (array) {
					@this.fail("array allocation requires a construction argument list; use 'new T[count]()' for default construction");
					return rt::unique<Syntax>();
				};
				discard @this.add(@*allocation.get(), @this.node(syntax_kind::list, this.peek()));
			};

			return $allocation;
		};

		default:
			@this.fail("expected expression");
			return rt::unique<Syntax>();
	};
};

fn Parser::variable(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	var declared_type = @this.absent();
	var declared_name = @this.absent();

	if (start.kind == token_kind::kw_var) {
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.pending_less = this.pending_less;
		@candidate.selections = this.selections;
		@candidate.discoveries = this.discoveries;
		var typed = @candidate.type();
		if (typed.get() && @candidate.accept(token_kind::punct_ellipsis)) {
			var expanded = @candidate.node(syntax_kind::pack_expansion, typed.get()->token());
			discard @candidate.add(@*expanded.get(), rt::unique<Syntax>(@typed.release()));
			@typed = $expanded;
		};
		var named = @candidate.name();
		if (candidate.failure.empty() && typed.get() && named.get()) {
			@declared_type = rt::unique<Syntax>(@typed.release());
			@declared_name = rt::unique<Syntax>(@named.release());
			@this.offset = candidate.offset;
			@this.pending_greater = candidate.pending_greater;
			@this.pending_less = candidate.pending_less;
		}
		else {
			discard @this.take();
			@declared_name = @this.name();
			if (@this.accept(token_kind::punct_colon)) {
				@declared_type = @this.type();
			};
		};
	}
	else {
		@declared_type = @this.type();
		if (declared_type.get() && @this.accept(token_kind::punct_ellipsis)) {
			var expanded = @this.node(syntax_kind::pack_expansion, declared_type.get()->token());
			discard @this.add(@*expanded.get(), rt::unique<Syntax>(@declared_type.release()));
			@declared_type = $expanded;
		};
		@declared_name = @this.name();
	};

	var initializer = @this.absent();

	if (this.peek().kind == token_kind::op_assign || this.peek().kind == token_kind::op_copy) {
		Token operation = @this.take();
		var initialized = @this.node(syntax_kind::unary, operation);
		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			discard @this.add(@*initialized.get(), @this.node(syntax_kind::error_expression, this.peek()));
		}
		else {
			discard @this.add(@*initialized.get(), @this.expression(1));
		};
		@initializer = rt::unique<Syntax>(@initialized.release());
	}
	else if (this.peek().kind == token_kind::punct_left_brace) {
		@initializer = @this.primary();
	};

	if (!(@this.require(token_kind::punct_semicolon, "expected ';' after variable declaration")).has<void>()) {
		return rt::unique<Syntax>();
	};

	var result = @this.node(syntax_kind::variable, start);
	discard @this.add(@*result.get(), rt::unique<Syntax>(@declared_name.release()));
	discard @this.add(@*result.get(), rt::unique<Syntax>(@declared_type.release()));
	discard @this.add(@*result.get(), rt::unique<Syntax>(@initializer.release()));

	return $result;
};

fn Parser::parameters(var Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_right_paren)) {
		return $result;
	};

	while (this.failure.empty()) {
		Token location = this.peek();

		if (@this.accept(token_kind::punct_ellipsis)) {
			var variadic = @this.node(syntax_kind::parameter, location);
			discard @this.add(@*variadic.get(), @this.absent());
			discard @this.add(@*variadic.get(), @this.absent());
			discard @this.add(@*variadic.get(), @this.absent());
			discard @this.add(@*result.get(), $variadic);
			discard @this.require(token_kind::punct_right_paren, "expected ')' after variadic parameter");

			return $result;
		};

		discard @this.add(@*result.get(), @this.parameter());

		if (@this.accept(token_kind::punct_right_paren)) {
			return $result;
		};

		if (!(@this.require(token_kind::punct_comma, "expected ',' between parameters")).has<void>()) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::parameter_one(var Parser& this) -> rt::unique<Syntax> {
	Token location = this.peek();
	var parameter_type = @this.type();
	var parameter_name = @this.absent();

	if (this.peek().kind == token_kind::identifier) {
		@parameter_name = @this.name();
	};

	var default_value = @this.absent();

	if (@this.accept(token_kind::op_assign)) {
		@default_value = @this.expression(1);
	};

	var parameter = @this.node(syntax_kind::parameter, location);
	discard @this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_name.release()));
	discard @this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_type.release()));
	discard @this.add(@*parameter.get(), rt::unique<Syntax>(@default_value.release()));
	if (this.peek().kind != token_kind::punct_comma && this.peek().kind != token_kind::punct_right_paren) {
		@this.fail("expected ',' between parameters");
		return rt::unique<Syntax>();
	};
	return $parameter;
};

fn Parser::parameter(var Parser& this) -> rt::unique<Syntax> {
	rt::buffer<rt::unique<ParseChoices>> work;
	rt::buffer<rt::unique<Syntax>> alternatives;

	@work.push_back(rt::unique<ParseChoices>::make());

	usize next = 0;
	usize end = this.offset;
	usize pending = this.pending_greater;
	usize pending_opening = this.pending_less;
	usize failed_at = this.offset;
	Token failed_token = this.peek();
	rt::string_view failure = "expected parameter";

	while (next < work.size()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		var ParseChoices* choices = work.data()[next].get();
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.pending_less = this.pending_less;
		@candidate.selections = choices;
		rt::buffer<usize> discoveries;
		@candidate.discoveries = &@discoveries;
		var syntax = @candidate.parameter_one();

		if (syntax.get() && candidate.failure.empty()) {
			if (alternatives.size() && (candidate.offset != end || candidate.pending_greater != pending || candidate.pending_less != pending_opening)) {
				@this.fail("source interpretations have different statement boundaries");
				return rt::unique<Syntax>();
			};

			@end = candidate.offset;
			@pending = candidate.pending_greater;
			@pending_opening = candidate.pending_less;

			// A named reference parameter wins over the same token sequence
			// interpreted as an unnamed tuple. Parentheses make the latter explicit.
			bool named = syntax.get()->parameter_name()->kind() != syntax_kind::absent;
			if (alternatives.size() && !named && alternatives.data()[0].get()->parameter_name()->kind() != syntax_kind::absent) {
				@next = next + 1;
				continue;
			};
			if (named && alternatives.size() && alternatives.data()[0].get()->parameter_name()->kind() == syntax_kind::absent) {
				@alternatives.clear();
			};
			if (!(@this.alternative_add(@alternatives, rt::unique<Syntax>(@syntax.release()))).has<void>()) {
				return rt::unique<Syntax>();
			};
		}
		else if (!candidate.failure.empty() && candidate.offset >= failed_at) {
			@failed_at = candidate.offset;
			@failed_token := candidate.failure_location;
			@failure = candidate.failure;
		};

		usize index = 0;

		while (index < discoveries.size()) {
			usize position = discoveries.data()[index];

			if (!choices->contains(position)) {
				var extension = choices->extended(position);


				usize known = 0;

				while (known < work.size() && !work.data()[known].get()->same(*extension.get())) {
					@known = known + 1;
				};

				if (known == work.size()) {
					@work.push_back(rt::unique<ParseChoices>(@extension.release()));
				};
			};

			@index = index + 1;
		};

		@next = next + 1;
	};

	if (!alternatives.size()) {
		if (this.mode == parse_mode::editor && !@this.cancelled()) {
			usize start = this.offset;
			@this.synchronize(start);

			if (!this.failure.empty()) {
				return rt::unique<Syntax>();
			};
			return @this.node(syntax_kind::error_expression, failed_token);
		};
		@this.offset = failed_at;
		@this.failure_location := failed_token;
		@this.failure = $failure;

		return rt::unique<Syntax>();
	};

	@this.offset = end;
	@this.pending_greater = pending;
	@this.pending_less = pending_opening;

	return @this.factor(@alternatives);
};


fn Parser::exception_spec(var Parser& this) -> rt::unique<Syntax> {
	if (this.peek().kind != token_kind::kw_noexcept) {
		return @this.absent();
	};
	Token location = @this.take();
	var result = @this.node(syntax_kind::exception_specification, location);
	if (@this.accept(token_kind::punct_left_paren)) {
		discard @this.add(@*result.get(), @this.expression(1));
		discard @this.require(token_kind::punct_right_paren, "expected ')' after noexcept specification");
	}
	else {
		discard @this.add(@*result.get(), @this.absent());
	};
	return $result;
};

fn Parser::function(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::function, start);
	if (this.peek().kind == token_kind::literal_string) {
		if (!this.peek().is("\"C\"")) {
			@this.fail("unsupported function linkage; only \"C\" is supported");
			return rt::unique<Syntax>();
		};
		Token linkage = @this.take();
		@result.get()->set_function_linkage(linkage);
	};
	discard @this.add(@*result.get(), @this.name());

	if (!(@this.require(token_kind::punct_left_paren, "expected function parameter list")).has<void>()) {
		return rt::unique<Syntax>();
	};

	discard @this.add(@*result.get(), @this.parameters());
	var exception = @this.exception_spec();
	var result_type = @this.absent();

	if (@this.accept(token_kind::op_arrow)) {
		@result_type = @this.type();
	};

	discard @this.add(@*result.get(), rt::unique<Syntax>(@result_type.release()));
	var attributes = @this.node(syntax_kind::attributes, this.peek());
	if (exception.get()->kind() != syntax_kind::absent) {
		discard @this.add(@*attributes.get(), $exception);
	};

	if (@this.accept(token_kind::punct_colon)) {
		discard @this.require(token_kind::punct_left_bracket, "expected attribute list");

		while (this.peek().kind != token_kind::punct_right_bracket && this.peek().kind != token_kind::eof && this.failure.empty()) {
			discard @this.add(@*attributes.get(), @this.node(syntax_kind::name, @this.take()));

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		discard @this.require(token_kind::punct_right_bracket, "expected ']' after attributes");
	};

	discard @this.add(@*result.get(), rt::unique<Syntax>(@attributes.release()));
	if (this.peek().kind == token_kind::punct_semicolon) {
		discard @this.add(@*result.get(), @this.node(syntax_kind::noop, @this.take()));
	}
	else {
		discard @this.add(@*result.get(), @this.expression(1));
	};

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		discard @this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::record(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::record, start);

	if (this.peek().kind == token_kind::identifier) {
		discard @this.add(@*result.get(), @this.name());
	}
	else {
		discard @this.add(@*result.get(), @this.absent());
	};

	var bases = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_colon)) {
		discard @this.require(token_kind::punct_left_bracket, "expected '[' before record bases");

		while (this.failure.empty()) {
			discard @this.add(@*bases.get(), @this.type());

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		discard @this.require(token_kind::punct_right_bracket, "expected ']' after record bases");
	};

	discard @this.add(@*result.get(), rt::unique<Syntax>(@bases.release()));
	if (this.peek().kind != token_kind::punct_left_brace && this.peek().kind != token_kind::punct_semicolon) {
		@this.fail("expected record body or ';'");
		return rt::unique<Syntax>();
	};
	discard @this.add(@*result.get(), @this.primary());

	return $result;
};

fn Parser::enumeration(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::enumeration, start);
	discard @this.add(@*result.get(), @this.name());
	var underlying = @this.absent();

	if (@this.accept(token_kind::punct_colon)) {
		discard @this.require(token_kind::punct_left_bracket, "expected enum underlying type");
		@underlying = @this.type();
		discard @this.require(token_kind::punct_right_bracket, "expected ']' after enum underlying type");
	};

	discard @this.add(@*result.get(), rt::unique<Syntax>(@underlying.release()));
	var members = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_semicolon)) {
		@members = @this.node(syntax_kind::noop, start);
	}
	else {
		discard @this.require(token_kind::punct_left_brace, "expected enum body");

		while (this.failure.empty() && this.peek().kind != token_kind::punct_right_brace) {
			if (this.peek().kind == token_kind::kw_fn) {
				discard @this.add(@*members.get(), @this.function());
				continue;
			};

			Token member = this.peek();
			var entry = @this.node(syntax_kind::enumerator, member);
			discard @this.add(@*entry.get(), @this.name());

			if (@this.accept(token_kind::op_assign)) {
				discard @this.add(@*entry.get(), @this.expression(1));
			}
			else {
				discard @this.add(@*entry.get(), @this.absent());
			};

			discard @this.add(@*members.get(), rt::unique<Syntax>(@entry.release()));
			discard @this.require(token_kind::punct_semicolon, "expected ';' after enumerator");
		};

		discard @this.require(token_kind::punct_right_brace, "expected '}' after enum body");
		discard @this.accept(token_kind::punct_semicolon);
	};

	discard @this.add(@*result.get(), rt::unique<Syntax>(@members.release()));

	return $result;
};

fn Parser::namespace_body(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::namespace_body, start);
	discard @this.add(@*result.get(), @this.name());
	discard @this.add(@*result.get(), @this.expression(1));

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		discard @this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::template_declaration(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	if (this.peek().kind == token_kind::identifier) {
		var signature = @this.node(syntax_kind::pack_signature_declaration, start);
		Token name = this.peek();
		discard @this.take();
		discard @this.add(@*signature.get(), @this.node(syntax_kind::name, name));
		discard @this.require(token_kind::op_assign, "expected '=' after pack signature name");
		discard @this.add(@*signature.get(), @this.pack_signature());
		discard @this.require(token_kind::punct_semicolon, "expected ';' after pack signature declaration");
		return $signature;
	};
	var result = @this.node(syntax_kind::template_declaration, start);
	var parameters = @this.node(syntax_kind::list, this.peek());
	discard @this.open_template();

	while (this.failure.empty()) {
		Token location = this.peek();
		var parameter_type = @this.absent();
		if (!@this.accept(token_kind::kw_typename)) {
			if (this.peek().kind == token_kind::op_less || this.peek().kind == token_kind::op_shift_left) {
				@parameter_type = @this.pack_signature();
			}
			else {
				@parameter_type = @this.type();
			};
		};
		syntax_kind parameter_kind = syntax_kind::template_parameter;
		if (@this.accept(token_kind::punct_ellipsis)) {
			@parameter_kind = syntax_kind::template_variadic_parameter;
		};
		var parameter = @this.node(parameter_kind, location);
		discard @this.add(@*parameter.get(), $parameter_type);

		discard @this.add(@*parameter.get(), @this.name());

		if (@this.accept(token_kind::op_assign)) {
			if (location.kind == token_kind::kw_typename) {
				discard @this.add(@*parameter.get(), @this.type());
			}
			else {
				discard @this.add(@*parameter.get(), @this.expression(10));
			};
		}
		else {
			discard @this.add(@*parameter.get(), @this.absent());
		};

		discard @this.add(@*parameters.get(), rt::unique<Syntax>(@parameter.release()));

		if (!@this.accept(token_kind::punct_comma)) {
			break;
		};
		if (parameter_kind == syntax_kind::template_variadic_parameter) {
			@this.fail("variadic template parameter must be last");
		};
	};

	discard @this.close_template();
	discard @this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
	discard @this.add(@*result.get(), @this.statement());

	return $result;
};

fn Parser::control(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	discard @this.require(token_kind::punct_left_paren, "expected '(' before control condition");

	if (start.kind == token_kind::kw_for) {
		var loop = @this.node(syntax_kind::for_loop, start);
		discard @this.add(@*loop.get(), @this.statement());

		if (this.peek().kind == token_kind::punct_semicolon) {
			discard @this.add(@*loop.get(), @this.absent());
		}
		else {
			discard @this.add(@*loop.get(), @this.expression(1));
		};

		discard @this.require(token_kind::punct_semicolon, "expected ';' after for condition");

		if (this.peek().kind == token_kind::punct_right_paren) {
			discard @this.add(@*loop.get(), @this.absent());
		}
		else {
			discard @this.add(@*loop.get(), @this.expression(1));
		};

		discard @this.require(token_kind::punct_right_paren, "expected ')' after for control");
		discard @this.add(@*loop.get(), @this.statement());

		return $loop;
	};

	syntax_kind kind = syntax_kind::conditional;

	if (start.kind == token_kind::kw_while) {
		@kind = syntax_kind::while_loop;
	}
	else if (start.kind == token_kind::kw_switch) {
		@kind = syntax_kind::switch_expression;
	};

	var result = @this.node($kind, start);
	discard @this.add(@*result.get(), @this.expression(1));
	discard @this.require(token_kind::punct_right_paren, "expected ')' after condition");
	discard @this.add(@*result.get(), @this.statement());

	if (start.kind == token_kind::kw_if) {
		if (@this.accept(token_kind::kw_else)) {
			discard @this.add(@*result.get(), @this.statement());
		}
		else {
			discard @this.add(@*result.get(), @this.absent());
		};
	};

	return $result;
};

fn Parser::exception_statement(var Parser& this) -> rt::unique<Syntax> {
	Token opening = @this.take();
	var result = @this.node(syntax_kind::exception_try, opening);
	if (!(@this.require(token_kind::punct_left_brace, "expected '{' after try")).has<void>()) {
		return rt::unique<Syntax>();
	};
	discard @this.add(@*result.get(), @this.sequence(opening, token_kind::punct_right_brace, syntax_kind::brace));
	var handlers = @this.node(syntax_kind::list, this.peek());
	while (this.peek().kind == token_kind::kw_catch && this.failure.empty()) {
		Token location = @this.take();
		var handler = @this.node(syntax_kind::exception_handler, location);
		discard @this.require(token_kind::punct_left_paren, "expected '(' after catch");
		if (@this.accept(token_kind::punct_ellipsis)) {
			discard @this.add(@*handler.get(), @this.absent());
		}
		else {
			var parameter = @this.parameter();
			if (parameter.get() && parameter.get()->item(2)->kind() != syntax_kind::absent) {
				@this.fail("catch declaration cannot have a default argument");
			};
			discard @this.add(@*handler.get(), $parameter);
		};
		discard @this.require(token_kind::punct_right_paren, "expected ')' after exception declaration");
		discard @this.require(token_kind::punct_left_brace, "expected '{' before catch body");
		discard @this.add(@*handler.get(), @this.sequence(location, token_kind::punct_right_brace, syntax_kind::brace));
		discard @this.add(@*handlers.get(), $handler);
	};
	if (!handlers.get()->size()) {
		@this.fail("try requires at least one catch handler");
	};
	discard @this.add(@*result.get(), $handlers);
	return $result;
};

fn attributed_declaration(var Syntax& source) -> var Syntax* {
	if (source.kind() == syntax_kind::template_declaration) {
		return attributed_declaration(@*source.item(1));
	};
	if (source.kind() == syntax_kind::ambiguity) {
		usize index = 0;
		while (index < source.size()) {
			var Syntax* entity = attributed_declaration(@*source.item(index));
			if (entity) {
				return entity;
			};
			@index = index + 1;
		};
		return nullptr;
	};
	switch (source.kind()) {
		case syntax_kind::variable:
		case syntax_kind::function:
		case syntax_kind::record:
		case syntax_kind::enumeration:
		case syntax_kind::namespace_body:
		case syntax_kind::using_alias:
		case syntax_kind::pack_signature_declaration:
			return &@source;
		default:
			return nullptr;
	};
};

fn Parser::attribute_declaration(var Parser& this) -> rt::unique<Syntax> {
	discard @this.take();
	discard @this.require(token_kind::punct_left_bracket, "expected '[[' before declaration attribute");
	Token key = this.peek();
	discard @this.require(token_kind::identifier, "expected attribute name");
	var attribute = @this.node(syntax_kind::declaration_attribute, key);
	if (@this.accept(token_kind::punct_colon)) {
		var value_parser = Parser(*this.tokens);
		@value_parser.offset = this.offset;
		var value = @value_parser.expression(1);
		var type_parser = Parser(*this.tokens);
		@type_parser.offset = this.offset;
		var type = @type_parser.type();
		if (value.get() && value_parser.failure.empty() && value_parser.peek().kind == token_kind::punct_right_bracket) {
			@this.offset = value_parser.offset;
			if (type.get() && type_parser.failure.empty() && type_parser.offset == value_parser.offset) {
				var alternatives = @this.node(syntax_kind::ambiguity, value.get()->token());
				discard @this.add(@*alternatives.get(), $type);
				discard @this.add(@*alternatives.get(), rt::unique<Syntax>(@value.release()));
				@value = $alternatives;
			};
			discard @this.add(@*attribute.get(), $value);
		}
		else if (type.get() && type_parser.failure.empty() && type_parser.peek().kind == token_kind::punct_right_bracket) {
			@this.offset = type_parser.offset;
			discard @this.add(@*attribute.get(), $type);
		}
		else {
			@this.fail("expected attribute value or type");
			return rt::unique<Syntax>();
		};
	}
	else {
		discard @this.add(@*attribute.get(), @this.absent());
	};
	discard @this.require(token_kind::punct_right_bracket, "expected ']]' after declaration attribute");
	discard @this.require(token_kind::punct_right_bracket, "expected ']]' after declaration attribute");
	var declaration = @this.statement_one();
	if (!declaration.get()) {
		return rt::unique<Syntax>();
	};
	var Syntax* entity = attributed_declaration(@*declaration.get());
	if (!entity) {
		@this.fail("attributes require an entity declaration");
		return rt::unique<Syntax>();
	};
	@entity->add_declaration_attribute($attribute);
	return $declaration;
};

fn Parser::statement_one(var Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (token.kind == token_kind::kw_export) {
		discard @this.take();
		var declaration = @this.statement_one();
		if (!declaration.get()) {
			return rt::unique<Syntax>();
		};
		var Syntax* entity = attributed_declaration(@*declaration.get());
		if (!entity) {
			@this.fail("export requires an entity declaration");
			return rt::unique<Syntax>();
		};
		if (entity->exported()) {
			@this.fail("duplicate export qualifier");
			return rt::unique<Syntax>();
		};
		@entity->mark_exported();
		return $declaration;
	};

	if (token.kind == token_kind::punct_left_bracket) {
		return @this.attribute_declaration();
	};

	if (token.kind == token_kind::identifier && (token.is("public") || token.is("private") || token.is("protected"))) {
		discard @this.take();
		discard @this.require(token_kind::punct_colon, "expected ':' after access label");

		return @this.node(syntax_kind::access_label, token);
	};

	switch (token.kind) {
		case token_kind::kw_try:
			return @this.exception_statement();
		case token_kind::kw_case:
		case token_kind::kw_default: {
			discard @this.take();
			var label = @this.node(syntax_kind::case_label, token);

			if (token.kind == token_kind::kw_case) {
				discard @this.add(@*label.get(), @this.expression(1));
			}
			else {
				discard @this.add(@*label.get(), @this.absent());
			};

			discard @this.require(token_kind::punct_colon, "expected ':' after switch label");

			return $label;
		};

		case token_kind::kw_var:
			return @this.variable();
		case token_kind::kw_fn:
			return @this.function();
		case token_kind::kw_enum:
			return @this.enumeration();
		case token_kind::kw_namespace:
			return @this.namespace_body();
		case token_kind::kw_template:
			return @this.template_declaration();
		case token_kind::kw_using: {
			discard @this.take();
			var alias = @this.node(syntax_kind::using_alias, token);
			discard @this.add(@*alias.get(), @this.name());
			discard @this.require(token_kind::op_assign, "expected '=' in type alias");
			discard @this.add(@*alias.get(), @this.type());
			discard @this.require(token_kind::punct_semicolon, "expected ';' after alias");

			return $alias;
		};

		default:
			break;
	};

	// Parsing does not classify identifiers by their spelling. A declaration and
	// expression that consume the same tokens remain alternatives for name binding.
	var declaration_parser = Parser(*this.tokens);
		discard @declaration_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@declaration_parser.mode = this.mode;
	@declaration_parser.offset = this.offset;
	@declaration_parser.pending_greater = this.pending_greater;
	@declaration_parser.pending_less = this.pending_less;
	@declaration_parser.selections = this.selections;
	@declaration_parser.discoveries = this.discoveries;
	var declaration = @declaration_parser.variable();
	var expression_parser = Parser(*this.tokens);
		discard @expression_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@expression_parser.mode = this.mode;
	@expression_parser.offset = this.offset;
	@expression_parser.pending_greater = this.pending_greater;
	@expression_parser.pending_less = this.pending_less;
	@expression_parser.selections = this.selections;
	@expression_parser.discoveries = this.discoveries;
	var expression = @expression_parser.expression(1);

	if (expression.get() && expression_parser.failure.empty()) {
		syntax_kind kind = expression.get()->kind();

		if (kind != syntax_kind::noop && kind != syntax_kind::brace && kind != syntax_kind::conditional && kind != syntax_kind::while_loop && kind != syntax_kind::for_loop && kind != syntax_kind::switch_expression && kind != syntax_kind::record) {
			discard @expression_parser.require(token_kind::punct_semicolon, "expected ';' after expression");
		}
		else if (kind != syntax_kind::noop && (kind != syntax_kind::record || expression.get()->record_members()->kind() != syntax_kind::noop)) {
			discard @expression_parser.accept(token_kind::punct_semicolon);
		};
	};

	if (declaration.get() && declaration_parser.failure.empty()) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;
		@this.pending_less = declaration_parser.pending_less;

		if (expression.get() && expression_parser.failure.empty() && expression_parser.offset == declaration_parser.offset) {
			var alternatives = @this.node(syntax_kind::ambiguity, token);
			discard @this.add(@*alternatives.get(), rt::unique<Syntax>(@declaration.release()));
			discard @this.add(@*alternatives.get(), rt::unique<Syntax>(@expression.release()));

			return $alternatives;
		};

		return $declaration;
	};

	if (!declaration_parser.failure.empty() && !expression_parser.failure.empty() && declaration_parser.offset > expression_parser.offset) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;
		@this.pending_less = declaration_parser.pending_less;

		@this.failure := declaration_parser.failure;
		@this.failure_location := declaration_parser.failure_location;

		return rt::unique<Syntax>();
	};

	@this.offset = expression_parser.offset;
	@this.pending_greater = expression_parser.pending_greater;
	@this.pending_less = expression_parser.pending_less;

	if (!expression_parser.failure.empty()) {
		@this.failure := expression_parser.failure;
		@this.failure_location := expression_parser.failure_location;

		return rt::unique<Syntax>();
	};

	return $expression;
};

fn Parser::statement(var Parser& this) -> rt::unique<Syntax> {
	rt::buffer<rt::unique<ParseChoices>> work;
	rt::buffer<rt::unique<Syntax>> alternatives;

	@work.push_back(rt::unique<ParseChoices>::make());

	usize next = 0;
	usize end = this.offset;
	usize pending = this.pending_greater;
	usize pending_opening = this.pending_less;
	usize failed_at = this.offset;
	Token failed_token = this.peek();
	rt::string_view failure = "expected declaration or expression";

	while (next < work.size()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		var ParseChoices* choices = work.data()[next].get();
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.pending_less = this.pending_less;
		@candidate.selections = choices;
		rt::buffer<usize> discoveries;
		@candidate.discoveries = &@discoveries;
		var syntax = @candidate.statement_one();

		if (syntax.get() && candidate.failure.empty()) {
			if (alternatives.size() && (candidate.offset != end || candidate.pending_greater != pending || candidate.pending_less != pending_opening)) {
				@this.fail("source interpretations have different statement boundaries");
				return rt::unique<Syntax>();
			};

			@end = candidate.offset;
			@pending = candidate.pending_greater;
			@pending_opening = candidate.pending_less;

			if (!(@this.alternative_add(@alternatives, rt::unique<Syntax>(@syntax.release()))).has<void>()) {
				return rt::unique<Syntax>();
			};
		}
		else if (!candidate.failure.empty() && candidate.offset >= failed_at) {
			@failed_at = candidate.offset;
			@failed_token := candidate.failure_location;
			@failure = candidate.failure;
		};

		usize index = 0;

		while (index < discoveries.size()) {
			usize position = discoveries.data()[index];

			if (!choices->contains(position)) {
				var extension = choices->extended(position);


				usize known = 0;

				while (known < work.size() && !work.data()[known].get()->same(*extension.get())) {
					@known = known + 1;
				};

				if (known == work.size()) {
					@work.push_back(rt::unique<ParseChoices>(@extension.release()));
				};
			};

			@index = index + 1;
		};

		@next = next + 1;
	};

	if (!alternatives.size()) {
		if (this.mode == parse_mode::editor && !@this.cancelled()) {
			usize start = this.offset;
			@this.synchronize(start);

			if (!this.failure.empty()) {
				return rt::unique<Syntax>();
			};
			return @this.node(syntax_kind::error_expression, failed_token);
		};
		@this.offset = failed_at;
		@this.failure_location := failed_token;
		@this.failure = $failure;

		return rt::unique<Syntax>();
	};

	@this.offset = end;
	@this.pending_greater = pending;
	@this.pending_less = pending_opening;

	return @this.factor(@alternatives);
};

fn Parser::alternative_add(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> CompilationResult {
	if (syntax.get()->kind() == syntax_kind::ambiguity) {
		usize index = 0;

		while (index < syntax.get()->size()) {
			if (!(@this.alternative_add(@alternatives, @syntax.get()->take_item(index))).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};

		return;
	};

	usize index = 0;

	while (index < alternatives.size()) {
		if (alternatives.data()[index].get()->same_tree(*syntax.get())) {
			return;
		};

		@index = index + 1;
	};

	@alternatives.push_back($syntax);

};

fn Parser::factor(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	// Factor each parent shape before preserving alternatives of different grammar roles.
	// This keeps type/value choices local even when declarations also compete with expressions.
	rt::buffer<rt::unique<Syntax>> factored;
	usize index = 0;

	while (index < alternatives.size()) {
		var Syntax* first = alternatives.data()[index].get();

		if (!first) {
			@index = index + 1;
			continue;
		};

		rt::buffer<rt::unique<Syntax>> group;
		usize candidate = index;

		while (candidate < alternatives.size()) {
			var Syntax* other = alternatives.data()[candidate].get();

			if (other && other->kind() == first->kind() && other->token().source == first->token().source && other->token().begin == first->token().begin && other->token().length == first->token().length && other->size() == first->size()) {
				if (!(@this.alternative_add(@group, rt::unique<Syntax>(@((@alternatives).data()[candidate]).release()))).has<void>()) {
					return rt::unique<Syntax>();
				};
			};

			@candidate = candidate + 1;
		};

		if (!(@this.alternative_add(@factored, @this.factor_group(@group))).has<void>()) {
			return rt::unique<Syntax>();
		};

		@index = index + 1;
	};

	return @this.factor_group(@factored);
};

fn Parser::factor_group(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	if (alternatives.size() == 1) {
		return rt::unique<Syntax>(@((@alternatives).data()[0]).release());
	};

	var Syntax* first = alternatives.data()[0].get();
	usize difference = usize::max;
	bool compatible = true;
	usize candidate = 1;

	while (candidate < alternatives.size() && compatible) {
		var Syntax* other = alternatives.data()[candidate].get();

		if (other->kind() != first->kind() || other->token().source != first->token().source || other->token().begin != first->token().begin || other->token().length != first->token().length || other->size() != first->size() || !other->same_declaration_metadata(*first)) {
			@compatible = false;
			break;
		};

		usize index = 0;

		while (index < first->size()) {
			if (!first->item(index)->same_tree(*other->item(index))) {
				if (first->kind() == syntax_kind::call && !index) {
					@compatible = false;
					break;
				};

				@difference = index;
			};

			@index = index + 1;
		};

		@candidate = candidate + 1;
	};

	if (compatible) {
		// Independent child choices may be factored only when every combination
		// occurs in the parsed alternatives. Unique trees make the product count
		// a completeness proof; correlated grammar choices remain whole trees.
		usize combinations = 1;
		usize index = 0;

		while (index < first->size() && compatible) {
			usize distinct = 0;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				usize previous = 0;

				while (previous < candidate && !alternatives.data()[previous].get()->item(index)->same_tree(*alternatives.data()[candidate].get()->item(index))) {
					@previous = previous + 1;
				};

				if (previous == candidate) {
					@distinct = distinct + 1;
				};

				@candidate = candidate + 1;
			};

			if (distinct > alternatives.size() / combinations) {
				@compatible = false;
				break;
			};

			@combinations = combinations * distinct;
			@index = index + 1;
		};

		if (combinations != alternatives.size()) {
			@compatible = false;
		};
	};

	if (compatible && difference != usize::max) {
		var result = @this.node(first->kind(), first->token());
		Token linkage = first->function_linkage();
		@result.get()->set_function_linkage(linkage);
		if (first->exported()) {
			@result.get()->mark_exported();
		};
		usize attribute = 0;
		while (attribute < first->declaration_attributes().size()) {
			@result.get()->add_declaration_attribute(@first->take_declaration_attribute(attribute));
			@attribute = attribute + 1;
		};
		usize index = 0;

		while (index < first->size()) {
			rt::buffer<rt::unique<Syntax>> children;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				if (!(@this.alternative_add(@children, @alternatives.data()[candidate].get()->take_item(index))).has<void>()) {
					return rt::unique<Syntax>();
				};

				@candidate = candidate + 1;
			};

			discard @this.add(@*result.get(), @this.factor(@children));
			@index = index + 1;
		};

		return $result;
	};

	var result = @this.node(syntax_kind::ambiguity, first->token());
	usize index = 0;

	while (index < alternatives.size()) {
		discard @this.add(@*result.get(), rt::unique<Syntax>(@((@alternatives).data()[index]).release()));
		@index = index + 1;
	};

	return $result;
};

fn ParseChoices::contains(ParseChoices& this, usize position) -> bool {
	usize index = 0;

	while (index < this.operators.size()) {
		if (this.operators.data()[index] == position) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ParseChoices::extended(ParseChoices& this, usize position) -> rt::unique<ParseChoices> {
	rt::unique<ParseChoices> result = rt::unique<ParseChoices>::make();
	usize index = 0;

	while (index < this.operators.size()) {
		@result.get()->operators.push_back(usize(this.operators.data()[index]));

		@index = index + 1;
	};

	@result.get()->operators.push_back($position);

	return $result;
};

fn ParseChoices::same(ParseChoices& this, ParseChoices& other) -> bool {
	if (this.operators.size() != other.operators.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.operators.size()) {
		if (!other.contains(usize(this.operators.data()[index]))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

enum source_origin : [u08] {
	input;
	compiler_generated;
};

struct SourceFile {
	fn SourceFile(var SourceFile& this) : [default];

	fn assign(var SourceFile& this, rt::string_view path, rt::string_view text);
	fn append_token(var SourceFile& this, Token token);
	fn append_comment(var SourceFile& this, Token comment);
	fn clear_tokens(var SourceFile& this);

	fn path(SourceFile& this) -> rt::string_view;
	fn text(SourceFile& this) -> rt::string_view;
	fn line(SourceFile& this, usize number) -> rt::string_view;
	fn tokens(SourceFile& this) -> rt::buffer<Token>&;
	fn comments(SourceFile& this) -> rt::buffer<Token>&;
	fn token_count(SourceFile& this) -> usize;
	fn set_module(var SourceFile& this, rt::string_view name, i32 access);
	fn module_name(SourceFile& this) -> rt::string_view;
	fn imported(SourceFile& this) -> bool;
	fn test_access(SourceFile& this) -> bool;
	fn compiler_generated(SourceFile& this) -> bool;
	fn mark_compiler_generated(var SourceFile& this);

private:
	rt::string file_path;
	rt::string contents;
	rt::buffer<usize> line_offsets;
	rt::buffer<Token> token_buffer;
	rt::buffer<Token> comment_buffer;
	rt::string owning_module;
	i32 module_access;
	source_origin origin;
};

fn SourceFile::set_module(var SourceFile& this, rt::string_view name, i32 access) {
	@this.owning_module = rt::string(name);
	@this.module_access = $access;
};

fn SourceFile::module_name(SourceFile& this) -> rt::string_view {
	return this.owning_module.view();
};

fn SourceFile::imported(SourceFile& this) -> bool {
	return this.module_access != 0;
};

fn SourceFile::compiler_generated(SourceFile& this) -> bool {
	return this.origin == source_origin::compiler_generated;
};

fn SourceFile::mark_compiler_generated(var SourceFile& this) {
	@this.origin = source_origin::compiler_generated;
};

fn SourceFile::test_access(SourceFile& this) -> bool {
	return this.module_access == 2;
};

struct SourceManager {
	fn add(var SourceManager& this, rt::string_view path, rt::string_view text) -> var SourceFile*;
	fn at(auto SourceManager& this, usize index) -> const[this] SourceFile*;
	fn clear(var SourceManager& this);

	fn count(SourceManager& this) -> usize;

private:
	rt::buffer<rt::unique<SourceFile>> files;
};

fn SourceFile::assign(var SourceFile& this, rt::string_view path, rt::string_view text) {
	rt::string next_path;
	rt::string next_text;
	rt::buffer<usize> next_lines;

	@next_path.append(path);
	@next_text.append(text);
	@next_lines.push_back(0);

	usize offset = 0;

	while (offset < text.size()) {
		if (text.data()[offset] == '\n') {
			@next_lines.push_back(offset + 1);
		};

		@offset = offset + 1;
	};

	@this.origin = source_origin::input;
	@this.token_buffer.clear();
	@this.comment_buffer.clear();
	@this.file_path = $next_path;
	@this.contents = $next_text;
	@this.line_offsets = $next_lines;

};

fn SourceFile::path(SourceFile& this) -> rt::string_view {
	return this.file_path.view();
};

fn SourceFile::text(SourceFile& this) -> rt::string_view {
	return this.contents.view();
};

fn SourceFile::line(SourceFile& this, usize number) -> rt::string_view {
	if (!number || number > this.line_offsets.size()) {
		return rt::string_view();
	};

	usize begin = this.line_offsets.data()[number - 1];
	usize end = this.contents.size();

	if (number < this.line_offsets.size()) {
		@end = this.line_offsets.data()[number] - 1;
	};

	if (end > begin && this.contents.data()[end - 1] == '\r') {
		@end = end - 1;
	};

	return rt::string_view(this.contents.data() + begin, end - begin);
};

fn SourceFile::tokens(SourceFile& this) -> rt::buffer<Token>& {
	return this.token_buffer;
};

fn SourceFile::comments(SourceFile& this) -> rt::buffer<Token>& {
	return this.comment_buffer;
};

fn SourceFile::token_count(SourceFile& this) -> usize {
	return this.token_buffer.size();
};

fn SourceFile::append_token(var SourceFile& this, Token token) {
	@this.token_buffer.push_back($token);
};

fn SourceFile::append_comment(var SourceFile& this, Token comment) {
	@this.comment_buffer.push_back($comment);
};

fn SourceFile::clear_tokens(var SourceFile& this) {
	@this.token_buffer.clear();
	@this.comment_buffer.clear();
};

fn SourceManager::add(var SourceManager& this, rt::string_view path, rt::string_view text) -> var SourceFile* {
	rt::unique<SourceFile> file = rt::unique<SourceFile>::make();

	@file.get()->assign(path, text);

	var SourceFile* result = file.get();

	@this.files.push_back($file);

	return result;
};

fn SourceManager::count(SourceManager& this) -> usize {
	return this.files.size();
};

fn SourceManager::at(auto SourceManager& this, usize index) -> const[this] SourceFile* {
	if (index >= this.files.size()) {
		return nullptr;
	};

	return const_cast<const[this] SourceFile*>(this.files.data()[index].get());
};

fn SourceManager::clear(var SourceManager& this) {
	@this.files.clear();
};



enum token_kind : [i32] {
	identifier;
	literal_number;
	literal_string;
	kw_fn;
	kw_using;
	kw_const;
	kw_discard;
	kw_delete;
	kw_new;
	kw_implicit;
	kw_nullptr;
	kw_template;
	kw_export;
	kw_typename;
	kw_class;
	kw_var;
	kw_struct;
	kw_union;
	kw_enum;
	kw_namespace;
	kw_virtual;
	kw_override;
	kw_final;
	kw_return;
	kw_try;
	kw_catch;
	kw_throw;
	kw_noexcept;
	kw_if;
	kw_else;
	kw_while;
	kw_for;
	kw_switch;
	kw_case;
	kw_default;
	kw_break;
	kw_continue;
	kw_sizeof;
	op_arrow;
	op_copy;
	op_equal;
	op_not_equal;
	op_less_equal;
	op_greater_equal;
	op_and;
	op_or;
	op_shift_left;
	op_shift_right;
	punct_ellipsis;
	punct_left_paren;
	punct_right_paren;
	punct_left_bracket;
	punct_right_bracket;
	punct_left_brace;
	punct_right_brace;
	punct_semicolon;
	punct_comma;
	punct_colon;
	op_scope;
	op_dot;
	op_assign;
	op_plus;
	op_plus_assign;
	op_minus;
	op_star;
	op_slash;
	op_remainder;
	op_ampersand;
	op_pipe;
	op_caret;
	op_bang;
	op_tilde;
	op_access;
	op_relocate;
	op_less;
	op_greater;
	eof;
};

struct Token {
	fn text(Token& this) -> rt::string_view;
	fn is(Token& this, rt::string_view spelling) -> bool;
	fn same(Token& this, Token& other) -> bool;

	var SourceFile* source;
	usize begin;
	usize length;
	usize line;
	usize column;
	token_kind kind;
};

fn Token::text(Token& this) -> rt::string_view {
	if (!this.source) {
		return rt::string_view();
	};

	var source = this.source->text();

	if (this.begin > source.size() || this.length > source.size() - this.begin) {
		return rt::string_view();
	};

	return rt::string_view(source.data() + this.begin, this.length);
};

fn Token::is(Token& this, rt::string_view spelling) -> bool {
	return this.source && this.text() == spelling;
};

fn Token::same(Token& this, Token& other) -> bool {
	return this.source && other.source && this.text() == other.text();
};

struct AnalysisCancellationScope {
	fn AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics);
	fn ~AnalysisCancellationScope(var AnalysisCancellationScope& this);

private:
	var Diagnostics* diagnostics;
};

fn AnalysisCancellationScope::AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn AnalysisCancellationScope::~AnalysisCancellationScope(var AnalysisCancellationScope& this) {
	@this.diagnostics->set_cancellation(nullptr, nullptr);
};

fn Analysis::analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, false);
};

fn Analysis::analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> AnalysisResult {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, true);
};

fn Analysis::analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> AnalysisResult {
	@this.messages.set_cancellation(cancelled, context);
	var cancellation_scope = AnalysisCancellationScope(@this.messages);
	@this.target_pointer_bits = pointer_bits;
	@this.semantic_unit = rt::unique<SemanticUnit>::make();
	Token location;
	if (pointer_bits != 32 && pointer_bits != 64) {
		@this.messages.error(location, "language analysis requires a 32-bit or 64-bit target");
		return compilation_error();
	};
	Diagnostics parse_errors;
	this.progress.report("parsing", 0, this.sources.count(), "");
	usize index = 0;
	while (index < this.sources.count()) {
		if (this.messages.cancelled()) {
			return analysis_cancelled_error();
		};
		var SourceFile* file = @this.sources.at(index);
		var lexer = Lexer(@*file);
		if (!(@lexer.scan()).has<void>()) {
			@parse_errors.syntax_error(lexer.error_token(), lexer.error());
			@index = index + 1;
			continue;
		};
		var parser = Parser(file->tokens());
		@parser.set_cancellation(cancelled, context);
		ParseResult parsed;
		if (editor) {
			@parsed = @parser.parse_editor();
			usize issue = 0;
			while (issue < parser.issues().size()) {
				@parse_errors.syntax_error(parser.issues().data()[issue].location, parser.issues().data()[issue].message.view());
				@issue = issue + 1;
			};
		}
		else {
			@parsed = @parser.parse();
		};
		if (parsed.has<compilation_error>()) {
			if (this.messages.cancelled()) {
				return analysis_cancelled_error();
			};
			@parse_errors.syntax_error(parser.error_token(), parser.error());
		}
		else {
			var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
			@this.syntax.push_back(rt::unique<Syntax>(@tree.release()));
		};
		@index = index + 1;
		this.progress.report("parsing", index, this.sources.count(), file->path());
	};
	if (this.tests_enabled) {
		var runner = TestRunnerSource();
		usize root = 0;
		while (root < this.syntax.size()) {
			Syntax& syntax = *this.syntax.data()[root].get();
			if (!syntax.token().source || !syntax.token().source->imported()) {
				@runner.collect(syntax, "", @this.messages);
			};
			@root = root + 1;
		};
		var generated = rt::string();
		runner.generate(@generated);
		@this.add_source("<generated-test-runner>", generated.view());
		var SourceFile* file = @this.sources.at(this.sources.count() - 1);
		rt::string_view module = "__rutile_test_runtime";
		usize source = 0;
		while (source + 1 < this.sources.count()) {
			SourceFile& input = *this.sources.at(source);
			if (!input.imported() && !input.module_name().empty()) {
				@module = input.module_name();
				break;
			};
			@source = source + 1;
		};
		@file->set_module(module, 0);
		@file->mark_compiler_generated();
		var lexer = Lexer(@*file);
		if (!(@lexer.scan()).has<void>()) {
			@this.messages.syntax_error(lexer.error_token(), lexer.error());
			return compilation_error();
		};
		var parser = Parser(file->tokens());
		var parsed = @parser.parse();
		if (parsed.has<compilation_error>()) {
			@this.messages.syntax_error(parser.error_token(), parser.error());
			return compilation_error();
		};
		var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
		@this.syntax.push_back(rt::unique<Syntax>(@tree.release()));
	};
	var analyzer = Analyzer(@this.types, @this.messages, $pointer_bits);
	@analyzer.set_progress(this.progress);
	@analyzer.set_editor($editor);
	var analyzed = @analyzer.analyze_into(@*this.semantic_unit.get(), this.syntax);
	if (!analyzed.has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
		compiler_panic("semantic analysis failed without a diagnostic");
	};
	if (analyzed.has<void>() && this.template_selection.get()) {
		var EditorTemplateSelection& selection = @*this.template_selection.get();
		rt::string input;
		@input.append("using __context = __arguments<");
		@input.append(selection.arguments.view());
		@input.append(">;");
		@selection.input.assign(selection.path.view(), input.view());
		var lexer = Lexer(@selection.input);
		if (!(@lexer.scan()).has<void>()) {
			@this.messages.syntax_error(lexer.error_token(), lexer.error());
			@analyzed = CompilationResult(compilation_error());
		}
		else {
			var parser = Parser(selection.input.tokens());
			@parser.set_cancellation(cancelled, context);
			var parsed = @parser.parse();
			if (parsed.has<rt::unique<Syntax>>()) {
				var rt::unique<Syntax>& tree = (@parsed).get<rt::unique<Syntax>>();
				@selection.syntax = rt::unique<Syntax>(@tree.release());
			};
			if (parsed.has<compilation_error>()) {
				@this.messages.syntax_error(parser.error_token(), parser.error());
				@analyzed = CompilationResult(compilation_error());
			}
			else if (selection.syntax.get()->size() != 1 || selection.syntax.get()->item(0)->kind() != syntax_kind::using_alias) {
				@this.messages.error(location, "enter only template arguments, without declarations or statements");
				@analyzed = CompilationResult(compilation_error());
			}
			else {
				usize source = 0;
				while (source < this.sources.count() && this.sources.at(source)->path() != selection.path.view()) {
					@source = source + 1;
				};
				var Syntax* applied = selection.syntax.get()->item(0)->alias_type();
				while (applied->kind() == syntax_kind::type_name) {
					@applied = applied->designated_type();
				};
				if (source == this.sources.count() || applied->kind() != syntax_kind::template_apply) {
					@this.messages.error(location, "cannot read the template argument list");
					@analyzed = CompilationResult(compilation_error());
				}
				else {
					@analyzed = @analyzer.editor_template_context(@*this.semantic_unit.get(), @*(@this.sources).at(source), selection.anchor, @*applied->arguments(), @selection.label);
				};
			};
		};
	};
	if (analyzed.has<void>()) {
		var facts = InferredFacts(@this.messages);
		if (!(@facts.validate(@*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
			compiler_panic("inferred fact analysis failed without a diagnostic");
		};
		this.progress.report("lifetimes", 0, 1, "");
		var lifetimes = LifetimeAnalyzer(@this.messages);
		if (!(@lifetimes.validate(*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
			compiler_panic("lifetime analysis failed without a diagnostic");
		};
		this.progress.report("lifetimes", 1, 1, "");
		if (!this.messages.failed()) {
			this.progress.report("reference-loans", 0, 1, "");
			var loans = ReferenceLoanAnalyzer(@this.messages);
			if (!(@loans.validate(*this.semantic_unit.get())).has<void>() && !this.messages.failed() && !this.messages.cancelled()) {
				compiler_panic("reference loan analysis failed without a diagnostic");
			};
			this.progress.report("reference-loans", 1, 1, "");
		};
	};
	if (this.messages.cancelled()) {
		return analysis_cancelled_error();
	};
	rt::buffer<DiagnosticRecord>& records = parse_errors.records();
	@index = 0;
	while (index < records.size()) {
		DiagnosticRecord& record = records.data()[index];
		@this.messages.error(record.location, record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			@this.messages.note(record.notes.data()[note].location, record.notes.data()[note].message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
	@this.index.build(*this.semantic_unit.get());
	if (this.messages.failed()) {
		return compilation_error();
	};
};




fn NavigationIndex::range(NavigationIndex& this, Token& token) -> SourceRange {
	SourceRange result;
	@result.source = usize::max;
	if (!token.source) {
		return $result;
	};
	SourceFile* source = token.source;
	usize* id = this.source_ids.find(source);
	if (id) {
		@result.source = *id;
		@result.begin = token.begin;
		@result.end = token.begin + token.length;
	};
	return $result;
};

fn NavigationIndex::symbol_id(NavigationIndex& this, Entity* entity) -> u64 {
	if (!entity) {
		return 0;
	};
	Entity* canonical = entity->canonical();
	u64* id = this.ids.find(canonical);
	if (!id) {
		return 0;
	};
	return *id;
};

fn NavigationIndex::declaration_name(NavigationIndex& this, var Syntax& declaration) -> Token {
	var Syntax* source = &@declaration;
	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};
	var Syntax* name = nullptr;
	switch (source->kind()) {
		case syntax_kind::function: @name = source->function_name(); break;
		case syntax_kind::record: @name = source->record_name(); break;
		case syntax_kind::enumeration: @name = source->enum_name(); break;
		case syntax_kind::namespace_body: @name = source->namespace_name(); break;
		case syntax_kind::using_alias: @name = source->alias_name(); break;
		case syntax_kind::variable: @name = source->variable_name(); break;
		case syntax_kind::parameter: @name = source->parameter_name(); break;
		case syntax_kind::template_parameter: @name = source->template_parameter_name(); break;
		case syntax_kind::enumerator: @name = source->enumerator_name(); break;
	};
	if (!name) {
		Token missing;
		return $missing;
	};
	while (name->kind() == syntax_kind::qualified_name || name->kind() == syntax_kind::template_apply || name->kind() == syntax_kind::unary) {
		if (name->kind() == syntax_kind::qualified_name) {
			@name = name->right();
		}
		else if (name->kind() == syntax_kind::template_apply) {
			@name = name->callable();
		}
		else {
			@name = name->operand();
		};
	};
	return name->token();
};

fn NavigationIndex::symbol_kind(NavigationIndex& this, Entity& entity) -> u32 {
	if (entity.declaration() && entity.declaration()->kind() == syntax_kind::template_parameter) {
		return 26;
	};
	switch (entity.kind()) {
		case entity_kind::function:
			if (entity.role() == function_role::constructor) {
				return 9;
			};
			if (entity.scope() && entity.scope()->owner() && entity.scope()->owner()->kind() == entity_kind::record) {
				return 6;
			};
			return 12;
		case entity_kind::record: return 23;
		case entity_kind::field: return 8;
		case entity_kind::field_pack: return 8;
		case entity_kind::enumeration: return 10;
		case entity_kind::enumerator: return 22;
		case entity_kind::namespace_body: return 3;
		case entity_kind::type_parameter: return 26;
		case entity_kind::constant: return 14;
		case entity_kind::template_pattern: {
			var Syntax* declaration = entity.declaration();
			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};
			if (declaration->kind() == syntax_kind::record) {
				return 23;
			};
			if (declaration->kind() == syntax_kind::namespace_body) {
				return 3;
			};
			return 12;
		};
	};
	return 13;
};

fn NavigationIndex::build(var NavigationIndex& this, SemanticUnit& semantics) {
	rt::buffer<rt::unique<Entity>>& entities = semantics.entities();
	usize index = 0;
	while (index < entities.size()) {
		var Entity* entity = entities.data()[index].get()->canonical();
		@index = index + 1;
		if (entity->origin() == declaration_origin::compiler_supplied || this.symbol_id(entity)) {
			continue;
		};
		rt::unique<NavigationEntry> entry = rt::unique<NavigationEntry>::make();
		@entry.get()->entity = entity;
		@entry.get()->value.id = static_cast<u64>(this.symbols.size()) + 1;
		@entry.get()->value.kind = this.symbol_kind(*entity);
		@entry.get()->value.declaration = this.range(entity->token());
		@entry.get()->value.definition.source = usize::max;
		@entry.get()->name.append(entity->name());
		var detail = DiagnosticMessage();
		diagnostic_entity(@detail, *entity);
		if (entity->type()) {
			@detail.text(": ");
			diagnostic_type(@detail, *entity->type());
		};
		@entry.get()->detail.append(detail.view());
		@entry.get()->value.name = entry.get()->name.view();
		@entry.get()->value.detail = entry.get()->detail.view();
		usize parameter_index = 0;
		while (parameter_index < entity->parameters().size()) {
			var Entity* parameter = entity->parameters().data()[parameter_index];
			@parameter_index = parameter_index + 1;
			rt::unique<NavigationParameterEntry> parameter_entry = rt::unique<NavigationParameterEntry>::make();
			var parameter_detail = DiagnosticMessage();
			@parameter_detail.text(parameter->name());
			@parameter_detail.text(": ");
			if (parameter->type()) {
				diagnostic_type(@parameter_detail, *parameter->type());
			};
			@parameter_entry.get()->detail.append(parameter_detail.view());
			@parameter_entry.get()->value.name = parameter->name();
			@parameter_entry.get()->value.detail = parameter_entry.get()->detail.view();
			@entry.get()->parameters.push_back($parameter_entry);
		};
		var Syntax* declaration = entity->declaration();
		if (declaration) {
			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};
			bool defined = true;
			if (declaration->kind() == syntax_kind::function) {
				@defined = declaration->function_body()->kind() != syntax_kind::noop || entity->definition() == function_definition::defaulted || entity->definition() == function_definition::deleted;
			}
			else if (declaration->kind() == syntax_kind::record) {
				@defined = declaration->record_members()->kind() != syntax_kind::noop;
			};
			if (defined) {
				@entry.get()->value.definition = this.range(this.declaration_name(@*declaration));
				@entry.get()->value.flags = 1;
			};
			if (declaration->kind() == syntax_kind::template_parameter) {
				@entry.get()->value.flags = entry.get()->value.flags | 2;
			};
		};
		if (entity->instantiated()) {
			@entry.get()->value.flags = entry.get()->value.flags | 4;
		};
		Entity* key = entity;
		bool inserted = @this.ids.insert($key, u64(entry.get()->value.id));
		if (!inserted) {
			compiler_panic("symbol is already registered");
		};
		@this.symbols.push_back($entry);
	};

	@index = 0;
	while (index < this.symbols.size()) {
		var NavigationEntry* entry = this.symbols.data()[index].get();
		var Entity* entity = entry->entity;
		@entry->value.origin = this.symbol_id(semantics.template_origin(*entity));
		var Scope* scope = entity->scope();
		while (scope && !scope->owner()) {
			@scope = scope->parent();
		};
		if (scope) {
			@entry->value.container = this.symbol_id(scope->owner());
		};
		NavigationOccurrence occurrence;
		@occurrence.range = entry->value.declaration;
		@occurrence.symbol = entry->value.id;
		@occurrence.roles = 1;
		if (entity->scope()) {
			@occurrence.context = this.symbol_id(semantics.reference_context(@*entity->scope()));
		};
		if (occurrence.range.source != usize::max) {
			@this.occurrences.push_back($occurrence);
		};
		if (entry->value.definition.source != usize::max && (entry->value.definition.source != entry->value.declaration.source || entry->value.definition.begin != entry->value.declaration.begin)) {
			NavigationOccurrence definition;
			@definition.range = entry->value.definition;
			@definition.symbol = entry->value.id;
			@definition.roles = 1;
			@this.occurrences.push_back($definition);
		};
		@index = index + 1;
	};

	rt::buffer<ResolvedReference>& references = semantics.references();
	@index = 0;
	while (index < references.size()) {
		ResolvedReference& reference = references.data()[index];
		NavigationOccurrence occurrence;
		@occurrence.range = this.range(reference.location);
		@occurrence.symbol = this.symbol_id(reference.target);
		@occurrence.context = this.symbol_id(reference.context);
		@occurrence.roles = reference.roles;
		if (occurrence.symbol && occurrence.range.source != usize::max) {
			@this.occurrences.push_back($occurrence);
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < semantics.classifications().size()) {
		SemanticClassification& source = semantics.classifications().data()[index];
		NavigationClassification classification;
		@classification.range = this.range(source.location);
		@classification.type = source.type;
		@classification.modifiers = source.modifiers;
		@this.classifications.push_back($classification);
		@index = index + 1;
	};
	@this.build_contexts(semantics);
	@this.build_receivers(semantics);
};

fn NavigationIndex::register_source(var NavigationIndex& this, var SourceFile& source, usize index) {
	SourceFile* key = &@source;
	bool inserted = @this.source_ids.insert($key, $index);
	if (!inserted) {
		compiler_panic("source is already registered");
	};
};

fn NavigationIndex::symbol_count(NavigationIndex& this) -> usize {
	return this.symbols.size();
};

fn NavigationIndex::symbol_at(NavigationIndex& this, usize index) -> NavigationSymbol* {
	if (index >= this.symbols.size()) {
		return nullptr;
	};
	return &@this.symbols.data()[index].get()->value;
};

fn NavigationIndex::occurrence_count(NavigationIndex& this) -> usize {
	return this.occurrences.size();
};

fn NavigationIndex::occurrence_at(NavigationIndex& this, usize index) -> NavigationOccurrence* {
	if (index >= this.occurrences.size()) {
		return nullptr;
	};
	return &@this.occurrences.data()[index];
};

fn NavigationIndex::syntax_range(NavigationIndex& this, Syntax& syntax) -> SourceRange {
	var result = this.range(syntax.token());
	usize index = 0;
	while (index < syntax.size()) {
		var child = this.syntax_range(*syntax.item(index));
		if (child.source != usize::max && (result.source == usize::max || child.source == result.source)) {
			if (result.source == usize::max) {
				@result = child;
			}
			else {
				if (child.begin < result.begin) {
					@result.begin = child.begin;
				};
				if (child.end > result.end) {
					@result.end = child.end;
				};
			};
		};
		@index = index + 1;
	};
	Token opening = syntax.token();
	if (syntax.kind() == syntax_kind::unit && opening.source) {
		@result.begin = 0;
		@result.end = opening.source->text().size();
	};
	if (opening.source && (opening.kind == token_kind::punct_left_brace || opening.kind == token_kind::punct_left_paren || opening.kind == token_kind::punct_left_bracket)) {
		rt::buffer<Token>& tokens = opening.source->tokens();
		usize depth = 0;
		@index = 0;
		while (index < tokens.size()) {
			Token token = tokens.data()[index];
			@index = index + 1;
			if (token.begin < opening.begin) {
				continue;
			};
			if (token.kind == opening.kind) {
				@depth = depth + 1;
			};
			bool closes = opening.kind == token_kind::punct_left_brace && token.kind == token_kind::punct_right_brace || opening.kind == token_kind::punct_left_paren && token.kind == token_kind::punct_right_paren || opening.kind == token_kind::punct_left_bracket && token.kind == token_kind::punct_right_bracket;
			if (closes) {
				@depth = depth - 1;
				if (!depth) {
					@result.end = token.begin + token.length;
					break;
				};
			};
		};
	};
	return $result;
};

fn NavigationIndex::scope_id(var NavigationIndex& this, Scope& scope) -> u64 {
	Scope* key = &@scope;
	u64* present = this.scope_ids.find(key);
	if (present) {
		return *present;
	};
	NavigationScope descriptor;
	@descriptor.range.source = usize::max;
	if (scope.parent()) {
		@descriptor.parent = @this.scope_id(*scope.parent());
	};
	Scope* cursor = &@scope;
	while (cursor) {
		if (cursor->owner() && cursor->owner()->instantiated()) {
			@descriptor.context = this.symbol_id(cursor->owner());
			if (cursor == &@scope && cursor->owner()->declaration()) {
				@descriptor.range = this.syntax_range(*cursor->owner()->declaration());
			};
			break;
		};
		@cursor = cursor->parent();
	};
	u64 id = u64(this.scope_ids.size()) + 1;
	@descriptor.id = id;
	Scope* retained_scope = &@scope;
	bool inserted = @this.scope_ids.insert($key, u64(id));
	if (!inserted) {
		compiler_panic("scope is already registered");
	};
	@this.scope_locations.push_back($descriptor);
	@this.scope_records.push_back($retained_scope);
	return $id;
};

fn NavigationIndex::build_contexts(var NavigationIndex& this, SemanticUnit& semantics) {
	rt::buffer<SemanticScopeRegion>& regions = semantics.scope_regions();
	usize index = 0;
	while (index < regions.size()) {
		SemanticScopeRegion& source = regions.data()[index];
		NavigationScope region;
		@region.id = @this.scope_id(*source.scope);
		if (source.scope->parent()) {
			@region.parent = @this.scope_id(*source.scope->parent());
		};
		@region.context = this.symbol_id(semantics.reference_context(@*source.scope));
		@region.range = this.syntax_range(*source.syntax);
		@this.scope_locations.push_back($region);
		@index = index + 1;
	};
	rt::buffer<rt::unique<Entity>>& entities = semantics.entities();
	@index = 0;
	while (index < entities.size()) {
		var Entity* entity = entities.data()[index].get();
		@index = index + 1;
		if (!entity->scope() || !this.symbol_id(entity)) {
			continue;
		};
		NavigationBinding binding;
		@binding.scope = @this.scope_id(*entity->scope());
		@binding.symbol = this.symbol_id(entity);
		@this.bindings.push_back($binding);
	};
	@index = 0;
	while (index < this.symbols.size()) {
		var NavigationEntry* entry = this.symbols.data()[index].get();
		@index = index + 1;
		var Entity* owner = entry->entity->member_owner();
		Type* type = entry->entity->type();
		while (type && (type->kind() == type_kind::pointer || type->kind() == type_kind::reference)) {
			@type = type->element();
		};
		if (!owner && type) {
			if (type->kind() == type_kind::named || type->kind() == type_kind::parameter) {
				@owner = type->entity()->member_owner();
			};
			if (!owner) {
				@owner = semantics.associated_owner(*type);
			};
		};
		if (owner && owner->members()) {
			@entry->member_scope = @this.scope_id(*owner->members());
		};
	};
	rt::buffer<SemanticCallSite>& sites = semantics.call_sites();
	@index = 0;
	while (index < sites.size()) {
		SemanticCallSite& source = sites.data()[index];
		@index = index + 1;
		rt::unique<NavigationCall> call = rt::unique<NavigationCall>::make();
		@call.get()->symbol = this.symbol_id(source.selected);
		@call.get()->bound_receiver = source.bound_receiver;
		if (source.candidates && source.candidates->scope()) {
			rt::buffer<var Entity*>& candidates = source.candidates->scope()->bindings();
			usize candidate = 0;
			while (candidate < candidates.size()) {
				Entity& function = *candidates.data()[candidate];
				@candidate = candidate + 1;
				if (function.kind() != entity_kind::function || function.name() != source.candidates->name() || !function.accessible_from(*source.scope)) {
					continue;
				};
				u64 symbol = this.symbol_id(&@function);
				if (symbol) {
					@call.get()->candidates.push_back($symbol);
				};
			};
		};
		@call.get()->scope = @this.scope_id(*source.scope);
		@call.get()->context = this.symbol_id(semantics.reference_context(@*source.scope));
		@call.get()->range = this.syntax_range(*source.syntax);
		@call.get()->callee = this.syntax_range(*source.syntax->callable());
		var Syntax* arguments = source.syntax->arguments();
		usize argument = 0;
		while (argument < arguments->size()) {
			@call.get()->arguments.push_back(this.syntax_range(*arguments->item(argument)));
			@argument = argument + 1;
		};
		@this.calls.push_back($call);
	};
};

fn NavigationIndex::scope_count(NavigationIndex& this) -> usize {
	return this.scope_locations.size();
};

fn NavigationIndex::scope_at(NavigationIndex& this, usize index) -> NavigationScope* {
	if (index >= this.scope_locations.size()) {
		return nullptr;
	};
	return this.scope_locations.data() + index;
};

fn NavigationIndex::binding_count(NavigationIndex& this) -> usize {
	return this.bindings.size();
};

fn NavigationIndex::binding_at(NavigationIndex& this, usize index) -> NavigationBinding* {
	if (index >= this.bindings.size()) {
		return nullptr;
	};
	return this.bindings.data() + index;
};

fn NavigationIndex::call_count(NavigationIndex& this) -> usize {
	return this.calls.size();
};

fn NavigationIndex::call_at(NavigationIndex& this, usize index) -> NavigationCall* {
	if (index >= this.calls.size()) {
		return nullptr;
	};
	return this.calls.data()[index].get();
};

fn NavigationIndex::parameter_count(NavigationIndex& this, u64 symbol) -> usize {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	return this.symbols.data()[symbol - 1].get()->parameters.size();
};

fn NavigationIndex::parameter_at(NavigationIndex& this, u64 symbol, usize index) -> NavigationParameter* {
	if (index >= this.parameter_count(symbol)) {
		return nullptr;
	};
	return &@this.symbols.data()[symbol - 1].get()->parameters.data()[index].get()->value;
};

fn NavigationIndex::member_scope(NavigationIndex& this, u64 symbol) -> u64 {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	return this.symbols.data()[symbol - 1].get()->member_scope;
};

fn NavigationIndex::accessible(NavigationIndex& this, u64 symbol, u64 scope) -> bool {
	if (!symbol || symbol > this.symbols.size() || !scope || scope > this.scope_records.size()) {
		return false;
	};
	return this.symbols.data()[symbol - 1].get()->entity->accessible_from(*this.scope_records.data()[scope - 1]);
};

fn NavigationIndex::receiver_candidates(var NavigationIndex& this, var NavigationReceiver& site, Entity& owner, Entity& visible_owner, Scope& scope) {
	if (!owner.members()) {
		return;
	};

	rt::buffer<var Entity*>& members = owner.members()->bindings();
	usize index = 0;
	while (index < members.size()) {
		Entity& member = *members.data()[index];
		@index = index + 1;
		var Entity* visible = visible_owner.find_member(member.name());
		if (!visible || visible->scope() != member.scope() || !member.accessible_from(scope)) {
			continue;
		};
		u64 symbol = this.symbol_id(&@member);
		if (!symbol) {
			continue;
		};
		usize previous = 0;
		while (previous < site.candidates.size() && site.candidates.data()[previous] != symbol) {
			@previous = previous + 1;
		};
		if (previous == site.candidates.size()) {
			@site.candidates.push_back($symbol);
		};
	};

	if (owner.bases().size() == 1) {
		@this.receiver_candidates(@site, *owner.bases().data()[0]->entity(), visible_owner, scope);
	};
};

fn NavigationIndex::build_receivers(var NavigationIndex& this, SemanticUnit& semantics) {
	rt::buffer<SemanticReceiverSite>& sites = semantics.receiver_sites();
	usize index = 0;
	while (index < sites.size()) {
		SemanticReceiverSite& source = sites.data()[index];
		@index = index + 1;
		rt::unique<NavigationReceiver> receiver = rt::unique<NavigationReceiver>::make();
		@receiver.get()->scope = @this.scope_id(*source.scope);
		@receiver.get()->context = this.symbol_id(semantics.reference_context(@*source.scope));
		@receiver.get()->range = this.syntax_range(*source.syntax->left());
		const Syntax* root = source.syntax->left();
		while (root && root->kind() == syntax_kind::member) {
			@root = root->left();
		};
		@receiver.get()->root.source = usize::max;
		if (root && root->kind() == syntax_kind::name) {
			@receiver.get()->root = this.syntax_range(*root);
		};
		@receiver.get()->selector = this.range(source.syntax->token());
		SourceRange member = this.syntax_range(*source.syntax->right());
		if (member.source == receiver.get()->selector.source && member.end > receiver.get()->selector.end) {
			@receiver.get()->selector.end = member.end;
		};
		@this.receiver_candidates(@*receiver.get(), *source.owner, *source.owner, *source.scope);
		@this.receivers.push_back($receiver);
	};
};

fn NavigationIndex::receiver_count(NavigationIndex& this) -> usize {
	return this.receivers.size();
};

fn NavigationIndex::receiver_at(NavigationIndex& this, usize index) -> NavigationReceiver* {
	if (index >= this.receivers.size()) {
		return nullptr;
	};
	return this.receivers.data()[index].get();
};

fn NavigationIndex::type_symbol(NavigationIndex& this, u64 symbol) -> u64 {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	Type* type = this.symbols.data()[symbol - 1].get()->entity->type();
	while (type && (type->kind() == type_kind::pointer || type->kind() == type_kind::reference || type->kind() == type_kind::array)) {
		@type = type->element();
	};
	if (!type || (type->kind() != type_kind::named && type->kind() != type_kind::parameter)) {
		return 0;
	};
	return this.symbol_id(type->entity());
};

fn NavigationIndex::semantic_token_type(NavigationIndex& this, u64 symbol) -> u32 {
	if (!symbol || symbol > this.symbols.size()) {
		return 8;
	};
	Entity& entity = *this.symbols.data()[symbol - 1].get()->entity;
	switch (entity.kind()) {
		case entity_kind::namespace_body: return 0;
		case entity_kind::alias: return 1;
		case entity_kind::record: return 5;
		case entity_kind::enumeration: return 3;
		case entity_kind::type_parameter: return 6;
		case entity_kind::parameter: return 7;
		case entity_kind::field: return 9;
		case entity_kind::field_pack: return 9;
		case entity_kind::enumerator: return 10;
		case entity_kind::function: {
			if (entity.scope() && entity.scope()->owner() && entity.scope()->owner()->kind() == entity_kind::record) {
				return 12;
			};
			return 11;
		};
	};
	NavigationSymbol& value = this.symbols.data()[symbol - 1].get()->value;
	if (value.kind == 3) {
		return 0;
	};
	if (value.kind == 23) {
		return 5;
	};
	if (value.kind == 26) {
		return 6;
	};
	return 8;
};

fn NavigationIndex::symbol_readonly(NavigationIndex& this, u64 symbol) -> bool {
	if (!symbol || symbol > this.symbols.size()) {
		return false;
	};
	Entity& entity = *this.symbols.data()[symbol - 1].get()->entity;
	Type* type = entity.type();
	if (type && type->kind() == type_kind::reference) {
		@type = type->element();
	};
	return entity.kind() == entity_kind::constant || entity.kind() == entity_kind::enumerator || type && type->qualifier() == type_qualifier::immutable;
};

fn NavigationIndex::classification_count(NavigationIndex& this) -> usize {
	return this.classifications.size();
};
fn NavigationIndex::classification_at(NavigationIndex& this, usize index) -> NavigationClassification* {
	if (index >= this.classifications.size()) {
		return nullptr;
	};
	return &@this.classifications.data()[index];
};

fn rutile_language_analyze(AnalysisSource* sources, usize count, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> var void* {
	try {
		if (count && !sources || cancelled && cancelled(context)) {
			return nullptr;
		};
		rt::unique<Analysis> analysis = rt::unique<Analysis>::make();
		rt::unique<Compiler> compiler = rt::unique<Compiler>::make();
		usize index = 0;
		while (index < count) {
			@analysis.get()->add_source(sources[index].path, sources[index].text);
			@index = index + 1;
		};
		if (!(@analysis.get()->analyze($pointer_bits, $cancelled, $context)).has<void>()) {
			return nullptr;
		};
		@compiler.get()->publish($analysis);
		return @compiler.release();
	}
	catch (compiler_internal_error& error) {
		report_compiler_internal_error(error, nullptr);
		return nullptr;
	}
	catch (rt::allocation_error& error) {
		return nullptr;
	};
};

fn rutile_language_destroy(var void* snapshot) {
	delete static_cast<var Compiler*>($snapshot);
};

fn rutile_language_symbol_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().navigation().symbol_count();
};

fn rutile_language_symbol(void* snapshot, usize index, var NavigationSymbol* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	NavigationSymbol* symbol = lease.value().navigation().symbol_at($index);
	if (!symbol) {
		return 0;
	};
	@*result := *symbol;
	return 1;
};

fn rutile_language_occurrence_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().navigation().occurrence_count();
};

fn rutile_language_occurrence(void* snapshot, usize index, var NavigationOccurrence* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	NavigationOccurrence* occurrence = lease.value().navigation().occurrence_at($index);
	if (!occurrence) {
		return 0;
	};
	@*result := *occurrence;
	return 1;
};

fn rutile_language_diagnostic_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().diagnostics().records().size();
};

fn rutile_language_diagnostic(void* snapshot, usize index, var LanguageDiagnostic* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (index >= records.size()) {
		return 0;
	};
	DiagnosticRecord& record = records.data()[index];
	@result->range = lease.value().navigation().range(record.location);
	@result->severity = 1;
	@result->message = record.message.view();
	return 1;
};

fn rutile_language_related_count(void* snapshot, usize diagnostic) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (diagnostic >= records.size()) {
		return 0;
	};
	return records.data()[diagnostic].notes.size();
};

fn rutile_language_related(void* snapshot, usize diagnostic, usize index, var LanguageDiagnostic* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (diagnostic >= records.size() || index >= records.data()[diagnostic].notes.size()) {
		return 0;
	};
	DiagnosticNote& note = records.data()[diagnostic].notes.data()[index];
	@result->range = lease.value().navigation().range(note.location);
	@result->severity = 3;
	@result->message = note.message.view();
	return 1;
};

struct AnalysisSource {
	rt::string_view path;
	rt::string_view text;
};

struct SourceRange {
	fn SourceRange(var SourceRange& this) : [default];
	fn SourceRange(var SourceRange& this, SourceRange& other) : [implicit, default];

	usize source;
	usize begin;
	usize end;
};

struct NavigationSymbol {
	fn NavigationSymbol(var NavigationSymbol& this) : [default];
	fn NavigationSymbol(var NavigationSymbol& this, NavigationSymbol& other) : [implicit, default];

	u64 id;
	u64 container;
	u64 origin;
	u32 kind;
	u32 flags;
	SourceRange declaration;
	SourceRange definition;
	rt::string_view name;
	rt::string_view detail;
};

struct NavigationOccurrence {
	fn NavigationOccurrence(var NavigationOccurrence& this) : [default];
	fn NavigationOccurrence(var NavigationOccurrence& this, NavigationOccurrence& other) : [implicit, default];

	SourceRange range;
	u64 symbol;
	u64 context;
	u32 roles;
};

struct LanguageDiagnostic {
	fn LanguageDiagnostic(var LanguageDiagnostic& this) : [default];
	fn LanguageDiagnostic(var LanguageDiagnostic& this, LanguageDiagnostic& other) : [implicit, default];

	SourceRange range;
	u32 severity;
	rt::string_view message;
};

struct NavigationScope {
	fn NavigationScope(var NavigationScope& this) : [default];
	fn NavigationScope(var NavigationScope& this, NavigationScope& other) : [implicit, default];
	u64 id;
	u64 parent;
	u64 context;
	SourceRange range;
};

struct NavigationBinding {
	u64 scope;
	u64 symbol;
};

struct NavigationCall {
	u64 symbol;
	u64 scope;
	u64 context;
	SourceRange range;
	SourceRange callee;
	bool bound_receiver;
	rt::buffer<u64> candidates;
	rt::buffer<SourceRange> arguments;
};

struct NavigationReceiver {
	u64 scope;
	u64 context;
	SourceRange range;
	SourceRange root;
	SourceRange selector;
	rt::buffer<u64> candidates;
};

struct NavigationParameter {
	rt::string_view name;
	rt::string_view detail;
};

struct NavigationParameterEntry {
	NavigationParameter value;
	rt::string detail;
};

struct NavigationEntry {
	var Entity* entity;
	u64 member_scope;
	NavigationSymbol value;
	rt::string name;
	rt::string detail;
	rt::buffer<rt::unique<NavigationParameterEntry>> parameters;
};

struct NavigationClassification {
	SourceRange range;
	u32 type;
	u32 modifiers;
};

struct NavigationIndex {
	fn register_source(var NavigationIndex& this, var SourceFile& source, usize index);
	fn build(var NavigationIndex& this, SemanticUnit& semantics);
	fn symbol_count(NavigationIndex& this) -> usize;
	fn symbol_at(NavigationIndex& this, usize index) -> NavigationSymbol*;
	fn occurrence_count(NavigationIndex& this) -> usize;
	fn occurrence_at(NavigationIndex& this, usize index) -> NavigationOccurrence*;
	fn range(NavigationIndex& this, Token& token) -> SourceRange;
	fn syntax_range(NavigationIndex& this, Syntax& syntax) -> SourceRange;
	fn scope_count(NavigationIndex& this) -> usize;
	fn scope_at(NavigationIndex& this, usize index) -> NavigationScope*;
	fn classification_count(NavigationIndex& this) -> usize;
	fn classification_at(NavigationIndex& this, usize index) -> NavigationClassification*;
	fn type_symbol(NavigationIndex& this, u64 symbol) -> u64;
	fn semantic_token_type(NavigationIndex& this, u64 symbol) -> u32;
	fn symbol_readonly(NavigationIndex& this, u64 symbol) -> bool;
	fn member_scope(NavigationIndex& this, u64 symbol) -> u64;
	fn accessible(NavigationIndex& this, u64 symbol, u64 scope) -> bool;
	fn binding_count(NavigationIndex& this) -> usize;
	fn binding_at(NavigationIndex& this, usize index) -> NavigationBinding*;
	fn parameter_count(NavigationIndex& this, u64 symbol) -> usize;
	fn parameter_at(NavigationIndex& this, u64 symbol, usize index) -> NavigationParameter*;
	fn receiver_count(NavigationIndex& this) -> usize;
	fn receiver_at(NavigationIndex& this, usize index) -> NavigationReceiver*;
	fn call_count(NavigationIndex& this) -> usize;
	fn call_at(NavigationIndex& this, usize index) -> NavigationCall*;

private:
	fn scope_id(var NavigationIndex& this, Scope& scope) -> u64;
	fn receiver_candidates(var NavigationIndex& this, var NavigationReceiver& site, Entity& owner, Entity& visible_owner, Scope& scope);
	fn build_receivers(var NavigationIndex& this, SemanticUnit& semantics);
	fn build_contexts(var NavigationIndex& this, SemanticUnit& semantics);
	fn symbol_id(NavigationIndex& this, Entity* entity) -> u64;
	fn declaration_name(NavigationIndex& this, var Syntax& declaration) -> Token;
	fn symbol_kind(NavigationIndex& this, Entity& entity) -> u32;

	rt::buffer<rt::unique<NavigationEntry>> symbols;
	rt::buffer<NavigationOccurrence> occurrences;
	rt::buffer<NavigationClassification> classifications;
	rt::buffer<NavigationScope> scope_locations;
	rt::buffer<NavigationBinding> bindings;
	rt::buffer<rt::unique<NavigationCall>> calls;
	rt::buffer<rt::unique<NavigationReceiver>> receivers;
	rt::unordered_map<Scope*, u64> scope_ids;
	rt::buffer<Scope*> scope_records;
	rt::unordered_map<Entity*, u64> ids;
	rt::unordered_map<SourceFile*, usize> source_ids;
};

fn kiln_project_source_load(char* path, ((var void*, char*, char*, usize, char*, i32) -> i32)* load, var void* context) -> i32;

fn language_load_interface_source(var void* context, char* path, char* text, usize size, char* module, i32 access) -> i32 {
	var Analysis& analysis = @*reinterpret_cast<var Analysis*>(context);
	@analysis.add_source(rt::from_c_string(path), rt::string_view(text, size));
	@analysis.set_source_module(analysis.source_count() - 1, rt::from_c_string(module), access);
	return 1;
};

fn LanguageWorkspace::add_project(var void* context, char* name, char* path, i32 kind) -> i32 {
	var LanguageWorkspace& workspace = @*reinterpret_cast<var LanguageWorkspace*>(context);
	usize index = 0;
	language_group_kind category = language_group_kind::target;
	if (kind == 6) {
		@category = language_group_kind::test_target;
	};
	if (kind == 1) {
		@category = language_group_kind::analysis;
	};
	if (kind == 2) {
		@category = language_group_kind::standard;
	};
	while (index < workspace.groups.size() && (workspace.groups.data()[index].kind != category || workspace.groups.data()[index].name.view() != rt::from_c_string(name))) {
		@index = index + 1;
	};
	if (index == workspace.groups.size()) {
		LanguageGroup group;
		@group.kind = $category;
		@group.name.append(rt::from_c_string(name));
		@workspace.groups.push_back($group);
	};
	var LanguageGroup* groups = (@workspace.groups).data();
	@groups[index].paths.push_back(rt::string(rt::from_c_string(path)));
	return 1;
};

fn LanguageWorkspace::project_error(var void* context, char* text) {
	var LanguageWorkspace& workspace = @*reinterpret_cast<var LanguageWorkspace*>(context);
	@workspace.discovery_error = rt::string(rt::from_c_string(text));
};

fn LanguageWorkspace::analyze(var LanguageWorkspace& this, var LanguageJob& job) -> rt::unique<LanguageIndex> {
	u64 started = runtime_clock_nanoseconds();
	if (this.cached_configuration != job.configuration) {
		@this.groups.clear();
		@this.discovery_error.clear();
		if (!kiln_project_sources(job.root.c_str(), &LanguageWorkspace::add_project, &@this, &LanguageWorkspace::project_error)) {
			var parameters = rt::json_value::make_object();
			if (parameters.get()) {
				@parameters.get()->set("type", rt::json_value::make_unsigned(1));
				@parameters.get()->set("message", rt::json_value::make_string(this.discovery_error.view()));
				@this.notify("window/logMessage", $parameters);
			};
			return rt::unique<LanguageIndex>();
		};
		@this.cached_configuration = job.configuration;
	};

	rt::unique<LanguageIndex> index = rt::unique<LanguageIndex>::make();
	if (!index.get()) {
		return rt::unique<LanguageIndex>();
	};
	@index.get()->generation = job.generation;
	rt::unordered_map<rt::string_view, bool> assigned;
	usize group = 0;
	while (group < this.groups.size()) {
		var LanguageGroup& input = @(@this.groups).data()[group];
		if (input.kind == language_group_kind::standard) {
			@group = group + 1;
			continue;
		};
		if (!(@this.analyze_group(@input, @job, @*index.get())).has<void>()) {
			return rt::unique<LanguageIndex>();
		};
		usize path = 0;
		while (path < input.paths.size()) {
			var current = input.paths.data()[path].view();
			usize document = 0;
			while (document < job.documents.size()) {
				rt::string key;
				LanguageUri::key(current, @key);
				if (job.documents.data()[document].key.view() == key.view() && !assigned.find(job.documents.data()[document].key.view())) {
					bool inserted = @assigned.insert(job.documents.data()[document].key.view(), true);
					discard $inserted;
				};
				@document = document + 1;
			};
			@path = path + 1;
		};
		@group = group + 1;
	};

	LanguageGroup loose;
	@loose.kind = language_group_kind::loose;
	usize document = 0;
	while (document < job.documents.size()) {
		if (!assigned.find(job.documents.data()[document].key.view())) {
			@loose.paths.push_back(rt::string(job.documents.data()[document].path));
		};
		@document = document + 1;
	};
	if (loose.paths.size()) {
		@group = 0;
		while (group < this.groups.size()) {
			LanguageGroup& standard = this.groups.data()[group];
			if (standard.kind == language_group_kind::standard) {
				usize path = 0;
				while (path < standard.paths.size()) {
					@loose.paths.push_back(rt::string(standard.paths.data()[path]));
					@path = path + 1;
				};
			};
			@group = group + 1;
		};
		if (!(@this.analyze_group(@loose, @job, @*index.get())).has<void>()) {
			return rt::unique<LanguageIndex>();
		};
	};
	runtime_atomic_store(this.phase_started, runtime_clock_nanoseconds());
	runtime_atomic_store(this.analysis_phase, 4);
	@index.get()->finish();
	@index.get()->build_nanoseconds = runtime_clock_nanoseconds() - started;
	return $index;
};

fn LanguageWorkspace::analyze_group(var LanguageWorkspace& this, var LanguageGroup& group, var LanguageJob& job, var LanguageIndex& index) -> CompilationResult {
	rt::unique<Analysis> analysis = rt::unique<Analysis>::make();
	if (!analysis.get()) {
		return compilation_error();
	};
	if (group.kind == language_group_kind::test_target) {
		@analysis.get()->enable_tests();
	};
	LanguageCancellation cancellation;
	@cancellation.generation = this.generation;
	@cancellation.stopped = this.stopped;
	@cancellation.expected = job.generation;
	rt::string key;
	if (LanguageWorkspace::cancelled(&@cancellation)) {
		return compilation_error();
	};
	if (group.kind != language_group_kind::analysis) {
		LanguageWorkspace::target_key(job.root.view(), group, @key);
		if (!(@this.compiler->expect_target(key.view(), u64(job.generation))).has<void>()) {
			return compilation_error();
		};
	};

	runtime_atomic_store(this.phase_started, runtime_clock_nanoseconds());
	runtime_atomic_store(this.analysis_phase, 1);
	usize source = 0;
	while (source < group.paths.size()) {
		if (LanguageWorkspace::cancelled(&@cancellation)) {
			return compilation_error();
		};
		rt::string& path = group.paths.data()[source];
		i32 imported = kiln_project_source_load(path.c_str(), &language_load_interface_source, analysis.get());
		if (imported >= 0) {
			if (!imported) {
				return compilation_error();
			};
			@source = source + 1;
			continue;
		};
		rt::string key;
		LanguageUri::key(path.view(), @key);
		usize document = 0;
		while (document < job.documents.size() && job.documents.data()[document].key.view() != key.view()) {
			@document = document + 1;
		};
		if (document < job.documents.size()) {
			@analysis.get()->add_source(path.view(), job.documents.data()[document].text.view());
		}
		else if (!(@analysis.get()->load_source(path.view(), &platform_open_utf8_file)).has<void>()) {
			usize diagnostic = 0;
			while (diagnostic < analysis.get()->diagnostics().records().size()) {
				if (LanguageWorkspace::cancelled(&@cancellation)) {
					return compilation_error();
				};
				DiagnosticRecord& record = analysis.get()->diagnostics().records().data()[diagnostic];
				var parameters = rt::json_value::make_object();
				if (!parameters.get()) {
					return compilation_error();
				};
				@parameters.get()->set("type", rt::json_value::make_unsigned(1));
				@parameters.get()->set("message", rt::json_value::make_string(record.message.view()));
				@this.notify("window/logMessage", $parameters);
				@diagnostic = diagnostic + 1;
			};
			return compilation_error();
		};
		@analysis.get()->set_source_module(analysis.get()->source_count() - 1, group.name.view(), 0);
		@source = source + 1;
	};

	var build_lease = @this.compiler->acquire_analysis();
	Analysis* build_analysis = build_lease.get();
	bool reusable = build_analysis != nullptr
		&& build_analysis->source_count() == analysis.get()->source_count()
		&& build_analysis->pointer_bits() == 64
		&& !build_analysis->diagnostics().failed()
		&& build_analysis->semantics() != nullptr;
	if (reusable) {
		usize current = 0;
		while (current < group.paths.size()) {
			if (build_analysis->source_path(current) != analysis.get()->source_path(current)
				|| build_analysis->source_text(current) != analysis.get()->source_text(current)) {
				@reusable = false;
				break;
			};
			@current = current + 1;
		};
	};
	if (reusable) {
		usize document = 0;
		while (document < job.documents.size()) {
			LanguageDocument& candidate = job.documents.data()[document];
			if (candidate.template_anchor.has_value()) {
				usize current = 0;
				while (current < group.paths.size()) {
					rt::string source_key;
					LanguageUri::key(group.paths.data()[current].view(), @source_key);
					if (source_key.view() == candidate.key.view()) {
						@reusable = false;
						break;
					};
					@current = current + 1;
				};
				if (!reusable) {
					break;
				};
			};
			@document = document + 1;
		};
	};

	runtime_atomic_store(this.phase_started, runtime_clock_nanoseconds());
	runtime_atomic_store(this.analysis_phase, 2);
	if (!reusable) {
		discard @analysis.get()->analyze_editor(64, &LanguageWorkspace::cancelled, &@cancellation);
	};
	var contextual = rt::unique<Analysis>();
	LanguageTemplateResult context_result;
	usize requested = 0;
	while (!reusable && requested < job.documents.size()) {
		LanguageDocument& document = job.documents.data()[requested];
		if (!document.template_anchor.has_value()) {
			@requested = requested + 1;
			continue;
		};
		usize original = 0;
		while (original < analysis.get()->source_count()) {
			rt::string source_key;
			LanguageUri::key(analysis.get()->source_path(original), @source_key);
			if (source_key.view() == document.key.view()) {
				break;
			};
			@original = original + 1;
		};
		if (original == analysis.get()->source_count()) {
			@requested = requested + 1;
			continue;
		};
		@context_result.key = rt::string(document.key);
		@context_result.anchor = document.template_anchor.value();
		@context_result.arguments = rt::string(document.template_arguments);
		@contextual = rt::unique<Analysis>::make();
		if (!contextual.get()) {
			return compilation_error();
		};
		usize source = 0;
		while (source < analysis.get()->source_count()) {
			@contextual.get()->add_source(analysis.get()->source_path(source), analysis.get()->source_text(source));
			@source = source + 1;
		};
		@contextual.get()->request_template_context(analysis.get()->source_path(original), document.template_anchor.value(), document.template_arguments.view());
		// Expected diagnostics remain in the contextual analysis for publication.
		discard @contextual.get()->analyze_editor(64, &LanguageWorkspace::cancelled, &@cancellation);
		if (contextual.get()->diagnostics().failed()) {
			rt::buffer<DiagnosticRecord>& errors = contextual.get()->diagnostics().records();
			usize error = 0;
			while (error < errors.size()) {
				if (error) {
					@context_result.error.append("\n");
				};
				@context_result.error.append(errors.data()[error].message.view());
				@error = error + 1;
			};
			@contextual.reset(nullptr);
		}
		else {
			@context_result.label = rt::string(contextual.get()->template_context_label());
		};
		break;
	};
	runtime_atomic_store(this.phase_started, runtime_clock_nanoseconds());
	runtime_atomic_store(this.analysis_phase, 3);
	Analysis* indexed = analysis.get();
	if (reusable) {
		@indexed = build_analysis;
	};
	if (contextual.get()) {
		@indexed = contextual.get();
	};
	if (LanguageWorkspace::cancelled(&@cancellation)) {
		return compilation_error();
	};
	@index.append(*indexed, job);
	if (!context_result.key.empty()) {
		@index.template_results.push_back($context_result);
	};
	if (group.kind == language_group_kind::analysis) {
		return;
	};
	@index.targets.push_back(rt::string(key));
	analysis_publication publication = analysis_publication::obsolete;
	if (reusable) {
		@publication = @this.compiler->publish_target_alias(key.view(), u64(job.generation), @*build_analysis);
	}
	else {
		@publication = @this.compiler->publish_target(key.view(), u64(job.generation), $analysis);
	};
	if (publication == analysis_publication::published && !LanguageWorkspace::cancelled(&@cancellation)) {
		return;
	};
	return compilation_error();
};

fn LanguageWorkspace::target_key(rt::string_view root, LanguageGroup& group, var rt::string& key) {
	rt::string result;
	LanguageUri::key(root, @result);
	if (group.kind == language_group_kind::loose) {
		@result.append("::editor::loose");
	}
	else {
		@result.append("::target::");
		@result.append(group.name.view());
	};
	@key = $result;
};

fn LanguageIndex::source(var LanguageIndex& this, Analysis& analysis, usize number, LanguageJob& job) -> usize {
	var path = analysis.source_path(usize(number));
	rt::string key;
	LanguageUri::key(path, @key);
	var previous = this.source_ids.find(key);
	if (previous) {
		return *previous;
	};

	LanguageIndexedSource source;
	@source.key = $key;
	@source.diagnostics = rt::json_value::make_array();
	if (!source.diagnostics.get()) {
		compiler_panic("language source index invariant failed");
	};
	LanguageUri::encode(path, @source.uri);
	@source.text.assign(analysis.source_text(usize(number)));
	usize document = 0;
	while (document < job.documents.size()) {
		if (job.documents.data()[document].key.view() == source.key.view()) {
			@source.uri = rt::string(job.documents.data()[document].uri);
			@source.version = rt::optional<i64>(i64(job.documents.data()[document].version));
			@source.revision = job.documents.data()[document].revision;
			break;
		};
		@document = document + 1;
	};
	usize result = this.sources.size();
	if (!@this.source_ids.insert(rt::string(source.key), usize(result))) {
		compiler_panic("language source index invariant failed");
	};
	@this.sources.push_back($source);
	return $result;
};

fn LanguageIndex::identity(LanguageIndex& this, u64 id) -> u64 {
	usize remaining = this.symbols.size();
	while (remaining) {
		var found = this.symbol_ids.find(id);
		if (!found || !this.symbols.data()[*found].value.origin || this.symbols.data()[*found].value.origin == id) {
			return $id;
		};
		@id = this.symbols.data()[*found].value.origin;
		@remaining = remaining - 1;
	};
	return $id;
};

fn LanguageIndex::append(var LanguageIndex& this, Analysis& analysis, LanguageJob& job) {
	@this.semantic_failed = this.semantic_failed || analysis.diagnostics().failed();
	rt::buffer<usize> mapping;
	usize source = 0;
	while (source < analysis.source_count()) {
		usize target = @this.source(analysis, usize(source), job);
		if (target == usize::max) {
			compiler_panic("language server append invariant failed");
		};
		@this.classify_source(analysis, usize(source), usize(target));
		@mapping.push_back($target);
		@source = source + 1;
	};

	@this.append_templates(analysis, mapping);

	u64 maximum = 0;
	usize number = 0;
	while (number < analysis.navigation().symbol_count()) {
		NavigationSymbol* input = analysis.navigation().symbol_at(number);
		LanguageIndexedSymbol symbol;
		@symbol.value = NavigationSymbol(*input);
		@symbol.semantic_type = analysis.navigation().semantic_token_type(input->id);
		u64 type_symbol = analysis.navigation().type_symbol(input->id);
		if (type_symbol) {
			@symbol.type_symbol = type_symbol + this.symbol_base;
		};
		if (input->id > maximum) {
			@maximum = input->id;
		};
		@symbol.value.id = input->id + this.symbol_base;
		if (input->origin) {
			@symbol.value.origin = input->origin + this.symbol_base;
		};
		if (input->container) {
			@symbol.value.container = input->container + this.symbol_base;
		};
		if (input->declaration.source < mapping.size()) {
			@symbol.value.declaration.source = mapping.data()[input->declaration.source];
		};
		if (input->definition.source < mapping.size()) {
			@symbol.value.definition.source = mapping.data()[input->definition.source];
		};
		@symbol.name.append(input->name);
		@symbol.detail.append(input->detail);
		usize parameter = 0;
		while (parameter < analysis.navigation().parameter_count(input->id)) {
			NavigationParameter* input_parameter = analysis.navigation().parameter_at(input->id, parameter);
			LanguageIndexedParameter copy;
			@copy.name.append(input_parameter->name);
			@copy.detail.append(input_parameter->detail);
			@symbol.parameters.push_back($copy);
			@parameter = parameter + 1;
		};
		@symbol.value.name = symbol.name.view();
		@symbol.value.detail = symbol.detail.view();
		if (!@this.symbol_ids.insert(u64(symbol.value.id), this.symbols.size())) {
			compiler_panic("language server append invariant failed");
		};
		@this.symbols.push_back($symbol);
		@number = number + 1;
	};

	@number = 0;
	while (number < analysis.navigation().occurrence_count()) {
		NavigationOccurrence* input = analysis.navigation().occurrence_at(number);
		if (input->range.source < mapping.size() && input->range.begin < input->range.end) {
			NavigationOccurrence occurrence := *input;
			@occurrence.range.source = mapping.data()[input->range.source];
			@occurrence.symbol = this.identity(input->symbol + this.symbol_base);
			if (input->context) {
				@occurrence.context = input->context + this.symbol_base;
			};
			@this.occurrences.push_back($occurrence);
		};
		@number = number + 1;
	};
	u64 maximum_scope = 0;
	@number = 0;
	while (number < analysis.navigation().scope_count()) {
		NavigationScope* input = analysis.navigation().scope_at(number);
		NavigationScope copy := *input;
		if (input->id > maximum_scope) {
			@maximum_scope = input->id;
		};
		@copy.id = input->id + this.scope_base;
		if (copy.parent) {
			@copy.parent = copy.parent + this.scope_base;
		};
		if (copy.context) {
			@copy.context = copy.context + this.symbol_base;
		};
		if (copy.range.source < mapping.size()) {
			@copy.range.source = mapping.data()[copy.range.source];
		};
		if (!this.scope_ids.find(copy.id) && !@this.scope_ids.insert(u64(copy.id), this.scopes.size())) {
			compiler_panic("language server append invariant failed");
		};
		@this.scopes.push_back($copy);
		@number = number + 1;
	};
	@number = 0;
	while (number < analysis.navigation().binding_count()) {
		NavigationBinding* input = analysis.navigation().binding_at(number);
		NavigationBinding copy;
		@copy.scope = input->scope + this.scope_base;
		@copy.symbol = input->symbol + this.symbol_base;
		if (!this.scope_members.find(copy.scope)) {
			rt::buffer<usize> members;
			if (!@this.scope_members.insert(u64(copy.scope), $members)) {
				compiler_panic("language server append invariant failed");
			};
		};
		var members = @this.scope_members.find(copy.scope);
		var symbol = this.symbol_ids.find(copy.symbol);
		if (!symbol) {
			compiler_panic("language server append invariant failed");
		};
		@members->push_back(usize(*symbol));
		@this.scope_bindings.push_back($copy);
		@number = number + 1;
	};
	@number = 0;
	while (number < analysis.navigation().call_count()) {
		NavigationCall* input = analysis.navigation().call_at(number);
		NavigationCall copy;
		if (input->symbol) {
			@copy.symbol = input->symbol + this.symbol_base;
		};
		@copy.scope = input->scope + this.scope_base;
		if (input->context) {
			@copy.context = input->context + this.symbol_base;
		};
		@copy.bound_receiver = bool(input->bound_receiver);
		usize candidate = 0;
		while (candidate < input->candidates.size()) {
			@copy.candidates.push_back(input->candidates.data()[candidate] + this.symbol_base);
			@candidate = candidate + 1;
		};
		@copy.range = SourceRange(input->range);
		@copy.callee = SourceRange(input->callee);
		if (copy.range.source < mapping.size()) {
			@copy.range.source = mapping.data()[copy.range.source];
		};
		if (copy.callee.source < mapping.size()) {
			@copy.callee.source = mapping.data()[copy.callee.source];
		};
		usize argument = 0;
		while (argument < input->arguments.size()) {
			SourceRange range := input->arguments.data()[argument];
			if (range.source < mapping.size()) {
				@range.source = mapping.data()[range.source];
			};
			@copy.arguments.push_back($range);
			@argument = argument + 1;
		};
		@this.calls.push_back($copy);
		@number = number + 1;
	};
	@number = 0;
	while (number < analysis.navigation().receiver_count()) {
		NavigationReceiver* input = analysis.navigation().receiver_at(number);
		NavigationReceiver copy;
		@copy.scope = input->scope + this.scope_base;
		if (input->context) {
			@copy.context = input->context + this.symbol_base;
		};
		@copy.range = SourceRange(input->range);
		@copy.selector = SourceRange(input->selector);
		@copy.root = SourceRange(input->root);
		if (copy.root.source < mapping.size()) {
			@copy.root.source = mapping.data()[copy.root.source];
		};
		if (copy.range.source < mapping.size()) {
			@copy.range.source = mapping.data()[copy.range.source];
		};
		if (copy.selector.source < mapping.size()) {
			@copy.selector.source = mapping.data()[copy.selector.source];
		};
		usize candidate = 0;
		while (candidate < input->candidates.size()) {
			@copy.candidates.push_back(input->candidates.data()[candidate] + this.symbol_base);
			@candidate = candidate + 1;
		};
		@this.receivers.push_back($copy);
		@number = number + 1;
	};
	@this.classify_bindings(analysis, mapping);
	@this.scope_base = this.scope_base + maximum_scope + 1;
	@this.symbol_base = this.symbol_base + maximum + 1;

	@number = 0;
	while (number < analysis.diagnostics().records().size()) {
		DiagnosticRecord& record = analysis.diagnostics().records().data()[number];
		SourceRange range = analysis.navigation().range(record.location);
		if (range.source < mapping.size()) {
			var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[range.source]];
			var diagnostic = rt::json_value::make_object();
			if (!diagnostic.get()) {
				compiler_panic("language server append invariant failed");
			};
			@diagnostic.get()->set("range", LanguageJson::range(source.text, usize(range.begin), usize(range.end)));
			@diagnostic.get()->set("severity", rt::json_value::make_unsigned(1));
			@diagnostic.get()->set("source", rt::json_value::make_string("rutile"));
			@diagnostic.get()->set("message", rt::json_value::make_string(record.message.view()));
			var related = rt::json_value::make_array();
			usize note = 0;
			while (related.get() && note < record.notes.size()) {
				SourceRange note_range = analysis.navigation().range(record.notes.data()[note].location);
				if (note_range.source < mapping.size()) {
					LanguageIndexedSource& target = this.sources.data()[mapping.data()[note_range.source]];
					var location = rt::json_value::make_object();
					var information = rt::json_value::make_object();
					if (!location.get()) {
						compiler_panic("language server append invariant failed");
					};
					if (!information.get()) {
						compiler_panic("language server append invariant failed");
					};
					@location.get()->set("uri", rt::json_value::make_string(target.uri.view()));
					@location.get()->set("range", LanguageJson::range(target.text, usize(note_range.begin), usize(note_range.end)));
					@information.get()->set("location", $location);
					@information.get()->set("message", rt::json_value::make_string(record.notes.data()[note].message.view()));
					@related.get()->append($information);
				};
				@note = note + 1;
			};
			if (!related.get()) {
				compiler_panic("language server append invariant failed");
			};
			@diagnostic.get()->set("relatedInformation", $related);
			@source.diagnostics.get()->append($diagnostic);
		};
		@number = number + 1;
	};
};

fn LanguageIndex::before(NavigationOccurrence& first, NavigationOccurrence& second) -> bool {
	if (first.range.source != second.range.source) {
		return first.range.source < second.range.source;
	};
	if (first.range.begin != second.range.begin) {
		return first.range.begin < second.range.begin;
	};
	return first.range.end < second.range.end;
};

fn LanguageIndex::finish(var LanguageIndex& this) {
	rt::buffer<NavigationOccurrence> scratch;
	usize size = this.occurrences.size();
	usize index = 0;
	while (index < size) {
		@scratch.push_back(NavigationOccurrence());
		@index = index + 1;
	};
	usize width = 1;
	while (width < size) {
		usize start = 0;
		while (start < size) {
			usize middle = start + width;
			if (middle > size) {
				@middle = usize(size);
			};
			usize end = middle + width;
			if (end > size) {
				@end = usize(size);
			};
			usize first = usize(start);
			usize second = usize(middle);
			usize output = usize(start);
			while (output < end) {
				if (first < middle && (second == end || LanguageIndex::before(this.occurrences.data()[first], this.occurrences.data()[second]))) {
					@(@scratch).data()[output] = NavigationOccurrence(this.occurrences.data()[first]);
					@first = first + 1;
				}
				else {
					@(@scratch).data()[output] = NavigationOccurrence(this.occurrences.data()[second]);
					@second = second + 1;
				};
				@output = output + 1;
			};
			@start = $end;
		};
		usize output = 0;
		while (output < size) {
			@(@this.occurrences).data()[output] = NavigationOccurrence(scratch.data()[output]);
			@output = output + 1;
		};
		if (width > size / 2) {
			break;
		};
		@width = width * 2;
	};

	@index = 0;
	while (index < size) {
		u64 symbol = this.occurrences.data()[index].symbol;
		var list = @this.references.find(symbol);
		if (!list) {
			rt::buffer<usize> positions;
			if (!@this.references.insert(u64(symbol), $positions)) {
				compiler_panic("language server finish invariant failed");
			};
			@list = @this.references.find(symbol);
		};
		if (!list) {
			compiler_panic("language server finish invariant failed");
		};
		@list->push_back(usize(index));
		@index = index + 1;
	};

	@this.diagnostics = rt::json_value::make_array();
	@index = 0;
	while (this.diagnostics.get() && index < this.sources.size()) {
		LanguageIndexedSource& source = this.sources.data()[index];
		var parameters = rt::json_value::make_object();
		if (!parameters.get()) {
			compiler_panic("language server finish invariant failed");
		};
		@parameters.get()->set("uri", rt::json_value::make_string(source.uri.view()));
		@parameters.get()->set("diagnostics", source.diagnostics.get()->clone());
		if (source.version.has_value()) {
			@parameters.get()->set("version", rt::json_value::make_integer(i64(source.version.value())));
		};
		@this.diagnostics.get()->append($parameters);
		@index = index + 1;
	};
	if (!this.diagnostics.get()) {
		compiler_panic("language index diagnostics container is unavailable");
	};
};

fn LanguageWorkspace::cursor(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var usize& source, var usize& offset) -> LanguageRequestResult {
	rt::json_value* document = parameters.member("textDocument");
	rt::json_value* position = parameters.member("position");
	if (!document || !position) {
		return language_request_error();
	};
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(LanguageJson::text(*document, "uri"), @path).has<void>()) {
		return language_request_error();
	};
	LanguageUri::key(path.view(), @key);
	var found = index.source_ids.find(key);
	if (!found) {
		return language_request_error();
	};
	@source = *found;
	LanguageText* text = &@index.sources.data()[source].text;
	var LanguageDocument* open = @this.document_key(key.view());
	if (open) {
		@text = &@open->text;
	};
	i64 line = LanguageJson::integer(*position, "line", -1);
	i64 character = LanguageJson::integer(*position, "character", -1);
	if (line < 0 || character < 0) {
		return language_request_error();
	};
	usize current = text->offset(static_cast<usize>(line), static_cast<usize>(character));
	if (@this.old_offset(index, usize(source), $current, @offset)) {
		return;
	};
	return language_request_error();
};

fn language_completion_identifier(char character) -> bool {
	return character >= 'a' && character <= 'z' || character >= 'A' && character <= 'Z' || character >= '0' && character <= '9' || character == '_';
};

fn language_completion_match(rt::string_view name, rt::string_view prefix) -> bool {
	if (name.empty() || name.size() < prefix.size()) {
		return false;
	};
	usize index = 0;
	while (index < prefix.size()) {
		char expected = prefix.data()[index];
		char actual = name.data()[index];
		if (expected >= 'A' && expected <= 'Z') {
			@expected = char(expected + ('a' - 'A'));
		};
		if (actual >= 'A' && actual <= 'Z') {
			@actual = char(actual + ('a' - 'A'));
		};
		if (expected != actual) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn language_completion_kind(u32 kind) -> u32 {
	switch (kind) {
		case 3:
			return 9;
		case 5:
			return 7;
		case 6:
			return 2;
		case 8:
			return 5;
		case 9:
			return 4;
		case 10:
			return 13;
		case 11:
			return 8;
		case 12:
			return 3;
		case 14:
			return 21;
		case 22:
			return 20;
		case 23:
			return 22;
		case 26:
			return 25;
		default:
			return 6;
	};
};

fn language_completion_item(rt::string_view name, rt::string_view detail, u32 kind, u64 rank, LanguageText& text, usize begin, usize end) -> rt::unique<rt::json_value> {
	var item = rt::json_value::make_object();
	var edit = rt::json_value::make_object();
	var order = DiagnosticMessage();
	u64 place = 1000000000;
	while (place > 1 && rank < place) {
		@order.text("0");
		@place = place / 10;
	};
	@order.number(rank);
	@order.text(":");
	@order.text(name);
	if (!item.get() || !edit.get()) {
		return rt::unique<rt::json_value>();
	};
	@item.get()->set("label", rt::json_value::make_string(name));
	@item.get()->set("detail", rt::json_value::make_string(detail));
	@item.get()->set("kind", rt::json_value::make_unsigned(u64(kind)));
	@item.get()->set("filterText", rt::json_value::make_string(name));
	@item.get()->set("sortText", rt::json_value::make_string(order.view()));
	@edit.get()->set("range", LanguageJson::range(text, begin, end));
	@edit.get()->set("newText", rt::json_value::make_string(name));
	@item.get()->set("textEdit", $edit);
	return $item;
};

fn language_completion_trivia(rt::string_view text, usize offset) -> bool {
	SourceFile source;
	@source.assign("", text);
	var lexer = Lexer(@source);
	var scanned = @lexer.scan();
	usize index = 0;
	while (index < source.comments().size()) {
		Token& comment = source.comments().data()[index];
		@index = index + 1;
		if (comment.begin < offset && offset < comment.begin + comment.length) {
			return true;
		};
		if (comment.begin < offset && offset == comment.begin + comment.length) {
			var spelling = comment.text();
			if (spelling.size() < 4 || spelling.data()[1] == '/' || spelling.data()[spelling.size() - 2] != '*' || spelling.data()[spelling.size() - 1] != '/') {
				return true;
			};
		};
	};
	@index = 0;
	while (index < source.tokens().size()) {
		Token& token = source.tokens().data()[index];
		@index = index + 1;
		if (token.kind != token_kind::literal_string && !(token.kind == token_kind::literal_number && token.length && token.text().data()[0] == '\'')) {
			continue;
		};
		if (token.begin < offset && (offset < token.begin + token.length || scanned.has<compilation_error>() && lexer.error_token().begin == token.begin && offset == token.begin + token.length)) {
			return true;
		};
	};
	return false;
};

fn language_completion_depth(LanguageIndex& index, u64 scope) -> usize {
	usize depth = 0;
	while (scope) {
		var found = index.scope_ids.find(scope);
		if (!found) {
			break;
		};
		@depth = depth + 1;
		@scope = index.scopes.data()[*found].parent;
	};
	return depth;
};

fn language_completion_scope(LanguageIndex& index, usize source, usize offset, u64 context, var usize& depth) -> u64 {
	u64 scope = 0;
	usize width = usize::max;
	usize region = 0;
	while (region < index.scopes.size()) {
		NavigationScope& candidate = index.scopes.data()[region];
		@region = region + 1;
		if ((context && candidate.context && index.template_owner(u64(candidate.context)) != context) || candidate.range.begin >= candidate.range.end || candidate.range.source != source || candidate.range.begin > offset || offset > candidate.range.end) {
			continue;
		};
		usize candidate_width = candidate.range.end - candidate.range.begin;
		usize candidate_depth = language_completion_depth(index, candidate.id);
		if (candidate_width < width || candidate_width == width && candidate_depth > depth) {
			@scope = candidate.id;
			@width = candidate_width;
			@depth = candidate_depth;
		};
	};
	return scope;
};

fn LanguageWorkspace::completion_visible(var LanguageWorkspace& this, LanguageIndex& index, NavigationSymbol& symbol) -> bool {
	SourceRange range;
	if (!@this.mapped(index, symbol.declaration, @range)) {
		return false;
	};
	LanguageIndexedSource& source = index.sources.data()[symbol.declaration.source];
	LanguageText* current = &@source.text;
	var LanguageDocument* open = @this.document_key(source.key.view());
	if (open) {
		@current = &@open->text;
	};
	if (symbol.declaration.end > source.text.view().size() || range.end > current->view().size()) {
		return false;
	};
	var before = rt::string_view(source.text.view().data() + symbol.declaration.begin, symbol.declaration.end - symbol.declaration.begin);
	var after = rt::string_view(current->view().data() + range.begin, range.end - range.begin);
	return before == after;
};

fn LanguageWorkspace::completion(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_array();
	rt::json_value* document = parameters.member("textDocument");
	rt::json_value* position = parameters.member("position");
	rt::string path;
	rt::string key;
	if (!result.get()) {
		return $result;
	};
	if (!document) {
		return $result;
	};
	if (!position) {
		return $result;
	};
	if (!LanguageUri::decode(LanguageJson::text(*document, "uri"), @path).has<void>()) {
		return $result;
	};
	LanguageUri::key(path.view(), @key);
	var found_source = index.source_ids.find(key);
	if (!found_source) {
		return $result;
	};
	usize source = *found_source;
	LanguageText* current = &@index.sources.data()[source].text;
	var LanguageDocument* open = @this.document_key(key.view());
	if (open) {
		@current = &@open->text;
	};
	i64 line = LanguageJson::integer(*position, "line", -1);
	i64 character = LanguageJson::integer(*position, "character", -1);
	if (line < 0 || character < 0) {
		return $result;
	};
	usize cursor = current->offset(usize(line), usize(character));
	var text = current->view();
	if (language_completion_trivia(text, cursor)) {
		return $result;
	};
	usize begin = cursor;
	while (begin && language_completion_identifier(text.data()[begin - 1])) {
		@begin = begin - 1;
	};
	usize end = cursor;
	while (end < text.size() && language_completion_identifier(text.data()[end])) {
		@end = end + 1;
	};
	var prefix = rt::string_view(text.data() + begin, cursor - begin);
	usize offset = 0;
	if (!@this.old_offset(index, source, cursor, @offset)) {
		if (!@this.old_offset(index, source, begin, @offset)) {
			if (begin) {
				if (!@this.old_offset(index, source, begin - 1, @offset)) {
					return $result;
				};
				@offset = offset + 1;
			}
			else {
				@offset = 0;
			};
		};
	};
	u64 selected_context = @this.template_context(index, source, offset);
	usize scope_depth = 0;
	u64 scope = language_completion_scope(index, source, offset, selected_context, @scope_depth);
	if (index.semantic_failed && this.highlight_fallback.get() && &@index != this.highlight_fallback.get()) {
		var fallback = this.highlight_fallback.get();
		var fallback_source = fallback->source_ids.find(key);
		if (fallback_source) {
			usize fallback_offset = 0;
			bool mapped = @this.old_offset(*fallback, *fallback_source, cursor, @fallback_offset) || @this.old_offset(*fallback, *fallback_source, begin, @fallback_offset);
			if (!mapped && begin) {
				@mapped = @this.old_offset(*fallback, *fallback_source, begin - 1, @fallback_offset);
				@fallback_offset = fallback_offset + 1;
			};
			if (mapped) {
				usize fallback_depth = 0;
				u64 context = @this.template_context(*fallback, *fallback_source, fallback_offset);
				discard language_completion_scope(*fallback, *fallback_source, fallback_offset, context, @fallback_depth);
				if (fallback_depth > scope_depth) {
					return @this.completion(*fallback, parameters);
				};
			};
		};
	};
	usize receiver = 0;
	rt::unordered_map<u64, bool> seen;
	while (receiver < index.receivers.size()) {
		NavigationReceiver& site = index.receivers.data()[receiver];
		@receiver = receiver + 1;
		if (
			site.selector.source != source
			|| selected_context && site.context && index.template_owner(u64(site.context)) != selected_context
			|| site.selector.begin >= offset
			|| site.selector.end < offset
		) {
			continue;
		};
		usize candidate = 0;
		while (candidate < site.candidates.size()) {
			u64 identity = site.candidates.data()[candidate];
			@candidate = candidate + 1;
			var found = index.symbol_ids.find(identity);
			if (!found || seen.find(identity)) {
				continue;
			};
			LanguageIndexedSymbol& symbol = index.symbols.data()[*found];
			var name = symbol.name.view();
			if (!language_completion_match(name, prefix) || !@this.completion_visible(index, symbol.value)) {
				continue;
			};
			u64 rank = 4;
			if (symbol.value.declaration.source != source) {
				@rank = rank + 2;
			};
			if (rt::string_view(name.data(), prefix.size()) != prefix) {
				@rank = rank + 1;
			};
			if (!@seen.insert(identity, true)) {
				return rt::unique<rt::json_value>();
			};
			@result.get()->append(language_completion_item(name, symbol.detail.view(), language_completion_kind(symbol.value.kind), rank, *current, begin, end));
		};
	};
	usize separator = begin;
	while (separator && (text.data()[separator - 1] == ' ' || text.data()[separator - 1] == '\t')) {
		@separator = separator - 1;
	};
	if (separator && (text.data()[separator - 1] == '.' || separator >= 2 && ((text.data()[separator - 2] == ':' && text.data()[separator - 1] == ':') || (text.data()[separator - 2] == '-' && text.data()[separator - 1] == '>')))) {
		return $result;
	};
	rt::unordered_map<rt::string_view, u64> names;
	u64 depth = 0;
	while (scope) {
		var members = index.scope_members.find(scope);
		usize member = 0;
		while (members && member < members->size()) {
			LanguageIndexedSymbol& symbol = index.symbols.data()[members->data()[member]];
			@member = member + 1;
			var name = symbol.name.view();
			if (!language_completion_match(name, prefix) || !@this.completion_visible(index, symbol.value) || symbol.value.kind == 13 && symbol.value.declaration.source == source && symbol.value.declaration.begin > offset) {
				continue;
			};
			var hidden = names.find(name);
			if (hidden && *hidden != scope) {
				continue;
			};
			if (!hidden && !@names.insert(name, scope)) {
				return rt::unique<rt::json_value>();
			};
			u64 rank = (depth + 1) * 4;
			if (symbol.value.declaration.source != source) {
				@rank = rank + 2;
			};
			if (name == "this") {
				@rank = 0;
			};
			if (rt::string_view(name.data(), prefix.size()) != prefix) {
				@rank = rank + 1;
			};
			@result.get()->append(language_completion_item(name, symbol.detail.view(), language_completion_kind(symbol.value.kind), rank, *current, begin, end));
		};
		var descriptor = index.scope_ids.find(scope);
		if (!descriptor) {
			break;
		};
		@scope = index.scopes.data()[*descriptor].parent;
		@depth = depth + 1;
	};
	usize primitive = 0;
	while (true) {
		var name = TypeStore::primitive_spelling(primitive);
		if (name.empty()) {
			break;
		};
		@primitive = primitive + 1;
		if (!names.find(name) && language_completion_match(name, prefix)) {
			@result.get()->append(language_completion_item(name, "Rutile built-in type", 7, 100000, *current, begin, end));
		};
	};
	i32 keyword = i32(token_kind::kw_fn);
	while (keyword <= i32(token_kind::kw_sizeof)) {
		var name = Lexer::keyword_spelling(static_cast<token_kind>(keyword));
		@keyword = keyword + 1;
		if (!names.find(name) && language_completion_match(name, prefix)) {
			@result.get()->append(language_completion_item(name, "Rutile keyword", 14, 100004, *current, begin, end));
		};
	};
	return $result;
};
fn LanguageWorkspace::signature_item(LanguageIndex& index, NavigationCall& call, u64 identity, usize offset) -> rt::unique<rt::json_value> {
	var found = index.symbol_ids.find(identity);
	if (!found) {
		return rt::json_value::make_null();
	};
	LanguageIndexedSymbol& symbol = index.symbols.data()[*found];
	var signature = rt::json_value::make_object();
	var parameters = rt::json_value::make_array();
	if (!signature.get() || !parameters.get()) {
		return rt::unique<rt::json_value>();
	};

	rt::string label;
	@label.append(symbol.name.view());
	@label.append("(");
	usize displayed = 0;
	usize parameter = 0;
	if (call.bound_receiver && symbol.parameters.size() && symbol.parameters.data()[0].name.view() == "this") {
		@parameter = 1;
	};
	while (parameter < symbol.parameters.size()) {
		LanguageIndexedParameter& input = symbol.parameters.data()[parameter];
		if (displayed) {
			@label.append(", ");
		};
		@label.append(input.detail.view());
		@displayed = displayed + 1;
		var item = rt::json_value::make_object();
		if (!item.get()) {
			return rt::unique<rt::json_value>();
		};
		@item.get()->set("label", rt::json_value::make_string(input.detail.view()));
		@parameters.get()->append($item);
		@parameter = parameter + 1;
	};
	@label.append(")");
	usize active = 0;
	while (active + 1 < call.arguments.size() && offset > call.arguments.data()[active].end) {
		@active = active + 1;
	};
	if (displayed && active >= displayed) {
		@active = displayed - 1;
	};
	@signature.get()->set("label", rt::json_value::make_string(label.view()));
	@signature.get()->set("documentation", rt::json_value::make_string(symbol.detail.view()));
	@signature.get()->set("parameters", $parameters);
	if (displayed) {
		@signature.get()->set("activeParameter", rt::json_value::make_unsigned(static_cast<u64>(active)));
	};
	return $signature;
};

fn LanguageWorkspace::signature(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value> {
	usize source = 0;
	usize offset = 0;
	if (!(@this.cursor(index, parameters, @source, @offset)).has<void>()) {
		return rt::json_value::make_null();
	};
	u64 selected_context = @this.template_context(index, parameters);
	usize width = usize::max;
	usize number = 0;
	while (number < index.calls.size()) {
		NavigationCall& call = index.calls.data()[number];
		@number = number + 1;
		if (
			call.range.source == source
			&& (!selected_context || !call.context || index.template_owner(u64(call.context)) == selected_context)
			&& call.callee.end < offset
			&& offset <= call.range.end
			&& (offset < call.range.end || !call.symbol)
			&& call.range.end - call.range.begin < width
		) {
			@width = call.range.end - call.range.begin;
		};
	};
	if (width == usize::max) {
		return rt::json_value::make_null();
	};

	var help = rt::json_value::make_object();
	var signatures = rt::json_value::make_array();
	if (!help.get() || !signatures.get()) {
		return rt::unique<rt::json_value>();
	};
	rt::unordered_map<u64, bool> seen;
	@number = 0;
	while (number < index.calls.size()) {
		NavigationCall& call = index.calls.data()[number];
		@number = number + 1;
		if (
			call.range.source != source
			|| selected_context && call.context && index.template_owner(u64(call.context)) != selected_context
			|| offset <= call.callee.end
			|| offset > call.range.end
			|| offset == call.range.end && call.symbol
			|| call.range.end - call.range.begin != width
		) {
			continue;
		};
		usize candidate = 0;
		usize count = call.candidates.size();
		if (call.symbol) {
			@count = 1;
		};
		while (candidate < count) {
			u64 identity = u64(call.symbol);
			if (!identity) {
				@identity = call.candidates.data()[candidate];
			};
			@candidate = candidate + 1;
			if (seen.find(identity)) {
				continue;
			};
			var signature = LanguageWorkspace::signature_item(index, call, u64(identity), usize(offset));
			if (!signature.get() || !@seen.insert($identity, true)) {
				return rt::unique<rt::json_value>();
			};
			if (signature.get()->kind() != rt::json_kind::null_value) {
				@signatures.get()->append($signature);
			};
		};
	};
	if (!signatures.get()->size()) {
		return rt::json_value::make_null();
	};
	if (signatures.get()->size() == 1) {
		rt::json_value* active = signatures.get()->item(0)->member("activeParameter");
		@help.get()->set("activeSignature", rt::json_value::make_unsigned(0));
		if (active) {
			@help.get()->set("activeParameter", rt::json_value::make_unsigned(static_cast<u64>(LanguageJson::integer(*signatures.get()->item(0), "activeParameter", 0))));
		};
	};
	@help.get()->set("signatures", $signatures);
	return $help;
};

struct LanguageJson {
	fn object() -> rt::unique<rt::json_value>;
	fn text(rt::json_value& object, rt::string_view key) -> rt::string_view;
	fn integer(rt::json_value& object, rt::string_view key, i64 fallback) -> i64;
	fn position(LanguagePosition& position) -> rt::unique<rt::json_value>;
	fn range(LanguageText& text, usize begin, usize end) -> rt::unique<rt::json_value>;
	fn notification(rt::string_view method, rt::unique<rt::json_value> parameters) -> rt::unique<rt::json_value>;
	fn response(rt::json_value& id, rt::unique<rt::json_value> value) -> rt::unique<rt::json_value>;
	fn failure(rt::json_value& id, i64 code, rt::string_view text) -> rt::unique<rt::json_value>;
};

fn LanguageJson::object() -> rt::unique<rt::json_value> {
	return rt::json_value::make_object();
};

fn LanguageJson::text(rt::json_value& object, rt::string_view key) -> rt::string_view {
	rt::json_value* value = object.member(key);
	if (!value || value->kind() != rt::json_kind::string) {
		return rt::string_view();
	};
	return value->text();
};

fn LanguageJson::integer(rt::json_value& object, rt::string_view key, i64 fallback) -> i64 {
	rt::json_value* value = object.member(key);
	if (!value) {
		return $fallback;
	};
	var result = value->integer();
	if (result.has<rt::json_error>()) {
		return $fallback;
	};
	return result.get<i64>();
};

fn LanguageJson::position(LanguagePosition& position) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@result.get()->set("line", rt::json_value::make_unsigned(static_cast<u64>(position.line)));
	@result.get()->set("character", rt::json_value::make_unsigned(static_cast<u64>(position.character)));
	return $result;
};

fn LanguageJson::range(LanguageText& text, usize begin, usize end) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@result.get()->set("start", LanguageJson::position(text.position($begin)));
	@result.get()->set("end", LanguageJson::position(text.position($end)));
	return $result;
};

fn LanguageJson::notification(rt::string_view method, rt::unique<rt::json_value> parameters) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@result.get()->set("jsonrpc", rt::json_value::make_string("2.0"));
	@result.get()->set("method", rt::json_value::make_string(method));
	@result.get()->set("params", $parameters);
	return $result;
};

fn LanguageJson::response(rt::json_value& id, rt::unique<rt::json_value> value) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@result.get()->set("jsonrpc", rt::json_value::make_string("2.0"));
	@result.get()->set("id", id.clone());
	@result.get()->set("result", $value);
	return $result;
};

fn LanguageJson::failure(rt::json_value& id, i64 code, rt::string_view text) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	var error = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	if (!error.get()) {
		return rt::unique<rt::json_value>();
	};
	@error.get()->set("code", rt::json_value::make_integer($code));
	@error.get()->set("message", rt::json_value::make_string(text));
	@result.get()->set("jsonrpc", rt::json_value::make_string("2.0"));
	@result.get()->set("id", id.clone());
	@result.get()->set("error", $error);
	return $result;
};

fn fgetc(var NativeFile* file) -> i32;
fn fflush(var NativeFile* file) -> i32;

struct RuntimeMutex;

fn runtime_mutex_create() -> var RuntimeMutex*;
fn runtime_mutex_destroy(var RuntimeMutex* mutex);
fn runtime_mutex_lock(var RuntimeMutex* mutex);
fn runtime_mutex_unlock(var RuntimeMutex* mutex);

enum language_frame_status : [u08] {
	message;
	end_of_stream;
	error;
};

struct language_request_error {
};
using LanguageRequestResult = void | language_request_error;

struct language_transport_error {
	rt::string_view message;
};

struct LanguageProtocol {
	fn LanguageProtocol(var LanguageProtocol& this, var NativeFile& input, var NativeFile& output);
	fn LanguageProtocol(var LanguageProtocol& this, LanguageProtocol& other) : [delete];
	fn LanguageProtocol(var LanguageProtocol& this, LanguageProtocol other) : [delete];
	fn ~LanguageProtocol(var LanguageProtocol& this);

	fn read(var LanguageProtocol& this, var rt::string& body) -> language_frame_status;
	fn send(var LanguageProtocol& this, rt::string_view body);
	fn error(LanguageProtocol& this) -> rt::string_view;
	fn ready(LanguageProtocol& this) -> bool;

private:
	fn fail(var LanguageProtocol& this, rt::string_view message) -> language_frame_status;
	fn header_name(rt::string_view name, rt::string_view expected) -> bool;
	fn length(rt::string_view text, var usize& result) -> LanguageRequestResult;
	fn decimal(var rt::string& output, u64 value);
	fn write(var LanguageProtocol& this, rt::string_view bytes);

	var NativeFile* input;
	var NativeFile* output;
	var RuntimeMutex* output_mutex;
	rt::string_view failure;
};

fn LanguageProtocol::LanguageProtocol(var LanguageProtocol& this, var NativeFile& input, var NativeFile& output) {
	@this.input = &@input;
	@this.output = &@output;
	@this.output_mutex = runtime_mutex_create();
};

fn LanguageProtocol::~LanguageProtocol(var LanguageProtocol& this) {
	if (this.output_mutex) {
		runtime_mutex_destroy(this.output_mutex);
	};
};

fn LanguageProtocol::ready(LanguageProtocol& this) -> bool {
	return this.output_mutex != nullptr;
};

fn LanguageProtocol::error(LanguageProtocol& this) -> rt::string_view {
	return rt::string_view(this.failure);
};

fn LanguageProtocol::fail(var LanguageProtocol& this, rt::string_view message) -> language_frame_status {
	@this.failure = rt::string_view(message);
	return language_frame_status::error;
};

fn LanguageProtocol::header_name(rt::string_view name, rt::string_view expected) -> bool {
	if (name.size() != expected.size()) {
		return false;
	};

	usize index = 0;
	while (index < name.size()) {
		char value = name.data()[index];
		if (value >= 'A' && value <= 'Z') {
			@value = static_cast<char>(static_cast<i32>(value) + 32);
		};

		if (value != expected.data()[index]) {
			return false;
		};
		@index = index + 1;
	};

	return true;
};

fn LanguageProtocol::length(rt::string_view text, var usize& result) -> LanguageRequestResult {
	if (text.empty()) {
		return language_request_error();
	};

	usize value = 0;
	usize index = 0;
	while (index < text.size()) {
		char character = text.data()[index];
		if (character < '0' || character > '9') {
			return language_request_error();
		};

		usize digit = static_cast<usize>(static_cast<i32>(character) - 48);
		if (value > (usize::max - digit) / 10) {
			return language_request_error();
		};

		@value = value * 10 + digit;
		@index = index + 1;
	};

	@result = $value;
};

fn LanguageProtocol::read(var LanguageProtocol& this, var rt::string& body) -> language_frame_status {
	@body.clear();
	@this.failure = rt::string_view();
	rt::optional<usize> content_length;
	usize header_bytes = 0;

	while (true) {
		rt::string header;
		while (true) {
			i32 value = fgetc(this.input);
			if (value < 0) {
				if (ferror(this.input)) {
					language_transport_error error;
					@error.message = "language protocol input could not be read";
					throw $error;
				};
				if (!header_bytes && !ferror(this.input)) {
					return language_frame_status::end_of_stream;
				};
				return @this.fail("unexpected end of protocol header");
			};

			@header_bytes = header_bytes + 1;
			if (header_bytes > 8192) {
				return @this.fail("protocol headers exceed 8192 bytes");
			};

			if (value == 10) {
				break;
			};
			char byte = static_cast<char>(value);
			@header.append(rt::string_view(&@byte, 1));
		};

		usize size = header.size();
		if (size && header.data()[size - 1] == '\r') {
			@size = size - 1;
		};
		if (!size) {
			break;
		};

		usize separator = 0;
		while (separator < size && header.data()[separator] != ':') {
			@separator = separator + 1;
		};
		if (separator == size) {
			return @this.fail("protocol header requires a colon");
		};

		var name = rt::string_view(header.data(), usize(separator));
		if (!LanguageProtocol::header_name(name, "content-length")) {
			continue;
		};
		if (content_length.has_value()) {
			return @this.fail("duplicate protocol Content-Length header");
		};

		@separator = separator + 1;
		while (separator < size && (header.data()[separator] == ' ' || header.data()[separator] == '\t')) {
			@separator = separator + 1;
		};
		usize parsed = 0;
		if (!LanguageProtocol::length(rt::string_view(header.data() + separator, size - separator), @parsed).has<void>() || parsed > 67108864) {
			return @this.fail("invalid protocol Content-Length; expected a decimal byte count up to 67108864");
		};
		@content_length = rt::optional<usize>($parsed);
	};

	if (!content_length.has_value()) {
		return @this.fail("protocol message is missing Content-Length");
	};

	usize remaining = content_length.value();
	char[4096] chunk;
	while (remaining) {
		usize request = sizeof(chunk);
		if (request > remaining) {
			@request = usize(remaining);
		};

		usize count = fread(&@chunk[0], 1, $request, this.input);
		if (!count) {
			if (ferror(this.input)) {
				language_transport_error error;
				@error.message = "language protocol message body could not be read";
				throw $error;
			};
			return @this.fail("unexpected end of protocol message body");
		};
		@body.append(rt::string_view(&@chunk[0], usize(count)));
		@remaining = remaining - count;
	};

	return language_frame_status::message;
};

fn LanguageProtocol::decimal(var rt::string& output, u64 value) {
	char[20] digits;
	usize count = 0;
	while (true) {
		@digits[count] = static_cast<char>(48 + static_cast<i32>(value % 10));
		@count = count + 1;
		@value = value / 10;
		if (!value) {
			break;
		};
	};

	while (count) {
		@count = count - 1;
		@output.append(rt::string_view(&@digits[count], 1));
	};
};

fn LanguageProtocol::write(var LanguageProtocol& this, rt::string_view bytes) {
	usize offset = 0;
	while (offset < bytes.size()) {
		usize written = fwrite(bytes.data() + offset, 1, bytes.size() - offset, this.output);
		if (!written) {
			language_transport_error error;
			@error.message = "language protocol output could not be written";
			throw $error;
		};
		@offset = offset + written;
	};
};

fn LanguageProtocol::send(var LanguageProtocol& this, rt::string_view body) {
	if (!this.ready()) {
		compiler_panic("language server send invariant failed");
	};

	rt::string header;
	@header.append("Content-Length: ");
	LanguageProtocol::decimal(@header, static_cast<u64>(body.size()));
	@header.append("\r\n\r\n");

	runtime_mutex_lock(this.output_mutex);
	try {
		@this.write(header.view());
		@this.write(body);
		if (fflush(this.output)) {
			language_transport_error error;
			@error.message = "language protocol output could not be flushed";
			throw $error;
		};
	}
	catch (language_transport_error& error) {
		runtime_mutex_unlock(this.output_mutex);
		throw;
	};
	runtime_mutex_unlock(this.output_mutex);
};

fn LanguageWorkspace::old_offset(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize current, var usize& original) -> bool {
	LanguageIndexedSource& input = index.sources.data()[source];
	var LanguageDocument* document = @this.document_key(input.key.view());
	if (!document) {
		if (input.version.has_value()) {
			return false;
		};
		@original = $current;
		return true;
	};
	if (!input.version.has_value() || input.revision < document->opened_revision) {
		return false;
	};

	usize edit = document->edits.size();
	while (edit) {
		@edit = edit - 1;
		LanguageEdit& change = document->edits.data()[edit];
		if (change.revision <= input.revision) {
			break;
		};
		if (current < change.begin) {
			continue;
		};
		if (current < change.begin + change.inserted) {
			return false;
		};
		@current = current - change.inserted + change.end - change.begin;
	};
	@original = $current;
	return true;
};

fn LanguageWorkspace::mapped(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& input, var SourceRange& output) -> bool {
	if (input.source >= index.sources.size()) {
		return false;
	};
	@output = SourceRange(input);
	LanguageIndexedSource& source = index.sources.data()[input.source];
	var LanguageDocument* document = @this.document_key(source.key.view());
	if (!document) {
		return !source.version.has_value();
	};
	if (!source.version.has_value() || source.revision < document->opened_revision) {
		return false;
	};

	usize edit = 0;
	while (edit < document->edits.size()) {
		LanguageEdit& change = document->edits.data()[edit];
		@edit = edit + 1;
		if (change.revision <= source.revision || output.end <= change.begin) {
			continue;
		};
		if (output.begin < change.end || change.begin == change.end && output.begin < change.begin && change.begin < output.end) {
			return false;
		};
		@output.begin = output.begin - (change.end - change.begin) + change.inserted;
		@output.end = output.end - (change.end - change.begin) + change.inserted;
	};
	return true;
};

fn LanguageWorkspace::location(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& range) -> rt::unique<rt::json_value> {
	SourceRange current;
	if (!@this.mapped(index, range, @current)) {
		return rt::unique<rt::json_value>();
	};
	LanguageIndexedSource& source = index.sources.data()[range.source];
	LanguageText* text = &@source.text;
	var LanguageDocument* document = @this.document_key(source.key.view());
	if (document) {
		@text = &@document->text;
	};

	var result = rt::json_value::make_object();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@result.get()->set("uri", rt::json_value::make_string(source.uri.view()));
	@result.get()->set("range", LanguageJson::range(*text, usize(current.begin), usize(current.end)));
	return $result;
};

fn LanguageWorkspace::bindings(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var rt::buffer<u64>& result) -> LanguageRequestResult {
	rt::json_value* document = parameters.member("textDocument");
	rt::json_value* position = parameters.member("position");
	if (!document || !position) {
		return language_request_error();
	};
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(LanguageJson::text(*document, "uri"), @path).has<void>()) {
		return language_request_error();
	};
	LanguageUri::key(path.view(), @key);
	var found = index.source_ids.find(key);
	if (!found) {
		return;
	};
	usize source = *found;
	LanguageText* text = &@index.sources.data()[source].text;
	var LanguageDocument* open = @this.document_key(key.view());
	if (open) {
		@text = &@open->text;
	};
	i64 line = LanguageJson::integer(*position, "line", -1);
	i64 character = LanguageJson::integer(*position, "character", -1);
	if (line < 0 || character < 0) {
		return language_request_error();
	};
	usize current = text->offset(static_cast<usize>(line), static_cast<usize>(character));
	usize original = 0;
	if (!@this.old_offset(index, usize(source), usize(current), @original)) {
		return;
	};

	usize first = 0;
	usize last = index.occurrences.size();
	while (first < last) {
		usize middle = first + (last - first) / 2;
		NavigationOccurrence& candidate = index.occurrences.data()[middle];
		if (candidate.range.source < source || candidate.range.source == source && candidate.range.begin <= original) {
			@first = middle + 1;
		}
		else {
			@last = $middle;
		};
	};
	u64 selected_context = @this.template_context(index, parameters);
	usize boundary = first;
	usize pass = 0;
	while (pass < 2 && !result.size()) {
		usize selected_width = usize::max;
		u32 selected_role = 0;
		@first = boundary;
		while (first) {
			@first = first - 1;
			NavigationOccurrence& candidate = index.occurrences.data()[first];
			if (candidate.range.source != source || candidate.range.end < original) {
				break;
			};
			if (selected_context && candidate.context && index.template_owner(u64(candidate.context)) != selected_context) {
				continue;
			};
			SourceRange mapped;
			if (!@this.mapped(index, candidate.range, @mapped)) {
				continue;
			};
			bool contains = mapped.begin <= current && current < mapped.end;
			bool selected_end = pass == 1 && mapped.begin < mapped.end && current == mapped.end;
			if (contains || selected_end) {
				usize width = mapped.end - mapped.begin;
				u32 role = candidate.roles & 16;
				if (width > selected_width || width == selected_width && role < selected_role) {
					continue;
				};
				if (width < selected_width || role > selected_role) {
					@result.clear();
					@selected_width = $width;
					@selected_role = $role;
				};
				usize duplicate = 0;
				while (duplicate < result.size() && result.data()[duplicate] != candidate.symbol) {
					@duplicate = duplicate + 1;
				};
				if (duplicate == result.size()) {
					@result.push_back(u64(candidate.symbol));
				};
			};
		};
		@pass = pass + 1;
	};
};

fn LanguageWorkspace::contains(rt::string_view text, rt::string_view part) -> bool {
	if (part.size() > text.size()) {
		return false;
	};
	usize offset = 0;
	while (offset <= text.size() - part.size()) {
		if (rt::string_view(text.data() + offset, part.size()) == part) {
			return true;
		};
		@offset = offset + 1;
	};
	return false;
};

fn LanguageWorkspace::measured(var LanguageWorkspace& this, rt::unique<rt::json_value> result, u64 started) -> rt::unique<rt::json_value> {
	@this.queries = this.queries + 1;
	@this.query_nanoseconds = this.query_nanoseconds + runtime_clock_nanoseconds() - started;
	return $result;
};

fn LanguageWorkspace::append_location(var rt::json_value& result, rt::unique<rt::json_value> location, var rt::unordered_map<rt::string, bool>& seen) {
	if (!location.get()) {
		return;
	};
	rt::string key;
	rt::json_write(*location.get(), @key);
	if (seen.find(key)) {
		return;
	};
	if (!@seen.insert($key, true)) {
		compiler_panic("language server append_location invariant failed");
	};
	@result.append($location);
};

fn LanguageWorkspace::query(var LanguageWorkspace& this, rt::string_view method, rt::json_value& parameters) -> rt::unique<rt::json_value> {
	u64 started = runtime_clock_nanoseconds();
	@this.receive();
	var LanguageIndex* index = this.published.get();
	if (index && (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range")) {
		return @this.measured(@this.tokens(*index, parameters, method == "textDocument/semanticTokens/range"), $started);
	};
	if (index && method == "textDocument/completion") {
		return @this.measured(@this.completion(*index, parameters), $started);
	};
	if (!index || index->generation < this.minimum_semantic_generation) {
		if (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range") {
			return @this.measured(rt::json_value::make_null(), $started);
		};
		if (method == "textDocument/hover" || method == "textDocument/signatureHelp") {
			return @this.measured(rt::json_value::make_null(), $started);
		};
		return @this.measured(rt::json_value::make_array(), $started);
	};
	if (method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range") {
		return @this.measured(@this.tokens(*index, parameters, method == "textDocument/semanticTokens/range"), $started);
	};

	if (method == "rutile/templateContexts" || method == "rutile/selectTemplateContext") {
		return @this.measured(@this.template_contexts(*index, parameters, method == "rutile/selectTemplateContext"), $started);
	};

	if (method == "textDocument/signatureHelp") {
		return @this.measured(@this.signature(*index, parameters), $started);
	};

	var result = rt::json_value::make_array();
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	if (method == "workspace/symbol" || method == "textDocument/documentSymbol") {
		usize source = usize::max;
		if (method == "textDocument/documentSymbol") {
			rt::json_value* identity = parameters.member("textDocument");
			rt::string path;
			rt::string key;
			if (!identity) {
				return rt::unique<rt::json_value>();
			};
			if (!LanguageUri::decode(LanguageJson::text(*identity, "uri"), @path).has<void>()) {
				return rt::unique<rt::json_value>();
			};
			LanguageUri::key(path.view(), @key);
			var found = index->source_ids.find(key);
			if (!found) {
				return @this.measured($result, $started);
			};
			@source = *found;
		};
		var filter = LanguageJson::text(parameters, "query");
		usize number = 0;
		while (number < index->symbols.size()) {
			LanguageIndexedSymbol& symbol = index->symbols.data()[number];
			@number = number + 1;
			if ((symbol.value.flags & 4) || source != usize::max && symbol.value.declaration.source != source || !LanguageWorkspace::contains(symbol.name.view(), filter)) {
				continue;
			};
			var location = @this.location(*index, symbol.value.declaration);
			if (!location.get()) {
				continue;
			};
			var information = rt::json_value::make_object();
			if (!information.get()) {
				return rt::unique<rt::json_value>();
			};
			@information.get()->set("name", rt::json_value::make_string(symbol.name.view()));
			@information.get()->set("kind", rt::json_value::make_unsigned(static_cast<u64>(symbol.value.kind)));
			@information.get()->set("location", $location);
			@result.get()->append($information);
		};
		return @this.measured($result, $started);
	};

	rt::buffer<u64> bindings;
	if (!(@this.bindings(*index, parameters, @bindings)).has<void>()) {
		return rt::unique<rt::json_value>();
	};
	if (method == "textDocument/hover") {
		return @this.measured(@this.hover(*index, parameters, bindings), $started);
	};

	rt::unordered_map<rt::string, bool> seen;
	usize binding = 0;
	while (binding < bindings.size()) {
		u64 id = bindings.data()[binding];
		@binding = binding + 1;
		var found = index->symbol_ids.find(id);
		if (!found) {
			continue;
		};
		if (method == "textDocument/references") {
			var references = index->references.find(id);
			if (!references) {
				continue;
			};
			rt::json_value* context = parameters.member("context");
			rt::json_value* include = nullptr;
			if (context) {
				@include = context->member("includeDeclaration");
			};
			usize occurrence = 0;
			while (occurrence < references->size()) {
				NavigationOccurrence& item = index->occurrences.data()[references->data()[occurrence]];
				@occurrence = occurrence + 1;
				if ((item.roles & 1) && (!include || !include->boolean())) {
					continue;
				};
				var location = @this.location(*index, item.range);
				LanguageWorkspace::append_location(@*result.get(), $location, @seen);
			};
		}
		else {
			if (method == "textDocument/typeDefinition") {
				u64 target = index->identity(index->symbols.data()[*found].type_symbol);
				var type = index->symbol_ids.find(target);
				if (!type) {
					continue;
				};
				@found = type;
			};
			NavigationSymbol& destination = index->symbols.data()[*found].value;
			SourceRange range := destination.declaration;
			if (
				(method == "textDocument/definition" || method == "textDocument/typeDefinition")
				&& (destination.flags & 1)
			) {
				usize source = 0;
				usize offset = 0;
				if (
					(@this.cursor(*index, parameters, @source, @offset)).has<void>()
					&& source == destination.declaration.source
					&& destination.declaration.begin <= offset
					&& offset <= destination.declaration.end
				) {
					@range = SourceRange(destination.definition);
				};
			};
			var location = @this.location(*index, range);
			LanguageWorkspace::append_location(@*result.get(), $location, @seen);
		};
	};
	return @this.measured($result, $started);
};

fn LanguageWorkspace::status(var LanguageWorkspace& this) -> rt::unique<rt::json_value> {
	@this.receive();
	var result = rt::json_value::make_object();
	var documents = rt::json_value::make_array();
	if (!result.get() || !documents.get()) {
		return rt::unique<rt::json_value>();
	};
	usize index = 0;
	while (index < this.documents.size()) {
		LanguageDocument& document = *this.documents.data()[index].get();
		var information = rt::json_value::make_object();
		if (!information.get()) {
			return rt::unique<rt::json_value>();
		};
		@information.get()->set("uri", rt::json_value::make_string(document.uri.view()));
		@information.get()->set("version", rt::json_value::make_integer(i64(document.version)));
		var version = rt::json_value::make_null();
		if (this.published.get()) {
			var found = this.published.get()->source_ids.find(document.key);
			if (found && this.published.get()->sources.data()[*found].version.has_value()) {
				@version = rt::json_value::make_integer(i64(this.published.get()->sources.data()[*found].version.value()));
			};
		};
		@information.get()->set("indexedVersion", $version);
		@documents.get()->append($information);
		@index = index + 1;
	};
	u64 generation = 0;
	u64 build = 0;
	if (this.published.get()) {
		@generation = this.published.get()->generation;
		@build = this.published.get()->build_nanoseconds;
	};
	u64 phase = runtime_atomic_load(this.analysis_phase);
	rt::string_view phase_name = "idle";
	switch (phase) {
		case 1: @phase_name = "loadingSources"; break;
		case 2: @phase_name = "compilerAnalysis"; break;
		case 3: @phase_name = "copyingIndex"; break;
		case 4: @phase_name = "sortingIndex"; break;
		case 5: @phase_name = "failed"; break;
	};
	u64 elapsed = 0;
	u64 began = runtime_atomic_load(this.phase_started);
	if (phase && began) {
		@elapsed = runtime_clock_nanoseconds() - began;
	};
	@result.get()->set("analysisPhase", rt::json_value::make_string(phase_name));
	@result.get()->set("phaseNanoseconds", rt::json_value::make_unsigned($elapsed));
	@result.get()->set("generation", rt::json_value::make_unsigned(runtime_atomic_load(this.generation)));
	@result.get()->set("indexedGeneration", rt::json_value::make_unsigned(u64(generation)));
	@result.get()->set("indexBuildNanoseconds", rt::json_value::make_unsigned($build));
	@result.get()->set("queries", rt::json_value::make_unsigned(u64(this.queries)));
	@result.get()->set("lookupNanoseconds", rt::json_value::make_unsigned(u64(this.query_nanoseconds)));
	@result.get()->set("bindingsCurrent", rt::json_value::make_boolean(this.published.get() && generation >= this.minimum_semantic_generation));
	@result.get()->set("documents", $documents);
	return $result;
};

fn language_lexical_type(Analysis* analysis, Token& input) -> u32 {
	if (input.kind == token_kind::identifier) {
		if (analysis && analysis->primitive_name(input.text()) || input.is("this") || input.is("true") || input.is("false")) {
			return 13;
		};
		return u32::max;
	};
	if (input.kind == token_kind::literal_number) {
		if (input.text().data()[0] == '\'') {
			return 15;
		};
		return 16;
	};
	if (input.kind == token_kind::literal_string) {
		return 15;
	};
	if (input.kind >= token_kind::kw_return && input.kind <= token_kind::kw_continue) {
		return 18;
	};
	if (input.kind >= token_kind::kw_fn && input.kind <= token_kind::kw_sizeof) {
		return 13;
	};
	return 17;
};

fn language_lexical_tokens(Analysis* analysis, rt::buffer<Token>& tokens, rt::buffer<Token>& comments, usize target, var LanguageIndexedSource& source) {
	usize index = 0;
	usize comment = 0;
	while (index < tokens.size() || comment < comments.size()) {
		Token* input = nullptr;
		u32 classification = 17;
		if (comment < comments.size() && (index >= tokens.size() || comments.data()[comment].begin < tokens.data()[index].begin)) {
			@input = &@comments.data()[comment];
			@comment = comment + 1;
			@classification = 14;
		}
		else {
			@input = &@tokens.data()[index];
			@index = index + 1;
		};
		if (!input->length || classification != 14 && input->kind == token_kind::eof) {
			continue;
		};
		LanguageSemanticToken token;
		@token.range.source = target;
		@token.range.begin = input->begin;
		@token.range.end = input->begin + input->length;
		@token.type = classification;
		if (classification != 14) {
			@token.type = language_lexical_type(analysis, *input);
		};
		if (!@source.token_offsets.insert(usize(input->begin), source.tokens.size())) {
			compiler_panic("language server language_lexical_tokens invariant failed");
		};
		@source.tokens.push_back($token);
	};
};

fn LanguageIndex::classify_source(var LanguageIndex& this, Analysis& analysis, usize original, usize target) {
	var LanguageIndexedSource& source = @(@this.sources).data()[target];
	if (source.tokens.size()) {
		return;
	};
	rt::buffer<Token>* tokens = analysis.source_tokens(usize(original));
	rt::buffer<Token>* comments = analysis.source_comments(usize(original));
	if (!tokens || !comments) {
		return;
	};
	language_lexical_tokens(&@analysis, *tokens, *comments, target, @source);
};

fn language_classify_template_names(var LanguageIndex& index, Analysis& analysis, rt::buffer<usize>& mapping, Syntax& syntax, var rt::buffer<Token>& parameters, bool unqualified) {
	usize checkpoint = parameters.size();
	if (syntax.kind() == syntax_kind::template_declaration) {
		Syntax& list = *syntax.template_parameters();
		usize parameter = 0;
		while (parameter < list.size()) {
			Syntax& declaration = *list.item(parameter);
			if ((declaration.template_parameter_type()->kind() == syntax_kind::absent || declaration.template_parameter_type()->kind() == syntax_kind::pack_signature)) {
				@parameters.push_back(declaration.template_parameter_name()->token());
			};
			@parameter = parameter + 1;
		};
	};
	if (unqualified && syntax.kind() == syntax_kind::name) {
		usize parameter = parameters.size();
		while (parameter) {
			@parameter = parameter - 1;
			if (parameters.data()[parameter].same(syntax.token())) {
				SourceRange range = analysis.navigation().range(syntax.token());
				if (range.source < mapping.size()) {
					var LanguageIndexedSource& source = @(@index.sources).data()[mapping.data()[range.source]];
					var found = source.token_offsets.find(range.begin);
					if (found && source.tokens.data()[*found].range.end == range.end && (source.tokens.data()[*found].type == u32::max || source.tokens.data()[*found].type == 0)) {
						@(@source.tokens).data()[*found].type = 6;
					};
				};
				break;
			};
		};
	};
	usize child = 0;
	while (child < syntax.size()) {
		bool child_unqualified = syntax.kind() != syntax_kind::qualified_name || !child;
		if ((syntax.kind() == syntax_kind::variable && syntax.item(child) == syntax.variable_name()) || (syntax.kind() == syntax_kind::parameter && syntax.item(child) == syntax.parameter_name())) {
			@child_unqualified = false;
		};
		language_classify_template_names(@index, analysis, mapping, *syntax.item(child), @parameters, $child_unqualified);
		@child = child + 1;
	};
	while (parameters.size() > checkpoint) {
		@parameters.pop_back();
	};
};

fn LanguageIndex::classify_bindings(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping) {
	rt::buffer<rt::unique<Syntax>>& roots = analysis.syntax_roots();
	usize root = 0;
	while (root < roots.size()) {
		@this.classify_syntax(analysis, mapping, *roots.data()[root].get());
		@root = root + 1;
	};
	usize classification = 0;
	while (classification < analysis.navigation().classification_count()) {
		NavigationClassification* input = analysis.navigation().classification_at(classification);
		@classification = classification + 1;
		if (input->range.source >= mapping.size()) {
			continue;
		};
		var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[input->range.source]];
		var present = source.token_offsets.find(input->range.begin);
		if (present && source.tokens.data()[*present].range.end == input->range.end) {
			@(@source.tokens).data()[*present].type = input->type;
			@(@source.tokens).data()[*present].modifiers = input->modifiers;
		};
	};
	usize index = 0;
	while (index < analysis.navigation().occurrence_count()) {
		NavigationOccurrence* occurrence = analysis.navigation().occurrence_at(index);
		@index = index + 1;
		if (occurrence->range.source >= mapping.size() || !occurrence->symbol) {
			continue;
		};
		var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[occurrence->range.source]];
		var found = source.token_offsets.find(occurrence->range.begin);
		if (!found) {
			continue;
		};
		var LanguageSemanticToken& token = @(@source.tokens).data()[*found];
		if (token.range.end != occurrence->range.end) {
			continue;
		};
		@token.type = analysis.navigation().semantic_token_type(occurrence->symbol);
		if (source.text.view().slice(token.range.begin, token.range.end - token.range.begin) == "this") {
			@token.type = 13;
		};
		if (occurrence->roles & 1) {
			@token.modifiers = token.modifiers | 1;
		};
		if (analysis.navigation().symbol_readonly(occurrence->symbol)) {
			@token.modifiers = token.modifiers | 4;
		};
	};
	rt::buffer<Token> parameters;
	@root = 0;
	while (root < roots.size()) {
		@this.classify_syntax(analysis, mapping, *roots.data()[root].get());
		language_classify_template_names(@this, analysis, mapping, *roots.data()[root].get(), @parameters, true);
		@root = root + 1;
	};
};

fn LanguageWorkspace::overlay_token(var LanguageWorkspace& this, LanguageIndex& index, rt::string_view key, SourceRange& current, LanguageText& text, var u32& type, var u32& modifiers) -> bool {
	var owned_key = rt::string(key);
	var found = index.source_ids.find(owned_key);
	if (!found) {
		return false;
	};
	LanguageIndexedSource& source = index.sources.data()[*found];
	usize offset = 0;
	if (!@this.old_offset(index, *found, current.begin, @offset)) {
		return false;
	};
	var position = source.token_offsets.find(offset);
	if (!position) {
		return false;
	};
	LanguageSemanticToken& token = source.tokens.data()[*position];
	SourceRange mapped;
	if (token.type > 13 || !@this.mapped(index, token.range, @mapped) || mapped.begin != current.begin || mapped.end != current.end) {
		return false;
	};
	if (token.range.end > source.text.view().size() || current.end > text.view().size()) {
		return false;
	};
	var before = rt::string_view(source.text.view().data() + token.range.begin, token.range.end - token.range.begin);
	var after = rt::string_view(text.view().data() + current.begin, current.end - current.begin);
	if (before != after) {
		return false;
	};
	@type = token.type;
	@modifiers = token.modifiers;
	return true;
};

fn LanguageWorkspace::tokens(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool ranged) -> rt::unique<rt::json_value> {
	var response = rt::json_value::make_object();
	var data = rt::json_value::make_array();
	rt::json_value* document = parameters.member("textDocument");
	if (!response.get() || !data.get() || !document) {
		return rt::unique<rt::json_value>();
	};
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(LanguageJson::text(*document, "uri"), @path).has<void>()) {
		return rt::unique<rt::json_value>();
	};
	LanguageUri::key(path.view(), @key);
	var found = index.source_ids.find(key);
	if (!found) {
		return rt::json_value::make_null();
	};
	usize source_number = *found;
	LanguageIndexedSource& source = index.sources.data()[source_number];
	LanguageText* text = &@source.text;
	var LanguageDocument* open = @this.document_key(source.key.view());
	if (open) {
		@text = &@open->text;
	};
	SourceFile live_source;
	LanguageIndexedSource live_colors;
	bool live = open && open->revision != source.revision;
	rt::buffer<LanguageSemanticToken>* colors = &@source.tokens;
	if (live) {
		@live_source.assign(open->path.view(), text->view());
		var lexer = Lexer(@live_source);
		// An unfinished edit can still provide a valid lexical prefix.
		discard @lexer.scan();
		language_lexical_tokens(nullptr, live_source.tokens(), live_source.comments(), source_number, @live_colors);
		@colors = &@live_colors.tokens;
	};
	usize first = 0;
	usize last = text->view().size();
	if (ranged) {
		rt::json_value* range = parameters.member("range");
		if (!range || !range->member("start") || !range->member("end")) {
			return rt::unique<rt::json_value>();
		};
		@first = text->offset(static_cast<usize>(LanguageJson::integer(*range->member("start"), "line", 0)), static_cast<usize>(LanguageJson::integer(*range->member("start"), "character", 0)));
		@last = text->offset(static_cast<usize>(LanguageJson::integer(*range->member("end"), "line", 0)), static_cast<usize>(LanguageJson::integer(*range->member("end"), "character", 0)));
	};
	usize previous_line = 0;
	usize previous_character = 0;
	usize index_token = 0;
	while (index_token < colors->size()) {
		LanguageSemanticToken& token = colors->data()[index_token];
		@index_token = index_token + 1;
		SourceRange current;
		if (live) {
			@current = SourceRange(token.range);
		}
		else if (!@this.mapped(index, token.range, @current)) {
			continue;
		};
		if (current.end <= first || current.begin >= last) {
			continue;
		};
		u32 type = token.type;
		u32 modifiers = token.modifiers;
		if (type == u32::max && live) {
			discard @this.overlay_token(index, source.key.view(), current, *text, @type, @modifiers);
		};
		if (type == u32::max && index.semantic_failed && this.highlight_fallback.get()) {
			discard @this.overlay_token(*this.highlight_fallback.get(), source.key.view(), current, *text, @type, @modifiers);
		};
		if (type == u32::max) {
			continue;
		};
		usize begin = current.begin;
		usize end = current.end;
		if (begin < first) {
			@begin = first;
		};
		if (end > last) {
			@end = last;
		};
		while (begin < end) {
			usize finish = begin;
			while (finish < end && text->view().data()[finish] != '\n' && text->view().data()[finish] != '\r') {
				@finish = finish + 1;
			};
			if (finish > begin) {
				LanguagePosition position = text->position(usize(begin));
				LanguagePosition ending = text->position(usize(finish));
				usize delta_character = position.character;
				if (position.line == previous_line) {
					@delta_character = delta_character - previous_character;
				};
				@data.get()->append(rt::json_value::make_unsigned(static_cast<u64>(position.line - previous_line)));
				@data.get()->append(rt::json_value::make_unsigned(static_cast<u64>(delta_character)));
				@data.get()->append(rt::json_value::make_unsigned(static_cast<u64>(ending.character - position.character)));
				@data.get()->append(rt::json_value::make_unsigned(u64(type)));
				@data.get()->append(rt::json_value::make_unsigned(u64(modifiers)));
				@previous_line = position.line;
				@previous_character = position.character;
			};
			@begin = finish;
			while (begin < end && (text->view().data()[begin] == '\n' || text->view().data()[begin] == '\r')) {
				@begin = begin + 1;
			};
		};
	};
	@response.get()->set("data", $data);
	return $response;
};

fn LanguageIndex::classify_syntax(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping, Syntax& syntax) {
	if (syntax.kind() == syntax_kind::ambiguity) {
		return;
	};
	if (syntax.kind() == syntax_kind::pack_signature_declaration) {
		SourceRange range = analysis.navigation().range(syntax.pack_signature_name()->token());
		if (range.source < mapping.size()) {
			var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[range.source]];
			var present = source.token_offsets.find(range.begin);
			if (present) {
				@(@source.tokens).data()[*present].type = 6;
			};
		};
	};
	if (syntax.kind() == syntax_kind::declaration_attribute) {
		SourceRange range = analysis.navigation().range(syntax.token());
		if (range.source < mapping.size()) {
			var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[range.source]];
			var present = source.token_offsets.find(range.begin);
			if (present) {
				@(@source.tokens).data()[*present].type = 19;
			};
		};
	};
	if (syntax.kind() == syntax_kind::attributes) {
		for (usize item = 0; item < syntax.size(); @item = item + 1) {
			SourceRange range = analysis.navigation().range(syntax.item(item)->token());
			if (range.source < mapping.size()) {
				var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[range.source]];
				var present = source.token_offsets.find(range.begin);
				if (present) {
					@(@source.tokens).data()[*present].type = 19;
				};
			};
		};
	};
	for (usize attribute = 0; attribute < syntax.declaration_attributes().size(); @attribute = attribute + 1) {
		@this.classify_syntax(analysis, mapping, *syntax.declaration_attributes().data()[attribute].get());
	};
	bool contextual = syntax.kind() == syntax_kind::type_auto || syntax.kind() == syntax_kind::access_label || syntax.kind() == syntax_kind::cast || syntax.kind() == syntax_kind::operator_name || syntax.kind() == syntax_kind::conversion_name || syntax.kind() == syntax_kind::null_pointer || syntax.kind() == syntax_kind::name && (syntax.token().is("true") || syntax.token().is("false"));
	if (contextual) {
		SourceRange range = analysis.navigation().range(syntax.token());
		if (range.source < mapping.size()) {
			var LanguageIndexedSource& source = @(@this.sources).data()[mapping.data()[range.source]];
			var present = source.token_offsets.find(range.begin);
			if (present) {
				@(@source.tokens).data()[*present].type = 13;
			};
		};
	};
	usize child = 0;
	while (child < syntax.size()) {
		@this.classify_syntax(analysis, mapping, *syntax.item(child));
		@child = child + 1;
	};
};

enum language_server_state : [u08] {
	uninitialized;
	running;
	shutdown;
	exited_clean;
	exited_unclean;
};

struct LanguageServer {
	fn LanguageServer(var LanguageServer& this, var LanguageProtocol& protocol, var LanguageWorkspace& workspace);
	fn run(var LanguageServer& this) -> i32;

private:
	fn dispatch(var LanguageServer& this, rt::json_value& message);
	fn send(var LanguageServer& this, rt::unique<rt::json_value> message);
	fn error(var LanguageServer& this, rt::json_value& id, i64 code, rt::string_view text);
	fn initialize(var LanguageServer& this, rt::json_value& id, rt::json_value& parameters);
	fn description() -> rt::json_document;

	var LanguageProtocol* protocol;
	var LanguageWorkspace* workspace;
	language_server_state state;
};

fn LanguageServer::LanguageServer(var LanguageServer& this, var LanguageProtocol& protocol, var LanguageWorkspace& workspace) {
	@this.protocol = &@protocol;
	@this.workspace = &@workspace;
};

fn LanguageServer::send(var LanguageServer& this, rt::unique<rt::json_value> message) {
	rt::string text;
	if (!message.get()) {
		compiler_panic("language server send invariant failed");
	};
	rt::json_write(*message.get(), @text);
	@this.protocol->send(text.view());
};

fn LanguageServer::error(var LanguageServer& this, rt::json_value& id, i64 code, rt::string_view text) {
	@this.send(LanguageJson::failure(id, $code, text));
};

fn LanguageServer::description() -> rt::json_document {
	return rt::json_parse("{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":{\"openClose\":true,\"change\":2,\"save\":{\"includeText\":false}},\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"declarationProvider\":true,\"referencesProvider\":true,\"hoverProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"function\",\"method\",\"keyword\",\"comment\",\"string\",\"number\",\"operator\",\"controlKeyword\",\"decorator\"],\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"static\",\"deprecated\",\"abstract\",\"async\",\"modification\",\"documentation\",\"defaultLibrary\"]},\"range\":true,\"full\":true},\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\",\">\",\"_\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}},\"serverInfo\":{\"name\":\"Rutile Language Server\"}}");
};

fn LanguageServer::initialize(var LanguageServer& this, rt::json_value& id, rt::json_value& parameters) {
	if (this.state != language_server_state::uninitialized) {
		@this.error(id, -32600, "language server is already initialized");
		return;
	};
	if (!(@this.workspace->configure(parameters)).has<void>()) {
		@this.error(id, -32602, "initialize requires a valid project file URI");
		return;
	};

	var description = LanguageServer::description();
	if (!description.has<rt::unique<rt::json_value>>()) {
		compiler_panic("language server initialize invariant failed");
	};
	rt::unique<rt::json_value> result = $description;
	rt::json_value* options = parameters.member("initializationOptions");
	rt::json_value* custom_colors = nullptr;
	if (options) {
		@custom_colors = options->member("rutileSemanticColors");
	};
	if (custom_colors && custom_colors->boolean()) {
		var filtered = rt::json_value::make_object();
		if (!filtered.get()) {
			compiler_panic("language server initialize invariant failed");
		};

		rt::json_value* capabilities = result.get()->member("capabilities");
		usize index = 0;
		while (index < capabilities->size()) {
			var key = capabilities->key(index);
			if (key != "semanticTokensProvider") {
				@filtered.get()->set(key, capabilities->member(key)->clone());
			};
			@index = index + 1;
		};
		@result.get()->set("capabilities", $filtered);
	};
	@this.state = language_server_state::running;
	@this.send(LanguageJson::response(id, $result));
};

fn LanguageServer::dispatch(var LanguageServer& this, rt::json_value& message) {
	if (this.state == language_server_state::running) {
		@this.workspace->refresh_sources();
	};
	var absent = rt::json_value::make_null();
	if (!absent.get()) {
		compiler_panic("language server dispatch invariant failed");
	};
	rt::json_value* supplied_id = message.member("id");
	rt::json_value* id = supplied_id;
	if (!id) {
		@id = absent.get();
	};
	var method = LanguageJson::text(message, "method");
	if (message.kind() != rt::json_kind::object || LanguageJson::text(message, "jsonrpc") != "2.0" || method.empty() || id->kind() != rt::json_kind::number && id->kind() != rt::json_kind::string && id->kind() != rt::json_kind::null_value) {
		@this.error(*absent.get(), -32600, "invalid JSON-RPC request");
		return;
	};
	var empty = rt::json_value::make_object();
	rt::json_value* parameters = message.member("params");
	if (!parameters) {
		@parameters = empty.get();
	};
	if (!parameters) {
		compiler_panic("language server dispatch invariant failed");
	};

	if (method == "exit") {
		if (this.state == language_server_state::shutdown) {
			@this.state = language_server_state::exited_clean;
		}
		else {
			@this.state = language_server_state::exited_unclean;
		};
		@this.workspace->cancel();
		return;
	};
	if (method == "$/cancelRequest") {
		// Indexed requests finish on this dispatch thread; obsolete analysis is
		// cancelled separately through its generation callback.
		return;
	};
	if (this.state == language_server_state::shutdown) {
		if (supplied_id) {
			@this.error(*id, -32600, "language server has shut down");
		};
		return;
	};
	if (method == "initialize") {
		@this.initialize(*id, *parameters);
		return;
	};
	if (this.state == language_server_state::uninitialized) {
		if (supplied_id) {
			@this.error(*id, -32002, "language server is not initialized");
		};
		return;
	};
	if (method == "shutdown") {
		@this.state = language_server_state::shutdown;
		@this.workspace->cancel();
		@this.send(LanguageJson::response(*id, rt::json_value::make_null()));
		return;
	};

	if (method == "textDocument/didOpen" || method == "textDocument/didChange" || method == "textDocument/didClose") {
		LanguageRequestResult accepted;
		if (method == "textDocument/didOpen") {
			@accepted = @this.workspace->open(*parameters);
		}
		else if (method == "textDocument/didChange") {
			@accepted = @this.workspace->change(*parameters);
		}
		else {
			@accepted = @this.workspace->close(*parameters);
		};
		if (accepted.has<language_request_error>() && supplied_id) {
			@this.error(*id, -32602, "invalid document update parameters or unavailable workspace storage");
			return;
		};
		return;
	};
	if (method == "textDocument/didSave" || method == "workspace/didChangeWatchedFiles") {
		@this.workspace->refresh();
		return;
	};
	if (method == "rutile/semanticTokensLegend") {
		var description = LanguageServer::description();
		if (!description.has<rt::unique<rt::json_value>>()) {
			compiler_panic("language server dispatch invariant failed");
		};
		rt::json_value* legend = description.get<rt::unique<rt::json_value>>().get()->member("capabilities")->member("semanticTokensProvider")->member("legend");
		@this.send(LanguageJson::response(*id, legend->clone()));
		return;
	};
	if (method == "rutile/indexStatus") {
		@this.send(LanguageJson::response(*id, @this.workspace->status()));
		return;
	};
	if (method == "rutile/templateContexts" || method == "rutile/selectTemplateContext" || method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/range" || method == "textDocument/typeDefinition" || method == "textDocument/completion" || method == "textDocument/signatureHelp" || method == "textDocument/definition" || method == "textDocument/declaration" || method == "textDocument/references" || method == "textDocument/hover" || method == "textDocument/documentSymbol" || method == "workspace/symbol") {
		var result = @this.workspace->query(method, *parameters);
		if (!result.get()) {
			@this.error(*id, -32602, "navigation requires a valid document URI and position");
			return;
		};
		@this.send(LanguageJson::response(*id, $result));
		var status = @this.workspace->status();
		if (status.get()) {
			rt::json_value* current = status.get()->member("generation");
			rt::json_value* indexed = status.get()->member("indexedGeneration");
			if (current && indexed && current->text() != indexed->text()) {
				@this.send(LanguageJson::notification("rutile/indexStatus", $status));
				return;
			};
		};
		return;
	};
	if (supplied_id) {
		@this.error(*id, -32601, "method is not implemented");
	};
};

fn LanguageServer::run(var LanguageServer& this) -> i32 {
	while (this.state != language_server_state::exited_clean && this.state != language_server_state::exited_unclean) {
		rt::string body;
		language_frame_status status = @this.protocol->read(@body);
		if (status == language_frame_status::end_of_stream) {
			break;
		};
		if (status == language_frame_status::error) {
			var id = rt::json_value::make_null();
			if (id.get()) {
				@this.error(*id.get(), -32700, this.protocol->error());
			};
			return 1;
		};

		var document = rt::json_parse(body.view());
		if (document.has<rt::allocation_error>()) {
			throw rt::allocation_error(document.get<rt::allocation_error>());
		};
		if (document.has<rt::json_error>()) {
			var id = rt::json_value::make_null();
			if (!id.get()) {
				return 1;
			}
			else {
				@this.error(*id.get(), -32700, document.get<rt::json_error>().message);
			};
			continue;
		};
		@this.dispatch(*document.get<rt::unique<rt::json_value>>().get());
	};
	@this.workspace->cancel();
	if (this.state == language_server_state::shutdown || this.state == language_server_state::exited_clean) {
		return 0;
	};
	return 1;
};

fn "C" rutile_language_server_main(var Compiler* compiler, var NativeFile* input, var NativeFile* output, char* root) -> i32 {
	try {
		if (!compiler || !input || !output || !root) {
			return 1;
		};
		var protocol = rt::unique<LanguageProtocol>(new LanguageProtocol(@*input, @*output));
		if (!protocol.get()) {
			rt::allocation_error error;
			@error.requested_bytes = sizeof(LanguageProtocol);
			throw $error;
		};
		if (!protocol.get()->ready()) {
			compiler_panic("language protocol synchronization could not be initialized");
		};
		var workspace = rt::unique<LanguageWorkspace>(new LanguageWorkspace(@*compiler, @*protocol.get(), rt::from_c_string(root)));
		if (!workspace.get()) {
			rt::allocation_error error;
			@error.requested_bytes = sizeof(LanguageWorkspace);
			throw $error;
		};
		if (!workspace.get()->ready()) {
			compiler_panic("language workspace worker could not be initialized");
		};
		var server = LanguageServer(@*protocol.get(), @*workspace.get());
		return @server.run();
	}
	catch (rt::allocation_error& error) {
		return 2;
	}
	catch (rt::json_error& error) {
		return 1;
	}
	catch (compiler_internal_error& error) {
		discard fprintf(platform_standard_error(), "Language server internal failure: %s\n\0".data(), error.message.c_str());
		return 2;
	}
	catch (language_transport_error& error) {
		discard fprintf(platform_standard_error(), "Language server transport failure: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
		return 1;
	};
};

fn kiln_emit_target(var Compiler* compiler, char* root, char* name, var char* output, var char* entry, i32 optimization, var NativeFile* diagnostics) -> CompilationResult {
	if (!compiler || !root || !name) {
		var errors = Diagnostics(diagnostics);
		Token location;
		@errors.error(location, "compiler, workspace root, and target name are required for native emission");
		return compilation_error();
	};
	LanguageGroup group;
	@group.kind = language_group_kind::target;
	rt::string key;
	@group.name.append(rt::from_c_string(name));
	LanguageWorkspace::target_key(rt::from_c_string(root), group, @key);
	rt::string_view entry_name = "main";
	if (entry) {
		@entry_name = rt::from_c_string(entry);
	};
	return @compiler->emit_target(key.view(), rt::from_c_string(output), entry_name, $optimization, $diagnostics, output_kind::executable);
};

using TargetSourceCallback = ((var void*, char*, char*, usize) -> void)*;

fn kiln_target_sources(var Compiler* compiler, char* root, char* name, TargetSourceCallback callback, var void* context, var NativeFile* diagnostics) -> i32 {
	if (!compiler || !root || !name || !callback) {
		return 1;
	};
	LanguageGroup group;
	@group.kind = language_group_kind::target;
	rt::string key;
	@group.name.append(rt::from_c_string(name));
	LanguageWorkspace::target_key(rt::from_c_string(root), group, @key);
	var lease = @compiler->acquire_current_target(key.view());
	if (!lease.get()) {
		var errors = Diagnostics(diagnostics);
		Token location;
		@errors.error(location, "no current target analysis is available for native emission");
		return 1;
	};
	if (lease.value().diagnostics().failed()) {
		lease.value().diagnostics().replay(diagnostics);
		return 1;
	};
	usize index = 0;
	while (index < lease.value().source_count()) {
		var path = rt::string(lease.value().source_path(index));
		rt::string_view text = lease.value().source_text(index);
		callback(context, path.c_str(), text.data(), text.size());
		@index = index + 1;
	};
	return 0;
};

fn LanguageIndex::append_templates(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping) {
	if (!analysis.semantics()) {
		return;
	};
	usize index = 0;
	while (index < analysis.semantics()->entities().size()) {
		Entity& entity = *analysis.semantics()->entities().data()[index].get();
		@index = index + 1;
		var Syntax* wrapper = entity.declaration();
		if (entity.kind() != entity_kind::template_pattern || !wrapper || wrapper->kind() != syntax_kind::template_declaration) {
			continue;
		};
		LanguageTemplate item;
		@item.range = analysis.navigation().syntax_range(*wrapper);
		@item.anchor = analysis.navigation().range(entity.token());
		if (item.range.source >= mapping.size() || item.anchor.source >= mapping.size()) {
			continue;
		};
		@item.range.source = mapping.data()[item.range.source];
		@item.anchor.source = mapping.data()[item.anchor.source];
		@item.name = rt::string(entity.name());
		usize parameter = 0;
		while (parameter < wrapper->template_parameters()->size()) {
			var Syntax* name = wrapper->template_parameters()->item(parameter)->item(1);
			@item.parameters.push_back(rt::string(name->token().text()));
			@parameter = parameter + 1;
		};
		@this.templates.push_back($item);
	};
};

fn LanguageIndex::template_owner(LanguageIndex& this, u64 context) -> u64 {
	usize remaining = this.symbols.size();
	while (context && remaining) {
		var found = this.symbol_ids.find(context);
		if (!found) {
			return 0;
		};
		NavigationSymbol& symbol = this.symbols.data()[*found].value;
		if (symbol.origin) {
			return context;
		};
		@context = symbol.container;
		@remaining = remaining - 1;
	};
	return 0;
};

fn LanguageWorkspace::template_context(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> u64 {
	usize source = 0;
	usize offset = 0;
	if (!(@this.cursor(index, parameters, @source, @offset)).has<void>()) {
		return 0;
	};
	return @this.template_context(index, source, offset);
};

fn LanguageWorkspace::template_context(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize offset) -> u64 {
	var LanguageDocument* document = @this.document_key(index.sources.data()[source].key.view());
	if (!document) {
		return 0;
	};
	rt::string_view selected = document->template_context.view();
	usize result = 0;
	while (result < index.template_results.size()) {
		LanguageTemplateResult& context = index.template_results.data()[result];
		if (context.key.view() == document->key.view() && context.arguments.view() == document->template_arguments.view() && document->template_anchor.has_value() && context.anchor == document->template_anchor.value()) {
			@selected = context.label.view();
			break;
		};
		@result = result + 1;
	};
	if (selected.empty()) {
		return 0;
	};

	usize region = 0;
	while (region < index.scopes.size()) {
		NavigationScope& scope = index.scopes.data()[region];
		@region = region + 1;
		if (scope.range.source != source || offset < scope.range.begin || offset > scope.range.end || !scope.context) {
			continue;
		};
		u64 context = index.template_owner(u64(scope.context));
		var symbol = index.symbol_ids.find(context);
		if (symbol) {
			rt::string_view detail = index.symbols.data()[*symbol].detail.view();
			if (detail == selected || detail.size() > selected.size() && detail.slice(0, selected.size()) == selected && detail.data()[selected.size()] == ':') {
				return context;
			};
		};
	};
	return 0;
};

fn LanguageWorkspace::template_contexts(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool select) -> rt::unique<rt::json_value> {
	var result = rt::json_value::make_object();
	var items = rt::json_value::make_array();
	usize source = 0;
	usize offset = 0;
	if (!result.get() || !items.get() || !(@this.cursor(index, parameters, @source, @offset)).has<void>()) {
		return rt::json_value::make_null();
	};
	var LanguageDocument* document = @this.document_key(index.sources.data()[source].key.view());
	if (!document) {
		return rt::json_value::make_null();
	};

	LanguageTemplate* declaration = nullptr;
	usize descriptor = 0;
	while (descriptor < index.templates.size()) {
		LanguageTemplate& candidate = index.templates.data()[descriptor];
		if (candidate.range.source == source && candidate.range.begin <= offset && offset <= candidate.range.end && (!declaration || candidate.range.end - candidate.range.begin < declaration->range.end - declaration->range.begin)) {
			@declaration = &candidate;
		};
		@descriptor = descriptor + 1;
	};
	if (select && parameters.member("arguments") && declaration) {
		usize other = 0;
		while (other < this.documents.size()) {
			var LanguageDocument& previous = @*(@this.documents).data()[other].get();
			@previous.template_anchor.reset();
			@previous.template_arguments.clear();
			@other = other + 1;
		};
		@document->template_anchor = rt::optional<usize>(usize(declaration->anchor.begin));
		@document->template_arguments = rt::string(LanguageJson::text(parameters, "arguments"));
		@document->template_context.clear();
		@this.schedule();
	};
	if (declaration) {
		var description = rt::json_value::make_object();
		var names = rt::json_value::make_array();
		usize parameter = 0;
		while (parameter < declaration->parameters.size()) {
			@names.get()->append(rt::json_value::make_string(declaration->parameters.data()[parameter].view()));
			@parameter = parameter + 1;
		};
		@description.get()->set("name", rt::json_value::make_string(declaration->name.view()));
		@description.get()->set("parameters", $names);
		@description.get()->set("range", LanguageJson::range(index.sources.data()[source].text, usize(declaration->range.begin), usize(declaration->range.end)));
		@result.get()->set("template", $description);
	};
	bool selected_declaration = declaration && document->template_anchor.has_value() && declaration->anchor.begin == document->template_anchor.value();
	rt::string_view selected_arguments;
	if (selected_declaration) {
		@selected_arguments = document->template_arguments.view();
	};
	@result.get()->set("arguments", rt::json_value::make_string(selected_arguments));
	usize status = 0;
	while (status < index.template_results.size()) {
		LanguageTemplateResult& context = index.template_results.data()[status];
		if (selected_declaration && context.key.view() == document->key.view() && context.arguments.view() == document->template_arguments.view() && context.anchor == document->template_anchor.value()) {
			@result.get()->set("error", rt::json_value::make_string(context.error.view()));
			@result.get()->set("label", rt::json_value::make_string(context.label.view()));
			break;
		};
		@status = status + 1;
	};
	usize width = usize::max;
	usize region = 0;
	while (region < index.scopes.size()) {
		NavigationScope& scope = index.scopes.data()[region];
		@region = region + 1;
		if (scope.range.source == source && scope.range.begin <= offset && offset <= scope.range.end && index.template_owner(u64(scope.context)) && scope.range.end - scope.range.begin < width) {
			@width = scope.range.end - scope.range.begin;
		};
	};
	rt::unordered_map<u64, bool> seen;
	var requested = LanguageJson::text(parameters, "context");
	bool accepted = requested.empty();
	@region = 0;
	while (region < index.scopes.size()) {
		NavigationScope& scope = index.scopes.data()[region];
		@region = region + 1;
		u64 context = index.template_owner(u64(scope.context));
		if (scope.range.source != source || offset < scope.range.begin || offset > scope.range.end || scope.range.end - scope.range.begin != width || !context || seen.find(context)) {
			continue;
		};
		var found = index.symbol_ids.find(context);
		if (!found || !index.symbols.data()[*found].value.origin) {
			continue;
		};
		LanguageIndexedSymbol& symbol = index.symbols.data()[*found];
		var item = rt::json_value::make_object();
		if (!@seen.insert(u64(context), true)) {
			return rt::unique<rt::json_value>();
		};
		if (!item.get()) {
			return rt::unique<rt::json_value>();
		};
		@item.get()->set("key", rt::json_value::make_string(symbol.detail.view()));
		@item.get()->set("label", rt::json_value::make_string(symbol.detail.view()));
		@items.get()->append($item);
		if (symbol.detail.view() == requested) {
			@accepted = true;
		};
	};
	if (select && accepted && !parameters.member("arguments")) {
		bool typed_context = document->template_anchor.has_value();
		@document->template_anchor.reset();
		@document->template_arguments.clear();
		@document->template_context = rt::string(requested);
		if (typed_context) {
			@this.schedule();
		};
	};
	@result.get()->set("items", $items);
	@result.get()->set("selected", rt::json_value::make_string(document->template_context.view()));
	return $result;
};

fn LanguageWorkspace::hover(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, rt::buffer<u64>& bindings) -> rt::unique<rt::json_value> {
	if (!bindings.size()) {
		return rt::json_value::make_null();
	};
	var found = index.symbol_ids.find(bindings.data()[0]);
	if (!found) {
		return rt::json_value::make_null();
	};
	LanguageIndexedSymbol& symbol = index.symbols.data()[*found];
	rt::string text;
	if (bindings.size() > 1 && !@this.template_context(index, parameters) && symbol.value.declaration.source < index.sources.size()) {
		var source = index.sources.data()[symbol.value.declaration.source].text.view();
		usize begin = symbol.value.declaration.begin;
		usize end = symbol.value.declaration.end;
		while (begin && source.data()[begin - 1] != '\n' && source.data()[begin - 1] != '\r') {
			@begin = begin - 1;
		};
		while (begin < end && (source.data()[begin] == '\t' || source.data()[begin] == ' ')) {
			@begin = begin + 1;
		};
		while (end < source.size() && source.data()[end] != '\n' && source.data()[end] != '\r' && end - begin < 240) {
			@end = end + 1;
		};
		@text.append(rt::string_view(source.data() + begin, end - begin));
		var contexts = @this.template_contexts(index, parameters, false);
		if (contexts.get() && contexts.get()->member("items") && contexts.get()->member("items")->size()) {
			@text.append("\nSelect a template context above the editor.");
		};
	}
	else if (!symbol.detail.empty()) {
		@text.append(symbol.detail.view());
	}
	else {
		@text.append(symbol.name.view());
	};

	var content = rt::json_value::make_object();
	var result = rt::json_value::make_object();
	if (!content.get()) {
		return rt::unique<rt::json_value>();
	};
	if (!result.get()) {
		return rt::unique<rt::json_value>();
	};
	@content.get()->set("kind", rt::json_value::make_string("plaintext"));
	@content.get()->set("value", rt::json_value::make_string(text.view()));
	@result.get()->set("contents", $content);
	return $result;
};

struct LanguagePosition {
	fn LanguagePosition(var LanguagePosition& this, usize line, usize character);
	fn LanguagePosition(var LanguagePosition& this, LanguagePosition& other) : [implicit, default];
	usize line;
	usize character;
};

struct LanguageText {
	fn assign(var LanguageText& this, rt::string_view text);
	fn view(LanguageText& this) -> rt::string_view;
	fn offset(LanguageText& this, usize line, usize character) -> usize;
	fn position(LanguageText& this, usize offset) -> LanguagePosition;
	fn width(rt::string_view text, usize offset) -> usize;

private:
	rt::string text;
	rt::buffer<usize> lines;
};

struct LanguageUri {
	fn decode(rt::string_view uri, var rt::string& path) -> LanguageRequestResult;
	fn encode(rt::string_view path, var rt::string& uri);
	fn key(rt::string_view path, var rt::string& result);

private:
	fn hexadecimal(char value) -> i32;
};

fn LanguagePosition::LanguagePosition(var LanguagePosition& this, usize line, usize character) {
	@this.line = $line;
	@this.character = $character;
};

fn LanguageText::assign(var LanguageText& this, rt::string_view text) {
	rt::string contents;
	rt::buffer<usize> offsets;
	@contents.append(text);
	@offsets.push_back(0);

	usize index = 0;
	while (index < text.size()) {
		if (text.data()[index] == '\n') {
			@offsets.push_back(index + 1);
		};
		@index = index + 1;
	};

	@this.text = $contents;
	@this.lines = $offsets;
};

fn LanguageText::view(LanguageText& this) -> rt::string_view {
	return this.text.view();
};

fn LanguageText::width(rt::string_view text, usize offset) -> usize {
	u08 first = static_cast<u08>(text.data()[offset]);
	usize width = 1;
	if (first >= 194 && first <= 223) {
		@width = 2;
	}
	else if (first >= 224 && first <= 239) {
		@width = 3;
	}
	else if (first >= 240 && first <= 244) {
		@width = 4;
	};
	if (width > text.size() - offset) {
		return 1;
	};

	usize index = 1;
	while (index < width) {
		if ((static_cast<u08>(text.data()[offset + index]) & 192) != 128) {
			return 1;
		};
		@index = index + 1;
	};
	return $width;
};

fn LanguageText::offset(LanguageText& this, usize line, usize character) -> usize {
	if (line >= this.lines.size()) {
		return this.text.size();
	};

	usize offset = this.lines.data()[line];
	usize units = 0;
	while (offset < this.text.size() && this.text.data()[offset] != '\r' && this.text.data()[offset] != '\n') {
		usize width = LanguageText::width(this.text.view(), usize(offset));
		usize count = 1;
		if (width == 4) {
			@count = 2;
		};
		if (units + count > character) {
			break;
		};
		@units = units + count;
		@offset = offset + width;
	};
	return $offset;
};

fn LanguageText::position(LanguageText& this, usize offset) -> LanguagePosition {
	if (offset > this.text.size()) {
		@offset = this.text.size();
	};
	if (!this.lines.size()) {
		return LanguagePosition(0, 0);
	};

	usize first = 0;
	usize last = this.lines.size();
	while (first + 1 < last) {
		usize middle = first + (last - first) / 2;
		if (this.lines.data()[middle] <= offset) {
			@first = $middle;
		}
		else {
			@last = $middle;
		};
	};

	usize cursor = this.lines.data()[first];
	usize units = 0;
	while (cursor < offset) {
		usize width = LanguageText::width(this.text.view(), usize(cursor));
		if (cursor + width > offset) {
			break;
		};
		if (width == 4) {
			@units = units + 2;
		}
		else {
			@units = units + 1;
		};
		@cursor = cursor + width;
	};
	return LanguagePosition($first, $units);
};

fn LanguageUri::hexadecimal(char value) -> i32 {
	if (value >= '0' && value <= '9') {
		return static_cast<i32>(value) - 48;
	};
	if (value >= 'a' && value <= 'f') {
		return static_cast<i32>(value) - 87;
	};
	if (value >= 'A' && value <= 'F') {
		return static_cast<i32>(value) - 55;
	};
	return -1;
};

fn LanguageUri::decode(rt::string_view uri, var rt::string& path) -> LanguageRequestResult {
	if (uri.size() < 7 || rt::string_view(uri.data(), 7) != "file://") {
		return language_request_error();
	};

	rt::string result;
	usize cursor = 7;
	if (uri.size() >= 17 && rt::string_view(uri.data() + 7, 10) == "localhost/") {
		@cursor = 16;
	};
	if (cursor < uri.size() && uri.data()[cursor] != '/') {
		@result.append("//");
	};
	if (cursor + 2 < uri.size() && uri.data()[cursor] == '/' && uri.data()[cursor + 2] == ':') {
		@cursor = cursor + 1;
	};

	while (cursor < uri.size()) {
		char byte = uri.data()[cursor];
		if (byte == '%') {
			if (cursor + 2 >= uri.size()) {
				return language_request_error();
			};
			i32 high = LanguageUri::hexadecimal(uri.data()[cursor + 1]);
			i32 low = LanguageUri::hexadecimal(uri.data()[cursor + 2]);
			if (high < 0 || low < 0 || !(high * 16 + low)) {
				return language_request_error();
			};
			@byte = static_cast<char>(high * 16 + low);
			@cursor = cursor + 2;
		};
		@result.append(rt::string_view(&@byte, 1));
		@cursor = cursor + 1;
	};
	@path = $result;
};

fn LanguageUri::encode(rt::string_view path, var rt::string& uri) {
	rt::string result;
	var prefix = "file:///";
	if (path.size() >= 2 && (path.data()[0] == '/' || path.data()[0] == '\\') && (path.data()[1] == '/' || path.data()[1] == '\\')) {
		@prefix = "file:";
	}
	else if (path.size() && path.data()[0] == '/') {
		@prefix = "file://";
	};
	@result.append(prefix);

	var digits = "0123456789ABCDEF";
	usize cursor = 0;
	while (cursor < path.size()) {
		char byte = path.data()[cursor];
		if (byte == '\\') {
			@byte = '/';
		};
		if ((byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '/' || byte == ':' || byte == '-' || byte == '_' || byte == '.' || byte == '~') {
			@result.append(rt::string_view(&@byte, 1));
		}
		else {
			u08 value = static_cast<u08>(byte);
			char[3] encoded;
			@encoded[0] = '%';
			@encoded[1] = digits.data()[static_cast<usize>(value >> 4)];
			@encoded[2] = digits.data()[static_cast<usize>(value & 15)];
			@result.append(rt::string_view(&@encoded[0], 3));
		};
		@cursor = cursor + 1;
	};
	@uri = $result;
};

fn LanguageUri::key(rt::string_view path, var rt::string& result) {
	rt::string key;
	usize index = 0;
	while (index < path.size()) {
		char byte = path.data()[index];
		if (byte == '\\') {
			@byte = '/';
		};
		if (byte >= 'A' && byte <= 'Z') {
			@byte = static_cast<char>(static_cast<i32>(byte) + 32);
		};
		@key.append(rt::string_view(&@byte, 1));
		@index = index + 1;
	};
	@result = $key;
};

fn rutile_editor_source_update(char* path, char* text, usize size);
fn rutile_editor_sources_clear();

struct RuntimeCondition;
struct RuntimeThread;
struct RuntimeAtomic;

fn runtime_condition_create() -> var RuntimeCondition*;
fn runtime_condition_destroy(var RuntimeCondition* condition);
fn runtime_condition_wait(var RuntimeCondition* condition, var RuntimeMutex* mutex, u32 milliseconds) -> i32;
fn runtime_condition_notify(var RuntimeCondition* condition);
fn runtime_thread_start(((var void*) -> i32)* callback, var void* context) -> var RuntimeThread*;
fn runtime_thread_join(var RuntimeThread* thread);
fn runtime_atomic_create(u64 value) -> var RuntimeAtomic*;
fn runtime_atomic_destroy(var RuntimeAtomic* value);
fn runtime_atomic_load(RuntimeAtomic* value) -> u64;
fn runtime_atomic_store(var RuntimeAtomic* destination, u64 value);
fn runtime_atomic_fetch_add(var RuntimeAtomic* destination, u64 value) -> u64;
fn runtime_clock_nanoseconds() -> u64;
fn kiln_project_sources(char* root, ((var void*, char*, char*, i32) -> i32)* add, var void* context, ((var void*, char*) -> void)* diagnostic) -> i32;
fn kiln_project_sources_revision() -> u64;

struct LanguageEdit {
	u64 revision;
	usize begin;
	usize end;
	usize inserted;
};

struct LanguageDocument {
	rt::string uri;
	rt::string path;
	rt::string key;
	LanguageText text;
	i64 version;
	u64 revision;
	u64 opened_revision;
	rt::buffer<LanguageEdit> edits;
	rt::string template_context;
	rt::optional<usize> template_anchor;
	rt::string template_arguments;
};

enum language_group_kind : [u08] {
	target;
	test_target;
	loose;
	analysis;
	standard;
};

struct LanguageGroup {
	language_group_kind kind;
	rt::string name;
	rt::buffer<rt::string> paths;
};

struct LanguageJob {
	u64 generation;
	u64 configuration;
	rt::string root;
	rt::buffer<LanguageDocument> documents;
};

struct LanguageSemanticToken {
	SourceRange range;
	u32 type;
	u32 modifiers;
};

struct LanguageIndexedSource {
	rt::string uri;
	rt::string key;
	LanguageText text;
	rt::optional<i64> version;
	u64 revision;
	rt::unique<rt::json_value> diagnostics;
	rt::buffer<LanguageSemanticToken> tokens;
	rt::unordered_map<usize, usize> token_offsets;
};

struct LanguageIndexedParameter {
	rt::string name;
	rt::string detail;
};

struct LanguageIndexedSymbol {
	NavigationSymbol value;
	u32 semantic_type;
	u64 type_symbol;
	rt::buffer<LanguageIndexedParameter> parameters;
	rt::string name;
	rt::string detail;
};

struct LanguageTemplate {
	SourceRange range;
	SourceRange anchor;
	rt::string name;
	rt::buffer<rt::string> parameters;
};

struct LanguageTemplateResult {
	rt::string key;
	usize anchor;
	rt::string arguments;
	rt::string label;
	rt::string error;
};

struct LanguageIndex {
	fn source(var LanguageIndex& this, Analysis& analysis, usize source, LanguageJob& job) -> usize;
	fn append(var LanguageIndex& this, Analysis& analysis, LanguageJob& job);
	fn finish(var LanguageIndex& this);
	fn append_templates(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping);
	fn classify_source(var LanguageIndex& this, Analysis& analysis, usize original, usize target);
	fn classify_syntax(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping, Syntax& syntax);
	fn classify_bindings(var LanguageIndex& this, Analysis& analysis, rt::buffer<usize>& mapping);
	fn identity(LanguageIndex& this, u64 id) -> u64;
	fn template_owner(LanguageIndex& this, u64 context) -> u64;
	fn before(NavigationOccurrence& first, NavigationOccurrence& second) -> bool;

	u64 generation;
	u64 build_nanoseconds;
	bool semantic_failed;
	u64 symbol_base;
	u64 scope_base;
	rt::buffer<NavigationScope> scopes;
	rt::unordered_map<u64, usize> scope_ids;
	rt::unordered_map<u64, rt::buffer<usize>> scope_members;
	rt::buffer<NavigationBinding> scope_bindings;
	rt::buffer<NavigationCall> calls;
	rt::buffer<NavigationReceiver> receivers;
	rt::buffer<LanguageIndexedSource> sources;
	rt::unordered_map<rt::string, usize> source_ids;
	rt::buffer<LanguageIndexedSymbol> symbols;
	rt::unordered_map<u64, usize> symbol_ids;
	rt::buffer<NavigationOccurrence> occurrences;
	rt::unordered_map<u64, rt::buffer<usize>> references;
	rt::unique<rt::json_value> diagnostics;
	rt::buffer<rt::string> targets;
	rt::buffer<LanguageTemplate> templates;
	rt::buffer<LanguageTemplateResult> template_results;
	rt::unique<LanguageIndex> retired_next;
};

struct LanguageCancellation {
	var RuntimeAtomic* generation;
	var RuntimeAtomic* stopped;
	u64 expected;
};

struct LanguageWorkspace {
	fn LanguageWorkspace(var LanguageWorkspace& this, var Compiler& compiler, var LanguageProtocol& protocol, rt::string_view root);
	fn LanguageWorkspace(var LanguageWorkspace& this, LanguageWorkspace& other) : [delete];
	fn LanguageWorkspace(var LanguageWorkspace& this, LanguageWorkspace other) : [delete];
	fn ~LanguageWorkspace(var LanguageWorkspace& this);
	fn ready(LanguageWorkspace& this) -> bool;
	fn configure(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn open(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn change(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn close(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult;
	fn refresh(var LanguageWorkspace& this);
	fn refresh_sources(var LanguageWorkspace& this);
	fn cancel(var LanguageWorkspace& this);
	fn query(var LanguageWorkspace& this, rt::string_view method, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn status(var LanguageWorkspace& this) -> rt::unique<rt::json_value>;

	fn target_key(rt::string_view root, LanguageGroup& group, var rt::string& key);

private:
	fn schedule(var LanguageWorkspace& this);
	fn run(var LanguageWorkspace& this) -> i32;
	fn report_failure(var LanguageWorkspace& this, LanguageJob& job, rt::string_view message);
	fn analyze(var LanguageWorkspace& this, var LanguageJob& job) -> rt::unique<LanguageIndex>;
	fn analyze_group(var LanguageWorkspace& this, var LanguageGroup& group, var LanguageJob& job, var LanguageIndex& index) -> CompilationResult;
	fn receive(var LanguageWorkspace& this);
	fn retire(var LanguageWorkspace& this, rt::unique<LanguageIndex> index);
	fn collect_retired(var LanguageWorkspace& this);
	fn document(var LanguageWorkspace& this, rt::string_view uri) -> var LanguageDocument*;
	fn document_key(var LanguageWorkspace& this, rt::string_view key) -> var LanguageDocument*;
	fn cursor(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var usize& source, var usize& offset) -> LanguageRequestResult;
	fn completion(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn completion_visible(var LanguageWorkspace& this, LanguageIndex& index, NavigationSymbol& symbol) -> bool;
	fn tokens(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool ranged) -> rt::unique<rt::json_value>;
	fn overlay_token(var LanguageWorkspace& this, LanguageIndex& index, rt::string_view key, SourceRange& current, LanguageText& text, var u32& type, var u32& modifiers) -> bool;
	fn signature_item(LanguageIndex& index, NavigationCall& call, u64 identity, usize offset) -> rt::unique<rt::json_value>;
	fn signature(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> rt::unique<rt::json_value>;
	fn mapped(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& input, var SourceRange& output) -> bool;
	fn old_offset(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize current, var usize& original) -> bool;
	fn location(var LanguageWorkspace& this, LanguageIndex& index, SourceRange& range) -> rt::unique<rt::json_value>;
	fn bindings(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, var rt::buffer<u64>& result) -> LanguageRequestResult;
	fn template_contexts(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, bool select) -> rt::unique<rt::json_value>;
	fn template_context(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters) -> u64;
	fn template_context(var LanguageWorkspace& this, LanguageIndex& index, usize source, usize offset) -> u64;
	fn hover(var LanguageWorkspace& this, LanguageIndex& index, rt::json_value& parameters, rt::buffer<u64>& bindings) -> rt::unique<rt::json_value>;
	fn notify(var LanguageWorkspace& this, rt::string_view method, rt::unique<rt::json_value> parameters);
	fn measured(var LanguageWorkspace& this, rt::unique<rt::json_value> result, u64 started) -> rt::unique<rt::json_value>;
	fn contains(rt::string_view text, rt::string_view part) -> bool;
	fn append_location(var rt::json_value& result, rt::unique<rt::json_value> location, var rt::unordered_map<rt::string, bool>& seen);
	fn add_project(var void* context, char* group, char* path, i32 kind) -> i32;
	fn project_error(var void* context, char* text);
	fn worker(var void* context) -> i32;
	fn cancelled(var void* context) -> i32;

	var Compiler* compiler;
	var LanguageProtocol* protocol;
	var RuntimeMutex* jobs_mutex;
	var RuntimeMutex* publication_mutex;
	var RuntimeCondition* wake;
	var RuntimeThread* thread;
	var RuntimeAtomic* generation;
	var RuntimeAtomic* stopped;
	var RuntimeAtomic* analysis_phase;
	var RuntimeAtomic* phase_started;
	rt::string root;
	u64 configuration;
	u64 cached_configuration;
	u64 sources_revision;
	u64 revision;
	u64 minimum_semantic_generation;
	u64 queries;
	u64 query_nanoseconds;
	rt::buffer<rt::unique<LanguageDocument>> documents;
	rt::unordered_map<rt::string_view, var LanguageDocument*> document_names;
	rt::buffer<LanguageGroup> groups;
	rt::buffer<rt::string> known_targets;
	rt::string discovery_error;
	rt::unique<LanguageJob> pending;
	rt::unique<LanguageIndex> published;
	rt::unique<LanguageIndex> highlight_fallback;
	rt::unique<LanguageIndex> incoming;
	rt::unique<LanguageIndex> retired;
};

fn LanguageWorkspace::LanguageWorkspace(var LanguageWorkspace& this, var Compiler& compiler, var LanguageProtocol& protocol, rt::string_view root) {
	@this.compiler = &@compiler;
	@this.protocol = &@protocol;
	@this.root = rt::string(root);
	@this.configuration = 1;
	@this.sources_revision = kiln_project_sources_revision();
	@this.jobs_mutex = runtime_mutex_create();
	@this.publication_mutex = runtime_mutex_create();
	@this.wake = runtime_condition_create();
	@this.generation = runtime_atomic_create(0);
	@this.analysis_phase = runtime_atomic_create(0);
	@this.phase_started = runtime_atomic_create(0);
	@this.stopped = runtime_atomic_create(0);
	if (this.jobs_mutex && this.publication_mutex && this.wake && this.generation && this.stopped && this.analysis_phase && this.phase_started) {
		@this.thread = runtime_thread_start(&LanguageWorkspace::worker, &@this);
	};
};

fn LanguageWorkspace::~LanguageWorkspace(var LanguageWorkspace& this) {
	rutile_editor_sources_clear();
	@this.cancel();
	if (this.thread) {
		runtime_thread_join(this.thread);
	};
	if (this.publication_mutex) {
		@this.collect_retired();
	};
	if (this.wake) {
		runtime_condition_destroy(this.wake);
	};
	if (this.jobs_mutex) {
		runtime_mutex_destroy(this.jobs_mutex);
	};
	if (this.publication_mutex) {
		runtime_mutex_destroy(this.publication_mutex);
	};
	if (this.analysis_phase) {
		runtime_atomic_destroy(this.analysis_phase);
	};
	if (this.phase_started) {
		runtime_atomic_destroy(this.phase_started);
	};
	if (this.generation) {
		runtime_atomic_destroy(this.generation);
	};
	if (this.stopped) {
		runtime_atomic_destroy(this.stopped);
	};
};

fn LanguageWorkspace::ready(LanguageWorkspace& this) -> bool {
	return this.thread != nullptr;
};

fn LanguageWorkspace::cancel(var LanguageWorkspace& this) {
	if (this.stopped) {
		runtime_atomic_store(this.stopped, 1);
	};
	if (this.generation) {
		discard runtime_atomic_fetch_add(this.generation, 1);
	};
	if (this.wake) {
		runtime_condition_notify(this.wake);
	};
};

fn LanguageWorkspace::worker(var void* context) -> i32 {
	var LanguageWorkspace& workspace = @*reinterpret_cast<var LanguageWorkspace*>(context);
	try {
		return @workspace.run();
	}
	catch (rt::allocation_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker stopped because allocation failed.\n\0".data());
		return 2;
	}
	catch (rt::json_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker stopped because JSON processing failed.\n\0".data());
		return 1;
	}
	catch (compiler_internal_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker internal failure: %s\n\0".data(), error.message.c_str());
		return 2;
	}
	catch (language_transport_error& error) {
		runtime_atomic_store(workspace.analysis_phase, 5);
		discard fprintf(platform_standard_error(), "Language worker transport failure: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
		return 1;
	};
};

fn LanguageWorkspace::cancelled(var void* context) -> i32 {
	var LanguageCancellation* cancellation = reinterpret_cast<var LanguageCancellation*>(context);
	return static_cast<i32>(runtime_atomic_load(cancellation->stopped) || runtime_atomic_load(cancellation->generation) != cancellation->expected);
};

fn LanguageWorkspace::run(var LanguageWorkspace& this) -> i32 {
	while (true) {
		@this.collect_retired();
		runtime_mutex_lock(this.jobs_mutex);
		while (!this.pending.get() && !runtime_atomic_load(this.stopped)) {
			discard runtime_condition_wait(this.wake, this.jobs_mutex, 100);
			runtime_mutex_unlock(this.jobs_mutex);
			@this.collect_retired();
			runtime_mutex_lock(this.jobs_mutex);
		};
		if (runtime_atomic_load(this.stopped)) {
			runtime_mutex_unlock(this.jobs_mutex);
			return 0;
		};
		var job = rt::unique<LanguageJob>(@this.pending.release());
		runtime_mutex_unlock(this.jobs_mutex);

		try {
			var index = @this.analyze(@*job.get());
			if (!index.get() && !runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
				runtime_atomic_store(this.analysis_phase, 5);
			};
			if (!index.get() || runtime_atomic_load(this.stopped) || runtime_atomic_load(this.generation) != job.get()->generation) {
				continue;
			};

			if (index.get()->diagnostics.get()) {
				usize item = 0;
				while (item < index.get()->diagnostics.get()->size() && !runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
					@this.notify("textDocument/publishDiagnostics", index.get()->diagnostics.get()->item(item)->clone());
					@item = item + 1;
				};
			};

			rt::unique<LanguageIndex> obsolete;
			runtime_mutex_lock(this.publication_mutex);
			@obsolete = rt::unique<LanguageIndex>(@this.incoming.release());
			runtime_atomic_store(this.analysis_phase, 0);
			@this.incoming = $index;
			runtime_mutex_unlock(this.publication_mutex);
			if (!runtime_atomic_load(this.stopped) && runtime_atomic_load(this.generation) == job.get()->generation) {
				var parameters = rt::json_value::make_object();
				if (parameters.get()) {
					@parameters.get()->set("generation", rt::json_value::make_unsigned(u64(job.get()->generation)));
					@this.notify("rutile/semanticTokensChanged", $parameters);
				};
			};
		}
		catch (rt::allocation_error& error) {
			@this.report_failure(*job.get(), "Language analysis failed: allocation could not be satisfied.");
		}
		catch (rt::json_error& error) {
			@this.report_failure(*job.get(), error.message);
		}
		catch (compiler_internal_error& error) {
			@this.report_failure(*job.get(), error.message.view());
		};
	};
};

fn LanguageWorkspace::report_failure(var LanguageWorkspace& this, LanguageJob& job, rt::string_view message) {
	if (runtime_atomic_load(this.stopped) || runtime_atomic_load(this.generation) != job.generation) {
		return;
	};
	runtime_atomic_store(this.analysis_phase, 5);
	try {
		var diagnostic = rt::json_value::make_object();
		@diagnostic.get()->set("type", rt::json_value::make_unsigned(1));
		@diagnostic.get()->set("message", rt::json_value::make_string(message));
		@this.notify("window/logMessage", $diagnostic);
		var completion = rt::json_value::make_object();
		@completion.get()->set("generation", rt::json_value::make_unsigned(u64(job.generation)));
		@this.notify("rutile/semanticTokensChanged", $completion);
	}
	catch (rt::allocation_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis failed; allocation prevented reporting the diagnostic.\n\0".data());
		try {
			@this.protocol->send("{\"jsonrpc\":\"2.0\",\"method\":\"window/logMessage\",\"params\":{\"type\":1,\"message\":\"Language analysis failed because allocation could not be satisfied.\"}}");
			@this.protocol->send("{\"jsonrpc\":\"2.0\",\"method\":\"rutile/semanticTokensChanged\",\"params\":{}}");
		}
		catch (rt::allocation_error& failure) {
			discard fprintf(platform_standard_error(), "Language analysis completion could not be sent because allocation failed.\n\0".data());
		};
	}
	catch (rt::json_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis failed; diagnostic JSON could not be produced.\n\0".data());
	}
	catch (language_transport_error& error) {
		discard fprintf(platform_standard_error(), "Language analysis diagnostic transport failed: %.*s\n\0".data(), static_cast<i32>(error.message.size()), error.message.data());
	};
};
fn LanguageWorkspace::receive(var LanguageWorkspace& this) {
	rt::unique<LanguageIndex> next;
	runtime_mutex_lock(this.publication_mutex);
	@next = rt::unique<LanguageIndex>(@this.incoming.release());
	runtime_mutex_unlock(this.publication_mutex);
	if (next.get()) {
		usize target = 0;
		while (target < next.get()->targets.size()) {
			rt::string& key = next.get()->targets.data()[target];
			usize existing = 0;
			while (existing < this.known_targets.size() && this.known_targets.data()[existing].view() != key.view()) {
				@existing = existing + 1;
			};
			if (existing == this.known_targets.size()) {
				@this.known_targets.push_back(rt::string(key));
			};
			@target = target + 1;
		};
	};
	if (next.get() && next.get()->generation >= this.minimum_semantic_generation) {
		var previous = rt::unique<LanguageIndex>(@this.published.release());
		if (next.get()->semantic_failed && previous.get() && !previous.get()->semantic_failed) {
			var obsolete = rt::unique<LanguageIndex>(@this.highlight_fallback.release());
			@this.highlight_fallback = rt::unique<LanguageIndex>(@previous.release());
			@this.retire($obsolete);
		};
		if (!next.get()->semantic_failed) {
			var obsolete = rt::unique<LanguageIndex>(@this.highlight_fallback.release());
			@this.retire($obsolete);
		};
		@this.published = $next;
		@this.retire($previous);
	}
	else {
		@this.retire($next);
	};
};

fn LanguageWorkspace::retire(var LanguageWorkspace& this, rt::unique<LanguageIndex> index) {
	if (!index.get()) {
		return;
	};
	runtime_mutex_lock(this.publication_mutex);
	@index.get()->retired_next = rt::unique<LanguageIndex>(@this.retired.release());
	@this.retired = $index;
	runtime_mutex_unlock(this.publication_mutex);
	runtime_condition_notify(this.wake);
};

fn LanguageWorkspace::collect_retired(var LanguageWorkspace& this) {
	rt::unique<LanguageIndex> garbage;
	runtime_mutex_lock(this.publication_mutex);
	@garbage = rt::unique<LanguageIndex>(@this.retired.release());
	runtime_mutex_unlock(this.publication_mutex);
	while (garbage.get()) {
		var next = rt::unique<LanguageIndex>(@garbage.get()->retired_next.release());
		@garbage.reset(nullptr);
		@garbage = $next;
	};
};

fn LanguageWorkspace::schedule(var LanguageWorkspace& this) {
	if (runtime_atomic_load(this.stopped)) {
		return;
	};
	if (!this.ready()) {
		compiler_panic("language worker is unavailable while scheduling analysis");
	};
	@this.receive();
	rt::unique<LanguageJob> job = rt::unique<LanguageJob>::make();
	if (!job.get()) {
		compiler_panic("language server schedule invariant failed");
	};
	@job.get()->root.append(this.root.view());

	u64 revision = @this.compiler->next_editor_revision();
	if (!revision) {
		compiler_panic("language server schedule invariant failed");
	};
	@job.get()->generation = revision;
	runtime_atomic_store(this.generation, $revision);
	@job.get()->configuration = this.configuration;
	usize target = 0;
	while (target < this.known_targets.size()) {
		if (!(@this.compiler->expect_target(this.known_targets.data()[target].view(), u64(job.get()->generation))).has<void>()) {
			return;
		};
		@target = target + 1;
	};
	usize index = 0;
	while (index < this.documents.size()) {
		if (this.published.get()) {
			var LanguageDocument& document = @*(@this.documents).data()[index].get();
			var source = this.published.get()->source_ids.find(document.key);
			if (source) {
				u64 revision = this.published.get()->sources.data()[*source].revision;
				if (this.highlight_fallback.get()) {
					var fallback = this.highlight_fallback.get()->source_ids.find(document.key);
					if (fallback && this.highlight_fallback.get()->sources.data()[*fallback].revision < revision) {
						@revision = this.highlight_fallback.get()->sources.data()[*fallback].revision;
					};
				};
				usize first = 0;
				while (first < document.edits.size() && document.edits.data()[first].revision <= revision) {
					@first = first + 1;
				};
				usize remaining = document.edits.size() - first;
				usize item = 0;
				while (first && item < remaining) {
					@(@document.edits).data()[item] = LanguageEdit(document.edits.data()[first + item]);
					@item = item + 1;
				};
				while (document.edits.size() > remaining) {
					@document.edits.pop_back();
				};
			};
		};
		@job.get()->documents.push_back(LanguageDocument(*this.documents.data()[index].get()));
		@index = index + 1;
	};

	rt::unique<LanguageJob> obsolete;
	runtime_mutex_lock(this.jobs_mutex);
	@obsolete = rt::unique<LanguageJob>(@this.pending.release());
	@this.pending = $job;
	runtime_mutex_unlock(this.jobs_mutex);
	runtime_condition_notify(this.wake);
};

fn LanguageWorkspace::configure(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	var uri = LanguageJson::text(parameters, "rootUri");
	if (!uri.empty()) {
		rt::string path;
		if (!LanguageUri::decode(uri, @path).has<void>()) {
			return language_request_error();
		};
		@this.root = $path;
	};
	@this.configuration = this.configuration + 1;
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::document_key(var LanguageWorkspace& this, rt::string_view key) -> var LanguageDocument* {
	var found = this.document_names.find(key);
	if (found) {
		return *found;
	};
	return nullptr;
};

fn LanguageWorkspace::document(var LanguageWorkspace& this, rt::string_view uri) -> var LanguageDocument* {
	rt::string path;
	rt::string key;
	if (!LanguageUri::decode(uri, @path).has<void>()) {
		return nullptr;
	};
	LanguageUri::key(path.view(), @key);
	return @this.document_key(key.view());
};

fn LanguageWorkspace::open(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	if (!identity) {
		return language_request_error();
	};
	var uri = LanguageJson::text(*identity, "uri");
	rt::unique<LanguageDocument> document = rt::unique<LanguageDocument>::make();
	if (!document.get()) {
		compiler_panic("language document allocation returned no document");
	};
	@document.get()->uri.append(uri);
	if (!LanguageUri::decode(uri, @document.get()->path).has<void>()) {
		return language_request_error();
	};
	LanguageUri::key(document.get()->path.view(), @document.get()->key);
	@document.get()->text.assign(LanguageJson::text(*identity, "text"));
	@document.get()->version = LanguageJson::integer(*identity, "version", 0);
	@this.revision = this.revision + 1;
	@document.get()->revision = this.revision;
	@document.get()->opened_revision = this.revision;

	usize existing = 0;
	while (existing < this.documents.size() && this.documents.data()[existing].get()->key.view() != document.get()->key.view()) {
		@existing = existing + 1;
	};
	if (existing < this.documents.size()) {
		discard @this.document_names.erase(this.documents.data()[existing].get()->key.view());
		if (!@this.document_names.insert(document.get()->key.view(), document.get())) {
			compiler_panic("language document replacement could not be registered");
		};
		@(@this.documents).data()[existing] = $document;
	}
	else {
		var LanguageDocument* added = document.get();
		@this.documents.push_back($document);
		if (!@this.document_names.insert(added->key.view(), (var LanguageDocument*(added)))) {
			@this.documents.pop_back();
			compiler_panic("new language document could not be registered");
		};
	};
	var LanguageDocument* opened = @this.document(uri);
	if (opened) {
		rutile_editor_source_update(opened->path.c_str(), opened->text.view().data(), opened->text.view().size());
	};
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::change(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	rt::json_value* changes = parameters.member("contentChanges");
	if (!identity || !changes || changes->kind() != rt::json_kind::array) {
		return language_request_error();
	};
	var LanguageDocument* document = @this.document(LanguageJson::text(*identity, "uri"));
	i64 version = LanguageJson::integer(*identity, "version", -1);
	if (!document) {
		return language_request_error();
	};
	if (version <= document->version) {
		return;
	};

	usize index = 0;
	while (index < changes->size()) {
		rt::json_value* change = changes->item(index);
		rt::json_value* range = change->member("range");
		usize begin = 0;
		usize end = document->text.view().size();
		if (range) {
			rt::json_value* start = range->member("start");
			rt::json_value* finish = range->member("end");
			if (!start || !finish) {
				return language_request_error();
			};
			@begin = document->text.offset(static_cast<usize>(LanguageJson::integer(*start, "line", 0)), static_cast<usize>(LanguageJson::integer(*start, "character", 0)));
			@end = document->text.offset(static_cast<usize>(LanguageJson::integer(*finish, "line", 0)), static_cast<usize>(LanguageJson::integer(*finish, "character", 0)));
		};
		if (end < begin) {
			return language_request_error();
		};

		var inserted = LanguageJson::text(*change, "text");
		var original = document->text.view();
		usize prefix = 0;
		while (prefix < end && (original.data()[prefix] == ' ' || original.data()[prefix] == '\r' || original.data()[prefix] == '\n' || original.data()[prefix] == '\t')) {
			@prefix = prefix + 1;
		};
		usize trivia = 0;
		while (trivia < inserted.size() && (inserted.data()[trivia] == ' ' || inserted.data()[trivia] == '\r' || inserted.data()[trivia] == '\n' || inserted.data()[trivia] == '\t')) {
			@trivia = trivia + 1;
		};
		if (prefix != end || trivia != inserted.size()) {
			@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
		};

		rt::string replacement;
		@replacement.append(rt::string_view(original.data(), usize(begin)));
		@replacement.append(inserted);
		@replacement.append(rt::string_view(original.data() + end, original.size() - end));
		LanguageEdit edit;
		@this.revision = this.revision + 1;
		@edit.revision = this.revision;
		@edit.begin = usize(begin);
		@edit.end = usize(end);
		@edit.inserted = inserted.size();
		@document->revision = this.revision;
		if (document->template_anchor.has_value()) {
			usize anchor = document->template_anchor.value();
			if (anchor >= end) {
				@document->template_anchor = rt::optional<usize>(anchor - (end - begin) + inserted.size());
			}
			else if (anchor >= begin) {
				@document->template_anchor.reset();
				@document->template_arguments.clear();
			};
		};
		@document->edits.push_back($edit);
		@document->text.assign(replacement.view());
		@index = index + 1;
	};
	@document->version = $version;
	rutile_editor_source_update(document->path.c_str(), document->text.view().data(), document->text.view().size());
	@this.schedule();
};

fn LanguageWorkspace::close(var LanguageWorkspace& this, rt::json_value& parameters) -> LanguageRequestResult {
	rt::json_value* identity = parameters.member("textDocument");
	if (!identity) {
		return language_request_error();
	};
	var uri = LanguageJson::text(*identity, "uri");
	var LanguageDocument* document = @this.document(uri);
	usize index = 0;
	while (index < this.documents.size()) {
		if (this.documents.data()[index].get() == document) {
			rutile_editor_source_update(document->path.c_str(), nullptr, 0);
			discard @this.document_names.erase(document->key.view());
			usize last = this.documents.size() - 1;
			if (index != last) {
				@(@this.documents).data()[index] = rt::unique<LanguageDocument>(@(@this.documents).data()[last].release());
			};
			@this.documents.pop_back();
			break;
		};
		@index = index + 1;
	};

	var notification = rt::json_value::make_object();
	if (notification.get()) {
		@notification.get()->set("uri", rt::json_value::make_string(uri));
		@notification.get()->set("diagnostics", rt::json_value::make_array());
		@this.notify("textDocument/publishDiagnostics", $notification);
	};
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::refresh(var LanguageWorkspace& this) {
	@this.sources_revision = kiln_project_sources_revision();
	@this.configuration = this.configuration + 1;
	@this.minimum_semantic_generation = runtime_atomic_load(this.generation) + 1;
	@this.schedule();
};

fn LanguageWorkspace::refresh_sources(var LanguageWorkspace& this) {
	if (!(this.sources_revision == kiln_project_sources_revision())) {
		@this.refresh();
	};
};

fn LanguageWorkspace::notify(var LanguageWorkspace& this, rt::string_view method, rt::unique<rt::json_value> parameters) {
	var message = LanguageJson::notification(method, $parameters);
	rt::string output;
	if (!message.get()) {
		compiler_panic("language server notify invariant failed");
	};
	rt::json_write(*message.get(), @output);
	@this.protocol->send(output.view());
};

// Field values loaded by a relocation are immutable after the source lifetime
// ends. They belong to the path state, rather than a shared mutable cache.
struct FactAggregateEvaluation {
	SemanticExpression* expression;
	usize place;
	FactValue value;
};

struct FactAggregateProjection {
	usize source;
	usize destination;
};

struct FactAggregateMove {
	SemanticExpression* initializer;
	SemanticExpression* relocation;
	usize source;
	usize destination;
	rt::buffer<FactAggregateProjection> projections;
};

fn FactState::aggregate_value(FactState& this, SemanticExpression* expression, usize place) -> FactValue {
	usize index = this.aggregate_evaluated.size();
	while (index) {
		@index = index - 1;
		FactAggregateEvaluation& entry = this.aggregate_evaluated.data()[index];
		if (entry.expression == expression && entry.place == place) {
			return FactValue(entry.value);
		};
	};
	return FactValue();
};

fn FactState::record_aggregate(var FactState& this, SemanticExpression* expression, usize place, FactValue value) {
	usize index = 0;
	while (index < this.aggregate_evaluated.size()) {
		var FactAggregateEvaluation& entry = @((@this.aggregate_evaluated).data()[index]);
		if (entry.expression == expression && entry.place == place) {
			@entry.value = $value;
			return;
		};
		@index = index + 1;
	};
	if (!value.version && !value.origin && !value.alternative && value.range.available == fact_truth::unknown) {
		return;
	};
	// Missing snapshots only lose precision; applying a move invalidates the
	// destination first, so the bounded cache never restores stale fields.
	if (this.aggregate_evaluated.size() >= 1024) {
		return;
	};
	FactAggregateEvaluation entry;
	@entry.expression = expression;
	@entry.place = place;
	@entry.value = $value;
	@this.aggregate_evaluated.push_back($entry);
};

fn fact_aggregate_shape(Type* type, usize depth, var usize& budget) -> bool {
	if (!budget || depth > 32 || type->kind() == type_kind::reference) {
		return false;
	};
	@budget = budget - 1;
	if (type->kind() == type_kind::array) {
		return fact_aggregate_shape(type->element(), depth + 1, @budget);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* record = type->entity();
	if (record->layout() == record_layout::overlapping || aggregate_access_kind(type) == 2) {
		return false;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!fact_aggregate_shape(record->bases().data()[index], depth + 1, @budget)) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (!fact_aggregate_shape(record->fields().data()[index]->type(), depth + 1, @budget)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn fact_aggregate_relocation(SemanticExpression* initializer) -> SemanticExpression* {
	if (!initializer || initializer->type()->kind() != type_kind::named || initializer->type()->entity()->kind() != entity_kind::record) {
		return nullptr;
	};
	usize budget = 1024;
	if (!fact_aggregate_shape(initializer->type(), 0, @budget)) {
		return nullptr;
	};
	SemanticExpression* value = initializer;
	if (initializer->kind() == semantic_kind::construction) {
		if (initializer->integer() || !initializer->size() || initializer->item(0)->kind() != semantic_kind::brace || initializer->item(0)->size() != 1) {
			return nullptr;
		};
		var Entity* selected = initializer->entity();
		if (selected) {
			@selected = selected->canonical();
			if (selected->definition() != function_definition::defaulted || selected->role() != function_role::constructor || selected->parameters().size() != 2 || selected->parameters().data()[1]->type()->kind() == type_kind::reference || !selected->parameters().data()[1]->type()->same_shape(*initializer->type())) {
				return nullptr;
			};
		};
		@value = initializer->item(0)->item(0);
	}
	else {
		// initialize_value_body invokes the selected move constructor when
		// the initializer itself is an already evaluated aggregate value.
		var Entity* selected = initializer->type()->entity()->move_constructor();
		if (selected && selected->canonical()->definition() != function_definition::defaulted) {
			return nullptr;
		};
	};
	while (value->kind() == semantic_kind::cast && value->size() == 1 && value->type()->same_shape(*value->item(0)->type())) {
		@value = value->item(0);
	};
	if (value->kind() != semantic_kind::relocation || value->size() != 1 || !value->type()->same_shape(*initializer->type())) {
		return nullptr;
	};
	return value;
};

fn fact_aggregate_descendant(rt::buffer<FactPlace>& places, usize place, usize ancestor) -> bool {
	while (place && place != ancestor) {
		@place = places.data()[place - 1].parent;
	};
	return place != 0;
};

fn InferredFacts::aggregate_move(InferredFacts& this, SemanticExpression* initializer) -> FactAggregateMove* {
	usize index = 0;
	while (index < this.aggregate_moves.size()) {
		if (this.aggregate_moves.data()[index].get()->initializer == initializer) {
			return this.aggregate_moves.data()[index].get();
		};
		@index = index + 1;
	};
	return nullptr;
};

fn InferredFacts::collect_aggregate_move_nodes(var InferredFacts& this, SemanticExpression* expression) {
	if (!expression) {
		return;
	};
	SemanticExpression* initializer = nullptr;
	usize destination = 0;
	if (expression->kind() == semantic_kind::variable && expression->entity() && expression->entity()->kind() == entity_kind::local && expression->entity()->type()->kind() != type_kind::reference && expression->size()) {
		@initializer = expression->item(0);
		if (fact_aggregate_relocation(initializer)) {
			usize index = 0;
			while (index < this.places.size()) {
				if (this.places.data()[index].root == expression->entity() && !this.places.data()[index].parent) {
					@destination = index + 1;
				};
				@index = index + 1;
			};
			if (!destination) {
				FactPlace root;
				@root.root = expression->entity();
				@this.places.push_back($root);
				@destination = this.places.size();
			};
		};
	}
	else if (expression->kind() == semantic_kind::construction && expression->size() > 1) {
		@initializer = expression;
		@destination = @this.place(expression->item(1));
	};
	SemanticExpression* relocation = fact_aggregate_relocation(initializer);
	if (relocation && destination && !this.aggregate_move(initializer) && this.aggregate_moves.size() < 128) {
		usize source = @this.place(relocation->item(0));
		if (source && this.places.data()[source - 1].root->kind() == entity_kind::local && this.places.data()[destination - 1].root->kind() == entity_kind::local && !fact_aggregate_descendant(this.places, source, destination) && !fact_aggregate_descendant(this.places, destination, source)) {
			rt::unique<FactAggregateMove> move = rt::unique<FactAggregateMove>::make();
			@move.get()->initializer = initializer;
			@move.get()->relocation = relocation;
			@move.get()->source = source;
			@move.get()->destination = destination;
			@this.aggregate_moves.push_back($move);
		};
	};
	usize child = 0;
	while (child < expression->size()) {
		@this.collect_aggregate_move_nodes(expression->item(child));
		@child = child + 1;
	};
};

fn InferredFacts::project_aggregate_place(var InferredFacts& this, usize place, usize source, usize destination, usize depth) -> usize {
	if (place == source) {
		return destination;
	};
	if (!place || depth > 32 || !this.places.data()[place - 1].parent || !this.places.data()[place - 1].field) {
		return 0;
	};
	var Entity* field = this.places.data()[place - 1].field;
	usize parent = @this.project_aggregate_place(this.places.data()[place - 1].parent, source, destination, depth + 1);
	if (!parent) {
		return 0;
	};
	usize index = 0;
	while (index < this.places.size()) {
		FactPlace& candidate = this.places.data()[index];
		if (candidate.root == this.places.data()[destination - 1].root && candidate.parent == parent && candidate.field == field) {
			return index + 1;
		};
		@index = index + 1;
	};
	if (this.places.size() >= 1024) {
		return 0;
	};
	FactPlace projected;
	@projected.root = this.places.data()[destination - 1].root;
	@projected.parent = parent;
	@projected.field = field;
	@this.places.push_back($projected);
	return this.places.size();
};

fn InferredFacts::collect_aggregate_moves(var InferredFacts& this, SemanticExpression* body) {
	@this.aggregate_moves.clear();
	@this.collect_aggregate_move_nodes(body);
	usize iteration = 0;
	while (iteration < 128) {
		usize before = this.places.size();
		usize move_index = 0;
		while (move_index < this.aggregate_moves.size()) {
			var FactAggregateMove& move = @*(@this.aggregate_moves).data()[move_index].get();
			usize place = 1;
			while (place <= this.places.size()) {
				var Entity* field = this.places.data()[place - 1].field;
				if (place != move.destination && field && field->type()->representation()->kind().is_integer() && fact_aggregate_descendant(this.places, place, move.destination)) {
					usize source = @this.project_aggregate_place(place, move.destination, move.source, 0);
					if (source) {
						usize entry = 0;
						while (entry < move.projections.size() && move.projections.data()[entry].destination != place) {
							@entry = entry + 1;
						};
						if (entry == move.projections.size()) {
							FactAggregateProjection projection;
							@projection.source = source;
							@projection.destination = place;
							@move.projections.push_back($projection);
						};
					};
				};
				@place = place + 1;
			};
			@move_index = move_index + 1;
		};
		if (this.places.size() == before) {
			return;
		};
		@iteration = iteration + 1;
	};
	@this.aggregate_moves.clear();
};

fn InferredFacts::capture_aggregate(var InferredFacts& this, SemanticExpression* expression, var FactState& state) {
	usize index = 0;
	while (index < this.aggregate_moves.size()) {
		FactAggregateMove& move = *this.aggregate_moves.data()[index].get();
		if (move.relocation == expression) {
			usize field = 0;
			while (field < move.projections.size()) {
				usize source = move.projections.data()[field].source;
				@state.record_aggregate(expression, source, FactValue(state.places.data()[source - 1]));
				@field = field + 1;
			};
		};
		@index = index + 1;
	};
};

fn InferredFacts::apply_aggregate_move(var InferredFacts& this, SemanticExpression* initializer, var FactState& state) {
	FactAggregateMove* move = this.aggregate_move(initializer);
	if (!move) {
		return;
	};
	@this.invalidate(@state, move->destination);
	usize field = 0;
	while (field < move->projections.size()) {
		FactAggregateProjection& projection = move->projections.data()[field];
		@((@state.places).data()[projection.destination - 1]) = state.aggregate_value(move->relocation, projection.source);
		@field = field + 1;
	};
};

// The graph owns no semantic expressions. Its source pointers remain valid for the
// lifetime of the analyzed semantic function.
enum fact_node_kind : [u08] {
	entry;
	expression;
	merge;
	normal_exit;
	exceptional_exit;
	opaque;
	lifetime_begin;
	lifetime_end;
	fallthrough_exit;
};

enum fact_evaluation : [u08] {
	value;
	storage;
};

enum fact_edge_kind : [u08] {
	next;
	when_true;
	when_false;
	exceptional;
	backedge;
};

struct FactNode {
	fact_node_kind kind;
	var SemanticExpression* expression;
	var Entity* owner;
	var SemanticExpression* region;
	fact_evaluation evaluation;
};

struct FactEdge {
	usize source;
	usize target;
	fact_edge_kind kind;
	var SemanticExpression* condition;
};

fn fact_no_node() -> usize {
	return 18446744073709551615;
};

// Subsequent semantic passes may consume generic facts after numeric analysis
// has converged. Numeric worklists must use their own current abstract state.
fn fact_semantic_edge_feasible(FactEdge& edge) -> bool {
	if (!edge.condition || edge.kind != fact_edge_kind::when_true && edge.kind != fact_edge_kind::when_false) {
		return true;
	};
	bool truth = false;
	bool known = edge.condition->constant_truth(@truth);
	if (!known) {
		@known = edge.condition->inferred_condition(@truth);
	};
	if (!known) {
		u64 value = 0;
		if (edge.condition->inferred_integer(@value)) {
			@truth = value != 0;
			@known = true;
		};
	};
	if (!known) {
		return true;
	};
	return (edge.kind == fact_edge_kind::when_true) == truth;
};

fn fact_cleanup_effects(Type* type, usize depth) -> bool {
	if (!type || depth > 32) {
		return true;
	};
	if (type->kind() == type_kind::array) {
		return fact_cleanup_effects(type->element(), depth + 1);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return false;
	};
	var Entity* record = type->entity();
	var Entity* destructor = record->destructor();
	if (destructor && destructor->definition() != function_definition::defaulted) {
		return true;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (fact_cleanup_effects(record->bases().data()[index], depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (fact_cleanup_effects(record->fields().data()[index]->type(), depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_collect_cleanup(var SemanticExpression* expression, var rt::buffer<var SemanticExpression*>& owners) {
	if (!expression) {
		return;
	};
	if (expression->kind() == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference) {
		@owners.push_back(expression);
		return;
	};
	if (expression->kind() == semantic_kind::statements) {
		usize index = 0;
		while (index < expression->size()) {
			fact_collect_cleanup(expression->item(index), @owners);
			@index = index + 1;
		};
	};
};

fn fact_temporary_source(var SemanticExpression* expression, bool nested) -> var SemanticExpression* {
	if (!expression) {
		return nullptr;
	};
	semantic_kind kind = expression->kind();
	// initialize_value_body constructs a matching consumable initializer
	// directly in owned variable storage. Only its arguments can create
	// full-expression temporaries; the outer object ends at scope cleanup.
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference && expression->size()) {
		var SemanticExpression* initializer = expression->item(0);
		if (initializer->kind() == semantic_kind::construction && initializer->category() == value_category::consumable && expression->entity()->type()->same_shape(*initializer->type())) {
			usize child = 0;
			while (child < initializer->size()) {
				var SemanticExpression* temporary = fact_temporary_source(initializer->item(child), true);
				if (temporary) {
					return temporary;
				};
				@child = child + 1;
			};
			return nullptr;
		};
	};
	if (kind == semantic_kind::conditional || kind == semantic_kind::while_loop || kind == semantic_kind::for_loop || kind == semantic_kind::switch_expression || kind == semantic_kind::exception_try || kind == semantic_kind::sequence || kind == semantic_kind::statements || kind == semantic_kind::return_value || kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow || kind == semantic_kind::brace && !nested) {
		return nullptr;
	};
	if ((kind == semantic_kind::construction || kind == semantic_kind::call) && expression->type()->kind() != type_kind::reference && fact_cleanup_effects(expression->type(), 0)) {
		return expression;
	};
	usize child = 0;
	while (child < expression->size()) {
		var SemanticExpression* source = fact_temporary_source(expression->item(child), true);
		if (source) {
			return source;
		};
		@child = child + 1;
	};
	return nullptr;
};

struct FactGraph {
	rt::buffer<FactNode> nodes;
	rt::buffer<FactEdge> edges;
	usize entry;
	usize normal_exit;
	usize exceptional_exit;
	usize fallthrough_exit;
	usize return_target;

	fn build(var FactGraph& this, var SemanticExpression* body);
	fn build_function(var FactGraph& this, Entity& function);
	fn add_node(var FactGraph& this, fact_node_kind kind, var SemanticExpression* expression, var usize& result);
	fn add_lifetime(var FactGraph& this, fact_node_kind kind, var Entity* owner, var SemanticExpression* expression, var usize& result);
	fn owner_cleanup(var FactGraph& this, var Entity* owner, var SemanticExpression* expression, usize target, usize exception_target, var usize& result);
	fn connect(var FactGraph& this, usize source, usize target, fact_edge_kind kind, var SemanticExpression* condition);
	fn lower(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn lower_contents(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn lower_scope(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn full_expression(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target);
	fn cleanup_target(var FactGraph& this, var SemanticExpression* handler, usize target, usize exception_target, var usize& result);
};

fn FactGraph::add_node(var FactGraph& this, fact_node_kind kind, var SemanticExpression* expression, var usize& result) {
	@result = this.nodes.size();
	FactNode node;
	@node.kind = $kind;
	@node.expression = $expression;
	@this.nodes.push_back($node);
};

fn FactGraph::add_lifetime(var FactGraph& this, fact_node_kind kind, var Entity* owner, var SemanticExpression* expression, var usize& result) {
	@this.add_node(kind, expression, @result);
	@(@this.nodes).data()[result].owner = owner;
};

fn FactGraph::owner_cleanup(var FactGraph& this, var Entity* owner, var SemanticExpression* expression, usize target, usize exception_target, var usize& result) {
	if (target == fact_no_node()) {
		@result = fact_no_node();
		return;
	};
	@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @result);
	@this.connect(result, target, fact_edge_kind::next, nullptr);
	if (!fact_cleanup_effects(owner->type(), 0)) {
		return;
	};
	usize normal = result;
	usize exceptional = 0;
	@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @exceptional);
	@this.connect(exceptional, exception_target, fact_edge_kind::exceptional, nullptr);
	@this.add_node(fact_node_kind::opaque, expression, @result);
	@(@this.nodes).data()[result].owner = owner;
	@this.connect(result, normal, fact_edge_kind::next, nullptr);
	@this.connect(result, exceptional, fact_edge_kind::exceptional, nullptr);
};

fn FactGraph::connect(var FactGraph& this, usize source, usize target, fact_edge_kind kind, var SemanticExpression* condition) {
	if (source == fact_no_node() || target == fact_no_node()) {
		return;
	};
	FactEdge edge;
	@edge.source = $source;
	@edge.target = $target;
	@edge.kind = $kind;
	// The initial entry is connected before the loop header is annotated.
	// Later header entries include continues from increment expressions and
	// their cleanup chains, and must retain backedge lifetime validation.
	if (edge.kind == fact_edge_kind::next && this.nodes.data()[edge.target].region) {
		@edge.kind = fact_edge_kind::backedge;
	};
	@edge.condition = $condition;
	@this.edges.push_back($edge);
};

fn FactGraph::build(var FactGraph& this, var SemanticExpression* body) {
	@this.nodes.clear();
	@this.edges.clear();
	@this.add_node(fact_node_kind::entry, nullptr, @this.entry);
	@this.add_node(fact_node_kind::normal_exit, nullptr, @this.normal_exit);
	@this.add_node(fact_node_kind::exceptional_exit, nullptr, @this.exceptional_exit);
	usize current = this.entry;
	@this.return_target = this.normal_exit;
	@this.lower(body, @current, fact_no_node(), fact_no_node(), this.exceptional_exit);
	@this.add_node(fact_node_kind::fallthrough_exit, nullptr, @this.fallthrough_exit);
	@this.connect(current, this.fallthrough_exit, fact_edge_kind::next, nullptr);
	@this.connect(this.fallthrough_exit, this.normal_exit, fact_edge_kind::next, nullptr);
};

fn FactGraph::build_function(var FactGraph& this, Entity& function) {
	@this.nodes.clear();
	@this.edges.clear();
	@this.add_node(fact_node_kind::entry, nullptr, @this.entry);
	@this.add_node(fact_node_kind::normal_exit, nullptr, @this.normal_exit);
	@this.add_node(fact_node_kind::exceptional_exit, nullptr, @this.exceptional_exit);
	usize normal = this.normal_exit;
	usize exceptional = this.exceptional_exit;
	usize current = this.entry;
	usize index = 0;
	while (index < function.parameters().size()) {
		var Entity* parameter = function.parameters().data()[index];
		@index = index + 1;
		if (parameter->type()->kind() == type_kind::reference) {
			continue;
		};
		usize begin = 0;
		@this.add_lifetime(fact_node_kind::lifetime_begin, parameter, nullptr, @begin);
		@this.connect(current, begin, fact_edge_kind::next, nullptr);
		@current = begin;
		@this.owner_cleanup(parameter, nullptr, normal, exceptional, @normal);
		@this.owner_cleanup(parameter, nullptr, exceptional, exceptional, @exceptional);
	};
	@this.return_target = normal;
	@this.lower(function.body(), @current, fact_no_node(), fact_no_node(), exceptional);
	@this.add_node(fact_node_kind::fallthrough_exit, nullptr, @this.fallthrough_exit);
	@this.connect(current, this.fallthrough_exit, fact_edge_kind::next, nullptr);
	@this.connect(this.fallthrough_exit, normal, fact_edge_kind::next, nullptr);
};

fn FactGraph::cleanup_target(var FactGraph& this, var SemanticExpression* handler, usize target, usize exception_target, var usize& result) {
	if (target == fact_no_node()) {
		@result = fact_no_node();
		return;
	};
	if (handler && handler->kind() == semantic_kind::variable && handler->entity() && handler->entity()->type()->kind() != type_kind::reference) {
		@this.owner_cleanup(handler->entity(), handler, target, exception_target, @result);
		return;
	};
	@this.add_node(fact_node_kind::opaque, handler, @result);
	@this.connect(result, target, fact_edge_kind::next, nullptr);
	@this.connect(result, exception_target, fact_edge_kind::exceptional, nullptr);
};

fn FactGraph::lower(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (expression && (expression->kind() == semantic_kind::brace || expression->kind() == semantic_kind::sequence || expression->kind() == semantic_kind::for_loop || expression->kind() == semantic_kind::switch_expression)) {
		@this.lower_scope(expression, @current, break_target, continue_target, exception_target);
		return;
	};
	@this.lower_contents(expression, @current, break_target, continue_target, exception_target);
};

fn FactGraph::full_expression(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	@this.lower(expression, @current, break_target, continue_target, exception_target);
	var SemanticExpression* source = fact_temporary_source(expression, false);
	if (!source || current == fact_no_node()) {
		return;
	};
	usize cleanup = 0;
	@this.add_node(fact_node_kind::opaque, source, @cleanup);
	@this.connect(current, cleanup, fact_edge_kind::next, nullptr);
	@this.connect(cleanup, exception_target, fact_edge_kind::exceptional, nullptr);
	@current = cleanup;
};

fn FactGraph::lower_scope(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (!expression || current == fact_no_node()) {
		return;
	};
	rt::buffer<var SemanticExpression*> owners;
	var SemanticExpression* declarations = expression;
	if (expression->kind() == semantic_kind::switch_expression) {
		@declarations = expression->item(1);
	};
	if (expression->kind() == semantic_kind::for_loop) {
		fact_collect_cleanup(expression->item(0), @owners);
	}
	else if (declarations && (declarations->kind() == semantic_kind::brace || declarations->kind() == semantic_kind::sequence || declarations->kind() == semantic_kind::statements)) {
		usize child = 0;
		while (child < declarations->size()) {
			fact_collect_cleanup(declarations->item(child), @owners);
			@child = child + 1;
		};
	}
	else {
		fact_collect_cleanup(declarations, @owners);
	};
	if (!owners.size()) {
		@this.lower_contents(expression, @current, break_target, continue_target, exception_target);
		var SemanticExpression* temporary = fact_temporary_source(expression, false);
		if (!temporary || current == fact_no_node()) {
			return;
		};
		usize cleanup = 0;
		@this.add_node(fact_node_kind::opaque, temporary, @cleanup);
		@this.connect(current, cleanup, fact_edge_kind::next, nullptr);
		@this.connect(cleanup, exception_target, fact_edge_kind::exceptional, nullptr);
		@current = cleanup;
		return;
	};
	usize after = 0;
	@this.add_node(fact_node_kind::merge, nullptr, @after);
	usize normal = after;
	usize leaving = break_target;
	usize continuing = continue_target;
	usize exceptional = exception_target;
	usize saved_return = this.return_target;
	usize owner = 0;
	while (owner < owners.size()) {
		var SemanticExpression* declaration = owners.data()[owner];
		@this.cleanup_target(declaration, normal, exceptional, @normal);
		@this.cleanup_target(declaration, leaving, exceptional, @leaving);
		@this.cleanup_target(declaration, continuing, exceptional, @continuing);
		@this.cleanup_target(declaration, this.return_target, exceptional, @this.return_target);
		@this.cleanup_target(declaration, exceptional, exceptional, @exceptional);
		@owner = owner + 1;
	};
	// Cleanup nodes are may-effects: declarations bypassed by a branch, or
	// already relocated, can add conservative edges but never invent facts.
	@this.lower_contents(expression, @current, leaving, continuing, exceptional);
	@this.return_target = saved_return;
	@this.connect(current, normal, fact_edge_kind::next, nullptr);
	@current = after;
};

fn FactGraph::lower_contents(var FactGraph& this, var SemanticExpression* expression, var usize& current, usize break_target, usize continue_target, usize exception_target) {
	if (!expression || current == fact_no_node()) {
		return;
	};
	semantic_kind kind = expression->kind();
	if (kind == semantic_kind::brace || kind == semantic_kind::statements || kind == semantic_kind::sequence) {
		usize child = 0;
		while (child < expression->size()) {
			@this.full_expression(expression->item(child), @current, break_target, continue_target, exception_target);
			@child = child + 1;
		};
		usize container = 0;
		@this.add_node(fact_node_kind::expression, expression, @container);
		@this.connect(current, container, fact_edge_kind::next, nullptr);
		@current = container;
		return;
	};
	if (kind == semantic_kind::conditional || kind == semantic_kind::binary && (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or)) {
		@this.full_expression(expression->item(0), @current, break_target, continue_target, exception_target);
		usize first = 0;
		usize second = 0;
		usize merge = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @first);
		@this.add_node(fact_node_kind::merge, nullptr, @second);
		@this.add_node(fact_node_kind::merge, nullptr, @merge);
		@this.connect(current, first, fact_edge_kind::when_true, expression->item(0));
		@this.connect(current, second, fact_edge_kind::when_false, expression->item(0));
		if (kind == semantic_kind::conditional || expression->operation() == token_kind::op_and) {
			@this.lower_scope(expression->item(1), @first, break_target, continue_target, exception_target);
		};
		if (kind == semantic_kind::conditional) {
			@this.lower_scope(expression->item(2), @second, break_target, continue_target, exception_target);
		}
		else if (expression->operation() == token_kind::op_or) {
			@this.full_expression(expression->item(1), @second, break_target, continue_target, exception_target);
		};
		@this.connect(first, merge, fact_edge_kind::next, nullptr);
		@this.connect(second, merge, fact_edge_kind::next, nullptr);
		@current = merge;
		return;
	};
	if (kind == semantic_kind::while_loop || kind == semantic_kind::for_loop) {
		bool is_for = kind == semantic_kind::for_loop;
		if (is_for) {
			@this.full_expression(expression->item(0), @current, break_target, continue_target, exception_target);
		};
		usize header = 0;
		usize body = 0;
		usize step = 0;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @header);
		@this.add_node(fact_node_kind::merge, nullptr, @body);
		@this.add_node(fact_node_kind::merge, nullptr, @step);
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		@this.connect(current, header, fact_edge_kind::next, nullptr);
		@(@this.nodes).data()[header].region = expression;
		usize test_index = 0;
		usize body_index = 1;
		if (is_for) {
			@test_index = 1;
			@body_index = 3;
		};
		var SemanticExpression* test = expression->item(test_index);
		@current = header;
		@this.full_expression(test, @current, break_target, continue_target, exception_target);
		@this.connect(current, body, fact_edge_kind::when_true, test);
		if (is_for) {
			if (test->kind() != semantic_kind::noop) {
				@this.connect(current, after, fact_edge_kind::when_false, test);
			};
		}
		else {
			@this.connect(current, after, fact_edge_kind::when_false, test);
		};
		@current = body;
		@this.lower_scope(expression->item(body_index), @current, after, step, exception_target);
		@this.connect(current, step, fact_edge_kind::next, nullptr);
		@current = step;
		if (is_for) {
			@this.full_expression(expression->item(2), @current, after, header, exception_target);
		};
		@this.connect(current, header, fact_edge_kind::backedge, nullptr);
		@current = after;
		return;
	};
	if (kind == semantic_kind::exception_try) {
		usize dispatch = 0;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @dispatch);
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		@this.lower_scope(expression->item(0), @current, break_target, continue_target, dispatch);
		@this.connect(current, after, fact_edge_kind::next, nullptr);
		usize catch_all = fact_no_node();
		usize handler_index = 1;
		while (handler_index < expression->size()) {
			var SemanticExpression* handler = expression->item(handler_index);
			usize handler_entry = 0;
			@this.add_node(fact_node_kind::expression, handler, @handler_entry);
			@this.connect(dispatch, handler_entry, fact_edge_kind::next, nullptr);
			if (handler->type()->kind() == type_kind::void_type) {
				@catch_all = handler_index;
			};
			@current = handler_entry;
			Type* caught = handler->type();
			if (caught->kind() == type_kind::reference) {
				@caught = caught->element();
			};
			bool cleanup = caught->kind() == type_kind::void_type || caught->kind() == type_kind::named && caught->entity()->kind() == entity_kind::record;
			usize handler_break = break_target;
			usize handler_continue = continue_target;
			usize saved_return = this.return_target;
			usize handler_after = after;
			if (cleanup) {
				@this.cleanup_target(handler, after, exception_target, @handler_after);
				@this.cleanup_target(handler, break_target, exception_target, @handler_break);
				@this.cleanup_target(handler, continue_target, exception_target, @handler_continue);
				@this.cleanup_target(handler, saved_return, exception_target, @this.return_target);
			};
			// A handler's own exceptions belong to the enclosing try, never
			// to another handler of the same dispatch.
			@this.lower_scope(handler->item(0), @current, handler_break, handler_continue, exception_target);
			@this.return_target = saved_return;
			// Catch completion can destroy an exception object. Without its
			// dynamic type, a catch-all or record catch has opaque cleanup.
			@this.connect(current, handler_after, fact_edge_kind::next, nullptr);
			@handler_index = handler_index + 1;
		};
		if (catch_all == fact_no_node()) {
			@this.connect(dispatch, exception_target, fact_edge_kind::exceptional, nullptr);
		};
		@current = after;
		return;
	};
	if (kind == semantic_kind::switch_expression) {
		var SemanticExpression* selector = expression->item(0);
		var SemanticExpression* body = expression->item(1);
		@this.full_expression(selector, @current, break_target, continue_target, exception_target);
		if (!body || body->kind() != semantic_kind::brace) {
			return;
		};
		usize dispatch = current;
		usize after = 0;
		@this.add_node(fact_node_kind::merge, nullptr, @after);
		rt::buffer<usize> labels;
		usize fallback = fact_no_node();
		usize selected = fact_no_node();
		u64 selector_value = 0;
		bool known = selector->constant_integer(@selector_value);
		usize item = 0;
		while (item < body->size()) {
			var SemanticExpression* source = body->item(item);
			usize label = fact_no_node();
			if (source->kind() == semantic_kind::case_label) {
				@this.add_node(fact_node_kind::merge, source, @label);
				if (source->token().kind == token_kind::kw_default) {
					@fallback = label;
				}
				else if (known && source->integer() == selector_value) {
					@selected = label;
				};
				if (!known) {
					@this.connect(dispatch, label, fact_edge_kind::next, nullptr);
				};
			};
			@labels.push_back($label);
			@item = item + 1;
		};
		if (known) {
			if (selected == fact_no_node()) {
				@selected = fallback;
			};
			if (selected == fact_no_node()) {
				@selected = after;
			};
			@this.connect(dispatch, selected, fact_edge_kind::next, nullptr);
		}
		else if (fallback == fact_no_node()) {
			@this.connect(dispatch, after, fact_edge_kind::next, nullptr);
		};
		@current = fact_no_node();
		@item = 0;
		while (item < body->size()) {
			if (body->item(item)->kind() == semantic_kind::case_label) {
				usize label = labels.data()[item];
				@this.connect(current, label, fact_edge_kind::next, nullptr);
				@current = label;
			}
			else {
				@this.full_expression(body->item(item), @current, after, continue_target, exception_target);
			};
			@item = item + 1;
		};
		@this.connect(current, after, fact_edge_kind::next, nullptr);
		@current = after;
		return;
	};
	usize index = 0;
	usize children = expression->size();
	// Cast fallback children describe exceptional dispatch alternatives; they
	// are not evaluations on the continuing path through the selected payload.
	if (kind == semantic_kind::variant_cast && children) {
		@children = 1;
	};
	while (index < children) {
		usize child = index;
		// Primitive assignment evaluates its value before computing the destination.
		if (kind == semantic_kind::binary && children == 2 && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
			@child = 1 - index;
		};
		// Indexed addresses evaluate the subscript before the base. Placement
		// construction computes its destination before constructor arguments.
		if (children == 2 && (kind == semantic_kind::index || kind == semantic_kind::construction)) {
			@child = 1 - index;
		};
		usize begin = this.nodes.size();
		@this.lower(expression->item(child), @current, break_target, continue_target, exception_target);
		if (kind == semantic_kind::construction && children > 1 && child == 1) {
			var Entity* owner = expression->item(child)->owned_binding();
			while (begin < this.nodes.size()) {
				var FactNode& lowered = @(@this.nodes).data()[begin];
				if (owner && lowered.kind == fact_node_kind::expression && lowered.expression && lowered.expression->kind() == semantic_kind::name && lowered.expression->entity() == owner) {
					@lowered.evaluation = fact_evaluation::storage;
				};
				@begin = begin + 1;
			};
		};
		@index = index + 1;
	};
	usize node = 0;
	@this.add_node(fact_node_kind::expression, expression, @node);
	@this.connect(current, node, fact_edge_kind::next, nullptr);
	@current = node;
	if (kind == semantic_kind::call || kind == semantic_kind::construction || kind == semantic_kind::allocation || kind == semantic_kind::destruction || kind == semantic_kind::variant_cast) {
		usize exceptional = exception_target;
		var Entity* ending = nullptr;
		if (kind == semantic_kind::destruction && expression->size()) {
			@ending = expression->item(0)->owned_binding();
		};
		if (ending) {
			@this.add_lifetime(fact_node_kind::lifetime_end, ending, expression, @exceptional);
			@this.connect(exceptional, exception_target, fact_edge_kind::exceptional, nullptr);
		};
		@this.connect(node, exceptional, fact_edge_kind::exceptional, nullptr);
	};
	var Entity* owner = nullptr;
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() != type_kind::reference) {
		@owner = expression->entity();
	}
	else if (kind == semantic_kind::construction && expression->size() > 1) {
		@owner = expression->item(1)->owned_binding();
	};
	if (owner) {
		usize begin = 0;
		@this.add_lifetime(fact_node_kind::lifetime_begin, owner, expression, @begin);
		@this.connect(current, begin, fact_edge_kind::next, nullptr);
		@current = begin;
	};
	if ((kind == semantic_kind::relocation || kind == semantic_kind::destruction) && expression->size()) {
		@owner = expression->item(0)->owned_binding();
		if (owner) {
			usize end = 0;
			@this.add_lifetime(fact_node_kind::lifetime_end, owner, expression, @end);
			@this.connect(current, end, fact_edge_kind::next, nullptr);
			@current = end;
		};
	};
	usize target = fact_no_node();
	if (kind == semantic_kind::return_value) {
		@target = this.return_target;
		var SemanticExpression* temporary = fact_temporary_source(expression->item(0), true);
		if (temporary) {
			@this.cleanup_target(temporary, target, exception_target, @target);
		};
	}
	else if (kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow) {
		@this.connect(node, exception_target, fact_edge_kind::exceptional, nullptr);
		@current = fact_no_node();
		return;
	}
	else if (kind == semantic_kind::break_loop) {
		@target = break_target;
	}
	else if (kind == semantic_kind::continue_loop) {
		@target = continue_target;
	};
	if (target != fact_no_node()) {
		@this.connect(node, target, fact_edge_kind::next, nullptr);
		@current = fact_no_node();
	};
};

fn strtod(char* text, var char var** end) -> f64;

struct SwitchAnalysis;

struct ConversionSelection {
	var Entity* selected;
	var Entity* conflict;

	fn unique(ConversionSelection& this) -> var Entity*;
};

enum declaration_collection {
	owners;
	complete;
};

struct PendingDeclaration {
	var Scope* scope;
	var Syntax* syntax;
	access_kind access;
};

struct Analyzer {
	fn Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits);

	fn set_progress(var Analyzer& this, CompilerProgress progress);
	fn report_progress(Analyzer& this, rt::string_view phase, usize completed, usize total, Entity& entity);
	fn set_editor(var Analyzer& this, bool enabled);
	fn analyze(var Analyzer& this, rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit>;
	fn editor_template_context(var Analyzer& this, var SemanticUnit& unit, var SourceFile& source, usize anchor, var Syntax& arguments, var rt::string& label) -> CompilationResult;
	fn analyze_into(var Analyzer& this, var SemanticUnit& unit, rt::buffer<rt::unique<Syntax>>& syntax) -> CompilationResult;
	fn error(var Analyzer& this, var Syntax* syntax, rt::string_view message);
	fn report(var Analyzer& this, Token& token, rt::string_view message);
	fn note(var Analyzer& this, Token& token, rt::string_view message);
	fn deleted_function(var Analyzer& this, Token& token, Entity& function);
	fn cancelled(Analyzer& this) -> bool;
	fn failed(Analyzer& this) -> bool;
	fn infer_variable(var Analyzer& this, var Syntax& declaration, SemanticExpression& initializer) -> Type*;
	fn type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type*;
	fn lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity*;
	fn primitive_scope(var Analyzer& this, Type& type, Token& location) -> var Entity*;
	fn primitive_constants(var Analyzer& this, var Entity& owner) -> CompilationResult;
	fn collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> CompilationResult;
	fn resolve(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> CompilationResult;
	fn expression(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn function_body(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn global_initializer(var Analyzer& this, var Entity& entity) -> CompilationResult;
	fn constant_integer(var Analyzer& this, SemanticExpression& expression, var u64& result) -> bool;
	fn exception_spec(var Analyzer& this, var Scope& scope, var Syntax& syntax, var bool& nonthrowing) -> CompilationResult;
	fn potentially_throwing(Analyzer& this, SemanticExpression& expression) -> bool;
	fn prepare_exception_spec(var Analyzer& this, SemanticExpression& expression) -> CompilationResult;
	fn prepare_exception_type(var Analyzer& this, Type* type) -> CompilationResult;
	fn prepare_function_exception(var Analyzer& this, var Entity& entity) -> CompilationResult;
	fn validate_dispatch_syntax(var Analyzer& this, var Syntax& syntax, bool class_scope) -> CompilationResult;

	fn semantic_unit(Analyzer& this) -> var SemanticUnit*;
	fn template_engine(var Analyzer& this) -> var TemplateEngine*;
	fn type_store(Analyzer& this) -> var TypeStore*;
	fn accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool;
	fn accessible_at(Analyzer& this, Entity& entity, var Scope& scope, Token& use) -> bool;

private:
	fn inline_record_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type*;
	fn collect_member_pack(var Analyzer& this, var Scope& scope, var Syntax& declaration) -> CompilationResult;
	fn resolve_member_pack(var Analyzer& this, var Entity& members) -> CompilationResult;
	fn expand_member_packs(var Analyzer& this, var Entity& record) -> CompilationResult;
	fn prepare_variant_special(var Analyzer& this, var Entity& function) -> CompilationResult;
	fn configure_variant_default(var Analyzer& this, var Entity& record) -> CompilationResult;
	fn null_member_pack(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity* pack, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn variant_cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* target, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected, bool propagate) -> rt::unique<SemanticExpression>;
	fn aggregate_access(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn construct_variant(var Analyzer& this, var Syntax& syntax, Type* type, var rt::buffer<rt::unique<SemanticExpression>>& raw, var bool& handled) -> rt::unique<SemanticExpression>;
	fn pack_declaration(var Analyzer& this, var Scope& scope, var Syntax& syntax, var TemplatePack var*& pack) -> CompilationResult;
	fn pack_fold(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn fold_binding(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity var*& binding) -> CompilationResult;
	fn binary_values(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> left, rt::unique<SemanticExpression> right, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	VariantFlowFacts variant_facts;
	CompilerProgress progress;
	bool editor;
	declaration_collection collection;
	rt::buffer<PendingDeclaration> pending_declarations;
	fn resolve_impl(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn recovery_operand(Analyzer& this, Syntax& syntax) -> bool;
	fn expression_impl(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn expression_form(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn names_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn size_query(var Analyzer& this, var Syntax& syntax, Type& type) -> rt::unique<SemanticExpression>;
	fn selection(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn label(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn prepare_expression(var Analyzer& this, var SemanticExpression* expression) -> CompilationResult;
	fn prepare_lifetime(var Analyzer& this, Type* type) -> CompilationResult;
	fn prepare_default(var Analyzer& this, Type* type) -> CompilationResult;
	fn prepare_copy(var Analyzer& this, Type* type) -> CompilationResult;
	fn prepare_copy_assignment(var Analyzer& this, Type* type) -> CompilationResult;
	fn field_initializer(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn resolve_bases(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn build_dispatch(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn supply_special_functions(var Analyzer& this, var Entity* entity) -> CompilationResult;
	fn contextual_argument(var Analyzer& this, var Scope& scope, var Syntax& syntax, TypeUse& use, rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression>;
	fn contextual_arguments(var Analyzer& this, var Scope& scope, var Syntax& syntax, var SemanticExpression& callable, var rt::buffer<rt::unique<SemanticExpression>>& values) -> CompilationResult;
	fn supply_special(var Analyzer& this, var Entity* entity, function_role role, token_kind operation, Type* source, function_definition definition) -> var Entity*;
	fn node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression>;
	fn unary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn binary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn call(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression>;
	fn cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn component(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn member_value(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> object, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn construct(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* type, var Syntax& arguments) -> rt::unique<SemanticExpression>;
	fn construct_values(var Analyzer& this, var Syntax& syntax, Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression>;
	fn zero_initialize(var Analyzer& this, var Syntax& syntax, Type* type) -> rt::unique<SemanticExpression>;
	fn initialize(var Analyzer& this, var Syntax& syntax, Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression>;
	fn select_candidates(var Analyzer& this, rt::buffer<var Entity*>& candidates, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn invoke(var Analyzer& this, var Syntax& syntax, var Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn select(var Analyzer& this, var Entity* group, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn convert(var Analyzer& this, rt::unique<SemanticExpression> value, rt::optional_ref<const Type>& expected, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn discarded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression>;
	fn argument_rank(var Analyzer& this, SemanticExpression& value, Type& expected) -> i32;
	fn implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> var Entity*;
	fn select_implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> ConversionSelection;
	fn conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> var Entity*;
	fn select_conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> ConversionSelection;

	fn compatible(Analyzer& this, Type* source, Type* target) -> bool;
	fn builtin_rank(Analyzer& this, SemanticExpression& value, Type& expected) -> i32;

	var TypeStore* types;
	var Diagnostics* diagnostics;
	var SemanticUnit* unit;
	var Entity* function;
	u32 pointer_bits;
	usize loop_depth;
	var SwitchAnalysis* active_switch;
	TemplateEngine templates;
	var Entity* folded_pack;
	var Entity* folded_argument;
	var Entity* folded_field_pack;
	usize folded_field_index;
};

fn Analyzer::error(var Analyzer& this, var Syntax* syntax, rt::string_view message) {
	Token token;

	if (syntax) {
		@token = syntax->token();
	};

	@this.diagnostics->error(token, message);
};

fn Analyzer::node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression> {
	Token location;

	if (syntax) {
		@location = syntax->token();
	};

	return SemanticExpression::make($kind, type, location);
};


fn Analyzer::lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@scope, @*name.left());

		if (owner && !this.accessible_at(*owner, @scope, name.token())) {
			@this.error(&@name, "qualified name owner is not accessible from this scope");
			return nullptr;
		};
		if (!owner || !(@this.resolve((var Entity*(owner)))).has<void>()) {
			return nullptr;
		};

		var Entity* associated = owner->member_owner();

		if (!associated && owner->denotes_type() && owner->type()) {
			@associated = @this.primitive_scope(*owner->type(), owner->token());
		};

		@owner := associated;

		if (!owner) {
			return nullptr;
		};

		@this.unit->record_receiver(@scope, @name, @*owner);

		var Syntax* member = name.right();

		if (member->kind() == syntax_kind::template_apply) {
			if (!owner->members()->local(member->callable()->token().text())) {
				return nullptr;
			};

			return @this.templates.apply(@this, @*owner->members(), @scope, @*member);
		};

		bool ambiguous = false;
		var Entity* result = owner->members()->local_from(member->token().text(), name.token().source, @ambiguous);
		if (!result && owner->kind() == entity_kind::record) {
			@result = owner->find_member(member->token().text());
		};
		if (ambiguous) {
			@this.error(&@name, "ambiguous name from imported modules");
			return nullptr;
		};
		if (result && result == this.folded_pack) {
			return this.folded_argument;
		};
		return $result;
	};

	if (name.kind() == syntax_kind::template_apply) {
		return @this.templates.apply(@this, @scope, @scope, @name);
	};

	bool ambiguous = false;
	var Entity* result = scope.lookup_from(name.token().text(), name.token().source, @ambiguous);
	if (ambiguous) {
		@this.error(&@name, "ambiguous name from imported modules");
		return nullptr;
	};

	if (result) {
		return result;
	};

	Type* primitive = this.types->find_primitive(name.token().text());

	if (!primitive) {
		return nullptr;
	};

	return @this.primitive_scope(*primitive, name.token());
};

fn Analyzer::integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> CompilationResult {
	if (syntax.kind() != syntax_kind::number) {
		return compilation_error();
	};

	var text = syntax.token().text();
	u64 value = 0;
	u64 base = 10;
	usize index = 0;

	if (text.size() > 2 && text.data()[0] == '0') {
		if (text.data()[1] == 'x' || text.data()[1] == 'X') {
			@base = 16;
			@index = 2;
		}
		else if (text.data()[1] == 'b' || text.data()[1] == 'B') {
			@base = 2;
			@index = 2;
		};
	};

	while (index < text.size()) {
		char character := text.data()[index];
		@index = index + 1;

		if (character == '_') {
			continue;
		};

		u64 digit = 0;

		if (character >= '0' && character <= '9') {
			@digit = static_cast<u64>(character - '0');
		}
		else if (character >= 'a' && character <= 'f') {
			@digit = static_cast<u64>(character - 'a') + 10;
		}
		else if (character >= 'A' && character <= 'F') {
			@digit = static_cast<u64>(character - 'A') + 10;
		}
		else {
			return compilation_error();
		};

		if (digit >= base || value > (u64::max - digit) / base) {
			return compilation_error();
		};

		@value = value * base + digit;
	};

	@result = $value;

};

fn Analyzer::type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type* {
	if (syntax.kind() == syntax_kind::absent) {
		return nullptr;
	};

	syntax_kind kind = syntax.kind();
	if (kind == syntax_kind::record) {
		return @this.inline_record_type(@scope, @syntax);
	};

	if (kind == syntax_kind::type_grouping) {
		return @this.type(@scope, @*syntax.item(0));
	};
	if (kind == syntax_kind::type_tuple || kind == syntax_kind::type_variant) {
		return @this.templates.aggregate_type(@this, @scope, @syntax);
	};

	if (kind == syntax_kind::type_auto) {
		Type* element = @this.type(@scope, @*syntax.designated_type());
		Type* actual = this.templates.qualifier(@scope, @syntax);

		if (!element || !actual) {
			if (this.failed()) {
				return nullptr;
			};
			@this.error(&@syntax, "automatic qualification requires a deduced parameter binding");

			return nullptr;
		};

		return @this.types->qualified(*element, actual->qualifier());
	};

	if (kind == syntax_kind::type_name) {
		return @this.type(@scope, @*syntax.designated_type());
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		var Entity* entity = @this.lookup(@scope, @syntax);
		if (this.failed()) {
			return nullptr;
		};

		if (kind == syntax_kind::name && !entity) {
			Type* builtin = this.types->find_primitive(syntax.token().text());

			if (builtin) {
				return $builtin;
			};
		};

		if (!entity || !entity->denotes_type()) {
			var message = DiagnosticMessage();
			if (!entity) {
				@message.text("unknown type name '");
			}
			else {
				@message.text("name does not denote a type: '");
			};
			diagnostic_name(@message, syntax);
			@message.text("'");
			@this.report(syntax.token(), message.view());
			if (entity) {
				@this.note(entity->token(), "referenced declaration is here");
			};

			return nullptr;
		};

		if (!this.accessible_at(*entity, @scope, syntax.token())) {
			var message = DiagnosticMessage();
			@message.text("type '");
			diagnostic_entity(@message, *entity);
			@message.text("' is not accessible from this scope");
			@this.report(syntax.token(), message.view());
			@this.note(entity->token(), "type is declared here");

			return nullptr;
		};

		if (!(@this.resolve((var Entity*(entity)))).has<void>()) {
			return nullptr;
		};

		@this.unit->record_name(@this, @scope, @syntax, @*entity, 2);
		return entity->type();
	};

	if (kind == syntax_kind::type_function) {
		rt::buffer<Type*> parameters;
		parameter_arity arity = parameter_arity::fixed;
		var Syntax* list = syntax.function_type_parameters();
		usize index = 0;
		while (list && index < list->size()) {
			var Syntax* parameter = list->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			if (parameter->kind() == syntax_kind::parameter) {
				@parameter = parameter->parameter_type();
			};

			Type* resolved = @this.type(@scope, @*parameter);

			if (!resolved) {
				return nullptr;
			};

			@parameters.push_back(resolved);

			@index = index + 1;
		};

		Type* result = @this.type(@scope, @*syntax.function_type_result());

		if (!result) {
			@result = this.types->find_primitive("void");
		};

		bool nonthrowing = false;
		if (!(@this.exception_spec(@scope, @*syntax.item(2), @nonthrowing)).has<void>()) {
			return nullptr;
		};
		return @this.types->function($result, $parameters, parameter_arity(arity), $nonthrowing);
	};

	if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array || (kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
		Type* element = @this.type(@scope, @*syntax.designated_type());

		if (!element) {
			return nullptr;
		};

		if ((kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
			var Syntax* condition = syntax.qualifier_condition();

			if (condition && condition->kind() != syntax_kind::absent) {
				var Entity* parameter = nullptr;
				var Scope* context = &@scope;

				while (context && !parameter) {
					var Entity* owner = context->owner();

					if (owner && owner->kind() == entity_kind::function) {
						usize index = 0;
						while (index < owner->parameters().size()) {
							var Entity* candidate := owner->parameters().data()[index];

							if (candidate->name() == condition->token().text()) {
								@parameter := candidate;
								break;
							};

							@index = index + 1;
						};
					};

					@context = context->parent();
				};

				if (!parameter) {
					@parameter = @this.lookup(@scope, @*condition);
				};

				if (!parameter || !parameter->type()) {
					if (this.failed()) {
						return nullptr;
					};
					var message = DiagnosticMessage();
					@message.text("conditional qualification requires a named parameter; '");
					diagnostic_name(@message, *condition);
					@message.text("' does not provide a parameter type");
					@this.report(condition->token(), message.view());

					return nullptr;
				};

				Type* actual = parameter->type();

				if (actual->kind() == type_kind::reference) {
					@actual = actual->element();
				};

				if (actual->qualifier() == type_qualifier::immutable) {
					return @this.types->qualified(*element, type_qualifier::immutable);
				};
				return $element;
			};

			if (kind == syntax_kind::type_mutable) {
				return $element;
			};
			return @this.types->qualified(*element, type_qualifier::immutable);
		};

		if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference) {
			if (!syntax.designated_type()->explicitly_qualified()) {
				@element = @this.types->qualified(*element, type_qualifier::immutable);
				if (!element) {
					return nullptr;
				};
			};
		};
		if (kind == syntax_kind::type_pointer) {
			return @this.types->pointer(element);
		};

		if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::reference) {
			var message = DiagnosticMessage();
			@message.text("cannot form ");
			if (kind == syntax_kind::type_reference) {
				@message.text("a reference to '");
			}
			else {
				@message.text("an array of '");
			};
			diagnostic_type(@message, *element);
			@message.text("'; the element type has no object storage");
			@this.report(syntax.token(), message.view());

			return nullptr;
		};

		if (kind == syntax_kind::type_reference) {
			return @this.types->reference(element);
		};

		u64 count = 0;
		var extent = @this.expression(@scope, @*syntax.array_extent(), rt::optional_ref<const Type>());

		if (!extent.get()) {
			return nullptr;
		};

		if (!extent.get()->type()->kind().is_integer()) {
			var message = DiagnosticMessage();
			@message.text("array extent shall be a positive integer constant; received type '");
			diagnostic_type(@message, *extent.get()->type());
			@message.text("'");
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!@this.constant_integer(*extent.get(), @count)) {
			if (this.failed()) {
				return nullptr;
			};
			var message = DiagnosticMessage();
			@message.text("array extent shall be a positive integer constant; expression beginning with ");
			@message.quoted(syntax.array_extent()->token().text());
			@message.text(" of type '");
			diagnostic_type(@message, *extent.get()->type());
			@message.text("' is not constant");
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!count) {
			@this.report(syntax.array_extent()->token(), "array extent shall be a positive integer constant; received 0");

			return nullptr;
		};

		if (extent.get()->type()->kind() == type_kind::signed_integer && count & (u64(1) << (static_cast<u64>(extent.get()->type()->bits()) - 1))) {
			var message = DiagnosticMessage();
			@message.text("array extent shall be positive; received -");
			@message.number(u64(0) - u64(extent.get()->type()->signed_value(count)));
			@this.report(syntax.array_extent()->token(), message.view());

			return nullptr;
		};

		return @this.types->array(element, $count);
	};

	var message = DiagnosticMessage();
	@message.text("unsupported type syntax beginning with ");
	@message.quoted(syntax.token().text());
	@this.report(syntax.token(), message.view());

	return nullptr;
};

fn Analyzer::collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> CompilationResult {
	var Scope* scope_cursor = &@scope;
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::unit || kind == syntax_kind::brace || kind == syntax_kind::list) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!(@this.collect(@*scope_cursor, @*syntax.item(index))).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};

		return;
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return;
	};
	if (kind == syntax_kind::pack_signature_declaration) {
		return @this.templates.collect_signature(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::access_label) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record) {
			var message = DiagnosticMessage();
			@message.text("access label ");
			@message.quoted(syntax.token().text());
			@message.text(" requires class scope; current scope is ");
			if (scope_cursor->owner()) {
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(" ");
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text("module scope");
			};
			@this.report(syntax.token(), message.view());
			return compilation_error();
		};

		Token token = syntax.token();

		if (token.is("private")) {
			@scope_cursor->set_access(access_kind::private_access);
		}
		else if (token.is("protected")) {
			@scope_cursor->set_access(access_kind::protected_access);
		}
		else {
			@scope_cursor->set_access(access_kind::public_access);
		};

		return;
	};

	if (kind == syntax_kind::ambiguity) {
		var Syntax* declaration = nullptr;
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			syntax_kind category = candidate->kind();

			if (category == syntax_kind::variable || category == syntax_kind::function || category == syntax_kind::record || category == syntax_kind::enumeration || category == syntax_kind::namespace_body || category == syntax_kind::template_declaration || category == syntax_kind::using_alias) {
				if (declaration) {
					var message = DiagnosticMessage();
					@message.text("declaration has multiple unresolved interpretations; source begins with ");
					@message.quoted(syntax.token().text());
					if (scope_cursor->owner()) {
						@message.text(" in ");
						diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
						@message.text(" ");
						diagnostic_entity(@message, *scope_cursor->owner());
					};
					@this.report(syntax.token(), message.view());
					return compilation_error();
				};

				@declaration := candidate;
			};

			@index = index + 1;
		};

		if (!declaration) {
			var message = DiagnosticMessage();
			@message.text("declaration context has no declaration interpretation; source begins with ");
			@message.quoted(syntax.token().text());
			if (scope_cursor->owner()) {
				@message.text(" in ");
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(" ");
				diagnostic_entity(@message, *scope_cursor->owner());
			};
			@this.report(syntax.token(), message.view());
			return compilation_error();
		};

		return @this.collect(@*scope_cursor, @*declaration);
	};

	var Syntax* candidate = &@syntax;
	if (kind == syntax_kind::template_declaration) {
		@candidate = syntax.template_declaration();
	};
	if (this.collection == declaration_collection::owners && candidate->kind() == syntax_kind::function && candidate->function_name()->kind() == syntax_kind::qualified_name) {
		PendingDeclaration pending;
		@pending.scope = scope_cursor;
		@pending.syntax = &@syntax;
		@pending.access = scope_cursor->access();
		@this.pending_declarations.push_back($pending);
		return;
	};

	if (kind == syntax_kind::template_declaration) {
		if (!(@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)).has<void>()) {
			return compilation_error();
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::function && this.templates.qualifier_dependent(@syntax)) {
		if (!(@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)).has<void>()) {
			return compilation_error();
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::variable && syntax.variable_type()->kind() == syntax_kind::pack_expansion) {
		return @this.collect_member_pack(@*scope_cursor, @syntax);
	};
	var Syntax* name = nullptr;
	entity_kind category = entity_kind::global;
	var Syntax* members = nullptr;

	if (kind == syntax_kind::function) {
		@name = syntax.function_name();
		@category = entity_kind::function;
	}
	else if (kind == syntax_kind::variable) {
		@name = syntax.variable_name();

		if (@this.templates.signature(@this, @*scope_cursor, @*syntax.variable_type())) {
			@category = entity_kind::pack_binding;
		}
		else if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
			@category = entity_kind::field;
		};
	}
	else if (kind == syntax_kind::record) {
		@name = syntax.record_name();
		@category = entity_kind::record;
		@members = syntax.record_members();
	}
	else if (kind == syntax_kind::enumeration) {
		@name = syntax.enum_name();
		@category = entity_kind::enumeration;
		@members = syntax.enum_members();
	}
	else if (kind == syntax_kind::enumerator) {
		@name = syntax.item(0);
		@category = entity_kind::enumerator;
	}
	else if (kind == syntax_kind::namespace_body) {
		@name = syntax.namespace_name();
		@category = entity_kind::namespace_body;
		@members = syntax.namespace_members();
	}
	else if (kind == syntax_kind::using_alias) {
		@name = syntax.alias_name();
		@category = entity_kind::alias;
	}
	else {
		var message = DiagnosticMessage();
		@message.text("declaration required at module or record scope; source begins with ");
		@message.quoted(syntax.token().text());
		if (scope_cursor->owner()) {
			@message.text(" in ");
			diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
			@message.text(" ");
			diagnostic_entity(@message, *scope_cursor->owner());
		};
		@this.report(syntax.token(), message.view());
		return compilation_error();
	};

	if (!name || name->kind() == syntax_kind::absent) {
		var message = DiagnosticMessage();
		@message.text("declaration requires an unqualified name in its owning scope; ");
		diagnostic_entity_kind(@message, category);
		@message.text(" declaration begins with ");
		@message.quoted(syntax.token().text());
		@this.report(syntax.token(), message.view());
		return compilation_error();
	};

	access_kind declaration_access = scope_cursor->access();
	if (category == entity_kind::namespace_body && name->kind() == syntax_kind::template_apply) {
		@this.error(name, "namespace declaration cannot have template arguments");
		return compilation_error();
	};

	if (name->kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@*scope_cursor, @*name->left());

		if (!owner || !owner->members()) {
			if (!this.failed()) {
				var message = DiagnosticMessage();
				@message.text("cannot declare '");
				diagnostic_name(@message, *name);
				@message.text("': owner '");
				diagnostic_name(@message, *name->left());
				if (owner) {
					@message.text("' is a ");
					diagnostic_entity_kind(@message, owner->kind());
					@message.text(" without a member scope");
				}
				else {
					@message.text("' is not declared");
				};
				@this.report(name->token(), message.view());
				if (owner) {
					@this.note(owner->token(), "owner is declared here");
				};
			};
			return compilation_error();
		};
		if (category == entity_kind::namespace_body && owner->kind() != entity_kind::namespace_body) {
			@this.error(name, "namespace declaration requires a namespace owner");
			return compilation_error();
		};

		@this.unit->record_name(@this, @*scope_cursor, @*name->left(), @*owner, 2);
		@scope_cursor = owner->members();
		@name = name->right();
	};

	var Entity* existing = scope_cursor->local_declaration(name->token().text(), name->token().source, entity_kind(category));

	if (existing && category != entity_kind::function) {
		if (existing->kind() != category) {
			var message = DiagnosticMessage();
			@message.text("conflicting declaration kind for ");
			@message.quoted(name->token().text());
			@message.text(": declaring ");
			diagnostic_entity_kind(@message, category);
			@message.text(" after ");
			diagnostic_entity_kind(@message, existing->kind());
			@this.report(name->token(), message.view());
			@this.note(existing->token(), "previous declaration is here");
			return compilation_error();
		};

		if (category == entity_kind::record) {
			if (members->kind() != syntax_kind::noop) {
				if (existing->declaration()->record_members()->kind() != syntax_kind::noop) {
					var message = DiagnosticMessage();
					@message.text("duplicate record definition for ");
					@message.quoted(name->token().text());
					@message.text(" (");
					diagnostic_entity_kind(@message, category);
					@message.text(")");
					@this.report(name->token(), message.view());
					@this.note(existing->token(), "previous record definition is here");
					return compilation_error();
				};

				@existing->replace_declaration(&@syntax);
			};
		}
		else if (category != entity_kind::namespace_body) {
			var message = DiagnosticMessage();
			@message.text("duplicate declaration of ");
			@message.quoted(name->token().text());
			@message.text(" (");
			diagnostic_entity_kind(@message, category);
			@message.text(")");
			@this.report(name->token(), message.view());
			@this.note(existing->token(), "previous declaration is here");
			return compilation_error();
		};
	};

	var Entity* entity = existing;

	if (!entity || category == entity_kind::function) {
		@entity = @this.unit->create_entity(entity_kind(category), name->token(), &@syntax, scope_cursor);

		if (entity) {
			@entity->set_access(access_kind(declaration_access));
		};
	};

	if (!entity) {
		@this.error(&@syntax, "out of memory storing declaration");
		return compilation_error();
	};

	if (members) {
		var Scope* nested = entity->members();

		if (!nested) {
			@nested = @this.unit->create_scope(scope_cursor, (var Entity*(entity)));
			@entity->set_members((var Scope*(nested)));
		};

		if (!nested || !(@this.collect(@*nested, @*members)).has<void>()) {
			return compilation_error();
		};
	};

	if (entity->kind() == entity_kind::field) {
		@entity->set_index(scope_cursor->owner()->fields().size());

		@scope_cursor->owner()->add_field(entity);
		return;
	};

	if (entity->kind() == entity_kind::function && name->kind() == syntax_kind::unary && name->token().kind == token_kind::op_tilde) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record || !name->operand()->token().same(scope_cursor->owner()->token())) {
			var message = DiagnosticMessage();
			@message.text("destructor '");
			@message.text("~");
			diagnostic_name(@message, *name->operand());
			@message.text("' shall name its owning class");
			if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
				@message.text(" ");
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text("; declaration is outside class scope");
			};
			@this.report(name->token(), message.view());
			return compilation_error();
		};

		@scope_cursor->owner()->set_destructor(entity);
	};

};

fn Analyzer::Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits) {
	@this.types = &@types;
	@this.diagnostics = &@diagnostics;
	@this.pointer_bits = $pointer_bits;

	@types.initialize_primitives(this.pointer_bits);
};

fn Analyzer::semantic_unit(Analyzer& this) -> var SemanticUnit* {
	return this.unit;
};

fn Analyzer::type_store(Analyzer& this) -> var TypeStore* {
	return this.types;
};

fn Analyzer::accessible_at(Analyzer& this, Entity& entity, var Scope& scope, Token& use) -> bool {
	Token declaration = entity.token();
	if (declaration.source && declaration.source->imported()) {
		if (declaration.source->test_access()) {
			return true;
		};
		if ((!use.source || use.source->module_name() != declaration.source->module_name()) && !entity.module_exported()) {
			return false;
		};
	};
	return entity.accessible_from(@scope);
};

fn Analyzer::accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool {
	if (this.function) {
		return this.accessible_at(entity, @scope, this.function->token());
	};
	var Scope* cursor = &@scope;
	while (cursor) {
		if (cursor->owner()) {
			return this.accessible_at(entity, @scope, cursor->owner()->token());
		};
		@cursor = cursor->parent();
	};
	Token use;
	return this.accessible_at(entity, @scope, use);
};

fn Analyzer::set_editor(var Analyzer& this, bool enabled) {
	@this.editor = $enabled;
};

fn Analyzer::recovery_operand(Analyzer& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::error_expression) {
		return true;
	};
	if (syntax.kind() != syntax_kind::unary && syntax.kind() != syntax_kind::binary && syntax.kind() != syntax_kind::index && syntax.kind() != syntax_kind::cast && syntax.kind() != syntax_kind::grouping) {
		return false;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.recovery_operand(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn Analyzer::set_progress(var Analyzer& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn Analyzer::report_progress(Analyzer& this, rt::string_view phase, usize completed, usize total, Entity& entity) {
	DiagnosticMessage detail;
	diagnostic_entity(@detail, entity);
	this.progress.report(phase, completed, total, detail.view());
};

// Context inputs describe already evaluated scalar arguments. Version numbers
// are caller-local and are translated to fresh formal parameter versions.
struct FactContextInput {
	var Entity* parameter;
	FactValue value;
};

struct FactContextRelation {
	usize left;
	usize right;
	token_kind operation;
};

struct FactContextRequest {
	var SemanticExpression* call;
	var Entity* function;
	rt::buffer<FactContextInput> inputs;
	rt::buffer<FactContextRelation> relations;
};

fn fact_context_condition(FactGraph& graph, SemanticExpression* expression) -> bool {
	usize index = 0;
	while (index < graph.edges.size()) {
		FactEdge& edge = graph.edges.data()[index];
		if (edge.condition == expression && (edge.kind == fact_edge_kind::when_true || edge.kind == fact_edge_kind::when_false)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_context_check_walk(SemanticExpression* expression, usize depth, usize calls, var usize& budget, var rt::buffer<var Entity*>& visited) -> bool {
	if (!expression || depth > 64 || !budget) {
		return false;
	};
	@budget = budget - 1;
	if (expression->kind() == semantic_kind::conditional || expression->kind() == semantic_kind::variant_cast || expression->kind() == semantic_kind::while_loop || expression->kind() == semantic_kind::for_loop) {
		return true;
	};
	var Entity* target = expression->entity();
	if (target && target->kind() == entity_kind::function) {
		@target = target->canonical();
	};
	if (expression->kind() == semantic_kind::call && target && target->dispatch() == function_dispatch::ordinary && target->body() && calls < 8) {
		usize prior = 0;
		while (prior < visited.size() && visited.data()[prior] != target) {
			@prior = prior + 1;
		};
		if (prior == visited.size()) {
			@visited.push_back(target);
			bool found = fact_context_check_walk(target->body(), 0, calls + 1, @budget, @visited);
			@visited.pop_back();
			if (found) {
				return true;
			};
		};
	};
	usize index = 0;
	while (index < expression->size()) {
		if (fact_context_check_walk(expression->item(index), depth + 1, calls, @budget, @visited)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn fact_context_has_check(SemanticExpression* expression, usize depth) -> bool {
	usize budget = 512;
	rt::buffer<var Entity*> visited;
	return fact_context_check_walk(expression, depth, 0, @budget, @visited);
};

fn fact_context_operation(usize index) -> token_kind {
	switch (index) {
		case 0: return token_kind::op_less;
		case 1: return token_kind::op_less_equal;
		case 2: return token_kind::op_greater;
		case 3: return token_kind::op_greater_equal;
		case 4: return token_kind::op_equal;
	};
	return token_kind::op_not_equal;
};

fn fact_context_comparison(token_kind operation, FactValue& left, FactValue& right, FactState& state) -> fact_truth {
	fact_truth result = fact_compare_values(operation, left, right);
	usize index = 0;
	while (result == fact_truth::unknown && left.version && right.version && index < state.relations.size()) {
		FactRelation& relation = state.relations.data()[index];
		if (relation.left == left.version && relation.right == right.version) {
			if (relation.operation == operation) {
				return fact_truth::proven;
			};
			if (relation.operation == fact_inverse(operation)) {
				return fact_truth::disproven;
			};
		};
		@index = index + 1;
	};
	return result;
};

fn InferredFacts::context_seed(var InferredFacts& this, var FactState& state) {
	usize input = 0;
	while (input < this.context_inputs.size()) {
		FactContextInput& seed = this.context_inputs.data()[input];
		usize place = 0;
		while (place < this.places.size()) {
			FactPlace& storage = this.places.data()[place];
			if (!storage.parent && storage.root == seed.parameter) {
				var FactValue& value = @((@state.places).data()[place]);
				@value.range := seed.value.range;
				@value.alternative = seed.value.alternative;
			};
			@place = place + 1;
		};
		@input = input + 1;
	};
	usize index = 0;
	while (index < this.context_relations.size()) {
		FactContextRelation& seed = this.context_relations.data()[index];
		FactRelation relation;
		@relation.operation = seed.operation;
		usize place = 0;
		while (place < this.places.size()) {
			FactPlace& storage = this.places.data()[place];
			if (!storage.parent) {
				if (storage.root == this.context_inputs.data()[seed.left].parameter) {
					@relation.left = state.places.data()[place].version;
				};
				if (storage.root == this.context_inputs.data()[seed.right].parameter) {
					@relation.right = state.places.data()[place].version;
				};
			};
			@place = place + 1;
		};
		if (relation.left) {
			if (relation.right) {
				@state.relations.push_back($relation);
			};
		};
		@index = index + 1;
	};
};

fn InferredFacts::context_override(var InferredFacts& this, var SemanticExpression& expression, inferred_override_kind kind, u64 value) {
	InferredExpressionFact fact;
	@fact.expression = &@expression;
	@fact.kind = $kind;
	@fact.value = $value;
	@this.context_output->overrides.push_back($fact);
};

fn InferredFacts::context_capture(var InferredFacts& this, var SemanticExpression& call, FactState& state) {
	var Entity* function = call.entity();
	if (function) {
		@function = function->canonical();
	};
	if (this.context_requests.size() >= 512 || !function || function == this.analyzed_function || function->dispatch() != function_dispatch::ordinary || function->role() != function_role::ordinary || function->definition() != function_definition::user_defined || !function->body() || function->parameters().size() > 16 || call.size() != 2 || call.item(0)->kind() != semantic_kind::name || (!call.item(0)->entity() || call.item(0)->entity()->canonical() != function) || call.item(1)->size() != function->parameters().size() || !fact_context_has_check(function->body(), 0)) {
		return;
	};
	rt::unique<FactContextRequest> request = rt::unique<FactContextRequest>::make();
	@request.get()->call = &@call;
	@request.get()->function = function;
	bool useful = false;
	usize parameter = 0;
	while (parameter < function->parameters().size()) {
		var Entity* formal = function->parameters().data()[parameter];
		Type* type = formal->type();
		// Reference-field seeding needs an alias partition. Until then, keep
		// reference-receiver and reference-parameter calls on their original ABI.
		if (type->kind() == type_kind::reference) {
			return;
		};
		if (type->representation()->kind().is_integer() || aggregate_access_kind(type) == 2) {
			FactContextInput input;
			@input.parameter = formal;
			@input.value = state.value(call.item(1)->item(parameter));
			if (input.value.alternative || input.value.range.available != fact_truth::unknown && (input.value.range.lower || input.value.range.upper != fact_limit(type) || input.value.range.sign == integer_range_sign::negative)) {
				@useful = true;
			};
			@request.get()->inputs.push_back($input);
		};
		@parameter = parameter + 1;
	};
	usize left = 0;
	while (left < request.get()->inputs.size()) {
		usize right = 0;
		while (right < request.get()->inputs.size()) {
			if (left != right && request.get()->inputs.data()[left].parameter->type()->representation()->kind().is_integer() && request.get()->inputs.data()[right].parameter->type()->representation()->kind().is_integer()) {
				usize operation = 0;
				while (operation < 6) {
					token_kind predicate = fact_context_operation(operation);
					if (fact_context_comparison(predicate, request.get()->inputs.data()[left].value, request.get()->inputs.data()[right].value, state) == fact_truth::proven) {
						FactContextRelation relation;
						@relation.left = left;
						@relation.right = right;
						@relation.operation = predicate;
						@request.get()->relations.push_back($relation);
						@useful = true;
					};
					@operation = operation + 1;
				};
			};
			@right = right + 1;
		};
		@left = left + 1;
	};
	if (!useful) {
		return;
	};
	@this.context_requests.push_back($request);
};

fn fact_context_equal(InferredFunctionContext& left, InferredFunctionContext& right) -> bool {
	if (left.function != right.function || left.overrides.size() != right.overrides.size() || left.calls.size() != right.calls.size()) {
		return false;
	};
	usize index = 0;
	while (index < left.overrides.size()) {
		InferredExpressionFact& first = left.overrides.data()[index];
		InferredExpressionFact& second = right.overrides.data()[index];
		if (first.expression != second.expression || first.kind != second.kind || first.value != second.value) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < left.calls.size()) {
		if (left.calls.data()[index].expression != right.calls.data()[index].expression || left.calls.data()[index].context != right.calls.data()[index].context) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

struct FactContextPlanner {
	var InferredFacts* root;
	var InferredContextSet* output;
	rt::buffer<var Entity*> active;
	usize attempts;
	fn plan(var FactContextPlanner& this, FactContextRequest& request, var usize& result) -> CompilationResult;
};

fn FactContextPlanner::plan(var FactContextPlanner& this, FactContextRequest& request, var usize& result) -> CompilationResult {
	@result = 0;
	if (this.attempts >= 512 || this.output->contexts.size() >= 256 || this.active.size() >= 32) {
		return;
	};
	usize index = 0;
	while (index < this.active.size()) {
		if (this.active.data()[index] == request.function) {
			return;
		};
		@index = index + 1;
	};
	usize count = 0;
	@index = 0;
	while (index < this.output->contexts.size()) {
		if (this.output->contexts.data()[index].get()->function == request.function) {
			@count = count + 1;
		};
		@index = index + 1;
	};
	if (count >= 16) {
		return;
	};
	@this.attempts = this.attempts + 1;
	rt::unique<InferredFunctionContext> context = rt::unique<InferredFunctionContext>::make();
	@this.active.push_back(request.function);
	@context.get()->function = request.function;
	var worker = InferredFacts(@*this.root->diagnostics);
	@worker.summary_source = &this.root->summary_cache();
	@worker.analyzed_function = request.function;
	@worker.context_output = context.get();
	@index = 0;
	while (index < request.inputs.size()) {
		@worker.context_inputs.push_back(FactContextInput(request.inputs.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < request.relations.size()) {
		@worker.context_relations.push_back(FactContextRelation(request.relations.data()[index]));
		@index = index + 1;
	};
	if (!(@worker.analyze(request.function->body())).has<void>()) {
		return compilation_error();
	};
	@index = 0;
	while (index < worker.context_requests.size()) {
		usize nested = 0;
		if (!(@this.plan(*worker.context_requests.data()[index].get(), @nested)).has<void>()) {
			return compilation_error();
		};
		if (nested) {
			InferredCallBinding binding;
			@binding.expression = worker.context_requests.data()[index].get()->call;
			@binding.context = nested;
			@context.get()->calls.push_back($binding);
		};
		@index = index + 1;
	};
	@this.active.pop_back();
	if (!context.get()->overrides.size() && !context.get()->calls.size()) {
		return;
	};
	@index = 0;
	while (index < this.output->contexts.size()) {
		if (fact_context_equal(*this.output->contexts.data()[index].get(), *context.get())) {
			@result = index + 1;
			return;
		};
		@index = index + 1;
	};
	// Nested planning may have filled the budget while this parent was pending.
	if (this.output->contexts.size() >= 256) {
		return;
	};
	@this.output->contexts.push_back($context);
	@result = this.output->contexts.size();
};

fn fact_build_contexts(var InferredFacts& root, var InferredContextSet& output) -> CompilationResult {
	@output.calls.clear();
	@output.contexts.clear();
	FactContextPlanner planner;
	@planner.root = &@root;
	@planner.output = &@output;
	usize index = 0;
	while (index < root.context_requests.size()) {
		FactContextRequest& request = *root.context_requests.data()[index].get();
		usize context = 0;
		if (!(@planner.plan(request, @context)).has<void>()) {
			return compilation_error();
		};
		if (context) {
			InferredCallBinding binding;
			@binding.expression = request.call;
			@binding.context = context;
			@output.calls.push_back($binding);
		};
		@index = index + 1;
	};
};

fn Analyzer::zero_initialize(var Analyzer& this, var Syntax& syntax, Type* type) -> rt::unique<SemanticExpression> {
	if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function || type->kind() == type_kind::reference) {
		@this.error(&@syntax, "zero initialization requires an object type");
		return rt::unique<SemanticExpression>();
	};
	if (type->kind() == type_kind::named && !(@this.resolve(type->entity())).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	var result = @this.node(semantic_kind::construction, type, &@syntax);
	var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);
	if (!result.get() || !arguments.get() || !(@result.get()->append($arguments)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	return $result;
};

fn Analyzer::construct(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* type, var Syntax& arguments) -> rt::unique<SemanticExpression> {
	if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function || type->kind() == type_kind::reference) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		var message = DiagnosticMessage();
		@message.text("construction requires an object type; ");
		if (type) {
			@message.text("requested type is '");
			diagnostic_type(@message, *type);
			@message.text("'");
		}
		else {
			@message.text("the destination type is unavailable");
		};
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	if (arguments.size() == 1 && arguments.item(0)->kind() == syntax_kind::brace && !arguments.item(0)->size()) {
		return @this.zero_initialize(@*arguments.item(0), type);
	};
	rt::buffer<rt::unique<SemanticExpression>> raw;
	usize index = 0;
	while (index < arguments.size()) {
		var value = rt::unique<SemanticExpression>();
		if (arguments.item(index)->kind() == syntax_kind::brace) {
			@value = @this.node(semantic_kind::deferred_argument, this.types->find_primitive("void"), arguments.item(index));
		}
		else {
			@value = @this.expression(@scope, @*arguments.item(index), rt::optional_ref<const Type>());
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		@raw.push_back($value);

		@index = index + 1;
	};
	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		if (!(@this.resolve(type->entity())).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		var Entity* group = type->entity()->members()->local(type->entity()->name());
		@index = 0;
		while (index < raw.size()) {
			if (raw.data()[index].get()->kind() == semantic_kind::deferred_argument) {
				var Entity* selected = nullptr;
				if (group) {
					@selected = @this.select(group, raw, 1, conversion_mode::explicit_only, @syntax);
				};
				if (!selected || !selected->type_use().has_value()) {
					@this.error(arguments.item(index), "constructor argument block requires a named parameter");
					return rt::unique<SemanticExpression>();
				};
				ParameterUse& parameter = selected->type_use().value().callable().parameters().data()[index + 1];
				var value = @this.contextual_argument(@scope, @*arguments.item(index), parameter.type(), parameter.name());
				if (!value.get()) {
					return rt::unique<SemanticExpression>();
				};
				@(@raw).data()[index] = $value;
			};
			@index = index + 1;
		};
	};

	return @this.construct_values(@syntax, type, $raw);
};

fn Analyzer::construct_values(var Analyzer& this, var Syntax& syntax, Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression> {
	bool handled = false;
	var variant = @this.construct_variant(@syntax, type, @raw, @handled);
	if (handled) {
		return $variant;
	};
	var values = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);

	if (!values.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	var Entity* constructor = nullptr;
	bool transfer = false;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		var Entity* owner = type->entity();

		if (!(@this.resolve((var Entity*(owner)))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		var Entity* candidate = owner->members()->local(owner->name());

		if (candidate && candidate->kind() == entity_kind::function) {
			@constructor = @this.select(candidate, raw, 1, conversion_mode::explicit_only, @syntax);

			if (this.diagnostics->failed()) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *constructor);

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && raw.size() == 1 && raw.data()[0].get()->type()->same_shape(*type)) {
			@transfer = true;
		};

		bool declared_constructor = false;
		usize member = 0;
		while (member < owner->members()->bindings().size()) {
			var Entity* declaration = owner->members()->bindings().data()[member];
			if (declaration->kind() == entity_kind::function && declaration->name() == owner->name() && declaration->origin() == declaration_origin::source) {
				@declared_constructor = true;
			};
			@member = member + 1;
		};

		if (!constructor && declared_constructor && !transfer) {
			var message = DiagnosticMessage();
			@message.text("no applicable constructor for '");
			diagnostic_type(@message, *type);
			@message.text("' with arguments ");
			diagnostic_arguments(@message, raw);
			@this.report(syntax.token(), message.view());
			if (candidate && candidate->kind() == entity_kind::function) {
				diagnostic_candidates(@*this.diagnostics, *candidate);
			};

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && !transfer && raw.size() > owner->fields().size()) {
			var message = DiagnosticMessage();
			@message.text("too many aggregate initializer arguments for '");
			diagnostic_type(@message, *type);
			@message.text("': expected at most ");
			@message.number(u64(owner->fields().size()));
			@message.text(", received ");
			@message.number(u64(raw.size()));
			@message.text(" with types ");
			diagnostic_arguments(@message, raw);
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};
	}
	else if (raw.size() > 1) {
		var message = DiagnosticMessage();
		@message.text("scalar construction of '");
		diagnostic_type(@message, *type);
		@message.text("' accepts at most one argument; received ");
		@message.number(u64(raw.size()));
		@message.text(" with types ");
		diagnostic_arguments(@message, raw);
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	@index = 0;
	var rt::unique<SemanticExpression>* owned = (@raw).data();

	while (index < raw.size()) {
		Type* expected = type;

		if (constructor) {
			@expected = constructor->parameters().data()[index + 1]->type();
		}
		else if (!transfer && type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			@expected = type->entity()->fields().data()[index]->type();
		};

		var value = rt::unique<SemanticExpression>(@owned[index].release());

		if (transfer) {
			if (value.get()->category() == value_category::place && !(@this.prepare_copy(type)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		}
		else if (type->kind().is_numeric() && value.get()->type()->kind().is_numeric() || type->kind() != type_kind::named && type->same_shape(*value.get()->type())) {
			var conversion = @this.node(semantic_kind::cast, type, &@syntax);

			if (!conversion.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@conversion.get()->append(rt::unique<SemanticExpression>(@value.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@value = $conversion;
		}
		else {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*expected), @syntax);
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@values.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	var result = @this.node(semantic_kind::construction, type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($values)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->bind($constructor, value_category::consumable);

	return $result;
};

fn Analyzer::initialize(var Analyzer& this, var Syntax& syntax, Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression> {
	if (!type) {
		return $value;
	};
	if (syntax.kind() == syntax_kind::variable && syntax.variable_initializer()->kind() == syntax_kind::brace && !syntax.variable_initializer()->size()) {
		return @this.zero_initialize(@*syntax.variable_initializer(), type);
	};

	bool explicit_copy = syntax.kind() == syntax_kind::variable && syntax.variable_initializer()->kind() == syntax_kind::unary && syntax.variable_initializer()->token().kind == token_kind::op_copy;
	if (explicit_copy && value.get()->kind() != semantic_kind::noop) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		@arguments.push_back(rt::unique<SemanticExpression>(@value.release()));
		return @this.construct_values(@syntax, type, $arguments);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		if (value.get()->kind() == semantic_kind::noop) {
			return $value;
		};

		return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
	};

	if (value.get()->kind() == semantic_kind::construction && value.get()->type()->same_shape(*type)) {
		return $value;
	};

	if (!explicit_copy && value.get()->category() == value_category::place && value.get()->type()->same_shape(*type)) {
		if (@this.implicit_constructor(*value.get(), *type) || @this.conversion_function(*value.get(), *type, conversion_mode::implicit_allowed)) {
			return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
		};
	};

	rt::buffer<rt::unique<SemanticExpression>> arguments;

	if (value.get()->kind() != semantic_kind::noop) {
		@arguments.push_back(rt::unique<SemanticExpression>(@value.release()));
	};

	return @this.construct_values(@syntax, type, $arguments);
};

fn Analyzer::call(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression> {
	var Syntax* source = syntax.callable();
	var Syntax* arguments = syntax.arguments();
	var Entity* explicit_pattern = @this.templates.call_pattern(@this, @scope, @*source);
	rt::optional_ref<Syntax> supplied;

	if (explicit_pattern) {
		var Syntax* application = source;

		if (application->kind() == syntax_kind::qualified_name) {
			@application = application->right();
		};

		@supplied.bind(@*application->arguments());
	};

	if (source->kind() == syntax_kind::record || source->kind() == syntax_kind::type_tuple || source->kind() == syntax_kind::type_variant || source->kind() == syntax_kind::type_grouping || source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || (source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_mutable) || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		Type* target = @this.type(@scope, @*source);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
	};

	if (!explicit_pattern && (source->kind() == syntax_kind::name || source->kind() == syntax_kind::qualified_name || source->kind() == syntax_kind::template_apply)) {
		Type* target = nullptr;
		var Entity* named = @this.lookup(@scope, @*source);

		if (source->kind() == syntax_kind::name && !named) {
			@target = this.types->find_primitive(source->token().text());
		};

		if (named && named->denotes_type()) {
			@target = @this.type(@scope, @*source);
		};

		if (target) {
			return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
		};
	};

	var Entity* group = nullptr;
	rt::unique<SemanticExpression> receiver;
	rt::unique<SemanticExpression> callable;

	if (source->kind() == syntax_kind::member) {
		@receiver = @this.expression(@scope, @*source->member_object(), rt::optional_ref<const Type>());

		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};

		var Syntax* requested_member = source->member_name();
		bool aggregate_operation = requested_member->kind() == syntax_kind::unary;
		if (requested_member->kind() == syntax_kind::template_apply) {
			@aggregate_operation = requested_member->callable()->token().is("get") || requested_member->callable()->token().is("has");
		};
		Type* known = variant_flow_known(this.variant_facts, *receiver.get());
		if (known && !aggregate_operation) {
			@receiver = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@receiver.release()), known);
			if (!receiver.get()) {
				return rt::unique<SemanticExpression>();
			};
		};
		Type* owner = receiver.get()->type();

		if (source->token().kind == token_kind::op_arrow) {
			if (owner->kind() != type_kind::pointer) {
				var message = DiagnosticMessage();
				@message.text("arrow method access to '");
				diagnostic_name(@message, *source->member_name());
				@message.text("' requires a pointer; receiver has type '");
				diagnostic_type(@message, *owner);
				@message.text("'");
				@this.report(source->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			@owner = owner->element();
			var dereference = @this.node(semantic_kind::dereference, owner, source);

			if (!dereference.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@dereference.get()->append(rt::unique<SemanticExpression>(@receiver.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@dereference.get()->set_category(value_category::place);
			@receiver = $dereference;
		};

		if (owner->kind() != type_kind::named || !owner->entity()->members()) {
			if (source->member_name()->kind() != syntax_kind::unary) {
				var Entity* alias = @this.lookup(@scope, @*source->member_name());
				if (this.failed()) {
					return rt::unique<SemanticExpression>();
				};
				Type* builtin = this.types->find_primitive(source->member_name()->token().text());

				if (!builtin && (!alias || !alias->denotes_type())) {
					var message = DiagnosticMessage();
					@message.text("method '");
					diagnostic_name(@message, *source->member_name());
					@message.text("' requires a class or enum object; receiver has type '");
					diagnostic_type(@message, *owner);
					@message.text("'");
					@this.report(source->token(), message.view());

					return rt::unique<SemanticExpression>();
				};
			};
		};

		var Syntax* aggregate_member = source->member_name();
		if (aggregate_access_kind(owner) && aggregate_member->kind() == syntax_kind::template_apply && (aggregate_member->callable()->token().is("get") || aggregate_member->callable()->token().is("has"))) {
			if (accessed) {
				@receiver.get()->set_mutable_access(true);
			};
			return @this.aggregate_access(@scope, @syntax, $receiver, expected);
		};
		var Syntax* member = source->member_name();
		bool destructor = member->kind() == syntax_kind::unary && member->token().kind == token_kind::op_tilde;
		Type* designated = nullptr;

		if (destructor) {
			@designated = @this.type(@scope, @*member->operand());
		}
		else {
			@designated = this.types->find_primitive(member->token().text());
			var Entity* alias = @this.lookup(@scope, @*member);
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};

			if (alias && alias->denotes_type()) {
				if (!(@this.resolve((var Entity*(alias)))).has<void>()) {
					return rt::unique<SemanticExpression>();
				};

				@designated = alias->type();
			};
		};

		if (designated && designated->same_shape(*owner)) {
			if (owner->qualifier() == type_qualifier::immutable || !accessed && receiver.get()->kind() != semantic_kind::access) {
				var message = DiagnosticMessage();
				if (destructor) {
					@message.text("explicit destruction of '");
				}
				else {
					@message.text("explicit construction of '");
				};
				diagnostic_type(@message, *owner);
				@message.text("' requires mutable access; ");
				if (owner->qualifier() == type_qualifier::immutable) {
					@message.text("the object is const");
				}
				else {
					@message.text("the object was not accessed through '@'");
				};
				@this.report(source->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			if (destructor) {
				if (arguments->size()) {
					var message = DiagnosticMessage();
					@message.text("destructor for '");
					diagnostic_type(@message, *owner);
					@message.text("' accepts no arguments after its receiver; received ");
					@message.number(u64(arguments->size()));
					@this.report(source->token(), message.view());

					return rt::unique<SemanticExpression>();
				};

				var result = @this.node(semantic_kind::destruction, this.types->find_primitive("void"), &@syntax);

				if (!result.get()) {
					return rt::unique<SemanticExpression>();
				};

				var Entity* finalizer = nullptr;

				if (owner->kind() == type_kind::named && owner->entity()->kind() == entity_kind::record) {
					@finalizer = owner->entity()->destructor();
				};

				@result.get()->bind(finalizer, value_category::consumable);

				if (!(@result.get()->append($receiver)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};

				return $result;
			};

			var result = @this.construct(@scope, @syntax, designated, @*arguments);

			if (!result.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@result.get()->append($receiver)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@result.get()->set_category(value_category::place);

			return @this.convert($result, expected, @syntax);
		};

		if (destructor) {
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};
			var message = DiagnosticMessage();
			@message.text("destructor type '");
			diagnostic_name(@message, *member->operand());
			@message.text("' does not match its object of type '");
			diagnostic_type(@message, *owner);
			@message.text("'");
			@this.report(source->token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (owner->kind() != type_kind::named) {
			var message = DiagnosticMessage();
			@message.text("explicit construction type '");
			diagnostic_name(@message, *member);
			@message.text("' does not match its destination of type '");
			diagnostic_type(@message, *owner);
			@message.text("'");
			@this.report(source->token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		@this.unit->record_receiver(@scope, @*source, @*owner->entity());

		@group = owner->entity()->find_member(source->member_name()->token().text());

		if (group && group->kind() == entity_kind::field) {
			@callable = @this.member_value(@scope, @*source, rt::unique<SemanticExpression>(@receiver.release()), rt::optional_ref<const Type>());

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@group = nullptr;
		};

		if (accessed && receiver.get()) {
			var access = @this.node(semantic_kind::access, owner, source);

			if (!access.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@access.get()->append(rt::unique<SemanticExpression>(@receiver.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@access.get()->set_category(value_category::place);
			@receiver = $access;
		};
	}
	else if (explicit_pattern) {
		@group = explicit_pattern;
	}
	else {
		@group = @this.lookup(@scope, @*source);
	};

	if (this.editor && group && group->kind() == entity_kind::function) {
		usize missing = 0;
		while (missing < arguments->size() && arguments->item(missing)->kind() != syntax_kind::error_expression) {
			@missing = missing + 1;
		};
		if (missing < arguments->size()) {
			rt::buffer<var Entity*>& candidates = group->scope()->bindings();
			usize candidate = 0;
			while (candidate < candidates.size()) {
				var Entity* function = candidates.data()[candidate];
				@candidate = candidate + 1;
				if (function->kind() == entity_kind::function && function->name() == group->name() && !(@this.resolve(function)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};
			};
			@this.unit->record_incomplete_call(@scope, @syntax, @*group, receiver.get() != nullptr);
			return @this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax);
		};
	};

	rt::buffer<rt::unique<SemanticExpression>> values;

	if (receiver.get()) {
		@values.push_back(rt::unique<SemanticExpression>(@receiver.release()));
	};

	usize index = 0;
	while (index < arguments->size()) {
		rt::unique<SemanticExpression> value;
		if (arguments->item(index)->kind() == syntax_kind::pack_expansion) {
			var Syntax* pattern = arguments->item(index)->pack_operand();
			var Entity* binding = nullptr;
			if (!(@this.fold_binding(@scope, @*pattern, @binding)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			if (binding && binding->kind() == entity_kind::field_pack) {
				usize element = 0;
				while (element < binding->fields().size()) {
					var Entity* previous = this.folded_field_pack;
					usize previous_index = this.folded_field_index;
					@this.folded_field_pack = binding;
					@this.folded_field_index = element;
					var expanded = @this.expression(@scope, @*pattern, rt::optional_ref<const Type>());
					@this.folded_field_pack = previous;
					@this.folded_field_index = previous_index;
					if (expanded.get()) {
						@values.push_back($expanded);
					}
					else {
						return rt::unique<SemanticExpression>();
					};
					@element = element + 1;
				};
				@index = index + 1;
				continue;
			};
			var TemplatePack* pack = @this.templates.pack(@this, @scope, @*arguments->item(index)->pack_operand());
			if (!pack) {
				return rt::unique<SemanticExpression>();
			};
			usize element = 0;
			while (element < pack->elements.size()) {
				var expanded = @this.templates.pack_value(@this, pack->elements.data()[element], @*arguments->item(index));
				if (expanded.get()) {
					@values.push_back($expanded);
				}
				else {
					return rt::unique<SemanticExpression>();
				};
				@element = element + 1;
			};
			@index = index + 1;
			continue;
		};

		if (arguments->item(index)->kind() == syntax_kind::brace) {
			@value = @this.node(semantic_kind::deferred_argument, this.types->find_primitive("void"), arguments->item(index));
		}
		else {
			@value = @this.expression(@scope, @*arguments->item(index), rt::optional_ref<const Type>());
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		@values.push_back($value);

		@index = index + 1;
	};

	if (group && group->kind() == entity_kind::template_pattern) {
		@group = @this.templates.specialize_call(@this, @scope, @*group, supplied, values, @syntax);

		if (!group) {
			return rt::unique<SemanticExpression>();
		};
	};

	var Entity* selected = nullptr;

	if (group && group->kind() == entity_kind::function) {
		@selected = @this.select(group, values, 0, conversion_mode::explicit_only, @syntax);

		if (!selected) {
			if (!this.diagnostics->failed()) {
				var message = DiagnosticMessage();
				@message.text("no applicable function for call to '");
				diagnostic_entity(@message, *group);
				@message.text("' with arguments ");
				diagnostic_arguments(@message, values);
				@this.diagnostics->error(syntax.token(), message.view());
				diagnostic_candidates(@*this.diagnostics, *group);
			};

			return rt::unique<SemanticExpression>();
		};

		if (selected->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *selected);

			return rt::unique<SemanticExpression>();
		};

		if (!this.accessible_at(*selected, @scope, syntax.token())) {
			var message = DiagnosticMessage();
			@message.text("selected function '");
			diagnostic_entity(@message, *selected);
			@message.text("' of type '");
			diagnostic_type(@message, *selected->type());
			@message.text("' is not accessible from this scope");
			@this.report(syntax.token(), message.view());
			@this.note(selected->token(), "function is declared here");

			return rt::unique<SemanticExpression>();
		};

		@callable = @this.node(semantic_kind::name, selected->type(), source);

		if (!callable.get()) {
			return rt::unique<SemanticExpression>();
		};

		@callable.get()->bind((var Entity*(selected)), value_category::place);
	}
	else if (!callable.get()) {
		@callable = @this.expression(@scope, @*source, rt::optional_ref<const Type>());
	};

	if (callable.get() && !(@this.contextual_arguments(@scope, @syntax, @*callable.get(), @values)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	return @this.invoke(@syntax, selected, $callable, $values, expected);
};

fn Analyzer::invoke(var Analyzer& this, var Syntax& syntax, var Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* signature = callable.get()->type();

	if (signature->kind() == type_kind::pointer) {
		@signature = signature->element();
	};

	if (signature->kind() != type_kind::function) {
		var message = DiagnosticMessage();
		@message.text("cannot call an expression of type '");
		diagnostic_type(@message, *callable.get()->type());
		@message.text("'; a function or pointer to function is required");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	usize fixed = signature->signature().parameters().size();

	if (values.size() < fixed || signature->signature().arity() != parameter_arity::variadic && values.size() != fixed) {
		var message = DiagnosticMessage();
		@message.text("call to function of type '");
		diagnostic_type(@message, *signature);
		@message.text("' requires ");
		if (signature->signature().arity() == parameter_arity::variadic) {
			@message.text("at least ");
		};
		@message.number(u64(fixed));
		@message.text(" arguments, received ");
		@message.number(u64(values.size()));
		@message.text(" with types ");
		diagnostic_arguments(@message, values);
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var converted = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);

	if (!converted.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	var rt::unique<SemanticExpression>* owners = (@values).data();

	while (index < values.size()) {
		var value = rt::unique<SemanticExpression>(@owners[index].release());

		if (index < fixed) {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*signature->signature().parameters().data()[index]), @syntax);
		}
		else if (!value.get()->type()->representation()->kind().is_scalar()) {
			var message = DiagnosticMessage();
			@message.text("variadic argument ");
			@message.number(u64(index + 1));
			@message.text(" requires a scalar value; received '");
			diagnostic_type(@message, *value.get()->type());
			@message.text("' for callable type '");
			diagnostic_type(@message, *signature);
			@message.text("'");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@converted.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	// Calls may mutate a previously escaped alias of a tracked binding.
	@this.variant_facts.clear();

	Type* result_type = signature->signature().result();
	value_category category = value_category::consumable;

	if (result_type->kind() == type_kind::reference) {
		@result_type = result_type->element();
		@category = value_category::place;
	};

	var result = @this.node(semantic_kind::call, result_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($callable)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($converted)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (selected) {
		if (this.function) {
			if (this.function->members()) {
				@this.unit->record_name(@this, @*this.function->members(), @syntax, @*selected, 16);
			};
		};
	};
	@result.get()->bind(selected, $category);

	if (signature->signature().result()->kind() == type_kind::reference) {
		@result.get()->set_mutable_access(result_type->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

enum constant_flow : [u08] {
	next;
	returned;
	break_loop;
	continue_loop;
	failed;
};

struct ConstantCell {
	rt::unique<SemanticExpression> value;
};

struct ConstantBinding {
	var Entity* entity;
	var ConstantCell* cell;
};

struct ConstantCheckpoint {
	usize bindings;
	usize cells;
};

enum constant_result_kind : [u08] {
	value;
	reference;
};

enum constant_reference_kind : [u08] {
	stored;
	temporary;
	unsupported;
};

struct ConstantFrame {
	fn set_result_type(var ConstantFrame& this, Type& type);
	fn leave(var ConstantFrame& this, ConstantCheckpoint& checkpoint);
	fn return_reference(var ConstantFrame& this, var ConstantCell* cell);
	fn bind(var ConstantFrame& this, var Entity* entity, var ConstantCell* cell);
	fn store(var ConstantFrame& this, var Entity* entity, rt::unique<SemanticExpression> value);

	fn returns_reference(ConstantFrame& this) -> bool;
	fn checkpoint(ConstantFrame& this) -> ConstantCheckpoint;
	fn returned_reference(ConstantFrame& this) -> var ConstantCell*;
	fn find(ConstantFrame& this, var Entity* entity) -> var ConstantCell*;
	fn owns(ConstantFrame& this, ConstantCell& cell) -> bool;

private:
	rt::buffer<rt::unique<ConstantCell>> cells;
	rt::buffer<ConstantBinding> bindings;
	rt::optional_ref<ConstantCell> reference_result;
	constant_result_kind result_kind;
};

struct ConstantRegion {
	fn ConstantRegion(var ConstantRegion& this, var ConstantFrame& frame);
	fn ~ConstantRegion(var ConstantRegion& this);

private:
	var ConstantFrame* frame;
	ConstantCheckpoint checkpoint;
};

// Each invocation owns its cells. Reference parameters borrow caller cells; unrelated
// mutable global storage is never admitted into an evaluation frame.
struct ConstantEvaluator {
	fn integer(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var u64& result) -> bool;
	fn real(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var f64& result) -> bool;

private:
	fn tick(var ConstantEvaluator& this) -> bool;
	fn bind_reference(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& target, var ConstantFrame& origin, var Entity& binding, SemanticExpression& source) -> bool;
	fn place(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> var ConstantCell*;
	fn global_cell(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, var Entity& entity) -> var ConstantCell*;
	fn value(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn call(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var ConstantCell var*& reference) -> rt::unique<SemanticExpression>;
	fn execute(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn loop(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn selection(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn execute_children(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn initialize_sequence(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> bool;

	fn reference_kind(ConstantEvaluator& this, SemanticExpression& source) -> constant_reference_kind;
	fn literal(ConstantEvaluator& this, SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression>;
	fn copy(ConstantEvaluator& this, SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn contains_label(ConstantEvaluator& this, SemanticExpression& source) -> bool;

	usize steps;
	usize depth;
	ConstantFrame constants;
};

fn ConstantEvaluator::tick(var ConstantEvaluator& this) -> bool {
	@this.steps = this.steps + 1;

	return this.steps <= 100000;
};

fn ConstantEvaluator::reference_kind(ConstantEvaluator& this, SemanticExpression& source) -> constant_reference_kind {
	if (source.category() == value_category::consumable) {
		return constant_reference_kind::temporary;
	};

	switch (source.kind()) {
		case semantic_kind::name:
		case semantic_kind::call:
			return constant_reference_kind::stored;
		case semantic_kind::access:
		case semantic_kind::cast:
			return this.reference_kind(*source.item(0));
		case semantic_kind::sequence:
			return this.reference_kind(*source.item(2));
		default:
			return constant_reference_kind::unsupported;
	};
};

fn ConstantEvaluator::bind_reference(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& target, var ConstantFrame& origin, var Entity& binding, SemanticExpression& source) -> bool {
	constant_reference_kind kind = this.reference_kind(source);

	if (kind == constant_reference_kind::stored) {
		var ConstantCell* cell = @this.place(@analyzer, @origin, source);

		if (!cell || !cell->value.get()) {
			return false;
		};

		@target.bind(&@binding, cell);
		return true;
	};

	if (kind != constant_reference_kind::temporary || binding.type()->element()->qualifier() != type_qualifier::immutable) {
		return false;
	};

	var temporary = @this.value(@analyzer, @origin, source);

	if (!temporary.get()) {
		return false;
	};

	@target.store(&@binding, $temporary);
	return true;
};

fn ConstantEvaluator::execute_children(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	usize index = 0;
	while (index < source.size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(index), @returned);

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantEvaluator::initialize_sequence(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> bool {
	rt::unique<SemanticExpression> returned;

	if (@this.execute(@analyzer, @frame, *source.item(0), @returned) != constant_flow::next) {
		return false;
	};

	return @this.execute(@analyzer, @frame, *source.item(1), @returned) == constant_flow::next;
};

fn ConstantEvaluator::literal(ConstantEvaluator& this, SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression> {
	var result = SemanticExpression::make(semantic_kind::literal_integer, source.type(), source.token());

	@result.get()->set_integer(source.type()->normalize_integer(value));

	return $result;
};

fn ConstantEvaluator::copy(ConstantEvaluator& this, SemanticExpression& source) -> rt::unique<SemanticExpression> {
	return source.copy_constant();
};

fn ConstantEvaluator::integer(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var u64& result) -> bool {
	@this.steps = 0;
	@this.depth = 0;
	@this.constants = ConstantFrame();
	ConstantFrame frame;
	var value = @this.value(@analyzer, @frame, expression);

	return value.get() && value.get()->constant_integer(@result);
};

fn ConstantEvaluator::real(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var f64& result) -> bool {
	@this.steps = 0;
	@this.depth = 0;
	@this.constants = ConstantFrame();
	ConstantFrame frame;
	var value = @this.value(@analyzer, @frame, expression);

	return value.get() && value.get()->constant_real(@result);
};

fn ConstantEvaluator::global_cell(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, var Entity& entity) -> var ConstantCell* {
	if (entity.kind() != entity_kind::global || entity.type()->qualifier() != type_qualifier::immutable) {
		return nullptr;
	};

	var ConstantCell* cell = this.constants.find(&@entity);

	if (cell) {
		return cell;
	};

	if (this.depth >= 128 || !(@analyzer.global_initializer(@entity)).has<void>() || !entity.body()) {
		return nullptr;
	};

	@this.depth = this.depth + 1;
	var value = @this.value(@analyzer, @frame, *entity.body());
	@this.depth = this.depth - 1;

	if (!value.get()) {
		return nullptr;
	};

	@this.constants.store(&@entity, $value);

	return this.constants.find(&@entity);
};

fn ConstantEvaluator::place(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> var ConstantCell* {
	if (!@this.tick()) {
		return nullptr;
	};

	if (source.kind() == semantic_kind::call && source.category() == value_category::place) {
		var ConstantCell* reference = nullptr;
		var value = @this.call(@analyzer, @frame, source, @reference);

		if (!value.get()) {
			return nullptr;
		};

		return $reference;
	};

	if (source.kind() == semantic_kind::name) {
		var ConstantCell* cell = frame.find(source.entity());
		var Entity* entity = source.entity();

		if (!cell && entity) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);
		};

		if (!cell || !cell->value.get()) {
			return nullptr;
		};

		return $cell;
	};

	if (source.kind() == semantic_kind::sequence && source.category() == value_category::place) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return nullptr;
		};

		return @this.place(@analyzer, @frame, *source.item(2));
	};

	if (source.kind() == semantic_kind::access || source.kind() == semantic_kind::cast && source.category() == value_category::place) {
		return @this.place(@analyzer, @frame, *source.item(0));
	};

	return nullptr;
};

fn constant_storage_size(Type& type, u32 pointer_bits, var u64& size) -> bool {
	Type* representation = type.representation();
	if (representation->kind().is_numeric()) {
		@size = (u64(representation->bits()) + 7) / 8;
		return true;
	};
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference) {
		@size = (u64(pointer_bits) + 7) / 8;
		return true;
	};
	if (type.kind() != type_kind::array) {
		return false;
	};
	u64 element = 0;
	if (!constant_storage_size(*type.element(), pointer_bits, @element) || element && type.count() > u64::max / element) {
		return false;
	};
	@size = element * type.count();
	return true;
};

fn ConstantEvaluator::value(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> rt::unique<SemanticExpression> {
	if (!@this.tick()) {
		return rt::unique<SemanticExpression>();
	};

	semantic_kind kind = source.kind();

	if (kind == semantic_kind::sizeof_type) {
		u64 size = 0;
		if (!constant_storage_size(*source.item(0)->type(), source.type()->bits(), @size)) {
			return rt::unique<SemanticExpression>();
		};
		return this.literal(source, size);
	};

	if (kind == semantic_kind::noop) {
		return SemanticExpression::make(semantic_kind::noop, source.type(), source.token());
	};

	if (kind == semantic_kind::sequence) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.value(@analyzer, @frame, *source.item(2));
	};

	if (kind == semantic_kind::name) {
		var ConstantCell* cell = frame.find(source.entity());

		if (cell && cell->value.get()) {
			return this.copy(*cell->value.get());
		};

		var Entity* entity = source.entity();

		if (entity && entity->kind() == entity_kind::global && entity->type()->qualifier() == type_qualifier::immutable) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);

			if (!cell || !cell->value.get()) {
				return rt::unique<SemanticExpression>();
			};

			return this.copy(*cell->value.get());
		};

		return this.copy(source);
	};

	if (kind == semantic_kind::access) {
		return @this.value(@analyzer, @frame, *source.item(0));
	};

	if (kind == semantic_kind::relocation) {
		var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!cell) {
			return rt::unique<SemanticExpression>();
		};

		var value = this.copy(*cell->value.get());
		@cell->value.reset(nullptr);

		return $value;
	};

	if (kind == semantic_kind::call) {
		var ConstantCell* reference = nullptr;

		return @this.call(@analyzer, @frame, source, @reference);
	};

	if (kind == semantic_kind::construction && source.type()->representation()->kind().is_numeric() && !source.entity()) {
		var SemanticExpression* arguments = source.item(0);

		if (!arguments->size()) {
			if (source.type()->representation()->kind() == type_kind::floating_point) {
				return SemanticExpression::make(semantic_kind::literal_real, source.type(), source.token());
			};

			return this.literal(source, 0);
		};

		if (arguments->size() == 1) {
			return @this.value(@analyzer, @frame, *arguments->item(0));
		};

		return rt::unique<SemanticExpression>();
	};

	if (kind == semantic_kind::binary && (source.operation() == token_kind::op_assign || source.operation() == token_kind::op_copy)) {
		// Runtime assignment evaluates its source before designating destination storage.
		var assigned = @this.value(@analyzer, @frame, *source.item(1));
		var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!assigned.get() || !cell || this.constants.owns(*cell)) {
			return rt::unique<SemanticExpression>();
		};

		@cell->value = this.copy(*assigned.get());

		if (!cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		return $assigned;
	};

	if (kind == semantic_kind::binary || kind == semantic_kind::unary || kind == semantic_kind::cast) {
		var first = @this.value(@analyzer, @frame, *source.item(0));

		if (!first.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (kind == semantic_kind::binary && (source.operation() == token_kind::op_and || source.operation() == token_kind::op_or)) {
			bool truth = false;

			if (!first.get()->constant_truth(@truth)) {
				return rt::unique<SemanticExpression>();
			};

			if (source.operation() == token_kind::op_and && !truth || source.operation() == token_kind::op_or && truth) {
				return this.literal(source, static_cast<u64>($truth));
			};
		};

		var operation = SemanticExpression::make($kind, source.type(), source.token());

		if (!(@operation.get()->append(rt::unique<SemanticExpression>(@first.release()))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		if (source.size() == 2) {
			var second = @this.value(@analyzer, @frame, *source.item(1));

			if (!second.get() || !(@operation.get()->append(rt::unique<SemanticExpression>(@second.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		};

		return this.copy(*operation.get());
	};

	return this.copy(source);
};

fn ConstantEvaluator::call(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var ConstantCell var*& reference) -> rt::unique<SemanticExpression> {
	@reference = nullptr;
	var Entity* function = source.entity();

	if (!function || function->kind() != entity_kind::function || this.depth >= 128) {
		return rt::unique<SemanticExpression>();
	};

	@function = function->canonical();

	if (!(@analyzer.function_body(function)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!function->body() || function->definition() != function_definition::user_defined || function->role() != function_role::ordinary || source.item(1)->size() != function->parameters().size()) {
		return rt::unique<SemanticExpression>();
	};

	ConstantFrame invocation;
	@invocation.set_result_type(*function->type()->signature().result());
	usize index = 0;
	while (index < function->parameters().size()) {
		var Entity* parameter = function->parameters().data()[index];
		var SemanticExpression* argument = source.item(1)->item(index);

		if (parameter->type()->kind() == type_kind::reference) {
			if (!@this.bind_reference(@analyzer, @invocation, @frame, @*parameter, *argument)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			var value = @this.value(@analyzer, @frame, *argument);

			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};
			@invocation.store(parameter, rt::unique<SemanticExpression>(@value.release()));
		};

		@index = index + 1;
	};

	@this.depth = this.depth + 1;
	rt::unique<SemanticExpression> returned;
	constant_flow flow = @this.execute(@analyzer, @invocation, *function->body(), @returned);
	@this.depth = this.depth - 1;

	if (flow == constant_flow::next && source.type()->kind() == type_kind::void_type) {
		return SemanticExpression::make(semantic_kind::noop, source.type(), source.token());
	};

	if (flow != constant_flow::returned) {
		return rt::unique<SemanticExpression>();
	};

	if (function->type()->signature().result()->kind() == type_kind::reference) {
		var ConstantCell* cell = invocation.returned_reference();
		ConstantCheckpoint boundary;
		@invocation.leave(boundary);

		if (!cell || !cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		@reference = cell;

		return this.copy(*cell->value.get());
	};

	return $returned;
};

fn ConstantEvaluator::execute(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	if (!@this.tick()) {
		return constant_flow::failed;
	};

	switch (source.kind()) {
		case semantic_kind::noop:
		case semantic_kind::case_label:
			return constant_flow::next;
		case semantic_kind::brace: {
			var region = ConstantRegion(@frame);

			return @this.execute_children(@analyzer, @frame, source, @returned);
		};
		case semantic_kind::statements:
			return @this.execute_children(@analyzer, @frame, source, @returned);
		case semantic_kind::variable: {
			var Entity* entity = source.entity();

			if (entity->type()->kind() == type_kind::reference) {
				if (!@this.bind_reference(@analyzer, @frame, @frame, @*entity, *source.item(0))) {
					return constant_flow::failed;
				};
			}
			else {
				rt::unique<SemanticExpression> value;

				if (source.item(0)->kind() == semantic_kind::noop && entity->type()->representation()->kind().is_numeric()) {
					semantic_kind kind = semantic_kind::literal_integer;

					if (entity->type()->representation()->kind() == type_kind::floating_point) {
						@kind = semantic_kind::literal_real;
					};

					@value = SemanticExpression::make($kind, entity->type(), source.token());
				}
				else {
					@value = @this.value(@analyzer, @frame, *source.item(0));
				};

				if (!value.get()) {
					return constant_flow::failed;
				};
				@frame.store(entity, rt::unique<SemanticExpression>(@value.release()));
			};

			return constant_flow::next;
		};
		case semantic_kind::return_value:
			if (frame.returns_reference()) {
				var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

				if (!cell) {
					return constant_flow::failed;
				};

				@frame.return_reference(cell);
				@returned = this.copy(*cell->value.get());
			}
			else {
				@returned = @this.value(@analyzer, @frame, *source.item(0));
			};

			if (!returned.get()) {
				return constant_flow::failed;
			};

			return constant_flow::returned;
		case semantic_kind::exception_try:
			return @this.execute(@analyzer, @frame, *source.item(0), @returned);
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
			return constant_flow::failed;
		case semantic_kind::break_loop:
			return constant_flow::break_loop;
		case semantic_kind::continue_loop:
			return constant_flow::continue_loop;
		case semantic_kind::conditional: {
			var condition = @this.value(@analyzer, @frame, *source.item(0));
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			usize selected = 2;

			if (truth) {
				@selected = 1;
			};

			return @this.execute(@analyzer, @frame, *source.item(selected), @returned);
		};
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(@analyzer, @frame, source, @returned);
		case semantic_kind::switch_expression:
			return @this.selection(@analyzer, @frame, source, @returned);
		default: {
			var value = @this.value(@analyzer, @frame, source);

			if (!value.get()) {
				return constant_flow::failed;
			};

			return constant_flow::next;
		};
	};
};

fn ConstantEvaluator::loop(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	usize condition_index = 0;
	usize body_index = 1;

	if (source.kind() == semantic_kind::for_loop) {
		constant_flow initialization = @this.execute(@analyzer, @frame, *source.item(0), @returned);

		if (initialization != constant_flow::next) {
			return $initialization;
		};

		@condition_index = 1;
		@body_index = 3;
	};

	while (true) {
		if (!@this.tick()) {
			return constant_flow::failed;
		};

		var SemanticExpression* expression = source.item(condition_index);

		if (expression->kind() != semantic_kind::noop) {
			var condition = @this.value(@analyzer, @frame, *expression);
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			if (!truth) {
				return constant_flow::next;
			};
		};

		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(body_index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow == constant_flow::returned || flow == constant_flow::failed) {
			return $flow;
		};

		if (source.kind() == semantic_kind::for_loop) {
			constant_flow step = @this.execute(@analyzer, @frame, *source.item(2), @returned);

			if (step != constant_flow::next && step != constant_flow::continue_loop) {
				if (step == constant_flow::break_loop) {
					return constant_flow::next;
				};

				return $step;
			};
		};
	};
};

fn ConstantEvaluator::contains_label(ConstantEvaluator& this, SemanticExpression& source) -> bool {
	if (source.kind() == semantic_kind::case_label) {
		return true;
	};

	if (source.kind() == semantic_kind::switch_expression) {
		return false;
	};

	usize index = 0;
	while (index < source.size()) {
		if (this.contains_label(*source.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantEvaluator::selection(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	var condition = @this.value(@analyzer, @frame, *source.item(0));
	u64 key = 0;

	if (!condition.get() || !condition.get()->constant_integer(@key) || source.item(1)->kind() != semantic_kind::brace) {
		return constant_flow::failed;
	};

	var SemanticExpression* body = source.item(1);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() != semantic_kind::case_label && this.contains_label(*item)) {
			// Nested labels require a resumable statement path, not linear fallthrough.
			return constant_flow::failed;
		};

		if (item->kind() == semantic_kind::case_label) {
			if (item->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (item->integer() == key) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	@index := selected;

	while (index < body->size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *body->item(index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantFrame::set_result_type(var ConstantFrame& this, Type& type) {
	@this.result_kind = constant_result_kind::value;

	if (type.kind() == type_kind::reference) {
		@this.result_kind = constant_result_kind::reference;
	};
};

fn ConstantFrame::returns_reference(ConstantFrame& this) -> bool {
	return this.result_kind == constant_result_kind::reference;
};

fn ConstantFrame::checkpoint(ConstantFrame& this) -> ConstantCheckpoint {
	ConstantCheckpoint checkpoint;
	@checkpoint.bindings = this.bindings.size();
	@checkpoint.cells = this.cells.size();

	return $checkpoint;
};

fn ConstantFrame::leave(var ConstantFrame& this, ConstantCheckpoint& checkpoint) {
	while (this.bindings.size() > checkpoint.bindings) {
		@this.bindings.pop_back();
	};

	usize index = checkpoint.cells;
	while (index < this.cells.size()) {
		// Keep stable tombstones for outstanding borrowed cells, but end the value's lifetime.
		@this.cells.data()[index].get()->value.reset(nullptr);
		@index = index + 1;
	};
};

fn ConstantFrame::return_reference(var ConstantFrame& this, var ConstantCell* cell) {
	@this.reference_result.reset();

	if (cell) {
		@this.reference_result.bind(@*cell);
	};
};

fn ConstantFrame::returned_reference(ConstantFrame& this) -> var ConstantCell* {
	return this.reference_result.get();
};

fn ConstantFrame::find(ConstantFrame& this, var Entity* entity) -> var ConstantCell* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].cell;
		};
	};

	return nullptr;
};

fn ConstantFrame::owns(ConstantFrame& this, ConstantCell& cell) -> bool {
	usize index = 0;
	while (index < this.cells.size()) {
		if (this.cells.data()[index].get() == &@cell) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantFrame::bind(var ConstantFrame& this, var Entity* entity, var ConstantCell* cell) {
	ConstantBinding binding;
	@binding.entity = $entity;
	@binding.cell = $cell;

	@this.bindings.push_back($binding);
};

fn ConstantFrame::store(var ConstantFrame& this, var Entity* entity, rt::unique<SemanticExpression> value) {
	rt::unique<ConstantCell> cell = rt::unique<ConstantCell>::make();

	@cell.get()->value = $value;
	var ConstantCell* borrowed = cell.get();

	@this.cells.push_back($cell);

	@this.bind($entity, $borrowed);
};

fn ConstantRegion::ConstantRegion(var ConstantRegion& this, var ConstantFrame& frame) {
	@this.frame = &@frame;
	@this.checkpoint = frame.checkpoint();
};

fn ConstantRegion::~ConstantRegion(var ConstantRegion& this) {
	@this.frame->leave(this.checkpoint);
};

fn SemanticExpression::constant_truth(SemanticExpression& this, var bool& result) -> bool {
	if (this.type()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return false;
		};

		@result = value != 0.0;

		return true;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return false;
	};

	@result = value != 0;

	return true;
};

fn SemanticExpression::constant_integer(SemanticExpression& this, var u64& result) -> bool {
	if (this.kind() == semantic_kind::null_pointer) {
		@result = 0;

		return true;
	};

	if (!this.type()->representation()->kind().is_integer()) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_integer) {
		@result = this.type()->normalize_integer(this.integer());

		return true;
	};

	if (this.kind() == semantic_kind::name && this.entity() && this.entity()->kind() == entity_kind::enumerator) {
		@result = this.type()->normalize_integer(this.entity()->integer());

		return true;
	};

	if (this.kind() == semantic_kind::cast) {
		if (this.type()->kind() == type_kind::boolean) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.type()->representation()->kind().is_integer()) {
			return false;
		};

		if (this.item(0)->type()->kind() == type_kind::floating_point) {
			f64 value = 0.0;

			if (!this.item(0)->constant_real(@value)) {
				return false;
			};

			return this.type()->integer_from_real(value, @result);
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() == semantic_kind::unary) {
		if (this.operation() == token_kind::op_bang) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@truth = !truth;
			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = u64(0) - result;
		}
		else if (this.operation() == token_kind::op_tilde) {
			@result = ~result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() != semantic_kind::binary) {
		return false;
	};

	if (this.operation() == token_kind::op_and || this.operation() == token_kind::op_or) {
		bool first = false;

		if (!this.item(0)->constant_truth(@first)) {
			return false;
		};

		if (this.operation() == token_kind::op_and && !first || this.operation() == token_kind::op_or && first) {
			@result = static_cast<u64>($first);

			return true;
		};

		bool second = false;

		if (!this.item(1)->constant_truth(@second)) {
			return false;
		};

		@result = static_cast<u64>($second);

		return true;
	};

	if (this.item(0)->type()->kind() == type_kind::floating_point || this.item(1)->type()->kind() == type_kind::floating_point) {
		return this.real_comparison(@result);
	};

	u64 first = 0;
	u64 second = 0;

	if (!this.item(0)->constant_integer(@first) || !this.item(1)->constant_integer(@second)) {
		return false;
	};

	bool signed_ = this.item(0)->type()->representation()->kind() == type_kind::signed_integer;
	i64 signed_first = 0;
	i64 signed_second = 0;

	if (signed_) {
		@signed_first = this.item(0)->type()->signed_value(first);
		@signed_second = this.item(1)->type()->signed_value(second);
	};

	bool comparison = false;

	switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
		case token_kind::op_remainder: {
			if (!second) {
				return false;
			};

			if (signed_) {
				u32 bits = this.item(0)->type()->representation()->bits();

				if (bits && first == (u64(1) << static_cast<u64>(bits - 1)) && signed_second == -1) {
					return false;
				};

				i64 answer = 0;

				if (this.operation() == token_kind::op_slash) {
					@answer = signed_first / signed_second;
				}
				else {
					@answer = signed_first % signed_second;
				};

				@result = static_cast<u64>($answer);
			}
			else if (this.operation() == token_kind::op_slash) {
				@result = first / second;
			}
			else {
				@result = first % second;
			};

			break;
		};
		case token_kind::op_ampersand:
			@result = first & second;
			break;
		case token_kind::op_pipe:
			@result = first | second;
			break;
		case token_kind::op_caret:
			@result = first ^ second;
			break;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			Type* representation = this.item(0)->type()->representation();
			u64 width = static_cast<u64>(representation->bits());

			if (second >= width) {
				return false;
			};

			if (this.operation() == token_kind::op_shift_left) {
				@result = first << second;
			}
			else if (signed_) {
				i64 shifted = signed_first >> static_cast<i64>(second);
				@result = static_cast<u64>($shifted);
			}
			else {
				@result = first >> second;
			};

			break;
		case token_kind::op_equal:
			@comparison = first == second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_not_equal:
			@comparison = first != second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less:
			@comparison = first < second;

			if (signed_) {
				@comparison = signed_first < signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater:
			@comparison = first > second;

			if (signed_) {
				@comparison = signed_first > signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less_equal:
			@comparison = first <= second;

			if (signed_) {
				@comparison = signed_first <= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater_equal:
			@comparison = first >= second;

			if (signed_) {
				@comparison = signed_first >= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		default:
			return false;
	};

	@result = this.type()->normalize_integer(result);

	return true;
};

fn SemanticExpression::copy_constant(SemanticExpression& this) -> rt::unique<SemanticExpression> {
	if (this.type()->representation()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return rt::unique<SemanticExpression>();
		};

		var result = SemanticExpression::make(semantic_kind::literal_real, this.type(), this.token());

		if (result.get()) {
			@result.get()->set_real(value);
		};

		return $result;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return rt::unique<SemanticExpression>();
	};

	var result = SemanticExpression::make(semantic_kind::literal_integer, this.type(), this.token());

	if (result.get()) {
		@result.get()->set_integer(this.type()->normalize_integer(value));
	};

	return $result;
};

fn Analyzer::contextual_arguments(var Analyzer& this, var Scope& scope, var Syntax& syntax, var SemanticExpression& callable, var rt::buffer<rt::unique<SemanticExpression>>& values) -> CompilationResult {
	TypeUse* use = callable.type_use().get();

	if (!use && callable.entity()) {
		@use = callable.entity()->type_use().get();
	};

	if (use && use->type().kind() == type_kind::pointer) {
		@use = &@use->element();
	};

	usize offset = values.size() - syntax.arguments()->size();
	usize index = 0;
	while (index < values.size()) {
		if (values.data()[index].get()->kind() == semantic_kind::deferred_argument) {
			if (!use || use->type().kind() != type_kind::function || index >= use->callable().parameters().size()) {
				var message = DiagnosticMessage();
				@message.text("contextual argument ");
				@message.number(u64(index + 1 - offset));
				@message.text(" requires a fixed parameter type; callable has type '");
				diagnostic_type(@message, *callable.type());
				@message.text("'");
				@this.report(syntax.arguments()->item(index - offset)->token(), message.view());
				return compilation_error();
			};

			ParameterUse& parameter = use->callable().parameters().data()[index];
			var value = @this.contextual_argument(@scope, @*syntax.arguments()->item(index - offset), parameter.type(), parameter.name());

			if (!value.get()) {
				return compilation_error();
			};

			@(@values).data()[index] = $value;
		};

		@index = index + 1;
	};

};

fn Analyzer::contextual_argument(var Analyzer& this, var Scope& scope, var Syntax& syntax, TypeUse& use, rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression> {
	if (!name.has_value()) {
		var message = DiagnosticMessage();
		@message.text("argument block requires a named parameter; selected parameter has type '");
		diagnostic_type(@message, use.type());
		@message.text("' and no parameter name");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	Type* type = &@use.type();
	Type* value_type = type;
	bool reference = type->kind() == type_kind::reference;

	if (reference) {
		@value_type = type->element();
	};

	var Scope* local = @this.unit->create_scope(&@scope, this.function);

	if (!local) {
		return rt::unique<SemanticExpression>();
	};

	Token token = syntax.token();

	if (name.has_value()) {
		@token = name.value().location();
	};

	var init = @this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax);
	var body = @this.node(semantic_kind::statements, this.types->find_primitive("void"), &@syntax);
	var Entity* binding = nullptr;

	if (!reference) {
		@binding = @this.unit->create_entity(entity_kind::local, token, &@syntax, local);

		if (!binding) {
			return rt::unique<SemanticExpression>();
		};

		if (name.has_value()) {
			@binding->set_name(name.value().text());
		};

		@binding->set_type(type);
		@binding->set_type_use(use);
		@binding->set_state(entity_state::ready);
		rt::buffer<rt::unique<SemanticExpression>> empty;
		var initial = @this.construct_values(@syntax, type, $empty);
		@init = @this.node(semantic_kind::variable, type, &@syntax);

		if (!initial.get() || !init.get()) {
			return rt::unique<SemanticExpression>();
		};

		@init.get()->bind((var Entity*(binding)), value_category::consumable);

		if (!(@init.get()->append($initial)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (!init.get() || !body.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	while (index < syntax.size()) {
		var Syntax* statement = syntax.item(index);
		rt::unique<SemanticExpression> child;
		var Syntax* target = nullptr;

		if (reference && !binding && statement->kind() == syntax_kind::binary && (statement->token().kind == token_kind::op_assign || statement->token().kind == token_kind::op_copy)) {
			@target = statement->left();

			if (target->kind() == syntax_kind::unary && target->token().kind == token_kind::op_access) {
				@target = target->operand();
			};
		};

		if (target && name.has_value() && target->kind() == syntax_kind::name && name.value().is(target->token().text())) {
			var value = @this.expression(@*local, @*statement->right(), rt::optional_ref<const Type>(*type));

			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (value.get()->category() != value_category::place) {
				var message = DiagnosticMessage();
				@message.text("reference contextual argument ");
				@message.quoted(name.value().text());
				@message.text(" of type '");
				diagnostic_type(@message, *type);
				@message.text("' requires a borrowed initializer; received a consumable of type '");
				diagnostic_type(@message, *value.get()->type());
				@message.text("'");
				@this.report(statement->token(), message.view());
				@this.note(name.value().location(), "parameter is declared here");

				return rt::unique<SemanticExpression>();
			};

			@binding = @this.unit->create_entity(entity_kind::local, token, &@syntax, local);

			if (!binding) {
				return rt::unique<SemanticExpression>();
			};

			@binding->set_name(name.value().text());

			@binding->set_type(type);
			@binding->set_type_use(use);
			@binding->set_state(entity_state::ready);
			@child = @this.node(semantic_kind::variable, type, statement);

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			@child.get()->bind((var Entity*(binding)), value_category::consumable);

			if (!(@child.get()->append($value)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			@child = @this.expression(@*local, @*statement, rt::optional_ref<const Type>());
		};

		if (!child.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@body.get()->append($child)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (!binding) {
		var message = DiagnosticMessage();
		@message.text("reference contextual argument ");
		@message.quoted(name.value().text());
		@message.text(" of type '");
		diagnostic_type(@message, *type);
		@message.text("' requires a bound initializer in its argument block");
		@this.report(syntax.token(), message.view());
		@this.note(name.value().location(), "parameter is declared here");

		return rt::unique<SemanticExpression>();
	};

	var yield = @this.node(semantic_kind::name, value_type, &@syntax);

	if (!yield.get()) {
		return rt::unique<SemanticExpression>();
	};

	@yield.get()->bind(binding, value_category::place);

	if (reference) {
		@yield.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	if (!reference) {
		var transfer = @this.node(semantic_kind::relocation, type, &@syntax);

		if (!transfer.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@transfer.get()->append(rt::unique<SemanticExpression>(@yield.release()))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@yield = $transfer;
	};

	var result = @this.node(semantic_kind::sequence, value_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->set_category(yield.get()->category());

	if (reference) {
		@result.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	@result.get()->set_type_use(use.effective());

	if (!(@result.get()->append($init)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($body)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($yield)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn numeric_literal_expression(SemanticExpression& expression) -> bool {
	rt::buffer<SemanticExpression*> pending;
	@pending.push_back(&expression);
	while (pending.size()) {
		SemanticExpression* current = pending.data()[pending.size() - 1];
		@pending.pop_back();
		if (current->kind() == semantic_kind::literal_integer || current->kind() == semantic_kind::literal_real) {
			if (current->token().kind != token_kind::literal_number) {
				return false;
			};
			continue;
		};
		if (current->kind() == semantic_kind::unary && (current->operation() == token_kind::op_plus || current->operation() == token_kind::op_minus)) {
			@pending.push_back(current->item(0));
			continue;
		};
		if (current->kind() == semantic_kind::binary && current->operation() != token_kind::op_assign && current->operation() != token_kind::op_copy) {
			@pending.push_back(current->item(1));
			@pending.push_back(current->item(0));
			continue;
		};
		if (current->kind() == semantic_kind::cast && current->token().kind == token_kind::literal_number) {
			@pending.push_back(current->item(0));
			continue;
		};
		return false;
	};
	return true;
};

fn Analyzer::compatible(Analyzer& this, Type* source, Type* target) -> bool {
	if (source == target) {
		return true;
	};

	if (!source || !target) {
		return false;
	};

	if (source->same_shape(*target) && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (target->kind() == type_kind::boolean && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (source->kind() != type_kind::pointer || target->kind() != type_kind::pointer) {
		return false;
	};

	Type* from = source->element();
	Type* to = target->element();

	if (from->kind() == type_kind::null_type) {
		return true;
	};

	if (from->qualifier() == type_qualifier::immutable && to->qualifier() == type_qualifier::mutable) {
		return false;
	};

	if (to->kind() == type_kind::void_type && from->kind() != type_kind::function) {
		return true;
	};

	if (from->kind() == type_kind::function && to->kind() == type_kind::function && from->signature().nonthrowing() && !to->signature().nonthrowing()) {
		FunctionSignature& first = from->signature();
		FunctionSignature& second = to->signature();
		if (first.result() != second.result() || first.arity() != second.arity() || first.parameters().size() != second.parameters().size()) {
			return false;
		};
		usize index = 0;
		while (index < first.parameters().size()) {
			if (first.parameters().data()[index] != second.parameters().data()[index]) {
				return false;
			};
			@index = index + 1;
		};
		return true;
	};
	return from->same_shape(*to) || from->derived_from(*to);
};

fn Analyzer::builtin_rank(Analyzer& this, SemanticExpression& value, Type& expected) -> i32 {
	Type* target = &@expected;
	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};
	Type* known = variant_flow_known(this.variant_facts, value);
	if (!value.type()->same_shape(*target) && variant_alternative(target, value.type())) {
		var injected = SemanticExpression(semantic_kind::construction, target, value.token());
		i32 rank = this.builtin_rank(injected, expected);
		if (rank < 0) {
			return rank;
		};
		return rank + 4;
	};
	if (!value.type()->same_shape(*target) && variant_alternative(value.type(), target)) {
		Type* alternative = variant_alternative(value.type(), target);
		var extracted = SemanticExpression(semantic_kind::name, target, value.token());
		@extracted.set_category(value.category());
		@extracted.set_mutable_access(value.mutable_access());
		if (alternative->kind() == type_kind::reference) {
			@extracted.set_category(value_category::place);
			@extracted.set_mutable_access(alternative->element()->qualifier() == type_qualifier::mutable);
		};
		i32 rank = this.builtin_rank(extracted, expected);
		if (rank < 0) {
			return rank;
		};
		return rank + 4;
	};
	if (known && !value.type()->same_shape(*target)) {
		Token token = value.token();
		Type* representation = known;
		semantic_kind category = semantic_kind::name;
		if (known->kind() == type_kind::null_type) {
			@representation = @this.types->pointer(@this.types->qualified(*known, type_qualifier::immutable));
			@category = semantic_kind::null_pointer;
		};
		var narrowed = SemanticExpression(category, representation, token);
		if (category == semantic_kind::name) {
			@narrowed.bind(value.entity(), value.category());
			@narrowed.set_mutable_access(value.mutable_access());
		};
		return this.builtin_rank(narrowed, expected);
	};
	if (expected.kind() == type_kind::reference) {
		if (value.category() != value_category::place && expected.element()->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		Type* target = expected.element();

		if (target->qualifier() == type_qualifier::mutable && !value.mutable_access()) {
			return -1;
		};

		if (target->qualifier() == type_qualifier::immutable && target->kind().is_numeric() && value.category() == value_category::consumable && numeric_literal_expression(value)) {
			return 1;
		};

		if ((!value.type()->same_shape(*target) && !value.type()->derived_from(*target)) || value.type()->qualifier() == type_qualifier::immutable && target->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		if (value.category() == value_category::consumable) {
			return 1;
		};

		if (!value.type()->same_shape(*target)) {
			return 1;
		};

		return 0;
	};

	if (expected.kind().is_numeric() && numeric_literal_expression(value)) {
		return 0;
	};

	i32 materialization = 0;

	if (value.category() == value_category::place) {
		if (value.type()->kind() == type_kind::named && value.type()->entity()->kind() == entity_kind::record) {
			return -1;
		};

		@materialization = 8;
	};

	if (value.type()->same_shape(expected)) {
		return $materialization;
	};

	if (value.type()->kind() == type_kind::pointer && expected.kind() == type_kind::boolean) {
		return materialization + 2;
	};

	if (this.compatible(value.type(), &@expected)) {
		return materialization + 1;
	};

	if (value.kind() == semantic_kind::literal_integer && expected.kind().is_numeric()) {
		return 2;
	};

	return -1;
};

fn Analyzer::convert(var Analyzer& this, rt::unique<SemanticExpression> value, rt::optional_ref<const Type>& expected, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!value.get() || !expected.has_value()) {
		return $value;
	};

	Type* requested = expected.get();
	if (requested->kind() == type_kind::reference) {
		@requested = requested->element();
	};
	if (!value.get()->type()->same_shape(*requested) && variant_alternative(requested, value.get()->type())) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		@arguments.push_back($value);
		var constructed = @this.construct_values(@syntax, requested, $arguments);
		return @this.convert($constructed, expected, @syntax);
	};
	if (!value.get()->type()->same_shape(*requested) && variant_alternative(value.get()->type(), requested)) {
		var Scope* scope = this.unit->root_scope();
		rt::buffer<SemanticScopeRegion>& regions = this.unit->scope_regions();
		for (usize index = regions.size(); index; @index = index - 1) {
			SemanticScopeRegion& region = regions.data()[index - 1];
			if (region.syntax == &@syntax) {
				@scope = region.scope;
				break;
			};
		};
		return @this.variant_cast(@*scope, @syntax, requested, $value, expected, true);
	};
	Type* known = variant_flow_known(this.variant_facts, *value.get());
	if (known && !value.get()->type()->same_shape(*requested)) {
		@value = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@value.release()), known);
		if (!value.get()) {
			@this.error(&@syntax, "proven variant alternative storage is unavailable");
			return rt::unique<SemanticExpression>();
		};
	};

	if (@this.argument_rank(*value.get(), expected.value()) < 0) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};

		Type* target = expected.get();
		if (target->kind() == type_kind::reference) {
			@target = target->element();
		};
		if (expected.value().kind() != type_kind::reference || target->qualifier() == type_qualifier::immutable) {
			var constructor = @this.select_implicit_constructor(*value.get(), *target);
			var conversion = @this.select_conversion_function(*value.get(), *target, conversion_mode::implicit_allowed);
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};
			if (constructor.conflict) {
				diagnostic_conversion_ambiguity(@*this.diagnostics, syntax.token(), *value.get()->type(), expected.value(), constructor);
				return rt::unique<SemanticExpression>();
			};
			if (conversion.conflict) {
				diagnostic_conversion_ambiguity(@*this.diagnostics, syntax.token(), *value.get()->type(), expected.value(), conversion);
				return rt::unique<SemanticExpression>();
			};
		};

		var message = DiagnosticMessage();
		@message.text("cannot initialize '");
		diagnostic_type(@message, expected.value());
		@message.text("' from ");
		if (value.get()->category() == value_category::place) {
			@message.text("a place of type '");
		}
		else {
			@message.text("a consumable of type '");
		};
		diagnostic_type(@message, *value.get()->type());
		@message.text("'");
		@this.diagnostics->error(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference && expected.value().element()->qualifier() == type_qualifier::immutable && expected.value().element()->kind().is_numeric() && !value.get()->type()->same_shape(*expected.value().element()) && numeric_literal_expression(*value.get())) {
		var converted = @this.node(semantic_kind::cast, expected.value().element(), &@syntax);

		if (!converted.get() || !(@converted.get()->append(rt::unique<SemanticExpression>(@value.release()))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@value = $converted;
	};

	i32 builtin = this.builtin_rank(*value.get(), expected.value());
	Type* target = expected.get();
	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	var Entity* constructor = nullptr;
	var Entity* conversion = nullptr;
	if (builtin < 0 || expected.value().kind() != type_kind::reference && value.get()->category() == value_category::place && value.get()->type()->same_shape(*target)) {
		@constructor = @this.implicit_constructor(*value.get(), *target);

		if (!constructor) {
			@conversion = @this.conversion_function(*value.get(), *target, conversion_mode::implicit_allowed);
		};
	};

	if (builtin < 0 || constructor || conversion) {
		var Entity* selected = constructor;
		usize source_index = 1;

		if (!selected) {
			@selected := conversion;
			@source_index = 0;
		};

		if (!selected) {
			var message = DiagnosticMessage();
			@message.text("no applicable implicit conversion from '");
			diagnostic_type(@message, *value.get()->type());
			@message.text("' to '");
			diagnostic_type(@message, expected.value());
			@message.text("'");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (selected->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *selected);

			return rt::unique<SemanticExpression>();
		};

		@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*selected->parameters().data()[source_index]->type()), @syntax);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);

		if (!arguments.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@arguments.get()->append(rt::unique<SemanticExpression>(@value.release()))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		if (constructor) {
			var construction = @this.node(semantic_kind::construction, target, &@syntax);

			if (!construction.get()) {
				return rt::unique<SemanticExpression>();
			};

			@construction.get()->bind(constructor, value_category::consumable);

			if (!(@construction.get()->append($arguments)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@value = $construction;
		}
		else {
			var callable = @this.node(semantic_kind::name, conversion->type(), &@syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind(conversion, value_category::place);
			var call = @this.node(semantic_kind::call, target, &@syntax);

			if (!call.get()) {
				return rt::unique<SemanticExpression>();
			};

			@call.get()->bind(conversion, value_category::consumable);

			if (!(@call.get()->append($callable)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@call.get()->append($arguments)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@value = $call;
		};
	};

	if (value.get()->type() == expected.get() && expected.value().kind() != type_kind::reference) {
		return $value;
	};

	var result = @this.node(semantic_kind::cast, target, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	TypeUse* use = value.get()->type_use().get();
	if (!use && value.get()->entity() && value.get()->entity()->type_use().has_value()) {
		@use = &@value.get()->entity()->type_use().value().effective();
	};
	if (syntax.kind() != syntax_kind::cast && use && use->type().same_shape(*target)) {
		TypeUse* converted_use = @this.unit->retype_use(*use, *target);
		if (!converted_use) {
			return rt::unique<SemanticExpression>();
		};
		@result.get()->set_type_use(*converted_use);
	};

	if (!(@result.get()->append($value)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(target->qualifier() == type_qualifier::mutable);
	};

	return $result;
};

struct CopyAssignmentPlan {
	fn CopyAssignmentPlan(var CopyAssignmentPlan& this, var Entity& destination, var Entity& source, rt::unique<SemanticExpression> expression);
	fn destination(CopyAssignmentPlan& this) -> var Entity&;
	fn source(CopyAssignmentPlan& this) -> var Entity&;
	fn expression(CopyAssignmentPlan& this) -> var SemanticExpression&;

private:
	var Entity* destination_binding;
	var Entity* source_binding;
	rt::unique<SemanticExpression> operation;
};

fn CopyAssignmentPlan::CopyAssignmentPlan(var CopyAssignmentPlan& this, var Entity& destination, var Entity& source, rt::unique<SemanticExpression> expression) {
	@this.destination_binding = &@destination;
	@this.source_binding = &@source;
	@this.operation = $expression;
};

fn CopyAssignmentPlan::destination(CopyAssignmentPlan& this) -> var Entity& {
	return @*this.destination_binding;
};

fn CopyAssignmentPlan::source(CopyAssignmentPlan& this) -> var Entity& {
	return @*this.source_binding;
};

fn CopyAssignmentPlan::expression(CopyAssignmentPlan& this) -> var SemanticExpression& {
	return @*this.operation.get();
};

fn Entity::copy_assignment(Entity& this) -> var CopyAssignmentPlan* {
	return this.copy_assigner.get();
};

fn Entity::set_copy_assignment(var Entity& this, rt::unique<CopyAssignmentPlan> plan) {
	@this.copy_assigner = $plan;
};

fn diagnostic_entity_kind(var DiagnosticMessage& message, entity_kind kind) {
	switch (kind) {
		case entity_kind::function: {
			@message.text("function");
			break;
		};
		case entity_kind::global: {
			@message.text("global variable");
			break;
		};
		case entity_kind::local: {
			@message.text("local variable");
			break;
		};
		case entity_kind::parameter: {
			@message.text("parameter");
			break;
		};
		case entity_kind::record: {
			@message.text("record");
			break;
		};
		case entity_kind::field: {
			@message.text("field");
			break;
		};
		case entity_kind::field_pack: {
			@message.text("member pack");
			break;
		};
		case entity_kind::enumeration: {
			@message.text("enumeration");
			break;
		};
		case entity_kind::enumerator: {
			@message.text("enumerator");
			break;
		};
		case entity_kind::namespace_body: {
			@message.text("namespace");
			break;
		};
		case entity_kind::alias: {
			@message.text("type alias");
			break;
		};
		case entity_kind::type_parameter: {
			@message.text("type parameter");
			break;
		};
		case entity_kind::template_pattern: {
			@message.text("template");
			break;
		};
		case entity_kind::primitive_type: {
			@message.text("primitive type");
			break;
		};
		case entity_kind::pack_binding: {
			@message.text("pack binding");
			break;
		};
		case entity_kind::pack_signature: {
			@message.text("pack signature");
			break;
		};
		case entity_kind::constant: {
			@message.text("constant");
			break;
		};
	};
};

fn snprintf(var char* buffer, usize capacity, char* format, ...) -> i32;

fn diagnostic_template_argument(var DiagnosticMessage& message, TemplateArgument& argument) {
	if (argument.kind == template_argument_kind::pack) {
		@message.text("<");
		usize index = 0;
		while (argument.pack && index < argument.pack->elements.size()) {
			if (index) {
				@message.text(", ");
			};
			diagnostic_template_argument(@message, argument.pack->elements.data()[index]);
			@index = index + 1;
		};
		@message.text(">");
		return;
	};
	if (argument.kind == template_argument_kind::type) {
		diagnostic_type(@message, *argument.type);
		return;
	};
	if (argument.type && argument.type->kind() == type_kind::floating_point) {
		char[64] buffer {};
		i32 size = snprintf(&@buffer[0], sizeof(buffer), "%.17g\0".data(), argument.real_value);
		if (size > 0 && static_cast<usize>(size) < sizeof(buffer)) {
			@message.text(rt::string_view(&@buffer[0], static_cast<usize>(size)));
		};
		return;
	};
	if (argument.type && argument.type->kind() == type_kind::signed_integer && argument.type->signed_value(argument.value) < 0) {
		@message.text("-");
		@message.number(u64(0) - u64(argument.type->signed_value(argument.value)));
		return;
	};
	@message.number(argument.value);
};

fn diagnostic_entity(var DiagnosticMessage& message, Entity& entity) {
	var Scope* scope = entity.scope();
	if (scope && scope->owner() && scope->owner() != &@entity) {
		diagnostic_entity(@message, *scope->owner());
		@message.text("::");
	};
	@message.text(entity.name());
	TemplateInstantiation* instance = entity.template_arguments();
	if (instance && instance->source_argument_count) {
		@message.text("<");
		usize index = 0;
		while (index < instance->source_argument_count) {
			if (index) {
				@message.text(", ");
			};
			TemplateArgument& argument = instance->arguments.data()[index];
			diagnostic_template_argument(@message, argument);
			@index = index + 1;
		};
		@message.text(">");
	};
};

fn diagnostic_name(var DiagnosticMessage& message, Syntax& syntax) {
	if (syntax.kind() == syntax_kind::qualified_name) {
		diagnostic_name(@message, *syntax.left());
		@message.text("::");
		diagnostic_name(@message, *syntax.right());
		return;
	};
	if (syntax.kind() == syntax_kind::type_name) {
		diagnostic_name(@message, *syntax.designated_type());
		return;
	};
	if (syntax.kind() == syntax_kind::template_apply) {
		diagnostic_name(@message, *syntax.callable());
		@message.text("<");
		usize index = 0;
		while (index < syntax.arguments()->size()) {
			if (index) {
				@message.text(", ");
			};
			diagnostic_name(@message, *syntax.arguments()->item(index));
			@index = index + 1;
		};
		@message.text(">");
		return;
	};
	@message.text(syntax.token().text());
};

fn diagnostic_indirection_target(var DiagnosticMessage& message, Type& type) {
	bool grouped = type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array || type.kind() == type_kind::function;
	if (type.qualifier() == type_qualifier::mutable) {
		@message.text("var ");
	};
	if (grouped) {
		@message.text("(");
	};
	Type view = type.qualified(type_qualifier::mutable);
	diagnostic_type(@message, view);
	if (grouped) {
		@message.text(")");
	};
};

fn diagnostic_type(var DiagnosticMessage& message, Type& type) {
	if (type.qualifier() == type_qualifier::immutable && type.kind() != type_kind::pointer && type.kind() != type_kind::reference && type.kind() != type_kind::array && type.kind() != type_kind::function) {
		@message.text("const ");
	};

	switch (type.kind()) {
		case type_kind::void_type: @message.text("void"); break;
		case type_kind::null_type: @message.text("null"); break;
		case type_kind::boolean: @message.text("bool"); break;
		case type_kind::character: @message.text("char"); break;
		case type_kind::signed_integer:
			@message.text("i");
			@message.number(u64(type.bits()));
			break;
		case type_kind::unsigned_integer:
			@message.text("u");
			@message.number(u64(type.bits()));
			break;
		case type_kind::floating_point:
			@message.text("f");
			@message.number(u64(type.bits()));
			break;
		case type_kind::named:
		case type_kind::parameter:
			diagnostic_entity(@message, *type.entity());
			break;
		case type_kind::pointer:
		case type_kind::reference:
			if (type.kind() == type_kind::pointer && type.qualifier() == type_qualifier::immutable) {
				@message.text("const (");
			};
			diagnostic_indirection_target(@message, *type.element());
			if (type.kind() == type_kind::pointer) {
				@message.text("*");
				if (type.qualifier() == type_qualifier::immutable) {
					@message.text(")");
				};
			}
			else {
				@message.text("&");
			};
			break;
		case type_kind::array:
			if (type.qualifier() == type_qualifier::immutable) {
				@message.text("const (");
			};
			diagnostic_type(@message, *type.element());
			@message.text("[");
			@message.number(type.count());
			@message.text("]");
			if (type.qualifier() == type_qualifier::immutable) {
				@message.text(")");
			};
			break;
		case type_kind::function: {
			@message.text("(");
			FunctionSignature& signature = type.signature();
			usize index = 0;
			while (index < signature.parameters().size()) {
				if (index) {
					@message.text(", ");
				};
				diagnostic_type(@message, *signature.parameters().data()[index]);
				@index = index + 1;
			};
			if (signature.arity() == parameter_arity::variadic) {
				if (index) {
					@message.text(", ");
				};
				@message.text("...");
			};
			@message.text(") -> ");
			diagnostic_type(@message, *signature.result());
			break;
		};
	};
};

fn Analyzer::cancelled(Analyzer& this) -> bool {
	return this.diagnostics->cancelled();
};

fn Analyzer::failed(Analyzer& this) -> bool {
	return this.diagnostics->failed();
};

fn Analyzer::report(var Analyzer& this, Token& token, rt::string_view message) {
	@this.diagnostics->error(token, message);
};

fn Analyzer::note(var Analyzer& this, Token& token, rt::string_view message) {
	@this.diagnostics->note(token, message);
};

fn Analyzer::deleted_function(var Analyzer& this, Token& token, Entity& function) {
	var message = DiagnosticMessage();
	@message.text("selected function '");
	diagnostic_entity(@message, function);
	@message.text("' of type '");
	diagnostic_type(@message, *function.type());
	@message.text("' is deleted");
	@this.report(token, message.view());
	@this.note(function.token(), "function is declared deleted here");
};

fn diagnostic_arguments(var DiagnosticMessage& message, rt::buffer<rt::unique<SemanticExpression>>& arguments) {
	@message.text("(");
	usize index = 0;
	while (index < arguments.size()) {
		if (index) {
			@message.text(", ");
		};
		SemanticExpression& argument = *arguments.data()[index].get();
		if (argument.kind() == semantic_kind::deferred_argument) {
			@message.text("brace expression");
		}
		else {
			diagnostic_type(@message, *argument.type());
		};
		@index = index + 1;
	};
	@message.text(")");
};

fn diagnostic_candidate(var Diagnostics& diagnostics, Entity& candidate) {
	var detail = DiagnosticMessage();
	@detail.text("candidate '");
	diagnostic_entity(@detail, candidate);
	@detail.text("' has type '");
	diagnostic_type(@detail, *candidate.type());
	@detail.text("'");
	@diagnostics.note(candidate.token(), detail.view());
};

fn diagnostic_conversion_ambiguity(var Diagnostics& diagnostics, Token& token, Type& source, Type& target, ConversionSelection& selection) {
	var message = DiagnosticMessage();
	@message.text("ambiguous implicit conversion from '");
	diagnostic_type(@message, source);
	@message.text("' to '");
	diagnostic_type(@message, target);
	@message.text("'; multiple conversion functions are applicable");
	@diagnostics.error(token, message.view());
	diagnostic_candidate(@diagnostics, *selection.selected);
	diagnostic_candidate(@diagnostics, *selection.conflict);
};

fn diagnostic_candidates(var Diagnostics& diagnostics, Entity& group) {
	rt::buffer<var Entity*>& candidates = group.scope()->bindings();
	usize index = 0;
	while (index < candidates.size()) {
		Entity& candidate = *candidates.data()[index];
		@index = index + 1;
		if (candidate.kind() != entity_kind::function || candidate.name() != group.name() || !candidate.type()) {
			continue;
		};

		diagnostic_candidate(@diagnostics, candidate);
	};
};

fn Analyzer::infer_variable(var Analyzer& this, var Syntax& declaration, SemanticExpression& initializer) -> Type* {
	Type* type = initializer.type();
	if (
		type
		&& type->kind().is_numeric()
		&& type->kind() != type_kind::boolean
		&& type->kind() != type_kind::character
		&& numeric_literal_expression(initializer)
	) {
		var message = DiagnosticMessage();
		@message.text("cannot infer the type of variable ");
		@message.quoted(declaration.variable_name()->token().text());
		@message.text(" from an untyped numeric literal; specify a variable type or construct a typed value");
		@this.diagnostics->error(declaration.variable_name()->token(), message.view());
		return nullptr;
	};
	return $type;
};

fn variant_alternative(Type* source, Type* target) -> Type* {
	if (!source || source->kind() != type_kind::named || !variant_instance(*source->entity())) {
		return nullptr;
	};
	TemplateInstantiation* instance = source->entity()->template_arguments();
	TemplatePack* elements = instance->arguments.data()[0].pack;
	Type* selected = nullptr;
	for (usize index = 0; index < elements->elements.size(); @index = index + 1) {
		Type* alternative = elements->elements.data()[index].type;
		if (alternative->same_shape(*target) || alternative->kind() == type_kind::reference && alternative->element()->same_shape(*target)) {
			if (selected) {
				return nullptr;
			};
			@selected = alternative;
		};
	};
	return selected;
};

fn Analyzer::discarded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression> {
	if (syntax.kind() == syntax_kind::grouping) {
		return @this.discarded(@scope, @*syntax.operand(), $value);
	};
	if (!value.get() || value.get()->type()->kind() == type_kind::void_type || value.get()->kind() == semantic_kind::noop || value.get()->kind() == semantic_kind::variable || value.get()->kind() == semantic_kind::construction && value.get()->category() == value_category::place) {
		return $value;
	};
	if (syntax.kind() == syntax_kind::binary && (syntax.token().kind == token_kind::op_assign || syntax.token().kind == token_kind::op_copy)) {
		return $value;
	};
	Type* nothing = this.types->find_primitive("void");
	if (syntax.kind() == syntax_kind::binary && syntax.token().kind == token_kind::op_plus_assign) {
		Type* result_type = value.get()->type();
		if (result_type->kind() == type_kind::named && variant_instance(*result_type->entity())) {
			TemplatePack* elements = result_type->entity()->template_arguments()->arguments.data()[0].pack;
			Type* reference = nullptr;
			for (usize index = 0; index < elements->elements.size(); @index = index + 1) {
				Type* alternative = elements->elements.data()[index].type;
				if (alternative->kind() == type_kind::reference) {
					if (reference) {
						@this.error(&@syntax, "discarded compound assignment requires a unique reference result");
						return rt::unique<SemanticExpression>();
					};
					@reference = alternative;
				};
			};
			if (reference) {
				return @this.variant_cast(@scope, @syntax, reference, $value, rt::optional_ref<const Type>(), true);
			};
		}
		else if (value.get()->category() == value_category::place) {
			return $value;
		};
	};
	if (variant_alternative(value.get()->type(), nothing)) {
		return @this.variant_cast(@scope, @syntax, nothing, $value, rt::optional_ref<const Type>(), true);
	};
	@this.error(&@syntax, "expression result must be used");
	return rt::unique<SemanticExpression>();
};

fn Analyzer::validate_dispatch_syntax(var Analyzer& this, var Syntax& syntax, bool class_scope) -> CompilationResult {
	if (syntax.kind() == syntax_kind::template_declaration) {
		var Syntax* declaration = syntax.template_declaration();

		if (declaration->kind() == syntax_kind::function) {
			usize index = 0;
			while (index < declaration->function_attributes()->size()) {
				Token token = declaration->function_attributes()->item(index)->token();

				if (token.is("virtual") || token.is("override") || token.is("final")) {
					var message = DiagnosticMessage();
					@message.text("attribute ");
					@message.quoted(token.text());
					@message.text(" on function template '");
					diagnostic_name(@message, *declaration->function_name());
					@message.text("' requires virtual function templates, which are not implemented");
					@this.report(token, message.view());
					return compilation_error();
				};

				@index = index + 1;
			};
		};

		return @this.validate_dispatch_syntax(@*declaration, $class_scope);
	};

	if (syntax.kind() == syntax_kind::record) {
		return @this.validate_dispatch_syntax(@*syntax.record_members(), true);
	};

	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.validate_dispatch_syntax(@*syntax.namespace_members(), false);
	};

	if (syntax.kind() == syntax_kind::list || syntax.kind() == syntax_kind::brace || syntax.kind() == syntax_kind::unit) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!(@this.validate_dispatch_syntax(@*syntax.item(index), bool(class_scope))).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};

		return;
	};

	if (syntax.kind() != syntax_kind::function) {
		return;
	};

	bool virtual_operation = false;
	usize index = 0;
	while (index < syntax.function_attributes()->size()) {
		Token token = syntax.function_attributes()->item(index)->token();

		if (token.is("virtual") || token.is("override") || token.is("final")) {
			@virtual_operation = true;
		};

		@index = index + 1;
	};

	if (!virtual_operation) {
		return;
	};

	var Syntax* parameters = syntax.function_parameters();

	if ((!class_scope && syntax.function_name()->kind() != syntax_kind::qualified_name) || !parameters->size() || !parameters->item(0)->parameter_name()->token().is("this") || parameters->item(0)->parameter_type()->kind() != syntax_kind::type_reference) {
		var message = DiagnosticMessage();
		@message.text("virtual operation '");
		diagnostic_name(@message, *syntax.function_name());
		@message.text("' requires an explicit class receiver of reference type named 'this'");
		if (!class_scope && syntax.function_name()->kind() != syntax_kind::qualified_name) {
			@message.text("; the function is not declared in class scope");
		}
		else if (!parameters->size()) {
			@message.text("; the function has no receiver parameter");
		}
		else {
			@message.text("; first parameter is named ");
			@message.quoted(parameters->item(0)->parameter_name()->token().text());
			if (parameters->item(0)->parameter_type()->kind() != syntax_kind::type_reference) {
				@message.text(" and does not have reference type");
			};
		};
		@this.report(syntax.token(), message.view());
		return compilation_error();
	};

	if (this.templates.qualifier_dependent(@syntax)) {
		var message = DiagnosticMessage();
		@message.text("virtual operation '");
		diagnostic_name(@message, *syntax.function_name());
		@message.text("' cannot have dependent receiver qualification");
		@this.report(syntax.token(), message.view());
		return compilation_error();
	};

};

fn dispatch_signature(Entity& function, Entity& inherited) -> bool {
	if (function.operator_kind() != token_kind::identifier || inherited.operator_kind() != token_kind::identifier) {
		if (function.operator_kind() != inherited.operator_kind()) {
			return false;
		};
	}
	else if (function.name() != inherited.name()) {
		return false;
	};

	rt::buffer<var Entity*>& first = function.parameters();
	rt::buffer<var Entity*>& second = inherited.parameters();

	if (!first.size() || first.size() != second.size() || first.data()[0]->type()->kind() != type_kind::reference || second.data()[0]->type()->kind() != type_kind::reference || first.data()[0]->type()->element()->qualifier() != second.data()[0]->type()->element()->qualifier()) {
		return false;
	};

	usize index = 1;
	while (index < first.size()) {
		if (first.data()[index]->type() != second.data()[index]->type()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn dispatch_result(Type& result, Type& inherited) -> bool {
	if (result.same_shape(inherited)) {
		return true;
	};

	if (result.kind() != inherited.kind() || result.kind() != type_kind::pointer && result.kind() != type_kind::reference) {
		return false;
	};

	Type* source = result.element();
	Type* destination = inherited.element();

	return source->derived_from(*destination) && (source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable);
};

fn Analyzer::build_dispatch(var Analyzer& this, var Entity* entity) -> CompilationResult {
	usize inherited = 0;

	if (entity->bases().size()) {
		rt::buffer<var Entity*>& base = entity->bases().data()[0]->entity()->virtual_functions();

		while (inherited < base.size()) {
			@entity->add_virtual(base.data()[inherited]);

			@inherited = inherited + 1;
		};
	};

	rt::buffer<var Entity*> seen;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* function = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (function->kind() != entity_kind::function) {
			continue;
		};

		if (!(@this.resolve((var Entity*(function)))).has<void>()) {
			return compilation_error();
		};

		@function = function->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != function) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		@seen.push_back((var Entity*(function)));

		usize slot = 0;

		while (slot < inherited && !dispatch_signature(*function, *entity->virtual_functions().data()[slot])) {
			@slot = slot + 1;
		};

		if (slot < inherited) {
			var Entity* previous = entity->virtual_functions().data()[slot];
			if (previous->nonthrowing() && !function->nonthrowing()) {
				@this.error(function->declaration(), "virtual override cannot weaken a nonthrowing exception specification");
				return compilation_error();
			};

			if (previous->is_final()) {
				var message = DiagnosticMessage();
				@message.text("final virtual operation cannot be overridden; function '");
				diagnostic_entity(@message, *function);
				@message.text("' has type '");
				diagnostic_type(@message, *function->type());
				@message.text("'");
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return compilation_error();
			};

			if (!function->requires_override() && !function->is_final()) {
				var message = DiagnosticMessage();
				@message.text("override of an inherited virtual operation requires override or final; function '");
				diagnostic_entity(@message, *function);
				@message.text("' has type '");
				diagnostic_type(@message, *function->type());
				@message.text("'");
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return compilation_error();
			};

			if (!dispatch_result(*function->type()->signature().result(), *previous->type()->signature().result())) {
				var message = DiagnosticMessage();
				@message.text("virtual override has an incompatible result type; function '");
				diagnostic_entity(@message, *function);
				@message.text("' has type '");
				diagnostic_type(@message, *function->type());
				@message.text("'");
				@message.text(" with result '");
				diagnostic_type(@message, *function->type()->signature().result());
				@message.text("'; inherited result is '");
				diagnostic_type(@message, *previous->type()->signature().result());
				@message.text("'");
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return compilation_error();
			};

			@entity->replace_virtual(usize(slot), @*function);
			@function->set_virtual_slot(slot);
		}
		else if (function->requires_override() || function->is_final() && !function->declares_virtual()) {
			var message = DiagnosticMessage();
			if (function->requires_override()) {
				@message.text("override");
			}
			else {
				@message.text("final without virtual");
			};
			@message.text(" on function '");
			diagnostic_entity(@message, *function);
			@message.text("' of type '");
			diagnostic_type(@message, *function->type());
			@message.text("' requires a matching inherited virtual operation");
			@this.report(function->token(), message.view());
			usize inherited_index = 0;
			while (inherited_index < inherited) {
				diagnostic_candidate(@*this.diagnostics, *entity->virtual_functions().data()[inherited_index]);
				@inherited_index = inherited_index + 1;
			};
			return compilation_error();
		}
		else if (function->declares_virtual()) {
			@function->set_virtual_slot(entity->virtual_functions().size());

			@entity->add_virtual((var Entity*(function)));
		};
	};

	if (entity->layout() == record_layout::overlapping && entity->virtual_functions().size()) {
		var message = DiagnosticMessage();
		@message.text("union '");
		diagnostic_entity(@message, *entity);
		@message.text("' cannot contain virtual operations");
		@this.report(entity->token(), message.view());
		return compilation_error();
	};

};

fn TemplateEngine::editor_context(var TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& arguments) -> var Entity* {
	return @this.instantiate(@analyzer, @*pattern.resolution_scope(), @pattern, TemplateInput(@arguments));
};

fn Analyzer::editor_template_context(var Analyzer& this, var SemanticUnit& unit, var SourceFile& source, usize anchor, var Syntax& arguments, var rt::string& label) -> CompilationResult {
	@this.unit = &@unit;
	var Entity* pattern = nullptr;
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* candidate = unit.entities().data()[index].get();
		Token token = candidate->token();
		if (candidate->kind() == entity_kind::template_pattern && token.source == &@source && token.begin == anchor) {
			@pattern = candidate;
			break;
		};
		@index = index + 1;
	};
	if (!pattern) {
		@this.unit = nullptr;
		Token token;
		@this.report(token, "the selected template declaration is no longer available");
		return compilation_error();
	};
	var Entity* instance = @this.templates.editor_context(@this, @*pattern, @arguments);
	if (!instance) {
		@this.unit = nullptr;
		return compilation_error();
	};
	@index = 0;
	while (index < unit.entities().size() && !this.failed()) {
		var Entity* entity = unit.entities().data()[index].get();
		@index = index + 1;
		var Scope* scope = entity->scope();
		while (scope && scope->owner() != instance) {
			@scope = scope->parent();
		};
		if (entity != instance && !scope) {
			continue;
		};
		if (!(@this.resolve(entity)).has<void>()) {
			break;
		};
		if (entity->kind() == entity_kind::function && entity->origin() != declaration_origin::compiler_supplied && entity->definition() != function_definition::deleted && !(@this.function_body(entity)).has<void>()) {
			break;
		};
	};
	if (!this.failed()) {
		var detail = DiagnosticMessage();
		diagnostic_entity(@detail, *instance);
		@label = rt::string(detail.view());
	};
	@this.unit = nullptr;
	if (!this.failed()) {
		return;
	};
	return compilation_error();
};

struct TemplateInstantiation;
struct TemplatePack;

enum entity_kind : [u08] {
	function;
	global;
	local;
	parameter;
	record;
	field;
	enumeration;
	enumerator;
	namespace_body;
	alias;
	type_parameter;
	template_pattern;
	primitive_type;
	constant;
	pack_binding;
	pack_signature;
	field_pack;
};

enum entity_state : [u08] {
	declared;
	resolving;
	ready;
};

enum record_resolution_phase : [u08] {
	fields;
	members;
	complete;
};

enum binding_lifetime : [u08] {
	live;
	consumed;
};

enum function_definition : [u08] {
	declaration;
	user_defined;
	defaulted;
	deleted;
};

enum function_completion : [u08] {
	unchecked;
	reaches_end;
	no_fallthrough;
};

enum exception_specification : [u08] {
	inferred;
	potentially_throwing;
	nonthrowing;
};

enum function_role : [u08] {
	ordinary;
	constructor;
	destructor;
	assignment;
	conversion;
};

enum function_linkage : [u08] {
	rutile;
	c;
};

enum conversion_mode : [u08] {
	explicit_only;
	implicit_allowed;
};

enum access_kind : [u08] {
	public_access;
	protected_access;
	private_access;
};

enum record_layout : [u08] {
	sequential;
	overlapping;
};

enum function_dispatch : [u08] {
	ordinary;
	virtual_function;
	override_function;
	final_function;
};

enum declaration_origin : [u08] {
	source;
	compiler_supplied;
};

struct Scope;
struct CopyAssignmentPlan;

struct Entity {
	fn pack(Entity& this) -> var TemplatePack*;
	fn set_pack(var Entity& this, var TemplatePack* pack);
	fn Entity(var Entity& this, entity_kind kind, Token& token, var Syntax* source, var Scope* scope);

	fn kind(Entity& this) -> entity_kind;
	fn canonical(Entity& this) -> var Entity*;
	fn token(Entity& this) -> Token;
	fn name(Entity& this) -> rt::string_view;
	fn set_name(var Entity& this, rt::string_view name);
	fn origin(Entity& this) -> declaration_origin;
	fn set_origin(var Entity& this, declaration_origin origin);
	fn merge_into(var Entity& this, var Entity* canonical);
	fn adopt_definition(var Entity& this, Entity& source);

	fn type(Entity& this) -> Type*;
	fn set_type(var Entity& this, Type* type);
	fn type_use(Entity& this) -> rt::optional_ref<const TypeUse>&;
	fn set_type_use(var Entity& this, TypeUse& use);
	fn underlying(Entity& this) -> Type*;
	fn set_underlying(var Entity& this, Type* type);
	fn denotes_type(Entity& this) -> bool;
	fn layout(Entity& this) -> record_layout;
	fn member_owner(Entity& this) -> var Entity*;
	fn accessible_from(Entity& this, Scope& scope) -> bool;
	fn imported_definition(Entity& this) -> bool;
	fn module_exported(Entity& this) -> bool;
	fn bases(Entity& this) -> rt::buffer<Type*>&;
	fn add_base(var Entity& this, Type* type);

	fn declaration(Entity& this) -> var Syntax*;
	fn replace_declaration(var Entity& this, var Syntax* syntax);
	fn scope(Entity& this) -> var Scope*;
	fn resolution_scope(Entity& this) -> var Scope*;
	fn set_resolution_scope(var Entity& this, var Scope* scope);
	fn members(Entity& this) -> var Scope*;
	fn set_members(var Entity& this, var Scope* scope);
	fn find_member(Entity& this, rt::string_view name) -> var Entity*;

	fn parameters(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_parameter(var Entity& this, var Entity* parameter);
	fn fields(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_field(var Entity& this, var Entity* field);
	fn set_fields(var Entity& this, rt::buffer<var Entity*> fields);
	fn index(Entity& this) -> usize;
	fn set_index(var Entity& this, usize index);
	fn body(Entity& this) -> var SemanticExpression*;
	fn set_body(var Entity& this, rt::unique<SemanticExpression> body);
	fn body_state(Entity& this) -> entity_state;
	fn set_body_state(var Entity& this, entity_state state);
	fn completion(Entity& this) -> function_completion;
	fn set_completion(var Entity& this, function_completion completion);

	fn destructor(Entity& this) -> var Entity*;
	fn set_destructor(var Entity& this, var Entity* function);
	fn default_constructor(Entity& this) -> var Entity*;
	fn set_default_constructor(var Entity& this, var Entity* function);
	fn copy_constructor(Entity& this) -> var Entity*;
	fn set_copy_constructor(var Entity& this, var Entity* function);
	fn move_constructor(Entity& this) -> var Entity*;
	fn set_move_constructor(var Entity& this, var Entity* function);
	fn copy_assignment(Entity& this) -> var CopyAssignmentPlan*;
	fn set_copy_assignment(var Entity& this, rt::unique<CopyAssignmentPlan> plan);

	fn virtual_owner(Entity& this) -> var Entity*;
	fn owns_dispatch(Entity& this) -> bool;
	fn virtual_functions(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_virtual(var Entity& this, var Entity* function);
	fn replace_virtual(var Entity& this, usize index, var Entity& function);
	fn dispatch(Entity& this) -> function_dispatch;
	fn set_dispatch(var Entity& this, function_dispatch dispatch);
	fn declares_virtual(Entity& this) -> bool;
	fn requires_override(Entity& this) -> bool;
	fn is_final(Entity& this) -> bool;
	fn merge_dispatch(var Entity& this, Entity& source);
	fn virtual_slot(Entity& this) -> usize;
	fn set_virtual_slot(var Entity& this, usize slot);
	fn dispatch_required(Entity& this) -> bool;
	fn require_dispatch(var Entity& this);

	fn definition(Entity& this) -> function_definition;
	fn linkage(Entity& this) -> function_linkage;
	fn set_definition(var Entity& this, function_definition definition);
	fn role(Entity& this) -> function_role;
	fn set_role(var Entity& this, function_role role);
	fn set_exception_specification(var Entity& this, exception_specification specification);
	fn exception_contract(Entity& this) -> exception_specification;
	fn nonthrowing(Entity& this) -> bool;
	fn exception_state(Entity& this) -> entity_state;
	fn set_exception_state(var Entity& this, entity_state state);
	fn conversion(Entity& this) -> conversion_mode;
	fn set_conversion(var Entity& this, conversion_mode mode);
	fn access(Entity& this) -> access_kind;
	fn set_access(var Entity& this, access_kind access);
	fn operator_kind(Entity& this) -> token_kind;
	fn set_operator_kind(var Entity& this, token_kind operation);

	fn state(Entity& this) -> entity_state;
	fn set_state(var Entity& this, entity_state state);
	fn record_phase(Entity& this) -> record_resolution_phase;
	fn set_record_phase(var Entity& this, record_resolution_phase phase);
	fn lifetime(Entity& this) -> binding_lifetime;
	fn set_lifetime(var Entity& this, binding_lifetime lifetime);
	fn integer(Entity& this) -> u64;
	fn set_integer(var Entity& this, u64 value);
	fn instantiated(Entity& this) -> bool;
	fn set_instantiated(var Entity& this);
	fn template_arguments(Entity& this) -> TemplateInstantiation*;
	fn set_template_arguments(var Entity& this, TemplateInstantiation* arguments);

private:
	entity_kind category;
	declaration_origin declaration_origin_kind;
	rt::string generated_name;
	entity_state resolution;
	record_resolution_phase record_resolution;
	entity_state body_resolution;
	function_completion body_completion;
	bool template_instance;
	TemplateInstantiation* retained_arguments;
	bool virtual_specified;
	bool override_specified;
	bool final_specified;
	bool dispatch_live;
	usize dispatch_slot;
	function_definition body_kind;
	function_role function_kind;
	exception_specification exception_kind;
	entity_state exception_resolution;
	conversion_mode conversion_kind;
	access_kind visibility;
	token_kind operator_symbol;
	binding_lifetime validity;
	Token location;
	var Syntax* source;
	var Scope* declaration_scope;
	var Scope* definition_scope;
	var Scope* member_scope;
	var Entity* previous_declaration;
	var Entity* finalizer;
	var Entity* default_initializer;
	var Entity* copy_initializer;
	rt::unique<CopyAssignmentPlan> copy_assigner;
	var Entity* move_initializer;
	Type* value_type;
	rt::optional_ref<const TypeUse> use;
	Type* underlying_type;
	usize position;
	u64 constant_value;
	var TemplatePack* bound_pack;
	rt::buffer<var Entity*> arguments;
	rt::buffer<var Entity*> member_fields;
	rt::buffer<Type*> base_types;
	rt::buffer<var Entity*> dispatch_table;
	rt::unique<SemanticExpression> implementation;
};

fn Entity::find_member(Entity& this, rt::string_view name) -> var Entity* {
	if (!this.members()) {
		return nullptr;
	};

	var Entity* result = this.members()->local(name);

	if (result || this.bases().size() != 1) {
		return result;
	};

	var Entity* base = this.bases().data()[0]->entity();

	if (base->name() == name) {
		return $base;
	};

	return base->find_member(name);
};

fn Entity::virtual_owner(Entity& this) -> var Entity* {
	if (!this.virtual_functions().size()) {
		return nullptr;
	};

	if (this.bases().size() && this.bases().data()[0]->entity()->virtual_functions().size()) {
		return this.bases().data()[0]->entity()->virtual_owner();
	};

	return const_cast<var Entity*>(&@this);
};

fn Entity::owns_dispatch(Entity& this) -> bool {
	return this.virtual_functions().size() && (!this.bases().size() || !this.bases().data()[0]->entity()->virtual_functions().size());
};

fn Entity::virtual_functions(Entity& this) -> rt::buffer<var Entity*>& {
	return this.dispatch_table;
};

fn Entity::add_virtual(var Entity& this, var Entity* function) {
	@this.dispatch_table.push_back($function);
};

fn Entity::replace_virtual(var Entity& this, usize index, var Entity& function) {
	var entries = (@this.dispatch_table).data();
	@entries[index] = &@function;
};

fn Entity::dispatch(Entity& this) -> function_dispatch {
	if (this.final_specified) {
		return function_dispatch::final_function;
	};

	if (this.override_specified) {
		return function_dispatch::override_function;
	};

	if (this.virtual_specified) {
		return function_dispatch::virtual_function;
	};

	return function_dispatch::ordinary;
};

fn Entity::declares_virtual(Entity& this) -> bool {
	return this.virtual_specified;
};

fn Entity::requires_override(Entity& this) -> bool {
	return this.override_specified;
};

fn Entity::is_final(Entity& this) -> bool {
	return this.final_specified;
};

fn Entity::set_dispatch(var Entity& this, function_dispatch dispatch) {
	if (dispatch == function_dispatch::virtual_function) {
		@this.virtual_specified = true;
	};

	if (dispatch == function_dispatch::override_function) {
		@this.override_specified = true;
	};

	if (dispatch == function_dispatch::final_function) {
		@this.final_specified = true;
	};
};

fn Entity::merge_dispatch(var Entity& this, Entity& source) {
	@this.virtual_specified = this.virtual_specified || source.virtual_specified;
	@this.override_specified = this.override_specified || source.override_specified;
	@this.final_specified = this.final_specified || source.final_specified;
};

fn Entity::virtual_slot(Entity& this) -> usize {
	return this.dispatch_slot;
};

fn Entity::set_virtual_slot(var Entity& this, usize slot) {
	@this.dispatch_slot = $slot;
};

fn Entity::dispatch_required(Entity& this) -> bool {
	return this.dispatch_live;
};

fn Entity::require_dispatch(var Entity& this) {
	@this.dispatch_live = true;
};

fn Entity::bases(Entity& this) -> rt::buffer<Type*>& {
	return this.base_types;
};

fn Entity::add_base(var Entity& this, Type* type) {
	@this.base_types.push_back($type);
};

fn Entity::Entity(var Entity& this, entity_kind kind, Token& token, var Syntax* source, var Scope* scope) {
	@this.category = $kind;
	@this.location := token;
	@this.source = $source;
	@this.declaration_scope = $scope;
};

fn Entity::kind(Entity& this) -> entity_kind {
	return entity_kind(this.category);
};

fn Entity::layout(Entity& this) -> record_layout {
	if (this.declaration() && this.declaration()->token().kind == token_kind::kw_union) {
		return record_layout::overlapping;
	};

	return record_layout::sequential;
};

fn Entity::denotes_type(Entity& this) -> bool {
	switch (this.kind()) {
		case entity_kind::primitive_type:
		case entity_kind::record:
		case entity_kind::enumeration:
		case entity_kind::alias:
		case entity_kind::type_parameter:
			return true;
		case entity_kind::template_pattern:
			return this.declaration()->kind() == syntax_kind::template_declaration && (this.declaration()->template_declaration()->kind() == syntax_kind::record || this.declaration()->template_declaration()->kind() == syntax_kind::using_alias);
		default:
			return false;
	};
};

fn Entity::member_owner(Entity& this) -> var Entity* {
	if (this.kind() == entity_kind::alias || this.kind() == entity_kind::type_parameter) {
		if (!this.type() || this.type()->kind() != type_kind::named) {
			return nullptr;
		};

		return this.type()->entity();
	};

	if (this.members()) {
		return const_cast<var Entity*>(&@this);
	};

	return nullptr;
};

fn Entity::instantiated(Entity& this) -> bool {
	return this.template_instance;
};

fn Entity::set_instantiated(var Entity& this) {
	@this.template_instance = true;
};

fn Entity::body_state(Entity& this) -> entity_state {
	return entity_state(this.body_resolution);
};

fn Entity::set_body_state(var Entity& this, entity_state state) {
	@this.body_resolution = $state;
};

fn Entity::completion(Entity& this) -> function_completion {
	return function_completion(this.body_completion);
};

fn Entity::set_completion(var Entity& this, function_completion completion) {
	@this.body_completion = $completion;
};

fn Entity::canonical(Entity& this) -> var Entity* {
	if (this.previous_declaration) {
		return this.previous_declaration->canonical();
	};

	return const_cast<var Entity*>(&@this);
};

fn Entity::token(Entity& this) -> Token {
	return Token(this.location);
};

fn Entity::name(Entity& this) -> rt::string_view {
	if (!this.generated_name.empty()) {
		return this.generated_name.view();
	};

	return this.location.text();
};

fn Entity::set_name(var Entity& this, rt::string_view name) {
	@this.generated_name.append(name);
};

fn Entity::origin(Entity& this) -> declaration_origin {
	return declaration_origin(this.declaration_origin_kind);
};

fn Entity::set_origin(var Entity& this, declaration_origin origin) {
	@this.declaration_origin_kind = $origin;
};

fn Entity::type_use(Entity& this) -> rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn Entity::set_type_use(var Entity& this, TypeUse& use) {
	@this.use.bind(use);
};

fn Entity::type(Entity& this) -> Type* {
	return this.value_type;
};

fn Entity::declaration(Entity& this) -> var Syntax* {
	return this.source;
};

fn Entity::scope(Entity& this) -> var Scope* {
	return this.declaration_scope;
};

fn Entity::resolution_scope(Entity& this) -> var Scope* {
	if (this.definition_scope) {
		return this.definition_scope;
	};

	return this.declaration_scope;
};

fn Entity::set_resolution_scope(var Entity& this, var Scope* scope) {
	@this.definition_scope = $scope;
};

fn Entity::members(Entity& this) -> var Scope* {
	return this.member_scope;
};

fn Entity::body(Entity& this) -> var SemanticExpression* {
	return this.implementation.get();
};

fn Entity::parameters(Entity& this) -> rt::buffer<var Entity*>& {
	return this.arguments;
};

fn Entity::fields(Entity& this) -> rt::buffer<var Entity*>& {
	return this.member_fields;
};

fn Entity::index(Entity& this) -> usize {
	return this.position;
};

fn Entity::state(Entity& this) -> entity_state {
	return entity_state(this.resolution);
};

fn Entity::lifetime(Entity& this) -> binding_lifetime {
	return binding_lifetime(this.validity);
};

fn Entity::integer(Entity& this) -> u64 {
	return this.constant_value;
};

fn Entity::underlying(Entity& this) -> Type* {
	return this.underlying_type;
};

fn Entity::destructor(Entity& this) -> var Entity* {
	if (!this.finalizer) {
		return nullptr;
	};

	return this.finalizer->canonical();
};

fn Entity::default_constructor(Entity& this) -> var Entity* {
	return this.default_initializer;
};

fn Entity::copy_constructor(Entity& this) -> var Entity* {
	return this.copy_initializer;
};

fn Entity::move_constructor(Entity& this) -> var Entity* {
	return this.move_initializer;
};

fn Entity::set_default_constructor(var Entity& this, var Entity* function) {
	@this.default_initializer = $function;
};

fn Entity::set_copy_constructor(var Entity& this, var Entity* function) {
	@this.copy_initializer = $function;
};

fn Entity::set_move_constructor(var Entity& this, var Entity* function) {
	@this.move_initializer = $function;
};

fn Entity::definition(Entity& this) -> function_definition {
	return function_definition(this.body_kind);
};

fn Entity::linkage(Entity& this) -> function_linkage {
	if (this.kind() == entity_kind::function && this.declaration() && !this.declaration()->function_linkage().text().empty()) {
		return function_linkage::c;
	};
	return function_linkage::rutile;
};

fn Entity::role(Entity& this) -> function_role {
	return function_role(this.function_kind);
};

fn Entity::set_exception_specification(var Entity& this, exception_specification specification) {
	@this.exception_kind = $specification;
};

fn Entity::exception_contract(Entity& this) -> exception_specification {
	return exception_specification(this.exception_kind);
};

fn Entity::exception_state(Entity& this) -> entity_state {
	return entity_state(this.exception_resolution);
};

fn Entity::set_exception_state(var Entity& this, entity_state state) {
	@this.exception_resolution = $state;
};

fn exception_type_nonthrowing(Type& type) -> bool {
	if (type.kind() == type_kind::array) {
		return exception_type_nonthrowing(*type.element());
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* destructor = type.entity()->destructor();
	if (destructor) {
		return destructor->nonthrowing();
	};
	usize base = 0;
	while (base < type.entity()->bases().size()) {
		if (!exception_type_nonthrowing(*type.entity()->bases().data()[base])) {
			return false;
		};
		@base = base + 1;
	};
	usize field = 0;
	while (field < type.entity()->fields().size()) {
		if (!exception_type_nonthrowing(*type.entity()->fields().data()[field]->type())) {
			return false;
		};
		@field = field + 1;
	};
	return true;
};

enum exception_operation : [u08] {
	initialize;
	copy_construct;
	copy_assign;
};

fn exception_operation_nonthrowing(Type& type, exception_operation operation) -> bool {
	if (type.kind() == type_kind::array) {
		return exception_operation_nonthrowing(*type.element(), exception_operation(operation));
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* record = type.entity();
	var Entity* selected = record->default_constructor();
	if (operation == exception_operation::copy_construct) {
		@selected = record->copy_constructor();
	}
	else if (operation == exception_operation::copy_assign) {
		var CopyAssignmentPlan* plan = record->copy_assignment();
		if (plan) {
			return exception_expression_nonthrowing(plan->expression());
		};
		return false;
	};
	if (selected) {
		return selected->nonthrowing();
	};
	if (record->layout() == record_layout::overlapping) {
		return true;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!exception_operation_nonthrowing(*record->bases().data()[index], exception_operation(operation))) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		if (operation == exception_operation::initialize && field->body()) {
			if (!exception_initializer_nonthrowing(*field->body())) {
				return false;
			};
		}
		else if (!exception_operation_nonthrowing(*field->type(), exception_operation(operation))) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Entity::nonthrowing(Entity& this) -> bool {
	if (this.exception_kind != exception_specification::inferred) {
		return this.exception_kind == exception_specification::nonthrowing;
	};
	if (this.role() != function_role::destructor && this.definition() != function_definition::defaulted) {
		return false;
	};
	var Entity* owner = this.scope()->owner();
	if (!owner || owner->kind() != entity_kind::record) {
		return this.role() == function_role::destructor;
	};
	if (this.definition() == function_definition::defaulted && variant_instance(*owner)) {
		return variant_special_nonthrowing(this);
	};
	if (this.role() == function_role::constructor && this.parameters().size() == 2 && this.parameters().data()[1]->type()->kind() != type_kind::reference) {
		return true;
	};
	if (this.role() == function_role::assignment && this.parameters().size() == 2 && this.parameters().data()[1]->type()->kind() != type_kind::reference) {
		var Entity* move = owner->move_constructor();
		return exception_type_nonthrowing(*owner->type()) && (!move || move->nonthrowing());
	};
	if (owner->layout() == record_layout::overlapping && this.role() != function_role::destructor) {
		return true;
	};
	exception_operation operation = exception_operation::initialize;
	if (this.role() == function_role::assignment) {
		@operation = exception_operation::copy_assign;
	}
	else if (this.role() == function_role::constructor && this.parameters().size() == 2) {
		@operation = exception_operation::copy_construct;
	};
	usize index = 0;
	while (index < owner->bases().size()) {
		Type& base = *owner->bases().data()[index];
		bool safe = exception_type_nonthrowing(base);
		if (this.role() != function_role::destructor) {
			@safe = exception_operation_nonthrowing(base, exception_operation(operation));
		};
		if (!safe) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < owner->fields().size()) {
		var Entity* field = owner->fields().data()[index];
		bool safe = exception_type_nonthrowing(*field->type());
		if (this.role() != function_role::destructor) {
			@safe = exception_operation_nonthrowing(*field->type(), exception_operation(operation));
			if (operation == exception_operation::initialize && field->body()) {
				@safe = exception_initializer_nonthrowing(*field->body());
			};
		};
		if (!safe) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Entity::conversion(Entity& this) -> conversion_mode {
	return conversion_mode(this.conversion_kind);
};

fn Entity::access(Entity& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Entity::set_access(var Entity& this, access_kind access) {
	@this.visibility = $access;
};

fn Entity::operator_kind(Entity& this) -> token_kind {
	return token_kind(this.operator_symbol);
};

fn Entity::set_operator_kind(var Entity& this, token_kind operation) {
	@this.operator_symbol = $operation;
};

fn Entity::set_definition(var Entity& this, function_definition definition) {
	@this.body_kind = $definition;
};

fn Entity::set_role(var Entity& this, function_role role) {
	@this.function_kind = $role;
};

fn Entity::set_conversion(var Entity& this, conversion_mode mode) {
	@this.conversion_kind = $mode;
};

fn Entity::set_destructor(var Entity& this, var Entity* function) {
	@this.finalizer = $function;
};

fn Entity::set_type(var Entity& this, Type* type) {
	@this.value_type = $type;
};

fn Entity::merge_into(var Entity& this, var Entity* canonical) {
	if (this.declaration() && this.declaration()->exported() && canonical->declaration()) {
		@canonical->declaration()->mark_exported();
	};
	@this.previous_declaration = $canonical;
};

fn Entity::replace_declaration(var Entity& this, var Syntax* syntax) {
	if (this.declaration() && this.declaration()->exported() && syntax) {
		@syntax->mark_exported();
	};
	@this.source = $syntax;
};

fn Entity::adopt_definition(var Entity& this, Entity& source) {
	if (this.declaration() && this.declaration()->exported() && source.declaration()) {
		@source.declaration()->mark_exported();
	};
	@this.source = source.declaration();
	@this.member_scope = source.members();
	@this.body_kind = source.definition();
	@this.function_kind = source.role();
	@this.exception_kind = source.exception_contract();

	if (source.conversion() == conversion_mode::implicit_allowed) {
		@this.conversion_kind = conversion_mode::implicit_allowed;
	};

	@this.arguments.clear();
	usize index = 0;
	while (index < source.parameters().size()) {
		@this.arguments.push_back(source.parameters().data()[index]);

		@index = index + 1;
	};

};

fn Entity::set_members(var Entity& this, var Scope* scope) {
	@this.member_scope = $scope;
};

fn Entity::set_body(var Entity& this, rt::unique<SemanticExpression> body) {
	@this.implementation = $body;
	@this.body_completion = function_completion::unchecked;
};

fn Entity::set_state(var Entity& this, entity_state state) {
	@this.resolution = $state;
};

fn Entity::record_phase(Entity& this) -> record_resolution_phase {
	return record_resolution_phase(this.record_resolution);
};

fn Entity::set_record_phase(var Entity& this, record_resolution_phase phase) {
	@this.record_resolution = $phase;
};

fn Entity::set_lifetime(var Entity& this, binding_lifetime lifetime) {
	@this.validity = $lifetime;
};

fn Entity::set_integer(var Entity& this, u64 value) {
	@this.constant_value = $value;
};

fn Entity::set_underlying(var Entity& this, Type* type) {
	@this.underlying_type = $type;
};

fn Entity::set_index(var Entity& this, usize index) {
	@this.position = $index;
};

fn Entity::add_parameter(var Entity& this, var Entity* parameter) {
	@this.arguments.push_back($parameter);
};

fn Entity::add_field(var Entity& this, var Entity* field) {
	@this.member_fields.push_back($field);
};

fn Entity::set_fields(var Entity& this, rt::buffer<var Entity*> fields) {
	@this.member_fields = $fields;
};

fn Entity::template_arguments(Entity& this) -> TemplateInstantiation* {
	return this.retained_arguments;
};

fn Entity::set_template_arguments(var Entity& this, TemplateInstantiation* arguments) {
	@this.retained_arguments = $arguments;
};

fn Entity::accessible_from(Entity& this, Scope& scope) -> bool {
	Scope* scope_cursor = &@scope;

	if (this.access() == access_kind::public_access) {
		return true;
	};

	while (scope_cursor) {
		if (scope_cursor->owner() == this.scope()->owner()) {
			return true;
		};

		if (this.access() == access_kind::protected_access && scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record && this.scope()->owner() && scope_cursor->owner()->type() && this.scope()->owner()->type() && scope_cursor->owner()->type()->derived_from(*this.scope()->owner()->type())) {
			return true;
		};

		@scope_cursor = scope_cursor->parent();
	};

	return false;
};

fn Entity::imported_definition(Entity& this) -> bool {
	Token token = this.token();
	return token.source && token.source->imported() && !this.instantiated() && this.origin() != declaration_origin::compiler_supplied;
};

fn Entity::module_exported(Entity& this) -> bool {
	if (this.kind() == entity_kind::namespace_body || this.origin() == declaration_origin::compiler_supplied) {
		return true;
	};
	var Syntax* declaration = this.declaration();
	while (declaration && declaration->kind() == syntax_kind::template_declaration) {
		@declaration = declaration->item(1);
	};
	if (declaration && declaration->exported()) {
		return true;
	};
	var Scope* owner = this.scope();
	if (owner && owner->owner() && owner->owner()->kind() != entity_kind::namespace_body) {
		return owner->owner()->module_exported();
	};
	return false;
};

fn Entity::pack(Entity& this) -> var TemplatePack* {
	return this.bound_pack;
};

fn Entity::set_pack(var Entity& this, var TemplatePack* pack) {
	@this.bound_pack = $pack;
};

enum value_category : [u08] {
	place;
	consumable;
};

enum inferred_condition_state : [u08] {
	unknown;
	when_false;
	when_true;
};

enum semantic_kind : [u08] {
	noop;
	literal_integer;
	literal_real;
	literal_text;
	null_pointer;
	name;
	unary;
	binary;
	call;
	brace;
	statements;
	sequence;
	deferred_argument;
	variable;
	return_value;
	exception_try;
	exception_handler;
	exception_throw;
	exception_rethrow;
	conditional;
	switch_expression;
	case_label;
	while_loop;
	for_loop;
	break_loop;
	continue_loop;
	cast;
	variant_cast;
	variant_payload;
	relocation;
	access;
	dereference;
	address;
	index;
	member;
	construction;
	allocation;
	deallocation;
	array_deallocation;
	destruction;
	sizeof_type;
	discard_value;
};

struct SemanticExpression {
	fn SemanticExpression(var SemanticExpression& this, semantic_kind kind, Type* type, Token& token);
	fn make(semantic_kind kind, Type* type, Token& token) -> rt::unique<SemanticExpression>;

	fn set_type_use(var SemanticExpression& this, TypeUse& use);
	fn set_mutable_access(var SemanticExpression& this, bool permitted);
	fn append(var SemanticExpression& this, rt::unique<SemanticExpression> child) -> CompilationResult;
	fn bind(var SemanticExpression& this, var Entity* entity, value_category category);
	fn set_category(var SemanticExpression& this, value_category category);
	fn set_integer(var SemanticExpression& this, u64 value);
	fn set_real(var SemanticExpression& this, f64 value);
	fn set_text(var SemanticExpression& this, rt::string_view value);
	fn set_inferred_integer(var SemanticExpression& this, u64 value);
	fn inferred_integer(SemanticExpression& this, var u64& value) -> bool;
	fn set_inferred_condition(var SemanticExpression& this, bool value);
	fn inferred_condition(SemanticExpression& this, var bool& value) -> bool;
	fn set_inferred_alternative(var SemanticExpression& this, u64 alternative);
	fn inferred_alternative(SemanticExpression& this) -> u64;

	fn copy_constant(SemanticExpression& this) -> rt::unique<SemanticExpression>;
	fn constant_truth(SemanticExpression& this, var bool& result) -> bool;
	fn constant_integer(SemanticExpression& this, var u64& result) -> bool;
	fn constant_real(SemanticExpression& this, var f64& result) -> bool;
	fn real_comparison(SemanticExpression& this, var u64& result) -> bool;
	fn owned_binding(SemanticExpression& this) -> var Entity*;
	fn indirect_storage(SemanticExpression& this) -> bool;
	fn kind(SemanticExpression& this) -> semantic_kind;
	fn type_use(SemanticExpression& this) -> rt::optional_ref<const TypeUse>&;
	fn type(SemanticExpression& this) -> Type*;
	fn token(SemanticExpression& this) -> Token;
	fn entity(SemanticExpression& this) -> var Entity*;
	fn operation(SemanticExpression& this) -> token_kind;
	fn category(SemanticExpression& this) -> value_category;
	fn mutable_access(SemanticExpression& this) -> bool;
	fn integer(SemanticExpression& this) -> u64;
	fn real(SemanticExpression& this) -> f64;
	fn text(SemanticExpression& this) -> rt::string_view;
	fn size(SemanticExpression& this) -> usize;
	fn item(SemanticExpression& this, usize index) -> var SemanticExpression*;

private:
	semantic_kind category_kind;
	bool has_inferred_integer;
	inferred_condition_state inferred_condition_value;
	u64 inferred_integer_value;
	u64 inferred_alternative_value;
	value_category value_kind;
	bool reference_access;
	Type* value_type;
	rt::optional_ref<const TypeUse> use;
	Token location;
	var Entity* binding;
	u64 integer_value;
	f64 real_value;
	rt::string text_value;
	rt::buffer<rt::unique<SemanticExpression>> children;
};

fn SemanticExpression::owned_binding(SemanticExpression& this) -> var Entity* {
	if (this.kind() == semantic_kind::name) {
		var Entity* entity = this.entity();

		if (entity && (entity->kind() == entity_kind::local || entity->kind() == entity_kind::parameter) && entity->type()->kind() != type_kind::reference) {
			return $entity;
		};

		return nullptr;
	};

	if (this.kind() == semantic_kind::access || this.kind() == semantic_kind::cast && this.category() == value_category::place) {
		return this.item(0)->owned_binding();
	};

	return nullptr;
};

fn SemanticExpression::indirect_storage(SemanticExpression& this) -> bool {
	switch (this.kind()) {
		case semantic_kind::dereference:
			return true;
		case semantic_kind::index:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::member:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::access:
		case semantic_kind::cast:
		case semantic_kind::variant_cast:
			return this.category() == value_category::place && this.item(0)->indirect_storage();
		default:
			return false;
	};
};

fn SemanticExpression::make(semantic_kind kind, Type* type, Token& token) -> rt::unique<SemanticExpression> {
	var result = rt::unique<SemanticExpression>(new SemanticExpression($kind, type, token));
	if (!result.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(SemanticExpression);
		throw $error;
	};
	return $result;
};

fn SemanticExpression::SemanticExpression(var SemanticExpression& this, semantic_kind kind, Type* type, Token& token) {
	@this.category_kind = $kind;
	@this.value_type = $type;
	@this.location := token;
	@this.value_kind = value_category::consumable;
};

fn SemanticExpression::kind(SemanticExpression& this) -> semantic_kind {
	return semantic_kind(this.category_kind);
};

fn SemanticExpression::type_use(SemanticExpression& this) -> rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn SemanticExpression::set_type_use(var SemanticExpression& this, TypeUse& use) {
	@this.use.bind(use);
};

fn SemanticExpression::type(SemanticExpression& this) -> Type* {
	if (this.kind() == semantic_kind::name && this.binding && this.binding->kind() == entity_kind::function) {
		return this.binding->type();
	};
	return this.value_type;
};

fn SemanticExpression::token(SemanticExpression& this) -> Token {
	return Token(this.location);
};

fn SemanticExpression::entity(SemanticExpression& this) -> var Entity* {
	return this.binding;
};

fn SemanticExpression::operation(SemanticExpression& this) -> token_kind {
	return token_kind(this.location.kind);
};

fn SemanticExpression::category(SemanticExpression& this) -> value_category {
	return value_category(this.value_kind);
};

fn SemanticExpression::mutable_access(SemanticExpression& this) -> bool {
	if (this.type()->qualifier() == type_qualifier::immutable) {
		return false;
	};

	if (this.kind() == semantic_kind::access || this.reference_access) {
		return true;
	};

	return this.binding && this.binding->type() && this.binding->type()->kind() == type_kind::reference && this.binding->type()->element()->qualifier() == type_qualifier::mutable;
};

fn SemanticExpression::set_mutable_access(var SemanticExpression& this, bool permitted) {
	@this.reference_access = $permitted;
};

fn SemanticExpression::integer(SemanticExpression& this) -> u64 {
	return this.integer_value;
};

fn SemanticExpression::real(SemanticExpression& this) -> f64 {
	return this.real_value;
};

fn SemanticExpression::text(SemanticExpression& this) -> rt::string_view {
	return this.text_value.view();
};

fn SemanticExpression::size(SemanticExpression& this) -> usize {
	return this.children.size();
};

fn SemanticExpression::item(SemanticExpression& this, usize index) -> var SemanticExpression* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn SemanticExpression::append(var SemanticExpression& this, rt::unique<SemanticExpression> child) -> CompilationResult {
	if (!child.get()) {
		return compilation_error();
	};

	@this.children.push_back($child);
};

fn SemanticExpression::bind(var SemanticExpression& this, var Entity* entity, value_category category) {
	@this.binding = $entity;
	@this.value_kind = $category;
};

fn SemanticExpression::set_category(var SemanticExpression& this, value_category category) {
	@this.value_kind = $category;
};

fn SemanticExpression::set_integer(var SemanticExpression& this, u64 value) {
	@this.integer_value = $value;
};

fn SemanticExpression::set_inferred_integer(var SemanticExpression& this, u64 value) {
	@this.has_inferred_integer = true;
	@this.inferred_integer_value = value;
};

fn SemanticExpression::inferred_integer(SemanticExpression& this, var u64& value) -> bool {
	@value = this.inferred_integer_value;
	return this.has_inferred_integer;
};

fn SemanticExpression::set_inferred_condition(var SemanticExpression& this, bool value) {
	@this.inferred_condition_value = inferred_condition_state::when_false;
	if (value) {
		@this.inferred_condition_value = inferred_condition_state::when_true;
	};
};

fn SemanticExpression::inferred_condition(SemanticExpression& this, var bool& value) -> bool {
	@value = this.inferred_condition_value == inferred_condition_state::when_true;
	return this.inferred_condition_value != inferred_condition_state::unknown;
};

fn SemanticExpression::set_inferred_alternative(var SemanticExpression& this, u64 alternative) {
	@this.inferred_alternative_value = alternative;
};

fn SemanticExpression::inferred_alternative(SemanticExpression& this) -> u64 {
	return this.inferred_alternative_value;
};

fn SemanticExpression::set_real(var SemanticExpression& this, f64 value) {
	@this.real_value = $value;
};

fn SemanticExpression::set_text(var SemanticExpression& this, rt::string_view value) {
	@this.text_value.append(value);
};

enum inferred_override_kind : [u08] {
	integer;
	alternative;
	evaluated_condition;
};

struct InferredExpressionFact {
	var SemanticExpression* expression;
	u64 value;
	inferred_override_kind kind;
};

struct InferredCallBinding {
	var SemanticExpression* expression;
	usize context;
};

struct InferredFunctionContext {
	var Entity* function;
	rt::buffer<InferredExpressionFact> overrides;
	rt::buffer<InferredCallBinding> calls;
};

struct InferredContextSet {
	rt::buffer<rt::unique<InferredFunctionContext>> contexts;
	rt::buffer<InferredCallBinding> calls;
};

fn Analyzer::exception_spec(var Analyzer& this, var Scope& scope, var Syntax& syntax, var bool& nonthrowing) -> CompilationResult {
	@nonthrowing = false;
	if (syntax.kind() == syntax_kind::absent) {
		return;
	};
	@nonthrowing = true;
	if (syntax.operand()->kind() == syntax_kind::absent) {
		return;
	};
	var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>(*this.types->find_primitive("bool")));
	u64 result = 0;
	if (!value.get() || !@this.constant_integer(*value.get(), @result)) {
		@this.error(&@syntax, "noexcept specification requires a constant boolean expression");
		return compilation_error();
	};
	@nonthrowing = result != 0;
};

fn exception_expression_contract(SemanticExpression& expression, bool temporary) -> bool {
	semantic_kind kind = expression.kind();
	if (kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow || kind == semantic_kind::allocation) {
		return false;
	};
	if (kind == semantic_kind::call) {
		var Entity* function = expression.entity();
		if (function && function->kind() == entity_kind::function) {
			if (!function->nonthrowing()) {
				return false;
			};
		}
		else {
			Type* callable = expression.item(0)->type();
			if (callable->kind() == type_kind::pointer || callable->kind() == type_kind::reference) {
				@callable = callable->element();
			};
			if (callable->kind() != type_kind::function || !callable->signature().nonthrowing()) {
				return false;
			};
		};
	};
	if (kind == semantic_kind::construction || kind == semantic_kind::destruction) {
		if (expression.entity() && !expression.entity()->nonthrowing()) {
			return false;
		};
	};
	if (kind == semantic_kind::construction && expression.type()->kind() == type_kind::array) {
		var SemanticExpression* arguments = expression.item(0);
		if (!arguments->size() && !exception_operation_nonthrowing(*expression.type(), exception_operation::initialize)) {
			return false;
		};
		if (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*expression.type()) && arguments->item(0)->category() == value_category::place && !exception_operation_nonthrowing(*expression.type(), exception_operation::copy_construct)) {
			return false;
		};
	};
	if (kind == semantic_kind::construction && !expression.entity() && expression.type()->kind() == type_kind::named && expression.type()->entity()->kind() == entity_kind::record) {
		var Entity* record = expression.type()->entity();
		var SemanticExpression* arguments = expression.item(0);
		if (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*expression.type())) {
			if (arguments->item(0)->category() == value_category::place) {
				if (!exception_operation_nonthrowing(*expression.type(), exception_operation::copy_construct)) {
					return false;
				};
			}
			else if (record->move_constructor() && !record->move_constructor()->nonthrowing()) {
				return false;
			};
		}
		else if (record->layout() != record_layout::overlapping) {
			usize base = 0;
			while (base < record->bases().size()) {
				if (!exception_operation_nonthrowing(*record->bases().data()[base], exception_operation::initialize)) {
					return false;
				};
				@base = base + 1;
			};
			usize field = arguments->size();
			while (field < record->fields().size()) {
				var Entity* member = record->fields().data()[field];
				if (member->body()) {
					if (!exception_initializer_nonthrowing(*member->body())) {
						return false;
					};
				}
				else if (!exception_operation_nonthrowing(*member->type(), exception_operation::initialize)) {
					return false;
				};
				@field = field + 1;
			};
		};
	};
	if (kind == semantic_kind::deallocation || kind == semantic_kind::array_deallocation) {
		Type* pointer = expression.item(0)->type();
		if (pointer->kind() == type_kind::pointer && !exception_type_nonthrowing(*pointer->element())) {
			return false;
		};
	};
	if (temporary && (kind == semantic_kind::construction || kind == semantic_kind::call) || kind == semantic_kind::variable) {
		Type* object = expression.type();
		if (kind == semantic_kind::variable && expression.entity()) {
			@object = expression.entity()->type();
		};
		if (!exception_type_nonthrowing(*object)) {
			return false;
		};
	};
	usize index = 0;
	while (index < expression.size()) {
		if (!exception_expression_nonthrowing(*expression.item(index))) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn exception_expression_nonthrowing(SemanticExpression& expression) -> bool {
	return exception_expression_contract(expression, true);
};

fn exception_initializer_nonthrowing(SemanticExpression& expression) -> bool {
	return exception_expression_contract(expression, false);
};

fn Analyzer::prepare_exception_spec(var Analyzer& this, SemanticExpression& expression) -> CompilationResult {
	var Entity* function = expression.entity();
	if (function && function->kind() == entity_kind::function && !(@this.prepare_function_exception(@*function)).has<void>()) {
		return compilation_error();
	};
	usize index = 0;
	while (index < expression.size()) {
		if (!(@this.prepare_exception_spec(*expression.item(index))).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn Analyzer::potentially_throwing(Analyzer& this, SemanticExpression& expression) -> bool {
	return !exception_expression_nonthrowing(expression);
};

fn exception_member_access(var Analyzer& analyzer, var Entity* member, var Scope& scope, Token& location) -> bool {
	if (!member) {
		return true;
	};
	if (member->definition() == function_definition::deleted) {
		@analyzer.deleted_function(location, *member);
		return false;
	};
	if (!analyzer.accessible_at(*member, @scope, location)) {
		var message = DiagnosticMessage();
		@message.text("exception handling requires function '");
		diagnostic_entity(@message, *member);
		@message.text("' which is not accessible from this scope");
		@analyzer.report(location, message.view());
		@analyzer.note(member->token(), "function is declared here");
		return false;
	};
	return true;
};

fn Analyzer::expression_impl(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (this.diagnostics->failed()) {
		return rt::unique<SemanticExpression>();
	};

	Type* void_type = this.types->find_primitive("void");
	syntax_kind kind = syntax.kind();
	if (kind == syntax_kind::exception_query) {
		return @this.expression_form(@scope, @syntax, expected);
	};
	if (this.editor && kind == syntax_kind::error_expression) {
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};
	if (this.editor && kind == syntax_kind::qualified_name && syntax.right()->kind() == syntax_kind::absent) {
		discard @this.lookup(@scope, @syntax);
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (this.editor && this.recovery_operand(syntax)) {
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* child = syntax.item(index);
			@index = index + 1;
			if (kind == syntax_kind::cast && child == syntax.cast_type()) {
				if (!@this.type(@scope, @*child)) {
					return rt::unique<SemanticExpression>();
				};
				continue;
			};
			var known = @this.expression(@scope, @*child, rt::optional_ref<const Type>());
			if (!known.get()) {
				return rt::unique<SemanticExpression>();
			};
		};
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::grouping) {
		return @this.expression(@scope, @*syntax.operand(), expected);
	};
	if (kind == syntax_kind::unary) {
		return @this.unary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::binary) {
		return @this.binary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::call) {
		return @this.call(@scope, @syntax, expected, false);
	};

	if (kind == syntax_kind::cast) {
		return @this.cast(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::member || kind == syntax_kind::index) {
		return @this.component(@scope, @syntax, expected);
	};

	return @this.expression_form(@scope, @syntax, expected);
};

fn Analyzer::expression_form(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Type* void_type = this.types->find_primitive("void");
	Type* bool_type = this.types->find_primitive("bool");
	syntax_kind kind = syntax.kind();
	if (kind == syntax_kind::exception_query) {
		var operand = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());
		if (!operand.get() || !(@this.prepare_exception_spec(*operand.get())).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		var result = @this.node(semantic_kind::literal_integer, bool_type, &@syntax);
		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};
		@result.get()->set_integer(static_cast<u64>(!this.potentially_throwing(*operand.get())));
		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::pack_fold) {
		return @this.pack_fold(@scope, @syntax, expected);
	};
	if (kind == syntax_kind::pack_signature_declaration) {
		if (!(@this.templates.collect_signature(@this, @scope, @syntax)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};
	if (kind == syntax_kind::pack_literal || kind == syntax_kind::pack_expansion) {
		@this.error(&@syntax, "a compile-time pack requires a pack binding, template argument, expansion list, or fold");
		return rt::unique<SemanticExpression>();
	};

	if (kind == syntax_kind::switch_expression) {
		@this.variant_facts.clear();
		var result = @this.selection(@scope, @syntax);
		@this.variant_facts.clear();
		return $result;
	};

	if (kind == syntax_kind::case_label) {
		@this.variant_facts.clear();
		return @this.label(@scope, @syntax);
	};

	if (kind == syntax_kind::sizeof_type) {
		Type* target = @this.type(@scope, @*syntax.designated_type());

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.size_query(@syntax, *target), expected, @syntax);
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::ambiguity) {
		usize cast_index = 0;
		while (cast_index < syntax.size()) {
			var Syntax* candidate = syntax.item(cast_index);
			if (candidate->kind() == syntax_kind::cast && candidate->token().kind == token_kind::punct_left_paren) {
				var Syntax* operand = candidate->cast_operand();
				while (operand->kind() == syntax_kind::grouping) {
					@operand = operand->operand();
				};
				if (operand->kind() == syntax_kind::name || operand->kind() == syntax_kind::qualified_name) {
					var Entity* binding = @this.lookup(@scope, @*operand);
					if (binding && !binding->denotes_type() && (@this.resolve(binding)).has<void>()) {
						Type* owner = binding->type();
						if (owner && owner->kind() == type_kind::reference) {
							@owner = owner->element();
						};
						if (aggregate_access_kind(owner) == 2) {
							return @this.expression(@scope, @*candidate, expected);
						};
					};
				};
			};
			@cast_index = cast_index + 1;
		};
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			var Syntax* type = nullptr;

			if (candidate->kind() == syntax_kind::variable) {
				@type = candidate->variable_type();
			}
			else if (candidate->kind() == syntax_kind::sizeof_type) {
				@type = candidate->designated_type();
			};

			if (candidate->kind() == syntax_kind::call) {
				@type = candidate->callable();
			};

			if (type && (candidate->kind() == syntax_kind::variable && @this.templates.signature(@this, @scope, @*type) || @this.names_type(@scope, @*type))) {
				return @this.expression(@scope, @*candidate, expected);
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			if (candidate->kind() == syntax_kind::cast && candidate->token().kind == token_kind::punct_left_paren && !@this.names_type(@scope, @*candidate->cast_type())) {
				@index = index + 1;
				continue;
			};

			if (candidate->kind() == syntax_kind::call) {
				syntax_kind callee = candidate->callable()->kind();

				if (callee == syntax_kind::record || callee == syntax_kind::type_name || callee == syntax_kind::type_pointer || callee == syntax_kind::type_reference || callee == syntax_kind::type_array || (callee == syntax_kind::type_const || callee == syntax_kind::type_mutable) || callee == syntax_kind::type_function || callee == syntax_kind::type_auto || callee == syntax_kind::type_tuple || callee == syntax_kind::type_variant || callee == syntax_kind::type_grouping) {
					@index = index + 1;
					continue;
				};
			};

			if (syntax.item(index)->kind() != syntax_kind::variable && syntax.item(index)->kind() != syntax_kind::sizeof_type) {
				return @this.expression(@scope, @*syntax.item(index), expected);
			};

			@index = index + 1;
		};

		var message = DiagnosticMessage();
		@message.text("syntax beginning with ");
		@message.quoted(syntax.token().text());
		@message.text(" has no interpretation in this scope");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	bool character_literal = kind == syntax_kind::number && syntax.token().text().size() && syntax.token().text().data()[0] == '\'';

	if (kind == syntax_kind::number && !character_literal) {
		u64 integer = 0;

		if ((@this.integer(@syntax, @integer)).has<void>()) {
			Type* type = expected.get();

			if (!type || !type->kind().is_integer() || type->kind() == type_kind::boolean) {
				@type = this.types->find_primitive("i32");

				if (integer > static_cast<u64>(i32::max)) {
					@type = this.types->find_primitive("i64");
				};

				if (integer > static_cast<u64>(i64::max)) {
					@type = this.types->find_primitive("u64");
				};
			};

			var result = @this.node(semantic_kind::literal_integer, type, &@syntax);

			if (result.get()) {
				@result.get()->set_integer(u64(integer));
			};

			return @this.convert($result, expected, @syntax);
		};

		var spelling = rt::string(syntax.token().text());
		var char* end = nullptr;
		f64 real = strtod(spelling.c_str(), &@end);

		if (!end || end[0]) {
			var message = DiagnosticMessage();
			@message.text("numeric literal ");
			@message.quoted(syntax.token().text());
			@message.text(" is not representable as an integer or floating-point value");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		Type* type = this.types->find_primitive("f64");

		if (expected.has_value() && expected.value().kind() == type_kind::floating_point) {
			@type = expected.get();
		};

		var result = @this.node(semantic_kind::literal_real, type, &@syntax);

		if (result.get()) {
			@result.get()->set_real(f64(real));
		};

		return $result;
	};

	if (kind == syntax_kind::string || character_literal) {
		var text = syntax.token().text();
		rt::string decoded;
		bool raw = !character_literal && text.size() >= 6 && text.data()[0] == '"' && text.data()[1] == '"' && text.data()[2] == '"';
		usize delimiter = 1;
		if (raw) {
			@delimiter = 3;
		};
		usize index = delimiter;
		while (index + delimiter < text.size()) {
			char character := text.data()[index];
			@index = index + 1;

			if (!raw && character == '\\' && index + 1 < text.size()) {
				@character := text.data()[index];
				@index = index + 1;

				if (character == 'n') {
					@character = '\n';
				}
				else if (character == 'r') {
					@character = '\r';
				}
				else if (character == 't') {
					@character = '\t';
				}
				else if (character == '0') {
					@character = '\0';
				}
				else if (character != '\\' && character != '\'' && character != '"') {
					var message = DiagnosticMessage();
					@message.text("unsupported escape ");
					@message.quoted(rt::string_view(text.data() + index - 2, 2));
					@message.text(" in literal ");
					@message.quoted(text);
					@this.report(syntax.token(), message.view());

					return rt::unique<SemanticExpression>();
				};
			};

			@decoded.append(rt::string_view(&@character, 1));
		};

		Type* character_type = this.types->find_primitive("char");

		if (text.data()[0] == '\'') {
			if (decoded.size() != 1) {
				var message = DiagnosticMessage();
				@message.text("character literal ");
				@message.quoted(text);
				@message.text(" shall contain one character; decoded length is ");
				@message.number(u64(decoded.size()));
				@this.report(syntax.token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			var result = @this.node(semantic_kind::literal_integer, character_type, &@syntax);

			if (result.get()) {
				char character := decoded.data()[0];
				@result.get()->set_integer(static_cast<u64>($character));
			};

			return @this.convert($result, expected, @syntax);
		};

		var Entity* runtime_namespace = this.unit->root_scope()->local("rt");
		var Entity* view = nullptr;
		if (runtime_namespace && runtime_namespace->kind() == entity_kind::namespace_body && runtime_namespace->members()) {
			@view = runtime_namespace->members()->local("string_view");
		};
		if (!view || view->kind() != entity_kind::record) {
			@this.report(syntax.token(), "string literals require the rt::string_view standard library declaration");
			return rt::unique<SemanticExpression>();
		};
		if (!(@this.resolve((var Entity*(view)))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		Type* element = @this.types->qualified(*character_type, type_qualifier::immutable);
		Type* bytes_type = @this.types->pointer(element);
		Type* size_type = this.types->find_primitive("usize");
		if (
			view->layout() != record_layout::sequential
			|| view->bases().size()
			|| view->owns_dispatch()
			|| view->fields().size() != 2
			|| !view->fields().data()[0]->type()->same_shape(*bytes_type)
			|| !view->fields().data()[1]->type()->same_shape(*size_type)
		) {
			@this.report(syntax.token(), "rt::string_view must store a character pointer followed by a usize length");
			return rt::unique<SemanticExpression>();
		};
		var result = @this.node(semantic_kind::literal_text, view->type(), &@syntax);

		if (result.get()) {
			@result.get()->set_text(decoded.view());
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::null_pointer) {
		Type* element = @this.types->qualified(*this.types->find_primitive("null"), type_qualifier::immutable);

		if (!element) {
			return rt::unique<SemanticExpression>();
		};

		Type* type = @this.types->pointer(element);

		return @this.convert(@this.node(semantic_kind::null_pointer, type, &@syntax), expected, @syntax);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Token token = syntax.token();

		if (token.is("true") || token.is("false")) {
			var result = @this.node(semantic_kind::literal_integer, bool_type, &@syntax);

			if (result.get() && token.is("true")) {
				@result.get()->set_integer(1);
			};

			return @this.convert($result, expected, @syntax);
		};

		var Entity* entity = @this.lookup(@scope, @syntax);

		if (!entity) {
			if (!this.diagnostics->failed()) {
				var message = DiagnosticMessage();
				@message.text("unknown identifier '");
				diagnostic_name(@message, syntax);
				@message.text("'");
				@this.diagnostics->error(syntax.token(), message.view());
			};
			return rt::unique<SemanticExpression>();
		};
		if (!this.accessible_at(*entity, @scope, syntax.token())) {
			@this.error(&@syntax, "declaration is not accessible from this scope");
			@this.note(entity->token(), "declaration is here");
			return rt::unique<SemanticExpression>();
		};
		if (!(@this.resolve((var Entity*(entity)))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@entity = entity->canonical();
		if (entity->kind() == entity_kind::field_pack && entity == this.folded_field_pack && this.folded_field_index < entity->fields().size()) {
			if (!entity->fields().data()[this.folded_field_index]) {
				return @this.null_member_pack(@scope, @syntax, entity, rt::unique<SemanticExpression>(), expected);
			};
			@entity = entity->fields().data()[this.folded_field_index];
		};

		if (entity->kind() != entity_kind::function) {
			@this.unit->record_name(@this, @scope, @syntax, @*entity, 4);
		};

		if (entity->kind() == entity_kind::constant) {
			return @this.convert(entity->body()->copy_constant(), expected, @syntax);
		};

		if (entity->kind() == entity_kind::enumerator) {
			var result = @this.node(semantic_kind::literal_integer, entity->type(), &@syntax);

			if (result.get()) {
				@result.get()->set_integer(entity->integer());
			};

			return @this.convert($result, expected, @syntax);
		};

		if (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global && entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter && entity->kind() != entity_kind::field) {
			var message = DiagnosticMessage();
			@message.text("identifier '");
			diagnostic_entity(@message, *entity);
			@message.text("' does not denote a value");
			@this.report(syntax.token(), message.view());
			@this.note(entity->token(), "referenced declaration is here");

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::function && entity->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *entity);

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::field) {
			var Entity* receiver = scope.lookup("this");

			if (!receiver || receiver->type()->kind() != type_kind::reference || receiver->type()->element()->kind() != type_kind::named || receiver->type()->element()->entity() != entity->scope()->owner()) {
				var message = DiagnosticMessage();
				@message.text("field access to '");
				diagnostic_entity(@message, *entity);
				@message.text("' requires an instance receiver of '");
				diagnostic_entity(@message, *entity->scope()->owner());
				@message.text("'");
				@this.report(syntax.token(), message.view());
				@this.note(entity->token(), "field is declared here");

				return rt::unique<SemanticExpression>();
			};

			Type* owner = receiver->type()->element();
			Type* field_type = entity->type();

			if (field_type->kind() == type_kind::reference) {
				@field_type = field_type->element();
			}
			else if (owner->qualifier() == type_qualifier::immutable) {
				@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
			};

			var object = @this.node(semantic_kind::name, owner, &@syntax);

			if (!object.get()) {
				return rt::unique<SemanticExpression>();
			};

			@object.get()->bind(receiver, value_category::place);
			var member = @this.node(semantic_kind::member, field_type, &@syntax);

			if (!member.get()) {
				return rt::unique<SemanticExpression>();
			};

			@member.get()->bind(entity, value_category::place);

			if (!(@member.get()->append($object)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			return @this.convert($member, expected, @syntax);
		};

		Type* type = entity->type();
		if (entity->kind() == entity_kind::function && !(@this.prepare_function_exception(@*entity)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		@type = entity->type();

		if (type->kind() == type_kind::reference) {
			@type = type->element();
		};

		var result = @this.node(semantic_kind::name, type, &@syntax);

		if (result.get()) {
			@result.get()->bind(entity, value_category::place);
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::brace || kind == syntax_kind::list) {
		if (kind == syntax_kind::brace && !syntax.size() && expected.has_value() && expected.value().kind() == type_kind::array) {
			Type* element = expected.get();

			while (element->kind() == type_kind::array) {
				@element = element->element();
			};

			if (!element->representation()->kind().is_scalar()) {
				var message = DiagnosticMessage();
				@message.text("empty initialization of object arrays is not specified; array type is '");
				diagnostic_type(@message, expected.value());
				@message.text("'");
				@this.report(syntax.token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			return @this.construct(@scope, @syntax, expected.get(), @syntax);
		};

		var Scope* local = &@scope;

		if (kind == syntax_kind::brace) {
			@local = @this.unit->create_scope(&@scope, this.function);
			if (local) {
				@this.unit->record_scope(@*local, @syntax);
			};
		};

		var result = @this.node(semantic_kind::brace, void_type, &@syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			var child = @this.expression(@*local, @*syntax.item(index), rt::optional_ref<const Type>());
			@child = @this.discarded(@*local, @*syntax.item(index), rt::unique<SemanticExpression>(@child.release()));

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@result.get()->append($child)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::using_alias || kind == syntax_kind::record || kind == syntax_kind::enumeration) {
		if (!(@this.collect(@scope, @syntax)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		var Syntax* name = syntax.alias_name();
		if (kind == syntax_kind::record) {
			@name = syntax.record_name();
		}
		else if (kind == syntax_kind::enumeration) {
			@name = syntax.enum_name();
		};
		var Entity* alias = scope.local(name->token().text());

		if (!alias || !(@this.resolve(alias)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::variable) {
		Token name = syntax.variable_name()->token();

		var Entity* previous = scope.local(name.text());
		if (previous) {
			var message = DiagnosticMessage();
			@message.text("duplicate local declaration of ");
			@message.quoted(name.text());
			@this.diagnostics->error(name, message.view());
			@this.diagnostics->note(previous->token(), "previous declaration is here");

			return rt::unique<SemanticExpression>();
		};

		if (@this.templates.signature(@this, @scope, @*syntax.variable_type())) {
			var TemplatePack* pack = nullptr;
			if (!(@this.pack_declaration(@scope, @syntax, @pack)).has<void>() || !(@this.templates.bind_pack(@this, @scope, @*syntax.variable_name(), @syntax, pack)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			return @this.node(semantic_kind::noop, void_type, &@syntax);
		};
		Type* type = @this.type(@scope, @*syntax.variable_type());
		var Syntax* initializer = syntax.variable_initializer();

		if (initializer->kind() == syntax_kind::unary) {
			@initializer = initializer->operand();
		};

		rt::optional_ref<const Type> initializer_type;

		if (type && !(type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) && syntax.variable_initializer()->token().kind != token_kind::op_copy) {
			@initializer_type.bind(*type);
		};

		var value = @this.expression(@scope, @*initializer, initializer_type);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!type && value.get()->kind() != semantic_kind::noop) {
			@type = @this.infer_variable(@syntax, *value.get());
			if (!type) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function) {
			var message = DiagnosticMessage();
			@message.text("variable ");
			@message.quoted(name.text());
			@message.text(" requires object storage or a reference; ");
			if (type) {
				@message.text("declared type is '");
				diagnostic_type(@message, *type);
				@message.text("'");
			}
			else {
				@message.text("neither a declared type nor an inferred initializer type is available");
			};
			@this.report(name, message.view());

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::reference && value.get()->kind() == semantic_kind::noop) {
			var message = DiagnosticMessage();
			@message.text("reference ");
			@message.quoted(name.text());
			@message.text(" of type '");
			diagnostic_type(@message, *type);
			@message.text("' requires an initializer");
			@this.report(name, message.view());

			return rt::unique<SemanticExpression>();
		};

		@value = @this.initialize(@syntax, type, rt::unique<SemanticExpression>(@value.release()));

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		var Entity* entity = @this.unit->create_entity(entity_kind::local, name, &@syntax, &@scope);

		if (!entity) {
			return rt::unique<SemanticExpression>();
		};

		@entity->set_type(type);
		@entity->set_state(entity_state::ready);
		var result = @this.node(semantic_kind::variable, void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		Type* alternative = variant_flow_known(this.variant_facts, *value.get());
		if (alternative) {
			@this.variant_facts.establish(@*entity, alternative);
		};
		if (!(@result.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->bind(entity, value_category::consumable);

		return $result;
	};

	if (kind == syntax_kind::return_value) {
		if (!this.function) {
			@this.error(&@syntax, "return requires an enclosing function");

			return rt::unique<SemanticExpression>();
		};

		Type* result_type = this.function->type()->signature().result();
		var result = @this.node(semantic_kind::return_value, void_type, &@syntax);
		var value = rt::unique<SemanticExpression>();
		if (syntax.operand()->kind() == syntax_kind::absent) {
			@value = @this.convert(@this.node(semantic_kind::noop, void_type, syntax.operand()), rt::optional_ref<const Type>(*result_type), @*syntax.operand());
		}
		else {
			@value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>(*result_type));
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::exception_throw) {
		if (syntax.operand()->kind() == syntax_kind::absent) {
			return @this.convert(@this.node(semantic_kind::exception_rethrow, void_type, &@syntax), expected, @syntax);
		};
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());
		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};
		if (value.get()->category() != value_category::consumable) {
			@this.error(&@syntax, "throw requires a temporary; copy or move the operand explicitly");
			return rt::unique<SemanticExpression>();
		};
		Type* type = value.get()->type();
		if (type->kind() == type_kind::void_type) {
			@this.error(&@syntax, "exception object cannot have type void");
			return rt::unique<SemanticExpression>();
		};
		if (type->kind() == type_kind::array || type->kind() == type_kind::function) {
			Type* element = type;
			if (type->kind() == type_kind::array) {
				@element = type->element();
			};
			@type = @this.types->pointer(element);
		}
		else {
			@type = @this.types->qualified(*type, type_qualifier::mutable);
		};
		if (!type) {
			return rt::unique<SemanticExpression>();
		};
		if (type->kind() != type_kind::null_type && !type->has_layout() || type->kind() == type_kind::pointer && type->element()->kind() != type_kind::void_type && type->element()->kind() != type_kind::function && type->element()->kind() != type_kind::null_type && !type->element()->has_layout()) {
			@this.error(&@syntax, "exception object requires a complete object type");
			return rt::unique<SemanticExpression>();
		};
		if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && !exception_member_access(@this, type->entity()->destructor(), @scope, syntax.token())) {
			return rt::unique<SemanticExpression>();
		};
		@value = @this.initialize(@syntax, type, rt::unique<SemanticExpression>(@value.release()));
		if (value.get() && value.get()->kind() == semantic_kind::construction && !exception_member_access(@this, value.get()->entity(), @scope, syntax.token())) {
			return rt::unique<SemanticExpression>();
		};
		var result = @this.node(semantic_kind::exception_throw, void_type, &@syntax);
		if (!value.get() || !result.get() || !(@result.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::exception_try) {
		@this.variant_facts.clear();
		if (!this.function) {
			@this.error(&@syntax, "try requires an enclosing function");
			return rt::unique<SemanticExpression>();
		};
		var result = @this.node(semantic_kind::exception_try, void_type, &@syntax);
		var body = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());
		if (!result.get() || !body.get() || !(@result.get()->append($body)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		var Syntax* handlers = syntax.item(1);
		usize index = 0;
		while (index < handlers->size()) {
			@this.variant_facts.clear();
			var Syntax* source = handlers->item(index);
			var Syntax* parameter = source->item(0);
			var Scope* local = @this.unit->create_scope(&@scope, this.function);
			Type* type = void_type;
			var Entity* entity = nullptr;
			if (local) {
				@this.unit->record_scope(@*local, @*source);
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			if (parameter->kind() != syntax_kind::absent) {
				@type = @this.type(@*local, @*parameter->parameter_type());
				if (!type) {
					return rt::unique<SemanticExpression>();
				};
				if (type->kind() == type_kind::array) {
					@type = @this.types->pointer(type->element());
				}
				else if (type->kind() == type_kind::function) {
					@type = @this.types->pointer(type);
				};
				Type* object = type;
				if (object->kind() == type_kind::reference) {
					@object = object->element();
				};
				if (object->kind() == type_kind::void_type || object->kind() == type_kind::array || object->kind() == type_kind::function || object->kind() == type_kind::null_type) {
					@this.error(parameter, "catch declaration requires an object type or reference to an object type");
					return rt::unique<SemanticExpression>();
				};
				if (!object->has_layout() || object->kind() == type_kind::pointer && object->element()->kind() != type_kind::void_type && object->element()->kind() != type_kind::function && object->element()->kind() != type_kind::null_type && !object->element()->has_layout()) {
					@this.error(parameter, "catch declaration requires a complete exception type");
					return rt::unique<SemanticExpression>();
				};
				if (type->kind() != type_kind::reference && object->kind() == type_kind::named && object->entity()->kind() == entity_kind::record) {
					if (!exception_member_access(@this, object->entity()->copy_constructor(), @*local, parameter->token()) || !exception_member_access(@this, object->entity()->destructor(), @*local, parameter->token())) {
						return rt::unique<SemanticExpression>();
					};
				};
				Token name = parameter->parameter_name()->token();
				@entity = @this.unit->create_entity(entity_kind::local, name, parameter, local);
				if (!entity) {
					return rt::unique<SemanticExpression>();
				};
				@entity->set_type(type);
				@entity->set_state(entity_state::ready);
			}
			else if (index + 1 != handlers->size()) {
				@this.error(source, "catch(...) must be the final handler");
				return rt::unique<SemanticExpression>();
			};
			var handler = @this.node(semantic_kind::exception_handler, type, source);
			var Syntax* body_source = source->item(1);
			var handler_body = @this.node(semantic_kind::brace, void_type, body_source);
			if (handler.get()) {
				if (handler_body.get()) {
					@this.unit->record_scope(@*local, @*body_source);
				}
				else {
					return rt::unique<SemanticExpression>();
				};
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			usize statement = 0;
			while (statement < body_source->size()) {
				var child = @this.expression(@*local, @*body_source->item(statement), rt::optional_ref<const Type>());
				@child = @this.discarded(@*local, @*body_source->item(statement), rt::unique<SemanticExpression>(@child.release()));
				if (!child.get() || !(@handler_body.get()->append($child)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};
				@statement = statement + 1;
			};
			if (!(@handler.get()->append($handler_body)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@handler.get()->bind(entity, value_category::consumable);
			if (!(@result.get()->append($handler)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@index = index + 1;
		};
		@this.variant_facts.clear();
		return $result;
	};

	if (kind == syntax_kind::conditional) {
		var condition = @this.expression(@scope, @*syntax.condition(), rt::optional_ref<const Type>(*bool_type));
		if (!condition.get()) {
			return rt::unique<SemanticExpression>();
		};
		var before = VariantFlowFacts(this.variant_facts);
		if (!variant_flow_condition(@this.variant_facts, *condition.get(), true)) {
			return rt::unique<SemanticExpression>();
		};
		var body = @this.expression(@scope, @*syntax.body(), rt::optional_ref<const Type>());
		@body = @this.discarded(@scope, @*syntax.body(), rt::unique<SemanticExpression>(@body.release()));
		if (!body.get()) {
			return rt::unique<SemanticExpression>();
		};
		var after_body = VariantFlowFacts(this.variant_facts);
		@this.variant_facts := before;
		if (!variant_flow_condition(@this.variant_facts, *condition.get(), false)) {
			return rt::unique<SemanticExpression>();
		};
		var alternative = @this.expression(@scope, @*syntax.alternative(), rt::optional_ref<const Type>());
		@alternative = @this.discarded(@scope, @*syntax.alternative(), rt::unique<SemanticExpression>(@alternative.release()));
		if (!alternative.get()) {
			return rt::unique<SemanticExpression>();
		};
		bool body_exits = variant_flow_terminates(*body.get());
		bool alternative_exits = variant_flow_terminates(*alternative.get());
		if (body_exits && alternative_exits) {
			@this.variant_facts.clear();
		}
		else if (alternative_exits) {
			@this.variant_facts := after_body;
		}
		else if (!body_exits) {
			@this.variant_facts.intersect(after_body);
		};
		var result = @this.node(semantic_kind::conditional, void_type, &@syntax);
		if (!result.get() || !(@result.get()->append($condition)).has<void>() || !(@result.get()->append($body)).has<void>() || !(@result.get()->append($alternative)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return $result;
	};

	if (kind == syntax_kind::conditional || kind == syntax_kind::while_loop || kind == syntax_kind::for_loop) {
		@this.variant_facts.clear();
		semantic_kind category = semantic_kind::conditional;
		var Scope* local = &@scope;

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth + 1;
			@category = semantic_kind::while_loop;
		};

		if (kind == syntax_kind::for_loop) {
			@category = semantic_kind::for_loop;
			@local = @this.unit->create_scope(&@scope, this.function);
			if (local) {
				@this.unit->record_scope(@*local, @syntax);
			};
		};

		var result = @this.node(semantic_kind(category), void_type, &@syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			rt::optional_ref<const Type> context;

			if (kind == syntax_kind::for_loop && index == 1 || kind != syntax_kind::for_loop && !index) {
				if (syntax.item(index)->kind() != syntax_kind::absent) {
					@context.bind(*bool_type);
				};
			};

			var child = @this.expression(@*local, @*syntax.item(index), context);
			if (!context.has_value()) {
				@child = @this.discarded(@*local, @*syntax.item(index), rt::unique<SemanticExpression>(@child.release()));
			};

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!(@result.get()->append($child)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth - 1;
		};
		@this.variant_facts.clear();

		return $result;
	};

	if (kind == syntax_kind::break_loop || kind == syntax_kind::continue_loop) {
		if (!this.loop_depth && (kind == syntax_kind::continue_loop || !this.active_switch)) {
			if (kind == syntax_kind::continue_loop) {
				@this.report(syntax.token(), "'continue' requires an enclosing loop");
			}
			else {
				@this.report(syntax.token(), "'break' requires an enclosing loop or switch");
			};

			return rt::unique<SemanticExpression>();
		};

		if (kind == syntax_kind::break_loop) {
			return @this.node(semantic_kind::break_loop, void_type, &@syntax);
		};

		return @this.node(semantic_kind::continue_loop, void_type, &@syntax);
	};

	if (kind == syntax_kind::discard_value) {
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (value.get()->category() != value_category::consumable) {
			var message = DiagnosticMessage();
			@message.text("discard requires a consumable; operand is a place of type '");
			diagnostic_type(@message, *value.get()->type());
			@message.text("'");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::discard_value, void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::allocation) {
		var Syntax* type_syntax = syntax.allocation_type();
		var Syntax* count = nullptr;

		if (type_syntax->kind() == syntax_kind::type_array) {
			@count = type_syntax->array_extent();
			@type_syntax = type_syntax->designated_type();
		};

		Type* target = @this.type(@scope, @*type_syntax);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		var construction = rt::unique<SemanticExpression>();
		if (syntax.allocation_arguments()->token().kind == token_kind::punct_left_brace) {
			@construction = @this.node(semantic_kind::noop, target, &@syntax);
		}
		else {
			@construction = @this.construct(@scope, @syntax, target, @*syntax.allocation_arguments());
		};

		if (!construction.get()) {
			return rt::unique<SemanticExpression>();
		};

		Type* pointee = target;

		if (!type_syntax->explicitly_qualified()) {
			@pointee = @this.types->qualified(*target, type_qualifier::mutable);

			if (!pointee) {
				return rt::unique<SemanticExpression>();
			};
		};

		var Entity* runtime_namespace = this.unit->root_scope()->local("rt");
		var Entity* error = nullptr;
		var Entity* variant = nullptr;
		if (runtime_namespace && runtime_namespace->members()) {
			@error = runtime_namespace->members()->local("allocation_error");
			@variant = runtime_namespace->members()->local("variant");
		};
		if (!error || error->kind() != entity_kind::record || !variant || variant->kind() != entity_kind::template_pattern) {
			@this.report(syntax.token(), "allocation requires the rt::allocation_error and rt::variant standard library declarations");
			return rt::unique<SemanticExpression>();
		};
		if (!(@this.resolve(error)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		if (!(@this.prepare_default(error->type())).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		var TemplatePack* alternatives = @this.unit->create_pack();
		for (usize alternative = 0; alternative < 2; @alternative = alternative + 1) {
			TemplateArgument element;
			@element.kind = template_argument_kind::type;
			@element.type = error->type();
			if (!alternative) {
				@element.type = @this.types->pointer(pointee);
			};
			PackElementSignature signature;
			@signature.kind = template_argument_kind::type;
			@alternatives->signature.push_back($signature);
			@alternatives->elements.push_back($element);
		};
		Type* result_type = @this.templates.aggregate_type(@this, @scope, @syntax, syntax_kind::type_variant, @*alternatives);
		if (!result_type) {
			return rt::unique<SemanticExpression>();
		};
		var result = @this.node(semantic_kind::allocation, result_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($construction)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		if (count) {
			var extent = @this.expression(@scope, @*count, rt::optional_ref<const Type>());

			if (!extent.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!extent.get()->type()->kind().is_integer()) {
				var message = DiagnosticMessage();
				@message.text("array allocation count requires an integer; received '");
				diagnostic_type(@message, *extent.get()->type());
				@message.text("' when allocating elements of type '");
				diagnostic_type(@message, *target);
				@message.text("'");
				@this.report(count->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			if (!(@result.get()->append($extent)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::deallocation || kind == syntax_kind::array_deallocation) {
		var pointer = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!pointer.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (pointer.get()->type()->kind() != type_kind::pointer) {
			var message = DiagnosticMessage();
			if (kind == syntax_kind::array_deallocation) {
				@message.text("delete[]");
			}
			else {
				@message.text("delete");
			};
			@message.text(" requires a pointer; operand has type '");
			diagnostic_type(@message, *pointer.get()->type());
			@message.text("'");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		semantic_kind category = semantic_kind::deallocation;

		if (kind == syntax_kind::array_deallocation) {
			@category = semantic_kind::array_deallocation;
		};

		var result = @this.node(semantic_kind(category), void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($pointer)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	var message = DiagnosticMessage();
	@message.text("semantic analysis for this expression is not implemented; expression begins with ");
	@message.quoted(syntax.token().text());
	@this.report(syntax.token(), message.view());

	return rt::unique<SemanticExpression>();
};

enum function_fact_kind : [u08] {
	unknown;
	integer;
	entry_place;
	binary;
	unary;
	cast;
	variant;
};

struct FunctionFactExpression {
	function_fact_kind kind;
	u64 integer;
	var SemanticExpression* place;
	token_kind operation;
	usize left;
	usize right;
	Type* type;
};

struct FactPathCondition {
	usize value;
	bool truth;
};

enum function_fact_effect : [u08] {
	known_write;
	scoped_havoc;
};

struct FactWrite {
	var SemanticExpression* target;
	usize value;
	function_fact_effect kind;
};

struct FunctionFactOutcome {
	var SemanticExpression* return_expression;
	usize result;
	rt::buffer<FactPathCondition> conditions;
	rt::buffer<FactWrite> writes;
};

struct FunctionFactSummary {
	var Entity* function;
	rt::buffer<FunctionFactExpression> expressions;
	rt::buffer<FunctionFactOutcome> outcomes;
	rt::buffer<rt::unique<SemanticExpression>> projected_places;
	bool opaque;
};

struct FunctionFactBinding {
	var SemanticExpression* expression;
	usize value;
};

struct FunctionFactPath {
	rt::buffer<FactPathCondition> conditions;
	rt::buffer<FactWrite> writes;
	rt::buffer<FunctionFactBinding> bindings;
	bool returned;
	fn copy_from(var FunctionFactPath& this, FunctionFactPath& other);
};

fn FunctionFactPath::copy_from(var FunctionFactPath& this, FunctionFactPath& other) {
	@this.returned = other.returned;
	usize binding = 0;
	while (binding < other.bindings.size()) {
		@this.bindings.push_back(FunctionFactBinding(other.bindings.data()[binding]));
		@binding = binding + 1;
	};
	usize index = 0;
	while (index < other.conditions.size()) {
		@this.conditions.push_back(FactPathCondition(other.conditions.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.writes.size()) {
		@this.writes.push_back(FactWrite(other.writes.data()[index]));
		@index = index + 1;
	};
};

fn function_fact_unwrap(var SemanticExpression* expression) -> var SemanticExpression* {
	while (expression && expression->size() == 1 && (expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::cast && expression->category() == value_category::place && expression->type()->same_shape(*expression->item(0)->type()))) {
		@expression = expression->item(0);
	};
	return expression;
};

fn function_fact_same_place(var SemanticExpression* left, var SemanticExpression* right) -> bool {
	var SemanticExpression* first = function_fact_unwrap(left);
	var SemanticExpression* second = function_fact_unwrap(right);
	if (!first || !second) {
		return false;
	};
	if ((first->kind() == semantic_kind::name || first->kind() == semantic_kind::variable) && (second->kind() == semantic_kind::name || second->kind() == semantic_kind::variable)) {
		return first->entity() == second->entity();
	};
	return first->kind() == semantic_kind::member && second->kind() == semantic_kind::member && first->entity() == second->entity() && function_fact_same_place(first->item(0), second->item(0));
};

fn function_fact_root(var SemanticExpression* expression) -> var Entity* {
	@expression = function_fact_unwrap(expression);
	while (expression && expression->kind() == semantic_kind::member) {
		if (expression->entity() && expression->entity()->type()->kind() == type_kind::reference) {
			return nullptr;
		};
		var SemanticExpression* receiver = function_fact_unwrap(expression->item(0));
		Type* type = receiver->type();
		if (type->kind() == type_kind::reference) {
			@type = type->element();
		};
		if (type->kind() == type_kind::pointer || type->kind() == type_kind::named && type->entity()->layout() == record_layout::overlapping) {
			return nullptr;
		};
		@expression = receiver;
	};
	if (expression && (expression->kind() == semantic_kind::name || expression->kind() == semantic_kind::variable)) {
		return expression->entity();
	};
	return nullptr;
};

fn function_fact_contains_place(SemanticExpression* prefix, SemanticExpression* place) -> bool {
	var SemanticExpression* current = function_fact_unwrap(const_cast<var SemanticExpression*>(place));
	while (current) {
		if (function_fact_same_place(const_cast<var SemanticExpression*>(prefix), current)) {
			return true;
		};
		if (current->kind() != semantic_kind::member || current->size() != 1) {
			return false;
		};
		@current = function_fact_unwrap(current->item(0));
	};
	return false;
};

fn function_fact_reverse_comparison(token_kind operation) -> token_kind {
	switch (operation) {
		case token_kind::op_less:
			return token_kind::op_greater;
		case token_kind::op_less_equal:
			return token_kind::op_greater_equal;
		case token_kind::op_greater:
			return token_kind::op_less;
		case token_kind::op_greater_equal:
			return token_kind::op_less_equal;
	};
	return operation;
};

fn function_fact_truth(FunctionFactSummary& summary, usize value, usize depth) -> fact_truth {
	if (!value || value > summary.expressions.size() || depth > 32) {
		return fact_truth::unknown;
	};
	FunctionFactExpression& expression = summary.expressions.data()[value - 1];
	if (expression.kind == function_fact_kind::integer) {
		if (expression.integer) {
			return fact_truth::proven;
		};
		return fact_truth::disproven;
	};
	if (expression.kind == function_fact_kind::cast && expression.left && (expression.type->kind() == type_kind::boolean || expression.type->same_shape(*summary.expressions.data()[expression.left - 1].type))) {
		return function_fact_truth(summary, expression.left, depth + 1);
	};
	if (expression.kind == function_fact_kind::unary && expression.operation == token_kind::op_bang) {
		fact_truth child = function_fact_truth(summary, expression.left, depth + 1);
		if (child == fact_truth::proven) {
			return fact_truth::disproven;
		};
		if (child == fact_truth::disproven) {
			return fact_truth::proven;
		};
	};
	return fact_truth::unknown;
};

fn function_fact_unsigned_bound(FunctionFactSummary& summary, usize value, FunctionFactPath& path, usize depth) -> IntegerRange {
	if (!value || value > summary.expressions.size() || depth > 32) {
		return IntegerRange();
	};
	FunctionFactExpression& expression = summary.expressions.data()[value - 1];
	if (expression.kind == function_fact_kind::integer) {
		return fact_constant(expression.type, expression.integer);
	};
	if (expression.kind == function_fact_kind::cast && expression.left && expression.type->same_shape(*summary.expressions.data()[expression.left - 1].type)) {
		return function_fact_unsigned_bound(summary, expression.left, path, depth + 1);
	};
	Type* type = expression.type->representation();
	if (expression.kind != function_fact_kind::entry_place || type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean && type->kind() != type_kind::character) {
		return IntegerRange();
	};
	IntegerRange range = fact_range(0, fact_limit(type));
	usize index = 0;
	while (index < path.conditions.size()) {
		FactPathCondition& source = path.conditions.data()[index];
		usize condition = source.value;
		bool truth = source.truth;
		usize wrappers = 0;
		while (condition && condition <= summary.expressions.size() && wrappers < 32) {
			FunctionFactExpression& wrapper = summary.expressions.data()[condition - 1];
			if (wrapper.kind == function_fact_kind::unary && wrapper.operation == token_kind::op_bang) {
				@truth = !truth;
				@condition = wrapper.left;
			}
			else if (wrapper.kind == function_fact_kind::cast && wrapper.left && wrapper.type->kind() == type_kind::boolean && summary.expressions.data()[wrapper.left - 1].type->kind() == type_kind::boolean) {
				@condition = wrapper.left;
			}
			else {
				break;
			};
			@wrappers = wrappers + 1;
		};
		if (condition && condition <= summary.expressions.size()) {
			FunctionFactExpression& guard = summary.expressions.data()[condition - 1];
			if (guard.kind == function_fact_kind::binary && guard.left && guard.right && summary.expressions.data()[guard.left - 1].type->same_shape(*expression.type) && summary.expressions.data()[guard.right - 1].type->same_shape(*expression.type)) {
				FunctionFactExpression& first = summary.expressions.data()[guard.left - 1];
				FunctionFactExpression& second = summary.expressions.data()[guard.right - 1];
				token_kind operation = guard.operation;
				usize constant = 0;
				if (first.kind == function_fact_kind::entry_place && second.kind == function_fact_kind::integer && function_fact_same_place(first.place, expression.place)) {
					@constant = guard.right;
				}
				else if (second.kind == function_fact_kind::entry_place && first.kind == function_fact_kind::integer && function_fact_same_place(second.place, expression.place)) {
					@constant = guard.left;
					@operation = function_fact_reverse_comparison(operation);
				};
				if (constant) {
					FunctionFactExpression& bound = summary.expressions.data()[constant - 1];
					IntegerRange limit = fact_constant(bound.type, bound.integer);
					if (!truth) {
						@operation = fact_inverse(operation);
					};
					if (limit.available != fact_truth::unknown && limit.sign != integer_range_sign::negative) {
						if (operation == token_kind::op_less && limit.lower && range.upper >= limit.lower) {
							@range.upper = limit.lower - 1;
						};
						if (operation == token_kind::op_less_equal && range.upper > limit.lower) {
							@range.upper = limit.lower;
						};
						if (operation == token_kind::op_greater && limit.lower != u64::max && range.lower <= limit.lower) {
							@range.lower = limit.lower + 1;
						};
						if (operation == token_kind::op_greater_equal && range.lower < limit.lower) {
							@range.lower = limit.lower;
						};
						if (operation == token_kind::op_equal) {
							if (range.lower < limit.lower) {
								@range.lower = limit.lower;
							};
							if (range.upper > limit.lower) {
								@range.upper = limit.lower;
							};
						};
						if (operation == token_kind::op_not_equal) {
							if (range.upper == limit.lower && range.upper) {
								@range.upper = range.upper - 1;
							};
							if (range.lower == limit.lower && range.lower != u64::max) {
								@range.lower = range.lower + 1;
							};
						};
					};
				};
			};
		};
		@index = index + 1;
	};
	if (range.lower > range.upper) {
		return IntegerRange();
	};
	return $range;
};

fn function_fact_unknown_binary(token_kind operation) -> bool {
	return operation == token_kind::op_star || operation == token_kind::op_slash
		|| operation == token_kind::op_remainder || operation == token_kind::op_shift_left
		|| operation == token_kind::op_shift_right || operation == token_kind::op_ampersand
		|| operation == token_kind::op_pipe || operation == token_kind::op_caret;
};

struct FunctionFactSummaries {
	rt::buffer<rt::unique<FunctionFactSummary>> summaries;
	fn validate(var FunctionFactSummaries& this, SemanticUnit& unit);
	fn find(FunctionFactSummaries& this, Entity* function) -> var FunctionFactSummary*;
	fn build(var FunctionFactSummaries& this, var Entity& function);
	fn expression(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> usize;
	fn walk(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths);
	fn finish(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* returned, usize result, FunctionFactPath& path);
	fn import_value(var FunctionFactSummaries& this, var FunctionFactSummary& summary, FunctionFactSummary& callee, usize value, var SemanticExpression& call, var FunctionFactPath& path, usize depth) -> usize;
	fn payload_safe(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> bool;
	fn expand_call(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* call, var rt::buffer<rt::unique<FunctionFactPath>>& paths);
	fn scoped_array_write(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* target, var SemanticExpression* value, var FunctionFactPath& path);
	fn expand_boolean(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths, usize depth);
};

fn function_fact_clone_place(var SemanticExpression* source) -> rt::unique<SemanticExpression> {
	@source = function_fact_unwrap(source);
	if (!source || source->kind() != semantic_kind::name && source->kind() != semantic_kind::member) {
		return rt::unique<SemanticExpression>();
	};
	var token = source->token();
	var result = SemanticExpression::make(source->kind(), source->type(), token);
	@result.get()->bind(source->entity(), value_category::place);
	if (source->kind() == semantic_kind::member) {
		var child = function_fact_clone_place(source->item(0));
		if (!child.get()) {
			return rt::unique<SemanticExpression>();
		};
		if (!(@result.get()->append($child)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
	};
	return $result;
};

fn function_fact_project_place(FunctionFactSummary& callee, var SemanticExpression* source, var SemanticExpression& call) -> rt::unique<SemanticExpression> {
	@source = function_fact_unwrap(source);
	if (!source) {
		return rt::unique<SemanticExpression>();
	};
	if (source->kind() == semantic_kind::name) {
		usize parameter = 0;
		while (parameter < callee.function->parameters().size()) {
			if (source->entity() == callee.function->parameters().data()[parameter]) {
				if (call.size() != 2 || parameter >= call.item(1)->size()) {
					return rt::unique<SemanticExpression>();
				};
				return function_fact_clone_place(call.item(1)->item(parameter));
			};
			@parameter = parameter + 1;
		};
		return function_fact_clone_place(source);
	};
	if (source->kind() != semantic_kind::member) {
		return rt::unique<SemanticExpression>();
	};
	var token = source->token();
	var result = SemanticExpression::make(semantic_kind::member, source->type(), token);
	@result.get()->bind(source->entity(), value_category::place);
	var child = function_fact_project_place(callee, source->item(0), @call);
	if (!child.get()) {
		return rt::unique<SemanticExpression>();
	};
	if (!(@result.get()->append($child)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	return $result;
};

fn FunctionFactSummaries::find(FunctionFactSummaries& this, Entity* function) -> var FunctionFactSummary* {
	if (!function) {
		return nullptr;
	};
	@function = function->canonical();
	usize index = this.summaries.size();
	while (index) {
		@index = index - 1;
		if (this.summaries.data()[index].get()->function == function) {
			return this.summaries.data()[index].get();
		};
	};
	return nullptr;
};

fn FunctionFactSummaries::expression(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> usize {
	if (!expression || summary.expressions.size() >= 4096) {
		@summary.opaque = true;
		return 0;
	};
	usize binding = path.bindings.size();
	while (binding) {
		@binding = binding - 1;
		if (path.bindings.data()[binding].expression == expression) {
			return path.bindings.data()[binding].value;
		};
	};
	FunctionFactExpression result;
	@result.type = expression->type();
	u64 integer = 0;
	if (expression->constant_integer(@integer)) {
		@result.kind = function_fact_kind::integer;
		@result.integer = integer;
	}
	else if (expression->kind() == semantic_kind::access && expression->size() == 1) {
		return @this.expression(@summary, expression->item(0), @path);
	}
	else if (expression->kind() == semantic_kind::construction && !expression->entity() && expression->type()->representation()->kind().is_numeric() && expression->size() == 1 && expression->item(0)->kind() == semantic_kind::brace && expression->item(0)->size() <= 1) {
		if (!expression->item(0)->size()) {
			@result.kind = function_fact_kind::integer;
			@result.integer = 0;
		}
		else {
			@result.kind = function_fact_kind::cast;
			@result.left = @this.expression(@summary, expression->item(0)->item(0), @path);
		};
	}
	else if (expression->kind() == semantic_kind::cast && expression->size() == 1 && expression->type()->kind() == type_kind::named && variant_instance(*expression->type()->entity()) && expression->type()->same_shape(*expression->item(0)->type())) {
		return @this.expression(@summary, expression->item(0), @path);
	}
	else if (expression->kind() == semantic_kind::construction && !expression->entity() && expression->integer() && expression->type()->kind() == type_kind::named && variant_instance(*expression->type()->entity())) {
		var Entity* destructor = expression->type()->entity()->destructor();
		if (destructor && destructor->definition() != function_definition::defaulted) {
			@summary.opaque = true;
			return 0;
		};
		usize child = 0;
		while (child < expression->size()) {
			if (!@this.payload_safe(@summary, expression->item(child), @path)) {
				@summary.opaque = true;
				return 0;
			};
			@child = child + 1;
		};
		@result.kind = function_fact_kind::variant;
		@result.integer = expression->integer();
	}
	else if (expression->kind() == semantic_kind::name || expression->kind() == semantic_kind::member) {
		usize index = path.writes.size();
		while (index) {
			@index = index - 1;
			FactWrite& effect = path.writes.data()[index];
			if (effect.kind == function_fact_effect::scoped_havoc && (function_fact_contains_place(effect.target, expression) || function_fact_contains_place(expression, effect.target))) {
				@result.kind = function_fact_kind::unknown;
				@summary.expressions.push_back($result);
				return summary.expressions.size();
			};
			if (function_fact_same_place(expression, effect.target)) {
				return effect.value;
			};
		};
		var Entity* root = function_fact_root(expression);
		if (!root || root->kind() != entity_kind::parameter && root->kind() != entity_kind::global) {
			@summary.opaque = true;
			return 0;
		};
		@result.kind = function_fact_kind::entry_place;
		@result.place = expression;
	}
	else if (expression->kind() == semantic_kind::call && expression->entity() && expression->size() == 2) {
		var FunctionFactSummary* callee = this.find(expression->entity());
		if (!callee || callee->opaque || callee->outcomes.size() != 1 || callee->outcomes.data()[0].writes.size()) {
			@summary.opaque = true;
			return 0;
		};
		// Even unused arguments execute. Check every argument for opaque effects.
		usize argument = 0;
		while (argument < expression->item(1)->size()) {
			discard @this.expression(@summary, expression->item(1)->item(argument), @path);
			@argument = argument + 1;
		};
		// A read-only callee can restrict its normal continuation even when
		// its other paths throw. Substitute those guards through wrappers.
		FunctionFactOutcome& outcome = callee->outcomes.data()[0];
		usize condition = 0;
		while (condition < outcome.conditions.size()) {
			FactPathCondition guard;
			@guard.value = @this.import_value(@summary, *callee, outcome.conditions.data()[condition].value, @*expression, @path, 0);
			@guard.truth = outcome.conditions.data()[condition].truth;
			@path.conditions.push_back($guard);
			@condition = condition + 1;
		};
		if (!outcome.result) {
			return 0;
		};
		return @this.import_value(@summary, *callee, callee->outcomes.data()[0].result, @*expression, @path, 0);
	}
	else if ((expression->kind() == semantic_kind::index || expression->kind() == semantic_kind::dereference) && expression->type()->representation()->kind().is_scalar()) {
		// A memory read has an unknown value, but does not erase the guards
		// on paths that return normally. Its operands still execute.
		usize child = 0;
		while (child < expression->size()) {
			discard @this.expression(@summary, expression->item(child), @path);
			@child = child + 1;
		};
		@result.kind = function_fact_kind::unknown;
	}
	else if ((expression->kind() == semantic_kind::binary && expression->size() == 2) || (expression->kind() == semantic_kind::unary && expression->size() == 1) || (expression->kind() == semantic_kind::cast && expression->size() == 1)) {
		@result.operation = expression->operation();
		if (expression->kind() == semantic_kind::binary && !function_fact_unknown_binary(result.operation) && result.operation != token_kind::op_plus && result.operation != token_kind::op_minus && result.operation != token_kind::op_less && result.operation != token_kind::op_less_equal && result.operation != token_kind::op_greater && result.operation != token_kind::op_greater_equal && result.operation != token_kind::op_equal && result.operation != token_kind::op_not_equal) {
			@summary.opaque = true;
			return 0;
		};
		if (expression->kind() == semantic_kind::unary && result.operation != token_kind::op_bang && result.operation != token_kind::op_minus && result.operation != token_kind::op_plus) {
			@summary.opaque = true;
			return 0;
		};
		@result.kind = function_fact_kind::binary;
		if (expression->kind() == semantic_kind::binary && function_fact_unknown_binary(result.operation)) {
			@result.kind = function_fact_kind::unknown;
		}
		else if (expression->kind() == semantic_kind::cast) {
			@result.kind = function_fact_kind::cast;
		}
		else if (expression->kind() == semantic_kind::unary) {
			@result.kind = function_fact_kind::unary;
		};
		@result.left = @this.expression(@summary, expression->item(0), @path);
		if (expression->size() == 2) {
			@result.right = @this.expression(@summary, expression->item(1), @path);
		};
	}
	else {
		@summary.opaque = true;
		return 0;
	};
	@summary.expressions.push_back($result);
	return summary.expressions.size();
};

fn FunctionFactSummaries::payload_safe(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var FunctionFactPath& path) -> bool {
	if (!expression) {
		return false;
	};
	if (expression->kind() == semantic_kind::construction) {
		Type* type = expression->type();
		if (expression->entity() && expression->entity()->definition() != function_definition::defaulted) {
			return false;
		};
		if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			var Entity* record = type->entity();
			var Entity* destructor = record->destructor();
			if (record->fields().size() || record->bases().size() || destructor && destructor->definition() != function_definition::defaulted) {
				return false;
			};
		}
		else if (!type->representation()->kind().is_scalar()) {
			return false;
		};
	}
	else if (expression->kind() != semantic_kind::brace && expression->kind() != semantic_kind::cast && expression->kind() != semantic_kind::access) {
		discard @this.expression(@summary, expression, @path);
		return !summary.opaque;
	};
	usize child = 0;
	while (child < expression->size()) {
		if (!@this.payload_safe(@summary, expression->item(child), @path)) {
			return false;
		};
		@child = child + 1;
	};
	return true;
};

fn FunctionFactSummaries::import_value(var FunctionFactSummaries& this, var FunctionFactSummary& summary, FunctionFactSummary& callee, usize value, var SemanticExpression& call, var FunctionFactPath& path, usize depth) -> usize {
	if (!value || value > callee.expressions.size() || depth > 64) {
		@summary.opaque = true;
		return 0;
	};
	FunctionFactExpression result = FunctionFactExpression(callee.expressions.data()[value - 1]);
	if (result.kind == function_fact_kind::entry_place) {
		var SemanticExpression* source = function_fact_unwrap(result.place);
		usize parameter = 0;
		while (source->kind() == semantic_kind::name && parameter < callee.function->parameters().size()) {
			if (source->entity() == callee.function->parameters().data()[parameter]) {
				if (source->entity()->type()->kind() == type_kind::reference) {
					var projected = function_fact_clone_place(call.item(1)->item(parameter));
					if (!projected.get()) {
						@summary.opaque = true;
						return 0;
					};
					var SemanticExpression* place = projected.get();
					@summary.projected_places.push_back($projected);
					return @this.expression(@summary, place, @path);
				};
				return @this.expression(@summary, call.item(1)->item(parameter), @path);
			};
			@parameter = parameter + 1;
		};
		var projected = function_fact_project_place(callee, source, @call);
		if (!projected.get()) {
			@summary.opaque = true;
			return 0;
		};
		var SemanticExpression* place = projected.get();
		@summary.projected_places.push_back($projected);
		return @this.expression(@summary, place, @path);
	};
	if (result.left) {
		@result.left = @this.import_value(@summary, callee, result.left, @call, @path, depth + 1);
	};
	if (result.right) {
		@result.right = @this.import_value(@summary, callee, result.right, @call, @path, depth + 1);
	};
	if (summary.expressions.size() >= 4096) {
		@summary.opaque = true;
		return 0;
	}
	else {
		@summary.expressions.push_back($result);
	};
	return summary.expressions.size();
};

fn FunctionFactSummaries::finish(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* returned, usize result, FunctionFactPath& path) {
	FunctionFactOutcome outcome;
	@outcome.return_expression = returned;
	@outcome.result = result;
	usize index = 0;
	while (index < path.conditions.size()) {
		@outcome.conditions.push_back(FactPathCondition(path.conditions.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < path.writes.size()) {
		FactWrite& write = path.writes.data()[index];
		var Entity* root = function_fact_root(write.target);
		if (root && (root->kind() == entity_kind::global || root->kind() == entity_kind::parameter && root->type()->kind() == type_kind::reference)) {
			@outcome.writes.push_back(FactWrite(write));
		};
		@index = index + 1;
	};
	@summary.outcomes.push_back($outcome);
};

// Initially compose calls only when their evaluation occupies a whole value
// position. Nested effectful call operands retain the conservative fallback.
fn function_fact_direct_call(var SemanticExpression* expression) -> var SemanticExpression* {
	while (expression && expression->size() == 1 && (expression->kind() == semantic_kind::cast || expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::unary)) {
		@expression = expression->item(0);
	};
	if (expression && expression->kind() == semantic_kind::call) {
		return expression;
	};
	return nullptr;
};

fn function_fact_contains_call(SemanticExpression* expression) -> bool {
	if (expression->kind() == semantic_kind::call) {
		return true;
	};
	usize child = 0;
	while (child < expression->size()) {
		if (function_fact_contains_call(expression->item(child))) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn FunctionFactSummaries::expand_call(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* call, var rt::buffer<rt::unique<FunctionFactPath>>& paths) {
	if (!call) {
		return;
	};
	var FunctionFactSummary* callee = this.find(call->entity());
	if (!callee || callee->opaque || call->size() != 2 || call->item(0)->kind() != semantic_kind::name || call->item(0)->entity()->canonical() != callee->function || callee->function->dispatch() != function_dispatch::ordinary || call->item(1)->size() != callee->function->parameters().size()) {
		@summary.opaque = true;
		return;
	};
	usize argument = 0;
	while (argument < call->item(1)->size()) {
		if (function_fact_contains_call(call->item(1)->item(argument))) {
			@summary.opaque = true;
			return;
		};
		@argument = argument + 1;
	};
	rt::buffer<rt::unique<FunctionFactPath>> expanded;
	usize index = 0;
	while (index < paths.size()) {
		if (expanded.size() >= 64) {
			@summary.opaque = true;
			return;
		};
		FunctionFactPath& source = *paths.data()[index].get();
		if (source.returned) {
			rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
			@retained.get()->copy_from(source);
			@expanded.push_back($retained);
		}
		else {
			FunctionFactPath entry;
			@entry.copy_from(source);
			@argument = 0;
			while (argument < call->item(1)->size()) {
				FunctionFactBinding binding;
				@binding.expression = call->item(1)->item(argument);
				@binding.value = @this.expression(@summary, binding.expression, @entry);
				@entry.bindings.push_back($binding);
				@argument = argument + 1;
			};
			if (summary.opaque) {
				return;
			};
			usize outcome = 0;
			while (outcome < callee->outcomes.size()) {
				if (expanded.size() >= 64) {
					@summary.opaque = true;
					return;
				};
				FunctionFactOutcome& selected = callee->outcomes.data()[outcome];
				rt::unique<FunctionFactPath> branch = rt::unique<FunctionFactPath>::make();
				@branch.get()->copy_from(entry);
				usize condition = 0;
				while (condition < selected.conditions.size()) {
					FactPathCondition guard;
					@guard.truth = selected.conditions.data()[condition].truth;
					@guard.value = @this.import_value(@summary, *callee, selected.conditions.data()[condition].value, @*call, @entry, 0);
					@branch.get()->conditions.push_back($guard);
					@condition = condition + 1;
				};
				// Import against the frozen call entry, before installing writes.
				FunctionFactBinding returned;
				@returned.expression = call;
				if (selected.result) {
					@returned.value = @this.import_value(@summary, *callee, selected.result, @*call, @entry, 0);
				};
				usize write = 0;
				while (write < selected.writes.size()) {
					var projected = function_fact_project_place(*callee, selected.writes.data()[write].target, @*call);
					if (!projected.get() || !function_fact_root(projected.get())) {
						@summary.opaque = true;
						return;
					};
					FactWrite effect;
					@effect.target = projected.get();
					@effect.kind = selected.writes.data()[write].kind;
					if (effect.kind == function_fact_effect::known_write) {
						@effect.value = @this.import_value(@summary, *callee, selected.writes.data()[write].value, @*call, @entry, 0);
					};
					@summary.projected_places.push_back($projected);
					@branch.get()->writes.push_back($effect);
					@write = write + 1;
				};
				if (summary.opaque) {
					return;
				};
				@branch.get()->bindings.push_back($returned);
				@expanded.push_back($branch);
				@outcome = outcome + 1;
			};
		};
		@index = index + 1;
	};
	@paths = $expanded;
};

fn FunctionFactSummaries::expand_boolean(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths, usize depth) {
	if (!paths.size()) {
		return;
	};
	if (!expression || expression->type()->kind() != type_kind::boolean || depth > 32) {
		@summary.opaque = true;
		return;
	};
	if (expression->kind() == semantic_kind::binary && (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or)) {
		@this.expand_boolean(@summary, expression->item(0), @paths, depth + 1);
		if (summary.opaque) {
			return;
		};
		rt::buffer<rt::unique<FunctionFactPath>> selected;
		rt::buffer<rt::unique<FunctionFactPath>> continuing;
		usize index = 0;
		while (index < paths.size()) {
			var FunctionFactPath& path = @*(@paths).data()[index].get();
			if (path.returned) {
				@selected.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
			}
			else {
				usize left = @this.expression(@summary, expression->item(0), @path);
				fact_truth truth = function_fact_truth(summary, left, 0);
				if (truth == fact_truth::unknown) {
					@summary.opaque = true;
					return;
				};
				bool skip = expression->operation() == token_kind::op_and && truth == fact_truth::disproven || expression->operation() == token_kind::op_or && truth == fact_truth::proven;
				if (skip) {
					FunctionFactBinding binding;
					@binding.expression = expression;
					@binding.value = left;
					@path.bindings.push_back($binding);
					@selected.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
				}
				else {
					@continuing.push_back(rt::unique<FunctionFactPath>(@((@paths).data()[index]).release()));
				};
			};
			@index = index + 1;
		};
		@this.expand_boolean(@summary, expression->item(1), @continuing, depth + 1);
		if (summary.opaque) {
			return;
		};
		@index = 0;
		while (index < continuing.size()) {
			if (selected.size() >= 64) {
				@summary.opaque = true;
				return;
			};
			var FunctionFactPath& path = @*(@continuing).data()[index].get();
			if (!path.returned) {
				FunctionFactBinding binding;
				@binding.expression = expression;
				@binding.value = @this.expression(@summary, expression->item(1), @path);
				@path.bindings.push_back($binding);
			};
			@selected.push_back(rt::unique<FunctionFactPath>(@((@continuing).data()[index]).release()));
			@index = index + 1;
		};
		@paths = $selected;
		return;
	};
	@this.expand_call(@summary, function_fact_direct_call(expression), @paths);
	if (summary.opaque) {
		return;
	};
	rt::buffer<rt::unique<FunctionFactPath>> branches;
	usize index = 0;
	while (index < paths.size()) {
		var FunctionFactPath& source = @*(@paths).data()[index].get();
		if (source.returned) {
			if (branches.size() >= 64) {
				@summary.opaque = true;
				return;
			};
			rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
			@retained.get()->copy_from(source);
			@branches.push_back($retained);
		}
		else {
			usize value = @this.expression(@summary, expression, @source);
			if (summary.opaque) {
				return;
			};
			fact_truth known = function_fact_truth(summary, value, 0);
			usize truth = 0;
			while (truth < 2) {
				if (known == fact_truth::unknown || (known == fact_truth::proven) == (truth != 0)) {
					if (branches.size() >= 64 || summary.expressions.size() >= 4096) {
						@summary.opaque = true;
						return;
					};
					rt::unique<FunctionFactPath> branch = rt::unique<FunctionFactPath>::make();
					@branch.get()->copy_from(source);
					if (known == fact_truth::unknown) {
						FactPathCondition guard;
						@guard.value = value;
						@guard.truth = truth != 0;
						@branch.get()->conditions.push_back($guard);
					};
					FunctionFactExpression constant;
					@constant.kind = function_fact_kind::integer;
					@constant.type = expression->type();
					@constant.integer = truth;
					@summary.expressions.push_back($constant);
					FunctionFactBinding binding;
					@binding.expression = expression;
					@binding.value = summary.expressions.size();
					@branch.get()->bindings.push_back($binding);
					@branches.push_back($branch);
				};
				@truth = truth + 1;
			};
		};
		@index = index + 1;
	};
	@paths = $branches;
};

fn FunctionFactSummaries::scoped_array_write(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* target, var SemanticExpression* value, var FunctionFactPath& path) {
	discard @this.expression(@summary, value, @path);
	var SemanticExpression* index = function_fact_unwrap(target);
	if (summary.opaque || !index || index->kind() != semantic_kind::index || index->size() != 2 || index->item(0)->type()->kind() != type_kind::array || !index->item(0)->type()->element()->representation()->kind().is_integer() || !function_fact_root(index->item(0))) {
		@summary.opaque = true;
		return;
	};
	usize evaluated = @this.expression(@summary, index->item(1), @path);
	IntegerRange bound = function_fact_unsigned_bound(summary, evaluated, path, 0);
	if (summary.opaque || bound.available == fact_truth::unknown || bound.sign == integer_range_sign::negative || bound.upper >= index->item(0)->type()->count()) {
		@summary.opaque = true;
		return;
	};
	FactWrite effect;
	@effect.target = index->item(0);
	@effect.kind = function_fact_effect::scoped_havoc;
	@path.writes.push_back($effect);
};

fn FunctionFactSummaries::walk(var FunctionFactSummaries& this, var FunctionFactSummary& summary, var SemanticExpression* expression, var rt::buffer<rt::unique<FunctionFactPath>>& paths) {
	if (!expression || summary.opaque) {
		return;
	};
	semantic_kind kind = expression->kind();
	if (kind == semantic_kind::variable && expression->entity() && expression->entity()->type()->kind() == type_kind::reference) {
		@summary.opaque = true;
		return;
	};
	if (kind == semantic_kind::brace || kind == semantic_kind::statements) {
		usize child = 0;
		while (child < expression->size()) {
			@this.walk(@summary, expression->item(child), @paths);
			@child = child + 1;
		};
		return;
	};
	var SemanticExpression* evaluated = expression;
	if (kind == semantic_kind::conditional || kind == semantic_kind::variable || kind == semantic_kind::return_value) {
		if (expression->size()) {
			@evaluated = expression->item(0);
		};
	}
	else if (kind == semantic_kind::binary && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
		@evaluated = expression->item(1);
	};
	if (evaluated->kind() == semantic_kind::binary && (evaluated->operation() == token_kind::op_and || evaluated->operation() == token_kind::op_or)) {
		@this.expand_boolean(@summary, evaluated, @paths, 0);
	}
	else {
		@this.expand_call(@summary, function_fact_direct_call(evaluated), @paths);
	};
	if (summary.opaque) {
		return;
	};
	if (kind == semantic_kind::conditional) {
		rt::buffer<rt::unique<FunctionFactPath>> branches;
		usize index = 0;
		while (index < paths.size()) {
			var FunctionFactPath& source = @*(@paths).data()[index].get();
			if (source.returned) {
				rt::unique<FunctionFactPath> retained = rt::unique<FunctionFactPath>::make();
				@retained.get()->copy_from(source);
				@branches.push_back($retained);
			}
			else {
				usize condition = @this.expression(@summary, expression->item(0), @source);
				usize branch = 0;
				while (branch < 2) {
					fact_truth known = function_fact_truth(summary, condition, 0);
					if (known != fact_truth::unknown && (known == fact_truth::proven) != !branch) {
						@branch = branch + 1;
						continue;
					};
					rt::unique<FunctionFactPath> state = rt::unique<FunctionFactPath>::make();
					@state.get()->copy_from(source);
					FactPathCondition fact;
					@fact.value = condition;
					@fact.truth = !branch;
					@state.get()->conditions.push_back($fact);
					rt::buffer<rt::unique<FunctionFactPath>> selected;
					@selected.push_back($state);
					@this.walk(@summary, expression->item(branch + 1), @selected);
					usize selected_index = 0;
					while (selected_index < selected.size()) {
						@branches.push_back(rt::unique<FunctionFactPath>(@((@selected).data()[selected_index]).release()));
						@selected_index = selected_index + 1;
					};
					@branch = branch + 1;
				};
			};
			@index = index + 1;
		};
		@paths = $branches;
		if (paths.size() > 64) {
			@summary.opaque = true;
		};
		return;
	};
	usize index = 0;
	while (index < paths.size()) {
		var FunctionFactPath& path = @*(@paths).data()[index].get();
		if (!path.returned) {
			if (kind == semantic_kind::exception_throw || kind == semantic_kind::exception_rethrow) {
				// This path has no normal continuation. A throw does not itself
				// describe a violated language rule or classify an API outcome.
				@path.returned = true;
			}
			else if (kind == semantic_kind::return_value) {
				usize result = 0;
				if (expression->size()) {
					@result = @this.expression(@summary, expression->item(0), @path);
				};
				@this.finish(@summary, expression, result, path);
				@path.returned = true;
			}
			else if (kind == semantic_kind::variable || kind == semantic_kind::binary && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
				var SemanticExpression* target = expression;
				var SemanticExpression* value = expression->item(0);
				if (kind == semantic_kind::binary) {
					@target = expression->item(0);
					@value = expression->item(1);
				};
				if (!function_fact_root(target)) {
					@this.scoped_array_write(@summary, target, value, @path);
				}
				else {
					FactWrite write;
					@write.target = target;
					@write.value = @this.expression(@summary, value, @path);
					@path.writes.push_back($write);
				};
			}
			else if (kind != semantic_kind::noop) {
				discard @this.expression(@summary, expression, @path);
			};
		};
		@index = index + 1;
	};
};

fn FunctionFactSummaries::build(var FunctionFactSummaries& this, var Entity& function) {
	rt::unique<FunctionFactSummary> summary = rt::unique<FunctionFactSummary>::make();
	@summary.get()->function = &@function;
	if (function.dispatch() != function_dispatch::ordinary) {
		// A statically selected declaration does not identify a virtual target.
		@summary.get()->opaque = true;
	};
	usize parameter = 0;
	while (parameter < function.parameters().size()) {
		Type* type = function.parameters().data()[parameter]->type();
		// Destruction of value parameters is implicit in the semantic body.
		// Until those cleanup effects are summarized, aggregate parameters
		// cannot be treated as a read-only call merely from their statements.
		if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record || type->kind() == type_kind::array) {
			@summary.get()->opaque = true;
		};
		@parameter = parameter + 1;
	};
	if (!function.body()) {
		@summary.get()->opaque = true;
	}
	else {
		rt::buffer<rt::unique<FunctionFactPath>> paths;
		rt::unique<FunctionFactPath> initial = rt::unique<FunctionFactPath>::make();
		@paths.push_back($initial);
		@this.walk(@*summary.get(), function.body(), @paths);
		usize index = 0;
		while (!summary.get()->opaque && index < paths.size()) {
			FunctionFactPath& path = *paths.data()[index].get();
			if (!(path.returned)) {
				@this.finish(@*summary.get(), nullptr, 0, path);
			};
			@index = index + 1;
		};
		// Without call-site alias partitioning, two reference parameters or a
		// global and a reference may denote the same storage. Do not summarize
		// mutations using independently substituted entry values in that case.
		usize references = 0;
		@index = 0;
		while (index < function.parameters().size()) {
			if (function.parameters().data()[index]->type()->kind() == type_kind::reference) {
				@references = references + 1;
			};
			@index = index + 1;
		};
		bool globals = false;
		@index = 0;
		while (index < summary.get()->expressions.size()) {
			FunctionFactExpression& value = summary.get()->expressions.data()[index];
			if (value.kind == function_fact_kind::entry_place) {
				var Entity* root = function_fact_root(value.place);
				if (root && root->kind() == entity_kind::global) {
					@globals = true;
				};
			};
			@index = index + 1;
		};
		@index = 0;
		while (index < summary.get()->outcomes.size()) {
			FunctionFactOutcome& outcome = summary.get()->outcomes.data()[index];
			usize write = 0;
			while (write < outcome.writes.size()) {
				var Entity* root = function_fact_root(outcome.writes.data()[write].target);
				if (root && root->kind() == entity_kind::global) {
					@globals = true;
				};
				@write = write + 1;
			};
			if (outcome.writes.size() && (references > 1 || references && globals)) {
				@summary.get()->opaque = true;
			};
			@index = index + 1;
		};
	};
	usize existing = 0;
	while (existing < this.summaries.size()) {
		if (this.summaries.data()[existing].get()->function == &@function) {
			@((@this.summaries).data()[existing]) = $summary;
			return;
		};
		@existing = existing + 1;
	};
	@this.summaries.push_back($summary);
};

fn FunctionFactSummaries::validate(var FunctionFactSummaries& this, SemanticUnit& unit) {
	@this.summaries.clear();
	while (true) {
		bool changed = false;
		usize index = 0;
		while (index < unit.entities().size()) {
			var Entity* entity = unit.entities().data()[index].get();
			if (entity->kind() == entity_kind::function) {
				@entity = entity->canonical();
			};
			var FunctionFactSummary* previous = this.find(entity);
			if (entity->kind() == entity_kind::function && (!previous || previous->opaque)) {
				@this.build(@*entity);
				var FunctionFactSummary* resolved = this.find(entity);
				if (resolved && !resolved->opaque) {
					@changed = true;
				};
			};
			@index = index + 1;
		};
		if (!changed) {
			break;
		};
	};
};

// Lifetime values and reference identity share the evaluation graph with facts,
// but use their own finite domain and preserve lifetime-specific diagnostics.
enum graph_storage : [u08] {
	unavailable;
	available;
};

struct GraphLifetimeValue {
	graph_storage storage;
	object_lifetime lifetime;
	var Entity* referent;
};

struct GraphLifetimeState {
	bool reachable;
	rt::buffer<GraphLifetimeValue> values;
	fn copy_from(var GraphLifetimeState& this, GraphLifetimeState& source);
	fn join(var GraphLifetimeState& this, GraphLifetimeState& source, var bool& changed);
	fn same(GraphLifetimeState& this, GraphLifetimeState& other) -> bool;
};

fn GraphLifetimeState::copy_from(var GraphLifetimeState& this, GraphLifetimeState& source) {
	@this.reachable = source.reachable;
	@this.values.clear();
	usize index = 0;
	while (index < source.values.size()) {
		@this.values.push_back(GraphLifetimeValue(source.values.data()[index]));
		@index = index + 1;
	};
};

fn GraphLifetimeState::join(var GraphLifetimeState& this, GraphLifetimeState& source, var bool& changed) {
	if (!source.reachable) {
		return;
	};
	if (!this.reachable) {
		@changed = true;
		@this.copy_from(source);
		return;
	};
	usize index = 0;
	while (index < this.values.size()) {
		var GraphLifetimeValue& target = @(@this.values).data()[index];
		GraphLifetimeValue& incoming = source.values.data()[index];
		if (target.storage == graph_storage::available && incoming.storage == graph_storage::unavailable) {
			@target.storage = graph_storage::unavailable;
			@changed = true;
		};
		if (target.lifetime != object_lifetime::indeterminate && (incoming.lifetime == object_lifetime::indeterminate || (target.lifetime == object_lifetime::live) != (incoming.lifetime == object_lifetime::live))) {
			@target.lifetime = object_lifetime::indeterminate;
			@changed = true;
		};
		if (target.referent && target.referent != incoming.referent) {
			@target.referent = nullptr;
			@changed = true;
		};
		@index = index + 1;
	};
};

fn GraphLifetimeState::same(GraphLifetimeState& this, GraphLifetimeState& other) -> bool {
	if (this.reachable != other.reachable || this.values.size() != other.values.size()) {
		return false;
	};
	usize index = 0;
	while (index < this.values.size()) {
		GraphLifetimeValue& first = this.values.data()[index];
		GraphLifetimeValue& second = other.values.data()[index];
		if (first.storage != second.storage || first.lifetime != second.lifetime || first.referent != second.referent) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn graph_lifetime_index(rt::buffer<var Entity*>& bindings, Entity* entity) -> usize {
	usize index = 0;
	while (index < bindings.size()) {
		if (bindings.data()[index] == entity) {
			return index;
		};
		@index = index + 1;
	};
	return fact_no_node();
};

fn graph_lifetime_owner(SemanticExpression* expression, rt::buffer<var Entity*>& bindings, GraphLifetimeState& state) -> var Entity* {
	while (expression) {
		semantic_kind kind = expression->kind();
		if (kind == semantic_kind::name) {
			var Entity* entity = expression->entity();
			if (!entity || entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter) {
				return nullptr;
			};
			usize remaining = bindings.size();
			while (entity && entity->type()->kind() == type_kind::reference) {
				usize index = graph_lifetime_index(bindings, entity);
				if (!remaining || index == fact_no_node() || !state.values.data()[index].referent) {
					return nullptr;
				};
				@entity = state.values.data()[index].referent;
				@remaining = remaining - 1;
			};
			return entity;
		};
		if (kind == semantic_kind::access || kind == semantic_kind::cast || kind == semantic_kind::member || kind == semantic_kind::index && expression->item(0)->type()->kind() == type_kind::array) {
			@expression = expression->item(0);
		}
		else if (kind == semantic_kind::dereference && expression->item(0)->kind() == semantic_kind::address) {
			@expression = expression->item(0)->item(0);
		}
		else if (kind == semantic_kind::sequence) {
			@expression = expression->item(2);
		}
		else {
			return nullptr;
		};
	};
	return nullptr;
};

fn graph_lifetime_declares(SemanticExpression* expression, Entity* entity) -> bool {
	if (!expression) {
		return false;
	};
	if (expression->kind() == semantic_kind::variable && expression->entity() == entity) {
		return true;
	};
	usize child = 0;
	while (child < expression->size()) {
		if (graph_lifetime_declares(expression->item(child), entity)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn LifetimeAnalyzer::graph_transfer(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, var GraphLifetimeState& state) {
	var SemanticExpression* expression = node.expression;
	var Entity* entity = node.owner;
	if (node.kind == fact_node_kind::lifetime_begin && entity) {
		usize index = graph_lifetime_index(bindings, entity);
		if (index != fact_no_node()) {
			@(@state.values).data()[index].storage = graph_storage::available;
			@(@state.values).data()[index].lifetime = object_lifetime::live;
		};
		return;
	};
	if (node.kind == fact_node_kind::lifetime_end && entity) {
		usize index = graph_lifetime_index(bindings, entity);
		if (index != fact_no_node() && (!expression || expression->kind() != semantic_kind::relocation && expression->kind() != semantic_kind::destruction)) {
			@(@state.values).data()[index].storage = graph_storage::unavailable;
		};
		return;
	};
	if (node.kind != fact_node_kind::expression || !expression) {
		return;
	};
	semantic_kind kind = expression->kind();
	if ((kind == semantic_kind::variable || kind == semantic_kind::exception_handler) && expression->entity()) {
		usize index = graph_lifetime_index(bindings, expression->entity());
		if (index != fact_no_node()) {
			var GraphLifetimeValue& value = @(@state.values).data()[index];
			@value.storage = graph_storage::available;
			@value.lifetime = object_lifetime::live;
			if (kind == semantic_kind::variable && expression->entity()->type()->kind() == type_kind::reference) {
				@value.referent = graph_lifetime_owner(expression->item(0), bindings, state);
			};
		};
	};
	if ((kind == semantic_kind::relocation || kind == semantic_kind::destruction) && expression->size()) {
		usize index = graph_lifetime_index(bindings, expression->item(0)->owned_binding());
		if (index != fact_no_node()) {
			object_lifetime ending = object_lifetime::relocated;
			if (kind == semantic_kind::destruction) {
				@ending = object_lifetime::destroyed;
			};
			@(@state.values).data()[index].lifetime = ending;
		};
	};
};

fn LifetimeAnalyzer::graph_check(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, GraphLifetimeState& state) -> CompilationResult {
	var SemanticExpression* expression = node.expression;
	if (!expression || node.kind != fact_node_kind::expression) {
		return;
	};
	if (expression->kind() == semantic_kind::sequence && expression->category() == value_category::place) {
		var Entity* owner = graph_lifetime_owner(expression->item(2), bindings, state);
		if (owner && graph_lifetime_declares(expression, owner)) {
			return @this.binding_error(expression, "sequence result refers to local storage", *owner);
		};
	};
	if (expression->kind() != semantic_kind::name || !expression->entity() || expression->entity()->kind() != entity_kind::local && expression->entity()->kind() != entity_kind::parameter) {
		return;
	};
	var Entity* entity = expression->entity();
	var Entity* owner = graph_lifetime_owner(expression, bindings, state);
	if (owner) {
		@entity = owner;
	};
	usize index = graph_lifetime_index(bindings, entity);
	if (index == fact_no_node() || state.values.data()[index].storage == graph_storage::unavailable) {
		if (node.evaluation == fact_evaluation::storage) {
			return @this.binding_error(expression, "object storage does not reach this construction", *entity);
		};
		return @this.binding_error(expression, "object construction does not reach this use", *entity);
	};
	if (node.evaluation == fact_evaluation::storage) {
		return;
	};
	object_lifetime lifetime = state.values.data()[index].lifetime;
	if (lifetime == object_lifetime::live) {
		return;
	};
	if (lifetime == object_lifetime::relocated) {
		return @this.binding_error(expression, "object has been relocated", *entity);
	};
	if (lifetime == object_lifetime::destroyed) {
		return @this.binding_error(expression, "object has been destroyed", *entity);
	};
	if (lifetime == object_lifetime::discarded) {
		return @this.binding_error(expression, "object has been discarded", *entity);
	};
	return @this.binding_error(expression, "object lifetime differs across reachable control-flow paths", *entity);
};

fn LifetimeAnalyzer::graph_function(var LifetimeAnalyzer& this, var Entity& function) -> CompilationResult {
	FactGraph graph;
	@graph.build_function(function);
	rt::buffer<var Entity*> bindings;
	usize index = 0;
	while (index < function.parameters().size()) {
		@bindings.push_back(function.parameters().data()[index]);
		@index = index + 1;
	};
	@index = 0;
	while (index < graph.nodes.size()) {
		var SemanticExpression* expression = graph.nodes.data()[index].expression;
		if (graph.nodes.data()[index].kind == fact_node_kind::expression) {
			if (expression) {
				if (expression->kind() == semantic_kind::variable) {
					if (expression->entity()) {
						if (graph_lifetime_index(bindings, expression->entity()) == fact_no_node()) {
							@bindings.push_back(expression->entity());
						};
					};
				}
				else {
					if (expression->kind() == semantic_kind::exception_handler) {
						if (expression->entity()) {
							if (graph_lifetime_index(bindings, expression->entity()) == fact_no_node()) {
								@bindings.push_back(expression->entity());
							};
						};
					};
				};
			};
		};
		@index = index + 1;
	};
	rt::buffer<rt::unique<GraphLifetimeState>> incoming;
	rt::buffer<rt::unique<GraphLifetimeState>> entries;
	@index = 0;
	while (index < graph.nodes.size()) {
		rt::unique<GraphLifetimeState> state = rt::unique<GraphLifetimeState>::make();
		rt::unique<GraphLifetimeState> entry = rt::unique<GraphLifetimeState>::make();
		if (!state.get() || !entry.get()) {
			return compilation_error();
		};
		usize binding = 0;
		while (binding < bindings.size()) {
			GraphLifetimeValue value;
			if (index == graph.entry && binding < function.parameters().size()) {
				@value.storage = graph_storage::available;
			};
			@state.get()->values.push_back($value);
			@binding = binding + 1;
		};
		if (index == graph.entry) {
			@state.get()->reachable = true;
		};
		@incoming.push_back($state);
		@entries.push_back($entry);
		@index = index + 1;
	};
	rt::buffer<usize> first_edges;
	rt::buffer<usize> next_edges;
	rt::buffer<usize> first_incoming;
	rt::buffer<usize> next_incoming;
	rt::buffer<rt::unique<GraphLifetimeState>> produced;
	rt::buffer<u08> queued;
	rt::buffer<usize> pending;
	@index = 0;
	while (index < graph.nodes.size()) {
		rt::unique<GraphLifetimeState> output = rt::unique<GraphLifetimeState>::make();
		if (output.get()) {
			@produced.push_back($output);
			@first_edges.push_back(fact_no_node());
			@first_incoming.push_back(fact_no_node());
			@queued.push_back(u08(index == graph.entry));
		}
		else {
			return compilation_error();
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < graph.edges.size()) {
		@next_edges.push_back(fact_no_node());
		@next_incoming.push_back(fact_no_node());
		@index = index + 1;
	};
	@index = graph.edges.size();
	while (index) {
		@index = index - 1;
		FactEdge& edge = graph.edges.data()[index];
		@(@next_edges).data()[index] = first_edges.data()[edge.source];
		@(@first_edges).data()[edge.source] = index;
		@(@next_incoming).data()[index] = first_incoming.data()[edge.target];
		@(@first_incoming).data()[edge.target] = index;
	};
	@pending.push_back(graph.entry);
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize source = pending.data()[cursor];
		@cursor = cursor + 1;
		@(@queued).data()[source] = 0;
		var GraphLifetimeState& outgoing = @*(@produced).data()[source].get();
		@outgoing.copy_from(*incoming.data()[source].get());
		@this.graph_transfer(graph.nodes.data()[source], bindings, @outgoing);
		usize edge_index = first_edges.data()[source];
		while (edge_index != fact_no_node()) {
			FactEdge& edge = graph.edges.data()[edge_index];
			if (fact_semantic_edge_feasible(edge)) {
				GraphLifetimeState merged;
				GraphLifetimeState entry;
				usize predecessor = first_incoming.data()[edge.target];
				while (predecessor != fact_no_node()) {
					FactEdge& previous = graph.edges.data()[predecessor];
					GraphLifetimeState& value = *produced.data()[previous.source].get();
					bool changed = false;
					if (value.reachable && fact_semantic_edge_feasible(previous)) {
						@merged.join(value, @changed);
						if (previous.kind != fact_edge_kind::backedge) {
							if (graph.nodes.data()[edge.target].region) {
								@entry.join(value, @changed);
							};
						};
					};
					@predecessor = next_incoming.data()[predecessor];
				};
				if (graph.nodes.data()[edge.target].region) {
					@entries.data()[edge.target].get()->copy_from(entry);
				};
				var GraphLifetimeState& current = @*(@incoming).data()[edge.target].get();
				if (!current.same(merged)) {
					@current.copy_from(merged);
					if (!queued.data()[edge.target]) {
						@pending.push_back(edge.target);
						@(@queued).data()[edge.target] = 1;
					};
				};
			};
			@edge_index = next_edges.data()[edge_index];
		};
	};
	@index = 0;
	while (index < graph.edges.size()) {
		FactEdge& edge = graph.edges.data()[index];
		if (edge.kind == fact_edge_kind::backedge && fact_semantic_edge_feasible(edge) && incoming.data()[edge.source].get()->reachable && entries.data()[edge.target].get()->reachable) {
			GraphLifetimeState repeated;
			@repeated.copy_from(*incoming.data()[edge.source].get());
			@this.graph_transfer(graph.nodes.data()[edge.source], bindings, @repeated);
			GraphLifetimeState& entry = *entries.data()[edge.target].get();
			usize binding = 0;
			while (binding < bindings.size()) {
				GraphLifetimeValue& initial = entry.values.data()[binding];
				GraphLifetimeValue& next = repeated.values.data()[binding];
				if (initial.storage == graph_storage::available && (next.storage != graph_storage::available || (initial.lifetime == object_lifetime::indeterminate) != (next.lifetime == object_lifetime::indeterminate) || (initial.lifetime == object_lifetime::live) != (next.lifetime == object_lifetime::live))) {
					return @this.binding_error(graph.nodes.data()[edge.target].region, "inconsistent object lifetimes at reachable loop backedge", *bindings.data()[binding]);
				};
				@binding = binding + 1;
			};
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < graph.nodes.size()) {
		if (incoming.data()[index].get()->reachable && !(@this.graph_check(graph.nodes.data()[index], bindings, *incoming.data()[index].get())).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
	function_completion completion = function_completion::no_fallthrough;
	if (incoming.data()[graph.fallthrough_exit].get()->reachable) {
		@completion = function_completion::reaches_end;
	};
	@function.set_completion(completion);
};

fn LifetimeAnalyzer::validate_graph(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;
		if (function->kind() == entity_kind::function && function->body() && !(@this.graph_function(@*function)).has<void>()) {
			return compilation_error();
		};
	};
};

fn ConversionSelection::unique(ConversionSelection& this) -> var Entity* {
	if (this.conflict) {
		return nullptr;
	};
	return this.selected;
};

fn Analyzer::implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> var Entity* {
	var result = @this.select_implicit_constructor(value, expected);
	return result.unique();
};

fn Analyzer::conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> var Entity* {
	var result = @this.select_conversion_function(value, expected, $mode);
	return result.unique();
};

fn Analyzer::select_implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> ConversionSelection {
	if (expected.kind() != type_kind::named || expected.entity()->kind() != entity_kind::record) {
		return ConversionSelection();
	};

	var Entity* owner = expected.entity();
	ConversionSelection result;
	i32 best = i32::max;
	usize index = 0;
	while (index < owner->members()->bindings().size()) {
		var Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function || !candidate->token().same(owner->token())) {
			continue;
		};

		if (!(@this.resolve((var Entity*(candidate)))).has<void>()) {
			return ConversionSelection();
		};

		@candidate = candidate->canonical();

		if (candidate->conversion() != conversion_mode::implicit_allowed || candidate->parameters().size() != 2) {
			continue;
		};

		i32 rank = this.builtin_rank(value, *candidate->parameters().data()[1]->type());

		if (rank < 0 || rank > best) {
			continue;
		};

		if (rank == best && result.selected != candidate) {
			@result.conflict = candidate;
			continue;
		};

		if (rank < best) {
			@result.selected = candidate;
			@best := rank;
			@result.conflict = nullptr;
		};
	};

	return $result;
};

fn Analyzer::select_conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> ConversionSelection {
	Type* source = value.type();

	ConversionSelection result;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		var Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		var Syntax* name = nullptr;
		if (candidate->declaration() && candidate->declaration()->kind() == syntax_kind::function) {
			@name = candidate->declaration()->function_name();
			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};
		};

		if (candidate->role() != function_role::conversion && (!name || name->kind() != syntax_kind::conversion_name)) {
			continue;
		};

		if (source->kind() == type_kind::named && candidate->scope() != source->entity()->members() && candidate->scope() != source->entity()->scope()) {
			continue;
		};

		if (!(@this.resolve((var Entity*(candidate)))).has<void>()) {
			return ConversionSelection();
		};

		@candidate = candidate->canonical();

		if (candidate->role() != function_role::conversion || candidate->parameters().size() != 1 || !candidate->type()->signature().result()->same_shape(expected) || mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (this.builtin_rank(value, *candidate->parameters().data()[0]->type()) < 0) {
			continue;
		};

		if (result.selected && result.selected != candidate) {
			@result.conflict = candidate;
			return $result;
		};

		@result.selected = candidate;
	};

	return $result;
};

fn Analyzer::argument_rank(var Analyzer& this, SemanticExpression& value, Type& expected) -> i32 {
	if (value.kind() == semantic_kind::deferred_argument) {
		return 0;
	};

	i32 builtin = this.builtin_rank(value, expected);

	if (expected.kind() != type_kind::reference && value.category() == value_category::place && value.type()->same_shape(expected)) {
		if (@this.implicit_constructor(value, expected)) {
			return 8;
		};

		if (@this.conversion_function(value, expected, conversion_mode::implicit_allowed)) {
			return 9;
		};
	};

	if (builtin >= 0) {
		return builtin;
	};

	if (expected.kind() == type_kind::reference && expected.element()->qualifier() == type_qualifier::mutable) {
		return -1;
	};

	Type* target = &@expected;

	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	var Entity* constructor = @this.implicit_constructor(value, *target);

	if (constructor) {
		return 16 + this.builtin_rank(value, *constructor->parameters().data()[1]->type());
	};

	var Entity* conversion = @this.conversion_function(value, *target, conversion_mode::implicit_allowed);

	if (conversion) {
		return 17 + this.builtin_rank(value, *conversion->parameters().data()[0]->type());
	};

	return -1;
};

fn Analyzer::supply_special_functions(var Analyzer& this, var Entity* entity) -> CompilationResult {
	Type* source = entity->type();
	Type* copy = @this.types->reference(@this.types->qualified(*source, type_qualifier::immutable));

	if (!copy) {
		return compilation_error();
	};

	bool source_constructor = false;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* member = entity->members()->bindings().data()[index];

		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->origin() == declaration_origin::source) {
			@source_constructor = true;
		};

		@index = index + 1;
	};

	if (!source_constructor) {
		var Entity* constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);

		if (!constructor) {
			return compilation_error();
		};

		@entity->set_default_constructor(constructor);
	};

	var Entity* move_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, source, function_definition::defaulted);
	var Entity* copy_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, copy, function_definition::defaulted);

	if (!move_constructor || !copy_constructor) {
		return compilation_error();
	};

	@entity->set_move_constructor(move_constructor);
	@entity->set_copy_constructor(copy_constructor);
	if (variant_instance(*entity) && !entity->destructor()) {
		var Entity* destructor = @this.supply_special(entity, function_role::destructor, token_kind::op_tilde, nullptr, function_definition::defaulted);
		if (!destructor) {
			return compilation_error();
		};
		@entity->set_destructor(destructor);
	};

	if (!@this.supply_special(entity, function_role::assignment, token_kind::op_assign, source, function_definition::defaulted)) {
		return compilation_error();
	};

	if (@this.supply_special(entity, function_role::assignment, token_kind::op_copy, copy, function_definition::defaulted) != nullptr) {
		return;
	};
	return compilation_error();
};

fn Analyzer::supply_special(var Analyzer& this, var Entity* entity, function_role role, token_kind operation, Type* source, function_definition definition) -> var Entity* {
	Type* receiver = @this.types->reference(entity->type());

	if (!receiver) {
		return nullptr;
	};

	usize parameter_count = 1;

	if (source) {
		@parameter_count = 2;
	};

	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* candidate = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!(@this.resolve((var Entity*(candidate)))).has<void>()) {
			return nullptr;
		};

		@candidate = candidate->canonical();

		if (candidate->role() == role && (role == function_role::constructor || candidate->operator_kind() == operation) && candidate->parameters().size() == parameter_count && candidate->parameters().data()[0]->type() == receiver && (!source || candidate->parameters().data()[1]->type() == source)) {
			return candidate;
		};
	};

	Token location = entity->token();
	var name = entity->name();
	Type* result = this.types->find_primitive("void");
	DiagnosticMessage destructor_name;
	if (role == function_role::destructor) {
		@location.kind = token_kind::op_tilde;
		@destructor_name.text("~");
		@destructor_name.text(entity->name());
		@name = destructor_name.view();
	};

	if (role == function_role::assignment) {
		@location.kind = token_kind(operation);
		@name = "operator=";
		@result := receiver;

		if (operation == token_kind::op_copy) {
			@name = "operator:=";
		};
	};

	var Entity* function = @this.unit->create_entity(entity_kind::function, location, nullptr, entity->members());

	if (function) {
		@function->set_name(name);
	}
	else {
		@this.error(entity->declaration(), "cannot declare compiler-supplied special function");
		return nullptr;
	};

	@function->set_origin(declaration_origin::compiler_supplied);
	@function->set_definition(function_definition(definition));
	@function->set_role(function_role(role));
	if (role == function_role::constructor && source && source->kind() == type_kind::reference && source->element()->same_shape(*entity->type())) {
		@function->set_conversion(conversion_mode::implicit_allowed);
	};
	@function->set_operator_kind(token_kind(operation));
	@function->set_access(access_kind::public_access);
	var Scope* parameters = @this.unit->create_scope(entity->members(), (var Entity*(function)));

	if (!parameters) {
		return nullptr;
	};

	@function->set_members((var Scope*(parameters)));
	rt::buffer<Type*> signature;
	@index = 0;

	while (index < parameter_count) {
		Type* type = source;
		var parameter_name = "other";

		if (!index) {
			@type = receiver;
			@parameter_name = "this";
		};

		var Entity* parameter = @this.unit->create_entity(entity_kind::parameter, location, nullptr, parameters);

		if (parameter) {
			@parameter->set_name(parameter_name);
		}
		else {
			return nullptr;
		};

		@parameter->set_origin(declaration_origin::compiler_supplied);
		@parameter->set_type(type);
		@parameter->set_index(usize(index));
		@parameter->set_state(entity_state::ready);

		@function->add_parameter((var Entity*(parameter)));
		@signature.push_back(type);

		@index = index + 1;
	};

	@function->set_type(@this.types->function(result, $signature, parameter_arity::fixed));

	if (!function->type()) {
		return nullptr;
	};

	@function->set_state(entity_state::ready);

	return function;
};

enum fact_truth : [u08] {
	unknown;
	proven;
	disproven;
};

enum integer_range_sign : [u08] {
	nonnegative;
	negative;
};

// Negative bounds use sign-extended two's complement values, whose unsigned
// ordering is monotone within the negative half. Mixed-sign ranges widen away.
struct IntegerRange {
	fact_truth available;
	integer_range_sign sign;
	u64 lower;
	u64 upper;
};

fn fact_range(u64 lower, u64 upper) -> IntegerRange {
	IntegerRange result;
	@result.available = fact_truth::proven;
	@result.lower = lower;
	@result.upper = upper;
	return $result;
};

fn fact_diagnostic_bound(var DiagnosticMessage& message, u64 value, integer_range_sign sign) {
	if (sign == integer_range_sign::negative) {
		@message.text("-");
		@message.number(u64::max - value + 1);
		return;
	};
	@message.number(value);
};

fn fact_limit(Type* type) -> u64 {
	if (!type || !type->representation()->kind().is_integer()) {
		return 0;
	};
	@type = type->representation();
	if (type->kind() == type_kind::boolean) {
		return 1;
	};
	u32 bits = type->bits();
	if (type->kind() == type_kind::signed_integer) {
		return (u64(1) << u64(bits - 1)) - 1;
	};
	if (bits == 64) {
		return u64::max;
	};
	return (u64(1) << u64(bits)) - 1;
};

fn fact_constant(Type* type, u64 value) -> IntegerRange {
	IntegerRange result;
	if (!type || !type->representation()->kind().is_integer()) {
		return $result;
	};
	@type = type->representation();
	u64 normalized = type->normalize_integer(value);
	@result = fact_range(normalized, normalized);
	if (type->kind() == type_kind::signed_integer && type->signed_value(normalized) < 0) {
		@result.sign = integer_range_sign::negative;
		@result.lower = static_cast<u64>(type->signed_value(normalized));
		@result.upper = result.lower;
	};
	return $result;
};

fn fact_convert(IntegerRange& source, Type* target) -> IntegerRange {
	if (source.available == fact_truth::unknown) {
		return IntegerRange();
	};
	if (target && target->kind() == type_kind::boolean) {
		if (source.lower) {
			return fact_range(1, 1);
		};
		if (!source.upper) {
			return fact_range(0, 0);
		};
		return fact_range(0, 1);
	};
	if (source.lower == source.upper) {
		return fact_constant(target, source.lower);
	};
	if (source.sign == integer_range_sign::nonnegative && source.upper <= fact_limit(target)) {
		return IntegerRange(source);
	};
	return IntegerRange();
};

struct FactPlace {
	var Entity* root;
	usize parent;
	var Entity* field;
};

struct FactValue {
	IntegerRange range;
	usize version;
	u64 alternative;
	usize origin;
	i64 displacement;
};

struct FactEvaluation {
	var SemanticExpression* expression;
	FactValue value;
};

struct FactRelation {
	usize left;
	usize right;
	token_kind operation;
};

struct ConditionalFact {
	usize condition;
	u64 selector;
	bool variant;
	usize place;
	usize expected_version;
	FactValue value;
};

struct ConditionalRelation {
	usize condition;
	u64 selector;
	bool variant;
	FactRelation relation;
	usize occurrences;
	usize last_outcome;
};

struct FactOutcomeCount {
	u64 selector;
	usize count;
};

struct FactCorrelationPlace {
	usize place;
	bool written;
};

struct FactIntegerConstant {
	Type* type;
	u64 value;
};

struct FactState {
	bool reachable;
	rt::buffer<FactValue> places;
	rt::buffer<FactEvaluation> evaluated;
	rt::buffer<FactAggregateEvaluation> aggregate_evaluated;
	rt::buffer<FactRelation> relations;
	rt::buffer<ConditionalFact> conditional;
	rt::buffer<ConditionalRelation> conditional_relations;
	fn copy_from(var FactState& this, FactState& other);
	fn value(FactState& this, SemanticExpression* expression) -> FactValue;
	fn record(var FactState& this, var SemanticExpression* expression, FactValue value);
	fn join(var FactState& this, FactState& incoming, bool widen, var bool& changed);
	fn aggregate_value(FactState& this, SemanticExpression* expression, usize place) -> FactValue;
	fn record_aggregate(var FactState& this, SemanticExpression* expression, usize place, FactValue value);
};

fn FactState::copy_from(var FactState& this, FactState& other) {
	@this.reachable = other.reachable;
	@this.places.clear();
	@this.evaluated.clear();
	@this.aggregate_evaluated.clear();
	@this.relations.clear();
	@this.conditional.clear();
	@this.conditional_relations.clear();
	usize index = 0;
	while (index < other.places.size()) {
		@this.places.push_back(FactValue(other.places.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.evaluated.size()) {
		@this.evaluated.push_back(FactEvaluation(other.evaluated.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.aggregate_evaluated.size()) {
		@this.aggregate_evaluated.push_back(FactAggregateEvaluation(other.aggregate_evaluated.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.relations.size()) {
		@this.relations.push_back(FactRelation(other.relations.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.conditional.size()) {
		@this.conditional.push_back(ConditionalFact(other.conditional.data()[index]));
		@index = index + 1;
	};
	@index = 0;
	while (index < other.conditional_relations.size()) {
		@this.conditional_relations.push_back(ConditionalRelation(other.conditional_relations.data()[index]));
		@index = index + 1;
	};
};

fn FactState::value(FactState& this, SemanticExpression* expression) -> FactValue {
	usize index = this.evaluated.size();
	while (index) {
		@index = index - 1;
		if (this.evaluated.data()[index].expression == expression) {
			return FactValue(this.evaluated.data()[index].value);
		};
	};
	return FactValue();
};

fn FactState::record(var FactState& this, var SemanticExpression* expression, FactValue value) {
	usize index = 0;
	while (index < this.evaluated.size()) {
		var FactEvaluation& entry = @((@this.evaluated).data()[index]);
		if (entry.expression == expression) {
			@entry.value = $value;
			return;
		};
		@index = index + 1;
	};
	FactEvaluation entry;
	@entry.expression = expression;
	@entry.value = $value;
	@this.evaluated.push_back($entry);
};

fn fact_join_value(var FactValue& current, FactValue& incoming, bool widen) -> bool {
	bool changed = false;
	if (current.origin && (current.origin != incoming.origin || current.displacement != incoming.displacement)) {
		@current.origin = 0;
		@changed = true;
	};
	if (current.alternative && current.alternative != incoming.alternative) {
		@current.alternative = 0;
		@changed = true;
	};
	if (current.version != incoming.version && current.version) {
		@current.version = 0;
		@changed = true;
	};
	if (current.range.available == fact_truth::unknown) {
		return changed;
	};
	if (incoming.range.available == fact_truth::unknown || current.range.sign != incoming.range.sign || widen && (current.range.lower != incoming.range.lower || current.range.upper != incoming.range.upper)) {
		@current.range.available = fact_truth::unknown;
		return true;
	};
	if (incoming.range.lower < current.range.lower) {
		@current.range.lower = incoming.range.lower;
		@changed = true;
	};
	if (incoming.range.upper > current.range.upper) {
		@current.range.upper = incoming.range.upper;
		@changed = true;
	};
	return changed;
};

fn FactState::join(var FactState& this, FactState& incoming, bool widen, var bool& changed) {
	if (!incoming.reachable) {
		return;
	};
	if (!this.reachable) {
		@changed = true;
		@this.copy_from(incoming);
		return;
	};
	usize index = 0;
	while (index < this.places.size()) {
		if (fact_join_value(@((@this.places).data()[index]), incoming.places.data()[index], widen)) {
			@changed = true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.evaluated.size()) {
		var FactEvaluation& entry = @((@this.evaluated).data()[index]);
		FactValue other = incoming.value(entry.expression);
		if (fact_join_value(@entry.value, other, widen)) {
			@changed = true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.aggregate_evaluated.size()) {
		var FactAggregateEvaluation& entry = @((@this.aggregate_evaluated).data()[index]);
		FactValue other = incoming.aggregate_value(entry.expression, entry.place);
		if (fact_join_value(@entry.value, other, widen)) {
			@changed = true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.relations.size()) {
		var FactRelation& relation = @((@this.relations).data()[index]);
		bool retained = false;
		usize other = 0;
		while (other < incoming.relations.size()) {
			FactRelation& candidate = incoming.relations.data()[other];
			if (candidate.left == relation.left && candidate.right == relation.right && candidate.operation == relation.operation) {
				@retained = true;
			};
			@other = other + 1;
		};
		if (!retained && relation.left) {
			@relation.left = 0;
			@changed = true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.conditional.size()) {
		var ConditionalFact& entry = @((@this.conditional).data()[index]);
		bool retained = false;
		usize other = 0;
		while (other < incoming.conditional.size()) {
			ConditionalFact& candidate = incoming.conditional.data()[other];
			if (entry.condition && candidate.condition == entry.condition && candidate.selector == entry.selector && candidate.variant == entry.variant && candidate.place == entry.place && candidate.expected_version == entry.expected_version) {
				@retained = true;
				if (fact_join_value(@entry.value, candidate.value, widen)) {
					@changed = true;
				};
			};
			@other = other + 1;
		};
		if (!retained && entry.condition) {
			@entry.condition = 0;
			@changed = true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.conditional_relations.size()) {
		var ConditionalRelation& entry = @((@this.conditional_relations).data()[index]);
		bool retained = false;
		usize other = 0;
		while (other < incoming.conditional_relations.size()) {
			ConditionalRelation& candidate = incoming.conditional_relations.data()[other];
			if (entry.condition && entry.condition == candidate.condition && entry.selector == candidate.selector && entry.variant == candidate.variant && entry.relation.left == candidate.relation.left && entry.relation.right == candidate.relation.right && entry.relation.operation == candidate.relation.operation) {
				@retained = true;
			};
			@other = other + 1;
		};
		if (!retained && entry.condition) {
			@entry.condition = 0;
			@changed = true;
		};
		@index = index + 1;
	};
};

fn fact_inverse(token_kind operation) -> token_kind {
	switch (operation) {
		case token_kind::op_less: return token_kind::op_greater_equal;
		case token_kind::op_less_equal: return token_kind::op_greater;
		case token_kind::op_greater: return token_kind::op_less_equal;
		case token_kind::op_greater_equal: return token_kind::op_less;
		case token_kind::op_equal: return token_kind::op_not_equal;
		case token_kind::op_not_equal: return token_kind::op_equal;
	};
	return operation;
};

fn fact_comparison(token_kind operation, IntegerRange& left, IntegerRange& right) -> fact_truth {
	if (left.available == fact_truth::unknown || right.available == fact_truth::unknown) {
		return fact_truth::unknown;
	};
	if (left.sign != right.sign) {
		IntegerRange first = fact_range(0, 0);
		IntegerRange second = fact_range(1, 1);
		if (left.sign == integer_range_sign::negative) {
			return fact_comparison(operation, first, second);
		};
		return fact_comparison(operation, second, first);
	};
	switch (operation) {
		case token_kind::op_less:
			if (left.upper < right.lower) {
				return fact_truth::proven;
			};
			if (left.lower >= right.upper) {
				return fact_truth::disproven;
			};
			break;
		case token_kind::op_less_equal:
			if (left.upper <= right.lower) {
				return fact_truth::proven;
			};
			if (left.lower > right.upper) {
				return fact_truth::disproven;
			};
			break;
		case token_kind::op_greater: return fact_comparison(token_kind::op_less, right, left);
		case token_kind::op_greater_equal: return fact_comparison(token_kind::op_less_equal, right, left);
		case token_kind::op_equal:
			if (left.lower == left.upper && right.lower == right.upper && left.lower == right.lower) {
				return fact_truth::proven;
			};
			if (left.upper < right.lower || right.upper < left.lower) {
				return fact_truth::disproven;
			};
			break;
		case token_kind::op_not_equal: {
			fact_truth equal = fact_comparison(token_kind::op_equal, left, right);
			if (equal == fact_truth::proven) {
				return fact_truth::disproven;
			};
			if (equal == fact_truth::disproven) {
				return fact_truth::proven;
			};
			break;
		};
	};
	return fact_truth::unknown;
};

fn fact_compare_values(token_kind operation, FactValue& left, FactValue& right) -> fact_truth {
	fact_truth result = fact_comparison(operation, left.range, right.range);
	if (result != fact_truth::unknown) {
		return result;
	};
	usize first = left.origin;
	usize second = right.origin;
	i64 first_offset = left.displacement;
	i64 second_offset = right.displacement;
	if (!first) {
		@first = left.version;
		@first_offset = 0;
	};
	if (!second) {
		@second = right.version;
		@second_offset = 0;
	};
	if (!first || first != second) {
		return fact_truth::unknown;
	};
	bool truth = false;
	switch (operation) {
		case token_kind::op_equal: @truth = first_offset == second_offset; break;
		case token_kind::op_not_equal: @truth = first_offset != second_offset; break;
		case token_kind::op_less: @truth = first_offset < second_offset; break;
		case token_kind::op_less_equal: @truth = first_offset <= second_offset; break;
		case token_kind::op_greater: @truth = first_offset > second_offset; break;
		case token_kind::op_greater_equal: @truth = first_offset >= second_offset; break;
		default: return fact_truth::unknown;
	};
	if (truth) {
		return fact_truth::proven;
	};
	return fact_truth::disproven;
};

fn fact_affine(var FactValue& result, FactValue& base, u64 amount, bool subtract) {
	if (amount > u64(i64::max) || !base.version) {
		return;
	};
	i64 offset = 0;
	usize origin = base.version;
	if (base.origin) {
		@origin = base.origin;
		@offset = base.displacement;
	};
	i64 delta = i64(amount);
	if (subtract) {
		@delta = -delta;
	};
	if (delta >= 0 && offset > i64::max - delta || delta < 0 && offset < (-i64::max - 1) - delta) {
		return;
	};
	@result.origin = origin;
	@result.displacement = offset + delta;
};

struct InferredFacts {
	fn InferredFacts(var InferredFacts& this, var Diagnostics& diagnostics);
	fn validate(var InferredFacts& this, var SemanticUnit& unit) -> CompilationResult;
	fn analyze(var InferredFacts& this, var SemanticExpression* body) -> CompilationResult;
	fn place(var InferredFacts& this, SemanticExpression* expression) -> usize;
	fn transfer(var InferredFacts& this, var SemanticExpression* expression, var FactState& state, usize version);
	fn assume(var InferredFacts& this, var SemanticExpression* condition, bool truth, var FactState& state);
	fn evaluate(var InferredFacts& this, SemanticExpression* expression, FactState& state) -> FactValue;
	fn invalidate(var InferredFacts& this, var FactState& state, usize place);
	fn end_lifetime(var InferredFacts& this, var FactState& state, Entity* owner);
	fn seed_default_members(var InferredFacts& this, Type* type, Entity* owner, usize parent, var FactState& state, usize version, usize depth);
	fn seed_default_record(var InferredFacts& this, Entity* owner, SemanticExpression* initializer, var FactState& state, usize version);
	fn collect_aggregate_moves(var InferredFacts& this, SemanticExpression* body);
	fn collect_aggregate_move_nodes(var InferredFacts& this, SemanticExpression* expression);
	fn project_aggregate_place(var InferredFacts& this, usize place, usize source, usize destination, usize depth) -> usize;
	fn capture_aggregate(var InferredFacts& this, SemanticExpression* expression, var FactState& state);
	fn apply_aggregate_move(var InferredFacts& this, SemanticExpression* initializer, var FactState& state);
	fn aggregate_move(InferredFacts& this, SemanticExpression* initializer) -> FactAggregateMove*;
	fn collect(var InferredFacts& this, SemanticExpression* expression);
	fn summary_place(var InferredFacts& this, SemanticExpression* expression, SemanticExpression& call, FunctionFactSummary& summary) -> usize;
	fn summary_value(var InferredFacts& this, FunctionFactSummary& summary, usize expression, SemanticExpression& call, FactState& state, usize depth) -> FactValue;
	fn summary_assume(var InferredFacts& this, FunctionFactSummary& summary, usize expression, bool truth, SemanticExpression& call, var FactState& state);
	fn apply_summary(var InferredFacts& this, var SemanticExpression& call, var FactState& state, var FactValue& result, usize version) -> bool;
	fn refine_outcome(var InferredFacts& this, var FactState& state, usize condition, u64 selector, bool matches, bool variant);
	fn constant_version(var InferredFacts& this, Type* type, u64 value) -> usize;
	fn correlation_place(var InferredFacts& this, var rt::buffer<FactCorrelationPlace>& places, usize place, bool written);
	fn summary_cache(InferredFacts& this) -> FunctionFactSummaries&;
	fn context_seed(var InferredFacts& this, var FactState& state);
	fn context_capture(var InferredFacts& this, var SemanticExpression& call, FactState& state);
	fn context_override(var InferredFacts& this, var SemanticExpression& expression, inferred_override_kind kind, u64 value);
	var Diagnostics* diagnostics;
	rt::buffer<FactPlace> places;
	rt::buffer<rt::unique<FactAggregateMove>> aggregate_moves;
	rt::buffer<rt::unique<FactState>> incoming;
	FunctionFactSummaries summaries;
	FunctionFactSummaries* summary_source;
	var Entity* analyzed_function;
	var InferredFunctionContext* context_output;
	rt::buffer<FactContextInput> context_inputs;
	rt::buffer<FactContextRelation> context_relations;
	rt::buffer<rt::unique<FactContextRequest>> context_requests;
	rt::buffer<FactIntegerConstant> constants;
	usize constant_base;
};

// Only expressions without calls, lifetime effects, or potentially throwing
// conversions can be replaced by a constant without evaluating their operands.
fn fact_place_pure(SemanticExpression& expression) -> bool {
	if (expression.kind() == semantic_kind::name) {
		return expression.entity() && expression.entity()->kind() != entity_kind::function;
	};
	if ((expression.kind() == semantic_kind::member || expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast) && expression.size() == 1) {
		return fact_place_pure(*expression.item(0));
	};
	return false;
};

fn fact_default_constant(SemanticExpression* expression, var u64& value) -> bool {
	if (!expression) {
		@value = 0;
		return true;
	};
	if (expression->kind() == semantic_kind::construction && !expression->entity() && expression->type()->representation()->kind().is_integer() && expression->size() == 1 && expression->item(0)->kind() == semantic_kind::brace && expression->item(0)->size() <= 1) {
		if (!expression->item(0)->size()) {
			@value = 0;
			return true;
		};
		var SemanticExpression* source = expression->item(0)->item(0);
		if (!fact_default_constant(source, @value)) {
			return false;
		};
		IntegerRange before = fact_constant(source->type(), value);
		IntegerRange converted = fact_convert(before, expression->type());
		if (converted.available == fact_truth::unknown || converted.lower != converted.upper) {
			return false;
		};
		@value = converted.lower;
		return true;
	};
	return fact_pure(*expression) && expression->constant_integer(@value);
};

// Mirror only default initialization whose complete implicit evaluation has no
// unknown effects. Custom constructors and alias-bearing storage stay opaque.
fn fact_default_safe(Type* type, SemanticExpression* initializer, usize depth, var usize& budget) -> bool {
	if (!budget || depth > 32 || type->kind() == type_kind::reference) {
		return false;
	};
	@budget = budget - 1;
	if (initializer && initializer->kind() == semantic_kind::noop) {
		@initializer = nullptr;
	};
	if (type->kind().is_integer()) {
		u64 value = 0;
		return fact_default_constant(initializer, @value);
	};
	if (type->kind() == type_kind::array) {
		return !initializer && fact_default_safe(type->element(), nullptr, depth + 1, @budget);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return !initializer || initializer->kind() == semantic_kind::literal_real || initializer->kind() == semantic_kind::null_pointer;
	};
	var Entity* record = type->entity();
	if (record->layout() == record_layout::overlapping || aggregate_access_kind(type) == 2) {
		return false;
	};
	var Entity* constructor = record->default_constructor();
	if (constructor) {
		@constructor = constructor->canonical();
		if (constructor->definition() != function_definition::defaulted || constructor->role() != function_role::constructor || constructor->parameters().size() != 1) {
			return false;
		};
	};
	if (initializer) {
		if (initializer->kind() != semantic_kind::construction || initializer->integer() || !initializer->size() || initializer->item(0)->size() || initializer->entity() && initializer->entity()->canonical() != constructor) {
			return false;
		};
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!fact_default_safe(record->bases().data()[index], nullptr, depth + 1, @budget)) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		if (!fact_default_safe(field->type(), field->body(), depth + 1, @budget)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn fact_default_record(SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() != semantic_kind::construction || expression->type()->kind() != type_kind::named || expression->type()->entity()->kind() != entity_kind::record) {
		return false;
	};
	usize budget = 1024;
	return fact_default_safe(expression->type(), expression, 0, @budget);
};

// These operations may discard their computed Boolean only after evaluating
// their operands through the ordinary backend lifetime and exception paths.
fn fact_evaluated_condition(SemanticExpression& expression) -> bool {
	if (expression.type()->kind() != type_kind::boolean) {
		return false;
	};
	if (expression.kind() == semantic_kind::call) {
		Type* callable = expression.item(0)->type();
		if (callable->kind() == type_kind::pointer) {
			@callable = callable->element();
		};
		return callable->kind() == type_kind::function && callable->signature().result()->kind() == type_kind::boolean;
	};
	if (expression.kind() == semantic_kind::unary) {
		return expression.operation() == token_kind::op_bang;
	};
	if (expression.kind() != semantic_kind::binary || expression.size() != 2 || !expression.item(0)->type()->representation()->kind().is_integer() || !expression.item(1)->type()->representation()->kind().is_integer()) {
		return false;
	};
	token_kind operation = expression.operation();
	return operation == token_kind::op_equal || operation == token_kind::op_not_equal || operation == token_kind::op_less || operation == token_kind::op_less_equal || operation == token_kind::op_greater || operation == token_kind::op_greater_equal;
};

fn fact_pure(SemanticExpression& expression) -> bool {
	switch (expression.kind()) {
		case semantic_kind::literal_integer:
		case semantic_kind::name:
			return expression.type()->kind().is_integer();
		case semantic_kind::member:
			return expression.type()->kind().is_integer() && expression.size() == 1 && fact_place_pure(*expression.item(0));
		case semantic_kind::access:
		case semantic_kind::cast:
		case semantic_kind::unary:
			return expression.size() == 1 && expression.type()->kind().is_integer() && fact_pure(*expression.item(0));
		case semantic_kind::binary:
			return expression.operation() != token_kind::op_assign && expression.operation() != token_kind::op_copy && expression.size() == 2 && fact_pure(*expression.item(0)) && fact_pure(*expression.item(1));
	};
	return false;
};

fn fact_variant_transfer(SemanticExpression& expression) -> bool {
	if (expression.kind() != semantic_kind::construction || aggregate_access_kind(expression.type()) != 2 || expression.integer() || expression.size() != 1 || expression.item(0)->size() != 1 || !expression.item(0)->item(0)->type()->same_shape(*expression.type())) {
		return false;
	};
	if (!expression.entity()) {
		return true;
	};
	if (expression.entity()->definition() != function_definition::defaulted) {
		return false;
	};
	usize index = 0;
	while (true) {
		Type* alternative = variant_flow_type(expression.type(), index);
		if (!alternative) {
			break;
		};
		if (alternative->kind() == type_kind::named && alternative->entity()->kind() == entity_kind::record) {
			var Entity* record = alternative->entity();
			if (record->fields().size() || record->copy_constructor() && record->copy_constructor()->definition() != function_definition::defaulted || record->destructor() && record->destructor()->definition() != function_definition::defaulted) {
				return false;
			};
		}
		else if (!alternative->representation()->kind().is_scalar() && alternative->kind() != type_kind::null_type) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn InferredFacts::InferredFacts(var InferredFacts& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn InferredFacts::summary_cache(InferredFacts& this) -> FunctionFactSummaries& {
	if (this.summary_source) {
		return *this.summary_source;
	};
	return this.summaries;
};

fn InferredFacts::constant_version(var InferredFacts& this, Type* type, u64 value) -> usize {
	usize index = 0;
	while (index < this.constants.size()) {
		FactIntegerConstant& entry = this.constants.data()[index];
		if (entry.value == value && entry.type->same_shape(*type)) {
			return this.constant_base + index;
		};
		@index = index + 1;
	};
	FactIntegerConstant entry;
	@entry.type = type;
	@entry.value = value;
	@this.constants.push_back($entry);
	return this.constant_base + index;
};

fn InferredFacts::place(var InferredFacts& this, SemanticExpression* expression) -> usize {
	if (!expression) {
		return 0;
	};
	if ((expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::relocation) && expression->size() == 1) {
		return @this.place(expression->item(0));
	};
	if (expression->kind() == semantic_kind::cast && expression->size() == 1) {
		if (!expression->type()->same_shape(*expression->item(0)->type())) {
			return 0;
		};
		return @this.place(expression->item(0));
	};
	var Entity* root = nullptr;
	var Entity* field = nullptr;
	usize parent = 0;
	if (expression->kind() == semantic_kind::name && expression->entity() && expression->entity()->type()->kind() != type_kind::reference) {
		@root = expression->entity();
	}
	else if (expression->kind() == semantic_kind::member && expression->size() == 1 && expression->entity()) {
		if (expression->entity()->type()->kind() == type_kind::reference) {
			return 0;
		};
		@parent = @this.place(expression->item(0));
		if (!parent) {
			return 0;
		};
		@root = this.places.data()[parent - 1].root;
		@field = expression->entity();
		Type* receiver = expression->item(0)->type();
		if (receiver->kind() == type_kind::named && receiver->entity()->layout() == record_layout::overlapping) {
			return 0;
		};
	}
	else {
		return 0;
	};
	usize index = 0;
	while (index < this.places.size()) {
		FactPlace& candidate = this.places.data()[index];
		if (candidate.root == root && candidate.parent == parent && candidate.field == field) {
			return index + 1;
		};
		@index = index + 1;
	};
	FactPlace result;
	@result.root = root;
	@result.parent = parent;
	@result.field = field;
	@this.places.push_back($result);
	return this.places.size();
};

fn InferredFacts::collect(var InferredFacts& this, SemanticExpression* expression) {
	if (!expression) {
		return;
	};
	discard @this.place(expression);
	if (expression->kind() == semantic_kind::call && expression->entity()) {
		var FunctionFactSummary* summary = this.summary_cache().find(expression->entity());
		if (summary && !summary->opaque) {
			usize item = 0;
			while (item < summary->expressions.size()) {
				FunctionFactExpression& value = summary->expressions.data()[item];
				if (value.kind == function_fact_kind::entry_place) {
					discard @this.summary_place(value.place, *expression, *summary);
				};
				@item = item + 1;
			};
			@item = 0;
			while (item < summary->outcomes.size()) {
				FunctionFactOutcome& outcome = summary->outcomes.data()[item];
				usize write = 0;
				while (write < outcome.writes.size()) {
					discard @this.summary_place(outcome.writes.data()[write].target, *expression, *summary);
					@write = write + 1;
				};
				@item = item + 1;
			};
		};
	};
	usize index = 0;
	while (index < expression->size()) {
		@this.collect(expression->item(index));
		@index = index + 1;
	};
};

fn InferredFacts::summary_place(var InferredFacts& this, SemanticExpression* expression, SemanticExpression& call, FunctionFactSummary& summary) -> usize {
	while (expression && expression->kind() == semantic_kind::access && expression->size() == 1) {
		@expression = expression->item(0);
	};
	if (!expression) {
		return 0;
	};
	if (expression->kind() == semantic_kind::name) {
		usize parameter = 0;
		while (parameter < summary.function->parameters().size()) {
			if (summary.function->parameters().data()[parameter] == expression->entity()) {
				if (call.size() != 2 || parameter >= call.item(1)->size()) {
					return 0;
				};
				return @this.place(call.item(1)->item(parameter));
			};
			@parameter = parameter + 1;
		};
		return @this.place(expression);
	};
	if (expression->kind() != semantic_kind::member || expression->size() != 1) {
		return 0;
	};
	usize parent = @this.summary_place(expression->item(0), call, summary);
	if (!parent) {
		return 0;
	};
	usize index = 0;
	while (index < this.places.size()) {
		FactPlace& candidate = this.places.data()[index];
		if (candidate.parent == parent && candidate.field == expression->entity()) {
			return index + 1;
		};
		@index = index + 1;
	};
	FactPlace result;
	@result.root = this.places.data()[parent - 1].root;
	@result.parent = parent;
	@result.field = expression->entity();
	@this.places.push_back($result);
	return this.places.size();
};

fn InferredFacts::summary_value(var InferredFacts& this, FunctionFactSummary& summary, usize expression, SemanticExpression& call, FactState& state, usize depth) -> FactValue {
	FactValue result;
	if (!expression || expression > summary.expressions.size() || depth > 64) {
		return $result;
	};
	FunctionFactExpression& value = summary.expressions.data()[expression - 1];
	if (value.kind == function_fact_kind::integer) {
		@result.range = fact_constant(value.type, value.integer);
		@result.version = @this.constant_version(value.type, value.integer);
		return $result;
	};
	if (value.kind == function_fact_kind::variant) {
		@result.alternative = value.integer;
		return $result;
	};
	if (value.kind == function_fact_kind::entry_place) {
		var SemanticExpression* source = function_fact_unwrap(value.place);
		usize parameter = 0;
		while (source->kind() == semantic_kind::name && parameter < summary.function->parameters().size()) {
			if (source->entity() == summary.function->parameters().data()[parameter] && source->entity()->type()->kind() != type_kind::reference) {
				return state.value(call.item(1)->item(parameter));
			};
			@parameter = parameter + 1;
		};
		usize place = @this.summary_place(value.place, call, summary);
		if (place && place <= state.places.size()) {
			return FactValue(state.places.data()[place - 1]);
		};
		return $result;
	};
	FactValue left = @this.summary_value(summary, value.left, call, state, depth + 1);
	if (value.kind == function_fact_kind::cast) {
		IntegerRange converted = fact_convert(left.range, value.type);
		if (!value.type->same_shape(*summary.expressions.data()[value.left - 1].type) && (converted.available == fact_truth::unknown || converted.lower != left.range.lower || converted.upper != left.range.upper || converted.sign != left.range.sign)) {
			@left.version = 0;
			@left.origin = 0;
		};
		@left.range = $converted;
		return $left;
	};
	if (value.kind == function_fact_kind::unary && value.operation == token_kind::op_bang) {
		if (left.range.available != fact_truth::unknown && (left.range.lower || !left.range.upper)) {
			u64 integer = 0;
			if (!left.range.upper) {
				@integer = 1;
			};
			@result.range = fact_range(integer, integer);
		};
		return $result;
	};
	FactValue right = @this.summary_value(summary, value.right, call, state, depth + 1);
	if (!value.left || !value.right || !summary.expressions.data()[value.left - 1].type->representation()->kind().is_integer() || !summary.expressions.data()[value.right - 1].type->representation()->kind().is_integer()) {
		return $result;
	};
	fact_truth truth = fact_compare_values(value.operation, left, right);
	if (truth != fact_truth::unknown) {
		u64 integer = 0;
		if (truth == fact_truth::proven) {
			@integer = 1;
		};
		@result.range = fact_range(integer, integer);
		return $result;
	};
	if (left.range.available == fact_truth::unknown || right.range.available == fact_truth::unknown || left.range.sign == integer_range_sign::negative || right.range.sign == integer_range_sign::negative) {
		return $result;
	};
	u64 limit = fact_limit(value.type);
	if (value.operation == token_kind::op_plus && right.range.upper <= limit && left.range.upper <= limit - right.range.upper) {
		@result.range = fact_range(left.range.lower + right.range.lower, left.range.upper + right.range.upper);
		if (right.range.lower == right.range.upper) {
			fact_affine(@result, left, right.range.lower, false);
		};
	};
	if (value.operation == token_kind::op_minus && left.range.lower >= right.range.upper) {
		@result.range = fact_range(left.range.lower - right.range.upper, left.range.upper - right.range.lower);
		if (right.range.lower == right.range.upper) {
			fact_affine(@result, left, right.range.lower, true);
		};
	};
	return $result;
};

fn InferredFacts::apply_summary(var InferredFacts& this, var SemanticExpression& call, var FactState& state, var FactValue& result, usize version) -> bool {
	var FunctionFactSummary* summary = this.summary_cache().find(call.entity());
	if (!summary || summary->opaque || !summary->outcomes.size() || call.entity()->dispatch() != function_dispatch::ordinary) {
		return false;
	};
	FactState combined;
	FactValue combined_result;
	rt::buffer<ConditionalFact> learned;
	rt::buffer<ConditionalRelation> learned_relations;
	rt::buffer<FactOutcomeCount> outcome_counts;
	rt::buffer<FactCorrelationPlace> correlated_places;
	usize item = 0;
	while (item < summary->expressions.size()) {
		FunctionFactExpression& expression = summary->expressions.data()[item];
		if (expression.kind == function_fact_kind::entry_place) {
			@this.correlation_place(@correlated_places, @this.summary_place(expression.place, call, *summary), false);
		};
		@item = item + 1;
	};
	@item = 0;
	while (item < summary->outcomes.size()) {
		FunctionFactOutcome& outcome = summary->outcomes.data()[item];
		usize effect = 0;
		while (effect < outcome.writes.size()) {
			@this.correlation_place(@correlated_places, @this.summary_place(outcome.writes.data()[effect].target, call, *summary), true);
			@effect = effect + 1;
		};
		@item = item + 1;
	};
	bool union_result = aggregate_access_kind(call.type()) == 2;
	bool correlate = call.type()->kind() == type_kind::boolean || union_result;
	bool first = true;
	usize index = 0;
	while (index < summary->outcomes.size()) {
		FunctionFactOutcome& outcome = summary->outcomes.data()[index];
		bool feasible = true;
		usize condition = 0;
		while (condition < outcome.conditions.size()) {
			FactPathCondition& guard = outcome.conditions.data()[condition];
			FactValue value = @this.summary_value(*summary, guard.value, call, state, 0);
			if (value.range.available != fact_truth::unknown && (guard.truth && !value.range.upper || !guard.truth && value.range.lower)) {
				@feasible = false;
			};
			@condition = condition + 1;
		};
		if (feasible) {
			FactState branch;
			FactState entry;
			@entry.copy_from(state);
			@condition = 0;
			while (condition < outcome.conditions.size()) {
				FactPathCondition& guard = outcome.conditions.data()[condition];
				@this.summary_assume(*summary, guard.value, guard.truth, call, @entry);
				@condition = condition + 1;
			};
			@branch.copy_from(entry);
			FactValue returned = @this.summary_value(*summary, outcome.result, call, entry, 0);
			usize write = 0;
			while (write < outcome.writes.size()) {
				FactWrite& effect = outcome.writes.data()[write];
				usize place = @this.summary_place(effect.target, call, *summary);
				if (!place || place > branch.places.size()) {
					return false;
				};
				FactValue value;
				if (effect.kind == function_fact_effect::known_write) {
					@value = @this.summary_value(*summary, effect.value, call, entry, 0);
				};
				@this.invalidate(@branch, place);
				@value.version = version + place;
				@((@branch.places).data()[place - 1]) = $value;
				@write = write + 1;
			};
			if (union_result && !returned.alternative || !union_result && (returned.range.available == fact_truth::unknown || returned.range.lower != returned.range.upper)) {
				@correlate = false;
			};
			if (correlate) {
				u64 selector = returned.alternative;
				if (!union_result) {
					@selector = returned.range.lower;
				};
				usize effect = 0;
				while (effect < correlated_places.size()) {
						FactCorrelationPlace& storage = correlated_places.data()[effect];
						usize place = storage.place;
						if (!place || place > branch.places.size()) {
							return false;
						};
						usize existing = 0;
						bool found = false;
						while (existing < learned.size()) {
							var ConditionalFact& entry = @((@learned).data()[existing]);
							if (entry.place == place && entry.selector == selector) {
								discard fact_join_value(@entry.value, branch.places.data()[place - 1], false);
								@found = true;
							};
							@existing = existing + 1;
						};
						if (!found) {
							ConditionalFact entry;
							@entry.condition = version;
							@entry.selector = selector;
							@entry.variant = union_result;
							@entry.place = place;
							@entry.expected_version = state.places.data()[place - 1].version;
							if (storage.written) {
								@entry.expected_version = version + place;
							};
							@entry.value := branch.places.data()[place - 1];
							@learned.push_back($entry);
						};
						@effect = effect + 1;
				};
				usize group = 0;
				while (group < outcome_counts.size() && outcome_counts.data()[group].selector != selector) {
					@group = group + 1;
				};
				if (group == outcome_counts.size()) {
					FactOutcomeCount count;
					@count.selector = selector;
					@outcome_counts.push_back($count);
				};
				@((@outcome_counts).data()[group]).count = outcome_counts.data()[group].count + 1;
				@condition = 0;
				while (condition < outcome.conditions.size()) {
					FactPathCondition& guard = outcome.conditions.data()[condition];
					FunctionFactExpression& expression = summary->expressions.data()[guard.value - 1];
					if (expression.kind == function_fact_kind::binary && (expression.operation == token_kind::op_equal || expression.operation == token_kind::op_not_equal || expression.operation == token_kind::op_less || expression.operation == token_kind::op_less_equal || expression.operation == token_kind::op_greater || expression.operation == token_kind::op_greater_equal)) {
						FactValue left = @this.summary_value(*summary, expression.left, call, entry, 0);
						FactValue right = @this.summary_value(*summary, expression.right, call, entry, 0);
						if (left.version && right.version && (!left.origin || !left.displacement) && (!right.origin || !right.displacement)) {
							token_kind operation = expression.operation;
							if (!guard.truth) {
								@operation = fact_inverse(operation);
							};
							usize existing = 0;
							while (existing < learned_relations.size()) {
								ConditionalRelation& candidate = learned_relations.data()[existing];
								if (candidate.selector == selector && candidate.relation.left == left.version && candidate.relation.right == right.version && candidate.relation.operation == operation) {
									break;
								};
								@existing = existing + 1;
							};
							if (existing == learned_relations.size()) {
								ConditionalRelation relation;
								@relation.condition = version;
								@relation.selector = selector;
								@relation.variant = union_result;
								@relation.relation.left = left.version;
								@relation.relation.right = right.version;
								@relation.relation.operation = operation;
								@learned_relations.push_back($relation);
							};
							var ConditionalRelation& candidate = @((@learned_relations).data()[existing]);
							if (candidate.last_outcome != index + 1) {
								@candidate.last_outcome = index + 1;
								@candidate.occurrences = candidate.occurrences + 1;
							};
						};
					};
					@condition = condition + 1;
				};
			};
			if (first) {
				@combined_result = $returned;
				@first = false;
			}
			else {
				discard fact_join_value(@combined_result, returned, false);
			};
			bool changed = false;
			@combined.join(branch, false, @changed);
		};
		@index = index + 1;
	};
	if (first) {
		return false;
	};
	@state.copy_from(combined);
	if (correlate && (learned.size() || learned_relations.size())) {
		if (call.type()->representation()->kind().is_integer() && combined_result.version && !combined_result.origin) {
			@combined_result.origin = combined_result.version;
			@combined_result.displacement = 0;
		};
		@combined_result.version = version;
		usize entry = 0;
		while (entry < learned.size()) {
			ConditionalFact& fact = learned.data()[entry];
			bool valid = fact.expected_version && state.places.data()[fact.place - 1].version == fact.expected_version;
			if (fact.expected_version == version + fact.place) {
				@((@state.places).data()[fact.place - 1]).version = fact.expected_version;
				@valid = true;
			};
			if (valid) {
				@state.conditional.push_back(ConditionalFact(fact));
			};
			@entry = entry + 1;
		};
		@entry = 0;
		while (entry < learned_relations.size()) {
			ConditionalRelation& relation = learned_relations.data()[entry];
			usize group = 0;
			while (group < outcome_counts.size()) {
				FactOutcomeCount& count = outcome_counts.data()[group];
				if (count.selector == relation.selector) {
					if (count.count == relation.occurrences) {
						@state.conditional_relations.push_back(ConditionalRelation(relation));
					};
				};
				@group = group + 1;
			};
			@entry = entry + 1;
		};
	};
	@result = $combined_result;
	return true;
};

fn InferredFacts::correlation_place(var InferredFacts& this, var rt::buffer<FactCorrelationPlace>& places, usize place, bool written) {
	if (!place) {
		return;
	};
	usize index = 0;
	while (index < places.size()) {
		var FactCorrelationPlace& entry = @((@places).data()[index]);
		if (entry.place == place) {
			if (written) {
				@entry.written = true;
			};
			return;
		};
		@index = index + 1;
	};
	FactCorrelationPlace entry;
	@entry.place = place;
	@entry.written = written;
	@places.push_back($entry);
};

fn InferredFacts::summary_assume(var InferredFacts& this, FunctionFactSummary& summary, usize expression, bool truth, SemanticExpression& call, var FactState& state) {
	if (!expression || expression > summary.expressions.size()) {
		return;
	};
	FunctionFactExpression& condition = summary.expressions.data()[expression - 1];
	if (condition.kind != function_fact_kind::binary || !condition.left || !condition.right) {
		return;
	};
	token_kind predicate = condition.operation;
	if (predicate != token_kind::op_equal && predicate != token_kind::op_not_equal && predicate != token_kind::op_less && predicate != token_kind::op_less_equal && predicate != token_kind::op_greater && predicate != token_kind::op_greater_equal) {
		return;
	};
	if (!summary.expressions.data()[condition.left - 1].type->representation()->kind().is_integer() || !summary.expressions.data()[condition.right - 1].type->representation()->kind().is_integer()) {
		return;
	};
	if (!truth) {
		@predicate = fact_inverse(predicate);
	};
	FactValue first = @this.summary_value(summary, condition.left, call, state, 0);
	FactValue second = @this.summary_value(summary, condition.right, call, state, 0);
	if (first.version && second.version && (!first.origin || !first.displacement) && (!second.origin || !second.displacement)) {
		usize index = 0;
		while (index < state.relations.size()) {
			FactRelation& relation = state.relations.data()[index];
			if (relation.left == first.version && relation.right == second.version && relation.operation == predicate) {
				break;
			};
			@index = index + 1;
		};
		if (index == state.relations.size()) {
			FactRelation relation;
			@relation.left = first.version;
			@relation.right = second.version;
			@relation.operation = predicate;
			@state.relations.push_back($relation);
		};
	};
	FunctionFactExpression& left = summary.expressions.data()[condition.left - 1];
	if (left.kind != function_fact_kind::entry_place) {
		return;
	};
	var Entity* root = function_fact_root(left.place);
	if (!root) {
		return;
	};
	usize place = @this.summary_place(left.place, call, summary);
	if (!place || place > state.places.size()) {
		return;
	};
	FactValue before = @this.summary_value(summary, condition.left, call, state, 0);
	if (!before.version || before.version != state.places.data()[place - 1].version) {
		return;
	};
	FactValue right = @this.summary_value(summary, condition.right, call, state, 0);
	IntegerRange range = IntegerRange(state.places.data()[place - 1].range);
	Type* representation = left.type->representation();
	if (range.available == fact_truth::unknown && (representation->kind() == type_kind::unsigned_integer || representation->kind() == type_kind::boolean || representation->kind() == type_kind::character)) {
		@range = fact_range(0, fact_limit(representation));
	};
	if (range.available == fact_truth::unknown || right.range.available == fact_truth::unknown || range.sign == integer_range_sign::negative || right.range.sign == integer_range_sign::negative) {
		return;
	};
	token_kind operation = condition.operation;
	if (!truth) {
		@operation = fact_inverse(operation);
	};
	if (operation == token_kind::op_less && right.range.upper && range.upper >= right.range.upper) {
		@range.upper = right.range.upper - 1;
	};
	if (operation == token_kind::op_less_equal && range.upper > right.range.upper) {
		@range.upper = right.range.upper;
	};
	if (operation == token_kind::op_greater && right.range.lower != u64::max && range.lower <= right.range.lower) {
		@range.lower = right.range.lower + 1;
	};
	if (operation == token_kind::op_greater_equal && range.lower < right.range.lower) {
		@range.lower = right.range.lower;
	};
	if (operation == token_kind::op_equal) {
		if (range.lower < right.range.lower) {
			@range.lower = right.range.lower;
		};
		if (range.upper > right.range.upper) {
			@range.upper = right.range.upper;
		};
	};
	if (operation == token_kind::op_not_equal && right.range.lower == right.range.upper) {
		if (range.upper == right.range.lower && range.upper) {
			@range.upper = range.upper - 1;
		};
		if (range.lower == right.range.lower && range.lower != u64::max) {
			@range.lower = range.lower + 1;
		};
	};
	if (range.lower <= range.upper) {
		usize value = 0;
		while (value < state.places.size()) {
			if (state.places.data()[value].version == before.version) {
				@((@state.places).data()[value]).range := range;
			};
			@value = value + 1;
		};
		@value = 0;
		while (value < state.evaluated.size()) {
			if (state.evaluated.data()[value].value.version == before.version) {
				@((@state.evaluated).data()[value]).value.range := range;
			};
			@value = value + 1;
		};
	};
};

fn InferredFacts::refine_outcome(var InferredFacts& this, var FactState& state, usize condition, u64 selector, bool matches, bool variant) {
	usize relation = 0;
	while (matches && relation < state.conditional_relations.size()) {
		ConditionalRelation& entry = state.conditional_relations.data()[relation];
		if (entry.condition == condition && entry.selector == selector && entry.variant == variant) {
			usize known = 0;
			while (known < state.relations.size()) {
				FactRelation& candidate = state.relations.data()[known];
				if (candidate.left == entry.relation.left && candidate.right == entry.relation.right && candidate.operation == entry.relation.operation) {
					break;
				};
				@known = known + 1;
			};
			if (known == state.relations.size()) {
				@state.relations.push_back(FactRelation(entry.relation));
			};
		};
		@relation = relation + 1;
	};
	usize place = 0;
	while (place < state.places.size()) {
		bool found = false;
		FactValue refined;
		usize index = 0;
		while (index < state.conditional.size()) {
			ConditionalFact& entry = state.conditional.data()[index];
			if (entry.condition == condition && entry.variant == variant && (entry.selector == selector) == matches && entry.place == place + 1 && state.places.data()[place].version == entry.expected_version) {
				if (!found) {
					@refined := entry.value;
					@found = true;
				}
				else {
					discard fact_join_value(@refined, entry.value, false);
				};
			};
			@index = index + 1;
		};
		if (found) {
			@((@state.places).data()[place]).range := refined.range;
			usize origin = refined.origin;
			i64 displacement = refined.displacement;
			Type* type = this.places.data()[place].root->type();
			if (this.places.data()[place].field) {
				@type = this.places.data()[place].field->type();
			};
			if (type->kind() == type_kind::reference) {
				@type = type->element();
			};
			if (!origin && refined.version && refined.version != state.places.data()[place].version && type->representation()->kind().is_integer()) {
				@origin = refined.version;
				@displacement = 0;
			};
			@((@state.places).data()[place]).origin = origin;
			@((@state.places).data()[place]).displacement = displacement;
			@((@state.places).data()[place]).alternative = refined.alternative;
		};
		@place = place + 1;
	};
};

fn InferredFacts::seed_default_members(var InferredFacts& this, Type* type, Entity* owner, usize parent, var FactState& state, usize version, usize depth) {
	if (depth > 32 || type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};
	var Entity* record = type->entity();
	usize field = 0;
	while (field < record->fields().size()) {
		var Entity* member = record->fields().data()[field];
		usize index = 0;
		while (index < this.places.size()) {
			FactPlace& place = this.places.data()[index];
			if (place.root == owner && place.parent == parent && place.field == member) {
				if (member->type()->kind().is_integer()) {
					u64 constant = 0;
					if (fact_default_constant(member->body(), @constant)) {
						FactValue value;
						@value.range = fact_constant(member->type(), constant);
						@value.version = version + index + 1;
						@((@state.places).data()[index]) = $value;
					};
				}
				else {
					@this.seed_default_members(member->type(), owner, index + 1, @state, version, depth + 1);
				};
			};
			@index = index + 1;
		};
		@field = field + 1;
	};
};

fn InferredFacts::seed_default_record(var InferredFacts& this, Entity* owner, SemanticExpression* initializer, var FactState& state, usize version) {
	if (!owner || !initializer || owner->kind() != entity_kind::local || !owner->type()->same_shape(*initializer->type()) || !fact_default_record(initializer)) {
		return;
	};
	usize index = 0;
	while (index < this.places.size()) {
		if (this.places.data()[index].root == owner && !this.places.data()[index].parent) {
			@this.invalidate(@state, index + 1);
			@this.seed_default_members(owner->type(), owner, index + 1, @state, version, 0);
			return;
		};
		@index = index + 1;
	};
};

fn InferredFacts::end_lifetime(var InferredFacts& this, var FactState& state, Entity* owner) {
	if (!owner) {
		return;
	};
	usize index = 0;
	while (index < this.places.size()) {
		if (this.places.data()[index].root == owner) {
			@((@state.places).data()[index]) = FactValue();
		};
		@index = index + 1;
	};
	// Evaluations are immutable snapshots. In particular, a relocated value
	// remains available to initialize its destination after the source ends.
	@index = 0;
	while (index < state.conditional.size()) {
		usize place = state.conditional.data()[index].place;
		if (place && this.places.data()[place - 1].root == owner) {
			@((@state.conditional).data()[index]).place = 0;
		};
		@index = index + 1;
	};
};

fn InferredFacts::invalidate(var InferredFacts& this, var FactState& state, usize place) {
	usize index = 0;
	while (index < this.places.size()) {
		usize ancestor = index + 1;
		while (ancestor && ancestor != place) {
			@ancestor = this.places.data()[ancestor - 1].parent;
		};
		if (!place || ancestor) {
			@((@state.places).data()[index]) = FactValue();
		};
		if (place && !ancestor) {
			usize parent = this.places.data()[place - 1].parent;
			while (parent && parent != index + 1) {
				@parent = this.places.data()[parent - 1].parent;
			};
			if (parent) {
				@((@state.places).data()[index]) = FactValue();
			};
		};
		@index = index + 1;
	};
};

fn InferredFacts::evaluate(var InferredFacts& this, SemanticExpression* expression, FactState& state) -> FactValue {
	FactValue result;
	if (!expression) {
		return $result;
	};
	u64 literal = 0;
	if (expression->constant_integer(@literal)) {
		@result.range = fact_constant(expression->type(), literal);
		@result.version = @this.constant_version(expression->type(), literal);
		return $result;
	};
	if (expression->kind() == semantic_kind::construction && aggregate_access_kind(expression->type()) == 2 && expression->integer()) {
		@result.alternative = expression->integer();
		return $result;
	};
	if (fact_variant_transfer(*expression)) {
		return state.value(expression->item(0)->item(0));
	};
	if (expression->kind() == semantic_kind::member && expression->entity() && expression->entity()->name() == "_index" && aggregate_access_kind(expression->item(0)->type()) == 2) {
		@result = state.value(expression->item(0));
		if (result.alternative) {
			@result.range = fact_range(result.alternative, result.alternative);
		};
		return $result;
	};
	if (expression->kind() == semantic_kind::cast || expression->kind() == semantic_kind::access || expression->kind() == semantic_kind::relocation) {
		if (expression->size() != 1) {
			return $result;
		};
		@result = state.value(expression->item(0));
		IntegerRange converted = fact_convert(result.range, expression->type());
		if (!expression->type()->same_shape(*expression->item(0)->type()) && (converted.available == fact_truth::unknown || converted.lower != result.range.lower || converted.upper != result.range.upper || converted.sign != result.range.sign)) {
			@result.version = 0;
			@result.origin = 0;
		};
		@result.range = $converted;
		return $result;
	};
	usize place = @this.place(expression);
	if (place && place <= state.places.size()) {
		return FactValue(state.places.data()[place - 1]);
	};
	if (expression->kind() == semantic_kind::construction && expression->type()->representation()->kind().is_integer() && expression->size() == 1 && !expression->entity()) {
		if (!expression->item(0)->size()) {
			@result.range = fact_range(0, 0);
			return $result;
		};
		if (expression->item(0)->size() == 1) {
			@result = state.value(expression->item(0)->item(0));
			IntegerRange converted = fact_convert(result.range, expression->type());
			if (converted.available == fact_truth::unknown || converted.lower != result.range.lower || converted.upper != result.range.upper || converted.sign != result.range.sign) {
				@result.version = 0;
				@result.origin = 0;
			};
			@result.range = $converted;
			return $result;
		};
	};
	if (expression->kind() == semantic_kind::unary && expression->operation() == token_kind::op_bang) {
		FactValue operand = state.value(expression->item(0));
		if (operand.range.available != fact_truth::unknown && (operand.range.lower || !operand.range.upper)) {
			u64 value = 0;
			if (!operand.range.upper) {
				@value = 1;
			};
			@result.range = fact_range(value, value);
		};
		return $result;
	};
	if (expression->kind() != semantic_kind::binary || expression->size() != 2) {
		return state.value(expression);
	};
	FactValue left = state.value(expression->item(0));
	FactValue right = state.value(expression->item(1));
	token_kind operation = expression->operation();
	if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
		return $right;
	};
	if (!expression->item(0)->type()->representation()->kind().is_integer() || !expression->item(1)->type()->representation()->kind().is_integer()) {
		return $result;
	};
	fact_truth truth = fact_compare_values(operation, left, right);
	usize relation = 0;
	while (truth == fact_truth::unknown && left.version && right.version && relation < state.relations.size()) {
		FactRelation& entry = state.relations.data()[relation];
		if (entry.left == left.version && entry.right == right.version) {
			if (entry.operation == operation) {
				@truth = fact_truth::proven;
			};
			if (entry.operation == fact_inverse(operation)) {
				@truth = fact_truth::disproven;
			};
		};
		@relation = relation + 1;
	};
	if (truth != fact_truth::unknown) {
		u64 value = 0;
		if (truth == fact_truth::proven) {
			@value = 1;
		};
		@result.range = fact_range(value, value);
		return $result;
	};
	if (left.range.available == fact_truth::unknown || right.range.available == fact_truth::unknown || left.range.sign == integer_range_sign::negative || right.range.sign == integer_range_sign::negative) {
		return $result;
	};
	u64 limit = fact_limit(expression->type());
	if (operation == token_kind::op_plus && right.range.upper <= limit && left.range.upper <= limit - right.range.upper) {
		@result.range = fact_range(left.range.lower + right.range.lower, left.range.upper + right.range.upper);
		if (right.range.lower == right.range.upper) {
			fact_affine(@result, left, right.range.lower, false);
		};
	};
	if (operation == token_kind::op_minus && left.range.lower >= right.range.upper) {
		@result.range = fact_range(left.range.lower - right.range.upper, left.range.upper - right.range.lower);
		if (right.range.lower == right.range.upper) {
			fact_affine(@result, left, right.range.lower, true);
		};
	};
	return $result;
};

fn InferredFacts::assume(var InferredFacts& this, var SemanticExpression* condition, bool truth, var FactState& state) {
	FactValue known = state.value(condition);
	if (known.range.available != fact_truth::unknown) {
		if (truth && !known.range.upper || !truth && known.range.lower) {
			@state.reachable = false;
			return;
		};
	};
	if (condition->kind() == semantic_kind::cast && condition->size() == 1) {
		@this.assume(condition->item(0), truth, @state);
		return;
	};
	if (condition->kind() == semantic_kind::unary && condition->operation() == token_kind::op_bang) {
		@this.assume(condition->item(0), !truth, @state);
		return;
	};
	if (known.version && condition->type()->kind() == type_kind::boolean) {
		@this.refine_outcome(@state, known.version, u64(truth), true, false);
	};
	if (condition->kind() != semantic_kind::binary || condition->size() != 2) {
		return;
	};
	if (!condition->item(0)->type()->representation()->kind().is_integer() || !condition->item(1)->type()->representation()->kind().is_integer()) {
		return;
	};
	token_kind operation = condition->operation();
	if (operation != token_kind::op_equal && operation != token_kind::op_not_equal && operation != token_kind::op_less && operation != token_kind::op_less_equal && operation != token_kind::op_greater && operation != token_kind::op_greater_equal) {
		return;
	};
	if (!truth) {
		@operation = fact_inverse(operation);
	};
	FactValue left = state.value(condition->item(0));
	FactValue right = state.value(condition->item(1));
	if ((operation == token_kind::op_equal || operation == token_kind::op_not_equal) && left.version && right.range.available != fact_truth::unknown && right.range.lower == right.range.upper) {
		@this.refine_outcome(@state, left.version, right.range.lower, operation == token_kind::op_equal, true);
		@this.refine_outcome(@state, left.version, right.range.lower, operation == token_kind::op_equal, false);
	};
	if (left.version && right.version) {
		FactRelation relation;
		@relation.left = left.version;
		@relation.right = right.version;
		@relation.operation = operation;
		bool exists = false;
		usize index = 0;
		while (index < state.relations.size()) {
			FactRelation& entry = state.relations.data()[index];
			if (entry.left == relation.left && entry.right == relation.right && entry.operation == operation) {
				@exists = true;
			};
			@index = index + 1;
		};
		if (!(exists)) {
			@state.relations.push_back($relation);
		};
	};
	usize place = @this.place(condition->item(0));
	if (place && left.range.available == fact_truth::unknown && condition->item(0)->type()->kind() == type_kind::signed_integer && right.range.available != fact_truth::unknown) {
		IntegerRange refined;
		u64 limit = fact_limit(condition->item(0)->type());
		if (right.range.sign == integer_range_sign::nonnegative) {
			if (operation == token_kind::op_less && !right.range.upper) {
				@refined = fact_range(u64::max - limit, u64::max);
				@refined.sign = integer_range_sign::negative;
			};
			if ((operation == token_kind::op_greater_equal || operation == token_kind::op_greater) && right.range.lower <= limit) {
				u64 lower = right.range.lower;
				if (operation == token_kind::op_greater) {
					if (lower == limit) {
						@state.reachable = false;
						return;
					};
					@lower = lower + 1;
				};
				@refined = fact_range(lower, limit);
			};
		};
		if (operation == token_kind::op_equal && right.range.lower == right.range.upper) {
			@refined := right.range;
		};
		if (refined.available != fact_truth::unknown) {
			@((@state.places).data()[place - 1]).range = $refined;
		};
	};
	if (!place || right.range.available == fact_truth::unknown || left.range.available == fact_truth::unknown || left.range.sign == integer_range_sign::negative || right.range.sign == integer_range_sign::negative) {
		return;
	};
	IntegerRange refined = IntegerRange(left.range);
	if (operation == token_kind::op_less && right.range.upper) {
		if (refined.upper >= right.range.upper) {
			@refined.upper = right.range.upper - 1;
		};
	};
	if (operation == token_kind::op_less_equal && refined.upper > right.range.upper) {
		@refined.upper = right.range.upper;
	};
	if (operation == token_kind::op_greater && right.range.lower != u64::max && refined.lower <= right.range.lower) {
		@refined.lower = right.range.lower + 1;
	};
	if (operation == token_kind::op_greater_equal && refined.lower < right.range.lower) {
		@refined.lower = right.range.lower;
	};
	if (operation == token_kind::op_equal) {
		if (refined.lower < right.range.lower) {
			@refined.lower = right.range.lower;
		};
		if (refined.upper > right.range.upper) {
			@refined.upper = right.range.upper;
		};
	};
	if (refined.lower > refined.upper) {
		@state.reachable = false;
		return;
	};
	@((@state.places).data()[place - 1]).range = $refined;
};

fn InferredFacts::transfer(var InferredFacts& this, var SemanticExpression* expression, var FactState& state, usize version) {
	if (!expression) {
		return;
	};
	@version = version * (this.places.size() + 1);
	if (expression->kind() == semantic_kind::relocation) {
		@this.capture_aggregate(expression, @state);
	};
	FactValue value = @this.evaluate(expression, state);
	if (expression->kind() == semantic_kind::call && expression->entity() && @this.apply_summary(@*expression, @state, @value, version)) {
		if (!value.version) {
			@value.version = version;
		};
		@state.record(expression, $value);
		return;
	};
	if (!value.version) {
		@value.version = version;
	};
	if (expression->kind() == semantic_kind::construction && this.aggregate_move(expression)) {
		if (expression->size() > 1) {
			@this.apply_aggregate_move(expression, @state);
		};
		@state.record(expression, $value);
		return;
	};
	if (expression->kind() == semantic_kind::construction && fact_default_record(expression)) {
		if (expression->size() == 1) {
			@state.record(expression, $value);
			return;
		};
		usize destination = @this.place(expression->item(1));
		if (destination) {
			@this.invalidate(@state, destination);
			@this.seed_default_record(expression->item(1)->owned_binding(), expression, @state, version);
			@state.record(expression, $value);
			return;
		};
	};
	if (expression->kind() == semantic_kind::variable) {
		@this.apply_aggregate_move(expression->item(0), @state);
		@this.seed_default_record(expression->entity(), expression->item(0), @state, version);
		usize index = 0;
		while (index < this.places.size()) {
			if (this.places.data()[index].root == expression->entity() && !this.places.data()[index].parent) {
				@value = state.value(expression->item(0));
				if (!value.version) {
					@value.version = version;
				};
				@((@state.places).data()[index]) = FactValue(value);
			};
			@index = index + 1;
		};
	};
	if (expression->kind() == semantic_kind::binary && (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy)) {
		usize place = @this.place(expression->item(0));
		usize affected = place;
		if (!affected) {
			var SemanticExpression* target = expression->item(0);
			while (target->kind() == semantic_kind::access && target->size() == 1) {
				@target = target->item(0);
			};
			while (target->kind() == semantic_kind::index && target->item(0)->type()->kind() == type_kind::array) {
				FactValue index = state.value(target->item(1));
				if (index.range.available == fact_truth::unknown || index.range.sign == integer_range_sign::negative || index.range.upper >= target->item(0)->type()->count()) {
					@affected = 0;
					break;
				};
				@target = target->item(0);
				@affected = @this.place(target);
			};
		};
		@this.invalidate(@state, affected);
		if (place) {
			@value = state.value(expression->item(1));
			if (!value.version) {
				@value.version = version;
			};
			@((@state.places).data()[place - 1]) = FactValue(value);
		};
	};
	if (expression->kind() == semantic_kind::call || expression->kind() == semantic_kind::allocation || expression->kind() == semantic_kind::deallocation || expression->kind() == semantic_kind::array_deallocation || expression->kind() == semantic_kind::exception_try || expression->kind() == semantic_kind::switch_expression || expression->kind() == semantic_kind::construction && expression->entity() && !fact_variant_transfer(*expression) || expression->kind() == semantic_kind::destruction) {
		@this.invalidate(@state, 0);
		@state.relations.clear();
		@state.conditional.clear();
		@state.conditional_relations.clear();
		@state.evaluated.clear();
		@state.aggregate_evaluated.clear();
	};
	if (expression->kind() == semantic_kind::relocation || expression->kind() == semantic_kind::destruction) {
		@this.invalidate(@state, @this.place(expression->item(0)));
	};
	if (expression->kind() == semantic_kind::variant_cast) {
		usize place = @this.place(expression->item(0));
		if (place) {
			@((@state.places).data()[place - 1]).alternative = expression->integer();
		};
	};
	@state.record(expression, $value);
};

fn InferredFacts::analyze(var InferredFacts& this, var SemanticExpression* body) -> CompilationResult {
	@this.places.clear();
	@this.incoming.clear();
	@this.constants.clear();
	@this.collect(body);
	@this.collect_aggregate_moves(body);
	FactGraph graph;
	if (this.analyzed_function) {
		@graph.build_function(*this.analyzed_function);
	}
	else {
		@graph.build(body);
	};
	// Large functions remain conservative until sparse state storage is available.
	if (graph.nodes.size() > 512) {
		return;
	};
	@this.constant_base = (graph.nodes.size() + 3) * (this.places.size() + 1);
	usize node = 0;
	while (node < graph.nodes.size()) {
		rt::unique<FactState> state = rt::unique<FactState>::make();
		usize place = 0;
		while (place < this.places.size()) {
			FactValue value;
			@value.version = (graph.nodes.size() + 1) * (this.places.size() + 1) + place + 1;
			FactPlace& storage = this.places.data()[place];
			Type* type = storage.root->type();
			if (storage.field) {
				@type = storage.field->type();
			};
			if (type->kind() == type_kind::unsigned_integer || type->kind() == type_kind::boolean || type->kind() == type_kind::character) {
				@value.range = fact_range(0, fact_limit(type));
			};
			@state.get()->places.push_back($value);
			@place = place + 1;
		};
		if (node == graph.entry) {
			@state.get()->reachable = true;
			@this.context_seed(@*state.get());
		};
		@this.incoming.push_back($state);
		@node = node + 1;
	};
	usize iteration = 0;
	while (true) {
		bool changed = false;
		usize edge = 0;
		while (edge < graph.edges.size()) {
			FactEdge& link = graph.edges.data()[edge];
			FactState& source = *this.incoming.data()[link.source].get();
			if (source.reachable) {
				FactState outgoing;
				@outgoing.copy_from(source);
				var SemanticExpression* expression = graph.nodes.data()[link.source].expression;
				if (graph.nodes.data()[link.source].kind == fact_node_kind::opaque) {
					@this.invalidate(@outgoing, 0);
					@outgoing.evaluated.clear();
					@outgoing.aggregate_evaluated.clear();
					@outgoing.relations.clear();
					@outgoing.conditional.clear();
					@outgoing.conditional_relations.clear();
				}
				else if (graph.nodes.data()[link.source].kind == fact_node_kind::lifetime_end) {
					@this.end_lifetime(@outgoing, graph.nodes.data()[link.source].owner);
				}
				else if (graph.nodes.data()[link.source].kind != fact_node_kind::lifetime_begin) {
					@this.transfer(expression, @outgoing, link.source + 1);
				};
				if (link.condition && (link.kind == fact_edge_kind::when_true || link.kind == fact_edge_kind::when_false)) {
					@this.assume(link.condition, link.kind == fact_edge_kind::when_true, @outgoing);
				};
				if (link.kind == fact_edge_kind::exceptional || link.kind == fact_edge_kind::backedge) {
					if (link.kind == fact_edge_kind::exceptional) {
						@this.invalidate(@outgoing, 0);
					};
					@outgoing.evaluated.clear();
					@outgoing.aggregate_evaluated.clear();
					@outgoing.relations.clear();
					@outgoing.conditional.clear();
					@outgoing.conditional_relations.clear();
				};
				@this.incoming.data()[link.target].get()->join(outgoing, iteration > 1 && link.kind == fact_edge_kind::backedge, @changed);
			};
			@edge = edge + 1;
		};
		if (!changed) {
			break;
		};
		@iteration = iteration + 1;
		if (iteration > graph.nodes.size() * 4 + 16) {
			return;
		};
	};
	@node = 0;
	while (node < graph.nodes.size()) {
		var SemanticExpression* expression = graph.nodes.data()[node].expression;
		FactState& state = *this.incoming.data()[node].get();
		if (expression && state.reachable && graph.nodes.data()[node].kind == fact_node_kind::expression) {
			if (expression->kind() == semantic_kind::variant_cast && state.value(expression->item(0)).alternative == expression->integer()) {
				if (this.context_output) {
					if (expression->inferred_alternative() != expression->integer()) {
						@this.context_override(@*expression, inferred_override_kind::alternative, expression->integer());
					};
				}
				else {
					@expression->set_inferred_alternative(expression->integer());
				};
			};
			FactValue value = @this.evaluate(expression, state);
			if (value.range.available != fact_truth::unknown && value.range.lower == value.range.upper && fact_pure(*expression)) {
				if (this.context_output) {
					u64 previous = 0;
					if (fact_context_condition(graph, expression)) {
						if (!(expression->inferred_integer(@previous))) {
							@this.context_override(@*expression, inferred_override_kind::integer, value.range.lower);
						};
					};
				}
				else {
					@expression->set_inferred_integer(value.range.lower);
				};
			};
			if (!fact_pure(*expression) && fact_evaluated_condition(*expression) && fact_context_condition(graph, expression)) {
				if (expression->kind() == semantic_kind::call) {
					FactState returned;
					@returned.copy_from(state);
					@this.transfer(expression, @returned, node + 1);
					@value = returned.value(expression);
				};
				if (value.range.available != fact_truth::unknown && value.range.lower == value.range.upper && value.range.upper <= 1) {
					bool known = value.range.lower != 0;
					if (this.context_output) {
						bool previous = false;
						if (!(expression->inferred_condition(@previous))) {
							@this.context_override(@*expression, inferred_override_kind::evaluated_condition, value.range.lower);
						};
					}
					else {
						@expression->set_inferred_condition(known);
					};
				};
			};
			if (expression->kind() == semantic_kind::call) {
				@this.context_capture(@*expression, state);
			};
			if (expression->kind() == semantic_kind::index && expression->item(0)->type()->kind() == type_kind::array) {
				FactValue index = state.value(expression->item(1));
				if (index.range.available != fact_truth::unknown && (index.range.sign == integer_range_sign::negative || index.range.lower >= expression->item(0)->type()->count())) {
					@this.diagnostics->error(expression->token(), "array index is provably outside the array bounds");
					DiagnosticMessage deduction;
					@deduction.text("inferred index range is [");
					fact_diagnostic_bound(@deduction, index.range.lower, index.range.sign);
					@deduction.text(", ");
					fact_diagnostic_bound(@deduction, index.range.upper, index.range.sign);
					@deduction.text("]; array extent is ");
					@deduction.number(expression->item(0)->type()->count());
					@this.diagnostics->note(expression->item(1)->token(), deduction.view());
					return compilation_error();
				};
			};
		};
		@node = node + 1;
	};
};

fn InferredFacts::validate(var InferredFacts& this, var SemanticUnit& unit) -> CompilationResult {
	@this.summaries.validate(unit);
	usize index = 0;
	@this.context_requests.clear();
	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();
		if (entity->kind() == entity_kind::function && entity->body()) {
			@this.analyzed_function = entity;
			if (!(@this.analyze(entity->body())).has<void>()) {
				return compilation_error();
			};
		};
		@index = index + 1;
	};
	return fact_build_contexts(@this, @unit.mutable_fact_contexts());
};

fn Analyzer::resolve_bases(var Analyzer& this, var Entity* entity) -> CompilationResult {
	var Syntax* declaration = entity->declaration();
	var Syntax* bases = declaration->record_bases();

	if (!bases->size()) {
		return;
	};

	if (entity->layout() == record_layout::overlapping) {
		var message = DiagnosticMessage();
		@message.text("union '");
		diagnostic_entity(@message, *entity);
		@message.text("' cannot contain a base subobject");
		@this.report(entity->token(), message.view());
		return compilation_error();
	};

	if (bases->size() != 1) {
		var message = DiagnosticMessage();
		@message.text("record '");
		diagnostic_entity(@message, *entity);
		@message.text("' declares ");
		@message.number(u64(bases->size()));
		@message.text(" base types; multiple base analysis is not implemented");
		@this.report(entity->token(), message.view());
		return compilation_error();
	};

	Type* base = @this.type(@*entity->resolution_scope(), @*bases->item(0));

	if (!base) {
		return compilation_error();
	};
	if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record || base->qualifier() != type_qualifier::mutable || base->entity()->layout() != record_layout::sequential) {
		var message = DiagnosticMessage();
		@message.text("invalid base type '");
		diagnostic_type(@message, *base);
		@message.text("' for record '");
		diagnostic_entity(@message, *entity);
		@message.text("': ");
		if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record) {
			@message.text("base requires a record type");
		}
		else if (base->qualifier() != type_qualifier::mutable) {
			@message.text("base type shall be unqualified");
		}
		else {
			@message.text("base type shall not be a union");
		};
		@this.report(bases->item(0)->token(), message.view());
		return compilation_error();
	};

	var Entity* owner = base->entity();

	if (owner->state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text("base relation contains a cycle; record '");
		diagnostic_entity(@message, *entity);
		@message.text("' names base '");
		diagnostic_type(@message, *base);
		@message.text("'");
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), "base record is declared here");
		return compilation_error();
	};

	if (!(@this.resolve(owner)).has<void>()) {
		return compilation_error();
	};

	if (owner->declaration()->record_members()->kind() == syntax_kind::noop) {
		var message = DiagnosticMessage();
		@message.text("base requires a complete record definition; record '");
		diagnostic_entity(@message, *entity);
		@message.text("' names base '");
		diagnostic_type(@message, *base);
		@message.text("'");
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), "base record is declared here");
		return compilation_error();
	};

	@entity->add_base(base);

};

fn SemanticUnit::inline_record(SemanticUnit& this, Syntax& syntax, Scope& scope) -> var Entity* {
	usize index = 0;
	while (index < this.inline_records.size()) {
		InlineRecord& record = this.inline_records.data()[index];
		if (record.syntax == &@syntax && record.scope == &@scope) {
			return record.entity;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn SemanticUnit::retain_inline_record(var SemanticUnit& this, var Syntax& syntax, var Scope& scope, var Entity& entity) {
	InlineRecord record;
	@record.syntax = &@syntax;
	@record.scope = &@scope;
	@record.entity = &@entity;
	@this.inline_records.push_back($record);
};

fn Analyzer::inline_record_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type* {
	var Entity* record = this.unit->inline_record(syntax, scope);
	if (record) {
		if (!(@this.resolve(record)).has<void>()) {
			return nullptr;
		};
		return record->type();
	};
	var Syntax* name = syntax.record_name();
	if (name->kind() != syntax_kind::absent) {
		if (name->kind() != syntax_kind::name) {
			@this.error(name, "inline record requires an unqualified name");
			return nullptr;
		};
		if (!(@this.collect(@scope, @syntax)).has<void>()) {
			return nullptr;
		};
		@record = scope.local(name->token().text());
		if (!record) {
			compiler_panic("collected inline record is missing from its scope");
		};
	}
	else {
		if (syntax.record_members()->kind() == syntax_kind::noop) {
			@this.error(&@syntax, "anonymous record type requires a definition");
			return nullptr;
		};
		var identity = DiagnosticMessage();
		@identity.text("inline-record[");
		@identity.number(u64(this.unit->entities().size()));
		@identity.text("]");
		@record = @this.unit->create_entity(entity_kind::record, syntax.token(), &@syntax, &@scope);
		@record->set_name(identity.view());
		@record->set_origin(declaration_origin::compiler_supplied);
		var Scope* members = @this.unit->create_scope(&@scope, record);
		@record->set_members(members);
	};
	@this.unit->retain_inline_record(@syntax, @scope, @*record);
	if (name->kind() == syntax_kind::absent && !(@this.collect(@*record->members(), @*syntax.record_members())).has<void>()) {
		return nullptr;
	};
	if (!(@this.resolve(record)).has<void>()) {
		return nullptr;
	};
	return record->type();
};

fn Analyzer::names_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool {
	switch (syntax.kind()) {
		case syntax_kind::type_tuple:
		case syntax_kind::type_variant:
			return @this.names_type(@scope, @*syntax.left()) && @this.names_type(@scope, @*syntax.right());
		case syntax_kind::type_grouping:
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_array:
		case syntax_kind::type_const:
		case syntax_kind::type_mutable:
			return @this.names_type(@scope, @*syntax.designated_type());
		case syntax_kind::record:
		case syntax_kind::type_function:
			return true;
		case syntax_kind::type_name: {
			var Syntax* name = syntax.designated_type();
			var Entity* entity = @this.lookup(@scope, @*name);

			if (entity) {
				return entity->denotes_type();
			};

			return this.types->find_primitive(name->token().text()) != nullptr;
		};
	};

	return false;
};

fn LifetimeAnalyzer::storage_owner(LifetimeAnalyzer& this, SemanticExpression& expression, var FlowState& state) -> rt::optional_ref<Entity> {
	switch (expression.kind()) {
		case semantic_kind::name: {
			var Entity* entity = expression.entity();

			if (!entity || entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter) {
				return rt::optional_ref<Entity>();
			};

			usize remaining = state.size();
			while (entity->type()->kind() == type_kind::reference) {
				var LiveBinding* binding = @state.find(entity);

				if (!binding) {
					return rt::optional_ref<Entity>(@*entity);
				};

				if (!remaining || !binding->referent.has_value()) {
					return rt::optional_ref<Entity>();
				};

				@entity = binding->referent.get();
				@remaining = remaining - 1;
			};

			return rt::optional_ref<Entity>(@*entity);
		};
		case semantic_kind::access:
		case semantic_kind::cast:
		case semantic_kind::member:
			return this.storage_owner(*expression.item(0), @state);
		case semantic_kind::index:
			if (expression.item(0)->type()->kind() == type_kind::array) {
				return this.storage_owner(*expression.item(0), @state);
			};

			break;
		case semantic_kind::dereference:
			if (expression.item(0)->kind() == semantic_kind::address) {
				return this.storage_owner(*expression.item(0)->item(0), @state);
			};

			break;
		case semantic_kind::sequence:
			return this.storage_owner(*expression.item(2), @state);
	};

	return rt::optional_ref<Entity>();
};

fn LifetimeAnalyzer::sequence(var LifetimeAnalyzer& this, var SemanticExpression& expression, var FlowState& state) -> CompilationResult {
	usize boundary = state.size();

	if (!(@this.walk(expression.item(0), @state)).has<void>() || !(@this.walk(expression.item(1), @state)).has<void>() || !(@this.walk(expression.item(2), @state)).has<void>()) {
		return compilation_error();
	};

	if (!state.exited() && expression.category() == value_category::place) {
		var owner = this.storage_owner(*expression.item(2), @state);

		if (owner.has_value()) {
			usize index = boundary;
			while (index < state.size()) {
				var LiveBinding* binding = @state.at(index);

				if (binding->entity == owner.get()) {
					return @this.binding_error(&@expression, "sequence result refers to local storage", *binding->entity);
				};

				@index = index + 1;
			};
		};
	};

	@state.truncate(boundary);

};

fn LifetimeAnalyzer::selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!(@this.walk(expression->item(0), @state)).has<void>()) {
		return compilation_error();
	};

	var SemanticExpression* body = expression->item(1);

	if (body->kind() != semantic_kind::brace) {
		return;
	};

	usize boundary = state.size();
	u64 condition = 0;
	bool known = expression->item(0)->constant_integer(@condition);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		var SemanticExpression* label = body->item(index);

		if (label->kind() == semantic_kind::case_label) {
			if (label->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (known && label->integer() == condition) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	FlowState combined;

	@combined.copy_from(state);

	if (fallback < body->size() || known && selected < body->size()) {
		@combined.leave(flow_exit::unreachable);
	};

	LoopFlow selection;
	@selection.region = flow_region::selection;
	@selection.parent := this.active_loop;
	@selection.break_boundary := boundary;
	var scope = LoopScope(@this.active_loop, @selection);
	@index = 0;

	while (index < body->size()) {
		if (body->item(index)->kind() != semantic_kind::case_label || known && index != selected) {
			@index = index + 1;
			continue;
		};

		FlowState path;

		@path.copy_from(state);

		usize next = index + 1;

		while (next < body->size() && !path.exited()) {
			if (body->item(next)->kind() != semantic_kind::case_label && !(@this.walk(body->item(next), @path)).has<void>()) {
				return compilation_error();
			};

			@next = next + 1;
		};

		if (!path.exited() && !(@this.save(@selection.breaks, @path, boundary, expression)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < selection.breaks.size()) {
		FlowState previous;

		@previous.copy_from(combined);
		if (!((@this.merge(@combined, @previous, @*selection.breaks.data()[index].get(), expression)).has<void>())) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@state.copy_from(combined);
};

enum object_lifetime : [u08] {
	live;
	relocated;
	discarded;
	destroyed;
	indeterminate;
};

enum flow_exit : [u08] {
	none;
	unreachable;
	return_function;
	break_loop;
	continue_loop;
	throw_exception;
};

enum flow_region : [u08] {
	loop;
	selection;
};

struct LiveBinding {
	var Entity* entity;
	object_lifetime lifetime;
	rt::optional_ref<Entity> referent;
};

struct FlowState {
	fn declare(var FlowState& this, var Entity* entity);
	fn copy_from(var FlowState& this, FlowState& other);
	fn truncate(var FlowState& this, usize size);
	fn leave(var FlowState& this, flow_exit exit);
	fn resume(var FlowState& this);

	fn size(FlowState& this) -> usize;
	fn at(var FlowState& this, usize index) -> var LiveBinding*;
	fn find(var FlowState& this, var Entity* entity) -> var LiveBinding*;
	fn exited(FlowState& this) -> bool;

private:
	rt::buffer<LiveBinding> bindings;
	flow_exit exit;
};

struct LoopFlow {
	flow_region region;
	usize break_boundary;
	usize continue_boundary;
	var LoopFlow* parent;
	rt::buffer<rt::unique<FlowState>> breaks;
	rt::buffer<rt::unique<FlowState>> continues;
};

struct LoopScope {
	fn LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop);
	fn ~LoopScope(var LoopScope& this);

private:
	var LoopFlow var** current;
	var LoopFlow* previous;
};

struct ExceptionFlow {
	usize boundary;
	var ExceptionFlow* parent;
	rt::buffer<rt::unique<FlowState>> entries;
};

struct LifetimeAnalyzer {
	fn LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics);

	fn sequence(var LifetimeAnalyzer& this, var SemanticExpression& expression, var FlowState& state) -> CompilationResult;
	fn validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn validate_graph(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn validate_legacy(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult;

	fn storage_owner(LifetimeAnalyzer& this, SemanticExpression& expression, var FlowState& state) -> rt::optional_ref<Entity>;

private:
	fn error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view message) -> CompilationResult;
	fn binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view reason, Entity& entity) -> CompilationResult;
	fn walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> CompilationResult;
	fn validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> CompilationResult;
	fn conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> CompilationResult;
	fn exceptions(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn exceptional_edge(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult;
	fn graph_function(var LifetimeAnalyzer& this, var Entity& function) -> CompilationResult;
	fn graph_transfer(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, var GraphLifetimeState& state);
	fn graph_check(var LifetimeAnalyzer& this, FactNode& node, rt::buffer<var Entity*>& bindings, GraphLifetimeState& state) -> CompilationResult;

	var Diagnostics* diagnostics;
	var LoopFlow* active_loop;
	var ExceptionFlow* active_exception;
};

fn LifetimeAnalyzer::exceptional_edge(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!this.active_exception || state.exited()) {
		return;
	};
	return @this.save(@this.active_exception->entries, @state, usize(this.active_exception->boundary), expression);
};

fn LifetimeAnalyzer::exceptions(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	ExceptionFlow region;
	@region.boundary = state.size();
	@region.parent = this.active_exception;
	@this.active_exception = &@region;
	FlowState normal;
	@normal.copy_from(state);
	bool valid = (@this.walk(expression->item(0), @normal)).has<void>();
	@this.active_exception = region.parent;
	if (!valid) {
		return compilation_error();
	};
	@normal.truncate(usize(region.boundary));
	@state.copy_from(normal);
	if (!region.entries.size()) {
		return;
	};
	FlowState incoming;
	@incoming.copy_from(*region.entries.data()[0].get());
	usize edge = 1;
	while (edge < region.entries.size()) {
		FlowState previous;
		@previous.copy_from(incoming);
		if (!((@this.merge(@incoming, @previous, @*region.entries.data()[edge].get(), expression)).has<void>())) {
			return compilation_error();
		};
		@edge = edge + 1;
	};
	usize index = 1;
	while (index < expression->size()) {
		var SemanticExpression* handler = expression->item(index);
		FlowState caught;
		@caught.copy_from(incoming);
		if (handler->entity()) {
			@caught.declare(handler->entity());
		};
		if (!(@this.walk(handler->item(0), @caught)).has<void>()) {
			return compilation_error();
		};
		@caught.truncate(usize(region.boundary));
		FlowState previous;
		@previous.copy_from(state);
		if (!((@this.merge(@state, @previous, @caught, expression)).has<void>())) {
			return compilation_error();
		};
		@index = index + 1;
	};
	var SemanticExpression* last = expression->item(expression->size() - 1);
	if (last->type()->kind() != type_kind::void_type && !(@this.exceptional_edge(expression, @incoming)).has<void>()) {
		return compilation_error();
	};
};

fn LifetimeAnalyzer::error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view message) -> CompilationResult {
	Token token;

	if (expression) {
		@token = expression->token();
	};

	@this.diagnostics->error(token, message);
	return compilation_error();
};

fn LifetimeAnalyzer::binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view reason, Entity& entity) -> CompilationResult {
	if (this.diagnostics->failed()) {
		return compilation_error();
	};
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text("; object '");
	diagnostic_entity(@message, entity);
	@message.text("' has type '");
	diagnostic_type(@message, *entity.type());
	@message.text("'");
	Token location = entity.token();
	if (expression) {
		@location = expression->token();
	};
	@this.diagnostics->error(location, message.view());
	@this.diagnostics->note(entity.token(), "object is declared here");
	return compilation_error();
};

fn LifetimeAnalyzer::merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> CompilationResult {
	if (first.exited() && second.exited()) {
		@destination.copy_from(first);
		return;
	};

	if (first.exited()) {
		@destination.copy_from(second);
		return;
	};

	if (second.exited()) {
		@destination.copy_from(first);
		return;
	};

	usize index = 0;
	while (index < destination.size()) {
		var LiveBinding* binding = @destination.at(index);
		var LiveBinding* a = @first.find(binding->entity);
		var LiveBinding* b = @second.find(binding->entity);

		if (!a || !b) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable control-flow merge", *binding->entity);
		};

		if (a->lifetime == object_lifetime::indeterminate || b->lifetime == object_lifetime::indeterminate || (a->lifetime == object_lifetime::live) != (b->lifetime == object_lifetime::live)) {
			@binding->lifetime = object_lifetime::indeterminate;
		}
		else {
			@binding->lifetime = object_lifetime(a->lifetime);
		};

		if (a->referent.get() != b->referent.get() || !a->referent.has_value()) {
			@binding->referent.reset();
		}
		else {
			@binding->referent.bind(@*a->referent.get());
		};

		@index = index + 1;
	};

};

fn LifetimeAnalyzer::validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> CompilationResult {
	usize index = 0;
	while (index < entry.size()) {
		var LiveBinding* binding = @entry.at(index);
		var LiveBinding* repeated = @incoming.find(binding->entity);

		if (!repeated || (binding->lifetime == object_lifetime::indeterminate) != (repeated->lifetime == object_lifetime::indeterminate) || (binding->lifetime == object_lifetime::live) != (repeated->lifetime == object_lifetime::live)) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable loop backedge", *binding->entity);
		};

		@index = index + 1;
	};

};

fn LifetimeAnalyzer::conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!(@this.walk(expression->item(0), @state)).has<void>()) {
		return compilation_error();
	};

	bool truth = false;

	if (expression->item(0)->constant_truth(@truth)) {
		if (truth) {
			return @this.walk(expression->item(1), @state);
		};

		return @this.walk(expression->item(2), @state);
	};

	FlowState first;
	FlowState second;

	@first.copy_from(state);
	@second.copy_from(state);

	if (!(@this.walk(expression->item(1), @first)).has<void>() || !(@this.walk(expression->item(2), @second)).has<void>()) {
		return compilation_error();
	};

	return @this.merge(@state, @first, @second, $expression);
};

fn LifetimeAnalyzer::storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	var Entity* owner = expression->owned_binding();

	if (!owner) {
		return @this.walk(expression, @state);
	};

	if (!@state.find(owner)) {
		return @this.binding_error(expression, "object storage does not reach this construction", *owner);
	};

};

fn LifetimeAnalyzer::save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> CompilationResult {
	rt::unique<FlowState> snapshot = rt::unique<FlowState>::make();

	@snapshot.get()->copy_from(state);

	@snapshot.get()->truncate($boundary);
	@snapshot.get()->resume();

	@exits.push_back($snapshot);

};

fn LifetimeAnalyzer::loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	bool is_for = expression->kind() == semantic_kind::for_loop;
	usize boundary = state.size();

	if (is_for && !(@this.walk(expression->item(0), @state)).has<void>()) {
		return compilation_error();
	};

	FlowState entry;

	@entry.copy_from(state);

	usize condition = 0;
	usize body = 1;

	if (is_for) {
		@condition = 1;
		@body = 3;
	};

	var SemanticExpression* test = expression->item(condition);

	if (!(@this.walk(test, @state)).has<void>()) {
		return compilation_error();
	};

	bool truth = true;
	bool known = is_for && test->kind() == semantic_kind::noop;

	if (!known) {
		@known = test->constant_truth(@truth);
	};

	if (known && !truth) {
		@state.truncate(boundary);

		return;
	};

	FlowState repeated;

	@repeated.copy_from(state);

	LoopFlow loop;
	@loop.parent := this.active_loop;
	@loop.break_boundary := boundary;
	@loop.continue_boundary = state.size();
	var scope = LoopScope(@this.active_loop, @loop);

	if (!(@this.walk(expression->item(body), @repeated)).has<void>()) {
		return compilation_error();
	};

	if (!repeated.exited() && !(@this.save(@loop.continues, @repeated, loop.continue_boundary, expression)).has<void>()) {
		return compilation_error();
	};

	usize body_exits = loop.continues.size();
	usize index = 0;
	while (index < body_exits) {
		var FlowState& backedge = @*loop.continues.data()[index].get();

		if (is_for && !(@this.walk(expression->item(2), @backedge)).has<void>()) {
			return compilation_error();
		};

		if (!backedge.exited()) {
			if (!(@this.validate_backedge(@entry, @backedge, expression)).has<void>()) {
				return compilation_error();
			};
		};

		@index = index + 1;
	};

	while (index < loop.continues.size()) {
		if (!(@this.validate_backedge(@entry, @*loop.continues.data()[index].get(), expression)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@state.truncate(boundary);
	bool has_exit = !known || !truth;
	@index = 0;

	while (index < loop.breaks.size()) {
		var FlowState& leaving = @*loop.breaks.data()[index].get();

		if (!has_exit) {
			@state.copy_from(leaving);

			@has_exit = true;
		}
		else {
			FlowState previous;

			@previous.copy_from(state);
			if (!((@this.merge(@state, @previous, @leaving, expression)).has<void>())) {
				return compilation_error();
			};
		};

		@index = index + 1;
	};

	if (!has_exit) {
		@state.leave(flow_exit::unreachable);
	};

};

fn LifetimeAnalyzer::walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> CompilationResult {
	if (!expression || state.exited()) {
		return;
	};

	switch (expression->kind()) {
		case semantic_kind::exception_try:
			return @this.exceptions(expression, @state);
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
			if (expression->size() && !(@this.walk(expression->item(0), @state)).has<void>()) {
				return compilation_error();
			};
			if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
				return compilation_error();
			};
			@state.leave(flow_exit::throw_exception);
			return;
		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or) {
				if (!(@this.walk(expression->item(0), @state)).has<void>()) {
					return compilation_error();
				};

				bool truth = false;

				if (expression->item(0)->constant_truth(@truth)) {
					if (expression->operation() == token_kind::op_and && !truth || expression->operation() == token_kind::op_or && truth) {
						return;
					};

					return @this.walk(expression->item(1), @state);
				};

				FlowState skipped;
				FlowState evaluated;

				@skipped.copy_from(state);
				@evaluated.copy_from(state);

				if (!(@this.walk(expression->item(1), @evaluated)).has<void>()) {
					return compilation_error();
				};

				return @this.merge(@state, @skipped, @evaluated, $expression);
			};

			break;
		case semantic_kind::conditional:
			return @this.conditional($expression, @state);
		case semantic_kind::switch_expression:
			return @this.selection(expression, @state);
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop($expression, @state);
		case semantic_kind::sequence:
			return @this.sequence(@*expression, @state);
		case semantic_kind::name: {
			var Entity* entity = expression->entity();

			if (!entity || (entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter)) {
				return;
			};

			var LiveBinding* binding = @state.find($entity);
			var owner = this.storage_owner(*expression, @state);

			if (owner.has_value()) {
				@binding = @state.find(owner.get());
			};

			if (!binding) {
				return @this.binding_error(expression, "object construction does not reach this use", *expression->entity());
			};

			if (binding->lifetime == object_lifetime::destroyed) {
				return @this.binding_error(expression, "object has been destroyed", *binding->entity);
			};

			if (binding->lifetime != object_lifetime::live) {
				if (binding->lifetime == object_lifetime::relocated) {
					return @this.binding_error(expression, "object has been relocated", *binding->entity);
				};
				if (binding->lifetime == object_lifetime::discarded) {
					return @this.binding_error(expression, "object has been discarded", *binding->entity);
				};
				return @this.binding_error(expression, "object lifetime differs across reachable control-flow paths", *binding->entity);
			};

			return;
		};
		case semantic_kind::variable: {
			if (!(@this.walk(expression->item(0), @state)).has<void>()) {
				return compilation_error();
			};

			var owner = this.storage_owner(*expression->item(0), @state);

			@state.declare(expression->entity());

			if (expression->entity()->type()->kind() == type_kind::reference && owner.has_value()) {
				var LiveBinding* binding = @state.find(expression->entity());
				@binding->referent.bind(@*owner.get());
			};

			return;
		};
		case semantic_kind::relocation: {
			var SemanticExpression* source = expression->item(0);

			if (!(@this.walk(source, @state)).has<void>()) {
				return compilation_error();
			};

			var Entity* owner = source->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::relocated;
				};
			};

			return;
		};
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);

			if (!(@this.walk(object, @state)).has<void>()) {
				return compilation_error();
			};

			var Entity* owner = object->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::destroyed;
				};
			};

			return;
		};
		case semantic_kind::construction: {
			if (expression->size() < 2) {
				if (!(@this.walk(expression->item(0), @state)).has<void>()) {
					return compilation_error();
				};
				return @this.exceptional_edge(expression, @state);
			};

			var SemanticExpression* destination = expression->item(1);

			if (!(@this.storage(destination, @state)).has<void>() || !(@this.walk(expression->item(0), @state)).has<void>()) {
				return compilation_error();
			};

			if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
				return compilation_error();
			};
			var Entity* owner = destination->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::live;
				};
			};

			return;
		};
		case semantic_kind::return_value:
			if (!(@this.walk(expression->item(0), @state)).has<void>()) {
				return compilation_error();
			};

			@state.leave(flow_exit::return_function);

			return;
		case semantic_kind::break_loop:
			if (!this.active_loop) {
				return @this.error(expression, "break requires an enclosing loop or switch");
			};
			if (!(@this.save(@this.active_loop->breaks, @state, usize(this.active_loop->break_boundary), expression)).has<void>()) {
				return compilation_error();
			};

			@state.leave(flow_exit::break_loop);

			return;
		case semantic_kind::continue_loop: {
			var LoopFlow* loop = this.active_loop;

			while (loop && loop->region == flow_region::selection) {
				@loop = loop->parent;
			};

			if (!loop) {
				return @this.error(expression, "continue requires an enclosing loop");
			};
			if (!(@this.save(@loop->continues, @state, usize(loop->continue_boundary), expression)).has<void>()) {
				return compilation_error();
			};

			@state.leave(flow_exit::continue_loop);

			return;
		};
		default:
			break;
	};

	usize boundary = state.size();
	usize index = 0;
	while (index < expression->size()) {
		if (!(@this.walk(expression->item(index), @state)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	if (expression->kind() == semantic_kind::call || expression->kind() == semantic_kind::allocation || expression->kind() == semantic_kind::deallocation || expression->kind() == semantic_kind::array_deallocation) {
		if (!(@this.exceptional_edge(expression, @state)).has<void>()) {
			return compilation_error();
		};
	};
	if (expression->kind() == semantic_kind::brace) {
		@state.truncate(boundary);
	};

};

fn LifetimeAnalyzer::validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	return @this.validate_graph(unit);
};

fn LifetimeAnalyzer::validate_legacy(var LifetimeAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;

		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};

		FlowState state;
		usize parameter = 0;

		while (parameter < function->parameters().size()) {
			@state.declare(function->parameters().data()[parameter]);

			@parameter = parameter + 1;
		};

		if (!(@this.walk(function->body(), @state)).has<void>()) {
			return compilation_error();
		};

		function_completion completion = function_completion::reaches_end;

		if (state.exited()) {
			@completion = function_completion::no_fallthrough;
		};

		@function->set_completion($completion);
	};

};

fn FlowState::size(FlowState& this) -> usize {
	return this.bindings.size();
};

fn FlowState::at(var FlowState& this, usize index) -> var LiveBinding* {
	return (@this.bindings).data() + index;
};

fn FlowState::find(var FlowState& this, var Entity* entity) -> var LiveBinding* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return (@this.bindings).data() + index;
		};
	};

	return nullptr;
};

fn FlowState::declare(var FlowState& this, var Entity* entity) {
	LiveBinding binding;
	@binding.entity = $entity;
	@binding.lifetime = object_lifetime::live;

	@this.bindings.push_back($binding);
};

fn FlowState::copy_from(var FlowState& this, FlowState& other) {
	@this.bindings.clear();
	@this.exit = flow_exit(other.exit);
	usize index = 0;
	while (index < other.bindings.size()) {
		LiveBinding binding := other.bindings.data()[index];

		@this.bindings.push_back($binding);

		@index = index + 1;
	};

};

fn FlowState::truncate(var FlowState& this, usize size) {
	while (this.bindings.size() > size) {
		@this.bindings.pop_back();
	};
};

fn FlowState::exited(FlowState& this) -> bool {
	return this.exit != flow_exit::none;
};

fn FlowState::leave(var FlowState& this, flow_exit exit) {
	@this.exit = $exit;
};

fn FlowState::resume(var FlowState& this) {
	@this.exit = flow_exit::none;
};

fn LoopScope::LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop) {
	@this.current = &@current;
	@this.previous := current;
	@current = &@loop;
};

fn LoopScope::~LoopScope(var LoopScope& this) {
	@*this.current := this.previous;
};

fn LifetimeAnalyzer::LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn Analyzer::collect_member_pack(var Analyzer& this, var Scope& scope, var Syntax& declaration) -> CompilationResult {
	var Entity* owner = scope.owner();
	if (!owner || owner->kind() != entity_kind::record) {
		@this.error(&@declaration, "member pack declaration requires record scope");
		return compilation_error();
	};
	var Syntax* name = declaration.variable_name();
	if (name->kind() != syntax_kind::name || scope.local(name->token().text())) {
		@this.error(name, "member pack requires a distinct unqualified name");
		return compilation_error();
	};
	if (declaration.variable_initializer()->kind() != syntax_kind::absent) {
		@this.error(&@declaration, "member pack declaration cannot have an initializer");
		return compilation_error();
	};
	var Entity* members = @this.unit->create_entity(entity_kind::field_pack, name->token(), &@declaration, &@scope);
	if (!members) {
		return compilation_error();
	};
	@members->set_access(scope.access());
	@owner->add_field(members);
};

fn Analyzer::resolve_member_pack(var Analyzer& this, var Entity& members) -> CompilationResult {
	var Scope* scope = members.scope();
	var Entity* owner = scope->owner();
	var Syntax* declaration = members.declaration();
	var Syntax* name = declaration->variable_name();
	var TemplatePack* elements = @this.templates.pack(@this, @*scope, @*declaration->variable_type()->item(0));
	if (!elements) {
		return compilation_error();
	};
	@members.set_pack(elements);
	usize index = 0;
	while (index < elements->elements.size()) {
		TemplateArgument& argument = elements->elements.data()[index];
		if (argument.kind != template_argument_kind::type || !argument.type) {
			@this.error(declaration, "member pack requires type arguments");
			return compilation_error();
		};
		Type* type = argument.type;
		if ((type->kind() == type_kind::null_type || type->kind() == type_kind::void_type && owner->scope() && owner->scope()->owner() && variant_instance(*owner->scope()->owner())) && owner->layout() == record_layout::overlapping) {
			// Storage-free alternatives retain their pack position and discriminant.
			@members.add_field(nullptr);
			@index = index + 1;
			continue;
		};
		if (type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function) {
			@this.error(declaration, "member pack element requires object storage or a reference");
			return compilation_error();
		};
		Type* storage_type = type;
		while (storage_type->kind() == type_kind::array) {
			@storage_type = storage_type->element();
		};
		if (storage_type->kind() == type_kind::named && storage_type->entity()->kind() == entity_kind::record && ((storage_type->entity()->state() == entity_state::resolving && storage_type->entity()->record_phase() == record_resolution_phase::fields) || storage_type->entity()->declaration()->record_members()->kind() == syntax_kind::noop || !storage_type->has_layout())) {
			@this.error(declaration, "member pack element requires a complete nonrecursive storage type");
			return compilation_error();
		};
		var field_name = DiagnosticMessage();
		@field_name.text(members.name());
		@field_name.text("[");
		@field_name.number(u64(index));
		@field_name.text("]");
		var Entity* field = @this.unit->create_entity(entity_kind::field, name->token(), declaration, scope);
		if (field) {
			@field->set_name(field_name.view());
		}
		else {
			return compilation_error();
		};
		@field->set_origin(declaration_origin::compiler_supplied);
		@field->set_access(members.access());
		@field->set_type(type);
		if (argument.type_use.has_value()) {
			@field->set_type_use(argument.type_use.value());
		};
		@field->set_integer(u64(index));
		@field->set_state(entity_state::ready);
		@field->set_body_state(entity_state::ready);
		@members.add_field(field);
		@index = index + 1;
	};
	@members.set_state(entity_state::ready);
	@members.set_body_state(entity_state::ready);
};

fn Analyzer::expand_member_packs(var Analyzer& this, var Entity& record) -> CompilationResult {
	rt::buffer<var Entity*> fields;
	usize index = 0;
	while (index < record.fields().size()) {
		var Entity* member = record.fields().data()[index];
		@index = index + 1;
		if (member->kind() != entity_kind::field_pack) {
			@member->set_index(fields.size());
			@fields.push_back(member);
			continue;
		};
		if (!(@this.resolve(member)).has<void>()) {
			return compilation_error();
		};
		usize element = 0;
		while (element < member->fields().size()) {
			var Entity* field = member->fields().data()[element];
			@element = element + 1;
			if (!field) {
				continue;
			};
			@field->set_index(fields.size());
			@fields.push_back(field);
		};
	};
	@record.set_fields($fields);
};

fn diagnostic_unary_operand(var Diagnostics& diagnostics, var Syntax& syntax, rt::string_view reason, SemanticExpression& operand) {
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text("; operator ");
	@message.quoted(syntax.token().text());
	@message.text(" received ");
	if (operand.category() == value_category::place) {
		@message.text("a place of type '");
	}
	else {
		@message.text("a consumable of type '");
	};
	diagnostic_type(@message, *operand.type());
	@message.text("'");
	@diagnostics.error(syntax.token(), message.view());
};

fn diagnostic_binary_operands(var Diagnostics& diagnostics, var Syntax& syntax, rt::string_view reason, Type& first, Type& second) {
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text("; operator ");
	@message.quoted(syntax.token().text());
	@message.text(" received operand types '");
	diagnostic_type(@message, first);
	@message.text("' and '");
	diagnostic_type(@message, second);
	@message.text("'");
	@diagnostics.error(syntax.token(), message.view());
};

fn numeric_literal_expression(Syntax& syntax) -> bool {
	rt::buffer<Syntax*> pending;
	@pending.push_back(&syntax);
	while (pending.size()) {
		Syntax* current = pending.data()[pending.size() - 1];
		@pending.pop_back();
		if (current->kind() == syntax_kind::number) {
			continue;
		};
		if (current->kind() == syntax_kind::grouping) {
			@pending.push_back(current->operand());
			continue;
		};
		if (current->kind() == syntax_kind::unary && (current->token().kind == token_kind::op_plus || current->token().kind == token_kind::op_minus)) {
			@pending.push_back(current->operand());
			continue;
		};
		if (current->kind() == syntax_kind::binary && current->token().kind != token_kind::op_assign && current->token().kind != token_kind::op_copy) {
			@pending.push_back(current->right());
			@pending.push_back(current->left());
			continue;
		};
		return false;
	};
	return true;
};

fn Analyzer::unary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.kind == token_kind::op_access && syntax.operand()->kind() == syntax_kind::call) {
		return @this.call(@scope, @*syntax.operand(), expected, true);
	};

	rt::optional_ref<const Type> operand_type;

	if ((operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus || operation.kind == token_kind::op_tilde) && expected.has_value() && expected.value().kind().is_numeric()) {
		@operand_type.bind(expected.value());
	};

	var operand = @this.expression(@scope, @*syntax.operand(), operand_type);

	if (!operand.get()) {
		return rt::unique<SemanticExpression>();
	};
	if (operation.kind == token_kind::op_bang && variant_alternative(operand.get()->type(), this.types->find_primitive("bool"))) {
		@operand = @this.convert(rt::unique<SemanticExpression>(@operand.release()), rt::optional_ref<const Type>(*this.types->find_primitive("bool")), @syntax);
		if (!operand.get()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (operation.kind != token_kind::op_access && operation.kind != token_kind::op_relocate && operation.kind != token_kind::op_ampersand && operation.kind != token_kind::kw_sizeof) {
		Type* known = variant_flow_known(this.variant_facts, *operand.get());
		if (known) {
			@operand = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@operand.release()), known);
			if (!operand.get()) {
				return rt::unique<SemanticExpression>();
			};
		};
	};
	Type* type = operand.get()->type();

	if (operation.kind == token_kind::kw_sizeof) {
		return @this.convert(@this.size_query(@syntax, *type), expected, @syntax);
	};

	semantic_kind category = semantic_kind::unary;

	if (operation.kind == token_kind::op_access || operation.kind == token_kind::op_relocate || operation.kind == token_kind::op_ampersand) {
		if (operand.get()->category() != value_category::place) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "operator requires a place", *operand.get());

			return rt::unique<SemanticExpression>();
		};

		if (operation.kind == token_kind::op_access) {
			@category = semantic_kind::access;
		}
		else if (operation.kind == token_kind::op_ampersand) {
			@category = semantic_kind::address;

			if (!operand.get()->mutable_access()) {
				@type = @this.types->qualified(*type, type_qualifier::immutable);

				if (!type) {
					return rt::unique<SemanticExpression>();
				};
			};

			@type = @this.types->pointer(type);
		}
		else {
			if (type->qualifier() == type_qualifier::immutable || !operand.get()->owned_binding() && !operand.get()->indirect_storage()) {
				if (type->qualifier() == type_qualifier::immutable) {
					diagnostic_unary_operand(@*this.diagnostics, @syntax, "cannot relocate a const object", *operand.get());
				}
				else {
					diagnostic_unary_operand(@*this.diagnostics, @syntax, "cannot relocate a borrowed reference", *operand.get());
				};

				return rt::unique<SemanticExpression>();
			};

			@category = semantic_kind::relocation;
		};
	}
	else if (operation.kind == token_kind::op_star) {
		if (type->kind() != type_kind::pointer || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "dereference requires a pointer to an object", *operand.get());

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		@category = semantic_kind::dereference;
	}
	else if (operation.kind == token_kind::op_bang) {
		if (!type->kind().is_scalar()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "logical negation requires a scalar", *operand.get());

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive("bool");
	}
	else if (operation.kind == token_kind::op_tilde) {
		if (!type->kind().is_integer()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "bitwise complement requires an integer", *operand.get());

			return rt::unique<SemanticExpression>();
		};
	}
	else if (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus) {
		if (!type->kind().is_numeric()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "unary arithmetic requires a numeric value", *operand.get());

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		diagnostic_unary_operand(@*this.diagnostics, @syntax, "unary operator is not implemented", *operand.get());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind(category), type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	var Entity* binding = operand.get()->entity();

	if (category == semantic_kind::access || category == semantic_kind::dereference) {
		@result.get()->bind(binding, value_category::place);
	}
	else if (category == semantic_kind::relocation) {
		@result.get()->bind(binding, value_category::consumable);
	};

	if (!(@result.get()->append($operand)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::binary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();
	bool assignment = operation.kind == token_kind::op_assign || operation.kind == token_kind::op_copy || operation.kind == token_kind::op_plus_assign;
	bool logical = operation.kind == token_kind::op_and || operation.kind == token_kind::op_or;
	bool comparison = operation.kind == token_kind::op_equal || operation.kind == token_kind::op_not_equal || operation.kind == token_kind::op_less || operation.kind == token_kind::op_greater || operation.kind == token_kind::op_less_equal || operation.kind == token_kind::op_greater_equal;
	rt::optional_ref<const Type> left_context;
	rt::unique<SemanticExpression> right;

	if (!assignment && !logical && numeric_literal_expression(*syntax.left())) {
		if (!numeric_literal_expression(*syntax.right())) {
			@right = @this.expression(@scope, @*syntax.right(), rt::optional_ref<const Type>());

			if (!right.get()) {
				return rt::unique<SemanticExpression>();
			};

			@left_context.bind(*right.get()->type());
		}
		else if (expected.has_value() && expected.value().kind().is_numeric()) {
			@left_context.bind(expected.value());

			if (expected.value().kind() == type_kind::boolean) {
				@left_context.bind(*this.types->find_primitive("f64"));
			};
		};
	};

	var left = @this.expression(@scope, @*syntax.left(), left_context);

	if (!left.get()) {
		return rt::unique<SemanticExpression>();
	};
	if (logical && variant_alternative(left.get()->type(), this.types->find_primitive("bool"))) {
		@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), rt::optional_ref<const Type>(*this.types->find_primitive("bool")), @*syntax.left());
		if (!left.get()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (!assignment) {
		Type* known = variant_flow_known(this.variant_facts, *left.get());
		if (known) {
			@left = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@left.release()), known);
			if (!left.get()) {
				return rt::unique<SemanticExpression>();
			};
		};
	};
	Type* type = left.get()->type();
	var right_context = rt::optional_ref<const Type>(*type);

	if (type->kind() == type_kind::named) {
		@right_context.reset();
	};

	if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		@right_context.reset();
	};

	if (comparison && type->kind() == type_kind::pointer) {
		@right_context.reset();
	};

	if (logical && type->representation()->kind().is_scalar()) {
		@right_context.bind(*this.types->find_primitive("bool"));
		@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), right_context, @*syntax.left());

		if (!left.get()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (assignment && (left.get()->category() != value_category::place || !left.get()->mutable_access())) {
		diagnostic_unary_operand(@*this.diagnostics, @syntax, "assignment requires explicit mutable access to a place", *left.get());

		return rt::unique<SemanticExpression>();
	};

	var logical_before = VariantFlowFacts(this.variant_facts);
	if (!right.get()) {
		@right = @this.expression(@scope, @*syntax.right(), right_context);
	};
	if (logical) {
		// The right operand may be skipped at runtime.
		@this.variant_facts.intersect(logical_before);
	};

	if (!right.get()) {
		return rt::unique<SemanticExpression>();
	};

	return @this.binary_values(@scope, @syntax, $left, $right, expected);
};

fn Analyzer::binary_values(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> left, rt::unique<SemanticExpression> right, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();
	if (operation.kind == token_kind::op_and || operation.kind == token_kind::op_or) {
		Type* boolean = this.types->find_primitive("bool");
		if (variant_alternative(left.get()->type(), boolean)) {
			@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), rt::optional_ref<const Type>(*boolean), @syntax);
		};
		if (variant_alternative(right.get()->type(), boolean)) {
			@right = @this.convert(rt::unique<SemanticExpression>(@right.release()), rt::optional_ref<const Type>(*boolean), @syntax);
		};
		if (!left.get() || !right.get()) {
			return rt::unique<SemanticExpression>();
		};
	};
	bool assignment = operation.kind == token_kind::op_assign || operation.kind == token_kind::op_copy || operation.kind == token_kind::op_plus_assign;
	if (assignment) {
		Type* alternative = variant_flow_known(this.variant_facts, *right.get());
		var Entity* binding = variant_flow_binding(*left.get());
		@this.variant_facts.clear();
		if (binding && operation.kind != token_kind::op_plus_assign) {
			if (alternative) {
				@this.variant_facts.establish(@*binding, alternative);
			};
		};
	};
	if (!assignment) {
		Type* known_left = variant_flow_known(this.variant_facts, *left.get());
		Type* known_right = variant_flow_known(this.variant_facts, *right.get());
		if (known_left) {
			@left = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@left.release()), known_left);
		};
		if (known_right) {
			@right = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@right.release()), known_right);
		};
		if (!left.get() || !right.get()) {
			return rt::unique<SemanticExpression>();
		};
	};
	bool logical = operation.kind == token_kind::op_and || operation.kind == token_kind::op_or;
	bool comparison = operation.kind == token_kind::op_equal || operation.kind == token_kind::op_not_equal || operation.kind == token_kind::op_less || operation.kind == token_kind::op_greater || operation.kind == token_kind::op_less_equal || operation.kind == token_kind::op_greater_equal;
	Type* type = left.get()->type();
	if (assignment && (left.get()->category() != value_category::place || !left.get()->mutable_access())) {
		diagnostic_unary_operand(@*this.diagnostics, @syntax, "assignment requires explicit mutable access to a place", *left.get());
		return rt::unique<SemanticExpression>();
	};
	if (logical && type->representation()->kind().is_scalar()) {
		var context = rt::optional_ref<const Type>(*this.types->find_primitive("bool"));
		@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), context, @syntax);
		@right = @this.convert(rt::unique<SemanticExpression>(@right.release()), context, @syntax);
		if (!left.get() || !right.get()) {
			return rt::unique<SemanticExpression>();
		};
		@type = left.get()->type();
	};
	Type* other = right.get()->type();

	if (comparison && (type->kind() == type_kind::pointer || other->kind() == type_kind::pointer)) {
		if (type->kind() != type_kind::pointer || other->kind() != type_kind::pointer) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "pointer comparison requires compatible pointer types", *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if (this.compatible(other, type)) {
			@right = @this.convert(rt::unique<SemanticExpression>(@right.release()), rt::optional_ref<const Type>(*type), @syntax);
		}
		else if (this.compatible(type, other)) {
			@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), rt::optional_ref<const Type>(*other), @syntax);
			@type = other;
		}
		else {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "pointer comparison requires compatible pointer types", *type, *other);

			return rt::unique<SemanticExpression>();
		};
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record || other->kind() == type_kind::named && other->entity()->kind() == entity_kind::record) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;

		@arguments.push_back($left);

		@arguments.push_back($right);

		return @this.overloaded(@scope, @syntax, $arguments, expected);
	};

	if (operation.kind == token_kind::op_plus_assign) {
		diagnostic_binary_operands(@*this.diagnostics, @syntax, "operator += requires an applicable overload", *type, *other);
		return rt::unique<SemanticExpression>();
	};

	if (assignment) {
		if (type->kind() == type_kind::array) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "aggregate assignment function selection is not implemented", *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::named && !type->same_shape(*other)) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "enumeration assignment requires the same enumeration type", *type, *other);

			return rt::unique<SemanticExpression>();
		};
	}
	else if (logical || comparison) {
		if (!type->representation()->kind().is_scalar() || !other->representation()->kind().is_scalar()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "built-in comparison requires scalar operands", *type, *other);

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive("bool");
	}
	else if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		if (!other->kind().is_integer() || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "pointer offset requires an integer and object element type", *type, *other);

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		if (!type->kind().is_numeric() || !other->kind().is_numeric() || type->kind() != other->kind() || type->bits() != other->bits()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "arithmetic requires matching numeric types", *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if ((operation.kind == token_kind::op_remainder || operation.kind == token_kind::op_ampersand || operation.kind == token_kind::op_pipe || operation.kind == token_kind::op_caret || operation.kind == token_kind::op_shift_left || operation.kind == token_kind::op_shift_right) && !type->kind().is_integer()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "bitwise arithmetic requires integers", *type, *other);

			return rt::unique<SemanticExpression>();
		};
	};

	var result = @this.node(semantic_kind::binary, type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($left)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($right)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (assignment) {
		@result.get()->set_category(value_category::place);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.is("dynamic_cast")) {
		@this.error(&@syntax, "dynamic_cast is not implemented");

		return rt::unique<SemanticExpression>();
	};

	Type* target = @this.type(@scope, @*syntax.cast_type());
	var value = @this.expression(@scope, @*syntax.cast_operand(), rt::optional_ref<const Type>());

	if (!target || !value.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* source = value.get()->type();
	if (operation.kind == token_kind::punct_left_paren && aggregate_access_kind(source) == 2) {
		return @this.variant_cast(@scope, @syntax, target, $value, expected, false);
	};
	if (operation.kind == token_kind::punct_left_paren) {
		@this.error(&@syntax, "parenthesized access casts require a variant operand");
		return rt::unique<SemanticExpression>();
	};
	Type* destination = target;

	if (destination->kind() == type_kind::reference) {
		if (value.get()->category() != value_category::place) {
			var message = DiagnosticMessage();
			@message.text("reference cast ");
			@message.quoted(operation.text());
			@message.text(" to '");
			diagnostic_type(@message, *target);
			@message.text("' requires a place; received a consumable of type '");
			diagnostic_type(@message, *source);
			@message.text("'");
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		@destination = destination->element();
	};

	bool allowed = false;

	if (operation.is("const_cast")) {
		if (target->kind() == type_kind::pointer && source->kind() == type_kind::pointer) {
			Type* a = target->element();
			Type* b = source->element();
			@allowed = a->same_shape(*b);
		}
		else if (target->kind() == type_kind::reference) {
			@allowed = source->same_shape(*destination);
		};
	}
	else if (operation.is("reinterpret_cast")) {
		@allowed = source->kind() == type_kind::pointer && target->kind() == type_kind::pointer || source->kind() == type_kind::pointer && target->kind().is_integer() && target->bits() == this.pointer_bits || source->kind().is_integer() && source->bits() == this.pointer_bits && target->kind() == type_kind::pointer;
	}
	else {
		var Entity* conversion = @this.conversion_function(*value.get(), *destination, conversion_mode::explicit_only);

		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		if (conversion) {
			if (conversion->definition() == function_definition::deleted) {
				@this.deleted_function(syntax.token(), *conversion);
				return rt::unique<SemanticExpression>();
			};
			if (!this.accessible_at(*conversion, @scope, syntax.token())) {
				var message = DiagnosticMessage();
				@message.text("selected conversion '");
				diagnostic_entity(@message, *conversion);
				@message.text("' of type '");
				diagnostic_type(@message, *conversion->type());
				@message.text("' is not accessible from this scope");
				@this.report(syntax.token(), message.view());
				@this.note(conversion->token(), "conversion is declared here");

				return rt::unique<SemanticExpression>();
			};

			rt::buffer<rt::unique<SemanticExpression>> arguments;

			@arguments.push_back(rt::unique<SemanticExpression>(@value.release()));

			var callable = @this.node(semantic_kind::name, conversion->type(), &@syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind((var Entity*(conversion)), value_category::place);

			return @this.invoke(@syntax, conversion, $callable, $arguments, expected);
		};

		Type* from = source->representation();
		Type* to = destination->representation();
		@allowed = from->kind().is_numeric() && to->kind().is_numeric() || source->kind() != type_kind::named && this.compatible(source, destination);

		if (target->kind() == type_kind::reference && (source->same_shape(*destination) || source->derived_from(*destination) || destination->derived_from(*source))) {
			@allowed = source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && destination->element()->derived_from(*source->element())) {
			@allowed = true;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && (source->element()->kind() == type_kind::void_type || destination->element()->kind() == type_kind::void_type)) {
			@allowed = source->element()->kind() != type_kind::function && destination->element()->kind() != type_kind::function;
		};
	};

	if (!operation.is("const_cast") && source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && source->element()->qualifier() == type_qualifier::immutable && destination->element()->qualifier() == type_qualifier::mutable) {
		@allowed = false;
	};

	if (!allowed) {
		var message = DiagnosticMessage();
		@message.text("cast ");
		@message.quoted(operation.text());
		@message.text(" does not permit conversion from '");
		diagnostic_type(@message, *source);
		@message.text("' to '");
		diagnostic_type(@message, *target);
		@message.text("'");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::cast, destination, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($value)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (target->kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(destination->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::component(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var object = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!object.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* known = variant_flow_known(this.variant_facts, *object.get());
	if (known) {
		@object = variant_flow_extract(@this, @syntax, rt::unique<SemanticExpression>(@object.release()), known);
		if (!object.get()) {
			return rt::unique<SemanticExpression>();
		};
	};
	Type* type = object.get()->type();

	if (syntax.kind() == syntax_kind::index) {
		if (type->kind() != type_kind::pointer && type->kind() != type_kind::array) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "indexing requires an array or pointer", *object.get());

			return rt::unique<SemanticExpression>();
		};

		Type* element = type->element();
		if (type->kind() == type_kind::array && type->qualifier() == type_qualifier::immutable) {
			@element = @this.types->qualified(*element, type_qualifier::immutable);
		};
		var index = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());

		if (!index.get()) {
			return rt::unique<SemanticExpression>();
		};
		if (!index.get()->type()->kind().is_integer()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, "index requires an integer", *type, *index.get()->type());

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::index, element, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($object)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@result.get()->append($index)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->set_category(value_category::place);

		return @this.convert($result, expected, @syntax);
	};

	if (syntax.token().kind == token_kind::op_arrow) {
		if (type->kind() != type_kind::pointer) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, "arrow member access requires a pointer", *object.get());

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		var dereference = @this.node(semantic_kind::dereference, type, &@syntax);

		if (!dereference.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!(@dereference.get()->append(rt::unique<SemanticExpression>(@object.release()))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};

		@dereference.get()->set_category(value_category::place);
		@object = $dereference;
	};

	return @this.member_value(@scope, @syntax, $object, expected);
};

fn Analyzer::member_value(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> object, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Type* type = object.get()->type();

	if (type->kind() != type_kind::named || !type->entity()->members()) {
		var message = DiagnosticMessage();
		@message.text("member access for ");
		@message.quoted(syntax.member_name()->token().text());
		@message.text(" requires a class or enum object; received '");
		diagnostic_type(@message, *type);
		@message.text("'");
		@this.report(syntax.member_name()->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	@this.unit->record_receiver(@scope, @syntax, @*type->entity());

	if (this.editor && syntax.member_name()->kind() == syntax_kind::absent) {
		return @this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax);
	};

	var Entity* field = type->entity()->find_member(syntax.member_name()->token().text());
	if (field && field->kind() == entity_kind::field_pack && field == this.folded_field_pack && this.folded_field_index < field->fields().size()) {
		if (!field->fields().data()[this.folded_field_index]) {
			return @this.null_member_pack(@scope, @syntax, field, $object, expected);
		};
		@field = field->fields().data()[this.folded_field_index];
	};

	if (!field || field->kind() != entity_kind::field) {
		var message = DiagnosticMessage();
		if (!field) {
			@message.text("unknown data member ");
			@message.quoted(syntax.member_name()->token().text());
			@message.text(" in type '");
			diagnostic_type(@message, *type);
			@message.text("'");
		}
		else {
			@message.text("member '");
			diagnostic_entity(@message, *field);
			@message.text("' does not denote a data member");
		};
		@this.report(syntax.member_name()->token(), message.view());
		if (field) {
			@this.note(field->token(), "member is declared here");
		};

		return rt::unique<SemanticExpression>();
	};

	if (!(@this.resolve((var Entity*(field)))).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	if (!this.accessible_at(*field, @scope, syntax.token())) {
		var message = DiagnosticMessage();
		@message.text("data member '");
		diagnostic_entity(@message, *field);
		@message.text("' of type '");
		diagnostic_type(@message, *field->type());
		@message.text("' is not accessible from this scope");
		@this.report(syntax.member_name()->token(), message.view());
		@this.note(field->token(), "data member is declared here");

		return rt::unique<SemanticExpression>();
	};

	Type* field_type = field->type();

	if (field_type->kind() == type_kind::reference) {
		@field_type = field_type->element();
	}
	else if (type->qualifier() == type_qualifier::immutable) {
		@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
	};

	var result = @this.node(semantic_kind::member, field_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($object)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	@this.unit->record_name(@this, @scope, @syntax, @*field, 4);
	@result.get()->bind(field, value_category::place);

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::template_engine(var Analyzer& this) -> var TemplateEngine* {
	return &@this.templates;
};

fn Analyzer::null_member_pack(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity* pack, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!receiver.get()) {
		var Entity* object = scope.lookup("this");
		if (!object || object->type()->kind() != type_kind::reference || object->type()->element()->kind() != type_kind::named || object->type()->element()->entity() != pack->scope()->owner()) {
			@this.error(&@syntax, "member pack access requires its instance receiver");
			return rt::unique<SemanticExpression>();
		};
		@receiver = @this.node(semantic_kind::name, object->type()->element(), &@syntax);
		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};
		@receiver.get()->bind(object, value_category::place);
	};
	Type* marker = pack->pack()->elements.data()[this.folded_field_index].type;
	Type* null_type = @this.types->pointer(@this.types->qualified(*marker, type_qualifier::immutable));
	var result = @this.node(semantic_kind::sequence, null_type, &@syntax);
	if (!result.get() || !(@result.get()->append($receiver)).has<void>() || !(@result.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@result.get()->append(@this.node(semantic_kind::null_pointer, null_type, &@syntax))).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	return @this.convert($result, expected, @syntax);
};

fn Analyzer::pack_declaration(var Analyzer& this, var Scope& scope, var Syntax& syntax, var TemplatePack var*& pack) -> CompilationResult {
	var Syntax* signature = @this.templates.signature(@this, @scope, @*syntax.variable_type());
	var Syntax* initializer = syntax.variable_initializer();
	if (!signature || initializer->kind() != syntax_kind::unary || initializer->token().kind != token_kind::op_assign) {
		@this.error(&@syntax, "a compile-time pack binding requires a signature and '= <arguments>' initializer");
		return compilation_error();
	};
	@pack = @this.templates.pack(@this, @scope, @*initializer->operand());
	if (pack && (@this.templates.validate_pack(@this, @scope, @*signature, @*pack)).has<void>()) {
		return;
	};
	return compilation_error();
};

fn Analyzer::fold_binding(var Analyzer& this, var Scope& scope, var Syntax& syntax, var Entity var*& binding) -> CompilationResult {
	if (syntax.kind() == syntax_kind::pack_fold) {
		return;
	};
	if (syntax.kind() == syntax_kind::member) {
		var receiver = @this.expression(@scope, @*syntax.member_object(), rt::optional_ref<const Type>());
		if (!receiver.get()) {
			return compilation_error();
		};
		Type* owner = receiver.get()->type();
		if (syntax.token().kind == token_kind::op_arrow && owner->kind() == type_kind::pointer) {
			@owner = owner->element();
		};
		if (owner->kind() == type_kind::named) {
			var Entity* member = owner->entity()->find_member(syntax.member_name()->token().text());
			if (member && member->kind() == entity_kind::field_pack) {
				if (!this.accessible_at(*member, @scope, syntax.token())) {
					@this.error(&@syntax, "member pack is not accessible from this scope");
					@this.note(member->token(), "member pack is declared here");
					return compilation_error();
				};
				if (binding && binding != member) {
					@this.error(&@syntax, "a fold pattern must reference one pack");
					return compilation_error();
				};
				@binding = member;
				return;
			};
		};
	};
	if (syntax.kind() == syntax_kind::name || syntax.kind() == syntax_kind::qualified_name) {
		var Entity* entity = @this.lookup(@scope, @syntax);
		if (entity && (entity->kind() == entity_kind::pack_binding || entity->kind() == entity_kind::field_pack)) {
			if (entity->kind() == entity_kind::field_pack && !this.accessible_at(*entity, @scope, syntax.token())) {
				@this.error(&@syntax, "member pack is not accessible from this scope");
				@this.note(entity->token(), "member pack is declared here");
				return compilation_error();
			};
			if (binding && binding != entity) {
				@this.error(&@syntax, "a fold pattern must reference one pack");
				return compilation_error();
			};
			if (!(@this.resolve(entity)).has<void>()) {
				return compilation_error();
			};
			@binding = entity;
			return;
		};
	};
	usize child = 0;
	while (child < syntax.size()) {
		if (!(@this.fold_binding(@scope, @*syntax.item(child), @binding)).has<void>()) {
			return compilation_error();
		};
		@child = child + 1;
	};
};

fn Analyzer::pack_fold(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var Entity* binding = nullptr;
	var Syntax* pattern = syntax.pack_operand();
	while (pattern->kind() == syntax_kind::grouping) {
		@pattern = pattern->operand();
	};
	var TemplatePack* pack = nullptr;
	if (pattern->kind() == syntax_kind::pack_literal) {
		@pack = @this.templates.pack(@this, @scope, @*pattern);
	}
	else if ((@this.fold_binding(@scope, @*pattern, @binding)).has<void>() && binding) {
		@pack = binding->pack();
	};
	if (!pack) {
		@this.error(&@syntax, "fold expression requires a pack in its pattern");
		return rt::unique<SemanticExpression>();
	};
	token_kind operation = syntax.token().kind;
	if (!pack->elements.size()) {
		if (operation == token_kind::punct_comma) {
			return @this.convert(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax), expected, @syntax);
		};
		if (operation != token_kind::op_and && operation != token_kind::op_or) {
			@this.error(&@syntax, "empty pack has no identity for this fold operator");
			return rt::unique<SemanticExpression>();
		};
		var identity = @this.node(semantic_kind::literal_integer, this.types->find_primitive("bool"), &@syntax);
		if (identity.get()) {
			@identity.get()->set_integer(static_cast<u64>(operation == token_kind::op_and));
		};
		return @this.convert($identity, expected, @syntax);
	};
	rt::buffer<rt::unique<SemanticExpression>> values;
	usize index = 0;
	while (index < pack->elements.size()) {
		if (binding && binding->kind() == entity_kind::field_pack) {
			var Entity* previous = this.folded_field_pack;
			usize previous_index = this.folded_field_index;
			@this.folded_field_pack = binding;
			@this.folded_field_index = index;
			var value = @this.expression(@scope, @*pattern, rt::optional_ref<const Type>());
			@this.folded_field_pack = previous;
			@this.folded_field_index = previous_index;
			if (value.get()) {
				@values.push_back($value);
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			@index = index + 1;
			continue;
		};
		if (!binding) {
			var value = @this.templates.pack_value(@this, pack->elements.data()[index], @syntax);
			if (value.get()) {
				@values.push_back($value);
			}
			else {
				return rt::unique<SemanticExpression>();
			};
			@index = index + 1;
			continue;
		};
		var Scope* iteration = @this.unit->create_scope(&@scope, nullptr);
		if (!iteration) {
			return rt::unique<SemanticExpression>();
		};
		TemplateArgument& argument = pack->elements.data()[index];
		entity_kind kind = entity_kind::constant;
		if (argument.kind == template_argument_kind::type) {
			@kind = entity_kind::type_parameter;
		};
		var Entity* element = @this.unit->create_entity($kind, binding->token(), &@syntax, iteration);
		if (element) {
			@element->set_name(binding->name());
		}
		else {
			return rt::unique<SemanticExpression>();
		};
		@element->set_type(argument.type);
		if (argument.type_use.has_value()) {
			@element->set_type_use(argument.type_use.value());
		};
		if (argument.kind == template_argument_kind::value) {
			var value = @this.templates.pack_value(@this, argument, @syntax);
			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};
			@element->set_body($value);
		};
		@element->set_state(entity_state::ready);
		var Entity* previous_pack = this.folded_pack;
		var Entity* previous_argument = this.folded_argument;
		@this.folded_pack = binding;
		@this.folded_argument = element;
		var value = @this.expression(@*iteration, @*pattern, rt::optional_ref<const Type>());
		@this.folded_pack = $previous_pack;
		@this.folded_argument = $previous_argument;
		if (value.get()) {
			@values.push_back($value);
		}
		else {
			return rt::unique<SemanticExpression>();
		};
		@index = index + 1;
	};
	if (operation == token_kind::punct_comma) {
		@index = values.size() - 1;
		var result = rt::unique<SemanticExpression>(@(@values).data()[index].release());
		while (index) {
			@index = index - 1;
			var sequence = @this.node(semantic_kind::sequence, result.get()->type(), &@syntax);
			if (!sequence.get()) {
				return rt::unique<SemanticExpression>();
			};
			@sequence.get()->set_category(result.get()->category());
			@sequence.get()->set_mutable_access(result.get()->mutable_access());
			if (!(@sequence.get()->append(rt::unique<SemanticExpression>(@(@values).data()[index].release()))).has<void>() || !(@sequence.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@sequence.get()->append(rt::unique<SemanticExpression>(@result.release()))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@result = $sequence;
		};
		return @this.convert($result, expected, @syntax);
	};
	@index = values.size() - 1;
	var result = rt::unique<SemanticExpression>(@(@values).data()[index].release());
	while (index) {
		@index = index - 1;
		var left = rt::unique<SemanticExpression>(@(@values).data()[index].release());
		@result = @this.binary_values(@scope, @syntax, $left, rt::unique<SemanticExpression>(@result.release()), rt::optional_ref<const Type>());
		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};
	};
	return @this.convert($result, expected, @syntax);
};

struct FunctionAnalysisScope {
	fn FunctionAnalysisScope(var FunctionAnalysisScope& this, var Entity var*& function, var usize& loop_depth, var SwitchAnalysis var*& selection, rt::optional_ref<Entity>& current);
	fn ~FunctionAnalysisScope(var FunctionAnalysisScope& this);

private:
	var Entity var** function_slot;
	var usize* loop_slot;
	var SwitchAnalysis var** switch_slot;
	var Entity* previous_function;
	usize previous_loop;
	var SwitchAnalysis* previous_switch;
};

fn Analyzer::constant_integer(var Analyzer& this, SemanticExpression& expression, var u64& result) -> bool {
	ConstantEvaluator evaluator;

	return @evaluator.integer(@this, expression, @result);
};

fn Analyzer::prepare_lifetime(var Analyzer& this, Type* type) -> CompilationResult {
	if (type->kind() == type_kind::array) {
		return @this.prepare_lifetime(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};

	var Entity* owner = type->entity();

	if (!(@this.resolve((var Entity*(owner)))).has<void>()) {
		return compilation_error();
	};

	if (owner->virtual_functions().size()) {
		@owner->require_dispatch();
		usize slot = 0;

		while (slot < owner->virtual_functions().size()) {
			if (!(@this.function_body(owner->virtual_functions().data()[slot])).has<void>()) {
				return compilation_error();
			};

			@slot = slot + 1;
		};
	};

	var Entity* destructor = owner->destructor();

	if (destructor && !(@this.function_body((var Entity*(destructor)))).has<void>()) {
		return compilation_error();
	};

	if (owner->layout() == record_layout::overlapping) {
		return;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!(@this.prepare_lifetime(owner->bases().data()[index])).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!(@this.prepare_lifetime(owner->fields().data()[index]->type())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn Analyzer::prepare_default(var Analyzer& this, Type* type) -> CompilationResult {
	if (!(@this.prepare_lifetime(type)).has<void>()) {
		return compilation_error();
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_default(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};

	var Entity* owner = type->entity();
	var Entity* constructor = nullptr;
	var Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		@constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (!constructor) {
			if (!this.failed()) {
				var message = DiagnosticMessage();
				@message.text("default initialization of '");
				diagnostic_type(@message, *type);
				@message.text("' has no applicable constructor for an empty argument list");
				@this.report(owner->token(), message.view());
				diagnostic_candidates(@*this.diagnostics, *group);
			};
			return compilation_error();
		};
		if (constructor->definition() == function_definition::deleted) {
			@this.deleted_function(owner->token(), *constructor);
			return compilation_error();
		};
	};

	if (constructor) {
		return @this.function_body(constructor);
	};

	if (owner->layout() == record_layout::overlapping) {
		return;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!(@this.prepare_default(owner->bases().data()[index])).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		var Entity* field = owner->fields().data()[index];

		if (!(@this.field_initializer((var Entity*(field)))).has<void>()) {
			return compilation_error();
		};

		if (field->body()) {
			if (!(@this.prepare_expression(field->body())).has<void>()) {
				return compilation_error();
			};
		}
		else if (!(@this.prepare_default(field->type())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn Analyzer::prepare_function_exception(var Analyzer& this, var Entity& entity) -> CompilationResult {
	if (entity.kind() != entity_kind::function || entity.exception_contract() != exception_specification::inferred || entity.exception_state() != entity_state::declared || entity.definition() == function_definition::deleted) {
		return;
	};
	if (entity.role() != function_role::destructor && entity.definition() != function_definition::defaulted) {
		return;
	};
	var Entity* owner = entity.scope()->owner();
	if (owner && owner->kind() == entity_kind::record && owner->state() != entity_state::ready) {
		return;
	};
	@entity.set_exception_state(entity_state::resolving);
	if (entity.definition() == function_definition::defaulted && !(@this.function_body(&@entity)).has<void>()) {
		return compilation_error();
	};
	rt::buffer<Type*> parameters;
	usize index = 0;
	while (index < entity.type()->signature().parameters().size()) {
		@parameters.push_back(entity.type()->signature().parameters().data()[index]);
		@index = index + 1;
	};
	Type* type = @this.types->function(entity.type()->signature().result(), $parameters, entity.type()->signature().arity(), entity.nonthrowing());
	if (!type) {
		return compilation_error();
	};
	@entity.set_type(type);
	@entity.set_exception_state(entity_state::ready);
};

fn exception_copyable(Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return exception_copyable(type->element());
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* record = type->entity();
	var Entity* copy = record->copy_constructor();
	if (copy && copy->definition() == function_definition::deleted) {
		return false;
	};
	if (copy && copy->definition() != function_definition::defaulted) {
		return true;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!exception_copyable(record->bases().data()[index])) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (!exception_copyable(record->fields().data()[index]->type())) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Analyzer::prepare_exception_type(var Analyzer& this, Type* type) -> CompilationResult {
	if (!(@this.prepare_lifetime(type)).has<void>()) {
		return compilation_error();
	};
	if (exception_copyable(type) && !(@this.prepare_copy(type)).has<void>()) {
		return compilation_error();
	};
	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		usize index = 0;
		while (index < type->entity()->bases().size()) {
			if (!(@this.prepare_exception_type(type->entity()->bases().data()[index])).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
	};
};

fn Analyzer::prepare_expression(var Analyzer& this, var SemanticExpression* expression) -> CompilationResult {
	if (!expression) {
		return;
	};

	var Entity* selected = expression->entity();

	if (selected && selected->kind() == entity_kind::function && !(@this.function_body((var Entity*(selected)))).has<void>()) {
		if (this.failed() && (selected->instantiated() || selected->scope() && this.unit->reference_context(@*selected->scope()))) {
			var message = DiagnosticMessage();
			@message.text("while instantiating function '");
			diagnostic_entity(@message, *selected);
			@message.text("' requested here");
			@this.note(expression->token(), message.view());
		};
		return compilation_error();
	};
	if (selected && selected->kind() == entity_kind::function && !(@this.prepare_function_exception(@*selected)).has<void>()) {
		return compilation_error();
	};

	if ((expression->kind() == semantic_kind::variable || expression->kind() == semantic_kind::name || expression->kind() == semantic_kind::exception_handler) && selected && !(@this.prepare_lifetime(selected->type())).has<void>()) {
		return compilation_error();
	};
	if (expression->kind() == semantic_kind::variable && selected && expression->size() && expression->item(0)->kind() == semantic_kind::noop && !(@this.prepare_default(selected->type())).has<void>()) {
		return compilation_error();
	};
	if (expression->kind() == semantic_kind::exception_handler && selected && selected->type()->kind() != type_kind::reference) {
		if (!exception_copyable(selected->type())) {
			@this.report(expression->token(), "catch by value requires a copyable exception type");
			return compilation_error();
		};
		if (!(@this.prepare_copy(selected->type())).has<void>()) {
			return compilation_error();
		};
	};
	if (expression->kind() == semantic_kind::exception_throw && !(@this.prepare_exception_type(expression->item(0)->type())).has<void>()) {
		return compilation_error();
	};

	if (expression->kind() == semantic_kind::allocation && !(@this.prepare_lifetime(expression->type())).has<void>()) {
		return compilation_error();
	};
	if (expression->kind() == semantic_kind::construction) {
		if (!(@this.prepare_lifetime(expression->type())).has<void>()) {
			return compilation_error();
		};

		if (!selected && expression->type()->kind() == type_kind::named && expression->type()->entity()->layout() != record_layout::overlapping) {
			rt::buffer<var Entity*>& fields = expression->type()->entity()->fields();
			usize field = expression->item(0)->size();

			while (field < fields.size()) {
				var Entity* member = fields.data()[field];

				if (!(@this.field_initializer((var Entity*(member)))).has<void>()) {
					return compilation_error();
				};

				if (!member->body() && !(@this.prepare_default(member->type())).has<void>()) {
					return compilation_error();
				};

				if (member->body() && !(@this.prepare_expression(member->body())).has<void>()) {
					return compilation_error();
				};

				@field = field + 1;
			};
		};
	};

	usize index = 0;
	while (index < expression->size()) {
		if (!(@this.prepare_expression(expression->item(index))).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn Analyzer::global_initializer(var Analyzer& this, var Entity& entity) -> CompilationResult {
	if (!(@this.resolve(&@entity)).has<void>()) {
		return compilation_error();
	};

	if (entity.body_state() == entity_state::ready) {
		return;
	};

	if (entity.body_state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text("global initializer for '");
		diagnostic_entity(@message, entity);
		@message.text("' of type '");
		diagnostic_type(@message, *entity.type());
		@message.text("' has a circular dependency");
		@this.report(entity.token(), message.view());
		return compilation_error();
	};

	var Syntax* initializer = entity.declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		if (!(@this.prepare_default(entity.type())).has<void>()) {
			return compilation_error();
		};
		@entity.set_body_state(entity_state::ready);
		return;
	};

	@entity.set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (!(entity.type()->kind() == type_kind::named && entity.type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity.type());
	};

	var value = @this.expression(@*entity.scope(), @*initializer, expected);

	if (!value.get()) {
		return compilation_error();
	};

	@value = @this.initialize(@*initializer, entity.type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return compilation_error();
	};

	@entity.set_body($value);
	@entity.set_body_state(entity_state::ready);

	return @this.prepare_expression(entity.body());
};

fn Analyzer::field_initializer(var Analyzer& this, var Entity* entity) -> CompilationResult {
	if (entity->body_state() == entity_state::ready) {
		return;
	};

	if (entity->body_state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text("member initializer for '");
		diagnostic_entity(@message, *entity);
		@message.text("' of type '");
		diagnostic_type(@message, *entity->type());
		@message.text("' has a circular dependency");
		@this.report(entity->token(), message.view());
		return compilation_error();
	};

	var Syntax* initializer = entity->declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		@entity->set_body_state(entity_state::ready);

		return;
	};

	if (entity->scope()->owner()->layout() == record_layout::overlapping) {
		var message = DiagnosticMessage();
		@message.text("default initializer for union member '");
		diagnostic_entity(@message, *entity);
		@message.text("' of type '");
		diagnostic_type(@message, *entity->type());
		@message.text("' is not implemented");
		@this.report(initializer->token(), message.view());
		@this.note(entity->token(), "union member is declared here");
		return compilation_error();
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (entity->type()->kind() != type_kind::reference && !(entity->type()->kind() == type_kind::named && entity->type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity->type());
	};

	var value = @this.expression(@*entity->scope(), @*initializer, expected);

	if (!value.get()) {
		return compilation_error();
	};

	if (entity->type()->kind() == type_kind::reference && value.get()->category() == value_category::consumable) {
		var message = DiagnosticMessage();
		@message.text("initializer for reference member '");
		diagnostic_entity(@message, *entity);
		@message.text("' of type '");
		diagnostic_type(@message, *entity->type());
		@message.text("' requires a live place; received a consumable of type '");
		diagnostic_type(@message, *value.get()->type());
		@message.text("'");
		@this.report(initializer->token(), message.view());
		@this.note(entity->token(), "reference member is declared here");
		return compilation_error();
	};

	@value = @this.initialize(@*initializer, entity->type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return compilation_error();
	};

	@entity->set_body($value);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::prepare_copy(var Analyzer& this, Type* type) -> CompilationResult {
	if (type->kind() == type_kind::array) {
		return @this.prepare_copy(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};

	var Entity* owner = type->entity();
	var Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		Type* source_type = @this.types->qualified(*type, type_qualifier::immutable);
		var source = @this.node(semantic_kind::name, source_type, owner->declaration());

		if (!source.get()) {
			return compilation_error();
		};

		@source.get()->set_category(value_category::place);

		@arguments.push_back($source);

		var Entity* constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (this.diagnostics->failed()) {
			return compilation_error();
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.deleted_function(owner->token(), *constructor);
			return compilation_error();
		};

		if (constructor) {
			return @this.function_body(constructor);
		};
	};

	if (owner->layout() == record_layout::overlapping) {
		return;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!(@this.prepare_copy(owner->bases().data()[index])).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!(@this.prepare_copy(owner->fields().data()[index]->type())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn Analyzer::prepare_copy_assignment(var Analyzer& this, Type* type) -> CompilationResult {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		var message = DiagnosticMessage();
		@message.text("generated assignment cannot replace component of type '");
		diagnostic_type(@message, *type);
		if (type->kind() == type_kind::reference) {
			@message.text("' because it is a reference");
		}
		else {
			@message.text("' because it is const-qualified");
		};
		Token location;
		if (this.function) {
			@location = this.function->token();
			@message.text(" in function '");
			diagnostic_entity(@message, *this.function);
			@message.text("'");
		};
		@this.report(location, message.view());

		return compilation_error();
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_copy_assignment(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};

	var Entity* owner = type->entity();
	rt::buffer<var Entity*> candidates;
	usize index = 0;

	while (index < owner->members()->bindings().size()) {
		var Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!(@this.resolve((var Entity*(candidate)))).has<void>()) {
			return compilation_error();
		};

		if (candidate->role() == function_role::assignment) {
			if (candidate->operator_kind() == token_kind::op_copy) {
				@candidates.push_back((var Entity*(candidate)));
			};
		};
	};

	Type* immutable = @this.types->qualified(*type, type_qualifier::immutable);
	var Scope* bindings = @this.unit->create_scope(owner->members(), nullptr);

	if (!bindings) {
		return compilation_error();
	};

	var Entity* destination_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);
	var Entity* source_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);

	if (!destination_binding || !source_binding) {
		return compilation_error();
	};

	@destination_binding->set_name("destination");
	@source_binding->set_name("source");

	@destination_binding->set_origin(declaration_origin::compiler_supplied);
	@source_binding->set_origin(declaration_origin::compiler_supplied);
	@destination_binding->set_type(@this.types->reference(type));
	@source_binding->set_type(@this.types->reference(immutable));
	@destination_binding->set_state(entity_state::ready);
	@source_binding->set_state(entity_state::ready);
	var destination = @this.node(semantic_kind::name, type, owner->declaration());
	var source = @this.node(semantic_kind::name, immutable, owner->declaration());

	if (!destination.get() || !source.get()) {
		return compilation_error();
	};

	@destination.get()->bind((var Entity*(destination_binding)), value_category::place);
	@destination.get()->set_mutable_access(true);
	@source.get()->bind((var Entity*(source_binding)), value_category::place);
	rt::buffer<rt::unique<SemanticExpression>> arguments;

	@arguments.push_back($destination);

	@arguments.push_back($source);

	var Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @*owner->declaration());

	if (!selected) {
		if (!this.failed()) {
			var message = DiagnosticMessage();
			@message.text("generated member assignment for '");
			diagnostic_type(@message, *type);
			@message.text("' has no applicable assignment function with arguments ");
			diagnostic_arguments(@message, arguments);
			@this.report(owner->token(), message.view());
			usize candidate_index = 0;
			while (candidate_index < candidates.size()) {
				diagnostic_candidate(@*this.diagnostics, *candidates.data()[candidate_index]);
				@candidate_index = candidate_index + 1;
			};
		};
		return compilation_error();
	};
	if (selected->definition() == function_definition::deleted) {
		@this.deleted_function(owner->token(), *selected);
		return compilation_error();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), owner->declaration());

	if (!callable.get()) {
		return compilation_error();
	};

	@callable.get()->bind((var Entity*(selected)), value_category::place);
	var operation = @this.invoke(@*owner->declaration(), selected, $callable, $arguments, rt::optional_ref<const Type>());

	if (!operation.get() || !(@this.prepare_expression(operation.get())).has<void>()) {
		return compilation_error();
	};

	if (!(@this.prepare_lifetime(selected->type()->signature().result())).has<void>()) {
		return compilation_error();
	};

	var plan = rt::unique<CopyAssignmentPlan>(new CopyAssignmentPlan(@*destination_binding, @*source_binding, $operation));

	if (!plan.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(CopyAssignmentPlan);
		throw $error;
	};

	@owner->set_copy_assignment($plan);

};

fn FunctionAnalysisScope::FunctionAnalysisScope(var FunctionAnalysisScope& this, var Entity var*& function, var usize& loop_depth, var SwitchAnalysis var*& selection, rt::optional_ref<Entity>& current) {
	@this.function_slot = &@function;
	@this.loop_slot = &@loop_depth;
	@this.switch_slot = &@selection;
	@this.previous_function := function;
	@this.previous_loop := loop_depth;
	@this.previous_switch := selection;
	@function = current.get();
	@loop_depth = 0;
	@selection = nullptr;
};

fn FunctionAnalysisScope::~FunctionAnalysisScope(var FunctionAnalysisScope& this) {
	@*this.function_slot := this.previous_function;
	@*this.loop_slot := this.previous_loop;
	@*this.switch_slot := this.previous_switch;
};

fn SemanticUnit::associated_owner(SemanticUnit& this, Type& type) -> var Entity* {
	usize index = 0;
	while (index < this.associated_scopes.size()) {
		AssociatedScope& association = this.associated_scopes.data()[index];

		if (association.type == &@type) {
			return association.owner;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn SemanticUnit::associate(var SemanticUnit& this, Type& type, var Entity& owner) {
	AssociatedScope association;
	@association.type = &@type;
	@association.owner = &@owner;

	@this.associated_scopes.push_back($association);
};

fn Analyzer::primitive_scope(var Analyzer& this, Type& type, Token& location) -> var Entity* {
	if (!type.kind().is_numeric() && type.kind() != type_kind::void_type && type.kind() != type_kind::null_type) {
		return nullptr;
	};

	Type* canonical = @this.types->primitive(type_kind(type.kind()), type.bits());
	if (!canonical) {
		return nullptr;
	};

	var Entity* found = this.unit->associated_owner(*canonical);

	if (found) {
		return found;
	};

	var Scope* declarations = @this.unit->create_scope(this.unit->root_scope(), nullptr);

	if (!declarations) {
		return nullptr;
	};

	var Entity* owner = @this.unit->create_entity(entity_kind::primitive_type, location, nullptr, declarations);

	if (!owner) {
		return nullptr;
	};

	@owner->set_type(canonical);
	@owner->set_origin(declaration_origin::compiler_supplied);
	@owner->set_state(entity_state::ready);
	var Scope* members = @this.unit->create_scope(declarations, (var Entity*(owner)));

	if (!members) {
		return nullptr;
	};

	@owner->set_members((var Scope*(members)));

	@this.unit->associate(*canonical, @*owner);
	if (!((@this.primitive_constants(@*owner)).has<void>())) {
		return nullptr;
	};

	return owner;
};

fn Analyzer::primitive_constants(var Analyzer& this, var Entity& owner) -> CompilationResult {
	Type* type = owner.type();

	if (!type->kind().is_numeric()) {
		return;
	};

	Type* value_type = @this.types->qualified(*type, type_qualifier::immutable);
	if (!value_type) {
		return compilation_error();
	};

	semantic_kind kind = semantic_kind::literal_integer;

	if (type->kind() == type_kind::floating_point) {
		@kind = semantic_kind::literal_real;
	};

	var value = SemanticExpression::make($kind, value_type, owner.token());

	if (!value.get()) {
		return compilation_error();
	};

	if (type->kind() == type_kind::floating_point) {
		f64 maximum = 0.0;

		if (type->bits() == 32) {
			u32 representation = 2139095039;
			f32 decoded := *reinterpret_cast<f32*>(&@representation);
		@maximum = static_cast<f64>($decoded);
		}
		else {
			u64 representation = 9218868437227405311;
			@maximum := *reinterpret_cast<f64*>(&@representation);
		};

		@value.get()->set_real($maximum);
	}
	else {
		u64 maximum = u64::max >> (64 - static_cast<u64>(type->bits()));

		if (type->kind() == type_kind::signed_integer || type->kind() == type_kind::character) {
			@maximum = maximum >> 1;
		};

		@value.get()->set_integer($maximum);
	};

	var Entity* constant = @this.unit->create_entity(entity_kind::constant, owner.token(), nullptr, owner.members());

	if (constant) {
		@constant->set_name("max");
	}
	else {
		return compilation_error();
	};

	@constant->set_origin(declaration_origin::compiler_supplied);
	@constant->set_type(value_type);
	@constant->set_body($value);
	@constant->set_state(entity_state::ready);
	@constant->set_body_state(entity_state::ready);

};

fn TypeStore::primitive_spelling(usize index) -> rt::string_view {
	switch (index) {
		case 0:
			return "void";
		case 1:
			return "null";
		case 2:
			return "bool";
		case 3:
			return "char";
		case 4:
			return "usize";
		case 5:
			return "ptrdiff";
		case 6:
			return "i8";
		case 7:
			return "i08";
		case 8:
			return "i16";
		case 9:
			return "i32";
		case 10:
			return "i64";
		case 11:
			return "u8";
		case 12:
			return "u08";
		case 13:
			return "u16";
		case 14:
			return "u32";
		case 15:
			return "u64";
		case 16:
			return "f32";
		case 17:
			return "f64";
		default:
			return rt::string_view();
	};
};
fn TypeStore::register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) {
	Type* type = @this.primitive($kind, $bits);

	if (!type) {
		compiler_panic("Primitive type construction produced no type.");
	};

	bool inserted = @names.insert($name, $type);
	if (!inserted) {
		compiler_panic("A primitive type name was registered twice.");
	};
};

fn TypeStore::initialize_primitives(var TypeStore& this, u32 pointer_bits) {
	rt::unordered_map<rt::string_view, Type*> names;

	@names.reserve(20);

	@this.register_primitive(@names, primitive_spelling(0), type_kind::void_type, 0);
	@this.register_primitive(@names, primitive_spelling(1), type_kind::null_type, 0);
	@this.register_primitive(@names, primitive_spelling(2), type_kind::boolean, 1);
	@this.register_primitive(@names, primitive_spelling(3), type_kind::character, 8);
	@this.register_primitive(@names, primitive_spelling(4), type_kind::unsigned_integer, pointer_bits);
	@this.register_primitive(@names, primitive_spelling(5), type_kind::signed_integer, pointer_bits);
	@this.register_primitive(@names, primitive_spelling(6), type_kind::signed_integer, 8);
	@this.register_primitive(@names, primitive_spelling(7), type_kind::signed_integer, 8);
	@this.register_primitive(@names, primitive_spelling(8), type_kind::signed_integer, 16);
	@this.register_primitive(@names, primitive_spelling(9), type_kind::signed_integer, 32);
	@this.register_primitive(@names, primitive_spelling(10), type_kind::signed_integer, 64);
	@this.register_primitive(@names, primitive_spelling(11), type_kind::unsigned_integer, 8);
	@this.register_primitive(@names, primitive_spelling(12), type_kind::unsigned_integer, 8);
	@this.register_primitive(@names, primitive_spelling(13), type_kind::unsigned_integer, 16);
	@this.register_primitive(@names, primitive_spelling(14), type_kind::unsigned_integer, 32);
	@this.register_primitive(@names, primitive_spelling(15), type_kind::unsigned_integer, 64);
	@this.register_primitive(@names, primitive_spelling(16), type_kind::floating_point, 32);
	@this.register_primitive(@names, primitive_spelling(17), type_kind::floating_point, 64);

	@this.primitive_names = $names;


};

fn TypeStore::find_primitive(TypeStore& this, rt::string_view name) -> Type* {
	var found = this.primitive_names.find(name);

	if (!found) {
		return nullptr;
	};

	return *found;
};

fn Type::integer_from_real(Type& this, f64 value, var u64& result) -> bool {
	Type* type = this.representation();

	if (type->kind() != type_kind::signed_integer && type->kind() != type_kind::unsigned_integer) {
		return false;
	};

	u32 bits = type->bits();

	if (!bits || bits > 64) {
		return false;
	};

	f64 limit = 1.0;
	u32 index = 0;
	u32 exponent = bits;

	if (type->kind() == type_kind::signed_integer) {
		@exponent = exponent - 1;
	};

	while (index < exponent) {
		@limit = limit * 2.0;
		@index = index + 1;
	};

	if (type->kind() == type_kind::signed_integer) {
		bool valid = value > -limit - 1.0 && value < limit;

		if (bits == 64) {
			@valid = value >= -limit && value < limit;
		};

		if (!valid) {
			return false;
		};

		i64 integer = static_cast<i64>(value);
		@result = type->normalize_integer(static_cast<u64>($integer));

		return true;
	};

	if (!(value > -1.0 && value < limit)) {
		return false;
	};

	if (value < 0.0) {
		@result = 0;

		return true;
	};

	@result = type->normalize_integer(static_cast<u64>(value));

	return true;
};

fn SemanticExpression::constant_real(SemanticExpression& this, var f64& result) -> bool {
	Type* type = this.type()->representation();

	if (type->kind().is_integer()) {
		u64 integer = 0;

		if (!this.constant_integer(@integer)) {
			return false;
		};

		if (type->kind() == type_kind::signed_integer) {
			@result = static_cast<f64>(type->signed_value(integer));

			return true;
		};

		@result = static_cast<f64>(integer);

		return true;
	};

	if (type->kind() != type_kind::floating_point) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_real) {
		@result = this.real();
	}
	else if (this.kind() == semantic_kind::cast) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::unary) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = -result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::binary) {
		f64 first = 0.0;
		f64 second = 0.0;

		if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
			return false;
		};

		switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
			if (!second) {
				return false;
			};

			@result = first / second;
			break;
		default:
			return false;
		};
	}
	else {
		return false;
	};

	if (type->bits() == 32) {
		f64 unrounded := result;
		f32 rounded = static_cast<f32>($unrounded);
		@result = static_cast<f64>($rounded);
	};

	return true;
};

fn SemanticExpression::real_comparison(SemanticExpression& this, var u64& result) -> bool {
	f64 first = 0.0;
	f64 second = 0.0;

	if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
		return false;
	};

	bool comparison = false;

	switch (this.operation()) {
	case token_kind::op_equal:
		@comparison = first == second;
		break;
	case token_kind::op_not_equal:
		@comparison = first != second;
		break;
	case token_kind::op_less:
		@comparison = first < second;
		break;
	case token_kind::op_less_equal:
		@comparison = first <= second;
		break;
	case token_kind::op_greater:
		@comparison = first > second;
		break;
	case token_kind::op_greater_equal:
		@comparison = first >= second;
		break;
	default:
		return false;
	};

	@result = static_cast<u64>($comparison);

	return true;
};

struct ReferenceContentRoot {
	ReferenceSlotPath holding;
	ReferenceLoanPlace referent;
	var Entity* field;
	type_qualifier permission;
};

fn reference_array_members(Type& type, usize depth) -> bool {
	if (depth > 16) {
		return true;
	};
	if (type.kind() == type_kind::array) {
		return reference_loan_members(type);
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return false;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		if (reference_array_members(*type.entity()->fields().data()[index]->type(), depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_slot_append(ReferenceSlotPath& prefix, ReferenceSlotPath& suffix, var ReferenceSlotPath& result) -> CompilationResult {
	reference_slot_copy(prefix, @result);
	usize index = 0;
	while (index < suffix.size) {
		if (result.size == 16) {
			@result.imprecise = true;
			return compilation_error();
		};
		ReferenceSlotStep& step = suffix.steps[index];
		@result.steps[result.size].field = step.field;
		@result.steps[result.size].index = step.index;
		@result.steps[result.size].kind = step.kind;
		@result.steps[result.size].value = step.value;
		@result.size = result.size + 1;
		@index = index + 1;
	};
};

fn reference_content_field(Type& type, usize depth) -> var Entity* {
	if (depth > 16) {
		return nullptr;
	};
	if (type.kind() == type_kind::array) {
		return reference_content_field(*type.element(), depth + 1);
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return nullptr;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		var Entity* field = type.entity()->fields().data()[index];
		if (field->type()->kind() == type_kind::reference) {
			return field;
		};
		var Entity* nested = reference_content_field(*field->type(), depth + 1);
		if (nested) {
			return nested;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn ReferenceLoanAnalyzer::content_sources(var ReferenceLoanAnalyzer& this, Type& type, SemanticExpression* source, var rt::buffer<ReferenceContentRoot>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, ReferenceSlotPath& holding, var Entity* symbolic, usize depth) -> CompilationResult {
	if (depth > 16) {
		return @this.error(*this.function_body, "reference holding projection exceeds the analysis depth limit");
	};
	while (source && (source->kind() == semantic_kind::access || source->kind() == semantic_kind::cast || source->kind() == semantic_kind::relocation) && source->size()) {
		@source = source->item(0);
	};
	if (source && source->kind() == semantic_kind::construction && source->size() && source->item(0)->size() == 1 && source->item(0)->item(0)->type()->same_shape(type)) {
		return @this.content_sources(type, source->item(0)->item(0), @output, @substitutions, context, holding, symbolic, depth + 1);
	};
	if (source && (source->kind() == semantic_kind::name || source->kind() == semantic_kind::member || source->kind() == semantic_kind::index) && (type.kind() == type_kind::array || type.kind() == type_kind::named)) {
		rt::buffer<ReferenceStoreBinding> bindings;
		var slot = this.store_slot(*source, bindings, context, 0);
		usize index = 0;
		bool found = false;
		while (index < this.loans.size()) {
			ReferenceLoan& loan = this.loans.data()[index];
			if (loan.binding == slot.root && loan.stored_field && reference_slot_overlap(loan.holding, slot.path) && @this.reaching_contents(loan, *source)) {
				ReferenceContentRoot root;
				ReferenceSlotPath relative;
				usize projection = slot.path.size;
				while (projection < loan.holding.size) {
					ReferenceSlotStep& step = loan.holding.steps[projection];
					if (relative.size == 16) {
						return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
					};
					@relative.steps[relative.size].kind = step.kind;
					@relative.steps[relative.size].field = step.field;
					@relative.steps[relative.size].index = step.index;
					@relative.steps[relative.size].value = step.value;
					@relative.size = relative.size + 1;
					@projection = projection + 1;
				};
				if (!relative.size && !reference_slot_field(@relative, loan.stored_field).has<void>()) {
					return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
				};
				if (!reference_slot_append(holding, relative, @root.holding).has<void>()) {
					return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
				};
				@root.field = loan.stored_field;
				@root.referent.root = loan.place.root;
				@root.referent.reference_contents = loan.place.reference_contents;
				@root.referent.field = loan.place.field;
				@root.referent.element = loan.place.element;
				@root.referent.through = loan.place.through;
				@root.permission = loan.permission;
				@output.push_back($root);
				@found = true;
			};
			@index = index + 1;
		};
		if (found) {
			return;
		};
		if (slot.root && slot.root->kind() == entity_kind::parameter) {
			@symbolic = slot.root;
			@source = nullptr;
		};
	};
	if (source && source->kind() == semantic_kind::name && (type.kind() == type_kind::array || type.kind() == type_kind::named)) {
		usize index = 0;
		bool found = false;
		while (index < this.loans.size()) {
			ReferenceLoan& loan = this.loans.data()[index];
			if (loan.binding == source->entity() && loan.stored_field && @this.reaching_contents(loan, *source)) {
				ReferenceContentRoot root;
				ReferenceSlotPath path;
				reference_slot_copy(loan.holding, @path);
				if (!path.size && !reference_slot_field(@path, loan.stored_field).has<void>()) {
					return compilation_error();
				};
				if (!reference_slot_append(holding, path, @root.holding).has<void>()) {
					return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
				};
				@root.field = loan.stored_field;
				@root.referent.root = loan.place.root;
				@root.referent.reference_contents = loan.place.reference_contents;
				@root.referent.field = loan.place.field;
				@root.referent.element = loan.place.element;
				@root.referent.through = loan.place.through;
				@root.permission = loan.permission;
				@output.push_back($root);
				@found = true;
			};
			@index = index + 1;
		};
		if (found) {
			return;
		};
		if (source->entity()->kind() == entity_kind::parameter) {
			@symbolic = source->entity();
			@source = nullptr;
		}
		else if (context && source->entity()->kind() == entity_kind::local) {
			var SemanticExpression* initial = this.initializer(*context->body(), *source->entity());
			if (initial) {
				return @this.content_sources(type, initial, @output, @substitutions, context, holding, symbolic, depth + 1);
			};
		};
	};
	if (source && source->kind() == semantic_kind::call && reference_loan_members(type)) {
		rt::buffer<ReferenceLoanPlace> targets;
		if (!(@this.places(*source, @targets, @substitutions, context, depth + 1)).has<void>()) {
			return compilation_error();
		};
		var Entity* field = reference_content_field(type, 0);
		if (!field) {
			return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
		};
		usize index = 0;
		while (index < targets.size()) {
			ReferenceContentRoot root;
			reference_slot_copy(holding, @root.holding);
			if (!reference_slot_field(@root.holding, nullptr).has<void>()) {
				return @this.error(*source, "reference holding projection exceeds the analysis depth limit");
			};
			@root.field = field;
			@root.permission = reference_loan_permission(type, 0);
			@root.referent.root = targets.data()[index].root;
			@root.referent.reference_contents = targets.data()[index].reference_contents;
			@root.referent.field = targets.data()[index].field;
			@root.referent.element = targets.data()[index].element;
			@root.referent.through = targets.data()[index].through;
			@output.push_back($root);
			@index = index + 1;
		};
		return;
	};
	if (type.kind() == type_kind::array) {
		if (!type.count() || !reference_loan_members(type)) {
			return;
		};
		ReferenceSlotPath element;
		reference_slot_copy(holding, @element);
		if (!reference_slot_index(@element, nullptr).has<void>()) {
			return @this.error(*this.function_body, "reference holding projection exceeds the analysis depth limit");
		};
		return @this.content_sources(*type.element(), nullptr, @output, @substitutions, context, element, symbolic, depth + 1);
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return;
	};
	var SemanticExpression* arguments = nullptr;
	bool custom = false;
	if (source && source->kind() == semantic_kind::construction && source->size()) {
		@arguments = source->item(0);
		@custom = source->entity() && source->entity()->canonical()->definition() != function_definition::defaulted;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		var Entity* field = type.entity()->fields().data()[index];
		var SemanticExpression* value = field->body();
		if (arguments && !custom && index < arguments->size()) {
			@value = arguments->item(index);
		};
		@index = index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		ReferenceSlotPath path;
		reference_slot_copy(holding, @path);
		if (!reference_slot_field(@path, field).has<void>()) {
			return @this.error(*this.function_body, "reference holding projection exceeds the analysis depth limit");
		};
		if (field->type()->kind() != type_kind::reference) {
			if (!(@this.content_sources(*field->type(), value, @output, @substitutions, context, path, symbolic, depth + 1)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		rt::buffer<ReferenceLoanPlace> targets;
		if (symbolic) {
			bool mapped = false;
			usize substitution = 0;
			while (substitution < substitutions.size()) {
				ReferenceLoanSubstitution& entry = substitutions.data()[substitution];
				if (entry.parameter == symbolic) {
					usize candidate = 0;
					while (candidate < entry.places.size()) {
						ReferenceLoanPlace target;
						@target.root = entry.places.data()[candidate].root;
						@target.reference_contents = entry.places.data()[candidate].reference_contents;
						@target.field = entry.places.data()[candidate].field;
						@target.element = entry.places.data()[candidate].element;
						@targets.push_back($target);
						@candidate = candidate + 1;
					};
					@mapped = true;
				};
				@substitution = substitution + 1;
			};
			if (!mapped) {
				ReferenceLoanPlace target;
				@target.root = symbolic;
				@target.reference_contents = symbolic->type()->kind() != type_kind::reference;
				@targets.push_back($target);
			};
		}
		else if (value && !(@this.places(*value, @targets, @substitutions, context, depth + 1)).has<void>()) {
			return compilation_error();
		};
		usize candidate = 0;
		while (candidate < targets.size()) {
			ReferenceContentRoot root;
			reference_slot_copy(path, @root.holding);
			@root.field = field;
			@root.permission = field->type()->element()->qualifier();
			@root.referent.root = targets.data()[candidate].root;
			@root.referent.reference_contents = targets.data()[candidate].reference_contents;
			@root.referent.field = targets.data()[candidate].field;
			@root.referent.element = targets.data()[candidate].element;
			@root.referent.through = targets.data()[candidate].through;
			@output.push_back($root);
			@candidate = candidate + 1;
		};
	};
};

fn ReferenceLoanAnalyzer::array_aggregate(var ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> CompilationResult {
	if (this.phase != reference_loan_phase::collect) {
		return;
	};
	rt::buffer<ReferenceContentRoot> roots;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	ReferenceSlotPath path;
	if (!(@this.content_sources(*expression.entity()->type(), expression.item(0), @roots, @substitutions, nullptr, path, nullptr, 0)).has<void>()) {
		return compilation_error();
	};
	usize index = 0;
	while (index < roots.size()) {
		ReferenceContentRoot& root = roots.data()[index];
		ReferenceLoan loan;
		@loan.binding = expression.entity();
		@loan.stored_field = root.field;
		@loan.creation = fact_no_node();
		reference_slot_copy(root.holding, @loan.holding);
		@loan.place.root = root.referent.root;
		@loan.place.reference_contents = root.referent.reference_contents;
		@loan.place.field = root.referent.field;
		@loan.place.element = root.referent.element;
		@loan.place.through = root.referent.through;
		@loan.permission = root.permission;
		@this.append_array_loan($loan);
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::stored_contents(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var bool& found) -> CompilationResult {
	rt::buffer<ReferenceStoreBinding> bindings;
	var slot = this.store_slot(@expression, bindings, nullptr, 0);
	if (!slot.root) {
		return;
	};
	usize index = 0;
	while (index < this.loans.size()) {
		ReferenceLoan& loan = this.loans.data()[index];
		@index = index + 1;
		if (loan.binding != slot.root || !loan.stored_field || !@this.reaching_contents(loan, expression)) {
			continue;
		};
		ReferenceSlotPath holding;
		reference_slot_copy(loan.holding, @holding);
		if (!holding.size && !reference_slot_field(@holding, loan.stored_field).has<void>()) {
			return compilation_error();
		};
		if (!reference_slot_overlap(holding, slot.path)) {
			continue;
		};
		ReferenceLoanPlace root;
		@root.root = loan.place.root;
		@root.reference_contents = loan.place.reference_contents;
		@root.field = loan.place.field;
		@root.element = loan.place.element;
		@root.through = loan.binding;
		@output.push_back($root);
		@found = true;
	};
};

fn ReferenceLoanAnalyzer::holding_use(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, var SemanticExpression& expression) -> bool {
	if (!loan.stored_field || !reference_array_members(*loan.binding->type(), 0)) {
		return expression.kind() == semantic_kind::name && expression.entity() == loan.binding;
	};
	if (expression.kind() != semantic_kind::name && expression.kind() != semantic_kind::member && expression.kind() != semantic_kind::index && expression.kind() != semantic_kind::access && expression.kind() != semantic_kind::relocation && expression.kind() != semantic_kind::cast && expression.kind() != semantic_kind::variant_cast && expression.kind() != semantic_kind::variant_payload) {
		return false;
	};
	// A projected base is an address computation, not a separate read of every
	// reference stored in its owner. The outer projection records the actual use.
	usize parent = 0;
	while (parent < this.expressions.size()) {
		SemanticExpression& candidate = *this.expressions.data()[parent];
		if (candidate.size() && candidate.item(0) == &expression && (candidate.kind() == semantic_kind::member || candidate.kind() == semantic_kind::index || candidate.kind() == semantic_kind::access || candidate.kind() == semantic_kind::relocation || candidate.kind() == semantic_kind::cast || candidate.kind() == semantic_kind::variant_cast || candidate.kind() == semantic_kind::variant_payload)) {
			return false;
		};
		@parent = parent + 1;
	};
	rt::buffer<ReferenceStoreBinding> bindings;
	var slot = this.store_slot(@expression, bindings, nullptr, 0);
	if (slot.root != loan.binding) {
		return false;
	};
	return reference_slot_overlap(loan.holding, slot.path);
};

fn ReferenceLoanAnalyzer::loan_definition(ReferenceLoanAnalyzer& this, ReferenceLoan& loan) -> usize {
	if (loan.creation != fact_no_node()) {
		return loan.creation;
	};
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::expression && node.expression && node.expression->kind() == semantic_kind::variable && node.expression->entity() == loan.binding) {
			return index;
		};
		@index = index + 1;
	};
	return fact_no_node();
};

fn ReferenceLoanAnalyzer::reaching_contents(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& use) -> bool {
	usize position = this.position(use);
	usize definition = this.loan_definition(loan);
	if (position == fact_no_node() || definition == fact_no_node()) {
		return true;
	};
	return @this.reachable(definition, position, fact_no_node(), loan.binding) && @this.loan_store_path(definition, position, loan, definition);
};

fn ReferenceLoanAnalyzer::append_array_loan(var ReferenceLoanAnalyzer& this, ReferenceLoan loan) {
	usize index = 0;
	while (index < this.loans.size()) {
		ReferenceLoan& existing = this.loans.data()[index];
		if (existing.binding == loan.binding && existing.stored_field == loan.stored_field && existing.creation == loan.creation && existing.permission == loan.permission && existing.place.root == loan.place.root && existing.place.field == loan.place.field && existing.place.element == loan.place.element && existing.place.reference_contents == loan.place.reference_contents && reference_slot_equal(existing.holding, loan.holding)) {
			return;
		};
		@index = index + 1;
	};
	@this.loans.push_back($loan);
};

fn ReferenceLoanAnalyzer::refresh_array_aliases(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize iteration = 0;
	while (iteration < 16) {
		usize previous = this.loans.size();
		usize index = 0;
		while (index < this.expressions.size()) {
			var SemanticExpression* expression = this.expressions.data()[index];
			@index = index + 1;
			if (expression->kind() != semantic_kind::variable || !expression->entity() || !expression->size()) {
				continue;
			};
			if (reference_array_members(*expression->entity()->type(), 0)) {
				@this.phase = reference_loan_phase::collect;
				bool collected = (@this.array_aggregate(*expression)).has<void>();
				@this.phase = reference_loan_phase::validate;
				if (!collected) {
					return compilation_error();
				};
				continue;
			};
			if (expression->entity()->type()->kind() != type_kind::reference || reference_loan_members(*expression->entity()->type()->element())) {
				continue;
			};
			rt::buffer<ReferenceStoreBinding> bindings;
			var slot = this.store_slot(*expression->item(0), bindings, nullptr, 0);
			if (!slot.root || !reference_array_members(*slot.root->type(), 0)) {
				continue;
			};
			rt::buffer<ReferenceLoanPlace> targets;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*expression->item(0), @targets, @substitutions, nullptr, 0)).has<void>()) {
				return compilation_error();
			};
			usize candidate = 0;
			while (candidate < targets.size()) {
				ReferenceLoan loan;
				@loan.binding = expression->entity();
				@loan.creation = fact_no_node();
				@loan.permission = expression->entity()->type()->element()->qualifier();
				@loan.place.root = targets.data()[candidate].root;
				@loan.place.reference_contents = targets.data()[candidate].reference_contents;
				@loan.place.field = targets.data()[candidate].field;
				@loan.place.element = targets.data()[candidate].element;
				@loan.place.through = targets.data()[candidate].through;
				@this.append_array_loan($loan);
				@candidate = candidate + 1;
			};
		};
		if (!(@this.retain_stores(@*this.function_body)).has<void>()) {
			return compilation_error();
		};
		if (previous == this.loans.size()) {
			return;
		};
		@iteration = iteration + 1;
	};
	return @this.error(*this.function_body, "reference array alias analysis did not converge within the analysis limit");
};

// Capture summaries grow monotonically over the finite set of formal references.
// Recursion without a path to an opaque capture contributes no captures.
struct ReferenceCapture {
	bool contents;
	var Entity* function;
	var Entity* parameter;
};

fn reference_capture_initializer(SemanticExpression& expression, Entity& binding) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding && expression.size()) {
		return expression.item(0);
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* result = reference_capture_initializer(*expression.item(index), binding);
		if (result) {
			return result;
		};
		@index = index + 1;
	};
	return nullptr;
};

// Trace reference-producing syntax without recursively expanding callees. Alias
// cycles terminate on binding identity; call summaries themselves use a fixed point.
fn reference_capture_depends(SemanticExpression& expression, Entity& binding, ReferenceLoanAnalyzer& analyzer, Entity& function, var rt::buffer<var Entity*>& visited) -> bool {
	if (expression.kind() == semantic_kind::dereference) {
		return false;
	};
	if (expression.kind() == semantic_kind::name) {
		var Entity* name = expression.entity();
		if (name == &binding) {
			return true;
		};
		if (!name || name->kind() != entity_kind::local || !(name->type()->kind() == type_kind::reference || reference_loan_members(*name->type()))) {
			return false;
		};
		usize index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == name) {
				return false;
			};
			@index = index + 1;
		};
		@visited.push_back(name);
		var SemanticExpression* source = reference_capture_initializer(*function.body(), *name);
		return source && reference_capture_depends(*source, binding, analyzer, function, @visited);
	};
	if (expression.kind() == semantic_kind::member || expression.kind() == semantic_kind::index) {
		if (expression.size() && expression.item(0)->type()->kind() == type_kind::pointer) {
			return false;
		};
		return expression.size() && reference_capture_depends(*expression.item(0), binding, analyzer, function, @visited);
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_capture_depends(*expression.item(child), binding, analyzer, function, @visited)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_capture_aggregate(Type* type) -> bool {
	if (type->kind() == type_kind::reference) {
		@type = type->element();
	};
	return reference_loan_members(*type);
};

fn ReferenceLoanAnalyzer::captures(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument) -> bool {
	return this.capture_mode(call, argument, false) || this.capture_mode(call, argument, true);
};

fn ReferenceLoanAnalyzer::capture_mode(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool {
	if (this.capture_parent) {
		return this.capture_parent->capture_mode(call, argument, contents);
	};
	var Entity* callee = call.entity();
	if (callee) {
		@callee = callee->canonical();
	};
	// The generated testing helper invokes its callback synchronously. For a known
	// callback, propagate that function's capture effects rather than the opaque
	// callback parameter's conservative generic effects.
	if (callee && callee->token().source && callee->token().source->compiler_generated() && callee->token().is("register") && argument >= 2 && call.item(1)->size() > 1) {
		var Entity* callback = reference_dispatch_callable(*call.item(1)->item(1), this.function_body, 0);
		if (callback && callback->dispatch() == function_dispatch::ordinary && callback->body() && argument - 2 < callback->parameters().size()) {
			usize index = 0;
			while (index < this.captures_summary.size()) {
				ReferenceCapture& capture = this.captures_summary.data()[index];
				if (capture.function == callback && capture.parameter == callback->parameters().data()[argument - 2] && capture.contents == contents) {
					return true;
				};
				@index = index + 1;
			};
			return false;
		};
	};
	if (!callee || callee->dispatch() != function_dispatch::ordinary || !callee->body() && callee->definition() != function_definition::defaulted) {
		Type* signature = call.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function || argument >= signature->signature().parameters().size()) {
			return true;
		};
		Type* parameter = signature->signature().parameters().data()[argument];
		if (contents) {
			return reference_capture_aggregate(parameter);
		};
		return parameter->kind() == type_kind::reference;
	};
	if (callee->definition() == function_definition::defaulted) {
		return false;
	};

	if (argument >= callee->parameters().size()) {
		return true;
	};
	usize index = 0;
	while (index < this.captures_summary.size()) {
		ReferenceCapture& capture = this.captures_summary.data()[index];
		if (capture.function == callee && capture.parameter == callee->parameters().data()[argument] && capture.contents == contents) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::capture_walk(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var Entity& function) -> CompilationResult {
	var ReferenceLoanAnalyzer* summary = &@this;
	if (this.capture_parent) {
		@summary = this.capture_parent;
	};
	if (expression.kind() == semantic_kind::call && expression.size() >= 2 && (!this.capture_parent || @this.reachable(this.graph.entry, this.position(expression), fact_no_node(), nullptr))) {
		Type* signature = expression.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() == type_kind::function) {
			usize argument = 0;
			while (argument < expression.item(1)->size() && argument < signature->signature().parameters().size()) {
				Type* parameter = signature->signature().parameters().data()[argument];
				if ((parameter->kind() == type_kind::reference || reference_loan_members(*parameter)) && this.captures(expression, argument)) {
					usize mode = 0;
					while (mode < 2) {
						bool contents = mode == 1;
						@mode = mode + 1;
						if (!this.capture_mode(expression, argument, contents)) {
							continue;
						};
						rt::buffer<ReferenceLoanPlace> roots;
						rt::buffer<ReferenceLoanSubstitution> substitutions;
						if (!(@this.places(*expression.item(1)->item(argument), @roots, @substitutions, &@function, 0)).has<void>()) {
							return compilation_error();
						};
						usize formal = 0;
						while (formal < function.parameters().size()) {
							var Entity* binding = function.parameters().data()[formal];
							@formal = formal + 1;
							if (!(binding->type()->kind() == type_kind::reference || reference_loan_members(*binding->type()))) {
								continue;
							};
							rt::buffer<var Entity*> aliases;
							bool captured_contents = contents && reference_capture_aggregate(binding->type());
							bool captured = reference_capture_depends(*expression.item(1)->item(argument), *binding, this, function, @aliases);
							usize root = 0;
							while (root < roots.size()) {
								if (roots.data()[root].root == binding) {
									@captured = true;
									if (roots.data()[root].reference_contents && (contents || !reference_capture_aggregate(expression.item(1)->item(argument)->type()))) {
										@captured_contents = true;
									};
								};
								@root = root + 1;
							};
							if (!captured) {
								continue;
							};
							usize existing = 0;
							while (existing < summary->captures_summary.size()) {
								ReferenceCapture& previous = summary->captures_summary.data()[existing];
								if (previous.function == &function && previous.parameter == binding && previous.contents == captured_contents) {
									break;
								};
								@existing = existing + 1;
							};
							if (existing == summary->captures_summary.size()) {
								ReferenceCapture capture;
								@capture.function = &@function;
								@capture.parameter = binding;
								@capture.contents = captured_contents;
								@summary->captures_summary.push_back($capture);
							};
						};
					};
				};
				@argument = argument + 1;
			};
		};
	};
	usize child = 0;
	while (child < expression.size()) {
		if (!(@this.capture_walk(*expression.item(child), @function)).has<void>()) {
			return compilation_error();
		};
		@child = child + 1;
	};
};

struct ReferenceCaptureContext {
	var Entity* function;
	rt::unique<ReferenceLoanAnalyzer> analyzer;
	usize base_loans;
};

fn ReferenceLoanAnalyzer::prepare_captures(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	@this.capture_resolution = entity_state::resolving;
	@this.captures_summary.clear();
	rt::buffer<ReferenceCaptureContext> contexts;
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;
		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};
		ReferenceCaptureContext context;
		@context.function = function;
		@context.analyzer = rt::unique<ReferenceLoanAnalyzer>(new ReferenceLoanAnalyzer(@*this.diagnostics));
		if (!context.analyzer.get()) {
			throw rt::allocation_error();
		};
		var ReferenceLoanAnalyzer& state = @*context.analyzer.get();
		@state.capture_parent = &@this;
		@state.function_body = function->body();
		@state.return_type = function->type()->signature().result();
		@state.phase = reference_loan_phase::collect;
		usize store_function = 0;
		while (store_function < this.store_functions.size()) {
			@state.store_functions.push_back(this.store_functions.data()[store_function]);
			@store_function = store_function + 1;
		};
		@state.build_graph(*function);
		@state.collect(function->body());
		usize parameter = 0;
		while (parameter < function->parameters().size()) {
			var Entity* formal = function->parameters().data()[parameter];
			@parameter = parameter + 1;
			Type* contents_type = formal->type();
			if (contents_type->kind() == type_kind::reference) {
				@contents_type = contents_type->element();
			};
			if (function->role() == function_role::constructor && parameter == 1 || !reference_loan_members(*contents_type)) {
				continue;
			};
			rt::buffer<ReferenceContentRoot> roots;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			ReferenceSlotPath holding;
			if (!(@state.content_sources(*contents_type, nullptr, @roots, @substitutions, function, holding, formal, 0)).has<void>()) {
				return compilation_error();
			};
			usize root = 0;
			while (root < roots.size()) {
				ReferenceContentRoot& source = roots.data()[root];
				ReferenceLoan loan;
				@loan.binding = formal;
				@loan.stored_field = source.field;
				reference_slot_copy(source.holding, @loan.holding);
				@loan.creation = state.graph.entry;
				@loan.place.root = formal;
				@loan.place.reference_contents = true;
				@loan.permission = source.permission;
				@state.loans.push_back($loan);
				@root = root + 1;
			};
		};
		if (!(@state.walk(function->body(), reference_loan_access::read)).has<void>() || !(@state.retain_stores(@*function->body())).has<void>() || !(@state.refresh_array_aliases()).has<void>()) {
			return compilation_error();
		};
		@context.base_loans = state.loans.size();
		@contexts.push_back($context);
	};
	while (true) {
		usize previous = this.captures_summary.size();
		@index = 0;
		while (index < contexts.size()) {
			ReferenceCaptureContext& context = contexts.data()[index];
			var ReferenceLoanAnalyzer& state = @*context.analyzer.get();
			while (state.loans.size() > context.base_loans) {
				@state.loans.pop_back();
			};
			if (!(@state.capture_walk(*context.function->body(), @*context.function)).has<void>() || !(@state.retain_special_escapes()).has<void>()) {
				return compilation_error();
			};
			usize loan_index = context.base_loans;
			while (loan_index < state.loans.size()) {
				ReferenceLoan& loan = state.loans.data()[loan_index];
				@loan_index = loan_index + 1;
				if (!loan.escapes.size() || !loan.place.root || !@state.reachable(state.graph.entry, usize(loan.creation), fact_no_node(), nullptr)) {
					continue;
				};
				usize formal = 0;
				while (formal < context.function->parameters().size()) {
					var Entity* parameter = context.function->parameters().data()[formal];
					@formal = formal + 1;
					if (loan.place.root != parameter) {
						continue;
					};
					usize existing = 0;
					while (existing < this.captures_summary.size()) {
						ReferenceCapture& capture = this.captures_summary.data()[existing];
						if (capture.function == context.function && capture.parameter == parameter && capture.contents == loan.place.reference_contents) {
							break;
						};
						@existing = existing + 1;
					};
					if (existing == this.captures_summary.size()) {
						ReferenceCapture capture;
						@capture.function = context.function;
						@capture.parameter = parameter;
						@capture.contents = loan.place.reference_contents;
						@this.captures_summary.push_back($capture);
					};
				};
			};
			@index = index + 1;
		};
		if (previous == this.captures_summary.size()) {
			@this.capture_resolution = entity_state::ready;
			return;
		};
	};
};

// Contexts refine capture effects only; unknown targets retain the generic summary.
struct ReferenceDispatchBinding {
	var Entity* parameter;
	var Entity* root;
};

fn reference_dispatch_origin(SemanticExpression& expression, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body, usize depth) -> var Entity* {
	if (depth > 24) {
		return nullptr;
	};
	if ((expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast) && expression.size()) {
		if (expression.item(0)->type()->kind() == type_kind::pointer) {
			return nullptr;
		};
		return reference_dispatch_origin(*expression.item(0), bindings, body, depth + 1);
	};
	if (expression.kind() != semantic_kind::name || !expression.entity()) {
		return nullptr;
	};
	var Entity* entity = expression.entity();
	usize index = 0;
	while (index < bindings.size()) {
		if (bindings.data()[index].parameter == entity) {
			return bindings.data()[index].root;
		};
		@index = index + 1;
	};
	if (entity->kind() == entity_kind::local && entity->type()->kind() == type_kind::reference && body) {
		SemanticExpression* initial = reference_capture_initializer(*body, *entity);
		if (initial) {
			return reference_dispatch_origin(*initial, bindings, body, depth + 1);
		};
		return nullptr;
	};
	return entity;
};

fn reference_dispatch_mentions(SemanticExpression& expression, Entity& binding) -> bool {
	if (expression.kind() == semantic_kind::name && expression.entity() == &binding) {
		return true;
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_dispatch_mentions(*expression.item(child), binding)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_dispatch_changed(SemanticExpression& expression, Entity& binding) -> bool {
	if (expression.kind() == semantic_kind::variable && expression.entity() && expression.entity()->type()->kind() == type_kind::reference && reference_dispatch_mentions(expression, binding)) {
		return true;
	};
	if (expression.kind() == semantic_kind::call && expression.size() > 1) {
		usize argument = 0;
		while (argument < expression.item(1)->size()) {
			SemanticExpression& actual = *expression.item(1)->item(argument);
			if (reference_dispatch_mentions(actual, binding)) {
				return true;
			};
			@argument = argument + 1;
		};
	};
	if (expression.kind() == semantic_kind::binary && (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy) && expression.item(0)->owned_binding() == &binding) {
		return true;
	};
	if (expression.kind() == semantic_kind::address && expression.size() && expression.item(0)->owned_binding() == &binding) {
		return true;
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_dispatch_changed(*expression.item(child), binding)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_dispatch_callable(SemanticExpression& expression, SemanticExpression* body, usize depth) -> var Entity* {
	if (depth > 16) {
		return nullptr;
	};
	if ((expression.kind() == semantic_kind::address || expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast) && expression.size()) {
		return reference_dispatch_callable(*expression.item(0), body, depth + 1);
	};
	if (expression.kind() != semantic_kind::name || !expression.entity()) {
		return nullptr;
	};
	var Entity* entity = expression.entity();
	if (entity->kind() == entity_kind::function) {
		return entity->canonical();
	};
	if (entity->kind() != entity_kind::local || !body || reference_dispatch_changed(*body, *entity)) {
		return nullptr;
	};
	SemanticExpression* initial = reference_capture_initializer(*body, *entity);
	if (initial) {
		return reference_dispatch_callable(*initial, body, depth + 1);
	};
	return nullptr;
};

fn reference_dispatch_compatible(Entity& concrete, Entity& owner, usize depth) -> bool {
	if (&concrete == &owner) {
		return true;
	};
	if (depth > 16) {
		return false;
	};
	usize base = 0;
	while (base < concrete.bases().size()) {
		if (reference_dispatch_compatible(*concrete.bases().data()[base]->entity(), owner, depth + 1)) {
			return true;
		};
		@base = base + 1;
	};
	return false;
};

// Ordinary helper bodies may change a receiver's dynamic layout through a
// reference parameter. Cyclic or excessive expansion cannot establish stability.
fn reference_dispatch_layout_change(SemanticExpression& expression, usize depth) -> bool {
	if (depth > 24) {
		return true;
	};
	if (expression.kind() == semantic_kind::construction && !fact_default_record(&expression)) {
		return true;
	};
	if (expression.kind() == semantic_kind::call && expression.entity()) {
		Entity* callee = expression.entity()->canonical();
		if (callee->role() == function_role::assignment && callee->definition() == function_definition::defaulted && callee->parameters().size() == 2 && callee->parameters().data()[1]->type()->kind() != type_kind::reference) {
			return true;
		};
		if (callee->dispatch() == function_dispatch::ordinary && callee->body() && reference_dispatch_layout_change(*callee->body(), depth + 1)) {
			return true;
		};
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_dispatch_layout_change(*expression.item(child), depth + 1)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_dispatch_reconstruction(SemanticExpression& expression) -> bool {
	return reference_dispatch_layout_change(expression, 0);
};

fn reference_dispatch_body_captures(SemanticExpression& expression, Entity& target, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body, rt::buffer<var Entity*>& raw_functions, var rt::buffer<var Entity*>& stack, usize depth) -> bool;

fn reference_dispatch_call_captures(SemanticExpression& call, Entity& target, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body, rt::buffer<var Entity*>& raw_functions, var rt::buffer<var Entity*>& stack, usize depth) -> bool {
	if (depth > 24 || call.size() < 2) {
		return true;
	};
	var Entity* callee = call.entity();
	if (callee) {
		@callee = callee->canonical();
	}
	else {
		@callee = reference_dispatch_callable(*call.item(0), body, 0);
	};
	if (callee && callee->dispatch() != function_dispatch::ordinary) {
		var Entity* receiver = nullptr;
		if (call.item(1)->size()) {
			@receiver = reference_dispatch_origin(*call.item(1)->item(0), bindings, body, 0);
		};
		if (!receiver || receiver->kind() != entity_kind::local || receiver->type()->kind() != type_kind::named || receiver->type()->entity()->kind() != entity_kind::record || !callee->scope() || !callee->scope()->owner() || !reference_dispatch_compatible(*receiver->type()->entity(), *callee->scope()->owner(), 0) || callee->virtual_slot() >= receiver->type()->entity()->virtual_functions().size()) {
			@callee = nullptr;
		}
		else {
			@callee = receiver->type()->entity()->virtual_functions().data()[callee->virtual_slot()]->canonical();
		};
	};
	if (!callee || !callee->body() && callee->definition() != function_definition::defaulted) {
		usize argument = 0;
		while (argument < call.item(1)->size()) {
			var Entity* root = reference_dispatch_origin(*call.item(1)->item(argument), bindings, body, 0);
			if (!root || root == &target) {
				return true;
			};
			@argument = argument + 1;
		};
		return false;
	};
	if (callee->definition() == function_definition::defaulted) {
		return callee->role() == function_role::constructor || callee->role() == function_role::destructor || callee->role() == function_role::assignment;
	};
	usize parameter = 0;
	while (parameter < callee->parameters().size()) {
		Type* type = callee->parameters().data()[parameter]->type();
		if (type->kind() != type_kind::reference && (type->kind() == type_kind::array || type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record)) {
			return true;
		};
		@parameter = parameter + 1;
	};
	if (reference_raw_effects(*callee->body(), raw_functions) || reference_dispatch_reconstruction(*callee->body())) {
		return true;
	};
	usize existing = 0;
	while (existing < stack.size()) {
		if (stack.data()[existing] == callee) {
			return true;
		};
		@existing = existing + 1;
	};
	rt::buffer<ReferenceDispatchBinding> nested;
	usize argument = 0;
	while (argument < callee->parameters().size() && argument < call.item(1)->size()) {
		ReferenceDispatchBinding binding;
		@binding.parameter = callee->parameters().data()[argument];
		@binding.root = reference_dispatch_origin(*call.item(1)->item(argument), bindings, body, 0);
		@nested.push_back($binding);
		@argument = argument + 1;
	};
	@stack.push_back(callee);
	bool result = reference_dispatch_body_captures(*callee->body(), target, nested, callee->body(), raw_functions, @stack, depth + 1);
	@stack.pop_back();
	return result;
};

fn reference_dispatch_body_captures(SemanticExpression& expression, Entity& target, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body, rt::buffer<var Entity*>& raw_functions, var rt::buffer<var Entity*>& stack, usize depth) -> bool {
	// This refinement does not summarize generated initialization or cleanup.
	// Preserve the generic capture result whenever those operations occur.
	if (expression.kind() == semantic_kind::construction || expression.kind() == semantic_kind::destruction) {
		return true;
	};
	if (expression.kind() == semantic_kind::variable && expression.entity()) {
		Type* type = expression.entity()->type();
		if (type->kind() == type_kind::array || type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			return true;
		};
	};
	if (expression.kind() == semantic_kind::call && reference_dispatch_call_captures(expression, target, bindings, body, raw_functions, @stack, depth)) {
		return true;
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_dispatch_body_captures(*expression.item(child), target, bindings, body, raw_functions, @stack, depth)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn reference_dispatch_target_use(SemanticExpression& expression, Entity& target, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body) -> bool {
	rt::buffer<SemanticExpression*> pending;
	@pending.push_back(&expression);
	usize budget = 1024;
	while (pending.size()) {
		if (!budget) {
			return true;
		};
		@budget = budget - 1;
		SemanticExpression* current = pending.data()[pending.size() - 1];
		@pending.pop_back();
		if (reference_dispatch_origin(*current, bindings, body, 0) == &target) {
			return true;
		};
		for (usize index = current->size(); index; @index = index - 1) {
			@pending.push_back(current->item(index - 1));
		};
	};
	return false;
};

fn reference_dispatch_selected(SemanticExpression& call, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body) -> var Entity* {
	var Entity* callee = call.entity();
	if (!callee) {
		return reference_dispatch_callable(*call.item(0), body, 0);
	};
	@callee = callee->canonical();
	if (callee->dispatch() == function_dispatch::ordinary) {
		return callee;
	};
	if (call.size() < 2 || !call.item(1)->size()) {
		return nullptr;
	};
	var Entity* receiver = reference_dispatch_origin(*call.item(1)->item(0), bindings, body, 0);
	if (!receiver || receiver->kind() != entity_kind::local || receiver->type()->kind() != type_kind::named || receiver->type()->entity()->kind() != entity_kind::record || !callee->scope() || !callee->scope()->owner() || !reference_dispatch_compatible(*receiver->type()->entity(), *callee->scope()->owner(), 0) || callee->virtual_slot() >= receiver->type()->entity()->virtual_functions().size()) {
		return nullptr;
	};
	return receiver->type()->entity()->virtual_functions().data()[callee->virtual_slot()]->canonical();
};

fn reference_dispatch_owner_change(SemanticExpression& expression, Entity& target, rt::buffer<ReferenceDispatchBinding>& bindings, SemanticExpression* body, usize depth) -> bool {
	if (depth > 24) {
		return true;
	};
	if (expression.kind() == semantic_kind::construction) {
		if (expression.size() > 1 && reference_dispatch_target_use(*expression.item(1), target, bindings, body)) {
			return true;
		};
		var Entity* constructor = expression.entity();
		for (usize index = 0; expression.size() && index < expression.item(0)->size(); @index = index + 1) {
			Type* parameter = nullptr;
			if (constructor && index + 1 < constructor->parameters().size()) {
				@parameter = constructor->parameters().data()[index + 1]->type();
			}
			else if (!constructor && expression.type()->kind() == type_kind::named && expression.type()->entity()->kind() == entity_kind::record && index < expression.type()->entity()->fields().size()) {
				@parameter = expression.type()->entity()->fields().data()[index]->type();
			};
			if ((!parameter || parameter->kind() == type_kind::reference || parameter->kind() == type_kind::pointer || reference_loan_members(*parameter)) && reference_dispatch_target_use(*expression.item(0)->item(index), target, bindings, body)) {
				return true;
			};
		};
	};
	if ((expression.kind() == semantic_kind::destruction || expression.kind() == semantic_kind::relocation) && expression.size() && reference_dispatch_target_use(*expression.item(0), target, bindings, body)) {
		return true;
	};
	if (expression.kind() == semantic_kind::call && expression.size() > 1 && reference_dispatch_target_use(*expression.item(1), target, bindings, body)) {
		var Entity* callee = reference_dispatch_selected(expression, bindings, body);
		if (!callee || !callee->body() && callee->definition() != function_definition::defaulted) {
			return true;
		};
		if (callee->role() == function_role::assignment && expression.item(1)->size() && reference_dispatch_origin(*expression.item(1)->item(0), bindings, body, 0) == &target) {
			return true;
		};
		if (callee->body()) {
			rt::buffer<ReferenceDispatchBinding> nested;
			for (usize index = 0; index < callee->parameters().size() && index < expression.item(1)->size(); @index = index + 1) {
				ReferenceDispatchBinding binding;
				@binding.parameter = callee->parameters().data()[index];
				@binding.root = reference_dispatch_origin(*expression.item(1)->item(index), bindings, body, 0);
				@nested.push_back($binding);
			};
			if (reference_dispatch_owner_change(*callee->body(), target, nested, callee->body(), depth + 1)) {
				return true;
			};
		};
	};
	for (usize index = 0; index < expression.size(); @index = index + 1) {
		if (reference_dispatch_owner_change(*expression.item(index), target, bindings, body, depth + 1)) {
			return true;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::contextual_capture(var ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool {
	var ReferenceLoanAnalyzer* summary = &@this;
	if (this.capture_parent) {
		@summary = this.capture_parent;
	};
	if (summary->capture_resolution != entity_state::ready) {
		return true;
	};
	if (!this.capture_mode(call, argument, contents)) {
		return false;
	};
	if (argument >= call.item(1)->size()) {
		return true;
	};
	rt::buffer<ReferenceDispatchBinding> bindings;
	var Entity* target = reference_dispatch_origin(*call.item(1)->item(argument), bindings, this.function_body, 0);
	if (!target || target->kind() != entity_kind::local) {
		return true;
	};
	// A raw memory effect can reach the owner after its address escapes.
	usize operation = this.position(call);
	rt::buffer<usize> exposures;
	usize index = 0;
	while (index < this.expressions.size()) {
		SemanticExpression& candidate = *this.expressions.data()[index];
		usize point = this.position(candidate);
		if (&candidate != &call && @this.reachable(this.graph.entry, point, fact_no_node(), nullptr) && @this.reachable(point, operation, fact_no_node(), nullptr)) {
			if (candidate.kind() == semantic_kind::address && reference_dispatch_target_use(candidate, *target, bindings, this.function_body)) {
				@exposures.push_back(point);
			};
			if (candidate.kind() == semantic_kind::call && candidate.size() > 1) {
				Type* signature = candidate.item(0)->type();
				if (signature->kind() == type_kind::pointer) {
					@signature = signature->element();
				};
				for (usize actual = 0; signature->kind() == type_kind::function && actual < candidate.item(1)->size() && actual < signature->signature().parameters().size(); @actual = actual + 1) {
					Type* parameter = signature->signature().parameters().data()[actual];
					if ((parameter->kind() == type_kind::reference || parameter->kind() == type_kind::pointer) && reference_dispatch_target_use(*candidate.item(1)->item(actual), *target, bindings, this.function_body) && (this.capture_mode(candidate, actual, false) || reference_raw_effects(candidate, this.raw_functions))) {
						@exposures.push_back(point);
					};
				};
			};
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.expressions.size()) {
		SemanticExpression& candidate = *this.expressions.data()[index];
		usize point = this.position(candidate);
		bool exposed = false;
		for (usize exposure = 0; exposure < exposures.size(); @exposure = exposure + 1) {
			if (@this.reachable(exposures.data()[exposure], point, fact_no_node(), nullptr)) {
				@exposed = true;
				break;
			};
		};
		if (&candidate != &call && (candidate.kind() == semantic_kind::call || candidate.kind() == semantic_kind::binary || candidate.kind() == semantic_kind::construction || candidate.kind() == semantic_kind::destruction || candidate.kind() == semantic_kind::relocation) && (exposed && reference_raw_effects(candidate, this.raw_functions) || reference_dispatch_owner_change(candidate, *target, bindings, this.function_body, 0)) && @this.reachable(this.graph.entry, point, fact_no_node(), nullptr) && @this.reachable(point, operation, fact_no_node(), nullptr)) {
			return true;
		};
		@index = index + 1;
	};
	var Entity* declared = call.entity();
	if (declared && declared->dispatch() != function_dispatch::ordinary) {
		var Entity* selected = reference_dispatch_selected(call, bindings, this.function_body);
		if (!selected || !selected->body() && selected->definition() != function_definition::defaulted || argument >= selected->parameters().size()) {
			return true;
		};
		for (usize capture = 0; capture < summary->captures_summary.size(); @capture = capture + 1) {
			ReferenceCapture& effect = summary->captures_summary.data()[capture];
			if (effect.function == selected && effect.parameter == selected->parameters().data()[argument] && effect.contents == contents) {
				return true;
			};
		};
		return false;
	};
	rt::buffer<var Entity*> stack;
	return reference_dispatch_call_captures(call, *target, bindings, this.function_body, this.raw_functions, @stack, 0);
};

// Lifetime state follows the same exceptional and cleanup edges as loan uses.
struct ReferenceLifetimeVisit {
	usize node;
	bool live;
};

fn ReferenceLoanAnalyzer::owner_live_at(var ReferenceLoanAnalyzer& this, var Entity* owner, usize target) -> bool {
	rt::buffer<ReferenceLifetimeVisit> pending;
	rt::buffer<ReferenceLifetimeVisit> visited;
	ReferenceLifetimeVisit initial;
	@initial.node = this.graph.entry;
	@pending.push_back($initial);
	usize cursor = 0;
	while (cursor < pending.size()) {
		ReferenceLifetimeVisit state = pending.data()[cursor];
		@cursor = cursor + 1;
		if (state.node == target && state.live) {
			return true;
		};
		bool seen = false;
		usize index = 0;
		while (index < visited.size()) {
			ReferenceLifetimeVisit& previous = visited.data()[index];
			if (previous.node == state.node && previous.live == state.live) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		@visited.push_back(ReferenceLifetimeVisit(state));
		FactNode& node = this.graph.nodes.data()[state.node];
		if (node.owner == owner) {
			if (node.kind == fact_node_kind::lifetime_begin) {
				@state.live = true;
			};
			if (node.kind == fact_node_kind::lifetime_end) {
				@state.live = false;
			};
		};
		@index = 0;
		while (index < this.graph.edges.size()) {
			FactEdge& edge = this.graph.edges.data()[index];
			bool feasible = fact_semantic_edge_feasible(edge);
			if (edge.source == state.node && feasible) {
				ReferenceLifetimeVisit next;
				@next.node = edge.target;
				@next.live = state.live;
				@pending.push_back($next);
			};
			@index = index + 1;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::loan_store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceLoan& loan, usize definition) -> bool {
	if (!loan.stored_field || definition == fact_no_node()) {
		return true;
	};
	ReferenceStoreEffect effect;
	@effect.site = this.graph.nodes.data()[definition].expression;
	@effect.slot.root = loan.binding;
	reference_slot_copy(loan.holding, @effect.slot.path);
	if (!effect.slot.path.size && loan.stored_field) {
		if (!reference_slot_field(@effect.slot.path, loan.stored_field).has<void>()) {
			return true;
		};
	};
	return @this.store_path(source, target, effect);
};

fn ReferenceLoanAnalyzer::validate_ends(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::lifetime_end && node.owner) {
			usize loan_index = 0;
			while (loan_index < this.loans.size()) {
				ReferenceLoan& loan = this.loans.data()[loan_index];
				if (!loan.place.reference_contents && loan.place.root == node.owner && @this.active_at(loan, index) && @this.owner_live_at(node.owner, index)) {
					var SemanticExpression* location = node.expression;
					if (!location) {
						@location = this.function_body;
					};
					return @this.error(*location, "object lifetime ends while a dependent reference loan is active");
				};
				@loan_index = loan_index + 1;
			};
		};
		@index = index + 1;
	};
};

// Local reference loans. Raw-pointer storage is deliberately outside this analysis.
struct ReferenceLoanPlace {
	bool reference_contents;
	var Entity* root;
	var Entity* field;
	var Entity* through;
	var SemanticExpression* element;
};

fn reference_loan_overlap(ReferenceLoanPlace& first, ReferenceLoanPlace& second) -> bool {
	if (first.reference_contents != second.reference_contents || first.root != second.root || first.field && second.field && first.field != second.field) {
		return false;
	};
	if (first.element && second.element) {
		u64 left = 0;
		u64 right = 0;
		bool known_left = first.element->constant_integer(@left) || first.element->inferred_integer(@left);
		bool known_right = second.element->constant_integer(@right) || second.element->inferred_integer(@right);
		if (known_left && known_right && left != right) {
			return false;
		};
	};
	return true;
};

enum reference_loan_access : [u08] {
	read;
	write;
};

enum reference_loan_phase : [u08] {
	collect;
	validate;
};

struct ReferenceLoan {
	ReferenceSlotPath holding;
	var Entity* binding;
	var Entity* stored_field;
	usize creation;
	ReferenceLoanPlace place;
	type_qualifier permission;
	rt::buffer<usize> escapes;
};

struct ReferenceLoanSubstitution {
	var Entity* parameter;
	rt::buffer<ReferenceLoanPlace> places;
};

fn reference_loan_members_at(Type& type, usize depth) -> bool {
	if (depth > 16) {
		return true;
	};
	if (type.kind() == type_kind::array) {
		return type.count() && reference_loan_members_at(*type.element(), depth + 1);
	};
	if (type.kind() != type_kind::named || type.entity()->kind() != entity_kind::record) {
		return false;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		Type* member = type.entity()->fields().data()[index]->type();
		if (member->kind() == type_kind::reference || reference_loan_members_at(*member, depth + 1)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_loan_members(Type& type) -> bool {
	return reference_loan_members_at(type, 0);
};

fn reference_loan_permission(Type& type, usize depth) -> type_qualifier {
	if (type.kind() == type_kind::array) {
		return reference_loan_permission(*type.element(), depth + 1);
	};
	if (type.kind() == type_kind::reference) {
		return type.element()->qualifier();
	};
	if (depth > 16 || !reference_loan_members(type)) {
		return type_qualifier::immutable;
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		if (reference_loan_permission(*type.entity()->fields().data()[index]->type(), depth + 1) == type_qualifier::mutable) {
			return type_qualifier::mutable;
		};
		@index = index + 1;
	};
	return type_qualifier::immutable;
};

enum reference_walk_task_kind : [u08] {
	walk;
	storage;
	array_aggregate;
	record_aggregate;
	reference_binding;
	call_post;
};

struct ReferenceWalkTask {
	reference_walk_task_kind kind;
	var SemanticExpression* expression;
	reference_loan_access access;
	fn ReferenceWalkTask(var ReferenceWalkTask& this, reference_walk_task_kind kind, var SemanticExpression* expression, reference_loan_access access);
};

fn ReferenceWalkTask::ReferenceWalkTask(var ReferenceWalkTask& this, reference_walk_task_kind kind, var SemanticExpression* expression, reference_loan_access access) {
	@this.kind = $kind;
	@this.expression = expression;
	@this.access = $access;
};

struct ReferenceLoanAnalyzer {
	fn ReferenceLoanAnalyzer(var ReferenceLoanAnalyzer& this, var Diagnostics& diagnostics);
	fn validate(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult;

	private:
	fn collect(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression);
	fn position(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> usize;
	fn build_graph(var ReferenceLoanAnalyzer& this, Entity& function);
	fn reachable(var ReferenceLoanAnalyzer& this, usize source, usize target, usize kill, var Entity* cleanup_owner) -> bool;
	fn active(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& expression) -> bool;
	fn active_at(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, usize point) -> bool;
	fn owner_live_at(var ReferenceLoanAnalyzer& this, var Entity* owner, usize target) -> bool;
	fn validate_ends(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn loan_store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceLoan& loan, usize definition) -> bool;
	fn retain_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn retain_special_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn retain_constructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth, reference_initialization_kind mode, var SemanticExpression* initialization) -> CompilationResult;
	fn retain_destructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth) -> CompilationResult;
	fn retain_effect_capture(var ReferenceLoanAnalyzer& this, var Entity& function, var Entity* owner, var SemanticExpression* arguments, usize position, SemanticExpression& location) -> CompilationResult;
	fn prepare_captures(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult;
	fn capture_walk(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var Entity& function) -> CompilationResult;
	fn contextual_capture(var ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool;
	fn captures(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument) -> bool;
	fn capture_mode(ReferenceLoanAnalyzer& this, SemanticExpression& call, usize argument, bool contents) -> bool;
	fn place(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> ReferenceLoanPlace;
	fn places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult;
	fn returned_places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult;
	fn initializer(ReferenceLoanAnalyzer& this, SemanticExpression& expression, Entity& binding) -> var SemanticExpression*;
	fn aggregate(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult;
	fn array_aggregate(var ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> CompilationResult;
	fn content_sources(var ReferenceLoanAnalyzer& this, Type& type, SemanticExpression* source, var rt::buffer<ReferenceContentRoot>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, ReferenceSlotPath& holding, var Entity* symbolic, usize depth) -> CompilationResult;
	fn stored_contents(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var bool& found) -> CompilationResult;
	fn holding_use(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, var SemanticExpression& expression) -> bool;
	fn loan_definition(ReferenceLoanAnalyzer& this, ReferenceLoan& loan) -> usize;
	fn reaching_contents(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& use) -> bool;
	fn append_array_loan(var ReferenceLoanAnalyzer& this, ReferenceLoan loan);
	fn refresh_array_aliases(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn returned_local_places(var ReferenceLoanAnalyzer& this, var Entity& function, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, usize depth) -> CompilationResult;
	fn prepare_unknowns(var ReferenceLoanAnalyzer& this, SemanticUnit& unit);
	fn collect_unknowns(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn unknown_event(var ReferenceLoanAnalyzer& this, var Entity* root, ReferenceSlotPath& holding, usize position);
	fn raw_targets(var ReferenceLoanAnalyzer& this, SemanticExpression& pointer, usize operation, usize depth) -> CompilationResult;
	fn raw_write(var ReferenceLoanAnalyzer& this, SemanticExpression& destination, usize operation) -> CompilationResult;
	fn visible_raw_targets(var ReferenceLoanAnalyzer& this, usize operation) -> CompilationResult;
	fn unknown_path(var ReferenceLoanAnalyzer& this, ReferenceUnknownContent& event, ReferenceStoreSlot& slot, usize target) -> bool;
	fn raw_address_context(ReferenceLoanAnalyzer& this, SemanticExpression& expression, usize depth) -> bool;
	fn check_unknown(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, reference_loan_access access) -> CompilationResult;
	fn assignment(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult;
	fn store_slot(ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, usize depth) -> ReferenceStoreSlot;
	fn store_expression(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult;
	fn store_walk(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult;
	fn retain_stores(var ReferenceLoanAnalyzer& this, var SemanticExpression& body) -> CompilationResult;
	fn prepare_stores(var ReferenceLoanAnalyzer& this, SemanticUnit& unit);
	fn validate_stores(var ReferenceLoanAnalyzer& this) -> CompilationResult;
	fn store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceStoreEffect& effect) -> bool;
	fn defaults(var ReferenceLoanAnalyzer& this, Type& type, var rt::buffer<ReferenceLoanPlace>& output, usize depth) -> CompilationResult;
	fn check_place(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, ReferenceLoanPlace& target, reference_loan_access access) -> CompilationResult;
	fn check(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, reference_loan_access access) -> CompilationResult;
	fn reference_binding(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult;
	fn return_validation(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult;
	fn call_post(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult;
	fn walk(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult;
	fn error(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::string_view message) -> CompilationResult;

	var Diagnostics* diagnostics;
	rt::buffer<var SemanticExpression*> expressions;
	rt::buffer<ReferenceLoan> loans;
	rt::buffer<ReferenceStoreEffect> stores;
	rt::buffer<var Entity*> store_functions;
	rt::buffer<ReferenceCapture> captures_summary;
	entity_state capture_resolution;
	rt::buffer<var Entity*> return_functions;
	rt::buffer<var Entity*> raw_functions;
	rt::buffer<var Entity*> raw_globals;
	rt::buffer<ReferenceUnknownContent> unknowns;
	var ReferenceLoanAnalyzer* capture_parent;
	var ReferenceStoreSlot* destructive_slot;
	var SemanticExpression* function_body;
	FactGraph graph;
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	rt::buffer<usize> first_edges;
	rt::buffer<usize> next_edges;
	usize visit_generation;
	Type* return_type;
	reference_loan_phase phase;
};

fn ReferenceLoanAnalyzer::ReferenceLoanAnalyzer(var ReferenceLoanAnalyzer& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn ReferenceLoanAnalyzer::error(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::string_view message) -> CompilationResult {
	@this.diagnostics->error(expression.token(), message);
	return compilation_error();
};

fn ReferenceLoanAnalyzer::collect(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) {
	if (!expression) {
		return;
	};
	@this.expressions.push_back(expression);
	usize index = 0;
	while (index < expression->size()) {
		@this.collect(expression->item(index));
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::position(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> usize {
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		if (this.graph.nodes.data()[index].kind == fact_node_kind::expression && this.graph.nodes.data()[index].expression == &expression) {
			return index;
		};
		@index = index + 1;
	};
	return fact_no_node();
};

fn ReferenceLoanAnalyzer::build_graph(var ReferenceLoanAnalyzer& this, Entity& function) {
	@this.graph.build_function(function);
	@this.first_edges.clear();
	@this.next_edges.clear();
	@this.visited.clear();
	@this.visit_generation = 0;
	usize index = 0;
	while (index < this.graph.nodes.size()) {
		@this.first_edges.push_back(fact_no_node());
		@this.visited.push_back(0);
		@index = index + 1;
	};
	@index = 0;
	while (index < this.graph.edges.size()) {
		@this.next_edges.push_back(fact_no_node());
		@index = index + 1;
	};
	@index = this.graph.edges.size();
	while (index) {
		@index = index - 1;
		FactEdge& edge = this.graph.edges.data()[index];
		@(@this.next_edges).data()[index] = this.first_edges.data()[edge.source];
		@(@this.first_edges).data()[edge.source] = index;
	};
};

fn ReferenceLoanAnalyzer::reachable(var ReferenceLoanAnalyzer& this, usize source, usize target, usize kill, var Entity* cleanup_owner) -> bool {
	if (source == fact_no_node() || target == fact_no_node()) {
		// Opaque graph regions must not prematurely end a loan.
		return true;
	};
	@this.pending.clear();
	if (this.visit_generation == usize::max) {
		usize index = 0;
		while (index < this.visited.size()) {
			@(@this.visited).data()[index] = 0;
			@index = index + 1;
		};
		@this.visit_generation = 0;
	};
	@this.visit_generation = this.visit_generation + 1;
	@this.pending.push_back(source);
	usize next = 0;
	while (next < this.pending.size()) {
		usize node = this.pending.data()[next];
		@next = next + 1;
		if (node == target) {
			return true;
		};
		if (node == kill && node != source) {
			continue;
		};
		if (cleanup_owner && node != source) {
			if (this.graph.nodes.data()[node].kind == fact_node_kind::lifetime_end && this.graph.nodes.data()[node].owner == cleanup_owner) {
				continue;
			};
			var SemanticExpression* operation = this.graph.nodes.data()[node].expression;
			if (operation && (operation->kind() == semantic_kind::relocation || operation->kind() == semantic_kind::destruction) && operation->size() && operation->item(0)->owned_binding() == cleanup_owner) {
				continue;
			};
		};
		if (this.visited.data()[node] == this.visit_generation) {
			continue;
		};
		@(@this.visited).data()[node] = this.visit_generation;
		usize index = this.first_edges.data()[node];
		while (index != fact_no_node()) {
			FactEdge& edge = this.graph.edges.data()[index];
			if (fact_semantic_edge_feasible(edge)) {
				@this.pending.push_back(usize(edge.target));
			};
			@index = this.next_edges.data()[index];
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::active(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, SemanticExpression& expression) -> bool {
	return @this.active_at(loan, this.position(expression));
};

fn ReferenceLoanAnalyzer::active_at(var ReferenceLoanAnalyzer& this, ReferenceLoan& loan, usize point) -> bool {
	usize definition = usize(loan.creation);
	usize index = 0;
	while (definition == fact_no_node() && index < this.graph.nodes.size()) {
		var SemanticExpression* candidate = this.graph.nodes.data()[index].expression;
		if (this.graph.nodes.data()[index].kind == fact_node_kind::expression && candidate && candidate->kind() == semantic_kind::variable && candidate->entity() == loan.binding) {
			@definition = index;
			break;
		};
		@index = index + 1;
	};
	if (definition != fact_no_node() && !@this.reachable(this.graph.entry, definition, fact_no_node(), nullptr)) {
		return false;
	};
	var Entity* cleanup_owner = nullptr;
	if (loan.stored_field) {
		@cleanup_owner = loan.binding;
	};
	if (!@this.reachable(definition, point, fact_no_node(), cleanup_owner) || !@this.loan_store_path(definition, point, loan, definition)) {
		return false;
	};
	@index = 0;
	while (index < loan.escapes.size()) {
		if (@this.reachable(loan.escapes.data()[index], point, definition, nullptr)) {
			return true;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* use = this.expressions.data()[index];
		if (loan.binding && @this.holding_use(loan, @*use) && @this.reachable(point, this.position(*use), definition, cleanup_owner) && @this.loan_store_path(point, this.position(*use), loan, definition)) {
			return true;
		};
		@index = index + 1;
	};
	// A holder's custom destructor may read its reference members even after
	// the last explicit name use. Cleanup nodes identify the owned variable.
	@index = 0;
	while (loan.binding && loan.stored_field && index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::opaque && node.owner == loan.binding && @this.reachable(point, index, definition, loan.binding) && @this.loan_store_path(point, index, loan, definition)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::retain_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* call = this.expressions.data()[index];
		@index = index + 1;
		if (call->kind() != semantic_kind::call || call->size() < 2 || !@this.reachable(this.graph.entry, this.position(*call), fact_no_node(), nullptr)) {
			continue;
		};
		Type* signature = call->item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function) {
			continue;
		};
		var SemanticExpression* arguments = call->item(1);
		usize argument = 0;
		while (argument < arguments->size() && argument < signature->signature().parameters().size()) {
			Type* parameter = signature->signature().parameters().data()[argument];
			var SemanticExpression* actual = arguments->item(argument);
			@argument = argument + 1;
			if (!(parameter->kind() == type_kind::reference || reference_loan_members(*parameter)) || !@this.contextual_capture(*call, argument - 1, false) && !@this.contextual_capture(*call, argument - 1, true)) {
				continue;
			};
			usize mode = 0;
			while (mode < 2) {
				bool contents = mode == 1;
				@mode = mode + 1;
				if (!@this.contextual_capture(*call, argument - 1, contents)) {
					continue;
				};
				rt::buffer<ReferenceLoanPlace> targets;
				rt::buffer<ReferenceLoanSubstitution> substitutions;
				if (!contents && reference_capture_aggregate(parameter) && actual->owned_binding()) {
					ReferenceLoanPlace owner;
					@owner.root = actual->owned_binding();
					@targets.push_back($owner);
				}
				else if (!(@this.places(*actual, @targets, @substitutions, nullptr, 0)).has<void>()) {
					return @this.error(*call, "reference escape provenance storage is unavailable");
				};
				usize candidate = 0;
				while (candidate < targets.size()) {
					ReferenceLoanPlace& target = targets.data()[candidate];

					// Opaque retention outlives any local reference binding or holder.
					 {
						ReferenceLoan escaped;
						@escaped.creation = this.position(*call);
						@escaped.place.root = target.root;
						@escaped.place.reference_contents = target.reference_contents || contents && target.root && target.root->kind() == entity_kind::parameter && reference_capture_aggregate(target.root->type());
						@escaped.place.field = target.field;
						@escaped.place.element = target.element;
						@escaped.place.through = target.through;
						@escaped.permission = reference_loan_permission(*parameter, 0);
						@escaped.escapes.push_back(usize(escaped.creation));
						@this.loans.push_back($escaped);
					};
					@candidate = candidate + 1;
				};
			};
		};
	};
};

fn ReferenceLoanAnalyzer::place(ReferenceLoanAnalyzer& this, SemanticExpression& expression) -> ReferenceLoanPlace {
	ReferenceLoanPlace result;
	if (expression.kind() == semantic_kind::name) {
		var Entity* binding = expression.entity();
		if (!binding || !binding->type() || binding->type()->kind() == type_kind::pointer) {
			return $result;
		};
		usize index = this.loans.size();
		while (index) {
			@index = index - 1;
			if (this.loans.data()[index].binding == binding) {
				@result.root = this.loans.data()[index].place.root;
				@result.reference_contents = this.loans.data()[index].place.reference_contents;
				@result.field = this.loans.data()[index].place.field;
				@result.element = this.loans.data()[index].place.element;
				@result.through = binding;
				return $result;
			};
		};
		@result.root = binding;
		if (binding->type()->kind() == type_kind::reference) {
			@result.through = binding;
		};
		return $result;
	};
	if (expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast || expression.kind() == semantic_kind::variant_payload) {
		return this.place(*expression.item(0));
	};
	if (expression.kind() == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		@result = this.place(*expression.item(0));
		// Keep the outermost field; deeper fields conservatively overlap.
		var Entity* field = expression.entity();
		var Entity* owner = nullptr;
		if (field) {
			@owner = field->member_owner();
		};
		if (!result.field && (!owner || owner->layout() != record_layout::overlapping)) {
			@result.field = expression.entity();
		};
		return $result;
	};
	if (expression.kind() == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		@result = this.place(*expression.item(0));
		var Entity* owner = expression.item(0)->owned_binding();
		if (owner && owner->kind() == entity_kind::local && owner->type()->kind() == type_kind::array && result.root == owner && !result.field) {
			@result.element = expression.item(1);
		};
		return $result;
	};
	return $result;
};

fn ReferenceLoanAnalyzer::initializer(ReferenceLoanAnalyzer& this, SemanticExpression& expression, Entity& binding) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding) {
		return expression.item(0);
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* found = this.initializer(*expression.item(index), binding);
		if (found) {
			return found;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn ReferenceLoanAnalyzer::returned_places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult {
	if (expression.kind() == semantic_kind::return_value) {
		if (!expression.size()) {
			return;
		};
		return @this.places(*expression.item(0), @output, @substitutions, context, depth + 1);
	};
	usize index = 0;
	while (index < expression.size()) {
		if (!(@this.returned_places(*expression.item(index), @output, @substitutions, context, depth)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::places(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var Entity* context, usize depth) -> CompilationResult {
	if (depth > 16) {
		return @this.error(expression, "reference provenance analysis limit exceeded");
	};
	semantic_kind kind = expression.kind();
	if (kind == semantic_kind::name && reference_loan_members(*expression.type()) && (!context || context->body() == this.function_body)) {
		bool found = false;
		if (!(@this.stored_contents(expression, @output, @found)).has<void>()) {
			return compilation_error();
		};
		if (found) {
			return;
		};
	};
	if (kind == semantic_kind::name) {
		var Entity* binding = expression.entity();
		usize index = substitutions.size();
		while (index) {
			@index = index - 1;
			ReferenceLoanSubstitution& substitution = substitutions.data()[index];
			if (substitution.parameter == binding) {
				usize candidate = 0;
				while (candidate < substitution.places.size()) {
					ReferenceLoanPlace mapped;
					@mapped.root = substitution.places.data()[candidate].root;
					@mapped.reference_contents = substitution.places.data()[candidate].reference_contents;
					@mapped.field = substitution.places.data()[candidate].field;
					@mapped.element = substitution.places.data()[candidate].element;
					@mapped.through = substitution.places.data()[candidate].through;
					@output.push_back($mapped);
					@candidate = candidate + 1;
				};
				return;
			};
		};
		if (context && binding && binding->kind() == entity_kind::local && (binding->type()->kind() == type_kind::reference || reference_loan_members(*binding->type()))) {
			var SemanticExpression* source = this.initializer(*context->body(), *binding);
			if (!source) {
				return;
			};
			return @this.places(*source, @output, @substitutions, context, depth + 1);
		};
		bool found = false;
		@index = 0;
		while (index < this.loans.size()) {
			ReferenceLoan& loan = this.loans.data()[index];
			if (loan.binding == binding) {
				ReferenceLoanPlace mapped;
				@mapped.root = loan.place.root;
				@mapped.reference_contents = loan.place.reference_contents;
				@mapped.field = loan.place.field;
				@mapped.element = loan.place.element;
				@mapped.through = binding;
				@output.push_back($mapped);
				@found = true;
			};
			@index = index + 1;
		};
		if (found) {
			return;
		};
	};
	if (kind == semantic_kind::access || kind == semantic_kind::cast || kind == semantic_kind::relocation || kind == semantic_kind::variant_payload || kind == semantic_kind::variant_cast) {
		return @this.places(*expression.item(0), @output, @substitutions, context, depth + 1);
	};
	if (kind == semantic_kind::index && reference_loan_members(*expression.type()) || kind == semantic_kind::member && expression.entity() && (expression.entity()->type()->kind() == type_kind::reference || reference_loan_members(*expression.type()))) {
		bool found = false;
		if (!(@this.stored_contents(@expression, @output, @found)).has<void>()) {
			return compilation_error();
		};
		if (found) {
			return;
		};
	};
	if (kind == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		usize first = output.size();
		if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
			return compilation_error();
		};
		var Entity* owner = expression.item(0)->owned_binding();
		while (first < output.size()) {
			var ReferenceLoanPlace* target = (@output).data() + first;
			if (owner && owner->kind() == entity_kind::local && owner->type()->kind() == type_kind::array && target->root == owner && !target->field) {
				@target->element = expression.item(1);
			};
			@first = first + 1;
		};
		return;
	};
	if (kind == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		var Entity* aggregate_binding = expression.item(0)->owned_binding();
		var Entity* selected = expression.entity();
		if (aggregate_binding && selected && (selected->type()->kind() == type_kind::reference || reference_loan_members(*selected->type()))) {
			bool found = false;
			usize index = 0;
			while (index < this.loans.size()) {
				ReferenceLoan& loan = this.loans.data()[index];
				if (loan.binding == aggregate_binding && loan.stored_field == selected) {
					ReferenceLoanPlace mapped;
					@mapped.root = loan.place.root;
					@mapped.reference_contents = loan.place.reference_contents;
					@mapped.field = loan.place.field;
					@mapped.element = loan.place.element;
					@mapped.through = aggregate_binding;
					@output.push_back($mapped);
					@found = true;
				};
				@index = index + 1;
			};
			if (found) {
				return;
			};
		};
		if (selected && selected->type()->kind() == type_kind::reference) {
			usize first = output.size();
			if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
				return compilation_error();
			};
			while (first < output.size()) {
				var ReferenceLoanPlace* target = (@output).data() + first;
				if (target->root && target->root->kind() == entity_kind::parameter && reference_capture_aggregate(target->root->type())) {
					@target->reference_contents = true;
				};
				@first = first + 1;
			};
			return;
		};
		usize first = output.size();
		if (!(@this.places(*expression.item(0), @output, @substitutions, context, depth + 1)).has<void>()) {
			return compilation_error();
		};
		var Entity* field = expression.entity();
		var Entity* owner = nullptr;
		if (field) {
			@owner = field->member_owner();
		};
		while (first < output.size()) {
			var ReferenceLoanPlace* target = (@output).data() + first;
			if (!target->field && (!owner || owner->layout() != record_layout::overlapping)) {
				@target->field = field;
			};
			@first = first + 1;
		};
		return;
	};
	if (kind == semantic_kind::construction && expression.type()->kind() == type_kind::array && reference_loan_members(*expression.type())) {
		rt::buffer<ReferenceContentRoot> roots;
		ReferenceSlotPath path;
		if (!(@this.content_sources(*expression.type(), &expression, @roots, @substitutions, context, path, nullptr, depth + 1)).has<void>()) {
			return compilation_error();
		};
		usize index = 0;
		while (index < roots.size()) {
			ReferenceLoanPlace root;
			@root.root = roots.data()[index].referent.root;
			@root.reference_contents = roots.data()[index].referent.reference_contents;
			@root.field = roots.data()[index].referent.field;
			@root.element = roots.data()[index].referent.element;
			@root.through = roots.data()[index].referent.through;
			@output.push_back($root);
			@index = index + 1;
		};
		return;
	};
	if (kind == semantic_kind::construction && reference_loan_members(*expression.type()) && expression.size()) {
		var SemanticExpression* arguments = expression.item(0);
		if (variant_instance(*expression.type()->entity()) && expression.integer() && arguments->size()) {
			Type* selected = variant_flow_type(expression.type(), usize(expression.integer() - 1));
			if (selected->kind() != type_kind::reference && !reference_loan_members(*selected)) {
				return;
			};
			return @this.places(*arguments->item(0), @output, @substitutions, context, depth + 1);
		};
		bool custom = expression.entity() && expression.entity()->definition() != function_definition::defaulted;
		if (!custom && arguments->size() == 1 && arguments->item(0)->type()->same_shape(*expression.type())) {
			return @this.places(*arguments->item(0), @output, @substitutions, context, depth + 1);
		};
		usize index = 0;
		while (index < expression.type()->entity()->fields().size()) {
			var Entity* field = expression.type()->entity()->fields().data()[index];
			var SemanticExpression* value = field->body();
			if (!custom && index < arguments->size()) {
				@value = arguments->item(index);
			};
			if (field->type()->kind() == type_kind::reference || reference_loan_members(*field->type())) {
				if (value) {
					if (!(@this.places(*value, @output, @substitutions, context, depth + 1)).has<void>()) {
						return compilation_error();
					};
				}
				else if (!(@this.defaults(*field->type(), @output, depth + 1)).has<void>()) {
					return compilation_error();
				};
			};
			@index = index + 1;
		};
		return;
	};
	var Entity* returned_function = expression.entity();
	if (returned_function && returned_function->kind() == entity_kind::function) {
		@returned_function = returned_function->canonical();
	};
	if (kind == semantic_kind::call && returned_function && returned_function->dispatch() == function_dispatch::ordinary && returned_function->body() && (returned_function->type()->signature().result()->kind() == type_kind::reference || reference_loan_members(*returned_function->type()->signature().result()))) {
		var Entity* callee = returned_function;
		var SemanticExpression* arguments = expression.item(1);
		usize boundary = substitutions.size();
		usize index = 0;
		while (index < callee->parameters().size() && index < arguments->size()) {
			ReferenceLoanSubstitution substitution;
			@substitution.parameter = callee->parameters().data()[index];
			if ((substitution.parameter->type()->kind() == type_kind::reference || reference_loan_members(*substitution.parameter->type())) && !(@this.places(*arguments->item(index), @substitution.places, @substitutions, context, depth + 1)).has<void>()) {
				return compilation_error();
			};
			@substitutions.push_back($substitution);
			@index = index + 1;
		};
		bool valid = false;
		if (reference_returns_local(*callee->body())) {
			@valid = (@this.returned_local_places(@*callee, @output, @substitutions, depth + 1)).has<void>();
		}
		else {
			@valid = (@this.returned_places(*callee->body(), @output, @substitutions, callee, depth + 1)).has<void>();
		};
		while (substitutions.size() > boundary) {
			@substitutions.pop_back();
		};
		if (valid) {
			return;
		};
		return compilation_error();
	};
	var target = this.place(expression);
	if (target.root) {
		@output.push_back($target);
		return;
	}
	else {
		return;
	};
};

fn ReferenceLoanAnalyzer::defaults(var ReferenceLoanAnalyzer& this, Type& type, var rt::buffer<ReferenceLoanPlace>& output, usize depth) -> CompilationResult {
	if (depth > 16) {
		return compilation_error();
	};
	if (!reference_loan_members(type)) {
		return;
	};
	if (type.kind() == type_kind::array) {
		if (!type.count()) {
			return;
		};
		return @this.defaults(*type.element(), @output, depth + 1);
	};
	usize index = 0;
	while (index < type.entity()->fields().size()) {
		var Entity* field = type.entity()->fields().data()[index];
		@index = index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		if (field->body()) {
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*field->body(), @output, @substitutions, nullptr, depth + 1)).has<void>()) {
				return compilation_error();
			};
		}
		else if (!(@this.defaults(*field->type(), @output, depth + 1)).has<void>()) {
			return compilation_error();
		};
	};
};

fn ReferenceLoanAnalyzer::aggregate(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult {
	Type* type = expression.entity()->type();
	var SemanticExpression* source = expression.item(0);
	if (!source || source->kind() != semantic_kind::construction || !source->size()) {
		return;
	};
	var SemanticExpression* arguments = source->item(0);
	if (variant_instance(*type->entity())) {
		if (this.phase != reference_loan_phase::collect) {
			return @this.walk(source, reference_loan_access::read);
		};
		rt::buffer<ReferenceLoanPlace> targets;
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		if (!(@this.places(*source, @targets, @substitutions, nullptr, 0)).has<void>()) {
			return compilation_error();
		};
		var Entity* field = nullptr;
		usize field_index = 0;
		while (field_index < type->entity()->fields().size()) {
			var Entity* candidate = type->entity()->fields().data()[field_index];
			if (reference_loan_members(*candidate->type())) {
				@field = candidate;
				break;
			};
			@field_index = field_index + 1;
		};
		usize index = 0;
		while (field && index < targets.size()) {
			ReferenceLoan loan;
			@loan.binding = expression.entity();
			@loan.stored_field = field;
			@loan.creation = fact_no_node();
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = reference_loan_permission(*type, 0);
			@this.loans.push_back($loan);
			@index = index + 1;
		};
		return;
	};
	bool custom = source->entity() && source->entity()->definition() != function_definition::defaulted;
	// Compiler-generated aggregate transfer preserves reference member provenance.
	if (!custom && arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type)) {
		var SemanticExpression* other = arguments->item(0);
		while ((other->kind() == semantic_kind::relocation || other->kind() == semantic_kind::access || other->kind() == semantic_kind::cast) && other->size()) {
			@other = other->item(0);
		};
		if (this.phase != reference_loan_phase::collect) {
			return;
		};
		if (other->kind() != semantic_kind::name) {
			rt::buffer<ReferenceLoanPlace> targets;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*other, @targets, @substitutions, nullptr, 0)).has<void>()) {
				return @this.error(expression, "returned aggregate provenance storage is unavailable");
			};
			usize field_index = 0;
			while (field_index < type->entity()->fields().size()) {
				var Entity* field = type->entity()->fields().data()[field_index];
				@field_index = field_index + 1;
				if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
					continue;
				};
				usize index = 0;
				while (index < targets.size()) {
					ReferenceLoan loan;
					@loan.binding = expression.entity();
					@loan.stored_field = field;
					@loan.creation = fact_no_node();
					@loan.place.root = targets.data()[index].root;
					@loan.place.reference_contents = targets.data()[index].reference_contents;
					@loan.place.field = targets.data()[index].field;
					@loan.place.element = targets.data()[index].element;
					@loan.place.through = targets.data()[index].through;
					@loan.permission = reference_loan_permission(*field->type(), 0);
					@this.loans.push_back($loan);
					@index = index + 1;
				};
			};
			return;
		};
		usize count = this.loans.size();
		usize index = 0;
		while (index < count) {
			if (this.loans.data()[index].binding == other->entity() && this.loans.data()[index].stored_field) {
				ReferenceLoan loan;
				@loan.binding = expression.entity();
				@loan.stored_field = this.loans.data()[index].stored_field;
				reference_slot_copy(this.loans.data()[index].holding, @loan.holding);
				@loan.creation = fact_no_node();
				@loan.place.root = this.loans.data()[index].place.root;
				@loan.place.reference_contents = this.loans.data()[index].place.reference_contents;
				@loan.place.field = this.loans.data()[index].place.field;
				@loan.place.element = this.loans.data()[index].place.element;
				@loan.place.through = this.loans.data()[index].place.through;
				@loan.permission = this.loans.data()[index].permission;
				@this.loans.push_back($loan);
			};
			@index = index + 1;
		};
		return;
	};
	usize field_index = 0;
	while (field_index < type->entity()->fields().size()) {
		var Entity* field = type->entity()->fields().data()[field_index];
		var SemanticExpression* argument = field->body();
		if (!custom && field_index < arguments->size()) {
			@argument = arguments->item(field_index);
		};
		@field_index = field_index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		type_qualifier permission = reference_loan_permission(*field->type(), 0);
		reference_loan_access required = reference_loan_access::read;
		if (permission == type_qualifier::mutable) {
			@required = reference_loan_access::write;
		};
		if (this.phase == reference_loan_phase::validate) {
			if (argument && !(@this.walk(argument, required)).has<void>()) {
				return compilation_error();
			};
		};
		rt::buffer<ReferenceLoanPlace> targets;
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		bool known = true;
		if (argument) {
			@known = (@this.places(*argument, @targets, @substitutions, nullptr, 0)).has<void>();
		}
		else {
			@known = (@this.defaults(*field->type(), @targets, 0)).has<void>();
		};
		if (!known) {
			return @this.error(expression, "reference member provenance storage is unavailable");
		};
		usize index = 0;
		while (index < targets.size()) {
			if (this.phase == reference_loan_phase::validate) {
				ReferenceLoanPlace& target = targets.data()[index];
				usize other = 0;
				while (other < this.loans.size()) {
					ReferenceLoan& existing = this.loans.data()[other];
					if (existing.binding == expression.entity() && existing.stored_field != field && reference_loan_overlap(existing.place, target) && (existing.permission == type_qualifier::mutable || permission == type_qualifier::mutable)) {
						return @this.error(expression, "reference members contain conflicting loans");
					};
					@other = other + 1;
				};
				@index = index + 1;
				continue;
			};
			ReferenceLoan loan;
			@loan.binding = expression.entity();
			@loan.stored_field = field;
			@loan.creation = fact_no_node();
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = permission;
			@this.loans.push_back($loan);
			@index = index + 1;
		};
	};
};

fn ReferenceLoanAnalyzer::assignment(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression) -> CompilationResult {
	if (this.phase != reference_loan_phase::collect || !expression.entity() || expression.entity()->role() != function_role::assignment || expression.entity()->definition() != function_definition::defaulted) {
		return;
	};
	var SemanticExpression* arguments = expression.item(1);
	if (arguments->size() != 2 || !reference_loan_members(*arguments->item(0)->type())) {
		return;
	};
	var Entity* destination = arguments->item(0)->owned_binding();
	if (!destination) {
		return;
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(*arguments->item(1), @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(expression, "assigned reference provenance storage is unavailable");
	};
	usize field_index = 0;
	while (field_index < destination->type()->entity()->fields().size()) {
		var Entity* field = destination->type()->entity()->fields().data()[field_index];
		@field_index = field_index + 1;
		if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
			continue;
		};
		usize index = 0;
		while (index < targets.size()) {
			ReferenceLoan loan;
			@loan.binding = destination;
			@loan.stored_field = field;
			@loan.creation = this.position(expression);
			@loan.place.root = targets.data()[index].root;
			@loan.place.reference_contents = targets.data()[index].reference_contents;
			@loan.place.field = targets.data()[index].field;
			@loan.place.element = targets.data()[index].element;
			@loan.place.through = targets.data()[index].through;
			@loan.permission = reference_loan_permission(*field->type(), 0);
			@this.loans.push_back($loan);
			@index = index + 1;
		};
	};
};

fn ReferenceLoanAnalyzer::check(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, reference_loan_access access) -> CompilationResult {
	if (this.phase == reference_loan_phase::collect) {
		return;
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(expression, @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		if (!(@this.check_place(@expression, targets.data()[index], access)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::check_place(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, ReferenceLoanPlace& target, reference_loan_access access) -> CompilationResult {
	usize index = 0;
	while (index < this.loans.size()) {
		ReferenceLoan& loan = this.loans.data()[index];
		if (reference_loan_overlap(loan.place, target) && (!loan.binding || loan.binding != target.through) && @this.active(loan, expression)) {
			// A reborrow may access through its parent; direct use of the parent is
			// still checked against every outstanding child loan.
			bool parent = false;
			var Entity* through = target.through;
			usize depth = this.loans.size();
			while (through && depth) {
				usize candidate = 0;
				var Entity* next = nullptr;
				while (candidate < this.loans.size()) {
					if (this.loans.data()[candidate].binding == through) {
						@next = this.loans.data()[candidate].place.through;
					};
					@candidate = candidate + 1;
				};
				if (loan.binding && next == loan.binding) {
					@parent = true;
					break;
				};
				@through = next;
				@depth = depth - 1;
			};
			if (!parent && (access == reference_loan_access::write || loan.permission == type_qualifier::mutable)) {
				if (loan.binding) {
					@this.diagnostics->note(loan.binding->token(), "conflicting reference is declared here and used later");
				};
				return @this.error(expression, "access conflicts with a live reference loan");
			};
		};
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::reference_binding(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult {
	var SemanticExpression* initializer = expression->item(0);
	type_qualifier permission = expression->entity()->type()->element()->qualifier();
	if (this.phase == reference_loan_phase::validate) {
		return;
	};
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	bool object = false;
	if (reference_loan_members(*expression->entity()->type()->element())) {
		rt::buffer<ReferenceStoreBinding> bindings;
		var slot = this.store_slot(*initializer, bindings, nullptr, 0);
		if (slot.root && reference_array_members(*slot.root->type(), 0)) {
			ReferenceLoanPlace target;
			@target.root = slot.root;
			usize projection = 0;
			while (projection < slot.path.size) {
				ReferenceSlotStep& step = slot.path.steps[projection];
				if (step.kind == reference_slot_step_kind::field && !target.field) {
					@target.field = step.field;
				};
				if (step.kind != reference_slot_step_kind::field && !target.element) {
					@target.element = step.index;
				};
				@projection = projection + 1;
			};
			@targets.push_back($target);
			@object = true;
		};
	};
	if (!object && !(@this.places(*initializer, @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(*expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		ReferenceLoan loan;
		@loan.binding = expression->entity();
		@loan.creation = fact_no_node();
		@loan.place.root = targets.data()[index].root;
		@loan.place.reference_contents = targets.data()[index].reference_contents;
		@loan.place.field = targets.data()[index].field;
		@loan.place.element = targets.data()[index].element;
		@loan.place.through = targets.data()[index].through;
		@loan.permission = permission;
		@this.loans.push_back($loan);
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::return_validation(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression) -> CompilationResult {
	rt::buffer<ReferenceLoanPlace> targets;
	rt::buffer<ReferenceLoanSubstitution> substitutions;
	if (!(@this.places(*expression->item(0), @targets, @substitutions, nullptr, 0)).has<void>()) {
		return @this.error(*expression, "reference provenance storage is unavailable");
	};
	usize index = 0;
	while (index < targets.size()) {
		var Entity* root = targets.data()[index].root;
		if (root && (root->kind() == entity_kind::local || root->kind() == entity_kind::parameter && root->type()->kind() != type_kind::reference)) {
			return @this.error(*expression, "returned reference refers to local storage");
		};
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::call_post(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult {
	Type* signature = expression->item(0)->type();
	if (signature->kind() == type_kind::pointer) {
		@signature = signature->element();
	};
	if (!(@this.assignment(@*expression)).has<void>()) {
		return compilation_error();
	};
	if (signature->kind() == type_kind::function && signature->signature().result()->kind() == type_kind::reference) {
		return @this.check(@*expression, access);
	};
};

fn ReferenceLoanAnalyzer::walk(var ReferenceLoanAnalyzer& this, var SemanticExpression* expression, reference_loan_access access) -> CompilationResult {
	rt::buffer<ReferenceWalkTask> pending;
	@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, expression, access));
	while (pending.size()) {
		ReferenceWalkTask task = pending.data()[pending.size() - 1];
		@pending.pop_back();
		var SemanticExpression* current = task.expression;
		if (!current) {
			continue;
		};
		semantic_kind kind = current->kind();
		if (task.kind == reference_walk_task_kind::array_aggregate) {
			if (!(@this.array_aggregate(*current)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::record_aggregate) {
			if (!(@this.aggregate(@*current)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::reference_binding) {
			if (!(@this.reference_binding(current)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::call_post) {
			if (!(@this.call_post(current, task.access)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		if (task.kind == reference_walk_task_kind::storage) {
			if (kind == semantic_kind::name) {
				continue;
			};
			if (kind == semantic_kind::index) {
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(1), reference_loan_access::read));
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current->item(0), reference_loan_access::read));
				continue;
			};
			if (kind == semantic_kind::member || kind == semantic_kind::access || kind == semantic_kind::cast || kind == semantic_kind::variant_payload) {
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current->item(0), reference_loan_access::read));
				continue;
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current, reference_loan_access::read));
			continue;
		};
		bool structural = kind == semantic_kind::brace || kind == semantic_kind::statements || kind == semantic_kind::sequence || kind == semantic_kind::conditional || kind == semantic_kind::while_loop || kind == semantic_kind::for_loop || kind == semantic_kind::exception_try || kind == semantic_kind::exception_handler || kind == semantic_kind::switch_expression || kind == semantic_kind::case_label;
		if (!structural && this.phase == reference_loan_phase::validate && this.position(*current) != fact_no_node() && !@this.reachable(this.graph.entry, this.position(*current), fact_no_node(), nullptr)) {
			continue;
		};
		if (this.phase == reference_loan_phase::validate && !(@this.check_unknown(*current, task.access)).has<void>()) {
			return compilation_error();
		};
		if (kind == semantic_kind::variant_cast) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), task.access));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && reference_array_members(*current->entity()->type(), 0)) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::array_aggregate, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && current->entity()->type()->kind() == type_kind::named && current->entity()->type()->entity()->kind() == entity_kind::record) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::record_aggregate, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::variable && current->entity() && current->entity()->type()->kind() == type_kind::reference) {
			reference_loan_access required = reference_loan_access::read;
			if (current->entity()->type()->element()->qualifier() == type_qualifier::mutable) {
				@required = reference_loan_access::write;
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::reference_binding, current, task.access));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), required));
			continue;
		};
		if (this.phase == reference_loan_phase::validate && kind == semantic_kind::return_value && (this.return_type->kind() == type_kind::reference || reference_loan_members(*this.return_type)) && current->size()) {
			if (!(@this.return_validation(current)).has<void>()) {
				return compilation_error();
			};
		};
		if (kind == semantic_kind::relocation || kind == semantic_kind::destruction) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::write));
			continue;
		};
		if (kind == semantic_kind::call && current->size() >= 2) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::call_post, current, task.access));
			Type* signature = current->item(0)->type();
			if (signature->kind() == type_kind::pointer) {
				@signature = signature->element();
			};
			var SemanticExpression* arguments = current->item(1);
			usize argument = arguments->size();
			while (argument) {
				@argument = argument - 1;
				reference_loan_access required = reference_loan_access::read;
				if (signature->kind() == type_kind::function && argument < signature->signature().parameters().size()) {
					Type* parameter = signature->signature().parameters().data()[argument];
					if (parameter->kind() == type_kind::reference && parameter->element()->qualifier() == type_qualifier::mutable) {
						@required = reference_loan_access::write;
					};
				};
				@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, arguments->item(argument), required));
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::binary && (current->operation() == token_kind::op_assign || current->operation() == token_kind::op_copy)) {
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(0), reference_loan_access::write));
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(1), reference_loan_access::read));
			continue;
		};
		if (kind == semantic_kind::name || kind == semantic_kind::member || kind == semantic_kind::index || kind == semantic_kind::access || kind == semantic_kind::variant_payload || kind == semantic_kind::cast && current->category() == value_category::place) {
			if (!(@this.check(@*current, task.access)).has<void>()) {
				return compilation_error();
			};
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::storage, current, reference_loan_access::read));
			continue;
		};
		usize child = current->size();
		while (child) {
			@child = child - 1;
			@pending.push_back(ReferenceWalkTask(reference_walk_task_kind::walk, current->item(child), reference_loan_access::read));
		};
	};
};

fn ReferenceLoanAnalyzer::validate(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) -> CompilationResult {
	@this.prepare_stores(unit);
	if ((@this.prepare_captures(unit)).has<void>()) {
		@this.prepare_unknowns(unit);
	}
	else {
		return compilation_error();
	};
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;
		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};
		@this.expressions.clear();
		@this.loans.clear();
		@this.stores.clear();
		@this.function_body = function->body();
		@this.return_type = function->type()->signature().result();
		@this.phase = reference_loan_phase::collect;
		@this.build_graph(*function);
		@this.collect(function->body());
		if (!(@this.walk(function->body(), reference_loan_access::read)).has<void>()) {
			return compilation_error();
		};
		@this.phase = reference_loan_phase::validate;
		if (!(@this.retain_stores(@*function->body())).has<void>() || !(@this.refresh_array_aliases()).has<void>() || !(@this.collect_unknowns()).has<void>() || !(@this.retain_escapes()).has<void>() || !(@this.retain_special_escapes()).has<void>() || !(@this.walk(function->body(), reference_loan_access::read)).has<void>() || !(@this.validate_stores()).has<void>() || !(@this.validate_ends()).has<void>()) {
			return compilation_error();
		};
	};
};

fn reference_returns_local(SemanticExpression& expression) -> bool {
	if (expression.kind() == semantic_kind::return_value && expression.size()) {
		SemanticExpression* value = expression.item(0);
		while ((value->kind() == semantic_kind::relocation || value->kind() == semantic_kind::access || value->kind() == semantic_kind::cast) && value->size()) {
			@value = value->item(0);
		};
		if (value->kind() == semantic_kind::name && value->entity() && value->entity()->kind() == entity_kind::local && reference_loan_members(*value->type())) {
			return true;
		};
	};
	usize index = 0;
	while (index < expression.size()) {
		if (reference_returns_local(*expression.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

// A returned local carries its reaching contents, including stores performed
// after its initializer. Reuse the same graph/store analysis in a separate state
// so a callee's slots never become slots in the caller's current object state.
fn ReferenceLoanAnalyzer::returned_local_places(var ReferenceLoanAnalyzer& this, var Entity& function, var rt::buffer<ReferenceLoanPlace>& output, var rt::buffer<ReferenceLoanSubstitution>& substitutions, usize depth) -> CompilationResult {
	if (depth > 16) {
		return @this.error(*function.body(), "reference provenance analysis limit exceeded");
	};
	usize index = 0;
	while (index < this.return_functions.size()) {
		if (this.return_functions.data()[index] == &function) {
			return @this.error(*function.body(), "recursive returned reference contents require conservative rejection");
		};
		@index = index + 1;
	};
	var local = ReferenceLoanAnalyzer(@*this.diagnostics);
	@index = 0;
	while (index < this.return_functions.size()) {
		@local.return_functions.push_back(this.return_functions.data()[index]);
		@index = index + 1;
	};
	@local.return_functions.push_back(&@function);
	@index = 0;
	while (index < this.store_functions.size()) {
		@local.store_functions.push_back(this.store_functions.data()[index]);
		@index = index + 1;
	};
	@local.function_body = function.body();
	@local.return_type = function.type()->signature().result();
	@local.phase = reference_loan_phase::collect;
	@local.build_graph(function);
	@local.collect(function.body());
	if (!(@local.walk(function.body(), reference_loan_access::read)).has<void>()) {
		return compilation_error();
	};
	@local.phase = reference_loan_phase::validate;
	if (!(@local.retain_stores(@*function.body())).has<void>() || !(@local.refresh_array_aliases()).has<void>()) {
		return compilation_error();
	};
	rt::buffer<ReferenceLoanPlace> roots;
	rt::buffer<ReferenceLoanSubstitution> none;
	if (!(@local.returned_places(*function.body(), @roots, @none, nullptr, depth + 1)).has<void>()) {
		return compilation_error();
	};
	@index = 0;
	while (index < roots.size()) {
		ReferenceLoanPlace& root = roots.data()[index];
		bool mapped = false;
		usize substitution = 0;
		while (substitution < substitutions.size()) {
			ReferenceLoanSubstitution& argument = substitutions.data()[substitution];
			if (argument.parameter == root.root) {
				usize candidate = 0;
				while (candidate < argument.places.size()) {
					ReferenceLoanPlace result;
					@result.root = argument.places.data()[candidate].root;
					@result.reference_contents = argument.places.data()[candidate].reference_contents;
					@result.field = argument.places.data()[candidate].field;
					@result.element = argument.places.data()[candidate].element;
					@result.through = argument.places.data()[candidate].through;
					if (!result.field) {
						@result.field = root.field;
					};
					if (!result.element) {
						@result.element = root.element;
					};
					@output.push_back($result);
					@candidate = candidate + 1;
				};
				@mapped = true;
			};
			@substitution = substitution + 1;
		};
		if (!mapped) {
			ReferenceLoanPlace result;
			@result.root = root.root;
			@result.reference_contents = root.reference_contents;
			@result.field = root.field;
			@result.element = root.element;
			@result.through = root.through;
			@output.push_back($result);
		};
		@index = index + 1;
	};
};

// Holding slots describe where references are stored. Referent places continue
// to describe the objects accessed through those references.
enum reference_slot_step_kind : [u08] {
	field;
	known_index;
	unknown_index;
};

struct ReferenceSlotStep {
	reference_slot_step_kind kind;
	var Entity* field;
	var SemanticExpression* index;
	u64 value;
};

struct ReferenceSlotPath {
	ReferenceSlotStep[16] steps;
	usize size;
	bool imprecise;
};

fn reference_slot_copy(ReferenceSlotPath& source, var ReferenceSlotPath& target) {
	@target.size = source.size;
	@target.imprecise = source.imprecise;
	usize index = 0;
	while (index < source.size) {
		@target.steps[index].field = source.steps[index].field;
		@target.steps[index].index = source.steps[index].index;
		@target.steps[index].kind = source.steps[index].kind;
		@target.steps[index].value = source.steps[index].value;
		@index = index + 1;
	};
};

fn reference_slot_field(var ReferenceSlotPath& path, var Entity* field) -> CompilationResult {
	if (path.size == 16) {
		@path.imprecise = true;
		return compilation_error();
	};
	@path.steps[path.size].field = field;
	@path.steps[path.size].kind = reference_slot_step_kind::field;
	@path.steps[path.size].index = nullptr;
	@path.steps[path.size].value = 0;
	@path.size = path.size + 1;
};

fn reference_slot_index(var ReferenceSlotPath& path, var SemanticExpression* expression) -> CompilationResult {
	if (path.size == 16) {
		@path.imprecise = true;
		return compilation_error();
	};
	var ReferenceSlotStep* step = &@path.steps[path.size];
	@step->kind = reference_slot_step_kind::unknown_index;
	@step->field = nullptr;
	@step->value = 0;
	@step->index = expression;
	if (expression) {
		u64 value = 0;
		if (expression->constant_integer(@value) || expression->inferred_integer(@value)) {
			@step->kind = reference_slot_step_kind::known_index;
			@step->value = value;
		};
	};
	@path.size = path.size + 1;
};

fn reference_slot_overlap(ReferenceSlotPath& first, ReferenceSlotPath& second) -> bool {
	usize index = 0;
	while (index < first.size && index < second.size) {
		ReferenceSlotStep& left = first.steps[index];
		ReferenceSlotStep& right = second.steps[index];
		if ((left.kind == reference_slot_step_kind::field) != (right.kind == reference_slot_step_kind::field)) {
			return true;
		};
		if (left.kind != reference_slot_step_kind::field) {
			if (left.kind == reference_slot_step_kind::known_index && right.kind == reference_slot_step_kind::known_index && left.value != right.value) {
				return false;
			};
		}
		else if (left.field && right.field && left.field != right.field) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

// A write may kill an old slot only when it definitely covers that slot.
// Unknown indices overlap for reads, but never prove such coverage.
fn reference_slot_prefix(ReferenceSlotPath& replacement, ReferenceSlotPath& previous) -> bool {
	if (replacement.imprecise || previous.imprecise || replacement.size > previous.size) {
		return false;
	};
	usize index = 0;
	while (index < replacement.size) {
		ReferenceSlotStep& left = replacement.steps[index];
		ReferenceSlotStep& right = previous.steps[index];
		if ((left.kind == reference_slot_step_kind::field) != (right.kind == reference_slot_step_kind::field)) {
			return false;
		};
		if (left.kind != reference_slot_step_kind::field) {
			if (left.kind != reference_slot_step_kind::known_index || right.kind != reference_slot_step_kind::known_index || left.value != right.value) {
				return false;
			};
		}
		else if (!left.field || !right.field || left.field != right.field) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn reference_slot_equal(ReferenceSlotPath& first, ReferenceSlotPath& second) -> bool {
	if (first.size != second.size || first.imprecise != second.imprecise) {
		return false;
	};
	usize index = 0;
	while (index < first.size) {
		ReferenceSlotStep& left = first.steps[index];
		ReferenceSlotStep& right = second.steps[index];
		if (left.kind != right.kind) {
			return false;
		};
		if (left.kind == reference_slot_step_kind::field && left.field != right.field || left.kind == reference_slot_step_kind::known_index && left.value != right.value || left.kind == reference_slot_step_kind::unknown_index && left.index != right.index) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

enum reference_initialization_kind : [u08] {
	initialize;
	copy;
	relocate;
};

// Special members have implicit receivers rather than ordinary call arguments.
fn ReferenceLoanAnalyzer::retain_effect_capture(var ReferenceLoanAnalyzer& this, var Entity& function, var Entity* owner, var SemanticExpression* arguments, usize position, SemanticExpression& location) -> CompilationResult {
	if (position != fact_no_node() && !@this.reachable(this.graph.entry, position, fact_no_node(), nullptr)) {
		return;
	};
	ReferenceLoanAnalyzer* summary = &this;
	if (this.capture_parent) {
		@summary = this.capture_parent;
	};
	var Entity* implementation = function.canonical();
	if (implementation != &function) {
		return @this.retain_effect_capture(@*implementation, owner, arguments, position, location);
	};
	usize index = 0;
	bool opaque = function.definition() != function_definition::defaulted && (!function.body() || function.dispatch() != function_dispatch::ordinary);
	usize count = summary->captures_summary.size();
	if (opaque) {
		@count = count + function.parameters().size() * 2;
	};
	while (index < count) {
		ReferenceCapture capture;
		if (index < summary->captures_summary.size()) {
			ReferenceCapture& known = summary->captures_summary.data()[index];
			@capture.function = known.function;
			@capture.parameter = known.parameter;
			@capture.contents = known.contents;
		}
		else {
			usize offset = index - summary->captures_summary.size();
			@capture.function = &@function;
			@capture.parameter = function.parameters().data()[offset / 2];
			@capture.contents = offset % 2 == 1;
			if (capture.contents && !reference_capture_aggregate(capture.parameter->type()) || !capture.contents && capture.parameter->type()->kind() != type_kind::reference) {
				@index = index + 1;
				continue;
			};
		};
		@index = index + 1;
		if (capture.function != &function) {
			continue;
		};
		if (owner && position != fact_no_node() && this.graph.nodes.data()[position].kind == fact_node_kind::opaque && !@this.owner_live_at(owner, position)) {
			continue;
		};

		usize parameter = 0;
		while (parameter < function.parameters().size() && function.parameters().data()[parameter] != capture.parameter) {
			@parameter = parameter + 1;
		};
		rt::buffer<ReferenceLoanPlace> targets;
		if (parameter == 0 && owner) {
			if (capture.contents) {
				usize loan_index = 0;
				while (loan_index < this.loans.size()) {
					ReferenceLoan& loan = this.loans.data()[loan_index];
					if (loan.binding == owner && loan.stored_field) {
						if (function.role() == function_role::destructor) {
							usize definition = @this.loan_definition(loan);
							if (definition == position || definition != fact_no_node() && (!@this.reachable(this.graph.entry, definition, fact_no_node(), nullptr) || !@this.loan_store_path(definition, position, loan, definition))) {
								@loan_index = loan_index + 1;
								continue;
							};
							ReferenceSlotPath holding;
							reference_slot_copy(loan.holding, @holding);
							if (!holding.size && !reference_slot_field(@holding, loan.stored_field).has<void>()) {
								return @this.error(location, "reference holding projection exceeds the analysis depth limit");
							};
							if (this.destructive_slot && !reference_slot_overlap(holding, this.destructive_slot->path)) {
								@loan_index = loan_index + 1;
								continue;
							};
						};
						ReferenceLoanPlace target;
						@target.root = loan.place.root;
						@target.reference_contents = loan.place.reference_contents;
						@target.field = loan.place.field;
						@target.element = loan.place.element;
						@targets.push_back($target);
					};
					@loan_index = loan_index + 1;
				};
			}
			else {
				if (function.role() == function_role::destructor && this.destructive_slot) {
					return @this.error(location, "destructor receiver capture outlives the replaced object");
				};
				if (function.role() == function_role::constructor && (owner->kind() == entity_kind::local || owner->kind() == entity_kind::parameter)) {
					discard @this.error(location, "constructor reference capture may outlive local storage");
					if (opaque) {
						@this.diagnostics->note(function.token(), "constructor body is unavailable to reference analysis");
					}
					else {
						@this.diagnostics->note(function.token(), "constructor receiver may escape through this function");
					};
					return compilation_error();
				};
				ReferenceLoanPlace target;
				@target.root = owner;
				@targets.push_back($target);
			};
		}
		else if (parameter && arguments && parameter - 1 < arguments->size()) {
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(*arguments->item(parameter - 1), @targets, @substitutions, nullptr, 0)).has<void>()) {
				return compilation_error();
			};
		};
		usize candidate = 0;
		while (candidate < targets.size()) {
			ReferenceLoanPlace& target = targets.data()[candidate];
			ReferenceLoan escaped;
			@escaped.creation = position;
			@escaped.place.root = target.root;
			@escaped.place.reference_contents = target.reference_contents;
			@escaped.place.field = target.field;
			@escaped.place.element = target.element;
			@escaped.permission = reference_loan_permission(*capture.parameter->type(), 0);
			@escaped.escapes.push_back(usize(position));
			@this.loans.push_back($escaped);
			@candidate = candidate + 1;
		};
	};
};

fn ReferenceLoanAnalyzer::retain_special_escapes(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.expressions.size()) {
		var SemanticExpression* expression = this.expressions.data()[index];
		@index = index + 1;
		if (expression->kind() == semantic_kind::call && expression->entity() && expression->size() > 1) {
			Entity* assignment = expression->entity()->canonical();
			if (assignment->role() == function_role::assignment && assignment->definition() == function_definition::defaulted && assignment->parameters().size() == 2 && assignment->parameters().data()[1]->type()->kind() != type_kind::reference && expression->item(1)->size() == 2 && @this.reachable(this.graph.entry, this.position(*expression), fact_no_node(), nullptr)) {
				rt::buffer<ReferenceStoreBinding> bindings;
				var destination = this.store_slot(*expression->item(1)->item(0), bindings, nullptr, 0);
				if (destination.root) {
					@this.destructive_slot = &@destination;
					bool retained = (@this.retain_destructor_captures(expression->item(1)->item(0)->type(), destination.root, this.position(*expression), *expression, 0)).has<void>();
					@this.destructive_slot = nullptr;
					if (!retained) {
						return compilation_error();
					};
				};
			};
		};
		var SemanticExpression* construction = expression;
		var Entity* owner = nullptr;
		if (expression->kind() == semantic_kind::variable && expression->size()) {
			@construction = expression->item(0);
			@owner = expression->entity();
		}
		else if (expression->kind() == semantic_kind::construction && expression->size() > 1) {
			@owner = expression->item(1)->owned_binding();
		};
		if (owner && construction->kind() == semantic_kind::construction && construction->entity() && !(@this.retain_effect_capture(@*construction->entity(), owner, construction->item(0), this.position(*construction), *expression)).has<void>()) {
			return compilation_error();
		};
		if (owner && construction->kind() == semantic_kind::construction && !(@this.retain_constructor_captures(owner->type(), owner, this.position(*construction), *expression, 0, reference_initialization_kind::initialize, construction)).has<void>()) {
			return compilation_error();
		};

	};
	@index = 0;
	while (index < this.graph.nodes.size()) {
		FactNode& node = this.graph.nodes.data()[index];
		if (node.kind == fact_node_kind::opaque && node.owner) {
			var SemanticExpression* location = node.expression;
			if (!location) {
				@location = this.function_body;
			};
			if (!(@this.retain_destructor_captures(node.owner->type(), node.owner, index, *location, 0)).has<void>()) {
				return compilation_error();
			};
		};
		@index = index + 1;
	};
};

fn ReferenceLoanAnalyzer::retain_destructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth) -> CompilationResult {
	if (depth > 32) {
		return @this.error(location, "special member capture analysis limit exceeded");
	};
	if (type->kind() == type_kind::reference) {
		return;
	};
	if (type->kind() == type_kind::array) {
		return @this.retain_destructor_captures(type->element(), owner, position, location, depth + 1);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};
	var Entity* record = type->entity();
	if (record->destructor() && !(@this.retain_effect_capture(@*record->destructor(), owner, nullptr, position, location)).has<void>()) {
		return compilation_error();
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!(@this.retain_destructor_captures(record->bases().data()[index], owner, position, location, depth + 1)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		if (!(@this.retain_destructor_captures(record->fields().data()[index]->type(), owner, position, location, depth + 1)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};


// Follow the same selected initialization path as backend initialize_members and
// copy_members. Generated relocation transfers representation without invoking
// member constructors; a custom constructor initializes its members normally.
fn ReferenceLoanAnalyzer::retain_constructor_captures(var ReferenceLoanAnalyzer& this, Type* type, var Entity* owner, usize position, SemanticExpression& location, usize depth, reference_initialization_kind mode, var SemanticExpression* initialization) -> CompilationResult {
	ReferenceLoanAnalyzer* summary = &this;
	if (this.capture_parent) {
		@summary = this.capture_parent;
	};
	if (depth > 32) {
		return @this.error(location, "special member capture analysis limit exceeded");
	};
	if (type->kind() == type_kind::reference) {
		return;
	};
	if (initialization && initialization->kind() == semantic_kind::construction) {
		var Entity* selected = initialization->entity();
		if (selected) {
			@selected = selected->canonical();
		};
		if (selected) {
			@mode = reference_initialization_kind::initialize;
			if (selected->definition() == function_definition::defaulted && selected->parameters().size() == 2) {
				@mode = reference_initialization_kind::relocate;
				if (selected->parameters().data()[1]->type()->kind() == type_kind::reference) {
					@mode = reference_initialization_kind::copy;
				};
			};
		}
		else if (initialization->size() && initialization->item(0)->size() == 1 && initialization->item(0)->item(0)->type()->same_shape(*type)) {
			@mode = reference_initialization_kind::relocate;
			if (initialization->item(0)->item(0)->category() == value_category::place) {
				@mode = reference_initialization_kind::copy;
			};
		};
	};
	if (mode == reference_initialization_kind::relocate) {
		return;
	};
	if (type->kind() == type_kind::array) {
		return @this.retain_constructor_captures(type->element(), owner, position, location, depth + 1, mode, nullptr);
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record || type->entity()->layout() == record_layout::overlapping) {
		return;
	};
	var Entity* record = type->entity();
	usize member = 0;
	while (member < record->bases().size() + record->fields().size()) {
		Type* child = nullptr;
		var SemanticExpression* value = nullptr;
		if (member < record->bases().size()) {
			@child = record->bases().data()[member];
		}
		else {
			var Entity* field = record->fields().data()[member - record->bases().size()];
			@child = field->type();
			if (mode == reference_initialization_kind::initialize) {
				@value = field->body();
			};
		};
		if (mode == reference_initialization_kind::initialize && initialization && !initialization->entity() && initialization->kind() == semantic_kind::construction && initialization->size() && member < initialization->item(0)->size()) {
			@value = initialization->item(0)->item(member);
		};
		@member = member + 1;
		Type* element = child;
		while (element->kind() == type_kind::array) {
			@element = element->element();
		};
		if (element->kind() == type_kind::reference) {
			continue;
		};
		reference_initialization_kind child_mode = mode;
		if (element->kind() == type_kind::named && element->entity()->kind() == entity_kind::record) {
			var Entity* constructor = element->entity()->default_constructor();
			var SemanticExpression* arguments = nullptr;
			if (mode == reference_initialization_kind::copy) {
				@constructor = element->entity()->copy_constructor();
			}
			else if (value) {
				@constructor = nullptr;
				if (value->kind() == semantic_kind::construction) {
					@constructor = value->entity();
					@arguments = value->item(0);
				}
				else {
					@constructor = element->entity()->move_constructor();
					@child_mode = reference_initialization_kind::relocate;
				};
			};
			if (constructor) {
				@constructor = constructor->canonical();
			};
			if (constructor && constructor->definition() != function_definition::defaulted && constructor->definition() != function_definition::deleted) {
				if (!constructor->body() && !arguments && constructor->parameters().size() > 1) {
					return @this.error(location, "implicit constructor capture provenance is unavailable");
				};
				usize capture_index = 0;
				while (!arguments && capture_index < summary->captures_summary.size()) {
					ReferenceCapture& capture = summary->captures_summary.data()[capture_index];
					if (capture.function == constructor && constructor->parameters().size() && capture.parameter != constructor->parameters().data()[0]) {
						return @this.error(location, "implicit constructor capture provenance is unavailable");
					};
					@capture_index = capture_index + 1;
				};
				if (!(@this.retain_effect_capture(@*constructor, owner, arguments, position, location)).has<void>()) {
					return compilation_error();
				};
				@child_mode = reference_initialization_kind::initialize;
				@value = nullptr;
			};
		};
		if (!(@this.retain_constructor_captures(child, owner, position, location, depth + 1, child_mode, value)).has<void>()) {
			return compilation_error();
		};
	};
};

// Reference-slot identity is distinct from the objects referenced by that slot.
struct ReferenceStoreSlot {
	ReferenceSlotPath path;
	var Entity* root;
	var Entity* field;
	SemanticExpression* expression;
};

struct ReferenceStoreBinding {
	var Entity* parameter;
	ReferenceStoreSlot slot;
};

struct ReferenceStoreEffect {
	var SemanticExpression* site;
	ReferenceStoreSlot slot;
	var Entity* field;
	ReferenceLoanPlace referent;
	type_qualifier permission;
	bool definite;
};

fn reference_store_calls(SemanticExpression& expression, rt::buffer<var Entity*>& functions) -> bool {
	if (expression.kind() == semantic_kind::call && expression.entity() && expression.entity()->dispatch() == function_dispatch::ordinary) {
		var Entity* callee = expression.entity();
		if (callee->role() == function_role::assignment && callee->definition() == function_definition::defaulted && expression.item(1)->size() == 2 && reference_loan_members(*expression.item(1)->item(0)->type())) {
			return true;
		};
		usize index = 0;
		while (index < functions.size()) {
			if (functions.data()[index] == callee) {
				return true;
			};
			@index = index + 1;
		};
	};
	usize index = 0;
	while (index < expression.size()) {
		if (reference_store_calls(*expression.item(index), functions)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::prepare_stores(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) {
	@this.store_functions.clear();
	while (true) {
		usize previous = this.store_functions.size();
		usize index = 0;
		while (index < unit.entities().size()) {
			var Entity* function = unit.entities().data()[index].get();
			@index = index + 1;
			if (function->kind() != entity_kind::function || !function->body() || function->dispatch() != function_dispatch::ordinary) {
				continue;
			};
			usize existing = 0;
			while (existing < this.store_functions.size() && this.store_functions.data()[existing] != function) {
				@existing = existing + 1;
			};
			if (existing == this.store_functions.size()) {
				if (reference_store_calls(*function->body(), this.store_functions)) {
					@this.store_functions.push_back(function);
				};
			};
		};
		if (previous == this.store_functions.size()) {
			break;
		};
	};
};

fn reference_store_contains(SemanticExpression& scope, SemanticExpression& expression) -> bool {
	if (&scope == &expression) {
		return true;
	};
	usize index = 0;
	while (index < scope.size()) {
		if (reference_store_contains(*scope.item(index), expression)) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_store_region(var SemanticExpression& expression, Entity& binding, var SemanticExpression* region) -> var SemanticExpression* {
	if (expression.kind() == semantic_kind::brace || expression.kind() == semantic_kind::sequence || expression.kind() == semantic_kind::for_loop) {
		@region = &@expression;
	};
	if (expression.kind() == semantic_kind::variable && expression.entity() == &binding) {
		return region;
	};
	usize index = 0;
	while (index < expression.size()) {
		var SemanticExpression* found = reference_store_region(@*expression.item(index), binding, region);
		if (found) {
			return found;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn reference_store_same(ReferenceStoreSlot& first, ReferenceStoreSlot& second) -> bool {
	return first.root == second.root && reference_slot_equal(first.path, second.path);
};

fn reference_store_graph_path(FactGraph& graph, usize source, usize target, usize avoid) -> bool {
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	@pending.push_back(source);
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize node = pending.data()[cursor];
		@cursor = cursor + 1;
		if (node == target) {
			return true;
		};
		bool seen = false;
		usize index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == node) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		@visited.push_back(node);
		@index = 0;
		while (index < graph.edges.size()) {
			FactEdge& edge = graph.edges.data()[index];
			bool feasible = fact_semantic_edge_feasible(edge);
			if (node == avoid && edge.kind != fact_edge_kind::exceptional) {
				@feasible = false;
			};
			if (edge.source == node) {
				if (feasible) {
					@pending.push_back(usize(edge.target));
				};
			};
			@index = index + 1;
		};
	};
	return false;
};

fn reference_store_required(Entity& function, SemanticExpression& operation) -> bool {
	if (!function.body()) {
		return false;
	};
	FactGraph graph;
	@graph.build(function.body());
	usize node = fact_no_node();
	usize index = 0;
	while (index < graph.nodes.size()) {
		if (graph.nodes.data()[index].kind == fact_node_kind::expression && graph.nodes.data()[index].expression == &operation) {
			@node = index;
			break;
		};
		@index = index + 1;
	};
	return node != fact_no_node() && reference_store_graph_path(graph, usize(graph.entry), usize(graph.normal_exit), fact_no_node()) && !reference_store_graph_path(graph, usize(graph.entry), usize(graph.normal_exit), node);
};

fn ReferenceLoanAnalyzer::store_slot(ReferenceLoanAnalyzer& this, SemanticExpression& expression, rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, usize depth) -> ReferenceStoreSlot {
	ReferenceStoreSlot slot;
	if (depth > 16) {
		return $slot;
	};
	if (expression.kind() == semantic_kind::name && expression.entity()) {
		var Entity* binding = expression.entity();
		usize index = bindings.size();
		while (index) {
			@index = index - 1;
			if (bindings.data()[index].parameter == binding) {
				@slot.root = bindings.data()[index].slot.root;
				@slot.field = bindings.data()[index].slot.field;
				@slot.expression = bindings.data()[index].slot.expression;
				reference_slot_copy(bindings.data()[index].slot.path, @slot.path);
				return $slot;
			};
		};
		if (binding->type()->kind() == type_kind::reference && binding->kind() != entity_kind::parameter) {
			var SemanticExpression* source = binding->body();
			if (binding->kind() == entity_kind::local) {
				var SemanticExpression* body = this.function_body;
				if (context) {
					@body = context->body();
				};
				@source = this.initializer(*body, *binding);
			};
			if (source) {
				return this.store_slot(@*source, bindings, context, depth + 1);
			};
			return $slot;
		};
		@slot.root = binding;
		@slot.expression = &expression;
		return $slot;
	};
	if (expression.kind() == semantic_kind::access || expression.kind() == semantic_kind::cast || expression.kind() == semantic_kind::relocation) {
		return this.store_slot(@*expression.item(0), bindings, context, depth + 1);
	};
	if (expression.kind() == semantic_kind::member && expression.item(0)->type()->kind() != type_kind::pointer) {
		@slot = this.store_slot(@*expression.item(0), bindings, context, depth + 1);
		if (!slot.field) {
			@slot.field = expression.entity();
		};
		@slot.expression = &expression;
		if (!reference_slot_field(@slot.path, expression.entity()).has<void>()) {
			@slot.path.imprecise = true;
		};
		return $slot;
	};
	if (expression.kind() == semantic_kind::index && expression.item(0)->type()->kind() == type_kind::array) {
		@slot = this.store_slot(@*expression.item(0), bindings, context, depth + 1);
		if (!reference_slot_index(@slot.path, expression.item(1)).has<void>()) {
			@slot.path.imprecise = true;
		};
		@slot.expression = &expression;
		return $slot;
	};
	return $slot;
};

fn ReferenceLoanAnalyzer::store_expression(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult {
	if (expression.kind() == semantic_kind::call && expression.entity() && expression.entity()->dispatch() == function_dispatch::ordinary) {
		var Entity* callee = expression.entity();
		var SemanticExpression* arguments = expression.item(1);
		var SemanticExpression* event = site;
		if (!event) {
			@event = &@expression;
		};
		bool required = definite;
		if (context) {
			@required = required && reference_store_required(*context, expression);
		};
		if (callee->role() == function_role::assignment && callee->definition() == function_definition::defaulted && arguments->size() == 2 && reference_loan_members(*arguments->item(0)->type())) {
			var slot = this.store_slot(@*arguments->item(0), bindings, context, 0);
			if (slot.root) {
				rt::buffer<ReferenceLoanPlace> targets;
				if (!(@this.places(*arguments->item(1), @targets, @substitutions, context, 0)).has<void>()) {
					return compilation_error();
				};
				usize field_index = 0;
				while (field_index < arguments->item(0)->type()->entity()->fields().size()) {
					var Entity* field = arguments->item(0)->type()->entity()->fields().data()[field_index];
					@field_index = field_index + 1;
					if (field->type()->kind() != type_kind::reference && !reference_loan_members(*field->type())) {
						continue;
					};
					usize target = 0;
					while (target < targets.size()) {
						ReferenceStoreEffect effect;
						@effect.site = event;
						@effect.slot.root = slot.root;
						@effect.slot.field = slot.field;
						@effect.slot.expression = slot.expression;
						reference_slot_copy(slot.path, @effect.slot.path);
						@effect.field = field;
						@effect.referent.root = targets.data()[target].root;
						@effect.referent.reference_contents = targets.data()[target].reference_contents;
						@effect.referent.field = targets.data()[target].field;
						@effect.referent.through = targets.data()[target].through;
						@effect.referent.element = targets.data()[target].element;
						@effect.permission = reference_loan_permission(*field->type(), 0);
						bool modeled_destructive = event == &@expression && callee->parameters().size() == 2 && callee->parameters().data()[1]->type()->kind() != type_kind::reference;
						@effect.definite = required && (!fact_cleanup_effects(arguments->item(0)->type(), 0) || modeled_destructive);
						usize existing = 0;
						while (existing < this.stores.size()) {
							ReferenceStoreEffect& previous = this.stores.data()[existing];
							if (previous.site == effect.site && previous.field == effect.field && reference_store_same(previous.slot, effect.slot) && previous.referent.root == effect.referent.root && previous.referent.field == effect.referent.field && previous.referent.element == effect.referent.element) {
								break;
							};
							@existing = existing + 1;
						};
						if (existing == this.stores.size()) {
							@this.stores.push_back($effect);
						};
						@target = target + 1;
					};
				};
			};
		}
		else if (callee->body()) {
			usize candidate = 0;
			while (candidate < this.store_functions.size() && this.store_functions.data()[candidate] != callee) {
				@candidate = candidate + 1;
			};
			if (candidate == this.store_functions.size()) {
				return;
			};
			usize boundary = substitutions.size();
			usize slot_boundary = bindings.size();
			usize parameter = 0;
			while (parameter < callee->parameters().size() && parameter < arguments->size()) {
				ReferenceLoanSubstitution substitution;
				@substitution.parameter = callee->parameters().data()[parameter];
				ReferenceStoreBinding binding;
				@binding.parameter = substitution.parameter;
				if (substitution.parameter->type()->kind() == type_kind::reference) {
					if (!(@this.places(*arguments->item(parameter), @substitution.places, @substitutions, context, 0)).has<void>()) {
						return compilation_error();
					};
					@binding.slot = this.store_slot(@*arguments->item(parameter), bindings, context, 0);
				}
				else {
					ReferenceLoanPlace owned;
					@owned.root = substitution.parameter;
					@substitution.places.push_back($owned);
					@binding.slot.root = substitution.parameter;
				};
				@substitutions.push_back($substitution);
				@bindings.push_back($binding);
				@parameter = parameter + 1;
			};
			if (!(@this.store_walk(@*callee->body(), @substitutions, @bindings, callee, event, required, depth + 1)).has<void>()) {
				return compilation_error();
			};
			while (substitutions.size() > boundary) {
				@substitutions.pop_back();
			};
			while (bindings.size() > slot_boundary) {
				@bindings.pop_back();
			};
		};
	};
};

fn ReferenceLoanAnalyzer::store_walk(var ReferenceLoanAnalyzer& this, var SemanticExpression& expression, var rt::buffer<ReferenceLoanSubstitution>& substitutions, var rt::buffer<ReferenceStoreBinding>& bindings, var Entity* context, var SemanticExpression* site, bool definite, usize depth) -> CompilationResult {
	if (depth > 16) {
		return @this.error(expression, "reference store summary exceeds the analysis depth limit");
	};
	// Expression depth must not consume the native stack. Only bounded call-summary
	// expansion recurses, with each call restoring its substitutions before children.
	rt::buffer<var SemanticExpression*> pending;
	@pending.push_back(&@expression);
	while (pending.size()) {
		var SemanticExpression* current = pending.data()[pending.size() - 1];
		@pending.pop_back();
		if (!(@this.store_expression(@*current, @substitutions, @bindings, context, site, definite, depth)).has<void>()) {
			return compilation_error();
		};
		usize child = current->size();
		while (child) {
			@child = child - 1;
			@pending.push_back(current->item(child));
		};
	};
};

fn ReferenceLoanAnalyzer::retain_stores(var ReferenceLoanAnalyzer& this, var SemanticExpression& body) -> CompilationResult {
	usize iteration = 0;
	while (iteration < 16) {
		usize previous = this.stores.size();
		rt::buffer<ReferenceLoanSubstitution> substitutions;
		rt::buffer<ReferenceStoreBinding> bindings;
		if (!(@this.store_walk(@body, @substitutions, @bindings, nullptr, nullptr, true, 0)).has<void>()) {
			return @this.error(body, "reference store summary storage is unavailable");
		};
		usize index = previous;
		while (index < this.stores.size()) {
			ReferenceStoreEffect& effect = this.stores.data()[index];
			ReferenceLoan loan;
			@loan.binding = effect.slot.root;
			reference_slot_copy(effect.slot.path, @loan.holding);
			if (!reference_slot_field(@loan.holding, effect.field).has<void>()) {
				return @this.error(*effect.site, "reference holding projection exceeds the analysis depth limit");
			};
			@loan.stored_field = effect.field;
			if (effect.slot.field) {
				@loan.stored_field = effect.slot.field;
			};
			@loan.creation = this.position(*effect.site);
			@loan.place.root = effect.referent.root;
			@loan.place.reference_contents = effect.referent.reference_contents;
			@loan.place.field = effect.referent.field;
			@loan.place.through = effect.referent.through;
			@loan.place.element = effect.referent.element;
			@loan.permission = effect.permission;
			if (loan.binding) {
				if (loan.place.root) {
					@this.loans.push_back($loan);
				};
			};
			@index = index + 1;
		};
		if (previous == this.stores.size()) {
			return;
		};
		@iteration = iteration + 1;
	};
	return @this.error(body, "reference store analysis did not converge within the analysis limit");
};

fn ReferenceLoanAnalyzer::store_path(var ReferenceLoanAnalyzer& this, usize source, usize target, ReferenceStoreEffect& effect) -> bool {
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	if (source == fact_no_node()) {
		return true;
	}
	else {
		if (target == fact_no_node()) {
			return true;
		}
		else {
			@pending.push_back(source);
		};
	};
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize node = pending.data()[cursor];
		@cursor = cursor + 1;
		bool killed = false;
		usize index = 0;
		while (node != source && index < this.stores.size()) {
			ReferenceStoreEffect& replacement = this.stores.data()[index];
			if (replacement.definite && replacement.site != effect.site && replacement.slot.root == effect.slot.root && reference_slot_prefix(replacement.slot.path, effect.slot.path) && this.position(*replacement.site) == node) {
				@killed = true;
				break;
			};
			@index = index + 1;
		};
		if (node != source && this.graph.nodes.data()[node].kind == fact_node_kind::lifetime_end && this.graph.nodes.data()[node].owner == effect.slot.root) {
			continue;
		};
		if (node == target) {
			return true;
		};
		bool seen = false;
		@index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == node) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		@visited.push_back(node);
		@index = 0;
		while (index < this.graph.edges.size()) {
			FactEdge& edge = this.graph.edges.data()[index];
			bool feasible = fact_semantic_edge_feasible(edge);
			// A verified replacement kills the old slot value only after normal
			// completion. An exceptional exit may precede the actual store.
			if (killed && edge.kind != fact_edge_kind::exceptional) {
				@feasible = false;
			};
			if (edge.source == node) {
				if (feasible) {
					@pending.push_back(usize(edge.target));
				};
			};
			@index = index + 1;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::validate_stores(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	usize index = 0;
	while (index < this.stores.size()) {
		ReferenceStoreEffect& effect = this.stores.data()[index];
		@index = index + 1;
		var Entity* source = effect.referent.root;
		var Entity* destination = effect.slot.root;
		if (effect.referent.reference_contents || !source || !destination || source->kind() == entity_kind::global || source->kind() == entity_kind::parameter && source->type()->kind() == type_kind::reference || source->kind() != entity_kind::local && source->kind() != entity_kind::parameter) {
			continue;
		};
		var SemanticExpression* region = reference_store_region(@*this.function_body, *source, this.function_body);
		if (!region && source->kind() == entity_kind::parameter && source->scope() && source->scope()->owner() && source->scope()->owner()->body() == this.function_body) {
			@region = this.function_body;
		};
		bool external = destination->kind() == entity_kind::global || destination->kind() == entity_kind::parameter && destination->type()->kind() == type_kind::reference;
		usize creation = this.position(*effect.site);
		if (!@this.reachable(this.graph.entry, creation, fact_no_node(), nullptr)) {
			continue;
		};
		if (external && (@this.store_path(creation, usize(this.graph.normal_exit), effect) || @this.store_path(creation, usize(this.graph.exceptional_exit), effect))) {
			return @this.error(*effect.site, "stored reference may outlive its referent");
		};
		usize node_index = 0;
		while (node_index < this.graph.nodes.size()) {
			FactNode& node = this.graph.nodes.data()[node_index];
			var SemanticExpression* use = node.expression;
			bool reads = use && use->kind() == semantic_kind::name && use->entity() == destination;
			bool cleanup = node.kind == fact_node_kind::opaque && use && use->kind() == semantic_kind::variable && use->entity() == destination;
			bool outside = !region || use && !reference_store_contains(*region, *use);
			if (cleanup && source->scope() == destination->scope() && destination->token().begin < source->token().begin) {
				@outside = true;
			};
			if (reads && outside) {
				usize replacement_index = 0;
				while (replacement_index < this.stores.size()) {
					ReferenceStoreEffect& replacement = this.stores.data()[replacement_index];
					if (replacement.definite && replacement.site != effect.site && reference_store_same(replacement.slot, effect.slot) && replacement.slot.expression && reference_store_contains(*replacement.slot.expression, *use)) {
						@reads = false;
					};
					@replacement_index = replacement_index + 1;
				};
			};
			if ((reads || cleanup || external && use && use->kind() == semantic_kind::call) && outside && @this.store_path(creation, node_index, effect)) {
				return @this.error(*effect.site, "stored reference may outlive its referent");
			};
			@node_index = node_index + 1;
		};
	};
};

struct ReferenceUnknownContent {
	var Entity* root;
	ReferenceSlotPath holding;
	usize source;
};

fn reference_holder_contents(Type* type) -> bool {
	if (type->kind() == type_kind::reference) {
		@type = type->element();
	};
	return reference_loan_members(*type);
};

fn reference_raw_function(Entity& function, rt::buffer<var Entity*>& functions) -> bool {
	usize index = 0;
	while (index < functions.size()) {
		if (functions.data()[index] == function.canonical()) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn reference_raw_effects(SemanticExpression& expression, rt::buffer<var Entity*>& functions) -> bool {
	if (expression.kind() == semantic_kind::binary && (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy) && expression.item(0)->type()->kind() == type_kind::pointer) {
		SemanticExpression* target = expression.item(0);
		while ((target->kind() == semantic_kind::access || target->kind() == semantic_kind::cast) && target->size()) {
			@target = target->item(0);
		};
		Entity* destination = target->entity();
		if (destination && destination->kind() == entity_kind::global) {
			return true;
		};
	};
	if (expression.kind() == semantic_kind::construction && expression.size() > 1 && expression.item(1)->indirect_storage() || (expression.kind() == semantic_kind::destruction || expression.kind() == semantic_kind::relocation) && expression.size() && expression.item(0)->indirect_storage()) {
		return true;
	};
	if (expression.kind() == semantic_kind::binary && (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy) && expression.item(0)->indirect_storage()) {
		return true;
	};
	if (expression.kind() == semantic_kind::call && expression.size() >= 2) {
		var Entity* function = expression.entity();
		if (function) {
			@function = function->canonical();
			if (reference_raw_function(*function, functions)) {
				return true;
			};
			if (function->role() == function_role::assignment && expression.item(1)->size() && expression.item(1)->item(0)->indirect_storage()) {
				return true;
			};
		};
		Type* signature = expression.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if ((!function || !function->body() || function->dispatch() != function_dispatch::ordinary) && signature->kind() == type_kind::function) {
			usize parameter = 0;
			while (parameter < expression.item(1)->size()) {
				Type* actual_type = expression.item(1)->item(parameter)->type();
				if (actual_type->kind() == type_kind::reference) {
					@actual_type = actual_type->element();
				};
				if (actual_type->kind() == type_kind::pointer) {
					return true;
				};
				@parameter = parameter + 1;
			};
		};
	};
	usize child = 0;
	while (child < expression.size()) {
		if (reference_raw_effects(*expression.item(child), functions)) {
			return true;
		};
		@child = child + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::prepare_unknowns(var ReferenceLoanAnalyzer& this, SemanticUnit& unit) {
	@this.raw_functions.clear();
	@this.raw_globals.clear();
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();
		if (entity->kind() == entity_kind::global) {
			if (entity->type()) {
				if (reference_holder_contents(entity->type())) {
					@this.raw_globals.push_back(entity);
				};
			};
		};
		@index = index + 1;
	};
	while (true) {
		usize previous = this.raw_functions.size();
		@index = 0;
		while (index < unit.entities().size()) {
			var Entity* function = unit.entities().data()[index].get();
			if (function->kind() == entity_kind::function) {
				if (function->body()) {
					if (!(reference_raw_function(*function, this.raw_functions))) {
						if (reference_raw_effects(*function->body(), this.raw_functions)) {
							@this.raw_functions.push_back(function->canonical());
						};
					};
				};
			};
			@index = index + 1;
		};
		if (previous == this.raw_functions.size()) {
			return;
		};
	};
};

fn ReferenceLoanAnalyzer::unknown_event(var ReferenceLoanAnalyzer& this, var Entity* root, ReferenceSlotPath& holding, usize position) {
	usize index = 0;
	while (index < this.unknowns.size()) {
		ReferenceUnknownContent& event = this.unknowns.data()[index];
		if (event.root == root && event.source == position && reference_slot_equal(event.holding, holding)) {
			return;
		};
		@index = index + 1;
	};
	ReferenceUnknownContent event;
	@event.root = root;
	@event.source = position;
	reference_slot_copy(holding, @event.holding);
	@this.unknowns.push_back($event);
};

fn ReferenceLoanAnalyzer::raw_targets(var ReferenceLoanAnalyzer& this, SemanticExpression& pointer, usize operation, usize depth) -> CompilationResult {
	ReferenceSlotPath empty;
	if (depth > 16) {
		@this.unknown_event(nullptr, empty, operation);
		return;
	};
	if ((pointer.kind() == semantic_kind::cast || pointer.kind() == semantic_kind::access || pointer.kind() == semantic_kind::relocation) && pointer.size()) {
		return @this.raw_targets(*pointer.item(0), operation, depth + 1);
	};
	if (pointer.kind() == semantic_kind::address && pointer.size()) {
		SemanticExpression* address = pointer.item(0);
		while ((address->kind() == semantic_kind::access || address->kind() == semantic_kind::cast) && address->size()) {
			@address = address->item(0);
		};
		SemanticExpression& value = *address;
		if (value.kind() == semantic_kind::dereference && value.size()) {
			return @this.raw_targets(*value.item(0), operation, depth + 1);
		};
		if (value.kind() == semantic_kind::member && value.entity() && value.entity()->type()->kind() == type_kind::reference) {
			rt::buffer<ReferenceLoanPlace> targets;
			rt::buffer<ReferenceLoanSubstitution> substitutions;
			if (!(@this.places(value, @targets, @substitutions, nullptr, 0)).has<void>()) {
				return compilation_error();
			};
			usize index = 0;
			while (index < targets.size()) {
				@this.unknown_event(targets.data()[index].root, empty, operation);
				@index = index + 1;
			};
			if (targets.size()) {
				return;
			}
			else {
				@this.unknown_event(nullptr, empty, operation);
				return;
			};
		};
		rt::buffer<ReferenceStoreBinding> bindings;
		var slot = this.store_slot(value, bindings, nullptr, 0);
		@this.unknown_event(slot.root, slot.path, operation);
		return;
	};
	if (pointer.kind() == semantic_kind::name && pointer.entity() && pointer.entity()->kind() == entity_kind::local && pointer.entity()->type()->kind() == type_kind::pointer) {
		var SemanticExpression* initial = this.initializer(*this.function_body, *pointer.entity());
		if (!initial || !(@this.raw_targets(*initial, operation, depth + 1)).has<void>()) {
			if (initial == nullptr) {
				@this.unknown_event(nullptr, empty, operation);
				return;
			}
			else {
				return compilation_error();
			};
		};
		usize index = 0;
		while (index < this.expressions.size()) {
			SemanticExpression& assignment = *this.expressions.data()[index];
			if (assignment.kind() == semantic_kind::binary && (assignment.operation() == token_kind::op_assign || assignment.operation() == token_kind::op_copy) && assignment.item(0)->owned_binding() == pointer.entity() && @this.reachable(this.position(assignment), operation, fact_no_node(), nullptr) && !(@this.raw_targets(*assignment.item(1), operation, depth + 1)).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
		return;
	};
	if (pointer.kind() == semantic_kind::null_pointer) {
		return;
	};
	@this.unknown_event(nullptr, empty, operation);
};

fn ReferenceLoanAnalyzer::raw_write(var ReferenceLoanAnalyzer& this, SemanticExpression& destination, usize operation) -> CompilationResult {
	if (destination.kind() == semantic_kind::dereference || destination.kind() == semantic_kind::index && destination.item(0)->type()->kind() == type_kind::pointer || destination.kind() == semantic_kind::member && destination.item(0)->type()->kind() == type_kind::pointer) {
		return @this.raw_targets(*destination.item(0), operation, 0);
	};
	if (destination.size() && destination.indirect_storage()) {
		return @this.raw_write(*destination.item(0), operation);
	};
};

fn ReferenceLoanAnalyzer::collect_unknowns(var ReferenceLoanAnalyzer& this) -> CompilationResult {
	@this.unknowns.clear();
	bool tracked = false;
	usize candidate = 0;
	while (candidate < this.expressions.size()) {
		if (reference_holder_contents(this.expressions.data()[candidate]->type())) {
			@tracked = true;
			break;
		};
		@candidate = candidate + 1;
	};
	if (!tracked) {
		return;
	};
	usize index = 0;
	while (index < this.expressions.size()) {
		SemanticExpression& expression = *this.expressions.data()[index];
		@index = index + 1;
		usize operation = this.position(expression);
		if (expression.kind() == semantic_kind::construction && expression.size() > 1 && expression.item(1)->indirect_storage() && !(@this.raw_write(*expression.item(1), operation)).has<void>()) {
			return compilation_error();
		};
		if ((expression.kind() == semantic_kind::destruction || expression.kind() == semantic_kind::relocation) && expression.size() && expression.item(0)->indirect_storage() && !(@this.raw_write(*expression.item(0), operation)).has<void>()) {
			return compilation_error();
		};
		if (expression.kind() == semantic_kind::binary && (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy) && expression.item(0)->indirect_storage() && !(@this.raw_write(*expression.item(0), operation)).has<void>()) {
			return compilation_error();
		};
		if (expression.kind() != semantic_kind::call || expression.size() < 2) {
			continue;
		};
		var Entity* function = expression.entity();
		if (function) {
			@function = function->canonical();
			if (function->role() == function_role::assignment && expression.item(1)->size() && expression.item(1)->item(0)->indirect_storage() && !(@this.raw_write(*expression.item(1)->item(0), operation)).has<void>()) {
				return compilation_error();
			};
		};
		bool opaque = !function || function->definition() != function_definition::defaulted && (!function->body() || function->dispatch() != function_dispatch::ordinary);
		bool effects = function && reference_raw_function(*function, this.raw_functions);
		if (!opaque && !effects) {
			continue;
		};
		Type* signature = expression.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function) {
			continue;
		};
		usize argument = 0;
		bool reachable_argument = false;
		while (argument < expression.item(1)->size()) {
			SemanticExpression& actual = *expression.item(1)->item(argument);
			Type* parameter = actual.type();
			if (argument < signature->signature().parameters().size()) {
				@parameter = signature->signature().parameters().data()[argument];
			};
			if (parameter->kind() == type_kind::reference && parameter->element()->kind() == type_kind::pointer) {
				@parameter = parameter->element();
			};
			if (parameter->kind() == type_kind::pointer) {
				if (!(@this.raw_targets(actual, operation, 0)).has<void>()) {
					return compilation_error();
				};
				@reachable_argument = true;
			}
			else if (effects && parameter->kind() == type_kind::reference) {
				rt::buffer<ReferenceStoreBinding> bindings;
				var slot = this.store_slot(actual, bindings, nullptr, 0);
				@this.unknown_event(slot.root, slot.path, operation);
				@reachable_argument = true;
			};
			@argument = argument + 1;
		};
		ReferenceSlotPath empty;
		if (effects) {
			if (!(reachable_argument)) {
				@this.unknown_event(nullptr, empty, operation);
			};
		};
		if (!(@this.visible_raw_targets(operation)).has<void>()) {
			return compilation_error();
		};
		usize global = 0;
		while (global < this.raw_globals.size()) {
			@this.unknown_event(this.raw_globals.data()[global], empty, operation);
			@global = global + 1;
		};
	};
};

fn ReferenceLoanAnalyzer::unknown_path(var ReferenceLoanAnalyzer& this, ReferenceUnknownContent& event, ReferenceStoreSlot& slot, usize target) -> bool {
	if (event.source != fact_no_node() && !@this.reachable(this.graph.entry, event.source, fact_no_node(), nullptr)) {
		return false;
	};
	rt::buffer<usize> pending;
	rt::buffer<usize> visited;
	if (event.source == fact_no_node()) {
		return true;
	}
	else {
		if (target == fact_no_node()) {
			return true;
		}
		else {
			@pending.push_back(usize(event.source));
		};
	};
	usize cursor = 0;
	while (cursor < pending.size()) {
		usize node = pending.data()[cursor];
		@cursor = cursor + 1;
		if (node == target) {
			return true;
		};
		bool seen = false;
		usize index = 0;
		while (index < visited.size()) {
			if (visited.data()[index] == node) {
				@seen = true;
				break;
			};
			@index = index + 1;
		};
		if (seen) {
			continue;
		};
		@visited.push_back(usize(node));
		FactNode& current = this.graph.nodes.data()[node];
		if (node != event.source && current.owner == slot.root && (current.kind == fact_node_kind::lifetime_begin || current.kind == fact_node_kind::lifetime_end)) {
			continue;
		};
		bool restored = false;
		@index = 0;
		while (index < this.stores.size()) {
			ReferenceStoreEffect& replacement = this.stores.data()[index];
			if (replacement.definite && replacement.slot.root == slot.root && this.position(*replacement.site) == node && reference_slot_prefix(replacement.slot.path, slot.path)) {
				@restored = true;
			};
			@index = index + 1;
		};
		@index = 0;
		while (index < this.graph.edges.size()) {
			FactEdge& edge = this.graph.edges.data()[index];
			bool feasible = fact_semantic_edge_feasible(edge) && !(restored && edge.kind != fact_edge_kind::exceptional);
			if (edge.source == node) {
				if (feasible) {
					@pending.push_back(usize(edge.target));
				};
			};
			@index = index + 1;
		};
	};
	return false;
};

fn ReferenceLoanAnalyzer::raw_address_context(ReferenceLoanAnalyzer& this, SemanticExpression& expression, usize depth) -> bool {
	if (depth > 16) {
		return false;
	};
	usize index = 0;
	while (index < this.expressions.size()) {
		SemanticExpression& parent = *this.expressions.data()[index];
		if (parent.size() && parent.item(0) == &expression) {
			if (parent.kind() == semantic_kind::address) {
				return true;
			};
			if ((parent.kind() == semantic_kind::access || parent.kind() == semantic_kind::cast || parent.kind() == semantic_kind::member || parent.kind() == semantic_kind::index) && this.raw_address_context(parent, depth + 1)) {
				return true;
			};
		};
		@index = index + 1;
	};
	return false;
};

fn ReferenceLoanAnalyzer::check_unknown(var ReferenceLoanAnalyzer& this, SemanticExpression& expression, reference_loan_access access) -> CompilationResult {
	if (!this.unknowns.size() || expression.indirect_storage() || this.raw_address_context(expression, 0)) {
		return;
	};
	bool reference_member = expression.kind() == semantic_kind::member && expression.entity() && expression.entity()->type()->kind() == type_kind::reference;
	if (!reference_member && (access != reference_loan_access::read || !reference_loan_members(*expression.type()))) {
		return;
	};
	if (expression.kind() != semantic_kind::name && expression.kind() != semantic_kind::member && expression.kind() != semantic_kind::index && expression.kind() != semantic_kind::variant_cast && expression.kind() != semantic_kind::variant_payload) {
		return;
	};
	rt::buffer<ReferenceStoreBinding> bindings;
	var slot = this.store_slot(expression, bindings, nullptr, 0);
	if (!slot.root || !reference_holder_contents(slot.root->type())) {
		return;
	};
	usize index = 0;
	while (index < this.unknowns.size()) {
		ReferenceUnknownContent& event = this.unknowns.data()[index];
		if ((!event.root || event.root == slot.root) && reference_slot_overlap(event.holding, slot.path) && @this.unknown_path(event, slot, this.position(expression))) {
			return @this.error(expression, "reference contents have unknown provenance after a raw or opaque memory effect");
		};
		@index = index + 1;
	};
};

// A later opaque operation can write through an address previously published to
// global storage or retained by an earlier pointer-taking opaque operation.
fn ReferenceLoanAnalyzer::visible_raw_targets(var ReferenceLoanAnalyzer& this, usize operation) -> CompilationResult {
	usize index = 0;
	while (index < this.expressions.size()) {
		SemanticExpression& source = *this.expressions.data()[index];
		usize position = this.position(source);
		@index = index + 1;
		if (position == fact_no_node() || position == operation || !@this.reachable(position, operation, fact_no_node(), nullptr)) {
			continue;
		};
		if (source.kind() == semantic_kind::binary && (source.operation() == token_kind::op_assign || source.operation() == token_kind::op_copy) && source.item(0)->type()->kind() == type_kind::pointer) {
			rt::buffer<ReferenceStoreBinding> bindings;
			var slot = this.store_slot(*source.item(0), bindings, nullptr, 0);
			if (slot.root && slot.root->kind() == entity_kind::global && !(@this.raw_targets(*source.item(1), operation, 0)).has<void>()) {
				return compilation_error();
			};
		};
		if (source.kind() != semantic_kind::call || source.size() < 2) {
			continue;
		};
		var Entity* callee = source.entity();
		if (callee) {
			@callee = callee->canonical();
		};
		if (callee && callee->body() && callee->dispatch() == function_dispatch::ordinary && !reference_raw_function(*callee, this.raw_functions)) {
			continue;
		};
		Type* signature = source.item(0)->type();
		if (signature->kind() == type_kind::pointer) {
			@signature = signature->element();
		};
		if (signature->kind() != type_kind::function) {
			continue;
		};
		usize parameter = 0;
		while (parameter < source.item(1)->size()) {
			Type* actual_type = source.item(1)->item(parameter)->type();
			if (actual_type->kind() == type_kind::reference) {
				@actual_type = actual_type->element();
			};
			if (actual_type->kind() == type_kind::pointer && !(@this.raw_targets(*source.item(1)->item(parameter), operation, 0)).has<void>()) {
				return compilation_error();
			};
			@parameter = parameter + 1;
		};
	};
};

fn Analyzer::resolve_impl(var Analyzer& this, var Entity* entity) -> CompilationResult {
	if (entity->kind() == entity_kind::template_pattern) {
		return;
	};

	if (entity->state() == entity_state::ready) {
		return;
	};

	if (entity->state() == entity_state::resolving) {
		if (entity->kind() == entity_kind::record && entity->type()) {
			return;
		};

		var message = DiagnosticMessage();
		@message.text("cyclic entity definition for ");
		diagnostic_entity_kind(@message, entity->kind());
		@message.text(" '");
		diagnostic_entity(@message, *entity);
		@message.text("'");
		@this.report(entity->token(), message.view());
		return compilation_error();
	};

	@entity->set_state(entity_state::resolving);
	var Syntax* source = entity->declaration();
	var Scope* scope = entity->resolution_scope();
	entity_kind kind = entity->kind();
	if (kind == entity_kind::field_pack) {
		return @this.resolve_member_pack(@*entity);
	};
	if (kind == entity_kind::pack_binding) {
		var TemplatePack* pack = nullptr;
		if (!(@this.pack_declaration(@*scope, @*source, @pack)).has<void>()) {
			return compilation_error();
		};
		@entity->set_pack($pack);
		@entity->set_state(entity_state::ready);
		return;
	};

	if (kind == entity_kind::record) {
		@entity->set_record_phase(record_resolution_phase::fields);
		@entity->set_type(@this.types->named(type_kind::named, (var Entity*(entity))));
		if (!(@this.expand_member_packs(@*entity)).has<void>()) {
			return compilation_error();
		};

		if (!(@this.resolve_bases((var Entity*(entity)))).has<void>()) {
			return compilation_error();
		};

		usize index = 0;
		while (index < entity->fields().size()) {
			if (!(@this.resolve(entity->fields().data()[index])).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};

		@entity->set_record_phase(record_resolution_phase::members);
		if (!(@this.build_dispatch((var Entity*(entity)))).has<void>()) {
			return compilation_error();
		};

		if (!(@this.supply_special_functions((var Entity*(entity)))).has<void>()) {
			return compilation_error();
		};
		if (!(@this.configure_variant_default(@*entity)).has<void>()) {
			return compilation_error();
		};
		@entity->set_record_phase(record_resolution_phase::complete);
	}
	else if (kind == entity_kind::enumeration) {
		@entity->set_type(@this.types->named(type_kind::named, (var Entity*(entity))));
		Type* underlying = @this.type(@*scope, @*source->enum_underlying());

		if (!underlying) {
			@underlying = this.types->find_primitive("i32");
		};

		if (!underlying->kind().is_integer()) {
			var message = DiagnosticMessage();
			@message.text("declaration '");
			diagnostic_entity(@message, *entity);
			@message.text("': enum underlying type shall be an integer type");
			@message.text("; received '");
			diagnostic_type(@message, *underlying);
			@message.text("'");
			@this.report(source->token(), message.view());
			return compilation_error();
		};

		@entity->set_underlying(underlying);
	}
	else if (kind == entity_kind::namespace_body) {
		@entity->set_state(entity_state::ready);

		return;
	}
	else if (kind == entity_kind::alias) {
		@entity->set_type(@this.type(@*scope, @*source->alias_type()));
	}
	else if (kind == entity_kind::enumerator) {
		var Entity* owner = scope->owner();

		if (!(@this.resolve((var Entity*(owner)))).has<void>()) {
			return compilation_error();
		};

		@entity->set_type(owner->type());
		u64 value = 0;
		rt::buffer<var Entity*>& members = scope->bindings();
		usize index = 0;
		while (index < members.size() && members.data()[index] != entity) {
			var Entity* previous := members.data()[index];

			if (previous->kind() == entity_kind::enumerator) {
				if (!(@this.resolve((var Entity*(previous)))).has<void>()) {
					return compilation_error();
				};

				@value = previous->integer() + 1;
			};

			@index = index + 1;
		};

		if (source->item(1)->kind() != syntax_kind::absent) {
			var initializer = @this.expression(@*scope, @*source->item(1), rt::optional_ref<const Type>(*owner->underlying()));

			if (!initializer.get()) {
				return compilation_error();
			};
			if (!@this.constant_integer(*initializer.get(), @value)) {
				if (this.failed()) {
					return compilation_error();
				};
				var message = DiagnosticMessage();
				@message.text("enumerator '");
				diagnostic_entity(@message, *entity);
				@message.text("' requires an integer constant of underlying type '");
				diagnostic_type(@message, *owner->underlying());
				@message.text("'; initializer has type '");
				diagnostic_type(@message, *initializer.get()->type());
				@message.text("' and is not constant");
				@this.report(source->item(1)->token(), message.view());
				return compilation_error();
			};
		};

		@entity->set_integer($value);
	}
	else if (kind == entity_kind::function) {
		var Scope* local = @this.unit->create_scope(scope, (var Entity*(entity)));

		if (!local) {
			@this.error(source, "out of memory storing function scope");
			return compilation_error();
		};

		@entity->set_members((var Scope*(local)));
		var Scope* signature = @this.unit->create_scope(scope, (var Entity*(entity)));

		if (!signature) {
			@this.error(source, "out of memory storing function signature scope");

			return compilation_error();
		};

		rt::buffer<Type*> signature_parameters;
		parameter_arity arity = parameter_arity::fixed;
		var Syntax* parameters = source->function_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			var Syntax* parameter = parameters->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			Type* resolved = @this.type(@*signature, @*parameter->parameter_type());

			if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type) {
				var message = DiagnosticMessage();
				@message.text("parameter ");
				@message.number(index + 1);
				@message.text(" '");
				diagnostic_name(@message, *parameter->parameter_name());
				@message.text("' of function '");
				diagnostic_entity(@message, *entity);
				@message.text("' requires an object or reference type");
				if (resolved) {
					@message.text("; received '");
					diagnostic_type(@message, *resolved);
					@message.text("'");
				};
				@this.report(parameter->token(), message.view());
				return compilation_error();
			};

			var Syntax* name = parameter->parameter_name();
			Token token = parameter->token();

			if (name->kind() != syntax_kind::absent) {
				@token = name->token();

				if (local->local(token.text())) {
					var message = DiagnosticMessage();
					@message.text("duplicate parameter '");
					@message.text(token.text());
					@message.text("' in function '");
					diagnostic_entity(@message, *entity);
					@message.text("'");
					@this.report(token, message.view());
					@this.diagnostics->note(local->local(token.text())->token(), "previous parameter is declared here");
					return compilation_error();
				};
			};

			var Entity* argument = @this.unit->create_entity(entity_kind::parameter, token, parameter, local);

			if (!argument) {
				return compilation_error();
			};

			@argument->set_resolution_scope((var Scope*(signature)));
			@argument->set_type(resolved);
			@argument->set_index(usize(index));
			@argument->set_state(entity_state::ready);

			@entity->add_parameter($argument);

			@signature_parameters.push_back(resolved);

			@index = index + 1;
		};

		var Syntax* declarator = source->function_name();

		while (declarator->kind() == syntax_kind::qualified_name) {
			@declarator = declarator->right();
		};

		Type* result = @this.type(@*signature, @*source->function_result());

		if (declarator->kind() == syntax_kind::conversion_name) {
			Type* target = @this.type(@*scope, @*declarator->operator_target());

			if (result && result != target) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': conversion function result does not match its named target");
				@message.text("; result is '");
				diagnostic_type(@message, *result);
				@message.text("', target is '");
				if (target) {
					diagnostic_type(@message, *target);
				};
				@message.text("'");
				@this.report(source->token(), message.view());
				return compilation_error();
			};

			@result := target;
			@entity->set_role(function_role::conversion);
		}
		else if (declarator->kind() == syntax_kind::operator_name) {
			@entity->set_operator_kind(token_kind(declarator->operator_token().kind));

			if (declarator->operator_token().kind == token_kind::op_assign || declarator->operator_token().kind == token_kind::op_copy) {
				@entity->set_role(function_role::assignment);
			};
		};

		if (!result) {
			@result = this.types->find_primitive("void");
		};

		bool nonthrowing = false;
		usize specification = 0;
		while (specification < source->function_attributes()->size()) {
			var Syntax* attribute = source->function_attributes()->item(specification);
			@specification = specification + 1;
			if (attribute->kind() != syntax_kind::exception_specification) {
				continue;
			};
			if (!(@this.exception_spec(@*signature, @*attribute, @nonthrowing)).has<void>()) {
				return compilation_error();
			};
			exception_specification contract = exception_specification::potentially_throwing;
			if (nonthrowing) {
				@contract = exception_specification::nonthrowing;
			};
			@entity->set_exception_specification($contract);
		};
		@entity->set_type(@this.types->function(result, $signature_parameters, parameter_arity(arity), $nonthrowing));
		var Entity* owner = entity->scope()->owner();
		bool destructor = declarator->kind() == syntax_kind::unary && declarator->token().kind == token_kind::op_tilde;
		bool constructor = owner && owner->kind() == entity_kind::record && entity->token().same(owner->token());

		if (destructor) {
			@entity->set_role(function_role::destructor);
		}
		else if (constructor) {
			@entity->set_role(function_role::constructor);
		};

		if (destructor || constructor) {
			if (!owner || !entity->parameters().size() || result->kind() != type_kind::void_type || source->function_result()->kind() != syntax_kind::absent) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': constructor or destructor requires an explicit owning-type receiver and no result annotation");
				@message.text("; declared signature is '");
				diagnostic_type(@message, *entity->type());
				@message.text("'");
				@this.report(source->token(), message.view());
				return compilation_error();
			};

			if (constructor) {
				if (entity->parameters().size() == 1) {
					@owner->set_default_constructor(entity);
				}
				else if (entity->parameters().size() == 2) {
					Type* source_type = entity->parameters().data()[1]->type();

					if (source_type == owner->type()) {
						@owner->set_move_constructor(entity);
					}
					else if (source_type->kind() == type_kind::reference && source_type->element()->same_shape(*owner->type()) && source_type->element()->qualifier() == type_qualifier::immutable) {
						@owner->set_copy_constructor(entity);
					};
				};
			};

			Type* receiver = entity->parameters().data()[0]->type();

			if (receiver->kind() != type_kind::reference || receiver->element()->kind() != type_kind::named || receiver->element()->entity() != owner || receiver->element()->qualifier() != type_qualifier::mutable || !entity->parameters().data()[0]->token().is("this") || destructor && entity->parameters().size() != 1) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': constructor or destructor has an invalid owning-type receiver");
				@message.text("; expected first parameter '");
				diagnostic_type(@message, *owner->type());
				@message.text("& this', received '");
				diagnostic_type(@message, *receiver);
				@message.text(" ");
				@message.text(entity->parameters().data()[0]->name());
				@message.text("'");
				if (destructor) {
					@message.text("; destructors require exactly one parameter");
				};
				@this.report(source->token(), message.view());
				return compilation_error();
			};
		};

		if (source->function_body()->kind() != syntax_kind::noop) {
			@entity->set_definition(function_definition::user_defined);
		};

		usize attribute = 0;

		while (attribute < source->function_attributes()->size()) {
			if (source->function_attributes()->item(attribute)->kind() == syntax_kind::exception_specification) {
				@attribute = attribute + 1;
				continue;
			};
			Token token = source->function_attributes()->item(attribute)->token();

			if (token.is("default") || token.is("delete")) {
				if (entity->definition() != function_definition::declaration) {
					var message = DiagnosticMessage();
					@message.text("declaration '");
					diagnostic_entity(@message, *entity);
					@message.text("': function has conflicting definitions");
					@this.report(source->token(), message.view());
					return compilation_error();
				};

				if (token.is("default")) {
					@entity->set_definition(function_definition::defaulted);
				}
				else {
					@entity->set_definition(function_definition::deleted);
				};
			}
			else if (token.is("implicit")) {
				if (!constructor && entity->role() != function_role::conversion) {
					var message = DiagnosticMessage();
					@message.text("declaration '");
					diagnostic_entity(@message, *entity);
					@message.text("': implicit requires a constructor or conversion function");
					@this.report(source->token(), message.view());
					return compilation_error();
				};

				@entity->set_conversion(conversion_mode::implicit_allowed);
			}
			else if (token.is("virtual")) {
				@entity->set_dispatch(function_dispatch::virtual_function);
			}
			else if (token.is("override")) {
				@entity->set_dispatch(function_dispatch::override_function);
			}
			else if (token.is("final")) {
				@entity->set_dispatch(function_dispatch::final_function);
			}
			else {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': unknown function attribute");
				@message.text(" '");
				@message.text(token.text());
				@message.text("'");
				@this.report(source->token(), message.view());
				return compilation_error();
			};

			@attribute = attribute + 1;
		};

		if (entity->role() == function_role::conversion) {
			if (entity->parameters().size() != 1 || arity != parameter_arity::fixed || result->kind() == type_kind::reference) {
				var message = DiagnosticMessage();
				@message.text("conversion '");
				diagnostic_entity(@message, *entity);
				@message.text("' requires one reference parameter and a result matching its target; declared signature is '");
				diagnostic_type(@message, *entity->type());
				@message.text("'");
				@this.report(entity->token(), message.view());
				return compilation_error();
			};

			var Entity* receiver = entity->parameters().data()[0];
			if (receiver->type()->kind() != type_kind::reference) {
				var message = DiagnosticMessage();
				@message.text("conversion '");
				diagnostic_entity(@message, *entity);
				@message.text("' requires one reference parameter and a result matching its target; declared signature is '");
				diagnostic_type(@message, *entity->type());
				@message.text("'");
				@this.report(entity->token(), message.view());
				return compilation_error();
			};

			if (entity->conversion() == conversion_mode::implicit_allowed && receiver->type()->element()->same_shape(*result) && receiver->type()->element()->qualifier() != type_qualifier::immutable) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': self conversion requires a const reference receiver");
				@message.text("; received '");
				diagnostic_type(@message, *receiver->type());
				@message.text("'");
				@this.report(source->token(), message.view());
				return compilation_error();
			};
		};

		if (entity->dispatch() != function_dispatch::ordinary) {
			if (!owner || owner->kind() != entity_kind::record || entity->role() != function_role::ordinary || !entity->parameters().size() || !entity->parameters().data()[0]->token().is("this") || entity->parameters().data()[0]->type()->kind() != type_kind::reference || !entity->parameters().data()[0]->type()->element()->same_shape(*owner->type())) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': virtual operation requires an explicit ordinary class receiver named this");
				@message.text("; declared signature is '");
				diagnostic_type(@message, *entity->type());
				@message.text("'");
				if (entity->parameters().size()) {
					Entity& receiver = *entity->parameters().data()[0];
					@message.text("; first parameter is '");
					diagnostic_type(@message, *receiver.type());
					@message.text(" ");
					@message.text(receiver.name());
					@message.text("'");
				}
				else {
					@message.text("; no receiver parameter was declared");
				};
				if (!owner || owner->kind() != entity_kind::record) {
					@message.text("; enclosing scope is ");
					if (owner) {
						diagnostic_entity_kind(@message, owner->kind());
						@message.text(" '");
						diagnostic_entity(@message, *owner);
						@message.text("'");
					}
					else {
						@message.text("module scope");
					};
				};
				@this.report(source->token(), message.view());
				return compilation_error();
			};

			if (arity == parameter_arity::variadic) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': variadic virtual operations are not implemented");
				@message.text("; declared signature is '");
				diagnostic_type(@message, *entity->type());
				@message.text("'");
				@this.report(source->token(), message.view());
				return compilation_error();
			};
		};

		if (entity->definition() == function_definition::defaulted && entity->role() != function_role::constructor && entity->role() != function_role::destructor && entity->role() != function_role::assignment) {
			var message = DiagnosticMessage();
			@message.text("declaration '");
			diagnostic_entity(@message, *entity);
			@message.text("': this function has no compiler-generated implementation");
			@this.report(source->token(), message.view());
			return compilation_error();
		};

		rt::buffer<var Entity*>& names = entity->scope()->bindings();
		@index = 0;

		while (index < names.size() && names.data()[index] != entity) {
			var Entity* previous = names.data()[index]->canonical();
			if (previous->kind() == entity_kind::function && previous->name() == entity->name() && same_source_module(previous->token().source, entity->token().source) && (previous->linkage() == function_linkage::c || entity->linkage() == function_linkage::c)) {
				if (previous->linkage() != entity->linkage()) {
					@this.error(source, "function redeclaration has incompatible language linkage");
					@this.diagnostics->note(previous->token(), "previous declaration is here");
					return compilation_error();
				};
				if (!previous->type()->signature().matches(entity->type()->signature())) {
					@this.error(source, "C linkage functions cannot be overloaded");
					@this.diagnostics->note(previous->token(), "previous declaration is here");
					return compilation_error();
				};
			};

			if (previous->kind() == entity_kind::function && previous->name() == entity->name() && previous->type()->signature().matches(entity->type()->signature()) && same_source_module(previous->token().source, entity->token().source)) {
				if (previous->nonthrowing() != entity->nonthrowing()) {
					@this.error(source, "function redeclaration has an incompatible exception specification");
					@this.diagnostics->note(previous->token(), "previous declaration is here");
					return compilation_error();
				};
				@previous->merge_dispatch(*entity);
				bool defined = source->function_body()->kind() != syntax_kind::noop;

				if (defined && previous->declaration()->function_body()->kind() != syntax_kind::noop) {
					var message = DiagnosticMessage();
					@message.text("duplicate function definition for '");
					diagnostic_entity(@message, *entity);
					@message.text("' of type '");
					diagnostic_type(@message, *entity->type());
					@message.text("'");
					@this.report(entity->token(), message.view());
					@this.diagnostics->note(previous->token(), "previous definition is here");
					return compilation_error();
				};

				if (defined) {
					@previous->adopt_definition(*entity);
				};

				@entity->merge_into($previous);
				break;
			};

			@index = index + 1;
		};
	}
	else if (kind == entity_kind::global || kind == entity_kind::field) {
		Type* resolved = @this.type(@*scope, @*source->variable_type());

		if (!resolved) {
			var Syntax* initial = source->variable_initializer();

			if (initial->kind() == syntax_kind::unary) {
				@initial = initial->operand();
			};

			var value = @this.expression(@*scope, @*initial, rt::optional_ref<const Type>());

			if (!value.get()) {
				return compilation_error();
			};

			@resolved = @this.infer_variable(@*source, *value.get());
			if (!resolved) {
				return compilation_error();
			};

			if (value.get()->type_use().has_value()) {
				@entity->set_type_use(value.get()->type_use().value());
			};
		};

		if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type || resolved->kind() == type_kind::function) {
			var message = DiagnosticMessage();
			@message.text("declaration '");
			diagnostic_entity(@message, *entity);
			@message.text("': variable requires object storage or a reference");
			@this.report(source->token(), message.view());
			return compilation_error();
		};

		@entity->set_type(resolved);
		Type* element = resolved;

		while (element->kind() == type_kind::array) {
			@element = element->element();
		};

		if (element->kind() == type_kind::named && element->entity()->kind() == entity_kind::record) {
			if ((element->entity()->state() == entity_state::resolving && element->entity()->record_phase() == record_resolution_phase::fields) || element->entity()->declaration()->record_members()->kind() == syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text("declaration '");
				diagnostic_entity(@message, *entity);
				@message.text("': object requires a complete nonrecursive storage type");
				@this.report(source->token(), message.view());
				return compilation_error();
			};
		};
	};

	if (!entity->type()) {
		var message = DiagnosticMessage();
		@message.text("declaration '");
		diagnostic_entity(@message, *entity);
		@message.text("': type could not be resolved");
		@this.report(source->token(), message.view());
		return compilation_error();
	};

	@entity->set_state(entity_state::ready);

};

fn Analyzer::function_body(var Analyzer& this, var Entity* entity) -> CompilationResult {
	if (!(@this.resolve(entity)).has<void>()) {
		return compilation_error();
	};

	@entity = entity->canonical();

	if (entity->body() || entity->body_state() == entity_state::ready) {
		return;
	};

	if (entity->definition() == function_definition::deleted) {
		@this.deleted_function(entity->token(), *entity);
		return compilation_error();
	};

	if (entity->definition() != function_definition::defaulted && (!entity->declaration() || entity->declaration()->function_body()->kind() == syntax_kind::noop)) {
		@entity->set_body_state(entity_state::ready);

		return;
	};

	if (entity->body_state() == entity_state::resolving) {
		return;
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>(@*entity));
	var variant_context = VariantFlowScope(@this.variant_facts);
	if (entity->definition() == function_definition::defaulted && entity->scope()->owner() && variant_instance(*entity->scope()->owner())) {
		if (!(@this.prepare_variant_special(@*entity)).has<void>()) {
			return compilation_error();
		};
		@entity->set_body_state(entity_state::ready);
		return @this.prepare_function_exception(@*entity);
	};

	if (entity->role() == function_role::constructor && entity->scope()->owner()->layout() != record_layout::overlapping && (entity->definition() == function_definition::user_defined || entity->parameters().size() == 1)) {
		var Entity* owner = entity->scope()->owner();
		usize index = 0;
		while (index < owner->bases().size()) {
			if (!(@this.prepare_default(owner->bases().data()[index])).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < owner->fields().size()) {
			var Entity* field = owner->fields().data()[index];

			if (!(@this.field_initializer((var Entity*(field)))).has<void>()) {
				return compilation_error();
			};

			if (!field->body() && !(@this.prepare_default(field->type())).has<void>()) {
				return compilation_error();
			};

			if (field->body() && !(@this.prepare_expression(field->body())).has<void>()) {
				return compilation_error();
			};

			@index = index + 1;
		};
	};

	if (entity->definition() == function_definition::defaulted) {
		Type* receiver = entity->parameters().data()[0]->type()->element();

		if (!(@this.prepare_lifetime(receiver)).has<void>()) {
			return compilation_error();
		};

		var Entity* owner = receiver->entity();

		if (entity->role() == function_role::constructor && entity->parameters().size() == 2 && entity->parameters().data()[1]->type()->kind() == type_kind::reference && owner->layout() != record_layout::overlapping) {
			usize index = 0;
			while (index < owner->bases().size()) {
				if (!(@this.prepare_copy(owner->bases().data()[index])).has<void>()) {
					return compilation_error();
				};

				@index = index + 1;
			};

			@index = 0;

			while (index < owner->fields().size()) {
				if (!(@this.prepare_copy(owner->fields().data()[index]->type())).has<void>()) {
					return compilation_error();
				};

				@index = index + 1;
			};
		};

		if (entity->role() == function_role::assignment) {
			if (entity->parameters().data()[1]->type()->kind() == type_kind::reference) {
				usize index = 0;

				while (index < owner->bases().size()) {
					if (!(@this.prepare_copy_assignment(owner->bases().data()[index])).has<void>()) {
						return compilation_error();
					};

					@index = index + 1;
				};

				@index = 0;

				while (owner->layout() != record_layout::overlapping && index < owner->fields().size()) {
					if (!(@this.prepare_copy_assignment(owner->fields().data()[index]->type())).has<void>()) {
						return compilation_error();
					};

					@index = index + 1;
				};
			}
			else if (owner->move_constructor() && !(@this.function_body(owner->move_constructor())).has<void>()) {
				return compilation_error();
			};
		};

		@entity->set_body_state(entity_state::ready);

		return @this.prepare_function_exception(@*entity);
	};

	var body = @this.expression(@*entity->members(), @*entity->declaration()->function_body(), rt::optional_ref<const Type>());

	if (!body.get()) {
		return compilation_error();
	};

	Type* void_type = this.types->find_primitive("void");
	Type* result_type = entity->type()->signature().result();
	if (entity->completion() != function_completion::no_fallthrough && variant_alternative(result_type, void_type)) {
		var Syntax* source = entity->declaration()->function_body();
		var returned = @this.node(semantic_kind::return_value, void_type, source);
		var success = @this.convert(@this.node(semantic_kind::noop, void_type, source), rt::optional_ref<const Type>(*result_type), @*source);
		if (!returned.get() || !success.get() || !(@returned.get()->append($success)).has<void>() || !(@body.get()->append($returned)).has<void>()) {
			return compilation_error();
		};
	};
	@entity->set_body($body);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::analyze(var Analyzer& this, rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit> {
	rt::unique<SemanticUnit> owned = rt::unique<SemanticUnit>::make();
	if (!owned.get() || !(@this.analyze_into(@*owned.get(), syntax)).has<void>()) {
		return rt::unique<SemanticUnit>();
	};
	return $owned;
};

fn Analyzer::analyze_into(var Analyzer& this, var SemanticUnit& unit, rt::buffer<rt::unique<Syntax>>& syntax) -> CompilationResult {
	@this.templates.clear();
	@this.pending_declarations.clear();
	@this.collection = declaration_collection::owners;
	@this.unit = &@unit;
	var Scope* root = @this.unit->create_scope(nullptr, nullptr);

	if (!root) {
		return compilation_error();
	};

	this.progress.report("collecting", 0, syntax.size(), "");
	usize index = 0;
	while (index < syntax.size() && !this.diagnostics->failed()) {
		@this.unit->record_scope(@*root, @*syntax.data()[index].get());
		if (!((@this.collect(@*root, @*(syntax.data()[index].get()))).has<void>())) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("collecting", index, syntax.size(), "");
	};

	@this.collection = declaration_collection::complete;
	this.progress.report("declarations", 0, this.pending_declarations.size() * 2, "");
	usize pass = 0;
	while (pass < 2) {
		@index = 0;
		while (index < this.pending_declarations.size() && !this.diagnostics->failed()) {
			PendingDeclaration pending := this.pending_declarations.data()[index];
			bool explicit_template = pending.syntax->kind() == syntax_kind::template_declaration;
			if ((pass == 0 && explicit_template) || (pass == 1 && !explicit_template)) {
				access_kind previous = pending.scope->access();
				@pending.scope->set_access(access_kind(pending.access));
				CompilationResult collected = @this.collect(@*pending.scope, @*pending.syntax);
				@pending.scope->set_access(access_kind(previous));
				if (!collected.has<void>()) {
					return compilation_error();
				};
			};
			@index = index + 1;
			this.progress.report("declarations", pass * this.pending_declarations.size() + index, this.pending_declarations.size() * 2, "");
		};
		@pass = pass + 1;
	};
	@this.pending_declarations.clear();

	this.progress.report("validating", 0, this.unit->entities().size(), "");
	@index = 0;
	var validator = TemplateDeclarationValidator();

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		var Entity* pattern = this.unit->entities().data()[index].get();
		if (pattern->kind() == entity_kind::template_pattern && !(@validator.validate(@this, @*pattern)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
		this.progress.report("validating", index, this.unit->entities().size(), "");
	};

	this.progress.report("resolving", 0, this.unit->entities().size(), "");
	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		if (!(@this.resolve(this.unit->entities().data()[index].get())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("resolving", index, this.unit->entities().size(), "");
	};

	this.progress.report("analyzing", 0, this.unit->entities().size(), "");
	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		var Entity* entity = this.unit->entities().data()[index].get();

		if (!(@this.resolve((var Entity*(entity)))).has<void>()) {
			return compilation_error();
		};

		if (entity->kind() == entity_kind::function && !entity->instantiated() && entity->origin() != declaration_origin::compiler_supplied && entity->definition() != function_definition::deleted) {
			this.report_progress("analyzing-function", 0, 0, *entity);
			if (!(@this.function_body((var Entity*(entity)))).has<void>()) {
				return compilation_error();
			};
		};

		if (entity->kind() == entity_kind::field && !entity->instantiated() && !(@this.field_initializer((var Entity*(entity)))).has<void>()) {
			return compilation_error();
		};

		if (entity->kind() == entity_kind::global && !(@this.global_initializer(@*entity)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@this.unit = nullptr;

	if (this.diagnostics->failed()) {
		return compilation_error();
	};

};

struct Scope {
	fn Scope(var Scope& this, var Scope* parent, var Entity* owner);

	fn set_access(var Scope& this, access_kind access);
	fn define(var Scope& this, var Entity* entity);

	fn parent(Scope& this) -> var Scope*;
	fn owner(Scope& this) -> var Entity*;
	fn bindings(Scope& this) -> rt::buffer<var Entity*>&;
	fn access(Scope& this) -> access_kind;
	fn local(Scope& this, rt::string_view name) -> var Entity*;
	fn local_declaration(Scope& this, rt::string_view name, SourceFile* source, entity_kind category) -> var Entity*;
	fn local_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity*;
	fn lookup_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity*;
	fn lookup(Scope& this, rt::string_view name) -> var Entity*;

private:
	var Scope* enclosing;
	var Entity* declaration_owner;
	access_kind visibility;
	rt::buffer<var Entity*> names;
};

fn Scope::Scope(var Scope& this, var Scope* parent, var Entity* owner) {
	@this.enclosing = $parent;
	@this.declaration_owner = $owner;
};

fn Scope::parent(Scope& this) -> var Scope* {
	return this.enclosing;
};

fn Scope::owner(Scope& this) -> var Entity* {
	return this.declaration_owner;
};

fn Scope::bindings(Scope& this) -> rt::buffer<var Entity*>& {
	return this.names;
};

fn Scope::access(Scope& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Scope::set_access(var Scope& this, access_kind access) {
	@this.visibility = $access;
};

fn Scope::local(Scope& this, rt::string_view name) -> var Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity := this.names.data()[index];

		if (entity->name() == name) {
			return $entity;
		};
	};

	return nullptr;
};

fn same_source_module(SourceFile* first, SourceFile* second) -> bool {
	if (!first || !second) {
		return first == second;
	};
	return first->module_name() == second->module_name();
};

fn Scope::local_declaration(Scope& this, rt::string_view name, SourceFile* source, entity_kind category) -> var Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity = this.names.data()[index];
		if (entity->name() == name && (same_source_module(entity->token().source, source) || category == entity_kind::namespace_body && entity->kind() == entity_kind::namespace_body)) {
			return entity;
		};
	};
	return nullptr;
};

fn Scope::local_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity* {
	var Entity* result = nullptr;
	i32 best = 0;
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity = this.names.data()[index];
		if (entity->name() != name) {
			continue;
		};
		i32 rank = 1;
		if (entity->module_exported() || entity->token().source && entity->token().source->test_access()) {
			@rank = 2;
		};
		if (same_source_module(entity->token().source, source)) {
			@rank = 3;
		};
		if (rank > best) {
			@result = entity;
			@best = rank;
			@ambiguous = false;
		}
		else if (rank == best && rank >= 2 && !same_source_module(entity->token().source, result->token().source) && entity->canonical() != result->canonical()) {
			@ambiguous = true;
		};
	};
	return result;
};

fn Scope::lookup_from(Scope& this, rt::string_view name, SourceFile* source, var bool& ambiguous) -> var Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};
	var Entity* result = this.local_from(name, source, @ambiguous);
	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};
	if (result || !this.enclosing) {
		return result;
	};
	return this.enclosing->lookup_from(name, source, @ambiguous);
};

fn Scope::lookup(Scope& this, rt::string_view name) -> var Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};

	var Entity* result = this.local(name);

	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};

	if (result || !this.enclosing) {
		return $result;
	};

	return this.enclosing->lookup(name);
};

fn Scope::define(var Scope& this, var Entity* entity) {
	@this.names.push_back($entity);
};

fn Analyzer::select(var Analyzer& this, var Entity* group, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	rt::buffer<var Entity*> candidates;
	rt::buffer<var Entity*>& bindings = group->scope()->bindings();
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];

		if (candidate->kind() == entity_kind::function && candidate->name() == group->name()) {
			SourceFile* use = syntax.token().source;
			SourceFile* declaration = candidate->token().source;
			if (same_source_module(group->token().source, use) && !same_source_module(declaration, use)) {
				@index = index + 1;
				continue;
			};
			if (declaration && declaration->imported() && !declaration->test_access() && !same_source_module(declaration, use) && !candidate->module_exported()) {
				@index = index + 1;
				continue;
			};
			@candidates.push_back((var Entity*(candidate)));
		};

		@index = index + 1;
	};

	return @this.select_candidates(candidates, arguments, $skipped, $mode, @syntax);
};

fn Analyzer::select_candidates(var Analyzer& this, rt::buffer<var Entity*>& bindings, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	var Entity* selected = nullptr;
	i32 best = i32::max;
	i32 best_receiver = i32::max;
	i32 best_origin = 2;
	rt::buffer<var Entity*> best_matches;
	rt::buffer<var Entity*> seen;
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!(@this.resolve((var Entity*(candidate)))).has<void>()) {
			return nullptr;
		};

		@candidate = candidate->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != candidate) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		@seen.push_back((var Entity*(candidate)));

		if (mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (candidate->parameters().size() < skipped) {
			continue;
		};

		usize fixed = candidate->parameters().size() - skipped;
		bool variadic = candidate->type()->signature().arity() == parameter_arity::variadic;

		if (arguments.size() < fixed || !variadic && arguments.size() != fixed) {
			continue;
		};

		i32 rank = 0;

		if (variadic) {
			@rank = 16;
		};

		usize argument = 0;

		while (argument < fixed) {
			i32 component = @this.argument_rank(*arguments.data()[argument].get(), *candidate->parameters().data()[argument + skipped]->type());

			if (component < 0) {
				@rank = -1;
				break;
			};

			@rank = rank + component;
			@argument = argument + 1;
		};

		i32 receiver = 0;
		if (syntax.kind() == syntax_kind::binary && (syntax.token().kind == token_kind::op_assign || syntax.token().kind == token_kind::op_copy) && !skipped && fixed && candidate->operator_kind() == syntax.token().kind) {
			Type* destination = candidate->parameters().data()[0]->type();
			if (destination->kind() == type_kind::reference) {
				@destination = destination->element();
			};
			if (!arguments.data()[0].get()->type()->same_shape(*destination)) {
				@receiver = 1;
			};
		};
		i32 origin = 0;

		if (candidate->origin() == declaration_origin::compiler_supplied) {
			@origin = 1;
		};

		if (rank < 0 || receiver > best_receiver || receiver == best_receiver && (rank > best || rank == best && origin > best_origin)) {
			continue;
		};

		if (receiver != best_receiver || rank != best || origin != best_origin) {
			@best_matches.clear();
		};
		@best_matches.push_back((var Entity*(candidate)));
		if (receiver == best_receiver && rank == best && origin == best_origin) {
			continue;
		};

		@best_receiver = receiver;
		@best_origin = origin;
		@best := rank;
		@selected := candidate;
	};

	if (best_matches.size() > 1) {
		var message = DiagnosticMessage();
		@message.text("ambiguous call to '");
		diagnostic_entity(@message, *selected);
		@message.text("' with arguments ");
		diagnostic_arguments(@message, arguments);
		@this.diagnostics->error(syntax.token(), message.view());
		usize candidate_index = 0;
		while (candidate_index < best_matches.size()) {
			var Entity* candidate = best_matches.data()[candidate_index];
			@candidate_index = candidate_index + 1;
			var detail = DiagnosticMessage();
			@detail.text("equally ranked candidate '");
			diagnostic_entity(@detail, *candidate);
			@detail.text("' has type '");
			diagnostic_type(@detail, *candidate->type());
			@detail.text("'");
			@this.diagnostics->note(candidate->token(), detail.view());
		};

		return nullptr;
	};

	return $selected;
};

fn Analyzer::overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	rt::buffer<var Entity*> candidates;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		var Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function && candidate->kind() != entity_kind::template_pattern) {
			continue;
		};

		if (candidate->state() == entity_state::ready && candidate->kind() == entity_kind::function) {
			if (candidate->operator_kind() != syntax.token().kind) {
				continue;
			};
		}
		else {
			var Syntax* declaration = candidate->declaration();

			if (!declaration) {
				continue;
			};

			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};

			if (declaration->kind() != syntax_kind::function) {
				continue;
			};

			var Syntax* name = declaration->function_name();

			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};

			if (name->kind() != syntax_kind::operator_name || name->operator_token().kind != syntax.token().kind) {
				continue;
			};
		};

		bool visible = false;
		var Scope* enclosing = &@scope;

		while (enclosing) {
			if (candidate->scope() == enclosing) {
				@visible = true;
			};

			@enclosing = enclosing->parent();
		};

		usize argument = 0;

		while (argument < arguments.size()) {
			Type* type = arguments.data()[argument].get()->type();

			if (type->kind() == type_kind::named) {
				var Entity* owner = type->entity();

				if (candidate->scope() == owner->members() || candidate->scope() == owner->scope()) {
					@visible = true;
				};
			};

			@argument = argument + 1;
		};

		if (!visible) {
			continue;
		};

		if (candidate->kind() == entity_kind::template_pattern) {
			@candidate = @this.templates.deduce(@this, @scope, @*candidate, arguments, @syntax);

			if (!candidate) {
				return rt::unique<SemanticExpression>();
			};
		};

		@candidates.push_back((var Entity*(candidate)));
	};

	var Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @syntax);

	if (!selected) {
		if (!this.diagnostics->failed()) {
			var message = DiagnosticMessage();
			@message.text("no applicable operator ");
			@message.quoted(syntax.token().text());
			@message.text(" for operands ");
			diagnostic_arguments(@message, arguments);
			@this.diagnostics->error(syntax.token(), message.view());
			usize candidate_index = 0;
			while (candidate_index < candidates.size()) {
				var Entity* candidate = candidates.data()[candidate_index];
				@candidate_index = candidate_index + 1;
				if (!candidate->type()) {
					continue;
				};
				var detail = DiagnosticMessage();
				@detail.text("candidate '");
				diagnostic_entity(@detail, *candidate);
				@detail.text("' has type '");
				diagnostic_type(@detail, *candidate->type());
				@detail.text("'");
				@this.diagnostics->note(candidate->token(), detail.view());
			};
		};
		return rt::unique<SemanticExpression>();
	};

	if (selected->definition() == function_definition::deleted) {
		@this.deleted_function(syntax.token(), *selected);
		return rt::unique<SemanticExpression>();
	};
	if (!this.accessible_at(*selected, @scope, syntax.token())) {
		var message = DiagnosticMessage();
		@message.text("selected operator '");
		diagnostic_entity(@message, *selected);
		@message.text("' of type '");
		diagnostic_type(@message, *selected->type());
		@message.text("' is not accessible from this scope");
		@this.diagnostics->error(syntax.token(), message.view());
		@this.diagnostics->note(selected->token(), "operator is declared here");
		return rt::unique<SemanticExpression>();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), &@syntax);

	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	@callable.get()->bind((var Entity*(selected)), value_category::place);

	return @this.invoke(@syntax, selected, $callable, $arguments, expected);
};

fn Analyzer::size_query(var Analyzer& this, var Syntax& syntax, Type& type) -> rt::unique<SemanticExpression> {
	if (!type.has_layout()) {
		var message = DiagnosticMessage();
		@message.text("sizeof requires a complete object storage type; received '");
		diagnostic_type(@message, type);
		@message.text("'");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var operand = @this.node(semantic_kind::noop, &@type, &@syntax);
	var result = @this.node(semantic_kind::sizeof_type, this.types->find_primitive("usize"), &@syntax);

	if (!operand.get() || !result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($operand)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

struct SwitchCase {
	u64 value;
	var Syntax* declaration;
};

struct SwitchAnalysis {
	Type* condition_type;
	Type* source_type;
	rt::buffer<SwitchCase> cases;
	var Syntax* default_label;
};

struct SwitchAnalysisScope {
	fn SwitchAnalysisScope(var SwitchAnalysisScope& this, var SwitchAnalysis var*& slot, var SwitchAnalysis& current);
	fn ~SwitchAnalysisScope(var SwitchAnalysisScope& this);

private:
	var SwitchAnalysis var** slot;
	var SwitchAnalysis* previous;
};

fn Analyzer::selection(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	var condition = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!condition.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* representation = condition.get()->type()->representation();

	if (!representation->kind().is_integer()) {
		var message = DiagnosticMessage();
		@message.text("switch condition requires an integer or enumeration value; received '");
		diagnostic_type(@message, *condition.get()->type());
		@message.text("'");
		@this.report(syntax.item(0)->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	SwitchAnalysis analysis;
	@analysis.condition_type = representation;
	@analysis.source_type = condition.get()->type();
	var context = SwitchAnalysisScope(@this.active_switch, @analysis);
	var body = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());
	@body = @this.discarded(@scope, @*syntax.item(1), rt::unique<SemanticExpression>(@body.release()));

	if (!body.get()) {
		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::switch_expression, this.types->find_primitive("void"), &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($condition)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	if (!(@result.get()->append($body)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::label(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!this.active_switch) {
		var message = DiagnosticMessage();
		@message.quoted(syntax.token().text());
		@message.text(" label requires an enclosing switch");
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::case_label, this.types->find_primitive("void"), &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (syntax.token().kind == token_kind::kw_default) {
		if (this.active_switch->default_label) {
			@this.error(&@syntax, "switch contains more than one default label");
			@this.note(this.active_switch->default_label->token(), "previous default label is here");

			return rt::unique<SemanticExpression>();
		};

		@this.active_switch->default_label = &@syntax;

		return $result;
	};

	var expression = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>(*this.active_switch->condition_type));
	u64 value = 0;

	if (!expression.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@this.constant_integer(*expression.get(), @value)) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		var message = DiagnosticMessage();
		@message.text("case label requires an integer constant expression for switch type '");
		diagnostic_type(@message, *this.active_switch->source_type);
		@message.text("'; expression beginning with ");
		@message.quoted(syntax.item(0)->token().text());
		@message.text(" of type '");
		diagnostic_type(@message, *expression.get()->type());
		@message.text("' is not constant");
		@this.report(syntax.item(0)->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	@value = this.active_switch->condition_type->normalize_integer(value);
	usize index = 0;
	while (index < this.active_switch->cases.size()) {
		SwitchCase& previous = this.active_switch->cases.data()[index];
		if (previous.value == value) {
			var message = DiagnosticMessage();
			@message.text("duplicate switch case value ");
			if (this.active_switch->condition_type->kind() == type_kind::signed_integer && this.active_switch->condition_type->signed_value(value) < 0) {
				@message.text("-");
				@message.number(u64(0) - u64(this.active_switch->condition_type->signed_value(value)));
			}
			else {
				@message.number(value);
			};
			@message.text(" for switch type '");
			diagnostic_type(@message, *this.active_switch->source_type);
			@message.text("'");
			@this.report(syntax.token(), message.view());
			@this.note(previous.declaration->token(), "previous case label is here");

			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	SwitchCase current;
	@current.value = value;
	@current.declaration = &@syntax;
	@this.active_switch->cases.push_back($current);

	@result.get()->set_integer(value);

	return $result;
};

fn SwitchAnalysisScope::SwitchAnalysisScope(var SwitchAnalysisScope& this, var SwitchAnalysis var*& slot, var SwitchAnalysis& current) {
	@this.slot = &@slot;
	@this.previous := slot;
	@slot = &@current;
};

fn SwitchAnalysisScope::~SwitchAnalysisScope(var SwitchAnalysisScope& this) {
	@*this.slot := this.previous;
};

enum template_validation_role : [u08] {
	dependent_type;
	template_type;
	dependent_value;
	pack_signature;
	value;
};

struct TemplateValidationSymbol {
	Token name;
	template_validation_role role;
};

struct TemplateDeclarationValidator {
	fn validate(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Entity& pattern) -> CompilationResult;

private:
	fn dependent(TemplateDeclarationValidator& this, Syntax& syntax) -> bool;
	fn lookup(TemplateDeclarationValidator& this, Token& name) -> TemplateValidationSymbol*;
	fn remember(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Syntax& name, template_validation_role role) -> CompilationResult;
	fn restore(var TemplateDeclarationValidator& this, usize checkpoint, usize frame);
	fn type_names(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult;
	fn declaration(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult;
	fn members(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& owner, var Syntax& body) -> CompilationResult;
	fn certain(TemplateDeclarationValidator& this, var Syntax& syntax) -> var Syntax*;

	rt::buffer<TemplateValidationSymbol> symbols;
	usize frame_start;
};

fn TemplateDeclarationValidator::lookup(TemplateDeclarationValidator& this, Token& name) -> TemplateValidationSymbol* {
	usize index = this.symbols.size();
	while (index) {
		@index = index - 1;
		if (this.symbols.data()[index].name.same(name)) {
			return &@this.symbols.data()[index];
		};
	};
	return nullptr;
};

fn TemplateDeclarationValidator::dependent(TemplateDeclarationValidator& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		TemplateValidationSymbol* symbol = this.lookup(syntax.token());
		return symbol && symbol->role != template_validation_role::value;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.dependent(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn TemplateDeclarationValidator::remember(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Syntax& name, template_validation_role role) -> CompilationResult {
	if (name.kind() != syntax_kind::name) {
		return;
	};
	usize index = this.frame_start;
	while (index < this.symbols.size()) {
		TemplateValidationSymbol& previous = this.symbols.data()[index];
		if (previous.name.same(name.token())) {
			if ((previous.role == template_validation_role::dependent_type || previous.role == template_validation_role::template_type) && (role == template_validation_role::dependent_type || role == template_validation_role::template_type)) {
				return;
			};
			var message = DiagnosticMessage();
			@message.text("duplicate declaration of '");
			diagnostic_name(@message, name);
			@message.text("' in template member scope");
			@analyzer.report(name.token(), message.view());
			@analyzer.note(previous.name, "previous declaration is here");
			return compilation_error();
		};
		@index = index + 1;
	};
	TemplateValidationSymbol symbol;
	@symbol.name = name.token();
	@symbol.role = $role;
	@this.symbols.push_back($symbol);
};

fn TemplateDeclarationValidator::restore(var TemplateDeclarationValidator& this, usize checkpoint, usize frame) {
	while (this.symbols.size() > checkpoint) {
		@this.symbols.pop_back();
	};
	@this.frame_start = $frame;
};

fn TemplateDeclarationValidator::certain(TemplateDeclarationValidator& this, var Syntax& syntax) -> var Syntax* {
	if (syntax.kind() != syntax_kind::ambiguity) {
		return &@syntax;
	};
	if (this.dependent(syntax)) {
		return nullptr;
	};
	var Syntax* selected = nullptr;
	usize index = 0;
	while (index < syntax.size()) {
		var Syntax* candidate = syntax.item(index);
		syntax_kind kind = candidate->kind();
		if (kind == syntax_kind::variable || kind == syntax_kind::function || kind == syntax_kind::record || kind == syntax_kind::enumeration || kind == syntax_kind::using_alias || kind == syntax_kind::template_declaration) {
			if (selected) {
				return nullptr;
			};
			@selected = candidate;
		};
		@index = index + 1;
	};
	return selected;
};

fn TemplateDeclarationValidator::type_names(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult {
	if (syntax.kind() == syntax_kind::record) {
		if (!(@this.remember(@analyzer, @*syntax.record_name(), template_validation_role::dependent_type)).has<void>()) {
			return compilation_error();
		};
		return @this.declaration(@analyzer, @scope, @syntax);
	};
	if (syntax.kind() == syntax_kind::type_tuple || syntax.kind() == syntax_kind::type_variant || syntax.kind() == syntax_kind::type_grouping) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!(@this.type_names(@analyzer, @scope, @*syntax.item(index))).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
		return;
	};
	if (syntax.kind() == syntax_kind::type_name) {
		if (this.dependent(syntax)) {
			var Syntax* name = syntax.designated_type();
			if (name->kind() == syntax_kind::name) {
				TemplateValidationSymbol* symbol = this.lookup(name->token());
				if (symbol && symbol->role == template_validation_role::template_type) {
					@analyzer.semantic_unit()->record_classification(name->token(), 6, 0);
					return;
				};
			};
			return;
		};
		var Syntax* name = syntax.designated_type();
		// Applications have their own argument roles and are checked when instantiated.
		if (name->kind() == syntax_kind::template_apply || name->kind() == syntax_kind::qualified_name) {
			return;
		};
		TemplateValidationSymbol* symbol = this.lookup(name->token());
		if (symbol && symbol->role == template_validation_role::value) {
			var message = DiagnosticMessage();
			@message.text("'");
			diagnostic_name(@message, *name);
			@message.text("' names a value; a type is required here");
			@analyzer.report(name->token(), message.view());
			return compilation_error();
		};
		var Entity* entity = @analyzer.lookup(@scope, @*name);
		if (!entity || !entity->denotes_type()) {
			var message = DiagnosticMessage();
			@message.text("'");
			diagnostic_name(@message, *name);
			@message.text("' does not name a type entity");
			@analyzer.report(name->token(), message.view());
			return compilation_error();
		};
		return;
	};
	if (syntax.kind() == syntax_kind::type_pointer || syntax.kind() == syntax_kind::type_reference || (syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable) || syntax.kind() == syntax_kind::type_array) {
		return @this.type_names(@analyzer, @scope, @*syntax.designated_type());
	};
	if (syntax.kind() == syntax_kind::type_function) {
		if (!(@this.type_names(@analyzer, @scope, @*syntax.function_type_result())).has<void>()) {
			return compilation_error();
		};
		var Syntax* parameters = syntax.function_type_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			if (!(@this.type_names(@analyzer, @scope, @*parameters->item(index)->parameter_type())).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
	};
};

fn TemplateDeclarationValidator::members(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& owner, var Syntax& body) -> CompilationResult {
	usize checkpoint = this.symbols.size();
	usize frame = this.frame_start;
	@this.frame_start = checkpoint;
	usize index = 0;
	while (index < body.size()) {
		var Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::record || member->kind() == syntax_kind::enumeration || member->kind() == syntax_kind::using_alias) {
			var Syntax* name = member->record_name();
			if (member->kind() == syntax_kind::using_alias) {
				@name = member->alias_name();
			};
			if (!(@this.remember(@analyzer, @*name, template_validation_role::dependent_type)).has<void>()) {
				return compilation_error();
			};
		};
	};
	@index = 0;
	while (index < body.size()) {
		var Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::function && owner.kind() == syntax_kind::record) {
			var Syntax* name = member->function_name();
			bool special = name->kind() == syntax_kind::unary || name->kind() == syntax_kind::operator_name && name->operator_token().kind == token_kind::op_assign || name->kind() == syntax_kind::conversion_name || name->kind() == syntax_kind::name && name->token().same(owner.record_name()->token());
			if (special && (!member->function_parameters()->size() || !member->function_parameters()->item(0)->parameter_name()->token().is("this"))) {
				var message = DiagnosticMessage();
				@message.text("instance function '");
				diagnostic_name(@message, *owner.record_name());
				@message.text("::");
				diagnostic_name(@message, *name);
				@message.text("' requires an explicit first reference parameter named 'this'");
				@analyzer.report(name->token(), message.view());
				return compilation_error();
			};
		};
		if (!(@this.declaration(@analyzer, @scope, @*member)).has<void>()) {
			return compilation_error();
		};
		if (member->kind() == syntax_kind::variable && !(@this.remember(@analyzer, @*member->variable_name(), template_validation_role::value)).has<void>()) {
			return compilation_error();
		};
	};
	@this.restore($checkpoint, $frame);
};

fn TemplateDeclarationValidator::declaration(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult {
	if (syntax.kind() == syntax_kind::template_declaration) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		var Syntax* parameters = syntax.template_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			var Syntax* parameter = parameters->item(index);
			var Syntax* type = parameter->template_parameter_type();
			usize prior = 0;
			while (prior < index) {
				if (parameters->item(prior)->template_parameter_name()->token().same(parameter->template_parameter_name()->token())) {
					var message = DiagnosticMessage();
					@message.text("duplicate template parameter '");
					diagnostic_name(@message, *parameter->template_parameter_name());
					@message.text("' at position ");
					@message.number(index + 1);
					@analyzer.report(parameter->template_parameter_name()->token(), message.view());
					@analyzer.note(parameters->item(prior)->template_parameter_name()->token(), "previous template parameter is declared here");
					return compilation_error();
				};
				@prior = prior + 1;
			};
			if (parameter->kind() == syntax_kind::template_variadic_parameter && index + 1 != parameters->size()) {
				@analyzer.error(parameter, "variadic template parameter must be last");
				return compilation_error();
			};
			var Syntax* pack_signature = @analyzer.template_engine()->signature(@analyzer, @scope, @*type);
			if (!pack_signature && type->kind() != syntax_kind::absent && !this.dependent(*type)) {
				Type* resolved = @analyzer.type(@scope, @*type);
				if (!resolved) {
					return compilation_error();
				};
				if (!resolved->kind().is_numeric()) {
					var message = DiagnosticMessage();
					@message.text("non-type template parameter '");
					diagnostic_name(@message, *parameter->template_parameter_name());
					@message.text("' at position ");
					@message.number(index + 1);
					@message.text(" requires an integral type; received '");
					diagnostic_type(@message, *resolved);
					@message.text("'");
					@analyzer.report(parameter->template_parameter_name()->token(), message.view());
					return compilation_error();
				};
			};
			template_validation_role role = template_validation_role::template_type;
			if (type->kind() != syntax_kind::absent) {
				@role = template_validation_role::dependent_value;
			};
			if (!(@this.remember(@analyzer, @*parameter->template_parameter_name(), $role)).has<void>()) {
				return compilation_error();
			};
			if (type->kind() == syntax_kind::absent) {
				@analyzer.semantic_unit()->record_classification(parameter->template_parameter_name()->token(), 6, 1);
			};
			@index = index + 1;
		};
		CompilationResult valid = @this.declaration(@analyzer, @scope, @*syntax.template_declaration());
		@this.restore($checkpoint, $frame);
		return $valid;
	};
	if (syntax.kind() == syntax_kind::record) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		if (!(@this.remember(@analyzer, @*syntax.record_name(), template_validation_role::dependent_type)).has<void>()) {
			@this.restore($checkpoint, $frame);
			return compilation_error();
		};
		CompilationResult valid = @this.members(@analyzer, @scope, @syntax, @*syntax.record_members());
		@this.restore($checkpoint, $frame);
		return $valid;
	};
	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.members(@analyzer, @scope, @syntax, @*syntax.namespace_members());
	};
	if (syntax.kind() == syntax_kind::pack_signature_declaration) {
		return @this.remember(@analyzer, @*syntax.item(0), template_validation_role::pack_signature);
	};
	if (syntax.kind() == syntax_kind::variable) {
		var Syntax* specifier = syntax.variable_type();
		if (specifier->kind() == syntax_kind::pack_expansion) {
			return @this.type_names(@analyzer, @scope, @*specifier->item(0));
		};
		if (specifier->kind() == syntax_kind::type_name && specifier->designated_type()->kind() == syntax_kind::name) {
			TemplateValidationSymbol* symbol = this.lookup(specifier->designated_type()->token());
			if (symbol && symbol->role == template_validation_role::pack_signature) {
				return;
			};
		};
		if (@analyzer.template_engine()->signature(@analyzer, @scope, @*syntax.variable_type())) {
			return;
		};
		return @this.type_names(@analyzer, @scope, @*syntax.variable_type());
	};
	if (syntax.kind() == syntax_kind::using_alias) {
		return @this.type_names(@analyzer, @scope, @*syntax.alias_type());
	};
	if (syntax.kind() == syntax_kind::function) {
		if (!(@this.type_names(@analyzer, @scope, @*syntax.function_result())).has<void>()) {
			return compilation_error();
		};
		usize index = 0;
		while (index < syntax.function_parameters()->size()) {
			if (!(@this.type_names(@analyzer, @scope, @*syntax.function_parameters()->item(index)->parameter_type())).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
	};
};

fn TemplateDeclarationValidator::validate(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Entity& pattern) -> CompilationResult {
	@this.symbols.clear();
	@this.frame_start = 0;
	if (!pattern.declaration() || !pattern.resolution_scope()) {
		return;
	};
	return @this.declaration(@analyzer, @*pattern.resolution_scope(), @*pattern.declaration());
};

enum template_input_kind : [u08] {
	explicit_arguments;
	deduced_arguments;
};

union TemplateInputStorage {
	var Syntax* explicit_arguments;
	rt::buffer<TemplateArgument>* deduced_arguments;
};

struct TemplateInput {
	fn TemplateInput(var TemplateInput& this, var Syntax& arguments);
	fn TemplateInput(var TemplateInput& this, rt::buffer<TemplateArgument>& arguments, Token& request);

	template_input_kind kind;
	TemplateInputStorage storage;
	Token request;
};

fn TemplateInput::TemplateInput(var TemplateInput& this, var Syntax& arguments) {
	@this.kind = template_input_kind::explicit_arguments;
	@this.storage.explicit_arguments = &@arguments;
	@this.request = arguments.token();
};

fn TemplateInput::TemplateInput(var TemplateInput& this, rt::buffer<TemplateArgument>& arguments, Token& request) {
	@this.kind = template_input_kind::deduced_arguments;
	@this.storage.deduced_arguments = &@arguments;
	@this.request := request;
};

struct TemplateInstance {
	var Entity* pattern;
	var Entity* entity;
	rt::buffer<TemplateArgument> arguments;
};

struct TemplateMemberDefinition {
	var Entity* owner;
	var Syntax* source;
	access_kind access;
};

struct TemplateEngine {
	fn argument_syntax(TemplateEngine& this, var Syntax& source, template_argument_kind kind) -> var Syntax*;
	fn aggregate_type(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> Type*;
	fn aggregate_type(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, syntax_kind operation, var TemplatePack& pack) -> Type*;
	fn pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> var TemplatePack*;
	fn signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> var Syntax*;
	fn validate_pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& signature, TemplatePack& pack) -> CompilationResult;
	fn pack_value(var TemplateEngine& this, var Analyzer& analyzer, TemplateArgument& argument, var Syntax& source) -> rt::unique<SemanticExpression>;
	fn collect_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult;
	fn bind_pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Syntax& source, var TemplatePack* pack) -> CompilationResult;

	fn clear(var TemplateEngine& this);
	fn collect(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& source) -> CompilationResult;
	fn editor_context(var TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& arguments) -> var Entity*;
	fn apply(var TemplateEngine& this, var Analyzer& analyzer, var Scope& lookup_scope, var Scope& argument_scope, var Syntax& source) -> var Entity*;
	fn deduce(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity*;
	fn call_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity*;
	fn specialize_call(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::optional_ref<Syntax> supplied, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity*;

	fn qualifier_dependent(TemplateEngine& this, var Syntax& declaration) -> bool;
	fn qualifier(TemplateEngine& this, var Scope& initial, var Syntax& syntax) -> Type*;
	fn instance(TemplateEngine& this, var Entity& entity) -> var TemplateInstance*;

private:
	fn signature_entity(TemplateEngine& this, var Scope& scope, var Syntax& name) -> var Entity*;
	fn normalized_input(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, var Syntax& source, var rt::buffer<TemplateArgument>& result) -> CompilationResult;
	fn check_argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> CompilationResult;
	fn pack_element(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, var TemplateArgument& result) -> CompilationResult;
	fn auto_declaration(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Scope& bindings, var Syntax& declaration, access_kind access) -> CompilationResult;
	fn same_auto_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second) -> bool;
	fn same_type_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second, var Syntax& first_parameters, var Syntax& second_parameters) -> bool;
	fn pattern_owner(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity*;
	fn argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& input, var Syntax& parameter, var Entity& pattern, usize position, var TemplateArgument& result) -> CompilationResult;
	fn instantiation_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& entity, Token& request);
	fn argument_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& parameter, usize position);
	fn bind(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> CompilationResult;
	fn instantiate(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, TemplateInput& input) -> var Entity*;
	fn member_definitions(var TemplateEngine& this, var Analyzer& analyzer, var TemplateInstance& instance) -> CompilationResult;
	fn match(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, TypeUse& actual_use, var Syntax& parameters, var rt::buffer<TemplateArgument>& arguments) -> bool;

	fn same_parameter_expression(TemplateEngine& this, Syntax& first, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool;
	fn auto_argument(TemplateEngine& this, var Syntax& syntax, TypeUse& actual) -> TypeUse*;
	fn has_auto(TemplateEngine& this, var Syntax& syntax) -> bool;
	fn contains(TemplateEngine& this, var Syntax& root, var Syntax& syntax) -> bool;
	fn parameter_count(TemplateEngine& this, var Entity& pattern) -> usize;
	fn explicit_count(TemplateEngine& this, var Entity& pattern) -> usize;
	fn function_source(TemplateEngine& this, var Entity& pattern) -> var Syntax*;
	fn deduced_pattern(TemplateEngine& this, var Syntax& syntax, var Syntax& parameters, usize supplied) -> bool;
	fn qualifications(var TemplateEngine& this, var Analyzer& analyzer, var Syntax& declaration, rt::buffer<rt::unique<SemanticExpression>>& values, var rt::buffer<TemplateArgument>& arguments) -> CompilationResult;
	fn parameter_at(TemplateEngine& this, var Entity& pattern, usize index) -> var Syntax*;
	fn parameter_name(TemplateEngine& this, var Syntax& parameter) -> var Syntax*;
	fn declaration_name(TemplateEngine& this, var Syntax& declaration) -> var Syntax*;
	fn unqualified(TemplateEngine& this, var Syntax& initial) -> var Syntax*;

	rt::buffer<rt::unique<TemplateInstance>> instances;
	rt::buffer<TemplateMemberDefinition> definitions;
};

fn TemplateEngine::clear(var TemplateEngine& this) {
	@this.instances.clear();
	@this.definitions.clear();
};

fn TemplateEngine::instance(TemplateEngine& this, var Entity& entity) -> var TemplateInstance* {
	usize index = 0;
	while (index < this.instances.size()) {
		var TemplateInstance* instance = this.instances.data()[index].get();

		if (instance->entity == &@entity) {
			return $instance;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::declaration_name(TemplateEngine& this, var Syntax& declaration) -> var Syntax* {
	switch (declaration.kind()) {
		case syntax_kind::function:
			return declaration.function_name();
		case syntax_kind::record:
			return declaration.record_name();
		case syntax_kind::namespace_body:
			return declaration.namespace_name();
		case syntax_kind::using_alias:
			return declaration.alias_name();
		case syntax_kind::variable:
			return declaration.variable_name();
		default:
			return nullptr;
	};
};

fn TemplateEngine::unqualified(TemplateEngine& this, var Syntax& initial) -> var Syntax* {
	var Syntax* name = &@initial;
	while (name && name->kind() == syntax_kind::qualified_name) {
		@name = name->right();
	};

	return $name;
};

fn TemplateEngine::pattern_owner(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::template_apply) {
		return @this.pattern_owner(@analyzer, @scope, @*name.callable());
	};

	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name.left());

		if (!owner || !(@analyzer.resolve((var Entity*(owner)))).has<void>()) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner) {
			return nullptr;
		};

		return @this.pattern_owner(@analyzer, @*owner->members(), @*name.right());
	};

	return @analyzer.lookup(@scope, @name);
};

fn TemplateEngine::collect(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& source) -> CompilationResult {
	var Syntax* declaration = &@source;

	if (source.kind() == syntax_kind::template_declaration) {
		@declaration = source.template_declaration();
	};

	var Syntax* name = this.declaration_name(@*declaration);

	if (!name) {
		var message = DiagnosticMessage();
		@message.text("template requires a record, function, namespace, alias, or variable declaration; received construct beginning with ");
		@message.quoted(declaration->token().text());
		@analyzer.report(declaration->token(), message.view());

		return compilation_error();
	};

	if (source.kind() == syntax_kind::template_declaration && declaration->kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name->left());

		if (!owner || owner->kind() != entity_kind::template_pattern) {
			var message = DiagnosticMessage();
			@message.text("template declaration '");
			diagnostic_name(@message, *name);
			@message.text("': qualified template member requires a declared owner template");
			@analyzer.report(source.token(), message.view());

			return compilation_error();
		};

		@analyzer.semantic_unit()->record_name(@analyzer, @scope, @*name->left(), @*owner, 2);
		TemplateMemberDefinition definition;
		@definition.owner = $owner;
		@definition.source = &@source;
		@definition.access = scope.access();

		@this.definitions.push_back($definition);

		return;
	};

	if (name->kind() != syntax_kind::name) {
		if (source.kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
			var Entity* owner = @analyzer.lookup(@scope, @*name->left());
			if (!owner || !(@analyzer.resolve((var Entity*(owner)))).has<void>()) {
				return compilation_error();
			};
			@owner = owner->member_owner();
			if (!owner || !owner->members()) {
				var message = DiagnosticMessage();
				@message.text("template declaration '");
				diagnostic_name(@message, *name);
				@message.text("': qualified function owner has no member scope");
				@analyzer.report(source.token(), message.view());
				return compilation_error();
			};
			@analyzer.semantic_unit()->record_name(@analyzer, @scope, @*name->left(), @*owner, 2);
			return @this.auto_declaration(@analyzer, @*owner->members(), @*owner->members(), @source, scope.access());
		};

		var message = DiagnosticMessage();
		@message.text("template declaration '");
		diagnostic_name(@message, *name);
		@message.text("': requires an unqualified name");
		@analyzer.report(source.token(), message.view());

		return compilation_error();
	};
	if (source.kind() == syntax_kind::function) {
		return @this.auto_declaration(@analyzer, @scope, @scope, @source, scope.access());
	};

	var Entity* previous = scope.local_declaration(name->token().text(), name->token().source, entity_kind::template_pattern);

	if (previous && previous->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text("template declaration '");
		diagnostic_name(@message, *name);
		@message.text("': name conflicts with another declaration");
		@analyzer.report(source.token(), message.view());
		@analyzer.note(previous->token(), "conflicting declaration is here");

		return compilation_error();
	};

	if (previous && declaration->kind() == syntax_kind::record) {
		var Syntax* existing = previous->declaration()->template_declaration();

		if (existing->kind() != syntax_kind::record || previous->declaration()->template_parameters()->size() != source.template_parameters()->size()) {
			var message = DiagnosticMessage();
			@message.text("template redeclaration '");
			diagnostic_name(@message, *name);
			@message.text("' has a different parameter list; previous declaration has ");
			@message.number(previous->declaration()->template_parameters()->size());
			@message.text(" parameters, received ");
			@message.number(source.template_parameters()->size());
			@analyzer.report(source.token(), message.view());
			@analyzer.note(previous->token(), "previous template declaration is here");

			return compilation_error();
		};

		if (declaration->record_members()->kind() != syntax_kind::noop) {
			if (existing->record_members()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text("template declaration '");
				diagnostic_name(@message, *name);
				@message.text("': duplicate template definition");
				@analyzer.report(source.token(), message.view());
				@analyzer.note(previous->token(), "previous template definition is here");

				return compilation_error();
			};

			@previous->replace_declaration(&@source);
		};

		return;
	};

	var Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &@source, &@scope);


	@pattern->set_state(entity_state::ready);

};

fn TemplateEngine::same_parameter_expression(TemplateEngine& this, Syntax& first, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind() || first.size() != second.size()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (!first.size()) {
		usize index = 0;
		while (index < first_parameters.size()) {
			if (first_parameters.item(index)->parameter_name()->token().text() == first.token().text()) {
				return second_parameters.item(index)->parameter_name()->token().text() == second.token().text();
			};
			@index = index + 1;
		};
		return first.token().kind == second.token().kind && first.token().text() == second.token().text();
	};
	if (first.token().kind != second.token().kind) {
		return false;
	};
	usize index = 0;
	while (index < first.size()) {
		if (!this.same_parameter_expression(*first.item(index), *second.item(index), first_parameters, second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn TemplateEngine::same_type_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second, var Syntax& first_parameters, var Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (first.kind() == syntax_kind::type_auto || first.kind() == syntax_kind::type_pointer || first.kind() == syntax_kind::type_reference || (first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_mutable) || first.kind() == syntax_kind::type_array) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first.designated_type(), @second_scope, @*second.designated_type(), @first_parameters, @second_parameters)) {
			return false;
		};
		if ((first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_mutable)) {
			return this.same_parameter_expression(*first.qualifier_condition(), *second.qualifier_condition(), first_parameters, second_parameters);
		};
		if (first.kind() == syntax_kind::type_array) {
			return this.same_parameter_expression(*first.array_extent(), *second.array_extent(), first_parameters, second_parameters);
		};
		return true;
	};
	Type* first_type = @analyzer.type(@first_scope, @first);
	Type* second_type = @analyzer.type(@second_scope, @second);
	return first_type && first_type == second_type;
};

fn TemplateEngine::same_auto_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second) -> bool {
	var Syntax* first_parameters = first.function_parameters();
	var Syntax* second_parameters = second.function_parameters();
	if (first_parameters->size() != second_parameters->size()) {
		return false;
	};
	usize index = 0;
	while (index < first_parameters->size()) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first_parameters->item(index)->parameter_type(), @second_scope, @*second_parameters->item(index)->parameter_type(), @*first_parameters, @*second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return @this.same_type_pattern(@analyzer, @first_scope, @*first.function_result(), @second_scope, @*second.function_result(), @*first_parameters, @*second_parameters);
};

fn TemplateEngine::auto_declaration(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Scope& bindings, var Syntax& declaration, access_kind access) -> CompilationResult {
	var Syntax* name = this.unqualified(@*declaration.function_name());
	usize index = 0;
	while (index < scope.bindings().size()) {
		var Entity* previous = scope.bindings().data()[index];
		@index = index + 1;
		if (previous->name() != name->token().text() || !same_source_module(previous->token().source, name->token().source)) {
			continue;
		};
		if (previous->kind() != entity_kind::template_pattern || previous->declaration()->kind() != syntax_kind::function) {
			var message = DiagnosticMessage();
			@message.text("function template '");
			diagnostic_name(@message, *name);
			@message.text("': name conflicts with another declaration");
			@analyzer.report(declaration.token(), message.view());
			@analyzer.note(previous->token(), "previous declaration is here");
			return compilation_error();
		};
		if (!@this.same_auto_signature(@analyzer, @*previous->resolution_scope(), @*previous->declaration(), @bindings, @declaration)) {
			continue;
		};
		if (declaration.function_body()->kind() != syntax_kind::noop) {
			if (previous->declaration()->function_body()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text("function template '");
				diagnostic_name(@message, *name);
				@message.text("': duplicate function definition");
				@analyzer.report(declaration.token(), message.view());
				@analyzer.note(previous->token(), "previous declaration is here");
				return compilation_error();
			};
			@previous->replace_declaration(&@declaration);
			@previous->set_resolution_scope(&@bindings);
		};
		return;
	};
	var Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &@declaration, &@scope);
	if (!pattern) {
		return compilation_error();
	};
	@pattern->set_resolution_scope(&@bindings);
	@pattern->set_access($access);
	@pattern->set_state(entity_state::ready);
};

fn TemplateEngine::argument_syntax(TemplateEngine& this, var Syntax& source, template_argument_kind kind) -> var Syntax* {
	if (source.kind() != syntax_kind::ambiguity) {
		return &@source;
	};

	usize index = 0;
	while (index < source.size()) {
		var Syntax* candidate = source.item(index);
		bool type = candidate->kind() == syntax_kind::record || candidate->kind() == syntax_kind::type_tuple || candidate->kind() == syntax_kind::type_variant || candidate->kind() == syntax_kind::type_grouping || candidate->kind() == syntax_kind::type_name || candidate->kind() == syntax_kind::type_pointer || candidate->kind() == syntax_kind::type_reference || candidate->kind() == syntax_kind::type_array || (candidate->kind() == syntax_kind::type_const || candidate->kind() == syntax_kind::type_mutable) || candidate->kind() == syntax_kind::type_function;

		if ((kind == template_argument_kind::type) == type) {
			return $candidate;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& input, var Syntax& parameter, var Entity& pattern, usize position, var TemplateArgument& result) -> CompilationResult {
	var Syntax* source = &@input;
	var Syntax* signature = @this.signature(@analyzer, @scope, @*parameter.template_parameter_type());
	if (signature) {
		@result.kind = template_argument_kind::pack;
		@result.pack = @this.pack(@analyzer, @scope, @input);
		if (result.pack && (@this.validate_pack(@analyzer, @scope, @*signature, *result.pack)).has<void>()) {
			return;
		};
		return compilation_error();
	};
	if (parameter.token().kind == token_kind::kw_typename) {
		@result.kind = template_argument_kind::type;
		@source = this.argument_syntax(@*source, template_argument_kind::type);

		if (!source) {
			var message = DiagnosticMessage();
			@message.text("template argument for type parameter ");
			@message.quoted(this.parameter_name(@parameter)->token().text());
			@message.text(" of template '");
			diagnostic_entity(@message, pattern);
			@message.text("' at position ");
			@message.number(position + 1);
			@message.text(" must name a type; received '");
			diagnostic_name(@message, input);
			@message.text("'");
			@analyzer.report(input.token(), message.view());
			@analyzer.note(parameter.token(), "type parameter is declared here");

			return compilation_error();
		};

		@result.type = @analyzer.type(@scope, @*source);

		if (!result.type) {
			this.argument_context(@analyzer, @pattern, @parameter, usize(position));
			return compilation_error();
		};

		TypeUse* use = @analyzer.semantic_unit()->describe_type(@analyzer, @scope, *source, *result.type);

		if (!use) {
			return compilation_error();
		};

		@result.type_use.bind(*use);

		return;
	};

	@result.kind = template_argument_kind::value;
	@source = this.argument_syntax(@*source, template_argument_kind::value);
	Type* expected = @analyzer.type(@scope, @*parameter.template_parameter_type());

	if (!source || source->kind() == syntax_kind::record || source->kind() == syntax_kind::type_tuple || source->kind() == syntax_kind::type_variant || source->kind() == syntax_kind::type_grouping || source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || (source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_mutable) || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		var message = DiagnosticMessage();
		@message.text("template argument for value parameter ");
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(" of template '");
		diagnostic_entity(@message, pattern);
		@message.text("' at position ");
		@message.number(position + 1);
		@message.text(" requires a value expression; received '");
		diagnostic_name(@message, input);
		@message.text("'");
		@analyzer.report(input.token(), message.view());
		@analyzer.note(parameter.token(), "value parameter is declared here");
		return compilation_error();
	};
	if (!expected) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return compilation_error();
	};

	var value = @analyzer.expression(@scope, @*source, rt::optional_ref<const Type>(*expected));

	if (!value.get()) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return compilation_error();
	};
	if (expected->kind() == type_kind::floating_point) {
		ConstantEvaluator evaluator;
		if (!@evaluator.real(@analyzer, *value.get(), @result.real_value)) {
			@analyzer.error(source, "template argument must be a compile-time floating-point value");
			return compilation_error();
		};
		@result.type = expected;
		return;
	};
	if (!@analyzer.constant_integer(*value.get(), @result.value)) {
		var message = DiagnosticMessage();
		@message.text("template argument for value parameter ");
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(" of template '");
		diagnostic_entity(@message, pattern);
		@message.text("' at position ");
		@message.number(position + 1);
		@message.text(" must be an integer constant of type '");
		diagnostic_type(@message, *expected);
		@message.text("'");
		@message.text("; supplied expression '");
		diagnostic_name(@message, *source);
		@message.text("' has type '");
		diagnostic_type(@message, *value.get()->type());
		@message.text("'");
		@analyzer.report(source->token(), message.view());
		@analyzer.note(parameter.token(), "value parameter is declared here");

		return compilation_error();
	};

	@result.type = $expected;

};

fn TemplateEngine::argument_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& parameter, usize position) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text("while checking argument ");
	@message.number(position + 1);
	@message.text(" for parameter ");
	@message.quoted(this.parameter_name(@parameter)->token().text());
	@message.text(" of template '");
	diagnostic_entity(@message, pattern);
	@message.text("'");
	@analyzer.note(parameter.token(), message.view());
};

fn TemplateEngine::bind(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> CompilationResult {
	var Syntax* name = this.parameter_name(@parameter);
	if (argument.kind == template_argument_kind::pack) {
		return @this.bind_pack(@analyzer, @scope, @*name, @parameter, argument.pack);
	};
	entity_kind kind = entity_kind::type_parameter;

	if (argument.kind == template_argument_kind::value) {
		@kind = entity_kind::enumerator;
		if (argument.type->kind() == type_kind::floating_point) {
			@kind = entity_kind::constant;
		};
	};

	var Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), &@parameter, &@scope);


	@entity->set_type(argument.type);
	if (argument.kind == template_argument_kind::value && argument.type->kind() == type_kind::floating_point) {
		var value = @this.pack_value(@analyzer, argument, @parameter);
		@entity->set_body($value);
	};

	if (argument.type_use.has_value()) {
		@entity->set_type_use(argument.type_use.value());
	};

	@entity->set_integer(u64(argument.value));
	@entity->set_state(entity_state::ready);

};

fn TemplateEngine::apply(var TemplateEngine& this, var Analyzer& analyzer, var Scope& lookup_scope, var Scope& argument_scope, var Syntax& source) -> var Entity* {
	var Entity* pattern = @analyzer.lookup(@lookup_scope, @*source.callable());

	if (pattern && pattern->kind() != entity_kind::template_pattern) {
		var TemplateInstance* current = this.instance(@*(var Entity*(pattern)));

		if (current) {
			@pattern = current->pattern;
		};
	};

	if (!pattern || pattern->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text("template arguments for '");
		diagnostic_name(@message, *source.callable());
		@message.text("' require a template declaration");
		if (pattern) {
			@message.text("; resolved declaration is '");
			diagnostic_entity(@message, *pattern);
			@message.text("'");
		};
		@analyzer.report(source.token(), message.view());
		if (pattern) {
			@analyzer.note(pattern->token(), "non-template declaration is here");
		};

		return nullptr;
	};

	if (!analyzer.accessible_at(*pattern, @argument_scope, source.token())) {
		@analyzer.error(&@source, "template is not accessible from this scope");
		@analyzer.note(pattern->token(), "template is declared here");
		return nullptr;
	};

	return @this.instantiate(@analyzer, @argument_scope, @*pattern, TemplateInput(@*source.arguments()));
};

fn TemplateEngine::instantiate(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, TemplateInput& input) -> var Entity* {
	if (analyzer.cancelled()) {
		return nullptr;
	};
	TemplateDeclarationValidator validator;

	if (!(@validator.validate(@analyzer, @pattern)).has<void>()) {
		return nullptr;
	};

	if (input.kind == template_input_kind::explicit_arguments) {
		rt::buffer<TemplateArgument> normalized;
		if (!(@this.normalized_input(@analyzer, @scope, @pattern, @*input.storage.explicit_arguments, @normalized)).has<void>()) {
			return nullptr;
		};
		return @this.instantiate(@analyzer, @scope, @pattern, TemplateInput(normalized, input.request));
	};
	var Syntax* wrapper = pattern.declaration();
	usize parameter_count = this.parameter_count(@pattern);

	if (input.kind == template_input_kind::explicit_arguments && input.storage.explicit_arguments->size() > this.explicit_count(@pattern)) {
		var message = DiagnosticMessage();
		@message.text("too many template arguments for '");
		diagnostic_entity(@message, pattern);
		@message.text("': expected at most ");
		@message.number(u64(this.explicit_count(@pattern)));
		@message.text(", received ");
		@message.number(u64(input.storage.explicit_arguments->size()));
		@analyzer.report(input.storage.explicit_arguments->token(), message.view());
		@analyzer.note(pattern.token(), "template is declared here");

		return nullptr;
	};

	var Scope* bindings = @analyzer.semantic_unit()->create_scope(pattern.resolution_scope(), pattern.scope()->owner());


	var instance = rt::unique<TemplateInstance>(new TemplateInstance());

	if (!instance.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(TemplateInstance);
		throw $error;
	};

	@instance.get()->pattern = &@pattern;
	usize index = 0;
	while (index < parameter_count) {
		var Syntax* parameter = this.parameter_at(@pattern, index);
		TemplateArgument argument;

		if (input.kind == template_input_kind::explicit_arguments && index < input.storage.explicit_arguments->size()) {
			if (!(@this.argument(@analyzer, @scope, @*input.storage.explicit_arguments->item(index), @*parameter, @pattern, usize(index), @argument)).has<void>()) {
				return nullptr;
			};
		}
		else if (input.kind == template_input_kind::deduced_arguments && index < input.storage.deduced_arguments->size() && input.storage.deduced_arguments->data()[index].kind != template_argument_kind::unbound) {
			@argument := input.storage.deduced_arguments->data()[index];
		}
		else if (parameter->kind() == syntax_kind::template_variadic_parameter) {
			@argument.kind = template_argument_kind::pack;
			@argument.pack = @analyzer.semantic_unit()->create_pack();
		}
		else {
			var Syntax* fallback = nullptr;

			if (parameter->kind() == syntax_kind::template_parameter) {
				@fallback = parameter->template_parameter_default();
			};

			if (!fallback || fallback->kind() == syntax_kind::absent) {
				var message = DiagnosticMessage();
				@message.text("missing argument for template parameter ");
				@message.quoted(this.parameter_name(@*parameter)->token().text());
				@message.text(" of '");
				diagnostic_entity(@message, pattern);
				@message.text("'; the argument could not be deduced and has no default");
				@analyzer.report(input.request, message.view());
				@analyzer.note(parameter->token(), "template parameter is declared here");

				return nullptr;
			};

			if (!(@this.argument(@analyzer, @*bindings, @*fallback, @*parameter, @pattern, usize(index), @argument)).has<void>()) {
				if (analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text("while evaluating default argument for parameter ");
					@message.quoted(this.parameter_name(@*parameter)->token().text());
					@message.text(" of template '");
					diagnostic_entity(@message, pattern);
					@message.text("'");
					@analyzer.note(fallback->token(), message.view());
					@analyzer.note(input.request, "template instantiation is requested here");
				};
				return nullptr;
			};
		};

		if (index < this.explicit_count(@pattern) && !(@this.bind(@analyzer, @*bindings, @*parameter, argument)).has<void>()) {
			return nullptr;
		};

		@instance.get()->arguments.push_back($argument);

		@index = index + 1;
	};

	@index = 0;

	while (index < this.instances.size()) {
		var TemplateInstance* existing = this.instances.data()[index].get();
		@index = index + 1;

		if (existing->pattern != &@pattern || existing->arguments.size() != instance.get()->arguments.size()) {
			continue;
		};

		usize argument = 0;

		while (argument < existing->arguments.size() && existing->arguments.data()[argument].same(instance.get()->arguments.data()[argument])) {
			@argument = argument + 1;
		};

		if (argument == existing->arguments.size()) {
			return existing->entity;
		};
	};

	var Syntax* declaration = wrapper;

	if (wrapper->kind() == syntax_kind::template_declaration) {
		@declaration = wrapper->template_declaration();
	};

	var Syntax* name = this.unqualified(@*this.declaration_name(@*declaration));
	entity_kind kind = entity_kind::record;

	if (declaration->kind() == syntax_kind::function) {
		@kind = entity_kind::function;
	}
	else if (declaration->kind() == syntax_kind::namespace_body) {
		@kind = entity_kind::namespace_body;
	}
	else if (declaration->kind() == syntax_kind::using_alias) {
		@kind = entity_kind::alias;
	}
	else if (declaration->kind() == syntax_kind::variable) {
		@kind = entity_kind::global;
		if (@this.signature(@analyzer, @*bindings, @*declaration->variable_type())) {
			@kind = entity_kind::pack_binding;
		};
	};

	var Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), declaration, bindings);


	@entity->set_access(pattern.access());
	@instance.get()->entity = entity;
	@entity->set_instantiated();
	@analyzer.semantic_unit()->record_origin(@*entity, @pattern, instance.get()->arguments, this.explicit_count(@pattern));
	var TemplateInstance* published = instance.get();
	analyzer.report_progress("instantiating-template", 0, 0, *entity);

	@this.instances.push_back($instance);

	// Publish the canonical identity before members can recursively refer to the instance.
	if (entity->kind() == entity_kind::record || entity->kind() == entity_kind::namespace_body) {
		var Scope* members = @analyzer.semantic_unit()->create_scope(bindings, (var Entity*(entity)));


		@entity->set_members((var Scope*(members)));
		var Syntax* body = declaration->record_members();

		if (entity->kind() == entity_kind::namespace_body) {
			@body = declaration->namespace_members();
		};

		if (!(@analyzer.collect(@*members, @*body)).has<void>() || !(@this.member_definitions(@analyzer, @*published)).has<void>()) {
			this.instantiation_context(@analyzer, @*entity, input.request);
			return nullptr;
		};
	};

	if (!(@analyzer.resolve((var Entity*(entity)))).has<void>()) {
		this.instantiation_context(@analyzer, @*entity, input.request);
		return nullptr;
	};

	return $entity;
};

fn TemplateEngine::instantiation_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& entity, Token& request) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text("while instantiating '");
	diagnostic_entity(@message, entity);
	@message.text("' requested here");
	@analyzer.note(request, message.view());
};

fn TemplateEngine::member_definitions(var TemplateEngine& this, var Analyzer& analyzer, var TemplateInstance& instance) -> CompilationResult {
	usize index = 0;
	while (index < this.definitions.size()) {
		TemplateMemberDefinition definition := this.definitions.data()[index];
		@index = index + 1;

		if (definition.owner != instance.pattern) {
			continue;
		};

		var Syntax* parameters = definition.source->template_parameters();

		if (parameters->size() != instance.arguments.size()) {
			var message = DiagnosticMessage();
			@message.text("member definition '");
			diagnostic_name(@message, *definition.source->template_declaration()->function_name());
			@message.text("' has ");
			@message.number(parameters->size());
			@message.text(" template parameters; owning template '");
			diagnostic_entity(@message, *instance.pattern);
			@message.text("' requires ");
			@message.number(instance.arguments.size());
			@analyzer.report(definition.source->token(), message.view());
			@analyzer.note(instance.pattern->token(), "owning template is declared here");

			return compilation_error();
		};

		var Scope* bindings = @analyzer.semantic_unit()->create_scope(instance.entity->members(), (var Entity*(instance.entity)));


		usize parameter = 0;

		while (parameter < parameters->size()) {
			if (!(@this.bind(@analyzer, @*bindings, @*parameters->item(parameter), instance.arguments.data()[parameter])).has<void>()) {
				return compilation_error();
			};

			@parameter = parameter + 1;
		};

		var Syntax* declaration = definition.source->template_declaration();
		var Syntax* name = this.unqualified(@*declaration->function_name());
		entity_kind category = entity_kind::function;

		if (this.qualifier_dependent(@*declaration)) {
			if (!(@this.auto_declaration(@analyzer, @*instance.entity->members(), @*bindings, @*declaration, access_kind(definition.access))).has<void>()) {
				return compilation_error();
			};
			continue;
		};

		var Entity* function = @analyzer.semantic_unit()->create_entity($category, name->token(), declaration, instance.entity->members());

		if (!function) {
			return compilation_error();
		};

		@function->set_access(access_kind(definition.access));
		@function->set_resolution_scope($bindings);

		if (function->kind() == entity_kind::template_pattern) {
			@function->set_state(entity_state::ready);
		};
	};

};

fn TemplateEngine::match(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, TypeUse& actual_use, var Syntax& parameters, var rt::buffer<TemplateArgument>& arguments) -> bool {
	Type* actual = &@actual_use.type();
	TypeUse* use = &@actual_use;

	if (syntax.kind() == syntax_kind::type_auto) {
		Type* unqualified = @analyzer.type_store()->qualified(*actual, type_qualifier::mutable);
		@use = @analyzer.semantic_unit()->retype_use(*use, *unqualified);

		return use && @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_name) {
		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_reference || (syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable)) {
		if (actual->kind() == type_kind::reference) {
			@actual = actual->element();
			@use = &@use->element();
		};

		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_pointer) {
		return actual->kind() == type_kind::pointer && @this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_array) {
		if (actual->kind() != type_kind::array || !@this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments)) {
			return false;
		};

		var Syntax* extent = syntax.array_extent();
		usize index = 0;
		while (index < parameters.size()) {
			var Syntax* parameter = parameters.item(index);

			if (parameter->token().kind != token_kind::kw_typename && parameter->template_parameter_name()->token().text() == extent->token().text()) {
				var TemplateArgument* argument = (@arguments).data() + index;
				Type* type = @analyzer.type(@scope, @*parameter->template_parameter_type());

				if (!type || argument->type && argument->value != actual->count()) {
					return false;
				};

				@argument->kind = template_argument_kind::value;
				@argument->type = $type;
				@argument->value = actual->count();

				return true;
			};

			@index = index + 1;
		};

		u64 expected = 0;

		return (@analyzer.integer(@*extent, @expected)).has<void>() && expected == actual->count();
	};

	if (syntax.kind() == syntax_kind::name) {
		usize index = 0;
		while (index < parameters.size()) {
			var Syntax* parameter = parameters.item(index);

			if (parameter->token().kind == token_kind::kw_typename && parameter->template_parameter_name()->token().text() == syntax.token().text()) {
				var TemplateArgument* argument = (@arguments).data() + index;

				if (argument->type && argument->type != actual) {
					return false;
				};

				@argument->kind = template_argument_kind::type;
				@argument->type = $actual;

				if (!argument->type_use.has_value()) {
					@argument->type_use.bind(*use);
				};

				return true;
			};

			@index = index + 1;
		};
	};

	var Syntax* application = &@syntax;

	if (syntax.kind() == syntax_kind::qualified_name) {
		@application = syntax.right();
	};

	if (application->kind() == syntax_kind::template_apply && actual->kind() == type_kind::named) {
		var TemplateInstance* instance = this.instance(@*actual->entity());
		var Entity* pattern = @this.pattern_owner(@analyzer, @scope, @syntax);

		if (!instance || instance->pattern != pattern) {
			return false;
		};

		rt::buffer<TemplateArgument> actual_arguments;
		usize position = 0;
		while (position < instance->arguments.size()) {
			TemplateArgument& argument = instance->arguments.data()[position];
			var Syntax* parameter = this.parameter_at(@*pattern, position);
			if (parameter->kind() == syntax_kind::template_variadic_parameter) {
				usize element = 0;
				while (element < argument.pack->elements.size()) {
					TemplateArgument copy := argument.pack->elements.data()[element];
					@actual_arguments.push_back($copy);
					@element = element + 1;
				};
			}
			else {
				TemplateArgument copy := argument;
				@actual_arguments.push_back($copy);
			};
			@position = position + 1;
		};
		usize index = 0;
		while (index < application->arguments()->size()) {
			var Syntax* pattern_source = application->arguments()->item(index);
			if (pattern_source->kind() == syntax_kind::ambiguity) {
				usize candidate = 0;
				while (candidate < pattern_source->size()) {
					if (pattern_source->item(candidate)->kind() == syntax_kind::pack_expansion) {
						@pattern_source = pattern_source->item(candidate);
						break;
					};
					@candidate = candidate + 1;
				};
			};
			if (pattern_source->kind() == syntax_kind::pack_expansion) {
				if (index + 1 != application->arguments()->size()) {
					return false;
				};
				var Syntax* name = pattern_source->item(0);
				if (name->kind() == syntax_kind::type_name) {
					@name = name->designated_type();
				};
				if (name->kind() != syntax_kind::name) {
					return false;
				};
				usize parameter = 0;
				while (parameter < parameters.size() && parameters.item(parameter)->template_parameter_name()->token().text() != name->token().text()) {
					@parameter = parameter + 1;
				};
				if (parameter >= parameters.size() || parameters.item(parameter)->kind() != syntax_kind::template_variadic_parameter) {
					return false;
				};
				var TemplatePack* pack = @analyzer.semantic_unit()->create_pack();
				if (!pack) {
					return false;
				};
				usize element = index;
				while (element < actual_arguments.size()) {
					TemplateArgument& argument = actual_arguments.data()[element];
					if (!(@this.check_argument(@analyzer, @scope, @*parameters.item(parameter), argument)).has<void>()) {
						return false;
					};
					PackElementSignature exact;
					@exact.kind = argument.kind;
					if (argument.kind == template_argument_kind::value) {
						@exact.value_type = argument.type;
					};
					TemplateArgument copy := argument;
					@pack->signature.push_back($exact);
					@pack->elements.push_back($copy);
					@element = element + 1;
				};
				TemplateArgument collected;
				@collected.kind = template_argument_kind::pack;
				@collected.pack = pack;
				var TemplateArgument* bound = (@arguments).data() + parameter;
				if (bound->kind != template_argument_kind::unbound && !bound->same(collected)) {
					return false;
				};
				@*bound := collected;
				return true;
			};
			if (index >= actual_arguments.size()) {
				return false;
			};
			TemplateArgument& argument = actual_arguments.data()[index];
			var Syntax* argument_source = this.argument_syntax(@*pattern_source, template_argument_kind(argument.kind));

			if (!argument_source) {
				return false;
			};

			if (argument.kind == template_argument_kind::type) {
				TypeUse* argument_use = argument.type_use.get();

				if (!argument_use) {
					@argument_use = @analyzer.semantic_unit()->canonical_use(*argument.type);
				};

				if (!argument_use || !@this.match(@analyzer, @scope, @*argument_source, *argument_use, @parameters, @arguments)) {
					return false;
				};
			}
			else {
				usize parameter = 0;

				while (parameter < parameters.size()) {
					var Syntax* name = parameters.item(parameter)->template_parameter_name();

					if (name->token().text() == argument_source->token().text()) {
						break;
					};

					@parameter = parameter + 1;
				};

				if (parameter < parameters.size()) {
					var TemplateArgument* bound = (@arguments).data() + parameter;

					if (bound->kind != template_argument_kind::unbound && !bound->same(argument)) {
						return false;
					};

					@*bound := argument;
				}
				else if (argument.kind == template_argument_kind::pack) {
					TemplateArgument expected;
					@expected.kind = template_argument_kind::pack;
					@expected.pack = @this.pack(@analyzer, @scope, @*argument_source);
					if (!expected.pack || !expected.same(argument)) {
						return false;
					};
				}
				else {
					var value = @analyzer.expression(@scope, @*argument_source, rt::optional_ref<const Type>(*argument.type));
					if (!value.get()) {
						return false;
					};
					if (argument.type->kind() == type_kind::floating_point) {
						f64 expected = 0.0;
						ConstantEvaluator evaluator;
						if (!@evaluator.real(@analyzer, *value.get(), @expected) || expected != argument.real_value) {
							return false;
						};
					}
					else {
						u64 expected = 0;
						if (!@analyzer.constant_integer(*value.get(), @expected) || expected != argument.value) {
							return false;
						};
					};
				};
			};

			@index = index + 1;
		};

		usize target_parameters = this.explicit_count(@*pattern);
		if (target_parameters && this.parameter_at(@*pattern, target_parameters - 1)->kind() == syntax_kind::template_variadic_parameter) {
			return application->arguments()->size() == actual_arguments.size();
		};
		return true;
	};

	Type* expected = @analyzer.type(@scope, @syntax);

	return expected && expected == actual;
};

fn TemplateEngine::call_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity* {
	var Syntax* application = &@name;
	var Scope* lookup = &@scope;

	if (name.kind() == syntax_kind::qualified_name) {
		@application = name.right();
	};

	if (application->kind() != syntax_kind::template_apply) {
		return nullptr;
	};

	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @analyzer.lookup(@scope, @*name.left());

		if (!owner || !(@analyzer.resolve((var Entity*(owner)))).has<void>()) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner || !owner->members()) {
			return nullptr;
		};

		@lookup = owner->members();
	};

	var Entity* pattern = @analyzer.lookup(@*lookup, @*application->callable());

	if (!pattern || pattern->kind() != entity_kind::template_pattern || !this.function_source(@*pattern)) {
		return nullptr;
	};

	return pattern;
};

fn TemplateEngine::deduced_pattern(TemplateEngine& this, var Syntax& syntax, var Syntax& parameters, usize supplied) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		usize index = supplied;
		while (index < parameters.size()) {
			if (parameters.item(index)->template_parameter_name()->token().text() == syntax.token().text()) {
				return true;
			};

			@index = index + 1;
		};
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.deduced_pattern(@*syntax.item(index), @parameters, usize(supplied))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifications(var TemplateEngine& this, var Analyzer& analyzer, var Syntax& declaration, rt::buffer<rt::unique<SemanticExpression>>& values, var rt::buffer<TemplateArgument>& arguments) -> CompilationResult {
	usize index = 0;
	while (index < values.size()) {
		var Syntax* parameter = declaration.function_parameters()->item(index);
		var SemanticExpression* value = values.data()[index].get();
		@index = index + 1;

		if (!this.has_auto(@*parameter->parameter_type())) {
			continue;
		};

		TypeUse* use = value->type_use().get();

		if (!use) {
			@use = @analyzer.semantic_unit()->canonical_use(*value->type());
		};

		if (!use) {
			return compilation_error();
		};

		@use = this.auto_argument(@*parameter->parameter_type(), *use);

		if (!use) {
			return compilation_error();
		};

		bool readonly = use->type().qualifier() == type_qualifier::immutable || parameter->parameter_type()->kind() == syntax_kind::type_reference && !value->mutable_access();
		type_qualifier qualifier = type_qualifier::mutable;

		if (readonly) {
			@qualifier = type_qualifier::immutable;
		};

		TemplateArgument argument;
		@argument.kind = template_argument_kind::value;
		@argument.type = @analyzer.type_store()->qualified(*analyzer.type_store()->find_primitive("bool"), $qualifier);
		@argument.value = static_cast<u64>($readonly);

		if (argument.type) {
			@arguments.push_back($argument);
		}
		else {
			return compilation_error();
		};
	};

};

fn TemplateEngine::deduce(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity* {
	return @this.specialize_call(@analyzer, @scope, @pattern, rt::optional_ref<Syntax>(), values, @request);
};

fn TemplateEngine::specialize_call(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::optional_ref<Syntax> supplied, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity* {
	if (!analyzer.accessible_at(pattern, @scope, request.token())) {
		@analyzer.error(&@request, "function template is not accessible from this scope");
		@analyzer.note(pattern.token(), "template is declared here");
		return nullptr;
	};
	var Syntax* declaration = this.function_source(@pattern);

	if (!declaration || declaration->function_parameters()->size() != values.size()) {
		var message = DiagnosticMessage();
		@message.text("function template '");
		diagnostic_entity(@message, pattern);
		if (declaration) {
			@message.text("' expects ");
			@message.number(u64(declaration->function_parameters()->size()));
			@message.text(" call arguments, received ");
			@message.number(u64(values.size()));
			@message.text(" with types ");
			diagnostic_arguments(@message, values);
		}
		else {
			@message.text("' does not declare a callable function");
		};
		@analyzer.report(request.token(), message.view());
		@analyzer.note(pattern.token(), "template is declared here");
		return nullptr;
	};

	usize visible = this.explicit_count(@pattern);
	usize provided = 0;
	rt::buffer<TemplateArgument> arguments;
	if (supplied.has_value()) {
		if (!(@this.normalized_input(@analyzer, @scope, @pattern, @supplied.value(), @arguments)).has<void>()) {
			return nullptr;
		};
		@provided = arguments.size();
	};
	usize index = arguments.size();
	while (index < visible) {
		TemplateArgument argument;
		@arguments.push_back($argument);
		@index = index + 1;
	};

	if (visible) {
		var Syntax* parameters = pattern.declaration()->template_parameters();
		@index = 0;

		while (index < values.size()) {
			var Syntax* parameter = declaration->function_parameters()->item(index)->parameter_type();
			var SemanticExpression* value = values.data()[index].get();
			@index = index + 1;

			if (!this.deduced_pattern(@*parameter, @*parameters, usize(provided))) {
				continue;
			};

			TypeUse* use = value->type_use().get();

			if (!use) {
				@use = @analyzer.semantic_unit()->canonical_use(*value->type());
			};

			if (!use || !@this.match(@analyzer, @*pattern.scope(), @*parameter, *use, @*parameters, @arguments)) {
				if (!analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text("cannot deduce template arguments for '");
					diagnostic_entity(@message, pattern);
					@message.text("' with arguments ");
					diagnostic_arguments(@message, values);
					@message.text(": call argument ");
					@message.number(u64(index));
					@message.text(" of type '");
					diagnostic_type(@message, *value->type());
					@message.text("' does not match parameter ");
					@message.number(u64(index));
					var Syntax* parameter_name = declaration->function_parameters()->item(index - 1)->parameter_name();
					if (parameter_name && parameter_name->kind() != syntax_kind::absent) {
						@message.text(" ");
						@message.quoted(parameter_name->token().text());
					};
					@analyzer.report(request.token(), message.view());
					@analyzer.note(pattern.token(), "function template is declared here");
					@analyzer.note(parameter->token(), "deduction failed for this parameter type");
					usize binding = 0;
					while (binding < visible && binding < arguments.size()) {
						TemplateArgument& bound = arguments.data()[binding];
						var Syntax* bound_parameter = this.parameter_at(@pattern, binding);
						@binding = binding + 1;
						if (!bound.type) {
							continue;
						};
						var binding_message = DiagnosticMessage();
						@binding_message.text("template parameter ");
						@binding_message.quoted(this.parameter_name(@*bound_parameter)->token().text());
						if (bound.kind == template_argument_kind::type) {
							@binding_message.text(" is bound to type '");
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text("'");
						}
						else {
							@binding_message.text(" is bound to value ");
							if (bound.type->kind() == type_kind::signed_integer && bound.type->signed_value(bound.value) < 0) {
								@binding_message.text("-");
								@binding_message.number(u64(0) - u64(bound.type->signed_value(bound.value)));
							}
							else {
								@binding_message.number(bound.value);
							};
							@binding_message.text(" of type '");
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text("'");
						};
						@analyzer.note(bound_parameter->token(), binding_message.view());
					};
				};
				return nullptr;
			};
		};
	};

	if (!(@this.qualifications(@analyzer, @*declaration, values, @arguments)).has<void>()) {
		if (!analyzer.failed()) {
			var message = DiagnosticMessage();
			@message.text("cannot deduce automatic qualification for function template '");
			diagnostic_entity(@message, pattern);
			@message.text("' with argument types ");
			diagnostic_arguments(@message, values);
			@analyzer.report(request.token(), message.view());
			@analyzer.note(pattern.token(), "function template is declared here");
		};
		return nullptr;
	};

	return @this.instantiate(@analyzer, @scope, @pattern, TemplateInput(arguments, request.token()));
};

fn TemplateEngine::has_auto(TemplateEngine& this, var Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_auto) {
		return true;
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.has_auto(@*syntax.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::contains(TemplateEngine& this, var Syntax& root, var Syntax& syntax) -> bool {
	if (&@root == &@syntax) {
		return true;
	};

	usize index = 0;
	while (index < root.size()) {
		if (this.contains(@*root.item(index), @syntax)) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifier_dependent(TemplateEngine& this, var Syntax& declaration) -> bool {
	return declaration.kind() == syntax_kind::function && this.has_auto(@*declaration.function_parameters());
};

fn TemplateEngine::function_source(TemplateEngine& this, var Entity& pattern) -> var Syntax* {
	var Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};

	if (source->kind() != syntax_kind::function) {
		return nullptr;
	};

	return source;
};

fn TemplateEngine::explicit_count(TemplateEngine& this, var Entity& pattern) -> usize {
	var Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		return source->template_parameters()->size();
	};

	return 0;
};

fn TemplateEngine::parameter_count(TemplateEngine& this, var Entity& pattern) -> usize {
	usize count = this.explicit_count(@pattern);
	var Syntax* source = this.function_source(@pattern);

	if (!source) {
		return $count;
	};

	usize index = 0;
	while (index < source->function_parameters()->size()) {
		if (this.has_auto(@*source->function_parameters()->item(index)->parameter_type())) {
			@count = count + 1;
		};

		@index = index + 1;
	};

	return $count;
};

fn TemplateEngine::parameter_at(TemplateEngine& this, var Entity& pattern, usize position) -> var Syntax* {
	usize visible = this.explicit_count(@pattern);

	if (position < visible) {
		return pattern.declaration()->template_parameters()->item(position);
	};

	var Syntax* source = this.function_source(@pattern);

	if (!source) {
		return nullptr;
	};

	usize index = 0;
	usize parameter = visible;
	while (index < source->function_parameters()->size()) {
		var Syntax* candidate = source->function_parameters()->item(index);
		@index = index + 1;

		if (!this.has_auto(@*candidate->parameter_type())) {
			continue;
		};

		if (parameter == position) {
			return $candidate;
		};

		@parameter = parameter + 1;
	};

	return nullptr;
};

fn TemplateEngine::parameter_name(TemplateEngine& this, var Syntax& parameter) -> var Syntax* {
	if (parameter.kind() == syntax_kind::parameter) {
		return parameter.parameter_name();
	};

	return parameter.template_parameter_name();
};

fn TemplateEngine::qualifier(TemplateEngine& this, var Scope& initial, var Syntax& syntax) -> Type* {
	var Scope* scope = &@initial;
	while (scope) {
		var Entity* owner = scope->owner();
		var TemplateInstance* instance = nullptr;

		if (owner) {
			@instance = this.instance(@*owner);
		};

		if (instance && owner->declaration()->kind() == syntax_kind::function && this.function_source(@*instance->pattern)) {
			usize index = this.explicit_count(@*instance->pattern);
			while (index < instance->arguments.size()) {
				var Syntax* parameter = this.parameter_at(@*instance->pattern, index);

				if (this.contains(@*parameter->parameter_type(), @syntax)) {
					return instance->arguments.data()[index].type;
				};

				@index = index + 1;
			};
		};

		@scope = scope->parent();
	};

	return nullptr;
};

fn TemplateEngine::auto_argument(TemplateEngine& this, var Syntax& syntax, TypeUse& actual) -> TypeUse* {
	if (syntax.kind() == syntax_kind::type_auto) {
		return &@actual;
	};

	if (syntax.kind() == syntax_kind::type_reference) {
		if (actual.type().kind() == type_kind::reference) {
			return this.auto_argument(@*syntax.designated_type(), actual.element());
		};

		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	if (syntax.kind() == syntax_kind::type_pointer && actual.type().kind() == type_kind::pointer || syntax.kind() == syntax_kind::type_array && actual.type().kind() == type_kind::array) {
		return this.auto_argument(@*syntax.designated_type(), actual.element());
	};

	if ((syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable)) {
		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	return nullptr;
};

fn TemplateArgument::same(TemplateArgument& this, TemplateArgument& other) -> bool {
	if (this.kind != other.kind || this.type != other.type) {
		return false;
	};
	if (this.kind == template_argument_kind::pack) {
		if (this.pack->elements.size() != other.pack->elements.size()) {
			return false;
		};
		usize index = 0;
		while (index < this.pack->elements.size()) {
			if (!this.pack->elements.data()[index].same(other.pack->elements.data()[index])) {
				return false;
			};
			@index = index + 1;
		};
		return true;
	};
	if (this.kind == template_argument_kind::type || this.kind == template_argument_kind::unbound) {
		return true;
	};
	if (this.type->kind() == type_kind::floating_point) {
		return this.real_value == other.real_value;
	};
	return this.value == other.value;
};

fn TemplateEngine::signature_entity(TemplateEngine& this, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::name) {
		bool ambiguous = false;
		var Entity* result = scope.lookup_from(name.token().text(), name.token().source, @ambiguous);
		if (ambiguous) {
			return nullptr;
		};
		return result;
	};
	if (name.kind() != syntax_kind::qualified_name || name.right()->kind() == syntax_kind::template_apply) {
		return nullptr;
	};
	var Entity* owner = this.signature_entity(@scope, @*name.left());
	if (!owner) {
		return nullptr;
	};
	@owner = owner->member_owner();
	if (!owner || !owner->members() || name.right()->kind() != syntax_kind::name) {
		return nullptr;
	};
	bool ambiguous = false;
	var Entity* result = owner->members()->local_from(name.right()->token().text(), name.token().source, @ambiguous);
	if (ambiguous) {
		return nullptr;
	};
	if (!result && owner->kind() == entity_kind::record) {
		@result = owner->find_member(name.right()->token().text());
	};
	return result;
};

fn TemplateEngine::signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> var Syntax* {
	if (syntax.kind() == syntax_kind::pack_signature) {
		return &@syntax;
	};
	var Syntax* name = &@syntax;
	if (name->kind() == syntax_kind::type_name) {
		@name = name->item(0);
	};
	var Entity* entity = this.signature_entity(@scope, @*name);
	if (!entity || entity->kind() != entity_kind::pack_signature) {
		return nullptr;
	};
	return entity->declaration()->item(1);
};

fn TemplateEngine::collect_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> CompilationResult {
	var Entity* previous = scope.local_declaration(syntax.item(0)->token().text(), syntax.token().source, entity_kind::pack_signature);
	if (previous) {
		var message = DiagnosticMessage();
		if (previous->kind() == entity_kind::pack_signature) {
			@message.text("duplicate pack signature declaration '");
		}
		else {
			@message.text("pack signature name conflicts with another declaration '");
		};
		diagnostic_name(@message, *syntax.item(0));
		@message.text("'");
		@analyzer.report(syntax.item(0)->token(), message.view());
		@analyzer.note(previous->token(), "previous declaration is here");
		return compilation_error();
	};
	var Syntax* signature = syntax.item(1);
	usize index = 0;
	while (index < signature->size()) {
		var Syntax* element = signature->item(index);
		if (element->kind() == syntax_kind::pack_signature_variadic_element && index + 1 != signature->size()) {
			@analyzer.error(element, "variadic pack signature element must be last");
			return compilation_error();
		};
		if (element->token().kind != token_kind::kw_typename && !@analyzer.type(@scope, @*element->item(0))) {
			return compilation_error();
		};
		@index = index + 1;
	};
	var Entity* entity = @analyzer.semantic_unit()->create_entity(entity_kind::pack_signature, syntax.item(0)->token(), &@syntax, &@scope);
	@entity->set_state(entity_state::ready);
};

fn TemplateEngine::bind_pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Syntax& source, var TemplatePack* pack) -> CompilationResult {
	var Entity* entity = @analyzer.semantic_unit()->create_entity(entity_kind::pack_binding, name.token(), &@source, &@scope);
	@entity->set_pack($pack);
	@entity->set_state(entity_state::ready);
};

fn TemplateEngine::pack_element(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, var TemplateArgument& result) -> CompilationResult {
	var Syntax* source = &@syntax;
	if (source->kind() == syntax_kind::ambiguity) {
		var Syntax* value_source = this.argument_syntax(@*source, template_argument_kind::value);
		var Entity* entity = nullptr;
		if (value_source && value_source->kind() == syntax_kind::name) {
			@entity = @analyzer.lookup(@scope, @*value_source);
		}
		else if (value_source && value_source->kind() == syntax_kind::qualified_name) {
			@entity = @analyzer.lookup(@scope, @*value_source);
		};
		if (entity && !entity->denotes_type() || value_source && value_source->kind() == syntax_kind::name && (value_source->token().is("true") || value_source->token().is("false"))) {
			@source = value_source;
		}
		else {
			@source = this.argument_syntax(@*source, template_argument_kind::type);
			if (!source) {
				@source = value_source;
			};
		};
	};
	if (!source) {
		return compilation_error();
	};
	if (source->kind() == syntax_kind::record || source->kind() == syntax_kind::type_tuple || source->kind() == syntax_kind::type_variant || source->kind() == syntax_kind::type_grouping || source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_mutable || source->kind() == syntax_kind::type_function) {
		@result.kind = template_argument_kind::type;
		@result.type = @analyzer.type(@scope, @*source);
		if (result.type != nullptr) {
			return;
		};
		return compilation_error();
	};
	var value = @analyzer.expression(@scope, @*source, rt::optional_ref<const Type>());
	if (!value.get()) {
		return compilation_error();
	};
	@result.kind = template_argument_kind::value;
	@result.type = @analyzer.type_store()->qualified(*value.get()->type(), type_qualifier::mutable);
	if (result.type->kind() == type_kind::floating_point) {
		ConstantEvaluator evaluator;
		if (@evaluator.real(@analyzer, *value.get(), @result.real_value)) {
			return;
		};
	}
	else if (@analyzer.constant_integer(*value.get(), @result.value)) {
		return;
	};
	@analyzer.error(source, "pack element must be a compile-time type or scalar value");
	return compilation_error();
};

fn TemplateEngine::pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> var TemplatePack* {
	var Syntax* source = &@syntax;
	if (source->kind() == syntax_kind::ambiguity) {
		@source = this.argument_syntax(@*source, template_argument_kind::value);
	};
	if (source && source->kind() == syntax_kind::type_name) {
		@source = source->item(0);
	};
	if (source && (source->kind() == syntax_kind::name || source->kind() == syntax_kind::qualified_name)) {
		var Entity* entity = @analyzer.lookup(@scope, @*source);
		if (entity && entity->kind() == entity_kind::pack_binding) {
			if (!(@analyzer.resolve(entity)).has<void>()) {
				return nullptr;
			};
			return entity->pack();
		};
	};
	if (!source || source->kind() != syntax_kind::pack_literal) {
		@analyzer.error(&@syntax, "expected a compile-time pack");
		return nullptr;
	};
	var TemplatePack* pack = @analyzer.semantic_unit()->create_pack();
	usize index = 0;
	while (index < source->size()) {
		TemplateArgument element;
		if (!(@this.pack_element(@analyzer, @scope, @*source->item(index), @element)).has<void>()) {
			return nullptr;
		};
		if (pack->elements.size() && (element.kind != pack->elements.data()[0].kind || element.kind == template_argument_kind::value && element.type != pack->elements.data()[0].type)) {
			@analyzer.error(source->item(index), "pack literal elements must have the same argument category and compatible value type");
			return nullptr;
		};
		PackElementSignature exact;
		@exact.kind = element.kind;
		if (element.kind == template_argument_kind::value) {
			@exact.value_type = element.type;
		};
		@pack->signature.push_back($exact);
		@pack->elements.push_back($element);
		@index = index + 1;
	};
	return $pack;
};

fn TemplateEngine::validate_pack(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& signature, TemplatePack& pack) -> CompilationResult {
	usize fixed = signature.size();
	bool variadic = fixed && signature.item(fixed - 1)->kind() == syntax_kind::pack_signature_variadic_element;
	if (variadic) {
		@fixed = fixed - 1;
	};
	if (pack.elements.size() < fixed || !variadic && pack.elements.size() != fixed) {
		var message = DiagnosticMessage();
		@message.text("pack signature expects ");
		if (variadic) {
			@message.text("at least ");
		};
		@message.number(fixed);
		@message.text(" elements, received ");
		@message.number(pack.elements.size());
		@analyzer.report(signature.token(), message.view());
		return compilation_error();
	};
	usize index = 0;
	while (index < pack.elements.size()) {
		usize slot = index;
		if (slot >= fixed && variadic) {
			@slot = fixed;
		};
		var Syntax* required = signature.item(slot);
		TemplateArgument& actual = pack.elements.data()[index];
		bool type = required->token().kind == token_kind::kw_typename;
		if (type != (actual.kind == template_argument_kind::type)) {
			var message = DiagnosticMessage();
			@message.text("pack signature expects ");
			if (type) {
				@message.text("a type");
			}
			else {
				@message.text("a value");
			};
			@message.text(" at pack index ");
			@message.number(index);
			@analyzer.report(required->token(), message.view());
			return compilation_error();
		};
		if (!type) {
			Type* expected = @analyzer.type(@scope, @*required->item(0));
			if (!expected || expected != actual.type) {
				var message = DiagnosticMessage();
				@message.text("pack signature value type mismatch at pack index ");
				@message.number(index);
				@analyzer.report(required->token(), message.view());
				return compilation_error();
			};
		};
		@index = index + 1;
	};
};

fn TemplateEngine::pack_value(var TemplateEngine& this, var Analyzer& analyzer, TemplateArgument& argument, var Syntax& source) -> rt::unique<SemanticExpression> {
	if (argument.kind != template_argument_kind::value) {
		@analyzer.error(&@source, "function argument expansion requires a pack of values");
		return rt::unique<SemanticExpression>();
	};
	semantic_kind kind = semantic_kind::literal_integer;
	if (argument.type->kind() == type_kind::floating_point) {
		@kind = semantic_kind::literal_real;
	};
	var result = SemanticExpression::make(semantic_kind(kind), argument.type, source.token());
	if (result.get()) {
		@result.get()->set_integer(argument.value);
		if (kind == semantic_kind::literal_real) {
			@result.get()->set_real(argument.real_value);
		};
	};
	return $result;
};

fn TemplateEngine::check_argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> CompilationResult {
	var Syntax* signature = @this.signature(@analyzer, @scope, @*parameter.template_parameter_type());
	if (signature) {
		if (argument.kind != template_argument_kind::pack) {
			@analyzer.error(&@parameter, "template parameter requires one complete pack argument");
			return compilation_error();
		};
		return @this.validate_pack(@analyzer, @scope, @*signature, *argument.pack);
	};
	if (parameter.token().kind == token_kind::kw_typename) {
		if (argument.kind == template_argument_kind::type) {
			return;
		};
		@analyzer.error(&@parameter, "template parameter requires a type argument");
		return compilation_error();
	};
	Type* expected = @analyzer.type(@scope, @*parameter.template_parameter_type());
	if (argument.kind != template_argument_kind::value || !expected || expected != argument.type) {
		@analyzer.error(&@parameter, "template value argument type mismatch");
		return compilation_error();
	};
};

fn TemplateEngine::normalized_input(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, var Syntax& source, var rt::buffer<TemplateArgument>& result) -> CompilationResult {
	usize visible = this.explicit_count(@pattern);
	bool variadic = visible && this.parameter_at(@pattern, visible - 1)->kind() == syntax_kind::template_variadic_parameter;
	usize fixed = visible;
	if (variadic) {
		@fixed = fixed - 1;
	};
	var TemplatePack* trailing = nullptr;
	if (variadic) {
		@trailing = @analyzer.semantic_unit()->create_pack();
		if (!trailing) {
			return compilation_error();
		};
	};
	usize index = 0;
	while (index < source.size()) {
		var Syntax* item = source.item(index);
		@index = index + 1;
		if (item->kind() == syntax_kind::ambiguity) {
			usize candidate = 0;
			while (candidate < item->size()) {
				if (item->item(candidate)->kind() == syntax_kind::pack_expansion) {
					@item = item->item(candidate);
					break;
				};
				@candidate = candidate + 1;
			};
		};
		var TemplatePack* expansion = nullptr;
		if (item->kind() == syntax_kind::pack_expansion) {
			@expansion = @this.pack(@analyzer, @scope, @*item->item(0));
			if (!expansion) {
				return compilation_error();
			};
		};
		usize count = 1;
		if (expansion) {
			@count = expansion->elements.size();
		};
		usize offset = 0;
		while (offset < count) {
			usize position = result.size();
			if (position >= fixed && !variadic) {
				@analyzer.error(item, "too many template arguments");
				return compilation_error();
			};
			if (position >= fixed) {
				@position = fixed;
			};
			var Syntax* parameter = this.parameter_at(@pattern, position);
			TemplateArgument argument;
			if (expansion) {
				@argument := expansion->elements.data()[offset];
				if (!(@this.check_argument(@analyzer, @scope, @*parameter, argument)).has<void>()) {
					return compilation_error();
				};
			}
			else if (!(@this.argument(@analyzer, @scope, @*item, @*parameter, @pattern, usize(position), @argument)).has<void>()) {
				return compilation_error();
			};
			if (variadic && result.size() >= fixed) {
				PackElementSignature exact;
				@exact.kind = argument.kind;
				if (argument.kind == template_argument_kind::value) {
					@exact.value_type = argument.type;
				};
				@trailing->signature.push_back($exact);
				@trailing->elements.push_back($argument);
			}
			else {
				@result.push_back($argument);
			};
			@offset = offset + 1;
		};
	};
	if (variadic) {
		while (result.size() < fixed) {
			TemplateArgument missing;
			@result.push_back($missing);
		};
		TemplateArgument argument;
		@argument.kind = template_argument_kind::pack;
		@argument.pack = trailing;
		@result.push_back($argument);
		return;
	};
};

struct Entity;

enum type_kind : [u08] {
	void_type;
	null_type;
	boolean;
	character;
	signed_integer;
	unsigned_integer;
	floating_point;
	named;
	pointer;
	reference;
	array;
	function;
	parameter;
};

enum type_qualifier : [u08] {
	mutable;
	immutable;
};

enum parameter_arity : [u08] {
	fixed;
	variadic;
};

fn type_kind::is_integer(type_kind& this) -> bool {
	return this == type_kind::boolean || this == type_kind::character || this == type_kind::signed_integer || this == type_kind::unsigned_integer;
};

fn type_kind::is_numeric(type_kind& this) -> bool {
	return this.is_integer() || this == type_kind::floating_point;
};

fn type_kind::is_scalar(type_kind& this) -> bool {
	return this.is_numeric() || this == type_kind::pointer || this == type_kind::reference;
};

struct FunctionSignature {
	fn FunctionSignature(var FunctionSignature& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity, bool nonthrowing);

	fn result(FunctionSignature& this) -> Type*;
	fn parameters(FunctionSignature& this) -> rt::buffer<Type*>&;
	fn arity(FunctionSignature& this) -> parameter_arity;
	fn nonthrowing(FunctionSignature& this) -> bool;
	fn equals(FunctionSignature& this, FunctionSignature& other) -> bool;
	fn matches(FunctionSignature& this, FunctionSignature& other) -> bool;

private:
	Type* return_type;
	rt::buffer<Type*> parameter_types;
	parameter_arity argument_arity;
	bool exception_free;
};

struct ArrayShape {
	Type* element;
	u64 count;
};

union TypeShape {
	u32 bits;
	var Entity* entity;
	Type* element;
	ArrayShape array;
	FunctionSignature* signature;
};

struct Type {
	fn Type(var Type& this) : [default];
	fn Type(var Type& this, type_kind kind, TypeShape shape);

	fn kind(Type& this) -> type_kind;
	fn qualifier(Type& this) -> type_qualifier;
	fn bits(Type& this) -> u32;
	fn entity(Type& this) -> var Entity*;
	fn element(Type& this) -> Type*;
	fn count(Type& this) -> u64;
	fn signature(Type& this) -> FunctionSignature&;
	fn qualified(Type& this, type_qualifier qualifier) -> Type;
	fn equals(Type& this, Type& other) -> bool;
	fn same_shape(Type& this, Type& other) -> bool;
	fn representation(Type& this) -> Type*;
	fn has_layout(Type& this) -> bool;
	fn normalize_integer(Type& this, u64 value) -> u64;
	fn signed_value(Type& this, u64 value) -> i64;
	fn integer_from_real(Type& this, f64 value, var u64& result) -> bool;
	fn derived_from(Type& this, Type& base) -> bool;
	fn hash(Type& this) -> usize;

private:
	TypeShape shape;
	type_kind category;
	type_qualifier qualification;
};

fn Type::equals(Type& this, Type& other) -> bool {
	if (this.category != other.category || this.qualification != other.qualification) {
		return false;
	};

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return this.shape.entity == other.shape.entity;
		case type_kind::pointer:
		case type_kind::reference:
			return this.shape.element == other.shape.element;
		case type_kind::array:
			return this.shape.array.element == other.shape.array.element && this.shape.array.count == other.shape.array.count;
		case type_kind::function:
			return this.shape.signature->equals(*other.shape.signature);
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return this.shape.bits == other.shape.bits;
		default:
			return true;
	};
};

fn Type::hash(Type& this) -> usize {
	usize hash = static_cast<usize>(this.category) * 37 + static_cast<usize>(this.qualification);

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.entity) >> 3);
		case type_kind::pointer:
		case type_kind::reference:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.element) >> 3);
		case type_kind::array:
			return (hash * 37 + (reinterpret_cast<usize>(this.shape.array.element) >> 3)) * 37 + static_cast<usize>(this.shape.array.count);
		case type_kind::function: {
			FunctionSignature& signature = *this.shape.signature;
			@hash = ((hash * 37 + (reinterpret_cast<usize>(signature.result()) >> 3)) * 37 + static_cast<usize>(signature.arity())) * 37 + static_cast<usize>(signature.nonthrowing());
			usize index = 0;
			while (index < signature.parameters().size()) {
				@hash = hash * 37 + (reinterpret_cast<usize>(signature.parameters().data()[index]) >> 3);
				@index = index + 1;
			};

			return $hash;
		};
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return hash * 37 + static_cast<usize>(this.shape.bits);
		default:
			return $hash;
	};
};

fn FunctionSignature::FunctionSignature(var FunctionSignature& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity, bool nonthrowing) {
	@this.return_type = $result;
	@this.parameter_types = $parameters;
	@this.argument_arity = $arity;
	@this.exception_free = $nonthrowing;
};

fn FunctionSignature::nonthrowing(FunctionSignature& this) -> bool {
	return this.exception_free;
};

fn FunctionSignature::result(FunctionSignature& this) -> Type* {
	return this.return_type;
};

fn FunctionSignature::parameters(FunctionSignature& this) -> rt::buffer<Type*>& {
	return this.parameter_types;
};

fn FunctionSignature::arity(FunctionSignature& this) -> parameter_arity {
	return parameter_arity(this.argument_arity);
};

fn FunctionSignature::equals(FunctionSignature& this, FunctionSignature& other) -> bool {
	return this.exception_free == other.exception_free && this.matches(other);
};

fn FunctionSignature::matches(FunctionSignature& this, FunctionSignature& other) -> bool {
	if (this.return_type != other.return_type || this.argument_arity != other.argument_arity || this.parameter_types.size() != other.parameter_types.size()) {
		return false;
	};

	usize index = 0;
	while (index < this.parameter_types.size()) {
		if (this.parameter_types.data()[index] != other.parameter_types.data()[index]) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Type::Type(var Type& this, type_kind kind, TypeShape shape) {
	@this.category = $kind;
	@this.shape = $shape;
};

fn Type::kind(Type& this) -> type_kind {
	return type_kind(this.category);
};

fn Type::qualifier(Type& this) -> type_qualifier {
	return type_qualifier(this.qualification);
};

fn Type::bits(Type& this) -> u32 {
	return this.shape.bits;
};

fn Type::entity(Type& this) -> var Entity* {
	return this.shape.entity;
};

fn Type::element(Type& this) -> Type* {
	if (this.category == type_kind::array) {
		return this.shape.array.element;
	};

	return this.shape.element;
};

fn Type::count(Type& this) -> u64 {
	return this.shape.array.count;
};

fn Type::signature(Type& this) -> FunctionSignature& {
	return *this.shape.signature;
};

fn Type::qualified(Type& this, type_qualifier qualifier) -> Type {
	Type result := this;
	@result.qualification = $qualifier;

	return $result;
};

fn Type::same_shape(Type& this, Type& other) -> bool {
	Type first = this.qualified(type_qualifier::mutable);
	Type second = other.qualified(type_qualifier::mutable);

	return first.equals(second);
};

fn aggregate_access_kind(Type* type) -> u32 {
	if (!type || type->kind() != type_kind::named || !type->entity()->template_arguments()) {
		return 0;
	};
	var Entity* pattern = type->entity()->template_arguments()->pattern;
	if (!pattern || !pattern->scope() || !pattern->scope()->owner()) {
		return 0;
	};
	var Entity* owner = pattern->scope()->owner();
	if (owner->kind() != entity_kind::namespace_body || owner->name() != "rt" || !owner->scope() || owner->scope()->owner()) {
		return 0;
	};
	if (pattern->name() == "tuple") {
		return 1;
	};
	if (pattern->name() == "variant") {
		return 2;
	};
	return 0;
};

fn aggregate_element(var Analyzer& analyzer, var Syntax& syntax, rt::unique<SemanticExpression> object, var Entity* field) -> rt::unique<SemanticExpression> {
	if (!field) {
		@analyzer.error(&@syntax, "aggregate element storage is unavailable");
		return rt::unique<SemanticExpression>();
	};
	Type* type = field->type();
	if (type->kind() == type_kind::reference) {
		@type = type->element();
	}
	else if (object.get()->type()->qualifier() == type_qualifier::immutable) {
		@type = @analyzer.type_store()->qualified(*type, type_qualifier::immutable);
	};
	Token location = syntax.token();
	bool mutable_access = object.get()->mutable_access();
	if (field->type()->kind() == type_kind::reference) {
		@mutable_access = type->qualifier() == type_qualifier::mutable;
	};
	var result = SemanticExpression::make(semantic_kind::member, type, location);
	if (!result.get() || !(@result.get()->append($object)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	@result.get()->bind(field, value_category::place);
	@result.get()->set_mutable_access(mutable_access);
	return $result;
};

fn Analyzer::aggregate_access(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var Syntax* member = syntax.callable()->member_name();
	var Syntax* supplied = member->arguments();
	bool predicate = member->token().text() == "has";
	Type* owner = receiver.get()->type();
	u32 kind = aggregate_access_kind(owner);
	if (!supplied || supplied->size() != 1 || syntax.arguments()->size()) {
		@this.error(&@syntax, "aggregate access requires one type argument and no value arguments");
		return rt::unique<SemanticExpression>();
	};
	if (predicate && kind != 2) {
		@this.error(&@syntax, "has<T>() requires a variant receiver");
		return rt::unique<SemanticExpression>();
	};
	var Syntax* type_source = this.templates.argument_syntax(@*supplied->item(0), template_argument_kind::type);
	if (!type_source) {
		@this.error(&@syntax, "aggregate access requires a type argument");
		return rt::unique<SemanticExpression>();
	};
	Type* requested = @this.type(@scope, @*type_source);
	if (!requested) {
		return rt::unique<SemanticExpression>();
	};
	TemplateInstantiation* instance = owner->entity()->template_arguments();
	if (instance->arguments.size() != 1 || instance->arguments.data()[0].kind != template_argument_kind::pack || !instance->arguments.data()[0].pack) {
		@this.error(&@syntax, "aggregate type arguments are unavailable");
		return rt::unique<SemanticExpression>();
	};
	var TemplatePack* elements = instance->arguments.data()[0].pack;
	usize position = 0;
	usize count = 0;
	usize index = 0;
	while (index < elements->elements.size()) {
		if (elements->elements.data()[index].type->same_shape(*requested)) {
			@position = index;
			@count = count + 1;
		};
		@index = index + 1;
	};
	if (!count) {
		@this.error(&@syntax, "requested type is not an aggregate element");
		return rt::unique<SemanticExpression>();
	};
	if (count != 1) {
		@this.error(&@syntax, "aggregate type access requires a unique element type");
		return rt::unique<SemanticExpression>();
	};
	if (predicate) {
		var tag = @aggregate_element(@this, @syntax, $receiver, owner->entity()->find_member("_index"));
		var number = @this.node(semantic_kind::literal_integer, this.types->find_primitive("usize"), &@syntax);
		Token operation = syntax.token();
		@operation.kind = token_kind::op_equal;
		var result = SemanticExpression::make(semantic_kind::binary, this.types->find_primitive("bool"), operation);
		if (!tag.get() || !number.get() || !result.get()) {
			return rt::unique<SemanticExpression>();
		};
		@number.get()->set_integer(u64(position + 1));
		if (!(@result.get()->append($tag)).has<void>() || !(@result.get()->append($number)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.convert($result, expected, @syntax);
	};
	if (requested->kind() == type_kind::void_type) {
		var result = @this.node(semantic_kind::sequence, requested, &@syntax);
		if (!result.get() || !(@result.get()->append($receiver)).has<void>() || !(@result.get()->append(@this.node(semantic_kind::noop, requested, &@syntax))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.convert($result, expected, @syntax);
	};
	if (requested->kind() == type_kind::null_type) {
		Type* null_type = @this.types->pointer(@this.types->qualified(*requested, type_qualifier::immutable));
		var result = @this.node(semantic_kind::sequence, null_type, &@syntax);
		if (!result.get() || !(@result.get()->append($receiver)).has<void>() || !(@result.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@result.get()->append(@this.node(semantic_kind::null_pointer, null_type, &@syntax))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.convert($result, expected, @syntax);
	};
	if (kind == 2) {
		@receiver = @aggregate_element(@this, @syntax, rt::unique<SemanticExpression>(@receiver.release()), owner->entity()->find_member("_storage"));
		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};
		@owner = receiver.get()->type();
	};
	var Entity* field = nullptr;
	var Entity* members = owner->entity()->find_member("_elements");
	if (members && members->kind() == entity_kind::field_pack && position < members->fields().size()) {
		@field = members->fields().data()[position];
	};
	return @this.convert(@aggregate_element(@this, @syntax, $receiver, field), expected, @syntax);
};

fn Analyzer::variant_cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* target, rt::unique<SemanticExpression> receiver, rt::optional_ref<const Type>& expected, bool propagate) -> rt::unique<SemanticExpression> {
	Type* owner = receiver.get()->type();
	TemplateInstantiation* instance = owner->entity()->template_arguments();
	var TemplatePack* elements = instance->arguments.data()[0].pack;
	usize selected = 0;
	usize count = 0;
	usize index = 0;
	while (index < elements->elements.size()) {
		Type* alternative = elements->elements.data()[index].type;
		if (alternative->same_shape(*target) || alternative->kind() == type_kind::reference && alternative->element()->same_shape(*target)) {
			@selected = index;
			@count = count + 1;
		};
		@index = index + 1;
	};
	if (count != 1) {
		@this.error(&@syntax, "variant cast requires a unique alternative of the requested type");
		return rt::unique<SemanticExpression>();
	};
	Type* known = variant_flow_known(this.variant_facts, *receiver.get());
	var Entity* binding = variant_flow_binding(*receiver.get());
	if (binding) {
		@this.variant_facts.establish(@*binding, elements->elements.data()[selected].type);
	};
	if (known && known->same_shape(*target) && target->kind() != type_kind::null_type && target->kind() != type_kind::void_type && receiver.get()->category() == value_category::place) {
		return @this.convert(variant_flow_extract(@this, @syntax, $receiver, known), expected, @syntax);
	};
	if (known && known->same_shape(*target) && target->kind() == type_kind::null_type) {
		Type* null_type = @this.types->pointer(@this.types->qualified(*target, type_qualifier::immutable));
		var result = @this.node(semantic_kind::sequence, null_type, &@syntax);
		if (!result.get() || !(@result.get()->append($receiver)).has<void>() || !(@result.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@result.get()->append(@this.node(semantic_kind::null_pointer, null_type, &@syntax))).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return @this.convert($result, expected, @syntax);
	};
	Type* result_type = elements->elements.data()[selected].type;
	bool reference_result = result_type->kind() == type_kind::reference;
	if (reference_result) {
		@result_type = result_type->element();
	};
	bool null_result = result_type->kind() == type_kind::null_type;
	if (null_result) {
		@result_type = @this.types->pointer(@this.types->qualified(*result_type, type_qualifier::immutable));
	};
	if (!reference_result && owner->qualifier() == type_qualifier::immutable && result_type->kind() != type_kind::void_type) {
		@result_type = @this.types->qualified(*result_type, type_qualifier::immutable);
	};
	bool mutable_access = receiver.get()->mutable_access();
	value_category category = receiver.get()->category();
	if (reference_result) {
		@mutable_access = result_type->qualifier() == type_qualifier::mutable;
	};
	var result = @this.node(semantic_kind::variant_cast, result_type, &@syntax);
	if (!result.get() || !(@result.get()->append($receiver)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	@result.get()->set_integer(u64(selected + 1));
	@result.get()->set_mutable_access(mutable_access);
	if (!null_result && result_type->kind() != type_kind::void_type) {
		if (reference_result) {
			@result.get()->set_category(value_category::place);
		}
		else {
			@result.get()->set_category(category);
		};
	};
	@index = 0;
	while (index < elements->elements.size()) {
		if (index == selected) {
			if (!(@result.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			Type* alternative = elements->elements.data()[index].type;
			if (alternative->kind() == type_kind::null_type) {
				Type* null_type = @this.types->pointer(@this.types->qualified(*alternative, type_qualifier::immutable));
				var payload = @this.node(semantic_kind::null_pointer, null_type, &@syntax);
				if (!payload.get()) {
					return rt::unique<SemanticExpression>();
				};
				if (propagate && this.function) {
					Type* returned_type = this.function->type()->signature().result();
					if (@this.argument_rank(*payload.get(), *returned_type) >= 0) {
						var returned = @this.node(semantic_kind::return_value, this.types->find_primitive("void"), &@syntax);
						var returned_value = @this.convert($payload, rt::optional_ref<const Type>(*returned_type), @syntax);
						if (!returned.get() || !returned_value.get() || !(@returned.get()->append($returned_value)).has<void>() || !(@result.get()->append($returned)).has<void>()) {
							return rt::unique<SemanticExpression>();
						};
						@index = index + 1;
						continue;
					};
				};
				var failure = @this.node(semantic_kind::exception_throw, this.types->find_primitive("void"), &@syntax);
				if (!failure.get() || !(@failure.get()->append($payload)).has<void>() || !(@result.get()->append($failure)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};
				@index = index + 1;
				continue;
			};
			Type* payload_type = alternative;
			if (owner->qualifier() == type_qualifier::immutable) {
				@payload_type = @this.types->qualified(*payload_type, type_qualifier::immutable);
			};
			if (category == value_category::place && !(@this.prepare_copy(alternative)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			if (alternative->kind() == type_kind::named && alternative->entity()->kind() == entity_kind::record && !exception_member_access(@this, alternative->entity()->destructor(), @scope, syntax.token())) {
				return rt::unique<SemanticExpression>();
			};
			var payload = @this.node(semantic_kind::variant_payload, payload_type, &@syntax);
			if (!payload.get()) {
				return rt::unique<SemanticExpression>();
			};
			@payload.get()->set_category(category);
			if (propagate && this.function) {
				Type* returned_type = this.function->type()->signature().result();
				if (@this.argument_rank(*payload.get(), *returned_type) >= 0) {
					var returned = @this.node(semantic_kind::return_value, this.types->find_primitive("void"), &@syntax);
					var returned_value = @this.convert($payload, rt::optional_ref<const Type>(*returned_type), @syntax);
					if (!returned.get() || !returned_value.get() || !(@returned.get()->append($returned_value)).has<void>() || !(@result.get()->append($returned)).has<void>()) {
						return rt::unique<SemanticExpression>();
					};
					@index = index + 1;
					continue;
				};
			};
			var value = @this.initialize(@syntax, alternative, $payload);
			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};
			if (value.get()->kind() == semantic_kind::construction && !exception_member_access(@this, value.get()->entity(), @scope, syntax.token())) {
				return rt::unique<SemanticExpression>();
			};
			var failure = @this.node(semantic_kind::exception_throw, this.types->find_primitive("void"), &@syntax);
			if (!failure.get() || !(@failure.get()->append($value)).has<void>() || !(@result.get()->append($failure)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
		};
		@index = index + 1;
	};
	return @this.convert($result, expected, @syntax);
};

fn variant_instance(Entity& record) -> bool {
	TemplateInstantiation* arguments = record.template_arguments();
	if (!arguments || !arguments->pattern || arguments->pattern->name() != "variant") {
		return false;
	};
	var Scope* scope = arguments->pattern->scope();
	return scope && scope->owner() && scope->owner()->kind() == entity_kind::namespace_body && scope->owner()->name() == "rt";
};

fn Analyzer::construct_variant(var Analyzer& this, var Syntax& syntax, Type* type, var rt::buffer<rt::unique<SemanticExpression>>& raw, var bool& handled) -> rt::unique<SemanticExpression> {
	@handled = false;
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record || !variant_instance(*type->entity()) || !raw.size()) {
		return rt::unique<SemanticExpression>();
	};
	if (raw.size() == 1 && raw.data()[0].get()->type()->same_shape(*type)) {
		return rt::unique<SemanticExpression>();
	};
	@handled = true;
	if (!(@this.resolve(type->entity())).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	if (raw.size() != 1) {
		@this.error(&@syntax, "variant construction requires exactly one alternative value");
		return rt::unique<SemanticExpression>();
	};
	if (raw.data()[0].get()->kind() == semantic_kind::null_pointer || raw.data()[0].get()->type()->kind() == type_kind::void_type) {
		bool void_value = raw.data()[0].get()->type()->kind() == type_kind::void_type;
		TemplateInstantiation* instance = type->entity()->template_arguments();
		var TemplatePack* elements = instance->arguments.data()[0].pack;
		usize empty_position = elements->elements.size();
		usize position = 0;
		while (position < elements->elements.size()) {
			if (elements->elements.data()[position].type && (void_value && elements->elements.data()[position].type->kind() == type_kind::void_type || !void_value && elements->elements.data()[position].type->kind() == type_kind::null_type)) {
				if (empty_position != elements->elements.size()) {
					@this.error(&@syntax, "variant construction type matches more than one alternative");
					return rt::unique<SemanticExpression>();
				};
				@empty_position = position;
			};
			@position = position + 1;
		};
		if (empty_position != elements->elements.size()) {
			var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);
			var result = @this.node(semantic_kind::construction, type, &@syntax);
			if (!arguments.get() || !result.get() || !(@result.get()->append($arguments)).has<void>()) {
				return rt::unique<SemanticExpression>();
			};
			@result.get()->set_integer(u64(empty_position + 1));
			if (void_value) {
				var sequence = @this.node(semantic_kind::sequence, type, &@syntax);
				if (!sequence.get() || !(@sequence.get()->append(rt::unique<SemanticExpression>(@raw.data()[0].release()))).has<void>() || !(@sequence.get()->append(@this.node(semantic_kind::noop, this.types->find_primitive("void"), &@syntax))).has<void>() || !(@sequence.get()->append($result)).has<void>()) {
					return rt::unique<SemanticExpression>();
				};
				return $sequence;
			};
			return $result;
		};
	};

	var Entity* storage = type->entity()->find_member("_storage");
	if (!storage || !(@this.resolve(storage)).has<void>() || storage->type()->kind() != type_kind::named || !(@this.resolve(storage->type()->entity())).has<void>()) {
		@this.error(&@syntax, "rt::variant requires its standard alternative storage declaration");
		return rt::unique<SemanticExpression>();
	};
	var Entity* alternatives = storage->type()->entity();
	usize selected = alternatives->fields().size();
	usize index = 0;
	while (index < alternatives->fields().size()) {
		Type* candidate = alternatives->fields().data()[index]->type();
		if (candidate->same_shape(*raw.data()[0].get()->type()) || candidate->kind() == type_kind::reference && candidate->element()->same_shape(*raw.data()[0].get()->type()) && @this.argument_rank(*raw.data()[0].get(), *candidate) >= 0) {
			if (selected != alternatives->fields().size()) {
				@this.error(&@syntax, "variant construction type matches more than one alternative");
				return rt::unique<SemanticExpression>();
			};
			@selected = index;
		};
		@index = index + 1;
	};
	if (selected == alternatives->fields().size()) {
		@this.error(&@syntax, "variant construction value type is not an alternative");
		return rt::unique<SemanticExpression>();
	};

	Type* alternative = alternatives->fields().data()[selected]->type();
	if (alternative->kind() != type_kind::reference && raw.data()[0].get()->category() == value_category::place && !(@this.prepare_copy(alternative)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	rt::buffer<rt::unique<SemanticExpression>> payload_arguments;
	@payload_arguments.push_back(rt::unique<SemanticExpression>(@raw.data()[0].release()));
	rt::unique<SemanticExpression> payload;
	if (alternative->kind() == type_kind::reference) {
		var rt::unique<SemanticExpression>* values = (@payload_arguments).data();
		@payload = rt::unique<SemanticExpression>(@values[0].release());
	}
	else {
		@payload = @this.construct_values(@syntax, alternative, $payload_arguments);
	};
	var arguments = @this.node(semantic_kind::brace, this.types->find_primitive("void"), &@syntax);
	var result = @this.node(semantic_kind::construction, type, &@syntax);
	if (!payload.get() || !arguments.get() || !result.get() || !(@arguments.get()->append($payload)).has<void>() || !(@result.get()->append($arguments)).has<void>()) {
		return rt::unique<SemanticExpression>();
	};
	@result.get()->set_integer(alternatives->fields().data()[selected]->integer() + 1);
	return $result;
};

// Flow facts apply only to directly named bindings. An unknown or escaped binding
// has no entry, so consumers must retain the checked variant operation.
struct VariantFlowFact {
	var Entity* binding;
	Type* alternative;
};

struct VariantFlowFacts {
	fn VariantFlowFacts(var VariantFlowFacts& this) : [default];
	fn VariantFlowFacts(var VariantFlowFacts& this, VariantFlowFacts& other) : [default];
	fn VariantFlowFacts(var VariantFlowFacts& this, VariantFlowFacts other) : [default];
	fn operator=(var VariantFlowFacts& this, VariantFlowFacts other) -> var VariantFlowFacts& : [default];
	fn operator:=(var VariantFlowFacts& this, VariantFlowFacts& other) -> var VariantFlowFacts& : [default];

	fn known(VariantFlowFacts& this, Entity& binding) -> Type*;
	fn establish(var VariantFlowFacts& this, var Entity& binding, Type* alternative);
	fn invalidate(var VariantFlowFacts& this, Entity& binding);
	fn clear(var VariantFlowFacts& this);
	fn intersect(var VariantFlowFacts& this, VariantFlowFacts& other);

private:
	rt::buffer<VariantFlowFact> entries;
};

fn VariantFlowFacts::known(VariantFlowFacts& this, Entity& binding) -> Type* {
	usize index = 0;
	while (index < this.entries.size()) {
		VariantFlowFact& entry = this.entries.data()[index];
		if (entry.binding == &binding) {
			return entry.alternative;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn VariantFlowFacts::establish(var VariantFlowFacts& this, var Entity& binding, Type* alternative) {
	usize index = 0;
	while (index < this.entries.size()) {
		var VariantFlowFact& entry = @((@this.entries).data()[index]);
		if (entry.binding == &binding) {
			@entry.alternative = alternative;
			return;
		};
		@index = index + 1;
	};
	if (!alternative) {
		return;
	};
	var entry = VariantFlowFact();
	@entry.binding = &@binding;
	@entry.alternative = alternative;
	@this.entries.push_back($entry);
};

fn VariantFlowFacts::invalidate(var VariantFlowFacts& this, Entity& binding) {
	usize index = 0;
	while (index < this.entries.size()) {
		var VariantFlowFact& entry = @((@this.entries).data()[index]);
		if (entry.binding == &binding) {
			@entry.alternative = nullptr;
			return;
		};
		@index = index + 1;
	};
};

fn VariantFlowFacts::clear(var VariantFlowFacts& this) {
	@this.entries.clear();
};

fn VariantFlowFacts::intersect(var VariantFlowFacts& this, VariantFlowFacts& other) {
	usize index = 0;
	while (index < this.entries.size()) {
		var VariantFlowFact& entry = @((@this.entries).data()[index]);
		if (entry.alternative && entry.alternative != other.known(*entry.binding)) {
			@entry.alternative = nullptr;
		};
		@index = index + 1;
	};
};

struct VariantFlowScope {
	fn VariantFlowScope(var VariantFlowScope& this, var VariantFlowFacts& current);
	fn ~VariantFlowScope(var VariantFlowScope& this);
private:
	var VariantFlowFacts* current;
	VariantFlowFacts previous;
};

fn VariantFlowScope::VariantFlowScope(var VariantFlowScope& this, var VariantFlowFacts& current) {
	@this.current = &@current;
	var snapshot = VariantFlowFacts(current);
	@this.previous = $snapshot;
	@current.clear();
};

fn VariantFlowScope::~VariantFlowScope(var VariantFlowScope& this) {
	@*this.current := this.previous;
};

fn variant_flow_binding(SemanticExpression& value) -> var Entity* {
	if ((value.kind() == semantic_kind::access || value.kind() == semantic_kind::cast || value.kind() == semantic_kind::relocation) && value.size() == 1) {
		return variant_flow_binding(*value.item(0));
	};
	if (value.kind() != semantic_kind::name || !value.entity()) {
		return nullptr;
	};
	var Entity* binding = value.entity();
	if (binding->kind() != entity_kind::local && binding->kind() != entity_kind::parameter) {
		return nullptr;
	};
	return binding;
};

fn variant_flow_type(Type* variant, usize index) -> Type* {
	if (aggregate_access_kind(variant) != 2) {
		return nullptr;
	};
	TemplateInstantiation* instance = variant->entity()->template_arguments();
	if (!instance || instance->arguments.size() != 1 || !instance->arguments.data()[0].pack) {
		return nullptr;
	};
	TemplatePack& alternatives = *instance->arguments.data()[0].pack;
	if (index >= alternatives.elements.size() || alternatives.elements.data()[index].kind != template_argument_kind::type) {
		return nullptr;
	};
	return alternatives.elements.data()[index].type;
};

fn variant_flow_known(VariantFlowFacts& facts, SemanticExpression& value) -> Type* {
	if (aggregate_access_kind(value.type()) != 2) {
		return nullptr;
	};
	if ((value.kind() == semantic_kind::cast || value.kind() == semantic_kind::access || value.kind() == semantic_kind::relocation) && value.size() == 1) {
		return variant_flow_known(facts, *value.item(0));
	};
	if (value.kind() == semantic_kind::construction && !value.integer() && value.size() == 1 && value.item(0)->size() == 1 && value.item(0)->item(0)->type()->same_shape(*value.type())) {
		return variant_flow_known(facts, *value.item(0)->item(0));
	};
	if (value.kind() == semantic_kind::construction && value.integer()) {
		return variant_flow_type(value.type(), usize(value.integer() - 1));
	};
	if (value.kind() == semantic_kind::construction && !value.integer() && value.size() == 1 && !value.item(0)->size()) {
		return variant_flow_type(value.type(), 0);
	};
	var Entity* binding = variant_flow_binding(value);
	if (binding) {
		return facts.known(*binding);
	};
	return nullptr;
};

fn variant_flow_condition(var VariantFlowFacts& facts, SemanticExpression& condition, bool truth) -> bool {
	if (condition.kind() == semantic_kind::cast && condition.size() == 1) {
		return variant_flow_condition(@facts, *condition.item(0), truth);
	};
	if (condition.kind() == semantic_kind::unary && condition.operation() == token_kind::op_bang) {
		return variant_flow_condition(@facts, *condition.item(0), !truth);
	};
	if (condition.kind() != semantic_kind::binary || condition.operation() != token_kind::op_equal || condition.size() != 2) {
		return true;
	};
	var SemanticExpression* tag = condition.item(0);
	var SemanticExpression* number = condition.item(1);
	if (tag->kind() != semantic_kind::member || !tag->entity() || tag->entity()->name() != "_index" || tag->size() != 1 || number->kind() != semantic_kind::literal_integer || !number->integer()) {
		return true;
	};
	var SemanticExpression* receiver = tag->item(0);
	var Entity* binding = variant_flow_binding(*receiver);
	Type* alternative = variant_flow_type(receiver->type(), usize(number->integer() - 1));
	if (!binding || !alternative) {
		return true;
	};
	if (!truth) {
		Type* first = variant_flow_type(receiver->type(), 0);
		Type* second = variant_flow_type(receiver->type(), 1);
		if (!first || !second || variant_flow_type(receiver->type(), 2) || first->same_shape(*second) || number->integer() > 2) {
			return true;
		};
		@alternative = first;
		if (number->integer() == 1) {
			@alternative = second;
		};
	};
	@facts.establish(@*binding, alternative);
	return true;
};

fn variant_flow_extract(var Analyzer& analyzer, var Syntax& syntax, rt::unique<SemanticExpression> value, Type* known) -> rt::unique<SemanticExpression> {
	if (known->kind() == type_kind::null_type) {
		Type* null_type = @analyzer.type_store()->pointer(@analyzer.type_store()->qualified(*known, type_qualifier::immutable));
		Token location = syntax.token();
		var result = SemanticExpression::make(semantic_kind::sequence, null_type, location);
		var null_value = SemanticExpression::make(semantic_kind::null_pointer, null_type, location);
		var noop = SemanticExpression::make(semantic_kind::noop, analyzer.type_store()->find_primitive("void"), location);
		if (!result.get() || !null_value.get() || !noop.get() || !(@result.get()->append($value)).has<void>() || !(@result.get()->append($noop)).has<void>() || !(@result.get()->append($null_value)).has<void>()) {
			return rt::unique<SemanticExpression>();
		};
		return $result;
	};
	var Entity* storage = value.get()->type()->entity()->find_member("_storage");
	if (!storage || !storage->type() || storage->type()->kind() != type_kind::named) {
		return rt::unique<SemanticExpression>();
	};
	var Entity* selected = nullptr;
	usize index = 0;
	while (index < storage->type()->entity()->fields().size()) {
		var Entity* field = storage->type()->entity()->fields().data()[index];
		if (field->type()->same_shape(*known)) {
			if (selected) {
				return rt::unique<SemanticExpression>();
			};
			@selected = field;
		};
		@index = index + 1;
	};
	if (!selected) {
		return rt::unique<SemanticExpression>();
	};
	bool mutable_access = value.get()->mutable_access();
	var element = aggregate_element(@analyzer, @syntax, $value, storage);
	if (!element.get()) {
		return rt::unique<SemanticExpression>();
	};
	var result = aggregate_element(@analyzer, @syntax, $element, selected);
	if (result.get() && selected->type()->kind() != type_kind::reference) {
		@result.get()->set_mutable_access(mutable_access);
	};
	return $result;
};

// Only structurally guaranteed exits suppress a branch at a flow merge.
fn variant_flow_terminates(SemanticExpression& expression) -> bool {
	switch (expression.kind()) {
		case semantic_kind::return_value:
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
		case semantic_kind::break_loop:
		case semantic_kind::continue_loop:
			return true;
		case semantic_kind::conditional:
			return expression.size() == 3 && variant_flow_terminates(*expression.item(1)) && variant_flow_terminates(*expression.item(2));
		case semantic_kind::brace:
		case semantic_kind::statements:
		case semantic_kind::sequence: {
			usize index = 0;
			while (index < expression.size()) {
				if (variant_flow_terminates(*expression.item(index))) {
					return true;
				};
				@index = index + 1;
			};
			return false;
		};
	};
	return false;
};

fn Analyzer::configure_variant_default(var Analyzer& this, var Entity& record) -> CompilationResult {
	if (!variant_instance(record)) {
		return;
	};
	TemplateInstantiation* instance = record.template_arguments();
	if (instance->arguments.size() != 1 || !instance->arguments.data()[0].pack) {
		return compilation_error();
	};
	var TemplatePack* elements = instance->arguments.data()[0].pack;
	configure_variant_copy(@record);
	bool available = elements->elements.size() && variant_default_constructible(elements->elements.data()[0].type);
	usize index = 0;
	while (index < record.members()->bindings().size()) {
		var Entity* member = record.members()->bindings().data()[index];
		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->parameters().size() == 1 && !available) {
			@member->set_definition(function_definition::deleted);
		};
		@index = index + 1;
	};
	if (!available) {
		return;
	};
	var Entity* constructor = @this.supply_special(&@record, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);
	if (!constructor) {
		return compilation_error();
	};
	@constructor->set_definition(function_definition::defaulted);
	@record.set_default_constructor(constructor);
	var Entity* tag = record.find_member("_index");
	if (!tag || !(@this.resolve(tag)).has<void>()) {
		return compilation_error();
	};
	Token location = tag->token();
	var initializer = SemanticExpression::make(semantic_kind::literal_integer, tag->type(), location);
	if (!initializer.get()) {
		return compilation_error();
	};
	@initializer.get()->set_integer(1);
	@tag->set_body($initializer);
	@tag->set_body_state(entity_state::ready);
};

fn aggregate_arguments(var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, syntax_kind operation, var TemplatePack& pack) -> bool {
	if (syntax.kind() == operation) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!aggregate_arguments(@analyzer, @scope, @*syntax.item(index), syntax_kind(operation), @pack)) {
				return false;
			};
			@index = index + 1;
		};
		return true;
	};
	TemplateArgument argument;
	@argument.kind = template_argument_kind::type;
	@argument.type = @analyzer.type(@scope, @syntax);
	if (!argument.type) {
		return false;
	};
	PackElementSignature signature;
	@signature.kind = template_argument_kind::type;
	@pack.signature.push_back($signature);
	@pack.elements.push_back($argument);
	return true;
};

fn TemplateEngine::aggregate_type(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> Type* {
	var TemplatePack* pack = @analyzer.semantic_unit()->create_pack();
	if (!aggregate_arguments(@analyzer, @scope, @syntax, syntax.kind(), @*pack)) {
		return nullptr;
	};
	return @this.aggregate_type(@analyzer, @scope, @syntax, syntax.kind(), @*pack);
};

fn TemplateEngine::aggregate_type(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, syntax_kind operation, var TemplatePack& pack) -> Type* {
	var name = rt::string_view("tuple");
	if (operation == syntax_kind::type_variant) {
		@name = "variant";
	};
	var Entity* runtime = analyzer.semantic_unit()->root_scope()->local("rt");
	var Entity* pattern = nullptr;
	if (runtime && runtime->kind() == entity_kind::namespace_body && runtime->members()) {
		@pattern = runtime->members()->local(name);
	};
	if (!pattern || pattern->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text("type operator requires the rt::");
		@message.text(name);
		@message.text(" standard library template declaration");
		@analyzer.report(syntax.token(), message.view());
		return nullptr;
	};
	rt::buffer<TemplateArgument> arguments;
	TemplateArgument argument;
	@argument.kind = template_argument_kind::pack;
	@argument.pack = &@pack;
	@arguments.push_back($argument);
	var Entity* instance = @this.instantiate(@analyzer, @scope, @*pattern, TemplateInput(arguments, syntax.token()));
	if (!instance) {
		return nullptr;
	};
	return instance->type();
};

fn Type::representation(Type& this) -> Type* {
	Type* type = &@this;

	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration && type->entity()->underlying()) {
		@type = type->entity()->underlying();
	};

	return $type;
};

fn Type::has_layout(Type& this) -> bool {
	switch (this.kind()) {
		case type_kind::void_type:
		case type_kind::null_type:
		case type_kind::function:
			return false;
		case type_kind::array:
			return this.element()->has_layout();
		case type_kind::named: {
			var Entity* entity = this.entity();

			if (entity->kind() == entity_kind::enumeration) {
				return entity->underlying() && entity->underlying()->has_layout();
			};

			return entity->kind() == entity_kind::record && entity->declaration() && entity->declaration()->record_members()->kind() != syntax_kind::noop;
		};
	};

	return true;
};

fn Type::normalize_integer(Type& this, u64 value) -> u64 {
	Type* type = this.representation();

	if (!type->kind().is_integer()) {
		return $value;
	};

	u32 bits = type->bits();

	if (bits && bits < 64) {
		return value & ((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return $value;
};

fn Type::signed_value(Type& this, u64 value) -> i64 {
	Type* type = this.representation();
	u32 bits = type->bits();
	@value = type->normalize_integer(value);

	if (bits && bits < 64 && (value & (u64(1) << static_cast<u64>(bits - 1)))) {
		@value = value | ~((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return static_cast<i64>($value);
};

fn Type::derived_from(Type& this, Type& base) -> bool {
	if (this.kind() != type_kind::named || base.kind() != type_kind::named || this.entity()->kind() != entity_kind::record || base.entity()->kind() != entity_kind::record) {
		return false;
	};

	var Entity* current = this.entity();

	while (current->bases().size() == 1) {
		@current = current->bases().data()[0]->entity();

		if (current == base.entity()) {
			return true;
		};
	};

	return false;
};

struct TypeEntry {
	Type value;
	var TypeEntry* next;
};

struct TypeStore {
	fn TypeStore(var TypeStore& this) : [default];
	fn TypeStore(var TypeStore& this, TypeStore& other) : [delete];
	fn TypeStore(var TypeStore& this, TypeStore other) : [default];

	fn operator=(var TypeStore& this, TypeStore& other) -> var TypeStore& : [delete];
	fn operator=(var TypeStore& this, TypeStore other) -> var TypeStore& : [default];
	fn primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type*;
	fn initialize_primitives(var TypeStore& this, u32 pointer_bits);
	fn primitive_spelling(usize index) -> rt::string_view;
	fn named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type*;
	fn pointer(var TypeStore& this, Type* element) -> Type*;
	fn reference(var TypeStore& this, Type* element) -> Type*;
	fn array(var TypeStore& this, Type* element, u64 count) -> Type*;
	fn function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type*;
	fn function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity, bool nonthrowing) -> Type*;
	fn qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type*;
	fn clear(var TypeStore& this);

	fn find_primitive(TypeStore& this, rt::string_view name) -> Type*;

private:
	fn register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits);
	fn intern(var TypeStore& this, Type key) -> Type*;
	fn rehash(var TypeStore& this, usize count);

	fn find(TypeStore& this, Type& key) -> Type*;

	rt::buffer<rt::unique<FunctionSignature>> signatures;
	rt::buffer<rt::unique<TypeEntry>> entries;
	rt::buffer<var TypeEntry*> buckets;
	rt::unordered_map<rt::string_view, Type*> primitive_names;
};

fn TypeStore::find(TypeStore& this, Type& key) -> Type* {
	if (!this.buckets.size()) {
		return nullptr;
	};

	var TypeEntry* entry := this.buckets.data()[key.hash() % this.buckets.size()];

	while (entry) {
		if (entry->value.equals(key)) {
			return &@entry->value;
		};

		@entry := entry->next;
	};

	return nullptr;
};

fn TypeStore::rehash(var TypeStore& this, usize count) {
	rt::buffer<var TypeEntry*> replacement;

	@replacement.reserve(usize(count));

	usize index = 0;
	while (index < count) {
		@replacement.push_back(nullptr);

		@index = index + 1;
	};

	@index = 0;
	var TypeEntry var** buckets = (@replacement).data();

	while (index < this.entries.size()) {
		var TypeEntry* entry = this.entries.data()[index].get();
		usize bucket = entry->value.hash() % count;
		@entry->next := buckets[bucket];
		@buckets[bucket] := entry;
		@index = index + 1;
	};

	@this.buckets = $replacement;

};

fn TypeStore::intern(var TypeStore& this, Type key) -> Type* {
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!this.buckets.size()) {
		@this.rehash(64);
	}
	else if (this.entries.size() >= this.buckets.size()) {
		if (this.buckets.size() > usize::max / 2) {
			rt::allocation_error error;
			@error.requested_bytes = usize::max;
			throw $error;
		}
		else {
			@this.rehash(this.buckets.size() * 2);
		};
	};

	rt::unique<TypeEntry> owner = rt::unique<TypeEntry>::make();

	var TypeEntry* entry = owner.get();
	@entry->value = $key;

	@this.entries.push_back($owner);

	usize bucket = entry->value.hash() % this.buckets.size();
	var TypeEntry var** buckets = (@this.buckets).data();
	@entry->next := buckets[bucket];
	@buckets[bucket] := entry;

	return &@entry->value;
};

fn TypeStore::primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type* {
	TypeShape shape;
	@shape.bits = $bits;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type* {
	TypeShape shape;
	@shape.entity = $entity;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::pointer(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::pointer, $shape));
};

fn TypeStore::reference(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::reference, $shape));
};

fn TypeStore::array(var TypeStore& this, Type* element, u64 count) -> Type* {
	TypeShape shape;
	@shape.array.element = $element;
	@shape.array.count = $count;

	return @this.intern(Type(type_kind::array, $shape));
};

fn TypeStore::function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type* {
	return @this.function($result, $parameters, $arity, false);
};

fn TypeStore::function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity, bool nonthrowing) -> Type* {
	var signature = rt::unique<FunctionSignature>(new FunctionSignature($result, $parameters, $arity, $nonthrowing));

	if (!signature.get()) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(FunctionSignature);
		throw $error;
	};

	TypeShape shape;
	@shape.signature = signature.get();
	var key = Type(type_kind::function, $shape);
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	@this.signatures.push_back($signature);

	return @this.intern($key);
};

fn TypeStore::qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type* {
	return @this.intern(type.qualified($qualifier));
};

fn TypeStore::clear(var TypeStore& this) {
	@this.primitive_names.clear();
	@this.buckets.clear();
	@this.entries.clear();
	@this.signatures.clear();
};

struct TypeUse;

// A label's semantic spelling can be generated independently of its source location.
struct ParameterLabel {
	fn ParameterLabel(var ParameterLabel& this, Token& location, rt::string_view spelling);

	fn location(ParameterLabel& this) -> Token;
	fn text(ParameterLabel& this) -> rt::string_view;
	fn is(ParameterLabel& this, rt::string_view spelling) -> bool;

private:
	Token source_location;
	rt::string_view spelling;
};

struct ParameterUse {
	fn ParameterUse(var ParameterUse& this, rt::optional<ParameterLabel> name, TypeUse& type);

	fn name(ParameterUse& this) -> rt::optional<ParameterLabel>&;
	fn type(ParameterUse& this) -> TypeUse&;

private:
	rt::optional<ParameterLabel> parameter_name;
	TypeUse* parameter_type;
};

struct FunctionUse {
	fn FunctionUse(var FunctionUse& this, rt::buffer<ParameterUse> parameters, TypeUse& result);

	fn parameters(FunctionUse& this) -> rt::buffer<ParameterUse>&;
	fn result(FunctionUse& this) -> TypeUse&;

private:
	rt::buffer<ParameterUse> arguments;
	TypeUse* return_type;
};

union TypeUseDetail {
	TypeUse* element;
	FunctionUse* callable;
};

// A declaration's type spelling supplies metadata without changing canonical type identity.
// Nominal and primitive uses are leaves. Indirect/array uses carry their element use;
// callable uses carry parameter labels and nested uses in a separately owned FunctionUse.
struct TypeUse {
	fn TypeUse(var TypeUse& this, Type& type);
	fn TypeUse(var TypeUse& this, Type& type, TypeUse& element);
	fn TypeUse(var TypeUse& this, Type& type, FunctionUse& callable);

	fn type(TypeUse& this) -> Type&;
	fn element(TypeUse& this) -> TypeUse&;
	fn callable(TypeUse& this) -> FunctionUse&;
	fn effective(TypeUse& this) -> TypeUse&;

private:
	Type* canonical_type;
	TypeUseDetail detail;
};

fn ParameterLabel::ParameterLabel(var ParameterLabel& this, Token& location, rt::string_view spelling) {
	@this.source_location := location;
	@this.spelling = rt::string_view(spelling.data(), spelling.size());
};

fn ParameterLabel::location(ParameterLabel& this) -> Token {
	return Token(this.source_location);
};

fn ParameterLabel::text(ParameterLabel& this) -> rt::string_view {
	return rt::string_view(this.spelling.data(), this.spelling.size());
};

fn ParameterLabel::is(ParameterLabel& this, rt::string_view spelling) -> bool {
	return this.spelling == spelling;
};

fn ParameterUse::ParameterUse(var ParameterUse& this, rt::optional<ParameterLabel> name, TypeUse& type) {
	@this.parameter_name = $name;
	@this.parameter_type = &@type;
};

fn ParameterUse::name(ParameterUse& this) -> rt::optional<ParameterLabel>& {
	return this.parameter_name;
};

fn ParameterUse::type(ParameterUse& this) -> TypeUse& {
	return *this.parameter_type;
};

fn FunctionUse::FunctionUse(var FunctionUse& this, rt::buffer<ParameterUse> parameters, TypeUse& result) {
	@this.arguments = $parameters;
	@this.return_type = &@result;
};

fn FunctionUse::parameters(FunctionUse& this) -> rt::buffer<ParameterUse>& {
	return this.arguments;
};

fn FunctionUse::result(FunctionUse& this) -> TypeUse& {
	return *this.return_type;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type) {
	@this.canonical_type = &@type;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type, TypeUse& element) {
	@this.canonical_type = &@type;
	@this.detail.element = &@element;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type, FunctionUse& callable) {
	@this.canonical_type = &@type;
	@this.detail.callable = &@callable;
};

fn TypeUse::type(TypeUse& this) -> Type& {
	return *this.canonical_type;
};

fn TypeUse::element(TypeUse& this) -> TypeUse& {
	return *this.detail.element;
};

fn TypeUse::callable(TypeUse& this) -> FunctionUse& {
	return *this.detail.callable;
};

fn TypeUse::effective(TypeUse& this) -> TypeUse& {
	if (this.type().kind() == type_kind::reference) {
		return this.element();
	};

	return this;
};

fn SemanticUnit::canonical_use(var SemanticUnit& this, Type& type) -> TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		TypeUse* element = @this.canonical_use(*type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function) {
		return @this.leaf_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		TypeUse* element = @this.canonical_use(*type.signature().parameters().data()[index]);

		if (element) {
			@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(), *element));
		}
		else {
			return nullptr;
		};

		@index = index + 1;
	};

	TypeUse* result = @this.canonical_use(*type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::retype_use(var SemanticUnit& this, TypeUse& source, Type& type) -> TypeUse* {
	if (&@source.type() == &@type) {
		return &@source;
	};

	if (source.type().kind() != type.kind()) {
		return @this.canonical_use(type);
	};

	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		TypeUse* element = @this.retype_use(source.element(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function || source.callable().parameters().size() != type.signature().parameters().size()) {
		return @this.canonical_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		ParameterUse& previous = source.callable().parameters().data()[index];
		TypeUse* element = @this.retype_use(previous.type(), *type.signature().parameters().data()[index]);

		if (element) {
			@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(previous.name()), *element));
		}
		else {
			return nullptr;
		};

		@index = index + 1;
	};

	TypeUse* result = @this.retype_use(source.callable().result(), *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_type(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, Type& type) -> TypeUse* {
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_grouping || kind == syntax_kind::type_name || (kind == syntax_kind::type_const || kind == syntax_kind::type_mutable) || kind == syntax_kind::type_auto) {
		return @this.describe_type(@analyzer, @scope, *syntax.designated_type(), type);
	};

	if ((kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array) && (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array)) {
		TypeUse* element = @this.describe_type(@analyzer, @scope, *syntax.designated_type(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		var Entity* entity = @analyzer.lookup(@scope, @*(const_cast<var Syntax*>(&@syntax)));

		if (entity && entity->type_use().has_value()) {
			return @this.retype_use(entity->type_use().value(), type);
		};
	};

	if ((kind != syntax_kind::type_function && kind != syntax_kind::function) || type.kind() != type_kind::function) {
		return @this.canonical_use(type);
	};

	var Syntax* inputs = syntax.function_type_parameters();
	var Syntax* output = syntax.function_type_result();

	if (kind == syntax_kind::function) {
		@inputs = syntax.function_parameters();
		@output = syntax.function_result();
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		var Syntax* parameter = inputs->item(index);
		TypeUse* element = @this.describe_type(@analyzer, @scope, *parameter->parameter_type(), *type.signature().parameters().data()[index]);

		if (!element) {
			return nullptr;
		};

		rt::optional<ParameterLabel> name;

		if (parameter->parameter_name()->kind() != syntax_kind::absent) {
			Token location = parameter->parameter_name()->token();
			@name = rt::optional<ParameterLabel>(ParameterLabel(location, location.text()));
		};

		@parameters.push_back(ParameterUse($name, *element));

		@index = index + 1;
	};

	TypeUse* result = @this.describe_type(@analyzer, @scope, *output, *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_entity(var SemanticUnit& this, var Analyzer& analyzer, var Entity& entity) -> CompilationResult {
	if (!entity.type() || entity.type_use().has_value() || entity.kind() == entity_kind::template_pattern) {
		return;
	};

	var Syntax* source = entity.declaration();
	TypeUse* use = nullptr;

	if (entity.kind() == entity_kind::function) {
		rt::buffer<ParameterUse> parameters;
		usize index = 0;
		while (index < entity.parameters().size()) {
			var Entity* parameter = entity.parameters().data()[index];

			if (!(@this.describe_entity(@analyzer, @*parameter)).has<void>() || !parameter->type_use().has_value()) {
				return compilation_error();
			};

			rt::optional<ParameterLabel> name;

			if (!parameter->name().empty()) {
				@name = rt::optional<ParameterLabel>(ParameterLabel(parameter->token(), parameter->name()));
			};

			@parameters.push_back(ParameterUse($name, parameter->type_use().value()));

			@index = index + 1;
		};

		TypeUse* result = nullptr;

		if (source && source->kind() == syntax_kind::function) {
			var Scope* signature_scope = entity.members();

			if (entity.parameters().size()) {
				@signature_scope = entity.parameters().data()[0]->resolution_scope();
			};

			@result = @this.describe_type(@analyzer, @*signature_scope, *source->function_result(), *entity.type()->signature().result());
		}
		else {
			@result = @this.canonical_use(*entity.type()->signature().result());
		};

		if (!result) {
			return compilation_error();
		};

		@use = @this.function_use(*entity.type(), $parameters, *result);
	}
	else if (!source) {
		@use = @this.canonical_use(*entity.type());
	}
	else {
		if (entity.kind() == entity_kind::alias) {
			@source = source->alias_type();
		}
		else if (entity.kind() == entity_kind::local || entity.kind() == entity_kind::global || entity.kind() == entity_kind::field) {
			@source = source->variable_type();
		}
		else if (entity.kind() == entity_kind::parameter) {
			@source = source->parameter_type();
		};

		@use = @this.describe_type(@analyzer, @*entity.resolution_scope(), *source, *entity.type());
	};

	if (!use) {
		return compilation_error();
	};

	@entity.set_type_use(*use);

};

fn SemanticUnit::available_use(SemanticUnit& this, SemanticExpression& expression) -> TypeUse* {
	if (expression.type_use().has_value()) {
		return expression.type_use().get();
	};

	var Entity* binding = expression.entity();

	if (binding && binding->type_use().has_value()) {
		return &@binding->type_use().value().effective();
	};

	return nullptr;
};

fn SemanticUnit::describe_expression(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, var SemanticExpression& expression) -> CompilationResult {
	if (expression.type_use().has_value()) {
		return;
	};

	semantic_kind kind = expression.kind();

	if (kind == semantic_kind::variable) {
		var Entity* entity = expression.entity();
		TypeUse* use = nullptr;
		var Syntax* declaration = entity->declaration();

		if (declaration->kind() == syntax_kind::variable && declaration->variable_type()->kind() != syntax_kind::absent) {
			@use = @this.describe_type(@analyzer, @scope, *declaration->variable_type(), *entity->type());
		}
		else {
			@use = this.available_use(*expression.item(0));
		};

		if (use) {
			@entity->set_type_use(*use);
		};

		return;
	};

	if (expression.type()->kind() == type_kind::void_type) {
		return;
	};

	TypeUse* use = this.available_use(expression);

	if (kind == semantic_kind::allocation && syntax.kind() == syntax_kind::allocation && expression.type()->kind() == type_kind::pointer) {
		var Syntax* allocated = syntax.allocation_type();

		if (allocated->kind() == syntax_kind::type_array) {
			@allocated = allocated->designated_type();
		};

		TypeUse* element = @this.describe_type(@analyzer, @scope, *allocated, *expression.type()->element());

		if (element) {
			@use = @this.indirect_use(*expression.type(), *element);
		};
	}
	else if (kind == semantic_kind::construction && syntax.kind() == syntax_kind::call) {
		@use = @this.describe_type(@analyzer, @scope, *syntax.callable(), *expression.type());
	}
	else if (kind == semantic_kind::address) {
		TypeUse* child = this.available_use(*expression.item(0));

		if (child) {
			@child = @this.retype_use(*child, *expression.type()->element());
			if (child) {
				@use = @this.indirect_use(*expression.type(), *child);
			};
		};
	}
	else if (kind == semantic_kind::access || kind == semantic_kind::relocation || kind == semantic_kind::cast) {
		@use = this.available_use(*expression.item(0));

		if (syntax.kind() == syntax_kind::cast) {
			Type* target = @analyzer.type(@scope, @*syntax.cast_type());

			if (!target) {
				return compilation_error();
			};

			@use = @this.describe_type(@analyzer, @scope, *syntax.cast_type(), *target);

			if (use) {
				@use = &@use->effective();
			};
		};
	}
	else if (kind == semantic_kind::dereference || kind == semantic_kind::index) {
		TypeUse* child = this.available_use(*expression.item(0));

		if (child && (child->type().kind() == type_kind::pointer || child->type().kind() == type_kind::array)) {
			@use = &@child->element().effective();
		};
	}
	else if (kind == semantic_kind::binary) {
		if (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy || expression.type()->kind() == type_kind::pointer) {
			@use = this.available_use(*expression.item(0));

			if (!use || use->type().kind() != expression.type()->kind()) {
				@use = this.available_use(*expression.item(1));
			};
		};
	}
	else if (kind == semantic_kind::sequence && expression.size()) {
		@use = this.available_use(*expression.item(expression.size() - 1));
	}
	else if (kind == semantic_kind::call) {
		TypeUse* callable = this.available_use(*expression.item(0));

		if (callable && callable->type().kind() == type_kind::pointer) {
			@callable = &@callable->element();
		};

		if (callable && callable->type().kind() == type_kind::function) {
			@use = &@callable->callable().result().effective();
		};
	};

	if (use) {
		@use = @this.retype_use(*use, *expression.type());
	}
	else {
		@use = @this.canonical_use(*expression.type());
	};

	if (!use) {
		return compilation_error();
	};

	@expression.set_type_use(*use);

};

fn Analyzer::resolve(var Analyzer& this, var Entity* entity) -> CompilationResult {
	if (!(@this.resolve_impl(entity)).has<void>()) {
		return compilation_error();
	};

	return @this.unit->describe_entity(@this, @*entity);
};

fn Analyzer::expression(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	@this.unit->record_scope(@scope, @syntax);
	var result = @this.expression_impl(@scope, @syntax, expected);

	if (!result.get()) {
		return $result;
	};

	@this.unit->record_call(@scope, @syntax, *result.get());
	if (!((@this.unit->describe_expression(@this, @scope, syntax, @*result.get())).has<void>())) {
		@this.error(&@syntax, "could not describe the expression's type use");

		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn SemanticUnit::retain_use(var SemanticUnit& this, rt::unique<TypeUse> use) -> TypeUse* {
	TypeUse* borrowed = use.get();

	if (!borrowed) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(TypeUse);
		throw $error;
	};
	@this.type_uses.push_back(rt::unique<TypeUse>(@use.release()));

	return $borrowed;
};

fn SemanticUnit::leaf_use(var SemanticUnit& this, Type& type) -> TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array || type.kind() == type_kind::function) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type)));
};

fn SemanticUnit::indirect_use(var SemanticUnit& this, Type& type, TypeUse& element) -> TypeUse* {
	if (type.kind() != type_kind::pointer && type.kind() != type_kind::reference && type.kind() != type_kind::array) {
		return nullptr;
	};

	if (type.element() != &@element.type()) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type, element)));
};

fn SemanticUnit::function_use(var SemanticUnit& this, Type& type, rt::buffer<ParameterUse> parameters, TypeUse& result) -> TypeUse* {
	if (type.kind() != type_kind::function || type.signature().parameters().size() != parameters.size()) {
		return nullptr;
	};

	if (type.signature().result() != &@result.type()) {
		return nullptr;
	};

	usize index = 0;
	while (index < parameters.size()) {
		if (type.signature().parameters().data()[index] != &@parameters.data()[index].type().type()) {
			return nullptr;
		};

		@index = index + 1;
	};

	var function = rt::unique<FunctionUse>(new FunctionUse($parameters, result));
	var FunctionUse* borrowed = function.get();

	if (!borrowed) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(FunctionUse);
		throw $error;
	};
	@this.function_uses.push_back(rt::unique<FunctionUse>(@function.release()));

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type, *borrowed)));
};

struct TemplatePack;

enum template_argument_kind : [u08] {
	unbound;
	type;
	value;
	pack;
};

struct TemplateArgument {
	template_argument_kind kind;
	Type* type;
	rt::optional_ref<const TypeUse> type_use;
	u64 value;
	f64 real_value;
	var TemplatePack* pack;

	fn same(TemplateArgument& this, TemplateArgument& other) -> bool;
};

struct PackElementSignature {
	template_argument_kind kind;
	Type* value_type;
};

struct TemplatePack {
	rt::buffer<PackElementSignature> signature;
	rt::buffer<TemplateArgument> elements;
};

struct TemplateInstantiation {
	var Entity* pattern;
	usize source_argument_count;
	rt::buffer<TemplateArgument> arguments;
};

struct AssociatedScope {
	Type* type;
	var Entity* owner;
};

struct ResolvedReference {
	Token location;
	var Entity* target;
	var Entity* context;
	u32 roles;
};

struct TemplateOrigin {
	var Entity* instance;
	var Entity* pattern;
};

struct SemanticScopeRegion {
	var Scope* scope;
	var Syntax* syntax;
};

struct SemanticCallSite {
	var Scope* scope;
	var Syntax* syntax;
	var Entity* selected;
	var Entity* candidates;
	bool bound_receiver;
};

struct SemanticReceiverSite {
	var Scope* scope;
	var Syntax* syntax;
	var Entity* owner;
};

struct SemanticClassification {
	Token location;
	u32 type;
	u32 modifiers;
};

struct InlineRecord {
	var Syntax* syntax;
	var Scope* scope;
	var Entity* entity;
};

struct SemanticUnit {
	fn create_pack(var SemanticUnit& this) -> var TemplatePack*;
	fn associate(var SemanticUnit& this, Type& type, var Entity& owner);
	fn canonical_use(var SemanticUnit& this, Type& type) -> TypeUse*;
	fn retype_use(var SemanticUnit& this, TypeUse& source, Type& type) -> TypeUse*;
	fn describe_type(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, Type& type) -> TypeUse*;
	fn describe_entity(var SemanticUnit& this, var Analyzer& analyzer, var Entity& entity) -> CompilationResult;
	fn describe_expression(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, var SemanticExpression& expression) -> CompilationResult;
	fn leaf_use(var SemanticUnit& this, Type& type) -> TypeUse*;
	fn indirect_use(var SemanticUnit& this, Type& type, TypeUse& element) -> TypeUse*;
	fn function_use(var SemanticUnit& this, Type& type, rt::buffer<ParameterUse> parameters, TypeUse& result) -> TypeUse*;
	fn create_scope(var SemanticUnit& this, var Scope* parent, var Entity* owner) -> var Scope*;
	fn create_entity(var SemanticUnit& this, entity_kind kind, Token& token, var Syntax* syntax, var Scope* scope) -> var Entity*;
	fn inline_record(SemanticUnit& this, Syntax& syntax, Scope& scope) -> var Entity*;
	fn retain_inline_record(var SemanticUnit& this, var Syntax& syntax, var Scope& scope, var Entity& entity);

	fn associated_owner(SemanticUnit& this, Type& type) -> var Entity*;
	fn entities(SemanticUnit& this) -> rt::buffer<rt::unique<Entity>>&;
	fn root_scope(SemanticUnit& this) -> var Scope*;

	fn record_name(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Entity& target, u32 roles);
	fn record_reference(var SemanticUnit& this, Token& token, var Entity& target, var Entity* context, u32 roles);
	fn record_origin(var SemanticUnit& this, var Entity& instance, var Entity& pattern, rt::buffer<TemplateArgument>& arguments, usize source_argument_count);
	fn reference_context(SemanticUnit& this, var Scope& scope) -> var Entity*;
	fn template_origin(SemanticUnit& this, Entity& entity) -> var Entity*;
	fn record_scope(var SemanticUnit& this, var Scope& scope, var Syntax& syntax);
	fn record_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, SemanticExpression& expression);
	fn scope_regions(SemanticUnit& this) -> rt::buffer<SemanticScopeRegion>&;
	fn record_incomplete_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& group, bool bound_receiver);
	fn record_receiver(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& owner);
	fn receiver_sites(SemanticUnit& this) -> rt::buffer<SemanticReceiverSite>&;
	fn call_sites(SemanticUnit& this) -> rt::buffer<SemanticCallSite>&;
	fn record_classification(var SemanticUnit& this, Token& location, u32 type, u32 modifiers);
	fn classifications(SemanticUnit& this) -> rt::buffer<SemanticClassification>&;
	fn references(SemanticUnit& this) -> rt::buffer<ResolvedReference>&;
	fn fact_contexts(SemanticUnit& this) -> InferredContextSet&;
	fn mutable_fact_contexts(var SemanticUnit& this) -> var InferredContextSet&;

private:
	fn retain_use(var SemanticUnit& this, rt::unique<TypeUse> use) -> TypeUse*;

	fn available_use(SemanticUnit& this, SemanticExpression& expression) -> TypeUse*;

	rt::buffer<rt::unique<TemplatePack>> packs;
	rt::buffer<AssociatedScope> associated_scopes;
	rt::buffer<rt::unique<TypeUse>> type_uses;
	rt::buffer<rt::unique<FunctionUse>> function_uses;
	rt::buffer<ResolvedReference> resolved_references;
	rt::buffer<SemanticClassification> token_classifications;
	rt::buffer<TemplateOrigin> template_origins;
	rt::buffer<rt::unique<TemplateInstantiation>> template_instantiations;
	rt::buffer<SemanticScopeRegion> regions;
	rt::buffer<SemanticCallSite> calls;
	rt::buffer<SemanticReceiverSite> receivers;
	rt::buffer<InlineRecord> inline_records;
	var Scope* global_scope;
	InferredContextSet inferred_contexts;
	rt::buffer<rt::unique<Scope>> scopes;
	rt::buffer<rt::unique<Entity>> declarations;
};

fn SemanticUnit::fact_contexts(SemanticUnit& this) -> InferredContextSet& {
	return this.inferred_contexts;
};

fn SemanticUnit::mutable_fact_contexts(var SemanticUnit& this) -> var InferredContextSet& {
	return @this.inferred_contexts;
};

fn SemanticUnit::entities(SemanticUnit& this) -> rt::buffer<rt::unique<Entity>>& {
	return this.declarations;
};

fn SemanticUnit::root_scope(SemanticUnit& this) -> var Scope* {
	return this.global_scope;
};

fn SemanticUnit::create_scope(var SemanticUnit& this, var Scope* parent, var Entity* owner) -> var Scope* {
	var owned = rt::unique<Scope>(new Scope($parent, $owner));
	var Scope* result = owned.get();

	if (!result) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Scope);
		throw $error;
	};

	@this.scopes.push_back($owned);

	if (!this.global_scope) {
		@this.global_scope := result;
	};

	return $result;
};

fn SemanticUnit::create_entity(var SemanticUnit& this, entity_kind kind, Token& token, var Syntax* syntax, var Scope* scope) -> var Entity* {
	var owned = rt::unique<Entity>(new Entity($kind, token, $syntax, scope));
	var Entity* result = owned.get();

	if (!result) {
		rt::allocation_error error;
		@error.requested_bytes = sizeof(Entity);
		throw $error;
	};

	@result->set_access(scope->access());

	if (scope->owner() && scope->owner()->instantiated()) {
		@result->set_instantiated();
	};

	@this.declarations.push_back($owned);

	@scope->define((var Entity*(result)));

	return $result;
};

fn SemanticUnit::record_reference(var SemanticUnit& this, Token& token, var Entity& target, var Entity* context, u32 roles) {
	if (!token.source || !token.length || target.origin() == declaration_origin::compiler_supplied) {
		return;
	};
	ResolvedReference reference;
	@reference.location := token;
	@reference.target = target.canonical();
	@reference.context = $context;
	@reference.roles = $roles;
	@this.resolved_references.push_back($reference);
};

fn SemanticUnit::record_origin(var SemanticUnit& this, var Entity& instance, var Entity& pattern, rt::buffer<TemplateArgument>& arguments, usize source_argument_count) {
	rt::unique<TemplateInstantiation> metadata = rt::unique<TemplateInstantiation>::make();
	@metadata.get()->pattern = &@pattern;
	@metadata.get()->source_argument_count = $source_argument_count;
	usize index = 0;
	while (index < arguments.size()) {
		TemplateArgument& source = arguments.data()[index];
		TemplateArgument argument;
		@argument.kind = source.kind;
		@argument.type = source.type;
		@argument.type_use = source.type_use;
		@argument.value = source.value;
		@argument.real_value = source.real_value;
		@argument.pack = source.pack;
		@metadata.get()->arguments.push_back($argument);
		@index = index + 1;
	};
	TemplateInstantiation* retained = metadata.get();
	@this.template_instantiations.push_back($metadata);
	@instance.set_template_arguments(retained);

	TemplateOrigin origin;
	@origin.instance = &@instance;
	@origin.pattern = &@pattern;
	@this.template_origins.push_back($origin);
};

fn SemanticUnit::reference_context(SemanticUnit& this, var Scope& scope) -> var Entity* {
	var Scope* current = &@scope;
	while (current) {
		var Entity* owner = current->owner();
		if (owner && owner->instantiated()) {
			return owner->canonical();
		};
		@current = current->parent();
	};
	return nullptr;
};

fn SemanticUnit::template_origin(SemanticUnit& this, Entity& entity) -> var Entity* {
	usize index = 0;
	while (index < this.template_origins.size()) {
		TemplateOrigin& origin = this.template_origins.data()[index];
		if (origin.instance == &@entity) {
			return origin.pattern;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn SemanticUnit::references(SemanticUnit& this) -> rt::buffer<ResolvedReference>& {
	return this.resolved_references;
};

fn SemanticUnit::record_name(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Entity& target, u32 roles) {
	if (name.kind() == syntax_kind::type_name) {
		@this.record_name(@analyzer, @scope, @*name.designated_type(), @target, $roles);
		return;
	};
	if (name.kind() == syntax_kind::call || name.kind() == syntax_kind::template_apply) {
		@this.record_name(@analyzer, @scope, @*name.callable(), @target, $roles);
		return;
	};
	if (name.kind() == syntax_kind::member) {
		@this.record_name(@analyzer, @scope, @*name.member_name(), @target, $roles);
		return;
	};
	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @analyzer.lookup(@scope, @*name.left());
		if (owner) {
			@this.record_name(@analyzer, @scope, @*name.left(), @*owner, 2);
		};
		@this.record_name(@analyzer, @scope, @*name.right(), @target, $roles);
		return;
	};
	if (name.kind() == syntax_kind::unary) {
		@this.record_name(@analyzer, @scope, @*name.operand(), @target, $roles);
		return;
	};
	@this.record_reference(name.token(), @target, this.reference_context(@scope), $roles);
};

fn SemanticUnit::record_scope(var SemanticUnit& this, var Scope& scope, var Syntax& syntax) {
	SemanticScopeRegion region;
	@region.scope = &@scope;
	@region.syntax = &@syntax;
	@this.regions.push_back($region);
};

fn SemanticUnit::scope_regions(SemanticUnit& this) -> rt::buffer<SemanticScopeRegion>& {
	return this.regions;
};

fn SemanticUnit::call_sites(SemanticUnit& this) -> rt::buffer<SemanticCallSite>& {
	return this.calls;
};

fn SemanticUnit::record_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, SemanticExpression& expression) {
	if (syntax.kind() != syntax_kind::call) {
		return;
	};
	SemanticExpression* call = &@expression;
	while (call->kind() != semantic_kind::call && call->size() == 1) {
		@call = call->item(0);
	};
	if (call->kind() != semantic_kind::call || !call->entity()) {
		return;
	};
	SemanticCallSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.selected = call->entity()->canonical();
	@site.bound_receiver = syntax.callable()->kind() == syntax_kind::member && call->size() > 1 && call->item(1)->size() == syntax.arguments()->size() + 1;
	@this.calls.push_back($site);
};

fn SemanticUnit::record_receiver(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& owner) {
	SemanticReceiverSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.owner = &@owner;

	@this.receivers.push_back($site);
};

fn SemanticUnit::receiver_sites(SemanticUnit& this) -> rt::buffer<SemanticReceiverSite>& {
	return this.receivers;
};

fn SemanticUnit::record_incomplete_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& group, bool bound_receiver) {
	SemanticCallSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.candidates = &@group;
	@site.bound_receiver = $bound_receiver;

	@this.calls.push_back($site);
};

fn SemanticUnit::record_classification(var SemanticUnit& this, Token& location, u32 type, u32 modifiers) {
	SemanticClassification classification;
	@classification.location := location;
	@classification.type = $type;
	@classification.modifiers = $modifiers;

	@this.token_classifications.push_back($classification);
};

fn SemanticUnit::classifications(SemanticUnit& this) -> rt::buffer<SemanticClassification>& {
	return this.token_classifications;
};

fn SemanticUnit::create_pack(var SemanticUnit& this) -> var TemplatePack* {
	rt::unique<TemplatePack> owned = rt::unique<TemplatePack>::make();
	var TemplatePack* result = owned.get();
	@this.packs.push_back($owned);
	return $result;
};

fn Analyzer::prepare_variant_special(var Analyzer& this, var Entity& function) -> CompilationResult {
	var Entity* owner = function.scope()->owner();
	TemplatePack& alternatives = *owner->template_arguments()->arguments.data()[0].pack;
	if (function.role() == function_role::constructor && function.parameters().size() == 1) {
		if (!alternatives.elements.size()) {
			return compilation_error();
		};
		Type* first = alternatives.elements.data()[0].type;
		if (first->kind() == type_kind::null_type || first->kind() == type_kind::void_type || (@this.prepare_default(first)).has<void>()) {
			return;
		};
		return compilation_error();
	};
	bool copy = function.parameters().size() == 2 && function.parameters().data()[1]->type()->kind() == type_kind::reference;
	usize index = 0;
	while (index < alternatives.elements.size()) {
		Type* type = alternatives.elements.data()[index].type;
		@index = index + 1;
		if (type->kind() == type_kind::null_type || type->kind() == type_kind::void_type) {
			continue;
		};
		if (!(@this.prepare_lifetime(type)).has<void>()) {
			return compilation_error();
		};
		if (copy && !(@this.prepare_copy(type)).has<void>()) {
			return compilation_error();
		};
		if (copy && function.role() == function_role::assignment && !(@this.prepare_copy_assignment(type)).has<void>()) {
			return compilation_error();
		};
	};
};

fn variant_special_nonthrowing(Entity& function) -> bool {
	var Entity* owner = function.scope()->owner();
	if (function.role() == function_role::constructor && function.parameters().size() == 1) {
		TemplatePack& alternatives = *owner->template_arguments()->arguments.data()[0].pack;
		if (!alternatives.elements.size()) {
			return false;
		};
		Type* first = alternatives.elements.data()[0].type;
		return first->kind() == type_kind::null_type || first->kind() == type_kind::void_type || exception_operation_nonthrowing(*first, exception_operation::initialize);
	};
	bool copy = function.parameters().size() == 2 && function.parameters().data()[1]->type()->kind() == type_kind::reference;
	bool destroys = function.role() == function_role::destructor || function.role() == function_role::assignment;
	TemplatePack& alternatives = *owner->template_arguments()->arguments.data()[0].pack;
	usize index = 0;
	while (index < alternatives.elements.size()) {
		Type* type = alternatives.elements.data()[index].type;
		@index = index + 1;
		if (type->kind() == type_kind::null_type || type->kind() == type_kind::void_type) {
			continue;
		};
		if (destroys && !exception_type_nonthrowing(*type)) {
			return false;
		};
		if (copy && !exception_operation_nonthrowing(*type, exception_operation::copy_construct)) {
			return false;
		};
		if (copy && function.role() == function_role::assignment && !exception_operation_nonthrowing(*type, exception_operation::copy_assign)) {
			return false;
		};
	};
	return true;
};

fn variant_default_constructible(Type* type) -> bool {
	if (type->kind() == type_kind::reference) {
		return false;
	};
	if (type->kind() == type_kind::array) {
		return variant_default_constructible(type->element());
	};
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};
	var Entity* record = type->entity();
	var Entity* constructor = record->default_constructor();
	if (!constructor || constructor->definition() == function_definition::deleted || constructor->access() != access_kind::public_access) {
		return false;
	};
	if (constructor->definition() != function_definition::defaulted || record->layout() == record_layout::overlapping) {
		return true;
	};
	if (variant_instance(*record)) {
		TemplatePack& alternatives = *record->template_arguments()->arguments.data()[0].pack;
		return alternatives.elements.size() && variant_default_constructible(alternatives.elements.data()[0].type);
	};
	usize index = 0;
	while (index < record->bases().size()) {
		if (!variant_default_constructible(record->bases().data()[index])) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		if (!field->body() && (!field->declaration() || field->declaration()->variable_initializer()->kind() == syntax_kind::absent) && !variant_default_constructible(field->type())) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn configure_variant_copy(var Entity& record) {
	TemplatePack& alternatives = *record.template_arguments()->arguments.data()[0].pack;
	usize index = 0;
	while (index < alternatives.elements.size()) {
		if (!exception_copyable(alternatives.elements.data()[index].type)) {
			@index = 0;
			while (index < record.members()->bindings().size()) {
				var Entity* function = record.members()->bindings().data()[index];
				@index = index + 1;
				if (function->kind() != entity_kind::function || function->definition() != function_definition::defaulted || function->parameters().size() != 2 || function->parameters().data()[1]->type()->kind() != type_kind::reference) {
					continue;
				};
				if (function->role() == function_role::constructor || function->role() == function_role::assignment) {
					@function->set_definition(function_definition::deleted);
				};
			};
			return;
		};
		@index = index + 1;
	};
};

enum syntax_kind : [i32] {
	absent;
	error_expression;
	noop;
	unit;
	name;
	number;
	string;
	null_pointer;
	unary;
	grouping;
	binary;
	call;
	member;
	index;
	brace;
	array;
	conditional;
	while_loop;
	for_loop;
	return_value;
	exception_try;
	exception_handler;
	exception_throw;
	exception_specification;
	exception_query;
	break_loop;
	continue_loop;
	discard_value;
	allocation;
	deallocation;
	array_deallocation;
	switch_expression;
	case_label;
	sizeof_type;
	cast;
	variable;
	parameter;
	function;
	record;
	enumeration;
	enumerator;
	namespace_body;
	template_declaration;
	template_parameter;
	template_variadic_parameter;
	pack_literal;
	pack_signature;
	pack_signature_element;
	pack_signature_variadic_element;
	pack_signature_declaration;
	pack_expansion;
	pack_fold;
	using_alias;
	list;
	attributes;
	declaration_attribute;
	ambiguity;
	type_name;
	type_tuple;
	type_variant;
	type_grouping;
	type_pointer;
	type_reference;
	type_array;
	type_function;
	type_const;
	type_mutable;
	type_auto;
	access_label;
	qualified_name;
	conversion_name;
	operator_name;
	operator_array;
	template_apply;
};

// Syntax owns source structure. Resolved entities and types belong to semantic analysis.
// Slots are explicit: absent has no source expression; noop denotes the token ';'.
// Fixed shapes are constructed in grammar order and checked before publication:
// variable = [name, type, initializer], parameter = [name, type, default]
// function = [name, parameters, result, attributes, body]
// record = [name, bases, members], enumeration = [name, underlying, members]
// conditional = [condition, body, alternative], while/switch = [condition, body]
// for = [initializer, condition, step, body], call = [callable, arguments]
// namespace/template = [name-or-parameters, body-or-declaration]
// indirect type = [element], array type = [element, extent]
// function type = [parameters, result], const type = [element, condition]
// Lists, brace expressions, units, and attributes own a sequence of children.
// Ambiguity owns complete source interpretations, never borrowed alternatives.

struct Syntax {
	fn Syntax(var Syntax& this, syntax_kind kind, Token& token);
	fn Syntax(var Syntax& this, Syntax& other) : [delete];
	fn Syntax(var Syntax& this, Syntax other) : [default];

	fn operator=(var Syntax& this, Syntax& other) -> var Syntax& : [delete];
	fn operator=(var Syntax& this, Syntax other) -> var Syntax& : [default];
	fn append(var Syntax& this, rt::unique<Syntax> child) -> CompilationResult;

	fn declaration_attributes(Syntax& this) -> rt::buffer<rt::unique<Syntax>>&;
	fn add_declaration_attribute(var Syntax& this, rt::unique<Syntax> attribute);
	fn same_declaration_metadata(Syntax& this, Syntax& other) -> bool;
	fn take_declaration_attribute(var Syntax& this, usize index) -> rt::unique<Syntax>;
	fn exported(Syntax& this) -> bool;
	fn mark_exported(var Syntax& this);
	fn function_linkage(Syntax& this) -> Token;
	fn set_function_linkage(var Syntax& this, Token& linkage);
	fn kind(Syntax& this) -> syntax_kind;
	fn explicitly_qualified(Syntax& this) -> bool;
	fn token(Syntax& this) -> Token;
	fn size(Syntax& this) -> usize;
	fn item(Syntax& this, usize index) -> var Syntax*;
	fn complete(Syntax& this) -> bool;
	fn fixed_arity(Syntax& this) -> usize;

private:
	syntax_kind category;
	Token location;
	bool is_exported;
	Token linkage;
	rt::buffer<rt::unique<Syntax>> metadata;
	rt::buffer<rt::unique<Syntax>> children;
};

fn Syntax::Syntax(var Syntax& this, syntax_kind kind, Token& token) {
	@this.is_exported = false;
	@this.category = $kind;
	@this.location := token;
};

fn Syntax::declaration_attributes(Syntax& this) -> rt::buffer<rt::unique<Syntax>>& {
	return this.metadata;
};

fn Syntax::add_declaration_attribute(var Syntax& this, rt::unique<Syntax> attribute) {
	@this.metadata.push_back($attribute);
};

fn Syntax::same_declaration_metadata(Syntax& this, Syntax& other) -> bool {
	if (this.exported() != other.exported() || this.linkage.text() != other.linkage.text() || this.metadata.size() != other.metadata.size()) {
		return false;
	};
	usize index = 0;
	while (index < this.metadata.size()) {
		if (!this.metadata.data()[index].get()->same_tree(*other.metadata.data()[index].get())) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Syntax::take_declaration_attribute(var Syntax& this, usize index) -> rt::unique<Syntax> {
	if (index >= this.metadata.size()) {
		return rt::unique<Syntax>();
	};
	return rt::unique<Syntax>(@((@this.metadata).data()[index]).release());
};

fn Syntax::exported(Syntax& this) -> bool {
	return this.is_exported;
};

fn Syntax::mark_exported(var Syntax& this) {
	@this.is_exported = true;
};

fn Syntax::function_linkage(Syntax& this) -> Token {
	return Token(this.linkage);
};

fn Syntax::set_function_linkage(var Syntax& this, Token& linkage) {
	@this.linkage := linkage;
};

fn Syntax::kind(Syntax& this) -> syntax_kind {
	return syntax_kind(this.category);
};

fn Syntax::explicitly_qualified(Syntax& this) -> bool {
	return this.category == syntax_kind::type_const || this.category == syntax_kind::type_mutable || this.category == syntax_kind::type_auto;
};

fn Syntax::token(Syntax& this) -> Token {
	return Token(this.location);
};

fn Syntax::size(Syntax& this) -> usize {
	return this.children.size();
};

fn Syntax::item(Syntax& this, usize index) -> var Syntax* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn Syntax::append(var Syntax& this, rt::unique<Syntax> child) -> CompilationResult {
	if (!child.get()) {
		return compilation_error();
	};
	if (this.children.size() >= this.fixed_arity()) {
		compiler_panic("syntax children exceed the fixed syntax shape");
	};

	@this.children.push_back($child);
};

fn Syntax::operand(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::left(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::right(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::callable(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::arguments(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::member_object(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::member_name(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::index_object(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::index_value(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::condition(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::body(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alternative(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_initializer(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::for_condition(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::for_step(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_body(Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::variable_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::variable_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::variable_initializer(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::parameter_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::parameter_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::parameter_default(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_parameters(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_result(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_attributes(Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::function_body(Syntax& this) -> var Syntax* {
	return this.item(4);
};

fn Syntax::record_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::record_bases(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::record_members(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::enum_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enum_underlying(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::enum_members(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::namespace_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::namespace_members(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameters(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_declaration(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alias_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::alias_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::cast_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::cast_operand(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::allocation_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::allocation_arguments(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::designated_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::array_extent(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_type_parameters(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_type_result(Syntax& this) -> var Syntax* {
	return this.item(1);
};

// TypeSyntax is a borrowed view of the owned syntax subtree for a type-id.

struct TypeSyntax {
	fn TypeSyntax(var TypeSyntax& this, var Syntax* syntax);

	fn kind(TypeSyntax& this) -> syntax_kind;
	fn element(TypeSyntax& this) -> var Syntax*;
	fn extent(TypeSyntax& this) -> var Syntax*;
	fn parameters(TypeSyntax& this) -> var Syntax*;
	fn result(TypeSyntax& this) -> var Syntax*;

private:
	var Syntax* syntax;
};

fn TypeSyntax::TypeSyntax(var TypeSyntax& this, var Syntax* syntax) {
	@this.syntax = $syntax;
};

fn TypeSyntax::kind(TypeSyntax& this) -> syntax_kind {
	return this.syntax->kind();
};

fn TypeSyntax::element(TypeSyntax& this) -> var Syntax* {
	return this.syntax->designated_type();
};

fn TypeSyntax::extent(TypeSyntax& this) -> var Syntax* {
	return this.syntax->array_extent();
};

fn TypeSyntax::parameters(TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_parameters();
};

fn TypeSyntax::result(TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_result();
};

fn Syntax::qualifier_condition(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::same_tree(Syntax& this, Syntax& other) -> bool {
	if (this.kind() != other.kind() || this.token().source != other.token().source || this.token().begin != other.token().begin || this.token().length != other.token().length || this.size() != other.size() || this.exported() != other.exported() || this.linkage.text() != other.linkage.text() || this.metadata.size() != other.metadata.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.size()) {
		if (!this.item(index)->same_tree(*other.item(index))) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;
	while (index < this.metadata.size()) {
		if (!this.metadata.data()[index].get()->same_tree(*other.metadata.data()[index].get())) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Syntax::take_item(var Syntax& this, usize index) -> rt::unique<Syntax> {
	if (index >= this.children.size()) {
		return rt::unique<Syntax>();
	};

	return rt::unique<Syntax>(@((@this.children).data()[index]).release());
};

fn Syntax::fixed_arity(Syntax& this) -> usize {
	switch (this.category) {
		case syntax_kind::error_expression:
		case syntax_kind::absent:
		case syntax_kind::noop:
		case syntax_kind::name:
		case syntax_kind::number:
		case syntax_kind::string:
		case syntax_kind::null_pointer:
		case syntax_kind::break_loop:
		case syntax_kind::continue_loop:
		case syntax_kind::access_label:
		case syntax_kind::operator_array:
			return 0;
		case syntax_kind::declaration_attribute:
		case syntax_kind::pack_signature_element:
		case syntax_kind::pack_signature_variadic_element:
		case syntax_kind::pack_expansion:
		case syntax_kind::pack_fold:
		case syntax_kind::unary:
		case syntax_kind::grouping:
		case syntax_kind::type_grouping:
		case syntax_kind::return_value:
		case syntax_kind::exception_throw:
		case syntax_kind::exception_specification:
		case syntax_kind::exception_query:
		case syntax_kind::discard_value:
		case syntax_kind::deallocation:
		case syntax_kind::array_deallocation:
		case syntax_kind::sizeof_type:
		case syntax_kind::conversion_name:
		case syntax_kind::type_name:
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_auto:
		case syntax_kind::array:
			return 1;
		case syntax_kind::pack_signature_declaration:
		case syntax_kind::binary:
		case syntax_kind::type_tuple:
		case syntax_kind::type_variant:
		case syntax_kind::call:
		case syntax_kind::member:
		case syntax_kind::index:
		case syntax_kind::while_loop:
		case syntax_kind::exception_try:
		case syntax_kind::exception_handler:
		case syntax_kind::switch_expression:
		case syntax_kind::cast:
		case syntax_kind::allocation:
		case syntax_kind::namespace_body:
		case syntax_kind::template_declaration:
		case syntax_kind::using_alias:
		case syntax_kind::enumerator:
		case syntax_kind::type_array:
		case syntax_kind::type_const:
		case syntax_kind::type_mutable:
		case syntax_kind::qualified_name:
		case syntax_kind::template_apply:
		case syntax_kind::operator_name:
			return 2;
		case syntax_kind::conditional:
		case syntax_kind::type_function:
		case syntax_kind::variable:
		case syntax_kind::parameter:
		case syntax_kind::record:
		case syntax_kind::enumeration:
		case syntax_kind::template_variadic_parameter:
		case syntax_kind::template_parameter:
			return 3;
		case syntax_kind::for_loop:
			return 4;
		case syntax_kind::function:
			return 5;
		case syntax_kind::case_label:
			return 1;
		default:
			return usize::max;
	};
};

fn Syntax::complete(Syntax& this) -> bool {
	usize arity = this.fixed_arity();

	if (arity != usize::max && this.children.size() != arity) {
		return false;
	};

	if (this.category == syntax_kind::ambiguity && this.children.size() < 2) {
		return false;
	};

	usize index = 0;

	while (index < this.children.size()) {
		if (!this.item(index) || !this.item(index)->complete()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::case_value(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_value(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_name(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_parameter_default(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::operator_target(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::operator_token(Syntax& this) -> Token {
	return this.item(0)->token();
};

fn Syntax::operator_suffix(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::pack_signature_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::pack_signature_body(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::pack_operand(Syntax& this) -> var Syntax* {
	return this.item(0);
};
