struct ContextDisposer {
	fn dispose(LLVMOpaqueContext* value);
};

fn ContextDisposer::dispose(LLVMOpaqueContext* value) {
	if (value) {
		LLVMContextDispose(value);
	};
};

struct ModuleDisposer {
	fn dispose(LLVMOpaqueModule* value);
};

fn ModuleDisposer::dispose(LLVMOpaqueModule* value) {
	if (value) {
		LLVMDisposeModule(value);
	};
};

