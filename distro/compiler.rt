namespace rt {
	template<typename T>
	struct default_delete {
		fn dispose(T* pointer);
	};

	template<typename T, typename D = default_delete<T>>
	struct unique {
		fn unique(unique& this) : [default];
		fn unique(unique& this, T* pointer);
		fn unique(unique& this, const unique& other) : [delete];
		fn operator=(unique& this, const unique& other) -> unique& : [delete];
		fn operator:=(unique& this, const unique& other) -> unique& : [delete];
		fn ~unique(unique& this);
		fn make() -> unique;

		fn release(unique& this) -> T*;
		fn reset(unique& this, T* pointer);

		fn get(const unique& this) -> T*;

	private:
		T* pointer;
	};

	template<typename T>
	fn default_delete<T>::dispose(T* pointer) {
		delete pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::unique(unique& this, T* pointer) {
		@this.pointer = $pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::~unique(unique& this) {
		@this.reset(nullptr);
	};

	template<typename T, typename D>
	fn unique<T, D>::get(const unique& this) -> T* {
		return this.pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::release(unique& this) -> T* {
		T* result := this.pointer;

		@this.pointer = nullptr;

		return $result;
	};

	template<typename T, typename D>
	fn unique<T, D>::reset(unique& this, T* pointer) {
		T* previous := this.pointer;

		@this.pointer = $pointer;
		D::dispose($previous);
	};

	template<typename T, typename D>
	fn unique<T, D>::make() -> unique {
		return unique(new T());
	};
};

namespace rt {
	enum optional_state : [u08] {
		empty;
		engaged;
	};

	template<typename T>
	union optional_storage {
		fn optional_storage(optional_storage& this);
		fn ~optional_storage(optional_storage& this);

		u08 empty;
		T value;
	};

	template<typename T>
	struct optional {
		fn optional(optional& this);
		fn optional(optional& this, T value);
		fn optional(optional& this, const optional& other);
		fn optional(optional& this, optional other);
		fn ~optional(optional& this);

		fn reset(optional& this);
		fn emplace(optional& this, T value) -> T&;

		fn has_value(const optional& this) -> bool;
		fn get(auto optional& this) -> const[this] T*;
		// Requires has_value(). The reference borrows the contained object's lifetime.
		fn value(auto optional& this) -> const[this] T&;

	private:
		optional_storage<T> storage;
		optional_state state;
	};

	template<typename T>
	struct optional_ref {
		fn optional_ref(optional_ref& this) : [default];
		fn optional_ref(optional_ref& this, T& value);
		fn optional_ref(optional_ref& this, const optional_ref& other) : [implicit];

		fn reset(optional_ref& this);
		fn bind(optional_ref& this, T& value);

		fn has_value(const optional_ref& this) -> bool;
		fn get(const optional_ref& this) -> T*;
		// Requires has_value(). Resetting the optional never destroys its referent.
		fn value(const optional_ref& this) -> T&;

	private:
		T* pointer;
	};

	template<typename T>
	fn optional_storage<T>::optional_storage(optional_storage& this) {
		@this.empty = 0;
	};

	template<typename T>
	fn optional_storage<T>::~optional_storage(optional_storage& this) {
	};

	template<typename T>
	fn optional<T>::optional(optional& this) {
	};

	template<typename T>
	fn optional<T>::optional(optional& this, T value) {
		@this.storage.value.T($value);
		@this.state = optional_state::engaged;
	};

	template<typename T>
	fn optional<T>::optional(optional& this, const optional& other) {
		if (other.has_value()) {
			@this.storage.value.T(other.storage.value);
			@this.state = optional_state::engaged;
		};
	};

	template<typename T>
	fn optional<T>::optional(optional& this, optional other) {
		if (other.has_value()) {
			T* source = &other.storage.value;

			@this.storage.value.T($(*source));
			@this.state = optional_state::engaged;
			@other.state = optional_state::empty;
		};
	};

	template<typename T>
	fn optional<T>::~optional(optional& this) {
		@this.reset();
	};

	template<typename T>
	fn optional<T>::has_value(const optional& this) -> bool {
		return this.state == optional_state::engaged;
	};

	template<typename T>
	fn optional<T>::get(auto optional& this) -> const[this] T* {
		if (!this.has_value()) {
			return nullptr;
		};

		return &this.storage.value;
	};

	template<typename T>
	fn optional<T>::value(auto optional& this) -> const[this] T& {
		return const_cast<const[this] T&>(@const_cast<T&>(this.storage.value));
	};

	template<typename T>
	fn optional<T>::reset(optional& this) {
		if (!this.has_value()) {
			return;
		};

		@this.storage.value.~T();
		@this.state = optional_state::empty;
	};

	template<typename T>
	fn optional<T>::emplace(optional& this, T value) -> T& {
		@this.reset();
		@this.storage.value.T($value);
		@this.state = optional_state::engaged;

		return @this.storage.value;
	};

	template<typename T>
	fn optional_ref<T>::optional_ref(optional_ref& this, T& value) {
		@this.pointer = &value;
	};

	template<typename T>
	fn optional_ref<T>::optional_ref(optional_ref& this, const optional_ref& other) : [implicit] {
		@this.pointer := other.pointer;
	};

	template<typename T>
	fn optional_ref<T>::has_value(const optional_ref& this) -> bool {
		return this.pointer != nullptr;
	};

	template<typename T>
	fn optional_ref<T>::get(const optional_ref& this) -> T* {
		return this.pointer;
	};

	template<typename T>
	fn optional_ref<T>::value(const optional_ref& this) -> T& {
		return static_cast<T&>(*this.pointer);
	};

	template<typename T>
	fn optional_ref<T>::reset(optional_ref& this) {
		@this.pointer = nullptr;
	};

	template<typename T>
	fn optional_ref<T>::bind(optional_ref& this, T& value) {
		@this.pointer = &value;
	};
};

fn malloc(usize size) -> void*;

fn free(void* memory);

namespace rt {
	template<typename T>
	struct buffer {
		fn buffer(buffer& this) : [default];
		fn buffer(buffer& this, const buffer& other);
		fn ~buffer(buffer& this);

		fn operator=(buffer& this, const buffer& other) -> buffer&;
		fn operator:=(buffer& this, const buffer& other) -> buffer&;
		fn reserve(buffer& this, usize required) -> bool;
		fn push_back(buffer& this, T value) -> bool;
		fn pop_back(buffer& this) -> bool;
		fn clear(buffer& this);

		fn data(auto buffer& this) -> const[this] T*;
		fn size(const buffer& this) -> usize;
		fn capacity(const buffer& this) -> usize;

	private:
		fn copy_from(buffer& this, const buffer& other) -> bool;

		T* _storage;
		usize _size;
		usize _capacity;
	};

	template<typename T>
	fn buffer<T>::buffer(buffer& this, const buffer& other) {
		@this.copy_from(other);
	};

	template<typename T>
	fn buffer<T>::operator=(buffer& this, const buffer& other) -> buffer& {
		buffer replacement;
		if (!@replacement.copy_from(other)) {
			return @this;
		};

		@this = $replacement;

		return @this;
	};

	template<typename T>
	fn buffer<T>::copy_from(buffer& this, const buffer& other) -> bool {
		if (!@this.reserve(other._size)) {
			return false;
		};

		while (this._size < other._size) {
			@this._storage[this._size].T(other._storage[this._size]);
			@this._size = this._size + 1;
		};

		return true;
	};

	template<typename T>
	fn buffer<T>::operator:=(buffer& this, const buffer& other) -> buffer& {
		return @this = other;
	};

	template<typename T>
	fn buffer<T>::~buffer(buffer& this) {
		@this.clear();
		free(this._storage);
	};

	template<typename T>
	fn buffer<T>::reserve(buffer& this, usize required) -> bool {
		if (required <= this._capacity) {
			return true;
		};

		usize element_size = sizeof(T);
		usize maximum = usize::max;
		if (element_size) {
			@maximum = maximum / element_size;
		};

		if (required > maximum) {
			return false;
		};

		usize count = $required;
		if (this._capacity <= (maximum >> 1)) {
			usize grown = this._capacity << 1;
			if (grown > count) {
				@count = $grown;
			};
		};

		usize bytes = count * element_size;
		if (!bytes) {
			@bytes = 1;
		};

		T* replacement = static_cast<T*>(malloc($bytes));
		if (!replacement) {
			return false;
		};

		usize index = 0;
		while (index < this._size) {
			@replacement[index].T($(this._storage[index]));
			@index = index + 1;
		};

		free(this._storage);
		@this._storage = $replacement;
		@this._capacity = $count;

		return true;
	};

	template<typename T>
	fn buffer<T>::push_back(buffer& this, T value) -> bool {
		if (this._size == usize::max || !@this.reserve(this._size + 1)) {
			return false;
		};

		@this._storage[this._size].T($value);
		@this._size = this._size + 1;

		return true;
	};

	template<typename T>
	fn buffer<T>::pop_back(buffer& this) -> bool {
		if (!this._size) {
			return false;
		};

		@this._size = this._size - 1;
		@this._storage[this._size].~T();

		return true;
	};

	template<typename T>
	fn buffer<T>::clear(buffer& this) {
		while (this._size) {
			@this._size = this._size - 1;
			@this._storage[this._size].~T();
		};
	};

	template<typename T>
	fn buffer<T>::size(const buffer& this) -> usize {
		return this._size;
	};

	template<typename T>
	fn buffer<T>::capacity(const buffer& this) -> usize {
		return this._capacity;
	};

	template<typename T>
	fn buffer<T>::data(auto buffer& this) -> const[this] T* {
		return this._storage;
	};
};

namespace rt {
	struct string_view {
		fn string_view(string_view& this) : [default];
		fn string_view(string_view& this, const string_view& other) : [implicit, default];
		fn string_view(string_view& this, const string& text) : [implicit];
		fn string_view(string_view& this, const char* data, usize size);
		fn string_view(string_view& this, const char* text) : [implicit];

		fn data(const string_view& this) -> const char*;
		fn size(const string_view& this) -> usize;
		fn empty(const string_view& this) -> bool;
		fn slice(const string_view& this, usize begin, usize count) -> string_view;
		fn compare(const string_view& this, const string_view& other) -> i32;

	private:
		const char* bytes;
		usize length;
	};

	fn operator==(const string_view& first, const string_view& second) -> bool {
		return !first.compare(second);
	};

	fn operator!=(const string_view& first, const string_view& second) -> bool {
		return first.compare(second) != 0;
	};

	fn operator<(const string_view& first, const string_view& second) -> bool {
		return first.compare(second) < 0;
	};

	fn operator<=(const string_view& first, const string_view& second) -> bool {
		return first.compare(second) <= 0;
	};

	fn operator>(const string_view& first, const string_view& second) -> bool {
		return first.compare(second) > 0;
	};

	fn operator>=(const string_view& first, const string_view& second) -> bool {
		return first.compare(second) >= 0;
	};

	fn string_view::string_view(string_view& this, const char* data, usize size) {
		@this.bytes = $data;
		@this.length = $size;
	};

	fn string_view::string_view(string_view& this, const char* text) : [implicit] {
		@this.bytes = $text;
		while (this.bytes && this.bytes[this.length]) {
			@this.length = this.length + 1;
		};
	};

	fn string_view::data(const string_view& this) -> const char* {
		return this.bytes;
	};

	fn string_view::size(const string_view& this) -> usize {
		return this.length;
	};

	fn string_view::empty(const string_view& this) -> bool {
		return !this.length;
	};

	fn string_view::slice(const string_view& this, usize begin, usize count) -> string_view {
		return string_view(this.bytes + begin, $count);
	};

	fn string_view::compare(const string_view& this, const string_view& other) -> i32 {
		usize count := this.length;
		if (other.length < count) {
			@count := other.length;
		};

		usize index = 0;
		while (index < count) {
			char first_byte := this.bytes[index];
			char second_byte := other.bytes[index];
			u08 first = static_cast<u08>($first_byte);
			u08 second = static_cast<u08>($second_byte);
			if (first < second) {
				return -1;
			};

			if (first > second) {
				return 1;
			};

			@index = index + 1;
		};

		if (this.length < other.length) {
			return -1;
		};

		if (this.length > other.length) {
			return 1;
		};

		return 0;
	};
};

namespace rt {
	struct string {
		fn string(string& this) : [default];
		fn string(string& this, const string& other);
		fn string(string& this, const string_view& text);
		fn string(string& this, const char* text);

		fn operator=(string& this, const string& other) -> string&;
		fn clear(string& this);
		fn append(string& this, const string_view& text) -> bool;

		fn size(const string& this) -> usize;
		fn empty(const string& this) -> bool;
		fn data(auto string& this) -> const[this] char*;
		fn c_str(const string& this) -> const char*;
		fn view(const string& this) -> string_view;

	private:
		buffer<char> bytes;
	};

	fn string_view::string_view(string_view& this, const string& text) {
		@this.bytes = text.data();
		@this.length = text.size();
	};

	fn string::append(string& this, const string_view& text) -> bool {
		if (text.empty()) {
			return true;
		};

		usize size = this.size();
		if (text.size() > usize::max - size - 1) {
			return false;
		};

		const char* source = text.data();
		usize offset = 0;
		usize address = reinterpret_cast<usize>(source);
		usize begin = reinterpret_cast<usize>(this.bytes.data());
		bool aliases = address >= begin && address - begin < this.bytes.size();
		if (aliases) {
			@offset = address - begin;
		};

		if (!@this.bytes.reserve(size + text.size() + 1)) {
			return false;
		};

		if (aliases) {
			@source = this.bytes.data() + offset;
		};

		@this.bytes.pop_back();

		usize index = 0;
		while (index < text.size()) {
			@this.bytes.push_back(char(source[index]));
			@index = index + 1;
		};

		@this.bytes.push_back('\0');

		return true;
	};

	fn string::string(string& this, const string& other) {
		@this.append(other.view());
	};

	fn string::string(string& this, const string_view& text) {
		@this.append(text);
	};

	fn string::string(string& this, const char* text) {
		@this.append(string_view($text));
	};

	fn string::operator=(string& this, const string& other) -> string& {
		string replacement;
		if (!@replacement.append(other.view())) {
			return @this;
		};

		@this = $replacement;

		return @this;
	};

	fn string::size(const string& this) -> usize {
		if (!this.bytes.size()) {
			return 0;
		};

		return this.bytes.size() - 1;
	};

	fn string::empty(const string& this) -> bool {
		return !this.size();
	};

	fn string::data(auto string& this) -> const[this] char* {
		return const_cast<const[this] char*>(this.bytes.data());
	};

	fn string::c_str(const string& this) -> const char* {
		if (!this.bytes.size()) {
			return "\0";
		};

		return this.bytes.data();
	};

	fn string::view(const string& this) -> string_view {
		return string_view(this.bytes.data(), this.size());
	};

	fn string::clear(string& this) {
		@this.bytes.clear();
	};
};

namespace rt {
	fn mix_hash(u64 value) -> usize {
		@value = (value ^ (value >> 30)) * 13787848793156543929;
		@value = (value ^ (value >> 27)) * 10723151780598845931;

		return static_cast<usize>(value ^ (value >> 31));
	};

	template<typename K>
	struct integer_hash {
		fn hash(const integer_hash& this, const K& value) -> usize;
	};

	template<typename T>
	struct pointer_hash {
		fn hash(const pointer_hash& this, const T* value) -> usize;
	};

	struct f32_hash {
		fn hash(const f32_hash& this, const f32& value) -> usize;
	};

	struct f64_hash {
		fn hash(const f64_hash& this, const f64& value) -> usize;
	};

	struct string_view_hash {
		fn hash(const string_view_hash& this, const string_view& value) -> usize;
	};

	template<typename K>
	fn integer_hash<K>::hash(const integer_hash& this, const K& value) -> usize {
		return mix_hash(static_cast<u64>(value));
	};

	template<typename T>
	fn pointer_hash<T>::hash(const pointer_hash& this, const T* value) -> usize {
		return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));
	};

	fn f32_hash::hash(const f32_hash& this, const f32& value) -> usize {
		if (value == 0.0) {
			return 0;
		};

		return mix_hash(static_cast<u64>(*reinterpret_cast<const u32*>(&value)));
	};

	fn f64_hash::hash(const f64_hash& this, const f64& value) -> usize {
		if (value == 0.0) {
			return 0;
		};

		return mix_hash(*reinterpret_cast<const u64*>(&value));
	};

	fn string_view_hash::hash(const string_view_hash& this, const string_view& value) -> usize {
		u64 result = 14695981039346656037;
		usize index = 0;
		while (index < value.size()) {
			char byte = value.data()[index];

			@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * 1099511628211;
			@index = index + 1;
		};

		return static_cast<usize>(result);
	};
};

namespace rt {
	template<typename K>
	struct default_equal {
		fn equal(const default_equal& this, const K& first, const K& second) -> bool;
	};

	template<typename K>
	fn default_equal<K>::equal(const default_equal& this, const K& first, const K& second) -> bool {
		return first == second;
	};
};

namespace rt {
	template<typename T>
	union unordered_slot {
		fn unordered_slot(unordered_slot& this);
		fn ~unordered_slot(unordered_slot& this);

		u08 empty;
		T object;
	};

	template<typename K, typename V>
	struct unordered_node {
		fn unordered_node(unordered_node& this, K key, V value, usize code);
		fn ~unordered_node(unordered_node& this);

		unordered_slot<K> key;
		unordered_slot<V> value;
		unordered_node* next;
		usize hash_code;
	};

	// Equal must define an equivalence relation; equivalent keys must have equal hashes.
	// Hash and Equal are called through const references and must remain stable while keys are stored.
	// Key storage borrowed by a key (such as string_view bytes) must remain valid and unchanged.
	// Insert consumes both arguments, returning false on duplicate or allocation failure.
	// Pointers returned by find survive insert/reserve and moves of their owning map.
	// Erase invalidates only the erased value; clear and destruction invalidate all values.
	template<typename K, typename V, typename Hash, typename Equal = default_equal<K>>
	struct unordered_map {
		fn unordered_map(unordered_map& this);
		fn unordered_map(unordered_map& this, Hash hash, Equal equal);
		fn unordered_map(unordered_map& this, const unordered_map& other) : [delete];
		fn operator=(unordered_map& this, const unordered_map& other) -> unordered_map& : [delete];
		fn operator:=(unordered_map& this, const unordered_map& other) -> unordered_map& : [delete];
		fn ~unordered_map(unordered_map& this);

		fn insert(unordered_map& this, K key, V value) -> bool;
		fn erase(unordered_map& this, const K& key) -> bool;
		fn clear(unordered_map& this);
		fn reserve(unordered_map& this, usize required) -> bool;

		fn size(const unordered_map& this) -> usize;
		fn empty(const unordered_map& this) -> bool;
		fn find(auto unordered_map& this, const K& key) -> const[this] V*;

	private:
		buffer<unordered_node<K, V>*> buckets;
		unordered_slot<Hash> hasher;
		unordered_slot<Equal> comparison;
		usize length;
	};

	template<typename T>
	fn unordered_slot<T>::unordered_slot(unordered_slot& this) {
		@this.empty = 0;
	};

	template<typename T>
	fn unordered_slot<T>::~unordered_slot(unordered_slot& this) {
	};

	template<typename K, typename V>
	fn unordered_node<K, V>::unordered_node(unordered_node& this, K key, V value, usize code) {
		@this.key.object.K($key);
		@this.value.object.V($value);
		@this.hash_code = $code;
	};

	template<typename K, typename V>
	fn unordered_node<K, V>::~unordered_node(unordered_node& this) {
		@this.value.object.~V();
		@this.key.object.~K();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::unordered_map(unordered_map& this) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash();
		@this.comparison.object.Equal();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::unordered_map(unordered_map& this, Hash hash, Equal equal) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash($hash);
		@this.comparison.object.Equal($equal);
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::~unordered_map(unordered_map& this) {
		@this.clear();
		@this.comparison.object.~Equal();
		@this.hasher.object.~Hash();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::size(const unordered_map& this) -> usize {
		return this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::empty(const unordered_map& this) -> bool {
		return !this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::find(auto unordered_map& this, const K& key) -> const[this] V* {
		if (!this.buckets.size()) {
			return nullptr;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		unordered_node<K, V>* node = this.buckets.data()[index];
		while (node) {
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				return const_cast<const[this] V*>(&node->value.object);
			};

			@node = node->next;
		};

		return nullptr;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::insert(unordered_map& this, K key, V value) -> bool {
		if (this.find(key) || this.length == usize::max) {
			return false;
		};

		usize code = this.hasher.object.hash(key);
		if (!@this.reserve(this.length + 1)) {
			return false;
		};

		using Node = unordered_node<K, V>;
		Node* node = static_cast<Node*>(malloc(sizeof(Node)));
		if (!node) {
			return false;
		};

		@node->Node($key, $value, $code);

		usize index = node->hash_code % this.buckets.size();

		@node->next = this.buckets.data()[index];
		@(@this.buckets).data()[index] = node;
		@this.length = this.length + 1;

		return true;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::erase(unordered_map& this, const K& key) -> bool {
		if (!this.buckets.size()) {
			return false;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		unordered_node<K, V>** link = &@(@this.buckets).data()[index];
		while (*link) {
			unordered_node<K, V>* node = *link;
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				@*link = node->next;

				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@this.length = this.length - 1;

				return true;
			};

			@link = &@node->next;
		};

		return false;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::clear(unordered_map& this) {
		usize index = 0;
		while (index < this.buckets.size()) {
			unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				unordered_node<K, V>* next = node->next;
				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@node = next;
			};

			@(@this.buckets).data()[index] = nullptr;
			@index = index + 1;
		};

		@this.length = 0;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::reserve(unordered_map& this, usize required) -> bool {
		if (required <= this.buckets.size()) {
			return true;
		};

		usize maximum = usize::max / sizeof(unordered_node<K, V>*);
		if (required > maximum) {
			return false;
		};

		usize count = $required;
		if (count < 8) {
			@count = 8;
		};

		if (this.buckets.size() <= (maximum >> 1)) {
			usize grown = this.buckets.size() << 1;
			if (grown > count) {
				@count = grown;
			};
		};

		buffer<unordered_node<K, V>*> replacement;
		if (!@replacement.reserve(count)) {
			return false;
		};

		usize index = 0;
		while (index < count) {
			if (!@replacement.push_back(nullptr)) {
				return false;
			};

			@index = index + 1;
		};

		@index = 0;
		while (index < this.buckets.size()) {
			unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				unordered_node<K, V>* next = node->next;
				usize bucket = node->hash_code % count;

				@node->next = replacement.data()[bucket];
				@(@replacement).data()[bucket] = node;
				@node = next;
			};

			@index = index + 1;
		};

		@this.buckets = $replacement;

		return true;
	};
};

enum token_kind : [i32] {
	identifier;
	literal_number;
	literal_string;
	kw_fn;
	kw_using;
	kw_const;
	kw_discard;
	kw_delete;
	kw_new;
	kw_implicit;
	kw_nullptr;
	kw_template;
	kw_typename;
	kw_class;
	kw_var;
	kw_struct;
	kw_union;
	kw_enum;
	kw_namespace;
	kw_virtual;
	kw_override;
	kw_final;
	kw_return;
	kw_if;
	kw_else;
	kw_while;
	kw_for;
	kw_switch;
	kw_case;
	kw_default;
	kw_break;
	kw_continue;
	kw_sizeof;
	op_arrow;
	op_copy;
	op_equal;
	op_not_equal;
	op_less_equal;
	op_greater_equal;
	op_and;
	op_or;
	op_shift_left;
	op_shift_right;
	punct_ellipsis;
	punct_left_paren;
	punct_right_paren;
	punct_left_bracket;
	punct_right_bracket;
	punct_left_brace;
	punct_right_brace;
	punct_semicolon;
	punct_comma;
	punct_colon;
	op_scope;
	op_dot;
	op_assign;
	op_plus;
	op_minus;
	op_star;
	op_slash;
	op_remainder;
	op_ampersand;
	op_pipe;
	op_caret;
	op_bang;
	op_tilde;
	op_access;
	op_relocate;
	op_less;
	op_greater;
	eof;
};

struct Token {
	fn text(const Token& this) -> rt::string_view;
	fn is(const Token& this, const rt::string_view& spelling) -> bool;
	fn same(const Token& this, const Token& other) -> bool;

	SourceFile* source;
	usize begin;
	usize length;
	usize line;
	usize column;
	token_kind kind;
};

fn Token::text(const Token& this) -> rt::string_view {
	if (!this.source) {
		return rt::string_view();
	};

	var source = this.source->text();

	if (this.begin > source.size() || this.length > source.size() - this.begin) {
		return rt::string_view();
	};

	return rt::string_view(source.data() + this.begin, this.length);
};

fn Token::is(const Token& this, const rt::string_view& spelling) -> bool {
	return this.source && this.text() == spelling;
};

fn Token::same(const Token& this, const Token& other) -> bool {
	return this.source && other.source && this.text() == other.text();
};

struct SourceFile {
	fn SourceFile(SourceFile& this) : [default];

	fn assign(SourceFile& this, const rt::string_view& path, const rt::string_view& text) -> bool;
	fn append_token(SourceFile& this, Token token) -> bool;
	fn clear_tokens(SourceFile& this);

	fn path(const SourceFile& this) -> rt::string_view;
	fn text(const SourceFile& this) -> rt::string_view;
	fn line(const SourceFile& this, usize number) -> rt::string_view;
	fn tokens(const SourceFile& this) -> const rt::buffer<Token>&;
	fn token_count(const SourceFile& this) -> usize;

private:
	rt::string file_path;
	rt::string contents;
	rt::buffer<usize> line_offsets;
	rt::buffer<Token> token_buffer;
};

struct SourceManager {
	fn add(SourceManager& this, const rt::string_view& path, const rt::string_view& text) -> SourceFile*;
	fn at(SourceManager& this, usize index) -> SourceFile*;
	fn clear(SourceManager& this);

	fn count(const SourceManager& this) -> usize;

private:
	rt::buffer<rt::unique<SourceFile>> files;
};

fn SourceFile::assign(SourceFile& this, const rt::string_view& path, const rt::string_view& text) -> bool {
	rt::string next_path;
	rt::string next_text;
	rt::buffer<usize> next_lines;

	if (!@next_path.append(path) || !@next_text.append(text) || !@next_lines.push_back(0)) {
		return false;
	};

	usize offset = 0;

	while (offset < text.size()) {
		if (text.data()[offset] == '\n' && !@next_lines.push_back(offset + 1)) {
			return false;
		};

		@offset = offset + 1;
	};

	@this.token_buffer.clear();
	@this.file_path = $next_path;
	@this.contents = $next_text;
	@this.line_offsets = $next_lines;

	return true;
};

fn SourceFile::path(const SourceFile& this) -> rt::string_view {
	return this.file_path.view();
};

fn SourceFile::text(const SourceFile& this) -> rt::string_view {
	return this.contents.view();
};

fn SourceFile::line(const SourceFile& this, usize number) -> rt::string_view {
	if (!number || number > this.line_offsets.size()) {
		return rt::string_view();
	};

	usize begin = this.line_offsets.data()[number - 1];
	usize end = this.contents.size();

	if (number < this.line_offsets.size()) {
		@end = this.line_offsets.data()[number] - 1;
	};

	if (end > begin && this.contents.data()[end - 1] == '\r') {
		@end = end - 1;
	};

	return rt::string_view(this.contents.data() + begin, end - begin);
};

fn SourceFile::tokens(const SourceFile& this) -> const rt::buffer<Token>& {
	return this.token_buffer;
};

fn SourceFile::token_count(const SourceFile& this) -> usize {
	return this.token_buffer.size();
};

fn SourceFile::append_token(SourceFile& this, Token token) -> bool {
	return @this.token_buffer.push_back($token);
};

fn SourceFile::clear_tokens(SourceFile& this) {
	@this.token_buffer.clear();
};

fn SourceManager::add(SourceManager& this, const rt::string_view& path, const rt::string_view& text) -> SourceFile* {
	var file = rt::unique<SourceFile>::make();

	if (!file.get() || !@file.get()->assign(path, text)) {
		return nullptr;
	};

	SourceFile* result = file.get();

	if (!@this.files.push_back($file)) {
		return nullptr;
	};

	return result;
};

fn SourceManager::count(const SourceManager& this) -> usize {
	return this.files.size();
};

fn SourceManager::at(SourceManager& this, usize index) -> SourceFile* {
	if (index >= this.files.size()) {
		return nullptr;
	};

	return this.files.data()[index].get();
};

fn SourceManager::clear(SourceManager& this) {
	@this.files.clear();
};

struct Lexer {
	fn Lexer(Lexer& this, SourceFile& source);

	fn scan(Lexer& this) -> bool;

	fn error(const Lexer& this) -> rt::string_view;
	fn error_token(const Lexer& this) -> Token;

private:
	SourceFile* source;
	usize offset;
	usize line;
	usize column;
	rt::string_view failure;
	Token failure_token;

	fn advance(Lexer& this) -> char;
	fn fail(Lexer& this, const Token& token, const rt::string_view& message) -> bool;
	fn trivia(Lexer& this) -> bool;
	fn number(Lexer& this, const Token& token) -> bool;
	fn quoted(Lexer& this, const Token& token, char quote) -> bool;
	fn symbol(Lexer& this, Token& token) -> bool;
	fn identifier_kind(const rt::string_view& spelling) -> token_kind;
	fn identifier_start(char value) -> bool;
	fn digit(char value) -> bool;

	fn peek(const Lexer& this, usize distance) -> char;
	fn location(const Lexer& this) -> Token;
};

fn Lexer::Lexer(Lexer& this, SourceFile& source) {
	@this.source = &source;
	@this.line = 1;
	@this.column = 1;
};

fn Lexer::peek(const Lexer& this, usize distance) -> char {
	var text = this.source->text();

	if (this.offset >= text.size() || distance >= text.size() - this.offset) {
		return 0;
	};

	return text.data()[this.offset + distance];
};

fn Lexer::advance(Lexer& this) -> char {
	char value = this.peek(0);

	if (!value) {
		return 0;
	};

	@this.offset = this.offset + 1;

	if (value == '\n') {
		@this.line = this.line + 1;
		@this.column = 1;
	}
	else {
		@this.column = this.column + 1;
	};

	return value;
};

fn Lexer::location(const Lexer& this) -> Token {
	Token token;
	@token.source = this.source;
	@token.begin = this.offset;
	@token.line = this.line;
	@token.column = this.column;

	return $token;
};

fn Lexer::fail(Lexer& this, const Token& token, const rt::string_view& message) -> bool {
	@this.failure = rt::string_view(message);
	@this.failure_token = Token(token);

	return false;
};

fn Lexer::error(const Lexer& this) -> rt::string_view {
	return rt::string_view(this.failure);
};

fn Lexer::error_token(const Lexer& this) -> Token {
	return Token(this.failure_token);
};

fn Lexer::identifier_start(char value) -> bool {
	return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || value == '_';
};

fn Lexer::digit(char value) -> bool {
	return value >= '0' && value <= '9';
};

fn Lexer::identifier_kind(const rt::string_view& spelling) -> token_kind {
	if (spelling == rt::string_view("fn\0")) {
		return token_kind::kw_fn;
	};

	if (spelling == rt::string_view("using\0")) {
		return token_kind::kw_using;
	};

	if (spelling == rt::string_view("const\0")) {
		return token_kind::kw_const;
	};

	if (spelling == rt::string_view("discard\0")) {
		return token_kind::kw_discard;
	};

	if (spelling == rt::string_view("delete\0")) {
		return token_kind::kw_delete;
	};

	if (spelling == rt::string_view("new\0")) {
		return token_kind::kw_new;
	};

	if (spelling == rt::string_view("implicit\0")) {
		return token_kind::kw_implicit;
	};

	if (spelling == rt::string_view("nullptr\0")) {
		return token_kind::kw_nullptr;
	};

	if (spelling == rt::string_view("template\0")) {
		return token_kind::kw_template;
	};

	if (spelling == rt::string_view("typename\0")) {
		return token_kind::kw_typename;
	};

	if (spelling == rt::string_view("class\0")) {
		return token_kind::kw_class;
	};

	if (spelling == rt::string_view("var\0")) {
		return token_kind::kw_var;
	};

	if (spelling == rt::string_view("struct\0")) {
		return token_kind::kw_struct;
	};

	if (spelling == rt::string_view("union\0")) {
		return token_kind::kw_union;
	};

	if (spelling == rt::string_view("enum\0")) {
		return token_kind::kw_enum;
	};

	if (spelling == rt::string_view("namespace\0")) {
		return token_kind::kw_namespace;
	};

	if (spelling == rt::string_view("virtual\0")) {
		return token_kind::kw_virtual;
	};

	if (spelling == rt::string_view("override\0")) {
		return token_kind::kw_override;
	};

	if (spelling == rt::string_view("final\0")) {
		return token_kind::kw_final;
	};

	if (spelling == rt::string_view("return\0")) {
		return token_kind::kw_return;
	};

	if (spelling == rt::string_view("if\0")) {
		return token_kind::kw_if;
	};

	if (spelling == rt::string_view("else\0")) {
		return token_kind::kw_else;
	};

	if (spelling == rt::string_view("while\0")) {
		return token_kind::kw_while;
	};

	if (spelling == rt::string_view("for\0")) {
		return token_kind::kw_for;
	};

	if (spelling == rt::string_view("switch\0")) {
		return token_kind::kw_switch;
	};

	if (spelling == rt::string_view("case\0")) {
		return token_kind::kw_case;
	};

	if (spelling == rt::string_view("default\0")) {
		return token_kind::kw_default;
	};

	if (spelling == rt::string_view("break\0")) {
		return token_kind::kw_break;
	};

	if (spelling == rt::string_view("continue\0")) {
		return token_kind::kw_continue;
	};

	if (spelling == rt::string_view("sizeof\0")) {
		return token_kind::kw_sizeof;
	};

	return token_kind::identifier;
};

fn Lexer::trivia(Lexer& this) -> bool {
	while (true) {
		char value = this.peek(0);

		if (value == ' ' || value == '\t' || value == '\r' || value == '\n') {
			@this.advance();
			continue;
		};

		if (value != '/') {
			break;
		};

		if (this.peek(1) == '/') {
			while (this.peek(0) && this.peek(0) != '\n') {
				@this.advance();
			};

			continue;
		};

		if (this.peek(1) != '*') {
			break;
		};

		var start = this.location();
		@this.advance();
		@this.advance();

		while (true) {
			if (!this.peek(0)) {
				return @this.fail(start, rt::string_view("unterminated comment\0"));
			};

			if (this.peek(0) == '*' && this.peek(1) == '/') {
				@this.advance();
				@this.advance();
				break;
			};

			@this.advance();
		};
	};

	return true;
};

fn Lexer::number(Lexer& this, const Token& token) -> bool {
	while (Lexer::digit(this.peek(0))) {
		@this.advance();
	};

	if (this.peek(0) == '.' && Lexer::digit(this.peek(1))) {
		@this.advance();

		while (Lexer::digit(this.peek(0))) {
			@this.advance();
		};
	};

	if (this.peek(0) != 'e' && this.peek(0) != 'E') {
		return true;
	};

	@this.advance();

	if (this.peek(0) == '+' || this.peek(0) == '-') {
		@this.advance();
	};

	if (!Lexer::digit(this.peek(0))) {
		return @this.fail(token, rt::string_view("expected exponent digits\0"));
	};

	while (Lexer::digit(this.peek(0))) {
		@this.advance();
	};

	return true;
};

fn Lexer::quoted(Lexer& this, const Token& token, char quote) -> bool {
	@this.advance();

	if (quote == '\'') {
		char value = @this.advance();

		if (!value || value == '\'' || value == '\n' || value == '\r') {
			return @this.fail(token, rt::string_view("expected one character in literal\0"));
		};

		if (value == '\\') {
			char escaped = @this.advance();

			if (!escaped || escaped == '\n' || escaped == '\r') {
				return @this.fail(token, rt::string_view("unterminated character escape\0"));
			};
		};

		if (@this.advance() != '\'') {
			return @this.fail(token, rt::string_view("expected closing quote after character\0"));
		};

		return true;
	};

	while (this.peek(0) != '"') {
		if (!this.peek(0)) {
			return @this.fail(token, rt::string_view("unterminated string literal\0"));
		};

		if (this.peek(0) == '\n') {
			return @this.fail(token, rt::string_view("newline in string literal\0"));
		};

		if (@this.advance() == '\\' && this.peek(0)) {
			@this.advance();
		};
	};

	@this.advance();

	return true;
};

fn Lexer::symbol(Lexer& this, Token& token) -> bool {
	usize width = 1;
	char next = this.peek(1);

	switch (this.peek(0)) {
		case '(':
			@token.kind = token_kind::punct_left_paren;
			break;
		case ')':
			@token.kind = token_kind::punct_right_paren;
			break;
		case '[':
			@token.kind = token_kind::punct_left_bracket;
			break;
		case ']':
			@token.kind = token_kind::punct_right_bracket;
			break;
		case '{':
			@token.kind = token_kind::punct_left_brace;
			break;
		case '}':
			@token.kind = token_kind::punct_right_brace;
			break;
		case ';':
			@token.kind = token_kind::punct_semicolon;
			break;
		case ',':
			@token.kind = token_kind::punct_comma;
			break;
		case '+':
			@token.kind = token_kind::op_plus;
			break;
		case '*':
			@token.kind = token_kind::op_star;
			break;
		case '/':
			@token.kind = token_kind::op_slash;
			break;
		case '%':
			@token.kind = token_kind::op_remainder;
			break;
		case '^':
			@token.kind = token_kind::op_caret;
			break;
		case '~':
			@token.kind = token_kind::op_tilde;
			break;
		case '@':
			@token.kind = token_kind::op_access;
			break;
		case '$':
			@token.kind = token_kind::op_relocate;
			break;
		case ':':
			@token.kind = token_kind::punct_colon;

			if (next == ':') {
				@token.kind = token_kind::op_scope;
				@width = 2;
			};

			if (next == '=') {
				@token.kind = token_kind::op_copy;
				@width = 2;
			};

			break;
		case '-':
			@token.kind = token_kind::op_minus;

			if (next == '>') {
				@token.kind = token_kind::op_arrow;
				@width = 2;
			};

			break;
		case '=':
			@token.kind = token_kind::op_assign;

			if (next == '=') {
				@token.kind = token_kind::op_equal;
				@width = 2;
			};

			break;
		case '!':
			@token.kind = token_kind::op_bang;

			if (next == '=') {
				@token.kind = token_kind::op_not_equal;
				@width = 2;
			};

			break;
		case '<':
			@token.kind = token_kind::op_less;

			if (next == '=') {
				@token.kind = token_kind::op_less_equal;
				@width = 2;
			};

			if (next == '<') {
				@token.kind = token_kind::op_shift_left;
				@width = 2;
			};

			break;
		case '>':
			@token.kind = token_kind::op_greater;

			if (next == '=') {
				@token.kind = token_kind::op_greater_equal;
				@width = 2;
			};

			if (next == '>') {
				@token.kind = token_kind::op_shift_right;
				@width = 2;
			};

			break;
		case '&':
			@token.kind = token_kind::op_ampersand;

			if (next == '&') {
				@token.kind = token_kind::op_and;
				@width = 2;
			};

			break;
		case '|':
			@token.kind = token_kind::op_pipe;

			if (next == '|') {
				@token.kind = token_kind::op_or;
				@width = 2;
			};

			break;
		case '.':
			@token.kind = token_kind::op_dot;

			if (next == '.' && this.peek(2) == '.') {
				@token.kind = token_kind::punct_ellipsis;
				@width = 3;
			};

			break;
		default:
			return @this.fail(token, rt::string_view("unknown source character\0"));
	};

	usize consumed = 0;

	while (consumed < width) {
		@this.advance();
		@consumed = consumed + 1;
	};

	return true;
};

fn Lexer::scan(Lexer& this) -> bool {
	@this.offset = 0;
	@this.line = 1;
	@this.column = 1;
	@this.failure = rt::string_view();
	@this.failure_token = Token();
	@this.source->clear_tokens();

	while (true) {
		if (!@this.trivia()) {
			return false;
		};

		var token = this.location();
		char value = this.peek(0);

		if (!value) {
			if (this.offset < this.source->text().size()) {
				return @this.fail(token, rt::string_view("NUL byte in source\0"));
			};

			@token.kind = token_kind::eof;
		}
		else if (Lexer::identifier_start(value)) {
			while (Lexer::identifier_start(this.peek(0)) || Lexer::digit(this.peek(0))) {
				@this.advance();
			};

			@token.length = this.offset - token.begin;
			@token.kind = Lexer::identifier_kind(token.text());
		}
		else if (Lexer::digit(value)) {
			@token.kind = token_kind::literal_number;

			if (!@this.number(token)) {
				return false;
			};
		}
		else if (value == '"' || value == '\'') {
			@token.kind = token_kind::literal_string;

			if (value == '\'') {
				@token.kind = token_kind::literal_number;
			};

			if (!@this.quoted(token, value)) {
				return false;
			};
		}
		else {
			if (!@this.symbol(@token)) {
				return false;
			};
		};

		@token.length = this.offset - token.begin;

		if (!@this.source->append_token(Token(token))) {
			return @this.fail(token, rt::string_view("token storage allocation failed\0"));
		};

		if (token.kind == token_kind::eof) {
			break;
		};
	};

	return true;
};

enum syntax_kind : [i32] {
	absent;
	noop;
	unit;
	name;
	number;
	string;
	null_pointer;
	unary;
	grouping;
	binary;
	call;
	member;
	index;
	brace;
	array;
	conditional;
	while_loop;
	for_loop;
	return_value;
	break_loop;
	continue_loop;
	discard_value;
	allocation;
	deallocation;
	array_deallocation;
	switch_expression;
	case_label;
	sizeof_type;
	cast;
	variable;
	parameter;
	function;
	record;
	enumeration;
	enumerator;
	namespace_body;
	template_declaration;
	template_parameter;
	using_alias;
	list;
	attributes;
	ambiguity;
	type_name;
	type_pointer;
	type_reference;
	type_array;
	type_function;
	type_const;
	type_auto;
	access_label;
	qualified_name;
	conversion_name;
	operator_name;
	operator_array;
	template_apply;
};

// Syntax owns source structure. Resolved entities and types belong to semantic analysis.
// Slots are explicit: absent has no source expression; noop denotes the token ';'.
// Fixed shapes are constructed in grammar order and checked before publication:
// variable = [name, type, initializer], parameter = [name, type, default]
// function = [name, parameters, result, attributes, body]
// record = [name, bases, members], enumeration = [name, underlying, members]
// conditional = [condition, body, alternative], while/switch = [condition, body]
// for = [initializer, condition, step, body], call = [callable, arguments]
// namespace/template = [name-or-parameters, body-or-declaration]
// indirect type = [element], array type = [element, extent]
// function type = [parameters, result], const type = [element, condition]
// Lists, brace expressions, units, and attributes own a sequence of children.
// Ambiguity owns complete source interpretations, never borrowed alternatives.

struct Syntax {
	fn Syntax(Syntax& this, syntax_kind kind, const Token& token);
	fn Syntax(Syntax& this, const Syntax& other) : [delete];
	fn Syntax(Syntax& this, Syntax other) : [default];

	fn operator=(Syntax& this, const Syntax& other) -> Syntax& : [delete];
	fn operator=(Syntax& this, Syntax other) -> Syntax& : [default];
	fn append(Syntax& this, rt::unique<Syntax> child) -> bool;

	fn kind(const Syntax& this) -> syntax_kind;
	fn token(const Syntax& this) -> Token;
	fn size(const Syntax& this) -> usize;
	fn item(const Syntax& this, usize index) -> Syntax*;
	fn complete(const Syntax& this) -> bool;
	fn fixed_arity(const Syntax& this) -> usize;

private:
	syntax_kind category;
	Token location;
	rt::buffer<rt::unique<Syntax>> children;
};

fn Syntax::Syntax(Syntax& this, syntax_kind kind, const Token& token) {
	@this.category = $kind;
	@this.location := token;
};

fn Syntax::kind(const Syntax& this) -> syntax_kind {
	return syntax_kind(this.category);
};

fn Syntax::token(const Syntax& this) -> Token {
	return Token(this.location);
};

fn Syntax::size(const Syntax& this) -> usize {
	return this.children.size();
};

fn Syntax::item(const Syntax& this, usize index) -> Syntax* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn Syntax::append(Syntax& this, rt::unique<Syntax> child) -> bool {
	if (!child.get() || this.children.size() >= this.fixed_arity()) {
		return false;
	};

	return @this.children.push_back($child);
};

fn Syntax::operand(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::left(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::right(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::callable(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::arguments(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::member_object(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::member_name(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::index_object(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::index_value(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::condition(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::body(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::alternative(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::for_initializer(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::for_condition(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::for_step(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::for_body(const Syntax& this) -> Syntax* {
	return this.item(3);
};

fn Syntax::variable_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::variable_type(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::variable_initializer(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::parameter_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::parameter_type(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::parameter_default(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::function_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::function_parameters(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::function_result(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::function_attributes(const Syntax& this) -> Syntax* {
	return this.item(3);
};

fn Syntax::function_body(const Syntax& this) -> Syntax* {
	return this.item(4);
};

fn Syntax::record_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::record_bases(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::record_members(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::enum_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::enum_underlying(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::enum_members(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::namespace_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::namespace_members(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::template_parameters(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::template_declaration(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::alias_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::alias_type(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::cast_type(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::cast_operand(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::allocation_type(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::allocation_arguments(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::designated_type(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::array_extent(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::function_type_parameters(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::function_type_result(const Syntax& this) -> Syntax* {
	return this.item(1);
};

// TypeSyntax is a borrowed view of the owned syntax subtree for a type-id.

struct TypeSyntax {
	fn TypeSyntax(TypeSyntax& this, Syntax* syntax);

	fn kind(const TypeSyntax& this) -> syntax_kind;
	fn element(const TypeSyntax& this) -> Syntax*;
	fn extent(const TypeSyntax& this) -> Syntax*;
	fn parameters(const TypeSyntax& this) -> Syntax*;
	fn result(const TypeSyntax& this) -> Syntax*;

private:
	Syntax* syntax;
};

fn TypeSyntax::TypeSyntax(TypeSyntax& this, Syntax* syntax) {
	@this.syntax = $syntax;
};

fn TypeSyntax::kind(const TypeSyntax& this) -> syntax_kind {
	return this.syntax->kind();
};

fn TypeSyntax::element(const TypeSyntax& this) -> Syntax* {
	return this.syntax->designated_type();
};

fn TypeSyntax::extent(const TypeSyntax& this) -> Syntax* {
	return this.syntax->array_extent();
};

fn TypeSyntax::parameters(const TypeSyntax& this) -> Syntax* {
	return this.syntax->function_type_parameters();
};

fn TypeSyntax::result(const TypeSyntax& this) -> Syntax* {
	return this.syntax->function_type_result();
};

fn Syntax::qualifier_condition(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::same_tree(const Syntax& this, const Syntax& other) -> bool {
	if (this.kind() != other.kind() || this.token().source != other.token().source || this.token().begin != other.token().begin || this.token().length != other.token().length || this.size() != other.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.size()) {
		if (!this.item(index)->same_tree(*other.item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::take_item(Syntax& this, usize index) -> rt::unique<Syntax> {
	if (index >= this.children.size()) {
		return rt::unique<Syntax>();
	};

	return rt::unique<Syntax>(@((@this.children).data()[index]).release());
};

fn Syntax::fixed_arity(const Syntax& this) -> usize {
	switch (this.category) {
		case syntax_kind::absent:
		case syntax_kind::noop:
		case syntax_kind::name:
		case syntax_kind::number:
		case syntax_kind::string:
		case syntax_kind::null_pointer:
		case syntax_kind::break_loop:
		case syntax_kind::continue_loop:
		case syntax_kind::access_label:
		case syntax_kind::operator_array:
			return 0;
		case syntax_kind::unary:
		case syntax_kind::grouping:
		case syntax_kind::return_value:
		case syntax_kind::discard_value:
		case syntax_kind::deallocation:
		case syntax_kind::array_deallocation:
		case syntax_kind::sizeof_type:
		case syntax_kind::conversion_name:
		case syntax_kind::type_name:
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_auto:
		case syntax_kind::array:
			return 1;
		case syntax_kind::binary:
		case syntax_kind::call:
		case syntax_kind::member:
		case syntax_kind::index:
		case syntax_kind::while_loop:
		case syntax_kind::switch_expression:
		case syntax_kind::cast:
		case syntax_kind::allocation:
		case syntax_kind::namespace_body:
		case syntax_kind::template_declaration:
		case syntax_kind::using_alias:
		case syntax_kind::enumerator:
		case syntax_kind::type_array:
		case syntax_kind::type_function:
		case syntax_kind::type_const:
		case syntax_kind::qualified_name:
		case syntax_kind::template_apply:
		case syntax_kind::operator_name:
			return 2;
		case syntax_kind::conditional:
		case syntax_kind::variable:
		case syntax_kind::parameter:
		case syntax_kind::record:
		case syntax_kind::enumeration:
		case syntax_kind::template_parameter:
			return 3;
		case syntax_kind::for_loop:
			return 4;
		case syntax_kind::function:
			return 5;
		case syntax_kind::case_label:
			return 1;
		default:
			return usize::max;
	};
};

fn Syntax::complete(const Syntax& this) -> bool {
	usize arity = this.fixed_arity();

	if (arity != usize::max && this.children.size() != arity) {
		return false;
	};

	if (this.category == syntax_kind::ambiguity && this.children.size() < 2) {
		return false;
	};

	usize index = 0;

	while (index < this.children.size()) {
		if (!this.item(index) || !this.item(index)->complete()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::case_value(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_name(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_value(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_name(const Syntax& this) -> Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_type(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::template_parameter_default(const Syntax& this) -> Syntax* {
	return this.item(2);
};

fn Syntax::operator_target(const Syntax& this) -> Syntax* {
	return this.item(0);
};

fn Syntax::operator_token(const Syntax& this) -> Token {
	return this.item(0)->token();
};

fn Syntax::operator_suffix(const Syntax& this) -> Syntax* {
	return this.item(1);
};

enum name_role : [u08] {
	designator;
	value;
};

struct ParseChoices {
	rt::buffer<usize> operators;

	fn contains(const ParseChoices& this, usize position) -> bool;
	fn extended(const ParseChoices& this, usize position) -> rt::unique<ParseChoices>;
	fn same(const ParseChoices& this, const ParseChoices& other) -> bool;
};

struct Parser {
	fn Parser(Parser& this, const rt::buffer<Token>& tokens);

	fn parse(Parser& this) -> rt::unique<Syntax>;

	fn error(const Parser& this) -> rt::string_view;
	fn error_token(const Parser& this) -> Token;

private:
	const rt::buffer<Token>* tokens;
	usize offset;
	usize pending_greater;
	const ParseChoices* selections;
	rt::buffer<usize>* discoveries;
	const char* failure;
	Token failure_location;

	fn peek(const Parser& this) -> Token;
	fn take(Parser& this) -> Token;
	fn accept(Parser& this, const token_kind& kind) -> bool;
	fn require(Parser& this, const token_kind& kind, const char* message) -> bool;
	fn fail(Parser& this, const char* message);

	fn node(Parser& this, syntax_kind kind, const Token& token) -> rt::unique<Syntax>;
	fn absent(Parser& this) -> rt::unique<Syntax>;
	fn add(Parser& this, Syntax& parent, rt::unique<Syntax> child) -> bool;
	fn factor(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn factor_group(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn alternative_add(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> bool;

	fn expression(Parser& this, i32 minimum) -> rt::unique<Syntax>;
	fn primary(Parser& this) -> rt::unique<Syntax>;
	fn postfix(Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax>;
	fn sequence(Parser& this, const Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax>;
	fn arguments(Parser& this, token_kind close) -> rt::unique<Syntax>;

	fn type(Parser& this) -> rt::unique<Syntax>;
	fn close_template(Parser& this) -> bool;
	fn name_part(Parser& this, const name_role& role) -> rt::unique<Syntax>;
	fn name_in(Parser& this, const name_role& role) -> rt::unique<Syntax>;
	fn name(Parser& this) -> rt::unique<Syntax>;
	fn precedence(const token_kind& kind) -> i32;

	fn statement_one(Parser& this) -> rt::unique<Syntax>;
	fn statement(Parser& this) -> rt::unique<Syntax>;
	fn variable(Parser& this) -> rt::unique<Syntax>;
	fn parameters(Parser& this) -> rt::unique<Syntax>;
	fn function(Parser& this) -> rt::unique<Syntax>;
	fn record(Parser& this) -> rt::unique<Syntax>;
	fn enumeration(Parser& this) -> rt::unique<Syntax>;
	fn namespace_body(Parser& this) -> rt::unique<Syntax>;
	fn template_declaration(Parser& this) -> rt::unique<Syntax>;
	fn control(Parser& this) -> rt::unique<Syntax>;
};

fn Parser::Parser(Parser& this, const rt::buffer<Token>& tokens) {
	@this.tokens = &tokens;
};

fn Parser::error(const Parser& this) -> rt::string_view {
	if (!this.failure) {
		return rt::string_view();
	};

	return rt::string_view(this.failure);
};

fn Parser::error_token(const Parser& this) -> Token {
	return Token(this.failure_location);
};

fn Parser::peek(const Parser& this) -> Token {
	if (this.pending_greater) {
		Token remainder := this.tokens->data()[this.offset - 1];
		@remainder.kind = token_kind::op_greater;
		@remainder.begin = remainder.begin + 1;
		@remainder.length = 1;

		return $remainder;
	};

	if (this.offset < this.tokens->size()) {
		return Token(this.tokens->data()[this.offset]);
	};

	Token token;
	@token.kind = token_kind::eof;

	return $token;
};

fn Parser::take(Parser& this) -> Token {
	Token token = this.peek();

	if (this.pending_greater) {
		@this.pending_greater = this.pending_greater - 1;

		return $token;
	};

	if (token.kind != token_kind::eof) {
		@this.offset = this.offset + 1;
	};

	return $token;
};

fn Parser::accept(Parser& this, const token_kind& kind) -> bool {
	if (this.peek().kind != kind) {
		return false;
	};

	@this.take();

	return true;
};

fn Parser::require(Parser& this, const token_kind& kind, const char* message) -> bool {
	if (@this.accept(kind)) {
		return true;
	};

	@this.fail($message);
	return false;
};

fn Parser::fail(Parser& this, const char* message) {
	if (!this.failure) {
		@this.failure = $message;
		@this.failure_location = this.peek();
	};
};

fn Parser::node(Parser& this, syntax_kind kind, const Token& token) -> rt::unique<Syntax> {
	var result = rt::unique<Syntax>(new Syntax($kind, token));

	if (!result.get()) {
		@this.fail("syntax allocation failed\0");
	};

	return $result;
};

fn Parser::absent(Parser& this) -> rt::unique<Syntax> {
	return @this.node(syntax_kind::absent, this.peek());
};

fn Parser::add(Parser& this, Syntax& parent, rt::unique<Syntax> child) -> bool {
	if (!child.get()) {
		return false;
	};

	if (!@parent.append($child)) {
		@this.fail("syntax allocation failed\0");
		return false;
	};

	return true;
};

fn Parser::precedence(const token_kind& kind) -> i32 {
	switch (kind) {
		case token_kind::op_assign:
		case token_kind::op_copy:
			return 1;
		case token_kind::op_or:
			return 2;
		case token_kind::op_and:
			return 3;
		case token_kind::op_pipe:
			return 4;
		case token_kind::op_caret:
			return 5;
		case token_kind::op_ampersand:
			return 6;
		case token_kind::op_equal:
		case token_kind::op_not_equal:
			return 7;
		case token_kind::op_less:
		case token_kind::op_greater:
		case token_kind::op_less_equal:
		case token_kind::op_greater_equal:
			return 8;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			return 9;
		case token_kind::op_plus:
		case token_kind::op_minus:
			return 10;
		case token_kind::op_star:
		case token_kind::op_slash:
		case token_kind::op_remainder:
			return 11;
		default:
			return 0;
	};
};

fn Parser::parse(Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::unit, this.peek());

	while (this.peek().kind != token_kind::eof && !this.failure) {
		usize before = this.offset;

		if (!@this.add(@*result.get(), @this.statement())) {
			break;
		};

		if (this.offset == before) {
			@this.fail("parser did not consume a declaration\0");
		};
	};

	if (!this.failure && !result.get()->complete()) {
		@this.fail("incomplete syntax structure\0");
	};

	if (this.failure) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::sequence(Parser& this, const Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax> {
	var result = @this.node($kind, opening);

	while (this.peek().kind != close && this.peek().kind != token_kind::eof && !this.failure) {
		if (!@this.add(@*result.get(), @this.statement())) {
			return rt::unique<Syntax>();
		};
	};

	if (!@this.require($close, "expected closing delimiter\0")) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::arguments(Parser& this, token_kind close) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(close)) {
		return $result;
	};

	while (!this.failure) {
		if (!@this.add(@*result.get(), @this.expression(1))) {
			return rt::unique<Syntax>();
		};

		if (@this.accept(close)) {
			return $result;
		};

		if (!@this.require(token_kind::punct_comma, "expected ',' between arguments\0")) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::close_template(Parser& this) -> bool {
	if (@this.accept(token_kind::op_greater)) {
		return true;
	};

	if (@this.accept(token_kind::op_shift_right)) {
		@this.pending_greater = 1;

		return true;
	};

	@this.fail("expected '>' after template arguments\0");
	return false;
};

fn Parser::name_part(Parser& this, const name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();

	if (@this.accept(token_kind::op_tilde)) {
		var destructor = @this.node(syntax_kind::unary, first);
		Token identifier = this.peek();
		@this.require(token_kind::identifier, "expected destructor type name\0");
		@this.add(@*destructor.get(), @this.node(syntax_kind::name, $identifier));

		return $destructor;
	};

	if (!@this.require(token_kind::identifier, "expected identifier\0")) {
		return rt::unique<Syntax>();
	};

	var conversion_type = @this.absent();
	var operator_symbol = @this.absent();
	var operator_suffix = @this.absent();

	if (first.is(rt::string_view("operator\0"))) {
		usize beginning = this.offset;
		Token operation = @this.take();
		@operator_symbol = @this.node(syntax_kind::name, operation);

		if (operation.kind == token_kind::punct_left_paren) {
			@this.require(token_kind::punct_right_paren, "expected ')' in operator name\0");
		}
		else if (operation.kind == token_kind::punct_left_bracket) {
			@this.require(token_kind::punct_right_bracket, "expected ']' in operator name\0");
		}
		else if ((operation.kind == token_kind::kw_new || operation.kind == token_kind::kw_delete) && @this.accept(token_kind::punct_left_bracket)) {
			@operator_suffix = @this.node(syntax_kind::operator_array, this.peek());
			@this.require(token_kind::punct_right_bracket, "expected ']' in allocation operator name\0");
		};

		if (operation.kind == token_kind::literal_string) {
			@operator_suffix = @this.node(syntax_kind::name, this.peek());
			@this.require(token_kind::identifier, "expected literal operator suffix\0");
		}
		else if (operation.kind == token_kind::identifier) {
			var conversion = Parser(*this.tokens);
			@conversion.offset = beginning;
			var target = @conversion.type();

			if (target.get() && !conversion.failure) {
				@conversion_type = $target;
				@this.offset = conversion.offset;
				@this.pending_greater = conversion.pending_greater;

			};
		};

		Token end := this.tokens->data()[this.offset - 1];
		@first.length = end.begin + end.length - first.begin;
	};

	syntax_kind category = syntax_kind::name;

	if (operator_symbol.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::operator_name;
	};

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::conversion_name;
	};

	var result = @this.node($category, first);

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		@this.add(@*result.get(), rt::unique<Syntax>(@conversion_type.release()));
	}
	else if (operator_symbol.get()->kind() != syntax_kind::absent) {
		@this.add(@*result.get(), rt::unique<Syntax>(@operator_symbol.release()));
		@this.add(@*result.get(), rt::unique<Syntax>(@operator_suffix.release()));
	};

	if (this.peek().kind != token_kind::op_less) {
		return $result;
	};

	var candidate = Parser(*this.tokens);
	@candidate.offset = this.offset;
	@candidate.pending_greater = this.pending_greater;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
	@candidate.take();
	var arguments = @candidate.node(syntax_kind::list, candidate.peek());

	while (!candidate.failure && candidate.peek().kind != token_kind::op_greater && candidate.peek().kind != token_kind::op_shift_right) {
		var type_parser = Parser(*candidate.tokens);
		@type_parser.offset = candidate.offset;
		@type_parser.pending_greater = candidate.pending_greater;
	@type_parser.selections = candidate.selections;
	@type_parser.discoveries = candidate.discoveries;
		var type = @type_parser.type();
		var value_parser = Parser(*candidate.tokens);
		@value_parser.offset = candidate.offset;
		@value_parser.pending_greater = candidate.pending_greater;
	@value_parser.selections = candidate.selections;
	@value_parser.discoveries = candidate.discoveries;
		var value = @value_parser.expression(10);

		if (type.get() && !type_parser.failure && (type_parser.peek().kind == token_kind::punct_comma || type_parser.peek().kind == token_kind::op_greater || type_parser.peek().kind == token_kind::op_shift_right)) {
			@candidate.offset = type_parser.offset;
			@candidate.pending_greater = type_parser.pending_greater;
	@candidate.selections = type_parser.selections;
	@candidate.discoveries = type_parser.discoveries;

			if (value.get() && !value_parser.failure && value_parser.offset == type_parser.offset && value_parser.pending_greater == type_parser.pending_greater) {
				var alternatives = @candidate.node(syntax_kind::ambiguity, type.get()->token());
				@candidate.add(@*alternatives.get(), rt::unique<Syntax>(@type.release()));
				@candidate.add(@*alternatives.get(), rt::unique<Syntax>(@value.release()));
				@candidate.add(@*arguments.get(), rt::unique<Syntax>(@alternatives.release()));
			}
			else {
				@candidate.add(@*arguments.get(), rt::unique<Syntax>(@type.release()));
			};
		}
		else if (value.get() && !value_parser.failure) {
			@candidate.offset = value_parser.offset;
			@candidate.pending_greater = value_parser.pending_greater;
	@candidate.selections = value_parser.selections;
	@candidate.discoveries = value_parser.discoveries;
			@candidate.add(@*arguments.get(), rt::unique<Syntax>(@value.release()));
		}
		else {
			@candidate.fail("expected template argument\0");
			break;
		};

		if (!@candidate.accept(token_kind::punct_comma)) {
			break;
		};
	};

	if (!@candidate.close_template() || candidate.failure) {
		return $result;
	};

	if (role == name_role::value) {
		if (this.selections && this.selections->contains(usize(this.offset))) {
			return $result;
		};

		if (this.discoveries && !@this.discoveries->push_back(usize(this.offset))) {
			@this.fail("parse alternatives storage is unavailable\0");
			return rt::unique<Syntax>();
		};
	};

	var applied = @this.node(syntax_kind::template_apply, first);
	@this.add(@*applied.get(), rt::unique<Syntax>(@result.release()));
	@this.add(@*applied.get(), rt::unique<Syntax>(@arguments.release()));
	@this.offset = candidate.offset;
	@this.pending_greater = candidate.pending_greater;

	return $applied;
};

fn Parser::name(Parser& this) -> rt::unique<Syntax> {
	return @this.name_in(name_role::designator);
};

fn Parser::name_in(Parser& this, const name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();
	var result = @this.name_part(role);

	while (@this.accept(token_kind::op_scope)) {
		var path = @this.node(syntax_kind::qualified_name, first);
		@this.add(@*path.get(), rt::unique<Syntax>(@result.release()));
		@this.add(@*path.get(), @this.name_part(role));
		@result = rt::unique<Syntax>(@path.release());
	};

	return $result;
};

fn Parser::type(Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	bool automatic = start.kind == token_kind::identifier && start.is(rt::string_view("auto\0"));

	if (automatic) {
		@this.take();
	};

	bool qualified = @this.accept(token_kind::kw_const);
	var condition = @this.absent();

	if (qualified && @this.accept(token_kind::punct_left_bracket)) {
		@condition = @this.expression(1);
		@this.require(token_kind::punct_right_bracket, "expected ']' after qualifier condition\0");
	};

	var result = @this.absent();

	if (@this.accept(token_kind::punct_left_paren)) {
		var candidate = Parser(*this.tokens);
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
		var parameters = @candidate.parameters();

		if (parameters.get() && !candidate.failure && @candidate.accept(token_kind::op_arrow)) {
			@result = @this.node(syntax_kind::type_function, start);
			@this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
			@this.add(@*result.get(), @candidate.type());
			@this.offset = candidate.offset;
			@this.pending_greater = candidate.pending_greater;

			if (candidate.failure) {
				@this.fail(candidate.failure);
			};
		}
		else {
			@result = @this.type();
			@this.require(token_kind::punct_right_paren, "expected ')' after grouped type\0");
		};
	}
	else if (this.peek().kind == token_kind::kw_struct || this.peek().kind == token_kind::kw_class || this.peek().kind == token_kind::kw_union) {
		@result = @this.record();
	}
	else {
		@result = @this.node(syntax_kind::type_name, start);

		if (!@this.add(@*result.get(), @this.name())) {
			return rt::unique<Syntax>();
		};
	};

	if (qualified) {
		var constant = @this.node(syntax_kind::type_const, start);
		@this.add(@*constant.get(), rt::unique<Syntax>(@result.release()));
		@this.add(@*constant.get(), rt::unique<Syntax>(@condition.release()));
		@result = $constant;
	};

	if (automatic) {
		var inferred = @this.node(syntax_kind::type_auto, start);
		@this.add(@*inferred.get(), rt::unique<Syntax>(@result.release()));
		@result = $inferred;
	};

	while (!this.failure) {
		Token suffix = this.peek();
		syntax_kind kind = syntax_kind::absent;

		if (@this.accept(token_kind::op_star)) {
			@kind = syntax_kind::type_pointer;
		}
		else if (@this.accept(token_kind::op_ampersand)) {
			@kind = syntax_kind::type_reference;
		}
		else if (@this.accept(token_kind::punct_left_bracket)) {
			var array = @this.node(syntax_kind::type_array, suffix);
			@this.add(@*array.get(), rt::unique<Syntax>(@result.release()));
			@this.add(@*array.get(), @this.expression(1));
			@this.require(token_kind::punct_right_bracket, "expected ']' after array extent\0");
			@result = rt::unique<Syntax>(@array.release());
			continue;
		}
		else {
			break;
		};

		var indirect = @this.node($kind, $suffix);
		@this.add(@*indirect.get(), rt::unique<Syntax>(@result.release()));
		@result = rt::unique<Syntax>(@indirect.release());
	};

	return $result;
};

fn Parser::expression(Parser& this, i32 minimum) -> rt::unique<Syntax> {
	var left = @this.primary();

	if (!left.get()) {
		return $left;
	};

	@left = @this.postfix(rt::unique<Syntax>(@left.release()));

	while (!this.failure) {
		Token operation = this.peek();
		i32 precedence = Parser::precedence(operation.kind);

		if (!precedence || precedence < minimum) {
			break;
		};

		@this.take();
		i32 next = precedence + 1;

		if (precedence == 1) {
			@next = precedence;
		};

		var binary = @this.node(syntax_kind::binary, operation);
		@this.add(@*binary.get(), rt::unique<Syntax>(@left.release()));

		if (!@this.add(@*binary.get(), @this.expression($next))) {
			return rt::unique<Syntax>();
		};

		@left = $binary;
	};

	return $left;
};

fn Parser::postfix(Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax> {
	while (!this.failure) {
		Token token = this.peek();

		if (@this.accept(token_kind::punct_left_paren)) {
			var call = @this.node(syntax_kind::call, token);
			@this.add(@*call.get(), rt::unique<Syntax>(@value.release()));
			@this.add(@*call.get(), @this.arguments(token_kind::punct_right_paren));
			@value = rt::unique<Syntax>(@call.release());
			continue;
		};

		if (@this.accept(token_kind::punct_left_bracket)) {
			var index = @this.node(syntax_kind::index, token);
			@this.add(@*index.get(), rt::unique<Syntax>(@value.release()));
			@this.add(@*index.get(), @this.expression(1));
			@this.require(token_kind::punct_right_bracket, "expected ']' after index\0");
			@value = rt::unique<Syntax>(@index.release());
			continue;
		};

		if (token.kind == token_kind::op_dot || token.kind == token_kind::op_arrow) {
			@this.take();
			var member = @this.node(syntax_kind::member, token);
			@this.add(@*member.get(), rt::unique<Syntax>(@value.release()));
			Token tilde = this.peek();

			if (@this.accept(token_kind::op_tilde)) {
				var destructor = @this.node(syntax_kind::unary, tilde);
				@this.add(@*destructor.get(), @this.type());
				@this.add(@*member.get(), rt::unique<Syntax>(@destructor.release()));
			}
			else {
				@this.add(@*member.get(), @this.name());
			};

			@value = rt::unique<Syntax>(@member.release());
			continue;
		};

		break;
	};

	return $value;
};

fn Parser::primary(Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (token.kind == token_kind::identifier || token.kind == token_kind::kw_const || token.kind == token_kind::kw_struct || token.kind == token_kind::kw_class || token.kind == token_kind::kw_union) {
		// Type suffixes and value operators share tokens. Enumerate both complete
		// continuations instead of deciding whether an identifier denotes a type here.
		usize choice = this.tokens->size() + this.offset;

		if (!this.selections || !this.selections->contains(choice)) {
			var candidate = Parser(*this.tokens);
			@candidate.offset = this.offset;
			@candidate.pending_greater = this.pending_greater;
			@candidate.selections = this.selections;
			@candidate.discoveries = this.discoveries;
			var type = @candidate.type();

			if (type.get() && !candidate.failure && type.get()->kind() != syntax_kind::type_name && candidate.peek().kind == token_kind::punct_left_paren) {
				if (this.discoveries && !@this.discoveries->push_back(choice)) {
					@this.fail("parse alternatives storage is unavailable\0");
					return rt::unique<Syntax>();
				};

				@this.offset = candidate.offset;
				@this.pending_greater = candidate.pending_greater;

				return $type;
			};
		};
	};

	switch (token.kind) {
		case token_kind::identifier:
			if (token.is(rt::string_view("static_cast\0")) || token.is(rt::string_view("reinterpret_cast\0")) || token.is(rt::string_view("const_cast\0")) || token.is(rt::string_view("dynamic_cast\0"))) {
				@this.take();
				var cast = @this.node(syntax_kind::cast, token);
				@this.require(token_kind::op_less, "expected '<' in named cast\0");
				@this.add(@*cast.get(), @this.type());
				@this.close_template();
				@this.require(token_kind::punct_left_paren, "expected '(' in named cast\0");
				@this.add(@*cast.get(), @this.expression(1));
				@this.require(token_kind::punct_right_paren, "expected ')' in named cast\0");

				return $cast;
			};

			return @this.name_in(name_role::value);
		case token_kind::literal_number:
			@this.take();

			return @this.node(syntax_kind::number, $token);
		case token_kind::literal_string:
			@this.take();

			return @this.node(syntax_kind::string, $token);
		case token_kind::kw_nullptr:
			@this.take();

			return @this.node(syntax_kind::null_pointer, $token);
		case token_kind::punct_semicolon:
			@this.take();

			return @this.node(syntax_kind::noop, $token);
		case token_kind::punct_left_brace:
			@this.take();

			return @this.sequence($token, token_kind::punct_right_brace, syntax_kind::brace);
		case token_kind::punct_left_bracket:
			@this.take();
			var array = @this.node(syntax_kind::array, $token);
			@this.add(@*array.get(), @this.arguments(token_kind::punct_right_bracket));

			return $array;
		case token_kind::punct_left_paren: {
			@this.take();
			var grouped = @this.node(syntax_kind::grouping, token);
			@this.add(@*grouped.get(), @this.expression(1));
			@this.require(token_kind::punct_right_paren, "expected ')' after expression\0");

			return $grouped;
		};

		case token_kind::kw_struct:
		case token_kind::kw_class:
		case token_kind::kw_union:
			return @this.record();
		case token_kind::kw_if:
		case token_kind::kw_while:
		case token_kind::kw_for:
		case token_kind::kw_switch:
			return @this.control();
		case token_kind::kw_break:
		case token_kind::kw_continue:
			@this.take();

			if (token.kind == token_kind::kw_break) {
				return @this.node(syntax_kind::break_loop, $token);
			};

			return @this.node(syntax_kind::continue_loop, $token);
		case token_kind::kw_return: {
			@this.take();
			var result = @this.node(syntax_kind::return_value, $token);

			if (this.peek().kind == token_kind::punct_semicolon) {
				@this.add(@*result.get(), @this.absent());
			}
			else {
				@this.add(@*result.get(), @this.expression(1));
			};

			return $result;
		};

		case token_kind::op_plus:
		case token_kind::op_minus:
		case token_kind::op_star:
		case token_kind::op_ampersand:
		case token_kind::op_bang:
		case token_kind::op_tilde:
		case token_kind::op_access:
		case token_kind::op_relocate: {
			@this.take();
			var unary = @this.node(syntax_kind::unary, $token);
			@this.add(@*unary.get(), @this.expression(12));

			return $unary;
		};

		case token_kind::kw_sizeof: {
			@this.take();
			var type_parser = Parser(*this.tokens);
			@type_parser.offset = this.offset;
			@type_parser.pending_greater = this.pending_greater;
	@type_parser.selections = this.selections;
	@type_parser.discoveries = this.discoveries;
			var type = @type_parser.absent();

			if (@type_parser.accept(token_kind::punct_left_paren)) {
				@type = @type_parser.type();
				@type_parser.require(token_kind::punct_right_paren, "expected ')' after sizeof type\0");
			}
			else {
				@type_parser.fail("expected sizeof type\0");
			};

			var value = @this.expression(12);

			if (type.get() && !type_parser.failure) {
				var measured_type = @this.node(syntax_kind::sizeof_type, token);
				@this.add(@*measured_type.get(), rt::unique<Syntax>(@type.release()));

				if (value.get() && !this.failure && this.offset == type_parser.offset && this.pending_greater == type_parser.pending_greater) {
					var measured_value = @this.node(syntax_kind::unary, token);
					@this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));
					var alternatives = @this.node(syntax_kind::ambiguity, token);
					@this.add(@*alternatives.get(), $measured_type);
					@this.add(@*alternatives.get(), $measured_value);

					return $alternatives;
				};

				@this.offset = type_parser.offset;
				@this.pending_greater = type_parser.pending_greater;

				@this.failure = nullptr;

				return $measured_type;
			};

			var measured_value = @this.node(syntax_kind::unary, token);
			@this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));

			return $measured_value;
		};

		case token_kind::kw_discard: {
			@this.take();
			var discard_expression = @this.node(syntax_kind::discard_value, token);
			@this.add(@*discard_expression.get(), @this.expression(12));

			return $discard_expression;
		};

		case token_kind::kw_delete: {
			@this.take();
			syntax_kind kind = syntax_kind::deallocation;

			if (@this.accept(token_kind::punct_left_bracket)) {
				@this.require(token_kind::punct_right_bracket, "expected ']' in delete[]\0");
				@kind = syntax_kind::array_deallocation;
			};

			var deletion = @this.node($kind, token);
			@this.add(@*deletion.get(), @this.expression(12));

			return $deletion;
		};

		case token_kind::kw_new: {
			@this.take();
			var allocation = @this.node(syntax_kind::allocation, $token);
			@this.add(@*allocation.get(), @this.type());

			if (@this.accept(token_kind::punct_left_paren)) {
				@this.add(@*allocation.get(), @this.arguments(token_kind::punct_right_paren));
			}
			else {
				@this.add(@*allocation.get(), @this.node(syntax_kind::list, this.peek()));
			};

			return $allocation;
		};

		default:
			@this.fail("expected expression\0");
			return rt::unique<Syntax>();
	};
};

fn Parser::variable(Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	var declared_type = @this.absent();
	var declared_name = @this.absent();

	if (start.kind == token_kind::kw_var) {
		@this.take();
		@declared_name = @this.name();

		if (@this.accept(token_kind::punct_colon)) {
			@declared_type = @this.type();
		};
	}
	else {
		@declared_type = @this.type();
		@declared_name = @this.name();
	};

	var initializer = @this.absent();

	if (this.peek().kind == token_kind::op_assign || this.peek().kind == token_kind::op_copy) {
		Token operation = @this.take();
		var initialized = @this.node(syntax_kind::unary, operation);
		@this.add(@*initialized.get(), @this.expression(1));
		@initializer = rt::unique<Syntax>(@initialized.release());
	}
	else if (this.peek().kind == token_kind::punct_left_brace) {
		@initializer = @this.primary();
	};

	if (!@this.require(token_kind::punct_semicolon, "expected ';' after variable declaration\0")) {
		return rt::unique<Syntax>();
	};

	var result = @this.node(syntax_kind::variable, start);
	@this.add(@*result.get(), rt::unique<Syntax>(@declared_name.release()));
	@this.add(@*result.get(), rt::unique<Syntax>(@declared_type.release()));
	@this.add(@*result.get(), rt::unique<Syntax>(@initializer.release()));

	return $result;
};

fn Parser::parameters(Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_right_paren)) {
		return $result;
	};

	while (!this.failure) {
		Token location = this.peek();

		if (@this.accept(token_kind::punct_ellipsis)) {
			var variadic = @this.node(syntax_kind::parameter, location);
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*result.get(), $variadic);
			@this.require(token_kind::punct_right_paren, "expected ')' after variadic parameter\0");

			return $result;
		};

		var parameter_type = @this.type();
		var parameter_name = @this.absent();

		if (this.peek().kind == token_kind::identifier) {
			@parameter_name = @this.name();
		};

		var default_value = @this.absent();

		if (@this.accept(token_kind::op_assign)) {
			@default_value = @this.expression(1);
		};

		var parameter = @this.node(syntax_kind::parameter, location);
		@this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_name.release()));
		@this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_type.release()));
		@this.add(@*parameter.get(), rt::unique<Syntax>(@default_value.release()));
		@this.add(@*result.get(), rt::unique<Syntax>(@parameter.release()));

		if (@this.accept(token_kind::punct_right_paren)) {
			return $result;
		};

		if (!@this.require(token_kind::punct_comma, "expected ',' between parameters\0")) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::function(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::function, start);
	@this.add(@*result.get(), @this.name());

	if (!@this.require(token_kind::punct_left_paren, "expected function parameter list\0")) {
		return rt::unique<Syntax>();
	};

	@this.add(@*result.get(), @this.parameters());
	var result_type = @this.absent();

	if (@this.accept(token_kind::op_arrow)) {
		@result_type = @this.type();
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@result_type.release()));
	var attributes = @this.node(syntax_kind::attributes, this.peek());

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, "expected attribute list\0");

		while (this.peek().kind != token_kind::punct_right_bracket && this.peek().kind != token_kind::eof && !this.failure) {
			@this.add(@*attributes.get(), @this.node(syntax_kind::name, @this.take()));

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		@this.require(token_kind::punct_right_bracket, "expected ']' after attributes\0");
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@attributes.release()));
	@this.add(@*result.get(), @this.expression(1));

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		@this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::record(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::record, start);

	if (this.peek().kind == token_kind::identifier) {
		@this.add(@*result.get(), @this.name());
	}
	else {
		@this.add(@*result.get(), @this.absent());
	};

	var bases = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, "expected '[' before record bases\0");

		while (!this.failure) {
			@this.add(@*bases.get(), @this.type());

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		@this.require(token_kind::punct_right_bracket, "expected ']' after record bases\0");
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@bases.release()));
	@this.add(@*result.get(), @this.expression(1));

	return $result;
};

fn Parser::enumeration(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::enumeration, start);
	@this.add(@*result.get(), @this.name());
	var underlying = @this.absent();

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, "expected enum underlying type\0");
		@underlying = @this.type();
		@this.require(token_kind::punct_right_bracket, "expected ']' after enum underlying type\0");
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@underlying.release()));
	var members = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_semicolon)) {
		@members = @this.node(syntax_kind::noop, start);
	}
	else {
		@this.require(token_kind::punct_left_brace, "expected enum body\0");

		while (!this.failure && this.peek().kind != token_kind::punct_right_brace) {
			if (this.peek().kind == token_kind::kw_fn) {
				@this.add(@*members.get(), @this.function());
				continue;
			};

			Token member = this.peek();
			var entry = @this.node(syntax_kind::enumerator, member);
			@this.add(@*entry.get(), @this.name());

			if (@this.accept(token_kind::op_assign)) {
				@this.add(@*entry.get(), @this.expression(1));
			}
			else {
				@this.add(@*entry.get(), @this.absent());
			};

			@this.add(@*members.get(), rt::unique<Syntax>(@entry.release()));
			@this.require(token_kind::punct_semicolon, "expected ';' after enumerator\0");
		};

		@this.require(token_kind::punct_right_brace, "expected '}' after enum body\0");
		@this.accept(token_kind::punct_semicolon);
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@members.release()));

	return $result;
};

fn Parser::namespace_body(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::namespace_body, start);
	@this.add(@*result.get(), @this.name());
	@this.add(@*result.get(), @this.expression(1));

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		@this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::template_declaration(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::template_declaration, start);
	var parameters = @this.node(syntax_kind::list, this.peek());
	@this.require(token_kind::op_less, "expected '<' after template\0");

	while (!this.failure) {
		Token location = this.peek();
		var parameter = @this.node(syntax_kind::template_parameter, location);

		if (@this.accept(token_kind::kw_typename)) {
			@this.add(@*parameter.get(), @this.absent());
		}
		else {
			@this.add(@*parameter.get(), @this.type());
		};

		@this.add(@*parameter.get(), @this.name());

		if (@this.accept(token_kind::op_assign)) {
			if (location.kind == token_kind::kw_typename) {
				@this.add(@*parameter.get(), @this.type());
			}
			else {
				@this.add(@*parameter.get(), @this.expression(10));
			};
		}
		else {
			@this.add(@*parameter.get(), @this.absent());
		};

		@this.add(@*parameters.get(), rt::unique<Syntax>(@parameter.release()));

		if (!@this.accept(token_kind::punct_comma)) {
			break;
		};
	};

	@this.close_template();
	@this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
	@this.add(@*result.get(), @this.statement());

	return $result;
};

fn Parser::control(Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	@this.require(token_kind::punct_left_paren, "expected '(' before control condition\0");

	if (start.kind == token_kind::kw_for) {
		var loop = @this.node(syntax_kind::for_loop, start);
		@this.add(@*loop.get(), @this.statement());

		if (this.peek().kind == token_kind::punct_semicolon) {
			@this.add(@*loop.get(), @this.absent());
		}
		else {
			@this.add(@*loop.get(), @this.expression(1));
		};

		@this.require(token_kind::punct_semicolon, "expected ';' after for condition\0");

		if (this.peek().kind == token_kind::punct_right_paren) {
			@this.add(@*loop.get(), @this.absent());
		}
		else {
			@this.add(@*loop.get(), @this.expression(1));
		};

		@this.require(token_kind::punct_right_paren, "expected ')' after for control\0");
		@this.add(@*loop.get(), @this.statement());

		return $loop;
	};

	syntax_kind kind = syntax_kind::conditional;

	if (start.kind == token_kind::kw_while) {
		@kind = syntax_kind::while_loop;
	}
	else if (start.kind == token_kind::kw_switch) {
		@kind = syntax_kind::switch_expression;
	};

	var result = @this.node($kind, start);
	@this.add(@*result.get(), @this.expression(1));
	@this.require(token_kind::punct_right_paren, "expected ')' after condition\0");
	@this.add(@*result.get(), @this.statement());

	if (start.kind == token_kind::kw_if) {
		if (@this.accept(token_kind::kw_else)) {
			@this.add(@*result.get(), @this.statement());
		}
		else {
			@this.add(@*result.get(), @this.absent());
		};
	};

	return $result;
};

fn Parser::statement_one(Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (token.kind == token_kind::identifier && (token.is(rt::string_view("public\0")) || token.is(rt::string_view("private\0")) || token.is(rt::string_view("protected\0")))) {
		@this.take();
		@this.require(token_kind::punct_colon, "expected ':' after access label\0");

		return @this.node(syntax_kind::access_label, token);
	};

	switch (token.kind) {
		case token_kind::kw_case:
		case token_kind::kw_default: {
			@this.take();
			var label = @this.node(syntax_kind::case_label, token);

			if (token.kind == token_kind::kw_case) {
				@this.add(@*label.get(), @this.expression(1));
			}
			else {
				@this.add(@*label.get(), @this.absent());
			};

			@this.require(token_kind::punct_colon, "expected ':' after switch label\0");

			return $label;
		};

		case token_kind::kw_var:
			return @this.variable();
		case token_kind::kw_fn:
			return @this.function();
		case token_kind::kw_enum:
			return @this.enumeration();
		case token_kind::kw_namespace:
			return @this.namespace_body();
		case token_kind::kw_template:
			return @this.template_declaration();
		case token_kind::kw_using: {
			@this.take();
			var alias = @this.node(syntax_kind::using_alias, token);
			@this.add(@*alias.get(), @this.name());
			@this.require(token_kind::op_assign, "expected '=' in type alias\0");
			@this.add(@*alias.get(), @this.type());
			@this.require(token_kind::punct_semicolon, "expected ';' after alias\0");

			return $alias;
		};

		default:
			break;
	};

	// Parsing does not classify identifiers by their spelling. A declaration and
	// expression that consume the same tokens remain alternatives for name binding.
	var declaration_parser = Parser(*this.tokens);
	@declaration_parser.offset = this.offset;
	@declaration_parser.pending_greater = this.pending_greater;
	@declaration_parser.selections = this.selections;
	@declaration_parser.discoveries = this.discoveries;
	var declaration = @declaration_parser.variable();
	var expression_parser = Parser(*this.tokens);
	@expression_parser.offset = this.offset;
	@expression_parser.pending_greater = this.pending_greater;
	@expression_parser.selections = this.selections;
	@expression_parser.discoveries = this.discoveries;
	var expression = @expression_parser.expression(1);

	if (expression.get() && !expression_parser.failure) {
		syntax_kind kind = expression.get()->kind();

		if (kind != syntax_kind::noop && kind != syntax_kind::brace && kind != syntax_kind::conditional && kind != syntax_kind::while_loop && kind != syntax_kind::for_loop && kind != syntax_kind::switch_expression && kind != syntax_kind::record) {
			@expression_parser.require(token_kind::punct_semicolon, "expected ';' after expression\0");
		}
		else if (kind != syntax_kind::noop && (kind != syntax_kind::record || expression.get()->record_members()->kind() != syntax_kind::noop)) {
			@expression_parser.accept(token_kind::punct_semicolon);
		};
	};

	if (declaration.get() && !declaration_parser.failure) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;

		if (expression.get() && !expression_parser.failure && expression_parser.offset == declaration_parser.offset) {
			var alternatives = @this.node(syntax_kind::ambiguity, token);
			@this.add(@*alternatives.get(), rt::unique<Syntax>(@declaration.release()));
			@this.add(@*alternatives.get(), rt::unique<Syntax>(@expression.release()));

			return $alternatives;
		};

		return $declaration;
	};

	if (declaration_parser.failure && expression_parser.failure && declaration_parser.offset > expression_parser.offset) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;

		@this.failure = declaration_parser.failure;
		@this.failure_location := declaration_parser.failure_location;

		return rt::unique<Syntax>();
	};

	@this.offset = expression_parser.offset;
	@this.pending_greater = expression_parser.pending_greater;

	if (expression_parser.failure) {
		@this.failure = expression_parser.failure;
		@this.failure_location := expression_parser.failure_location;

		return rt::unique<Syntax>();
	};

	return $expression;
};

fn Parser::statement(Parser& this) -> rt::unique<Syntax> {
	rt::buffer<rt::unique<ParseChoices>> work;
	rt::buffer<rt::unique<Syntax>> alternatives;

	if (!@work.push_back(rt::unique<ParseChoices>(new ParseChoices()))) {
		@this.fail("parse alternatives storage is unavailable\0");
		return rt::unique<Syntax>();
	};

	usize next = 0;
	usize end = this.offset;
	usize pending = this.pending_greater;
	usize failed_at = this.offset;
	Token failed_token = this.peek();
	const char* failure = "expected declaration or expression\0";

	while (next < work.size()) {
		ParseChoices* choices = work.data()[next].get();
		var candidate = Parser(*this.tokens);
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.selections = choices;
		rt::buffer<usize> discoveries;
		@candidate.discoveries = &discoveries;
		var syntax = @candidate.statement_one();

		if (syntax.get() && !candidate.failure) {
			if (alternatives.size() && (candidate.offset != end || candidate.pending_greater != pending)) {
				@this.fail("source interpretations have different statement boundaries\0");
				return rt::unique<Syntax>();
			};

			@end = candidate.offset;
			@pending = candidate.pending_greater;

			if (!@this.alternative_add(@alternatives, rt::unique<Syntax>(@syntax.release()))) {
				return rt::unique<Syntax>();
			};
		}
		else if (candidate.failure && candidate.offset >= failed_at) {
			@failed_at = candidate.offset;
			@failed_token := candidate.failure_location;
			@failure = candidate.failure;
		};

		usize index = 0;

		while (index < discoveries.size()) {
			usize position = discoveries.data()[index];

			if (!choices->contains(position)) {
				var extension = choices->extended(position);

				if (!extension.get()) {
					@this.fail("parse alternatives storage is unavailable\0");
					return rt::unique<Syntax>();
				};

				usize known = 0;

				while (known < work.size() && !work.data()[known].get()->same(*extension.get())) {
					@known = known + 1;
				};

				if (known == work.size() && !@work.push_back(rt::unique<ParseChoices>(@extension.release()))) {
					@this.fail("parse alternatives storage is unavailable\0");
					return rt::unique<Syntax>();
				};
			};

			@index = index + 1;
		};

		@next = next + 1;
	};

	if (!alternatives.size()) {
		@this.offset = failed_at;
		@this.failure_location := failed_token;
		@this.failure = $failure;

		return rt::unique<Syntax>();
	};

	@this.offset = end;
	@this.pending_greater = pending;

	return @this.factor(@alternatives);
};

fn Parser::alternative_add(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> bool {
	if (syntax.get()->kind() == syntax_kind::ambiguity) {
		usize index = 0;

		while (index < syntax.get()->size()) {
			if (!@this.alternative_add(@alternatives, @syntax.get()->take_item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	usize index = 0;

	while (index < alternatives.size()) {
		if (alternatives.data()[index].get()->same_tree(*syntax.get())) {
			return true;
		};

		@index = index + 1;
	};

	if (!@alternatives.push_back($syntax)) {
		@this.fail("parse alternatives storage is unavailable\0");
		return false;
	};

	return true;
};

fn Parser::factor(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	// Factor each parent shape before preserving alternatives of different grammar roles.
	// This keeps type/value choices local even when declarations also compete with expressions.
	rt::buffer<rt::unique<Syntax>> factored;
	usize index = 0;

	while (index < alternatives.size()) {
		Syntax* first = alternatives.data()[index].get();

		if (!first) {
			@index = index + 1;
			continue;
		};

		rt::buffer<rt::unique<Syntax>> group;
		usize candidate = index;

		while (candidate < alternatives.size()) {
			Syntax* other = alternatives.data()[candidate].get();

			if (other && other->kind() == first->kind() && other->token().source == first->token().source && other->token().begin == first->token().begin && other->token().length == first->token().length && other->size() == first->size()) {
				if (!@this.alternative_add(@group, rt::unique<Syntax>(@((@alternatives).data()[candidate]).release()))) {
					return rt::unique<Syntax>();
				};
			};

			@candidate = candidate + 1;
		};

		if (!@this.alternative_add(@factored, @this.factor_group(@group))) {
			return rt::unique<Syntax>();
		};

		@index = index + 1;
	};

	return @this.factor_group(@factored);
};

fn Parser::factor_group(Parser& this, rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	if (alternatives.size() == 1) {
		return rt::unique<Syntax>(@((@alternatives).data()[0]).release());
	};

	Syntax* first = alternatives.data()[0].get();
	usize difference = usize::max;
	bool compatible = true;
	usize candidate = 1;

	while (candidate < alternatives.size() && compatible) {
		Syntax* other = alternatives.data()[candidate].get();

		if (other->kind() != first->kind() || other->token().source != first->token().source || other->token().begin != first->token().begin || other->token().length != first->token().length || other->size() != first->size()) {
			@compatible = false;
			break;
		};

		usize index = 0;

		while (index < first->size()) {
			if (!first->item(index)->same_tree(*other->item(index))) {
				if (first->kind() == syntax_kind::call && !index) {
					@compatible = false;
					break;
				};

				@difference = index;
			};

			@index = index + 1;
		};

		@candidate = candidate + 1;
	};

	if (compatible) {
		// Independent child choices may be factored only when every combination
		// occurs in the parsed alternatives. Unique trees make the product count
		// a completeness proof; correlated grammar choices remain whole trees.
		usize combinations = 1;
		usize index = 0;

		while (index < first->size() && compatible) {
			usize distinct = 0;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				usize previous = 0;

				while (previous < candidate && !alternatives.data()[previous].get()->item(index)->same_tree(*alternatives.data()[candidate].get()->item(index))) {
					@previous = previous + 1;
				};

				if (previous == candidate) {
					@distinct = distinct + 1;
				};

				@candidate = candidate + 1;
			};

			if (distinct > alternatives.size() / combinations) {
				@compatible = false;
				break;
			};

			@combinations = combinations * distinct;
			@index = index + 1;
		};

		if (combinations != alternatives.size()) {
			@compatible = false;
		};
	};

	if (compatible && difference != usize::max) {
		var result = @this.node(first->kind(), first->token());
		usize index = 0;

		while (index < first->size()) {
			rt::buffer<rt::unique<Syntax>> children;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				if (!@this.alternative_add(@children, @alternatives.data()[candidate].get()->take_item(index))) {
					return rt::unique<Syntax>();
				};

				@candidate = candidate + 1;
			};

			@this.add(@*result.get(), @this.factor(@children));
			@index = index + 1;
		};

		return $result;
	};

	var result = @this.node(syntax_kind::ambiguity, first->token());
	usize index = 0;

	while (index < alternatives.size()) {
		@this.add(@*result.get(), rt::unique<Syntax>(@((@alternatives).data()[index]).release()));
		@index = index + 1;
	};

	return $result;
};

fn ParseChoices::contains(const ParseChoices& this, usize position) -> bool {
	usize index = 0;

	while (index < this.operators.size()) {
		if (this.operators.data()[index] == position) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ParseChoices::extended(const ParseChoices& this, usize position) -> rt::unique<ParseChoices> {
	var result = rt::unique<ParseChoices>(new ParseChoices());
	usize index = 0;

	while (index < this.operators.size()) {
		if (!@result.get()->operators.push_back(usize(this.operators.data()[index]))) {
			return rt::unique<ParseChoices>();
		};

		@index = index + 1;
	};

	if (!@result.get()->operators.push_back($position)) {
		return rt::unique<ParseChoices>();
	};

	return $result;
};

fn ParseChoices::same(const ParseChoices& this, const ParseChoices& other) -> bool {
	if (this.operators.size() != other.operators.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.operators.size()) {
		if (!other.contains(usize(this.operators.data()[index]))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

struct Entity;

enum type_kind : [u08] {
	void_type;
	null_type;
	boolean;
	character;
	signed_integer;
	unsigned_integer;
	floating_point;
	named;
	pointer;
	reference;
	array;
	function;
	parameter;
};

enum type_qualifier : [u08] {
	mutable;
	immutable;
};

enum parameter_arity : [u08] {
	fixed;
	variadic;
};

fn type_kind::is_integer(const type_kind& this) -> bool {
	return this == type_kind::boolean || this == type_kind::character || this == type_kind::signed_integer || this == type_kind::unsigned_integer;
};

fn type_kind::is_numeric(const type_kind& this) -> bool {
	return this.is_integer() || this == type_kind::floating_point;
};

fn type_kind::is_scalar(const type_kind& this) -> bool {
	return this.is_numeric() || this == type_kind::pointer || this == type_kind::reference;
};

struct FunctionSignature {
	fn FunctionSignature(FunctionSignature& this, const Type* result, rt::buffer<const Type*> parameters, parameter_arity arity);

	fn result(const FunctionSignature& this) -> const Type*;
	fn parameters(const FunctionSignature& this) -> const rt::buffer<const Type*>&;
	fn arity(const FunctionSignature& this) -> parameter_arity;
	fn equals(const FunctionSignature& this, const FunctionSignature& other) -> bool;

private:
	const Type* return_type;
	rt::buffer<const Type*> parameter_types;
	parameter_arity argument_arity;
};

struct ArrayShape {
	const Type* element;
	u64 count;
};

union TypeShape {
	u32 bits;
	Entity* entity;
	const Type* element;
	ArrayShape array;
	const FunctionSignature* signature;
};

struct Type {
	fn Type(Type& this) : [default];
	fn Type(Type& this, type_kind kind, TypeShape shape);

	fn kind(const Type& this) -> type_kind;
	fn qualifier(const Type& this) -> type_qualifier;
	fn bits(const Type& this) -> u32;
	fn entity(const Type& this) -> Entity*;
	fn element(const Type& this) -> const Type*;
	fn count(const Type& this) -> u64;
	fn signature(const Type& this) -> const FunctionSignature&;
	fn qualified(const Type& this, type_qualifier qualifier) -> Type;
	fn equals(const Type& this, const Type& other) -> bool;
	fn same_shape(const Type& this, const Type& other) -> bool;
	fn representation(const Type& this) -> const Type*;
	fn has_layout(const Type& this) -> bool;
	fn normalize_integer(const Type& this, u64 value) -> u64;
	fn signed_value(const Type& this, u64 value) -> i64;
	fn integer_from_real(const Type& this, f64 value, u64& result) -> bool;
	fn derived_from(const Type& this, const Type& base) -> bool;
	fn hash(const Type& this) -> usize;

private:
	TypeShape shape;
	type_kind category;
	type_qualifier qualification;
};

fn Type::equals(const Type& this, const Type& other) -> bool {
	if (this.category != other.category || this.qualification != other.qualification) {
		return false;
	};

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return this.shape.entity == other.shape.entity;
		case type_kind::pointer:
		case type_kind::reference:
			return this.shape.element == other.shape.element;
		case type_kind::array:
			return this.shape.array.element == other.shape.array.element && this.shape.array.count == other.shape.array.count;
		case type_kind::function:
			return this.shape.signature->equals(*other.shape.signature);
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return this.shape.bits == other.shape.bits;
		default:
			return true;
	};
};

fn Type::hash(const Type& this) -> usize {
	usize hash = static_cast<usize>(this.category) * 37 + static_cast<usize>(this.qualification);

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.entity) >> 3);
		case type_kind::pointer:
		case type_kind::reference:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.element) >> 3);
		case type_kind::array:
			return (hash * 37 + (reinterpret_cast<usize>(this.shape.array.element) >> 3)) * 37 + static_cast<usize>(this.shape.array.count);
		case type_kind::function: {
			const FunctionSignature& signature = *this.shape.signature;
			@hash = (hash * 37 + (reinterpret_cast<usize>(signature.result()) >> 3)) * 37 + static_cast<usize>(signature.arity());
			usize index = 0;
			while (index < signature.parameters().size()) {
				@hash = hash * 37 + (reinterpret_cast<usize>(signature.parameters().data()[index]) >> 3);
				@index = index + 1;
			};

			return $hash;
		};
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return hash * 37 + static_cast<usize>(this.shape.bits);
		default:
			return $hash;
	};
};

fn FunctionSignature::FunctionSignature(FunctionSignature& this, const Type* result, rt::buffer<const Type*> parameters, parameter_arity arity) {
	@this.return_type = $result;
	@this.parameter_types = $parameters;
	@this.argument_arity = $arity;
};

fn FunctionSignature::result(const FunctionSignature& this) -> const Type* {
	return this.return_type;
};

fn FunctionSignature::parameters(const FunctionSignature& this) -> const rt::buffer<const Type*>& {
	return this.parameter_types;
};

fn FunctionSignature::arity(const FunctionSignature& this) -> parameter_arity {
	return parameter_arity(this.argument_arity);
};

fn FunctionSignature::equals(const FunctionSignature& this, const FunctionSignature& other) -> bool {
	if (this.return_type != other.return_type || this.argument_arity != other.argument_arity || this.parameter_types.size() != other.parameter_types.size()) {
		return false;
	};

	usize index = 0;
	while (index < this.parameter_types.size()) {
		if (this.parameter_types.data()[index] != other.parameter_types.data()[index]) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Type::Type(Type& this, type_kind kind, TypeShape shape) {
	@this.category = $kind;
	@this.shape = $shape;
};

fn Type::kind(const Type& this) -> type_kind {
	return type_kind(this.category);
};

fn Type::qualifier(const Type& this) -> type_qualifier {
	return type_qualifier(this.qualification);
};

fn Type::bits(const Type& this) -> u32 {
	return this.shape.bits;
};

fn Type::entity(const Type& this) -> Entity* {
	return this.shape.entity;
};

fn Type::element(const Type& this) -> const Type* {
	if (this.category == type_kind::array) {
		return this.shape.array.element;
	};

	return this.shape.element;
};

fn Type::count(const Type& this) -> u64 {
	return this.shape.array.count;
};

fn Type::signature(const Type& this) -> const FunctionSignature& {
	return *this.shape.signature;
};

fn Type::qualified(const Type& this, type_qualifier qualifier) -> Type {
	Type result := this;
	@result.qualification = $qualifier;

	return $result;
};

fn Type::same_shape(const Type& this, const Type& other) -> bool {
	Type first = this.qualified(type_qualifier::mutable);
	Type second = other.qualified(type_qualifier::mutable);

	return first.equals(second);
};

struct TypeEntry {
	Type value;
	TypeEntry* next;
};

struct TypeStore {
	fn TypeStore(TypeStore& this) : [default];
	fn TypeStore(TypeStore& this, const TypeStore& other) : [delete];
	fn TypeStore(TypeStore& this, TypeStore other) : [default];

	fn operator=(TypeStore& this, const TypeStore& other) -> TypeStore& : [delete];
	fn operator=(TypeStore& this, TypeStore other) -> TypeStore& : [default];
	fn primitive(TypeStore& this, type_kind kind, u32 bits) -> const Type*;
	fn initialize_primitives(TypeStore& this, u32 pointer_bits) -> bool;
	fn named(TypeStore& this, type_kind kind, Entity* entity) -> const Type*;
	fn pointer(TypeStore& this, const Type* element) -> const Type*;
	fn reference(TypeStore& this, const Type* element) -> const Type*;
	fn array(TypeStore& this, const Type* element, u64 count) -> const Type*;
	fn function(TypeStore& this, const Type* result, rt::buffer<const Type*> parameters, parameter_arity arity) -> const Type*;
	fn qualified(TypeStore& this, const Type& type, type_qualifier qualifier) -> const Type*;
	fn clear(TypeStore& this);

	fn find_primitive(const TypeStore& this, const rt::string_view& name) -> const Type*;

private:
	fn register_primitive(TypeStore& this, rt::unordered_map<rt::string_view, const Type*, rt::string_view_hash>& names, rt::string_view name, type_kind kind, u32 bits) -> bool;
	fn intern(TypeStore& this, Type key) -> const Type*;
	fn rehash(TypeStore& this, usize count) -> bool;

	fn find(const TypeStore& this, const Type& key) -> const Type*;

	rt::buffer<rt::unique<FunctionSignature>> signatures;
	rt::buffer<rt::unique<TypeEntry>> entries;
	rt::buffer<TypeEntry*> buckets;
	rt::unordered_map<rt::string_view, const Type*, rt::string_view_hash> primitive_names;
};

fn TypeStore::find(const TypeStore& this, const Type& key) -> const Type* {
	if (!this.buckets.size()) {
		return nullptr;
	};

	TypeEntry* entry := this.buckets.data()[key.hash() % this.buckets.size()];

	while (entry) {
		if (entry->value.equals(key)) {
			return &entry->value;
		};

		@entry := entry->next;
	};

	return nullptr;
};

fn TypeStore::rehash(TypeStore& this, usize count) -> bool {
	rt::buffer<TypeEntry*> replacement;

	if (!@replacement.reserve(usize(count))) {
		return false;
	};

	usize index = 0;
	while (index < count) {
		if (!@replacement.push_back(nullptr)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;
	TypeEntry** buckets = (@replacement).data();

	while (index < this.entries.size()) {
		TypeEntry* entry = this.entries.data()[index].get();
		usize bucket = entry->value.hash() % count;
		@entry->next := buckets[bucket];
		@buckets[bucket] := entry;
		@index = index + 1;
	};

	@this.buckets = $replacement;

	return true;
};

fn TypeStore::intern(TypeStore& this, Type key) -> const Type* {
	const Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!this.buckets.size()) {
		if (!@this.rehash(64)) {
			return nullptr;
		};
	}
	else if (this.entries.size() >= this.buckets.size()) {
		if (this.buckets.size() > usize::max / 2 || !@this.rehash(this.buckets.size() * 2)) {
			return nullptr;
		};
	};

	var owner = rt::unique<TypeEntry>::make();

	if (!owner.get()) {
		return nullptr;
	};

	TypeEntry* entry = owner.get();
	@entry->value = $key;

	if (!@this.entries.push_back($owner)) {
		return nullptr;
	};

	usize bucket = entry->value.hash() % this.buckets.size();
	TypeEntry** buckets = (@this.buckets).data();
	@entry->next := buckets[bucket];
	@buckets[bucket] := entry;

	return &entry->value;
};

fn TypeStore::primitive(TypeStore& this, type_kind kind, u32 bits) -> const Type* {
	TypeShape shape;
	@shape.bits = $bits;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::named(TypeStore& this, type_kind kind, Entity* entity) -> const Type* {
	TypeShape shape;
	@shape.entity = $entity;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::pointer(TypeStore& this, const Type* element) -> const Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::pointer, $shape));
};

fn TypeStore::reference(TypeStore& this, const Type* element) -> const Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::reference, $shape));
};

fn TypeStore::array(TypeStore& this, const Type* element, u64 count) -> const Type* {
	TypeShape shape;
	@shape.array.element = $element;
	@shape.array.count = $count;

	return @this.intern(Type(type_kind::array, $shape));
};

fn TypeStore::function(TypeStore& this, const Type* result, rt::buffer<const Type*> parameters, parameter_arity arity) -> const Type* {
	var signature = rt::unique<FunctionSignature>(new FunctionSignature($result, $parameters, $arity));

	if (!signature.get()) {
		return nullptr;
	};

	TypeShape shape;
	@shape.signature = signature.get();
	var key = Type(type_kind::function, $shape);
	const Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!@this.signatures.push_back($signature)) {
		return nullptr;
	};

	return @this.intern($key);
};

fn TypeStore::qualified(TypeStore& this, const Type& type, type_qualifier qualifier) -> const Type* {
	return @this.intern(type.qualified($qualifier));
};

fn TypeStore::clear(TypeStore& this) {
	@this.primitive_names.clear();
	@this.buckets.clear();
	@this.entries.clear();
	@this.signatures.clear();
};

fn TypeStore::register_primitive(TypeStore& this, rt::unordered_map<rt::string_view, const Type*, rt::string_view_hash>& names, rt::string_view name, type_kind kind, u32 bits) -> bool {
	const Type* type = @this.primitive($kind, $bits);

	if (!type) {
		return false;
	};

	return @names.insert($name, $type);
};

fn TypeStore::initialize_primitives(TypeStore& this, u32 pointer_bits) -> bool {
	rt::unordered_map<rt::string_view, const Type*, rt::string_view_hash> names;

	if (!@names.reserve(20)) {
		return false;
	};

	if (!@this.register_primitive(@names, rt::string_view("void\0"), type_kind::void_type, 0)
		|| !@this.register_primitive(@names, rt::string_view("null\0"), type_kind::null_type, 0)
		|| !@this.register_primitive(@names, rt::string_view("bool\0"), type_kind::boolean, 1)
		|| !@this.register_primitive(@names, rt::string_view("char\0"), type_kind::character, 8)
		|| !@this.register_primitive(@names, rt::string_view("usize\0"), type_kind::unsigned_integer, u32(pointer_bits))
		|| !@this.register_primitive(@names, rt::string_view("isize\0"), type_kind::signed_integer, u32(pointer_bits))
		|| !@this.register_primitive(@names, rt::string_view("ptrdiff\0"), type_kind::signed_integer, u32(pointer_bits))
		|| !@this.register_primitive(@names, rt::string_view("i8\0"), type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("i08\0"), type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("i16\0"), type_kind::signed_integer, 16)
		|| !@this.register_primitive(@names, rt::string_view("i32\0"), type_kind::signed_integer, 32)
		|| !@this.register_primitive(@names, rt::string_view("i64\0"), type_kind::signed_integer, 64)
		|| !@this.register_primitive(@names, rt::string_view("u8\0"), type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("u08\0"), type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("u16\0"), type_kind::unsigned_integer, 16)
		|| !@this.register_primitive(@names, rt::string_view("u32\0"), type_kind::unsigned_integer, 32)
		|| !@this.register_primitive(@names, rt::string_view("u64\0"), type_kind::unsigned_integer, 64)
		|| !@this.register_primitive(@names, rt::string_view("f32\0"), type_kind::floating_point, 32)
		|| !@this.register_primitive(@names, rt::string_view("f64\0"), type_kind::floating_point, 64)) {
		return false;
	};

	@this.primitive_names = $names;

	return true;
};

fn TypeStore::find_primitive(const TypeStore& this, const rt::string_view& name) -> const Type* {
	var found = this.primitive_names.find(name);

	if (!found) {
		return nullptr;
	};

	return *found;
};

struct NativeFile;

fn fclose(NativeFile* file) -> i32;

fn fread(void* destination, usize size, usize count, NativeFile* file) -> usize;

fn fwrite(const void* source, usize size, usize count, NativeFile* file) -> usize;

fn ferror(NativeFile* file) -> i32;

using FileOpener = ((const char*, const char*) -> NativeFile*)*;

struct FileCloser {
	fn dispose(NativeFile* file);
};

struct File {
	fn File(File& this, NativeFile* file);
	fn File(File& this, const File& other) : [delete];
	fn File(File& this, File other) : [default];

	fn operator=(File& this, const File& other) -> File& : [delete];
	fn operator=(File& this, File other) -> File& : [default];
	fn read(File& this, char* destination, usize capacity) -> usize;
	fn write(File& this, const rt::string_view& bytes) -> bool;
	fn close(File& this) -> bool;

	fn is_open(const File& this) -> bool;
	fn failed(const File& this) -> bool;

private:
	rt::unique<NativeFile, FileCloser> handle;
};

fn FileCloser::dispose(NativeFile* file) {
	if (file) {
		fclose($file);
	};
};

fn File::File(File& this, NativeFile* file) {
	@this.handle = rt::unique<NativeFile, FileCloser>($file);
};

fn File::is_open(const File& this) -> bool {
	return this.handle.get() != nullptr;
};

fn File::failed(const File& this) -> bool {
	return !this.handle.get() || ferror(this.handle.get());
};

fn File::read(File& this, char* destination, usize capacity) -> usize {
	return fread($destination, 1, $capacity, this.handle.get());
};

fn File::write(File& this, const rt::string_view& bytes) -> bool {
	return fwrite(bytes.data(), 1, bytes.size(), this.handle.get()) == bytes.size();
};

fn File::close(File& this) -> bool {
	NativeFile* handle = @this.handle.release();

	if (!handle) {
		return true;
	};

	return !fclose($handle);
};

fn fprintf(NativeFile* file, const char* format, ...) -> i32;

enum diagnostic_state : [u08] {
	clean;
	failed;
};

struct Diagnostics {
	fn Diagnostics(Diagnostics& this) : [default];
	fn Diagnostics(Diagnostics& this, NativeFile* output);

	fn error(Diagnostics& this, const Token& location, const rt::string_view& message);

	fn failed(const Diagnostics& this) -> bool;

private:
	NativeFile* output;
	diagnostic_state state;
};

fn Diagnostics::Diagnostics(Diagnostics& this, NativeFile* output) {
	@this.output = $output;
};

fn Diagnostics::failed(const Diagnostics& this) -> bool {
	return this.state == diagnostic_state::failed;
};

fn Diagnostics::error(Diagnostics& this, const Token& location, const rt::string_view& message) {
	@this.state = diagnostic_state::failed;

	if (!this.output) {
		return;
	};

	var path = rt::string_view("<compiler>\0");

	if (location.source) {
		@path = location.source->path();
	};

	usize path_size = path.size();
	usize message_size = message.size();

	if (path_size > static_cast<usize>(i32::max)) {
		@path_size = static_cast<usize>(i32::max);
	};

	if (message_size > static_cast<usize>(i32::max)) {
		@message_size = static_cast<usize>(i32::max);
	};

	fprintf(this.output, "%.*s:%llu:%llu: %.*s\n\0", static_cast<i32>($path_size), path.data(), u64(location.line), u64(location.column), static_cast<i32>($message_size), message.data());
};

struct SourceReader {
	fn SourceReader(SourceReader& this, FileOpener opener, SourceManager& sources, Diagnostics& diagnostics);

	fn load(SourceReader& this, const char* path) -> SourceFile*;

private:
	FileOpener opener;
	SourceManager* sources;
	Diagnostics* diagnostics;
};

fn SourceReader::SourceReader(SourceReader& this, FileOpener opener, SourceManager& sources, Diagnostics& diagnostics) {
	@this.opener = $opener;
	@this.sources = &sources;
	@this.diagnostics = &diagnostics;
};

fn SourceReader::load(SourceReader& this, const char* path) -> SourceFile* {
	Token location;
	var file = File(this.opener(path, "rb\0"));

	if (!file.is_open()) {
		@this.diagnostics->error(location, "cannot open source\0");
		return nullptr;
	};

	rt::string contents;
	char[4096] chunk {};

	while (true) {
		usize count = @file.read(&chunk[0], sizeof(chunk));

		if (!count) {
			break;
		};

		if (!@contents.append(rt::string_view(&chunk[0], $count))) {
			@this.diagnostics->error(location, "source storage is unavailable\0");
			return nullptr;
		};
	};

	if (file.failed()) {
		@this.diagnostics->error(location, "cannot read source\0");
		return nullptr;
	};

	if (!@file.close()) {
		@this.diagnostics->error(location, "cannot close source\0");
		return nullptr;
	};

	SourceFile* source = @this.sources->add(rt::string_view($path), contents.view());

	if (!source) {
		@this.diagnostics->error(location, "source storage is unavailable\0");
	};

	return $source;
};

enum output_kind : [u08] {
	executable;
	library;
};

enum entity_kind : [u08] {
	function;
	global;
	local;
	parameter;
	record;
	field;
	enumeration;
	enumerator;
	namespace_body;
	alias;
	type_parameter;
	template_pattern;
	primitive_type;
	constant;
};

enum entity_state : [u08] {
	declared;
	resolving;
	ready;
};

enum binding_lifetime : [u08] {
	live;
	consumed;
};

enum function_definition : [u08] {
	declaration;
	user_defined;
	defaulted;
	deleted;
};

enum function_completion : [u08] {
	unchecked;
	reaches_end;
	no_fallthrough;
};

enum function_role : [u08] {
	ordinary;
	constructor;
	destructor;
	assignment;
	conversion;
};

enum conversion_mode : [u08] {
	explicit_only;
	implicit_allowed;
};

enum access_kind : [u08] {
	public_access;
	protected_access;
	private_access;
};

enum record_layout : [u08] {
	sequential;
	overlapping;
};

enum function_dispatch : [u08] {
	ordinary;
	virtual_function;
	override_function;
	final_function;
};

enum declaration_origin : [u08] {
	source;
	compiler_supplied;
};

struct Scope;
struct CopyAssignmentPlan;

struct Entity {
	fn Entity(Entity& this, entity_kind kind, const Token& token, Syntax* source, Scope* scope);

	fn kind(const Entity& this) -> entity_kind;
	fn canonical(const Entity& this) -> Entity*;
	fn token(const Entity& this) -> Token;
	fn name(const Entity& this) -> rt::string_view;
	fn set_name(Entity& this, const rt::string_view& name) -> bool;
	fn origin(const Entity& this) -> declaration_origin;
	fn set_origin(Entity& this, declaration_origin origin);
	fn merge_into(Entity& this, Entity* canonical);
	fn adopt_definition(Entity& this, const Entity& source) -> bool;

	fn type(const Entity& this) -> const Type*;
	fn set_type(Entity& this, const Type* type);
	fn type_use(const Entity& this) -> const rt::optional_ref<const TypeUse>&;
	fn set_type_use(Entity& this, const TypeUse& use);
	fn underlying(const Entity& this) -> const Type*;
	fn set_underlying(Entity& this, const Type* type);
	fn denotes_type(const Entity& this) -> bool;
	fn layout(const Entity& this) -> record_layout;
	fn member_owner(const Entity& this) -> Entity*;
	fn bases(const Entity& this) -> const rt::buffer<const Type*>&;
	fn add_base(Entity& this, const Type* type) -> bool;

	fn declaration(const Entity& this) -> Syntax*;
	fn replace_declaration(Entity& this, Syntax* syntax);
	fn scope(const Entity& this) -> Scope*;
	fn resolution_scope(const Entity& this) -> Scope*;
	fn set_resolution_scope(Entity& this, Scope* scope);
	fn members(const Entity& this) -> Scope*;
	fn set_members(Entity& this, Scope* scope);
	fn find_member(const Entity& this, const rt::string_view& name) -> Entity*;

	fn parameters(const Entity& this) -> const rt::buffer<Entity*>&;
	fn add_parameter(Entity& this, Entity* parameter) -> bool;
	fn fields(const Entity& this) -> const rt::buffer<Entity*>&;
	fn add_field(Entity& this, Entity* field) -> bool;
	fn index(const Entity& this) -> usize;
	fn set_index(Entity& this, usize index);
	fn body(const Entity& this) -> SemanticExpression*;
	fn set_body(Entity& this, rt::unique<SemanticExpression> body);
	fn body_state(const Entity& this) -> entity_state;
	fn set_body_state(Entity& this, entity_state state);
	fn completion(const Entity& this) -> function_completion;
	fn set_completion(Entity& this, function_completion completion);

	fn destructor(const Entity& this) -> Entity*;
	fn set_destructor(Entity& this, Entity* function);
	fn default_constructor(const Entity& this) -> Entity*;
	fn set_default_constructor(Entity& this, Entity* function);
	fn copy_constructor(const Entity& this) -> Entity*;
	fn set_copy_constructor(Entity& this, Entity* function);
	fn move_constructor(const Entity& this) -> Entity*;
	fn set_move_constructor(Entity& this, Entity* function);
	fn copy_assignment(const Entity& this) -> CopyAssignmentPlan*;
	fn set_copy_assignment(Entity& this, rt::unique<CopyAssignmentPlan> plan);

	fn virtual_owner(const Entity& this) -> Entity*;
	fn owns_dispatch(const Entity& this) -> bool;
	fn virtual_functions(const Entity& this) -> const rt::buffer<Entity*>&;
	fn add_virtual(Entity& this, Entity* function) -> bool;
	fn replace_virtual(Entity& this, usize index, Entity& function);
	fn dispatch(const Entity& this) -> function_dispatch;
	fn set_dispatch(Entity& this, function_dispatch dispatch);
	fn declares_virtual(const Entity& this) -> bool;
	fn requires_override(const Entity& this) -> bool;
	fn is_final(const Entity& this) -> bool;
	fn merge_dispatch(Entity& this, const Entity& source);
	fn virtual_slot(const Entity& this) -> usize;
	fn set_virtual_slot(Entity& this, usize slot);
	fn dispatch_required(const Entity& this) -> bool;
	fn require_dispatch(Entity& this);

	fn definition(const Entity& this) -> function_definition;
	fn set_definition(Entity& this, function_definition definition);
	fn role(const Entity& this) -> function_role;
	fn set_role(Entity& this, function_role role);
	fn conversion(const Entity& this) -> conversion_mode;
	fn set_conversion(Entity& this, conversion_mode mode);
	fn access(const Entity& this) -> access_kind;
	fn set_access(Entity& this, access_kind access);
	fn operator_kind(const Entity& this) -> token_kind;
	fn set_operator_kind(Entity& this, token_kind operation);

	fn state(const Entity& this) -> entity_state;
	fn set_state(Entity& this, entity_state state);
	fn lifetime(const Entity& this) -> binding_lifetime;
	fn set_lifetime(Entity& this, binding_lifetime lifetime);
	fn integer(const Entity& this) -> u64;
	fn set_integer(Entity& this, u64 value);
	fn instantiated(const Entity& this) -> bool;
	fn set_instantiated(Entity& this);

private:
	entity_kind category;
	declaration_origin declaration_origin_kind;
	rt::string generated_name;
	entity_state resolution;
	entity_state body_resolution;
	function_completion body_completion;
	bool template_instance;
	bool virtual_specified;
	bool override_specified;
	bool final_specified;
	bool dispatch_live;
	usize dispatch_slot;
	function_definition body_kind;
	function_role function_kind;
	conversion_mode conversion_kind;
	access_kind visibility;
	token_kind operator_symbol;
	binding_lifetime validity;
	Token location;
	Syntax* source;
	Scope* declaration_scope;
	Scope* definition_scope;
	Scope* member_scope;
	Entity* previous_declaration;
	Entity* finalizer;
	Entity* default_initializer;
	Entity* copy_initializer;
	rt::unique<CopyAssignmentPlan> copy_assigner;
	Entity* move_initializer;
	const Type* value_type;
	rt::optional_ref<const TypeUse> use;
	const Type* underlying_type;
	usize position;
	u64 constant_value;
	rt::buffer<Entity*> arguments;
	rt::buffer<Entity*> member_fields;
	rt::buffer<const Type*> base_types;
	rt::buffer<Entity*> dispatch_table;
	rt::unique<SemanticExpression> implementation;
};

fn Entity::find_member(const Entity& this, const rt::string_view& name) -> Entity* {
	if (!this.members()) {
		return nullptr;
	};

	Entity* result = this.members()->local(name);

	if (result || this.bases().size() != 1) {
		return result;
	};

	Entity* base = this.bases().data()[0]->entity();

	if (base->name() == name) {
		return $base;
	};

	return base->find_member(name);
};

fn Entity::virtual_owner(const Entity& this) -> Entity* {
	if (!this.virtual_functions().size()) {
		return nullptr;
	};

	if (this.bases().size() && this.bases().data()[0]->entity()->virtual_functions().size()) {
		return this.bases().data()[0]->entity()->virtual_owner();
	};

	return const_cast<Entity*>(&this);
};

fn Entity::owns_dispatch(const Entity& this) -> bool {
	return this.virtual_functions().size() && (!this.bases().size() || !this.bases().data()[0]->entity()->virtual_functions().size());
};

fn Entity::virtual_functions(const Entity& this) -> const rt::buffer<Entity*>& {
	return this.dispatch_table;
};

fn Entity::add_virtual(Entity& this, Entity* function) -> bool {
	return @this.dispatch_table.push_back($function);
};

fn Entity::replace_virtual(Entity& this, usize index, Entity& function) {
	var entries = (@this.dispatch_table).data();
	@entries[index] = &function;
};

fn Entity::dispatch(const Entity& this) -> function_dispatch {
	if (this.final_specified) {
		return function_dispatch::final_function;
	};

	if (this.override_specified) {
		return function_dispatch::override_function;
	};

	if (this.virtual_specified) {
		return function_dispatch::virtual_function;
	};

	return function_dispatch::ordinary;
};

fn Entity::declares_virtual(const Entity& this) -> bool {
	return this.virtual_specified;
};

fn Entity::requires_override(const Entity& this) -> bool {
	return this.override_specified;
};

fn Entity::is_final(const Entity& this) -> bool {
	return this.final_specified;
};

fn Entity::set_dispatch(Entity& this, function_dispatch dispatch) {
	if (dispatch == function_dispatch::virtual_function) {
		@this.virtual_specified = true;
	};

	if (dispatch == function_dispatch::override_function) {
		@this.override_specified = true;
	};

	if (dispatch == function_dispatch::final_function) {
		@this.final_specified = true;
	};
};

fn Entity::merge_dispatch(Entity& this, const Entity& source) {
	@this.virtual_specified = this.virtual_specified || source.virtual_specified;
	@this.override_specified = this.override_specified || source.override_specified;
	@this.final_specified = this.final_specified || source.final_specified;
};

fn Entity::virtual_slot(const Entity& this) -> usize {
	return this.dispatch_slot;
};

fn Entity::set_virtual_slot(Entity& this, usize slot) {
	@this.dispatch_slot = $slot;
};

fn Entity::dispatch_required(const Entity& this) -> bool {
	return this.dispatch_live;
};

fn Entity::require_dispatch(Entity& this) {
	@this.dispatch_live = true;
};

fn Entity::bases(const Entity& this) -> const rt::buffer<const Type*>& {
	return this.base_types;
};

fn Entity::add_base(Entity& this, const Type* type) -> bool {
	return @this.base_types.push_back($type);
};

fn Entity::Entity(Entity& this, entity_kind kind, const Token& token, Syntax* source, Scope* scope) {
	@this.category = $kind;
	@this.location := token;
	@this.source = $source;
	@this.declaration_scope = $scope;
};

fn Entity::kind(const Entity& this) -> entity_kind {
	return entity_kind(this.category);
};

fn Entity::layout(const Entity& this) -> record_layout {
	if (this.declaration() && this.declaration()->token().kind == token_kind::kw_union) {
		return record_layout::overlapping;
	};

	return record_layout::sequential;
};

fn Entity::denotes_type(const Entity& this) -> bool {
	switch (this.kind()) {
		case entity_kind::primitive_type:
		case entity_kind::record:
		case entity_kind::enumeration:
		case entity_kind::alias:
		case entity_kind::type_parameter:
			return true;
		case entity_kind::template_pattern:
			return this.declaration()->kind() == syntax_kind::template_declaration && (this.declaration()->template_declaration()->kind() == syntax_kind::record || this.declaration()->template_declaration()->kind() == syntax_kind::using_alias);
		default:
			return false;
	};
};

fn Entity::member_owner(const Entity& this) -> Entity* {
	if (this.kind() == entity_kind::alias || this.kind() == entity_kind::type_parameter) {
		if (!this.type() || this.type()->kind() != type_kind::named) {
			return nullptr;
		};

		return this.type()->entity();
	};

	if (this.members()) {
		return const_cast<Entity*>(&this);
	};

	return nullptr;
};

fn Entity::instantiated(const Entity& this) -> bool {
	return this.template_instance;
};

fn Entity::set_instantiated(Entity& this) {
	@this.template_instance = true;
};

fn Entity::body_state(const Entity& this) -> entity_state {
	return entity_state(this.body_resolution);
};

fn Entity::set_body_state(Entity& this, entity_state state) {
	@this.body_resolution = $state;
};

fn Entity::completion(const Entity& this) -> function_completion {
	return function_completion(this.body_completion);
};

fn Entity::set_completion(Entity& this, function_completion completion) {
	@this.body_completion = $completion;
};

fn Entity::canonical(const Entity& this) -> Entity* {
	if (this.previous_declaration) {
		return this.previous_declaration->canonical();
	};

	return const_cast<Entity*>(&this);
};

fn Entity::token(const Entity& this) -> Token {
	return Token(this.location);
};

fn Entity::name(const Entity& this) -> rt::string_view {
	if (!this.generated_name.empty()) {
		return this.generated_name.view();
	};

	return this.location.text();
};

fn Entity::set_name(Entity& this, const rt::string_view& name) -> bool {
	return @this.generated_name.append(name);
};

fn Entity::origin(const Entity& this) -> declaration_origin {
	return declaration_origin(this.declaration_origin_kind);
};

fn Entity::set_origin(Entity& this, declaration_origin origin) {
	@this.declaration_origin_kind = $origin;
};

fn Entity::type_use(const Entity& this) -> const rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn Entity::set_type_use(Entity& this, const TypeUse& use) {
	@this.use.bind(use);
};

fn Entity::type(const Entity& this) -> const Type* {
	return this.value_type;
};

fn Entity::declaration(const Entity& this) -> Syntax* {
	return this.source;
};

fn Entity::scope(const Entity& this) -> Scope* {
	return this.declaration_scope;
};

fn Entity::resolution_scope(const Entity& this) -> Scope* {
	if (this.definition_scope) {
		return this.definition_scope;
	};

	return this.declaration_scope;
};

fn Entity::set_resolution_scope(Entity& this, Scope* scope) {
	@this.definition_scope = $scope;
};

fn Entity::members(const Entity& this) -> Scope* {
	return this.member_scope;
};

fn Entity::body(const Entity& this) -> SemanticExpression* {
	return this.implementation.get();
};

fn Entity::parameters(const Entity& this) -> const rt::buffer<Entity*>& {
	return this.arguments;
};

fn Entity::fields(const Entity& this) -> const rt::buffer<Entity*>& {
	return this.member_fields;
};

fn Entity::index(const Entity& this) -> usize {
	return this.position;
};

fn Entity::state(const Entity& this) -> entity_state {
	return entity_state(this.resolution);
};

fn Entity::lifetime(const Entity& this) -> binding_lifetime {
	return binding_lifetime(this.validity);
};

fn Entity::integer(const Entity& this) -> u64 {
	return this.constant_value;
};

fn Entity::underlying(const Entity& this) -> const Type* {
	return this.underlying_type;
};

fn Entity::destructor(const Entity& this) -> Entity* {
	if (!this.finalizer) {
		return nullptr;
	};

	return this.finalizer->canonical();
};

fn Entity::default_constructor(const Entity& this) -> Entity* {
	return this.default_initializer;
};

fn Entity::copy_constructor(const Entity& this) -> Entity* {
	return this.copy_initializer;
};

fn Entity::move_constructor(const Entity& this) -> Entity* {
	return this.move_initializer;
};

fn Entity::set_default_constructor(Entity& this, Entity* function) {
	@this.default_initializer = $function;
};

fn Entity::set_copy_constructor(Entity& this, Entity* function) {
	@this.copy_initializer = $function;
};

fn Entity::set_move_constructor(Entity& this, Entity* function) {
	@this.move_initializer = $function;
};

fn Entity::definition(const Entity& this) -> function_definition {
	return function_definition(this.body_kind);
};

fn Entity::role(const Entity& this) -> function_role {
	return function_role(this.function_kind);
};

fn Entity::conversion(const Entity& this) -> conversion_mode {
	return conversion_mode(this.conversion_kind);
};

fn Entity::access(const Entity& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Entity::set_access(Entity& this, access_kind access) {
	@this.visibility = $access;
};

fn Entity::operator_kind(const Entity& this) -> token_kind {
	return token_kind(this.operator_symbol);
};

fn Entity::set_operator_kind(Entity& this, token_kind operation) {
	@this.operator_symbol = $operation;
};

fn Entity::set_definition(Entity& this, function_definition definition) {
	@this.body_kind = $definition;
};

fn Entity::set_role(Entity& this, function_role role) {
	@this.function_kind = $role;
};

fn Entity::set_conversion(Entity& this, conversion_mode mode) {
	@this.conversion_kind = $mode;
};

fn Entity::set_destructor(Entity& this, Entity* function) {
	@this.finalizer = $function;
};

fn Entity::set_type(Entity& this, const Type* type) {
	@this.value_type = $type;
};

fn Entity::merge_into(Entity& this, Entity* canonical) {
	@this.previous_declaration = $canonical;
};

fn Entity::replace_declaration(Entity& this, Syntax* syntax) {
	@this.source = $syntax;
};

fn Entity::adopt_definition(Entity& this, const Entity& source) -> bool {
	@this.source = source.declaration();
	@this.member_scope = source.members();
	@this.body_kind = source.definition();
	@this.function_kind = source.role();

	if (source.conversion() == conversion_mode::implicit_allowed) {
		@this.conversion_kind = conversion_mode::implicit_allowed;
	};

	@this.arguments.clear();
	usize index = 0;
	while (index < source.parameters().size()) {
		if (!@this.arguments.push_back(source.parameters().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Entity::set_members(Entity& this, Scope* scope) {
	@this.member_scope = $scope;
};

fn Entity::set_body(Entity& this, rt::unique<SemanticExpression> body) {
	@this.implementation = $body;
	@this.body_completion = function_completion::unchecked;
};

fn Entity::set_state(Entity& this, entity_state state) {
	@this.resolution = $state;
};

fn Entity::set_lifetime(Entity& this, binding_lifetime lifetime) {
	@this.validity = $lifetime;
};

fn Entity::set_integer(Entity& this, u64 value) {
	@this.constant_value = $value;
};

fn Entity::set_underlying(Entity& this, const Type* type) {
	@this.underlying_type = $type;
};

fn Entity::set_index(Entity& this, usize index) {
	@this.position = $index;
};

fn Entity::add_parameter(Entity& this, Entity* parameter) -> bool {
	return @this.arguments.push_back($parameter);
};

fn Entity::add_field(Entity& this, Entity* field) -> bool {
	return @this.member_fields.push_back($field);
};

struct Scope {
	fn Scope(Scope& this, Scope* parent, Entity* owner);

	fn set_access(Scope& this, access_kind access);
	fn define(Scope& this, Entity* entity) -> bool;

	fn parent(const Scope& this) -> Scope*;
	fn owner(const Scope& this) -> Entity*;
	fn bindings(const Scope& this) -> const rt::buffer<Entity*>&;
	fn access(const Scope& this) -> access_kind;
	fn local(const Scope& this, const rt::string_view& name) -> Entity*;
	fn lookup(const Scope& this, const rt::string_view& name) -> Entity*;

private:
	Scope* enclosing;
	Entity* declaration_owner;
	access_kind visibility;
	rt::buffer<Entity*> names;
};

fn Scope::Scope(Scope& this, Scope* parent, Entity* owner) {
	@this.enclosing = $parent;
	@this.declaration_owner = $owner;
};

fn Scope::parent(const Scope& this) -> Scope* {
	return this.enclosing;
};

fn Scope::owner(const Scope& this) -> Entity* {
	return this.declaration_owner;
};

fn Scope::bindings(const Scope& this) -> const rt::buffer<Entity*>& {
	return this.names;
};

fn Scope::access(const Scope& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Scope::set_access(Scope& this, access_kind access) {
	@this.visibility = $access;
};

fn Scope::local(const Scope& this, const rt::string_view& name) -> Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		Entity* entity := this.names.data()[index];

		if (entity->name() == name) {
			return $entity;
		};
	};

	return nullptr;
};

fn Scope::lookup(const Scope& this, const rt::string_view& name) -> Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};

	Entity* result = this.local(name);

	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};

	if (result || !this.enclosing) {
		return $result;
	};

	return this.enclosing->lookup(name);
};

fn Scope::define(Scope& this, Entity* entity) -> bool {
	return @this.names.push_back($entity);
};

enum value_category : [u08] {
	place;
	consumable;
};

enum semantic_kind : [u08] {
	noop;
	literal_integer;
	literal_real;
	literal_text;
	null_pointer;
	name;
	unary;
	binary;
	call;
	brace;
	statements;
	sequence;
	deferred_argument;
	variable;
	return_value;
	conditional;
	switch_expression;
	case_label;
	while_loop;
	for_loop;
	break_loop;
	continue_loop;
	cast;
	relocation;
	access;
	dereference;
	address;
	index;
	member;
	construction;
	allocation;
	deallocation;
	array_deallocation;
	destruction;
	sizeof_type;
	discard_value;
};

struct SemanticExpression {
	fn SemanticExpression(SemanticExpression& this, semantic_kind kind, const Type* type, const Token& token);

	fn set_type_use(SemanticExpression& this, const TypeUse& use);
	fn set_mutable_access(SemanticExpression& this, bool permitted);
	fn append(SemanticExpression& this, rt::unique<SemanticExpression> child) -> bool;
	fn bind(SemanticExpression& this, Entity* entity, value_category category);
	fn set_category(SemanticExpression& this, value_category category);
	fn set_integer(SemanticExpression& this, u64 value);
	fn set_real(SemanticExpression& this, f64 value);
	fn set_text(SemanticExpression& this, const rt::string_view& value) -> bool;

	fn copy_constant(const SemanticExpression& this) -> rt::unique<SemanticExpression>;
	fn constant_truth(const SemanticExpression& this, bool& result) -> bool;
	fn constant_integer(const SemanticExpression& this, u64& result) -> bool;
	fn constant_real(const SemanticExpression& this, f64& result) -> bool;
	fn real_comparison(const SemanticExpression& this, u64& result) -> bool;
	fn owned_binding(const SemanticExpression& this) -> Entity*;
	fn indirect_storage(const SemanticExpression& this) -> bool;
	fn kind(const SemanticExpression& this) -> semantic_kind;
	fn type_use(const SemanticExpression& this) -> const rt::optional_ref<const TypeUse>&;
	fn type(const SemanticExpression& this) -> const Type*;
	fn token(const SemanticExpression& this) -> Token;
	fn entity(const SemanticExpression& this) -> Entity*;
	fn operation(const SemanticExpression& this) -> token_kind;
	fn category(const SemanticExpression& this) -> value_category;
	fn mutable_access(const SemanticExpression& this) -> bool;
	fn integer(const SemanticExpression& this) -> u64;
	fn real(const SemanticExpression& this) -> f64;
	fn text(const SemanticExpression& this) -> rt::string_view;
	fn size(const SemanticExpression& this) -> usize;
	fn item(const SemanticExpression& this, usize index) -> SemanticExpression*;

private:
	semantic_kind category_kind;
	value_category value_kind;
	bool reference_access;
	const Type* value_type;
	rt::optional_ref<const TypeUse> use;
	Token location;
	Entity* binding;
	u64 integer_value;
	f64 real_value;
	rt::string text_value;
	rt::buffer<rt::unique<SemanticExpression>> children;
};

fn SemanticExpression::owned_binding(const SemanticExpression& this) -> Entity* {
	if (this.kind() == semantic_kind::name) {
		Entity* entity = this.entity();

		if (entity && (entity->kind() == entity_kind::local || entity->kind() == entity_kind::parameter) && entity->type()->kind() != type_kind::reference) {
			return $entity;
		};

		return nullptr;
	};

	if (this.kind() == semantic_kind::access || this.kind() == semantic_kind::cast && this.category() == value_category::place) {
		return this.item(0)->owned_binding();
	};

	return nullptr;
};

fn SemanticExpression::indirect_storage(const SemanticExpression& this) -> bool {
	switch (this.kind()) {
		case semantic_kind::dereference:
			return true;
		case semantic_kind::index:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::member:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::access:
		case semantic_kind::cast:
			return this.category() == value_category::place && this.item(0)->indirect_storage();
		default:
			return false;
	};
};

fn SemanticExpression::SemanticExpression(SemanticExpression& this, semantic_kind kind, const Type* type, const Token& token) {
	@this.category_kind = $kind;
	@this.value_type = $type;
	@this.location := token;
	@this.value_kind = value_category::consumable;
};

fn SemanticExpression::kind(const SemanticExpression& this) -> semantic_kind {
	return semantic_kind(this.category_kind);
};

fn SemanticExpression::type_use(const SemanticExpression& this) -> const rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn SemanticExpression::set_type_use(SemanticExpression& this, const TypeUse& use) {
	@this.use.bind(use);
};

fn SemanticExpression::type(const SemanticExpression& this) -> const Type* {
	return this.value_type;
};

fn SemanticExpression::token(const SemanticExpression& this) -> Token {
	return Token(this.location);
};

fn SemanticExpression::entity(const SemanticExpression& this) -> Entity* {
	return this.binding;
};

fn SemanticExpression::operation(const SemanticExpression& this) -> token_kind {
	return token_kind(this.location.kind);
};

fn SemanticExpression::category(const SemanticExpression& this) -> value_category {
	return value_category(this.value_kind);
};

fn SemanticExpression::mutable_access(const SemanticExpression& this) -> bool {
	if (this.type()->qualifier() == type_qualifier::immutable) {
		return false;
	};

	if (this.kind() == semantic_kind::access || this.reference_access) {
		return true;
	};

	return this.binding && this.binding->type() && this.binding->type()->kind() == type_kind::reference && this.binding->type()->element()->qualifier() == type_qualifier::mutable;
};

fn SemanticExpression::set_mutable_access(SemanticExpression& this, bool permitted) {
	@this.reference_access = $permitted;
};

fn SemanticExpression::integer(const SemanticExpression& this) -> u64 {
	return this.integer_value;
};

fn SemanticExpression::real(const SemanticExpression& this) -> f64 {
	return this.real_value;
};

fn SemanticExpression::text(const SemanticExpression& this) -> rt::string_view {
	return this.text_value.view();
};

fn SemanticExpression::size(const SemanticExpression& this) -> usize {
	return this.children.size();
};

fn SemanticExpression::item(const SemanticExpression& this, usize index) -> SemanticExpression* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn SemanticExpression::append(SemanticExpression& this, rt::unique<SemanticExpression> child) -> bool {
	if (!child.get()) {
		return false;
	};

	return @this.children.push_back($child);
};

fn SemanticExpression::bind(SemanticExpression& this, Entity* entity, value_category category) {
	@this.binding = $entity;
	@this.value_kind = $category;
};

fn SemanticExpression::set_category(SemanticExpression& this, value_category category) {
	@this.value_kind = $category;
};

fn SemanticExpression::set_integer(SemanticExpression& this, u64 value) {
	@this.integer_value = $value;
};

fn SemanticExpression::set_real(SemanticExpression& this, f64 value) {
	@this.real_value = $value;
};

fn SemanticExpression::set_text(SemanticExpression& this, const rt::string_view& value) -> bool {
	return @this.text_value.append(value);
};

struct AssociatedScope {
	const Type* type;
	Entity* owner;
};

struct SemanticUnit {
	fn associate(SemanticUnit& this, const Type& type, Entity& owner) -> bool;
	fn canonical_use(SemanticUnit& this, const Type& type) -> const TypeUse*;
	fn retype_use(SemanticUnit& this, const TypeUse& source, const Type& type) -> const TypeUse*;
	fn describe_type(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, const Type& type) -> const TypeUse*;
	fn describe_entity(SemanticUnit& this, Analyzer& analyzer, Entity& entity) -> bool;
	fn describe_expression(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, SemanticExpression& expression) -> bool;
	fn leaf_use(SemanticUnit& this, const Type& type) -> const TypeUse*;
	fn indirect_use(SemanticUnit& this, const Type& type, const TypeUse& element) -> const TypeUse*;
	fn function_use(SemanticUnit& this, const Type& type, rt::buffer<ParameterUse> parameters, const TypeUse& result) -> const TypeUse*;
	fn create_scope(SemanticUnit& this, Scope* parent, Entity* owner) -> Scope*;
	fn create_entity(SemanticUnit& this, entity_kind kind, const Token& token, Syntax* syntax, Scope* scope) -> Entity*;

	fn associated_owner(const SemanticUnit& this, const Type& type) -> Entity*;
	fn entities(const SemanticUnit& this) -> const rt::buffer<rt::unique<Entity>>&;
	fn root_scope(const SemanticUnit& this) -> Scope*;

private:
	fn retain_use(SemanticUnit& this, rt::unique<TypeUse> use) -> const TypeUse*;

	fn available_use(const SemanticUnit& this, const SemanticExpression& expression) -> const TypeUse*;

	rt::buffer<AssociatedScope> associated_scopes;
	rt::buffer<rt::unique<TypeUse>> type_uses;
	rt::buffer<rt::unique<FunctionUse>> function_uses;
	Scope* global_scope;
	rt::buffer<rt::unique<Scope>> scopes;
	rt::buffer<rt::unique<Entity>> declarations;
};

fn SemanticUnit::entities(const SemanticUnit& this) -> const rt::buffer<rt::unique<Entity>>& {
	return this.declarations;
};

fn SemanticUnit::root_scope(const SemanticUnit& this) -> Scope* {
	return this.global_scope;
};

fn SemanticUnit::create_scope(SemanticUnit& this, Scope* parent, Entity* owner) -> Scope* {
	var owned = rt::unique<Scope>(new Scope($parent, $owner));
	Scope* result = owned.get();

	if (!result) {
		return nullptr;
	};

	if (!@this.scopes.push_back($owned)) {
		return nullptr;
	};

	if (!this.global_scope) {
		@this.global_scope := result;
	};

	return $result;
};

fn SemanticUnit::create_entity(SemanticUnit& this, entity_kind kind, const Token& token, Syntax* syntax, Scope* scope) -> Entity* {
	var owned = rt::unique<Entity>(new Entity($kind, token, $syntax, scope));
	Entity* result = owned.get();

	if (!result) {
		return nullptr;
	};

	@result->set_access(scope->access());

	if (scope->owner() && scope->owner()->instantiated()) {
		@result->set_instantiated();
	};

	if (!@this.declarations.push_back($owned)) {
		return nullptr;
	};

	if (!@scope->define(Entity*(result))) {
		return nullptr;
	};

	return $result;
};

fn strtod(const char* text, char** end) -> f64;

struct SwitchAnalysis;

struct Analyzer {
	fn Analyzer(Analyzer& this, TypeStore& types, Diagnostics& diagnostics, u32 pointer_bits);

	fn analyze(Analyzer& this, const rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit>;
	fn error(Analyzer& this, Syntax* syntax, const char* message);
	fn type(Analyzer& this, Scope& scope, Syntax& syntax) -> const Type*;
	fn lookup(Analyzer& this, Scope& scope, Syntax& name) -> Entity*;
	fn primitive_scope(Analyzer& this, const Type& type, const Token& location) -> Entity*;
	fn primitive_constants(Analyzer& this, Entity& owner) -> bool;
	fn collect(Analyzer& this, Scope& scope, Syntax& syntax) -> bool;
	fn resolve(Analyzer& this, Entity* entity) -> bool;
	fn integer(Analyzer& this, Syntax& syntax, u64& result) -> bool;
	fn expression(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn function_body(Analyzer& this, Entity* entity) -> bool;
	fn global_initializer(Analyzer& this, Entity& entity) -> bool;
	fn constant_integer(Analyzer& this, const SemanticExpression& expression, u64& result) -> bool;
	fn validate_dispatch_syntax(Analyzer& this, Syntax& syntax, bool class_scope) -> bool;

	fn semantic_unit(const Analyzer& this) -> SemanticUnit*;
	fn type_store(const Analyzer& this) -> TypeStore*;
	fn accessible(const Analyzer& this, const Entity& entity, Scope& scope) -> bool;

private:
	fn resolve_impl(Analyzer& this, Entity* entity) -> bool;
	fn expression_impl(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn names_type(Analyzer& this, Scope& scope, Syntax& syntax) -> bool;
	fn size_query(Analyzer& this, Syntax& syntax, const Type& type) -> rt::unique<SemanticExpression>;
	fn selection(Analyzer& this, Scope& scope, Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn label(Analyzer& this, Scope& scope, Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn prepare_expression(Analyzer& this, SemanticExpression* expression) -> bool;
	fn prepare_lifetime(Analyzer& this, const Type* type) -> bool;
	fn prepare_default(Analyzer& this, const Type* type) -> bool;
	fn prepare_copy(Analyzer& this, const Type* type) -> bool;
	fn prepare_copy_assignment(Analyzer& this, const Type* type) -> bool;
	fn field_initializer(Analyzer& this, Entity* entity) -> bool;
	fn resolve_bases(Analyzer& this, Entity* entity) -> bool;
	fn build_dispatch(Analyzer& this, Entity* entity) -> bool;
	fn supply_special_functions(Analyzer& this, Entity* entity) -> bool;
	fn contextual_argument(Analyzer& this, Scope& scope, Syntax& syntax, const TypeUse& use, const rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression>;
	fn contextual_arguments(Analyzer& this, Scope& scope, Syntax& syntax, SemanticExpression& callable, rt::buffer<rt::unique<SemanticExpression>>& values) -> bool;
	fn supply_special(Analyzer& this, Entity* entity, function_role role, token_kind operation, const Type* source, function_definition definition) -> Entity*;
	fn node(Analyzer& this, semantic_kind kind, const Type* type, Syntax* syntax) -> rt::unique<SemanticExpression>;
	fn unary(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn binary(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn call(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression>;
	fn cast(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn component(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn member_value(Analyzer& this, Scope& scope, Syntax& syntax, rt::unique<SemanticExpression> object, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn construct(Analyzer& this, Scope& scope, Syntax& syntax, const Type* type, Syntax& arguments) -> rt::unique<SemanticExpression>;
	fn construct_values(Analyzer& this, Syntax& syntax, const Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression>;
	fn initialize(Analyzer& this, Syntax& syntax, const Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression>;
	fn select_candidates(Analyzer& this, const rt::buffer<Entity*>& candidates, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity*;
	fn invoke(Analyzer& this, Syntax& syntax, Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn overloaded(Analyzer& this, Scope& scope, Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn select(Analyzer& this, Entity* group, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity*;
	fn convert(Analyzer& this, rt::unique<SemanticExpression> value, const rt::optional_ref<const Type>& expected, Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn argument_rank(Analyzer& this, const SemanticExpression& value, const Type& expected) -> i32;
	fn implicit_constructor(Analyzer& this, const SemanticExpression& value, const Type& expected) -> Entity*;
	fn conversion_function(Analyzer& this, const SemanticExpression& value, const Type& expected, conversion_mode mode) -> Entity*;

	fn compatible(const Analyzer& this, const Type* source, const Type* target) -> bool;
	fn builtin_rank(const Analyzer& this, const SemanticExpression& value, const Type& expected) -> i32;

	TypeStore* types;
	Diagnostics* diagnostics;
	SemanticUnit* unit;
	Entity* function;
	u32 pointer_bits;
	usize loop_depth;
	SwitchAnalysis* active_switch;
	TemplateEngine templates;
};

fn Analyzer::error(Analyzer& this, Syntax* syntax, const char* message) {
	Token token;

	if (syntax) {
		@token = syntax->token();
	};

	@this.diagnostics->error(token, rt::string_view($message));
};

fn Analyzer::node(Analyzer& this, semantic_kind kind, const Type* type, Syntax* syntax) -> rt::unique<SemanticExpression> {
	Token location;

	if (syntax) {
		@location = syntax->token();
	};

	var result = rt::unique<SemanticExpression>(new SemanticExpression($kind, type, location));

	if (!result.get()) {
		@this.error(syntax, "out of memory during semantic analysis\0");
	};

	return $result;
};


fn Analyzer::lookup(Analyzer& this, Scope& scope, Syntax& name) -> Entity* {
	if (name.kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.lookup(@scope, @*name.left());

		if (!owner || !@this.resolve(Entity*(owner))) {
			return nullptr;
		};

		Entity* associated = owner->member_owner();

		if (!associated && owner->denotes_type() && owner->type()) {
			@associated = @this.primitive_scope(*owner->type(), owner->token());
		};

		@owner := associated;

		if (!owner) {
			return nullptr;
		};

		Syntax* member = name.right();

		if (member->kind() == syntax_kind::template_apply) {
			if (!owner->members()->local(member->callable()->token().text())) {
				return nullptr;
			};

			return @this.templates.apply(@this, @*owner->members(), @scope, @*member);
		};

		return owner->find_member(member->token().text());
	};

	if (name.kind() == syntax_kind::template_apply) {
		return @this.templates.apply(@this, @scope, @scope, @name);
	};

	Entity* result = scope.lookup(name.token().text());

	if (result) {
		return result;
	};

	const Type* primitive = this.types->find_primitive(name.token().text());

	if (!primitive) {
		return nullptr;
	};

	return @this.primitive_scope(*primitive, name.token());
};

fn Analyzer::integer(Analyzer& this, Syntax& syntax, u64& result) -> bool {
	if (syntax.kind() != syntax_kind::number) {
		return false;
	};

	var text = syntax.token().text();
	u64 value = 0;
	u64 base = 10;
	usize index = 0;

	if (text.size() > 2 && text.data()[0] == '0') {
		if (text.data()[1] == 'x' || text.data()[1] == 'X') {
			@base = 16;
			@index = 2;
		}
		else if (text.data()[1] == 'b' || text.data()[1] == 'B') {
			@base = 2;
			@index = 2;
		};
	};

	while (index < text.size()) {
		char character := text.data()[index];
		@index = index + 1;

		if (character == '_') {
			continue;
		};

		u64 digit = 0;

		if (character >= '0' && character <= '9') {
			@digit = static_cast<u64>(character - '0');
		}
		else if (character >= 'a' && character <= 'f') {
			@digit = static_cast<u64>(character - 'a') + 10;
		}
		else if (character >= 'A' && character <= 'F') {
			@digit = static_cast<u64>(character - 'A') + 10;
		}
		else {
			return false;
		};

		if (digit >= base || value > (u64::max - digit) / base) {
			return false;
		};

		@value = value * base + digit;
	};

	@result = $value;

	return true;
};

fn Analyzer::type(Analyzer& this, Scope& scope, Syntax& syntax) -> const Type* {
	if (syntax.kind() == syntax_kind::absent) {
		return nullptr;
	};

	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_auto) {
		const Type* element = @this.type(@scope, @*syntax.designated_type());
		const Type* actual = this.templates.qualifier(@scope, @syntax);

		if (!element || !actual) {
			@this.error(&syntax, "automatic qualification requires a deduced parameter binding\0");

			return nullptr;
		};

		return @this.types->qualified(*element, actual->qualifier());
	};

	if (kind == syntax_kind::type_name) {
		return @this.type(@scope, @*syntax.designated_type());
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Entity* entity = @this.lookup(@scope, @syntax);

		if (kind == syntax_kind::name && !entity) {
			const Type* builtin = this.types->find_primitive(syntax.token().text());

			if (builtin) {
				return $builtin;
			};
		};

		if (!entity || !entity->denotes_type()) {
			@this.error(&syntax, "name does not denote a type\0");

			return nullptr;
		};

		if (!this.accessible(*entity, @scope)) {
			@this.error(&syntax, "private or protected type is not accessible\0");

			return nullptr;
		};

		if (!@this.resolve(Entity*(entity))) {
			return nullptr;
		};

		return entity->type();
	};

	if (kind == syntax_kind::type_function) {
		rt::buffer<const Type*> parameters;
		parameter_arity arity = parameter_arity::fixed;
		Syntax* list = syntax.function_type_parameters();
		usize index = 0;
		while (list && index < list->size()) {
			Syntax* parameter = list->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			if (parameter->kind() == syntax_kind::parameter) {
				@parameter = parameter->parameter_type();
			};

			const Type* resolved = @this.type(@scope, @*parameter);

			if (!resolved) {
				return nullptr;
			};

			if (!@parameters.push_back(resolved)) {
				return nullptr;
			};

			@index = index + 1;
		};

		const Type* result = @this.type(@scope, @*syntax.function_type_result());

		if (!result) {
			@result = this.types->find_primitive(rt::string_view("void\0"));
		};

		return @this.types->function($result, $parameters, parameter_arity(arity));
	};

	if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array || kind == syntax_kind::type_const) {
		const Type* element = @this.type(@scope, @*syntax.designated_type());

		if (!element) {
			return nullptr;
		};

		if (kind == syntax_kind::type_const) {
			Syntax* condition = syntax.qualifier_condition();

			if (condition && condition->kind() != syntax_kind::absent) {
				Entity* parameter = nullptr;
				Scope* context = &scope;

				while (context && !parameter) {
					Entity* owner = context->owner();

					if (owner && owner->kind() == entity_kind::function) {
						usize index = 0;
						while (index < owner->parameters().size()) {
							Entity* candidate := owner->parameters().data()[index];

							if (candidate->name() == condition->token().text()) {
								@parameter := candidate;
								break;
							};

							@index = index + 1;
						};
					};

					@context = context->parent();
				};

				if (!parameter) {
					@parameter = @this.lookup(@scope, @*condition);
				};

				if (!parameter || !parameter->type()) {
					@this.error(&syntax, "conditional qualification requires a named parameter\0");

					return nullptr;
				};

				const Type* actual = parameter->type();

				if (actual->kind() == type_kind::reference) {
					@actual = actual->element();
				};

				return @this.types->qualified(*element, actual->qualifier());
			};

			return @this.types->qualified(*element, type_qualifier::immutable);
		};

		if (kind == syntax_kind::type_pointer) {
			return @this.types->pointer(element);
		};

		if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::reference) {
			@this.error(&syntax, "type has no object storage\0");

			return nullptr;
		};

		if (kind == syntax_kind::type_reference) {
			return @this.types->reference(element);
		};

		u64 count = 0;
		var extent = @this.expression(@scope, @*syntax.array_extent(), rt::optional_ref<const Type>());

		if (!extent.get() || !extent.get()->type()->kind().is_integer() || !@this.constant_integer(*extent.get(), @count) || !count) {
			@this.error(&syntax, "array extent shall be a positive integer constant\0");

			return nullptr;
		};

		if (extent.get()->type()->kind() == type_kind::signed_integer && count & (u64(1) << (static_cast<u64>(extent.get()->type()->bits()) - 1))) {
			@this.error(&syntax, "array extent shall be positive\0");

			return nullptr;
		};

		return @this.types->array(element, $count);
	};

	@this.error(&syntax, "unsupported type syntax\0");

	return nullptr;
};

fn Analyzer::collect(Analyzer& this, Scope& scope, Syntax& syntax) -> bool {
	Scope* scope_cursor = &scope;
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::unit || kind == syntax_kind::brace || kind == syntax_kind::list) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!@this.collect(@*scope_cursor, @*syntax.item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return true;
	};

	if (kind == syntax_kind::access_label) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record) {
			@this.error(&syntax, "access label requires class scope\0");
			return false;
		};

		Token token = syntax.token();

		if (token.is(rt::string_view("private\0"))) {
			@scope_cursor->set_access(access_kind::private_access);
		}
		else if (token.is(rt::string_view("protected\0"))) {
			@scope_cursor->set_access(access_kind::protected_access);
		}
		else {
			@scope_cursor->set_access(access_kind::public_access);
		};

		return true;
	};

	if (kind == syntax_kind::ambiguity) {
		Syntax* declaration = nullptr;
		usize index = 0;
		while (index < syntax.size()) {
			Syntax* candidate = syntax.item(index);
			syntax_kind category = candidate->kind();

			if (category == syntax_kind::variable || category == syntax_kind::function || category == syntax_kind::record || category == syntax_kind::enumeration || category == syntax_kind::namespace_body || category == syntax_kind::template_declaration || category == syntax_kind::using_alias) {
				if (declaration) {
					@this.error(&syntax, "declaration has multiple unresolved interpretations\0");
					return false;
				};

				@declaration := candidate;
			};

			@index = index + 1;
		};

		if (!declaration) {
			@this.error(&syntax, "declaration context has no declaration interpretation\0");
			return false;
		};

		return @this.collect(@*scope_cursor, @*declaration);
	};

	if (kind == syntax_kind::template_declaration) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::function && this.templates.qualifier_dependent(@syntax)) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	Syntax* name = nullptr;
	entity_kind category = entity_kind::global;
	Syntax* members = nullptr;

	if (kind == syntax_kind::function) {
		@name = syntax.function_name();
		@category = entity_kind::function;
	}
	else if (kind == syntax_kind::variable) {
		@name = syntax.variable_name();

		if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
			@category = entity_kind::field;
		};
	}
	else if (kind == syntax_kind::record) {
		@name = syntax.record_name();
		@category = entity_kind::record;
		@members = syntax.record_members();
	}
	else if (kind == syntax_kind::enumeration) {
		@name = syntax.enum_name();
		@category = entity_kind::enumeration;
		@members = syntax.enum_members();
	}
	else if (kind == syntax_kind::enumerator) {
		@name = syntax.item(0);
		@category = entity_kind::enumerator;
	}
	else if (kind == syntax_kind::namespace_body) {
		@name = syntax.namespace_name();
		@category = entity_kind::namespace_body;
		@members = syntax.namespace_members();
	}
	else if (kind == syntax_kind::using_alias) {
		@name = syntax.alias_name();
		@category = entity_kind::alias;
	}
	else {
		@this.error(&syntax, "declaration required at module or record scope\0");
		return false;
	};

	if (!name || name->kind() == syntax_kind::absent) {
		@this.error(&syntax, "declaration requires an unqualified name in its owning scope\0");
		return false;
	};

	access_kind declaration_access = scope_cursor->access();

	if (name->kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.lookup(@*scope_cursor, @*name->left());

		if (!owner || !owner->members()) {
			@this.error(&syntax, "qualified declaration owner has no member scope\0");
			return false;
		};

		@scope_cursor = owner->members();
		@name = name->right();
	};

	Entity* existing = scope_cursor->local(name->token().text());

	if (existing && category != entity_kind::function) {
		if (existing->kind() != category) {
			@this.error(&syntax, "conflicting declaration kind\0");
			return false;
		};

		if (category == entity_kind::record) {
			if (members->kind() != syntax_kind::noop) {
				if (existing->declaration()->record_members()->kind() != syntax_kind::noop) {
					@this.error(&syntax, "duplicate record definition\0");
					return false;
				};

				@existing->replace_declaration(&syntax);
			};
		}
		else if (category != entity_kind::namespace_body) {
			@this.error(&syntax, "duplicate declaration\0");
			return false;
		};
	};

	Entity* entity = existing;

	if (!entity || category == entity_kind::function) {
		@entity = @this.unit->create_entity(entity_kind(category), name->token(), &syntax, scope_cursor);

		if (entity) {
			@entity->set_access(access_kind(declaration_access));
		};
	};

	if (!entity) {
		@this.error(&syntax, "out of memory storing declaration\0");
		return false;
	};

	if (members) {
		Scope* nested = entity->members();

		if (!nested) {
			@nested = @this.unit->create_scope(scope_cursor, Entity*(entity));
			@entity->set_members(Scope*(nested));
		};

		if (!nested || !@this.collect(@*nested, @*members)) {
			return false;
		};
	};

	if (entity->kind() == entity_kind::field) {
		@entity->set_index(scope_cursor->owner()->fields().size());

		return @scope_cursor->owner()->add_field(entity);
	};

	if (entity->kind() == entity_kind::function && name->kind() == syntax_kind::unary && name->token().kind == token_kind::op_tilde) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record || !name->operand()->token().same(scope_cursor->owner()->token())) {
			@this.error(&syntax, "destructor shall name its owning class\0");
			return false;
		};

		@scope_cursor->owner()->set_destructor(entity);
	};

	return true;
};

fn Analyzer::Analyzer(Analyzer& this, TypeStore& types, Diagnostics& diagnostics, u32 pointer_bits) {
	@this.types = &types;
	@this.diagnostics = &diagnostics;
	@this.pointer_bits = $pointer_bits;

	if (!@types.initialize_primitives(this.pointer_bits)) {
		Token location;
		@diagnostics.error(location, rt::string_view("cannot initialize primitive types\0"));
	};
};

fn Analyzer::semantic_unit(const Analyzer& this) -> SemanticUnit* {
	return this.unit;
};

fn Analyzer::type_store(const Analyzer& this) -> TypeStore* {
	return this.types;
};

fn Analyzer::accessible(const Analyzer& this, const Entity& entity, Scope& scope) -> bool {
	Scope* scope_cursor = &scope;

	if (entity.access() == access_kind::public_access) {
		return true;
	};

	while (scope_cursor) {
		if (scope_cursor->owner() == entity.scope()->owner()) {
			return true;
		};

		if (entity.access() == access_kind::protected_access && scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record && entity.scope()->owner() && scope_cursor->owner()->type() && entity.scope()->owner()->type() && scope_cursor->owner()->type()->derived_from(*entity.scope()->owner()->type())) {
			return true;
		};

		@scope_cursor = scope_cursor->parent();
	};

	return false;
};

fn SemanticUnit::associated_owner(const SemanticUnit& this, const Type& type) -> Entity* {
	usize index = 0;
	while (index < this.associated_scopes.size()) {
		const AssociatedScope& association = this.associated_scopes.data()[index];

		if (association.type == &type) {
			return association.owner;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn SemanticUnit::associate(SemanticUnit& this, const Type& type, Entity& owner) -> bool {
	AssociatedScope association;
	@association.type = &type;
	@association.owner = &owner;

	return @this.associated_scopes.push_back($association);
};

fn Analyzer::primitive_scope(Analyzer& this, const Type& type, const Token& location) -> Entity* {
	if (!type.kind().is_numeric() && type.kind() != type_kind::void_type && type.kind() != type_kind::null_type) {
		return nullptr;
	};

	const Type* canonical = @this.types->primitive(type_kind(type.kind()), type.bits());
	if (!canonical) {
		return nullptr;
	};

	Entity* found = this.unit->associated_owner(*canonical);

	if (found) {
		return found;
	};

	Scope* declarations = @this.unit->create_scope(this.unit->root_scope(), nullptr);

	if (!declarations) {
		return nullptr;
	};

	Entity* owner = @this.unit->create_entity(entity_kind::primitive_type, location, nullptr, declarations);

	if (!owner) {
		return nullptr;
	};

	@owner->set_type(canonical);
	@owner->set_origin(declaration_origin::compiler_supplied);
	@owner->set_state(entity_state::ready);
	Scope* members = @this.unit->create_scope(declarations, Entity*(owner));

	if (!members) {
		return nullptr;
	};

	@owner->set_members(Scope*(members));

	if (!@this.unit->associate(*canonical, @*owner) || !@this.primitive_constants(@*owner)) {
		return nullptr;
	};

	return owner;
};

fn Analyzer::primitive_constants(Analyzer& this, Entity& owner) -> bool {
	const Type* type = owner.type();

	if (!type->kind().is_numeric()) {
		return true;
	};

	const Type* value_type = @this.types->qualified(*type, type_qualifier::immutable);
	if (!value_type) {
		return false;
	};

	semantic_kind kind = semantic_kind::literal_integer;

	if (type->kind() == type_kind::floating_point) {
		@kind = semantic_kind::literal_real;
	};

	var value = rt::unique<SemanticExpression>(new SemanticExpression($kind, value_type, owner.token()));

	if (!value.get()) {
		return false;
	};

	if (type->kind() == type_kind::floating_point) {
		f64 maximum = 0.0;

		if (type->bits() == 32) {
			u32 representation = 2139095039;
			f32 decoded := *reinterpret_cast<const f32*>(&representation);
		@maximum = static_cast<f64>($decoded);
		}
		else {
			u64 representation = 9218868437227405311;
			@maximum := *reinterpret_cast<const f64*>(&representation);
		};

		@value.get()->set_real($maximum);
	}
	else {
		u64 maximum = u64::max >> (64 - static_cast<u64>(type->bits()));

		if (type->kind() == type_kind::signed_integer || type->kind() == type_kind::character) {
			@maximum = maximum >> 1;
		};

		@value.get()->set_integer($maximum);
	};

	Entity* constant = @this.unit->create_entity(entity_kind::constant, owner.token(), nullptr, owner.members());

	if (!constant || !@constant->set_name(rt::string_view("max\0"))) {
		return false;
	};

	@constant->set_origin(declaration_origin::compiler_supplied);
	@constant->set_type(value_type);
	@constant->set_body($value);
	@constant->set_state(entity_state::ready);
	@constant->set_body_state(entity_state::ready);

	return true;
};

struct FunctionAnalysisScope {
	fn FunctionAnalysisScope(FunctionAnalysisScope& this, Entity*& function, usize& loop_depth, SwitchAnalysis*& selection, const rt::optional_ref<Entity>& current);
	fn ~FunctionAnalysisScope(FunctionAnalysisScope& this);

private:
	Entity** function_slot;
	usize* loop_slot;
	SwitchAnalysis** switch_slot;
	Entity* previous_function;
	usize previous_loop;
	SwitchAnalysis* previous_switch;
};

fn Analyzer::constant_integer(Analyzer& this, const SemanticExpression& expression, u64& result) -> bool {
	ConstantEvaluator evaluator;

	return @evaluator.integer(@this, expression, @result);
};

fn Analyzer::prepare_lifetime(Analyzer& this, const Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return @this.prepare_lifetime(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	Entity* owner = type->entity();

	if (!@this.resolve(Entity*(owner))) {
		return false;
	};

	if (owner->virtual_functions().size()) {
		@owner->require_dispatch();
		usize slot = 0;

		while (slot < owner->virtual_functions().size()) {
			if (!@this.function_body(owner->virtual_functions().data()[slot])) {
				return false;
			};

			@slot = slot + 1;
		};
	};

	Entity* destructor = owner->destructor();

	if (destructor && !@this.function_body(Entity*(destructor))) {
		return false;
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_lifetime(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!@this.prepare_lifetime(owner->fields().data()[index]->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_default(Analyzer& this, const Type* type) -> bool {
	if (!@this.prepare_lifetime(type)) {
		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_default(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	Entity* owner = type->entity();
	Entity* constructor = nullptr;
	Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		@constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (!constructor || constructor->definition() == function_definition::deleted) {
			@this.error(owner->declaration(), "default initialization has no available constructor\0");
			return false;
		};
	};

	if (constructor) {
		return @this.function_body(constructor);
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_default(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		Entity* field = owner->fields().data()[index];

		if (!@this.field_initializer(Entity*(field))) {
			return false;
		};

		if (field->body()) {
			if (!@this.prepare_expression(field->body())) {
				return false;
			};
		}
		else if (!@this.prepare_default(field->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_expression(Analyzer& this, SemanticExpression* expression) -> bool {
	if (!expression) {
		return true;
	};

	Entity* selected = expression->entity();

	if (selected && selected->kind() == entity_kind::function && !@this.function_body(Entity*(selected))) {
		return false;
	};

	if ((expression->kind() == semantic_kind::variable || expression->kind() == semantic_kind::name) && selected && !@this.prepare_lifetime(selected->type())) {
		return false;
	};

	if (expression->kind() == semantic_kind::construction) {
		if (!@this.prepare_lifetime(expression->type())) {
			return false;
		};

		if (!selected && expression->type()->kind() == type_kind::named && expression->type()->entity()->layout() != record_layout::overlapping) {
			const rt::buffer<Entity*>& fields = expression->type()->entity()->fields();
			usize field = expression->item(0)->size();

			while (field < fields.size()) {
				Entity* member = fields.data()[field];

				if (!@this.field_initializer(Entity*(member))) {
					return false;
				};

				if (!member->body() && !@this.prepare_default(member->type())) {
					return false;
				};

				if (member->body() && !@this.prepare_expression(member->body())) {
					return false;
				};

				@field = field + 1;
			};
		};
	};

	usize index = 0;
	while (index < expression->size()) {
		if (!@this.prepare_expression(expression->item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::global_initializer(Analyzer& this, Entity& entity) -> bool {
	if (!@this.resolve(&entity)) {
		return false;
	};

	if (entity.body_state() == entity_state::ready) {
		return true;
	};

	if (entity.body_state() == entity_state::resolving) {
		@this.error(entity.declaration(), "global initializer has a circular dependency\0");
		return false;
	};

	Syntax* initializer = entity.declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		@entity.set_body_state(entity_state::ready);
		return true;
	};

	@entity.set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (!(entity.type()->kind() == type_kind::named && entity.type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity.type());
	};

	var value = @this.expression(@*entity.scope(), @*initializer, expected);

	if (!value.get()) {
		return false;
	};

	@value = @this.initialize(@*initializer, entity.type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return false;
	};

	@entity.set_body($value);
	@entity.set_body_state(entity_state::ready);

	return @this.prepare_expression(entity.body());
};

fn Analyzer::field_initializer(Analyzer& this, Entity* entity) -> bool {
	if (entity->body_state() == entity_state::ready) {
		return true;
	};

	if (entity->body_state() == entity_state::resolving) {
		@this.error(entity->declaration(), "member initializer has a circular dependency\0");
		return false;
	};

	Syntax* initializer = entity->declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		@entity->set_body_state(entity_state::ready);

		return true;
	};

	if (entity->scope()->owner()->layout() == record_layout::overlapping) {
		@this.error(initializer, "union default member initializers are not implemented\0");
		return false;
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (entity->type()->kind() != type_kind::reference && !(entity->type()->kind() == type_kind::named && entity->type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity->type());
	};

	var value = @this.expression(@*entity->scope(), @*initializer, expected);

	if (!value.get()) {
		return false;
	};

	if (entity->type()->kind() == type_kind::reference && value.get()->category() == value_category::consumable) {
		@this.error(initializer, "reference member initializer requires a live place\0");
		return false;
	};

	@value = @this.initialize(@*initializer, entity->type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return false;
	};

	@entity->set_body($value);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::prepare_copy(Analyzer& this, const Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return @this.prepare_copy(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	Entity* owner = type->entity();
	Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		const Type* source_type = @this.types->qualified(*type, type_qualifier::immutable);
		var source = @this.node(semantic_kind::name, source_type, owner->declaration());

		if (!source.get()) {
			return false;
		};

		@source.get()->set_category(value_category::place);

		if (!@arguments.push_back($source)) {
			return false;
		};

		Entity* constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (this.diagnostics->failed()) {
			return false;
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.error(owner->declaration(), "member copy selects a deleted or unavailable constructor\0");
			return false;
		};

		if (constructor) {
			return @this.function_body(constructor);
		};
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_copy(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!@this.prepare_copy(owner->fields().data()[index]->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_copy_assignment(Analyzer& this, const Type* type) -> bool {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		@this.error(nullptr, "generated assignment cannot replace a const or reference component\0");

		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_copy_assignment(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	Entity* owner = type->entity();
	rt::buffer<Entity*> candidates;
	usize index = 0;

	while (index < owner->members()->bindings().size()) {
		Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return false;
		};

		if (candidate->role() == function_role::assignment && candidate->operator_kind() == token_kind::op_assign && !@candidates.push_back(Entity*(candidate))) {
			return false;
		};
	};

	const Type* immutable = @this.types->qualified(*type, type_qualifier::immutable);
	Scope* bindings = @this.unit->create_scope(owner->members(), nullptr);

	if (!bindings) {
		return false;
	};

	Entity* destination_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);
	Entity* source_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);

	if (!destination_binding || !source_binding) {
		return false;
	};

	if (!@destination_binding->set_name(rt::string_view("destination\0")) || !@source_binding->set_name(rt::string_view("source\0"))) {
		return false;
	};

	@destination_binding->set_type(@this.types->reference(type));
	@source_binding->set_type(@this.types->reference(immutable));
	@destination_binding->set_state(entity_state::ready);
	@source_binding->set_state(entity_state::ready);
	var destination = @this.node(semantic_kind::name, type, owner->declaration());
	var source = @this.node(semantic_kind::name, immutable, owner->declaration());

	if (!destination.get() || !source.get()) {
		return false;
	};

	@destination.get()->bind(Entity*(destination_binding), value_category::place);
	@destination.get()->set_mutable_access(true);
	@source.get()->bind(Entity*(source_binding), value_category::place);
	rt::buffer<rt::unique<SemanticExpression>> arguments;

	if (!@arguments.push_back($destination)) {
		return false;
	};

	if (!@arguments.push_back($source)) {
		return false;
	};

	Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @*owner->declaration());

	if (!selected || selected->definition() == function_definition::deleted) {
		@this.error(owner->declaration(), "generated member assignment selects a deleted or unavailable function\0");

		return false;
	};

	var callable = @this.node(semantic_kind::name, selected->type(), owner->declaration());

	if (!callable.get()) {
		return false;
	};

	@callable.get()->bind(Entity*(selected), value_category::place);
	var operation = @this.invoke(@*owner->declaration(), selected, $callable, $arguments, rt::optional_ref<const Type>());

	if (!operation.get() || !@this.prepare_expression(operation.get())) {
		return false;
	};

	if (!@this.prepare_lifetime(selected->type()->signature().result())) {
		return false;
	};

	var plan = rt::unique<CopyAssignmentPlan>(new CopyAssignmentPlan(@*destination_binding, @*source_binding, $operation));

	if (!plan.get()) {
		return false;
	};

	@owner->set_copy_assignment($plan);

	return true;
};

fn FunctionAnalysisScope::FunctionAnalysisScope(FunctionAnalysisScope& this, Entity*& function, usize& loop_depth, SwitchAnalysis*& selection, const rt::optional_ref<Entity>& current) {
	@this.function_slot = &function;
	@this.loop_slot = &loop_depth;
	@this.switch_slot = &selection;
	@this.previous_function := function;
	@this.previous_loop := loop_depth;
	@this.previous_switch := selection;
	@function = current.get();
	@loop_depth = 0;
	@selection = nullptr;
};

fn FunctionAnalysisScope::~FunctionAnalysisScope(FunctionAnalysisScope& this) {
	@*this.function_slot := this.previous_function;
	@*this.loop_slot := this.previous_loop;
	@*this.switch_slot := this.previous_switch;
};

struct CopyAssignmentPlan {
	fn CopyAssignmentPlan(CopyAssignmentPlan& this, Entity& destination, Entity& source, rt::unique<SemanticExpression> expression);
	fn destination(const CopyAssignmentPlan& this) -> Entity&;
	fn source(const CopyAssignmentPlan& this) -> Entity&;
	fn expression(const CopyAssignmentPlan& this) -> SemanticExpression&;

private:
	Entity* destination_binding;
	Entity* source_binding;
	rt::unique<SemanticExpression> operation;
};

fn CopyAssignmentPlan::CopyAssignmentPlan(CopyAssignmentPlan& this, Entity& destination, Entity& source, rt::unique<SemanticExpression> expression) {
	@this.destination_binding = &destination;
	@this.source_binding = &source;
	@this.operation = $expression;
};

fn CopyAssignmentPlan::destination(const CopyAssignmentPlan& this) -> Entity& {
	return @*this.destination_binding;
};

fn CopyAssignmentPlan::source(const CopyAssignmentPlan& this) -> Entity& {
	return @*this.source_binding;
};

fn CopyAssignmentPlan::expression(const CopyAssignmentPlan& this) -> SemanticExpression& {
	return @*this.operation.get();
};

fn Entity::copy_assignment(const Entity& this) -> CopyAssignmentPlan* {
	return this.copy_assigner.get();
};

fn Entity::set_copy_assignment(Entity& this, rt::unique<CopyAssignmentPlan> plan) {
	@this.copy_assigner = $plan;
};

fn Analyzer::resolve_impl(Analyzer& this, Entity* entity) -> bool {
	if (entity->kind() == entity_kind::template_pattern) {
		return true;
	};

	if (entity->state() == entity_state::ready) {
		return true;
	};

	if (entity->state() == entity_state::resolving) {
		if (entity->kind() == entity_kind::record && entity->type()) {
			return true;
		};

		@this.error(entity->declaration(), "cyclic entity definition\0");
		return false;
	};

	@entity->set_state(entity_state::resolving);
	Syntax* source = entity->declaration();
	Scope* scope = entity->resolution_scope();
	entity_kind kind = entity->kind();

	if (kind == entity_kind::record) {
		@entity->set_type(@this.types->named(type_kind::named, Entity*(entity)));

		if (!@this.resolve_bases(Entity*(entity))) {
			return false;
		};

		usize index = 0;
		while (index < entity->fields().size()) {
			if (!@this.resolve(entity->fields().data()[index])) {
				return false;
			};

			@index = index + 1;
		};

		if (!@this.build_dispatch(Entity*(entity))) {
			return false;
		};

		if (!@this.supply_special_functions(Entity*(entity))) {
			return false;
		};
	}
	else if (kind == entity_kind::enumeration) {
		@entity->set_type(@this.types->named(type_kind::named, Entity*(entity)));
		const Type* underlying = @this.type(@*scope, @*source->enum_underlying());

		if (!underlying) {
			@underlying = this.types->find_primitive(rt::string_view("i32\0"));
		};

		if (!underlying->kind().is_integer()) {
			@this.error(source, "enum underlying type shall be an integer type\0");
			return false;
		};

		@entity->set_underlying(underlying);
	}
	else if (kind == entity_kind::namespace_body) {
		@entity->set_state(entity_state::ready);

		return true;
	}
	else if (kind == entity_kind::alias) {
		@entity->set_type(@this.type(@*scope, @*source->alias_type()));
	}
	else if (kind == entity_kind::enumerator) {
		Entity* owner = scope->owner();

		if (!@this.resolve(Entity*(owner))) {
			return false;
		};

		@entity->set_type(owner->type());
		u64 value = 0;
		const rt::buffer<Entity*>& members = scope->bindings();
		usize index = 0;
		while (index < members.size() && members.data()[index] != entity) {
			Entity* previous := members.data()[index];

			if (previous->kind() == entity_kind::enumerator) {
				if (!@this.resolve(Entity*(previous))) {
					return false;
				};

				@value = previous->integer() + 1;
			};

			@index = index + 1;
		};

		if (source->item(1)->kind() != syntax_kind::absent) {
			var initializer = @this.expression(@*scope, @*source->item(1), rt::optional_ref<const Type>(*owner->underlying()));

			if (!initializer.get() || !@this.constant_integer(*initializer.get(), @value)) {
				@this.error(source, "enumerator value requires an integer constant\0");
				return false;
			};
		};

		@entity->set_integer($value);
	}
	else if (kind == entity_kind::function) {
		Scope* local = @this.unit->create_scope(scope, Entity*(entity));

		if (!local) {
			@this.error(source, "out of memory storing function scope\0");
			return false;
		};

		@entity->set_members(Scope*(local));
		Scope* signature = @this.unit->create_scope(scope, Entity*(entity));

		if (!signature) {
			@this.error(source, "out of memory storing function signature scope\0");

			return false;
		};

		rt::buffer<const Type*> signature_parameters;
		parameter_arity arity = parameter_arity::fixed;
		Syntax* parameters = source->function_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			Syntax* parameter = parameters->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			const Type* resolved = @this.type(@*signature, @*parameter->parameter_type());

			if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type) {
				@this.error(parameter, "parameter requires an object or reference type\0");
				return false;
			};

			Syntax* name = parameter->parameter_name();
			Token token = parameter->token();

			if (name->kind() != syntax_kind::absent) {
				@token = name->token();

				if (local->local(token.text())) {
					@this.error(parameter, "duplicate parameter name\0");
					return false;
				};
			};

			Entity* argument = @this.unit->create_entity(entity_kind::parameter, token, parameter, local);

			if (!argument) {
				return false;
			};

			@argument->set_resolution_scope(Scope*(signature));
			@argument->set_type(resolved);
			@argument->set_index(usize(index));
			@argument->set_state(entity_state::ready);

			if (!@entity->add_parameter($argument)) {
				return false;
			};

			if (!@signature_parameters.push_back(resolved)) {
				return false;
			};

			@index = index + 1;
		};

		Syntax* declarator = source->function_name();

		while (declarator->kind() == syntax_kind::qualified_name) {
			@declarator = declarator->right();
		};

		const Type* result = @this.type(@*signature, @*source->function_result());

		if (declarator->kind() == syntax_kind::conversion_name) {
			const Type* target = @this.type(@*scope, @*declarator->operator_target());

			if (result && result != target) {
				@this.error(source, "conversion function result does not match its named target\0");
				return false;
			};

			@result := target;
			@entity->set_role(function_role::conversion);
		}
		else if (declarator->kind() == syntax_kind::operator_name) {
			@entity->set_operator_kind(token_kind(declarator->operator_token().kind));

			if (declarator->operator_token().kind == token_kind::op_assign || declarator->operator_token().kind == token_kind::op_copy) {
				@entity->set_role(function_role::assignment);
			};
		};

		if (!result) {
			@result = this.types->find_primitive(rt::string_view("void\0"));
		};

		@entity->set_type(@this.types->function(result, $signature_parameters, parameter_arity(arity)));
		Entity* owner = entity->scope()->owner();
		bool destructor = declarator->kind() == syntax_kind::unary && declarator->token().kind == token_kind::op_tilde;
		bool constructor = owner && owner->kind() == entity_kind::record && entity->token().same(owner->token());

		if (destructor) {
			@entity->set_role(function_role::destructor);
		}
		else if (constructor) {
			@entity->set_role(function_role::constructor);
		};

		if (destructor || constructor) {
			if (!owner || !entity->parameters().size() || result->kind() != type_kind::void_type || source->function_result()->kind() != syntax_kind::absent) {
				@this.error(source, "constructor or destructor requires an explicit owning-type receiver and no result annotation\0");
				return false;
			};

			if (constructor) {
				if (entity->parameters().size() == 1) {
					@owner->set_default_constructor(entity);
				}
				else if (entity->parameters().size() == 2) {
					const Type* source_type = entity->parameters().data()[1]->type();

					if (source_type == owner->type()) {
						@owner->set_move_constructor(entity);
					}
					else if (source_type->kind() == type_kind::reference && source_type->element()->same_shape(*owner->type()) && source_type->element()->qualifier() == type_qualifier::immutable) {
						@owner->set_copy_constructor(entity);
					};
				};
			};

			const Type* receiver = entity->parameters().data()[0]->type();

			if (receiver->kind() != type_kind::reference || receiver->element()->kind() != type_kind::named || receiver->element()->entity() != owner || receiver->element()->qualifier() != type_qualifier::mutable || !entity->parameters().data()[0]->token().is(rt::string_view("this\0")) || destructor && entity->parameters().size() != 1) {
				@this.error(source, "constructor or destructor has an invalid owning-type receiver\0");
				return false;
			};
		};

		if (source->function_body()->kind() != syntax_kind::noop) {
			@entity->set_definition(function_definition::user_defined);
		};

		usize attribute = 0;

		while (attribute < source->function_attributes()->size()) {
			Token token = source->function_attributes()->item(attribute)->token();

			if (token.is(rt::string_view("default\0")) || token.is(rt::string_view("delete\0"))) {
				if (entity->definition() != function_definition::declaration) {
					@this.error(source, "function has conflicting definitions\0");
					return false;
				};

				if (token.is(rt::string_view("default\0"))) {
					@entity->set_definition(function_definition::defaulted);
				}
				else {
					@entity->set_definition(function_definition::deleted);
				};
			}
			else if (token.is(rt::string_view("implicit\0"))) {
				if (!constructor && entity->role() != function_role::conversion) {
					@this.error(source, "implicit requires a constructor or conversion function\0");
					return false;
				};

				@entity->set_conversion(conversion_mode::implicit_allowed);
			}
			else if (token.is(rt::string_view("virtual\0"))) {
				@entity->set_dispatch(function_dispatch::virtual_function);
			}
			else if (token.is(rt::string_view("override\0"))) {
				@entity->set_dispatch(function_dispatch::override_function);
			}
			else if (token.is(rt::string_view("final\0"))) {
				@entity->set_dispatch(function_dispatch::final_function);
			}
			else {
				@this.error(source, "unknown function attribute\0");
				return false;
			};

			@attribute = attribute + 1;
		};

		if (entity->role() == function_role::conversion) {
			if (entity->parameters().size() != 1 || arity != parameter_arity::fixed || result->kind() == type_kind::reference) {
				@this.error(source, "conversion requires one reference parameter and a result matching its target\0");
				return false;
			};

			Entity* receiver = entity->parameters().data()[0];
			if (receiver->type()->kind() != type_kind::reference) {
				@this.error(source, "conversion requires one reference parameter and a result matching its target\0");
				return false;
			};

			if (entity->conversion() == conversion_mode::implicit_allowed && receiver->type()->element()->same_shape(*result) && receiver->type()->element()->qualifier() != type_qualifier::immutable) {
				@this.error(source, "self conversion requires a const reference receiver\0");
				return false;
			};
		};

		if (entity->dispatch() != function_dispatch::ordinary) {
			if (!owner || owner->kind() != entity_kind::record || entity->role() != function_role::ordinary || !entity->parameters().size() || !entity->parameters().data()[0]->token().is(rt::string_view("this\0")) || entity->parameters().data()[0]->type()->kind() != type_kind::reference || !entity->parameters().data()[0]->type()->element()->same_shape(*owner->type())) {
				@this.error(source, "virtual operation requires an explicit ordinary class receiver named this\0");
				return false;
			};

			if (arity == parameter_arity::variadic) {
				@this.error(source, "variadic virtual operations are not implemented\0");
				return false;
			};
		};

		if (entity->definition() == function_definition::defaulted && entity->role() != function_role::constructor && entity->role() != function_role::destructor && entity->role() != function_role::assignment) {
			@this.error(source, "this function has no compiler-generated implementation\0");
			return false;
		};

		const rt::buffer<Entity*>& names = entity->scope()->bindings();
		@index = 0;

		while (index < names.size() && names.data()[index] != entity) {
			Entity* previous = names.data()[index]->canonical();

			if (previous->kind() == entity_kind::function && previous->name() == entity->name() && previous->type() == entity->type()) {
				@previous->merge_dispatch(*entity);
				bool defined = source->function_body()->kind() != syntax_kind::noop;

				if (defined && previous->declaration()->function_body()->kind() != syntax_kind::noop) {
					@this.error(source, "duplicate function definition\0");
					return false;
				};

				if (defined && !@previous->adopt_definition(*entity)) {
					return false;
				};

				@entity->merge_into($previous);
				break;
			};

			@index = index + 1;
		};
	}
	else if (kind == entity_kind::global || kind == entity_kind::field) {
		const Type* resolved = @this.type(@*scope, @*source->variable_type());

		if (!resolved) {
			Syntax* initial = source->variable_initializer();

			if (initial->kind() == syntax_kind::unary) {
				@initial = initial->operand();
			};

			var value = @this.expression(@*scope, @*initial, rt::optional_ref<const Type>());

			if (!value.get()) {
				return false;
			};

			@resolved = value.get()->type();

			if (value.get()->type_use().has_value()) {
				@entity->set_type_use(value.get()->type_use().value());
			};
		};

		if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type || resolved->kind() == type_kind::function) {
			@this.error(source, "variable requires object storage or a reference\0");
			return false;
		};

		@entity->set_type(resolved);
		const Type* element = resolved;

		while (element->kind() == type_kind::array) {
			@element = element->element();
		};

		if (element->kind() == type_kind::named && element->entity()->kind() == entity_kind::record) {
			if (element->entity()->state() == entity_state::resolving || element->entity()->declaration()->record_members()->kind() == syntax_kind::noop) {
				@this.error(source, "object requires a complete nonrecursive storage type\0");
				return false;
			};
		};
	};

	if (!entity->type()) {
		@this.error(source, "type could not be resolved\0");
		return false;
	};

	@entity->set_state(entity_state::ready);

	return true;
};

fn Analyzer::function_body(Analyzer& this, Entity* entity) -> bool {
	if (!@this.resolve(entity)) {
		return false;
	};

	@entity = entity->canonical();

	if (entity->body() || entity->body_state() == entity_state::ready) {
		return true;
	};

	if (entity->definition() == function_definition::deleted) {
		@this.error(entity->declaration(), "selected function is deleted\0");
		return false;
	};

	if (entity->definition() != function_definition::defaulted && (!entity->declaration() || entity->declaration()->function_body()->kind() == syntax_kind::noop)) {
		@entity->set_body_state(entity_state::ready);

		return true;
	};

	if (entity->body_state() == entity_state::resolving) {
		return true;
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>(@*entity));

	if (entity->role() == function_role::constructor && entity->scope()->owner()->layout() != record_layout::overlapping && (entity->definition() == function_definition::user_defined || entity->parameters().size() == 1)) {
		Entity* owner = entity->scope()->owner();
		usize index = 0;
		while (index < owner->bases().size()) {
			if (!@this.prepare_default(owner->bases().data()[index])) {
				return false;
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < owner->fields().size()) {
			Entity* field = owner->fields().data()[index];

			if (!@this.field_initializer(Entity*(field))) {
				return false;
			};

			if (!field->body() && !@this.prepare_default(field->type())) {
				return false;
			};

			if (field->body() && !@this.prepare_expression(field->body())) {
				return false;
			};

			@index = index + 1;
		};
	};

	if (entity->definition() == function_definition::defaulted) {
		const Type* receiver = entity->parameters().data()[0]->type()->element();

		if (!@this.prepare_lifetime(receiver)) {
			return false;
		};

		Entity* owner = receiver->entity();

		if (entity->role() == function_role::constructor && entity->parameters().size() == 2 && entity->parameters().data()[1]->type()->kind() == type_kind::reference && owner->layout() != record_layout::overlapping) {
			usize index = 0;
			while (index < owner->bases().size()) {
				if (!@this.prepare_copy(owner->bases().data()[index])) {
					return false;
				};

				@index = index + 1;
			};

			@index = 0;

			while (index < owner->fields().size()) {
				if (!@this.prepare_copy(owner->fields().data()[index]->type())) {
					return false;
				};

				@index = index + 1;
			};
		};

		if (entity->role() == function_role::assignment) {
			if (entity->parameters().data()[1]->type()->kind() == type_kind::reference) {
				usize index = 0;

				while (index < owner->bases().size()) {
					if (!@this.prepare_copy_assignment(owner->bases().data()[index])) {
						return false;
					};

					@index = index + 1;
				};

				@index = 0;

				while (owner->layout() != record_layout::overlapping && index < owner->fields().size()) {
					if (!@this.prepare_copy_assignment(owner->fields().data()[index]->type())) {
						return false;
					};

					@index = index + 1;
				};
			}
			else if (owner->move_constructor() && !@this.function_body(owner->move_constructor())) {
				return false;
			};
		};

		@entity->set_body_state(entity_state::ready);

		return true;
	};

	var body = @this.expression(@*entity->members(), @*entity->declaration()->function_body(), rt::optional_ref<const Type>());

	if (!body.get()) {
		return false;
	};

	@entity->set_body($body);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::analyze(Analyzer& this, const rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit> {
	@this.templates.clear();
	var owned = rt::unique<SemanticUnit>::make();
	@this.unit = owned.get();

	if (!this.unit) {
		@this.error(nullptr, "out of memory creating semantic unit\0");

		return rt::unique<SemanticUnit>();
	};

	Scope* root = @this.unit->create_scope(nullptr, nullptr);

	if (!root) {
		return rt::unique<SemanticUnit>();
	};

	usize index = 0;
	while (index < syntax.size() && !this.diagnostics->failed()) {
		if (!@this.collect(@*root, @*(syntax.data()[index].get()))) {
			return rt::unique<SemanticUnit>();
		};

		@index = index + 1;
	};

	@index = 0;
	var validator = TemplateDeclarationValidator();

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		Entity* pattern = this.unit->entities().data()[index].get();
		if (pattern->kind() == entity_kind::template_pattern && !@validator.validate(@this, @*pattern)) {
			return rt::unique<SemanticUnit>();
		};
		@index = index + 1;
	};

	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		if (!@this.resolve(this.unit->entities().data()[index].get())) {
			return rt::unique<SemanticUnit>();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		Entity* entity = this.unit->entities().data()[index].get();

		if (!@this.resolve(Entity*(entity))) {
			return rt::unique<SemanticUnit>();
		};

		if (entity->kind() == entity_kind::function && !entity->instantiated() && entity->origin() != declaration_origin::compiler_supplied && entity->definition() != function_definition::deleted && !@this.function_body(Entity*(entity))) {
			return rt::unique<SemanticUnit>();
		};

		if (entity->kind() == entity_kind::field && !entity->instantiated() && !@this.field_initializer(Entity*(entity))) {
			return rt::unique<SemanticUnit>();
		};

		if (entity->kind() == entity_kind::global && !@this.global_initializer(@*entity)) {
			return rt::unique<SemanticUnit>();
		};

		@index = index + 1;
	};

	@this.unit = nullptr;

	if (this.diagnostics->failed()) {
		return rt::unique<SemanticUnit>();
	};

	return $owned;
};

fn Analyzer::names_type(Analyzer& this, Scope& scope, Syntax& syntax) -> bool {
	switch (syntax.kind()) {
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_array:
		case syntax_kind::type_const:
			return @this.names_type(@scope, @*syntax.designated_type());
		case syntax_kind::type_function:
			return true;
		case syntax_kind::type_name: {
			Syntax* name = syntax.designated_type();
			Entity* entity = @this.lookup(@scope, @*name);

			if (entity) {
				return entity->denotes_type();
			};

			return this.types->find_primitive(name->token().text()) != nullptr;
		};
	};

	return false;
};

fn Analyzer::size_query(Analyzer& this, Syntax& syntax, const Type& type) -> rt::unique<SemanticExpression> {
	if (!type.has_layout()) {
		@this.error(&syntax, "sizeof requires a complete object storage type\0");

		return rt::unique<SemanticExpression>();
	};

	var operand = @this.node(semantic_kind::noop, &type, &syntax);
	var result = @this.node(semantic_kind::sizeof_type, this.types->find_primitive(rt::string_view("usize\0")), &syntax);

	if (!operand.get() || !result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($operand)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::resolve_bases(Analyzer& this, Entity* entity) -> bool {
	Syntax* declaration = entity->declaration();
	Syntax* bases = declaration->record_bases();

	if (!bases->size()) {
		return true;
	};

	if (entity->layout() == record_layout::overlapping) {
		@this.error(declaration, "union cannot contain a base subobject\0");
		return false;
	};

	if (bases->size() != 1) {
		@this.error(declaration, "multiple base analysis is not implemented\0");
		return false;
	};

	const Type* base = @this.type(@*entity->resolution_scope(), @*bases->item(0));

	if (!base || base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record || base->qualifier() != type_qualifier::mutable || base->entity()->layout() != record_layout::sequential) {
		@this.error(bases->item(0), "base requires an unqualified nonunion record type\0");
		return false;
	};

	Entity* owner = base->entity();

	if (owner->state() == entity_state::resolving) {
		@this.error(bases->item(0), "base relation contains a cycle\0");
		return false;
	};

	if (!@this.resolve(owner)) {
		return false;
	};

	if (owner->declaration()->record_members()->kind() == syntax_kind::noop) {
		@this.error(bases->item(0), "base requires a complete record definition\0");
		return false;
	};

	if (!@entity->add_base(base)) {
		@this.error(declaration, "cannot retain base subobject metadata\0");
		return false;
	};

	return true;
};

fn Analyzer::validate_dispatch_syntax(Analyzer& this, Syntax& syntax, bool class_scope) -> bool {
	if (syntax.kind() == syntax_kind::template_declaration) {
		Syntax* declaration = syntax.template_declaration();

		if (declaration->kind() == syntax_kind::function) {
			usize index = 0;
			while (index < declaration->function_attributes()->size()) {
				Token token = declaration->function_attributes()->item(index)->token();

				if (token.is(rt::string_view("virtual\0")) || token.is(rt::string_view("override\0")) || token.is(rt::string_view("final\0"))) {
					@this.error(declaration, "virtual function templates are not implemented\0");
					return false;
				};

				@index = index + 1;
			};
		};

		return @this.validate_dispatch_syntax(@*declaration, $class_scope);
	};

	if (syntax.kind() == syntax_kind::record) {
		return @this.validate_dispatch_syntax(@*syntax.record_members(), true);
	};

	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.validate_dispatch_syntax(@*syntax.namespace_members(), false);
	};

	if (syntax.kind() == syntax_kind::list || syntax.kind() == syntax_kind::brace || syntax.kind() == syntax_kind::unit) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!@this.validate_dispatch_syntax(@*syntax.item(index), bool(class_scope))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	if (syntax.kind() != syntax_kind::function) {
		return true;
	};

	bool virtual_operation = false;
	usize index = 0;
	while (index < syntax.function_attributes()->size()) {
		Token token = syntax.function_attributes()->item(index)->token();

		if (token.is(rt::string_view("virtual\0")) || token.is(rt::string_view("override\0")) || token.is(rt::string_view("final\0"))) {
			@virtual_operation = true;
		};

		@index = index + 1;
	};

	if (!virtual_operation) {
		return true;
	};

	Syntax* parameters = syntax.function_parameters();

	if ((!class_scope && syntax.function_name()->kind() != syntax_kind::qualified_name) || !parameters->size() || !parameters->item(0)->parameter_name()->token().is(rt::string_view("this\0")) || parameters->item(0)->parameter_type()->kind() != syntax_kind::type_reference) {
		@this.error(&syntax, "virtual operation requires an explicit class receiver named this\0");
		return false;
	};

	if (this.templates.qualifier_dependent(@syntax)) {
		@this.error(&syntax, "virtual operation cannot have dependent receiver qualification\0");
		return false;
	};

	return true;
};

fn dispatch_signature(const Entity& function, const Entity& inherited) -> bool {
	if (function.operator_kind() != token_kind::identifier || inherited.operator_kind() != token_kind::identifier) {
		if (function.operator_kind() != inherited.operator_kind()) {
			return false;
		};
	}
	else if (function.name() != inherited.name()) {
		return false;
	};

	const rt::buffer<Entity*>& first = function.parameters();
	const rt::buffer<Entity*>& second = inherited.parameters();

	if (!first.size() || first.size() != second.size() || first.data()[0]->type()->kind() != type_kind::reference || second.data()[0]->type()->kind() != type_kind::reference || first.data()[0]->type()->element()->qualifier() != second.data()[0]->type()->element()->qualifier()) {
		return false;
	};

	usize index = 1;
	while (index < first.size()) {
		if (first.data()[index]->type() != second.data()[index]->type()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn dispatch_result(const Type& result, const Type& inherited) -> bool {
	if (result.same_shape(inherited)) {
		return true;
	};

	if (result.kind() != inherited.kind() || result.kind() != type_kind::pointer && result.kind() != type_kind::reference) {
		return false;
	};

	const Type* source = result.element();
	const Type* destination = inherited.element();

	return source->derived_from(*destination) && (source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable);
};

fn Analyzer::build_dispatch(Analyzer& this, Entity* entity) -> bool {
	usize inherited = 0;

	if (entity->bases().size()) {
		const rt::buffer<Entity*>& base = entity->bases().data()[0]->entity()->virtual_functions();

		while (inherited < base.size()) {
			if (!@entity->add_virtual(base.data()[inherited])) {
				return false;
			};

			@inherited = inherited + 1;
		};
	};

	rt::buffer<Entity*> seen;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		Entity* function = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (function->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve(Entity*(function))) {
			return false;
		};

		@function = function->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != function) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back(Entity*(function))) {
			return false;
		};

		usize slot = 0;

		while (slot < inherited && !dispatch_signature(*function, *entity->virtual_functions().data()[slot])) {
			@slot = slot + 1;
		};

		if (slot < inherited) {
			Entity* previous = entity->virtual_functions().data()[slot];

			if (previous->is_final()) {
				@this.error(function->declaration(), "final virtual operation cannot be overridden\0");
				return false;
			};

			if (!function->requires_override() && !function->is_final()) {
				@this.error(function->declaration(), "override of an inherited virtual operation requires override or final\0");
				return false;
			};

			if (!dispatch_result(*function->type()->signature().result(), *previous->type()->signature().result())) {
				@this.error(function->declaration(), "virtual override has an incompatible result type\0");
				return false;
			};

			@entity->replace_virtual(usize(slot), @*function);
			@function->set_virtual_slot(slot);
		}
		else if (function->requires_override() || function->is_final() && !function->declares_virtual()) {
			@this.error(function->declaration(), "override requires a matching inherited virtual operation\0");
			return false;
		}
		else if (function->declares_virtual()) {
			@function->set_virtual_slot(entity->virtual_functions().size());

			if (!@entity->add_virtual(Entity*(function))) {
				return false;
			};
		};
	};

	if (entity->layout() == record_layout::overlapping && entity->virtual_functions().size()) {
		@this.error(entity->declaration(), "union cannot contain virtual operations\0");
		return false;
	};

	return true;
};

fn Analyzer::expression_impl(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (this.diagnostics->failed()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* void_type = this.types->find_primitive(rt::string_view("void\0"));
	const Type* bool_type = this.types->find_primitive(rt::string_view("bool\0"));
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::grouping) {
		return @this.expression(@scope, @*syntax.operand(), expected);
	};

	if (kind == syntax_kind::switch_expression) {
		return @this.selection(@scope, @syntax);
	};

	if (kind == syntax_kind::case_label) {
		return @this.label(@scope, @syntax);
	};

	if (kind == syntax_kind::sizeof_type) {
		const Type* target = @this.type(@scope, @*syntax.designated_type());

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.size_query(@syntax, *target), expected, @syntax);
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return @this.node(semantic_kind::noop, void_type, &syntax);
	};

	if (kind == syntax_kind::ambiguity) {
		usize index = 0;
		while (index < syntax.size()) {
			Syntax* candidate = syntax.item(index);
			Syntax* type = nullptr;

			if (candidate->kind() == syntax_kind::variable) {
				@type = candidate->variable_type();
			}
			else if (candidate->kind() == syntax_kind::sizeof_type) {
				@type = candidate->designated_type();
			};

			if (candidate->kind() == syntax_kind::call) {
				@type = candidate->callable();
			};

			if (type && @this.names_type(@scope, @*type)) {
				return @this.expression(@scope, @*candidate, expected);
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < syntax.size()) {
			Syntax* candidate = syntax.item(index);

			if (candidate->kind() == syntax_kind::call) {
				syntax_kind callee = candidate->callable()->kind();

				if (callee == syntax_kind::type_name || callee == syntax_kind::type_pointer || callee == syntax_kind::type_reference || callee == syntax_kind::type_array || callee == syntax_kind::type_const || callee == syntax_kind::type_function || callee == syntax_kind::type_auto) {
					@index = index + 1;
					continue;
				};
			};

			if (syntax.item(index)->kind() != syntax_kind::variable && syntax.item(index)->kind() != syntax_kind::sizeof_type) {
				return @this.expression(@scope, @*syntax.item(index), expected);
			};

			@index = index + 1;
		};

		@this.error(&syntax, "syntax has no interpretation in this scope\0");

		return rt::unique<SemanticExpression>();
	};

	bool character_literal = kind == syntax_kind::number && syntax.token().text().size() && syntax.token().text().data()[0] == '\'';

	if (kind == syntax_kind::number && !character_literal) {
		u64 integer = 0;

		if (@this.integer(@syntax, @integer)) {
			const Type* type = expected.get();

			if (!type || !type->kind().is_integer() || type->kind() == type_kind::boolean) {
				@type = this.types->find_primitive(rt::string_view("i32\0"));

				if (integer > static_cast<u64>(i32::max)) {
					@type = this.types->find_primitive(rt::string_view("i64\0"));
				};

				if (integer > static_cast<u64>(i64::max)) {
					@type = this.types->find_primitive(rt::string_view("u64\0"));
				};
			};

			var result = @this.node(semantic_kind::literal_integer, type, &syntax);

			if (result.get()) {
				@result.get()->set_integer(u64(integer));
			};

			return @this.convert($result, expected, @syntax);
		};

		var spelling = rt::string(syntax.token().text());
		char* end = nullptr;
		f64 real = strtod(spelling.c_str(), &end);

		if (!end || end[0]) {
			@this.error(&syntax, "numeric literal is not representable\0");

			return rt::unique<SemanticExpression>();
		};

		const Type* type = this.types->find_primitive(rt::string_view("f64\0"));

		if (expected.has_value() && expected.value().kind() == type_kind::floating_point) {
			@type = expected.get();
		};

		var result = @this.node(semantic_kind::literal_real, type, &syntax);

		if (result.get()) {
			@result.get()->set_real(f64(real));
		};

		return $result;
	};

	if (kind == syntax_kind::string || character_literal) {
		var text = syntax.token().text();
		rt::string decoded;
		usize index = 1;
		while (index + 1 < text.size()) {
			char character := text.data()[index];
			@index = index + 1;

			if (character == '\\' && index + 1 < text.size()) {
				@character := text.data()[index];
				@index = index + 1;

				if (character == 'n') {
					@character = '\n';
				}
				else if (character == 'r') {
					@character = '\r';
				}
				else if (character == 't') {
					@character = '\t';
				}
				else if (character == '0') {
					@character = '\0';
				}
				else if (character != '\\' && character != '\'' && character != '"') {
					@this.error(&syntax, "unsupported escape in literal\0");

					return rt::unique<SemanticExpression>();
				};
			};

			if (!@decoded.append(rt::string_view(&character, 1))) {
				return rt::unique<SemanticExpression>();
			};
		};

		const Type* character_type = this.types->find_primitive(rt::string_view("char\0"));

		if (text.data()[0] == '\'') {
			if (decoded.size() != 1) {
				@this.error(&syntax, "character literal shall contain one character\0");

				return rt::unique<SemanticExpression>();
			};

			var result = @this.node(semantic_kind::literal_integer, character_type, &syntax);

			if (result.get()) {
				char character := decoded.data()[0];
				@result.get()->set_integer(static_cast<u64>($character));
			};

			return @this.convert($result, expected, @syntax);
		};

		const Type* element = @this.types->qualified(*character_type, type_qualifier::immutable);
		var result = @this.node(semantic_kind::literal_text, @this.types->pointer(element), &syntax);

		if (result.get()) {
			@result.get()->set_text(decoded.view());
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::null_pointer) {
		const Type* type = @this.types->pointer(this.types->find_primitive(rt::string_view("null\0")));

		return @this.convert(@this.node(semantic_kind::null_pointer, type, &syntax), expected, @syntax);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Token token = syntax.token();

		if (token.is(rt::string_view("true\0")) || token.is(rt::string_view("false\0"))) {
			var result = @this.node(semantic_kind::literal_integer, bool_type, &syntax);

			if (result.get() && token.is(rt::string_view("true\0"))) {
				@result.get()->set_integer(1);
			};

			return @this.convert($result, expected, @syntax);
		};

		Entity* entity = @this.lookup(@scope, @syntax);

		if (!entity || !@this.resolve(Entity*(entity))) {
			@this.error(&syntax, "unknown identifier\0");

			return rt::unique<SemanticExpression>();
		};

		@entity = entity->canonical();

		if (entity->kind() == entity_kind::constant) {
			return @this.convert(entity->body()->copy_constant(), expected, @syntax);
		};

		if (entity->kind() == entity_kind::enumerator) {
			var result = @this.node(semantic_kind::literal_integer, entity->type(), &syntax);

			if (result.get()) {
				@result.get()->set_integer(entity->integer());
			};

			return @this.convert($result, expected, @syntax);
		};

		if (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global && entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter && entity->kind() != entity_kind::field) {
			@this.error(&syntax, "identifier does not denote a value\0");

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::function && entity->definition() == function_definition::deleted) {
			@this.error(&syntax, "selected function is deleted\0");

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::field) {
			Entity* receiver = scope.lookup(rt::string_view("this\0"));

			if (!receiver || receiver->type()->kind() != type_kind::reference || receiver->type()->element()->kind() != type_kind::named || receiver->type()->element()->entity() != entity->scope()->owner()) {
				@this.error(&syntax, "field access requires an instance receiver\0");

				return rt::unique<SemanticExpression>();
			};

			const Type* owner = receiver->type()->element();
			const Type* field_type = entity->type();

			if (field_type->kind() == type_kind::reference) {
				@field_type = field_type->element();
			}
			else if (owner->qualifier() == type_qualifier::immutable) {
				@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
			};

			var object = @this.node(semantic_kind::name, owner, &syntax);

			if (!object.get()) {
				return rt::unique<SemanticExpression>();
			};

			@object.get()->bind(receiver, value_category::place);
			var member = @this.node(semantic_kind::member, field_type, &syntax);

			if (!member.get()) {
				return rt::unique<SemanticExpression>();
			};

			@member.get()->bind(entity, value_category::place);

			if (!@member.get()->append($object)) {
				return rt::unique<SemanticExpression>();
			};

			return @this.convert($member, expected, @syntax);
		};

		const Type* type = entity->type();

		if (type->kind() == type_kind::reference) {
			@type = type->element();
		};

		var result = @this.node(semantic_kind::name, type, &syntax);

		if (result.get()) {
			@result.get()->bind(entity, value_category::place);
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::brace || kind == syntax_kind::list) {
		if (kind == syntax_kind::brace && !syntax.size() && expected.has_value() && expected.value().kind() == type_kind::array) {
			const Type* element = expected.get();

			while (element->kind() == type_kind::array) {
				@element = element->element();
			};

			if (!element->representation()->kind().is_scalar()) {
				@this.error(&syntax, "empty initialization of object arrays is not specified\0");

				return rt::unique<SemanticExpression>();
			};

			return @this.construct(@scope, @syntax, expected.get(), @syntax);
		};

		Scope* local = &scope;

		if (kind == syntax_kind::brace) {
			@local = @this.unit->create_scope(&scope, this.function);
		};

		var result = @this.node(semantic_kind::brace, void_type, &syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			var child = @this.expression(@*local, @*syntax.item(index), rt::optional_ref<const Type>());

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($child)) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::using_alias) {
		if (!@this.collect(@scope, @syntax)) {
			return rt::unique<SemanticExpression>();
		};

		Entity* alias = scope.local(syntax.alias_name()->token().text());

		if (!alias || !@this.resolve(alias)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.node(semantic_kind::noop, void_type, &syntax);
	};

	if (kind == syntax_kind::variable) {
		Token name = syntax.variable_name()->token();

		if (scope.local(name.text())) {
			@this.error(&syntax, "duplicate local declaration\0");

			return rt::unique<SemanticExpression>();
		};

		const Type* type = @this.type(@scope, @*syntax.variable_type());
		Syntax* initializer = syntax.variable_initializer();

		if (initializer->kind() == syntax_kind::unary) {
			@initializer = initializer->operand();
		};

		rt::optional_ref<const Type> initializer_type;

		if (type && !(type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) && syntax.variable_initializer()->token().kind != token_kind::op_copy) {
			@initializer_type.bind(*type);
		};

		var value = @this.expression(@scope, @*initializer, initializer_type);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!type && value.get()->kind() != semantic_kind::noop) {
			@type = value.get()->type();
		};

		if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function) {
			@this.error(&syntax, "variable requires object storage or a reference\0");

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::reference && value.get()->kind() == semantic_kind::noop) {
			@this.error(&syntax, "reference requires an initializer\0");

			return rt::unique<SemanticExpression>();
		};

		@value = @this.initialize(@syntax, type, rt::unique<SemanticExpression>(@value.release()));

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		Entity* entity = @this.unit->create_entity(entity_kind::local, name, &syntax, &scope);

		if (!entity) {
			return rt::unique<SemanticExpression>();
		};

		@entity->set_type(type);
		@entity->set_state(entity_state::ready);
		var result = @this.node(semantic_kind::variable, void_type, &syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->bind(entity, value_category::consumable);

		return $result;
	};

	if (kind == syntax_kind::return_value) {
		if (!this.function) {
			@this.error(&syntax, "return requires an enclosing function\0");

			return rt::unique<SemanticExpression>();
		};

		const Type* result_type = this.function->type()->signature().result();
		var result = @this.node(semantic_kind::return_value, void_type, &syntax);
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>(*result_type));

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::conditional || kind == syntax_kind::while_loop || kind == syntax_kind::for_loop) {
		semantic_kind category = semantic_kind::conditional;
		Scope* local = &scope;

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth + 1;
			@category = semantic_kind::while_loop;
		};

		if (kind == syntax_kind::for_loop) {
			@category = semantic_kind::for_loop;
			@local = @this.unit->create_scope(&scope, this.function);
		};

		var result = @this.node(semantic_kind(category), void_type, &syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			rt::optional_ref<const Type> context;

			if (kind == syntax_kind::for_loop && index == 1 || kind != syntax_kind::for_loop && !index) {
				if (syntax.item(index)->kind() != syntax_kind::absent) {
					@context.bind(*bool_type);
				};
			};

			var child = @this.expression(@*local, @*syntax.item(index), context);

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($child)) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth - 1;
		};

		return $result;
	};

	if (kind == syntax_kind::break_loop || kind == syntax_kind::continue_loop) {
		if (!this.loop_depth && (kind == syntax_kind::continue_loop || !this.active_switch)) {
			@this.error(&syntax, "control transfer requires an enclosing loop or switch\0");

			return rt::unique<SemanticExpression>();
		};

		if (kind == syntax_kind::break_loop) {
			return @this.node(semantic_kind::break_loop, void_type, &syntax);
		};

		return @this.node(semantic_kind::continue_loop, void_type, &syntax);
	};

	if (kind == syntax_kind::unary) {
		return @this.unary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::binary) {
		return @this.binary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::call) {
		return @this.call(@scope, @syntax, expected, false);
	};

	if (kind == syntax_kind::cast) {
		return @this.cast(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::member || kind == syntax_kind::index) {
		return @this.component(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::discard_value) {
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!value.get() || value.get()->category() != value_category::consumable) {
			@this.error(&syntax, "discard requires a consumable\0");

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::discard_value, void_type, &syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::allocation) {
		Syntax* type_syntax = syntax.allocation_type();
		Syntax* count = nullptr;

		if (type_syntax->kind() == syntax_kind::type_array) {
			@count = type_syntax->array_extent();
			@type_syntax = type_syntax->designated_type();
		};

		const Type* target = @this.type(@scope, @*type_syntax);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		var construction = @this.construct(@scope, @syntax, target, @*syntax.allocation_arguments());

		if (!construction.get()) {
			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::allocation, @this.types->pointer(target), &syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($construction)) {
			return rt::unique<SemanticExpression>();
		};

		if (count) {
			var extent = @this.expression(@scope, @*count, rt::optional_ref<const Type>());

			if (!extent.get() || !extent.get()->type()->kind().is_integer()) {
				@this.error(&syntax, "array allocation count requires an integer\0");

				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($extent)) {
				return rt::unique<SemanticExpression>();
			};
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::deallocation || kind == syntax_kind::array_deallocation) {
		var pointer = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!pointer.get() || pointer.get()->type()->kind() != type_kind::pointer) {
			@this.error(&syntax, "deallocation requires a pointer\0");

			return rt::unique<SemanticExpression>();
		};

		semantic_kind category = semantic_kind::deallocation;

		if (kind == syntax_kind::array_deallocation) {
			@category = semantic_kind::array_deallocation;
		};

		var result = @this.node(semantic_kind(category), void_type, &syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($pointer)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	@this.error(&syntax, "semantic analysis for this expression is not implemented\0");

	return rt::unique<SemanticExpression>();
};

struct SwitchAnalysis {
	const Type* condition_type;
	rt::buffer<u64> values;
	Syntax* default_label;
};

struct SwitchAnalysisScope {
	fn SwitchAnalysisScope(SwitchAnalysisScope& this, SwitchAnalysis*& slot, SwitchAnalysis& current);
	fn ~SwitchAnalysisScope(SwitchAnalysisScope& this);

private:
	SwitchAnalysis** slot;
	SwitchAnalysis* previous;
};

fn Analyzer::selection(Analyzer& this, Scope& scope, Syntax& syntax) -> rt::unique<SemanticExpression> {
	var condition = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!condition.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* representation = condition.get()->type()->representation();

	if (!representation->kind().is_integer()) {
		@this.error(&syntax, "switch condition requires an integer or enumeration value\0");

		return rt::unique<SemanticExpression>();
	};

	SwitchAnalysis analysis;
	@analysis.condition_type = representation;
	var context = SwitchAnalysisScope(@this.active_switch, @analysis);
	var body = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());

	if (!body.get()) {
		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::switch_expression, this.types->find_primitive(rt::string_view("void\0")), &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($condition)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($body)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::label(Analyzer& this, Scope& scope, Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!this.active_switch) {
		@this.error(&syntax, "case or default label requires an enclosing switch\0");

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::case_label, this.types->find_primitive(rt::string_view("void\0")), &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (syntax.token().kind == token_kind::kw_default) {
		if (this.active_switch->default_label) {
			@this.error(&syntax, "switch contains more than one default label\0");

			return rt::unique<SemanticExpression>();
		};

		@this.active_switch->default_label = &syntax;

		return $result;
	};

	var expression = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>(*this.active_switch->condition_type));
	u64 value = 0;

	if (!expression.get() || !@this.constant_integer(*expression.get(), @value)) {
		@this.error(&syntax, "case label requires an integer constant expression\0");

		return rt::unique<SemanticExpression>();
	};

	@value = this.active_switch->condition_type->normalize_integer(value);
	usize index = 0;
	while (index < this.active_switch->values.size()) {
		if (this.active_switch->values.data()[index] == value) {
			@this.error(&syntax, "duplicate switch case value\0");

			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (!@this.active_switch->values.push_back(value)) {
		@this.error(&syntax, "switch label storage is unavailable\0");

		return rt::unique<SemanticExpression>();
	};

	@result.get()->set_integer(value);

	return $result;
};

fn SwitchAnalysisScope::SwitchAnalysisScope(SwitchAnalysisScope& this, SwitchAnalysis*& slot, SwitchAnalysis& current) {
	@this.slot = &slot;
	@this.previous := slot;
	@slot = &current;
};

fn SwitchAnalysisScope::~SwitchAnalysisScope(SwitchAnalysisScope& this) {
	@*this.slot := this.previous;
};

enum object_lifetime : [u08] {
	live;
	relocated;
	discarded;
	destroyed;
	indeterminate;
};

enum flow_exit : [u08] {
	none;
	unreachable;
	return_function;
	break_loop;
	continue_loop;
};

enum flow_region : [u08] {
	loop;
	selection;
};

struct LiveBinding {
	Entity* entity;
	object_lifetime lifetime;
	rt::optional_ref<Entity> referent;
};

struct FlowState {
	fn declare(FlowState& this, Entity* entity) -> bool;
	fn copy_from(FlowState& this, const FlowState& other) -> bool;
	fn truncate(FlowState& this, usize size);
	fn leave(FlowState& this, flow_exit exit);
	fn resume(FlowState& this);

	fn size(const FlowState& this) -> usize;
	fn at(FlowState& this, usize index) -> LiveBinding*;
	fn find(FlowState& this, Entity* entity) -> LiveBinding*;
	fn exited(const FlowState& this) -> bool;

private:
	rt::buffer<LiveBinding> bindings;
	flow_exit exit;
};

struct LoopFlow {
	flow_region region;
	usize break_boundary;
	usize continue_boundary;
	LoopFlow* parent;
	rt::buffer<rt::unique<FlowState>> breaks;
	rt::buffer<rt::unique<FlowState>> continues;
};

struct LoopScope {
	fn LoopScope(LoopScope& this, LoopFlow*& current, LoopFlow& loop);
	fn ~LoopScope(LoopScope& this);

private:
	LoopFlow** current;
	LoopFlow* previous;
};

struct LifetimeAnalyzer {
	fn LifetimeAnalyzer(LifetimeAnalyzer& this, Diagnostics& diagnostics);

	fn sequence(LifetimeAnalyzer& this, SemanticExpression& expression, FlowState& state) -> bool;
	fn validate(LifetimeAnalyzer& this, const SemanticUnit& unit) -> bool;

	fn storage_owner(const LifetimeAnalyzer& this, const SemanticExpression& expression, FlowState& state) -> rt::optional_ref<Entity>;

private:
	fn error(LifetimeAnalyzer& this, SemanticExpression* expression, const char* message) -> bool;
	fn walk(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool;
	fn storage(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool;
	fn merge(LifetimeAnalyzer& this, FlowState& destination, FlowState& first, FlowState& second, SemanticExpression* expression) -> bool;
	fn validate_backedge(LifetimeAnalyzer& this, FlowState& entry, FlowState& incoming, SemanticExpression* expression) -> bool;
	fn conditional(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool;
	fn loop(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool;
	fn selection(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool;
	fn save(LifetimeAnalyzer& this, rt::buffer<rt::unique<FlowState>>& exits, FlowState& state, usize boundary, SemanticExpression* expression) -> bool;

	Diagnostics* diagnostics;
	LoopFlow* active_loop;
};

fn LifetimeAnalyzer::error(LifetimeAnalyzer& this, SemanticExpression* expression, const char* message) -> bool {
	Token token;

	if (expression) {
		@token = expression->token();
	};

	@this.diagnostics->error(token, rt::string_view($message));
	return false;
};

fn LifetimeAnalyzer::merge(LifetimeAnalyzer& this, FlowState& destination, FlowState& first, FlowState& second, SemanticExpression* expression) -> bool {
	if (first.exited() && second.exited()) {
		return @destination.copy_from(first);
	};

	if (first.exited()) {
		return @destination.copy_from(second);
	};

	if (second.exited()) {
		return @destination.copy_from(first);
	};

	usize index = 0;
	while (index < destination.size()) {
		LiveBinding* binding = @destination.at(index);
		LiveBinding* a = @first.find(binding->entity);
		LiveBinding* b = @second.find(binding->entity);

		if (!a || !b) {
			return @this.error($expression, "inconsistent object lifetimes at reachable control-flow merge\0");
		};

		if (a->lifetime == object_lifetime::indeterminate || b->lifetime == object_lifetime::indeterminate || (a->lifetime == object_lifetime::live) != (b->lifetime == object_lifetime::live)) {
			@binding->lifetime = object_lifetime::indeterminate;
		}
		else {
			@binding->lifetime = object_lifetime(a->lifetime);
		};

		if (a->referent.get() != b->referent.get() || !a->referent.has_value()) {
			@binding->referent.reset();
		}
		else {
			@binding->referent.bind(@*a->referent.get());
		};

		@index = index + 1;
	};

	return true;
};

fn LifetimeAnalyzer::validate_backedge(LifetimeAnalyzer& this, FlowState& entry, FlowState& incoming, SemanticExpression* expression) -> bool {
	usize index = 0;
	while (index < entry.size()) {
		LiveBinding* binding = @entry.at(index);
		LiveBinding* repeated = @incoming.find(binding->entity);

		if (!repeated || (binding->lifetime == object_lifetime::indeterminate) != (repeated->lifetime == object_lifetime::indeterminate) || (binding->lifetime == object_lifetime::live) != (repeated->lifetime == object_lifetime::live)) {
			return @this.error(expression, "inconsistent object lifetimes at reachable control-flow merge\0");
		};

		@index = index + 1;
	};

	return true;
};

fn LifetimeAnalyzer::conditional(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool {
	if (!@this.walk(expression->item(0), @state)) {
		return false;
	};

	bool truth = false;

	if (expression->item(0)->constant_truth(@truth)) {
		if (truth) {
			return @this.walk(expression->item(1), @state);
		};

		return @this.walk(expression->item(2), @state);
	};

	FlowState first;
	FlowState second;

	if (!@first.copy_from(state) || !@second.copy_from(state)) {
		return @this.error($expression, "lifetime state storage is unavailable\0");
	};

	if (!@this.walk(expression->item(1), @first) || !@this.walk(expression->item(2), @second)) {
		return false;
	};

	return @this.merge(@state, @first, @second, $expression);
};

fn LifetimeAnalyzer::storage(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool {
	Entity* owner = expression->owned_binding();

	if (!owner) {
		return @this.walk(expression, @state);
	};

	if (!@state.find(owner)) {
		return @this.error(expression, "object storage does not reach this construction\0");
	};

	return true;
};

fn LifetimeAnalyzer::save(LifetimeAnalyzer& this, rt::buffer<rt::unique<FlowState>>& exits, FlowState& state, usize boundary, SemanticExpression* expression) -> bool {
	var snapshot = rt::unique<FlowState>::make();

	if (!snapshot.get() || !@snapshot.get()->copy_from(state)) {
		return @this.error($expression, "lifetime state storage is unavailable\0");
	};

	@snapshot.get()->truncate($boundary);
	@snapshot.get()->resume();

	if (!@exits.push_back($snapshot)) {
		return @this.error($expression, "lifetime state storage is unavailable\0");
	};

	return true;
};

fn LifetimeAnalyzer::loop(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool {
	bool is_for = expression->kind() == semantic_kind::for_loop;
	usize boundary = state.size();

	if (is_for && !@this.walk(expression->item(0), @state)) {
		return false;
	};

	FlowState entry;

	if (!@entry.copy_from(state)) {
		return @this.error($expression, "lifetime state storage is unavailable\0");
	};

	usize condition = 0;
	usize body = 1;

	if (is_for) {
		@condition = 1;
		@body = 3;
	};

	SemanticExpression* test = expression->item(condition);

	if (!@this.walk(test, @state)) {
		return false;
	};

	bool truth = true;
	bool known = is_for && test->kind() == semantic_kind::noop;

	if (!known) {
		@known = test->constant_truth(@truth);
	};

	if (known && !truth) {
		@state.truncate(boundary);

		return true;
	};

	FlowState repeated;

	if (!@repeated.copy_from(state)) {
		return @this.error($expression, "lifetime state storage is unavailable\0");
	};

	LoopFlow loop;
	@loop.parent := this.active_loop;
	@loop.break_boundary := boundary;
	@loop.continue_boundary = state.size();
	var scope = LoopScope(@this.active_loop, @loop);

	if (!@this.walk(expression->item(body), @repeated)) {
		return false;
	};

	if (!repeated.exited() && !@this.save(@loop.continues, @repeated, loop.continue_boundary, expression)) {
		return false;
	};

	usize body_exits = loop.continues.size();
	usize index = 0;
	while (index < body_exits) {
		FlowState& backedge = @*loop.continues.data()[index].get();

		if (is_for && !@this.walk(expression->item(2), @backedge)) {
			return false;
		};

		if (!backedge.exited()) {
			if (!@this.validate_backedge(@entry, @backedge, expression)) {
				return false;
			};
		};

		@index = index + 1;
	};

	while (index < loop.continues.size()) {
		if (!@this.validate_backedge(@entry, @*loop.continues.data()[index].get(), expression)) {
			return false;
		};

		@index = index + 1;
	};

	@state.truncate(boundary);
	bool has_exit = !known || !truth;
	@index = 0;

	while (index < loop.breaks.size()) {
		FlowState& leaving = @*loop.breaks.data()[index].get();

		if (!has_exit) {
			if (!@state.copy_from(leaving)) {
				return @this.error($expression, "lifetime state storage is unavailable\0");
			};

			@has_exit = true;
		}
		else {
			FlowState previous;

			if (!@previous.copy_from(state) || !@this.merge(@state, @previous, @leaving, expression)) {
				return false;
			};
		};

		@index = index + 1;
	};

	if (!has_exit) {
		@state.leave(flow_exit::unreachable);
	};

	return true;
};

fn LifetimeAnalyzer::walk(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool {
	if (!expression || state.exited()) {
		return true;
	};

	switch (expression->kind()) {
		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or) {
				if (!@this.walk(expression->item(0), @state)) {
					return false;
				};

				bool truth = false;

				if (expression->item(0)->constant_truth(@truth)) {
					if (expression->operation() == token_kind::op_and && !truth || expression->operation() == token_kind::op_or && truth) {
						return true;
					};

					return @this.walk(expression->item(1), @state);
				};

				FlowState skipped;
				FlowState evaluated;

				if (!@skipped.copy_from(state) || !@evaluated.copy_from(state)) {
					return @this.error($expression, "lifetime state storage is unavailable\0");
				};

				if (!@this.walk(expression->item(1), @evaluated)) {
					return false;
				};

				return @this.merge(@state, @skipped, @evaluated, $expression);
			};

			break;
		case semantic_kind::conditional:
			return @this.conditional($expression, @state);
		case semantic_kind::switch_expression:
			return @this.selection(expression, @state);
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop($expression, @state);
		case semantic_kind::sequence:
			return @this.sequence(@*expression, @state);
		case semantic_kind::name: {
			Entity* entity = expression->entity();

			if (!entity || (entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter)) {
				return true;
			};

			LiveBinding* binding = @state.find($entity);
			var owner = this.storage_owner(*expression, @state);

			if (owner.has_value()) {
				@binding = @state.find(owner.get());
			};

			if (!binding) {
				return @this.error($expression, "object construction does not reach this use\0");
			};

			if (binding->lifetime == object_lifetime::destroyed) {
				return @this.error(expression, "object has been destroyed\0");
			};

			if (binding->lifetime != object_lifetime::live) {
				return @this.error($expression, "object has been relocated or discarded\0");
			};

			return true;
		};
		case semantic_kind::variable: {
			if (!@this.walk(expression->item(0), @state)) {
				return false;
			};

			var owner = this.storage_owner(*expression->item(0), @state);

			if (!@state.declare(expression->entity())) {
				return @this.error($expression, "lifetime state storage is unavailable\0");
			};

			if (expression->entity()->type()->kind() == type_kind::reference && owner.has_value()) {
				LiveBinding* binding = @state.find(expression->entity());
				@binding->referent.bind(@*owner.get());
			};

			return true;
		};
		case semantic_kind::relocation: {
			SemanticExpression* source = expression->item(0);

			if (!@this.walk(source, @state)) {
				return false;
			};

			Entity* owner = source->owned_binding();

			if (owner) {
				LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::relocated;
				};
			};

			return true;
		};
		case semantic_kind::destruction: {
			SemanticExpression* object = expression->item(0);

			if (!@this.walk(object, @state)) {
				return false;
			};

			Entity* owner = object->owned_binding();

			if (owner) {
				LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::destroyed;
				};
			};

			return true;
		};
		case semantic_kind::construction: {
			if (expression->size() < 2) {
				return @this.walk(expression->item(0), @state);
			};

			SemanticExpression* destination = expression->item(1);

			if (!@this.storage(destination, @state) || !@this.walk(expression->item(0), @state)) {
				return false;
			};

			Entity* owner = destination->owned_binding();

			if (owner) {
				LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::live;
				};
			};

			return true;
		};
		case semantic_kind::return_value:
			if (!@this.walk(expression->item(0), @state)) {
				return false;
			};

			@state.leave(flow_exit::return_function);

			return true;
		case semantic_kind::break_loop:
			if (!this.active_loop || !@this.save(@this.active_loop->breaks, @state, usize(this.active_loop->break_boundary), expression)) {
				return @this.error($expression, "break requires an enclosing loop\0");
			};

			@state.leave(flow_exit::break_loop);

			return true;
		case semantic_kind::continue_loop: {
			LoopFlow* loop = this.active_loop;

			while (loop && loop->region == flow_region::selection) {
				@loop = loop->parent;
			};

			if (!loop || !@this.save(@loop->continues, @state, usize(loop->continue_boundary), expression)) {
				return @this.error($expression, "continue requires an enclosing loop\0");
			};

			@state.leave(flow_exit::continue_loop);

			return true;
		};
		default:
			break;
	};

	usize boundary = state.size();
	usize index = 0;
	while (index < expression->size()) {
		if (!@this.walk(expression->item(index), @state)) {
			return false;
		};

		@index = index + 1;
	};

	if (expression->kind() == semantic_kind::brace) {
		@state.truncate(boundary);
	};

	return true;
};

fn LifetimeAnalyzer::validate(LifetimeAnalyzer& this, const SemanticUnit& unit) -> bool {
	usize index = 0;
	while (index < unit.entities().size()) {
		Entity* function = unit.entities().data()[index].get();
		@index = index + 1;

		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};

		FlowState state;
		usize parameter = 0;

		while (parameter < function->parameters().size()) {
			if (!@state.declare(function->parameters().data()[parameter])) {
				return @this.error(nullptr, "lifetime state storage is unavailable\0");
			};

			@parameter = parameter + 1;
		};

		if (!@this.walk(function->body(), @state)) {
			return false;
		};

		function_completion completion = function_completion::reaches_end;

		if (state.exited()) {
			@completion = function_completion::no_fallthrough;
		};

		@function->set_completion($completion);
	};

	return true;
};

fn FlowState::size(const FlowState& this) -> usize {
	return this.bindings.size();
};

fn FlowState::at(FlowState& this, usize index) -> LiveBinding* {
	return (@this.bindings).data() + index;
};

fn FlowState::find(FlowState& this, Entity* entity) -> LiveBinding* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return (@this.bindings).data() + index;
		};
	};

	return nullptr;
};

fn FlowState::declare(FlowState& this, Entity* entity) -> bool {
	LiveBinding binding;
	@binding.entity = $entity;
	@binding.lifetime = object_lifetime::live;

	return @this.bindings.push_back($binding);
};

fn FlowState::copy_from(FlowState& this, const FlowState& other) -> bool {
	@this.bindings.clear();
	@this.exit = flow_exit(other.exit);
	usize index = 0;
	while (index < other.bindings.size()) {
		LiveBinding binding := other.bindings.data()[index];

		if (!@this.bindings.push_back($binding)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FlowState::truncate(FlowState& this, usize size) {
	while (this.bindings.size() > size) {
		@this.bindings.pop_back();
	};
};

fn FlowState::exited(const FlowState& this) -> bool {
	return this.exit != flow_exit::none;
};

fn FlowState::leave(FlowState& this, flow_exit exit) {
	@this.exit = $exit;
};

fn FlowState::resume(FlowState& this) {
	@this.exit = flow_exit::none;
};

fn LoopScope::LoopScope(LoopScope& this, LoopFlow*& current, LoopFlow& loop) {
	@this.current = &current;
	@this.previous := current;
	@current = &loop;
};

fn LoopScope::~LoopScope(LoopScope& this) {
	@*this.current := this.previous;
};

fn LifetimeAnalyzer::LifetimeAnalyzer(LifetimeAnalyzer& this, Diagnostics& diagnostics) {
	@this.diagnostics = &diagnostics;
};

fn LifetimeAnalyzer::selection(LifetimeAnalyzer& this, SemanticExpression* expression, FlowState& state) -> bool {
	if (!@this.walk(expression->item(0), @state)) {
		return false;
	};

	SemanticExpression* body = expression->item(1);

	if (body->kind() != semantic_kind::brace) {
		return true;
	};

	usize boundary = state.size();
	u64 condition = 0;
	bool known = expression->item(0)->constant_integer(@condition);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		SemanticExpression* label = body->item(index);

		if (label->kind() == semantic_kind::case_label) {
			if (label->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (known && label->integer() == condition) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	FlowState combined;

	if (!@combined.copy_from(state)) {
		return @this.error(expression, "lifetime state storage is unavailable\0");
	};

	if (fallback < body->size() || known && selected < body->size()) {
		@combined.leave(flow_exit::unreachable);
	};

	LoopFlow selection;
	@selection.region = flow_region::selection;
	@selection.parent := this.active_loop;
	@selection.break_boundary := boundary;
	var scope = LoopScope(@this.active_loop, @selection);
	@index = 0;

	while (index < body->size()) {
		if (body->item(index)->kind() != semantic_kind::case_label || known && index != selected) {
			@index = index + 1;
			continue;
		};

		FlowState path;

		if (!@path.copy_from(state)) {
			return @this.error(expression, "lifetime state storage is unavailable\0");
		};

		usize next = index + 1;

		while (next < body->size() && !path.exited()) {
			if (body->item(next)->kind() != semantic_kind::case_label && !@this.walk(body->item(next), @path)) {
				return false;
			};

			@next = next + 1;
		};

		if (!path.exited() && !@this.save(@selection.breaks, @path, boundary, expression)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < selection.breaks.size()) {
		FlowState previous;

		if (!@previous.copy_from(combined) || !@this.merge(@combined, @previous, @*selection.breaks.data()[index].get(), expression)) {
			return false;
		};

		@index = index + 1;
	};

	return @state.copy_from(combined);
};

fn LifetimeAnalyzer::storage_owner(const LifetimeAnalyzer& this, const SemanticExpression& expression, FlowState& state) -> rt::optional_ref<Entity> {
	switch (expression.kind()) {
		case semantic_kind::name: {
			Entity* entity = expression.entity();

			if (!entity || entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter) {
				return rt::optional_ref<Entity>();
			};

			usize remaining = state.size();
			while (entity->type()->kind() == type_kind::reference) {
				LiveBinding* binding = @state.find(entity);

				if (!binding) {
					return rt::optional_ref<Entity>(@*entity);
				};

				if (!remaining || !binding->referent.has_value()) {
					return rt::optional_ref<Entity>();
				};

				@entity = binding->referent.get();
				@remaining = remaining - 1;
			};

			return rt::optional_ref<Entity>(@*entity);
		};
		case semantic_kind::access:
		case semantic_kind::cast:
		case semantic_kind::member:
			return this.storage_owner(*expression.item(0), @state);
		case semantic_kind::index:
			if (expression.item(0)->type()->kind() == type_kind::array) {
				return this.storage_owner(*expression.item(0), @state);
			};

			break;
		case semantic_kind::dereference:
			if (expression.item(0)->kind() == semantic_kind::address) {
				return this.storage_owner(*expression.item(0)->item(0), @state);
			};

			break;
		case semantic_kind::sequence:
			return this.storage_owner(*expression.item(2), @state);
	};

	return rt::optional_ref<Entity>();
};

fn LifetimeAnalyzer::sequence(LifetimeAnalyzer& this, SemanticExpression& expression, FlowState& state) -> bool {
	usize boundary = state.size();

	if (!@this.walk(expression.item(0), @state) || !@this.walk(expression.item(1), @state) || !@this.walk(expression.item(2), @state)) {
		return false;
	};

	if (!state.exited() && expression.category() == value_category::place) {
		var owner = this.storage_owner(*expression.item(2), @state);

		if (owner.has_value()) {
			usize index = boundary;
			while (index < state.size()) {
				LiveBinding* binding = @state.at(index);

				if (binding->entity == owner.get()) {
					return @this.error(&expression, "sequence result refers to local storage\0");
				};

				@index = index + 1;
			};
		};
	};

	@state.truncate(boundary);

	return true;
};

