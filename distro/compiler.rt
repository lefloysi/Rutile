fn Backend::external_signature(var Backend& this, var Entity* entity) -> CompilationResult {
	FunctionSignature& signature = entity->type()->signature();
	Type* result = signature.result()->representation();

	if (result->kind() == type_kind::array || result->kind() == type_kind::named) {
		var message = DiagnosticMessage();
		@message.text("external aggregate return requires unsupported C ABI lowering for function '");
		diagnostic_entity(@message, *entity);
		@message.text("' of type '");
		diagnostic_type(@message, *entity->type());
		@message.text("'; result type is '");
		diagnostic_type(@message, *signature.result());
		@message.text("'");
		return @this.error(entity->token(), message.view());
	};

	usize index = 0;

	while (index < signature.parameters().size()) {
		Type* parameter = signature.parameters().data()[index]->representation();

		if (parameter->kind() == type_kind::array || parameter->kind() == type_kind::named) {
			var message = DiagnosticMessage();
			@message.text("external aggregate parameter requires unsupported C ABI lowering for parameter ");
			@message.number(index + 1);
			@message.text(" of function '");
			diagnostic_entity(@message, *entity);
			@message.text("' of type '");
			diagnostic_type(@message, *entity->type());
			@message.text("'; parameter type is '");
			diagnostic_type(@message, *signature.parameters().data()[index]);
			@message.text("'");
			return @this.error(entity->parameters().data()[index]->token(), message.view());
		};

		@index = index + 1;
	};

};

fn FunctionEmitter::allocation_prefix(var FunctionEmitter& this, Type* type) -> u64 {
	u64 header = static_cast<u64>(this.backend->pointer_bits()) / 8;
	u64 alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.backend->layout(), @this.backend->type(type)));

	return (header + alignment - 1) / alignment * alignment;
};

fn FunctionEmitter::allocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* construction = expression->item(0);

	if (construction->kind() != semantic_kind::noop && construction->item(0)->size()) {
		var message = DiagnosticMessage();
		@message.text("array constructor argument evaluation is not specified for element type '");
		diagnostic_type(@message, *construction->type());
		@message.text("' with arguments ");
		@message.text("(");
		usize argument = 0;
		while (argument < construction->item(0)->size()) {
			if (argument) {
				@message.text(", ");
			};
			diagnostic_type(@message, *construction->item(0)->item(argument)->type());
			@argument = argument + 1;
		};
		@message.text(")");
		discard @this.backend->error(expression->token(), message.view());
		return nullptr;
	};

	Type* element = expression->item(0)->type();
	var LLVMOpaqueType* native = @this.backend->type(element, expression->token());

	if (!native) {
		return nullptr;
	};

	u32 bits = this.backend->pointer_bits();
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), bits);
	var LLVMOpaqueType* character = LLVMIntTypeInContext(this.backend->context(), 8);
	var SemanticExpression* length = expression->item(1);
	var LLVMOpaqueValue* original = @this.value(length);

	if (!original) {
		return nullptr;
	};

	bool signed_count = length->type()->representation()->kind() == type_kind::signed_integer;
	var LLVMOpaqueValue* count = LLVMBuildIntCast2(this.backend->builder(), original, integer, static_cast<i32>(signed_count), "array.count\0".data());
	u64 prefix = @this.allocation_prefix(element);
	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	u64 maximum = (u64::max) >> (64 - static_cast<u64>(bits));

	if (prefix > maximum) {
		var LLVMOpaqueType* pointer_type = @this.backend->type(variant_flow_type(expression->type(), 0), expression->token());
		return @this.allocation_result(expression, LLVMConstNull(pointer_type), LLVMConstInt(integer, maximum, 0), true);
	};

	u64 maximum_count = maximum;

	if (size) {
		@maximum_count = (maximum - prefix) / size;
	};

	var LLVMOpaqueValue* checked = count;
	var LLVMOpaqueType* checked_type = integer;

	if (length->type()->representation()->bits() > bits) {
		@checked = original;
		@checked_type = LLVMTypeOf(original);
	};

	var LLVMOpaqueValue* invalid = LLVMBuildICmp(this.backend->builder(), 34, checked, LLVMConstInt(checked_type, maximum_count, 0), "array.overflow\0".data());

	if (signed_count) {
		var LLVMOpaqueValue* negative = LLVMBuildICmp(this.backend->builder(), 40, original, LLVMConstNull(LLVMTypeOf(original)), "array.negative\0".data());
		@invalid = LLVMBuildOr(this.backend->builder(), invalid, negative, "array.invalid\0".data());
	};

	var LLVMOpaqueBasicBlock* allocate = @this.block("array.allocate");
	var LLVMOpaqueBasicBlock* initialize = @this.block("array.initialize");
	var LLVMOpaqueBasicBlock* failure = @this.block("array.failure");
	var LLVMOpaqueBasicBlock* after = @this.block("array.after");
	var LLVMOpaqueValue* bytes = LLVMBuildMul(this.backend->builder(), count, LLVMConstInt(integer, size, 0), "array.bytes\0".data());
	@bytes = LLVMBuildAdd(this.backend->builder(), bytes, LLVMConstInt(integer, prefix, 0), "array.storage.bytes\0".data());
	var LLVMOpaqueValue* requested_bytes = LLVMBuildSelect(this.backend->builder(), invalid, LLVMConstInt(integer, maximum, 0), bytes, "array.requested.bytes\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), invalid, failure, allocate);
	LLVMPositionBuilderAtEnd(this.backend->builder(), allocate);
	var LLVMOpaqueValue* memory = @this.native_allocate(bytes);
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, memory, LLVMConstNull(LLVMTypeOf(memory)), "array.exists\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), exists, initialize, failure);
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);
	bool uninitialized = construction->kind() == semantic_kind::noop;
	var LLVMOpaqueValue* initialized_count = count;
	if (uninitialized) {
		@initialized_count = LLVMConstNull(integer);
	};
	discard LLVMBuildStore(this.backend->builder(), initialized_count, memory);
	var LLVMOpaqueValue* offset = LLVMConstInt(integer, prefix, 0);
	var LLVMOpaqueValue* data = LLVMBuildGEP2(this.backend->builder(), character, memory, &@offset, 1, "array.data\0".data());
	usize unwind_begin = this.unwinds.size();
	var LLVMOpaqueValue* constructed = @this.native_slot(integer);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(integer), constructed);
	@this.retain_unwind(element, data, constructed, memory);
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block("array.construct.test");
	var LLVMOpaqueBasicBlock* body = @this.block("array.construct.element");
	var LLVMOpaqueBasicBlock* done = @this.block("array.construct.done");
	discard LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "array.index\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, initialized_count, "array.within\0".data()), body, done);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue* address = LLVMBuildGEP2(this.backend->builder(), native, data, &@index, 1, "array.element\0".data());

	if (!uninitialized) {
		if (!(@this.construct_into(construction, address)).has<void>()) {
			return nullptr;
		};
	};

	var LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "array.next\0".data());
	discard LLVMBuildStore(this.backend->builder(), next, constructed);
	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	discard LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), done);
	@this.forget_unwinds(unwind_begin);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), failure);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	var LLVMOpaqueType* pointer_type = @this.backend->type(variant_flow_type(expression->type(), 0), expression->token());
	var LLVMOpaqueValue* result = LLVMBuildPhi(this.backend->builder(), pointer_type, "array.result\0".data());
	@values[0] = data;
	@values[1] = LLVMConstNull(pointer_type);
	@blocks[0] = done;
	@blocks[1] = failure;
	LLVMAddIncoming(result, &@values[0], &@blocks[0], 2);

	return @this.allocation_result(expression, result, requested_bytes, true);
};

fn FunctionEmitter::deallocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* operand = expression->item(0);
	Type* element = operand->type()->element();

	if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::function) {
		var message = DiagnosticMessage();
		@message.text("array deallocation requires a supported object layout for element type '");
		diagnostic_type(@message, *element);
		@message.text("'");
		discard @this.backend->error(expression->token(), message.view());
		return nullptr;
	};

	var LLVMOpaqueValue* data = @this.value(operand);

	if (!data) {
		return nullptr;
	};

	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	var LLVMOpaqueBasicBlock* dispose = @this.block("array.delete");
	var LLVMOpaqueBasicBlock* after = @this.block("array.delete.after");
	discard LLVMBuildCondBr(this.backend->builder(), @this.truth(data, operand->type()), dispose, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), dispose);
	var LLVMOpaqueValue* offset = LLVMConstInt(integer, 0 - @this.allocation_prefix(element), 1);
	var LLVMOpaqueValue* memory = LLVMBuildGEP2(this.backend->builder(), LLVMIntTypeInContext(this.backend->context(), 8), data, &@offset, 1, "array.base\0".data());
	var LLVMOpaqueValue* count = LLVMBuildLoad2(this.backend->builder(), integer, memory, "array.count\0".data());
	usize unwind_begin = this.unwinds.size();
	@this.retain_unwind(element, nullptr, nullptr, memory);

	if (!(@this.destroy_range(element, data, count)).has<void>()) {
		return nullptr;
	};
	@this.forget_unwinds(unwind_begin);

	var LLVMOpaqueValue* result = @this.native_free(memory);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return result;
};

fn FunctionEmitter::destroy_range(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* memory, var LLVMOpaqueValue* count) -> CompilationResult {
	if (!FunctionEmitter::needs_destruction(type)) {
		return;
	};

	var LLVMOpaqueType* integer = LLVMTypeOf(count);
	usize unwind_begin = this.unwinds.size();
	var LLVMOpaqueValue* pending;
	if (!this.unwind_depth) {
		@pending = @this.native_slot(integer);
		discard LLVMBuildStore(this.backend->builder(), count, pending);
		@this.retain_unwind(type, memory, pending, nullptr);
	};
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block("array.destroy.test");
	var LLVMOpaqueBasicBlock* body = @this.block("array.destroy.element");
	var LLVMOpaqueBasicBlock* after = @this.block("array.destroy.after");
	discard LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* remaining = LLVMBuildPhi(this.backend->builder(), integer, "array.remaining\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 33, remaining, LLVMConstNull(integer), "array.remaining.truth\0".data()), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue* previous = LLVMBuildSub(this.backend->builder(), remaining, LLVMConstInt(integer, 1, 0), "array.previous\0".data());
	if (pending) {
		discard LLVMBuildStore(this.backend->builder(), previous, pending);
	};
	var LLVMOpaqueValue* element = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), memory, &@previous, 1, "array.destroy.address\0".data());

	if (!(@this.destroy(type, element)).has<void>()) {
		return compilation_error();
	};

	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	discard LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = count;
	@values[1] = previous;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(remaining, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	@this.forget_unwinds(unwind_begin);

};

struct NativeType {
	Type* source;
	var LLVMOpaqueType* value;
};

struct NativeEntity {
	var Entity* source;
	var LLVMOpaqueValue* value;
	var LLVMOpaqueValue* implementation;
};

struct NativeTable {
	var Entity* source;
	var LLVMOpaqueValue* value;
};

struct Backend {
	fn Backend(var Backend& this, var Diagnostics& diagnostics);

	fn ~Backend(var Backend& this);

	fn set_progress(var Backend& this, CompilerProgress progress);
	fn initialize(var Backend& this, i32 optimization) -> CompilationResult;
	fn emit(var Backend& this, SemanticUnit& unit, rt::string_view entry, output_kind output) -> CompilationResult;
	fn write(var Backend& this, var File& output) -> CompilationResult;

	fn pointer_bits(Backend& this) -> u32;
	fn type(var Backend& this, Type* source) -> var LLVMOpaqueType*;
	fn type(var Backend& this, Type* source, Token& origin) -> var LLVMOpaqueType*;
	fn symbol(Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn implementation(Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn table(var Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn exception_type(var Backend& this, Type* type) -> var LLVMOpaqueValue*;
	fn exception_info(var Backend& this, Type* type) -> var LLVMOpaqueValue*;
	fn field_index(Backend& this, var Entity* entity, usize index) -> u32;

	fn context(Backend& this) -> var LLVMOpaqueContext*;
	fn module(Backend& this) -> var LLVMOpaqueModule*;
	fn builder(Backend& this) -> var LLVMOpaqueBuilder*;
	fn layout(Backend& this) -> var LLVMOpaqueTargetData*;

	fn error(var Backend& this, Token& token, rt::string_view message) -> CompilationResult;
	fn note(var Backend& this, Token& token, rt::string_view message);
	fn failed(Backend& this) -> bool;
	fn declare_fact_contexts(var Backend& this, InferredContextSet& contexts) -> CompilationResult;
	fn emit_fact_contexts(var Backend& this) -> CompilationResult;
	fn fact_context(Backend& this, usize context) -> var InferredFunctionContext*;
	fn fact_symbol(Backend& this, usize context) -> var LLVMOpaqueValue*;
	fn redirected_call(Backend& this, SemanticExpression& call, InferredFunctionContext* context) -> var LLVMOpaqueValue*;

private:
	fn verify(var Backend& this);
	fn optimize(var Backend& this);

	fn declare(var Backend& this, var Entity* entity) -> CompilationResult;
	fn required(Backend& this, var Entity* entity) -> bool;
	fn external_signature(var Backend& this, var Entity* entity) -> CompilationResult;

	fn emit_dispatch(var Backend& this, var Entity* entity) -> CompilationResult;
	fn dispatch_target(var Backend& this, var Entity* entity, var LLVMOpaqueValue* receiver) -> var LLVMOpaqueValue*;
	fn entry(var Backend& this, var Entity* entity) -> CompilationResult;
	fn register_lifecycle(var Backend& this, var LLVMOpaqueValue* function, rt::string_view name);

	var Diagnostics* diagnostics;
	var Entity* selected_entry;
	CompilerProgress progress;
	i32 optimization;
	rt::unique<LLVMOpaqueContext, ContextDisposer> native_context;
	rt::unique<LLVMOpaqueTargetMachine, MachineDisposer> native_machine;
	rt::unique<LLVMOpaqueModule, ModuleDisposer> native_module;
	rt::unique<LLVMOpaqueBuilder, BuilderDisposer> native_builder;
	rt::unique<LLVMOpaqueTargetData, LayoutDisposer> native_layout;
	rt::buffer<NativeType> types;
	rt::buffer<NativeEntity> entities;
	rt::buffer<NativeTable> tables;
	InferredContextSet* fact_context_set;
	rt::buffer<var LLVMOpaqueValue*> fact_symbols;
};

fn Backend::Backend(var Backend& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn Backend::~Backend(var Backend& this) {
	@this.native_layout.reset(nullptr);
	@this.native_builder.reset(nullptr);
	@this.native_module.reset(nullptr);
	@this.native_machine.reset(nullptr);
	@this.native_context.reset(nullptr);
};

fn Backend::context(Backend& this) -> var LLVMOpaqueContext* {
	return this.native_context.get();
};

fn Backend::module(Backend& this) -> var LLVMOpaqueModule* {
	return this.native_module.get();
};

fn Backend::builder(Backend& this) -> var LLVMOpaqueBuilder* {
	return this.native_builder.get();
};

fn Backend::layout(Backend& this) -> var LLVMOpaqueTargetData* {
	return this.native_layout.get();
};

fn Backend::failed(Backend& this) -> bool {
	return this.diagnostics->failed();
};

fn Backend::error(var Backend& this, Token& token, rt::string_view message) -> CompilationResult {
	@this.diagnostics->error(token, message);
	return compilation_error();
};

fn Backend::pointer_bits(Backend& this) -> u32 {
	if (!this.native_layout.get()) {
		return 0;
	};

	return LLVMPointerSize(this.native_layout.get()) * 8;
};

fn Backend::initialize(var Backend& this, i32 optimization) -> CompilationResult {
	Token location;

	if (optimization < 0 || optimization > 3) {
		return @this.error(location, "optimization level must be between 0 and 3");
	};

	@this.optimization = $optimization;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&@major, &@minor, &@patch);

	if (major != 21 || minor != 1 || patch != 0) {
		compiler_panic("LLVM runtime version must be 21.1.0");
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.native_context.reset(LLVMContextCreate());

	if (!this.context()) {
		compiler_panic("cannot create LLVM context");
	};

	@this.native_module.reset(LLVMModuleCreateWithNameInContext("rutile\0".data(), this.context()));
	@this.native_builder.reset(LLVMCreateBuilderInContext(this.context()));

	if (!this.module() || !this.builder()) {
		compiler_panic("cannot create LLVM module or builder");
	};

	var triple = rt::unique<char, MessageDisposer>(LLVMGetDefaultTargetTriple());

	if (!triple.get()) {
		compiler_panic("cannot obtain target triple");
	};

	var LLVMTarget* target;
	var char* failure;

	if (LLVMGetTargetFromTriple(triple.get(), &@target, &@failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		compiler_panic(rt::from_c_string(message.get()));
	};

	@this.native_machine.reset(LLVMCreateTargetMachine(target, triple.get(), "generic\0".data(), "\0".data(), i32(this.optimization), 2, 0));

	if (!this.native_machine.get()) {
		compiler_panic("cannot create target machine");
	};

	@this.native_layout.reset(LLVMCreateTargetDataLayout(this.native_machine.get()));

	if (!this.layout()) {
		compiler_panic("cannot create target layout");
	};

	var layout = rt::unique<char, MessageDisposer>(LLVMCopyStringRepOfTargetData(this.layout()));

	if (!layout.get()) {
		compiler_panic("cannot describe target layout");
	};

	LLVMSetTarget(this.module(), triple.get());
	LLVMSetDataLayout(this.module(), layout.get());

};

fn Backend::verify(var Backend& this) {
	var char* failure;

	if (!LLVMVerifyModule(this.module(), 2, &@failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return;
	};

	var message = rt::unique<char, MessageDisposer>(failure);

	compiler_panic(rt::from_c_string(message.get()));
};

fn Backend::optimize(var Backend& this) {
	@this.verify();

	var options = rt::unique<LLVMOpaquePassBuilderOptions, PassOptionsDisposer>(LLVMCreatePassBuilderOptions());

	if (!options.get()) {
		compiler_panic("cannot create optimization options");
	};

	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 0);
	rt::string_view pipeline = "default<O0>";

	switch (this.optimization) {
		case 1:
			@pipeline = "default<O1>";
			break;
		case 2:
			@pipeline = "default<O2>";
			break;
		case 3:
			@pipeline = "default<O3>";
			break;
	};

	var native_pipeline = rt::string(pipeline);
	this.progress.report("optimizing", 0, 1, pipeline);
	var LLVMOpaqueError* error = LLVMRunPasses(this.module(), native_pipeline.c_str(), this.native_machine.get(), options.get());

	if (error) {
		var message = rt::unique<char, ErrorMessageDisposer>(LLVMGetErrorMessage(error));

		compiler_panic(rt::from_c_string(message.get()));
	};

	this.progress.report("optimizing", 1, 1, pipeline);
	@this.verify();
};

fn Backend::write(var Backend& this, var File& output) -> CompilationResult {
	if (this.failed()) {
		return compilation_error();
	};

	@this.optimize();

	var LLVMOpaqueMemoryBuffer* bytes;
	var char* failure;
	Token location;

	this.progress.report("object", 0, 1, "");
	if (LLVMTargetMachineEmitToMemoryBuffer(this.native_machine.get(), this.module(), 1, &@failure, &@bytes)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		compiler_panic(rt::from_c_string(message.get()));
	};

	this.progress.report("object", 1, 1, "");
	var buffer = rt::unique<LLVMOpaqueMemoryBuffer, BufferDisposer>(bytes);
	usize byte_count = LLVMGetBufferSize(buffer.get());
	this.progress.report("writing", 0, byte_count, "");

	if (!(@output.write(rt::string_view(LLVMGetBufferStart(buffer.get()), LLVMGetBufferSize(buffer.get())))).has<void>()) {
		return @this.error(location, "cannot write native object output");
	};

	this.progress.report("writing", byte_count, byte_count, "");
};

fn Backend::note(var Backend& this, Token& token, rt::string_view message) {
	@this.diagnostics->note(token, message);
};

fn Backend::set_progress(var Backend& this, CompilerProgress progress) {
	@this.progress = $progress;
};

fn FunctionEmitter::set_fact_context(var FunctionEmitter& this, InferredFunctionContext* context) {
	@this.fact_context = context;
};

fn FunctionEmitter::integer_fact(FunctionEmitter& this, SemanticExpression& expression, var u64& value) -> bool {
	if (this.fact_context) {
		usize index = 0;
		while (index < this.fact_context->overrides.size()) {
			InferredExpressionFact& fact = this.fact_context->overrides.data()[index];
			if (fact.expression == &expression && fact.kind == inferred_override_kind::integer) {
				@value = fact.value;
				return true;
			};
			@index = index + 1;
		};
	};
	return expression.inferred_integer(@value);
};

fn FunctionEmitter::alternative_fact(FunctionEmitter& this, SemanticExpression& expression) -> u64 {
	if (this.fact_context) {
		usize index = 0;
		while (index < this.fact_context->overrides.size()) {
			InferredExpressionFact& fact = this.fact_context->overrides.data()[index];
			if (fact.expression == &expression && fact.kind == inferred_override_kind::alternative) {
				return fact.value;
			};
			@index = index + 1;
		};
	};
	return expression.inferred_alternative();
};

fn Backend::fact_context(Backend& this, usize context) -> var InferredFunctionContext* {
	if (!this.fact_context_set || !context || context > this.fact_context_set->contexts.size()) {
		return nullptr;
	};
	return this.fact_context_set->contexts.data()[context - 1].get();
};

fn Backend::fact_symbol(Backend& this, usize context) -> var LLVMOpaqueValue* {
	if (!context || context > this.fact_symbols.size()) {
		return nullptr;
	};
	return this.fact_symbols.data()[context - 1];
};

fn Backend::redirected_call(Backend& this, SemanticExpression& call, InferredFunctionContext* context) -> var LLVMOpaqueValue* {
	if (!this.fact_context_set || !call.entity() || call.entity()->dispatch() != function_dispatch::ordinary || call.size() != 2 || call.item(0)->kind() != semantic_kind::name || call.item(0)->entity() != call.entity()) {
		return nullptr;
	};
	// A context body has its own call bindings. Generic-site assumptions must
	// never leak into another emission of the same shared semantic body.
	rt::buffer<InferredCallBinding>* bindings = &this.fact_context_set->calls;
	if (context) {
		@bindings = &context->calls;
	};
	usize index = 0;
	while (index < bindings->size()) {
		InferredCallBinding& binding = bindings->data()[index];
		if (binding.expression == &call) {
			var InferredFunctionContext* target = this.fact_context(binding.context);
			if (target && target->function && target->function->canonical() == call.entity()->canonical()) {
				return this.fact_symbol(binding.context);
			};
			return nullptr;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn Backend::declare_fact_contexts(var Backend& this, InferredContextSet& contexts) -> CompilationResult {
	@this.fact_context_set = &contexts;
	@this.fact_symbols.clear();
	usize index = 0;
	while (index < contexts.contexts.size()) {
		var InferredFunctionContext* context = contexts.contexts.data()[index].get();
		if (!context || !context->function || context->function->dispatch() != function_dispatch::ordinary || !context->function->body()) {
			compiler_panic("invalid inferred function context");
		};
		DiagnosticMessage name;
		@name.text("rt.fact.");
		@name.number(u64(index + 1));
		var spelling = rt::string(name.view());
		var LLVMOpaqueType* signature = @this.type(context->function->type(), context->function->token());
		if (!signature) {
			return compilation_error();
		};
		var LLVMOpaqueValue* symbol = LLVMAddFunction(this.module(), spelling.c_str(), signature);
		LLVMSetLinkage(symbol, 9);
		@this.fact_symbols.push_back(symbol);
		@index = index + 1;
	};
};

fn Backend::emit_fact_contexts(var Backend& this) -> CompilationResult {
	if (!this.fact_context_set) {
		return;
	};
	usize index = 0;
	while (index < this.fact_context_set->contexts.size()) {
		var InferredFunctionContext* context = this.fact_context(index + 1);
		var emitter = FunctionEmitter(@this, this.fact_symbol(index + 1), context->function->type()->signature().result());
		@emitter.set_fact_context(context);
		if (!(@emitter.emit(context->function)).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn FunctionEmitter::condition_fact(FunctionEmitter& this, SemanticExpression& expression, var bool& value) -> bool {
	if (this.fact_context) {
		usize index = 0;
		while (index < this.fact_context->overrides.size()) {
			InferredExpressionFact& fact = this.fact_context->overrides.data()[index];
			if (fact.expression == &expression && fact.kind == inferred_override_kind::evaluated_condition) {
				@value = fact.value != 0;
				return true;
			};
			@index = index + 1;
		};
	};
	return expression.inferred_condition(@value);
};

fn FunctionEmitter::construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() > 1) {
		var LLVMOpaqueValue* storage = @this.address(expression);

		if (!storage) {
			return nullptr;
		};

		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "reconstructed\0".data());
	};

	var LLVMOpaqueValue* storage = @this.slot(expression->type());

	if (!storage || !(@this.construct_into(expression, storage)).has<void>()) {
		return nullptr;
	};
	@this.remember(expression, storage);

	return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "constructed\0".data());
};

fn FunctionEmitter::construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> CompilationResult {
	usize begin = this.unwinds.size();
	if (!(@this.construct_body(expression, storage)).has<void>()) {
		return compilation_error();
	};
	@this.forget_unwinds(begin);
};

fn FunctionEmitter::construct_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> CompilationResult {
	if (expression->integer()) {
		return @this.construct_variant_body(expression, storage);
	};

	Type* type = expression->type();
	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());

	if (!native) {
		return compilation_error();
	};
	if (expression->operation() == token_kind::punct_left_brace) {
		discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), storage);
		return;
	};

	var SemanticExpression* arguments = expression->item(0);
	var LLVMOpaqueValue* value = LLVMConstNull(native);
	var Entity* constructor = expression->entity();

	if (constructor) {
		if (constructor->definition() != function_definition::defaulted || constructor->parameters().size() != 2) {
			discard LLVMBuildStore(this.backend->builder(), value, storage);
		};

		rt::buffer<var LLVMOpaqueValue*> inputs;

		@inputs.push_back(storage);

		usize index = 0;

		while (index < arguments->size()) {
			var LLVMOpaqueValue* argument;

			if (constructor->parameters().data()[index + 1]->type()->kind() == type_kind::reference) {
				@argument = @this.address(arguments->item(index));
			}
			else {
				@argument = @this.value(arguments->item(index));
			};

			if (!argument) {
				return compilation_error();
			};

			@inputs.push_back(argument);

			@index = index + 1;
		};

		@index = 0;
		while (index < arguments->size()) {
			if (constructor->parameters().data()[index + 1]->type()->kind() != type_kind::reference) {
				@this.consume(arguments->item(index));
			};
			@index = index + 1;
		};
		if (!@this.native_call(@this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), (@inputs).data(), static_cast<u32>(inputs.size()))) {
			return compilation_error();
		};

		return;
	};

	if (!arguments || !arguments->size()) {
		return @this.initialize(type, storage);
	};

	if (type->kind().is_scalar() || (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type))) {
		if (!type->kind().is_scalar() && arguments->item(0)->category() == value_category::place) {
			var LLVMOpaqueValue* source = @this.address(arguments->item(0));

			if (!source) {
				return compilation_error();
			};

			return @this.copy_initialize(type, storage, source);
		};

		@value = @this.take(arguments->item(0));

		if (!value) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), value, storage);

		return;
	};

	discard LLVMBuildStore(this.backend->builder(), value, storage);
	usize index = 0;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		if (type->entity()->bases().size()) {
			var message = DiagnosticMessage();
			@message.text("base aggregate argument initialization is not implemented for type '");
			diagnostic_type(@message, *type);
			@message.text("' with argument types (");
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(", ");
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(")");
			return @this.backend->error(expression->token(), message.view());
		};

		if (type->entity()->layout() == record_layout::overlapping) {
			var message = DiagnosticMessage();
			@message.text("union aggregate argument selection is not implemented for type '");
			diagnostic_type(@message, *type);
			@message.text("' with argument types (");
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(", ");
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(")");
			return @this.backend->error(expression->token(), message.view());
		};

		if (!(@this.initialize_dispatch(type, storage)).has<void>()) {
			return compilation_error();
		};

		while (index < type->entity()->fields().size()) {
			var Entity* field = type->entity()->fields().data()[index];
			var LLVMOpaqueValue* destination = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(type->entity(), index), "aggregate.field\0".data());

			if (!(@this.initialize_value(field->type(), destination, arguments->item(index))).has<void>()) {
				return compilation_error();
			};
			@this.retain_unwind(field->type(), destination, nullptr, nullptr);

			@index = index + 1;
		};

		return;
	};

	while (index < arguments->size()) {
		var LLVMOpaqueValue* element = @this.take(arguments->item(index));

		if (!element) {
			return compilation_error();
		};

		@value = LLVMBuildInsertValue(this.backend->builder(), value, element, static_cast<u32>(index), "aggregate\0".data());
		@index = index + 1;
	};

	discard LLVMBuildStore(this.backend->builder(), value, storage);

};

fn FunctionEmitter::allocation_result(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* pointer, var LLVMOpaqueValue* bytes, bool array) -> var LLVMOpaqueValue* {
	Type* type = expression->type();
	var Entity* record = type->entity();
	var Entity* storage_field = record->find_member("_storage");
	var Entity* index_field = record->find_member("_index");
	Type* error_type = variant_flow_type(type, 1);
	if (!storage_field || !index_field || !error_type) {
		discard @this.backend->error(expression->token(), "allocation result requires pointer and allocation_error alternatives");
		return nullptr;
	};
	var Entity* requested_field = error_type->entity()->find_member("requested_bytes");
	var Entity* kind_field = error_type->entity()->find_member("kind");
	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	var LLVMOpaqueType* error_native = @this.backend->type(error_type, expression->token());
	var LLVMOpaqueType* tag_type = @this.backend->type(index_field->type(), expression->token());
	if (!requested_field || !kind_field || !native || !error_native || !tag_type) {
		discard @this.backend->error(expression->token(), "allocation_error requires requested_bytes and kind fields");
		return nullptr;
	};
	rt::string_view kind_name = "single";
	if (array) {
		@kind_name = "array";
	};
	var Entity* category = kind_field->type()->entity()->members()->local(kind_name);
	if (!category) {
		discard @this.backend->error(expression->token(), "allocation_kind requires single and array enumerators");
		return nullptr;
	};
	var LLVMOpaqueValue* result = @this.slot(type);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), result);
	var LLVMOpaqueValue* payload = LLVMBuildStructGEP2(this.backend->builder(), native, result, this.backend->field_index(record, storage_field->index()), "allocation.payload\0".data());
	var LLVMOpaqueValue* tag = LLVMBuildStructGEP2(this.backend->builder(), native, result, this.backend->field_index(record, index_field->index()), "allocation.tag\0".data());
	var LLVMOpaqueBasicBlock* success = @this.block("allocation.success");
	var LLVMOpaqueBasicBlock* failure = @this.block("allocation.failure");
	var LLVMOpaqueBasicBlock* after = @this.block("allocation.after");
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, pointer, LLVMConstNull(LLVMTypeOf(pointer)), "allocation.exists\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), exists, success, failure);
	LLVMPositionBuilderAtEnd(this.backend->builder(), success);
	discard LLVMBuildStore(this.backend->builder(), pointer, payload);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(tag_type, 1, 0), tag);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), failure);
	if (!(@this.initialize(error_type, payload)).has<void>()) {
		return nullptr;
	};
	var LLVMOpaqueValue* requested = LLVMBuildStructGEP2(this.backend->builder(), error_native, payload, this.backend->field_index(error_type->entity(), requested_field->index()), "allocation.requested\0".data());
	discard LLVMBuildStore(this.backend->builder(), bytes, requested);
	var LLVMOpaqueValue* kind = LLVMBuildStructGEP2(this.backend->builder(), error_native, payload, this.backend->field_index(error_type->entity(), kind_field->index()), "allocation.kind\0".data());
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(@this.backend->type(kind_field->type(), expression->token()), category->integer(), 0), kind);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(tag_type, 2, 0), tag);
	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	@this.remember(expression, result);
	return LLVMBuildLoad2(this.backend->builder(), native, result, "allocation.result\0".data());
};

fn FunctionEmitter::allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() != 1) {
		return @this.allocate_array(expression);
	};

	Type* element = expression->item(0)->type();
	var LLVMOpaqueType* type = @this.backend->type(element, expression->token());

	if (!type) {
		return nullptr;
	};

	var LLVMOpaqueValue* bytes = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), LLVMABISizeOfType(this.backend->layout(), type), 0);
	var LLVMOpaqueValue* pointer = @this.native_allocate(bytes);
	if (expression->item(0)->kind() == semantic_kind::noop) {
		return @this.allocation_result(expression, pointer, bytes, false);
	};
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, pointer, LLVMConstNull(LLVMTypeOf(pointer)), "new.exists\0".data());
	var LLVMOpaqueBasicBlock* initialize = @this.block("new.initialize");
	var LLVMOpaqueBasicBlock* after = @this.block("new.after");
	discard LLVMBuildCondBr(this.backend->builder(), exists, (var LLVMOpaqueBasicBlock*(initialize)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);
	usize unwind_begin = this.unwinds.size();
	@this.retain_unwind(element, nullptr, nullptr, pointer);

	if (!(@this.construct_into(expression->item(0), pointer)).has<void>()) {
		return nullptr;
	};
	@this.forget_unwinds(unwind_begin);

	discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.allocation_result(expression, pointer, bytes, false);
};

fn FunctionEmitter::conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	var SemanticExpression* condition = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = @this.truth(@this.value(condition), condition->type());

	if (!truth) {
		return compilation_error();
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* yes = @this.block("if.yes");
	var LLVMOpaqueBasicBlock* no = @this.block("if.no");
	var LLVMOpaqueBasicBlock* after = @this.block("if.after");
	discard LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(yes)), (var LLVMOpaqueBasicBlock*(no)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), yes);

	if (!(@this.scoped_statement(expression->item(1))).has<void>()) {
		return compilation_error();
	};

	bool yes_returns = this.terminated();

	if (!yes_returns) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), no);

	if (!(@this.scoped_statement(expression->item(2))).has<void>()) {
		return compilation_error();
	};

	bool no_returns = this.terminated();

	if (!no_returns) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (yes_returns && no_returns) {
		discard LLVMBuildUnreachable(this.backend->builder());
	};

};

fn FunctionEmitter::loop(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	usize scope_boundary = this.bindings.size();
	usize condition_index = 0;
	usize body_index = 1;

	if (expression->kind() == semantic_kind::for_loop) {
		if (!(@this.statement(expression->item(0))).has<void>()) {
			return compilation_error();
		};

		@condition_index = 1;
		@body_index = 3;
	};

	var LLVMOpaqueBasicBlock* test = @this.block("loop.condition");
	var LLVMOpaqueBasicBlock* body = @this.block("loop.body");
	var LLVMOpaqueBasicBlock* step = test;

	if (expression->kind() == semantic_kind::for_loop) {
		@step = @this.block("loop.step");
	};

	var LLVMOpaqueBasicBlock* after = @this.block("loop.after");
	discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	var SemanticExpression* condition = expression->item(condition_index);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0);

	if (condition && condition->kind() != semantic_kind::noop) {
		@truth = @this.truth(@this.value(condition), condition->type());
	};

	if (!truth) {
		return compilation_error();
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(temporary_boundary);
	discard LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(body)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	NativeControl loop;
	@loop.leave := after;
	@loop.resume := step;
	@loop.parent := this.active_control;
	@loop.catches = this.active_catch;
	@loop.handlers = this.active_handler;
	@loop.binding_boundary = this.bindings.size();
	@this.active_control = &@loop;
	var emitted = @this.scoped_statement(expression->item(body_index));
	@this.active_control := loop.parent;

	if (emitted.has<compilation_error>()) {
		return compilation_error();
	};

	if (!this.terminated()) {
		discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(step)));
	};

	if (expression->kind() == semantic_kind::for_loop) {
		LLVMPositionBuilderAtEnd(this.backend->builder(), step);

		if (!(@this.statement(expression->item(2))).has<void>()) {
			return compilation_error();
		};

		if (!this.terminated()) {
			discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
		};
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return;
	};
	if (expression->kind() == semantic_kind::variant_cast && expression->type()->kind() == type_kind::void_type) {
		if (@this.variant_cast_address(expression) != nullptr) {
			return;
		};
		return compilation_error();
	};

	if (this.backend->failed()) {
		return compilation_error();
	};

	switch (expression->kind()) {
		case semantic_kind::statements: {
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!(@this.statement(expression->item(index))).has<void>()) {
					return compilation_error();
				};

				@index = index + 1;
			};

			return;
		};

		case semantic_kind::sequence:
			if (expression->type()->kind() == type_kind::void_type) {
				var LLVMOpaqueValue* result;

				return @this.sequence(expression, native_evaluation::value, @result);
			};

			break;
		case semantic_kind::brace: {
			usize scope_boundary = this.bindings.size();
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!(@this.statement(expression->item(index))).has<void>()) {
					return compilation_error();
				};

				@index = index + 1;
			};

			return @this.leave_scope(scope_boundary);
		};

		case semantic_kind::variable: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueType* type = @this.backend->type(entity->type(), entity->token());

			if (!type) {
				return compilation_error();
			};

			var LLVMOpaqueValue* slot = @this.slot(entity->type());

			if (!slot) {
				return compilation_error();
			};
			@this.bind((var Entity*(entity)), (var LLVMOpaqueValue*(slot)));

			@this.binding_live(entity, false);

			if (!(@this.initialize_value(entity->type(), slot, expression->item(0))).has<void>()) {
				return compilation_error();
			};

			@this.binding_live(entity, true);
			return;
		};

		case semantic_kind::return_value: {
			if (this.result->kind() == type_kind::void_type) {
				var SemanticExpression* operand = expression->item(0);

				if (operand && operand->kind() != semantic_kind::noop && !(@this.statement(operand)).has<void>()) {
					return compilation_error();
				};
				if (this.terminated()) {
					return;
				};

				if (!(@this.exit_cleanup(0, nullptr, this.function_handler)).has<void>()) {
					return compilation_error();
				};

				discard LLVMBuildRetVoid(this.backend->builder());

				return;
			};

			var LLVMOpaqueValue* value;

			if (this.result->kind() == type_kind::reference) {
				@value = @this.address(expression->item(0));
			}
			else {
				@value = @this.take(expression->item(0));
			};

			if (!value) {
				return compilation_error();
			};

			usize unwind_begin = this.unwinds.size();
			if (FunctionEmitter::needs_destruction(this.result)) {
				var LLVMOpaqueValue* storage = @this.slot(this.result);
				if (!storage) {
					return compilation_error();
				};
				discard LLVMBuildStore(this.backend->builder(), value, storage);
				@this.retain_unwind(this.result, storage, nullptr, nullptr);
			};
			if (!(@this.exit_cleanup(0, nullptr, this.function_handler)).has<void>()) {
				return compilation_error();
			};
			@this.forget_unwinds(unwind_begin);
			discard LLVMBuildRet(this.backend->builder(), value);

			return;
		};

		case semantic_kind::conditional:
			return @this.conditional(expression);
		case semantic_kind::exception_try:
			return @this.exception_try(expression);
		case semantic_kind::exception_throw:
		case semantic_kind::exception_rethrow:
			return @this.exception_throw(expression);
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);
			if (!address) {
				return compilation_error();
			};
			@this.set_live(object, false);
			return @this.destroy(object->type(), address);
		};

		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(expression);
		case semantic_kind::switch_expression:
			return @this.selection(expression);
		case semantic_kind::break_loop:
		case semantic_kind::continue_loop: {
			var NativeControl* target = this.active_control;

			if (expression->kind() == semantic_kind::continue_loop) {
				while (target && !target->resume) {
					@target = target->parent;
				};
			};

			if (!target) {
				return @this.backend->error(expression->token(), "control transfer has no enclosing native destination");
			};

			if (!(@this.exit_cleanup(target->binding_boundary, target->catches, target->handlers)).has<void>()) {
				return compilation_error();
			};

			if (expression->kind() == semantic_kind::break_loop) {
				@target->leave_edges = target->leave_edges + 1;
				discard LLVMBuildBr(this.backend->builder(), target->leave);
			}
			else {
				discard LLVMBuildBr(this.backend->builder(), target->resume);
			};

			return;
		};
	};

	if (@this.value(expression) != nullptr) {
		return;
	};
	return compilation_error();
};

fn FunctionEmitter::statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return;
	};

	usize begin = this.temporaries.size();

	if (!(@this.lower_statement(expression)).has<void>()) {
		return compilation_error();
	};

	if (!this.terminated() && !(@this.cleanup_temporaries(begin)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(begin);

};

fn Backend::implementation(Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].implementation;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::field_index(Backend& this, var Entity* entity, usize index) -> u32 {
	return static_cast<u32>(entity->bases().size() + static_cast<usize>(entity->owns_dispatch()) + index);
};

fn Backend::table(var Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = 0;

	while (index < this.tables.size()) {
		if (this.tables.data()[index].source == entity) {
			return this.tables.data()[index].value;
		};

		@index = index + 1;
	};

	rt::buffer<var LLVMOpaqueValue*> functions;
	@index = 0;

	while (index < entity->virtual_functions().size()) {
		var Entity* function = entity->virtual_functions().data()[index];
		var LLVMOpaqueValue* implementation = this.implementation(function);

		if (!implementation) {
			discard @this.error(function->token(), "virtual implementation has no prepared native declaration");
			return nullptr;
		};

		@functions.push_back(implementation);

		@index = index + 1;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* contents = LLVMConstArray2(pointer, (@functions).data(), functions.size());
	var LLVMOpaqueValue* value = LLVMAddGlobal(this.module(), LLVMTypeOf(contents), "rt.vtable\0".data());
	LLVMSetInitializer(value, contents);
	LLVMSetGlobalConstant(value, 1);
	LLVMSetLinkage(value, 9);
	NativeTable table;
	@table.source = entity;
	@table.value = value;

	@this.tables.push_back($table);

	return value;
};

fn Backend::dispatch_target(var Backend& this, var Entity* entity, var LLVMOpaqueValue* receiver) -> var LLVMOpaqueValue* {
	var Entity* owner = entity->scope()->owner()->virtual_owner();

	if (!owner || !receiver) {
		discard @this.error(entity->token(), "virtual dispatch has no owning receiver layout");
		return nullptr;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.builder(), @this.type(owner->type()), receiver, static_cast<u32>(owner->bases().size()), "dispatch.header\0".data());
	var LLVMOpaqueValue* table = LLVMBuildLoad2(this.builder(), pointer, header, "dispatch.table\0".data());
	var LLVMOpaqueValue* index = LLVMConstInt(LLVMIntTypeInContext(this.context(), this.pointer_bits()), entity->virtual_slot(), 0);
	var LLVMOpaqueValue* slot = LLVMBuildGEP2(this.builder(), pointer, table, &@index, 1, "dispatch.slot\0".data());

	return LLVMBuildLoad2(this.builder(), pointer, slot, "dispatch.target\0".data());
};

fn Backend::emit_dispatch(var Backend& this, var Entity* entity) -> CompilationResult {
	FunctionSignature& signature = entity->type()->signature();

	if (!signature.parameters().size() || signature.parameters().data()[0]->kind() != type_kind::reference || signature.arity() == parameter_arity::variadic) {
		return @this.error(entity->token(), "virtual dispatch requires a fixed signature with an object receiver");
	};

	var LLVMOpaqueValue* function = this.symbol(entity);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), function, "entry\0".data()));
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < signature.parameters().size()) {
		@arguments.push_back(LLVMGetParam(function, static_cast<u32>(index)));

		@index = index + 1;
	};

	var LLVMOpaqueValue* target = @this.dispatch_target(entity, arguments.data()[0]);

	if (!target) {
		return compilation_error();
	};

	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), target, (@arguments).data(), static_cast<u32>(arguments.size()), "\0".data());

	if (signature.result()->kind() == type_kind::void_type) {
		discard LLVMBuildRetVoid(this.builder());
	}
	else {
		discard LLVMBuildRet(this.builder(), result);
	};

};

fn FunctionEmitter::initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	var Entity* record = type->entity();
	var Entity* owner = record->virtual_owner();

	if (!owner) {
		return;
	};

	var LLVMOpaqueValue* table = @this.backend->table(record);

	if (!table) {
		return compilation_error();
	};

	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(owner->type()), address, static_cast<u32>(owner->bases().size()), "initialize.dispatch\0".data());
	discard LLVMBuildStore(this.backend->builder(), table, header);

};

fn Backend::entry(var Backend& this, var Entity* entity) -> CompilationResult {
	FunctionSignature& signature = entity->type()->signature();
	bool runtime_entry = entity->name() == "__rutile_runtime_main" || entity->name() == "__rutile_test_main";

	if ((!runtime_entry && signature.parameters().size()) || (signature.result()->kind() != type_kind::void_type && !signature.result()->kind().is_integer())) {
		var message = DiagnosticMessage();
		@message.text("executable entry '");
		diagnostic_entity(@message, *entity);
		@message.text("' requires no parameters and an integer or void result; declared signature is '");
		diagnostic_type(@message, *entity->type());
		@message.text("'");
		return @this.error(entity->token(), message.view());
	};

	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.context(), 32);
	var LLVMOpaqueType*[2] parameters {};
	@parameters[0] = integer;
	@parameters[1] = LLVMPointerTypeInContext(this.context(), 0);
	u32 parameter_count = 0;
	if (runtime_entry) {
		@parameter_count = 2;
	};
	var LLVMOpaqueType* type = LLVMFunctionType((var LLVMOpaqueType*(integer)), &@parameters[0], parameter_count, 0);
	if (LLVMGetNamedFunction(this.module(), "main\0".data()) || LLVMGetNamedGlobal(this.module(), "main\0".data())) {
		return @this.error(entity->token(), "generated executable entry conflicts with the native symbol 'main'");
	};
	var LLVMOpaqueValue* main = LLVMAddFunction(this.module(), "main\0".data(), type);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), main, "entry\0".data()));
	var LLVMOpaqueValue*[2] arguments {};
	if (runtime_entry) {
		@arguments[0] = LLVMGetParam(main, 0);
		@arguments[1] = LLVMGetParam(main, 1);
	};
	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), this.symbol(entity), &@arguments[0], parameter_count, "\0".data());

	if (signature.result()->kind() == type_kind::void_type) {
		@result = LLVMConstInt(integer, 0, 0);
	}
	else if (@this.type(signature.result()) != integer) {
		u32 bits = signature.result()->bits();

		if (signature.result()->kind() == type_kind::boolean) {
			@bits = 1;
		};

		if (signature.result()->kind() == type_kind::character) {
			@bits = 8;
		};

		if (bits > 32) {
			@result = LLVMBuildTrunc(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		}
		else if (signature.result()->kind() == type_kind::unsigned_integer || signature.result()->kind() == type_kind::boolean) {
			@result = LLVMBuildZExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		}
		else {
			@result = LLVMBuildSExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0".data());
		};
	};

	discard LLVMBuildRet(this.builder(), result);

};

fn Backend::emit(var Backend& this, SemanticUnit& unit, rt::string_view entry, output_kind output) -> CompilationResult {
	if (output != output_kind::library) {
		if (output == output_kind::tests) {
			@entry = "__rutile_test_main";
		};
		var Entity* selected = unit.root_scope()->lookup(entry);

		if (!selected || selected->kind() != entity_kind::function || !selected->body() || selected->body()->kind() == semantic_kind::noop) {
			Token location;
			var message = DiagnosticMessage();
			@message.text("executable entry ");
			@message.quoted(entry);
			@message.text(" requires a defined function; ");
			if (!selected) {
				@message.text("the requested name is not declared");
			}
			else {
				@location = selected->token();
				@message.text("selected declaration is ");
				diagnostic_entity_kind(@message, selected->kind());
				@message.text(" '");
				diagnostic_entity(@message, *selected);
				@message.text("'");
				if (selected->kind() == entity_kind::function) {
					@message.text(" of type '");
					diagnostic_type(@message, *selected->type());
					@message.text("' without a definition");
				};
			};
			return @this.error(location, message.view());
		};

		@this.selected_entry = selected->canonical();
	};

	this.progress.report("declaring", 0, unit.entities().size(), "");
	usize index = 0;

	while (index < unit.entities().size()) {
		if (!(@this.declare(unit.entities().data()[index].get())).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("declaring", index, unit.entities().size(), "");
	};

	usize function_count = 0;
	if (!(@this.declare_fact_contexts(unit.fact_contexts())).has<void>()) {
		return compilation_error();
	};
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			@function_count = function_count + 1;
		};

		@index = index + 1;
	};

	this.progress.report("functions", 0, function_count, "");
	@index = 0;
	usize compiled_functions = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			var emitter = FunctionEmitter(@this, this.implementation(entity), entity->type()->signature().result());
			DiagnosticMessage detail;
			diagnostic_entity(@detail, *entity);
			this.progress.report("compiling-function", compiled_functions, function_count, detail.view());

			if (!(@emitter.emit(entity)).has<void>()) {
				if (!this.failed()) {
					DiagnosticMessage failure;
					@failure.text("native emission failed without a diagnostic while compiling '");
					diagnostic_entity(@failure, *entity);
					@failure.text("'");
					compiler_panic(failure.view());
				};
				return compilation_error();
			};

			@compiled_functions = compiled_functions + 1;
			this.progress.report("compiling-function", compiled_functions, function_count, detail.view());
		};

		@index = index + 1;
	};

	if (!(@this.emit_fact_contexts()).has<void>()) {
		return compilation_error();
	};
	this.progress.report("dispatch", 0, unit.entities().size(), "");
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && !entity->imported_definition() && entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary && !(@this.emit_dispatch(entity)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
		this.progress.report("dispatch", index, unit.entities().size(), "");
	};

	var LLVMOpaqueValue* initialize;
	this.progress.report("initializing", 0, unit.entities().size(), "");
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && !entity->imported_definition() && entity->kind() == entity_kind::global) {
			if (!initialize) {
				@initialize = LLVMAddFunction(this.module(), "rt.initialize\0".data(), LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage((var LLVMOpaqueValue*(initialize)), 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), (var LLVMOpaqueValue*(initialize)), "entry\0".data()));
			};

			var emitter = FunctionEmitter(@this, (var LLVMOpaqueValue*(initialize)), nullptr);

			if (!(@emitter.initialize_value(entity->type(), this.symbol(entity), entity->body())).has<void>() || !(@emitter.finish_expression()).has<void>()) {
				return compilation_error();
			};
		};

		@index = index + 1;
		this.progress.report("initializing", index, unit.entities().size(), "");
	};

	if (initialize) {
		discard LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(initialize, "llvm.global_ctors");
	};

	var LLVMOpaqueValue* finalize;
	@index = unit.entities().size();

	while (index) {
		@index = index - 1;
		var Entity* entity = unit.entities().data()[index].get();
		this.progress.report("finalizing", unit.entities().size() - index, unit.entities().size(), "");

		if (entity->canonical() == entity && !entity->imported_definition() && entity->kind() == entity_kind::global && FunctionEmitter::needs_destruction(entity->type())) {
			if (!finalize) {
				@finalize = LLVMAddFunction(this.module(), "rt.finalize\0".data(), LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage(finalize, 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), finalize, "entry\0".data()));
			};

			var emitter = FunctionEmitter(@this, finalize, nullptr);

			if (!(@emitter.destroy(entity->type(), this.symbol(entity))).has<void>()) {
				return compilation_error();
			};
		};
	};

	if (finalize) {
		discard LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(finalize, "llvm.global_dtors");
	};

	if (output != output_kind::library) {
		if (!(@this.entry(this.selected_entry)).has<void>()) {
			return compilation_error();
		};
	};

	u32 unwind_kind = LLVMGetEnumAttributeKindForName("uwtable\0".data(), 7);
	var LLVMOpaqueAttributeRef* unwind = LLVMCreateEnumAttribute(this.context(), $unwind_kind, 2);
	var LLVMOpaqueValue* function = LLVMGetFirstFunction(this.module());
	while (function) {
		if (LLVMCountBasicBlocks(function)) {
			LLVMAddAttributeAtIndex(function, u32::max, unwind);
		};
		@function = LLVMGetNextFunction(function);
	};
	@this.verify();
};

fn Backend::register_lifecycle(var Backend& this, var LLVMOpaqueValue* function, rt::string_view name) {
	var LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(this.context(), 32);
	@fields[1] = LLVMPointerTypeInContext(this.context(), 0);
	@fields[2] := fields[1];
	var LLVMOpaqueType* record = LLVMStructTypeInContext(this.context(), &@fields[0], 3, 0);
	var LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt((var LLVMOpaqueType*(fields[0])), 65535, 0);
	@values[1] = function;
	@values[2] = LLVMConstNull((var LLVMOpaqueType*(fields[2])));
	var LLVMOpaqueValue*[1] records {};
	@records[0] = LLVMConstNamedStruct((var LLVMOpaqueType*(record)), &@values[0], 3);
	var native_name = rt::string(name);
	var LLVMOpaqueValue* global = LLVMAddGlobal(this.module(), LLVMArrayType2((var LLVMOpaqueType*(record)), 1), native_name.c_str());
	LLVMSetInitializer(global, LLVMConstArray2(record, &@records[0], 1));
	LLVMSetLinkage(global, 7);
};



// Microsoft x64 exception metadata follows the platform C++ runtime ABI.
struct NativeExceptionBase {
	Type* type;
	u64 offset;
};

struct NativeExceptionNames {
	rt::buffer<rt::string> names;
	rt::buffer<Type*> arguments;
};

fn native_exception_source_name(var NativeExceptionNames& context, rt::string_view source, var rt::string& name) {
	usize index = 0;
	while (index < context.names.size()) {
		if (context.names.data()[index].view() == source) {
			char code = static_cast<char>(u32('0') + static_cast<u32>(index));
			@name.append(rt::string_view(&code, 1));
			return;
		};
		@index = index + 1;
	};
	if (context.names.size() < 10) {
		@context.names.push_back(rt::string(source));
	};
	@name.append(source);
	@name.append("@");
};

fn native_exception_number(u64 value, var rt::string& name) {
	if (!value) {
		@name.append("A@");
		return;
	};
	if (value <= 10) {
		char digit = static_cast<char>(u64('0') + value - 1);
		@name.append(rt::string_view(&digit, 1));
		return;
	};
	char[16] digits {};
	usize count = 0;
	while (value) {
		@digits[count] = static_cast<char>(u64('A') + (value & 15));
		@count = count + 1;
		@value = value >> 4;
	};
	while (count) {
		@count = count - 1;
		@name.append(rt::string_view(&digits[count], 1));
	};
	@name.append("@");
};

fn native_exception_template_argument(var NativeExceptionNames& context, TemplateArgument& argument, var rt::string& name) -> CompilationResult {
	if (argument.kind == template_argument_kind::pack) {
		if (!argument.pack) {
			return compilation_error();
		};
		@name.append("$$P");
		native_exception_number(argument.pack->elements.size(), @name);
		usize index = 0;
		while (index < argument.pack->elements.size()) {
			if (!native_exception_template_argument(@context, argument.pack->elements.data()[index], @name).has<void>()) {
				return compilation_error();
			};
			@index = index + 1;
		};
		@name.append("$$E");
		return;
	};
	if (argument.kind == template_argument_kind::type) {
		return native_exception_encoding(@context, argument.type, @name, false, true);
	};
	if (argument.type && argument.type->kind() == type_kind::floating_point) {
		f64 real = argument.real_value;
		u64 bits = *reinterpret_cast<u64*>(&real);
		@name.append("$$R");
		if (!native_exception_encoding(@context, argument.type, @name, false, true).has<void>()) {
			return compilation_error();
		};
		native_exception_number(bits, @name);
		return;
	};
	@name.append("$0");
	u64 value = argument.value;
	if (argument.type && argument.type->kind() == type_kind::signed_integer && argument.type->signed_value(value) < 0) {
		@name.append("?");
		@value = u64(0) - static_cast<u64>(argument.type->signed_value(value));
	}
	else if (static_cast<i64>(value) < 0) {
		@name.append("?");
		@value = u64(0) - value;
	};
	native_exception_number(value, @name);
};

fn native_exception_template(var Entity& entity, var rt::string& name) -> CompilationResult {
	TemplateInstantiation* instance = entity.template_arguments();
	if (!instance) {
		return compilation_error();
	};
	if (!instance->pattern) {
		return compilation_error();
	};
	@name.append("?$");
	var context = NativeExceptionNames();
	native_exception_source_name(@context, instance->pattern->name(), @name);
	usize index = 0;
	while (index < instance->arguments.size()) {
		TemplateArgument& argument = instance->arguments.data()[index];
		if (!native_exception_template_argument(@context, argument, @name).has<void>()) {
			return compilation_error();
		};
		@index = index + 1;
	};
};

fn native_exception_encoding(var NativeExceptionNames& context, Type* type, var rt::string& name, bool result, bool escape) -> CompilationResult {
	if (type->kind() == type_kind::reference) {
		if (type->element()->kind() == type_kind::function) {
			@name.append("A6");
			return native_exception_function(@context, type->element(), @name);
		};
		@name.append("AE");
		if (type->element()->qualifier() == type_qualifier::immutable) {
			@name.append("B");
		}
		else {
			@name.append("A");
		};
		return native_exception_encoding(@context, type->element(), @name, false, false);
	};
	if (escape && type->qualifier() == type_qualifier::immutable && type->kind() != type_kind::pointer && type->kind() != type_kind::array) {
		@name.append("$$CB");
	};
	if (result && type->qualifier() == type_qualifier::immutable && type->kind() != type_kind::named && type->kind() != type_kind::pointer && type->kind() != type_kind::array && type->kind() != type_kind::function) {
		@name.append("?B");
	};
	switch (type->kind()) {
		case type_kind::void_type:
			@name.append("X");
			return;
		case type_kind::boolean:
			@name.append("_N");
			return;
		case type_kind::character:
			@name.append("D");
			return;
		case type_kind::signed_integer:
			switch (type->bits()) {
				case 8:
					@name.append("C");
					return;
				case 16:
					@name.append("F");
					return;
				case 32:
					@name.append("H");
					return;
				case 64:
					@name.append("_J");
					return;
			};
			return compilation_error();
		case type_kind::unsigned_integer:
			switch (type->bits()) {
				case 8:
					@name.append("E");
					return;
				case 16:
					@name.append("G");
					return;
				case 32:
					@name.append("I");
					return;
				case 64:
					@name.append("_K");
					return;
			};
			return compilation_error();
		case type_kind::floating_point:
			if (type->bits() == 32) {
				@name.append("M");
				return;
			};
			@name.append("N");
			return;
		case type_kind::pointer: {
			if (type->element()->kind() == type_kind::null_type) {
				@name.append("$$T");
				return;
			};
			if (type->element()->kind() == type_kind::function) {
				if (type->qualifier() == type_qualifier::immutable) {
					@name.append("Q6");
				}
				else {
					@name.append("P6");
				};
				return native_exception_function(@context, type->element(), @name);
			};
			if (type->qualifier() == type_qualifier::immutable) {
				@name.append("QE");
			}
			else {
				@name.append("PE");
			};
			if (type->element()->qualifier() == type_qualifier::immutable) {
				@name.append("B");
			}
			else {
				@name.append("A");
			};
			return native_exception_encoding(@context, type->element(), @name, false, false);
		};
		case type_kind::function:
			@name.append("$$A6");
			return native_exception_function(@context, type, @name);
		case type_kind::array: {
			if ((result || escape)) {
				@name.append("$$B");
			};
			@name.append("Y");
			usize dimensions = 0;
			Type* element = type;
			while (element->kind() == type_kind::array) {
				@dimensions = dimensions + 1;
				@element = element->element();
			};
			native_exception_number(static_cast<u64>(dimensions), @name);
			@element = type;
			while (element->kind() == type_kind::array) {
				native_exception_number(element->count(), @name);
				@element = element->element();
			};
			if (type->qualifier() == type_qualifier::immutable) {
				var qualified = element->qualified(type_qualifier::immutable);
				return native_exception_encoding(@context, &qualified, @name, false, true);
			};
			return native_exception_encoding(@context, element, @name, false, true);
		};
		case type_kind::named: {
			var Entity* entity = type->entity();
			if (!entity) {
				return compilation_error();
			};
			if (result) {
				if (type->qualifier() == type_qualifier::immutable) {
					@name.append("?B");
				}
				else {
					@name.append("?A");
				};
			};
			if (entity->kind() == entity_kind::enumeration) {
				@name.append("W4");
			}
			else if (entity->layout() == record_layout::overlapping) {
				@name.append("T");
			}
			else {
				@name.append("U");
			};
			while (entity) {
				if (entity->template_arguments()) {
					var template_name = rt::string();
					if (!native_exception_template(@*entity, @template_name).has<void>()) {
						return compilation_error();
					};
					native_exception_source_name(@context, template_name.view(), @name);
				}
				else {
					native_exception_source_name(@context, entity->name(), @name);
				};
				var Scope* scope = entity->scope();
				@entity = nullptr;
				while (scope && !entity) {
					@entity = scope->owner();
					@scope = scope->parent();
				};
			};
			@name.append("@");
			return;
		};
		default:
			return compilation_error();
	};
};

fn native_exception_name(Type* type, var rt::string& name) -> CompilationResult {
	var context = NativeExceptionNames();
	while (type->kind() == type_kind::reference) {
		@type = type->element();
	};
	var normalized = type->qualified(type_qualifier::mutable);
	if (type->kind() == type_kind::pointer) {
		var element = type->element()->qualified(type_qualifier::mutable);
		TypeShape shape;
		@shape.element = &element;
		var pointer = Type(type_kind::pointer, $shape);
		return native_exception_encoding(@context, &pointer, @name, true, false);
	};
	return native_exception_encoding(@context, &normalized, @name, true, false);
};

fn native_exception_function(var NativeExceptionNames& context, Type* type, var rt::string& name) -> CompilationResult {
	FunctionSignature& signature = type->signature();
	@name.append("A");
	if (!native_exception_encoding(@context, signature.result(), @name, true, false).has<void>()) {
		return compilation_error();
	};
	usize index = 0;
	while (index < signature.parameters().size()) {
		Type* parameter = signature.parameters().data()[index];
		usize previous = 0;
		while (previous < context.arguments.size() && !parameter->equals(*context.arguments.data()[previous])) {
			@previous = previous + 1;
		};
		if (previous < context.arguments.size()) {
			char digit = static_cast<char>(u32('0') + static_cast<u32>(previous));
			@name.append(rt::string_view(&digit, 1));
		}
		else {
			usize begin = name.size();
			if (!native_exception_encoding(@context, parameter, @name, false, false).has<void>()) {
				return compilation_error();
			};
			if (name.size() - begin > 1 && context.arguments.size() < 10) {
				@context.arguments.push_back(parameter);
			};
		};
		@index = index + 1;
	};
	if (signature.arity() == parameter_arity::variadic) {
		@name.append("Z");
	}
	else if (!signature.parameters().size()) {
		@name.append("X");
	}
	else {
		@name.append("@");
	};
	if (signature.nonthrowing()) {
		@name.append("_E");
		return;
	};
	@name.append("Z");
};

fn native_exception_function_pointer_descriptor(var Backend& backend, Type* pointer, bool nonthrowing) -> var LLVMOpaqueValue* {
	if (pointer->kind() != type_kind::pointer || pointer->element()->kind() != type_kind::function) {
		return nullptr;
	};
	FunctionSignature& source = pointer->element()->signature();
	rt::buffer<Type*> parameters;
	usize index = 0;
	while (index < source.parameters().size()) {
		@parameters.push_back(source.parameters().data()[index]);
		@index = index + 1;
	};
	var signature = FunctionSignature(source.result(), $parameters, source.arity(), nonthrowing);
	TypeShape function_shape;
	@function_shape.signature = &signature;
	var function = Type(type_kind::function, $function_shape);
	TypeShape pointer_shape;
	@pointer_shape.element = &function;
	var converted = Type(type_kind::pointer, $pointer_shape);
	return @backend.exception_type(&converted);
};

fn native_exception_rva(var Backend& backend, var LLVMOpaqueValue* value) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(backend.context(), 64);
	var LLVMOpaqueType* relative = LLVMIntTypeInContext(backend.context(), 32);
	if (!value) {
		return LLVMConstNull(relative);
	};
	var LLVMOpaqueValue* image = LLVMGetNamedGlobal(backend.module(), "__ImageBase\0".data());
	if (!image) {
		@image = LLVMAddGlobal(backend.module(), LLVMIntTypeInContext(backend.context(), 8), "__ImageBase\0".data());
	};
	return LLVMConstTrunc(LLVMConstSub(LLVMConstPtrToInt(value, integer), LLVMConstPtrToInt(image, integer)), relative);
};

fn native_exception_global(var Backend& backend, rt::string_view prefix, rt::string_view suffix, var LLVMOpaqueValue* initializer) -> var LLVMOpaqueValue* {
	var name = rt::string(prefix);
	@name.append(suffix);
	var LLVMOpaqueValue* global = LLVMGetNamedGlobal(backend.module(), name.c_str());
	if (global) {
		return global;
	};
	@global = LLVMAddGlobal(backend.module(), LLVMTypeOf(initializer), name.c_str());
	LLVMSetInitializer(global, initializer);
	LLVMSetGlobalConstant(global, 1);
	LLVMSetLinkage(global, 3);
	LLVMSetComdat(global, LLVMGetOrInsertComdat(backend.module(), name.c_str()));
	return global;
};

fn Backend::exception_type(var Backend& this, Type* type) -> var LLVMOpaqueValue* {
	var name = rt::string(".");
	if (!native_exception_name(type, @name).has<void>()) {
		Token origin;
		discard @this.error(origin, "exception type requires a supported Microsoft C++ type identity");
		return nullptr;
	};
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* vtable = LLVMGetNamedGlobal(this.module(), "??_7type_info@@6B@\0".data());
	if (!vtable) {
		@vtable = LLVMAddGlobal(this.module(), pointer, "??_7type_info@@6B@\0".data());
	};
	var LLVMOpaqueValue* text = LLVMConstStringInContext2(this.context(), name.c_str(), name.size(), 0);
	var LLVMOpaqueType*[3] fields {};
	@fields[0] = pointer;
	@fields[1] = pointer;
	@fields[2] = LLVMTypeOf(text);
	var LLVMOpaqueType* structure = LLVMStructTypeInContext(this.context(), &@fields[0], 3, 0);
	var LLVMOpaqueValue*[3] values {};
	@values[0] = vtable;
	@values[1] = LLVMConstNull(pointer);
	@values[2] = text;
	var LLVMOpaqueValue* descriptor = native_exception_global(@this, "__rutile_eh_type_", name.view(), LLVMConstNamedStruct(structure, &@values[0], 3));
	if (descriptor) {
		LLVMSetGlobalConstant(descriptor, 0);
	};
	return descriptor;
};

fn native_exception_thunk(var Backend& backend, Type* type, rt::string_view name, bool copy) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(backend.context(), 0);
	var LLVMOpaqueType*[2] parameters {};
	@parameters[0] = pointer;
	@parameters[1] = pointer;
	u32 count = 1;
	if (copy) {
		@count = 2;
	};
	var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(backend.context()), &@parameters[0], count, 0);
	var native_name = rt::string(name);
	var LLVMOpaqueValue* function = LLVMGetNamedFunction(backend.module(), native_name.c_str());
	if (function) {
		return function;
	};
	@function = LLVMAddFunction(backend.module(), native_name.c_str(), signature);
	LLVMSetLinkage(function, 3);
	LLVMSetComdat(function, LLVMGetOrInsertComdat(backend.module(), native_name.c_str()));
	var LLVMOpaqueBasicBlock* saved = LLVMGetInsertBlock(backend.builder());
	LLVMPositionBuilderAtEnd(backend.builder(), LLVMAppendBasicBlockInContext(backend.context(), function, "entry\0".data()));
	var emitter = FunctionEmitter(@backend, function, nullptr);
	CompilationResult emitted;
	if (copy) {
		@emitted = @emitter.copy_initialize(type, LLVMGetParam(function, 0), LLVMGetParam(function, 1));
	}
	else {
		@emitted = @emitter.destroy_exception(type, LLVMGetParam(function, 0));
	};
	if (emitted.has<void>()) {
		discard LLVMBuildRetVoid(backend.builder());
	};
	if (saved) {
		LLVMPositionBuilderAtEnd(backend.builder(), saved);
	};
	if (emitted.has<compilation_error>()) {
		return nullptr;
	};
	return function;
};

fn FunctionEmitter::destroy_exception(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	var LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());
	NativeHandler boundary;
	@boundary.destination = @this.terminate_handler();
	var NativeHandler* previous = this.active_handler;
	@this.active_handler = &@boundary;
	LLVMPositionBuilderAtEnd(this.backend->builder(), current);
	var result = @this.destroy(type, address);
	@this.active_handler = previous;
	return $result;
};

fn native_exception_bases(var Backend& backend, Type* type, u64 offset, var rt::buffer<NativeExceptionBase>& bases) {
	NativeExceptionBase base;
	@base.type = type;
	@base.offset = offset;
	@bases.push_back($base);
	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};
	var Entity* record = type->entity();
	usize index = 0;
	while (index < record->bases().size()) {
		Type* parent = record->bases().data()[index];
		u64 displacement = LLVMOffsetOfElement(backend.layout(), @backend.type(type), static_cast<u32>(index));
		native_exception_bases(@backend, parent, offset + displacement, @bases);
		@index = index + 1;
	};
};

fn Backend::exception_info(var Backend& this, Type* type) -> var LLVMOpaqueValue* {
	var name = rt::string();
	if (!native_exception_name(type, @name).has<void>()) {
		Token origin;
		discard @this.error(origin, "exception type requires a supported Microsoft C++ type identity");
		return nullptr;
	};
	if (!@this.exception_type(type)) {
		return nullptr;
	};
	var symbol_name = rt::string("__rutile_eh_throw_");
	@symbol_name.append(name.view());
	bool pointee_const = type->kind() == type_kind::pointer && type->element()->kind() != type_kind::null_type && type->element()->kind() != type_kind::function && type->element()->qualifier() == type_qualifier::immutable;
	if (pointee_const) {
		@symbol_name.append("_const");
	};
	var LLVMOpaqueValue* existing = LLVMGetNamedGlobal(this.module(), symbol_name.c_str());
	if (existing) {
		return existing;
	};
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.context(), 32);
	var LLVMOpaqueType*[7] fields {};
	usize index = 0;
	while (index < 7) {
		@fields[index] = integer;
		@index = index + 1;
	};
	var LLVMOpaqueType* catchable = LLVMStructTypeInContext(this.context(), &@fields[0], 7, 0);
	rt::buffer<NativeExceptionBase> bases;
	Type* hierarchy = type;
	bool pointer = type->kind() == type_kind::pointer && type->element()->kind() != type_kind::null_type;
	if (pointer) {
		@hierarchy = type->element();
	};
	native_exception_bases(@this, hierarchy, 0, @bases);
	rt::buffer<var LLVMOpaqueValue*> entries;
	@index = 0;
	while (index < bases.size()) {
		Type* target = bases.data()[index].type;
		usize appearances = 0;
		usize other = 0;
		while (other < bases.size()) {
			if (target->same_shape(*bases.data()[other].type)) {
				@appearances = appearances + 1;
			};
			@other = other + 1;
		};
		if (appearances > 1) {
			@index = index + 1;
			continue;
		};
		TypeShape pointer_shape;
		@pointer_shape.element = target;
		var converted = Type(type_kind::pointer, $pointer_shape);
		if (pointer) {
			@target = &converted;
		};
		var base_name = rt::string();
		if (!native_exception_name(target, @base_name).has<void>()) {
			Token origin;
			discard @this.error(origin, "exception base type requires a supported Microsoft C++ type identity");
			return nullptr;
		};
		var LLVMOpaqueValue* copy;
		bool copyable = exception_copyable(target);
		if (copyable && target->kind() == type_kind::named && target->entity()->kind() == entity_kind::record) {
			var copy_name = rt::string("__rutile_eh_copy_");
			@copy_name.append(base_name.view());
			@copy = native_exception_thunk(@this, target, copy_name.view(), true);
			if (!copy) {
				return nullptr;
			};
		};
		var LLVMOpaqueValue*[7] values {};
		bool scalar = target->kind().is_scalar() || target->kind() == type_kind::named && target->entity()->kind() == entity_kind::enumeration;
		u64 properties = static_cast<u64>(scalar);
		if (!copyable) {
			@properties = properties | 2;
		};
		@values[0] = LLVMConstInt(integer, properties, 0);
		@values[1] = native_exception_rva(@this, @this.exception_type(target));
		@values[2] = LLVMConstInt(integer, bases.data()[index].offset, 0);
		@values[3] = LLVMConstInt(integer, u64::max, 1);
		@values[4] = LLVMConstNull(integer);
		var LLVMOpaqueType* representation = LLVMPointerTypeInContext(this.context(), 0);
		if (!pointer) {
			@representation = @this.type(target);
		};
		@values[5] = LLVMConstInt(integer, LLVMABISizeOfType(this.layout(), representation), 0);
		@values[6] = native_exception_rva(@this, copy);
		var item_name = rt::string(name.view());
		@item_name.append("_");
		@item_name.append(base_name.view());
		var LLVMOpaqueValue* item = native_exception_global(@this, "__rutile_eh_catch_", item_name.view(), LLVMConstNamedStruct(catchable, &@values[0], 7));
		@entries.push_back(native_exception_rva(@this, item));
		@index = index + 1;
	};
	if (type->kind() == type_kind::pointer && type->element()->kind() != type_kind::void_type && type->element()->kind() != type_kind::function) {
		TypeShape void_shape;
		@void_shape.bits = 0;
		var void_type = Type(type_kind::void_type, $void_shape);
		TypeShape pointer_shape;
		@pointer_shape.element = &void_type;
		var void_pointer = Type(type_kind::pointer, $pointer_shape);
		var LLVMOpaqueValue*[7] values {};
		@values[0] = LLVMConstInt(integer, 1, 0);
		@values[1] = native_exception_rva(@this, @this.exception_type(&void_pointer));
		@values[2] = LLVMConstNull(integer);
		@values[3] = LLVMConstInt(integer, u64::max, 1);
		@values[4] = LLVMConstNull(integer);
		@values[5] = LLVMConstInt(integer, static_cast<u64>(this.pointer_bits() / 8), 0);
		@values[6] = LLVMConstNull(integer);
		var LLVMOpaqueValue* item = native_exception_global(@this, "__rutile_eh_void_catch_", name.view(), LLVMConstNamedStruct(catchable, &@values[0], 7));
		@entries.push_back(native_exception_rva(@this, item));
	};
	if (type->kind() == type_kind::pointer && type->element()->kind() == type_kind::function && type->element()->signature().nonthrowing()) {
		var LLVMOpaqueValue* descriptor = native_exception_function_pointer_descriptor(@this, type, false);
		if (!descriptor) {
			return nullptr;
		};
		var LLVMOpaqueValue*[7] values {};
		@values[0] = LLVMConstInt(integer, 1, 0);
		@values[1] = native_exception_rva(@this, descriptor);
		@values[2] = LLVMConstNull(integer);
		@values[3] = LLVMConstInt(integer, u64::max, 1);
		@values[4] = LLVMConstNull(integer);
		@values[5] = LLVMConstInt(integer, static_cast<u64>(this.pointer_bits() / 8), 0);
		@values[6] = LLVMConstNull(integer);
		var LLVMOpaqueValue* item = native_exception_global(@this, "__rutile_eh_throwing_function_catch_", name.view(), LLVMConstNamedStruct(catchable, &@values[0], 7));
		@entries.push_back(native_exception_rva(@this, item));
	};
	var LLVMOpaqueValue* array = LLVMConstArray2(integer, (@entries).data(), entries.size());
	var LLVMOpaqueType*[2] array_fields {};
	@array_fields[0] = integer;
	@array_fields[1] = LLVMTypeOf(array);
	var LLVMOpaqueType* array_type = LLVMStructTypeInContext(this.context(), &@array_fields[0], 2, 0);
	var LLVMOpaqueValue*[2] array_values {};
	@array_values[0] = LLVMConstInt(integer, entries.size(), 0);
	@array_values[1] = array;
	var LLVMOpaqueValue* catchable_array = native_exception_global(@this, "__rutile_eh_array_", name.view(), LLVMConstNamedStruct(array_type, &@array_values[0], 2));
	var LLVMOpaqueValue* destructor;
	if (FunctionEmitter::needs_destruction(type)) {
		var destructor_name = rt::string("__rutile_eh_destroy_");
		@destructor_name.append(name.view());
		@destructor = native_exception_thunk(@this, type, destructor_name.view(), false);
		if (!destructor) {
			return nullptr;
		};
	};
	var LLVMOpaqueType* info_type = LLVMStructTypeInContext(this.context(), &@fields[0], 4, 0);
	var LLVMOpaqueValue*[4] info {};
	u64 attributes = 0;
	if (pointee_const) {
		@attributes = 1;
	};
	@info[0] = LLVMConstInt(integer, attributes, 0);
	@info[1] = native_exception_rva(@this, destructor);
	@info[2] = LLVMConstNull(integer);
	@info[3] = native_exception_rva(@this, catchable_array);
	return native_exception_global(@this, "", symbol_name.view(), LLVMConstNamedStruct(info_type, &@info[0], 4));
};

fn native_windows_exceptions(Backend& backend) -> bool {
	var triple = rt::from_c_string(LLVMGetTarget(backend.module()));
	usize index = 0;
	while (index + 7 <= triple.size()) {
		if (triple.slice(index, 7) == "windows") {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn FunctionEmitter::native_allocate(var FunctionEmitter& this, var LLVMOpaqueValue* bytes) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	var LLVMOpaqueType* signature = LLVMFunctionType(LLVMPointerTypeInContext(this.backend->context(), 0), &@integer, 1, 0);
	var LLVMOpaqueValue* function = LLVMGetNamedFunction(this.backend->module(), "malloc\0".data());
	if (!function) {
		@function = LLVMAddFunction(this.backend->module(), "malloc\0".data(), signature);
	};
	return @this.native_call(signature, function, &@bytes, 1);
};

fn FunctionEmitter::native_free(var FunctionEmitter& this, var LLVMOpaqueValue* address) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.backend->context(), 0);
	var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(this.backend->context()), &@pointer, 1, 0);
	var LLVMOpaqueValue* function = LLVMGetNamedFunction(this.backend->module(), "free\0".data());
	if (!function) {
		@function = LLVMAddFunction(this.backend->module(), "free\0".data(), signature);
	};
	return @this.native_call(signature, function, &@address, 1);
};

fn FunctionEmitter::terminate_handler(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock* {
	var LLVMOpaqueValue* personality = LLVMGetNamedFunction(this.backend->module(), "__CxxFrameHandler3\0".data());
	if (!personality) {
		@personality = LLVMAddFunction(this.backend->module(), "__CxxFrameHandler3\0".data(), LLVMFunctionType(LLVMIntTypeInContext(this.backend->context(), 32), nullptr, 0, 1));
	};
	LLVMSetPersonalityFn(this.function, personality);
	var LLVMOpaqueBasicBlock* destination = @this.block("noexcept.dispatch");
	var LLVMOpaqueBasicBlock* handler = @this.block("noexcept.terminate");
	LLVMPositionBuilderAtEnd(this.backend->builder(), destination);
	var LLVMOpaqueValue* parent = LLVMConstNull(LLVMTokenTypeInContext(this.backend->context()));
	var LLVMOpaqueValue* dispatch = LLVMBuildCatchSwitch(this.backend->builder(), parent, nullptr, 1, "noexcept.switch\0".data());
	LLVMAddHandler(dispatch, handler);
	LLVMPositionBuilderAtEnd(this.backend->builder(), handler);
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.backend->context(), 0);
	var LLVMOpaqueValue*[3] arguments {};
	@arguments[0] = LLVMConstNull(pointer);
	@arguments[1] = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 64, 0);
	@arguments[2] = LLVMConstNull(pointer);
	var LLVMOpaqueValue* pad = LLVMBuildCatchPad(this.backend->builder(), dispatch, &@arguments[0], 3, "noexcept.pad\0".data());
	var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(this.backend->context()), nullptr, 0, 0);
	var LLVMOpaqueValue* terminate = LLVMGetNamedFunction(this.backend->module(), "terminate\0".data());
	if (!terminate) {
		@terminate = LLVMAddFunction(this.backend->module(), "terminate\0".data(), signature);
	};
	var LLVMOpaqueOperandBundle* bundle = LLVMCreateOperandBundle("funclet\0".data(), 7, &@pad, 1);
	discard LLVMBuildCallWithOperandBundles(this.backend->builder(), signature, terminate, nullptr, 0, &@bundle, 1, "\0".data());
	LLVMDisposeOperandBundle(bundle);
	discard LLVMBuildUnreachable(this.backend->builder());
	return destination;
};

fn FunctionEmitter::retain_components(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) {
	var Entity* record = type->entity();
	if (record->layout() == record_layout::overlapping) {
		return;
	};
	usize index = 0;
	while (index < record->bases().size()) {
		var LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, static_cast<u32>(index), "unwind.base\0".data());
		@this.retain_unwind(record->bases().data()[index], base, nullptr, nullptr);
		@index = index + 1;
	};
	@index = 0;
	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		var LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, this.backend->field_index(record, index), "unwind.field\0".data());
		@this.retain_unwind(field->type(), member, nullptr, nullptr);
		@index = index + 1;
	};
};

fn FunctionEmitter::native_call(var FunctionEmitter& this, var LLVMOpaqueType* type, var LLVMOpaqueValue* function, var LLVMOpaqueValue var** arguments, u32 count) -> var LLVMOpaqueValue* {
	if (!type || !function) {
		return nullptr;
	};
	if (!native_windows_exceptions(*this.backend)) {
		return LLVMBuildCall2(this.backend->builder(), type, function, arguments, count, "\0".data());
	};

	var LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* unwind = @this.unwind_destination();
	LLVMPositionBuilderAtEnd(this.backend->builder(), current);
	var LLVMOpaqueOperandBundle* bundle;

	if (this.active_pad) {
		@bundle = LLVMCreateOperandBundle("funclet\0".data(), 7, &@this.active_pad, 1);
	};

	var LLVMOpaqueValue* result;

	if (unwind) {
		var LLVMOpaqueBasicBlock* normal = @this.block("invoke.continue");
		if (bundle) {
			@result = LLVMBuildInvokeWithOperandBundles(this.backend->builder(), type, function, arguments, count, normal, unwind, &@bundle, 1, "\0".data());
		}
		else {
			@result = LLVMBuildInvoke2(this.backend->builder(), type, function, arguments, count, normal, unwind, "\0".data());
		};
		LLVMPositionBuilderAtEnd(this.backend->builder(), normal);
	}
	else if (bundle) {
		@result = LLVMBuildCallWithOperandBundles(this.backend->builder(), type, function, arguments, count, &@bundle, 1, "\0".data());
	}
	else {
		@result = LLVMBuildCall2(this.backend->builder(), type, function, arguments, count, "\0".data());
	};

	if (bundle) {
		LLVMDisposeOperandBundle(bundle);
	};
	return result;
};

fn FunctionEmitter::unwind_destination(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock* {
	usize route_index = this.unwind_routes.size();
	while (route_index) {
		@route_index = route_index - 1;
		NativeUnwindRoute& route = this.unwind_routes.data()[route_index];
		if (route.revision == this.lifetime_revision && route.depth == this.unwind_depth && route.pad == this.active_pad && route.handler == this.active_handler) {
			return route.destination;
		};
	};
	usize binding_begin = 0;
	usize temporary_begin = 0;
	usize unwind_begin = 0;
	var LLVMOpaqueBasicBlock* target;

	if (this.active_catch && this.active_handler == this.active_catch->handlers && !this.unwind_depth) {
		@binding_begin = this.active_catch->bindings;
		@temporary_begin = this.active_catch->temporaries;
		@unwind_begin = this.active_catch->unwinds;
		@target = this.active_catch->unwind;
	}
	else if (this.active_handler && !this.unwind_depth) {
		@binding_begin = this.active_handler->bindings;
		@temporary_begin = this.active_handler->temporaries;
		@unwind_begin = this.active_handler->unwinds;
		@target = this.active_handler->destination;
	};

	bool cleanup = this.unwinds.size() > unwind_begin;
	usize index = binding_begin;
	while (index < this.bindings.size()) {
		@cleanup = cleanup || this.bindings.data()[index].live != nullptr;
		@index = index + 1;
	};
	@index = temporary_begin;
	while (index < this.temporaries.size()) {
		@cleanup = cleanup || this.temporaries.data()[index].live != nullptr;
		@index = index + 1;
	};

	if (!cleanup && !this.unwind_depth) {
		return target;
	};

	var LLVMOpaqueValue* personality = LLVMGetNamedFunction(this.backend->module(), "__CxxFrameHandler3\0".data());
	if (!personality) {
		@personality = LLVMAddFunction(this.backend->module(), "__CxxFrameHandler3\0".data(), LLVMFunctionType(LLVMIntTypeInContext(this.backend->context(), 32), nullptr, 0, 1));
	};
	LLVMSetPersonalityFn(this.function, personality);
	var LLVMOpaqueBasicBlock* destination = @this.block("exception.cleanup");
	NativeUnwindRoute route;
	@route.revision = this.lifetime_revision;
	@route.depth = this.unwind_depth;
	@route.pad = this.active_pad;
	@route.handler = this.active_handler;
	@route.destination = destination;
	@this.unwind_routes.push_back($route);
	LLVMPositionBuilderAtEnd(this.backend->builder(), destination);
	var LLVMOpaqueValue* parent = this.active_pad;
	if (!parent) {
		@parent = LLVMConstNull(LLVMTokenTypeInContext(this.backend->context()));
	};
	var LLVMOpaqueValue* pad = LLVMBuildCleanupPad(this.backend->builder(), parent, nullptr, 0, "cleanup.pad\0".data());
	var LLVMOpaqueValue* previous_pad = this.active_pad;
	@this.active_pad = pad;

	if (this.unwind_depth) {
		var LLVMOpaqueValue* terminate = LLVMGetNamedFunction(this.backend->module(), "terminate\0".data());
		var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(this.backend->context()), nullptr, 0, 0);
		if (!terminate) {
			@terminate = LLVMAddFunction(this.backend->module(), "terminate\0".data(), signature);
		};
		var LLVMOpaqueOperandBundle* bundle = LLVMCreateOperandBundle("funclet\0".data(), 7, &@pad, 1);
		discard LLVMBuildCallWithOperandBundles(this.backend->builder(), signature, terminate, nullptr, 0, &@bundle, 1, "\0".data());
		LLVMDisposeOperandBundle(bundle);
		discard LLVMBuildUnreachable(this.backend->builder());
	}
	else {
		@this.unwind_depth = this.unwind_depth + 1;
		var success = @this.unwind_cleanup(binding_begin, temporary_begin, unwind_begin);
		@this.unwind_depth = this.unwind_depth - 1;
		if (success.has<void>() && !this.terminated()) {
			discard LLVMBuildCleanupRet(this.backend->builder(), pad, target);
		};
	};
	@this.active_pad = previous_pad;
	return destination;
};

fn FunctionEmitter::retain_unwind(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* count, var LLVMOpaqueValue* allocation) {
	if (!count && !allocation && !FunctionEmitter::needs_destruction(type)) {
		return;
	};
	NativeUnwind action;
	@action.type = type;
	@action.address = address;
	@action.count = count;
	@action.allocation = allocation;
	@this.lifetime_order = this.lifetime_order + 1;
	@action.order = this.lifetime_order;
	@this.unwinds.push_back($action);
	@this.lifetime_revision = this.lifetime_revision + 1;
};

fn FunctionEmitter::forget_unwinds(var FunctionEmitter& this, usize begin) {
	while (this.unwinds.size() > begin) {
		@this.unwinds.pop_back();
		@this.lifetime_revision = this.lifetime_revision + 1;
	};
};

fn FunctionEmitter::unwind_cleanup(var FunctionEmitter& this, usize bindings, usize temporaries, usize unwinds) -> CompilationResult {
	usize binding_index = this.bindings.size();
	usize temporary_index = this.temporaries.size();
	usize unwind_index = this.unwinds.size();
	while (binding_index > bindings || temporary_index > temporaries || unwind_index > unwinds) {
		usize binding_order = 0;
		usize temporary_order = 0;
		usize unwind_order = 0;
		if (binding_index > bindings) {
			@binding_order = this.bindings.data()[binding_index - 1].order;
		};
		if (temporary_index > temporaries) {
			@temporary_order = this.temporaries.data()[temporary_index - 1].order;
		};
		if (unwind_index > unwinds) {
			@unwind_order = this.unwinds.data()[unwind_index - 1].order;
		};
		if (binding_order > temporary_order && binding_order > unwind_order) {
			@binding_index = binding_index - 1;
			NativeBinding& binding = this.bindings.data()[binding_index];
			if (!(@this.guarded_destroy(binding.entity->type(), binding.address, binding.live)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		if (temporary_order > unwind_order) {
			@temporary_index = temporary_index - 1;
			NativeTemporary& temporary = this.temporaries.data()[temporary_index];
			if (!(@this.guarded_destroy(temporary.expression->type(), temporary.address, temporary.live)).has<void>()) {
				return compilation_error();
			};
			continue;
		};
		@unwind_index = unwind_index - 1;
		NativeUnwind& action = this.unwinds.data()[unwind_index];
		if (action.count) {
			var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
			var LLVMOpaqueValue* count = LLVMBuildLoad2(this.backend->builder(), integer, action.count, "constructed.count\0".data());
			if (!(@this.destroy_range(action.type, action.address, count)).has<void>()) {
				return compilation_error();
			};
		}
		else if (action.address && !(@this.destroy(action.type, action.address)).has<void>()) {
			return compilation_error();
		};
		if (action.allocation) {
			var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.backend->context(), 0);
			var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(this.backend->context()), &@pointer, 1, 0);
			var LLVMOpaqueValue* free = LLVMGetNamedFunction(this.backend->module(), "free\0".data());
			if (!free) {
				@free = LLVMAddFunction(this.backend->module(), "free\0".data(), signature);
			};
			var LLVMOpaqueOperandBundle* bundle = LLVMCreateOperandBundle("funclet\0".data(), 7, &@this.active_pad, 1);
			var LLVMOpaqueValue* allocation = action.allocation;
			discard LLVMBuildCallWithOperandBundles(this.backend->builder(), signature, free, &@allocation, 1, &@bundle, 1, "\0".data());
			LLVMDisposeOperandBundle(bundle);
		};
	};
};

fn FunctionEmitter::exception_throw(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!native_windows_exceptions(*this.backend)) {
		return @this.backend->error(expression->token(), "native exception handling currently requires a Windows target");
	};
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.backend->context(), 0);
	var LLVMOpaqueValue*[2] arguments {};
	@arguments[0] = LLVMConstNull(pointer);
	@arguments[1] = LLVMConstNull(pointer);

	if (expression->kind() == semantic_kind::exception_throw) {
		var SemanticExpression* value = expression->item(0);
		var LLVMOpaqueValue* storage = @this.slot(value->type());
		if (!storage || !(@this.initialize_value(value->type(), storage, value)).has<void>()) {
			return compilation_error();
		};
		@arguments[0] = storage;
		@arguments[1] = @this.backend->exception_info(value->type());
		if (!arguments[1]) {
			return compilation_error();
		};
	};

	var LLVMOpaqueType*[2] parameters {};
	@parameters[0] = pointer;
	@parameters[1] = pointer;
	var LLVMOpaqueType* signature = LLVMFunctionType(LLVMVoidTypeInContext(this.backend->context()), &@parameters[0], 2, 0);
	var LLVMOpaqueValue* function = LLVMGetNamedFunction(this.backend->module(), "_CxxThrowException\0".data());
	if (!function) {
		@function = LLVMAddFunction(this.backend->module(), "_CxxThrowException\0".data(), signature);
	};
	if (!@this.native_call(signature, function, &@arguments[0], 2)) {
		return compilation_error();
	};
	discard LLVMBuildUnreachable(this.backend->builder());
};

fn native_exception_accepts_nonthrowing(Type* type) -> bool {
	if (type->kind() == type_kind::reference) {
		if (type->element()->qualifier() != type_qualifier::immutable) {
			return false;
		};
		@type = type->element();
	};
	return type->kind() == type_kind::pointer && type->element()->kind() == type_kind::function && !type->element()->signature().nonthrowing();
};

fn FunctionEmitter::exception_try(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	if (!native_windows_exceptions(*this.backend)) {
		return @this.backend->error(expression->token(), "native exception handling currently requires a Windows target");
	};
	var LLVMOpaqueValue* personality = LLVMGetNamedFunction(this.backend->module(), "__CxxFrameHandler3\0".data());
	if (!personality) {
		@personality = LLVMAddFunction(this.backend->module(), "__CxxFrameHandler3\0".data(), LLVMFunctionType(LLVMIntTypeInContext(this.backend->context(), 32), nullptr, 0, 1));
	};
	LLVMSetPersonalityFn(this.function, personality);
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* outer_unwind = @this.unwind_destination();
	var LLVMOpaqueBasicBlock* dispatch = @this.block("catch.dispatch");
	var LLVMOpaqueBasicBlock* after = @this.block("try.after");
	LLVMPositionBuilderAtEnd(this.backend->builder(), before);
	NativeHandler handler;
	@handler.destination = dispatch;
	@handler.parent_pad = this.active_pad;
	@handler.parent = this.active_handler;
	@handler.bindings = this.bindings.size();
	@handler.temporaries = this.temporaries.size();
	@handler.unwinds = this.unwinds.size();
	@this.active_handler = &@handler;
	@this.lifetime_revision = this.lifetime_revision + 1;
	if (!(@this.scoped_statement(expression->item(0))).has<void>()) {
		return compilation_error();
	};
	if (!this.terminated()) {
		discard LLVMBuildBr(this.backend->builder(), after);
	};
	@this.active_handler = handler.parent;
	@this.lifetime_revision = this.lifetime_revision + 1;
	LLVMPositionBuilderAtEnd(this.backend->builder(), dispatch);
	var LLVMOpaqueValue* parent = this.active_pad;
	if (!parent) {
		@parent = LLVMConstNull(LLVMTokenTypeInContext(this.backend->context()));
	};
	usize count = expression->size() - 1;
	usize index = 1;
	while (index < expression->size()) {
		if (native_exception_accepts_nonthrowing(expression->item(index)->type())) {
			@count = count + 1;
		};
		@index = index + 1;
	};
	var LLVMOpaqueValue* switch_pad = LLVMBuildCatchSwitch(this.backend->builder(), parent, outer_unwind, static_cast<u32>(count), "catch.switch\0".data());
	@index = 1;
	while (index < expression->size()) {
		var SemanticExpression* source = expression->item(index);
		if (!(@this.catch_handler(source, switch_pad, after, outer_unwind, nullptr)).has<void>()) {
			return compilation_error();
		};
		if (native_exception_accepts_nonthrowing(source->type())) {
			Type* type = source->type();
			if (type->kind() == type_kind::reference) {
				@type = type->element();
			};
			var LLVMOpaqueValue* descriptor = native_exception_function_pointer_descriptor(@*this.backend, type, true);
			if (!descriptor || !(@this.catch_handler(source, switch_pad, after, outer_unwind, descriptor)).has<void>()) {
				return compilation_error();
			};
		};
		@index = index + 1;
	};
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
};

fn FunctionEmitter::catch_handler(var FunctionEmitter& this, var SemanticExpression* source, var LLVMOpaqueValue* dispatch, var LLVMOpaqueBasicBlock* after, var LLVMOpaqueBasicBlock* unwind, var LLVMOpaqueValue* descriptor) -> CompilationResult {
	var LLVMOpaqueBasicBlock* body = @this.block("catch.body");
	LLVMAddHandler(dispatch, body);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.backend->context(), 0);
	var LLVMOpaqueValue*[3] arguments {};
	@arguments[0] = LLVMConstNull(pointer);
	@arguments[1] = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 64, 0);
	@arguments[2] = LLVMConstNull(pointer);
	var LLVMOpaqueValue* storage;
	if (source->type()->kind() != type_kind::void_type) {
		Type* type = source->type();
		u64 flags = 0;
		if (type->kind() == type_kind::reference) {
			@type = type->element();
			@flags = 8;
		};
		if (type->kind() == type_kind::pointer && type->element()->kind() != type_kind::null_type && type->element()->kind() != type_kind::function && type->element()->qualifier() == type_qualifier::immutable) {
			@flags = flags | 1;
		};
		@arguments[0] = descriptor;
		if (!arguments[0]) {
			@arguments[0] = @this.backend->exception_type(type);
		};
		@arguments[1] = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), flags, 0);
		@storage = @this.slot(source->type());
		@arguments[2] = storage;
		if (!arguments[0] || !storage) {
			return compilation_error();
		};
	};
	var LLVMOpaqueValue* pad = LLVMBuildCatchPad(this.backend->builder(), dispatch, &@arguments[0], 3, "catch.pad\0".data());
	NativeCatch active;
	@active.pad = pad;
	@active.parent_pad = this.active_pad;
	@active.parent = this.active_catch;
	@active.handlers = this.active_handler;
	@active.unwind = unwind;
	@active.bindings = this.bindings.size();
	@active.temporaries = this.temporaries.size();
	@active.unwinds = this.unwinds.size();
	@this.active_pad = pad;
	@this.active_catch = &@active;
	if (source->entity()) {
		@this.bind(source->entity(), storage);
	};
	if (!(@this.scoped_statement(source->item(0))).has<void>() || !(@this.leave_scope(active.bindings)).has<void>()) {
		return compilation_error();
	};
	if (!this.terminated()) {
		discard LLVMBuildCatchRet(this.backend->builder(), pad, after);
	};
	@this.active_catch = active.parent;
	@this.active_pad = active.parent_pad;
};

fn FunctionEmitter::exit_cleanup(var FunctionEmitter& this, usize bindings, var NativeCatch* catches, var NativeHandler* handlers) -> CompilationResult {
	var NativeCatch* previous_catch = this.active_catch;
	var NativeHandler* previous_handler = this.active_handler;
	var LLVMOpaqueValue* previous_pad = this.active_pad;
	usize index = this.bindings.size();
	var success = @this.cleanup_temporaries(0);
	while (success.has<void>()) {
		usize boundary = bindings;
		if (this.active_handler != handlers && (!this.active_catch || this.active_catch == catches || this.active_handler != this.active_catch->handlers)) {
			@boundary = this.active_handler->bindings;
		}
		else if (this.active_catch != catches) {
			@boundary = this.active_catch->bindings;
		};
		while (index > boundary) {
			@index = index - 1;
			NativeBinding& binding = this.bindings.data()[index];
			if (!(@this.guarded_destroy(binding.entity->type(), binding.address, binding.live)).has<void>()) {
				@success = CompilationResult(compilation_error());
				break;
			};
		};
		if (success.has<compilation_error>()) {
			break;
		};
		if (this.active_handler != handlers && (!this.active_catch || this.active_catch == catches || this.active_handler != this.active_catch->handlers)) {
			@this.active_handler = this.active_handler->parent;
			@this.lifetime_revision = this.lifetime_revision + 1;
			continue;
		};
		if (this.active_catch != catches) {
			var NativeCatch* active = this.active_catch;
			var LLVMOpaqueBasicBlock* next = @this.block("catch.leave");
			discard LLVMBuildCatchRet(this.backend->builder(), active->pad, next);
			LLVMPositionBuilderAtEnd(this.backend->builder(), next);
			@this.active_pad = active->parent_pad;
			@this.active_catch = active->parent;
			@this.lifetime_revision = this.lifetime_revision + 1;
			continue;
		};
		break;
	};
	@this.active_catch = previous_catch;
	@this.active_handler = previous_handler;
	@this.active_pad = previous_pad;
	@this.lifetime_revision = this.lifetime_revision + 1;
	return $success;
};

fn FunctionEmitter::evaluate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	var LLVMOpaqueType* type = @this.backend->type(expression->type(), expression->token());

	if (!type) {
		return nullptr;
	};
	u64 inferred = 0;
	if (this.integer_fact(*expression, @inferred)) {
		return LLVMConstInt(type, inferred, 0);
	};

	switch (expression->kind()) {
		case semantic_kind::sequence: {
			var LLVMOpaqueValue* result;

			if (!(@this.sequence(expression, native_evaluation::value, @result)).has<void>()) {
				return nullptr;
			};

			return result;
		};

		case semantic_kind::sizeof_type: {
			Type* queried = expression->item(0)->type();

			if (queried->kind() == type_kind::void_type || queried->kind() == type_kind::null_type || queried->kind() == type_kind::function) {
				discard @this.backend->error(expression->token(), "size query requires an object type");
				return nullptr;
			};

			var LLVMOpaqueType* native = @this.backend->type(queried, expression->token());
			if (!native) {
				return nullptr;
			};
			return LLVMConstInt(type, LLVMABISizeOfType(this.backend->layout(), native), 0);
		};

		case semantic_kind::literal_integer:
			return LLVMConstInt(type, expression->integer(), 0);
		case semantic_kind::literal_real:
			return LLVMConstReal(type, expression->real());
		case semantic_kind::null_pointer:
			return LLVMConstNull(type);
		case semantic_kind::literal_text: {
			var text = expression->text();
			var LLVMOpaqueValue* bytes = LLVMConstStringInContext2(this.backend->context(), text.data(), text.size(), 1);
			var LLVMOpaqueValue* global = LLVMAddGlobal(this.backend->module(), LLVMTypeOf((var LLVMOpaqueValue*(bytes))), "literal\0".data());
			LLVMSetInitializer((var LLVMOpaqueValue*(global)), bytes);
			LLVMSetGlobalConstant((var LLVMOpaqueValue*(global)), 1);
			LLVMSetLinkage((var LLVMOpaqueValue*(global)), 9);

			var LLVMOpaqueType* length_type = @this.backend->type(expression->type()->entity()->fields().data()[1]->type(), expression->token());
			if (!length_type) {
				return nullptr;
			};
			rt::buffer<var LLVMOpaqueValue*> fields;
			@fields.push_back(global);
			@fields.push_back(LLVMConstInt(length_type, text.size(), 0));
			return LLVMConstNamedStruct(type, (@fields).data(), 2);
		};

		case semantic_kind::name: {
			var Entity* entity = expression->entity();

			if (entity->kind() == entity_kind::function) {
				return this.backend->symbol(entity);
			};

			if (entity->kind() == entity_kind::enumerator) {
				return LLVMConstInt(type, entity->integer(), 0);
			};

			var LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0".data());
		};

		case semantic_kind::access:
		case semantic_kind::variant_payload:
		case semantic_kind::dereference:
		case semantic_kind::index:
		case semantic_kind::member: {
			var LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0".data());
		};

		case semantic_kind::address:
			return @this.address(expression->item(0));
		case semantic_kind::variant_cast: {
			var LLVMOpaqueValue* address = @this.variant_cast_address(expression);
			if (!address) {
				return nullptr;
			};
			if (expression->type()->kind() == type_kind::pointer && expression->type()->element()->kind() == type_kind::null_type) {
				return LLVMConstNull(type);
			};
			var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), type, address, "variant.cast.read\0".data());
			if (expression->category() == value_category::consumable) {
				@this.consume(expression->item(0));
			};
			return value;
		};
		case semantic_kind::relocation: {
			var LLVMOpaqueValue* storage = @this.address(expression->item(0));

			if (!storage) {
				return nullptr;
			};

			var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), type, storage, "relocated\0".data());
			@this.set_live(expression->item(0), false);

			return value;
		};

		case semantic_kind::call: {
			var LLVMOpaqueValue* value = @this.call(expression);

			if (!value) {
				return nullptr;
			};

			bool condition = false;
			if (this.condition_fact(*expression, @condition)) {
				return LLVMConstInt(type, static_cast<u64>($condition), 0);
			};

			Type* signature = expression->item(0)->type();

			if (signature->kind() == type_kind::pointer) {
				@signature = signature->element();
			};

			if (signature->signature().result()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), type, value, "call.reference\0".data());
			};

			return value;
		};

		case semantic_kind::binary:
			return @this.binary(expression);
		case semantic_kind::unary: {
			var SemanticExpression* operand = expression->item(0);
			var LLVMOpaqueValue* value = @this.value(operand);

			if (!value) {
				return nullptr;
			};

			switch (expression->operation()) {
				case token_kind::op_plus:
					return value;
				case token_kind::op_minus:
					if (expression->type()->kind() == type_kind::floating_point) {
						return LLVMBuildFNeg(this.backend->builder(), value, "negate\0".data());
					};

					return LLVMBuildNeg(this.backend->builder(), value, "negate\0".data());
				case token_kind::op_tilde:
					return LLVMBuildNot(this.backend->builder(), value, "complement\0".data());
				case token_kind::op_bang: {
					bool condition = false;
					if (this.condition_fact(*expression, @condition)) {
						return LLVMConstInt(type, static_cast<u64>($condition), 0);
					};
					return LLVMBuildNot(this.backend->builder(), @this.truth(value, operand->type()), "not\0".data());
				};
			};

			break;
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				var LLVMOpaqueValue* storage = @this.address(expression);

				if (!storage) {
					return nullptr;
				};

				return LLVMBuildLoad2(this.backend->builder(), type, storage, "cast.reference\0".data());
			};

			return @this.convert(@this.take(expression->item(0)), expression->item(0)->type(), expression->type());
		case semantic_kind::construction:
			return @this.construct(expression);
		case semantic_kind::allocation:
			return @this.allocate(expression);
		case semantic_kind::deallocation: {
			var LLVMOpaqueValue* pointer = @this.value(expression->item(0));

			if (!pointer) {
				return nullptr;
			};

			Type* element = expression->item(0)->type()->element();

			if (FunctionEmitter::needs_destruction(element)) {
				var LLVMOpaqueBasicBlock* destroy = @this.block("delete.destroy");
				var LLVMOpaqueBasicBlock* after = @this.block("delete.after");
				discard LLVMBuildCondBr(this.backend->builder(), @this.truth(pointer, expression->item(0)->type()), destroy, after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);
				usize unwind_begin = this.unwinds.size();
				@this.retain_unwind(element, nullptr, nullptr, pointer);

				if (!(@this.destroy(element, pointer)).has<void>()) {
					return nullptr;
				};

				@this.forget_unwinds(unwind_begin);
				var LLVMOpaqueValue* disposed = @this.native_free(pointer);
				discard LLVMBuildBr(this.backend->builder(), after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), after);

				return disposed;
			};

			return @this.native_free(pointer);
		};

		case semantic_kind::array_deallocation:
			return @this.deallocate_array(expression);
		case semantic_kind::discard_value:
			return @this.take(expression->item(0));
		case semantic_kind::noop:
			return LLVMConstNull(type);
	};

	discard @this.backend->error(expression->token(), "expression has no implemented native lowering");
	return nullptr;
};

struct NativeBinding {
	var Entity* entity;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
	usize order;
};

struct NativeTemporary {
	var SemanticExpression* expression;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
	usize order;
};

struct NativeAssignment {
	var LLVMOpaqueValue* value;
	var LLVMOpaqueValue* address;
};

struct NativeControl {
	var LLVMOpaqueBasicBlock* leave;
	var LLVMOpaqueBasicBlock* resume;
	var NativeControl* parent;
	var NativeCatch* catches;
	var NativeHandler* handlers;
	usize binding_boundary;
	usize leave_edges;
};

struct NativeUnwind {
	Type* type;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* count;
	var LLVMOpaqueValue* allocation;
	usize order;
};

struct NativeHandler {
	var LLVMOpaqueBasicBlock* destination;
	var LLVMOpaqueValue* parent_pad;
	var NativeHandler* parent;
	usize bindings;
	usize temporaries;
	usize unwinds;
};

struct NativeCatch {
	var LLVMOpaqueValue* pad;
	var LLVMOpaqueValue* parent_pad;
	var NativeCatch* parent;
	var NativeHandler* handlers;
	var LLVMOpaqueBasicBlock* unwind;
	usize bindings;
	usize temporaries;
	usize unwinds;
};

struct NativeUnwindRoute {
	usize revision;
	usize depth;
	var LLVMOpaqueValue* pad;
	var NativeHandler* handler;
	var LLVMOpaqueBasicBlock* destination;
};

enum native_evaluation : [u08] {
	value;
	address;
};

struct FunctionEmitter {
	fn FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result);

	fn emit(var FunctionEmitter& this, var Entity* function) -> CompilationResult;
	fn set_fact_context(var FunctionEmitter& this, InferredFunctionContext* context);
	fn integer_fact(FunctionEmitter& this, SemanticExpression& expression, var u64& value) -> bool;
	fn condition_fact(FunctionEmitter& this, SemanticExpression& expression, var bool& value) -> bool;
	fn alternative_fact(FunctionEmitter& this, SemanticExpression& expression) -> u64;
	fn statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn value(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn variant_cast_address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address);
	fn destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn destroy_exception(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn needs_destruction(Type* type) -> bool;

	fn take(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn construct_variant_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_value(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* value) -> CompilationResult;

	fn finish_expression(var FunctionEmitter& this) -> CompilationResult;
	fn copy_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn move_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn copy_representation(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;

private:
	fn storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn terminated(FunctionEmitter& this) -> bool;
	fn block(var FunctionEmitter& this, rt::string_view name) -> var LLVMOpaqueBasicBlock*;

	fn slot(var FunctionEmitter& this, Type* type) -> var LLVMOpaqueValue*;
	fn native_slot(var FunctionEmitter& this, var LLVMOpaqueType* type) -> var LLVMOpaqueValue*;

	fn live_flag(var FunctionEmitter& this) -> var LLVMOpaqueValue*;
	fn set_live(var FunctionEmitter& this, var SemanticExpression* expression, bool live);
	fn consume(var FunctionEmitter& this, var SemanticExpression* expression);
	fn remember(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address);
	fn temporary(FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn cleanup_temporaries(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn cleanup_bindings(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn guarded_destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* live) -> CompilationResult;
	fn forget_temporaries(var FunctionEmitter& this, usize begin);
	fn leave_scope(var FunctionEmitter& this, usize begin) -> CompilationResult;
	fn native_call(var FunctionEmitter& this, var LLVMOpaqueType* type, var LLVMOpaqueValue* function, var LLVMOpaqueValue var** arguments, u32 count) -> var LLVMOpaqueValue*;
	fn native_allocate(var FunctionEmitter& this, var LLVMOpaqueValue* bytes) -> var LLVMOpaqueValue*;
	fn native_free(var FunctionEmitter& this, var LLVMOpaqueValue* address) -> var LLVMOpaqueValue*;
	fn unwind_destination(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock*;
	fn unwind_cleanup(var FunctionEmitter& this, usize bindings, usize temporaries, usize unwinds) -> CompilationResult;
	fn retain_unwind(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* count, var LLVMOpaqueValue* allocation);
	fn forget_unwinds(var FunctionEmitter& this, usize begin);
	fn exception_try(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn catch_handler(var FunctionEmitter& this, var SemanticExpression* source, var LLVMOpaqueValue* dispatch, var LLVMOpaqueBasicBlock* after, var LLVMOpaqueBasicBlock* unwind, var LLVMOpaqueValue* descriptor) -> CompilationResult;
	fn exception_throw(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn exit_cleanup(var FunctionEmitter& this, usize bindings, var NativeCatch* catches, var NativeHandler* handlers) -> CompilationResult;
	fn terminate_handler(var FunctionEmitter& this) -> var LLVMOpaqueBasicBlock*;
	fn retain_components(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address);

	fn scoped_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;

	fn generated(var FunctionEmitter& this, var Entity* function) -> CompilationResult;
	fn generated_variant(var FunctionEmitter& this, var Entity* function, Type* type, var LLVMOpaqueValue* destination) -> CompilationResult;
	fn variant_transfer(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, bool assign) -> CompilationResult;
	fn initialize_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn copy_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn transfer_elements(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, component_transfer operation) -> CompilationResult;
	fn copy_assign(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn copy_assign_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;

	fn binding_live(var FunctionEmitter& this, var Entity* entity, bool live);

	fn evaluate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn truth(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* type) -> var LLVMOpaqueValue*;
	fn convert(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* source, Type* target) -> var LLVMOpaqueValue*;
	fn binary(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn assign(var FunctionEmitter& this, var SemanticExpression* expression) -> NativeAssignment;
	fn logical(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn loop(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn selection(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;
	fn sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> CompilationResult;
	fn validate_switch_item(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult;

	fn construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn construct_body(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> CompilationResult;
	fn initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult;
	fn copy_initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult;
	fn initialize_value_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* value) -> CompilationResult;

	fn allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn allocation_result(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* pointer, var LLVMOpaqueValue* bytes, bool array) -> var LLVMOpaqueValue*;
	fn allocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn deallocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn destroy_range(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* memory, var LLVMOpaqueValue* count) -> CompilationResult;
	fn allocation_prefix(var FunctionEmitter& this, Type* type) -> u64;

	fn representation(Type* type) -> Type*;

	var Backend* backend;
	InferredFunctionContext* fact_context;
	var LLVMOpaqueValue* function;
	var LLVMOpaqueValue* variant_payload_address;
	var LLVMOpaqueValue* variant_payload_live;
	Type* result;
	var NativeControl* active_control;
	var NativeHandler* active_handler;
	var NativeHandler* function_handler;
	var LLVMOpaqueValue* active_pad;
	var NativeCatch* active_catch;
	usize unwind_depth;
	usize lifetime_order;
	usize lifetime_revision;
	rt::buffer<NativeBinding> bindings;
	rt::buffer<NativeTemporary> temporaries;
	rt::buffer<NativeUnwind> unwinds;
	rt::buffer<NativeUnwindRoute> unwind_routes;
};

fn FunctionEmitter::FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result) {
	@this.backend = &@backend;
	@this.function = function;
	@this.result = result;
};

fn FunctionEmitter::terminated(FunctionEmitter& this) -> bool {
	var LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());

	return current && LLVMGetBasicBlockTerminator(current) != nullptr;
};

fn FunctionEmitter::block(var FunctionEmitter& this, rt::string_view name) -> var LLVMOpaqueBasicBlock* {
	var native_name = rt::string(name);
	return LLVMAppendBasicBlockInContext(this.backend->context(), this.function, native_name.c_str());
};

fn FunctionEmitter::bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address) {
	NativeBinding binding;
	@binding.entity = entity;
	@binding.address = address;
	@this.lifetime_order = this.lifetime_order + 1;
	@binding.order = this.lifetime_order;

	if (FunctionEmitter::needs_destruction(entity->type())) {
		@binding.live = @this.live_flag();

		if (!binding.live) {
			compiler_panic("cannot create a native binding lifetime flag");
		};

		discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), binding.live);
	};

	@this.bindings.push_back($binding);
	@this.lifetime_revision = this.lifetime_revision + 1;

};

fn FunctionEmitter::storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].address;
		};
	};

	return this.backend->symbol(entity);
};

fn FunctionEmitter::emit(var FunctionEmitter& this, var Entity* function) -> CompilationResult {
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block("entry"));
	NativeHandler boundary;
	if (function->nonthrowing() && native_windows_exceptions(*this.backend)) {
		var LLVMOpaqueBasicBlock* entry = LLVMGetInsertBlock(this.backend->builder());
		@boundary.destination = @this.terminate_handler();
		@this.active_handler = &@boundary;
		@this.function_handler = &@boundary;
		LLVMPositionBuilderAtEnd(this.backend->builder(), entry);
	};
	usize index = 0;

	while (index < function->parameters().size()) {
		var Entity* parameter = function->parameters().data()[index];
		var LLVMOpaqueValue* slot = @this.slot(parameter->type());

		if (!slot) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), LLVMGetParam(this.function, static_cast<u32>(index)), (var LLVMOpaqueValue*(slot)));

		@this.bind(parameter, slot);

		@index = index + 1;
	};

	if (function->definition() == function_definition::defaulted) {
		return @this.generated(function);
	};
	if (function->role() == function_role::destructor && function->nonthrowing()) {
		Type* type = function->parameters().data()[0]->type()->element();
		@this.retain_components(type, LLVMGetParam(this.function, 0));
	};

	if (function->role() == function_role::constructor) {
		Type* type = function->parameters().data()[0]->type()->element();

		if (!(@this.initialize_members(type, LLVMGetParam(this.function, 0))).has<void>()) {
			return compilation_error();
		};
	};

	if (!(@this.statement(function->body())).has<void>()) {
		return compilation_error();
	};

	if (this.terminated()) {
		return;
	};

	if (function->completion() == function_completion::no_fallthrough) {
		discard LLVMBuildUnreachable(this.backend->builder());

		return;
	};

	if (this.result->kind() == type_kind::void_type) {
		if (!(@this.cleanup_bindings(0)).has<void>()) {
			return compilation_error();
		};

		discard LLVMBuildRetVoid(this.backend->builder());

		return;
	};

	var message = DiagnosticMessage();
	@message.text("non-void function reaches the end without a result: '");
	diagnostic_entity(@message, *function);
	@message.text("' has result type '");
	diagnostic_type(@message, *this.result);
	@message.text("'");
	return @this.backend->error(function->token(), message.view());
};

fn FunctionEmitter::address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::variant_cast:
			return @this.variant_cast_address(expression);
		case semantic_kind::variant_payload:
			return this.variant_payload_address;
		case semantic_kind::name: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueValue* address = this.storage((var Entity*(entity)));

			if (!address) {
				discard @this.backend->error(expression->token(), "entity has no native storage");
				return nullptr;
			};

			if (entity->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(entity->type()), address, "reference\0".data());
			};

			return address;
		};

		case semantic_kind::access:
			return @this.address(expression->item(0));
		case semantic_kind::dereference:
			return @this.value(expression->item(0));
		case semantic_kind::call: {
			Type* callable = expression->item(0)->type();

			if (callable->kind() == type_kind::pointer) {
				@callable = callable->element();
			};

			if (callable->signature().result()->kind() == type_kind::reference) {
				return @this.call(expression);
			};

			break;
		};

		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy) {
				var assigned = @this.assign(expression);

				return assigned.address;
			};

			break;
		case semantic_kind::member: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);

			if (!address) {
				return nullptr;
			};

			var LLVMOpaqueValue* field = address;
			Type* owner = expression->entity()->scope()->owner()->type();

			if (owner->entity()->layout() == record_layout::sequential) {
				var LLVMOpaqueType* native = @this.backend->type(owner, expression->token());
				if (!native) {
					return nullptr;
				};
				@field = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(owner->entity(), expression->entity()->index()), "field\0".data());
			};

			if (expression->entity()->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->entity()->type()), field, "field.reference\0".data());
			};

			return field;
		};

		case semantic_kind::index: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* index = @this.value(expression->item(1));

			if (!index) {
				return nullptr;
			};

			Type* offset_type = expression->item(1)->type()->representation();
			bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
			@index = LLVMBuildIntCast2(this.backend->builder(), index, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "element.offset\0".data());

			rt::buffer<var LLVMOpaqueValue*> indices;
			var LLVMOpaqueValue* base;
			Type* element = object->type();

			if (element->kind() == type_kind::array) {
				@base = @this.address(object);

				@indices.push_back(LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 0, 0));
			}
			else {
				@base = @this.value(object);
				@element = element->element();
			};

			if (!base) {
				return nullptr;
			};

			@indices.push_back(index);

			var LLVMOpaqueType* native = @this.backend->type(element, expression->token());
			if (!native) {
				return nullptr;
			};
			return LLVMBuildGEP2(this.backend->builder(), native, base, (@indices).data(), static_cast<u32>(indices.size()), "element\0".data());
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				return @this.address(expression->item(0));
			};

			break;
		case semantic_kind::construction:
			if (expression->size() > 1) {
				var LLVMOpaqueValue* storage = @this.address(expression->item(1));

				if (!storage || !(@this.construct_into(expression, storage)).has<void>()) {
					return nullptr;
				};

				@this.set_live(expression->item(1), true);

				return storage;
			};

			discard @this.value(expression);

			return this.temporary(expression);
		case semantic_kind::sequence:
			if (expression->category() == value_category::place) {
				var LLVMOpaqueValue* result;

				if (!(@this.sequence(expression, native_evaluation::address, @result)).has<void>()) {
					return nullptr;
				};

				return result;
			};

			break;
	};

	if (expression->category() == value_category::consumable) {
		var LLVMOpaqueValue* value = @this.value(expression);

		if (!value) {
			return nullptr;
		};

		var LLVMOpaqueValue* storage = this.temporary(expression);

		if (storage) {
			return storage;
		};

		@storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		discard LLVMBuildStore(this.backend->builder(), value, storage);

		@this.remember(expression, storage);

		return storage;
	};

	discard @this.backend->error(expression->token(), "expression does not designate native storage");
	return nullptr;
};

fn FunctionEmitter::call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* callable = expression->item(0);
	Type* type = callable->type();

	if (type->kind() == type_kind::pointer) {
		@type = type->element();
	};

	if (type->kind() != type_kind::function) {
		discard @this.backend->error(expression->token(), "call target has no native function signature");
		return nullptr;
	};

	var LLVMOpaqueValue* function = @this.value(callable);

	if (!function) {
		return nullptr;
	};

	FunctionSignature& signature = type->signature();
	var SemanticExpression* source_arguments = expression->item(1);
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < source_arguments->size()) {
		var SemanticExpression* source = source_arguments->item(index);

		if (index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic && !source->type()->representation()->kind().is_scalar()) {
			var message = DiagnosticMessage();
			@message.text("aggregate variadic argument ");
			@message.number(u64(index + 1));
			@message.text(" of type '");
			diagnostic_type(@message, *source->type());
			@message.text("' requires unsupported C ABI lowering for callable '");
			if (callable->entity()) {
				diagnostic_entity(@message, *callable->entity());
			}
			else {
				diagnostic_type(@message, *type);
			};
			@message.text("'");
			discard @this.backend->error(source->token(), message.view());
			return nullptr;
		};

		var LLVMOpaqueValue* argument;

		if (index < signature.parameters().size() && signature.parameters().data()[index]->kind() == type_kind::reference) {
			@argument = @this.address(source);
		}
		else {
			@argument = @this.value(source);

			if (argument && index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic) {
				Type* type = FunctionEmitter::representation(source->type());

				if (type->kind() == type_kind::floating_point && type->bits() == 32) {
					@argument = LLVMBuildFPExt(this.backend->builder(), argument, LLVMDoubleTypeInContext(this.backend->context()), "vararg.float\0".data());
				}
				else if (type->kind() == type_kind::boolean || type->kind() == type_kind::character || (type->kind().is_integer() && type->bits() < 32)) {
					bool signed_value = type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean;
					@argument = LLVMBuildIntCast2(this.backend->builder(), argument, LLVMIntTypeInContext(this.backend->context(), 32), static_cast<i32>($signed_value), "vararg.integer\0".data());
				};
			};
		};

		if (!argument) {
			return nullptr;
		};

		@arguments.push_back(argument);

		@index = index + 1;
	};

	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	if (!native) {
		return nullptr;
	};
	@index = 0;
	while (index < source_arguments->size()) {
		if (index >= signature.parameters().size() || signature.parameters().data()[index]->kind() != type_kind::reference) {
			@this.consume(source_arguments->item(index));
		};
		@index = index + 1;
	};
	var LLVMOpaqueValue* specialized = this.backend->redirected_call(*expression, this.fact_context);
	if (specialized) {
		@function = specialized;
	};
	return @this.native_call(native, function, (@arguments).data(), static_cast<u32>(arguments.size()));
};

fn FunctionEmitter::native_slot(var FunctionEmitter& this, var LLVMOpaqueType* native) -> var LLVMOpaqueValue* {
	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		compiler_panic("cannot create a native storage builder");
	};

	var LLVMOpaqueBasicBlock* entry = LLVMGetEntryBasicBlock(this.function);
	var LLVMOpaqueValue* first = LLVMGetFirstInstruction((var LLVMOpaqueBasicBlock*(entry)));

	if (first) {
		LLVMPositionBuilderBefore(builder.get(), first);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), entry);
	};

	var LLVMOpaqueValue* storage = LLVMBuildAlloca(builder.get(), native, "storage\0".data());
	if (!storage) {
		compiler_panic("cannot allocate native storage");
	};
	return storage;
};

enum component_transfer : [u08] {
	initialize;
	copy_construct;
	copy_assign;
};

fn FunctionEmitter::initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	usize begin = this.unwinds.size();
	if (!(@this.initialize_body(type, address)).has<void>()) {
		return compilation_error();
	};
	@this.forget_unwinds(begin);
};

fn FunctionEmitter::initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return compilation_error();
	};

	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), address);

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, address, nullptr, component_transfer::initialize);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return;
	};

	var Entity* record = type->entity();
	var Entity* constructor = record->default_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text("default construction of '");
			diagnostic_type(@message, *type);
			@message.text("' selects deleted function '");
			diagnostic_entity(@message, *constructor);
			@message.text("' of type '");
			diagnostic_type(@message, *constructor->type());
			@message.text("'");
			discard @this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), "function is declared deleted here");
			return compilation_error();
		};

		var LLVMOpaqueValue*[1] inputs {};
		@inputs[0] = address;
		var LLVMOpaqueValue* callee = this.backend->symbol(constructor);
		if (!callee) {
			DiagnosticMessage message;
			@message.text("default construction has no native callee for '");
			diagnostic_entity(@message, *constructor);
			@message.text("'");
			compiler_panic(message.view());
		};
		if (!@this.native_call(@this.backend->type(constructor->type(), constructor->token()), callee, &@inputs[0], 1)) {
			return compilation_error();
		};

		return;
	};

	return @this.initialize_members(type, address);
};

fn FunctionEmitter::copy_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	usize begin = this.unwinds.size();
	if (!(@this.copy_initialize_body(type, destination, source)).has<void>()) {
		return compilation_error();
	};
	@this.forget_unwinds(begin);
};

fn FunctionEmitter::copy_initialize_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return compilation_error();
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_construct);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		discard LLVMBuildStore(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), native, source, "copied\0".data()), destination);

		return;
	};

	var Entity* record = type->entity();
	var Entity* constructor = record->copy_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text("member copy of '");
			diagnostic_type(@message, *type);
			@message.text("' selects deleted function '");
			diagnostic_entity(@message, *constructor);
			@message.text("' of type '");
			diagnostic_type(@message, *constructor->type());
			@message.text("'");
			discard @this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), "function is declared deleted here");
			return compilation_error();
		};

		if (record->layout() == record_layout::overlapping && constructor->definition() != function_definition::defaulted) {
			discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), destination);
		};

		var LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = source;
		if (!@this.native_call(@this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), &@inputs[0], 2)) {
			return compilation_error();
		};

		return;
	};

	return @this.copy_members(type, destination, source);
};

fn FunctionEmitter::move_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return compilation_error();
	};

	var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "move.source\0".data());

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		var Entity* constructor = type->entity()->move_constructor();

		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text("move construction of '");
			diagnostic_type(@message, *type);
			@message.text("' selects deleted function '");
			diagnostic_entity(@message, *constructor);
			@message.text("' of type '");
			diagnostic_type(@message, *constructor->type());
			@message.text("'");
			discard @this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), "function is declared deleted here");
			return compilation_error();
		};

		var LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = value;
		if (!@this.native_call(@this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), &@inputs[0], 2)) {
			return compilation_error();
		};

		return;
	};

	return @this.copy_representation(type, destination, source);
};

fn FunctionEmitter::generated(var FunctionEmitter& this, var Entity* function) -> CompilationResult {
	if (!function->parameters().size() || function->parameters().data()[0]->type()->kind() != type_kind::reference) {
		return @this.backend->error(function->token(), "defaulted function requires an object receiver");
	};

	Type* type = function->parameters().data()[0]->type()->element();
	var LLVMOpaqueValue* destination = LLVMGetParam(this.function, 0);
	if (aggregate_access_kind(type) == 2) {
		return @this.generated_variant(function, type, destination);
	};

	if (function->role() == function_role::constructor && function->parameters().size() == 1) {
		discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(@this.backend->type(type, function->token())), destination);

		if (!(@this.initialize_members(type, destination)).has<void>()) {
			return compilation_error();
		};
	}
	else if (function->role() == function_role::constructor && function->parameters().size() == 2) {
		var Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			var LLVMOpaqueValue* input = LLVMGetParam(this.function, 1);

			if (!(@this.copy_members(type, destination, input)).has<void>()) {
				return compilation_error();
			};
		}
		else {
			if (!(@this.copy_representation(type, destination, this.storage(source))).has<void>()) {
				return compilation_error();
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() == function_role::assignment && function->parameters().size() == 2) {
		var Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			if (!(@this.copy_assign_members(type, destination, LLVMGetParam(this.function, 1))).has<void>()) {
				return compilation_error();
			};
		}
		else {
			if (!(@this.destroy(type, destination)).has<void>()) {
				return compilation_error();
			};

			if (!(@this.move_initialize(type, destination, this.storage(source))).has<void>()) {
				return compilation_error();
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() != function_role::destructor) {
		return @this.backend->error(function->token(), "defaulted function role has no native implementation");
	};

	if (!(@this.cleanup_bindings(0)).has<void>()) {
		return compilation_error();
	};

	if (this.result->kind() == type_kind::void_type) {
		discard LLVMBuildRetVoid(this.backend->builder());
	}
	else if (this.result->kind() == type_kind::reference) {
		discard LLVMBuildRet(this.backend->builder(), destination);
	}
	else {
		discard LLVMBuildRet(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), @this.backend->type(this.result, function->token()), destination, "generated.result\0".data()));
	};

};

fn FunctionEmitter::transfer_elements(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, component_transfer operation) -> CompilationResult {
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	usize unwind_begin = this.unwinds.size();
	var LLVMOpaqueValue* constructed;
	if (operation != component_transfer::copy_assign && FunctionEmitter::needs_destruction(type->element())) {
		@constructed = @this.native_slot(integer);
		discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(integer), constructed);
		@this.retain_unwind(type->element(), destination, constructed, nullptr);
	};
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block("array.initialize.test");
	var LLVMOpaqueBasicBlock* body = @this.block("array.initialize.element");
	var LLVMOpaqueBasicBlock* after = @this.block("array.initialize.after");
	discard LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "index\0".data());
	discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, LLVMConstInt(integer, type->count(), 0), "within.array\0".data()), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue*[2] indices {};
	@indices[0] = LLVMConstNull(integer);
	@indices[1] = index;
	var LLVMOpaqueValue* output = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), destination, &@indices[0], 2, "initialize.destination\0".data());

	if (operation != component_transfer::initialize) {
		var LLVMOpaqueValue* input = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), source, &@indices[0], 2, "initialize.source\0".data());

		if (operation == component_transfer::copy_assign) {
			if (!(@this.copy_assign(type->element(), output, input)).has<void>()) {
				return compilation_error();
			};
		}
		else {
			if (!(@this.copy_initialize(type->element(), output, input)).has<void>()) {
				return compilation_error();
			};
		};
	}
	else {
		if (!(@this.initialize(type->element(), output)).has<void>()) {
			return compilation_error();
		};
	};

	var LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "next\0".data());
	if (constructed) {
		discard LLVMBuildStore(this.backend->builder(), next, constructed);
	};
	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	discard LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	@this.forget_unwinds(unwind_begin);

};

fn FunctionEmitter::initialize_value(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* expression) -> CompilationResult {
	usize begin = this.unwinds.size();
	if (!(@this.initialize_value_body(type, address, expression)).has<void>()) {
		return compilation_error();
	};
	@this.forget_unwinds(begin);
};

fn FunctionEmitter::initialize_value_body(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* expression) -> CompilationResult {
	if (!expression || expression->kind() == semantic_kind::noop) {
		return @this.initialize(type, address);
	};

	if (type->kind() == type_kind::reference) {
		var LLVMOpaqueValue* value = @this.address(expression);

		if (!value) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), value, address);

		return;
	};

	if (expression->kind() == semantic_kind::construction && expression->category() == value_category::consumable) {
		return @this.construct_into(expression, address);
	};

	var LLVMOpaqueValue* value = @this.take(expression);

	if (!value) {
		return compilation_error();
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		var LLVMOpaqueValue* source = @this.slot(type);

		if (!source) {
			return compilation_error();
		};

		discard LLVMBuildStore(this.backend->builder(), value, source);

		return @this.move_initialize(type, address, source);
	};

	discard LLVMBuildStore(this.backend->builder(), value, address);

};

fn FunctionEmitter::finish_expression(var FunctionEmitter& this) -> CompilationResult {
	if (!(@this.cleanup_temporaries(0)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(0);

};

fn FunctionEmitter::copy_representation(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return compilation_error();
	};

	if (type->kind() != type_kind::array && (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record)) {
		var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "transfer.value\0".data());
		discard LLVMBuildStore(this.backend->builder(), value, destination);

		return;
	};

	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	var LLVMOpaqueValue* bytes = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 64), size, 0);
	discard LLVMBuildMemCpy(this.backend->builder(), destination, 0, source, 0, bytes);

};

fn FunctionEmitter::initialize_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return;
	};

	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return compilation_error();
	};

	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), native, address, static_cast<u32>(index), "initialize.base\0".data());

		if (!(@this.initialize(record->bases().data()[index], base)).has<void>()) {
			return compilation_error();
		};
		@this.retain_unwind(record->bases().data()[index], base, nullptr, nullptr);

		@index = index + 1;
	};

	if (!(@this.initialize_dispatch(type, address)).has<void>()) {
		return compilation_error();
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];

		if (field->type()->kind() == type_kind::reference && !field->body()) {
			var message = DiagnosticMessage();
			@message.text("reference member '");
			diagnostic_entity(@message, *field);
			@message.text("' of type '");
			diagnostic_type(@message, *field->type());
			@message.text("' requires an explicit initializer");
			return @this.backend->error(field->token(), message.view());
		};

		var LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(record, index), "initialize.field\0".data());
		usize temporary_boundary = this.temporaries.size();

		if (!(@this.initialize_value(field->type(), member, field->body())).has<void>()) {
			return compilation_error();
		};
		@this.retain_unwind(field->type(), member, nullptr, nullptr);
		if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
			return compilation_error();
		};

		@this.forget_temporaries(temporary_boundary);
		@index = index + 1;
	};

};

fn FunctionEmitter::copy_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	var LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "copy.base.destination\0".data());
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "copy.base.source\0".data());

		if (!(@this.copy_initialize(record->bases().data()[index], output, input)).has<void>()) {
			return compilation_error();
		};
		@this.retain_unwind(record->bases().data()[index], output, nullptr, nullptr);

		@index = index + 1;
	};

	if (!(@this.initialize_dispatch(type, destination)).has<void>()) {
		return compilation_error();
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "copy.field.destination\0".data());
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "copy.field.source\0".data());

		if (!(@this.copy_initialize(field->type(), output, input)).has<void>()) {
			return compilation_error();
		};
		@this.retain_unwind(field->type(), output, nullptr, nullptr);

		@index = index + 1;
	};

};

fn FunctionEmitter::copy_assign(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		Token token;

		return @this.backend->error(token, "generated assignment cannot replace a const or reference component");
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_assign);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return @this.copy_initialize(type, destination, source);
	};

	var CopyAssignmentPlan* assignment = type->entity()->copy_assignment();

	if (!assignment) {
		return @this.backend->error(type->entity()->token(), "member copy assignment has no prepared function");
	};

	usize binding_boundary = this.bindings.size();
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* destination_slot = @this.slot(assignment->destination().type());
	var LLVMOpaqueValue* source_slot = @this.slot(assignment->source().type());

	if (!destination_slot || !source_slot) {
		return compilation_error();
	};

	discard LLVMBuildStore(this.backend->builder(), destination, destination_slot);
	discard LLVMBuildStore(this.backend->builder(), source, source_slot);

	@this.bind(&@assignment->destination(), destination_slot);
	@this.bind(&@assignment->source(), source_slot);

	if (!@this.value(&@assignment->expression()) || !(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return compilation_error();
	};

	@this.forget_temporaries(temporary_boundary);

	return @this.leave_scope(binding_boundary);
};

fn FunctionEmitter::copy_assign_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> CompilationResult {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	var LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "assign.base.destination\0".data());
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "assign.base.source\0".data());

		if (!(@this.copy_assign(record->bases().data()[index], output, input)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "assign.field.destination\0".data());
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "assign.field.source\0".data());

		if (!(@this.copy_assign(field->type(), output, input)).has<void>()) {
			return compilation_error();
		};

		@index = index + 1;
	};

};

fn FunctionEmitter::needs_destruction(Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return FunctionEmitter::needs_destruction(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return false;
	};

	var Entity* record = type->entity();

	if (record->destructor()) {
		return true;
	};
	if (record->layout() == record_layout::overlapping) {
		return false;
	};

	usize index = 0;

	while (index < record->bases().size()) {
		if (FunctionEmitter::needs_destruction(record->bases().data()[index])) {
			return true;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn FunctionEmitter::destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> CompilationResult {
	if (!FunctionEmitter::needs_destruction(type)) {
		return;
	};

	if (type->kind() == type_kind::array) {
		var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
		var LLVMOpaqueValue* count = LLVMConstInt(integer, type->count(), 0);

		return @this.destroy_range(type->element(), address, count);
	};

	var Entity* record = type->entity();
	var Entity* destructor = record->destructor();
	usize unwind_begin = this.unwinds.size();
	bool protect_components = !this.unwind_depth && record->layout() == record_layout::sequential && aggregate_access_kind(type) != 2;

	if (!(@this.initialize_dispatch(type, address)).has<void>()) {
		return compilation_error();
	};
	if (protect_components) {
		@this.retain_components(type, address);
	};

	if (record->layout() == record_layout::overlapping && (!destructor || destructor->definition() == function_definition::defaulted && destructor->origin() == declaration_origin::compiler_supplied)) {
		usize index = 0;

		while (index < record->fields().size()) {
			if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
				var Entity* member = record->fields().data()[index];
				var message = DiagnosticMessage();
				@message.text("union '");
				diagnostic_entity(@message, *record);
				@message.text("' requires an explicit destructor because member '");
				diagnostic_entity(@message, *member);
				@message.text("' of type '");
				diagnostic_type(@message, *member->type());
				@message.text("' requires destruction");
				discard @this.backend->error(record->token(), message.view());
				@this.backend->note(member->token(), "member requiring destruction is declared here");
				return compilation_error();
			};

			@index = index + 1;
		};
	};

	if (destructor) {
		if (destructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text("destruction of '");
			diagnostic_type(@message, *type);
			@message.text("' selects deleted destructor '");
			diagnostic_entity(@message, *destructor);
			@message.text("' of type '");
			diagnostic_type(@message, *destructor->type());
			@message.text("'");
			discard @this.backend->error(destructor->token(), message.view());
			@this.backend->note(destructor->token(), "destructor is declared deleted here");
			return compilation_error();
		};

		var LLVMOpaqueValue*[1] arguments {};
		@arguments[0] = address;
		var LLVMOpaqueValue* callee = this.backend->symbol(destructor);
		if (!callee) {
			DiagnosticMessage message;
			@message.text("destruction has no native callee for '");
			diagnostic_entity(@message, *destructor);
			@message.text("'");
			compiler_panic(message.view());
		};
		if (!@this.native_call(@this.backend->type(destructor->type(), destructor->token()), callee, &@arguments[0], 1)) {
			return compilation_error();
		};
	};

	if (record->layout() == record_layout::overlapping || aggregate_access_kind(type) == 2) {
		return;
	};

	usize index = record->fields().size();

	while (index) {
		@index = index - 1;
		var Entity* field = record->fields().data()[index];

		if (FunctionEmitter::needs_destruction(field->type())) {
			if (protect_components) {
				@this.forget_unwinds(this.unwinds.size() - 1);
			};
			var LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type, field->token()), address, this.backend->field_index(record, index), "destroy.field\0".data());

			if (!(@this.destroy(field->type(), member)).has<void>()) {
				return compilation_error();
			};
		};
	};

	@index = record->bases().size();

	while (index) {
		@index = index - 1;
		var LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, static_cast<u32>(index), "destroy.base\0".data());
		if (protect_components && FunctionEmitter::needs_destruction(record->bases().data()[index])) {
			@this.forget_unwinds(this.unwinds.size() - 1);
		};

		if (!(@this.destroy(record->bases().data()[index], base)).has<void>()) {
			return compilation_error();
		};
	};
	@this.forget_unwinds(unwind_begin);

};

fn FunctionEmitter::slot(var FunctionEmitter& this, Type* type) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return nullptr;
	};

	return @this.native_slot(native);
};

fn FunctionEmitter::live_flag(var FunctionEmitter& this) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	var LLVMOpaqueValue* flag = @this.native_slot(boolean);

	if (!flag) {
		compiler_panic("cannot allocate a native lifetime flag");
	};

	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		compiler_panic("cannot create a native lifetime builder");
	};

	var LLVMOpaqueValue* next = LLVMGetNextInstruction(flag);

	if (next) {
		LLVMPositionBuilderBefore(builder.get(), next);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), LLVMGetEntryBasicBlock(this.function));
	};

	discard LLVMBuildStore(builder.get(), LLVMConstNull(boolean), flag);

	return flag;
};

fn FunctionEmitter::temporary(FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;

		if (this.temporaries.data()[index].expression == expression) {
			return this.temporaries.data()[index].address;
		};
	};

	return nullptr;
};

fn FunctionEmitter::remember(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) {
	NativeTemporary temporary;
	@temporary.expression = expression;
	@temporary.address = address;
	@this.lifetime_order = this.lifetime_order + 1;
	@temporary.order = this.lifetime_order;

	if (FunctionEmitter::needs_destruction(expression->type())) {
		@temporary.live = @this.live_flag();

		if (!temporary.live) {
			compiler_panic("cannot create a native temporary lifetime flag");
		};

		discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), temporary.live);
	};

	@this.temporaries.push_back($temporary);
	@this.lifetime_revision = this.lifetime_revision + 1;

};

fn FunctionEmitter::value(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var LLVMOpaqueValue* value = @this.evaluate(expression);

	if (!value) {
		return nullptr;
	};

	if (expression->category() == value_category::consumable && FunctionEmitter::needs_destruction(expression->type()) && !this.temporary(expression)) {
		var LLVMOpaqueValue* storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		discard LLVMBuildStore(this.backend->builder(), value, storage);

		@this.remember(expression, storage);
	};

	return value;
};

fn FunctionEmitter::take(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var LLVMOpaqueValue* value = @this.value(expression);
	@this.consume(expression);
	return value;
};

fn FunctionEmitter::consume(var FunctionEmitter& this, var SemanticExpression* expression) {
	if (expression->kind() == semantic_kind::variant_payload && this.variant_payload_live) {
		discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(LLVMIntTypeInContext(this.backend->context(), 1)), this.variant_payload_live);
	};

	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;
		NativeTemporary& temporary = this.temporaries.data()[index];

		if (temporary.expression == expression && temporary.live) {
			discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(LLVMIntTypeInContext(this.backend->context(), 1)), temporary.live);
			break;
		};
	};

};

fn FunctionEmitter::set_live(var FunctionEmitter& this, var SemanticExpression* expression, bool live) {
	if (expression->indirect_storage()) {
		return;
	};

	@this.binding_live(expression->owned_binding(), live);
};

fn FunctionEmitter::binding_live(var FunctionEmitter& this, var Entity* entity, bool live) {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;
		NativeBinding& binding = this.bindings.data()[index];

		if (binding.entity == entity && binding.live) {
			discard LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), static_cast<u64>(live), 0), binding.live);
			return;
		};
	};
};

fn FunctionEmitter::guarded_destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* live) -> CompilationResult {
	if (!live) {
		return;
	};

	var LLVMOpaqueBasicBlock* destroy = @this.block("cleanup.destroy");
	var LLVMOpaqueBasicBlock* after = @this.block("cleanup.after");
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	discard LLVMBuildCondBr(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), boolean, live, "live\0".data()), destroy, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);
	discard LLVMBuildStore(this.backend->builder(), LLVMConstNull(boolean), live);

	if (!(@this.destroy(type, address)).has<void>()) {
		return compilation_error();
	};

	discard LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

};

fn FunctionEmitter::cleanup_temporaries(var FunctionEmitter& this, usize begin) -> CompilationResult {
	usize index = this.temporaries.size();

	while (index > begin) {
		@index = index - 1;
		NativeTemporary& temporary = this.temporaries.data()[index];

		if (!(@this.guarded_destroy(temporary.expression->type(), temporary.address, temporary.live)).has<void>()) {
			return compilation_error();
		};
	};

};

fn FunctionEmitter::cleanup_bindings(var FunctionEmitter& this, usize begin) -> CompilationResult {
	usize index = this.bindings.size();

	while (index > begin) {
		@index = index - 1;
		NativeBinding& binding = this.bindings.data()[index];

		if (!(@this.guarded_destroy(binding.entity->type(), binding.address, binding.live)).has<void>()) {
			return compilation_error();
		};
	};

};

fn FunctionEmitter::forget_temporaries(var FunctionEmitter& this, usize begin) {
	while (this.temporaries.size() > begin) {
		@this.temporaries.pop_back();
		@this.lifetime_revision = this.lifetime_revision + 1;
	};
};

fn FunctionEmitter::leave_scope(var FunctionEmitter& this, usize begin) -> CompilationResult {
	if (!this.terminated() && !(@this.cleanup_bindings(begin)).has<void>()) {
		return compilation_error();
	};

	while (this.bindings.size() > begin) {
		@this.bindings.pop_back();
		@this.lifetime_revision = this.lifetime_revision + 1;
	};

};

fn FunctionEmitter::scoped_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> CompilationResult {
	usize begin = this.bindings.size();

	if (!(@this.statement(expression)).has<void>()) {
		return compilation_error();
	};

	return @this.leave_scope(begin);
};

