struct unique_ptr {
	void* pointer;

	fn unique_ptr(unique_ptr& this);
	fn unique_ptr(unique_ptr& this, null* pointer);
	fn unique_ptr(unique_ptr& this, void* pointer);
	fn unique_ptr(unique_ptr& this, const unique_ptr& other) : delete;
	fn operator=(unique_ptr& this, const unique_ptr& other) -> unique_ptr& : delete;
	fn operator=(unique_ptr& this, unique_ptr other) -> unique_ptr&;
	fn get(const unique_ptr& this) -> void*;
	fn release(unique_ptr& this) -> void*;
	fn reset(unique_ptr& this, void* pointer);
	fn ~unique_ptr(unique_ptr& this);
};

fn unique_ptr::unique_ptr(unique_ptr& this) {
	@this.pointer = nullptr;
};

fn unique_ptr::unique_ptr(unique_ptr& this, null* pointer) {
	@this.pointer = $pointer;
};

fn unique_ptr::unique_ptr(unique_ptr& this, void* pointer) {
	@this.pointer = $pointer;
};

fn unique_ptr::operator=(unique_ptr& this, unique_ptr other) -> unique_ptr& {
	unique_ptr::reset(@this, unique_ptr::release(@other));
	discard other;
	return @this;
};

fn unique_ptr::get(const unique_ptr& this) -> void* {
	return (void*)this.pointer;
};

fn unique_ptr::release(unique_ptr& this) -> void* {
	void* pointer := this.pointer;
	@this.pointer = nullptr;
	return $pointer;
};

fn unique_ptr::reset(unique_ptr& this, void* pointer) {
	void* previous := this.pointer;
	@this.pointer = $pointer;
	if (!previous) {
		return;
	};
	free($previous);
};

fn unique_ptr::~unique_ptr(unique_ptr& this) {
	if (!this.pointer) {
		return;
	};
	free((void*)this.pointer);
};

struct Arena {
	Allocation* head;

	fn ~Arena(Arena& this) {
		while (this.head) {
			Allocation* allocation := this.head;
			@this.head := allocation->next;
			free((void*)allocation->memory);
			free((void*)allocation);
		};
	};
};

