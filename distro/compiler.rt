enum FilePurpose {
	SOURCE_FILE,
	OBJECT_FILE,
};

struct File {
	Compiler* compiler;
	void* handle;
	Token location;
	FilePurpose purpose;

	fn File(File& this, Compiler* compiler, char* path, FilePurpose purpose, Token location) {
		@this.compiler = $compiler;
		@this.location = $location;
		@this.purpose := purpose;
		char* mode = "rb\0";
		char* failure = "cannot open source\0";
		if (purpose == OBJECT_FILE) {
			@mode = "wb\0";
			@failure = "cannot open native object output\0";
		};
		@this.handle = this.compiler->open_file($path, $mode);
		if (!this.handle) {
			compiler_error((Compiler*)this.compiler, Token(this.location), (char*)failure);
		};
	};

	fn ~File(File& this) {
		if (!this.handle) {
			return;
		};
		if (fclose((void*)this.handle)) {
			char* failure = "cannot read source\0";
			if (this.purpose == OBJECT_FILE) {
				@failure = "cannot write native object output\0";
			};
			compiler_error((Compiler*)this.compiler, Token(this.location), (char*)failure);
		};
	};
};

enum CompilationResult {
	COMPILATION_SUCCESS,
	COMPILATION_FAILURE,
};

enum OutputKind {
	OUTPUT_EXECUTABLE,
	OUTPUT_LIBRARY,
};

struct Compiler {
	Arena allocations;
	LLVMContextOwner llvm_context;
	LLVMTargetMachineOwner llvm_machine;
	LLVMModuleOwner llvm_module;
	LLVMBuilderOwner llvm_builder;
	LLVMLayoutOwner llvm_layout;
	CompilationResult result;
	Source* sources;
	Syntax* declarations;
	Scope* module;
	DeclarationRule[4] declaration_rules;
	((char* path, char* mode) -> void*)* open_file;
	void* diagnostics;
	RuntimeView* runtime_views;
	RuntimeThunk* runtime_thunks;
	RuntimeWrapper* runtime_wrappers;
	OutputKind output;
	char* entry;
	i32 optimization;
	Type* void_type;
	Type* null_type;
	Type* bool_type;
	Type* i32_type;
	Type* usize_type;
	Type* char_type;

	fn Compiler(Compiler& this) {
	};

	fn Compiler(Compiler& this, Compiler* storage) {
		if (!storage) {
			return;
		};
		memcpy((void*)&this, (void*)storage, sizeof(Compiler));
		memset((void*)storage, 0, sizeof(Compiler));
	};
};

