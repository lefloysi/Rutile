fn LLVMBuildIntCast2(void* builder, void* value, void* type, i32 signed_value, char* name) -> void*;
fn LLVMBuildFPCast(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildFPToSI(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildFPToUI(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildSIToFP(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildUIToFP(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildPtrToInt(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildIntToPtr(void* builder, void* value, void* type, char* name) -> void*;
fn LLVMBuildSelect(void* builder, void* condition, void* first, void* second, char* name) -> void*;
fn LLVMGetEnumAttributeKindForName(char* name, usize length) -> u32;
fn LLVMCreateEnumAttribute(void* context, u32 kind, u64 value) -> void*;
fn LLVMAddAttributeAtIndex(void* function, u32 index, void* attribute);
fn LLVMAddCallSiteAttribute(void* call, u32 index, void* attribute);
fn LLVMVerifyModule(void* module, i32 action, char** message) -> i32;
fn LLVMCreatePassBuilderOptions() -> void*;
fn LLVMDisposePassBuilderOptions(void* options);
fn LLVMPassBuilderOptionsSetVerifyEach(void* options, i32 enabled);
fn LLVMRunPasses(void* module, char* passes, void* machine, void* options) -> void*;
fn LLVMGetErrorMessage(void* error) -> char*;
fn LLVMDisposeErrorMessage(char* message);
fn LLVMTargetMachineEmitToMemoryBuffer(void* machine, void* module, i32 kind, char** message, void** buffer) -> i32;
fn LLVMGetBufferStart(void* buffer) -> char*;
fn LLVMGetBufferSize(void* buffer) -> usize;
fn LLVMDisposeMemoryBuffer(void* buffer);

enum ValueCategory {
	VALUE_ENTITY,
	VALUE_STORAGE,
	VALUE_TEMPORARY,
};

struct Semantic {
	Compiler* compiler;
	Scope* scope;
	Entity* function;
	Flow* flow;
	Type* selection_type;
};

struct Emitter {
	void* llvm_function;
	Type* return_type;
	Compiler* compiler;
	Entity* function;
	Flow* flow;
	CaseBlock* cases;
	Temporary* temporaries;
};

struct Temporary {
	Type* type;
	void* address;
	void* guard;
	Temporary* next;
};

struct CaseBlock {
	Syntax* syntax;
	void* block;
	Temporary* temporaries;
	CaseBlock* next;
};

struct CaseValue {
	u64 value;
	CaseValue* next;
};

fn entity_type(Entity* entity) -> Type* {
	switch (entity->kind) {
		case ENTITY_PRIMITIVE:
			return (Type*)entity->data.primitive.type;
		case ENTITY_STRUCT:
		case ENTITY_UNION:
			return (Type*)entity->data.aggregate.type;
		case ENTITY_ENUM:
			return (Type*)entity->data.enumeration.type;
		case ENTITY_FUNCTION:
			return (Type*)entity->data.function.type;
		case ENTITY_VARIABLE:
			return (Type*)entity->data.variable.type;
		default:
			return nullptr;
	};
};

fn type_new(Compiler* compiler, TypeKind kind) -> Type* {
	Type* type = (Type*)memory_allocate($compiler, sizeof(Type));
	if (!type) {
		return nullptr;
	};

	@type->kind = $kind;

	return $type;
};

fn type_pointer(Compiler* compiler, Type* element) -> Type* {
	Type* type = type_new($compiler, TYPE_POINTER);
	if (!type) {
		return nullptr;
	};

	@type->data.element = $element;

	return $type;
};

fn type_equal(Type* first, Type* second) -> i32 {
	if (first == second) {
		return 1;
	};
	if (!first || !second || first->kind != second->kind || first->qualifier != second->qualifier) {
		return 0;
	};
	switch (first->kind) {
		case TYPE_VOID:
		case TYPE_NULL:
		case TYPE_BOOL:
		case TYPE_CHAR:
			return 1;
		case TYPE_SIGNED:
		case TYPE_UNSIGNED:
		case TYPE_FLOAT:
			return first->data.bits == second->data.bits;
		case TYPE_NAMED:
			return first->data.entity == second->data.entity;
		case TYPE_POINTER:
		case TYPE_REFERENCE:
			return type_equal((Type*)first->data.element, (Type*)second->data.element);
		case TYPE_ARRAY:
			return first->data.array.count == second->data.array.count && type_equal((Type*)first->data.array.element, (Type*)second->data.array.element);
		case TYPE_FUNCTION: {
			if (first->data.function.arity != second->data.function.arity || !type_equal((Type*)first->data.function.result, (Type*)second->data.function.result)) {
				return 0;
			};
			Parameter* a := first->data.function.parameters;
			Parameter* b := second->data.function.parameters;
			while (a && b) {
				if (!type_equal((Type*)a->type, (Type*)b->type)) {
					return 0;
				};
				@a := a->next;
				@b := b->next;
			};
			return !a && !b;
		};
	};
	return 0;
};

fn type_qualified(Compiler* compiler, Type* type, TypeQualifier qualifier) -> Type* {
	if (type->qualifier == qualifier) {
		return $type;
	};
	Type* result = (Type*)memory_allocate($compiler, sizeof(Type));
	@*result := *type;
	@result->qualifier = $qualifier;
	return $result;
};

fn type_value_equal(Type* first, Type* second) -> bool {
	if (!first || !second) {
		return false;
	};
	Type a := *first;
	Type b := *second;
	@a.qualifier = MUTABLE_TYPE;
	@b.qualifier = MUTABLE_TYPE;
	return type_equal(&a, &b);
};

fn type_numeric(Type* type) -> i32 {
	return type && (type->kind == TYPE_CHAR || type->kind == TYPE_BOOL || type->kind == TYPE_SIGNED || type->kind == TYPE_UNSIGNED || type->kind == TYPE_FLOAT || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_ENUM));
};

fn type_integer(Type* type) -> i32 {
	return type_numeric((Type*)type) && type->kind != TYPE_FLOAT;
};

fn type_null_pointer(Type* type) -> bool {
	return type && type->kind == TYPE_POINTER && type->data.element->kind == TYPE_NULL;
};
fn type_pointer_conversion(Type* source, Type* target) -> bool {
	if (!source || !target || source->kind != TYPE_POINTER || target->kind != TYPE_POINTER) {
		return false;
	};
	if (type_null_pointer((Type*)source)) {
		return true;
	};
	if (source->data.element->qualifier == CONST_TYPE && target->data.element->qualifier != CONST_TYPE) {
		return false;
	};
	return type_value_equal((Type*)source->data.element, (Type*)target->data.element) || (target->data.element->kind == TYPE_VOID && source->data.element->kind != TYPE_FUNCTION);
};

fn type_scalar(Type* type) -> i32 {
	return type_numeric((Type*)type) || (type && (type->kind == TYPE_POINTER || type->kind == TYPE_REFERENCE));
};

fn type_aggregate(Type* type) -> i32 {
	if (!type) {
		return 0;
	};
	if (type->kind == TYPE_ARRAY) {
		return 1;
	};
	return type->kind == TYPE_NAMED && (type->data.entity->kind == ENTITY_STRUCT || type->data.entity->kind == ENTITY_UNION);
};

fn type_bits(Type* type) -> i32 {
	if (type->kind == TYPE_BOOL) {
		return 1;
	};
	if (type->kind == TYPE_CHAR) {
		return 8;
	};
	if (type->kind == TYPE_NAMED) {
		return 32;
	};
	return (i32)type->data.bits;
};

fn type_unsigned(Type* type) -> i32 {
	return type->kind == TYPE_UNSIGNED || type->kind == TYPE_BOOL;
};

fn type_resolve(Compiler* compiler, Scope* scope, Syntax* syntax) -> Type*;
fn entity_resolve(Compiler* compiler, Entity* entity);
fn llvm_body(Compiler* compiler, Entity* entity) -> void*;
fn llvm_type(Compiler* compiler, Type* type) -> void*;

fn integer_spelling(Compiler* compiler, Token token, u64 maximum) -> u64 {
	if (token.length && token.source->bytes[token.begin] == '\'') {
		char character := token.source->bytes[token.begin + 1];

		if (character == '\\') {
			@character = literal_escape((Compiler*)compiler, Token(token), (char)token.source->bytes[token.begin + 2]);
		};

		u64 value = (u64)character;

		if (value > maximum) {
			compiler_error((Compiler*)compiler, Token(token), "character literal is outside the destination range\0");
			return 0;
		};

		return $value;
	};

	u64 result = 0;
	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes[token.begin + index];

		if (!lexer_digit((char)character)) {
			compiler_error((Compiler*)compiler, Token(token), "expected a decimal integer literal\0");
			return 0;
		};

		u64 digit = (u64)(character - '0');

		if (result > maximum / 10 || (result == maximum / 10 && digit > maximum % 10)) {
			compiler_error((Compiler*)compiler, Token(token), "integer literal is outside the destination range\0");
			return 0;
		};

		@result = result * 10 + digit;
		@index = index + 1;
	};
	return $result;
};

fn number_truth(Compiler* compiler, Token token) -> u64 {
	if (token.source->bytes[token.begin] == '\'') {
		return integer_spelling($compiler, Token(token), 255) != 0;
	};

	usize index = 0;
	while (index < token.length) {
		char character := token.source->bytes[token.begin + index];
		if (character == 'e' || character == 'E') {
			break;
		};
		if (character >= '1' && character <= '9') {
			return 1;
		};

		@index = index + 1;
	};

	return 0;
};

fn type_resolve(Compiler* compiler, Scope* scope, Syntax* syntax) -> Type* {
	if (!syntax) {
		return (Type*)compiler->void_type;
	};
	if (syntax->type) {
		return (Type*)syntax->type;
	};
	Type* type = nullptr;
	switch (syntax->kind) {
		case SYNTAX_CONST:
			@type = type_qualified((Compiler*)compiler, type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.expression), CONST_TYPE);
			break;
		case SYNTAX_NAME: {
			Entity* entity = syntax_lookup((Scope*)scope, (Syntax*)syntax);
			if (!entity || (entity->kind != ENTITY_PRIMITIVE && entity->kind != ENTITY_STRUCT && entity->kind != ENTITY_UNION && entity->kind != ENTITY_ENUM)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "identifier does not name a type entity\0");
				return (Type*)compiler->void_type;
			};
			@syntax->entity := entity;
			if (!entity_type((Entity*)entity) && entity->kind != ENTITY_PRIMITIVE) {
				Type* named = type_new((Compiler*)compiler, TYPE_NAMED);
				@named->data.entity := entity;
				if (entity->kind == ENTITY_ENUM) {
					@entity->data.enumeration.type = (Type*)named;
				}
				else {
					@entity->data.aggregate.type = (Type*)named;
				};
			};
			@type = entity_type((Entity*)entity);
			break;
		};
		case SYNTAX_POINTER:
		case SYNTAX_REFERENCE: {
			TypeKind kind = TYPE_POINTER;
			if (syntax->kind == SYNTAX_REFERENCE) {
				@kind = TYPE_REFERENCE;
			};
			@type = type_new((Compiler*)compiler, (TypeKind)kind);
			@type->data.element = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.expression);
			if ((kind == TYPE_POINTER && type->data.element->kind == TYPE_REFERENCE) || (kind == TYPE_REFERENCE && (type->data.element->kind == TYPE_VOID || type->data.element->kind == TYPE_NULL || type->data.element->kind == TYPE_REFERENCE))) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "reference requires an object or function referent type\0");
			};
			break;
		};
		case SYNTAX_ARRAY:
			@type = type_new((Compiler*)compiler, TYPE_ARRAY);
			@type->data.array.count = integer_spelling((Compiler*)compiler, Token(syntax->data.array.count), (u64)18446744073709551615);
			@type->data.array.element = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.array.element);
			if (!type->data.array.count || type->data.array.element->kind == TYPE_VOID || type->data.array.element->kind == TYPE_NULL || type->data.array.element->kind == TYPE_FUNCTION || type->data.array.element->kind == TYPE_REFERENCE) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "array requires a positive length and a storage element type\0");
			};
			break;
		case SYNTAX_SIGNATURE: {
			@type = type_new((Compiler*)compiler, TYPE_FUNCTION);
			@type->data.function.result = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.signature.result);
			if (type->data.function.result->kind == TYPE_NULL) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "null is an unsized type and cannot be a function result\0");
			};
			@type->data.function.arity := syntax->data.signature.arity;
			Parameter* last = nullptr;
			ParameterSyntax* input := syntax->data.signature.parameters;
			while (input) {
				Parameter* parameter = (Parameter*)memory_allocate((Compiler*)compiler, sizeof(Parameter));
				@parameter->name := input->name;
				@parameter->type = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)input->type);
				if (parameter->type->kind == TYPE_VOID || parameter->type->kind == TYPE_NULL || parameter->type->kind == TYPE_FUNCTION) {
					compiler_error((Compiler*)compiler, Token(input->type->token), "parameter requires a storage type\0");
				};
				if (last) {
					@last->next := parameter;
				}
				else {
					@type->data.function.parameters := parameter;
				};
				@last = (Parameter*)parameter;
				@input := input->next;
			};
			break;
		};
		default:
			compiler_error((Compiler*)compiler, Token(syntax->token), "expected type expression\0");
			@type := compiler->void_type;
			break;
	};
	@syntax->type := type;
	return $type;
};

fn constant_selector(u64 value, Type* type) -> u64;

fn constant_integer(Compiler* compiler, Scope* scope, Syntax* syntax) -> u64 {
	if (syntax->kind == SYNTAX_NUMBER) {
		return integer_spelling((Compiler*)compiler, Token(syntax->token), (u64)18446744073709551615);
	};

	if (syntax->kind == SYNTAX_NAME) {
		Entity* entity = syntax_lookup((Scope*)scope, (Syntax*)syntax);
		if (entity && entity->kind == ENTITY_VARIABLE && entity->data.variable.storage == STORAGE_CONSTANT && entity->resolution == RESOLUTION_PENDING && entity->scope && entity->scope->owner && entity->scope->owner->kind == ENTITY_ENUM) {
			entity_resolve((Compiler*)compiler, (Entity*)entity->scope->owner);
		};
		if (entity && entity->kind == ENTITY_VARIABLE && entity->data.variable.storage == STORAGE_CONSTANT && entity->resolution == RESOLUTION_READY) {
			return (u64)entity->data.variable.data.integer;
		};
	};

	if (syntax->kind == SYNTAX_UNARY) {
		u64 value = constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.unary.value);
		if (syntax->data.unary.operation == TOKEN_MINUS) {
			return (u64)0 - value;
		};
		if (syntax->data.unary.operation == TOKEN_PLUS) {
			return $value;
		};
		if (syntax->data.unary.operation == TOKEN_BANG) {
			return (u64)!value;
		};
		if (syntax->data.unary.operation == TOKEN_TILDE) {
			return ~value;
		};
	};

	if (syntax->kind == SYNTAX_CAST) {
		Type* target = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.cast.type);
		if (!type_integer((Type*)target)) {
			compiler_error((Compiler*)compiler, Token(syntax->token), "constant cast requires an integer destination\0");
			return 0;
		};

		u64 value = constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.cast.value);
		@value = constant_selector((u64)value, (Type*)target);
		i32 bits = type_bits((Type*)target);
		if (!type_unsigned($target) && bits < 64) {
			u64 width = (u64)(64 - bits);
			u64 mask = (u64)18446744073709551615 >> width;
			if (value > mask / 2) {
				@value = value | ~mask;
			};
		};
		return $value;
	};

	if (syntax->kind == SYNTAX_BINARY) {
		u64 first = constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.binary.left);
		u64 second = constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)syntax->data.binary.right);
		if (compiler->result == COMPILATION_FAILURE) {
			return 0;
		};
		i64 signed_first := (i64)first;
		i64 signed_second := (i64)second;
		if ((syntax->data.binary.operation == TOKEN_SLASH || syntax->data.binary.operation == TOKEN_REMAINDER) && (!second || (signed_first == (i64)-9223372036854775808 && signed_second == (i64)-1))) {
			compiler_error((Compiler*)compiler, Token(syntax->token), "invalid constant division\0");
			return 0;
		};
		if ((syntax->data.binary.operation == TOKEN_SHIFT_LEFT || syntax->data.binary.operation == TOKEN_SHIFT_RIGHT) && second >= 64) {
			compiler_error((Compiler*)compiler, Token(syntax->token), "constant shift count is outside the integer width\0");
			return 0;
		};
		switch (syntax->data.binary.operation) {
			case TOKEN_PLUS:
				return first + second;
			case TOKEN_MINUS:
				return first - second;
			case TOKEN_STAR:
				return first * second;
			case TOKEN_AMPERSAND:
				return first & second;
			case TOKEN_PIPE:
				return first | second;
			case TOKEN_CARET:
				return first ^ second;
			case TOKEN_SHIFT_LEFT:
				return first << second;
			case TOKEN_SHIFT_RIGHT:
				return (u64)(signed_first >> signed_second);
			case TOKEN_SLASH:
				if (second) {
					return (u64)(signed_first / signed_second);
				};
				break;
			case TOKEN_REMAINDER:
				if (second) {
					return (u64)(signed_first % signed_second);
				};
				break;
			case TOKEN_EQUAL:
				return (u64)(first == second);
			case TOKEN_NOT_EQUAL:
				return (u64)(first != second);
			case TOKEN_LESS:
				return (u64)(signed_first < signed_second);
			case TOKEN_GREATER:
				return (u64)(signed_first > signed_second);
			case TOKEN_LESS_EQUAL:
				return (u64)(signed_first <= signed_second);
			case TOKEN_GREATER_EQUAL:
				return (u64)(signed_first >= signed_second);
			case TOKEN_AND:
				return (u64)(first && second);
			case TOKEN_OR:
				return (u64)(first || second);
		};
	};

	compiler_error($compiler, Token(syntax->token), "expected an integer constant expression\0");
	return 0;
};

fn constant_selector(u64 value, Type* type) -> u64 {
	i32 bits = type_bits($type);
	if (bits >= 64) {
		return $value;
	};

	u64 maximum = (u64)18446744073709551615;
	u64 shift = (u64)(64 - bits);
	return value & (maximum >> shift);
};

fn selection_validate(Semantic* semantic, Syntax* syntax, Type* type) {
	Syntax* statement := syntax->data.selection.cases->data.statements;
	CaseValue* values = nullptr;
	Syntax* fallback = nullptr;
	while (statement && semantic->compiler->result != COMPILATION_FAILURE) {
		if (statement->kind != SYNTAX_CASE) {
			@statement := statement->next;
			continue;
		};

		Syntax* expression := statement->data.selection_case.value;
		if (!expression) {
			if (fallback) {
				compiler_error((Compiler*)semantic->compiler, Token(statement->token), "duplicate default label\0");
				return;
			};
			@fallback := statement;
			@statement := statement->next;
			continue;
		};

		@expression->type := type;
		@expression->scope := syntax->data.selection.cases->scope;
		u64 value = constant_integer((Compiler*)semantic->compiler, (Scope*)expression->scope, $expression);
		@value = constant_selector((u64)value, (Type*)type);
		CaseValue* previous := values;
		while (previous) {
			if (previous->value == value) {
				compiler_error((Compiler*)semantic->compiler, Token(statement->token), "duplicate case value after conversion to the selector type\0");
				return;
			};
			@previous := previous->next;
		};

		CaseValue* selected = (CaseValue*)memory_allocate((Compiler*)semantic->compiler, sizeof(CaseValue));
		if (!selected) {
			return;
		};
		@selected->value = $value;
		@selected->next := values;
		@values = $selected;
		@statement := statement->next;
	};
};

fn interface_receiver_validate(Compiler* compiler, Entity* entity, Type* signature, Token token) {
	Entity* owner := entity->data.function.interface_owner;
	if (!owner && entity->data.function.role != ORDINARY_ROLE && entity->scope) {
		@owner := entity->scope->owner;
	};
	if (!owner) {
		return;
	};
	Parameter* receiver := signature->data.function.parameters;
	if (!receiver || !token_is(Token(receiver->name), "this\0") || receiver->type->kind != TYPE_REFERENCE || receiver->type->data.element->kind != TYPE_NAMED || receiver->type->data.element->data.entity != owner) {
		compiler_error((Compiler*)compiler, Token(token), "struct interface function requires its owning reference receiver named this\0");
		return;
	};
	if (entity->data.function.role == DESTRUCTOR_ROLE && (receiver->next || receiver->type->data.element->qualifier == CONST_TYPE || signature->data.function.arity != PARAMETERS_FIXED || signature->data.function.result->kind != TYPE_VOID)) {
		compiler_error((Compiler*)compiler, Token(token), "destructor requires exactly one mutable owning-type reference receiver named this\0");
	};
};

fn entity_resolve(Compiler* compiler, Entity* entity) {
	if (!entity || entity->resolution == RESOLUTION_READY) {
		return;
	};
	if (entity->resolution == RESOLUTION_ACTIVE) {
		compiler_error((Compiler*)compiler, Token(entity->name), "cyclic entity definition\0");
		return;
	};
	@entity->resolution = RESOLUTION_ACTIVE;
	Syntax* declaration := entity->declaration;
	if (!declaration) {
		compiler_error((Compiler*)compiler, Token(entity->name), "entity has no declaration\0");
		return;
	};
	if (entity->kind == ENTITY_FUNCTION) {
		@entity->data.function.type = type_resolve((Compiler*)compiler, (Scope*)entity->scope, (Syntax*)declaration->data.declaration.type);
		interface_receiver_validate((Compiler*)compiler, (Entity*)entity, (Type*)entity->data.function.type, Token(declaration->token));
		Parameter* receiver := entity->data.function.type->data.function.parameters;
		Entity* owner = nullptr;
		if (entity->scope) {
			@owner := entity->scope->owner;
		};
		if (owner && (owner->kind == ENTITY_STRUCT || owner->kind == ENTITY_UNION) && receiver && token_is(Token(receiver->name), "this\0") && (receiver->type->kind != TYPE_REFERENCE || receiver->type->data.element->kind != TYPE_NAMED || receiver->type->data.element->data.entity != owner)) {
			compiler_error((Compiler*)compiler, Token(receiver->name), "associated receiver must reference its owning type\0");
		};
		@entity->data.function.definition := declaration->data.declaration.definition;
		@entity->data.function.body := declaration->data.declaration.body;
		if (entity->data.function.body) {
			@entity->data.function.scope := entity->data.function.body->scope;
			Parameter* parameter := entity->data.function.type->data.function.parameters;
			while (parameter) {
				if (!parameter->name.source) {
					compiler_error((Compiler*)compiler, Token(entity->name), "function definition requires named parameters\0");
					break;
				};
				@parameter->entity = scope_lookup((Scope*)entity->data.function.scope, Token(parameter->name));
				if (parameter->entity && parameter->entity->kind == ENTITY_VARIABLE) {
					@parameter->entity->data.variable.type := parameter->type;
					@parameter->entity->resolution = RESOLUTION_READY;
				};
				@parameter := parameter->next;
			};
		};
	}
	else if (entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION || entity->kind == ENTITY_ENUM) {
		if (!entity_type((Entity*)entity)) {
			Type* type = type_new((Compiler*)compiler, TYPE_NAMED);
			@type->data.entity := entity;
			if (entity->kind == ENTITY_ENUM) {
				@entity->data.enumeration.type = (Type*)type;
			}
			else {
				@entity->data.aggregate.type = (Type*)type;
			};
		};
		bases_resolve((Compiler*)compiler, (Entity*)entity);
		usize base_count = 0;
		if (aggregate_header((Entity*)entity)) {
			@base_count = 1;
		};
		usize component := base_count;
		BaseRelation* layout_base := entity->data.aggregate.bases;
		while (layout_base) {
			if (layout_base->kind == BASE_NONVIRTUAL) {
				@layout_base->component := component;
				@component = component + 1;
			};
			@layout_base := layout_base->next;
		};
		if (entity->kind == ENTITY_STRUCT) {
			BaseRelation* base := entity->data.aggregate.bases;
			while (base && compiler->result != COMPILATION_FAILURE) {
				entity_resolve((Compiler*)compiler, (Entity*)base->entity);
				if (!base->entity->declaration || !base->entity->declaration->data.declaration.body) {
					compiler_error((Compiler*)compiler, Token(base->name->token), "base struct requires a complete definition\0");
					return;
				};
				if (base->kind == BASE_NONVIRTUAL) {
					@base_count = base_count + 1;
				};
				@base := base->next;
			};
		};
		Syntax* body := declaration->data.declaration.body;
		if (body) {
			Syntax* field := body->data.statements;
			usize index = 0;
			Field* last_field = nullptr;
			u64 next_value = 0;
			while (field) {
				if (field->kind != SYNTAX_DECLARATION) {
					compiler_error((Compiler*)compiler, Token(field->token), "aggregate context requires declarations\0");
					break;
				};
				if (field->entity->kind != ENTITY_VARIABLE) {
					if (entity->kind == ENTITY_ENUM) {
						compiler_error((Compiler*)compiler, Token(field->token), "enum context requires enumerator declarations\0");
						break;
					};
					@field := field->next;
					continue;
				};
				Entity* variable := field->entity;
				if (entity->kind == ENTITY_ENUM) {
					@variable->data.variable.type = entity_type((Entity*)entity);
					@variable->data.variable.storage = STORAGE_CONSTANT;
					if (field->data.declaration.body) {
						@next_value = constant_integer((Compiler*)compiler, (Scope*)body->scope, (Syntax*)field->data.declaration.body);
					};
					if ((i64)next_value < (i64)-2147483648 || (i64)next_value > (i64)2147483647) {
						compiler_error((Compiler*)compiler, Token(field->token), "enum value is outside the i32 range\0");
					};
					@variable->data.variable.data.integer := next_value;
					@next_value = next_value + 1;
				}
				else {
					@variable->data.variable.type = type_resolve((Compiler*)compiler, (Scope*)body->scope, (Syntax*)field->data.declaration.type);
					if (entity->kind == ENTITY_UNION && variable->data.variable.type->kind == TYPE_REFERENCE) {
						compiler_error((Compiler*)compiler, Token(field->token), "union cannot contain a reference field\0");
					};
					@variable->data.variable.storage = STORAGE_FIELD;
					@variable->data.variable.data.field.owner := entity;
					@variable->data.variable.data.field.index = base_count + index;
					Field* representation = (Field*)memory_allocate((Compiler*)compiler, sizeof(Field));
					@representation->entity := variable;
					if (last_field) {
						@last_field->next := representation;
					}
					else {
						@entity->data.aggregate.fields := representation;
					};
					@last_field = $representation;
					@index = index + 1;
				};
				@variable->resolution = RESOLUTION_READY;
				@field := field->next;
			};
			if (entity->kind == ENTITY_ENUM) {
				@entity->data.enumeration.values := body->scope->bindings;
			}
			else {
				@entity->data.aggregate.field_count = (u64)index;
			};
		};
	}
	else if (entity->kind == ENTITY_VARIABLE) {
		if (declaration->data.declaration.type) {
			@entity->data.variable.type = type_resolve((Compiler*)compiler, (Scope*)entity->scope, (Syntax*)declaration->data.declaration.type);
		};
	};
	@entity->resolution = RESOLUTION_READY;
};

fn type_effective(Type* type) -> Type* {
	if (type && type->kind == TYPE_REFERENCE) {
		return (Type*)type->data.element;
	};
	return $type;
};

fn syntax_storage_type(Syntax* syntax) -> Type* {
	if (syntax->kind == SYNTAX_BINARY && syntax->entity && syntax->entity->kind == ENTITY_FUNCTION && syntax->entity->data.function.role == ASSIGNMENT_ROLE) {
		return (Type*)syntax->entity->data.function.type->data.function.result;
	};
	if (syntax->kind == SYNTAX_ACCESS) {
		return syntax_storage_type((Syntax*)syntax->data.expression);
	};
	if (syntax->kind == SYNTAX_BASE_REFERENCE || syntax->kind == SYNTAX_BASE_POINTER) {
		return (Type*)syntax->data.base_conversion.target;
	};
	if (syntax->entity && syntax->entity->kind == ENTITY_VARIABLE) {
		return entity_type((Entity*)syntax->entity);
	};
	if (syntax->kind == SYNTAX_CAST && syntax->data.cast.type->type && syntax->data.cast.type->type->kind == TYPE_REFERENCE) {
		return (Type*)syntax->data.cast.type->type;
	};
	if (syntax->kind == SYNTAX_INDEX) {
		Type* object := syntax->data.binary.left->type;
		if (object->kind == TYPE_ARRAY) {
			return (Type*)object->data.array.element;
		};
		return (Type*)object->data.element;
	};
	if (syntax->kind == SYNTAX_UNARY && syntax->data.unary.operation == TOKEN_STAR) {
		return (Type*)syntax->data.unary.value->type->data.element;
	};
	if (syntax->kind == SYNTAX_CALL) {
		Type* callable := syntax->data.call.callable->type;
		if (callable->kind == TYPE_POINTER) {
			@callable := callable->data.element;
		};
		return (Type*)callable->data.function.result;
	};
	return (Type*)syntax->type;
};

fn syntax_category(Syntax* syntax) -> ValueCategory {
	if (syntax->kind == SYNTAX_BORROWED_COMPONENT) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_BASE_POINTER && syntax->data.base_conversion.request == IMPLICIT_BASE_CONVERSION) {
		return syntax_category((Syntax*)syntax->data.base_conversion.value);
	};
	if (syntax->kind == SYNTAX_INITIALIZE || syntax->kind == SYNTAX_BIND_REFERENCE) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_BINARY && (syntax->data.binary.operation == TOKEN_ASSIGN || syntax->data.binary.operation == TOKEN_COPY) && !syntax->entity) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_BINARY && syntax->entity && syntax->entity->kind == ENTITY_FUNCTION && syntax->entity->data.function.role == ASSIGNMENT_ROLE && syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_ACCESS) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_NAME && syntax->entity && syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage != STORAGE_CONSTANT) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_BASE_REFERENCE || (syntax->kind == SYNTAX_CAST && syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE) || syntax->kind == SYNTAX_MEMBER || syntax->kind == SYNTAX_INDEX || (syntax->kind == SYNTAX_CALL && syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE) || (syntax->kind == SYNTAX_UNARY && syntax->data.unary.operation == TOKEN_STAR)) {
		return VALUE_STORAGE;
	};
	if (syntax->kind == SYNTAX_NAME && syntax->entity && syntax->entity->kind != ENTITY_VARIABLE) {
		return VALUE_ENTITY;
	};
	return VALUE_TEMPORARY;
};

fn syntax_mutable_access(Syntax* syntax) -> bool {
	if (!syntax || !syntax->type || syntax->type->qualifier == CONST_TYPE) {
		return false;
	};
	if (syntax->kind == SYNTAX_ACCESS) {
		return true;
	};
	if (syntax->kind == SYNTAX_BINARY && (syntax->data.binary.operation == TOKEN_ASSIGN || syntax->data.binary.operation == TOKEN_COPY) && !syntax->entity) {
		return syntax_mutable_access((Syntax*)syntax->data.binary.left);
	};
	if (syntax->kind == SYNTAX_MEMBER) {
		return syntax_mutable_access((Syntax*)syntax->data.member.object);
	};
	if (syntax->kind == SYNTAX_INDEX) {
		return syntax_mutable_access((Syntax*)syntax->data.binary.left);
	};
	if (syntax->kind == SYNTAX_BASE_REFERENCE) {
		return syntax_mutable_access((Syntax*)syntax->data.base_conversion.value);
	};
	if (syntax->kind == SYNTAX_CAST && syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE) {
		return syntax_mutable_access((Syntax*)syntax->data.cast.value);
	};
	return false;
};

fn semantic_owned(Semantic* semantic, Syntax* syntax) {
	if (syntax_category((Syntax*)syntax) == VALUE_STORAGE) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "owned value requires an rvalue; relocate with '$' or construct a value\0");
		return;
	};
	@syntax->use = TRANSFERRED_VALUE;
};

fn special_select(Semantic* semantic, Entity* owner, FunctionRole role, Syntax* arguments, Token token) -> Entity* {
	Syntax* input := arguments;
	while (input) {
		if (!syntax_number_expression((Syntax*)input)) {
			semantic_expression((Semantic*)semantic, (Syntax*)input, nullptr);
		};
		@input := input->next;
	};
	Entity* candidate := *special_functions($owner, $role);
	Entity* selected = nullptr;
	i32 best = 2147483647;
	i32 matches = 0;
	while (candidate && semantic->compiler->result != COMPILATION_FAILURE) {
		entity_resolve((Compiler*)semantic->compiler, (Entity*)candidate);
		Parameter* parameter := candidate->data.function.type->data.function.parameters;
		if (parameter) {
			@parameter := parameter->next;
		};
		Syntax* argument := arguments;
		i32 rank = 0;
		while (argument && parameter) {
			Type* expected := parameter->type;
			Type* value_type := expected;
			if (expected->kind == TYPE_REFERENCE) {
				@value_type := expected->data.element;
				if (value_type->qualifier != CONST_TYPE && !syntax_mutable_access((Syntax*)argument)) {
					break;
				};
				if (syntax_category((Syntax*)argument) == VALUE_TEMPORARY) {
					@rank = rank + 1;
				};
			}
			else if (syntax_category((Syntax*)argument) == VALUE_STORAGE) {
				break;
			};
			if (syntax_number_expression((Syntax*)argument)) {
				if (value_type->kind == TYPE_POINTER && syntax_zero_pointer_constant((Syntax*)argument)) {
					@rank = rank + 2;
				}
				else if (!type_numeric((Type*)value_type)) {
					break;
				};
			}
			else {
				Type* actual = semantic_expression((Semantic*)semantic, (Syntax*)argument, nullptr);
				if (type_pointer_conversion((Type*)actual, (Type*)value_type) && !type_value_equal((Type*)actual, (Type*)value_type)) {
					@rank = rank + 2;
				}
				else if (!type_value_equal((Type*)actual, (Type*)value_type) && !(expected->kind == TYPE_REFERENCE && base_search((Compiler*)semantic->compiler, (Type*)actual, (Type*)value_type).count == 1)) {
					break;
				};
			};
			@parameter := parameter->next;
			@argument := argument->next;
		};
		if (!argument && !parameter) {
			if (rank < best) {
				@selected := candidate;
				@best = (i32)rank;
				@matches = 1;
			}
			else if (rank == best) {
				@matches = matches + 1;
			};
		};
		@candidate := candidate->data.function.overload_next;
	};
	if (matches > 1) {
		compiler_error((Compiler*)semantic->compiler, Token(token), "ambiguous special function call\0");
		return nullptr;
	};
	if (selected && selected->data.function.definition == FUNCTION_DELETED) {
		compiler_error((Compiler*)semantic->compiler, Token(token), "selected function is deleted\0");
		return nullptr;
	};
	if (selected) {
		Parameter* parameter := selected->data.function.type->data.function.parameters->next;
		Syntax* argument := arguments;
		while (argument && parameter) {
			semantic_expression((Semantic*)semantic, (Syntax*)argument, (Type*)parameter->type);
			if (parameter->type->kind != TYPE_REFERENCE) {
				semantic_owned((Semantic*)semantic, (Syntax*)argument);
			}
			else {
				@argument->use = OBSERVED_VALUE;
			};
			@argument := argument->next;
			@parameter := parameter->next;
		};
	};
	return $selected;
};

fn syntax_construct(Compiler* compiler, Syntax* syntax, Type* target) {
	Syntax* argument = (Syntax*)memory_allocate($compiler, sizeof(Syntax));
	@*argument := *syntax;
	@argument->next = nullptr;
	@argument->use = OBSERVED_VALUE;
	@syntax->kind = SYNTAX_CONSTRUCT;
	@syntax->type = nullptr;
	@syntax->entity = nullptr;
	@syntax->data.construction.target = $target;
	@syntax->data.construction.constructor = nullptr;
	@syntax->data.construction.arguments = $argument;
	@syntax->data.construction.slot = nullptr;
};

enum GeneratedOperation {
	DEFAULT_CONSTRUCTION,
	COPY_CONSTRUCTION,
	VALUE_ASSIGNMENT,
};

fn operation_function(Semantic* semantic, Type* type, GeneratedOperation operation, Token token) -> Entity* {
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return nullptr;
	};
	FunctionRole role = CONSTRUCTOR_ROLE;
	Syntax input;
	@input.kind = SYNTAX_BORROWED_COMPONENT;
	@input.type = type_qualified((Compiler*)semantic->compiler, (Type*)type, CONST_TYPE);
	@input.token := token;
	@input.use = TRANSFERRED_VALUE;
	if (operation == VALUE_ASSIGNMENT) {
		@role = ASSIGNMENT_ROLE;
		@input.kind = SYNTAX_OWNED_COMPONENT;
		@input.type := type;
	};
	Syntax* argument = &input;
	if (operation == DEFAULT_CONSTRUCTION) {
		@argument = nullptr;
	};
	return special_select($semantic, (Entity*)type->data.entity, $role, $argument, $token);
};

fn operation_has_callback(Semantic* semantic, Type* type, GeneratedOperation operation, Token token) -> bool {
	if (type_has_views((Type*)type)) {
		return true;
	};
	if (type->kind == TYPE_ARRAY) {
		return operation_has_callback((Semantic*)semantic, (Type*)type->data.array.element, (GeneratedOperation)operation, Token(token));
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	if (operation_function((Semantic*)semantic, (Type*)type, (GeneratedOperation)operation, Token(token))) {
		return true;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base) {
		if (operation_has_callback((Semantic*)semantic, entity_type((Entity*)base->entity), (GeneratedOperation)operation, Token(token))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field) {
		if (operation_has_callback((Semantic*)semantic, entity_type((Entity*)field->entity), (GeneratedOperation)operation, Token(token))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn constructor_members_validate(Semantic* semantic, Type* type, Token token) {
	if (type->kind != TYPE_NAMED || type->data.entity->kind != ENTITY_STRUCT) {
		return;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base && semantic->compiler->result != COMPILATION_FAILURE) {
		generated_operation_validate((Semantic*)semantic, entity_type((Entity*)base->entity), DEFAULT_CONSTRUCTION, Token(token));
		@base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field && semantic->compiler->result != COMPILATION_FAILURE) {
		generated_operation_validate((Semantic*)semantic, entity_type((Entity*)field->entity), DEFAULT_CONSTRUCTION, Token(token));
		@field := field->next;
	};
};
fn generated_operation_validate(Semantic* semantic, Type* type, GeneratedOperation operation, Token token) {
	if (semantic->compiler->result == COMPILATION_FAILURE) {
		return;
	};
	if (type->kind == TYPE_REFERENCE) {
		if (operation != COPY_CONSTRUCTION) {
			compiler_error((Compiler*)semantic->compiler, Token(token), "generated operation cannot default-bind or assign a reference component\0");
		};
		return;
	};
	if (operation == VALUE_ASSIGNMENT && type->qualifier == CONST_TYPE) {
		compiler_error((Compiler*)semantic->compiler, Token(token), "generated assignment cannot replace a const component\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		generated_operation_validate((Semantic*)semantic, (Type*)type->data.array.element, (GeneratedOperation)operation, Token(token));
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	Entity* function = operation_function((Semantic*)semantic, (Type*)type, (GeneratedOperation)operation, Token(token));
	if (function) {
		if (operation != VALUE_ASSIGNMENT) {
			constructor_members_validate((Semantic*)semantic, (Type*)type, Token(token));
		};
		if (operation != VALUE_ASSIGNMENT && type_has_reference((Type*)type)) {
			compiler_error((Compiler*)semantic->compiler, Token(token), "constructor reference-field binding syntax is not implemented\0");
		};
		return;
	};
	Entity* entity := type->data.entity;
	if (operation == DEFAULT_CONSTRUCTION && entity->data.aggregate.constructors) {
		compiler_error((Compiler*)semantic->compiler, Token(token), "user-declared constructors suppress the generated default constructor\0");
		return;
	};
	if (entity->kind == ENTITY_UNION) {
		if (operation == DEFAULT_CONSTRUCTION && entity->data.aggregate.fields) {
			Field* variant := entity->data.aggregate.fields;
			usize mutable_variants = 0;
			while (variant) {
				Type* member = entity_type((Entity*)variant->entity);
				while (member->kind == TYPE_ARRAY && member->qualifier != CONST_TYPE) {
					@member := member->data.array.element;
				};
				if (member->qualifier != CONST_TYPE) {
					@mutable_variants = mutable_variants + 1;
				};
				@variant := variant->next;
			};
			if (!mutable_variants) {
				compiler_error((Compiler*)semantic->compiler, Token(token), "generated default constructor is deleted for a union with only const variant members\0");
				return;
			};
		};
		if (operation == DEFAULT_CONSTRUCTION && (type_has_reference((Type*)type) || type_requires_union_choice((Type*)type))) {
			compiler_error((Compiler*)semantic->compiler, Token(token), "generated union construction requires explicit member initialization\0");
			return;
		};
		Field* field := entity->data.aggregate.fields;
		while (field) {
			Type* member = entity_type((Entity*)field->entity);
			if (operation_has_callback((Semantic*)semantic, (Type*)member, (GeneratedOperation)operation, Token(token))) {
				compiler_error((Compiler*)semantic->compiler, Token(token), "generated union operation is deleted for a nontrivial variant member\0");
				return;
			};
			generated_operation_validate((Semantic*)semantic, $member, (GeneratedOperation)operation, Token(token));
			@field := field->next;
		};
		return;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		generated_operation_validate((Semantic*)semantic, entity_type((Entity*)base->entity), (GeneratedOperation)operation, Token(token));
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		generated_operation_validate((Semantic*)semantic, entity_type((Entity*)field->entity), (GeneratedOperation)operation, Token(token));
		@field := field->next;
	};
};

fn semantic_expression(Semantic* semantic, Syntax* syntax, Type* expected) -> Type*;
fn semantic_statement(Semantic* semantic, Syntax* syntax);
fn layout_validate(Compiler* compiler, Type* type, LayoutVisit* parent, Token token);

fn syntax_zero_pointer_constant(Syntax* syntax) -> bool {
	if (syntax->kind != SYNTAX_NUMBER || !syntax->token.length) {
		return false;
	};
	usize index = 0;
	while (index < syntax->token.length) {
		if (syntax->token.source->bytes[syntax->token.begin + index] != '0') {
			return false;
		};
		@index = index + 1;
	};
	return true;
};
fn syntax_number_expression(Syntax* syntax) -> i32 {
	if (syntax->kind == SYNTAX_NUMBER) {
		return 1;
	};
	if (syntax->kind == SYNTAX_UNARY && (syntax->data.unary.operation == TOKEN_PLUS || syntax->data.unary.operation == TOKEN_MINUS)) {
		return syntax_number_expression((Syntax*)syntax->data.unary.value);
	};
	if (syntax->kind == SYNTAX_BINARY && syntax->data.binary.operation != TOKEN_ASSIGN && syntax->data.binary.operation != TOKEN_COPY) {
		return syntax_number_expression((Syntax*)syntax->data.binary.left) && syntax_number_expression((Syntax*)syntax->data.binary.right);
	};
	return 0;
};

fn storage_borrowed(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 0;
	};
	if (syntax_storage_type((Syntax*)syntax) && syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE) {
		return 1;
	};
	switch (syntax->kind) {
		case SYNTAX_MEMBER:
		case SYNTAX_INDEX:
			return 1;
		case SYNTAX_UNARY:
			return syntax->data.unary.operation == TOKEN_STAR;
		default:
			return 0;
	};
};

fn semantic_scope(Semantic* semantic, Scope* parsed) -> Scope* {
	Scope* scope = scope_create((Compiler*)semantic->compiler, (Scope*)semantic->scope, (ContextKind)parsed->context, (Entity*)parsed->owner);
	if (!scope) {
		return nullptr;
	};

	Binding* binding := parsed->bindings;
	while (binding) {
		Entity* entity := binding->entity;
		if (entity->kind != ENTITY_VARIABLE || entity->data.variable.storage == STORAGE_PARAMETER || entity->data.variable.storage == STORAGE_ARGUMENT || entity->data.variable.storage == STORAGE_CONSTANT) {
			scope_define((Compiler*)semantic->compiler, (Scope*)scope, (Entity*)entity);
		};
		@binding := binding->next;
	};

	if (parsed->context == CONTEXT_FUNCTION && parsed->parent) {
		@binding := parsed->parent->bindings;
		while (binding) {
			if (binding->entity->kind == ENTITY_VARIABLE && binding->entity->data.variable.storage == STORAGE_PARAMETER) {
				scope_define((Compiler*)semantic->compiler, (Scope*)scope, (Entity*)binding->entity);
			};
			@binding := binding->next;
		};
	};

	return $scope;
};

fn syntax_unaccess(Syntax* syntax) -> Syntax* {
	while (syntax && syntax->kind == SYNTAX_ACCESS) {
		@syntax := syntax->data.expression;
	};
	return $syntax;
};

fn reference_initializer(Compiler* compiler, Syntax* body, Entity* variable, Token token) {
	Syntax* statement = nullptr;
	if (body) {
		@statement := body->data.statements;
	};
	while (statement) {
		Syntax* target = nullptr;
		if (statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) {
			@target = syntax_unaccess((Syntax*)statement->data.binary.left);
		};
		if (target && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY) && target->kind == SYNTAX_NAME && token_same(Token(target->token), Token(variable->name))) {
			@statement->kind = SYNTAX_INITIALIZE;
			@target->entity := variable;
			return;
		};
		@statement := statement->next;
	};
	compiler_error($compiler, $token, "reference requires a bound initializer\0");
};

union ReferencePathData {
	BaseRelation* base;
	Entity* entity;
	usize index;
};

struct ReferencePath {
	ReferencePath* parent;
	SyntaxKind kind;
	ReferencePathData data;
};

fn reference_path_type(ReferencePath* path) -> Type* {
	if (path->kind == SYNTAX_BASE_REFERENCE) {
		return entity_type((Entity*)path->data.base->entity);
	};
	if (path->kind == SYNTAX_INDEX) {
		return (Type*)reference_path_type((ReferencePath*)path->parent)->data.array.element;
	};
	return type_effective(entity_type((Entity*)path->data.entity));
};

fn reference_base_count(ReferencePath* path) -> usize {
	if (path->kind != SYNTAX_BASE_REFERENCE) {
		return 0;
	};
	return 1 + reference_base_count((ReferencePath*)path->parent);
};

fn reference_base_at(ReferencePath* path, usize index) -> BaseRelation* {
	usize depth = reference_base_count((ReferencePath*)path);
	if (!depth || index >= depth) {
		return nullptr;
	};
	if (index + 1 == depth) {
		return (BaseRelation*)path->data.base;
	};
	return reference_base_at((ReferencePath*)path->parent, $index);
};

fn reference_bases_match(Compiler* compiler, ReferencePath* expected, Type* source, BasePath* first, BasePath* second) -> bool {
	CompleteGraph* graph = complete_graph($compiler, (Entity*)source->data.entity);
	Subobject* actual = subobject_path(subobject_path((Subobject*)graph->root, $first), $second);
	Subobject* required := graph->root;
	usize index = 0;
	while (index < reference_base_count((ReferencePath*)expected)) {
		@required = subobject_edge((Subobject*)required, reference_base_at((ReferencePath*)expected, (u64)index));
		@index = index + 1;
	};
	return actual == required;
};

fn reference_path_matches(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool;

fn reference_cast_subobject(Compiler* compiler, Scope* scope, ReferencePath* root, CompleteGraph* graph, Syntax* storage) -> Subobject* {
	if (storage->kind != SYNTAX_CAST) {
		if (reference_path_matches((Compiler*)compiler, (Scope*)scope, (ReferencePath*)root, (Syntax*)storage)) {
			return (Subobject*)graph->root;
		};
		return nullptr;
	};
	Type* selected = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)storage->data.cast.type);
	if (selected->kind != TYPE_REFERENCE || selected->data.element->kind != TYPE_NAMED) {
		return nullptr;
	};
	Subobject* source = reference_cast_subobject((Compiler*)compiler, $scope, $root, $graph, (Syntax*)storage->data.cast.value);
	if (!source) {
		return nullptr;
	};
	BaseSearch path = base_search($compiler, entity_type((Entity*)source->entity), (Type*)selected->data.element);
	if (path.count != 1) {
		return nullptr;
	};
	return subobject_path($source, (BasePath*)path.path);
};

fn reference_path_matches(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	while (storage && storage->kind == SYNTAX_ACCESS) {
		@storage := storage->data.expression;
	};
	if (storage && storage->kind == SYNTAX_CAST && path->kind == SYNTAX_BASE_REFERENCE) {
		ReferencePath* root := path;
		while (root->kind == SYNTAX_BASE_REFERENCE) {
			@root := root->parent;
		};
		Type* source = reference_path_type((ReferencePath*)root);
		CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)source->data.entity);
		Subobject* actual = reference_cast_subobject((Compiler*)compiler, (Scope*)scope, $root, (CompleteGraph*)graph, (Syntax*)storage);
		Subobject* required := graph->root;
		usize index = 0;
		while (index < reference_base_count((ReferencePath*)path)) {
			@required = subobject_edge((Subobject*)required, reference_base_at((ReferencePath*)path, (u64)index));
			@index = index + 1;
		};
		return actual && actual == required;
	};
	if (!storage || storage->kind != path->kind) {
		return false;
	};
	if (path->kind == SYNTAX_NAME) {
		return token_same(Token(storage->token), Token(path->data.entity->name));
	};
	if (path->kind == SYNTAX_MEMBER) {
		if (storage->token.kind == TOKEN_ARROW || !token_same(Token(storage->data.member.name), Token(path->data.entity->name))) {
			return false;
		};
		ReferencePath* object := path->parent;
		while (object->kind == SYNTAX_BASE_REFERENCE) {
			@object := object->parent;
		};
		if (!reference_path_matches((Compiler*)compiler, (Scope*)scope, (ReferencePath*)object, (Syntax*)storage->data.member.object)) {
			return false;
		};
		Type* source = reference_path_type($object);
		Type* owner = entity_type((Entity*)path->data.entity->data.variable.data.field.owner);
		Type* visible := source;
		if (storage->data.member.qualifier) {
			@visible = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)storage->data.member.qualifier);
		};
		if (visible->kind != TYPE_NAMED || associated_lookup((Compiler*)compiler, (Entity*)visible->data.entity, Token(storage->data.member.name)) != path->data.entity) {
			return false;
		};
		BaseSearch first = base_search((Compiler*)compiler, (Type*)source, (Type*)owner);
		BaseSearch second;
		if (storage->data.member.qualifier) {
			Type* selected = type_resolve((Compiler*)compiler, (Scope*)scope, (Syntax*)storage->data.member.qualifier);
			@first = base_search((Compiler*)compiler, (Type*)source, (Type*)selected);
			@second = base_search((Compiler*)compiler, $selected, (Type*)owner);
			if (second.count != 1) {
				return false;
			};
		};
		if (first.count > 1 || second.count > 1) {
			compiler_error((Compiler*)compiler, Token(storage->token), "ambiguous inherited reference field subobject\0");
			return false;
		};
		return first.count == 1 && reference_bases_match((Compiler*)compiler, (ReferencePath*)path->parent, (Type*)source, (BasePath*)first.path, (BasePath*)second.path);
	};
	if (path->kind == SYNTAX_INDEX) {
		return reference_path_matches((Compiler*)compiler, (Scope*)scope, (ReferencePath*)path->parent, (Syntax*)storage->data.binary.left) && constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)storage->data.binary.right) == (u64)path->data.index;
	};
	return false;
};

fn type_has_reference(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_REFERENCE) {
		return true;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_has_reference((Type*)type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	BaseRelation* base := type->data.entity->data.aggregate.bases;
	while (base) {
		if (type_has_reference(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := type->data.entity->data.aggregate.fields;
	while (field) {
		if (type_has_reference(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn reference_path_contains(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* storage) -> bool {
	while (storage) {
		if (storage->kind == SYNTAX_ACCESS) {
			@storage := storage->data.expression;
			continue;
		};
		if (reference_path_matches((Compiler*)compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)storage)) {
			return true;
		};
		if (storage->kind == SYNTAX_MEMBER && storage->token.kind != TOKEN_ARROW) {
			@storage := storage->data.member.object;
		}
		else if (storage->kind == SYNTAX_INDEX) {
			@storage := storage->data.binary.left;
		}
		else {
			break;
		};
	};
	return false;
};

fn reference_fields_prepare(Compiler* compiler, Scope* scope, Type* type, ReferencePath* path, Syntax* body, Token token);

fn reference_whole_prepare(Compiler* compiler, Scope* scope, ReferencePath* path, Syntax* body) -> bool {
	Syntax* statement = nullptr;
	if (body) {
		@statement := body->data.statements;
	};
	while (statement) {
		if ((statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY) && reference_path_matches((Compiler*)compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)statement->data.binary.left)) {
			@statement->kind = SYNTAX_INITIALIZE;
			if (path->kind == SYNTAX_NAME || path->kind == SYNTAX_MEMBER) {
				@syntax_unaccess((Syntax*)statement->data.binary.left)->entity := path->data.entity;
			};
			return true;
		};
		@statement := statement->next;
	};
	return false;
};

fn reference_subobjects_bound(Compiler* compiler, Subobject* object, SubobjectVisit** visited) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate((Compiler*)compiler, sizeof(SubobjectVisit));
	@visit->object := object;
	@visit->next := *visited;
	@*visited = $visit;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		reference_subobjects_bound((Compiler*)compiler, (Subobject*)edge->target, (SubobjectVisit**)visited);
		@edge := edge->next;
	};
};

fn reference_subobjects_prepare(Compiler* compiler, Scope* scope, Subobject* object, ReferencePath* path, Syntax* body, Token token, SubobjectVisit** visited) {
	if (reference_whole_prepare((Compiler*)compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)body)) {
		reference_subobjects_bound((Compiler*)compiler, (Subobject*)object, (SubobjectVisit**)visited);
		return;
	};
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* visit = (SubobjectVisit*)memory_allocate((Compiler*)compiler, sizeof(SubobjectVisit));
	@visit->object := object;
	@visit->next := *visited;
	@*visited = $visit;

	SubobjectEdge* edge := object->edges;
	while (edge && compiler->result != COMPILATION_FAILURE) {
		ReferencePath inherited;
		@inherited.kind = SYNTAX_BASE_REFERENCE;
		@inherited.parent := path;
		@inherited.data.base := edge->relation;
		reference_subobjects_prepare((Compiler*)compiler, (Scope*)scope, (Subobject*)edge->target, &inherited, (Syntax*)body, Token(token), (SubobjectVisit**)visited);
		@edge := edge->next;
	};
	Field* field := object->entity->data.aggregate.fields;
	while (field && compiler->result != COMPILATION_FAILURE) {
		ReferencePath member;
		@member.kind = SYNTAX_MEMBER;
		@member.parent := path;
		@member.data.entity := field->entity;
		reference_fields_prepare((Compiler*)compiler, (Scope*)scope, entity_type((Entity*)field->entity), &member, (Syntax*)body, Token(token));
		@field := field->next;
	};
};

fn reference_fields_prepare(Compiler* compiler, Scope* scope, Type* type, ReferencePath* path, Syntax* body, Token token) {
	if (!type || compiler->result == COMPILATION_FAILURE || !type_has_reference((Type*)type)) {
		return;
	};
	if (reference_whole_prepare((Compiler*)compiler, (Scope*)scope, (ReferencePath*)path, (Syntax*)body)) {
		return;
	};
	Syntax* statement = nullptr;
	if (type->kind == TYPE_REFERENCE) {
		compiler_error((Compiler*)compiler, Token(token), "object requires an initializer binding every reference field\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		ReferencePath element;
		@element.kind = SYNTAX_INDEX;
		@element.parent := path;
		usize index = 0;
		while (index < type->data.array.count && compiler->result != COMPILATION_FAILURE) {
			@element.data.index := index;
			reference_fields_prepare((Compiler*)compiler, (Scope*)scope, (Type*)type->data.array.element, &element, (Syntax*)body, Token(token));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	entity_resolve((Compiler*)compiler, (Entity*)type->data.entity);
	if (type->data.entity->kind == ENTITY_UNION) {
		if (body) {
			@statement := body->data.statements;
		};
		while (statement) {
			if ((statement->kind == SYNTAX_BINARY || statement->kind == SYNTAX_INITIALIZE) && (statement->data.binary.operation == TOKEN_ASSIGN || statement->data.binary.operation == TOKEN_COPY)) {
				Field* field := type->data.entity->data.aggregate.fields;
				while (field) {
					ReferencePath member;
					@member.kind = SYNTAX_MEMBER;
					@member.parent := path;
					@member.data.entity := field->entity;
					if (reference_path_contains((Compiler*)compiler, (Scope*)scope, &member, (Syntax*)statement->data.binary.left)) {
						reference_fields_prepare((Compiler*)compiler, (Scope*)scope, entity_type((Entity*)field->entity), &member, (Syntax*)body, Token(token));
						return;
					};
					@field := field->next;
				};
			};
			@statement := statement->next;
		};
		return;
	};
	CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)type->data.entity);
	SubobjectVisit* visited = nullptr;
	reference_subobjects_prepare($compiler, $scope, (Subobject*)graph->root, $path, $body, $token, &visited);
};

fn object_initializer_prepare(Compiler* compiler, Scope* scope, Entity* variable, Syntax* body, Token token) {
	Type* type := entity_type((Entity*)variable);
	layout_validate((Compiler*)compiler, (Type*)type, nullptr, Token(token));
	if (compiler->result == COMPILATION_FAILURE) {
		return;
	};
	Syntax* whole = nullptr;
	if (body) {
		@whole := body->data.statements;
	};
	while (whole) {
		Syntax* target = nullptr;
		if (whole->kind == SYNTAX_BINARY || whole->kind == SYNTAX_INITIALIZE) {
			@target = syntax_unaccess((Syntax*)whole->data.binary.left);
		};
		if (target && (whole->data.binary.operation == TOKEN_ASSIGN || whole->data.binary.operation == TOKEN_COPY) && target->kind == SYNTAX_NAME && token_same(Token(target->token), Token(variable->name))) {
			@whole->kind = SYNTAX_INITIALIZE;
			@target->entity := variable;
			return;
		};
		@whole := whole->next;
	};
	if (!type_has_reference((Type*)type)) {
		return;
	};
	ReferencePath root;
	@root.kind = SYNTAX_NAME;
	@root.data.entity = $variable;
	reference_fields_prepare($compiler, $scope, $type, &root, $body, $token);
};

fn syntax_base_count(Syntax* syntax) -> usize {
	if (syntax->kind != SYNTAX_BASE_REFERENCE) {
		return 0;
	};
	usize count = syntax_base_count((Syntax*)syntax->data.base_conversion.value);
	BasePath* path := syntax->data.base_conversion.path;
	while (path) {
		@count = count + 1;
		@path := path->next;
	};
	return $count;
};

fn syntax_base_at(Syntax* syntax, usize index) -> BaseRelation* {
	if (syntax->kind != SYNTAX_BASE_REFERENCE) {
		return nullptr;
	};
	usize before = syntax_base_count((Syntax*)syntax->data.base_conversion.value);
	if (index < before) {
		return syntax_base_at((Syntax*)syntax->data.base_conversion.value, (u64)index);
	};
	@index = index - before;
	BasePath* path := syntax->data.base_conversion.path;
	while (path && index) {
		@path := path->next;
		@index = index - 1;
	};
	if (!path) {
		return nullptr;
	};
	return (BaseRelation*)path->relation;
};

fn syntax_base_root(Syntax* syntax) -> Syntax* {
	while (syntax->kind == SYNTAX_BASE_REFERENCE) {
		@syntax := syntax->data.base_conversion.value;
	};
	return $syntax;
};

fn storage_root_entity(Syntax* syntax) -> Entity* {
	while (syntax) {
		if (syntax->kind == SYNTAX_ACCESS) {
			@syntax := syntax->data.expression;
		}
		else if (syntax->kind == SYNTAX_BASE_REFERENCE) {
			@syntax := syntax->data.base_conversion.value;
		}
		else if (syntax->kind == SYNTAX_MEMBER && syntax->token.kind != TOKEN_ARROW) {
			@syntax := syntax->data.member.object;
		}
		else if (syntax->kind == SYNTAX_INDEX && syntax->data.binary.left->type->kind == TYPE_ARRAY) {
			@syntax := syntax->data.binary.left;
		}
		else {
			break;
		};
	};
	if (!syntax || syntax->kind != SYNTAX_NAME) {
		return nullptr;
	};
	return (Entity*)syntax->entity;
};

fn reference_storage_same(Compiler* compiler, Scope* scope, Syntax* first, Syntax* second) -> bool {
	while (first && first->kind == SYNTAX_ACCESS) {
		@first := first->data.expression;
	};
	while (second && second->kind == SYNTAX_ACCESS) {
		@second := second->data.expression;
	};
	if (!first || !second) {
		return false;
	};
	if (first->kind == SYNTAX_BASE_REFERENCE || second->kind == SYNTAX_BASE_REFERENCE) {
		Syntax* root = syntax_base_root((Syntax*)first);
		Syntax* other = syntax_base_root((Syntax*)second);
		Type* type = type_effective((Type*)root->type);
		if (!type || type->kind != TYPE_NAMED || !type_equal((Type*)type, type_effective((Type*)other->type))) {
			return false;
		};
		CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)type->data.entity);
		Subobject* left := graph->root;
		Subobject* right := graph->root;
		usize index = 0;
		while (index < syntax_base_count((Syntax*)first)) {
			@left = subobject_edge((Subobject*)left, syntax_base_at((Syntax*)first, (u64)index));
			@index = index + 1;
		};
		@index = 0;
		while (index < syntax_base_count((Syntax*)second)) {
			@right = subobject_edge((Subobject*)right, syntax_base_at((Syntax*)second, (u64)index));
			@index = index + 1;
		};
		if (left != right) {
			return false;
		};
		return reference_storage_same((Compiler*)compiler, (Scope*)scope, syntax_base_root((Syntax*)first), syntax_base_root((Syntax*)second));
	};
	if (first->kind != second->kind) {
		return false;
	};
	if (first->kind == SYNTAX_NAME) {
		return first->entity == second->entity;
	};
	if (first->kind == SYNTAX_MEMBER) {
		return first->entity == second->entity && reference_storage_same((Compiler*)compiler, (Scope*)scope, (Syntax*)first->data.member.object, (Syntax*)second->data.member.object);
	};
	if (first->kind == SYNTAX_INDEX) {
		return constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)first->data.binary.right) == constant_integer((Compiler*)compiler, (Scope*)scope, (Syntax*)second->data.binary.right) && reference_storage_same((Compiler*)compiler, (Scope*)scope, (Syntax*)first->data.binary.left, (Syntax*)second->data.binary.left);
	};
	return false;
};

fn reference_storage_contains(Compiler* compiler, Scope* scope, Syntax* parent, Syntax* storage) -> bool {
	while (storage) {
		if (storage->kind == SYNTAX_ACCESS) {
			@storage := storage->data.expression;
			continue;
		};
		if (reference_storage_same((Compiler*)compiler, (Scope*)scope, (Syntax*)parent, (Syntax*)storage)) {
			return true;
		};
		if (storage->kind == SYNTAX_MEMBER) {
			@storage := storage->data.member.object;
		}
		else if (storage->kind == SYNTAX_INDEX) {
			@storage := storage->data.binary.left;
		}
		else if (storage->kind == SYNTAX_BASE_REFERENCE) {
			@storage := storage->data.base_conversion.value;
		}
		else {
			break;
		};
	};
	return false;
};

fn reference_read_validate(Semantic* semantic, Syntax* storage) {
	if (storage->token.kind == TOKEN_ARROW) {
		return;
	};
	Syntax* object := storage->data.member.object;
	while (object->kind == SYNTAX_MEMBER || object->kind == SYNTAX_INDEX || object->kind == SYNTAX_NAME || object->kind == SYNTAX_BASE_REFERENCE) {
		if (object->kind == SYNTAX_BASE_REFERENCE) {
			@object := object->data.base_conversion.value;
			continue;
		};
		Type* type = syntax_storage_type((Syntax*)object);
		if ((type && type->kind == TYPE_REFERENCE) || (object->kind == SYNTAX_MEMBER && object->token.kind == TOKEN_ARROW)) {
			return;
		};
		if (object->kind == SYNTAX_MEMBER) {
			@object := object->data.member.object;
		}
		else if (object->kind == SYNTAX_INDEX) {
			@object := object->data.binary.left;
		}
		else {
			break;
		};
	};
	Scope* scope := semantic->scope;
	while (scope) {
		if ((scope->context == CONTEXT_INITIALIZATION || scope->context == CONTEXT_ARGUMENTS) && scope->owner && scope->owner->kind == ENTITY_VARIABLE && scope->owner->declaration) {
			Syntax* body := scope->owner->declaration;
			if (body->kind == SYNTAX_DECLARATION) {
				@body := body->data.declaration.body;
			};
			Syntax* root := storage;
			while (root->kind == SYNTAX_MEMBER || root->kind == SYNTAX_INDEX || root->kind == SYNTAX_BASE_REFERENCE) {
				if (root->kind == SYNTAX_BASE_REFERENCE) {
					@root := root->data.base_conversion.value;
				}
				else if (root->kind == SYNTAX_MEMBER) {
					@root := root->data.member.object;
				}
				else {
					@root := root->data.binary.left;
				};
			};
			if (root->kind != SYNTAX_NAME || root->entity != scope->owner) {
				return;
			};
			Syntax* statement := body->data.statements;
			while (statement) {
				if (statement->kind == SYNTAX_BIND_REFERENCE && reference_storage_same((Compiler*)semantic->compiler, (Scope*)semantic->scope, (Syntax*)statement->data.binary.left, (Syntax*)storage)) {
					return;
				};
				if (statement->kind == SYNTAX_INITIALIZE && statement->type && reference_storage_contains((Compiler*)semantic->compiler, (Scope*)semantic->scope, (Syntax*)statement->data.binary.left, (Syntax*)storage)) {
					return;
				};
				@statement := statement->next;
			};
			compiler_error((Compiler*)semantic->compiler, Token(storage->token), "reference field must be bound before use\0");
			return;
		};
		@scope := scope->parent;
	};
};

fn semantic_move(Semantic* semantic, Syntax* syntax) {
	if (storage_borrowed((Syntax*)syntax)) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "cannot move a borrowed value\0");
		return;
	};
	while (syntax->kind == SYNTAX_CAST || syntax->kind == SYNTAX_BASE_POINTER) {
		if (syntax->kind == SYNTAX_BASE_POINTER) {
			@syntax := syntax->data.base_conversion.value;
		}
		else {
			@syntax := syntax->data.cast.value;
		};
	};
	if (storage_borrowed((Syntax*)syntax)) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "cannot move a borrowed value\0");
		return;
	};

	if (syntax->kind != SYNTAX_NAME || !syntax->entity || syntax->entity->kind != ENTITY_VARIABLE || syntax->entity->data.variable.storage == STORAGE_CONSTANT) {
		return;
	};

};

fn syntax_base_conversion(Compiler* compiler, Syntax* syntax, Type* target, BasePath* path, BaseDirection direction) {
	Syntax* original = (Syntax*)memory_allocate($compiler, sizeof(Syntax));
	@*original := *syntax;
	@original->next = nullptr;
	if (target->kind == TYPE_REFERENCE) {
		@syntax->kind = SYNTAX_BASE_REFERENCE;
		@syntax->type := target->data.element;
	}
	else {
		@syntax->kind = SYNTAX_BASE_POINTER;
		@syntax->type := target;
	};
	@syntax->entity = nullptr;
	@syntax->data.base_conversion.value = $original;
	@syntax->data.base_conversion.target = $target;
	@syntax->data.base_conversion.path = $path;
	@syntax->data.base_conversion.direction = $direction;
	@syntax->data.base_conversion.request = IMPLICIT_BASE_CONVERSION;
};

fn semantic_base_conversion(Semantic* semantic, Syntax* syntax, Type* actual, Type* expected) -> bool {
	Type* source := actual;
	Type* target := expected->data.element;
	if (expected->kind == TYPE_POINTER) {
		if (actual->kind != TYPE_POINTER) {
			return false;
		};
		@source := actual->data.element;
	}
	else if (syntax_category((Syntax*)syntax) != VALUE_STORAGE) {
		return false;
	};
	BaseSearch result = base_search((Compiler*)semantic->compiler, $source, $target);
	if (result.count > 1) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "ambiguous base subobject conversion\0");
		return false;
	};
	if (!result.count) {
		return false;
	};
	syntax_base_conversion((Compiler*)semantic->compiler, $syntax, $expected, (BasePath*)result.path, BASE_UP);
	return true;
};

fn semantic_expect(Semantic* semantic, Syntax* syntax, Type* actual, Type* expected) -> Type* {
	if (expected && actual && expected->kind == TYPE_REFERENCE) {
		if (expected->data.element->qualifier == CONST_TYPE && type_pointer_conversion((Type*)actual, (Type*)expected->data.element)) {
			return $expected;
		};
		if (expected->data.element->qualifier != CONST_TYPE && !syntax_mutable_access((Syntax*)syntax) && actual->kind != TYPE_FUNCTION) {
			compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "mutable reference requires explicit '@' access\0");
		};
		if (type_value_equal((Type*)actual, (Type*)expected->data.element) && (syntax_category((Syntax*)syntax) == VALUE_STORAGE || expected->data.element->qualifier == CONST_TYPE || actual->kind == TYPE_FUNCTION)) {
			return $expected;
		};
	};
	if (expected && actual && !type_value_equal((Type*)actual, (Type*)expected)) {
		if ((expected->kind == TYPE_BOOL && type_scalar((Type*)actual)) || (actual->kind == TYPE_BOOL && type_numeric((Type*)expected))) {
			return $expected;
		};
		if ((expected->kind == TYPE_REFERENCE || expected->kind == TYPE_POINTER) && semantic_base_conversion((Semantic*)semantic, (Syntax*)syntax, (Type*)actual, (Type*)expected)) {
			return $expected;
		};
		if (actual->kind == TYPE_POINTER && expected->kind == TYPE_POINTER) {
			if (type_null_pointer((Type*)actual)) {
				return $expected;
			};
			if (actual->data.element->qualifier == CONST_TYPE && expected->data.element->qualifier != CONST_TYPE) {
				compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "pointer conversion cannot discard const qualification\0");
				return $actual;
			};
			if (type_pointer_conversion((Type*)actual, (Type*)expected)) {
				return $expected;
			};
		};
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "expression type does not match its destination\0");
	};
	return $actual;
};

fn semantic_base_cast(Semantic* semantic, Syntax* syntax, Syntax* value, Type* source, Type* target) -> bool {
	Type* actual := source;
	if (target->kind == TYPE_POINTER) {
		if (source->kind != TYPE_POINTER) {
			return false;
		};
		@actual := source->data.element;
	}
	else if (syntax_category((Syntax*)value) != VALUE_STORAGE) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "reference cast requires an existing referent\0");
		return false;
	};
	Type* destination := target->data.element;
	BaseSearch up = base_search((Compiler*)semantic->compiler, (Type*)actual, (Type*)destination);
	BaseSearch down;
	if (!up.count) {
		@down = base_search((Compiler*)semantic->compiler, (Type*)destination, (Type*)actual);
	};
	if (up.count > 1 || down.count > 1) {
		compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "ambiguous base subobject cast\0");
		return false;
	};
	if (!up.count && !down.count) {
		return false;
	};
	BaseDirection direction = BASE_UP;
	BasePath* path := up.path;
	if (down.count) {
		if (base_path_virtual((BasePath*)down.path)) {
			compiler_error((Compiler*)semantic->compiler, Token(syntax->token), "downcast through a virtual base is invalid\0");
			return false;
		};
		@direction = BASE_DOWN;
		@path := down.path;
	};
	@syntax->data.base_conversion.value = $value;
	@syntax->data.base_conversion.target := target;
	@syntax->data.base_conversion.path = $path;
	@syntax->data.base_conversion.direction = $direction;
	@syntax->data.base_conversion.request = EXPLICIT_BASE_CONVERSION;
	if (target->kind == TYPE_REFERENCE) {
		@syntax->kind = SYNTAX_BASE_REFERENCE;
		@syntax->type := target->data.element;
	}
	else {
		@syntax->kind = SYNTAX_BASE_POINTER;
		@syntax->type = (Type*)target;
	};
	return true;
};

fn semantic_member_project(Semantic* semantic, Syntax* member, Type* source, Type* target) -> Type* {
	if (type_value_equal((Type*)source, (Type*)target)) {
		return $source;
	};
	@target = type_qualified((Compiler*)semantic->compiler, (Type*)target, (TypeQualifier)source->qualifier);
	Type* expected = nullptr;
	if (member->token.kind == TOKEN_ARROW) {
		@expected = type_pointer((Compiler*)semantic->compiler, (Type*)target);
	}
	else {
		@expected = type_new((Compiler*)semantic->compiler, TYPE_REFERENCE);
		@expected->data.element = (Type*)target;
	};
	if (!semantic_base_conversion((Semantic*)semantic, (Syntax*)member->data.member.object, (Type*)member->data.member.object->type, (Type*)expected)) {
		compiler_error((Compiler*)semantic->compiler, Token(member->token), "member owner is not an unambiguous base of its receiver\0");
	};
	return (Type*)expected->data.element;
};

fn semantic_member_object(Semantic* semantic, Syntax* member) -> Type* {
	Type* object = semantic_expression((Semantic*)semantic, (Syntax*)member->data.member.object, nullptr);
	if (member->token.kind == TOKEN_ARROW) {
		if (object->kind != TYPE_POINTER) {
			compiler_error((Compiler*)semantic->compiler, Token(member->token), "arrow member access requires a pointer\0");
			return (Type*)semantic->compiler->void_type;
		};
		@object := object->data.element;
	};
	if (!member->data.member.qualifier) {
		return $object;
	};
	Type* owner = type_resolve((Compiler*)semantic->compiler, (Scope*)semantic->scope, (Syntax*)member->data.member.qualifier);
	if (owner->kind != TYPE_NAMED || (owner->data.entity->kind != ENTITY_STRUCT && owner->data.entity->kind != ENTITY_UNION)) {
		compiler_error((Compiler*)semantic->compiler, Token(member->token), "qualified instance access requires a record type\0");
		return (Type*)semantic->compiler->void_type;
	};
	return semantic_member_project($semantic, $member, $object, $owner);
};

fn method_receiver(Semantic* semantic, Syntax* member) -> Syntax* {
	Syntax* receiver := member->data.member.object;
	Type* type = semantic_expression((Semantic*)semantic, (Syntax*)receiver, nullptr);
	if (member->token.kind != TOKEN_ARROW) {
		return $receiver;
	};
	if (type->kind != TYPE_POINTER) {
		compiler_error((Compiler*)semantic->compiler, Token(member->token), "arrow member access requires a pointer\0");
		return $receiver;
	};
	Syntax* object = (Syntax*)memory_allocate((Compiler*)semantic->compiler, sizeof(Syntax));
	@object->kind = SYNTAX_UNARY;
	@object->token := member->token;
	@object->data.unary.operation = TOKEN_STAR;
	@object->data.unary.value = $receiver;
	@object->type = type_effective((Type*)type->data.element);
	return $object;
};

fn receiver_callable(Semantic* semantic, Type* type, Token name) -> Entity* {
	Entity* associated = nullptr;
	if (type->kind == TYPE_NAMED && (type->data.entity->kind == ENTITY_STRUCT || type->data.entity->kind == ENTITY_UNION)) {
		entity_resolve((Compiler*)semantic->compiler, (Entity*)type->data.entity);
		@associated = associated_lookup((Compiler*)semantic->compiler, (Entity*)type->data.entity, Token(name));
	};
	if (associated) {
		return $associated;
	};
	Entity* lexical = scope_lookup((Scope*)semantic->scope, $name);
	if (!lexical || lexical->kind != ENTITY_FUNCTION) {
		return nullptr;
	};
	entity_resolve((Compiler*)semantic->compiler, (Entity*)lexical);
	Parameter* first := lexical->data.function.type->data.function.parameters;
	if (!first || !token_is(Token(first->name), "this\0")) {
		return nullptr;
	};
	return $lexical;
};

fn semantic_expression(Semantic* semantic, Syntax* syntax, Type* expected) -> Type* {
	Compiler* compiler := semantic->compiler;
	if (!syntax) {
		return (Type*)compiler->void_type;
	};
	if (expected && expected->kind == TYPE_REFERENCE && syntax_number_expression((Syntax*)syntax)) {
		Type* actual = semantic_expression((Semantic*)semantic, (Syntax*)syntax, (Type*)expected->data.element);
		return semantic_expect((Semantic*)semantic, (Syntax*)syntax, $actual, (Type*)expected);
	};
	if (syntax->type) {
		return semantic_expect((Semantic*)semantic, (Syntax*)syntax, (Type*)syntax->type, (Type*)expected);
	};
	Type* type = nullptr;
	switch (syntax->kind) {
		case SYNTAX_NULLPTR:
			@type = type_pointer((Compiler*)compiler, (Type*)compiler->null_type);
			break;
		case SYNTAX_DISCARD:
			semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.expression, nullptr);
			if (syntax->data.expression->kind != SYNTAX_NAME || !syntax->data.expression->entity || syntax->data.expression->entity->kind != ENTITY_VARIABLE || storage_borrowed((Syntax*)syntax->data.expression) || (syntax->data.expression->entity->data.variable.storage != STORAGE_LOCAL && syntax->data.expression->entity->data.variable.storage != STORAGE_PARAMETER)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "discard requires a directly owned local identifier\0");
			};
			@type := compiler->void_type;
			break;
		case SYNTAX_ACCESS:
		case SYNTAX_RELOCATE: {
			Syntax* operand := syntax->data.expression;
			@type = semantic_expression((Semantic*)semantic, (Syntax*)operand, nullptr);
			if (syntax_category((Syntax*)operand) != VALUE_STORAGE) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "reference access and relocation require an existing object\0");
			};
			if (syntax->kind == SYNTAX_ACCESS && type->qualifier == CONST_TYPE) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "immutable object cannot provide mutable access\0");
			};
			if (syntax->kind == SYNTAX_RELOCATE && (operand->kind != SYNTAX_NAME || !operand->entity || operand->entity->kind != ENTITY_VARIABLE || storage_borrowed((Syntax*)operand))) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "relocation requires an owned local binding\0");
			};
			break;
		};
		case SYNTAX_CONSTRUCT: {
			@type := syntax->data.construction.target;
			if (type->kind == TYPE_NULL) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "null is an unsized type and cannot be constructed\0");
				break;
			};
			Syntax* argument := syntax->data.construction.arguments;
			if (type->kind == TYPE_NAMED && (type->data.entity->kind == ENTITY_STRUCT || type->data.entity->kind == ENTITY_UNION)) {
				@syntax->data.construction.constructor = special_select((Semantic*)semantic, (Entity*)type->data.entity, CONSTRUCTOR_ROLE, (Syntax*)argument, Token(syntax->token));
				if (syntax->data.construction.constructor || compiler->result == COMPILATION_FAILURE) {
					if (syntax->data.construction.constructor) {
						constructor_members_validate((Semantic*)semantic, (Type*)type, Token(syntax->token));
					};
					if (syntax->data.construction.constructor && type_has_reference((Type*)type)) {
						compiler_error((Compiler*)compiler, Token(syntax->token), "constructor reference-field binding syntax is not implemented\0");
					};
					break;
				};
			};
			if (!argument) {
				generated_operation_validate((Semantic*)semantic, (Type*)type, DEFAULT_CONSTRUCTION, Token(syntax->token));
				break;
			};
			if (argument->next) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "generated construction requires zero or one argument\0");
				break;
			};
			Type* actual = semantic_expression((Semantic*)semantic, (Syntax*)argument, (Type*)type);
			semantic_expect((Semantic*)semantic, (Syntax*)argument, (Type*)actual, (Type*)type);
			generated_operation_validate((Semantic*)semantic, (Type*)type, COPY_CONSTRUCTION, Token(syntax->token));
			break;
		};
		case SYNTAX_NAME:
			if (!syntax->entity) {
				@syntax->entity = syntax_lookup((Scope*)semantic->scope, (Syntax*)syntax);
			};
			if (!syntax->entity) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "unknown identifier\0");
				return (Type*)compiler->void_type;
			};
			if (syntax->entity->kind != ENTITY_VARIABLE && syntax->entity->kind != ENTITY_FUNCTION) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "type entity is not a runtime value\0");
				return (Type*)compiler->void_type;
			};
			entity_resolve((Compiler*)compiler, (Entity*)syntax->entity);
			if (syntax->entity->kind == ENTITY_FUNCTION && syntax->entity->data.function.definition == FUNCTION_DELETED) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "selected function is deleted\0");
			};
			if (syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage == STORAGE_FIELD) {
				Token name := syntax->token;
				Entity* receiver = scope_lookup((Scope*)semantic->scope, token_synthetic((Compiler*)compiler, Token(name), "this\0"));
				if (!receiver || receiver->kind != ENTITY_VARIABLE) {
					compiler_error((Compiler*)compiler, Token(name), "field access requires an instance receiver\0");
					return (Type*)compiler->void_type;
				};
				Syntax* object = (Syntax*)memory_allocate((Compiler*)compiler, sizeof(Syntax));
				@object->kind = SYNTAX_NAME;
				@object->token := receiver->name;
				@object->entity = (Entity*)receiver;
				@syntax->kind = SYNTAX_MEMBER;
				@syntax->data.member.object = (Syntax*)object;
				@syntax->data.member.name = Token(name);
				return semantic_expression((Semantic*)semantic, (Syntax*)syntax, (Type*)expected);
			};
			@type = type_effective(entity_type((Entity*)syntax->entity));
			break;
		case SYNTAX_NUMBER:
			if (expected && expected->kind == TYPE_POINTER && syntax_zero_pointer_constant((Syntax*)syntax)) {
				@type := expected;
				break;
			};
			if (!expected || !type_numeric((Type*)expected)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "number literal requires a numeric destination type\0");
				return (Type*)compiler->void_type;
			};
			@type := expected;
			if (type_integer((Type*)type) && type->kind != TYPE_BOOL) {
				u64 maximum = (u64)18446744073709551615;
				i32 bits = type_bits((Type*)type);
				if (bits < 64) {
					@maximum = 1;
					i32 bit = 0;
					while (bit < bits) {
						@maximum = maximum * 2;
						@bit = bit + 1;
					};
					@maximum = maximum - 1;
				};
				if (!type_unsigned((Type*)type) && type->kind != TYPE_CHAR) {
					@maximum = maximum / 2;
				};
				integer_spelling((Compiler*)compiler, Token(syntax->token), (u64)maximum);
			};
			break;
		case SYNTAX_STRING:
			@type = type_pointer((Compiler*)compiler, (Type*)compiler->char_type);
			break;
		case SYNTAX_CAST: {
			@type = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)syntax->data.cast.type);
			if (type->kind == TYPE_REFERENCE) {
				Syntax* value := syntax->data.cast.value;
				Type* source = semantic_expression((Semantic*)semantic, (Syntax*)value, nullptr);
				if (semantic_base_cast((Semantic*)semantic, (Syntax*)syntax, (Syntax*)value, (Type*)source, (Type*)type)) {
					@type := syntax->type;
				}
				else {
					semantic_expect((Semantic*)semantic, (Syntax*)value, (Type*)source, (Type*)type);
				};
				break;
			};
			Type* source = nullptr;
			if (syntax_number_expression((Syntax*)syntax->data.cast.value)) {
				Type* context := type;
				if (type->kind == TYPE_POINTER) {
					@context := compiler->usize_type;
				};
				@source = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.cast.value, (Type*)context);
			}
			else {
				@source = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.cast.value, nullptr);
			};
			if (type->kind == TYPE_POINTER && source->kind == TYPE_POINTER && semantic_base_cast((Semantic*)semantic, (Syntax*)syntax, (Syntax*)syntax->data.cast.value, (Type*)source, (Type*)type)) {
				break;
			};
			if (!type_scalar((Type*)type) || !type_scalar((Type*)source)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "cast requires scalar types\0");
			};
			if (((type->kind == TYPE_POINTER || type->kind == TYPE_REFERENCE) && source->kind == TYPE_FLOAT) || ((source->kind == TYPE_POINTER || source->kind == TYPE_REFERENCE) && type->kind == TYPE_FLOAT)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "pointer casts require an integer or pointer counterpart\0");
			};
			break;
		};
		case SYNTAX_SIZEOF: {
			Syntax* operand := syntax->data.expression;
			if (operand->kind == SYNTAX_NAME) {
				Entity* entity = syntax_lookup((Scope*)semantic->scope, (Syntax*)operand);
				if (entity && (entity->kind == ENTITY_PRIMITIVE || entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION || entity->kind == ENTITY_ENUM)) {
					@operand->type = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)operand);
				}
				else {
					semantic_expression((Semantic*)semantic, (Syntax*)operand, nullptr);
				};
			}
			else if (operand->kind == SYNTAX_POINTER || operand->kind == SYNTAX_REFERENCE || operand->kind == SYNTAX_ARRAY || operand->kind == SYNTAX_SIGNATURE) {
				@operand->type = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)operand);
			}
			else {
				semantic_expression((Semantic*)semantic, (Syntax*)operand, nullptr);
			};
			@operand->type = type_effective((Type*)operand->type);
			if (!operand->type || operand->type->kind == TYPE_VOID || operand->type->kind == TYPE_NULL || operand->type->kind == TYPE_FUNCTION) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "sizeof requires a storage type\0");
			};
			layout_validate((Compiler*)compiler, (Type*)operand->type, nullptr, Token(syntax->token));
			@type := compiler->usize_type;
			break;
		};
		case SYNTAX_MEMBER: {
			Type* object = semantic_member_object((Semantic*)semantic, (Syntax*)syntax);
			if (object->kind != TYPE_NAMED || (object->data.entity->kind != ENTITY_STRUCT && object->data.entity->kind != ENTITY_UNION)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "member access requires a record\0");
				return (Type*)compiler->void_type;
			};
			entity_resolve((Compiler*)compiler, (Entity*)object->data.entity);
			layout_validate((Compiler*)compiler, (Type*)object, nullptr, Token(syntax->token));
			if (compiler->result == COMPILATION_FAILURE) {
				return (Type*)compiler->void_type;
			};
			@syntax->entity = associated_lookup((Compiler*)compiler, (Entity*)object->data.entity, Token(syntax->data.member.name));
			if (!syntax->entity) {
				compiler_error((Compiler*)compiler, Token(syntax->data.member.name), "unknown record field\0");
				return (Type*)compiler->void_type;
			};
			if (syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage == STORAGE_FIELD) {
				semantic_member_project((Semantic*)semantic, (Syntax*)syntax, (Type*)object, entity_type((Entity*)syntax->entity->data.variable.data.field.owner));
			};
			if (syntax->entity->kind != ENTITY_VARIABLE || syntax->entity->data.variable.storage != STORAGE_FIELD) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "associated declaration is not instance field storage\0");
				return (Type*)compiler->void_type;
			};
			if (entity_type((Entity*)syntax->entity)->kind == TYPE_REFERENCE) {
				reference_read_validate((Semantic*)semantic, (Syntax*)syntax);
			};
			@type = type_effective(entity_type((Entity*)syntax->entity));
			if (object->qualifier == CONST_TYPE && entity_type((Entity*)syntax->entity)->kind != TYPE_REFERENCE) {
				@type = type_qualified((Compiler*)compiler, (Type*)type, CONST_TYPE);
			};
			break;
		};
		case SYNTAX_INDEX: {
			Type* object = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.binary.left, nullptr);
			Type* index_context = nullptr;
			if (syntax_number_expression((Syntax*)syntax->data.binary.right)) {
				@index_context := compiler->usize_type;
			};
			Type* index = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.binary.right, (Type*)index_context);
			if (!type_integer((Type*)index)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "index requires an integer\0");
			};
			if (object->kind == TYPE_ARRAY) {
				@type := object->data.array.element;
				if (object->qualifier == CONST_TYPE) {
					@type = type_qualified((Compiler*)compiler, (Type*)type, CONST_TYPE);
				};
			}
			else if (object->kind == TYPE_POINTER) {
				@type := object->data.element;
			}
			else {
				compiler_error((Compiler*)compiler, Token(syntax->token), "index requires an array or pointer\0");
				@type := compiler->void_type;
			};
			layout_validate((Compiler*)compiler, (Type*)type, nullptr, Token(syntax->token));
			break;
		};
		case SYNTAX_UNARY: {
			TokenKind operation := syntax->data.unary.operation;
			Type* context := expected;
			if (context && context->kind == TYPE_BOOL && !syntax_number_expression((Syntax*)syntax->data.unary.value) && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				@context = type_new((Compiler*)compiler, TYPE_FLOAT);
				@context->data.bits = 64;
			};
			if (operation == TOKEN_AMPERSAND || operation == TOKEN_STAR) {
				@context = nullptr;
			};
			if (operation == TOKEN_BANG) {
				@context := compiler->bool_type;
			};
			Type* operand = nullptr;
			if (operation == TOKEN_MINUS && syntax->data.unary.value->kind == SYNTAX_NUMBER && context && context->kind == TYPE_SIGNED) {
				Type* magnitude = type_new((Compiler*)compiler, TYPE_UNSIGNED);
				@magnitude->data.bits := context->data.bits;
				semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.unary.value, (Type*)magnitude);

				u64 maximum = 1;
				i32 bit = 1;
				while (bit < context->data.bits) {
					@maximum = maximum * 2;
					@bit = bit + 1;
				};
				integer_spelling((Compiler*)compiler, Token(syntax->data.unary.value->token), (u64)maximum);
				@syntax->data.unary.value->type := context;
				@operand = (Type*)context;
			}
			else {
				@operand = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.unary.value, (Type*)context);
			};
			if (operation == TOKEN_AMPERSAND) {
				if (syntax_category((Syntax*)syntax->data.unary.value) != VALUE_STORAGE && operand->kind != TYPE_FUNCTION) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "address-of requires storage or a function entity\0");
				};
				@type = type_pointer((Compiler*)compiler, (Type*)operand);
			}
			else if (operation == TOKEN_STAR) {
				if (operand->kind != TYPE_POINTER) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "dereference requires a pointer\0");
					@type := compiler->void_type;
				}
				else {
					@type := operand->data.element;
					if (type->kind != TYPE_FUNCTION) {
						layout_validate((Compiler*)compiler, (Type*)type, nullptr, Token(syntax->token));
					};
				};
			}
			else if (operation == TOKEN_BANG) {
				if (!type_scalar((Type*)operand)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "logical negation requires a scalar\0");
				};
				@type := compiler->bool_type;
			}
			else {
				if (!type_numeric((Type*)operand) || (operation == TOKEN_TILDE && !type_integer((Type*)operand))) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "unary operation requires a numeric operand\0");
				};
				@type = (Type*)operand;
				if (type->kind == TYPE_BOOL && !syntax_number_expression((Syntax*)syntax->data.unary.value)) {
					@type := compiler->i32_type;
				};
			};
			break;
		};
		case SYNTAX_INITIALIZE:
		case SYNTAX_BINARY: {
			TokenKind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == TOKEN_ASSIGN || operation == TOKEN_COPY) {
				Syntax* storage = syntax_unaccess((Syntax*)left);
				if (syntax->kind == SYNTAX_INITIALIZE && storage->entity && entity_type((Entity*)storage->entity) && entity_type((Entity*)storage->entity)->kind == TYPE_REFERENCE) {
					if (syntax->data.binary.access != DECLARATION_ACCESS && left->kind != SYNTAX_ACCESS) {
						compiler_error((Compiler*)compiler, Token(left->token), "reference initialization requires explicit '@' access\0");
					};
					Type* reference := entity_type((Entity*)storage->entity);
					if (storage->kind == SYNTAX_MEMBER) {
						Type* object = semantic_member_object((Semantic*)semantic, (Syntax*)storage);
						semantic_member_project((Semantic*)semantic, (Syntax*)storage, (Type*)object, entity_type((Entity*)storage->entity->data.variable.data.field.owner));
					};
					semantic_expression((Semantic*)semantic, (Syntax*)right, (Type*)reference);
					if (syntax_category((Syntax*)right) != VALUE_STORAGE && storage->entity->data.variable.storage != STORAGE_ARGUMENT) {
						compiler_error((Compiler*)compiler, Token(right->token), "a named reference cannot bind a temporary\0");
					};
					if (storage->entity->data.variable.storage != STORAGE_FIELD) {
						scope_define((Compiler*)compiler, (Scope*)semantic->scope, (Entity*)storage->entity);
					};
					@left->type := reference->data.element;
					@storage->type := reference->data.element;
					@syntax->kind = SYNTAX_BIND_REFERENCE;
					@type := reference->data.element;
					break;
				};

				Type* destination = semantic_expression((Semantic*)semantic, (Syntax*)left, nullptr);
				Type* source_type = nullptr;
				if (left->entity && left->entity->kind == ENTITY_VARIABLE && !left->entity->data.variable.type) {
					@source_type = semantic_expression((Semantic*)semantic, (Syntax*)right, nullptr);
					@destination := source_type;
					@left->entity->data.variable.type := destination;
					@left->type := destination;
				};
				if (syntax_category((Syntax*)left) != VALUE_STORAGE) {
					compiler_error((Compiler*)compiler, Token(left->token), "assignment requires writable storage\0");
				};
				if (syntax->data.binary.access != DECLARATION_ACCESS && !syntax_mutable_access((Syntax*)left)) {
					compiler_error((Compiler*)compiler, Token(left->token), "assignment requires explicit '@' mutable access\0");
				};
				if (operation == TOKEN_ASSIGN && syntax->kind != SYNTAX_INITIALIZE && destination->kind == TYPE_NAMED && (destination->data.entity->kind == ENTITY_STRUCT || destination->data.entity->kind == ENTITY_UNION) && syntax_number_expression((Syntax*)right)) {
					Entity* assignment = special_select((Semantic*)semantic, (Entity*)destination->data.entity, ASSIGNMENT_ROLE, (Syntax*)right, Token(syntax->token));
					if (assignment) {
						@syntax->entity := assignment;
						@type = type_effective((Type*)assignment->data.function.type->data.function.result);
						break;
					};
				};
				if (operation == TOKEN_COPY) {
					syntax_construct((Compiler*)compiler, (Syntax*)right, (Type*)destination);
					@source_type = semantic_expression((Semantic*)semantic, (Syntax*)right, (Type*)destination);
				}
				else if (!source_type) {
					Type* context = nullptr;
					if (syntax_number_expression((Syntax*)right)) {
						@context := destination;
					};
					@source_type = semantic_expression((Semantic*)semantic, (Syntax*)right, (Type*)context);
				};
				semantic_owned((Semantic*)semantic, (Syntax*)right);
				if (syntax->kind != SYNTAX_INITIALIZE && destination->kind == TYPE_NAMED && (destination->data.entity->kind == ENTITY_STRUCT || destination->data.entity->kind == ENTITY_UNION)) {
					Entity* assignment = special_select((Semantic*)semantic, (Entity*)destination->data.entity, ASSIGNMENT_ROLE, (Syntax*)right, Token(syntax->token));
					if (assignment) {
						@syntax->entity := assignment;
						@type = type_effective((Type*)assignment->data.function.type->data.function.result);
						break;
					};
				};
				semantic_expect((Semantic*)semantic, (Syntax*)right, (Type*)right->type, (Type*)destination);
				if (left->entity && left->entity->kind == ENTITY_VARIABLE && left->entity->data.variable.storage == STORAGE_FIELD && left->entity->data.variable.data.field.owner->kind == ENTITY_UNION && !type_has_reference((Type*)destination)) {
					Scope* context := semantic->scope;
					while (context && context->context != CONTEXT_INITIALIZATION && context->context != CONTEXT_ARGUMENTS) {
						@context := context->parent;
					};
					if (context && context->owner == storage_root_entity((Syntax*)left) && entity_type((Entity*)context->owner)->kind != TYPE_REFERENCE) {
						@syntax->kind = SYNTAX_INITIALIZE;
					};
				};
				if (syntax->kind != SYNTAX_INITIALIZE) {
					generated_operation_validate((Semantic*)semantic, (Type*)destination, VALUE_ASSIGNMENT, Token(syntax->token));
				};
				if (operation == TOKEN_ASSIGN) {
					semantic_move((Semantic*)semantic, (Syntax*)right);
				};
				@type = (Type*)destination;
				break;
			};
			if (operation == TOKEN_AND || operation == TOKEN_OR) {
				Type* a = semantic_expression((Semantic*)semantic, (Syntax*)left, (Type*)compiler->bool_type);
				Type* b = semantic_expression((Semantic*)semantic, (Syntax*)right, (Type*)compiler->bool_type);
				if (!type_scalar((Type*)a) || !type_scalar((Type*)b)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "logical operation requires scalars\0");
				};
				@type := compiler->bool_type;
				break;
			};

			Type* operand := expected;
			if (operand && operand->kind == TYPE_BOOL && syntax_number_expression((Syntax*)left) && syntax_number_expression((Syntax*)right)) {
				@operand = type_new((Compiler*)compiler, TYPE_FLOAT);
				@operand->data.bits = 64;
			};
			Type* a = nullptr;
			Type* b = nullptr;
			if (!syntax_number_expression((Syntax*)left)) {
				@a = semantic_expression((Semantic*)semantic, (Syntax*)left, nullptr);
				@operand := a;
			}
			else if (!syntax_number_expression((Syntax*)right)) {
				@b = semantic_expression((Semantic*)semantic, (Syntax*)right, nullptr);
				@operand := b;
			};
			if (!a) {
				@a = semantic_expression((Semantic*)semantic, (Syntax*)left, (Type*)operand);
			};

			Type* right_context := operand;
			if (a->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				@right_context = nullptr;
				if (syntax_number_expression((Syntax*)right)) {
					@right_context := compiler->usize_type;
				};
			};
			if (!b) {
				@b = semantic_expression((Semantic*)semantic, (Syntax*)right, (Type*)right_context);
			};
			if (a->kind == TYPE_POINTER && b->kind == TYPE_POINTER && (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) && !type_equal((Type*)a, (Type*)b)) {
				BaseSearch forward = base_search((Compiler*)compiler, (Type*)b->data.element, (Type*)a->data.element);
				BaseSearch reverse = base_search((Compiler*)compiler, (Type*)a->data.element, (Type*)b->data.element);
				if (forward.count == 1) {
					semantic_expect((Semantic*)semantic, (Syntax*)right, (Type*)b, (Type*)a);
					@b := a;
				}
				else if (reverse.count == 1 || type_pointer_conversion((Type*)a, (Type*)b)) {
					semantic_expect((Semantic*)semantic, (Syntax*)left, (Type*)a, (Type*)b);
					@a := b;
					@right_context := b;
				};
			};
			semantic_expect((Semantic*)semantic, (Syntax*)right, (Type*)b, (Type*)right_context);
			if (a->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
				layout_validate((Compiler*)compiler, (Type*)a->data.element, nullptr, Token(syntax->token));
				if (!type_integer((Type*)b)) {
					compiler_error((Compiler*)compiler, Token(right->token), "pointer offset requires an integer\0");
				};
				@type := a;
				break;
			};
			if (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) {
				if (!type_scalar((Type*)a) || !type_scalar((Type*)b)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "comparison requires scalar operands\0");
				};
				@type := compiler->bool_type;
			}
			else {
				if (!type_numeric((Type*)a) || !type_equal((Type*)a, (Type*)b)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "arithmetic requires matching numeric operands\0");
				};
				if ((operation == TOKEN_REMAINDER || operation == TOKEN_AMPERSAND || operation == TOKEN_PIPE || operation == TOKEN_CARET || operation == TOKEN_SHIFT_LEFT || operation == TOKEN_SHIFT_RIGHT) && !type_integer((Type*)a)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "operation requires integer operands\0");
				};
				@type = (Type*)a;
				if (type->kind == TYPE_BOOL) {
					@type := compiler->i32_type;
				};
			};
			break;
		};
		case SYNTAX_CALL: {
			Syntax* callable_syntax := syntax->data.call.callable;
			if (callable_syntax->kind == SYNTAX_NAME) {
				Entity* callable_entity = syntax_lookup((Scope*)semantic->scope, (Syntax*)callable_syntax);
				if (callable_entity && (callable_entity->kind == ENTITY_PRIMITIVE || callable_entity->kind == ENTITY_STRUCT || callable_entity->kind == ENTITY_UNION || callable_entity->kind == ENTITY_ENUM)) {
					Syntax* arguments := syntax->data.call.arguments;
					Type* target = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)callable_syntax);
					@syntax->kind = SYNTAX_CONSTRUCT;
					@syntax->data.construction.target = (Type*)target;
					@syntax->data.construction.constructor = nullptr;
					@syntax->data.construction.arguments = (Syntax*)arguments;
					@syntax->data.construction.slot = nullptr;
					return semantic_expression((Semantic*)semantic, (Syntax*)syntax, (Type*)expected);
				};
			};
			if (callable_syntax->kind == SYNTAX_MEMBER) {
				Syntax* receiver = method_receiver((Semantic*)semantic, (Syntax*)callable_syntax);
				Type* owner := receiver->type;
				if (callable_syntax->data.member.qualifier) {
					@owner = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)callable_syntax->data.member.qualifier);
					BaseSearch path = base_search((Compiler*)compiler, (Type*)receiver->type, (Type*)owner);
					if (!path.count) {
						compiler_error((Compiler*)compiler, Token(callable_syntax->token), "qualified callable owner is not a base of its receiver\0");
						return (Type*)compiler->void_type;
					};
					@syntax->data.call.qualified_owner := owner->data.entity;
				};
				Entity* function = receiver_callable((Semantic*)semantic, (Type*)owner, Token(callable_syntax->data.member.name));
				if (function && function->kind == ENTITY_FUNCTION) {
					entity_resolve((Compiler*)compiler, (Entity*)function);
					Parameter* first := function->data.function.type->data.function.parameters;
					@syntax->data.call.receiver.value := receiver;
					if (first && token_is(Token(first->name), "this\0")) {
						if (callable_syntax->data.member.qualifier && !type_equal((Type*)receiver->type, (Type*)owner)) {
							Type* reference = type_new((Compiler*)compiler, TYPE_REFERENCE);
							@reference->data.element = (Type*)owner;
							semantic_expect((Semantic*)semantic, (Syntax*)receiver, (Type*)receiver->type, (Type*)reference);
						};
						semantic_expect((Semantic*)semantic, (Syntax*)receiver, (Type*)receiver->type, (Type*)first->type);
						@syntax->data.call.receiver.kind = RECEIVER_BIND;
					}
					else {
						@syntax->data.call.receiver.kind = RECEIVER_EVALUATE;
					};
					Syntax* direct = (Syntax*)memory_allocate((Compiler*)compiler, sizeof(Syntax));
					@direct->kind = SYNTAX_NAME;
					@direct->token := callable_syntax->data.member.name;
					@direct->entity = (Entity*)function;
					@syntax->data.call.callable = (Syntax*)direct;
				};
			};
			Type* callable = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.call.callable, nullptr);
			if (callable->kind == TYPE_POINTER) {
				@callable := callable->data.element;
			};
			if (callable->kind != TYPE_FUNCTION) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "call requires a function entity or function pointer\0");
				return (Type*)compiler->void_type;
			};
			Parameter* parameter := callable->data.function.parameters;
			Syntax* direct := syntax->data.call.callable;
			if (syntax->data.call.receiver.kind == RECEIVER_NONE && direct->kind == SYNTAX_NAME && !direct->data.expression && direct->entity && direct->entity->scope && direct->entity->scope->owner && (direct->entity->scope->owner->kind == ENTITY_STRUCT || direct->entity->scope->owner->kind == ENTITY_UNION) && parameter && token_is(Token(parameter->name), "this\0")) {
				Entity* current = scope_lookup((Scope*)semantic->scope, token_synthetic((Compiler*)compiler, Token(direct->token), "this\0"));
				if (current) {
					Syntax* receiver = (Syntax*)memory_allocate((Compiler*)compiler, sizeof(Syntax));
					@receiver->kind = SYNTAX_NAME;
					@receiver->token := current->name;
					@receiver->entity = (Entity*)current;
					semantic_expression((Semantic*)semantic, (Syntax*)receiver, (Type*)parameter->type);
					@syntax->data.call.receiver.value = (Syntax*)receiver;
					@syntax->data.call.receiver.kind = RECEIVER_BIND;
				};
			};
			if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
				@parameter := parameter->next;
			};
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (!parameter && callable->data.function.arity != PARAMETERS_VARIADIC) {
					compiler_error((Compiler*)compiler, Token(argument->token), "too many arguments\0");
					break;
				};
				Type* destination = nullptr;
				if (parameter) {
					@destination := parameter->type;
				};
				if (argument->kind == SYNTAX_BLOCK) {
					if (!parameter || !parameter->name.source) {
						compiler_error((Compiler*)compiler, Token(argument->token), "argument block requires a named parameter\0");
					}
					else {
						@argument->scope->context = CONTEXT_ARGUMENTS;
						Entity* storage = entity_create((Compiler*)compiler, ENTITY_VARIABLE, Token(parameter->name));
						@storage->resolution = RESOLUTION_READY;
						@storage->data.variable.type := destination;
						@storage->data.variable.storage = STORAGE_ARGUMENT;
						@storage->declaration := argument;
						@argument->scope->owner := storage;
						if (destination->kind == TYPE_REFERENCE) {
							reference_initializer((Compiler*)compiler, (Syntax*)argument, (Entity*)storage, Token(argument->token));
						}
						else {
							scope_define((Compiler*)compiler, (Scope*)argument->scope, (Entity*)storage);
							object_initializer_prepare((Compiler*)compiler, (Scope*)semantic->scope, (Entity*)storage, (Syntax*)argument, Token(argument->token));
						};
						@argument->entity = (Entity*)storage;
						semantic_statement((Semantic*)semantic, (Syntax*)argument);
						@argument->type = (Type*)destination;
					};
				}
				else {
					Type* actual = semantic_expression((Semantic*)semantic, (Syntax*)argument, (Type*)destination);
					if (!destination || destination->kind != TYPE_REFERENCE) {
						semantic_owned((Semantic*)semantic, (Syntax*)argument);
					};
					if (!parameter && type_aggregate((Type*)actual)) {
						compiler_error((Compiler*)compiler, Token(argument->token), "aggregate C variadic arguments require ABI lowering that is not supported yet\0");
					};
				};
				if (parameter) {
					@parameter := parameter->next;
				};
				@argument := argument->next;
			};
			if (parameter) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "too few arguments\0");
			};
			@type = type_effective((Type*)callable->data.function.result);
			break;
		};
		case SYNTAX_BLOCK:
			semantic_statement((Semantic*)semantic, (Syntax*)syntax);
			@type := compiler->void_type;
			break;
		default:
			compiler_error((Compiler*)compiler, Token(syntax->token), "expected value expression\0");
			@type := compiler->void_type;
			break;
	};
	@type = type_effective((Type*)type);
	@syntax->type := type;
	return semantic_expect($semantic, $syntax, $type, $expected);
};

fn llvm_body(Compiler* compiler, Entity* entity) -> void* {
	if (entity->data.aggregate.llvm_body) {
		return (void*)entity->data.aggregate.llvm_body;
	};
	entity_resolve((Compiler*)compiler, (Entity*)entity);
	void* record = LLVMStructCreateNamed((void*)compiler->llvm_context.handle, "rt.body\0");
	@entity->data.aggregate.llvm_body := record;
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		return $record;
	};
	usize count := entity->data.aggregate.field_count;
	if (aggregate_header((Entity*)entity)) {
		@count = count + 1;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			@count = count + 1;
		};
		@base := base->next;
	};
	void** fields = (void**)memory_allocate((Compiler*)compiler, (count + 2) * sizeof(void*));
	usize index = 0;
	if (aggregate_header((Entity*)entity)) {
		@fields[index] = LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0);
		@index = index + 1;
	};
	@base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			@fields[index] = llvm_body((Compiler*)compiler, (Entity*)base->entity);
			@index = index + 1;
		};
		@base := base->next;
	};
	Field* binding := entity->data.aggregate.fields;
	u64 maximum_size = 0;
	u32 maximum_alignment = 0;
	void* aligned = nullptr;
	while (binding) {
		void* field = llvm_type((Compiler*)compiler, entity_type((Entity*)binding->entity));
		@fields[index] := field;
		@index = index + 1;
		if (entity->kind == ENTITY_UNION) {
			u64 size = LLVMABISizeOfType((void*)compiler->llvm_layout.handle, (void*)field);
			u32 alignment = LLVMABIAlignmentOfType((void*)compiler->llvm_layout.handle, (void*)field);
			if (size > maximum_size) {
				@maximum_size = (u64)size;
			};
			if (alignment > maximum_alignment) {
				@maximum_alignment = (u32)alignment;
				@aligned = (void*)field;
			};
		};
		@binding := binding->next;
	};
	if (entity->kind == ENTITY_UNION && aligned) {
		u64 size = LLVMABISizeOfType((void*)compiler->llvm_layout.handle, (void*)aligned);
		@fields[0] = (void*)aligned;
		@index = 1;
		if (maximum_size > size) {
			@fields[1] = LLVMArrayType2(LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 8), maximum_size - size);
			@index = 2;
		};
	};
	if (!index) {
		@fields[0] = LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 8);
		@index = 1;
	};
	LLVMStructSetBody((void*)record, $fields, (u32)index, 0);
	return $record;
};

fn llvm_type(Compiler* compiler, Type* type) -> void* {
	if (!type) {
		return LLVMVoidTypeInContext((void*)compiler->llvm_context.handle);
	};
	switch (type->kind) {
		case TYPE_VOID:
		case TYPE_NULL:
			return LLVMVoidTypeInContext((void*)compiler->llvm_context.handle);
		case TYPE_CHAR:
			return LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 8);
		case TYPE_BOOL:
			return LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1);
		case TYPE_SIGNED:
		case TYPE_UNSIGNED:
			return LLVMIntTypeInContext((void*)compiler->llvm_context.handle, (u32)type->data.bits);
		case TYPE_FLOAT:
			if (type->data.bits == 32) {
				return LLVMFloatTypeInContext((void*)compiler->llvm_context.handle);
			};
			return LLVMDoubleTypeInContext((void*)compiler->llvm_context.handle);
		case TYPE_POINTER:
		case TYPE_REFERENCE:
			return LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0);
		case TYPE_ARRAY:
			return LLVMArrayType2(llvm_type((Compiler*)compiler, (Type*)type->data.array.element), (u64)type->data.array.count);
		case TYPE_FUNCTION: {
			u32 count = 0;
			Parameter* parameter := type->data.function.parameters;
			while (parameter) {
				@count = count + 1;
				@parameter := parameter->next;
			};
			void** parameters = (void**)memory_allocate((Compiler*)compiler, (usize)count * sizeof(void*));
			@parameter := type->data.function.parameters;
			u32 index = 0;
			while (parameter) {
				@parameters[index] = llvm_type((Compiler*)compiler, (Type*)parameter->type);
				@index = index + 1;
				@parameter := parameter->next;
			};
			return LLVMFunctionType(llvm_type((Compiler*)compiler, (Type*)type->data.function.result), $parameters, $count, type->data.function.arity == PARAMETERS_VARIADIC);
		};
		case TYPE_NAMED: {
			Entity* entity := type->data.entity;
			if (entity->kind == ENTITY_ENUM) {
				return LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 32);
			};
			if (entity->data.aggregate.llvm_type) {
				return (void*)entity->data.aggregate.llvm_type;
			};
			void* body = llvm_body((Compiler*)compiler, (Entity*)entity);
			if (!entity->data.aggregate.virtual_types) {
				@entity->data.aggregate.llvm_type := body;
				return $body;
			};
			void* record = LLVMStructCreateNamed((void*)compiler->llvm_context.handle, entity_name((Compiler*)compiler, (Entity*)entity));
			@entity->data.aggregate.llvm_type := record;
			CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)entity);
			usize count = 1;
			Subobject* object := graph->virtuals;
			while (object) {
				@count = count + 1;
				@object := object->virtual_next;
			};
			void** components = (void**)memory_allocate((Compiler*)compiler, count * sizeof(void*));
			@components[0] = (void*)body;
			@object := graph->virtuals;
			while (object) {
				@components[object->component] = llvm_body((Compiler*)compiler, (Entity*)object->entity);
				@object := object->virtual_next;
			};
			LLVMStructSetBody((void*)record, (void**)components, (u32)count, 0);
			return $record;
		};
	};
	return LLVMVoidTypeInContext((void*)compiler->llvm_context.handle);
};

fn emit_slot(Compiler* compiler, Type* type) -> void* {
	void* block = LLVMGetEntryBasicBlock(LLVMGetBasicBlockParent(LLVMGetInsertBlock((void*)compiler->llvm_builder.handle)));
	LLVMBuilderOwner storage_builder = LLVMBuilderOwner(LLVMCreateBuilderInContext((void*)compiler->llvm_context.handle));
	void* first = LLVMGetFirstInstruction((void*)block);
	if (first) {
		LLVMPositionBuilderBefore((void*)storage_builder.handle, (void*)first);
	}
	else {
		LLVMPositionBuilderAtEnd((void*)storage_builder.handle, (void*)block);
	};
	void* slot = LLVMBuildAlloca((void*)storage_builder.handle, llvm_type($compiler, $type), "storage\0");

	return $slot;
};

fn emit_expression(Emitter* emitter, Syntax* syntax) -> void*;
fn emit_statement(Emitter* emitter, Syntax* syntax);
fn emit_cast(Emitter* emitter, void* value, Type* source, Type* target) -> void*;

fn emit_call(Emitter* emitter, Syntax* syntax) -> void*;

fn emit_address(Emitter* emitter, Syntax* syntax) -> void*;

fn subobject_offsets(Compiler* compiler, Subobject* object, u64 offset) {
	@object->offset := offset;
	SubobjectEdge* edge := object->edges;
	while (edge) {
		if (edge->relation->kind == BASE_NONVIRTUAL) {
			u64 child = offset + LLVMOffsetOfElement((void*)compiler->llvm_layout.handle, llvm_body((Compiler*)compiler, (Entity*)object->entity), (u32)edge->relation->component);
			subobject_offsets((Compiler*)compiler, (Subobject*)edge->target, $child);
		};
		@edge := edge->next;
	};
};

fn complete_offsets(Compiler* compiler, CompleteGraph* graph) {
	void* type = llvm_type((Compiler*)compiler, entity_type((Entity*)graph->entity));
	subobject_offsets((Compiler*)compiler, (Subobject*)graph->root, 0);
	Subobject* object := graph->virtuals;
	while (object) {
		u64 offset = LLVMOffsetOfElement((void*)compiler->llvm_layout.handle, (void*)type, (u32)object->component);
		subobject_offsets((Compiler*)compiler, (Subobject*)object, $offset);
		@object := object->virtual_next;
	};
};

fn virtual_callable_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualCallable* callable := entity->data.aggregate.virtual_callables;
	while (callable) {
		@count = count + 1;
		@callable := callable->next;
	};
	return $count;
};

fn virtual_base_count(Entity* entity) -> usize {
	usize count = 0;
	VirtualType* type := entity->data.aggregate.virtual_types;
	while (type) {
		@count = count + 1;
		@type := type->next;
	};
	return $count;
};

fn runtime_view_type(Compiler* compiler, Entity* entity) -> void* {
	void*[2] fields {};
	@fields[0] = LLVMArrayType2(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), (u64)virtual_base_count((Entity*)entity));
	@fields[1] = LLVMArrayType2(LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), (u64)virtual_callable_count($entity));
	return LLVMStructTypeInContext((void*)compiler->llvm_context.handle, &fields[0], 2, 0);
};

fn runtime_view_request(Compiler* compiler, CompleteGraph* graph, Subobject* object) -> void* {
	if (object->view) {
		return (void*)object->view;
	};
	void* view = LLVMAddGlobal((void*)compiler->llvm_module.handle, runtime_view_type((Compiler*)compiler, (Entity*)object->entity), "rt.view\0");
	LLVMSetLinkage((void*)view, 9);
	LLVMSetGlobalConstant((void*)view, 1);
	@object->view := view;
	RuntimeView* request = (RuntimeView*)memory_allocate((Compiler*)compiler, sizeof(RuntimeView));
	@request->graph = $graph;
	@request->object = $object;
	@request->next := compiler->runtime_views;
	@compiler->runtime_views = $request;
	return $view;
};

fn emit_function_attributes(Compiler* compiler, void* function, Type* signature) {
	void* extension = emit_extension((Compiler*)compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddAttributeAtIndex((void*)function, 0, (void*)extension);
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension((Compiler*)compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddAttributeAtIndex((void*)function, (u32)index, (void*)extension);
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn runtime_thunk_request(Compiler* compiler, CompleteGraph* graph, Subobject* receiver, VirtualCallable* callable) -> void* {
	VirtualTarget target = virtual_target((Compiler*)compiler, $graph, (Subobject*)receiver, (Entity*)callable->function);
	if (target.function == callable->function && target.object == receiver) {
		return (void*)target.function->data.function.llvm_value;
	};
	RuntimeThunk* thunk = (RuntimeThunk*)memory_allocate((Compiler*)compiler, sizeof(RuntimeThunk));
	@thunk->receiver = $receiver;
	@thunk->callable := callable;
	@thunk->target = $target;
	@thunk->function = LLVMAddFunction((void*)compiler->llvm_module.handle, "rt.virtual.thunk\0", llvm_type((Compiler*)compiler, (Type*)callable->function->data.function.type));
	LLVMSetLinkage((void*)thunk->function, 9);
	emit_function_attributes((Compiler*)compiler, (void*)thunk->function, (Type*)callable->function->data.function.type);
	@thunk->next := compiler->runtime_thunks;
	@compiler->runtime_thunks := thunk;
	return (void*)thunk->function;
};

fn runtime_views_emit(Compiler* compiler) {
	while (compiler->runtime_views && compiler->result != COMPILATION_FAILURE) {
		RuntimeView* view := compiler->runtime_views;
		@compiler->runtime_views := view->next;
		complete_offsets((Compiler*)compiler, (CompleteGraph*)view->graph);
		usize count = virtual_base_count((Entity*)view->object->entity);
		void** offsets = (void**)memory_allocate((Compiler*)compiler, count * sizeof(void*));
		VirtualType* target := view->object->entity->data.aggregate.virtual_types;
		while (target) {
			Subobject* storage := view->graph->virtuals;
			while (storage && storage->entity != target->entity) {
				@storage := storage->virtual_next;
			};
			@offsets[target->index] = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), storage->offset - view->object->offset, 0);
			@target := target->next;
		};
		void*[2] fields {};
		@fields[0] = LLVMConstArray2(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), $offsets, (u64)count);
		@count = virtual_callable_count((Entity*)view->object->entity);
		void** functions = (void**)memory_allocate((Compiler*)compiler, count * sizeof(void*));
		VirtualCallable* callable := view->object->entity->data.aggregate.virtual_callables;
		while (callable) {
			@functions[callable->index] = runtime_thunk_request((Compiler*)compiler, (CompleteGraph*)view->graph, (Subobject*)view->object, (VirtualCallable*)callable);
			@callable := callable->next;
		};
		@fields[1] = LLVMConstArray2(LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), $functions, (u64)count);
		LLVMSetInitializer((void*)view->object->view, LLVMConstStructInContext((void*)compiler->llvm_context.handle, &fields[0], 2, 0));
	};
};

fn emit_byte_offset(Emitter* emitter, void* address, u64 offset) -> void* {
	Compiler* compiler := emitter->compiler;
	void* index = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), $offset, 0);
	return LLVMBuildGEP2((void*)compiler->llvm_builder.handle, LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 8), $address, &index, 1, "subobject\0");
};

fn emit_base_address(Emitter* emitter, void* address, Entity* derived, BasePath* path, BaseDirection direction) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder.handle;
	u64 offset = 0;
	while (path) {
		BaseRelation* relation := path->relation;
		if (direction == BASE_UP && relation->kind == BASE_VIRTUAL) {
			void* header = LLVMBuildStructGEP2((void*)builder, llvm_body((Compiler*)compiler, (Entity*)derived), (void*)address, 0, "view.storage\0");
			void* view = LLVMBuildLoad2((void*)builder, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), $header, "view\0");
			void* offsets = LLVMBuildStructGEP2((void*)builder, runtime_view_type((Compiler*)compiler, (Entity*)derived), $view, 0, "virtual.offsets\0");
			void* index = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), (u64)relation->component, 0);
			void* slot = LLVMBuildGEP2((void*)builder, llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), $offsets, &index, 1, "virtual.offset.storage\0");
			void* displacement = LLVMBuildLoad2((void*)builder, llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), $slot, "virtual.offset\0");
			@address = LLVMBuildGEP2((void*)builder, LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 8), (void*)address, &displacement, 1, "virtual.base\0");
		}
		else if (direction == BASE_UP) {
			@address = LLVMBuildStructGEP2((void*)builder, llvm_body((Compiler*)compiler, (Entity*)derived), (void*)address, (u32)relation->component, "base\0");
		}
		else {
			@offset = offset + LLVMOffsetOfElement((void*)compiler->llvm_layout.handle, llvm_body((Compiler*)compiler, (Entity*)derived), (u32)relation->component);
		};
		@derived := relation->entity;
		@path := path->next;
	};
	if (direction == BASE_DOWN && offset) {
		void* integer = LLVMBuildPtrToInt((void*)builder, (void*)address, llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), "base.address\0");
		@integer = LLVMBuildSub((void*)builder, (void*)integer, LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), (u64)offset, 0), "derived.address\0");
		@address = LLVMBuildIntToPtr((void*)builder, $integer, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), "derived\0");
	};
	return $address;
};

fn emit_base_conversion(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	Syntax* value := syntax->data.base_conversion.value;
	Type* source := value->type;
	void* address = nullptr;
	if (syntax->kind == SYNTAX_BASE_POINTER) {
		@address = emit_expression((Emitter*)emitter, (Syntax*)value);
		@source := source->data.element;
	}
	else {
		@address = emit_address((Emitter*)emitter, (Syntax*)value);
	};
	Entity* derived := source->data.entity;
	if (syntax->data.base_conversion.direction == BASE_DOWN) {
		@derived := syntax->data.base_conversion.target->data.element->data.entity;
	};
	if (syntax->kind == SYNTAX_BASE_POINTER && base_path_virtual((BasePath*)syntax->data.base_conversion.path)) {
		void* initial = LLVMGetInsertBlock((void*)compiler->llvm_builder.handle);
		void* function = LLVMGetBasicBlockParent((void*)initial);
		void* live = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "base.nonnull\0");
		void* merge = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, $function, "base.end\0");
		void* null = LLVMConstNull(LLVMTypeOf((void*)address));
		void* empty = LLVMBuildICmp((void*)compiler->llvm_builder.handle, 32, (void*)address, (void*)null, "base.null\0");
		LLVMBuildCondBr((void*)compiler->llvm_builder.handle, $empty, (void*)merge, (void*)live);
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, (void*)live);
		void* converted = emit_base_address((Emitter*)emitter, (void*)address, (Entity*)derived, (BasePath*)syntax->data.base_conversion.path, (BaseDirection)syntax->data.base_conversion.direction);
		@live = LLVMGetInsertBlock((void*)compiler->llvm_builder.handle);
		LLVMBuildBr((void*)compiler->llvm_builder.handle, (void*)merge);
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $merge);
		void* result = LLVMBuildPhi((void*)compiler->llvm_builder.handle, LLVMTypeOf((void*)address), "base.pointer\0");
		void*[2] values {};
		void*[2] blocks {};
		@values[0] = $null;
		@values[1] = $converted;
		@blocks[0] = $initial;
		@blocks[1] = $live;
		LLVMAddIncoming((void*)result, &values[0], &blocks[0], 2);
		return $result;
	};
	void* result = emit_base_address($emitter, (void*)address, $derived, (BasePath*)syntax->data.base_conversion.path, (BaseDirection)syntax->data.base_conversion.direction);
	if (syntax->kind == SYNTAX_BASE_POINTER) {
		void* null = LLVMConstNull(LLVMTypeOf((void*)address));
		void* empty = LLVMBuildICmp((void*)compiler->llvm_builder.handle, 32, (void*)address, (void*)null, "base.null\0");
		return LLVMBuildSelect((void*)compiler->llvm_builder.handle, $empty, $null, (void*)result, "base.pointer\0");
	};
	return $result;
};

fn runtime_callable(Compiler* compiler, Entity* entity) -> void* {
	if (!entity->data.function.callable) {
		return (void*)entity->data.function.llvm_value;
	};
	if (entity->data.function.wrapper) {
		return (void*)entity->data.function.wrapper;
	};
	void* function = LLVMAddFunction((void*)compiler->llvm_module.handle, "rt.virtual.callable\0", llvm_type((Compiler*)compiler, (Type*)entity->data.function.type));
	LLVMSetLinkage((void*)function, 9);
	emit_function_attributes((Compiler*)compiler, (void*)function, (Type*)entity->data.function.type);
	@entity->data.function.wrapper := function;
	RuntimeWrapper* wrapper = (RuntimeWrapper*)memory_allocate((Compiler*)compiler, sizeof(RuntimeWrapper));
	@wrapper->entity = $entity;
	@wrapper->next := compiler->runtime_wrappers;
	@compiler->runtime_wrappers = $wrapper;
	return $function;
};

fn emit_dispatch_target(Emitter* emitter, Entity* entity, void* receiver) -> void* {
	Compiler* compiler := emitter->compiler;
	Entity* owner := entity->data.function.interface_owner;
	void* header = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)owner), $receiver, 0, "virtual.header\0");
	void* view = LLVMBuildLoad2((void*)compiler->llvm_builder.handle, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), $header, "virtual.view\0");
	void* functions = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, runtime_view_type((Compiler*)compiler, $owner), $view, 1, "virtual.functions\0");
	void* index = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), (u64)entity->data.function.callable->index, 0);
	void* slot = LLVMBuildGEP2((void*)compiler->llvm_builder.handle, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), $functions, &index, 1, "virtual.slot\0");
	return LLVMBuildLoad2((void*)compiler->llvm_builder.handle, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), $slot, "virtual.target\0");
};

fn emit_covariant_result(Emitter* emitter, void* value, Type* source, Type* target) -> void* {
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	Compiler* compiler := emitter->compiler;
	BaseSearch path = base_search((Compiler*)compiler, (Type*)source->data.element, (Type*)target->data.element);
	if (source->kind == TYPE_REFERENCE) {
		return emit_base_address((Emitter*)emitter, (void*)value, (Entity*)source->data.element->data.entity, (BasePath*)path.path, BASE_UP);
	};
	void* initial = LLVMGetInsertBlock((void*)compiler->llvm_builder.handle);
	void* function = LLVMGetBasicBlockParent((void*)initial);
	void* live = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "return.nonnull\0");
	void* merge = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, $function, "return.end\0");
	void* null = LLVMConstNull(LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0));
	void* empty = LLVMBuildICmp((void*)compiler->llvm_builder.handle, 32, (void*)value, (void*)null, "return.null\0");
	LLVMBuildCondBr((void*)compiler->llvm_builder.handle, $empty, (void*)merge, (void*)live);
	LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, (void*)live);
	void* adjusted = emit_base_address($emitter, $value, (Entity*)source->data.element->data.entity, (BasePath*)path.path, BASE_UP);
	@live = LLVMGetInsertBlock((void*)compiler->llvm_builder.handle);
	LLVMBuildBr((void*)compiler->llvm_builder.handle, (void*)merge);
	LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $merge);
	void* result = LLVMBuildPhi((void*)compiler->llvm_builder.handle, LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0), "return.base\0");
	void*[2] values {};
	void*[2] blocks {};
	@values[0] = $null;
	@values[1] = $adjusted;
	@blocks[0] = $initial;
	@blocks[1] = $live;
	LLVMAddIncoming((void*)result, &values[0], &blocks[0], 2);
	return $result;
};

fn covariance_adjustment_required(Compiler* compiler, Type* source, Type* target) -> bool {
	if (type_equal((Type*)source, (Type*)target)) {
		return false;
	};
	BaseSearch conversion = base_search((Compiler*)compiler, (Type*)source->data.element, (Type*)target->data.element);
	Entity* current := source->data.element->data.entity;
	BasePath* path := conversion.path;
	u64 offset = 0;
	while (path) {
		if (path->relation->kind == BASE_VIRTUAL) {
			return true;
		};
		@offset = offset + LLVMOffsetOfElement((void*)compiler->llvm_layout.handle, llvm_body((Compiler*)compiler, (Entity*)current), (u32)path->relation->component);
		@current := path->relation->entity;
		@path := path->next;
	};
	return offset != 0;
};

fn emit_storage_address(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder.handle;
	switch (syntax->kind) {
		case SYNTAX_BORROWED_COMPONENT:
		case SYNTAX_OWNED_COMPONENT:
			return (void*)syntax->address;
		case SYNTAX_BINARY:
			if (syntax->entity && syntax->entity->kind == ENTITY_FUNCTION && syntax->entity->data.function.role == ASSIGNMENT_ROLE) {
				return emit_special_call((Emitter*)emitter, (Entity*)syntax->entity, emit_address((Emitter*)emitter, (Syntax*)syntax->data.binary.left), (Syntax*)syntax->data.binary.right);
			};
			if (syntax->data.binary.operation == TOKEN_ASSIGN || syntax->data.binary.operation == TOKEN_COPY) {
				emit_expression((Emitter*)emitter, (Syntax*)syntax);
				return (void*)syntax->address;
			};
			break;
		case SYNTAX_ACCESS:
			return emit_storage_address((Emitter*)emitter, (Syntax*)syntax->data.expression);
		case SYNTAX_BASE_REFERENCE:
			return emit_base_conversion((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_NAME:
			if (syntax->entity->kind == ENTITY_FUNCTION) {
				return runtime_callable((Compiler*)compiler, (Entity*)syntax->entity);
			};
			return (void*)syntax->entity->data.variable.data.address;
		case SYNTAX_CAST:
			return emit_address((Emitter*)emitter, (Syntax*)syntax->data.cast.value);
		case SYNTAX_CALL:
			return emit_call((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_UNARY:
			return emit_expression((Emitter*)emitter, (Syntax*)syntax->data.unary.value);
		case SYNTAX_MEMBER: {
			Syntax* object := syntax->data.member.object;
			Type* type := object->type;
			void* address = nullptr;
			if (syntax->token.kind == TOKEN_ARROW) {
				@address = emit_expression((Emitter*)emitter, (Syntax*)object);
				@type := type->data.element;
			}
			else if (syntax_category((Syntax*)object) == VALUE_STORAGE) {
				@address = emit_address((Emitter*)emitter, (Syntax*)object);
			}
			else {
				@address = emit_address((Emitter*)emitter, (Syntax*)object);
			};
			Entity* owner := syntax->entity->data.variable.data.field.owner;
			if (type->data.entity != owner) {
				BaseSearch path = base_search((Compiler*)compiler, (Type*)type, entity_type((Entity*)owner));
				@address = emit_base_address((Emitter*)emitter, (void*)address, (Entity*)type->data.entity, (BasePath*)path.path, BASE_UP);
				@type = entity_type((Entity*)owner);
			};
			if (type->data.entity->kind == ENTITY_UNION) {
				return $address;
			};
			void* field = LLVMBuildStructGEP2((void*)builder, llvm_body((Compiler*)compiler, (Entity*)type->data.entity), (void*)address, (u32)syntax->entity->data.variable.data.field.index, "field\0");
			return $field;
		};
		case SYNTAX_INDEX: {
			Syntax* object := syntax->data.binary.left;
			void* index = emit_expression((Emitter*)emitter, (Syntax*)syntax->data.binary.right);
			@index = emit_cast((Emitter*)emitter, (void*)index, (Type*)syntax->data.binary.right->type, (Type*)compiler->usize_type);
			void*[2] indices {};
			if (object->type->kind == TYPE_ARRAY) {
				@indices[0] = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), 0, 0);
				@indices[1] := index;
				return LLVMBuildGEP2((void*)builder, llvm_type((Compiler*)compiler, (Type*)object->type), emit_address((Emitter*)emitter, (Syntax*)object), &indices[0], 2, "element\0");
			};
			@indices[0] = (void*)index;
			return LLVMBuildGEP2($builder, llvm_type((Compiler*)compiler, (Type*)object->type->data.element), emit_expression($emitter, $object), &indices[0], 1, "element\0");
		};
	};
	compiler_error($compiler, Token(syntax->token), "expression has no storage address\0");
	return nullptr;
};

fn type_has_views(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_has_views((Type*)type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (aggregate_header((Entity*)entity)) {
		return true;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_has_views(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_has_views(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn type_requires_union_choice(Type* type) -> bool {
	if (!type) {
		return false;
	};
	if (type->kind == TYPE_ARRAY) {
		return type_requires_union_choice((Type*)type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;

	if (entity->kind == ENTITY_UNION) {
		return type_has_views((Type*)type) || type_has_reference((Type*)type);
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_requires_union_choice(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_requires_union_choice(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn emit_initialize_type(Emitter* emitter, Type* type, void* address);
fn emit_payload_copy(Emitter* emitter, Type* type, void* destination, void* source);

fn emit_array_element(Emitter* emitter, Type* type, void* address, usize index) -> void* {
	Compiler* compiler := emitter->compiler;
	void*[2] indices {};
	@indices[0] = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), 0, 0);
	@indices[1] = LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)compiler->usize_type), (u64)index, 0);
	return LLVMBuildGEP2((void*)compiler->llvm_builder.handle, llvm_type($compiler, $type), $address, &indices[0], 2, "array.element\0");
};

fn emit_initialize_body_fields(Emitter* emitter, Entity* entity, void* address) {
	if (entity->kind == ENTITY_UNION) {
		return;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		Type* type = entity_type((Entity*)field->entity);
		if (type_has_views((Type*)type)) {
			void* storage = LLVMBuildStructGEP2((void*)emitter->compiler->llvm_builder.handle, llvm_body((Compiler*)emitter->compiler, (Entity*)entity), (void*)address, (u32)field->entity->data.variable.data.field.index, "member.object\0");
			emit_initialize_type((Emitter*)emitter, (Type*)type, $storage);
		};
		@field := field->next;
	};
};

fn emit_initialize_type(Emitter* emitter, Type* type, void* address) {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views((Type*)type)) {
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_initialize_type((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)address, (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;

	if (entity->kind == ENTITY_UNION) {
		return;
	};
	CompleteGraph* graph = complete_graph((Compiler*)compiler, $entity);
	complete_offsets((Compiler*)compiler, (CompleteGraph*)graph);
	Subobject* object := graph->objects;
	while (object) {
		void* storage = emit_byte_offset((Emitter*)emitter, (void*)address, (u64)object->offset);
		if (aggregate_header((Entity*)object->entity)) {
			void* header = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)object->entity), (void*)storage, 0, "view.storage\0");
			LLVMBuildStore((void*)compiler->llvm_builder.handle, runtime_view_request((Compiler*)compiler, (CompleteGraph*)graph, (Subobject*)object), $header);
		};
		emit_initialize_body_fields((Emitter*)emitter, (Entity*)object->entity, $storage);
		@object := object->next;
	};
};

fn emit_body_payload_copy(Emitter* emitter, Entity* entity, void* destination, void* source) {
	Compiler* compiler := emitter->compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)base->component, "copy.base.destination\0");
			void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)base->component, "copy.base.source\0");
			emit_body_payload_copy((Emitter*)emitter, (Entity*)base->entity, $target, $origin);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)field->entity->data.variable.data.field.index, "copy.field.destination\0");
		void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)field->entity->data.variable.data.field.index, "copy.field.source\0");
		emit_payload_copy((Emitter*)emitter, entity_type((Entity*)field->entity), $target, $origin);
		@field := field->next;
	};
};

fn emit_payload_copy(Emitter* emitter, Type* type, void* destination, void* source) {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views((Type*)type) || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_UNION)) {
		void* value = LLVMBuildLoad2((void*)compiler->llvm_builder.handle, llvm_type((Compiler*)compiler, (Type*)type), (void*)source, "copy.value\0");
		LLVMBuildStore((void*)compiler->llvm_builder.handle, $value, (void*)destination);
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_payload_copy((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)destination, (u64)index), emit_array_element((Emitter*)emitter, (Type*)type, (void*)source, (u64)index));
			@index = index + 1;
		};
		return;
	};
	Entity* entity := type->data.entity;
	emit_body_payload_copy((Emitter*)emitter, (Entity*)entity, (void*)destination, (void*)source);
	CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)entity);
	Subobject* target := graph->virtuals;
	while (target) {
		BasePath* path = nullptr;
		subobject_find_path((Compiler*)compiler, (Subobject*)graph->root, (Subobject*)target, &path);
		void* origin = emit_base_address((Emitter*)emitter, (void*)source, (Entity*)entity, (BasePath*)path, BASE_UP);
		void* result = emit_base_address((Emitter*)emitter, (void*)destination, (Entity*)entity, $path, BASE_UP);
		emit_body_payload_copy((Emitter*)emitter, (Entity*)target->entity, $result, $origin);
		@target := target->virtual_next;
	};
};

fn emit_complete_read(Emitter* emitter, Type* type, void* source) -> void* {
	Compiler* compiler := emitter->compiler;
	if (!type_has_views((Type*)type) || (type->kind == TYPE_NAMED && type->data.entity->kind == ENTITY_UNION)) {
		return LLVMBuildLoad2((void*)compiler->llvm_builder.handle, llvm_type((Compiler*)compiler, (Type*)type), (void*)source, "value\0");
	};
	void* value = emit_slot((Compiler*)compiler, (Type*)type);
	emit_initialize_type((Emitter*)emitter, (Type*)type, (void*)value);
	emit_payload_copy($emitter, (Type*)type, (void*)value, $source);
	return LLVMBuildLoad2((void*)compiler->llvm_builder.handle, llvm_type($compiler, $type), $value, "complete.value\0");
};

fn emit_value_read(Emitter* emitter, Syntax* syntax) -> void* {
	return emit_complete_read((Emitter*)emitter, (Type*)syntax->type, emit_address($emitter, $syntax));
};

fn emit_truth(Emitter* emitter, void* value, Type* type) -> void* {
	void* zero = LLVMConstNull(llvm_type((Compiler*)emitter->compiler, (Type*)type));
	if (type->kind == TYPE_FLOAT) {
		return LLVMBuildFCmp((void*)emitter->compiler->llvm_builder.handle, 14, (void*)value, (void*)zero, "truth\0");
	};
	return LLVMBuildICmp((void*)emitter->compiler->llvm_builder.handle, 33, $value, $zero, "truth\0");
};

fn emit_address(Emitter* emitter, Syntax* syntax) -> void* {
	if (syntax->kind == SYNTAX_OWNED_COMPONENT) {
		return (void*)syntax->address;
	};
	if (syntax_category((Syntax*)syntax) == VALUE_TEMPORARY) {
		void* value = emit_expression((Emitter*)emitter, (Syntax*)syntax);
		if (syntax->address) {
			return (void*)syntax->address;
		};
		void* slot = emit_slot((Compiler*)emitter->compiler, (Type*)syntax->type);
		LLVMBuildStore((void*)emitter->compiler->llvm_builder.handle, $value, (void*)slot);
		@syntax->address := slot;
		return $slot;
	};
	void* address = emit_storage_address((Emitter*)emitter, (Syntax*)syntax);
	Type* storage = syntax_storage_type((Syntax*)syntax);
	if (storage && storage->kind == TYPE_REFERENCE && syntax->kind != SYNTAX_CALL && syntax->kind != SYNTAX_CAST && syntax->kind != SYNTAX_BASE_REFERENCE) {
		return LLVMBuildLoad2((void*)emitter->compiler->llvm_builder.handle, llvm_type((Compiler*)emitter->compiler, $storage), (void*)address, "referent\0");
	};
	return $address;
};


fn emit_cast(Emitter* emitter, void* value, Type* source, Type* target) -> void* {
	void* builder := emitter->compiler->llvm_builder.handle;
	void* type = llvm_type((Compiler*)emitter->compiler, (Type*)target);
	if (target->kind == TYPE_BOOL && source->kind != TYPE_BOOL) {
		return emit_truth($emitter, (void*)value, (Type*)source);
	};
	if (type_equal((Type*)source, (Type*)target)) {
		return $value;
	};
	if (source->kind == TYPE_POINTER || source->kind == TYPE_REFERENCE) {
		if (target->kind == TYPE_POINTER || target->kind == TYPE_REFERENCE) {
			return $value;
		};
		return LLVMBuildPtrToInt((void*)builder, (void*)value, (void*)type, "cast\0");
	};
	if (target->kind == TYPE_POINTER || target->kind == TYPE_REFERENCE) {
		return LLVMBuildIntToPtr((void*)builder, (void*)value, (void*)type, "cast\0");
	};
	if (source->kind == TYPE_FLOAT && target->kind == TYPE_FLOAT) {
		return LLVMBuildFPCast((void*)builder, (void*)value, (void*)type, "cast\0");
	};
	if (source->kind == TYPE_FLOAT) {
		if (type_unsigned((Type*)target)) {
			return LLVMBuildFPToUI((void*)builder, (void*)value, (void*)type, "cast\0");
		};
		return LLVMBuildFPToSI((void*)builder, (void*)value, (void*)type, "cast\0");
	};
	if (target->kind == TYPE_FLOAT) {
		if (type_unsigned((Type*)source) || source->kind == TYPE_CHAR) {
			return LLVMBuildUIToFP((void*)builder, (void*)value, (void*)type, "cast\0");
		};
		return LLVMBuildSIToFP((void*)builder, (void*)value, (void*)type, "cast\0");
	};
	return LLVMBuildIntCast2($builder, $value, $type, !(type_unsigned((Type*)source) || source->kind == TYPE_CHAR), "cast\0");
};

fn emit_extension(Compiler* compiler, Type* type) -> void* {
	if (!type_integer((Type*)type) || type_bits((Type*)type) >= 32) {
		return nullptr;
	};
	char* name = "signext\0";
	if (type_unsigned((Type*)type) || type->kind == TYPE_CHAR) {
		@name = "zeroext\0";
	};
	return LLVMCreateEnumAttribute((void*)compiler->llvm_context.handle, LLVMGetEnumAttributeKindForName((char*)name, strlen($name)), 0);
};

fn emit_binary(Emitter* emitter, Syntax* syntax, void* first, void* second) -> void* {
	void* builder := emitter->compiler->llvm_builder.handle;
	Type* type := syntax->data.binary.left->type;
	TokenKind operation := syntax->data.binary.operation;
	if (operation != TOKEN_EQUAL && operation != TOKEN_NOT_EQUAL && operation != TOKEN_LESS && operation != TOKEN_GREATER && operation != TOKEN_LESS_EQUAL && operation != TOKEN_GREATER_EQUAL) {
		@type := syntax->type;
	};
	if (type->kind == TYPE_POINTER && (operation == TOKEN_PLUS || operation == TOKEN_MINUS)) {
		@second = emit_cast((Emitter*)emitter, (void*)second, (Type*)syntax->data.binary.right->type, (Type*)emitter->compiler->usize_type);
		if (operation == TOKEN_MINUS) {
			@second = LLVMBuildNeg((void*)builder, (void*)second, "negative\0");
		};
		return LLVMBuildGEP2((void*)builder, llvm_type((Compiler*)emitter->compiler, (Type*)type->data.element), (void*)first, &second, 1, "offset\0");
	};
	if (operation == TOKEN_EQUAL || operation == TOKEN_NOT_EQUAL || operation == TOKEN_LESS || operation == TOKEN_GREATER || operation == TOKEN_LESS_EQUAL || operation == TOKEN_GREATER_EQUAL) {
		i32 predicate = 32;
		if (operation == TOKEN_NOT_EQUAL) {
			@predicate = 33;
		};
		if (operation == TOKEN_GREATER) {
			@predicate = 38;
		};
		if (operation == TOKEN_GREATER_EQUAL) {
			@predicate = 39;
		};
		if (operation == TOKEN_LESS) {
			@predicate = 40;
		};
		if (operation == TOKEN_LESS_EQUAL) {
			@predicate = 41;
		};
		void* result = nullptr;
		if (type->kind == TYPE_FLOAT) {
			@predicate = 1;
			if (operation == TOKEN_NOT_EQUAL) {
				@predicate = 14;
			};
			if (operation == TOKEN_GREATER) {
				@predicate = 2;
			};
			if (operation == TOKEN_GREATER_EQUAL) {
				@predicate = 3;
			};
			if (operation == TOKEN_LESS) {
				@predicate = 4;
			};
			if (operation == TOKEN_LESS_EQUAL) {
				@predicate = 5;
			};
			@result = LLVMBuildFCmp((void*)builder, (i32)predicate, (void*)first, (void*)second, "compare\0");
		}
		else {
			if ((type_unsigned((Type*)type) || type->kind == TYPE_CHAR || type->kind == TYPE_POINTER) && predicate >= 38) {
				@predicate = predicate - 4;
			};
			@result = LLVMBuildICmp((void*)builder, (i32)predicate, (void*)first, (void*)second, "compare\0");
		};
		return $result;
	};
	if (type->kind == TYPE_FLOAT) {
		switch (operation) {
			case TOKEN_PLUS:
				return LLVMBuildFAdd((void*)builder, (void*)first, (void*)second, "sum\0");
			case TOKEN_MINUS:
				return LLVMBuildFSub((void*)builder, (void*)first, (void*)second, "difference\0");
			case TOKEN_STAR:
				return LLVMBuildFMul((void*)builder, (void*)first, (void*)second, "product\0");
			case TOKEN_SLASH:
				return LLVMBuildFDiv((void*)builder, (void*)first, (void*)second, "quotient\0");
		};
	};
	switch (operation) {
		case TOKEN_PLUS:
			return LLVMBuildAdd((void*)builder, (void*)first, (void*)second, "sum\0");
		case TOKEN_MINUS:
			return LLVMBuildSub((void*)builder, (void*)first, (void*)second, "difference\0");
		case TOKEN_STAR:
			return LLVMBuildMul((void*)builder, (void*)first, (void*)second, "product\0");
		case TOKEN_SLASH:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildUDiv((void*)builder, (void*)first, (void*)second, "quotient\0");
			};
			return LLVMBuildSDiv((void*)builder, (void*)first, (void*)second, "quotient\0");
		case TOKEN_REMAINDER:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildURem((void*)builder, (void*)first, (void*)second, "remainder\0");
			};
			return LLVMBuildSRem((void*)builder, (void*)first, (void*)second, "remainder\0");
		case TOKEN_AMPERSAND:
			return LLVMBuildAnd((void*)builder, (void*)first, (void*)second, "and\0");
		case TOKEN_PIPE:
			return LLVMBuildOr((void*)builder, (void*)first, (void*)second, "or\0");
		case TOKEN_CARET:
			return LLVMBuildXor((void*)builder, (void*)first, (void*)second, "xor\0");
		case TOKEN_SHIFT_LEFT:
			return LLVMBuildShl((void*)builder, (void*)first, (void*)second, "shift\0");
		case TOKEN_SHIFT_RIGHT:
			if (type_unsigned((Type*)type)) {
				return LLVMBuildLShr((void*)builder, (void*)first, (void*)second, "shift\0");
			};
			return LLVMBuildAShr($builder, $first, $second, "shift\0");
	};
	compiler_error((Compiler*)emitter->compiler, Token(syntax->token), "unsupported numeric operation\0");
	return nullptr;
};

fn emit_call(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder.handle;
	if (syntax->data.call.receiver.kind == RECEIVER_EVALUATE) {
		Syntax* object := syntax->data.call.receiver.value;
		if (syntax_category((Syntax*)object) == VALUE_STORAGE) {
			emit_address((Emitter*)emitter, (Syntax*)object);
		}
		else {
			emit_expression((Emitter*)emitter, (Syntax*)object);
		};
	};
	Syntax* callee := syntax->data.call.callable;
	Type* signature := callee->type;
	if (signature->kind == TYPE_POINTER) {
		@signature := signature->data.element;
	};
	u32 count = 0;
	if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
		@count = 1;
	};
	Syntax* argument := syntax->data.call.arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	void** values = (void**)memory_allocate((Compiler*)compiler, (usize)count * sizeof(void*));
	Parameter* parameter := signature->data.function.parameters;
	@argument := syntax->data.call.arguments;
	u32 index = 0;
	if (syntax->data.call.receiver.kind == RECEIVER_BIND) {
		Syntax* receiver := syntax->data.call.receiver.value;
		if (parameter->type->kind == TYPE_REFERENCE) {
			@values[0] = emit_address((Emitter*)emitter, (Syntax*)receiver);
		}
		else {
			@values[0] = emit_expression((Emitter*)emitter, (Syntax*)receiver);
		};
		@parameter := parameter->next;
		@index = 1;
	};
	while (argument) {
		void* value = nullptr;
		if (argument->kind == SYNTAX_BLOCK) {
			@argument->entity->data.variable.data.address = emit_slot((Compiler*)compiler, (Type*)argument->type);
			if (argument->data.statements && argument->type->kind != TYPE_REFERENCE) {
				emit_initialize_type((Emitter*)emitter, (Type*)argument->type, (void*)argument->entity->data.variable.data.address);
			};
			emit_statement((Emitter*)emitter, (Syntax*)argument);
			@value = LLVMBuildLoad2((void*)builder, llvm_type((Compiler*)compiler, (Type*)argument->type), (void*)argument->entity->data.variable.data.address, "argument\0");
		}
		else if (parameter && parameter->type->kind == TYPE_REFERENCE) {
			@value = emit_address((Emitter*)emitter, (Syntax*)argument);
		}
		else {
			@value = emit_expression((Emitter*)emitter, (Syntax*)argument);
		};
		if (parameter && parameter->type->kind != TYPE_REFERENCE) {
			@value = emit_cast((Emitter*)emitter, (void*)value, (Type*)argument->type, (Type*)parameter->type);
		};
		if (!parameter) {
			Type* promoted := argument->type;
			if (promoted->kind == TYPE_FLOAT && promoted->data.bits == 32) {
				@promoted = type_new((Compiler*)compiler, TYPE_FLOAT);
				@promoted->data.bits = 64;
			}
			else if (type_integer((Type*)promoted) && type_bits((Type*)promoted) < 32) {
				@promoted := compiler->i32_type;
			};
			@value = emit_cast((Emitter*)emitter, (void*)value, (Type*)argument->type, $promoted);
		};
		@values[index] = $value;
		@index = index + 1;
		@argument := argument->next;
		if (parameter) {
			@parameter := parameter->next;
		};
	};
	char* name = "call\0";
	if (signature->data.function.result->kind == TYPE_VOID) {
		@name = "\0";
	};
	void* target = nullptr;
	if (callee->kind == SYNTAX_NAME && callee->entity && callee->entity->kind == ENTITY_FUNCTION) {
		Entity* function := callee->entity;
		if (function->data.function.callable && !syntax->data.call.qualified_owner && !callee->data.expression) {
			@target = emit_dispatch_target((Emitter*)emitter, (Entity*)function, (void*)values[0]);
		}
		else {
			@target := function->data.function.llvm_value;
		};
	}
	else {
		@target = emit_expression((Emitter*)emitter, (Syntax*)callee);
	};
	void* call = LLVMBuildCall2($builder, llvm_type((Compiler*)compiler, (Type*)signature), $target, $values, $count, $name);
	void* extension = emit_extension((Compiler*)compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute((void*)call, 0, (void*)extension);
	};
	@index = 1;
	@parameter := signature->data.function.parameters;
	while (parameter) {
		@extension = emit_extension((Compiler*)compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute((void*)call, (u32)index, (void*)extension);
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
	return $call;
};

fn emit_special_call(Emitter* emitter, Entity* function, void* receiver, Syntax* arguments) -> void* {
	Compiler* compiler := emitter->compiler;
	Type* signature := function->data.function.type;
	u32 count = 1;
	Syntax* argument := arguments;
	while (argument) {
		@count = count + 1;
		@argument := argument->next;
	};
	void** values = (void**)memory_allocate((Compiler*)compiler, (usize)count * sizeof(void*));
	@values[0] = $receiver;
	Parameter* parameter := signature->data.function.parameters->next;
	@argument := arguments;
	u32 index = 1;
	while (argument && parameter) {
		if (parameter->type->kind == TYPE_REFERENCE) {
			@values[index] = emit_address((Emitter*)emitter, (Syntax*)argument);
		}
		else {
			@values[index] = emit_cast((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)argument), (Type*)argument->type, (Type*)parameter->type);
		};
		@argument := argument->next;
		@parameter := parameter->next;
		@index = index + 1;
	};
	char* name = "special.call\0";
	if (signature->data.function.result->kind == TYPE_VOID) {
		@name = "\0";
	};
	void* call = LLVMBuildCall2((void*)compiler->llvm_builder.handle, (void*)function->data.function.llvm_type, (void*)function->data.function.llvm_value, $values, $count, $name);
	emit_forward_attributes($compiler, (void*)call, $signature);
	return $call;
};

fn type_requires_destruction(Type* type) -> bool {
	if (type->kind == TYPE_ARRAY) {
		return type_requires_destruction((Type*)type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (entity->data.aggregate.destructor) {
		return true;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_requires_destruction(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_requires_destruction(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	return false;
};

fn emit_destroy_type(Emitter* emitter, Type* type, void* address);

fn emit_destroy_fields(Emitter* emitter, Field* field, void* address) {
	if (!field) {
		return;
	};
	emit_destroy_fields((Emitter*)emitter, (Field*)field->next, (void*)address);
	Entity* entity := field->entity;
	Entity* owner := entity->data.variable.data.field.owner;
	void* member = LLVMBuildStructGEP2((void*)emitter->compiler->llvm_builder.handle, llvm_body((Compiler*)emitter->compiler, $owner), $address, (u32)entity->data.variable.data.field.index, "destroy.field\0");
	emit_destroy_type($emitter, entity_type($entity), $member);
};

fn emit_destroy_body(Emitter* emitter, Entity* entity, void* address);

fn emit_destroy_bases(Emitter* emitter, Entity* owner, BaseRelation* base, void* address) {
	if (!base) {
		return;
	};
	emit_destroy_bases((Emitter*)emitter, (Entity*)owner, (BaseRelation*)base->next, (void*)address);
	if (base->kind == BASE_NONVIRTUAL) {
		void* subobject = LLVMBuildStructGEP2((void*)emitter->compiler->llvm_builder.handle, llvm_body((Compiler*)emitter->compiler, (Entity*)owner), (void*)address, (u32)base->component, "destroy.base\0");
		emit_destroy_body((Emitter*)emitter, (Entity*)base->entity, $subobject);
	};
};

fn emit_destroy_body(Emitter* emitter, Entity* entity, void* address) {
	if (entity->data.aggregate.destructor) {
		if (entity->data.aggregate.destructor->data.function.definition == FUNCTION_DELETED) {
			compiler_error((Compiler*)emitter->compiler, Token(entity->name), "selected destructor is deleted\0");
			return;
		};
		emit_special_call((Emitter*)emitter, (Entity*)entity->data.aggregate.destructor, (void*)address, nullptr);
	};
	if (entity->kind == ENTITY_UNION) {
		if (!entity->data.aggregate.destructor) {
			Field* field := entity->data.aggregate.fields;
			while (field) {
				if (type_requires_destruction(entity_type((Entity*)field->entity))) {
					compiler_error((Compiler*)emitter->compiler, Token(entity->name), "union with nontrivial members requires an explicit destructor\0");
					return;
				};
				@field := field->next;
			};
		};
		return;
	};
	emit_destroy_fields((Emitter*)emitter, (Field*)entity->data.aggregate.fields, (void*)address);
	emit_destroy_bases($emitter, (Entity*)entity, (BaseRelation*)entity->data.aggregate.bases, $address);
};

fn emit_destroy_type(Emitter* emitter, Type* type, void* address) {
	if (!type_requires_destruction((Type*)type)) {
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		u64 index := type->data.array.count;
		while (index) {
			@index = index - 1;
			emit_destroy_type((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)address, (usize)index));
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	Entity* entity := type->data.entity;
	if (type_has_views($type)) {
		compiler_error((Compiler*)emitter->compiler, Token(entity->name), "nontrivial polymorphic lifetimes are not implemented\0");
		return;
	};
	emit_destroy_body($emitter, $entity, $address);
};

fn emit_cleanups(Emitter* emitter, Syntax* syntax) {
	LifetimeCleanup* cleanup := syntax->cleanup;
	while (cleanup) {
		Entity* entity := cleanup->entity;
		emit_destroy_type((Emitter*)emitter, entity_type((Entity*)entity), (void*)entity->data.variable.data.address);
		@cleanup := cleanup->next;
	};
};

fn aggregate_default_constructor(Entity* entity) -> Entity* {
	Entity* constructor := entity->data.aggregate.constructors;
	while (constructor) {
		Parameter* parameter := constructor->data.function.type->data.function.parameters;
		if (parameter && !parameter->next) {
			return $constructor;
		};
		@constructor := constructor->data.function.overload_next;
	};
	return nullptr;
};

fn type_has_lifecycle_callbacks(Type* type) -> bool {
	if (type->kind == TYPE_ARRAY) {
		return type_has_lifecycle_callbacks((Type*)type->data.array.element);
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Entity* entity := type->data.entity;
	if (entity->data.aggregate.constructors || entity->data.aggregate.assignments || entity->data.aggregate.destructor) {
		return true;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (type_has_lifecycle_callbacks(entity_type((Entity*)base->entity))) {
			return true;
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		if (type_has_lifecycle_callbacks(entity_type((Entity*)field->entity))) {
			return true;
		};
		@field := field->next;
	};
	return false;
};

fn lifetime_polymorphism_supported(Emitter* emitter, Type* type) -> bool {
	if (type_has_views((Type*)type) && type_has_lifecycle_callbacks((Type*)type)) {
		Token token;
		if (type->kind == TYPE_NAMED) {
			@token := type->data.entity->name;
		};
		compiler_error((Compiler*)emitter->compiler, $token, "nontrivial polymorphic lifetimes are not implemented\0");
		return false;
	};
	return true;
};

fn emit_default_type(Emitter* emitter, Type* type, void* address);
fn emit_default_body(Emitter* emitter, Entity* entity, void* address);

fn emit_default_body_members(Emitter* emitter, Entity* entity, void* address) {
	if (entity->kind == ENTITY_UNION) {
		return;
	};
	Compiler* compiler := emitter->compiler;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			void* subobject = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)address, (u32)base->component, "construct.base\0");
			emit_default_body((Emitter*)emitter, (Entity*)base->entity, $subobject);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		void* member = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)address, (u32)field->entity->data.variable.data.field.index, "construct.field\0");
		emit_default_type((Emitter*)emitter, entity_type((Entity*)field->entity), $member);
		@field := field->next;
	};
};

fn emit_default_body(Emitter* emitter, Entity* entity, void* address) {
	emit_default_body_members((Emitter*)emitter, (Entity*)entity, (void*)address);
	Entity* constructor = aggregate_default_constructor($entity);
	if (constructor) {
		emit_special_call((Emitter*)emitter, (Entity*)constructor, (void*)address, nullptr);
	};
};

fn emit_default_members(Emitter* emitter, Type* type, void* address) {
	if (!lifetime_polymorphism_supported((Emitter*)emitter, (Type*)type)) {
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	Entity* entity := type->data.entity;
	emit_default_body_members($emitter, $entity, $address);
};

fn emit_default_type(Emitter* emitter, Type* type, void* address) {
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_default_type((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)address, (u64)index));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};
	emit_default_members((Emitter*)emitter, (Type*)type, (void*)address);
	Entity* constructor = aggregate_default_constructor((Entity*)type->data.entity);
	if (constructor) {
		emit_special_call((Emitter*)emitter, (Entity*)constructor, (void*)address, nullptr);
	};
};

enum StorageExtent {
	BODY_OBJECT,
	COMPLETE_OBJECT,
};

fn emit_temporary_register(Emitter* emitter, Type* type, void* value, void* address) -> void* {
	Temporary* temporary = (Temporary*)memory_allocate((Compiler*)emitter->compiler, sizeof(Temporary));
	@temporary->type := type;
	if (!address) {
		@address = emit_slot((Compiler*)emitter->compiler, (Type*)type);
		LLVMBuildStore((void*)emitter->compiler->llvm_builder.handle, (void*)value, (void*)address);
	};
	@temporary->address := address;
	@temporary->next := emitter->temporaries;
	@emitter->temporaries = $temporary;
	return $address;
};

fn emit_storage_special(Emitter* emitter, Type* type, FunctionRole role, void* destination, void* source, SyntaxKind kind, StorageExtent extent) -> bool {
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return false;
	};
	Syntax argument;
	@argument.kind := kind;
	@argument.token := type->data.entity->name;
	@argument.type := type;
	@argument.address := source;
	@argument.use = TRANSFERRED_VALUE;
	if (kind == SYNTAX_BORROWED_COMPONENT) {
		@argument.type = type_qualified((Compiler*)emitter->compiler, (Type*)type, CONST_TYPE);
	};
	Semantic semantic;
	@semantic.compiler := emitter->compiler;
	@semantic.scope := emitter->compiler->module;
	Entity* function = special_select(&semantic, (Entity*)type->data.entity, (FunctionRole)role, &argument, Token(argument.token));
	if (!function) {
		return false;
	};
	if (role == CONSTRUCTOR_ROLE) {
		if (extent == COMPLETE_OBJECT) {
			emit_default_members((Emitter*)emitter, (Type*)type, (void*)destination);
		}
		else {
			emit_default_body_members((Emitter*)emitter, (Entity*)type->data.entity, (void*)destination);
		};
	};
	void* result = emit_special_call((Emitter*)emitter, (Entity*)function, $destination, &argument);
	Type* result_type := function->data.function.type->data.function.result;
	if (role == ASSIGNMENT_ROLE && result_type->kind != TYPE_REFERENCE && type_requires_destruction((Type*)result_type)) {
		emit_temporary_register((Emitter*)emitter, (Type*)result_type, (void*)result, nullptr);
	};
	if (role == ASSIGNMENT_ROLE && function->data.function.type->data.function.parameters->next->type->kind == TYPE_REFERENCE) {
		emit_destroy_type((Emitter*)emitter, (Type*)type, (void*)source);
	};
	return true;
};

fn emit_copy_construct_type(Emitter* emitter, Type* type, void* destination, void* source);

fn emit_copy_construct_body(Emitter* emitter, Entity* entity, void* destination, void* source) {
	Type* type = entity_type((Entity*)entity);
	if (emit_storage_special((Emitter*)emitter, (Type*)type, CONSTRUCTOR_ROLE, (void*)destination, (void*)source, SYNTAX_BORROWED_COMPONENT, BODY_OBJECT)) {
		return;
	};
	Compiler* compiler := emitter->compiler;
	if (entity->kind == ENTITY_UNION) {
		emit_payload_copy((Emitter*)emitter, (Type*)type, (void*)destination, (void*)source);
		return;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)base->component, "construct.copy.base.target\0");
			void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)base->component, "construct.copy.base.source\0");
			emit_copy_construct_body((Emitter*)emitter, (Entity*)base->entity, $target, $origin);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)field->entity->data.variable.data.field.index, "construct.copy.field.target\0");
		void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)field->entity->data.variable.data.field.index, "construct.copy.field.source\0");
		emit_copy_construct_type((Emitter*)emitter, entity_type((Entity*)field->entity), $target, $origin);
		@field := field->next;
	};
};

fn emit_copy_construct_type(Emitter* emitter, Type* type, void* destination, void* source) {
	if (!lifetime_polymorphism_supported((Emitter*)emitter, (Type*)type)) {
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_copy_construct_type((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)destination, (u64)index), emit_array_element((Emitter*)emitter, (Type*)type, (void*)source, (u64)index));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		emit_payload_copy((Emitter*)emitter, (Type*)type, (void*)destination, (void*)source);
		return;
	};
	if (emit_storage_special((Emitter*)emitter, (Type*)type, CONSTRUCTOR_ROLE, (void*)destination, (void*)source, SYNTAX_BORROWED_COMPONENT, COMPLETE_OBJECT)) {
		return;
	};
	Entity* entity := type->data.entity;
	if (type_has_views((Type*)type)) {
		emit_payload_copy((Emitter*)emitter, (Type*)type, (void*)destination, (void*)source);
		return;
	};
	emit_copy_construct_body($emitter, $entity, $destination, $source);
};

fn emit_assign_storage(Emitter* emitter, Type* type, void* destination, void* source);

fn emit_assign_body(Emitter* emitter, Entity* entity, void* destination, void* source) {
	Type* type = entity_type((Entity*)entity);
	if (emit_storage_special((Emitter*)emitter, (Type*)type, ASSIGNMENT_ROLE, (void*)destination, (void*)source, SYNTAX_OWNED_COMPONENT, BODY_OBJECT)) {
		return;
	};
	Compiler* compiler := emitter->compiler;
	if (entity->kind == ENTITY_UNION) {
		emit_payload_copy((Emitter*)emitter, (Type*)type, (void*)destination, (void*)source);
		return;
	};
	BaseRelation* base := entity->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)base->component, "assign.base.target\0");
			void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)base->component, "assign.base.source\0");
			emit_assign_body((Emitter*)emitter, (Entity*)base->entity, $target, $origin);
		};
		@base := base->next;
	};
	Field* field := entity->data.aggregate.fields;
	while (field) {
		void* target = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)destination, (u32)field->entity->data.variable.data.field.index, "assign.field.target\0");
		void* origin = LLVMBuildStructGEP2((void*)compiler->llvm_builder.handle, llvm_body((Compiler*)compiler, (Entity*)entity), (void*)source, (u32)field->entity->data.variable.data.field.index, "assign.field.source\0");
		emit_assign_storage((Emitter*)emitter, entity_type((Entity*)field->entity), $target, $origin);
		@field := field->next;
	};
};

fn emit_assign_storage(Emitter* emitter, Type* type, void* destination, void* source) {
	if (!lifetime_polymorphism_supported((Emitter*)emitter, (Type*)type)) {
		return;
	};
	if (type->qualifier == CONST_TYPE || type->kind == TYPE_REFERENCE) {
		Token token;
		compiler_error((Compiler*)emitter->compiler, $token, "generated assignment cannot replace a const or reference component\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		usize index = 0;
		while (index < type->data.array.count) {
			emit_assign_storage((Emitter*)emitter, (Type*)type->data.array.element, emit_array_element((Emitter*)emitter, (Type*)type, (void*)destination, (u64)index), emit_array_element((Emitter*)emitter, (Type*)type, (void*)source, (u64)index));
			@index = index + 1;
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM || type_has_views((Type*)type)) {
		emit_payload_copy((Emitter*)emitter, (Type*)type, (void*)destination, (void*)source);
		return;
	};
	emit_assign_body($emitter, (Entity*)type->data.entity, $destination, $source);
};

fn emit_expression_value(Emitter* emitter, Syntax* syntax) -> void* {
	Compiler* compiler := emitter->compiler;
	void* builder := compiler->llvm_builder.handle;
	void* type = llvm_type((Compiler*)compiler, (Type*)syntax->type);
	switch (syntax->kind) {
		case SYNTAX_BORROWED_COMPONENT:
		case SYNTAX_OWNED_COMPONENT:
			return emit_complete_read((Emitter*)emitter, (Type*)syntax->type, (void*)syntax->address);
		case SYNTAX_DISCARD:
			return nullptr;
		case SYNTAX_CONSTRUCT: {
			Type* target := syntax->data.construction.target;
			void* slot = emit_slot((Compiler*)compiler, (Type*)target);
			@syntax->data.construction.slot := slot;
			Syntax* argument := syntax->data.construction.arguments;
			if (syntax->data.construction.constructor) {
				LLVMBuildStore((void*)builder, LLVMConstNull(llvm_type((Compiler*)compiler, (Type*)target)), (void*)slot);
				emit_initialize_type((Emitter*)emitter, (Type*)target, (void*)slot);
				emit_default_members((Emitter*)emitter, (Type*)target, (void*)slot);
				emit_special_call((Emitter*)emitter, (Entity*)syntax->data.construction.constructor, (void*)slot, (Syntax*)argument);
			}
			else if (!argument) {
				LLVMBuildStore((void*)builder, LLVMConstNull(llvm_type((Compiler*)compiler, (Type*)target)), (void*)slot);
				emit_initialize_type((Emitter*)emitter, (Type*)target, (void*)slot);
				emit_default_type((Emitter*)emitter, (Type*)target, (void*)slot);
			}
			else if (type_aggregate((Type*)target)) {
				void* source = emit_address((Emitter*)emitter, (Syntax*)argument);
				emit_initialize_type((Emitter*)emitter, (Type*)target, (void*)slot);
				emit_copy_construct_type((Emitter*)emitter, (Type*)target, (void*)slot, (void*)source);
			}
			else {
				void* value = emit_cast((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)argument), (Type*)argument->type, (Type*)target);
				LLVMBuildStore((void*)builder, (void*)value, (void*)slot);
			};
			return LLVMBuildLoad2((void*)builder, llvm_type((Compiler*)compiler, $target), $slot, "constructed\0");
		};
		case SYNTAX_ACCESS:
		case SYNTAX_RELOCATE:
			return emit_expression((Emitter*)emitter, (Syntax*)syntax->data.expression);
		case SYNTAX_BASE_POINTER:
			return emit_base_conversion((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_BASE_REFERENCE:
			return emit_value_read((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_NULLPTR:
			return LLVMConstNull($type);
		case SYNTAX_NUMBER:
			if (syntax->type->kind == TYPE_POINTER) {
				return LLVMConstNull($type);
			};
			if (syntax->type->kind == TYPE_BOOL) {
				return LLVMConstInt((void*)type, number_truth((Compiler*)compiler, Token(syntax->token)), 0);
			};
			if (syntax->type->kind == TYPE_FLOAT) {
				if (syntax->token.source->bytes[syntax->token.begin] == '\'') {
					return LLVMConstReal((void*)type, (f64)integer_spelling((Compiler*)compiler, Token(syntax->token), (u64)18446744073709551615));
				};
				char* text = memory_text((Compiler*)compiler, syntax->token.source->bytes + syntax->token.begin, (u64)syntax->token.length);
				return LLVMConstReal((void*)type, strtod($text, nullptr));
			};
			return LLVMConstInt((void*)type, integer_spelling((Compiler*)compiler, Token(syntax->token), (u64)18446744073709551615), 0);
		case SYNTAX_STRING: {
			void* value = LLVMConstStringInContext2((void*)compiler->llvm_context.handle, (char*)syntax->data.string.bytes, (u64)syntax->data.string.length, 1);
			void* global = LLVMAddGlobal((void*)compiler->llvm_module.handle, LLVMTypeOf((void*)value), "string\0");
			LLVMSetInitializer((void*)global, (void*)value);
			LLVMSetGlobalConstant((void*)global, 1);
			LLVMSetLinkage((void*)global, 9);
			return $global;
		};
		case SYNTAX_NAME:
			if (syntax->entity->kind == ENTITY_FUNCTION) {
				return runtime_callable((Compiler*)compiler, (Entity*)syntax->entity);
			};
			if (syntax->entity->data.variable.storage == STORAGE_CONSTANT) {
				return LLVMConstInt((void*)type, (u64)syntax->entity->data.variable.data.integer, 0);
			};
			if (syntax->type->kind == TYPE_FUNCTION) {
				return emit_address((Emitter*)emitter, (Syntax*)syntax);
			};
			return emit_value_read((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_MEMBER:
		case SYNTAX_INDEX:
			if (syntax->type->kind == TYPE_FUNCTION) {
				return emit_address((Emitter*)emitter, (Syntax*)syntax);
			};
			return emit_value_read((Emitter*)emitter, (Syntax*)syntax);
		case SYNTAX_SIZEOF:
			return LLVMConstInt($type, LLVMABISizeOfType((void*)compiler->llvm_layout.handle, llvm_type((Compiler*)compiler, (Type*)syntax->data.expression->type)), 0);
		case SYNTAX_CAST:
			return emit_cast((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)syntax->data.cast.value), (Type*)syntax->data.cast.value->type, (Type*)syntax->type);
		case SYNTAX_UNARY: {
			TokenKind operation := syntax->data.unary.operation;
			Syntax* operand := syntax->data.unary.value;
			if (operation == TOKEN_AMPERSAND) {
				if (operand->type->kind == TYPE_FUNCTION) {
					return emit_expression((Emitter*)emitter, (Syntax*)operand);
				};
				return emit_address((Emitter*)emitter, (Syntax*)operand);
			};
			if (operation == TOKEN_STAR) {
				if (syntax->type->kind == TYPE_FUNCTION) {
					return emit_expression((Emitter*)emitter, (Syntax*)operand);
				};
				return emit_value_read((Emitter*)emitter, (Syntax*)syntax);
			};
			void* value = emit_expression((Emitter*)emitter, (Syntax*)operand);
			if (operation == TOKEN_BANG) {
				@value = LLVMBuildNot((void*)builder, emit_truth((Emitter*)emitter, (void*)value, (Type*)operand->type), "not\0");
				return $value;
			};
			@value = emit_cast((Emitter*)emitter, (void*)value, (Type*)operand->type, (Type*)syntax->type);
			if (operation == TOKEN_TILDE) {
				return LLVMBuildNot((void*)builder, (void*)value, "complement\0");
			};
			if (operation == TOKEN_MINUS) {
				if (syntax->type->kind == TYPE_FLOAT) {
					return LLVMBuildFNeg((void*)builder, (void*)value, "negative\0");
				};
				return LLVMBuildNeg((void*)builder, (void*)value, "negative\0");
			};
			return $value;
		};
		case SYNTAX_BIND_REFERENCE: {
			Syntax* left := syntax->data.binary.left;
			void* referent = emit_address((Emitter*)emitter, (Syntax*)syntax->data.binary.right);
			LLVMBuildStore((void*)builder, (void*)referent, emit_storage_address((Emitter*)emitter, (Syntax*)left));
			return $referent;
		};
		case SYNTAX_INITIALIZE:
		case SYNTAX_BINARY: {
			TokenKind operation := syntax->data.binary.operation;
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			if (operation == TOKEN_ASSIGN || operation == TOKEN_COPY) {
				if (syntax->entity && syntax->entity->kind == ENTITY_FUNCTION && syntax->entity->data.function.role == ASSIGNMENT_ROLE) {
					void* result = emit_special_call((Emitter*)emitter, (Entity*)syntax->entity, emit_address((Emitter*)emitter, (Syntax*)left), (Syntax*)right);
					Type* declared := syntax->entity->data.function.type->data.function.result;
					if (declared->kind == TYPE_REFERENCE) {
						return emit_complete_read((Emitter*)emitter, (Type*)syntax->type, (void*)result);
					};
					return $result;
				};
				if (type_aggregate((Type*)left->type)) {
					void* destination = nullptr;
					if (type_has_views((Type*)left->type)) {
						@destination = emit_address((Emitter*)emitter, (Syntax*)left);
					};
					void* source = nullptr;
					if (syntax_category((Syntax*)right) == VALUE_STORAGE) {
						@source = emit_address((Emitter*)emitter, (Syntax*)right);
					}
					else {
						void* value = emit_expression((Emitter*)emitter, (Syntax*)right);
						@source = emit_slot((Compiler*)compiler, (Type*)right->type);
						LLVMBuildStore((void*)builder, (void*)value, (void*)source);
					};
					if (!destination) {
						@destination = emit_address((Emitter*)emitter, (Syntax*)left);
					};
					@syntax->address := destination;
					if (syntax->kind == SYNTAX_INITIALIZE) {
						if (left->kind != SYNTAX_BASE_REFERENCE) {
							emit_initialize_type((Emitter*)emitter, (Type*)left->type, (void*)destination);
						};
						emit_payload_copy((Emitter*)emitter, (Type*)left->type, (void*)destination, (void*)source);
					}
					else {
						emit_assign_storage((Emitter*)emitter, (Type*)left->type, (void*)destination, (void*)source);
					};
					return emit_complete_read((Emitter*)emitter, (Type*)left->type, $destination);
				};
				void* value = emit_expression((Emitter*)emitter, (Syntax*)right);
				@value = emit_cast((Emitter*)emitter, (void*)value, (Type*)right->type, (Type*)left->type);
				void* destination = emit_address((Emitter*)emitter, (Syntax*)left);
				@syntax->address := destination;
				LLVMBuildStore((void*)builder, (void*)value, (void*)destination);
				return $value;
			};
			if (operation == TOKEN_AND || operation == TOKEN_OR) {
				void* initial = LLVMGetInsertBlock((void*)builder);
				void* function = LLVMGetBasicBlockParent((void*)initial);
				void* rhs = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "logical.right\0");
				void* merge = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "logical.end\0");
				void* first = emit_truth((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)left), (Type*)left->type);
				@initial = LLVMGetInsertBlock((void*)builder);
				if (operation == TOKEN_AND) {
					LLVMBuildCondBr((void*)builder, (void*)first, (void*)rhs, (void*)merge);
				}
				else {
					LLVMBuildCondBr((void*)builder, (void*)first, (void*)merge, (void*)rhs);
				};
				LLVMPositionBuilderAtEnd((void*)builder, (void*)rhs);
				Temporary* boundary := emitter->temporaries;
				void* second = emit_truth((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)right), (Type*)right->type);
				@rhs = LLVMGetInsertBlock((void*)builder);
				LLVMBuildBr((void*)builder, (void*)merge);
				LLVMPositionBuilderAtEnd((void*)builder, (void*)merge);
				void* phi = LLVMBuildPhi((void*)builder, LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1), "logical\0");
				void*[2] values {};
				void*[2] blocks {};
				@values[0] = LLVMConstInt(LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1), (u64)(operation == TOKEN_OR), 0);
				@values[1] = (void*)second;
				@blocks[0] = (void*)initial;
				@blocks[1] = (void*)rhs;
				LLVMAddIncoming((void*)phi, &values[0], &blocks[0], 2);
				Temporary* temporary := emitter->temporaries;
				while (temporary != boundary) {
					void* guard = LLVMBuildPhi((void*)builder, LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1), "temporary.created\0");
					@values[0] = LLVMConstInt(LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1), 0, 0);
					@values[1] := temporary->guard;
					if (!values[1]) {
						@values[1] = LLVMConstInt(LLVMIntTypeInContext((void*)compiler->llvm_context.handle, 1), 1, 0);
					};
					LLVMAddIncoming((void*)guard, &values[0], &blocks[0], 2);
					@temporary->guard = (void*)guard;
					@temporary := temporary->next;
				};
				return $phi;
			};
			void* first = emit_expression((Emitter*)emitter, (Syntax*)left);
			void* second = emit_expression((Emitter*)emitter, (Syntax*)right);
			if (left->type->kind != TYPE_POINTER) {
				Type* operand := left->type;
				if (operation != TOKEN_EQUAL && operation != TOKEN_NOT_EQUAL && operation != TOKEN_LESS && operation != TOKEN_GREATER && operation != TOKEN_LESS_EQUAL && operation != TOKEN_GREATER_EQUAL) {
					@operand := syntax->type;
				};
				@first = emit_cast((Emitter*)emitter, (void*)first, (Type*)left->type, (Type*)operand);
				@second = emit_cast((Emitter*)emitter, (void*)second, (Type*)right->type, (Type*)operand);
			};
			return emit_binary((Emitter*)emitter, (Syntax*)syntax, $first, $second);
		};
		case SYNTAX_CALL: {
			if (syntax_storage_type((Syntax*)syntax)->kind == TYPE_REFERENCE && syntax->type->kind != TYPE_FUNCTION) {
				return emit_value_read((Emitter*)emitter, (Syntax*)syntax);
			};
			return emit_call($emitter, (Syntax*)syntax);
		};
	};
	compiler_error($compiler, Token(syntax->token), "expression cannot be emitted\0");
	return nullptr;
};

fn emit_expression(Emitter* emitter, Syntax* syntax) -> void* {
	if (syntax->kind != SYNTAX_BORROWED_COMPONENT && syntax->kind != SYNTAX_OWNED_COMPONENT) {
		@syntax->address = nullptr;
	};
	void* value = emit_expression_value((Emitter*)emitter, (Syntax*)syntax);
	if (syntax->kind == SYNTAX_CONSTRUCT) {
		@syntax->address := syntax->data.construction.slot;
	}
	else if (syntax->kind == SYNTAX_RELOCATE) {
		@syntax->address = emit_address((Emitter*)emitter, (Syntax*)syntax->data.expression);
	};
	if (!value || syntax->use == TRANSFERRED_VALUE || syntax_category((Syntax*)syntax) != VALUE_TEMPORARY || !type_requires_destruction((Type*)syntax->type)) {
		return $value;
	};
	@syntax->address = emit_temporary_register($emitter, (Type*)syntax->type, (void*)value, (void*)syntax->address);
	return $value;
};

fn emit_temporaries(Emitter* emitter, Temporary* boundary) {
	Compiler* compiler := emitter->compiler;
	while (emitter->temporaries != boundary) {
		Temporary* temporary := emitter->temporaries;
		@emitter->temporaries := temporary->next;
		if (!temporary->guard) {
			emit_destroy_type((Emitter*)emitter, (Type*)temporary->type, (void*)temporary->address);
			continue;
		};
		void* destroy = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)emitter->llvm_function, "temporary.destroy\0");
		void* continuation = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)emitter->llvm_function, "temporary.end\0");
		LLVMBuildCondBr((void*)compiler->llvm_builder.handle, (void*)temporary->guard, (void*)destroy, (void*)continuation);
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $destroy);
		emit_destroy_type((Emitter*)emitter, (Type*)temporary->type, (void*)temporary->address);
		LLVMBuildBr((void*)compiler->llvm_builder.handle, (void*)continuation);
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $continuation);
	};
};

fn emit_jump(Emitter* emitter, void* block) {
	void* current = LLVMGetInsertBlock((void*)emitter->compiler->llvm_builder.handle);
	if (!LLVMGetBasicBlockTerminator($current)) {
		LLVMBuildBr((void*)emitter->compiler->llvm_builder.handle, (void*)block);
	};
};

fn emit_has_predecessor(void* target) -> i32 {
	void* block = LLVMGetFirstBasicBlock(LLVMGetBasicBlockParent((void*)target));
	while (block) {
		void* instruction = LLVMGetBasicBlockTerminator((void*)block);
		if (instruction) {
			u32 count = LLVMGetNumSuccessors((void*)instruction);
			u32 index = 0;
			while (index < count) {
				if (LLVMGetSuccessor((void*)instruction, (u32)index) == target) {
					return 1;
				};
				@index = index + 1;
			};
		};
		@block = LLVMGetNextBasicBlock((void*)block);
	};
	return 0;
};

fn emit_statement(Emitter* emitter, Syntax* syntax) {
	Compiler* compiler := emitter->compiler;
	if (!syntax || compiler->result == COMPILATION_FAILURE) {
		return;
	};
	void* builder := compiler->llvm_builder.handle;
	Temporary* temporaries := emitter->temporaries;
	if (syntax->kind != SYNTAX_CASE && syntax->kind != SYNTAX_BLOCK && syntax->kind != SYNTAX_DECLARATION && LLVMGetBasicBlockTerminator(LLVMGetInsertBlock((void*)builder))) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_BLOCK: {
			Syntax* statement := syntax->data.statements;
			while (statement) {
				emit_statement((Emitter*)emitter, (Syntax*)statement);
				@statement := statement->next;
			};
			break;
		};
		case SYNTAX_DECLARATION:
			if (syntax->entity->kind == ENTITY_VARIABLE) {
				Entity* variable := syntax->entity;
				@variable->data.variable.data.address = emit_slot((Compiler*)compiler, (Type*)variable->data.variable.type);
				if (LLVMGetBasicBlockTerminator(LLVMGetInsertBlock((void*)builder))) {
					break;
				};
				if (!syntax->data.declaration.body) {
					LLVMBuildStore((void*)builder, LLVMConstNull(llvm_type((Compiler*)compiler, (Type*)variable->data.variable.type)), (void*)variable->data.variable.data.address);
					emit_initialize_type((Emitter*)emitter, (Type*)variable->data.variable.type, (void*)variable->data.variable.data.address);
					emit_default_type((Emitter*)emitter, (Type*)variable->data.variable.type, (void*)variable->data.variable.data.address);
				}
				else if (syntax->data.declaration.body->data.statements && variable->data.variable.type->kind != TYPE_REFERENCE) {
					emit_initialize_type((Emitter*)emitter, (Type*)variable->data.variable.type, (void*)variable->data.variable.data.address);
				};
				emit_statement((Emitter*)emitter, (Syntax*)syntax->data.declaration.body);
			};
			break;
		case SYNTAX_RETURN:
			if (syntax->data.expression) {
				Syntax* expression := syntax->data.expression;
				Type* result := emitter->function->data.function.type->data.function.result;
				void* value = nullptr;
				if (result->kind == TYPE_REFERENCE) {
					@value = emit_address((Emitter*)emitter, (Syntax*)expression);
				}
				else {
					@value = emit_expression((Emitter*)emitter, (Syntax*)expression);
					@value = emit_cast((Emitter*)emitter, (void*)value, (Type*)expression->type, (Type*)result);
				};
				if (emitter->return_type && !type_equal((Type*)result, (Type*)emitter->return_type)) {
					@value = emit_covariant_result((Emitter*)emitter, (void*)value, (Type*)result, (Type*)emitter->return_type);
				};
				emit_temporaries((Emitter*)emitter, nullptr);
				emit_cleanups((Emitter*)emitter, (Syntax*)syntax);
				LLVMBuildRet((void*)builder, (void*)value);
			}
			else {
				emit_temporaries((Emitter*)emitter, nullptr);
				emit_cleanups((Emitter*)emitter, (Syntax*)syntax);
				LLVMBuildRetVoid((void*)builder);
			};
			break;
		case SYNTAX_BREAK:
			emit_cleanups((Emitter*)emitter, (Syntax*)syntax);
			LLVMBuildBr((void*)builder, (void*)emitter->flow->break_block);
			break;
		case SYNTAX_CONTINUE: {
			Flow* flow := emitter->flow;
			while (flow && flow->kind != FLOW_LOOP) {
				@flow := flow->parent;
			};
			emit_cleanups((Emitter*)emitter, (Syntax*)syntax);
			LLVMBuildBr((void*)builder, (void*)flow->continue_block);
			break;
		};
		case SYNTAX_IF: {
			void* function := emitter->llvm_function;
			void* first = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "if.then\0");
			void* second = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "if.else\0");
			void* merge = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "if.end\0");
			Syntax* condition := syntax->data.branch.condition;
			void* predicate = emit_truth((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)condition), (Type*)condition->type);
			emit_temporaries((Emitter*)emitter, (Temporary*)temporaries);
			LLVMBuildCondBr((void*)builder, (void*)predicate, (void*)first, (void*)second);
			LLVMPositionBuilderAtEnd((void*)builder, (void*)first);
			emit_statement((Emitter*)emitter, (Syntax*)syntax->data.branch.first);
			i32 first_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock((void*)builder)) != nullptr;
			emit_jump((Emitter*)emitter, (void*)merge);
			LLVMPositionBuilderAtEnd((void*)builder, (void*)second);
			@emitter->temporaries := temporaries;
			emit_statement((Emitter*)emitter, (Syntax*)syntax->data.branch.second);
			i32 second_stops = LLVMGetBasicBlockTerminator(LLVMGetInsertBlock((void*)builder)) != nullptr;
			emit_jump((Emitter*)emitter, (void*)merge);
			LLVMPositionBuilderAtEnd((void*)builder, (void*)merge);
			@emitter->temporaries := temporaries;
			if (first_stops && second_stops) {
				LLVMBuildUnreachable((void*)builder);
			};
			break;
		};
		case SYNTAX_FOR:
		case SYNTAX_WHILE: {
			void* function := emitter->llvm_function;
			void* test = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "loop.test\0");
			void* body = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "loop.body\0");
			void* step = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "loop.step\0");
			void* end = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "loop.end\0");
			emit_statement((Emitter*)emitter, (Syntax*)syntax->data.loop.initializer);
			emit_jump((Emitter*)emitter, (void*)test);
			LLVMPositionBuilderAtEnd((void*)builder, (void*)test);
			Syntax* condition := syntax->data.loop.condition;
			if (condition) {
				void* predicate = emit_truth((Emitter*)emitter, emit_expression((Emitter*)emitter, (Syntax*)condition), (Type*)condition->type);
				emit_temporaries((Emitter*)emitter, (Temporary*)temporaries);
				LLVMBuildCondBr((void*)builder, (void*)predicate, (void*)body, (void*)end);
			}
			else {
				LLVMBuildBr((void*)builder, (void*)body);
			};
			Flow flow;
			@flow.kind = FLOW_LOOP;
			@flow.parent := emitter->flow;
			@flow.break_block := end;
			@flow.continue_block := step;
			@emitter->flow = &flow;
			LLVMPositionBuilderAtEnd((void*)builder, (void*)body);
			emit_statement((Emitter*)emitter, (Syntax*)syntax->data.loop.body);
			emit_jump((Emitter*)emitter, (void*)step);
			LLVMPositionBuilderAtEnd((void*)builder, (void*)step);
			@emitter->temporaries := temporaries;
			if (syntax->data.loop.step) {
				emit_expression((Emitter*)emitter, (Syntax*)syntax->data.loop.step);
				emit_temporaries((Emitter*)emitter, (Temporary*)temporaries);
			};
			emit_jump((Emitter*)emitter, (void*)test);
			@emitter->flow := flow.parent;
			LLVMPositionBuilderAtEnd((void*)builder, (void*)end);
			@emitter->temporaries := temporaries;
			break;
		};
		case SYNTAX_SWITCH: {
			void* function := emitter->llvm_function;
			void* end = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "switch.end\0");
			void* fallback := end;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			CaseBlock* previous := emitter->cases;
			CaseBlock* cases = nullptr;
			u32 count = 0;
			while (statement) {
				if (statement->kind == SYNTAX_CASE) {
					CaseBlock* selection = (CaseBlock*)memory_allocate((Compiler*)compiler, sizeof(CaseBlock));
					@selection->syntax := statement;
					@selection->temporaries := temporaries;
					@selection->block = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "switch.case\0");
					@selection->next := cases;
					if (!statement->data.selection_case.value) {
						@fallback := selection->block;
					}
					else {
						@count = count + 1;
					};
					@cases = (CaseBlock*)selection;
				};
				@statement := statement->next;
			};
			void* value = emit_expression((Emitter*)emitter, (Syntax*)syntax->data.selection.value);
			emit_temporaries((Emitter*)emitter, (Temporary*)temporaries);
			void* instruction = LLVMBuildSwitch((void*)builder, (void*)value, (void*)fallback, (u32)count);
			CaseBlock* selection := cases;
			while (selection) {
				if (selection->syntax->data.selection_case.value) {
					Syntax* expression := selection->syntax->data.selection_case.value;
					u64 value = constant_integer((Compiler*)compiler, (Scope*)expression->scope, (Syntax*)expression);
					@value = constant_selector((u64)value, (Type*)expression->type);
					LLVMAddCase((void*)instruction, LLVMConstInt(llvm_type((Compiler*)compiler, (Type*)expression->type), (u64)value, 0), (void*)selection->block);
				};
				@selection := selection->next;
			};
			Flow flow;
			@flow.kind = FLOW_SWITCH;
			@flow.parent := emitter->flow;
			@flow.break_block := end;
			@emitter->flow = &flow;
			@emitter->cases = (CaseBlock*)cases;
			emit_statement((Emitter*)emitter, (Syntax*)syntax->data.selection.cases);
			emit_jump((Emitter*)emitter, (void*)end);
			@emitter->flow := flow.parent;
			@emitter->cases = (CaseBlock*)previous;
			LLVMPositionBuilderAtEnd((void*)builder, (void*)end);
			@emitter->temporaries := temporaries;
			if (!emit_has_predecessor((void*)end)) {
				LLVMBuildUnreachable((void*)builder);
			};
			break;
		};
		case SYNTAX_CASE: {
			CaseBlock* selection := emitter->cases;
			while (selection && selection->syntax != syntax) {
				@selection := selection->next;
			};
			if (selection) {
				emit_jump((Emitter*)emitter, (void*)selection->block);
				LLVMPositionBuilderAtEnd((void*)builder, (void*)selection->block);
				@emitter->temporaries := selection->temporaries;
			};
			break;
		};
		default:
			emit_expression((Emitter*)emitter, (Syntax*)syntax);
			break;
	};
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock($builder))) {
		emit_temporaries((Emitter*)emitter, (Temporary*)temporaries);
		emit_cleanups((Emitter*)emitter, (Syntax*)syntax);
	};
};

struct LayoutVisit {
	Entity* entity;
	LayoutVisit* parent;
};

fn layout_validate(Compiler* compiler, Type* type, LayoutVisit* parent, Token token) {
	if (!type) {
		return;
	};
	if (type->kind == TYPE_VOID || type->kind == TYPE_NULL || type->kind == TYPE_FUNCTION) {
		compiler_error((Compiler*)compiler, Token(token), "type has no value storage layout\0");
		return;
	};
	if (type->kind == TYPE_ARRAY) {
		layout_validate((Compiler*)compiler, (Type*)type->data.array.element, (LayoutVisit*)parent, Token(token));
		if (compiler->result == COMPILATION_FAILURE) {
			return;
		};

		u64 size = LLVMABISizeOfType((void*)compiler->llvm_layout.handle, llvm_type((Compiler*)compiler, (Type*)type->data.array.element));
		u64 maximum = (u64)18446744073709551615;
		if (compiler->usize_type->data.bits < 64) {
			@maximum = 1;
			i32 bit = 0;
			while (bit < compiler->usize_type->data.bits) {
				@maximum = maximum * 2;
				@bit = bit + 1;
			};
			@maximum = maximum - 1;
		};
		if (size && type->data.array.count > maximum / size) {
			compiler_error((Compiler*)compiler, Token(token), "array storage exceeds the native address range\0");
		};
		return;
	};
	if (type->kind != TYPE_NAMED || type->data.entity->kind == ENTITY_ENUM) {
		return;
	};

	Entity* entity := type->data.entity;
	LayoutVisit* previous := parent;
	while (previous) {
		if (previous->entity == entity) {
			compiler_error((Compiler*)compiler, Token(token), "record contains itself by value\0");
			return;
		};
		@previous := previous->parent;
	};

	entity_resolve((Compiler*)compiler, (Entity*)entity);
	if (!entity->declaration || !entity->declaration->data.declaration.body) {
		compiler_error((Compiler*)compiler, Token(token), "incomplete record has no storage layout\0");
		return;
	};

	Field* binding := entity->data.aggregate.fields;
	LayoutVisit visit;
	@visit.entity := entity;
	@visit.parent = $parent;
	BaseRelation* base := entity->data.aggregate.bases;
	while (base && compiler->result != COMPILATION_FAILURE) {
		layout_validate((Compiler*)compiler, entity_type((Entity*)base->entity), &visit, Token(base->name->token));
		@base := base->next;
	};
	while (binding && compiler->result != COMPILATION_FAILURE) {
		layout_validate((Compiler*)compiler, entity_type((Entity*)binding->entity), &visit, Token(binding->entity->name));
		@binding := binding->next;
	};
};

struct DeclarationIterator {
	Scope* scope;
};

fn declaration_next(DeclarationIterator* iterator, Binding* binding) -> Binding* {
	Scope* members = nullptr;
	if (binding->entity->kind == ENTITY_NAMESPACE || binding->entity->kind == ENTITY_STRUCT || binding->entity->kind == ENTITY_UNION) {
		@members = entity_members((Entity*)binding->entity);
	};
	if (members && members->bindings) {
		@iterator->scope = (Scope*)members;
		return (Binding*)iterator->scope->bindings;
	};
	while (!binding->next) {
		Entity* owner := iterator->scope->owner;
		if (!owner || (owner->kind != ENTITY_NAMESPACE && owner->kind != ENTITY_STRUCT && owner->kind != ENTITY_UNION)) {
			return nullptr;
		};
		@iterator->scope := iterator->scope->parent;
		@binding := iterator->scope->bindings;
		while (binding && binding->entity != owner) {
			@binding := binding->next;
		};
		if (!binding) {
			return nullptr;
		};
	};
	return (Binding*)binding->next;
};

fn declarations_validate_block(Compiler* compiler, Syntax* module) {
	Syntax* statement := module->data.statements;
	while (statement && compiler->result != COMPILATION_FAILURE) {
		if (statement->kind != SYNTAX_DECLARATION) {
			compiler_error((Compiler*)compiler, Token(statement->token), "module context requires declarations\0");
			return;
		};

		Entity* entity := statement->entity;
		if (statement->token.kind == TOKEN_NAMESPACE) {
			declarations_validate_block((Compiler*)compiler, (Syntax*)statement->data.declaration.body);
		}
		else if (entity->kind == ENTITY_FUNCTION) {
			Type* declared = type_resolve((Compiler*)compiler, (Scope*)entity->scope, (Syntax*)statement->data.declaration.type);
			interface_receiver_validate((Compiler*)compiler, (Entity*)entity, (Type*)declared, Token(statement->token));
			if (statement->data.declaration.modification != FUNCTION_ORDINARY && (!entity->data.function.interface_owner || statement->data.declaration.modification != entity->data.function.modification)) {
				compiler_error((Compiler*)compiler, Token(statement->token), "virtual relationships require a matching struct interface declaration\0");
			};
			if (!type_equal($declared, (Type*)entity->data.function.type)) {
				compiler_error((Compiler*)compiler, Token(statement->token), "conflicting function signature\0");
			};
			if (statement->data.declaration.definition != FUNCTION_DECLARATION && statement != entity->declaration) {
				compiler_error((Compiler*)compiler, Token(statement->token), "duplicate function definition\0");
			};
		}
		else if (entity->kind == ENTITY_VARIABLE) {
			if (entity->data.variable.storage != STORAGE_FIELD) {
				compiler_error((Compiler*)compiler, Token(statement->token), "module variables are not supported in this bootstrap stage\0");
			};
		}
		else if (statement->data.declaration.body && statement != entity->declaration) {
			compiler_error((Compiler*)compiler, Token(statement->token), "duplicate type definition\0");
		}
		else if ((entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION) && statement->data.declaration.body) {
			declarations_validate_block((Compiler*)compiler, (Syntax*)statement->data.declaration.body);
		};
		@statement := statement->next;
	};
};

fn declarations_validate(Compiler* compiler) {
	Syntax* module := compiler->declarations;
	while (module && compiler->result != COMPILATION_FAILURE) {
		declarations_validate_block((Compiler*)compiler, (Syntax*)module);
		@module := module->next;
	};
};

fn external_validate(Compiler* compiler, Entity* entity) {
	if (entity->data.function.body || (entity->scope && entity->scope->owner && (entity->scope->owner->kind == ENTITY_STRUCT || entity->scope->owner->kind == ENTITY_UNION))) {
		return;
	};
	DeclarationIterator iterator;
	@iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && binding->entity != entity) {
		Entity* previous := binding->entity;
		if (previous->kind == ENTITY_FUNCTION && !previous->data.function.body && (!previous->scope || !previous->scope->owner || (previous->scope->owner->kind != ENTITY_STRUCT && previous->scope->owner->kind != ENTITY_UNION)) && token_same(Token(previous->name), Token(entity->name)) && !type_equal((Type*)previous->data.function.type, (Type*)entity->data.function.type)) {
			compiler_error((Compiler*)compiler, Token(entity->name), "conflicting external C function signature\0");
			return;
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn virtual_signature_equal(Entity* first, Entity* second) -> bool {
	if (!token_same(Token(first->name), Token(second->name))) {
		return false;
	};
	Type* left := first->data.function.type;
	Type* right := second->data.function.type;
	if (!left || !right || left->data.function.arity != right->data.function.arity) {
		return false;
	};
	Parameter* a := left->data.function.parameters;
	Parameter* b := right->data.function.parameters;
	if (!a || !b || !token_is(Token(a->name), "this\0") || !token_is(Token(b->name), "this\0")) {
		return false;
	};
	@a := a->next;
	@b := b->next;
	while (a && b) {
		if (!type_equal((Type*)a->type, (Type*)b->type)) {
			return false;
		};
		@a := a->next;
		@b := b->next;
	};
	return !a && !b;
};

fn virtual_result_compatible(Compiler* compiler, Type* derived, Type* base) -> bool {
	if (type_equal((Type*)derived, (Type*)base)) {
		return true;
	};
	if (derived->kind != base->kind || (derived->kind != TYPE_POINTER && derived->kind != TYPE_REFERENCE)) {
		return false;
	};
	return base_search($compiler, (Type*)derived->data.element, (Type*)base->data.element).count == 1;
};

fn virtual_relationships(Compiler* compiler, Entity* function) {
	if (function->data.function.virtual_resolution == RESOLUTION_READY) {
		return;
	};
	@function->data.function.virtual_resolution = RESOLUTION_ACTIVE;
	Entity* owner = nullptr;
	if (function->scope) {
		@owner := function->scope->owner;
	};
	if (!owner || owner->kind != ENTITY_STRUCT) {
		@function->data.function.virtual_resolution = RESOLUTION_READY;
		return;
	};
	CompleteGraph* graph = complete_graph((Compiler*)compiler, $owner);
	Subobject* object := graph->objects;
	while (object) {
		if (object != graph->root) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				Entity* inherited := callable->function;
				entity_resolve((Compiler*)compiler, (Entity*)inherited);
				if (virtual_signature_equal((Entity*)function, (Entity*)inherited)) {
					OverrideLink* existing := function->data.function.overrides;
					while (existing && existing->function != inherited) {
						@existing := existing->next;
					};
					if (!existing) {
						OverrideLink* relation = (OverrideLink*)memory_allocate((Compiler*)compiler, sizeof(OverrideLink));
						@relation->function := inherited;
						@relation->next := function->data.function.overrides;
						@function->data.function.overrides = $relation;
					};
					if (inherited->data.function.modification == FUNCTION_FINAL) {
						compiler_error((Compiler*)compiler, Token(function->name), "cannot override a final operation\0");
					};
					if (!virtual_result_compatible((Compiler*)compiler, (Type*)function->data.function.type->data.function.result, (Type*)inherited->data.function.type->data.function.result)) {
						compiler_error((Compiler*)compiler, Token(function->name), "override has an incompatible return type\0");
					};
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	FunctionModification modification := function->data.function.modification;
	if (function->data.function.overrides && modification != FUNCTION_OVERRIDE && modification != FUNCTION_FINAL) {
		compiler_error((Compiler*)compiler, Token(function->name), "matching inherited virtual operation requires explicit override or final\0");
	};
	if ((modification == FUNCTION_OVERRIDE || modification == FUNCTION_FINAL) && !function->data.function.overrides) {
		compiler_error((Compiler*)compiler, Token(function->name), "override requires a matching inherited virtual operation\0");
	};
	if (modification != FUNCTION_ORDINARY && !function->data.function.interface_owner) {
		compiler_error((Compiler*)compiler, Token(function->name), "virtual relationships require a struct interface declaration\0");
	};
	@function->data.function.virtual_resolution = RESOLUTION_READY;
};

fn virtual_overrides(Entity* function, Entity* operation) -> bool {
	if (function == operation) {
		return true;
	};
	OverrideLink* relation := function->data.function.overrides;
	while (relation) {
		if (virtual_overrides((Entity*)relation->function, (Entity*)operation)) {
			return true;
		};
		@relation := relation->next;
	};
	return false;
};

struct VirtualCandidate {
	VirtualTarget target;
	VirtualCandidate* next;
};

fn virtual_target(Compiler* compiler, CompleteGraph* graph, Subobject* receiver, Entity* operation) -> VirtualTarget {
	VirtualCandidate* candidates = nullptr;
	Subobject* object := graph->objects;
	while (object) {
		if (subobject_contains((Subobject*)object, (Subobject*)receiver)) {
			VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
			while (callable) {
				if (virtual_overrides((Entity*)callable->function, (Entity*)operation)) {
					VirtualCandidate* candidate = (VirtualCandidate*)memory_allocate((Compiler*)compiler, sizeof(VirtualCandidate));
					@candidate->target.function := callable->function;
					@candidate->target.object := object;
					@candidate->next := candidates;
					@candidates = $candidate;
				};
				@callable := callable->next;
			};
		};
		@object := object->next;
	};
	VirtualTarget result;
	VirtualCandidate* candidate := candidates;
	while (candidate) {
		VirtualCandidate* other := candidates;
		while (other && (other->target.object == candidate->target.object || !subobject_contains((Subobject*)other->target.object, (Subobject*)candidate->target.object))) {
			@other := other->next;
		};
		if (!other) {
			if (result.object && (result.object != candidate->target.object || result.function != candidate->target.function)) {
				compiler_error((Compiler*)compiler, Token(graph->entity->name), "virtual operation has multiple final overriders\0");
				return $result;
			};
			@result := candidate->target;
		};
		@candidate := candidate->next;
	};
	return $result;
};

fn virtual_validate(Compiler* compiler) {
	DeclarationIterator iterator;
	@iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		if (binding->entity->kind == ENTITY_FUNCTION) {
			virtual_relationships((Compiler*)compiler, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	@iterator.scope := compiler->module;
	@binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		Entity* entity := binding->entity;
		if (entity->kind == ENTITY_STRUCT && entity->declaration && entity->declaration->data.declaration.body) {
			CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)entity);
			Subobject* object := graph->objects;
			while (object && compiler->result != COMPILATION_FAILURE) {
				VirtualCallable* callable := object->entity->data.aggregate.virtual_callables;
				while (callable && compiler->result != COMPILATION_FAILURE) {
					virtual_target((Compiler*)compiler, (CompleteGraph*)graph, (Subobject*)object, (Entity*)callable->function);
					@callable := callable->next;
				};
				@object := object->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn backend_analyze(Compiler* compiler) {
	DeclarationIterator iterator;
	@iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		if (binding->entity->kind != ENTITY_VARIABLE) {
			entity_resolve((Compiler*)compiler, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};

	declarations_validate((Compiler*)compiler);
	virtual_validate((Compiler*)compiler);
	@iterator.scope := compiler->module;
	@binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		Entity* entity := binding->entity;
		if ((entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION) && entity->declaration && entity->declaration->data.declaration.body) {
			layout_validate((Compiler*)compiler, entity_type((Entity*)entity), nullptr, Token(entity->name));
		};
		if (entity->kind == ENTITY_FUNCTION) {
			external_validate((Compiler*)compiler, (Entity*)entity);
			Type* signature := entity->data.function.type;
			if (!entity->data.function.body && type_aggregate((Type*)signature->data.function.result)) {
				compiler_error((Compiler*)compiler, Token(entity->name), "external aggregate return requires C ABI lowering that is not supported yet\0");
			};
			if (signature->data.function.result->kind != TYPE_VOID) {
				layout_validate((Compiler*)compiler, (Type*)signature->data.function.result, nullptr, Token(entity->name));
			};
			Parameter* parameter := signature->data.function.parameters;
			while (parameter && compiler->result != COMPILATION_FAILURE) {
				if (!entity->data.function.body && type_aggregate((Type*)parameter->type)) {
					compiler_error((Compiler*)compiler, Token(entity->name), "external aggregate parameter requires C ABI lowering that is not supported yet\0");
					break;
				};
				layout_validate((Compiler*)compiler, (Type*)parameter->type, nullptr, Token(entity->name));
				@parameter := parameter->next;
			};
		};
		if (entity->kind == ENTITY_FUNCTION && entity->data.function.body) {
			Semantic semantic;
			@semantic.compiler := compiler;
			@semantic.scope := entity->scope;
			@semantic.function := entity;
			semantic_statement(&semantic, (Syntax*)entity->data.function.body);
			if (compiler->result == COMPILATION_SUCCESS) {
				lifetime_function((Compiler*)compiler, (Entity*)entity);
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
};

fn entity_name(Compiler* compiler, Entity* entity) -> char* {
	Scope* scope := entity->scope;
	char* parent = "\0";
	if (scope && scope->owner && (scope->owner->kind == ENTITY_NAMESPACE || scope->owner->kind == ENTITY_STRUCT || scope->owner->kind == ENTITY_UNION)) {
		@parent = entity_name((Compiler*)compiler, (Entity*)scope->owner);
	};
	usize length = strlen((char*)parent);
	usize separator = 0;
	if (length) {
		@separator = 2;
	};
	char* name = (char*)memory_allocate($compiler, length + separator + entity->name.length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy((void*)name, (void*)parent, (u64)length);
	if (separator) {
		@name[length] = ':';
		@name[length + 1] = ':';
	};
	memcpy((void*)(name + length + separator), (void*)(entity->name.source->bytes + entity->name.begin), (u64)entity->name.length);
	return $name;
};

fn emit_symbol(Compiler* compiler, Entity* entity) -> char* {
	if (!entity->data.function.body && (!entity->scope || !entity->scope->owner || (entity->scope->owner->kind != ENTITY_STRUCT && entity->scope->owner->kind != ENTITY_UNION))) {
		return memory_text((Compiler*)compiler, entity->name.source->bytes + entity->name.begin, (u64)entity->name.length);
	};
	char* qualified = entity_name((Compiler*)compiler, (Entity*)entity);
	if (entity->data.function.role != ORDINARY_ROLE) {
		char[22] digits {};
		usize position = sizeof(digits) - 1;
		usize index := entity->data.function.overload_index;
		while (true) {
			@position = position - 1;
			@digits[position] = (char)((usize)'0' + index % 10);
			@index = index / 10;
			if (!index) {
				break;
			};
		};
		usize length = strlen((char*)qualified);
		usize count = strlen(&digits[position]);
		char* name = (char*)memory_allocate((Compiler*)compiler, length + count + 3);
		memcpy((void*)name, (void*)qualified, (u64)length);
		@name[length] = '.';
		@name[length + 1] = (char)((i32)'a' + (i32)entity->data.function.role);
		memcpy((void*)(name + length + 2), (void*)&digits[position], count + 1);
		@qualified = $name;
	};
	if (compiler->output == OUTPUT_LIBRARY) {
		return $qualified;
	};
	char* prefix = "rt.function.\0";
	usize prefix_length = strlen((char*)prefix);
	usize length = strlen((char*)qualified);
	char* name = (char*)memory_allocate($compiler, prefix_length + length + 1);
	if (!name) {
		return nullptr;
	};
	memcpy((void*)name, (void*)prefix, (u64)prefix_length);
	memcpy((void*)(name + prefix_length), (void*)qualified, $length);
	return $name;
};

fn emit_function_body(Compiler* compiler, Entity* entity, void* function, u64 receiver_offset, Type* return_type) {
	if (!entity->data.function.body) {
		return;
	};
	void* block = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "entry\0");
	LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $block);
	Emitter emitter;
	@emitter.llvm_function := function;
	@emitter.return_type = $return_type;
	@emitter.compiler := compiler;
	@emitter.function := entity;
	Parameter* parameter := entity->data.function.type->data.function.parameters;
	u32 index = 0;
	while (parameter) {
		void* value = LLVMGetParam((void*)function, (u32)index);
		if (!index && receiver_offset) {
			@value = emit_byte_offset(&emitter, (void*)value, (u64)receiver_offset);
		};
		@parameter->entity->data.variable.data.address = emit_slot((Compiler*)compiler, (Type*)parameter->type);
		if (type_has_views((Type*)parameter->type) && (parameter->type->kind != TYPE_NAMED || parameter->type->data.entity->kind != ENTITY_UNION)) {
			void* incoming = emit_slot((Compiler*)compiler, (Type*)parameter->type);
			LLVMBuildStore((void*)compiler->llvm_builder.handle, (void*)value, (void*)incoming);
			emit_initialize_type(&emitter, (Type*)parameter->type, (void*)parameter->entity->data.variable.data.address);
			emit_payload_copy(&emitter, (Type*)parameter->type, (void*)parameter->entity->data.variable.data.address, $incoming);
		}
		else {
			LLVMBuildStore((void*)compiler->llvm_builder.handle, (void*)value, (void*)parameter->entity->data.variable.data.address);
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
	emit_statement(&emitter, (Syntax*)entity->data.function.body);
	if (!LLVMGetBasicBlockTerminator(LLVMGetInsertBlock((void*)compiler->llvm_builder.handle))) {
		if (entity->data.function.lifetime_exit == PATH_UNREACHABLE) {
			LLVMBuildUnreachable((void*)compiler->llvm_builder.handle);
		}
		else if (entity->data.function.type->data.function.result->kind == TYPE_VOID) {
			LLVMBuildRetVoid((void*)compiler->llvm_builder.handle);
		}
		else {
			compiler_error((Compiler*)compiler, Token(entity->name), "function can finish without returning a value\0");
		};
	};
};

fn emit_function(Compiler* compiler, Entity* entity) {
	emit_function_body($compiler, (Entity*)entity, (void*)entity->data.function.llvm_value, 0, nullptr);
};

fn emit_forward_attributes(Compiler* compiler, void* call, Type* signature) {
	void* extension = emit_extension((Compiler*)compiler, (Type*)signature->data.function.result);
	if (extension) {
		LLVMAddCallSiteAttribute((void*)call, 0, (void*)extension);
	};
	Parameter* parameter := signature->data.function.parameters;
	u32 index = 1;
	while (parameter) {
		@extension = emit_extension((Compiler*)compiler, (Type*)parameter->type);
		if (extension) {
			LLVMAddCallSiteAttribute((void*)call, (u32)index, (void*)extension);
		};
		@index = index + 1;
		@parameter := parameter->next;
	};
};

fn emit_variadic_tail(Compiler* compiler, void* function, void* call) {
	void* attribute = LLVMCreateStringAttribute((void*)compiler->llvm_context.handle, "thunk\0", 5, "\0", 0);
	LLVMAddAttributeAtIndex($function, (u32)4294967295, $attribute);
	LLVMSetTailCallKind($call, 2);
};

fn emit_forward_return(Compiler* compiler, Type* result, void* call) {
	if (result->kind == TYPE_VOID) {
		LLVMBuildRetVoid((void*)compiler->llvm_builder.handle);
	}
	else {
		LLVMBuildRet((void*)compiler->llvm_builder.handle, (void*)call);
	};
};

fn runtime_wrappers_emit(Compiler* compiler) {
	while (compiler->runtime_wrappers && compiler->result != COMPILATION_FAILURE) {
		RuntimeWrapper* wrapper := compiler->runtime_wrappers;
		@compiler->runtime_wrappers := wrapper->next;
		Entity* entity := wrapper->entity;
		void* function := entity->data.function.wrapper;
		Type* signature := entity->data.function.type;
		void* block = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)function, "entry\0");
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $block);
		Emitter emitter;
		@emitter.llvm_function := function;
		@emitter.compiler := compiler;
		@emitter.function := entity;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		void** arguments = (void**)memory_allocate((Compiler*)compiler, count * sizeof(void*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam((void*)function, (u32)index);
			@index = index + 1;
		};
		void* target = emit_dispatch_target(&emitter, $entity, (void*)arguments[0]);
		char* name = "virtual.call\0";
		if (signature->data.function.result->kind == TYPE_VOID) {
			@name = "\0";
		};
		void* call = LLVMBuildCall2((void*)compiler->llvm_builder.handle, llvm_type((Compiler*)compiler, (Type*)signature), $target, $arguments, (u32)count, $name);
		emit_forward_attributes((Compiler*)compiler, (void*)call, (Type*)signature);
		if (signature->data.function.arity == PARAMETERS_VARIADIC) {
			emit_variadic_tail((Compiler*)compiler, (void*)function, (void*)call);
		};
		emit_forward_return((Compiler*)compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_thunks_emit(Compiler* compiler) {
	while (compiler->runtime_thunks && compiler->result != COMPILATION_FAILURE) {
		RuntimeThunk* thunk := compiler->runtime_thunks;
		@compiler->runtime_thunks := thunk->next;
		Entity* implementation := thunk->target.function;
		Type* signature := thunk->callable->function->data.function.type;
		Type* result := implementation->data.function.type->data.function.result;
		u64 offset = thunk->target.object->offset - thunk->receiver->offset;
		if (signature->data.function.arity == PARAMETERS_VARIADIC && covariance_adjustment_required((Compiler*)compiler, (Type*)result, (Type*)signature->data.function.result)) {
			if (!implementation->data.function.body) {
				compiler_error((Compiler*)compiler, Token(implementation->name), "covariant variadic override requires an available implementation body\0");
				return;
			};
			emit_function_body((Compiler*)compiler, (Entity*)implementation, (void*)thunk->function, (u64)offset, (Type*)signature->data.function.result);
			continue;
		};
		void* block = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)thunk->function, "entry\0");
		LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $block);
		Emitter emitter;
		@emitter.llvm_function := thunk->function;
		@emitter.compiler := compiler;
		@emitter.function := implementation;
		usize count = 0;
		Parameter* parameter := signature->data.function.parameters;
		while (parameter) {
			@count = count + 1;
			@parameter := parameter->next;
		};
		void** arguments = (void**)memory_allocate((Compiler*)compiler, count * sizeof(void*));
		usize index = 0;
		while (index < count) {
			@arguments[index] = LLVMGetParam((void*)thunk->function, (u32)index);
			@index = index + 1;
		};
		@arguments[0] = emit_byte_offset(&emitter, (void*)arguments[0], $offset);
		char* name = "override.call\0";
		if (result->kind == TYPE_VOID) {
			@name = "\0";
		};
		void* call = LLVMBuildCall2((void*)compiler->llvm_builder.handle, (void*)implementation->data.function.llvm_type, (void*)implementation->data.function.llvm_value, $arguments, (u32)count, $name);
		emit_forward_attributes((Compiler*)compiler, (void*)call, (Type*)implementation->data.function.type);
		if (signature->data.function.arity == PARAMETERS_VARIADIC) {
			emit_variadic_tail((Compiler*)compiler, (void*)thunk->function, (void*)call);
			emit_forward_return((Compiler*)compiler, (Type*)signature->data.function.result, (void*)call);
			continue;
		};
		if (!type_equal((Type*)result, (Type*)signature->data.function.result)) {
			@call = emit_covariant_result(&emitter, (void*)call, (Type*)result, (Type*)signature->data.function.result);
		};
		emit_forward_return((Compiler*)compiler, (Type*)signature->data.function.result, $call);
	};
};

fn runtime_metadata_emit(Compiler* compiler) {
	while ((compiler->runtime_views || compiler->runtime_thunks || compiler->runtime_wrappers) && compiler->result != COMPILATION_FAILURE) {
		runtime_wrappers_emit((Compiler*)compiler);
		runtime_views_emit((Compiler*)compiler);
		runtime_thunks_emit((Compiler*)compiler);
	};
};

fn entry_lookup(Compiler* compiler) -> Entity* {
	Source source;
	@source.bytes := compiler->entry;
	@source.length = strlen((char*)compiler->entry);
	Token name;
	@name.source = &source;
	Scope* scope := compiler->module;
	while (name.begin < source.length) {
		@name.length = 0;
		while (name.begin + name.length < source.length && source.bytes[name.begin + name.length] != ':') {
			@name.length = name.length + 1;
		};
		Entity* entity = scope_local((Scope*)scope, Token(name));
		if (!entity) {
			return nullptr;
		};
		if (name.begin + name.length == source.length) {
			return $entity;
		};
		@scope = entity_members($entity);
		if (!scope || name.begin + name.length + 1 >= source.length || source.bytes[name.begin + name.length + 1] != ':') {
			return nullptr;
		};
		@name.begin = name.begin + name.length + 2;
	};
	return nullptr;
};

fn emit_entry(Compiler* compiler) {
	Entity* entry = entry_lookup((Compiler*)compiler);
	if (!entry || entry->kind != ENTITY_FUNCTION || !entry->data.function.body) {
		Token token;
		if (compiler->declarations) {
			@token := compiler->declarations->token;
		};
		compiler_error((Compiler*)compiler, $token, "entry function is missing or has no definition\0");
		return;
	};
	Type* signature := entry->data.function.type;
	if (signature->data.function.result->kind != TYPE_VOID && !type_equal((Type*)signature->data.function.result, (Type*)compiler->i32_type)) {
		compiler_error((Compiler*)compiler, Token(entry->name), "entry function must return i32 or void\0");
		return;
	};
	Parameter* parameter := signature->data.function.parameters;
	void*[2] arguments {};
	void*[2] parameter_types {};
	@parameter_types[0] = llvm_type((Compiler*)compiler, (Type*)compiler->i32_type);
	@parameter_types[1] = LLVMPointerTypeInContext((void*)compiler->llvm_context.handle, 0);
	if (parameter && (!parameter->next || parameter->next->next || !type_equal((Type*)parameter->type, (Type*)compiler->i32_type) || !type_equal((Type*)parameter->next->type, type_pointer((Compiler*)compiler, type_pointer((Compiler*)compiler, (Type*)compiler->char_type))))) {
		compiler_error((Compiler*)compiler, Token(entry->name), "entry parameters must be empty or (i32, char**)\0");
		return;
	};
	void* main_type = LLVMFunctionType((void*)parameter_types[0], &parameter_types[0], 2, 0);
	void* main_function = LLVMAddFunction((void*)compiler->llvm_module.handle, "main\0", $main_type);
	void* block = LLVMAppendBasicBlockInContext((void*)compiler->llvm_context.handle, (void*)main_function, "entry\0");
	LLVMPositionBuilderAtEnd((void*)compiler->llvm_builder.handle, $block);
	@arguments[0] = LLVMGetParam((void*)main_function, 0);
	@arguments[1] = LLVMGetParam($main_function, 1);
	u32 count = 0;
	if (parameter) {
		@count = 2;
	};
	char* name = "entry.result\0";
	if (signature->data.function.result->kind == TYPE_VOID) {
		@name = "\0";
	};
	void* result = LLVMBuildCall2((void*)compiler->llvm_builder.handle, (void*)entry->data.function.llvm_type, (void*)entry->data.function.llvm_value, &arguments[0], $count, $name);
	if (signature->data.function.result->kind == TYPE_VOID) {
		@result = LLVMConstInt((void*)parameter_types[0], 0, 0);
	};
	LLVMBuildRet((void*)compiler->llvm_builder.handle, $result);
};

fn backend_emit(Compiler* compiler) {
	DeclarationIterator iterator;
	@iterator.scope := compiler->module;
	Binding* binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		Entity* entity := binding->entity;
		if (entity->kind == ENTITY_FUNCTION && entity->data.function.definition != FUNCTION_DELETED) {
			Type* signature := entity->data.function.type;
			@entity->data.function.llvm_type = llvm_type((Compiler*)compiler, (Type*)signature);
			char* symbol = emit_symbol((Compiler*)compiler, (Entity*)entity);
			void* existing = LLVMGetNamedFunction((void*)compiler->llvm_module.handle, (char*)symbol);
			if (existing && LLVMGlobalGetValueType((void*)existing) != entity->data.function.llvm_type) {
				compiler_error((Compiler*)compiler, Token(entity->name), "conflicting native function signature\0");
				return;
			};
			if (!existing) {
				@existing = LLVMAddFunction((void*)compiler->llvm_module.handle, (char*)symbol, (void*)entity->data.function.llvm_type);
			};
			@entity->data.function.llvm_value = $existing;
			void* extension = emit_extension((Compiler*)compiler, (Type*)signature->data.function.result);
			if (extension) {
				LLVMAddAttributeAtIndex((void*)entity->data.function.llvm_value, 0, (void*)extension);
			};
			Parameter* parameter := signature->data.function.parameters;
			u32 index = 1;
			while (parameter) {
				@extension = emit_extension((Compiler*)compiler, (Type*)parameter->type);
				if (extension) {
					LLVMAddAttributeAtIndex((void*)entity->data.function.llvm_value, (u32)index, (void*)extension);
				};
				@index = index + 1;
				@parameter := parameter->next;
			};
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	@iterator.scope := compiler->module;
	@binding := compiler->module->bindings;
	while (binding && compiler->result != COMPILATION_FAILURE) {
		if (binding->entity->kind == ENTITY_FUNCTION) {
			emit_function((Compiler*)compiler, (Entity*)binding->entity);
		};
		@binding = declaration_next(&iterator, (Binding*)binding);
	};
	if (compiler->output == OUTPUT_EXECUTABLE && compiler->result != COMPILATION_FAILURE) {
		emit_entry((Compiler*)compiler);
	};
	if (compiler->result == COMPILATION_SUCCESS) {
		runtime_metadata_emit((Compiler*)compiler);
	};
};

fn lifetime_find(LifetimeState* state, Entity* entity) -> LifetimeObject* {
	LifetimeObject* object := state->objects;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->next;
	};
	return nullptr;
};

fn lifetime_clone(Compiler* compiler, LifetimeState* state) -> LifetimeState {
	LifetimeState result;
	@result.reachability := state->reachability;
	LifetimeObject** last = &result.objects;
	LifetimeObject* object := state->objects;
	while (object) {
		LifetimeObject* copy = (LifetimeObject*)memory_allocate((Compiler*)compiler, sizeof(LifetimeObject));
		@copy->entity := object->entity;
		@copy->status := object->status;
		@*last := copy;
		@last = &copy->next;
		@object := object->next;
	};
	return $result;
};

fn lifetime_merge(Compiler* compiler, LifetimeState* destination, LifetimeState* incoming, Token token) {
	if (incoming->reachability == PATH_UNREACHABLE) {
		return;
	};
	if (destination->reachability == PATH_UNREACHABLE) {
		@*destination = lifetime_clone((Compiler*)compiler, (LifetimeState*)incoming);
		return;
	};
	LifetimeObject* object := destination->objects;
	while (object && compiler->result != COMPILATION_FAILURE) {
		LifetimeObject* other = lifetime_find((LifetimeState*)incoming, (Entity*)object->entity);
		if ((!other && object->status != LIFETIME_DEAD) || (other && object->status != other->status)) {
			compiler_error((Compiler*)compiler, Token(token), "inconsistent object lifetimes at reachable control-flow merge\0");
			return;
		};
		@object := object->next;
	};
	@object := incoming->objects;
	while (object && compiler->result != COMPILATION_FAILURE) {
		if (!lifetime_find((LifetimeState*)destination, (Entity*)object->entity)) {
			if (object->status != LIFETIME_DEAD) {
				compiler_error((Compiler*)compiler, Token(token), "object construction does not reach every incoming control-flow path\0");
				return;
			};
			LifetimeObject* copy = (LifetimeObject*)memory_allocate((Compiler*)compiler, sizeof(LifetimeObject));
			@copy->entity := object->entity;
			@copy->status := object->status;
			@copy->next := destination->objects;
			@destination->objects = $copy;
		};
		@object := object->next;
	};
};

fn lifetime_enter(LifetimeAnalysis* analysis, Entity* entity) {
	LifetimeObject* previous := analysis->state.objects;
	while (previous) {
		if (previous->entity->scope == entity->scope && token_same(Token(previous->entity->name), Token(entity->name)) && previous->status != LIFETIME_DEAD) {
			compiler_error((Compiler*)analysis->compiler, Token(entity->name), "duplicate live declaration\0");
			return;
		};
		@previous := previous->next;
	};
	LifetimeObject* object = (LifetimeObject*)memory_allocate((Compiler*)analysis->compiler, sizeof(LifetimeObject));
	@object->entity := entity;
	@object->status = LIFETIME_ALIVE;
	@object->next := analysis->state.objects;
	@analysis->state.objects = $object;
};

fn lifetime_cleanup(LifetimeAnalysis* analysis, Syntax* syntax, LifetimeObject* boundary) {
	LifetimeCleanup** last = &syntax->cleanup;
	while (*last) {
		@last = &(*last)->next;
	};
	LifetimeObject* object := analysis->state.objects;
	while (object && (!boundary || object->entity != boundary->entity)) {
		Type* type = entity_type((Entity*)object->entity);
		if (object->status == LIFETIME_ALIVE && type && type->kind != TYPE_REFERENCE) {
			LifetimeCleanup* cleanup = (LifetimeCleanup*)memory_allocate((Compiler*)analysis->compiler, sizeof(LifetimeCleanup));
			@cleanup->entity := object->entity;
			@*last := cleanup;
			@last = &cleanup->next;
		};
		@object := object->next;
	};
};

fn lifetime_trim(LifetimeState* state, LifetimeObject* boundary) {
	while (state->objects && (!boundary || state->objects->entity != boundary->entity)) {
		@state->objects := state->objects->next;
	};
};

fn lifetime_truth(Syntax* syntax) -> i32 {
	if (!syntax) {
		return 1;
	};
	if (syntax->kind == SYNTAX_NAME && syntax->entity && syntax->entity->kind == ENTITY_VARIABLE && syntax->entity->data.variable.storage == STORAGE_CONSTANT) {
		return !!syntax->entity->data.variable.data.integer;
	};
	if (syntax->kind == SYNTAX_NUMBER && syntax->token.length == 1) {
		char value := syntax->token.source->bytes[syntax->token.begin];
		if (value >= '0' && value <= '9') {
			return value != '0';
		};
	};
	if (syntax->kind == SYNTAX_UNARY && syntax->data.unary.operation == TOKEN_BANG) {
		i32 value = lifetime_truth((Syntax*)syntax->data.unary.value);
		if (value >= 0) {
			return !value;
		};
	};
	return -1;
};

fn lifetime_expression(LifetimeAnalysis* analysis, Syntax* syntax);
fn lifetime_statement(LifetimeAnalysis* analysis, Syntax* syntax);

fn lifetime_nested_statement(LifetimeAnalysis* analysis, Syntax* syntax) {
	if (!syntax) {
		return;
	};
	LifetimeObject* boundary := analysis->state.objects;
	lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax);
	if (analysis->state.reachability == PATH_REACHABLE) {
		lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax, (LifetimeObject*)boundary);
	};
	lifetime_trim(&analysis->state, $boundary);
};

fn lifetime_expression(LifetimeAnalysis* analysis, Syntax* syntax) {
	if (!syntax || analysis->state.reachability == PATH_UNREACHABLE || analysis->compiler->result == COMPILATION_FAILURE) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_CONSTRUCT: {
			Syntax* argument := syntax->data.construction.arguments;
			while (argument) {
				lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)argument);
				@argument := argument->next;
			};
			break;
		};
		case SYNTAX_NAME: {
			LifetimeObject* object = lifetime_find(&analysis->state, (Entity*)syntax->entity);
			if (!object && syntax->entity && syntax->entity->kind == ENTITY_VARIABLE && (syntax->entity->data.variable.storage == STORAGE_LOCAL || syntax->entity->data.variable.storage == STORAGE_PARAMETER || syntax->entity->data.variable.storage == STORAGE_ARGUMENT)) {
				compiler_error((Compiler*)analysis->compiler, Token(syntax->token), "object construction does not reach this use\0");
				return;
			};
			if (object && object->status == LIFETIME_DEAD) {
				compiler_error((Compiler*)analysis->compiler, Token(syntax->token), "object was relocated; declare a new binding before using it\0");
			};
			break;
		};
		case SYNTAX_RELOCATE: {
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&analysis->state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error((Compiler*)analysis->compiler, Token(syntax->token), "relocation requires a live owned local binding\0");
				return;
			};
			@object->status = LIFETIME_DEAD;
			break;
		};
		case SYNTAX_ACCESS:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.expression);
			break;
		case SYNTAX_DISCARD: {
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.expression);
			LifetimeObject* object = lifetime_find(&analysis->state, (Entity*)syntax->data.expression->entity);
			if (!object) {
				compiler_error((Compiler*)analysis->compiler, Token(syntax->token), "discard requires a live owned local binding\0");
				return;
			};
			@object->status = LIFETIME_DEAD;
			break;
		};
		case SYNTAX_MEMBER:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.member.object);
			break;
		case SYNTAX_CAST:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.cast.value);
			break;
		case SYNTAX_BASE_REFERENCE:
		case SYNTAX_BASE_POINTER:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.base_conversion.value);
			break;
		case SYNTAX_UNARY:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.unary.value);
			break;
		case SYNTAX_INITIALIZE:
		case SYNTAX_BIND_REFERENCE:
		case SYNTAX_BINARY: {
			Syntax* left := syntax->data.binary.left;
			Syntax* right := syntax->data.binary.right;
			TokenKind operation := syntax->data.binary.operation;
			if (syntax->kind == SYNTAX_BIND_REFERENCE || ((operation == TOKEN_ASSIGN || operation == TOKEN_COPY) && !type_has_views((Type*)left->type) && !syntax->entity)) {
				lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)right);
				lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)left);
				return;
			};
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)left);
			if (syntax->kind == SYNTAX_BINARY && (operation == TOKEN_AND || operation == TOKEN_OR)) {
				i32 truth = lifetime_truth((Syntax*)left);
				if ((operation == TOKEN_AND && !truth) || (operation == TOKEN_OR && truth == 1)) {
					return;
				};
				LifetimeState skipped = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
				lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)right);
				if (truth < 0) {
					lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &skipped, Token(syntax->token));
				};
				return;
			};
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)right);
			break;
		};
		case SYNTAX_INDEX:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.binary.right);
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.binary.left);
			break;
		case SYNTAX_CALL: {
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.call.receiver.value);
			Syntax* argument := syntax->data.call.arguments;
			while (argument) {
				if (argument->kind == SYNTAX_BLOCK) {
					LifetimeObject* boundary := analysis->state.objects;
					lifetime_enter((LifetimeAnalysis*)analysis, (Entity*)argument->entity);
					lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)argument);
					lifetime_trim(&analysis->state, (LifetimeObject*)boundary);
				}
				else {
					lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)argument);
				};
				@argument := argument->next;
			};
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.call.callable);
			break;
		};
		case SYNTAX_BLOCK:
			lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax);
			break;
		default:
			break;
	};
};

fn lifetime_loop(LifetimeAnalysis* analysis, Syntax* syntax) {
	LifetimeObject* boundary := analysis->state.objects;
	lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.loop.initializer);
	LifetimeState entry = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
	lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.loop.condition);
	i32 truth = lifetime_truth((Syntax*)syntax->data.loop.condition);
	LifetimeState exits;
	if (truth != 1) {
		@exits = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
	};
	LifetimeControl control;
	@control.kind = FLOW_LOOP;
	@control.boundary := analysis->state.objects;
	@control.parent := analysis->control;
	@analysis->control = &control;
	if (!truth) {
		@analysis->state.reachability = PATH_UNREACHABLE;
	};
	lifetime_nested_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.loop.body);
	lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &control.continues, Token(syntax->token));
	lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.loop.step);
	if (analysis->state.reachability == PATH_REACHABLE) {
		lifetime_merge((Compiler*)analysis->compiler, &entry, &analysis->state, Token(syntax->token));
	};
	lifetime_merge((Compiler*)analysis->compiler, &exits, &control.breaks, Token(syntax->token));
	@analysis->state = $exits;
	@analysis->control := control.parent;
	if (analysis->state.reachability == PATH_REACHABLE) {
		lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax, (LifetimeObject*)boundary);
	};
	lifetime_trim(&analysis->state, $boundary);
};

fn lifetime_switch(LifetimeAnalysis* analysis, Syntax* syntax) {
	lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.selection.value);
	LifetimeState dispatch = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
	LifetimeControl control;
	@control.kind = FLOW_SWITCH;
	@control.boundary := analysis->state.objects;
	@control.parent := analysis->control;
	@analysis->control = &control;
	@analysis->state.reachability = PATH_UNREACHABLE;
	i32 defaults = 0;
	Syntax* statement := syntax->data.selection.cases->data.statements;
	while (statement && analysis->compiler->result != COMPILATION_FAILURE) {
		if (statement->kind == SYNTAX_CASE) {
			lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &dispatch, Token(statement->token));
			if (!statement->data.selection_case.value) {
				@defaults = defaults + 1;
			};
		}
		else {
			lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)statement);
		};
		@statement := statement->next;
	};
	if (analysis->state.reachability == PATH_REACHABLE) {
		lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.selection.cases, (LifetimeObject*)control.boundary);
	};
	lifetime_trim(&analysis->state, (LifetimeObject*)control.boundary);
	lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &control.breaks, Token(syntax->token));
	if (!defaults) {
		lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &dispatch, Token(syntax->token));
	};
	@analysis->control := control.parent;
};

fn lifetime_statement(LifetimeAnalysis* analysis, Syntax* syntax) {
	if (!syntax || analysis->state.reachability == PATH_UNREACHABLE || analysis->compiler->result == COMPILATION_FAILURE) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_BLOCK: {
			LifetimeObject* boundary := analysis->state.objects;
			Syntax* statement := syntax->data.statements;
			while (statement && analysis->compiler->result != COMPILATION_FAILURE) {
				lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)statement);
				@statement := statement->next;
			};
			if (analysis->state.reachability == PATH_REACHABLE) {
				lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax, (LifetimeObject*)boundary);
			};
			lifetime_trim(&analysis->state, (LifetimeObject*)boundary);
			break;
		};
		case SYNTAX_DECLARATION:
			if (syntax->entity->kind == ENTITY_VARIABLE) {
				lifetime_enter((LifetimeAnalysis*)analysis, (Entity*)syntax->entity);
				lifetime_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.declaration.body);
			};
			break;
		case SYNTAX_RETURN:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.expression);
			lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax, nullptr);
			@analysis->state.reachability = PATH_UNREACHABLE;
			break;
		case SYNTAX_IF: {
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.branch.condition);
			i32 truth = lifetime_truth((Syntax*)syntax->data.branch.condition);
			LifetimeState incoming = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
			if (!truth) {
				@analysis->state.reachability = PATH_UNREACHABLE;
			};
			lifetime_nested_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.branch.first);
			LifetimeState first := analysis->state;
			@analysis->state = LifetimeState(incoming);
			if (truth == 1) {
				@analysis->state.reachability = PATH_UNREACHABLE;
			};
			lifetime_nested_statement((LifetimeAnalysis*)analysis, (Syntax*)syntax->data.branch.second);
			lifetime_merge((Compiler*)analysis->compiler, &analysis->state, &first, Token(syntax->token));
			break;
		};
		case SYNTAX_FOR:
		case SYNTAX_WHILE:
			lifetime_loop((LifetimeAnalysis*)analysis, (Syntax*)syntax);
			break;
		case SYNTAX_SWITCH:
			lifetime_switch((LifetimeAnalysis*)analysis, (Syntax*)syntax);
			break;
		case SYNTAX_BREAK:
		case SYNTAX_CONTINUE: {
			LifetimeControl* control := analysis->control;
			while (control && syntax->kind == SYNTAX_CONTINUE && control->kind != FLOW_LOOP) {
				@control := control->parent;
			};
			if (!control) {
				return;
			};
			lifetime_cleanup((LifetimeAnalysis*)analysis, (Syntax*)syntax, (LifetimeObject*)control->boundary);
			LifetimeState edge = lifetime_clone((Compiler*)analysis->compiler, &analysis->state);
			lifetime_trim(&edge, (LifetimeObject*)control->boundary);
			if (syntax->kind == SYNTAX_CONTINUE) {
				lifetime_merge((Compiler*)analysis->compiler, &control->continues, &edge, Token(syntax->token));
			}
			else {
				lifetime_merge((Compiler*)analysis->compiler, &control->breaks, &edge, Token(syntax->token));
			};
			@analysis->state.reachability = PATH_UNREACHABLE;
			break;
		};
		default:
			lifetime_expression((LifetimeAnalysis*)analysis, (Syntax*)syntax);
			break;
	};
};

fn lifetime_function(Compiler* compiler, Entity* entity) {
	LifetimeAnalysis analysis;
	@analysis.compiler := compiler;
	@analysis.state.reachability = PATH_REACHABLE;
	Parameter* parameter := entity->data.function.type->data.function.parameters;
	while (parameter) {
		lifetime_enter(&analysis, (Entity*)parameter->entity);
		@parameter := parameter->next;
	};
	lifetime_statement(&analysis, (Syntax*)entity->data.function.body);
	@entity->data.function.lifetime_exit := analysis.state.reachability;
	if (analysis.state.reachability == PATH_REACHABLE) {
		lifetime_cleanup(&analysis, (Syntax*)entity->data.function.body, nullptr);
	};
};

fn semantic_statement(Semantic* semantic, Syntax* syntax) {
	Compiler* compiler := semantic->compiler;
	if (!syntax || compiler->result == COMPILATION_FAILURE) {
		return;
	};
	switch (syntax->kind) {
		case SYNTAX_BLOCK: {
			Scope* outer := semantic->scope;
			if (syntax->scope) {
				@semantic->scope = semantic_scope((Semantic*)semantic, (Scope*)syntax->scope);
				@syntax->scope := semantic->scope;
			};
			Syntax* statement := syntax->data.statements;
			while (statement && compiler->result != COMPILATION_FAILURE) {
				semantic_statement((Semantic*)semantic, (Syntax*)statement);
				@statement := statement->next;
			};
			@semantic->scope = (Scope*)outer;
			break;
		};
		case SYNTAX_DECLARATION:
			if (syntax->entity->kind == ENTITY_VARIABLE) {
				Entity* variable := syntax->entity;
				if (syntax->data.declaration.type) {
					@variable->data.variable.type = type_resolve((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)syntax->data.declaration.type);
				};
				@variable->resolution = RESOLUTION_READY;
				if (!syntax->data.declaration.body && variable->data.variable.type) {
					generated_operation_validate((Semantic*)semantic, (Type*)variable->data.variable.type, DEFAULT_CONSTRUCTION, Token(syntax->token));
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && variable->data.variable.type->kind == TYPE_NAMED && (variable->data.variable.type->data.entity->kind == ENTITY_STRUCT || variable->data.variable.type->data.entity->kind == ENTITY_UNION)) {
					@syntax->data.declaration.constructor = special_select((Semantic*)semantic, (Entity*)variable->data.variable.type->data.entity, CONSTRUCTOR_ROLE, nullptr, Token(syntax->token));
				};
				if (!syntax->data.declaration.body && variable->data.variable.type && type_requires_union_choice((Type*)variable->data.variable.type)) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "automatic union member construction requires an explicit member initializer\0");
					return;
				};
				if (variable->data.variable.type && variable->data.variable.type->kind == TYPE_REFERENCE) {
					reference_initializer((Compiler*)compiler, (Syntax*)syntax->data.declaration.body, (Entity*)variable, Token(syntax->token));
					if (compiler->result == COMPILATION_FAILURE) {
						return;
					};
				}
				else {
					scope_bind((Compiler*)compiler, (Scope*)semantic->scope, (Entity*)variable);
					if (variable->data.variable.type) {
						object_initializer_prepare((Compiler*)compiler, (Scope*)semantic->scope, (Entity*)variable, (Syntax*)syntax->data.declaration.body, Token(syntax->token));
					};
				};
				semantic_statement((Semantic*)semantic, (Syntax*)syntax->data.declaration.body);
				if (variable->data.variable.type && variable->data.variable.type->kind == TYPE_REFERENCE) {
					scope_bind((Compiler*)compiler, (Scope*)semantic->scope, (Entity*)variable);
				};
				if (!variable->data.variable.type || variable->data.variable.type->kind == TYPE_VOID || variable->data.variable.type->kind == TYPE_NULL || variable->data.variable.type->kind == TYPE_FUNCTION) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "variable requires a resolved storage type\0");
				};
				layout_validate((Compiler*)compiler, (Type*)variable->data.variable.type, nullptr, Token(syntax->token));
			}
			else {
				entity_resolve((Compiler*)compiler, (Entity*)syntax->entity);
			};
			break;
		case SYNTAX_RETURN:
			if (!semantic->function) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "return requires a function context\0");
			}
			else {
				Type* result := semantic->function->data.function.type->data.function.result;
				if (syntax->data.expression) {
					semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.expression, (Type*)result);
					if (result->kind != TYPE_REFERENCE) {
						semantic_owned((Semantic*)semantic, (Syntax*)syntax->data.expression);
					};
				}
				else if (result->kind != TYPE_VOID) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "return requires a result value\0");
				};
			};
			break;
		case SYNTAX_IF:
			if (!type_scalar(semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.branch.condition, (Type*)compiler->bool_type))) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "condition requires a scalar value\0");
			};
			Scope* outer := semantic->scope;
			Scope* first = scope_snapshot((Compiler*)compiler, (Scope*)outer);
			@semantic->scope := first;
			semantic_statement((Semantic*)semantic, (Syntax*)syntax->data.branch.first);
			Scope* second = scope_snapshot((Compiler*)compiler, (Scope*)outer);
			@semantic->scope := second;
			semantic_statement((Semantic*)semantic, (Syntax*)syntax->data.branch.second);
			@semantic->scope := outer;
			scope_merge_removals((Compiler*)compiler, (Scope*)outer, (Scope*)first);
			scope_merge_removals((Compiler*)compiler, (Scope*)outer, (Scope*)second);
			break;
		case SYNTAX_FOR:
		case SYNTAX_WHILE: {
			Flow flow;
			@flow.kind = FLOW_LOOP;
			@flow.parent := semantic->flow;
			@semantic->flow = &flow;
			Scope* outer := semantic->scope;
			if (syntax->scope) {
				@semantic->scope = semantic_scope((Semantic*)semantic, (Scope*)syntax->scope);
				@syntax->scope := semantic->scope;
			};
			semantic_statement((Semantic*)semantic, (Syntax*)syntax->data.loop.initializer);
			if (syntax->data.loop.condition) {
				if (!type_scalar(semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.loop.condition, (Type*)compiler->bool_type))) {
					compiler_error((Compiler*)compiler, Token(syntax->token), "condition requires a scalar value\0");
				};
			};
			semantic_statement((Semantic*)semantic, (Syntax*)syntax->data.loop.body);
			if (syntax->data.loop.step) {
				semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.loop.step, nullptr);
			};
			@semantic->scope = (Scope*)outer;
			@semantic->flow := flow.parent;
			break;
		};
		case SYNTAX_SWITCH: {
			Type* type = semantic_expression((Semantic*)semantic, (Syntax*)syntax->data.selection.value, nullptr);
			if (!type_integer((Type*)type)) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "switch requires an integer value\0");
				break;
			};
			selection_validate((Semantic*)semantic, (Syntax*)syntax, (Type*)type);
			Flow flow;
			@flow.kind = FLOW_SWITCH;
			@flow.parent := semantic->flow;
			@semantic->flow = &flow;
			Type* outer := semantic->selection_type;
			@semantic->selection_type = (Type*)type;
			Scope* outer_scope := semantic->scope;
			Scope* merged = scope_snapshot((Compiler*)compiler, (Scope*)outer_scope);
			Scope* branch = scope_snapshot((Compiler*)compiler, (Scope*)outer_scope);
			@semantic->scope := branch;
			Scope* cases = semantic_scope((Semantic*)semantic, (Scope*)syntax->data.selection.cases->scope);
			@syntax->data.selection.cases->scope := cases;
			@semantic->scope := cases;
			Syntax* statement := syntax->data.selection.cases->data.statements;
			while (statement && compiler->result != COMPILATION_FAILURE) {
				if (statement->kind == SYNTAX_CASE) {
					scope_merge_removals((Compiler*)compiler, (Scope*)merged, (Scope*)branch);
					@branch = scope_snapshot((Compiler*)compiler, (Scope*)outer_scope);
					@cases->parent := branch;
				};
				semantic_statement((Semantic*)semantic, (Syntax*)statement);
				@statement := statement->next;
			};
			scope_merge_removals((Compiler*)compiler, (Scope*)merged, (Scope*)branch);
			scope_merge_removals((Compiler*)compiler, (Scope*)outer_scope, (Scope*)merged);
			@semantic->scope = (Scope*)outer_scope;
			@semantic->selection_type = (Type*)outer;
			@semantic->flow := flow.parent;
			break;
		};
		case SYNTAX_CASE:
			if (!semantic->flow || semantic->flow->kind != FLOW_SWITCH) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "case requires a switch context\0");
			};
			if (syntax->data.selection_case.value) {
				constant_integer((Compiler*)compiler, (Scope*)semantic->scope, (Syntax*)syntax->data.selection_case.value);
			};
			break;
		case SYNTAX_BREAK:
		case SYNTAX_CONTINUE: {
			Flow* flow := semantic->flow;
			if (syntax->kind == SYNTAX_CONTINUE) {
				while (flow && flow->kind != FLOW_LOOP) {
					@flow := flow->parent;
				};
			};
			if (!flow) {
				compiler_error((Compiler*)compiler, Token(syntax->token), "flow statement has no enclosing target\0");
			};
			break;
		};
		default:
			semantic_expression((Semantic*)semantic, (Syntax*)syntax, nullptr);
			break;
	};
};

fn LLVMGetVersion(u32* major, u32* minor, u32* patch);

fn backend_initialize(Compiler* compiler) -> i32 {
	Token token;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);
	if (major != 21 || minor != 1 || patch != 0) {
		compiler_error((Compiler*)compiler, Token(token), "LLVM runtime version must be 21.1.0\0");
		return 0;
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@compiler->llvm_context.handle = LLVMContextCreate();
	if (!compiler->llvm_context.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot create LLVM context\0");
		return 0;
	};
	@compiler->llvm_module.handle = LLVMModuleCreateWithNameInContext("rutile\0", (void*)compiler->llvm_context.handle);
	if (!compiler->llvm_module.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot create LLVM module\0");
		return 0;
	};
	@compiler->llvm_builder.handle = LLVMCreateBuilderInContext((void*)compiler->llvm_context.handle);
	if (!compiler->llvm_builder.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot create LLVM builder\0");
		return 0;
	};

	LLVMMessageOwner triple = LLVMMessageOwner(LLVMGetDefaultTargetTriple());
	LLVMMessageOwner message;
	void* target;
	if (!triple.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot obtain LLVM target triple\0");
		return 0;
	};
	if (LLVMGetTargetFromTriple((char*)triple.handle, &target, &message.handle)) {
		compiler_error((Compiler*)compiler, Token(token), (char*)message.handle);
		return 0;
	};

	@compiler->llvm_machine.handle = LLVMCreateTargetMachine((void*)target, (char*)triple.handle, "generic\0", "\0", (i32)compiler->optimization, 2, 0);
	if (!compiler->llvm_machine.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot create LLVM target machine\0");
		return 0;
	};
	@compiler->llvm_layout.handle = LLVMCreateTargetDataLayout((void*)compiler->llvm_machine.handle);
	if (!compiler->llvm_layout.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot create LLVM target data layout\0");
		return 0;
	};
	LLVMMessageOwner layout = LLVMMessageOwner(LLVMCopyStringRepOfTargetData((void*)compiler->llvm_layout.handle));
	if (!layout.handle) {
		compiler_error((Compiler*)compiler, Token(token), "cannot obtain LLVM target data layout\0");
		return 0;
	};
	LLVMSetTarget((void*)compiler->llvm_module.handle, (char*)triple.handle);
	LLVMSetDataLayout((void*)compiler->llvm_module.handle, (char*)layout.handle);
	return compiler->result == COMPILATION_SUCCESS;
};

fn backend_verify(Compiler* compiler) -> i32 {
	LLVMMessageOwner message;
	i32 invalid = LLVMVerifyModule((void*)compiler->llvm_module.handle, 2, &message.handle);
	if (invalid) {
		Token token;
		compiler_error((Compiler*)compiler, $token, (char*)message.handle);
	};
	return !invalid;
};

fn backend_optimize(Compiler* compiler) -> i32 {
	if (!backend_verify((Compiler*)compiler)) {
		return 0;
	};

	char*[4] pipelines {};
	@pipelines[0] = "default<O0>\0";
	@pipelines[1] = "default<O1>\0";
	@pipelines[2] = "default<O2>\0";
	@pipelines[3] = "default<O3>\0";
	LLVMPassOptionsOwner options = LLVMPassOptionsOwner(LLVMCreatePassBuilderOptions());
	if (!options.handle) {
		Token token;
		compiler_error((Compiler*)compiler, $token, "cannot create LLVM pass options\0");
		return 0;
	};
	LLVMPassBuilderOptionsSetVerifyEach((void*)options.handle, 1);
	void* error = LLVMRunPasses((void*)compiler->llvm_module.handle, (char*)pipelines[compiler->optimization], (void*)compiler->llvm_machine.handle, (void*)options.handle);
	if (error) {
		LLVMErrorMessageOwner message = LLVMErrorMessageOwner(LLVMGetErrorMessage((void*)error));
		Token token;
		compiler_error((Compiler*)compiler, $token, (char*)message.handle);
		return 0;
	};

	return backend_verify($compiler);
};

fn backend_publish(Compiler* compiler, char* output_path) -> i32 {
	LLVMMessageOwner message;
	LLVMMemoryBufferOwner buffer;
	if (LLVMTargetMachineEmitToMemoryBuffer((void*)compiler->llvm_machine.handle, (void*)compiler->llvm_module.handle, 1, &message.handle, &buffer.handle)) {
		Token token;
		compiler_error((Compiler*)compiler, $token, (char*)message.handle);
		return 0;
	};

	{
		Token token;
		File file = File((Compiler*)compiler, $output_path, OBJECT_FILE, Token(token));
		if (!file.handle) {
			return 0;
		};
		usize size = LLVMGetBufferSize((void*)buffer.handle);
		usize written = fwrite((void*)LLVMGetBufferStart((void*)buffer.handle), 1, (u64)size, (void*)file.handle);
		if (written != size) {
			compiler_error((Compiler*)compiler, $token, "cannot write native object output\0");
			return 0;
		};
	};
	return compiler->result == COMPILATION_SUCCESS;
};

fn source_read(Compiler* compiler, char* path) -> Source* {
	Source* source = (Source*)memory_allocate((Compiler*)compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};
	@source->path = memory_text((Compiler*)compiler, (char*)path, strlen((char*)path));
	Token token;
	@token.source := source;
	@token.line = 1;
	@token.column = 1;
	char* bytes;
	{
		File file = File((Compiler*)compiler, $path, SOURCE_FILE, Token(token));
		if (!file.handle) {
			return nullptr;
		};
		usize capacity = 4096;
		@bytes = (char*)memory_allocate((Compiler*)compiler, (u64)capacity);
		usize maximum = (usize)(u64)18446744073709551615 / sizeof(Token) - 1;
		char[4096] chunk {};
		while (bytes) {
			usize count = fread((void*)&chunk[0], 1, sizeof(chunk), (void*)file.handle);
			if (!count) {
				break;
			};
			if (count > maximum - source->length) {
				compiler_error((Compiler*)compiler, Token(token), "source exceeds compiler address limits\0");
				break;
			};

			usize required = source->length + count + 1;
			if (required > capacity) {
				usize next_capacity := capacity;
				while (next_capacity < required) {
					if (next_capacity > maximum / 2) {
						@next_capacity = (u64)required;
						break;
					};
					@next_capacity = next_capacity * 2;
				};
				char* next = (char*)memory_allocate((Compiler*)compiler, (u64)next_capacity);
				if (!next) {
					break;
				};
				memcpy((void*)next, (void*)bytes, (u64)source->length);
				@bytes = $next;
				@capacity = $next_capacity;
			};

			memcpy((void*)(bytes + source->length), (void*)&chunk[0], (u64)count);
			@source->length = source->length + count;
		};

		if (ferror((void*)file.handle) || !bytes) {
			compiler_error((Compiler*)compiler, Token(token), "cannot read source\0");
		};
	};
	if (compiler->result == COMPILATION_FAILURE) {
		return nullptr;
	};
	@bytes[source->length] = 0;
	@source->bytes = $bytes;
	return $source;
};

fn backend_clear(Compiler* compiler) {
	Compiler previous = Compiler($compiler);
};

fn rutile_compiler_create() -> Compiler* {
	Compiler value;
	unique_ptr storage = unique_ptr(calloc(1, sizeof(Compiler)));
	if (!unique_ptr::get(storage)) {
		return nullptr;
	};
	memcpy((void*)unique_ptr::get(storage), (void*)&value, sizeof(Compiler));
	discard value;
	return (Compiler*)unique_ptr::release(@storage);
};

fn rutile_compiler_destroy(Compiler* compiler) {
	if (!compiler) {
		return;
	};

	unique_ptr storage = unique_ptr((void*)compiler);
	Compiler previous = Compiler($compiler);
};

fn backend_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics, OutputKind output) -> i32 {
	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};
	if (!compiler) {
		fputs("error: compiler context unavailable\n\0", (void*)diagnostics);
		return 1;
	};

	backend_clear((Compiler*)compiler);
	@compiler->diagnostics = $diagnostics;
	@compiler->open_file = $open_file;
	if (!compiler->open_file) {
		@compiler->open_file = &fopen;
	};
	@compiler->output = $output;
	@compiler->optimization := optimization;
	@compiler->entry = "main\0";
	if (entry) {
		@compiler->entry = memory_text((Compiler*)compiler, (char*)entry, strlen((char*)entry));
	};
	Token token;
	if (optimization < 0 || optimization > 3) {
		compiler_error((Compiler*)compiler, Token(token), "optimization level must be between 0 and 3\0");
	};
	if (!source_paths || !source_count) {
		compiler_error((Compiler*)compiler, Token(token), "no source files\0");
	};
	if (!output_path) {
		compiler_error((Compiler*)compiler, Token(token), "native object output path is required\0");
	};

	usize index = 0;
	Source* last;
	while (index < source_count && compiler->result != COMPILATION_FAILURE) {
		if (!source_paths[index] || !strcmp((char*)source_paths[index], (char*)output_path)) {
			compiler_error((Compiler*)compiler, Token(token), "output cannot overwrite a source file\0");
			break;
		};
		Source* source = source_read((Compiler*)compiler, (char*)source_paths[index]);
		if (!source) {
			break;
		};
		if (last) {
			@last->next := source;
		}
		else {
			@compiler->sources := source;
		};
		@last = $source;
		@index = index + 1;
	};

	if (compiler->result != COMPILATION_FAILURE && backend_initialize((Compiler*)compiler)) {
		compiler_builtins((Compiler*)compiler, (i32)(LLVMPointerSize((void*)compiler->llvm_layout.handle) * 8));
		if (prepare_sources((Compiler*)compiler)) {
			Source* source := compiler->sources;
			Syntax* last_module;
			while (source && compiler->result != COMPILATION_FAILURE) {
				Syntax* module = parse_source((Compiler*)compiler, (Source*)source);
				if (last_module) {
					@last_module->next := module;
				}
				else {
					@compiler->declarations := module;
				};
				@last_module = $module;
				@source := source->next;
			};
		};
	};
	if (compiler->result != COMPILATION_FAILURE) {
		backend_analyze((Compiler*)compiler);
	};
	if (compiler->result != COMPILATION_FAILURE) {
		backend_emit((Compiler*)compiler);
	};
	if (compiler->result != COMPILATION_FAILURE && backend_optimize((Compiler*)compiler)) {
		backend_publish((Compiler*)compiler, (char*)output_path);
	};

	@compiler->diagnostics = nullptr;
	@compiler->open_file = (((char*, char*) -> void*)*)0;
	return (i32)compiler->result;
};

fn rutile_compile(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, char* entry, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile($compiler, $source_paths, $source_count, $output_path, $open_file, $entry, $optimization, $diagnostics, OUTPUT_EXECUTABLE);
};

fn rutile_compile_library(Compiler* compiler, char** source_paths, usize source_count, char* output_path, ((char* path, char* mode) -> void*)* open_file, i32 optimization, void* diagnostics) -> i32 {
	return backend_compile($compiler, $source_paths, $source_count, $output_path, $open_file, nullptr, $optimization, $diagnostics, OUTPUT_LIBRARY);
};



