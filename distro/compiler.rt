fn LLVMBuildAnd(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildOr(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildXor(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFAdd(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFSub(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFMul(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFDiv(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFRem(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildNeg(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildNot(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFNeg(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildTrunc(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildZExt(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildSExt(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFPToUI(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFPToSI(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildUIToFP(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildSIToFP(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFPTrunc(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFPExt(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildPtrToInt(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildIntToPtr(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildBitCast(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, char* name) -> var LLVMOpaqueValue*;

fn LLVMStructTypeInContext(var LLVMOpaqueContext* context, var LLVMOpaqueType var** fields, u32 count, i32 packed) -> var LLVMOpaqueType*;

fn LLVMConstNamedStruct(var LLVMOpaqueType* type, var LLVMOpaqueValue var** values, u32 count) -> var LLVMOpaqueValue*;
fn LLVMConstArray2(var LLVMOpaqueType* type, var LLVMOpaqueValue var** values, u64 count) -> var LLVMOpaqueValue*;

fn LLVMBuildMalloc(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildFree(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* pointer) -> var LLVMOpaqueValue*;
fn LLVMBuildInsertValue(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* aggregate, var LLVMOpaqueValue* element, u32 index, char* name) -> var LLVMOpaqueValue*;

fn LLVMGetEntryBasicBlock(var LLVMOpaqueValue* function) -> var LLVMOpaqueBasicBlock*;
fn LLVMGetFirstInstruction(var LLVMOpaqueBasicBlock* block) -> var LLVMOpaqueValue*;

fn LLVMPositionBuilderBefore(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* instruction);

fn LLVMBuildPtrDiff2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* element, var LLVMOpaqueValue* first, var LLVMOpaqueValue* second, char* name) -> var LLVMOpaqueValue*;
fn LLVMBuildIntCast2(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueType* target, i32 signed_value, char* name) -> var LLVMOpaqueValue*;

fn LLVMGetNextInstruction(var LLVMOpaqueValue* instruction) -> var LLVMOpaqueValue*;

fn LLVMBuildMemCpy(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* destination, u32 destination_alignment, var LLVMOpaqueValue* source, u32 source_alignment, var LLVMOpaqueValue* size) -> var LLVMOpaqueValue*;
fn LLVMBuildSwitch(var LLVMOpaqueBuilder* builder, var LLVMOpaqueValue* value, var LLVMOpaqueBasicBlock* otherwise, u32 count) -> var LLVMOpaqueValue*;

fn LLVMAddCase(var LLVMOpaqueValue* instruction, var LLVMOpaqueValue* value, var LLVMOpaqueBasicBlock* destination);

fn LLVMBuildArrayMalloc(var LLVMOpaqueBuilder* builder, var LLVMOpaqueType* type, var LLVMOpaqueValue* count, char* name) -> var LLVMOpaqueValue*;

fn LLVMABIAlignmentOfType(var LLVMOpaqueTargetData* layout, var LLVMOpaqueType* type) -> u32;

struct ContextDisposer {
	fn dispose(var LLVMOpaqueContext* value);
};

fn ContextDisposer::dispose(var LLVMOpaqueContext* value) {
	if (value) {
		LLVMContextDispose(value);
	};
};

struct ModuleDisposer {
	fn dispose(var LLVMOpaqueModule* value);
};

fn ModuleDisposer::dispose(var LLVMOpaqueModule* value) {
	if (value) {
		LLVMDisposeModule(value);
	};
};

struct BuilderDisposer {
	fn dispose(var LLVMOpaqueBuilder* value);
};

fn BuilderDisposer::dispose(var LLVMOpaqueBuilder* value) {
	if (value) {
		LLVMDisposeBuilder(value);
	};
};

struct MachineDisposer {
	fn dispose(var LLVMOpaqueTargetMachine* value);
};

fn MachineDisposer::dispose(var LLVMOpaqueTargetMachine* value) {
	if (value) {
		LLVMDisposeTargetMachine(value);
	};
};

struct LayoutDisposer {
	fn dispose(var LLVMOpaqueTargetData* value);
};

fn LayoutDisposer::dispose(var LLVMOpaqueTargetData* value) {
	if (value) {
		LLVMDisposeTargetData(value);
	};
};

struct BufferDisposer {
	fn dispose(var LLVMOpaqueMemoryBuffer* value);
};

fn BufferDisposer::dispose(var LLVMOpaqueMemoryBuffer* value) {
	if (value) {
		LLVMDisposeMemoryBuffer(value);
	};
};

struct MessageDisposer {
	fn dispose(var char* value);
};

fn MessageDisposer::dispose(var char* value) {
	if (value) {
		LLVMDisposeMessage(value);
	};
};

struct ErrorMessageDisposer {
	fn dispose(var char* value);
};

fn ErrorMessageDisposer::dispose(var char* value) {
	if (value) {
		LLVMDisposeErrorMessage(value);
	};
};

struct PassOptionsDisposer {
	fn dispose(var LLVMOpaquePassBuilderOptions* value);
};

fn PassOptionsDisposer::dispose(var LLVMOpaquePassBuilderOptions* value) {
	if (value) {
		LLVMDisposePassBuilderOptions(value);
	};
};

struct NativeType {
	Type* source;
	var LLVMOpaqueType* value;
};

struct NativeEntity {
	var Entity* source;
	var LLVMOpaqueValue* value;
	var LLVMOpaqueValue* implementation;
};

struct NativeTable {
	var Entity* source;
	var LLVMOpaqueValue* value;
};

struct Backend {
	fn Backend(var Backend& this, var Diagnostics& diagnostics);

	fn ~Backend(var Backend& this);

	fn initialize(var Backend& this, i32 optimization) -> bool;
	fn emit(var Backend& this, SemanticUnit& unit, rt::string_view& entry, output_kind output) -> bool;
	fn write(var Backend& this, var File& output) -> bool;

	fn pointer_bits(Backend& this) -> u32;
	fn type(var Backend& this, Type* source) -> var LLVMOpaqueType*;
	fn type(var Backend& this, Type* source, Token& origin) -> var LLVMOpaqueType*;
	fn symbol(Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn implementation(Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn table(var Backend& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn field_index(Backend& this, var Entity* entity, usize index) -> u32;

	fn context(Backend& this) -> var LLVMOpaqueContext*;
	fn module(Backend& this) -> var LLVMOpaqueModule*;
	fn builder(Backend& this) -> var LLVMOpaqueBuilder*;
	fn layout(Backend& this) -> var LLVMOpaqueTargetData*;

	fn error(var Backend& this, Token& token, rt::string_view& message) -> bool;
	fn note(var Backend& this, Token& token, rt::string_view& message);
	fn failed(Backend& this) -> bool;

private:
	fn verify(var Backend& this) -> bool;
	fn optimize(var Backend& this) -> bool;

	fn declare(var Backend& this, var Entity* entity) -> bool;
	fn required(Backend& this, var Entity* entity) -> bool;
	fn external_signature(var Backend& this, var Entity* entity) -> bool;

	fn emit_dispatch(var Backend& this, var Entity* entity) -> bool;
	fn dispatch_target(var Backend& this, var Entity* entity, var LLVMOpaqueValue* receiver) -> var LLVMOpaqueValue*;
	fn entry(var Backend& this, var Entity* entity) -> bool;
	fn register_lifecycle(var Backend& this, var LLVMOpaqueValue* function, rt::string_view& name);

	var Diagnostics* diagnostics;
	var Entity* selected_entry;
	i32 optimization;
	rt::unique<LLVMOpaqueContext, ContextDisposer> native_context;
	rt::unique<LLVMOpaqueTargetMachine, MachineDisposer> native_machine;
	rt::unique<LLVMOpaqueModule, ModuleDisposer> native_module;
	rt::unique<LLVMOpaqueBuilder, BuilderDisposer> native_builder;
	rt::unique<LLVMOpaqueTargetData, LayoutDisposer> native_layout;
	rt::buffer<NativeType> types;
	rt::buffer<NativeEntity> entities;
	rt::buffer<NativeTable> tables;
};

fn Backend::Backend(var Backend& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn Backend::~Backend(var Backend& this) {
	@this.native_layout.reset(nullptr);
	@this.native_builder.reset(nullptr);
	@this.native_module.reset(nullptr);
	@this.native_machine.reset(nullptr);
	@this.native_context.reset(nullptr);
};

fn Backend::context(Backend& this) -> var LLVMOpaqueContext* {
	return this.native_context.get();
};

fn Backend::module(Backend& this) -> var LLVMOpaqueModule* {
	return this.native_module.get();
};

fn Backend::builder(Backend& this) -> var LLVMOpaqueBuilder* {
	return this.native_builder.get();
};

fn Backend::layout(Backend& this) -> var LLVMOpaqueTargetData* {
	return this.native_layout.get();
};

fn Backend::failed(Backend& this) -> bool {
	return this.diagnostics->failed();
};

fn Backend::error(var Backend& this, Token& token, rt::string_view& message) -> bool {
	@this.diagnostics->error(token, message);
	return false;
};

fn Backend::pointer_bits(Backend& this) -> u32 {
	if (!this.native_layout.get()) {
		return 0;
	};

	return LLVMPointerSize(this.native_layout.get()) * 8;
};

fn Backend::initialize(var Backend& this, i32 optimization) -> bool {
	Token location;

	if (optimization < 0 || optimization > 3) {
		return @this.error(location, rt::string_view("optimization level must be between 0 and 3", 42));
	};

	@this.optimization = $optimization;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&@major, &@minor, &@patch);

	if (major != 21 || minor != 1 || patch != 0) {
		return @this.error(location, rt::string_view("LLVM runtime version must be 21.1.0", 35));
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.native_context.reset(LLVMContextCreate());

	if (!this.context()) {
		return @this.error(location, rt::string_view("cannot create LLVM context", 26));
	};

	@this.native_module.reset(LLVMModuleCreateWithNameInContext("rutile\0", this.context()));
	@this.native_builder.reset(LLVMCreateBuilderInContext(this.context()));

	if (!this.module() || !this.builder()) {
		return @this.error(location, rt::string_view("cannot create LLVM module or builder", 36));
	};

	var triple = rt::unique<char, MessageDisposer>(LLVMGetDefaultTargetTriple());

	if (!triple.get()) {
		return @this.error(location, rt::string_view("cannot obtain target triple", 27));
	};

	var LLVMTarget* target;
	var char* failure;

	if (LLVMGetTargetFromTriple(triple.get(), &@target, &@failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return @this.error(location, rt::string_view(message.get()));
	};

	@this.native_machine.reset(LLVMCreateTargetMachine(target, triple.get(), "generic\0", "\0", i32(this.optimization), 2, 0));

	if (!this.native_machine.get()) {
		return @this.error(location, rt::string_view("cannot create target machine", 28));
	};

	@this.native_layout.reset(LLVMCreateTargetDataLayout(this.native_machine.get()));

	if (!this.layout()) {
		return @this.error(location, rt::string_view("cannot create target layout", 27));
	};

	var layout = rt::unique<char, MessageDisposer>(LLVMCopyStringRepOfTargetData(this.layout()));

	if (!layout.get()) {
		return @this.error(location, rt::string_view("cannot describe target layout", 29));
	};

	LLVMSetTarget(this.module(), triple.get());
	LLVMSetDataLayout(this.module(), layout.get());

	return true;
};

fn Backend::verify(var Backend& this) -> bool {
	var char* failure;

	if (!LLVMVerifyModule(this.module(), 2, &@failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return true;
	};

	var message = rt::unique<char, MessageDisposer>(failure);
	Token location;

	return @this.error(location, rt::string_view(message.get()));
};

fn Backend::optimize(var Backend& this) -> bool {
	if (!@this.verify()) {
		return false;
	};

	var options = rt::unique<LLVMOpaquePassBuilderOptions, PassOptionsDisposer>(LLVMCreatePassBuilderOptions());
	Token location;

	if (!options.get()) {
		return @this.error(location, rt::string_view("cannot create optimization options", 34));
	};

	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 1);
	rt::string_view pipeline = rt::string_view("default<O0>", 11);

	switch (this.optimization) {
		case 1:
			@pipeline = rt::string_view("default<O1>", 11);
			break;
		case 2:
			@pipeline = rt::string_view("default<O2>", 11);
			break;
		case 3:
			@pipeline = rt::string_view("default<O3>", 11);
			break;
	};

	var native_pipeline = rt::string(pipeline);
	var LLVMOpaqueError* error = LLVMRunPasses(this.module(), native_pipeline.c_str(), this.native_machine.get(), options.get());

	if (error) {
		var message = rt::unique<char, ErrorMessageDisposer>(LLVMGetErrorMessage(error));

		return @this.error(location, rt::string_view(message.get()));
	};

	return @this.verify();
};

fn Backend::write(var Backend& this, var File& output) -> bool {
	if (this.failed() || !@this.optimize()) {
		return false;
	};

	var LLVMOpaqueMemoryBuffer* bytes;
	var char* failure;
	Token location;

	if (LLVMTargetMachineEmitToMemoryBuffer(this.native_machine.get(), this.module(), 1, &@failure, &@bytes)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return @this.error(location, rt::string_view(message.get()));
	};

	var buffer = rt::unique<LLVMOpaqueMemoryBuffer, BufferDisposer>(bytes);

	if (!@output.write(rt::string_view(LLVMGetBufferStart(buffer.get()), LLVMGetBufferSize(buffer.get())))) {
		return @this.error(location, rt::string_view("cannot write native object output", 33));
	};

	return true;
};

fn Backend::note(var Backend& this, Token& token, rt::string_view& message) {
	@this.diagnostics->note(token, message);
};

fn Backend::type(var Backend& this, Type* source) -> var LLVMOpaqueType* {
	Token origin;
	return @this.type(source, origin);
};

fn Backend::type(var Backend& this, Type* source, Token& origin) -> var LLVMOpaqueType* {
	if (!source || this.failed()) {
		return nullptr;
	};

	usize index = 0;

	while (index < this.types.size()) {
		Type* stored = this.types.data()[index].source;

		if (stored == source || (stored->kind() == type_kind::named && source->kind() == type_kind::named && stored->entity() == source->entity())) {
			return this.types.data()[index].value;
		};

		@index = index + 1;
	};

	var LLVMOpaqueType* result;

	switch (source->kind()) {
		case type_kind::void_type:
			@result = LLVMVoidTypeInContext(this.context());
			break;
		case type_kind::boolean:
			@result = LLVMIntTypeInContext(this.context(), 1);
			break;
		case type_kind::character:
			@result = LLVMIntTypeInContext(this.context(), 8);
			break;
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
			@result = LLVMIntTypeInContext(this.context(), source->bits());
			break;
		case type_kind::floating_point:
			@result = LLVMDoubleTypeInContext(this.context());

			if (source->bits() == 32) {
				@result = LLVMFloatTypeInContext(this.context());
			};

			break;
		case type_kind::pointer:
		case type_kind::reference:
			@result = LLVMPointerTypeInContext(this.context(), 0);
			break;
		case type_kind::array: {
			var LLVMOpaqueType* element = @this.type(source->element(), origin);

			if (!element) {
				return nullptr;
			};

			u64 element_size = LLVMABISizeOfType(this.layout(), element);
			u64 maximum = (u64::max) >> (64 - static_cast<u64>(this.pointer_bits()));

			if (element_size && source->count() > maximum / element_size) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("array storage size exceeds target address space for type '", 58));
				diagnostic_type(@message, *source);
				@message.text(rt::string_view("': ", 3));
				@message.number(source->count());
				@message.text(rt::string_view(" elements of ", 13));
				@message.number(element_size);
				@message.text(rt::string_view(" bytes exceed the ", 18));
				@message.number(u64(this.pointer_bits()));
				@message.text(rt::string_view("-bit target limit of ", 21));
				@message.number(maximum);
				@message.text(rt::string_view(" bytes", 6));
				@this.error(origin, message.view());
				return nullptr;
			};

			@result = LLVMArrayType2(element, source->count());
			break;
		};

		case type_kind::function: {
			FunctionSignature& signature = source->signature();
			rt::buffer<var LLVMOpaqueType*> parameters;
			@index = 0;

			while (index < signature.parameters().size()) {
				var LLVMOpaqueType* parameter = @this.type(signature.parameters().data()[index], origin);

				if (!parameter) {
					return nullptr;
				};
				if (!@parameters.push_back(parameter)) {
					Token location;
					@this.error(location, rt::string_view("cannot allocate native signature", 32));
					return nullptr;
				};

				@index = index + 1;
			};

			var LLVMOpaqueType* result_type = @this.type(signature.result(), origin);

			if (!result_type) {
				return nullptr;
			};

			@result = LLVMFunctionType(result_type, (@parameters).data(), static_cast<u32>(parameters.size()), static_cast<i32>(signature.arity() == parameter_arity::variadic));
			break;
		};

		case type_kind::named: {
			var Entity* record = source->entity();

			if (record && record->kind() == entity_kind::enumeration) {
				@result = @this.type(record->underlying(), origin);
				break;
			};

			if (!record || record->kind() != entity_kind::record) {
				Token location;
				@this.error(location, rt::string_view("native named type requires a resolved record", 44));
				return nullptr;
			};

			rt::string name;

			if (!@name.append(record->name())) {
				@this.error(record->token(), rt::string_view("cannot allocate native type name", 32));
				return nullptr;
			};

			@result = LLVMStructCreateNamed(this.context(), name.c_str());
			NativeType native;
			@native.source := source;
			@native.value := result;

			if (!@this.types.push_back($native)) {
				@this.error(record->token(), rt::string_view("cannot retain native type identity", 34));
				return nullptr;
			};

			rt::buffer<var LLVMOpaqueType*> fields;
			@index = 0;

			while (index < record->bases().size()) {
				var LLVMOpaqueType* base = @this.type(record->bases().data()[index], record->token());

				if (!base) {
					return nullptr;
				};
				if (!@fields.push_back(base)) {
					@this.error(record->token(), rt::string_view("cannot allocate native base layout", 34));
					return nullptr;
				};

				@index = index + 1;
			};

			if (record->owns_dispatch() && !@fields.push_back(LLVMPointerTypeInContext(this.context(), 0))) {
				@this.error(record->token(), rt::string_view("cannot allocate native dispatch layout", 38));
				return nullptr;
			};

			@index = 0;

			while (index < record->fields().size()) {
				var LLVMOpaqueType* field = @this.type(record->fields().data()[index]->type(), record->fields().data()[index]->token());

				if (!field) {
					return nullptr;
				};
				if (!@fields.push_back(field)) {
					@this.error(record->token(), rt::string_view("cannot allocate native record layout", 36));
					return nullptr;
				};

				@index = index + 1;
			};

			if (record->layout() == record_layout::overlapping && fields.size()) {
				var LLVMOpaqueType* aligned = fields.data()[0];
				u64 maximum = 0;
				u64 alignment = 1;
				@index = 0;

				while (index < fields.size()) {
					var LLVMOpaqueType* field = fields.data()[index];
					u64 size = LLVMABISizeOfType(this.layout(), field);
					u64 field_alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.layout(), field));

					if (size > maximum) {
						@maximum = size;
					};

					if (field_alignment > alignment) {
						@alignment = field_alignment;
						@aligned = field;
					};

					@index = index + 1;
				};

				@maximum = (maximum + alignment - 1) / alignment * alignment;
				@fields.clear();

				if (!@fields.push_back(aligned)) {
					@this.error(record->token(), rt::string_view("cannot allocate native union layout", 35));
					return nullptr;
				};

				u64 occupied = LLVMABISizeOfType(this.layout(), aligned);

				if (maximum > occupied) {
					var LLVMOpaqueType* padding = LLVMArrayType2(LLVMIntTypeInContext(this.context(), 8), maximum - occupied);

					if (!@fields.push_back(padding)) {
						@this.error(record->token(), rt::string_view("cannot allocate native union padding", 36));
						return nullptr;
					};
				};
			};

			LLVMStructSetBody((var LLVMOpaqueType*(result)), (@fields).data(), static_cast<u32>(fields.size()), 0);

			return result;
		};

		default: {
			Token location;
			@this.error(location, rt::string_view("type has no native representation", 33));
			return nullptr;
		};
	};

	NativeType native;
	@native.source = source;
	@native.value := result;

	if (!@this.types.push_back($native)) {
		Token location;
		@this.error(location, rt::string_view("cannot retain native type identity", 34));
		return nullptr;
	};

	return result;
};

fn Backend::symbol(Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].value;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::declare(var Backend& this, var Entity* entity) -> bool {
	if (!this.required(entity) || this.symbol((var Entity*(entity)))) {
		return true;
	};

	if (!entity->type()) {
		return @this.error(entity->token(), rt::string_view("native declaration has no resolved type", 39));
	};

	if (entity->kind() == entity_kind::function && entity->definition() == function_definition::declaration && !@this.external_signature(entity)) {
		return false;
	};

	rt::string name;
	var spelling = entity->name();

	if (this.selected_entry && spelling == rt::string_view("main", 4)) {
		@spelling = rt::string_view("rt.user.main", 12);

		if (entity == this.selected_entry) {
			@spelling = rt::string_view("rt.entry", 8);
		};
	};

	if (!@name.append(spelling)) {
		return @this.error(entity->token(), rt::string_view("cannot allocate native symbol name", 34));
	};

	if (entity->kind() == entity_kind::function) {
		usize parameter = 0;
		while (parameter < entity->parameters().size()) {
			var Entity* argument = entity->parameters().data()[parameter];
			if (!@this.type(argument->type(), argument->token())) {
				return false;
			};
			@parameter = parameter + 1;
		};
	};
	var LLVMOpaqueType* type = @this.type(entity->type(), entity->token());

	if (!type) {
		return false;
	};

	var LLVMOpaqueValue* value;

	if (entity->kind() == entity_kind::function) {
		@value = LLVMAddFunction(this.module(), name.c_str(), type);
	}
	else {
		@value = LLVMAddGlobal(this.module(), (var LLVMOpaqueType*(type)), name.c_str());
		LLVMSetInitializer((var LLVMOpaqueValue*(value)), LLVMConstNull(type));
	};

	NativeEntity native;
	@native.source = entity;
	@native.value = value;
	@native.implementation = value;

	if (entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary) {
		rt::string wrapper;

		if (!@wrapper.append(rt::string_view("rt.dispatch.", 12)) || !@wrapper.append(name.view())) {
			return @this.error(entity->token(), rt::string_view("cannot allocate dispatch symbol name", 36));
		};

		@native.value = LLVMAddFunction(this.module(), wrapper.c_str(), type);
	};

	if (!@this.entities.push_back($native)) {
		Token location;

		return @this.error(location, rt::string_view("cannot retain native symbol identity", 36));
	};

	return true;
};

fn Backend::required(Backend& this, var Entity* entity) -> bool {
	if (entity->canonical() != entity || (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global)) {
		return false;
	};

	if (entity->kind() == entity_kind::function && (entity->instantiated() || entity->origin() == declaration_origin::compiler_supplied) && entity->body_state() != entity_state::ready) {
		return false;
	};

	return true;
};

fn Backend::external_signature(var Backend& this, var Entity* entity) -> bool {
	FunctionSignature& signature = entity->type()->signature();
	Type* result = signature.result()->representation();

	if (result->kind() == type_kind::array || result->kind() == type_kind::named) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("external aggregate return requires unsupported C ABI lowering for function '", 76));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *entity->type());
		@message.text(rt::string_view("'; result type is '", 19));
		diagnostic_type(@message, *signature.result());
		@message.text(rt::string_view("'", 1));
		return @this.error(entity->token(), message.view());
	};

	usize index = 0;

	while (index < signature.parameters().size()) {
		Type* parameter = signature.parameters().data()[index]->representation();

		if (parameter->kind() == type_kind::array || parameter->kind() == type_kind::named) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("external aggregate parameter requires unsupported C ABI lowering for parameter ", 79));
			@message.number(index + 1);
			@message.text(rt::string_view(" of function '", 14));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *entity->type());
			@message.text(rt::string_view("'; parameter type is '", 22));
			diagnostic_type(@message, *signature.parameters().data()[index]);
			@message.text(rt::string_view("'", 1));
			return @this.error(entity->parameters().data()[index]->token(), message.view());
		};

		@index = index + 1;
	};

	return true;
};

struct NativeBinding {
	var Entity* entity;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
};

struct NativeTemporary {
	var SemanticExpression* expression;
	var LLVMOpaqueValue* address;
	var LLVMOpaqueValue* live;
};

struct NativeAssignment {
	var LLVMOpaqueValue* value;
	var LLVMOpaqueValue* address;
};

struct NativeControl {
	var LLVMOpaqueBasicBlock* leave;
	var LLVMOpaqueBasicBlock* resume;
	var NativeControl* parent;
	usize binding_boundary;
	usize leave_edges;
};

enum native_evaluation : [u08] {
	value;
	address;
};

struct FunctionEmitter {
	fn FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result);

	fn emit(var FunctionEmitter& this, var Entity* function) -> bool;
	fn statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;
	fn value(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address) -> bool;
	fn destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool;
	fn needs_destruction(Type* type) -> bool;

	fn take(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> bool;
	fn initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool;
	fn initialize_value(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* value) -> bool;

	fn finish_expression(var FunctionEmitter& this) -> bool;
	fn copy_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;
	fn move_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;
	fn copy_representation(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;

private:
	fn storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue*;
	fn terminated(FunctionEmitter& this) -> bool;
	fn block(var FunctionEmitter& this, rt::string_view& name) -> var LLVMOpaqueBasicBlock*;

	fn slot(var FunctionEmitter& this, Type* type) -> var LLVMOpaqueValue*;
	fn native_slot(var FunctionEmitter& this, var LLVMOpaqueType* type) -> var LLVMOpaqueValue*;

	fn live_flag(var FunctionEmitter& this) -> var LLVMOpaqueValue*;
	fn set_live(var FunctionEmitter& this, var SemanticExpression* expression, bool live);
	fn remember(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> bool;
	fn temporary(FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn cleanup_temporaries(var FunctionEmitter& this, usize begin) -> bool;
	fn cleanup_bindings(var FunctionEmitter& this, usize begin) -> bool;
	fn guarded_destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* live) -> bool;
	fn forget_temporaries(var FunctionEmitter& this, usize begin);
	fn leave_scope(var FunctionEmitter& this, usize begin) -> bool;

	fn scoped_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;
	fn lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;

	fn generated(var FunctionEmitter& this, var Entity* function) -> bool;
	fn initialize_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool;
	fn initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool;
	fn copy_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;
	fn transfer_elements(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, component_transfer operation) -> bool;
	fn copy_assign(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;
	fn copy_assign_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool;

	fn binding_live(var FunctionEmitter& this, var Entity* entity, bool live);

	fn evaluate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn truth(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* type) -> var LLVMOpaqueValue*;
	fn convert(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* source, Type* target) -> var LLVMOpaqueValue*;
	fn binary(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn assign(var FunctionEmitter& this, var SemanticExpression* expression) -> NativeAssignment;
	fn logical(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;
	fn loop(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;
	fn selection(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;
	fn sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> bool;
	fn validate_switch_item(var FunctionEmitter& this, var SemanticExpression* expression) -> bool;

	fn construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn allocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;
	fn deallocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue*;

	fn destroy_range(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* memory, var LLVMOpaqueValue* count) -> bool;
	fn allocation_prefix(var FunctionEmitter& this, Type* type) -> u64;

	fn representation(Type* type) -> Type*;

	var Backend* backend;
	var LLVMOpaqueValue* function;
	Type* result;
	var NativeControl* active_control;
	rt::buffer<NativeBinding> bindings;
	rt::buffer<NativeTemporary> temporaries;
};

fn FunctionEmitter::FunctionEmitter(var FunctionEmitter& this, var Backend& backend, var LLVMOpaqueValue* function, Type* result) {
	@this.backend = &@backend;
	@this.function = function;
	@this.result = result;
};

fn FunctionEmitter::terminated(FunctionEmitter& this) -> bool {
	var LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());

	return current && LLVMGetBasicBlockTerminator(current) != nullptr;
};

fn FunctionEmitter::block(var FunctionEmitter& this, rt::string_view& name) -> var LLVMOpaqueBasicBlock* {
	var native_name = rt::string(name);
	return LLVMAppendBasicBlockInContext(this.backend->context(), this.function, native_name.c_str());
};

fn FunctionEmitter::bind(var FunctionEmitter& this, var Entity* entity, var LLVMOpaqueValue* address) -> bool {
	NativeBinding binding;
	@binding.entity = entity;
	@binding.address = address;

	if (FunctionEmitter::needs_destruction(entity->type())) {
		@binding.live = @this.live_flag();

		if (!binding.live) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), binding.live);
	};

	if (!@this.bindings.push_back($binding)) {
		Token location;

		return @this.backend->error(location, rt::string_view("cannot retain native local storage", 34));
	};

	return true;
};

fn FunctionEmitter::storage(FunctionEmitter& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].address;
		};
	};

	return this.backend->symbol(entity);
};

fn FunctionEmitter::emit(var FunctionEmitter& this, var Entity* function) -> bool {
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block(rt::string_view("entry", 5)));
	usize index = 0;

	while (index < function->parameters().size()) {
		var Entity* parameter = function->parameters().data()[index];
		var LLVMOpaqueValue* slot = @this.slot(parameter->type());

		if (!slot) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMGetParam(this.function, static_cast<u32>(index)), (var LLVMOpaqueValue*(slot)));

		if (!@this.bind(parameter, slot)) {
			return false;
		};

		@index = index + 1;
	};

	if (function->definition() == function_definition::defaulted) {
		return @this.generated(function);
	};

	if (function->role() == function_role::constructor) {
		Type* type = function->parameters().data()[0]->type()->element();

		if (!@this.initialize_members(type, LLVMGetParam(this.function, 0))) {
			return false;
		};
	};

	if (!@this.statement(function->body())) {
		return false;
	};

	if (this.terminated()) {
		return true;
	};

	if (function->completion() == function_completion::no_fallthrough) {
		LLVMBuildUnreachable(this.backend->builder());

		return true;
	};

	if (this.result->kind() == type_kind::void_type) {
		if (!@this.cleanup_bindings(0)) {
			return false;
		};

		LLVMBuildRetVoid(this.backend->builder());

		return true;
	};

	var message = DiagnosticMessage();
	@message.text(rt::string_view("non-void function reaches the end without a result: '", 53));
	diagnostic_entity(@message, *function);
	@message.text(rt::string_view("' has result type '", 19));
	diagnostic_type(@message, *this.result);
	@message.text(rt::string_view("'", 1));
	return @this.backend->error(function->token(), message.view());
};

fn FunctionEmitter::address(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::name: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueValue* address = this.storage((var Entity*(entity)));

			if (!address) {
				@this.backend->error(expression->token(), rt::string_view("entity has no native storage", 28));
				return nullptr;
			};

			if (entity->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(entity->type()), address, "reference\0");
			};

			return address;
		};

		case semantic_kind::access:
			return @this.address(expression->item(0));
		case semantic_kind::dereference:
			return @this.value(expression->item(0));
		case semantic_kind::call: {
			Type* callable = expression->item(0)->type();

			if (callable->kind() == type_kind::pointer) {
				@callable = callable->element();
			};

			if (callable->signature().result()->kind() == type_kind::reference) {
				return @this.call(expression);
			};

			break;
		};

		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy) {
				var assigned = @this.assign(expression);

				return assigned.address;
			};

			break;
		case semantic_kind::member: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);

			if (!address) {
				return nullptr;
			};

			var LLVMOpaqueValue* field = address;
			Type* owner = expression->entity()->scope()->owner()->type();

			if (owner->entity()->layout() == record_layout::sequential) {
				var LLVMOpaqueType* native = @this.backend->type(owner, expression->token());
				if (!native) {
					return nullptr;
				};
				@field = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(owner->entity(), expression->entity()->index()), "field\0");
			};

			if (expression->entity()->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->entity()->type()), field, "field.reference\0");
			};

			return field;
		};

		case semantic_kind::index: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* index = @this.value(expression->item(1));

			if (!index) {
				return nullptr;
			};

			Type* offset_type = expression->item(1)->type()->representation();
			bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
			@index = LLVMBuildIntCast2(this.backend->builder(), index, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "element.offset\0");

			rt::buffer<var LLVMOpaqueValue*> indices;
			var LLVMOpaqueValue* base;
			Type* element = object->type();

			if (element->kind() == type_kind::array) {
				@base = @this.address(object);

				if (!@indices.push_back(LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 0, 0))) {
					@this.backend->error(expression->token(), rt::string_view("cannot allocate native array indices", 36));
					return nullptr;
				};
			}
			else {
				@base = @this.value(object);
				@element = element->element();
			};

			if (!base) {
				return nullptr;
			};

			if (!@indices.push_back(index)) {
				@this.backend->error(expression->token(), rt::string_view("cannot allocate native array indices", 36));
				return nullptr;
			};

			var LLVMOpaqueType* native = @this.backend->type(element, expression->token());
			if (!native) {
				return nullptr;
			};
			return LLVMBuildGEP2(this.backend->builder(), native, base, (@indices).data(), static_cast<u32>(indices.size()), "element\0");
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				return @this.address(expression->item(0));
			};

			break;
		case semantic_kind::construction:
			if (expression->size() > 1) {
				var LLVMOpaqueValue* storage = @this.address(expression->item(1));

				if (!storage || !@this.construct_into(expression, storage)) {
					return nullptr;
				};

				@this.set_live(expression->item(1), true);

				return storage;
			};

			@this.value(expression);

			return this.temporary(expression);
		case semantic_kind::sequence:
			if (expression->category() == value_category::place) {
				var LLVMOpaqueValue* result;

				if (!@this.sequence(expression, native_evaluation::address, @result)) {
					return nullptr;
				};

				return result;
			};

			break;
	};

	if (expression->category() == value_category::consumable) {
		var LLVMOpaqueValue* value = @this.value(expression);

		if (!value) {
			return nullptr;
		};

		var LLVMOpaqueValue* storage = this.temporary(expression);

		if (storage) {
			return storage;
		};

		@storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		if (!@this.remember(expression, storage)) {
			return nullptr;
		};

		return storage;
	};

	@this.backend->error(expression->token(), rt::string_view("expression does not designate native storage", 44));
	return nullptr;
};

fn FunctionEmitter::call(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* callable = expression->item(0);
	Type* type = callable->type();

	if (type->kind() == type_kind::pointer) {
		@type = type->element();
	};

	if (type->kind() != type_kind::function) {
		@this.backend->error(expression->token(), rt::string_view("call target has no native function signature", 44));
		return nullptr;
	};

	var LLVMOpaqueValue* function = @this.value(callable);

	if (!function) {
		return nullptr;
	};

	FunctionSignature& signature = type->signature();
	var SemanticExpression* source_arguments = expression->item(1);
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < source_arguments->size()) {
		var SemanticExpression* source = source_arguments->item(index);

		if (index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic && !source->type()->representation()->kind().is_scalar()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("aggregate variadic argument ", 28));
			@message.number(u64(index + 1));
			@message.text(rt::string_view(" of type '", 10));
			diagnostic_type(@message, *source->type());
			@message.text(rt::string_view("' requires unsupported C ABI lowering for callable '", 52));
			if (callable->entity()) {
				diagnostic_entity(@message, *callable->entity());
			}
			else {
				diagnostic_type(@message, *type);
			};
			@message.text(rt::string_view("'", 1));
			@this.backend->error(source->token(), message.view());
			return nullptr;
		};

		var LLVMOpaqueValue* argument;

		if (index < signature.parameters().size() && signature.parameters().data()[index]->kind() == type_kind::reference) {
			@argument = @this.address(source);
		}
		else {
			@argument = @this.take(source);

			if (argument && index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic) {
				Type* type = FunctionEmitter::representation(source->type());

				if (type->kind() == type_kind::floating_point && type->bits() == 32) {
					@argument = LLVMBuildFPExt(this.backend->builder(), argument, LLVMDoubleTypeInContext(this.backend->context()), "vararg.float\0");
				}
				else if (type->kind() == type_kind::boolean || type->kind() == type_kind::character || (type->kind().is_integer() && type->bits() < 32)) {
					bool signed_value = type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean;
					@argument = LLVMBuildIntCast2(this.backend->builder(), argument, LLVMIntTypeInContext(this.backend->context(), 32), static_cast<i32>($signed_value), "vararg.integer\0");
				};
			};
		};

		if (!argument) {
			return nullptr;
		};

		if (!@arguments.push_back(argument)) {
			@this.backend->error(expression->token(), rt::string_view("cannot allocate native call arguments", 37));
			return nullptr;
		};

		@index = index + 1;
	};

	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());
	if (!native) {
		return nullptr;
	};
	return LLVMBuildCall2(this.backend->builder(), native, function, (@arguments).data(), static_cast<u32>(arguments.size()), "\0");
};

fn FunctionEmitter::native_slot(var FunctionEmitter& this, var LLVMOpaqueType* native) -> var LLVMOpaqueValue* {
	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		Token location;
		@this.backend->error(location, rt::string_view("cannot create storage builder", 29));
		return nullptr;
	};

	var LLVMOpaqueBasicBlock* entry = LLVMGetEntryBasicBlock(this.function);
	var LLVMOpaqueValue* first = LLVMGetFirstInstruction((var LLVMOpaqueBasicBlock*(entry)));

	if (first) {
		LLVMPositionBuilderBefore(builder.get(), first);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), entry);
	};

	return LLVMBuildAlloca(builder.get(), native, "storage\0");
};

fn FunctionEmitter::needs_destruction(Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return FunctionEmitter::needs_destruction(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return false;
	};

	var Entity* record = type->entity();

	if (record->destructor()) {
		return true;
	};

	usize index = 0;

	while (index < record->bases().size()) {
		if (FunctionEmitter::needs_destruction(record->bases().data()[index])) {
			return true;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn FunctionEmitter::destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool {
	if (!FunctionEmitter::needs_destruction(type)) {
		return true;
	};

	if (type->kind() == type_kind::array) {
		var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
		var LLVMOpaqueValue* count = LLVMConstInt(integer, type->count(), 0);

		return @this.destroy_range(type->element(), address, count);
	};

	var Entity* record = type->entity();
	var Entity* destructor = record->destructor();

	if (!@this.initialize_dispatch(type, address)) {
		return false;
	};

	if (record->layout() == record_layout::overlapping && (!destructor || destructor->definition() == function_definition::defaulted && destructor->origin() == declaration_origin::compiler_supplied)) {
		usize index = 0;

		while (index < record->fields().size()) {
			if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
				var Entity* member = record->fields().data()[index];
				var message = DiagnosticMessage();
				@message.text(rt::string_view("union '", 7));
				diagnostic_entity(@message, *record);
				@message.text(rt::string_view("' requires an explicit destructor because member '", 50));
				diagnostic_entity(@message, *member);
				@message.text(rt::string_view("' of type '", 11));
				diagnostic_type(@message, *member->type());
				@message.text(rt::string_view("' requires destruction", 22));
				@this.backend->error(record->token(), message.view());
				@this.backend->note(member->token(), rt::string_view("member requiring destruction is declared here", 45));
				return false;
			};

			@index = index + 1;
		};
	};

	if (destructor) {
		if (destructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("destruction of '", 16));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' selects deleted destructor '", 30));
			diagnostic_entity(@message, *destructor);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *destructor->type());
			@message.text(rt::string_view("'", 1));
			@this.backend->error(destructor->token(), message.view());
			@this.backend->note(destructor->token(), rt::string_view("destructor is declared deleted here", 35));
			return false;
		};

		var LLVMOpaqueValue*[1] arguments {};
		@arguments[0] = address;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(destructor->type(), destructor->token()), this.backend->symbol(destructor), &@arguments[0], 1, "\0");
	};

	if (record->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = record->fields().size();

	while (index) {
		@index = index - 1;
		var Entity* field = record->fields().data()[index];

		if (FunctionEmitter::needs_destruction(field->type())) {
			var LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type, field->token()), address, this.backend->field_index(record, index), "destroy.field\0");

			if (!@this.destroy(field->type(), member)) {
				return false;
			};
		};
	};

	@index = record->bases().size();

	while (index) {
		@index = index - 1;
		var LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, static_cast<u32>(index), "destroy.base\0");

		if (!@this.destroy(record->bases().data()[index], base)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::slot(var FunctionEmitter& this, Type* type) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return nullptr;
	};

	return @this.native_slot(native);
};

fn FunctionEmitter::live_flag(var FunctionEmitter& this) -> var LLVMOpaqueValue* {
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	var LLVMOpaqueValue* flag = @this.native_slot(boolean);

	if (!flag) {
		return nullptr;
	};

	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		Token location;
		@this.backend->error(location, rt::string_view("cannot create lifetime builder", 30));
		return nullptr;
	};

	var LLVMOpaqueValue* next = LLVMGetNextInstruction(flag);

	if (next) {
		LLVMPositionBuilderBefore(builder.get(), next);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), LLVMGetEntryBasicBlock(this.function));
	};

	LLVMBuildStore(builder.get(), LLVMConstNull(boolean), flag);

	return flag;
};

fn FunctionEmitter::temporary(FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;

		if (this.temporaries.data()[index].expression == expression) {
			return this.temporaries.data()[index].address;
		};
	};

	return nullptr;
};

fn FunctionEmitter::remember(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* address) -> bool {
	NativeTemporary temporary;
	@temporary.expression = expression;
	@temporary.address = address;

	if (FunctionEmitter::needs_destruction(expression->type())) {
		@temporary.live = @this.live_flag();

		if (!temporary.live) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), temporary.live);
	};

	if (!@this.temporaries.push_back($temporary)) {
		return @this.backend->error(expression->token(), rt::string_view("cannot retain a consumable lifetime", 35));
	};

	return true;
};

fn FunctionEmitter::value(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var LLVMOpaqueValue* value = @this.evaluate(expression);

	if (!value) {
		return nullptr;
	};

	if (expression->category() == value_category::consumable && FunctionEmitter::needs_destruction(expression->type()) && !this.temporary(expression)) {
		var LLVMOpaqueValue* storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		if (!@this.remember(expression, storage)) {
			return nullptr;
		};
	};

	return value;
};

fn FunctionEmitter::take(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var LLVMOpaqueValue* value = @this.value(expression);
	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;
		NativeTemporary& temporary = this.temporaries.data()[index];

		if (temporary.expression == expression && temporary.live) {
			LLVMBuildStore(this.backend->builder(), LLVMConstNull(LLVMIntTypeInContext(this.backend->context(), 1)), temporary.live);
			break;
		};
	};

	return value;
};

fn FunctionEmitter::set_live(var FunctionEmitter& this, var SemanticExpression* expression, bool live) {
	if (expression->indirect_storage()) {
		return;
	};

	@this.binding_live(expression->owned_binding(), live);
};

fn FunctionEmitter::binding_live(var FunctionEmitter& this, var Entity* entity, bool live) {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;
		NativeBinding& binding = this.bindings.data()[index];

		if (binding.entity == entity && binding.live) {
			LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), static_cast<u64>(live), 0), binding.live);
			return;
		};
	};
};

fn FunctionEmitter::guarded_destroy(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var LLVMOpaqueValue* live) -> bool {
	if (!live) {
		return true;
	};

	var LLVMOpaqueBasicBlock* destroy = @this.block(rt::string_view("cleanup.destroy", 15));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("cleanup.after", 13));
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), boolean, live, "live\0"), destroy, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);
	LLVMBuildStore(this.backend->builder(), LLVMConstNull(boolean), live);

	if (!@this.destroy(type, address)) {
		return false;
	};

	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::cleanup_temporaries(var FunctionEmitter& this, usize begin) -> bool {
	usize index = this.temporaries.size();

	while (index > begin) {
		@index = index - 1;
		NativeTemporary& temporary = this.temporaries.data()[index];

		if (!@this.guarded_destroy(temporary.expression->type(), temporary.address, temporary.live)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::cleanup_bindings(var FunctionEmitter& this, usize begin) -> bool {
	usize index = this.bindings.size();

	while (index > begin) {
		@index = index - 1;
		NativeBinding& binding = this.bindings.data()[index];

		if (!@this.guarded_destroy(binding.entity->type(), binding.address, binding.live)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::forget_temporaries(var FunctionEmitter& this, usize begin) {
	while (this.temporaries.size() > begin) {
		@this.temporaries.pop_back();
	};
};

fn FunctionEmitter::leave_scope(var FunctionEmitter& this, usize begin) -> bool {
	if (!this.terminated() && !@this.cleanup_bindings(begin)) {
		return false;
	};

	while (this.bindings.size() > begin) {
		@this.bindings.pop_back();
	};

	return true;
};

fn FunctionEmitter::scoped_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	usize begin = this.bindings.size();

	if (!@this.statement(expression)) {
		return false;
	};

	return @this.leave_scope(begin);
};

enum component_transfer : [u08] {
	initialize;
	copy_construct;
	copy_assign;
};

fn FunctionEmitter::initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), address);

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, address, nullptr, component_transfer::initialize);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	var Entity* record = type->entity();
	var Entity* constructor = record->default_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("default construction of '", 25));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' selects deleted function '", 28));
			diagnostic_entity(@message, *constructor);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *constructor->type());
			@message.text(rt::string_view("'", 1));
			@this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), rt::string_view("function is declared deleted here", 33));
			return false;
		};

		var LLVMOpaqueValue*[1] inputs {};
		@inputs[0] = address;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), &@inputs[0], 1, "\0");

		return true;
	};

	return @this.initialize_members(type, address);
};

fn FunctionEmitter::copy_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_construct);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		LLVMBuildStore(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), native, source, "copied\0"), destination);

		return true;
	};

	var Entity* record = type->entity();
	var Entity* constructor = record->copy_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("member copy of '", 16));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' selects deleted function '", 28));
			diagnostic_entity(@message, *constructor);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *constructor->type());
			@message.text(rt::string_view("'", 1));
			@this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), rt::string_view("function is declared deleted here", 33));
			return false;
		};

		var LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = source;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), &@inputs[0], 2, "\0");

		return true;
	};

	return @this.copy_members(type, destination, source);
};

fn FunctionEmitter::move_initialize(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "move.source\0");

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		var Entity* constructor = type->entity()->move_constructor();

		if (constructor->definition() == function_definition::deleted) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("move construction of '", 22));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' selects deleted function '", 28));
			diagnostic_entity(@message, *constructor);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *constructor->type());
			@message.text(rt::string_view("'", 1));
			@this.backend->error(constructor->token(), message.view());
			@this.backend->note(constructor->token(), rt::string_view("function is declared deleted here", 33));
			return false;
		};

		var LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = value;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), &@inputs[0], 2, "\0");

		return true;
	};

	return @this.copy_representation(type, destination, source);
};

fn FunctionEmitter::generated(var FunctionEmitter& this, var Entity* function) -> bool {
	if (!function->parameters().size() || function->parameters().data()[0]->type()->kind() != type_kind::reference) {
		return @this.backend->error(function->token(), rt::string_view("defaulted function requires an object receiver", 46));
	};

	Type* type = function->parameters().data()[0]->type()->element();
	var LLVMOpaqueValue* destination = LLVMGetParam(this.function, 0);

	if (function->role() == function_role::constructor && function->parameters().size() == 1) {
		LLVMBuildStore(this.backend->builder(), LLVMConstNull(@this.backend->type(type, function->token())), destination);

		if (!@this.initialize_members(type, destination)) {
			return false;
		};
	}
	else if (function->role() == function_role::constructor && function->parameters().size() == 2) {
		var Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			var LLVMOpaqueValue* input = LLVMGetParam(this.function, 1);

			if (!@this.copy_members(type, destination, input)) {
				return false;
			};
		}
		else {
			if (!@this.copy_representation(type, destination, this.storage(source))) {
				return false;
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() == function_role::assignment && function->parameters().size() == 2) {
		var Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			if (!@this.copy_assign_members(type, destination, LLVMGetParam(this.function, 1))) {
				return false;
			};
		}
		else {
			if (!@this.destroy(type, destination)) {
				return false;
			};

			if (!@this.move_initialize(type, destination, this.storage(source))) {
				return false;
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() != function_role::destructor) {
		return @this.backend->error(function->token(), rt::string_view("defaulted function role has no native implementation", 52));
	};

	if (!@this.cleanup_bindings(0)) {
		return false;
	};

	if (this.result->kind() == type_kind::void_type) {
		LLVMBuildRetVoid(this.backend->builder());
	}
	else if (this.result->kind() == type_kind::reference) {
		LLVMBuildRet(this.backend->builder(), destination);
	}
	else {
		LLVMBuildRet(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), @this.backend->type(this.result, function->token()), destination, "generated.result\0"));
	};

	return true;
};

fn FunctionEmitter::transfer_elements(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source, component_transfer operation) -> bool {
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block(rt::string_view("array.initialize.test", 21));
	var LLVMOpaqueBasicBlock* body = @this.block(rt::string_view("array.initialize.element", 24));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("array.initialize.after", 22));
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "index\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, LLVMConstInt(integer, type->count(), 0), "within.array\0"), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue*[2] indices {};
	@indices[0] = LLVMConstNull(integer);
	@indices[1] = index;
	var LLVMOpaqueValue* output = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), destination, &@indices[0], 2, "initialize.destination\0");

	if (operation != component_transfer::initialize) {
		var LLVMOpaqueValue* input = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), source, &@indices[0], 2, "initialize.source\0");

		if (operation == component_transfer::copy_assign) {
			if (!@this.copy_assign(type->element(), output, input)) {
				return false;
			};
		}
		else {
			if (!@this.copy_initialize(type->element(), output, input)) {
				return false;
			};
		};
	}
	else {
		if (!@this.initialize(type->element(), output)) {
			return false;
		};
	};

	var LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "next\0");
	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::initialize_value(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address, var SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop) {
		return @this.initialize(type, address);
	};

	if (type->kind() == type_kind::reference) {
		var LLVMOpaqueValue* value = @this.address(expression);

		if (!value) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, address);

		return true;
	};

	if (expression->kind() == semantic_kind::construction && expression->category() == value_category::consumable) {
		return @this.construct_into(expression, address);
	};

	var LLVMOpaqueValue* value = @this.take(expression);

	if (!value) {
		return false;
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		var LLVMOpaqueValue* source = @this.slot(type);

		if (!source) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, source);

		return @this.move_initialize(type, address, source);
	};

	LLVMBuildStore(this.backend->builder(), value, address);

	return true;
};

fn FunctionEmitter::finish_expression(var FunctionEmitter& this) -> bool {
	if (!@this.cleanup_temporaries(0)) {
		return false;
	};

	@this.forget_temporaries(0);

	return true;
};

fn FunctionEmitter::copy_representation(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	if (type->kind() != type_kind::array && (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record)) {
		var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "transfer.value\0");
		LLVMBuildStore(this.backend->builder(), value, destination);

		return true;
	};

	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	var LLVMOpaqueValue* bytes = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 64), size, 0);
	LLVMBuildMemCpy(this.backend->builder(), destination, 0, source, 0, bytes);

	return true;
};

fn FunctionEmitter::initialize_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return true;
	};

	var LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), native, address, static_cast<u32>(index), "initialize.base\0");

		if (!@this.initialize(record->bases().data()[index], base)) {
			return false;
		};

		@index = index + 1;
	};

	if (!@this.initialize_dispatch(type, address)) {
		return false;
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];

		if (field->type()->kind() == type_kind::reference && !field->body()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("reference member '", 18));
			diagnostic_entity(@message, *field);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *field->type());
			@message.text(rt::string_view("' requires an explicit initializer", 34));
			return @this.backend->error(field->token(), message.view());
		};

		var LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(record, index), "initialize.field\0");
		usize temporary_boundary = this.temporaries.size();

		if (!@this.initialize_value(field->type(), member, field->body()) || !@this.cleanup_temporaries(temporary_boundary)) {
			return false;
		};

		@this.forget_temporaries(temporary_boundary);
		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::copy_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	var LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "copy.base.destination\0");
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "copy.base.source\0");

		if (!@this.copy_initialize(record->bases().data()[index], output, input)) {
			return false;
		};

		@index = index + 1;
	};

	if (!@this.initialize_dispatch(type, destination)) {
		return false;
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "copy.field.destination\0");
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "copy.field.source\0");

		if (!@this.copy_initialize(field->type(), output, input)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::copy_assign(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		Token token;

		return @this.backend->error(token, rt::string_view("generated assignment cannot replace a const or reference component", 66));
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_assign);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return @this.copy_initialize(type, destination, source);
	};

	var CopyAssignmentPlan* assignment = type->entity()->copy_assignment();

	if (!assignment) {
		return @this.backend->error(type->entity()->token(), rt::string_view("member copy assignment has no prepared function", 47));
	};

	usize binding_boundary = this.bindings.size();
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* destination_slot = @this.slot(assignment->destination().type());
	var LLVMOpaqueValue* source_slot = @this.slot(assignment->source().type());

	if (!destination_slot || !source_slot) {
		return false;
	};

	LLVMBuildStore(this.backend->builder(), destination, destination_slot);
	LLVMBuildStore(this.backend->builder(), source, source_slot);

	if (!@this.bind(&@assignment->destination(), destination_slot) || !@this.bind(&@assignment->source(), source_slot)) {
		return false;
	};

	if (!@this.value(&@assignment->expression()) || !@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);

	return @this.leave_scope(binding_boundary);
};

fn FunctionEmitter::copy_assign_members(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* destination, var LLVMOpaqueValue* source) -> bool {
	var Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	var LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "assign.base.destination\0");
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "assign.base.source\0");

		if (!@this.copy_assign(record->bases().data()[index], output, input)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		var Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		var LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "assign.field.destination\0");
		var LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "assign.field.source\0");

		if (!@this.copy_assign(field->type(), output, input)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::truth(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* type) -> var LLVMOpaqueValue* {
	if (!value) {
		return nullptr;
	};

	if (type->kind() == type_kind::boolean) {
		return value;
	};

	var LLVMOpaqueValue* zero = LLVMConstNull(@this.backend->type(type));

	if (type->kind() == type_kind::floating_point) {
		return LLVMBuildFCmp(this.backend->builder(), 14, value, zero, "truth\0");
	};

	return LLVMBuildICmp(this.backend->builder(), 33, value, zero, "truth\0");
};

fn FunctionEmitter::convert(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* source, Type* target) -> var LLVMOpaqueValue* {
	if (!value || !source || !target) {
		return nullptr;
	};

	@source = FunctionEmitter::representation(source);
	@target = FunctionEmitter::representation(target);
	var LLVMOpaqueType* native = @this.backend->type(target);

	if (LLVMTypeOf((var LLVMOpaqueValue*(value))) == native) {
		return value;
	};

	if (target->kind() == type_kind::boolean) {
		return @this.truth(value, source);
	};

	if (source->kind() == type_kind::pointer && target->kind() == type_kind::pointer) {
		return value;
	};

	if (source->kind() == type_kind::pointer) {
		return LLVMBuildPtrToInt(this.backend->builder(), value, native, "pointer.integer\0");
	};

	if (target->kind() == type_kind::pointer) {
		return LLVMBuildIntToPtr(this.backend->builder(), value, native, "integer.pointer\0");
	};

	if (source->kind() == type_kind::floating_point) {
		if (target->kind() == type_kind::floating_point) {
			if (source->bits() > target->bits()) {
				return LLVMBuildFPTrunc(this.backend->builder(), value, native, "float.narrow\0");
			};

			return LLVMBuildFPExt(this.backend->builder(), value, native, "float.widen\0");
		};

		if (target->kind() == type_kind::unsigned_integer) {
			return LLVMBuildFPToUI(this.backend->builder(), value, native, "float.unsigned\0");
		};

		return LLVMBuildFPToSI(this.backend->builder(), value, native, "float.signed\0");
	};

	if (target->kind() == type_kind::floating_point) {
		if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
			return LLVMBuildUIToFP(this.backend->builder(), value, native, "unsigned.float\0");
		};

		return LLVMBuildSIToFP(this.backend->builder(), value, native, "signed.float\0");
	};

	u32 source_bits = source->bits();
	u32 target_bits = target->bits();

	if (source->kind() == type_kind::boolean) {
		@source_bits = 1;
	};

	if (source->kind() == type_kind::character) {
		@source_bits = 8;
	};

	if (target->kind() == type_kind::character) {
		@target_bits = 8;
	};

	if (source_bits > target_bits) {
		return LLVMBuildTrunc(this.backend->builder(), value, native, "integer.narrow\0");
	};

	if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
		return LLVMBuildZExt(this.backend->builder(), value, native, "unsigned.widen\0");
	};

	return LLVMBuildSExt(this.backend->builder(), value, native, "signed.widen\0");
};

fn FunctionEmitter::logical(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* left = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* first = @this.truth(@this.value(left), left->type());

	if (!first) {
		return nullptr;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* right = @this.block(rt::string_view("logical.right", 13));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("logical.after", 13));
	u64 immediate = 0;

	if (expression->operation() == token_kind::op_and) {
		LLVMBuildCondBr(this.backend->builder(), first, (var LLVMOpaqueBasicBlock*(right)), (var LLVMOpaqueBasicBlock*(after)));
	}
	else {
		@immediate = 1;
		LLVMBuildCondBr(this.backend->builder(), first, (var LLVMOpaqueBasicBlock*(after)), (var LLVMOpaqueBasicBlock*(right)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), right);
	var SemanticExpression* source = expression->item(1);
	var LLVMOpaqueValue* second = @this.truth(@this.value(source), source->type());

	if (!second) {
		return nullptr;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* last = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	var LLVMOpaqueValue* phi = LLVMBuildPhi(this.backend->builder(), (var LLVMOpaqueType*(boolean)), "logical\0");
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstInt(boolean, $immediate, 0);
	@values[1] = second;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = last;
	LLVMAddIncoming((var LLVMOpaqueValue*(phi)), &@values[0], &@blocks[0], 2);

	return phi;
};

fn FunctionEmitter::binary(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	token_kind operation = expression->operation();

	if (operation == token_kind::op_and || operation == token_kind::op_or) {
		return @this.logical(expression);
	};

	var SemanticExpression* left = expression->item(0);
	var SemanticExpression* right = expression->item(1);

	if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
		var assigned = @this.assign(expression);

		return assigned.value;
	};

	var LLVMOpaqueValue* first = @this.value(left);
	var LLVMOpaqueValue* second = @this.value(right);

	if (!first || !second) {
		return nullptr;
	};

	if ((operation == token_kind::op_plus || operation == token_kind::op_minus) && (left->type()->kind() == type_kind::pointer || right->type()->kind() == type_kind::pointer)) {
		if (left->type()->kind() == type_kind::pointer && right->type()->kind() == type_kind::pointer) {
			var LLVMOpaqueValue* difference = LLVMBuildPtrDiff2(this.backend->builder(), @this.backend->type(left->type()->element()), first, second, "pointer.difference\0");

			return LLVMBuildIntCast2(this.backend->builder(), difference, @this.backend->type(expression->type()), 1, "pointer.distance\0");
		};

		Type* pointer_type = left->type();
		Type* offset_type = right->type();

		if (right->type()->kind() == type_kind::pointer) {
			@pointer_type = right->type();
			@offset_type = left->type();
			var LLVMOpaqueValue* swap = first;
			@first = second;
			@second = swap;
		};

		if (pointer_type->element()->kind() == type_kind::void_type || pointer_type->element()->kind() == type_kind::null_type || pointer_type->element()->kind() == type_kind::function) {
			@this.backend->error(expression->token(), rt::string_view("pointer arithmetic requires an object element type", 50));
			return nullptr;
		};

		bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
		@second = LLVMBuildIntCast2(this.backend->builder(), second, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "pointer.offset\0");

		if (operation == token_kind::op_minus) {
			@second = LLVMBuildNeg(this.backend->builder(), second, "pointer.backward\0");
		};

		var LLVMOpaqueType* native = @this.backend->type(pointer_type->element(), expression->token());
		if (!native) {
			return nullptr;
		};
		return LLVMBuildGEP2(this.backend->builder(), native, first, &@second, 1, "pointer.advance\0");
	};

	Type* operand_type = FunctionEmitter::representation(left->type());
	bool real = operand_type->kind() == type_kind::floating_point;
	bool unsigned_value = operand_type->kind() == type_kind::unsigned_integer || operand_type->kind() == type_kind::boolean || operand_type->kind() == type_kind::pointer;
	var LLVMOpaqueBuilder* builder = this.backend->builder();

	switch (operation) {
		case token_kind::op_plus:
			if (real) {
				return LLVMBuildFAdd(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildAdd(builder, first, second, "arithmetic\0");
		case token_kind::op_minus:
			if (real) {
				return LLVMBuildFSub(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSub(builder, first, second, "arithmetic\0");
		case token_kind::op_star:
			if (real) {
				return LLVMBuildFMul(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildMul(builder, first, second, "arithmetic\0");
		case token_kind::op_slash:
			if (real) {
				return LLVMBuildFDiv(builder, first, second, "arithmetic\0");
			};

			if (unsigned_value) {
				return LLVMBuildUDiv(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSDiv(builder, first, second, "arithmetic\0");
		case token_kind::op_remainder:
			if (real) {
				return LLVMBuildFRem(builder, first, second, "arithmetic\0");
			};

			if (unsigned_value) {
				return LLVMBuildURem(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSRem(builder, first, second, "arithmetic\0");
		case token_kind::op_shift_right:
			if (unsigned_value) {
				return LLVMBuildLShr(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildAShr(builder, first, second, "arithmetic\0");
		case token_kind::op_shift_left:
			return LLVMBuildShl(builder, first, second, "arithmetic\0");
		case token_kind::op_ampersand:
			return LLVMBuildAnd(builder, first, second, "arithmetic\0");
		case token_kind::op_pipe:
			return LLVMBuildOr(builder, first, second, "arithmetic\0");
		case token_kind::op_caret:
			return LLVMBuildXor(builder, first, second, "arithmetic\0");
	};

	i32 predicate = -1;

	switch (operation) {
		case token_kind::op_equal:
			@predicate = 32;

			if (real) {
				@predicate = 1;
			};

			break;
		case token_kind::op_not_equal:
			@predicate = 33;

			if (real) {
				@predicate = 14;
			};

			break;
		case token_kind::op_greater:
			@predicate = 34;

			if (real) {
				@predicate = 2;
			};

			break;
		case token_kind::op_greater_equal:
			@predicate = 35;

			if (real) {
				@predicate = 3;
			};

			break;
		case token_kind::op_less:
			@predicate = 36;

			if (real) {
				@predicate = 4;
			};

			break;
		case token_kind::op_less_equal:
			@predicate = 37;

			if (real) {
				@predicate = 5;
			};

			break;
	};

	if (predicate < 0) {
		@this.backend->error(expression->token(), rt::string_view("operator has no native lowering", 31));
		return nullptr;
	};

	if (real) {
		return LLVMBuildFCmp(builder, $predicate, first, second, "compare\0");
	};

	if (!unsigned_value && predicate >= 34) {
		@predicate = predicate + 4;
	};

	return LLVMBuildICmp(builder, $predicate, first, second, "compare\0");
};

fn FunctionEmitter::representation(Type* type) -> Type* {
	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration) {
		@type = type->entity()->underlying();
	};

	return type;
};

fn FunctionEmitter::assign(var FunctionEmitter& this, var SemanticExpression* expression) -> NativeAssignment {
	NativeAssignment result;
	var LLVMOpaqueValue* value = @this.value(expression->item(1));
	var LLVMOpaqueValue* address = @this.address(expression->item(0));

	if (!address || !value) {
		return $result;
	};

	LLVMBuildStore(this.backend->builder(), value, address);
	@result.value = value;
	@result.address = address;

	return $result;
};

fn FunctionEmitter::evaluate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	var LLVMOpaqueType* type = @this.backend->type(expression->type(), expression->token());

	if (!type) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::sequence: {
			var LLVMOpaqueValue* result;

			if (!@this.sequence(expression, native_evaluation::value, @result)) {
				return nullptr;
			};

			return result;
		};

		case semantic_kind::sizeof_type: {
			Type* queried = expression->item(0)->type();

			if (queried->kind() == type_kind::void_type || queried->kind() == type_kind::null_type || queried->kind() == type_kind::function) {
				@this.backend->error(expression->token(), rt::string_view("size query requires an object type", 34));
				return nullptr;
			};

			var LLVMOpaqueType* native = @this.backend->type(queried, expression->token());
			if (!native) {
				return nullptr;
			};
			return LLVMConstInt(type, LLVMABISizeOfType(this.backend->layout(), native), 0);
		};

		case semantic_kind::literal_integer:
			return LLVMConstInt(type, expression->integer(), 0);
		case semantic_kind::literal_real:
			return LLVMConstReal(type, expression->real());
		case semantic_kind::null_pointer:
			return LLVMConstNull(type);
		case semantic_kind::literal_text: {
			var text = expression->text();
			var LLVMOpaqueValue* bytes = LLVMConstStringInContext2(this.backend->context(), text.data(), text.size(), 1);
			var LLVMOpaqueValue* global = LLVMAddGlobal(this.backend->module(), LLVMTypeOf((var LLVMOpaqueValue*(bytes))), "literal\0");
			LLVMSetInitializer((var LLVMOpaqueValue*(global)), bytes);
			LLVMSetGlobalConstant((var LLVMOpaqueValue*(global)), 1);
			LLVMSetLinkage((var LLVMOpaqueValue*(global)), 9);

			return global;
		};

		case semantic_kind::name: {
			var Entity* entity = expression->entity();

			if (entity->kind() == entity_kind::function) {
				return this.backend->symbol(entity);
			};

			if (entity->kind() == entity_kind::enumerator) {
				return LLVMConstInt(type, entity->integer(), 0);
			};

			var LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0");
		};

		case semantic_kind::access:
		case semantic_kind::dereference:
		case semantic_kind::index:
		case semantic_kind::member: {
			var LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0");
		};

		case semantic_kind::address:
			return @this.address(expression->item(0));
		case semantic_kind::relocation: {
			var LLVMOpaqueValue* storage = @this.address(expression->item(0));

			if (!storage) {
				return nullptr;
			};

			var LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), type, storage, "relocated\0");
			@this.set_live(expression->item(0), false);

			return value;
		};

		case semantic_kind::call: {
			var LLVMOpaqueValue* value = @this.call(expression);

			if (!value) {
				return nullptr;
			};

			Type* signature = expression->item(0)->type();

			if (signature->kind() == type_kind::pointer) {
				@signature = signature->element();
			};

			if (signature->signature().result()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), type, value, "call.reference\0");
			};

			return value;
		};

		case semantic_kind::binary:
			return @this.binary(expression);
		case semantic_kind::unary: {
			var SemanticExpression* operand = expression->item(0);
			var LLVMOpaqueValue* value = @this.value(operand);

			if (!value) {
				return nullptr;
			};

			switch (expression->operation()) {
				case token_kind::op_plus:
					return value;
				case token_kind::op_minus:
					if (expression->type()->kind() == type_kind::floating_point) {
						return LLVMBuildFNeg(this.backend->builder(), value, "negate\0");
					};

					return LLVMBuildNeg(this.backend->builder(), value, "negate\0");
				case token_kind::op_tilde:
					return LLVMBuildNot(this.backend->builder(), value, "complement\0");
				case token_kind::op_bang:
					return LLVMBuildNot(this.backend->builder(), @this.truth(value, operand->type()), "not\0");
			};

			break;
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				var LLVMOpaqueValue* storage = @this.address(expression);

				if (!storage) {
					return nullptr;
				};

				return LLVMBuildLoad2(this.backend->builder(), type, storage, "cast.reference\0");
			};

			return @this.convert(@this.take(expression->item(0)), expression->item(0)->type(), expression->type());
		case semantic_kind::construction:
			return @this.construct(expression);
		case semantic_kind::allocation:
			return @this.allocate(expression);
		case semantic_kind::deallocation: {
			var LLVMOpaqueValue* pointer = @this.value(expression->item(0));

			if (!pointer) {
				return nullptr;
			};

			Type* element = expression->item(0)->type()->element();

			if (FunctionEmitter::needs_destruction(element)) {
				var LLVMOpaqueBasicBlock* destroy = @this.block(rt::string_view("delete.destroy", 14));
				var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("delete.after", 12));
				LLVMBuildCondBr(this.backend->builder(), @this.truth(pointer, expression->item(0)->type()), destroy, after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);

				if (!@this.destroy(element, pointer)) {
					return nullptr;
				};

				var LLVMOpaqueValue* disposed = LLVMBuildFree(this.backend->builder(), pointer);
				LLVMBuildBr(this.backend->builder(), after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), after);

				return disposed;
			};

			return LLVMBuildFree(this.backend->builder(), pointer);
		};

		case semantic_kind::array_deallocation:
			return @this.deallocate_array(expression);
		case semantic_kind::discard_value:
			return @this.take(expression->item(0));
		case semantic_kind::noop:
			return LLVMConstNull(type);
	};

	@this.backend->error(expression->token(), rt::string_view("expression has no implemented native lowering", 45));
	return nullptr;
};

fn FunctionEmitter::conditional(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	var SemanticExpression* condition = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = @this.truth(@this.value(condition), condition->type());

	if (!truth) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* yes = @this.block(rt::string_view("if.yes", 6));
	var LLVMOpaqueBasicBlock* no = @this.block(rt::string_view("if.no", 5));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("if.after", 8));
	LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(yes)), (var LLVMOpaqueBasicBlock*(no)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), yes);

	if (!@this.scoped_statement(expression->item(1))) {
		return false;
	};

	bool yes_returns = this.terminated();

	if (!yes_returns) {
		LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), no);

	if (!@this.scoped_statement(expression->item(2))) {
		return false;
	};

	bool no_returns = this.terminated();

	if (!no_returns) {
		LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (yes_returns && no_returns) {
		LLVMBuildUnreachable(this.backend->builder());
	};

	return true;
};

fn FunctionEmitter::loop(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	usize scope_boundary = this.bindings.size();
	usize condition_index = 0;
	usize body_index = 1;

	if (expression->kind() == semantic_kind::for_loop) {
		if (!@this.statement(expression->item(0))) {
			return false;
		};

		@condition_index = 1;
		@body_index = 3;
	};

	var LLVMOpaqueBasicBlock* test = @this.block(rt::string_view("loop.condition", 14));
	var LLVMOpaqueBasicBlock* body = @this.block(rt::string_view("loop.body", 9));
	var LLVMOpaqueBasicBlock* step = test;

	if (expression->kind() == semantic_kind::for_loop) {
		@step = @this.block(rt::string_view("loop.step", 9));
	};

	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("loop.after", 10));
	LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
	var SemanticExpression* condition = expression->item(condition_index);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* truth = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0);

	if (condition && condition->kind() != semantic_kind::noop) {
		@truth = @this.truth(@this.value(condition), condition->type());
	};

	if (!truth) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);
	LLVMBuildCondBr(this.backend->builder(), truth, (var LLVMOpaqueBasicBlock*(body)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	NativeControl loop;
	@loop.leave := after;
	@loop.resume := step;
	@loop.parent := this.active_control;
	@loop.binding_boundary = this.bindings.size();
	@this.active_control = &@loop;
	bool emitted = @this.scoped_statement(expression->item(body_index));
	@this.active_control := loop.parent;

	if (!emitted) {
		return false;
	};

	if (!this.terminated()) {
		LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(step)));
	};

	if (expression->kind() == semantic_kind::for_loop) {
		LLVMPositionBuilderAtEnd(this.backend->builder(), step);

		if (!@this.statement(expression->item(2))) {
			return false;
		};

		if (!this.terminated()) {
			LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(test)));
		};
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::lower_statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return true;
	};

	if (this.backend->failed()) {
		return false;
	};

	switch (expression->kind()) {
		case semantic_kind::statements: {
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!@this.statement(expression->item(index))) {
					return false;
				};

				@index = index + 1;
			};

			return true;
		};

		case semantic_kind::sequence:
			if (expression->type()->kind() == type_kind::void_type) {
				var LLVMOpaqueValue* result;

				return @this.sequence(expression, native_evaluation::value, @result);
			};

			break;
		case semantic_kind::brace: {
			usize scope_boundary = this.bindings.size();
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!@this.statement(expression->item(index))) {
					return false;
				};

				@index = index + 1;
			};

			return @this.leave_scope(scope_boundary);
		};

		case semantic_kind::variable: {
			var Entity* entity = expression->entity();
			var LLVMOpaqueType* type = @this.backend->type(entity->type(), entity->token());

			if (!type) {
				return false;
			};

			var LLVMOpaqueValue* slot = @this.slot(entity->type());

			if (!slot || !@this.bind((var Entity*(entity)), (var LLVMOpaqueValue*(slot)))) {
				return false;
			};

			return @this.initialize_value(entity->type(), slot, expression->item(0));
		};

		case semantic_kind::return_value: {
			if (this.result->kind() == type_kind::void_type) {
				var SemanticExpression* operand = expression->item(0);

				if (operand && operand->kind() != semantic_kind::noop && !@this.statement(operand)) {
					return false;
				};

				if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(0)) {
					return false;
				};

				LLVMBuildRetVoid(this.backend->builder());

				return true;
			};

			var LLVMOpaqueValue* value;

			if (this.result->kind() == type_kind::reference) {
				@value = @this.address(expression->item(0));
			}
			else {
				@value = @this.take(expression->item(0));
			};

			if (!value) {
				return false;
			};

			if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(0)) {
				return false;
			};

			LLVMBuildRet(this.backend->builder(), value);

			return true;
		};

		case semantic_kind::conditional:
			return @this.conditional(expression);
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);
			var LLVMOpaqueValue* address = @this.address(object);

			if (!address || !@this.destroy(object->type(), address)) {
				return false;
			};

			@this.set_live(object, false);

			return true;
		};

		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(expression);
		case semantic_kind::switch_expression:
			return @this.selection(expression);
		case semantic_kind::break_loop:
		case semantic_kind::continue_loop: {
			var NativeControl* target = this.active_control;

			if (expression->kind() == semantic_kind::continue_loop) {
				while (target && !target->resume) {
					@target = target->parent;
				};
			};

			if (!target) {
				return @this.backend->error(expression->token(), rt::string_view("control transfer has no enclosing native destination", 52));
			};

			if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(target->binding_boundary)) {
				return false;
			};

			if (expression->kind() == semantic_kind::break_loop) {
				@target->leave_edges = target->leave_edges + 1;
				LLVMBuildBr(this.backend->builder(), target->leave);
			}
			else {
				LLVMBuildBr(this.backend->builder(), target->resume);
			};

			return true;
		};
	};

	return @this.value(expression) != nullptr;
};

fn FunctionEmitter::statement(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return true;
	};

	usize begin = this.temporaries.size();

	if (!@this.lower_statement(expression)) {
		return false;
	};

	if (!this.terminated() && !@this.cleanup_temporaries(begin)) {
		return false;
	};

	@this.forget_temporaries(begin);

	return true;
};

fn FunctionEmitter::selection(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	var SemanticExpression* condition = expression->item(0);
	var SemanticExpression* body = expression->item(1);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* value = @this.value(condition);

	if (!value || !@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);

	if (!body) {
		return true;
	};

	if (body->kind() != semantic_kind::brace) {
		return @this.validate_switch_item(body);
	};

	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("switch.after", 12));
	var LLVMOpaqueBasicBlock* otherwise = after;
	rt::buffer<var LLVMOpaqueBasicBlock*> labels;
	usize index = 0;
	u32 count = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);
		var LLVMOpaqueBasicBlock* destination;

		if (item->kind() == semantic_kind::case_label) {
			@destination = @this.block(rt::string_view("switch.case", 11));

			if (item->token().kind == token_kind::kw_default) {
				@otherwise = destination;
			}
			else {
				@count = count + 1;
			};
		}
		else if (!@this.validate_switch_item(item)) {
			return false;
		};

		if (!@labels.push_back(destination)) {
			return @this.backend->error(item->token(), rt::string_view("cannot retain native switch labels", 34));
		};

		@index = index + 1;
	};

	var LLVMOpaqueValue* instruction = LLVMBuildSwitch(this.backend->builder(), value, otherwise, count);
	@index = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label && item->token().kind != token_kind::kw_default) {
			var LLVMOpaqueValue* constant = LLVMConstInt(@this.backend->type(condition->type()), item->integer(), 0);
			LLVMAddCase(instruction, constant, labels.data()[index]);
		};

		@index = index + 1;
	};

	usize scope_boundary = this.bindings.size();
	NativeControl control;
	@control.leave = after;
	@control.parent = this.active_control;
	@control.binding_boundary = scope_boundary;

	if (otherwise == after) {
		@control.leave_edges = 1;
	};

	@this.active_control = &@control;
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block(rt::string_view("switch.unreachable", 18)));
	@index = 0;

	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label) {
			if (!this.terminated()) {
				LLVMBuildBr(this.backend->builder(), labels.data()[index]);
			};

			LLVMPositionBuilderAtEnd(this.backend->builder(), labels.data()[index]);
		}
		else if (!@this.statement(item)) {
			@this.active_control = control.parent;

			return false;
		};

		@index = index + 1;
	};

	@this.active_control = control.parent;

	if (!this.terminated()) {
		@control.leave_edges = control.leave_edges + 1;
		LLVMBuildBr(this.backend->builder(), after);
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (!control.leave_edges) {
		LLVMBuildUnreachable(this.backend->builder());
	};

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::validate_switch_item(var FunctionEmitter& this, var SemanticExpression* expression) -> bool {
	if (expression->kind() == semantic_kind::switch_expression) {
		return true;
	};

	if (expression->kind() == semantic_kind::case_label) {
		return @this.backend->error(expression->token(), rt::string_view("nested case label lowering is not implemented", 45));
	};

	usize index = 0;

	while (index < expression->size()) {
		if (!@this.validate_switch_item(expression->item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::construct(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() > 1) {
		var LLVMOpaqueValue* storage = @this.address(expression);

		if (!storage) {
			return nullptr;
		};

		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "reconstructed\0");
	};

	var LLVMOpaqueValue* storage = @this.slot(expression->type());

	if (!storage || !@this.construct_into(expression, storage) || !@this.remember(expression, storage)) {
		return nullptr;
	};

	return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), storage, "constructed\0");
};

fn FunctionEmitter::construct_into(var FunctionEmitter& this, var SemanticExpression* expression, var LLVMOpaqueValue* storage) -> bool {
	Type* type = expression->type();
	var LLVMOpaqueType* native = @this.backend->type(type, expression->token());

	if (!native) {
		return false;
	};

	var SemanticExpression* arguments = expression->item(0);
	var LLVMOpaqueValue* value = LLVMConstNull(native);
	LLVMBuildStore(this.backend->builder(), value, storage);
	var Entity* constructor = expression->entity();

	if (constructor) {
		rt::buffer<var LLVMOpaqueValue*> inputs;

		if (!@inputs.push_back(storage)) {
			return @this.backend->error(expression->token(), rt::string_view("cannot allocate constructor arguments", 37));
		};

		usize index = 0;

		while (index < arguments->size()) {
			var LLVMOpaqueValue* argument;

			if (constructor->parameters().data()[index + 1]->type()->kind() == type_kind::reference) {
				@argument = @this.address(arguments->item(index));
			}
			else {
				@argument = @this.take(arguments->item(index));
			};

			if (!argument) {
				return false;
			};

			if (!@inputs.push_back(argument)) {
				return @this.backend->error(expression->token(), rt::string_view("cannot allocate constructor arguments", 37));
			};

			@index = index + 1;
		};

		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type(), constructor->token()), this.backend->symbol(constructor), (@inputs).data(), static_cast<u32>(inputs.size()), "\0");

		return true;
	};

	if (!arguments || !arguments->size()) {
		return @this.initialize(type, storage);
	};

	if (type->kind().is_scalar() || (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type))) {
		if (!type->kind().is_scalar() && arguments->item(0)->category() == value_category::place) {
			var LLVMOpaqueValue* source = @this.address(arguments->item(0));

			if (!source) {
				return false;
			};

			return @this.copy_initialize(type, storage, source);
		};

		@value = @this.take(arguments->item(0));

		if (!value) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		return true;
	};

	usize index = 0;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		if (type->entity()->bases().size()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("base aggregate argument initialization is not implemented for type '", 68));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' with argument types (", 23));
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(rt::string_view(", ", 2));
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(rt::string_view(")", 1));
			return @this.backend->error(expression->token(), message.view());
		};

		if (type->entity()->layout() == record_layout::overlapping) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("union aggregate argument selection is not implemented for type '", 64));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' with argument types (", 23));
			usize argument = 0;
			while (argument < arguments->size()) {
				if (argument) {
					@message.text(rt::string_view(", ", 2));
				};
				diagnostic_type(@message, *arguments->item(argument)->type());
				@argument = argument + 1;
			};
			@message.text(rt::string_view(")", 1));
			return @this.backend->error(expression->token(), message.view());
		};

		if (!@this.initialize_dispatch(type, storage)) {
			return false;
		};

		while (index < type->entity()->fields().size()) {
			var Entity* field = type->entity()->fields().data()[index];
			var LLVMOpaqueValue* destination = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(type->entity(), index), "aggregate.field\0");

			if (!@this.initialize_value(field->type(), destination, arguments->item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	while (index < arguments->size()) {
		var LLVMOpaqueValue* element = @this.take(arguments->item(index));

		if (!element) {
			return false;
		};

		@value = LLVMBuildInsertValue(this.backend->builder(), value, element, static_cast<u32>(index), "aggregate\0");
		@index = index + 1;
	};

	LLVMBuildStore(this.backend->builder(), value, storage);

	return true;
};

fn FunctionEmitter::allocate(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	if (expression->size() != 1) {
		return @this.allocate_array(expression);
	};

	Type* element = expression->type()->element();
	var LLVMOpaqueType* type = @this.backend->type(element, expression->token());

	if (!type) {
		return nullptr;
	};

	var LLVMOpaqueValue* pointer = LLVMBuildMalloc(this.backend->builder(), type, "allocation\0");
	var LLVMOpaqueValue* exists = @this.truth((var LLVMOpaqueValue*(pointer)), expression->type());
	var LLVMOpaqueBasicBlock* initialize = @this.block(rt::string_view("new.initialize", 14));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("new.after", 9));
	LLVMBuildCondBr(this.backend->builder(), exists, (var LLVMOpaqueBasicBlock*(initialize)), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);

	if (!@this.construct_into(expression->item(0), pointer)) {
		return nullptr;
	};

	LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return pointer;
};

fn FunctionEmitter::allocation_prefix(var FunctionEmitter& this, Type* type) -> u64 {
	u64 header = static_cast<u64>(this.backend->pointer_bits()) / 8;
	u64 alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.backend->layout(), @this.backend->type(type)));

	return (header + alignment - 1) / alignment * alignment;
};

fn FunctionEmitter::allocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* construction = expression->item(0);

	if (construction->item(0)->size()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("array constructor argument evaluation is not specified for element type '", 73));
		diagnostic_type(@message, *expression->type()->element());
		@message.text(rt::string_view("' with arguments ", 17));
		@message.text(rt::string_view("(", 1));
		usize argument = 0;
		while (argument < construction->item(0)->size()) {
			if (argument) {
				@message.text(rt::string_view(", ", 2));
			};
			diagnostic_type(@message, *construction->item(0)->item(argument)->type());
			@argument = argument + 1;
		};
		@message.text(rt::string_view(")", 1));
		@this.backend->error(expression->token(), message.view());
		return nullptr;
	};

	Type* element = expression->type()->element();
	var LLVMOpaqueType* native = @this.backend->type(element, expression->token());

	if (!native) {
		return nullptr;
	};

	u32 bits = this.backend->pointer_bits();
	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), bits);
	var LLVMOpaqueType* character = LLVMIntTypeInContext(this.backend->context(), 8);
	var SemanticExpression* length = expression->item(1);
	var LLVMOpaqueValue* original = @this.value(length);

	if (!original) {
		return nullptr;
	};

	bool signed_count = length->type()->representation()->kind() == type_kind::signed_integer;
	var LLVMOpaqueValue* count = LLVMBuildIntCast2(this.backend->builder(), original, integer, static_cast<i32>(signed_count), "array.count\0");
	u64 prefix = @this.allocation_prefix(element);
	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	u64 maximum = (u64::max) >> (64 - static_cast<u64>(bits));

	if (prefix > maximum) {
		return LLVMConstNull(@this.backend->type(expression->type(), expression->token()));
	};

	u64 maximum_count = maximum;

	if (size) {
		@maximum_count = (maximum - prefix) / size;
	};

	var LLVMOpaqueValue* checked = count;
	var LLVMOpaqueType* checked_type = integer;

	if (length->type()->representation()->bits() > bits) {
		@checked = original;
		@checked_type = LLVMTypeOf(original);
	};

	var LLVMOpaqueValue* invalid = LLVMBuildICmp(this.backend->builder(), 34, checked, LLVMConstInt(checked_type, maximum_count, 0), "array.overflow\0");

	if (signed_count) {
		var LLVMOpaqueValue* negative = LLVMBuildICmp(this.backend->builder(), 40, original, LLVMConstNull(LLVMTypeOf(original)), "array.negative\0");
		@invalid = LLVMBuildOr(this.backend->builder(), invalid, negative, "array.invalid\0");
	};

	var LLVMOpaqueBasicBlock* allocate = @this.block(rt::string_view("array.allocate", 14));
	var LLVMOpaqueBasicBlock* initialize = @this.block(rt::string_view("array.initialize", 16));
	var LLVMOpaqueBasicBlock* failure = @this.block(rt::string_view("array.failure", 13));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("array.after", 11));
	LLVMBuildCondBr(this.backend->builder(), invalid, failure, allocate);
	LLVMPositionBuilderAtEnd(this.backend->builder(), allocate);
	var LLVMOpaqueValue* bytes = LLVMBuildMul(this.backend->builder(), count, LLVMConstInt(integer, size, 0), "array.bytes\0");
	@bytes = LLVMBuildAdd(this.backend->builder(), bytes, LLVMConstInt(integer, prefix, 0), "array.storage.bytes\0");
	var LLVMOpaqueValue* memory = LLVMBuildArrayMalloc(this.backend->builder(), character, bytes, "array.storage\0");
	var LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, memory, LLVMConstNull(LLVMTypeOf(memory)), "array.exists\0");
	LLVMBuildCondBr(this.backend->builder(), exists, initialize, failure);
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);
	LLVMBuildStore(this.backend->builder(), count, memory);
	var LLVMOpaqueValue* offset = LLVMConstInt(integer, prefix, 0);
	var LLVMOpaqueValue* data = LLVMBuildGEP2(this.backend->builder(), character, memory, &@offset, 1, "array.data\0");
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block(rt::string_view("array.construct.test", 20));
	var LLVMOpaqueBasicBlock* body = @this.block(rt::string_view("array.construct.element", 23));
	var LLVMOpaqueBasicBlock* done = @this.block(rt::string_view("array.construct.done", 20));
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "array.index\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, count, "array.within\0"), body, done);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue* address = LLVMBuildGEP2(this.backend->builder(), native, data, &@index, 1, "array.element\0");

	if (!@this.construct_into(construction, address)) {
		return nullptr;
	};

	var LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "array.next\0");
	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), done);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), failure);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	var LLVMOpaqueValue* result = LLVMBuildPhi(this.backend->builder(), @this.backend->type(expression->type(), expression->token()), "array.result\0");
	@values[0] = data;
	@values[1] = LLVMConstNull(@this.backend->type(expression->type(), expression->token()));
	@blocks[0] = done;
	@blocks[1] = failure;
	LLVMAddIncoming(result, &@values[0], &@blocks[0], 2);

	return result;
};

fn FunctionEmitter::deallocate_array(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* operand = expression->item(0);
	Type* element = operand->type()->element();

	if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::function) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("array deallocation requires a supported object layout for element type '", 72));
		diagnostic_type(@message, *element);
		@message.text(rt::string_view("'", 1));
		@this.backend->error(expression->token(), message.view());
		return nullptr;
	};

	var LLVMOpaqueValue* data = @this.value(operand);

	if (!data) {
		return nullptr;
	};

	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	var LLVMOpaqueBasicBlock* dispose = @this.block(rt::string_view("array.delete", 12));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("array.delete.after", 18));
	LLVMBuildCondBr(this.backend->builder(), @this.truth(data, operand->type()), dispose, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), dispose);
	var LLVMOpaqueValue* offset = LLVMConstInt(integer, 0 - @this.allocation_prefix(element), 1);
	var LLVMOpaqueValue* memory = LLVMBuildGEP2(this.backend->builder(), LLVMIntTypeInContext(this.backend->context(), 8), data, &@offset, 1, "array.base\0");
	var LLVMOpaqueValue* count = LLVMBuildLoad2(this.backend->builder(), integer, memory, "array.count\0");

	if (!@this.destroy_range(element, data, count)) {
		return nullptr;
	};

	var LLVMOpaqueValue* result = LLVMBuildFree(this.backend->builder(), memory);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return result;
};

fn FunctionEmitter::destroy_range(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* memory, var LLVMOpaqueValue* count) -> bool {
	if (!FunctionEmitter::needs_destruction(type)) {
		return true;
	};

	var LLVMOpaqueType* integer = LLVMTypeOf(count);
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* test = @this.block(rt::string_view("array.destroy.test", 18));
	var LLVMOpaqueBasicBlock* body = @this.block(rt::string_view("array.destroy.element", 21));
	var LLVMOpaqueBasicBlock* after = @this.block(rt::string_view("array.destroy.after", 19));
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	var LLVMOpaqueValue* remaining = LLVMBuildPhi(this.backend->builder(), integer, "array.remaining\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 33, remaining, LLVMConstNull(integer), "array.remaining.truth\0"), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	var LLVMOpaqueValue* previous = LLVMBuildSub(this.backend->builder(), remaining, LLVMConstInt(integer, 1, 0), "array.previous\0");
	var LLVMOpaqueValue* element = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), memory, &@previous, 1, "array.destroy.address\0");

	if (!@this.destroy(type, element)) {
		return false;
	};

	var LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	var LLVMOpaqueValue*[2] values {};
	@values[0] = count;
	@values[1] = previous;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(remaining, &@values[0], &@blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::sequence(var FunctionEmitter& this, var SemanticExpression* expression, native_evaluation form, var LLVMOpaqueValue var*& result) -> bool {
	usize bindings = this.bindings.size();
	usize temporaries = this.temporaries.size();

	if (!@this.statement(expression->item(0)) || !@this.statement(expression->item(1))) {
		return false;
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), rt::string_view("control transfer within a sequence initializer is not implemented", 65));
	};

	var SemanticExpression* yielded = expression->item(2);

	if (expression->type()->kind() == type_kind::void_type) {
		if (!@this.statement(yielded)) {
			return false;
		};
	}
	else if (form == native_evaluation::address) {
		@result = @this.address(yielded);
	}
	else if (yielded->category() == value_category::consumable) {
		@result = @this.take(yielded);
	}
	else {
		@result = @this.value(yielded);
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), rt::string_view("control transfer within a sequence yield is not implemented", 59));
	};

	if (expression->type()->kind() != type_kind::void_type && !result) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporaries) || !@this.leave_scope(bindings)) {
		return false;
	};

	@this.forget_temporaries(temporaries);

	return true;
};

fn Backend::implementation(Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].implementation;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::field_index(Backend& this, var Entity* entity, usize index) -> u32 {
	return static_cast<u32>(entity->bases().size() + static_cast<usize>(entity->owns_dispatch()) + index);
};

fn Backend::table(var Backend& this, var Entity* entity) -> var LLVMOpaqueValue* {
	usize index = 0;

	while (index < this.tables.size()) {
		if (this.tables.data()[index].source == entity) {
			return this.tables.data()[index].value;
		};

		@index = index + 1;
	};

	rt::buffer<var LLVMOpaqueValue*> functions;
	@index = 0;

	while (index < entity->virtual_functions().size()) {
		var Entity* function = entity->virtual_functions().data()[index];
		var LLVMOpaqueValue* implementation = this.implementation(function);

		if (!implementation) {
			@this.error(function->token(), rt::string_view("virtual implementation has no prepared native declaration", 57));
			return nullptr;
		};

		if (!@functions.push_back(implementation)) {
			@this.error(function->token(), rt::string_view("cannot retain native virtual implementations", 44));
			return nullptr;
		};

		@index = index + 1;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* contents = LLVMConstArray2(pointer, (@functions).data(), functions.size());
	var LLVMOpaqueValue* value = LLVMAddGlobal(this.module(), LLVMTypeOf(contents), "rt.vtable\0");
	LLVMSetInitializer(value, contents);
	LLVMSetGlobalConstant(value, 1);
	LLVMSetLinkage(value, 9);
	NativeTable table;
	@table.source = entity;
	@table.value = value;

	if (!@this.tables.push_back($table)) {
		@this.error(entity->token(), rt::string_view("cannot retain native virtual table", 34));
		return nullptr;
	};

	return value;
};

fn Backend::dispatch_target(var Backend& this, var Entity* entity, var LLVMOpaqueValue* receiver) -> var LLVMOpaqueValue* {
	var Entity* owner = entity->scope()->owner()->virtual_owner();

	if (!owner || !receiver) {
		@this.error(entity->token(), rt::string_view("virtual dispatch has no owning receiver layout", 46));
		return nullptr;
	};

	var LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.builder(), @this.type(owner->type()), receiver, static_cast<u32>(owner->bases().size()), "dispatch.header\0");
	var LLVMOpaqueValue* table = LLVMBuildLoad2(this.builder(), pointer, header, "dispatch.table\0");
	var LLVMOpaqueValue* index = LLVMConstInt(LLVMIntTypeInContext(this.context(), this.pointer_bits()), entity->virtual_slot(), 0);
	var LLVMOpaqueValue* slot = LLVMBuildGEP2(this.builder(), pointer, table, &@index, 1, "dispatch.slot\0");

	return LLVMBuildLoad2(this.builder(), pointer, slot, "dispatch.target\0");
};

fn Backend::emit_dispatch(var Backend& this, var Entity* entity) -> bool {
	FunctionSignature& signature = entity->type()->signature();

	if (!signature.parameters().size() || signature.parameters().data()[0]->kind() != type_kind::reference || signature.arity() == parameter_arity::variadic) {
		return @this.error(entity->token(), rt::string_view("virtual dispatch requires a fixed signature with an object receiver", 67));
	};

	var LLVMOpaqueValue* function = this.symbol(entity);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), function, "entry\0"));
	rt::buffer<var LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < signature.parameters().size()) {
		if (!@arguments.push_back(LLVMGetParam(function, static_cast<u32>(index)))) {
			return @this.error(entity->token(), rt::string_view("cannot retain virtual call arguments", 36));
		};

		@index = index + 1;
	};

	var LLVMOpaqueValue* target = @this.dispatch_target(entity, arguments.data()[0]);

	if (!target) {
		return false;
	};

	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), target, (@arguments).data(), static_cast<u32>(arguments.size()), "\0");

	if (signature.result()->kind() == type_kind::void_type) {
		LLVMBuildRetVoid(this.builder());
	}
	else {
		LLVMBuildRet(this.builder(), result);
	};

	return true;
};

fn FunctionEmitter::initialize_dispatch(var FunctionEmitter& this, Type* type, var LLVMOpaqueValue* address) -> bool {
	var Entity* record = type->entity();
	var Entity* owner = record->virtual_owner();

	if (!owner) {
		return true;
	};

	var LLVMOpaqueValue* table = @this.backend->table(record);

	if (!table) {
		return false;
	};

	var LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(owner->type()), address, static_cast<u32>(owner->bases().size()), "initialize.dispatch\0");
	LLVMBuildStore(this.backend->builder(), table, header);

	return true;
};

fn Backend::entry(var Backend& this, var Entity* entity) -> bool {
	FunctionSignature& signature = entity->type()->signature();

	if (signature.parameters().size() || (signature.result()->kind() != type_kind::void_type && !signature.result()->kind().is_integer())) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("executable entry '", 18));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' requires no parameters and an integer or void result; declared signature is '", 79));
		diagnostic_type(@message, *entity->type());
		@message.text(rt::string_view("'", 1));
		return @this.error(entity->token(), message.view());
	};

	var LLVMOpaqueType* integer = LLVMIntTypeInContext(this.context(), 32);
	var LLVMOpaqueType* type = LLVMFunctionType((var LLVMOpaqueType*(integer)), nullptr, 0, 0);
	var LLVMOpaqueValue* main = LLVMAddFunction(this.module(), "main\0", type);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), main, "entry\0"));
	var LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), this.symbol(entity), nullptr, 0, "\0");

	if (signature.result()->kind() == type_kind::void_type) {
		@result = LLVMConstInt(integer, 0, 0);
	}
	else if (@this.type(signature.result()) != integer) {
		u32 bits = signature.result()->bits();

		if (signature.result()->kind() == type_kind::boolean) {
			@bits = 1;
		};

		if (signature.result()->kind() == type_kind::character) {
			@bits = 8;
		};

		if (bits > 32) {
			@result = LLVMBuildTrunc(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0");
		}
		else if (signature.result()->kind() == type_kind::unsigned_integer || signature.result()->kind() == type_kind::boolean) {
			@result = LLVMBuildZExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0");
		}
		else {
			@result = LLVMBuildSExt(this.builder(), (var LLVMOpaqueValue*(result)), integer, "entry.result\0");
		};
	};

	LLVMBuildRet(this.builder(), result);

	return true;
};

fn Backend::emit(var Backend& this, SemanticUnit& unit, rt::string_view& entry, output_kind output) -> bool {
	if (output == output_kind::executable) {
		var Entity* selected = unit.root_scope()->lookup(entry);

		if (!selected || selected->kind() != entity_kind::function || !selected->body() || selected->body()->kind() == semantic_kind::noop) {
			Token location;
			var message = DiagnosticMessage();
			@message.text(rt::string_view("executable entry ", 17));
			@message.quoted(entry);
			@message.text(rt::string_view(" requires a defined function; ", 30));
			if (!selected) {
				@message.text(rt::string_view("the requested name is not declared", 34));
			}
			else {
				@location = selected->token();
				@message.text(rt::string_view("selected declaration is ", 24));
				diagnostic_entity_kind(@message, selected->kind());
				@message.text(rt::string_view(" '", 2));
				diagnostic_entity(@message, *selected);
				@message.text(rt::string_view("'", 1));
				if (selected->kind() == entity_kind::function) {
					@message.text(rt::string_view(" of type '", 10));
					diagnostic_type(@message, *selected->type());
					@message.text(rt::string_view("' without a definition", 22));
				};
			};
			return @this.error(location, message.view());
		};

		@this.selected_entry = selected->canonical();
	};

	usize index = 0;

	while (index < unit.entities().size()) {
		if (!@this.declare(unit.entities().data()[index].get())) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			var emitter = FunctionEmitter(@this, this.implementation(entity), entity->type()->signature().result());

			if (!@emitter.emit(entity)) {
				return false;
			};
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary && !@this.emit_dispatch(entity)) {
			return false;
		};

		@index = index + 1;
	};

	var LLVMOpaqueValue* initialize;
	@index = 0;

	while (index < unit.entities().size()) {
		var Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && entity->kind() == entity_kind::global) {
			if (!initialize) {
				@initialize = LLVMAddFunction(this.module(), "rt.initialize\0", LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage((var LLVMOpaqueValue*(initialize)), 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), (var LLVMOpaqueValue*(initialize)), "entry\0"));
			};

			var emitter = FunctionEmitter(@this, (var LLVMOpaqueValue*(initialize)), nullptr);

			if (!@emitter.initialize_value(entity->type(), this.symbol(entity), entity->body()) || !@emitter.finish_expression()) {
				return false;
			};
		};

		@index = index + 1;
	};

	if (initialize) {
		LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(initialize, rt::string_view("llvm.global_ctors", 17));
	};

	var LLVMOpaqueValue* finalize;
	@index = unit.entities().size();

	while (index) {
		@index = index - 1;
		var Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && entity->kind() == entity_kind::global && FunctionEmitter::needs_destruction(entity->type())) {
			if (!finalize) {
				@finalize = LLVMAddFunction(this.module(), "rt.finalize\0", LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage(finalize, 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), finalize, "entry\0"));
			};

			var emitter = FunctionEmitter(@this, finalize, nullptr);

			if (!@emitter.destroy(entity->type(), this.symbol(entity))) {
				return false;
			};
		};
	};

	if (finalize) {
		LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(finalize, rt::string_view("llvm.global_dtors", 17));
	};

	if (output == output_kind::executable) {
		if (!@this.entry(this.selected_entry)) {
			return false;
		};
	};

	return @this.verify();
};

fn Backend::register_lifecycle(var Backend& this, var LLVMOpaqueValue* function, rt::string_view& name) {
	var LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(this.context(), 32);
	@fields[1] = LLVMPointerTypeInContext(this.context(), 0);
	@fields[2] := fields[1];
	var LLVMOpaqueType* record = LLVMStructTypeInContext(this.context(), &@fields[0], 3, 0);
	var LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt((var LLVMOpaqueType*(fields[0])), 65535, 0);
	@values[1] = function;
	@values[2] = LLVMConstNull((var LLVMOpaqueType*(fields[2])));
	var LLVMOpaqueValue*[1] records {};
	@records[0] = LLVMConstNamedStruct((var LLVMOpaqueType*(record)), &@values[0], 3);
	var native_name = rt::string(name);
	var LLVMOpaqueValue* global = LLVMAddGlobal(this.module(), LLVMArrayType2((var LLVMOpaqueType*(record)), 1), native_name.c_str());
	LLVMSetInitializer(global, LLVMConstArray2(record, &@records[0], 1));
	LLVMSetLinkage(global, 7);
};

struct EditorTemplateSelection {
	rt::string path;
	usize anchor;
	rt::string arguments;
	SourceFile input;
	rt::unique<Syntax> syntax;
	rt::string label;
};

struct Analysis {
	fn Analysis(var Analysis& this) : [default];
	fn Analysis(var Analysis& this, var NativeFile* output);

	fn add_source(var Analysis& this, rt::string_view& path, rt::string_view& text) -> bool;
	fn load_source(var Analysis& this, rt::string_view& path, FileOpener opener) -> bool;
	fn analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> bool;
	fn request_template_context(var Analysis& this, rt::string_view& path, usize anchor, rt::string_view& arguments) -> bool;
	fn template_context_label(Analysis& this) -> rt::string_view;
	fn analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> bool;

	fn source_count(Analysis& this) -> usize;
	fn source_path(Analysis& this, usize index) -> rt::string_view;
	fn syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>&;
	fn source_tokens(Analysis& this, usize index) -> rt::buffer<Token>*;
	fn primitive_name(Analysis& this, rt::string_view& name) -> bool;
	fn source_text(Analysis& this, usize index) -> rt::string_view;
	fn semantics(Analysis& this) -> SemanticUnit*;
	fn diagnostics(Analysis& this) -> Diagnostics&;
	fn navigation(Analysis& this) -> NavigationIndex&;
	fn pointer_bits(Analysis& this) -> u32;

private:
	fn analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> bool;

	rt::unique<EditorTemplateSelection> template_selection;
	SourceManager sources;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax;
	rt::unique<SemanticUnit> semantic_unit;
	Diagnostics messages;
	NavigationIndex index;
	u32 target_pointer_bits;
};

fn Analysis::Analysis(var Analysis& this, var NativeFile* output) {
	@this.messages = Diagnostics($output);
};

fn Analysis::add_source(var Analysis& this, rt::string_view& path, rt::string_view& text) -> bool {
	var SourceFile* source = @this.sources.add(path, text);
	return source && @this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::load_source(var Analysis& this, rt::string_view& path, FileOpener opener) -> bool {
	var reader = SourceReader($opener, @this.sources, @this.messages);
	var SourceFile* source = @reader.load(path);
	return source && @this.index.register_source(@*source, this.sources.count() - 1);
};

fn Analysis::source_count(Analysis& this) -> usize {
	return this.sources.count();
};

fn Analysis::source_path(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->path();
};

fn Analysis::source_text(Analysis& this, usize index) -> rt::string_view {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return rt::string_view();
	};
	return source->text();
};

fn Analysis::semantics(Analysis& this) -> SemanticUnit* {
	return this.semantic_unit.get();
};

fn Analysis::diagnostics(Analysis& this) -> Diagnostics& {
	return this.messages;
};

fn Analysis::navigation(Analysis& this) -> NavigationIndex& {
	return this.index;
};

fn Analysis::pointer_bits(Analysis& this) -> u32 {
	return this.target_pointer_bits;
};

fn Analysis::source_tokens(Analysis& this, usize index) -> rt::buffer<Token>* {
	SourceFile* source = this.sources.at($index);
	if (!source) {
		return nullptr;
	};
	return &@source->tokens();
};

fn Analysis::primitive_name(Analysis& this, rt::string_view& name) -> bool {
	return this.types.find_primitive(name) != nullptr;
};

fn Analysis::syntax_roots(Analysis& this) -> rt::buffer<rt::unique<Syntax>>& {
	return this.syntax;
};

fn Analysis::request_template_context(var Analysis& this, rt::string_view& path, usize anchor, rt::string_view& arguments) -> bool {
	var selection = rt::unique<EditorTemplateSelection>::make();
	if (!selection.get()) {
		return false;
	};
	@selection.get()->path = rt::string(path);
	@selection.get()->anchor = $anchor;
	@selection.get()->arguments = rt::string(arguments);
	@this.template_selection = $selection;
	return true;
};

fn Analysis::template_context_label(Analysis& this) -> rt::string_view {
	if (!this.template_selection.get()) {
		return rt::string_view();
	};
	return this.template_selection.get()->label.view();
};

struct RuntimeMutex;
fn runtime_mutex_create() -> var RuntimeMutex*;
fn runtime_mutex_destroy(var RuntimeMutex* mutex);
fn runtime_mutex_lock(var RuntimeMutex* mutex);
fn runtime_mutex_unlock(var RuntimeMutex* mutex);

struct Compiler;

enum analysis_publication : [u08] {
	published;
	obsolete;
	unavailable;
};

struct PublishedAnalysis {
	rt::unique<Analysis> analysis;
	usize readers;
	u64 revision;
};

struct TargetAnalysis {
	rt::string key;
	u64 expected_revision;
	rt::unique<PublishedAnalysis> published;
};

struct AnalysisLease {
	fn AnalysisLease(var AnalysisLease& this) : [default];
	fn AnalysisLease(var AnalysisLease& this, AnalysisLease& other) : [delete];
	fn operator=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn operator:=(var AnalysisLease& this, AnalysisLease& other) -> var AnalysisLease& : [delete];
	fn AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry);
	fn ~AnalysisLease(var AnalysisLease& this);

	fn get(AnalysisLease& this) -> Analysis*;
	fn value(AnalysisLease& this) -> Analysis&;
	fn revision(AnalysisLease& this) -> u64;

private:
	var Compiler* owner;
	var PublishedAnalysis* entry;
};

struct Compilation {
	fn Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output);
	fn run(var Compilation& this, rt::string_view& output_path, rt::string_view& entry, i32 optimization, output_kind kind) -> i32;

private:
	Analysis* analysis;
	FileOpener opener;
	Diagnostics diagnostics;
	rt::unique<Backend> backend;

	fn failure(var Compilation& this, rt::string_view& message) -> i32;
	fn output_failure(var Compilation& this, rt::string_view& operation, rt::string_view& path) -> i32;
};

struct Compiler {
	fn Compiler(var Compiler& this);
	fn ~Compiler(var Compiler& this);

	fn expect_target(var Compiler& this, rt::string_view& key, u64 revision) -> bool;
	fn publish_target(var Compiler& this, rt::string_view& key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication;
	fn acquire_target(var Compiler& this, rt::string_view& key) -> AnalysisLease;
	fn acquire_current_target(var Compiler& this, rt::string_view& key) -> AnalysisLease;
	fn emit_target(var Compiler& this, rt::string_view& key, rt::string_view& output_path, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;

	fn publish(var Compiler& this, rt::unique<Analysis> analysis) -> bool;
	fn acquire_analysis(var Compiler& this) -> AnalysisLease;
	fn release_analysis(var Compiler& this, var PublishedAnalysis& entry);
	fn emit_current(var Compiler& this, rt::string_view& output_path, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;
	fn compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view& output_path, FileOpener opener, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32;

private:
	fn collect_retired(var Compiler& this);

	var RuntimeMutex* publication_mutex;
	rt::unordered_map<rt::string_view, rt::unique<TargetAnalysis>> targets;
	rt::buffer<rt::unique<PublishedAnalysis>> retired;
};

fn AnalysisLease::AnalysisLease(var AnalysisLease& this, var Compiler& owner, var PublishedAnalysis* entry) {
	@this.owner = &@owner;
	@this.entry = $entry;
};

fn AnalysisLease::~AnalysisLease(var AnalysisLease& this) {
	if (this.owner && this.entry) {
		@this.owner->release_analysis(@*this.entry);
	};
};

fn AnalysisLease::get(AnalysisLease& this) -> Analysis* {
	if (!this.entry) {
		return nullptr;
	};

	return this.entry->analysis.get();
};

fn AnalysisLease::value(AnalysisLease& this) -> Analysis& {
	return *this.get();
};

fn Compiler::Compiler(var Compiler& this) {
	@this.publication_mutex = runtime_mutex_create();
};

fn Compiler::~Compiler(var Compiler& this) {
	runtime_mutex_destroy(this.publication_mutex);
};

fn AnalysisLease::revision(AnalysisLease& this) -> u64 {
	if (!this.entry) {
		return 0;
	};

	return this.entry->revision;
};

fn Compiler::expect_target(var Compiler& this, rt::string_view& key, u64 revision) -> bool {
	if (!this.publication_mutex) {
		return false;
	};

	var fresh = rt::unique<TargetAnalysis>::make();
	if (!fresh.get() || !@fresh.get()->key.append(key)) {
		return false;
	};
	@fresh.get()->expected_revision = revision;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (found) {
		if (revision < found->get()->expected_revision) {
			runtime_mutex_unlock(this.publication_mutex);
			return false;
		};
		@found->get()->expected_revision = revision;
		runtime_mutex_unlock(this.publication_mutex);
		return true;
	};

	var owned_key = fresh.get()->key.view();
	bool inserted = @this.targets.insert(owned_key, $fresh);
	runtime_mutex_unlock(this.publication_mutex);
	return $inserted;
};

fn Compiler::publish_target(var Compiler& this, rt::string_view& key, u64 revision, rt::unique<Analysis> analysis) -> analysis_publication {
	if (!this.publication_mutex || !analysis.get()) {
		return analysis_publication::unavailable;
	};

	var next = rt::unique<PublishedAnalysis>::make();
	if (!next.get()) {
		return analysis_publication::unavailable;
	};
	@next.get()->analysis = $analysis;
	@next.get()->revision = revision;

	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	if (!found) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::unavailable;
	};

	var TargetAnalysis* target = found->get();
	if (target->expected_revision != revision) {
		runtime_mutex_unlock(this.publication_mutex);
		return analysis_publication::obsolete;
	};

	if (target->published.get()) {
		usize index = 0;
		while (index < this.retired.size() && this.retired.data()[index].get()) {
			@index = index + 1;
		};
		if (index == this.retired.size()) {
			if (!@this.retired.reserve(index + 1) || !@this.retired.push_back(rt::unique<PublishedAnalysis>())) {
				runtime_mutex_unlock(this.publication_mutex);
				return analysis_publication::unavailable;
			};
		};
		var rt::unique<PublishedAnalysis>* entries = (@this.retired).data();
		@entries[index].reset(@target->published.release());
	};
	@target->published.reset(@next.release());
	runtime_mutex_unlock(this.publication_mutex);
	@this.collect_retired();
	return analysis_publication::published;
};

fn Compiler::publish(var Compiler& this, rt::unique<Analysis> analysis) -> bool {
	var key = rt::string_view();
	if (!@this.expect_target(key, 0)) {
		return false;
	};

	return @this.publish_target(key, 0, $analysis) == analysis_publication::published;
};

fn Compiler::acquire_target(var Compiler& this, rt::string_view& key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	if (found) {
		@entry = found->get()->published.get();
	};

	if (entry) {
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry);
};

fn Compiler::acquire_current_target(var Compiler& this, rt::string_view& key) -> AnalysisLease {
	if (!this.publication_mutex) {
		return AnalysisLease();
	};
	runtime_mutex_lock(this.publication_mutex);
	var rt::unique<TargetAnalysis>* found = @this.targets.find(key);
	var PublishedAnalysis* entry = nullptr;
	if (found && found->get()->published.get() && found->get()->expected_revision == found->get()->published.get()->revision) {
		@entry = found->get()->published.get();
		@entry->readers = entry->readers + 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
	return AnalysisLease(@this, $entry);
};

fn Compiler::acquire_analysis(var Compiler& this) -> AnalysisLease {
	return @this.acquire_target(rt::string_view());
};

fn Compiler::release_analysis(var Compiler& this, var PublishedAnalysis& entry) {
	runtime_mutex_lock(this.publication_mutex);
	if (entry.readers) {
		@entry.readers = entry.readers - 1;
	};
	runtime_mutex_unlock(this.publication_mutex);
};

fn Compiler::collect_retired(var Compiler& this) {
	while (true) {
		rt::unique<PublishedAnalysis> garbage;
		runtime_mutex_lock(this.publication_mutex);
		usize index = 0;
		while (index < this.retired.size()) {
			var PublishedAnalysis* entry = this.retired.data()[index].get();
			if (entry && !entry->readers) {
				var rt::unique<PublishedAnalysis>* entries = (@this.retired).data();
				@garbage.reset(@entries[index].release());
				break;
			};
			@index = index + 1;
		};
		runtime_mutex_unlock(this.publication_mutex);
		if (!garbage.get()) {
			break;
		};
		@garbage.reset(nullptr);
	};
};

fn Compilation::Compilation(var Compilation& this, Analysis& analysis, FileOpener opener, var NativeFile* output) {
	@this.opener = $opener;
	@this.analysis = &@analysis;
	@this.diagnostics = Diagnostics($output);
};

fn Compilation::failure(var Compilation& this, rt::string_view& message) -> i32 {
	if (!this.diagnostics.failed()) {
		Token location;
		@this.diagnostics.error(location, message);
	};

	return 1;
};

fn Compilation::output_failure(var Compilation& this, rt::string_view& operation, rt::string_view& path) -> i32 {
	var message = DiagnosticMessage();
	@message.text(operation);
	@message.text(rt::string_view(" native object output ", 22));
	@message.quoted(path);
	Token location;

	if (this.diagnostics.failed()) {
		@this.diagnostics.note(location, message.view());
	}
	else {
		@this.diagnostics.error(location, message.view());
	};

	return 1;
};

fn Compilation::run(var Compilation& this, rt::string_view& output_path, rt::string_view& entry, i32 optimization, output_kind kind) -> i32 {
	if (this.analysis->diagnostics().failed() || !this.analysis->semantics()) {
		return 1;
	};

	if (output_path.empty()) {
		return @this.failure(rt::string_view("native object output path is required", 37));
	};

	if (optimization < 0 || optimization > 3) {
		return @this.failure(rt::string_view("optimization level must be between 0 and 3", 42));
	};
	@this.backend = rt::unique<Backend>(new var Backend(@this.diagnostics));

	if (!this.backend.get() || !@this.backend.get()->initialize($optimization)) {
		return @this.failure(rt::string_view("internal compiler error: target initialization failed without a diagnostic", 74));
	};

	if (this.backend.get()->pointer_bits() != this.analysis->pointer_bits()) {
		return @this.failure(rt::string_view("analysis target pointer width does not match the native output target", 69));
	};

	if (!@this.backend.get()->emit(*this.analysis->semantics(), entry, $kind)) {
		return @this.failure(rt::string_view("internal compiler error: native emission failed without a diagnostic", 68));
	};

	var native_output_path = rt::string(output_path);
	var output = File(this.opener(native_output_path.c_str(), "wb\0"));
	if (!output.is_open()) {
		return @this.output_failure(rt::string_view("cannot open", 11), output_path);
	};

	if (!@this.backend.get()->write(@output)) {
		return @this.output_failure(rt::string_view("cannot write", 12), output_path);
	};

	if (!@output.close()) {
		return @this.output_failure(rt::string_view("cannot close", 12), output_path);
	};

	return 0;
};

fn Compiler::emit_target(var Compiler& this, rt::string_view& key, rt::string_view& output_path, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var lease = @this.acquire_current_target(key);
	if (!lease.get()) {
		var errors = Diagnostics($diagnostics);
		Token location;
		@errors.error(location, rt::string_view("no current target analysis is available for native emission", 59));
		return 1;
	};

	if (lease.value().diagnostics().failed()) {
		lease.value().diagnostics().replay(diagnostics);
		return 1;
	};

	var compilation = Compilation(lease.value(), &platform_open_utf8_file, $diagnostics);
	return @compilation.run(output_path, entry, $optimization, $kind);
};

fn Compiler::emit_current(var Compiler& this, rt::string_view& output_path, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	return @this.emit_target(rt::string_view(), output_path, entry, $optimization, $diagnostics, $kind);
};

fn Compiler::compile(var Compiler& this, rt::buffer<rt::string_view>& paths, rt::string_view& output_path, FileOpener opener, rt::string_view& entry, i32 optimization, var NativeFile* diagnostics, output_kind kind) -> i32 {
	var errors = Diagnostics(diagnostics);
	Token location;

	if (!paths.size()) {
		@errors.error(location, rt::string_view("no source files", 15));
		return 1;
	};

	if (output_path.empty()) {
		@errors.error(location, rt::string_view("native object output path is required", 37));
		return 1;
	};

	var analysis = rt::unique<Analysis>(new var Analysis(diagnostics));
	if (!analysis.get()) {
		@errors.error(location, rt::string_view("analysis storage is unavailable", 31));
		return 1;
	};

	usize index = 0;
	while (index < paths.size()) {
		rt::string_view path := paths.data()[index];

		if (path.empty() || path == output_path) {
			@errors.error(location, rt::string_view("output cannot overwrite a source file", 37));
			return 1;
		};
		if (!@analysis.get()->load_source(path, opener)) {
			return 1;
		};
		@index = index + 1;
	};

	if (!@analysis.get()->analyze(static_cast<u32>(sizeof(usize) * 8), nullptr, nullptr)) {
		@errors.error(location, rt::string_view("internal compiler error: analysis could not complete", 52));
		return 1;
	};

	var compilation = Compilation(*analysis.get(), opener, diagnostics);
	i32 result = @compilation.run(output_path, entry, $optimization, $kind);

	if (!@this.publish($analysis)) {
		@errors.error(location, rt::string_view("could not publish the completed analysis", 40));
		return 1;
	};

	return $result;
};

fn fopen(char* path, char* mode) -> var NativeFile*;

fn platform_standard_error() -> var NativeFile*;

fn rutile_compiler_session(((var Compiler*, var void*) -> i32)* callback, var void* data) -> i32 {
	var compiler = rt::unique<Compiler>::make();

	if (!compiler.get()) {
		return 1;
	};

	return callback(compiler.get(), $data);
};

fn rutile_compile(var Compiler* compiler, var char var** paths, usize count, var char* output_path, FileOpener opener, var char* entry, i32 optimization, var NativeFile* diagnostics) -> i32 {
	if (!compiler) {
		return 1;
	};

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	rt::buffer<rt::string_view> source_paths;
	usize index = 0;

	while (paths && index < count) {
		if (!@source_paths.push_back(rt::string_view(paths[index]))) {
			return 1;
		};
		@index = index + 1;
	};

	rt::string_view entry_name = rt::string_view("main", 4);

	if (entry) {
		@entry_name = rt::string_view(entry);
	};

	return @compiler->compile(source_paths, rt::string_view(output_path), $opener, entry_name, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(var char var** paths, usize count, var char* output_path, FileOpener opener, i32 optimization, var NativeFile* diagnostics) -> i32 {
	Compiler compiler;

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	rt::buffer<rt::string_view> source_paths;
	usize index = 0;

	while (paths && index < count) {
		if (!@source_paths.push_back(rt::string_view(paths[index]))) {
			return 1;
		};
		@index = index + 1;
	};

	return @compiler.compile(source_paths, rt::string_view(output_path), $opener, rt::string_view("main", 4), $optimization, $diagnostics, output_kind::library);
};

fn Analyzer::construct(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* type, var Syntax& arguments) -> rt::unique<SemanticExpression> {
	if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function || type->kind() == type_kind::reference) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		var message = DiagnosticMessage();
		@message.text(rt::string_view("construction requires an object type; ", 38));
		if (type) {
			@message.text(rt::string_view("requested type is '", 19));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("'", 1));
		}
		else {
			@message.text(rt::string_view("the destination type is unavailable", 35));
		};
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	rt::buffer<rt::unique<SemanticExpression>> raw;
	usize index = 0;
	while (index < arguments.size()) {
		var value = @this.expression(@scope, @*arguments.item(index), rt::optional_ref<const Type>());

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@raw.push_back($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	return @this.construct_values(@syntax, type, $raw);
};

fn Analyzer::construct_values(var Analyzer& this, var Syntax& syntax, Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression> {
	var values = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

	if (!values.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	var Entity* constructor = nullptr;
	bool transfer = false;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		var Entity* owner = type->entity();

		if (!@this.resolve((var Entity*(owner)))) {
			return rt::unique<SemanticExpression>();
		};

		var Entity* candidate = owner->members()->local(owner->name());

		if (candidate && candidate->kind() == entity_kind::function) {
			@constructor = @this.select(candidate, raw, 1, conversion_mode::explicit_only, @syntax);

			if (this.diagnostics->failed()) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *constructor);

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && raw.size() == 1 && raw.data()[0].get()->type()->same_shape(*type)) {
			@transfer = true;
		};

		bool declared_constructor = false;
		usize member = 0;
		while (member < owner->members()->bindings().size()) {
			var Entity* declaration = owner->members()->bindings().data()[member];
			if (declaration->kind() == entity_kind::function && declaration->name() == owner->name() && declaration->origin() == declaration_origin::source) {
				@declared_constructor = true;
			};
			@member = member + 1;
		};

		if (!constructor && declared_constructor && !transfer) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("no applicable constructor for '", 31));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' with arguments ", 17));
			diagnostic_arguments(@message, raw);
			@this.report(syntax.token(), message.view());
			if (candidate && candidate->kind() == entity_kind::function) {
				diagnostic_candidates(@*this.diagnostics, *candidate);
			};

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && !transfer && raw.size() > owner->fields().size()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("too many aggregate initializer arguments for '", 46));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("': expected at most ", 20));
			@message.number(u64(owner->fields().size()));
			@message.text(rt::string_view(", received ", 11));
			@message.number(u64(raw.size()));
			@message.text(rt::string_view(" with types ", 12));
			diagnostic_arguments(@message, raw);
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};
	}
	else if (raw.size() > 1) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("scalar construction of '", 24));
		diagnostic_type(@message, *type);
		@message.text(rt::string_view("' accepts at most one argument; received ", 41));
		@message.number(u64(raw.size()));
		@message.text(rt::string_view(" with types ", 12));
		diagnostic_arguments(@message, raw);
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	@index = 0;
	var rt::unique<SemanticExpression>* owned = (@raw).data();

	while (index < raw.size()) {
		Type* expected = type;

		if (constructor) {
			@expected = constructor->parameters().data()[index + 1]->type();
		}
		else if (!transfer && type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			@expected = type->entity()->fields().data()[index]->type();
		};

		var value = rt::unique<SemanticExpression>(@owned[index].release());

		if (transfer) {
			if (value.get()->category() == value_category::place && !@this.prepare_copy(type)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else if (type->kind().is_numeric() && value.get()->type()->kind().is_numeric() || type->kind() != type_kind::named && type->same_shape(*value.get()->type())) {
			var conversion = @this.node(semantic_kind::cast, type, &@syntax);

			if (!conversion.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@conversion.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@value = $conversion;
		}
		else {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*expected), @syntax);
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@values.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	var result = @this.node(semantic_kind::construction, type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($values)) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->bind($constructor, value_category::consumable);

	return $result;
};

fn Analyzer::initialize(var Analyzer& this, var Syntax& syntax, Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression> {
	if (!type) {
		return $value;
	};

	bool explicit_copy = syntax.kind() == syntax_kind::variable && syntax.variable_initializer()->kind() == syntax_kind::unary && syntax.variable_initializer()->token().kind == token_kind::op_copy;
	if (explicit_copy && value.get()->kind() != semantic_kind::noop) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};
		return @this.construct_values(@syntax, type, $arguments);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		if (value.get()->kind() == semantic_kind::noop) {
			return $value;
		};

		return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
	};

	if (value.get()->kind() == semantic_kind::construction && value.get()->type()->same_shape(*type)) {
		return $value;
	};

	if (!explicit_copy && value.get()->category() == value_category::place && value.get()->type()->same_shape(*type)) {
		if (@this.implicit_constructor(*value.get(), *type) || @this.conversion_function(*value.get(), *type, conversion_mode::implicit_allowed)) {
			return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
		};
	};

	rt::buffer<rt::unique<SemanticExpression>> arguments;

	if (value.get()->kind() != semantic_kind::noop) {
		if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};
	};

	return @this.construct_values(@syntax, type, $arguments);
};

fn Analyzer::call(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression> {
	var Syntax* source = syntax.callable();
	var Syntax* arguments = syntax.arguments();
	var Entity* explicit_pattern = @this.templates.call_pattern(@this, @scope, @*source);
	rt::optional_ref<Syntax> supplied;

	if (explicit_pattern) {
		var Syntax* application = source;

		if (application->kind() == syntax_kind::qualified_name) {
			@application = application->right();
		};

		@supplied.bind(@*application->arguments());
	};

	if (source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || (source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_mutable) || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		Type* target = @this.type(@scope, @*source);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
	};

	if (!explicit_pattern && (source->kind() == syntax_kind::name || source->kind() == syntax_kind::qualified_name || source->kind() == syntax_kind::template_apply)) {
		Type* target = nullptr;
		var Entity* named = @this.lookup(@scope, @*source);

		if (source->kind() == syntax_kind::name && !named) {
			@target = this.types->find_primitive(source->token().text());
		};

		if (named && named->denotes_type()) {
			@target = @this.type(@scope, @*source);
		};

		if (target) {
			return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
		};
	};

	var Entity* group = nullptr;
	rt::unique<SemanticExpression> receiver;
	rt::unique<SemanticExpression> callable;

	if (source->kind() == syntax_kind::member) {
		@receiver = @this.expression(@scope, @*source->member_object(), rt::optional_ref<const Type>());

		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};

		Type* owner = receiver.get()->type();

		if (source->token().kind == token_kind::op_arrow) {
			if (owner->kind() != type_kind::pointer) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("arrow method access to '", 24));
				diagnostic_name(@message, *source->member_name());
				@message.text(rt::string_view("' requires a pointer; receiver has type '", 41));
				diagnostic_type(@message, *owner);
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			@owner = owner->element();
			var dereference = @this.node(semantic_kind::dereference, owner, source);

			if (!dereference.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@dereference.get()->append(rt::unique<SemanticExpression>(@receiver.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@dereference.get()->set_category(value_category::place);
			@receiver = $dereference;
		};

		if (owner->kind() != type_kind::named || !owner->entity()->members()) {
			if (source->member_name()->kind() != syntax_kind::unary) {
				var Entity* alias = @this.lookup(@scope, @*source->member_name());
				if (this.failed()) {
					return rt::unique<SemanticExpression>();
				};
				Type* builtin = this.types->find_primitive(source->member_name()->token().text());

				if (!builtin && (!alias || !alias->denotes_type())) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("method '", 8));
					diagnostic_name(@message, *source->member_name());
					@message.text(rt::string_view("' requires a class or enum object; receiver has type '", 54));
					diagnostic_type(@message, *owner);
					@message.text(rt::string_view("'", 1));
					@this.report(source->token(), message.view());

					return rt::unique<SemanticExpression>();
				};
			};
		};

		var Syntax* member = source->member_name();
		bool destructor = member->kind() == syntax_kind::unary && member->token().kind == token_kind::op_tilde;
		Type* designated = nullptr;

		if (destructor) {
			@designated = @this.type(@scope, @*member->operand());
		}
		else {
			@designated = this.types->find_primitive(member->token().text());
			var Entity* alias = @this.lookup(@scope, @*member);
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};

			if (alias && alias->denotes_type()) {
				if (!@this.resolve((var Entity*(alias)))) {
					return rt::unique<SemanticExpression>();
				};

				@designated = alias->type();
			};
		};

		if (designated && designated->same_shape(*owner)) {
			if (owner->qualifier() == type_qualifier::immutable || !accessed && receiver.get()->kind() != semantic_kind::access) {
				var message = DiagnosticMessage();
				if (destructor) {
					@message.text(rt::string_view("explicit destruction of '", 25));
				}
				else {
					@message.text(rt::string_view("explicit construction of '", 26));
				};
				diagnostic_type(@message, *owner);
				@message.text(rt::string_view("' requires mutable access; ", 27));
				if (owner->qualifier() == type_qualifier::immutable) {
					@message.text(rt::string_view("the object is const", 19));
				}
				else {
					@message.text(rt::string_view("the object was not accessed through '@'", 39));
				};
				@this.report(source->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			if (destructor) {
				if (arguments->size()) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("destructor for '", 16));
					diagnostic_type(@message, *owner);
					@message.text(rt::string_view("' accepts no arguments after its receiver; received ", 52));
					@message.number(u64(arguments->size()));
					@this.report(source->token(), message.view());

					return rt::unique<SemanticExpression>();
				};

				var result = @this.node(semantic_kind::destruction, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

				if (!result.get()) {
					return rt::unique<SemanticExpression>();
				};

				var Entity* finalizer = nullptr;

				if (owner->kind() == type_kind::named && owner->entity()->kind() == entity_kind::record) {
					@finalizer = owner->entity()->destructor();
				};

				@result.get()->bind(finalizer, value_category::consumable);

				if (!@result.get()->append($receiver)) {
					return rt::unique<SemanticExpression>();
				};

				return $result;
			};

			var result = @this.construct(@scope, @syntax, designated, @*arguments);

			if (!result.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($receiver)) {
				return rt::unique<SemanticExpression>();
			};

			@result.get()->set_category(value_category::place);

			return @this.convert($result, expected, @syntax);
		};

		if (destructor) {
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};
			var message = DiagnosticMessage();
			@message.text(rt::string_view("destructor type '", 17));
			diagnostic_name(@message, *member->operand());
			@message.text(rt::string_view("' does not match its object of type '", 37));
			diagnostic_type(@message, *owner);
			@message.text(rt::string_view("'", 1));
			@this.report(source->token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (owner->kind() != type_kind::named) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("explicit construction type '", 28));
			diagnostic_name(@message, *member);
			@message.text(rt::string_view("' does not match its destination of type '", 42));
			diagnostic_type(@message, *owner);
			@message.text(rt::string_view("'", 1));
			@this.report(source->token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (!@this.unit->record_receiver(@scope, @*source, @*owner->entity())) {
			return rt::unique<SemanticExpression>();
		};

		@group = owner->entity()->find_member(source->member_name()->token().text());

		if (group && group->kind() == entity_kind::field) {
			@callable = @this.member_value(@scope, @*source, rt::unique<SemanticExpression>(@receiver.release()), rt::optional_ref<const Type>());

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@group = nullptr;
		};

		if (accessed && receiver.get()) {
			var access = @this.node(semantic_kind::access, owner, source);

			if (!access.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@access.get()->append(rt::unique<SemanticExpression>(@receiver.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@access.get()->set_category(value_category::place);
			@receiver = $access;
		};
	}
	else if (explicit_pattern) {
		@group = explicit_pattern;
	}
	else {
		@group = @this.lookup(@scope, @*source);
	};

	if (this.editor && group && group->kind() == entity_kind::function) {
		usize missing = 0;
		while (missing < arguments->size() && arguments->item(missing)->kind() != syntax_kind::error_expression) {
			@missing = missing + 1;
		};
		if (missing < arguments->size()) {
			rt::buffer<var Entity*>& candidates = group->scope()->bindings();
			usize candidate = 0;
			while (candidate < candidates.size()) {
				var Entity* function = candidates.data()[candidate];
				@candidate = candidate + 1;
				if (function->kind() == entity_kind::function && function->name() == group->name() && !@this.resolve(function)) {
					return rt::unique<SemanticExpression>();
				};
			};
			if (!@this.unit->record_incomplete_call(@scope, @syntax, @*group, receiver.get() != nullptr)) {
				return rt::unique<SemanticExpression>();
			};
			return @this.node(semantic_kind::noop, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);
		};
	};

	rt::buffer<rt::unique<SemanticExpression>> values;

	if (receiver.get()) {
		if (!@values.push_back(rt::unique<SemanticExpression>(@receiver.release()))) {
			return rt::unique<SemanticExpression>();
		};
	};

	usize index = 0;
	while (index < arguments->size()) {
		rt::unique<SemanticExpression> value;

		if (arguments->item(index)->kind() == syntax_kind::brace) {
			@value = @this.node(semantic_kind::deferred_argument, this.types->find_primitive(rt::string_view("void", 4)), arguments->item(index));
		}
		else {
			@value = @this.expression(@scope, @*arguments->item(index), rt::optional_ref<const Type>());
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@values.push_back($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (group && group->kind() == entity_kind::template_pattern) {
		@group = @this.templates.specialize_call(@this, @scope, @*group, supplied, values, @syntax);

		if (!group) {
			return rt::unique<SemanticExpression>();
		};
	};

	var Entity* selected = nullptr;

	if (group && group->kind() == entity_kind::function) {
		@selected = @this.select(group, values, 0, conversion_mode::explicit_only, @syntax);

		if (!selected) {
			if (!this.diagnostics->failed()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("no applicable function for call to '", 36));
				diagnostic_entity(@message, *group);
				@message.text(rt::string_view("' with arguments ", 17));
				diagnostic_arguments(@message, values);
				@this.diagnostics->error(syntax.token(), message.view());
				diagnostic_candidates(@*this.diagnostics, *group);
			};

			return rt::unique<SemanticExpression>();
		};

		if (selected->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *selected);

			return rt::unique<SemanticExpression>();
		};

		if (!this.accessible(*selected, @scope)) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("selected function '", 19));
			diagnostic_entity(@message, *selected);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *selected->type());
			@message.text(rt::string_view("' is not accessible from this scope", 35));
			@this.report(syntax.token(), message.view());
			@this.note(selected->token(), rt::string_view("function is declared here", 25));

			return rt::unique<SemanticExpression>();
		};

		@callable = @this.node(semantic_kind::name, selected->type(), source);

		if (!callable.get()) {
			return rt::unique<SemanticExpression>();
		};

		@callable.get()->bind((var Entity*(selected)), value_category::place);
	}
	else if (!callable.get()) {
		@callable = @this.expression(@scope, @*source, rt::optional_ref<const Type>());
	};

	if (callable.get() && !@this.contextual_arguments(@scope, @syntax, @*callable.get(), @values)) {
		return rt::unique<SemanticExpression>();
	};

	return @this.invoke(@syntax, selected, $callable, $values, expected);
};

fn Analyzer::invoke(var Analyzer& this, var Syntax& syntax, var Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* signature = callable.get()->type();

	if (signature->kind() == type_kind::pointer) {
		@signature = signature->element();
	};

	if (signature->kind() != type_kind::function) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("cannot call an expression of type '", 35));
		diagnostic_type(@message, *callable.get()->type());
		@message.text(rt::string_view("'; a function or pointer to function is required", 48));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	usize fixed = signature->signature().parameters().size();

	if (values.size() < fixed || signature->signature().arity() != parameter_arity::variadic && values.size() != fixed) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("call to function of type '", 26));
		diagnostic_type(@message, *signature);
		@message.text(rt::string_view("' requires ", 11));
		if (signature->signature().arity() == parameter_arity::variadic) {
			@message.text(rt::string_view("at least ", 9));
		};
		@message.number(u64(fixed));
		@message.text(rt::string_view(" arguments, received ", 21));
		@message.number(u64(values.size()));
		@message.text(rt::string_view(" with types ", 12));
		diagnostic_arguments(@message, values);
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var converted = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

	if (!converted.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	var rt::unique<SemanticExpression>* owners = (@values).data();

	while (index < values.size()) {
		var value = rt::unique<SemanticExpression>(@owners[index].release());

		if (index < fixed) {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*signature->signature().parameters().data()[index]), @syntax);
		}
		else if (!value.get()->type()->representation()->kind().is_scalar()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("variadic argument ", 18));
			@message.number(u64(index + 1));
			@message.text(rt::string_view(" requires a scalar value; received '", 36));
			diagnostic_type(@message, *value.get()->type());
			@message.text(rt::string_view("' for callable type '", 21));
			diagnostic_type(@message, *signature);
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@converted.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	Type* result_type = signature->signature().result();
	value_category category = value_category::consumable;

	if (result_type->kind() == type_kind::reference) {
		@result_type = result_type->element();
		@category = value_category::place;
	};

	var result = @this.node(semantic_kind::call, result_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($callable)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($converted)) {
		return rt::unique<SemanticExpression>();
	};

	if (selected && this.function && this.function->members() && !@this.unit->record_name(@this, @*this.function->members(), @syntax, @*selected, 16)) {
		@this.error(&@syntax, rt::string_view("navigation index storage is unavailable", 39));
		return rt::unique<SemanticExpression>();
	};
	@result.get()->bind(selected, $category);

	if (signature->signature().result()->kind() == type_kind::reference) {
		@result.get()->set_mutable_access(result_type->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::contextual_arguments(var Analyzer& this, var Scope& scope, var Syntax& syntax, var SemanticExpression& callable, var rt::buffer<rt::unique<SemanticExpression>>& values) -> bool {
	TypeUse* use = callable.type_use().get();

	if (!use && callable.entity()) {
		@use = callable.entity()->type_use().get();
	};

	if (use && use->type().kind() == type_kind::pointer) {
		@use = &@use->element();
	};

	usize offset = values.size() - syntax.arguments()->size();
	usize index = 0;
	while (index < values.size()) {
		if (values.data()[index].get()->kind() == semantic_kind::deferred_argument) {
			if (!use || use->type().kind() != type_kind::function || index >= use->callable().parameters().size()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("contextual argument ", 20));
				@message.number(u64(index + 1 - offset));
				@message.text(rt::string_view(" requires a fixed parameter type; callable has type '", 53));
				diagnostic_type(@message, *callable.type());
				@message.text(rt::string_view("'", 1));
				@this.report(syntax.arguments()->item(index - offset)->token(), message.view());
				return false;
			};

			ParameterUse& parameter = use->callable().parameters().data()[index];
			var value = @this.contextual_argument(@scope, @*syntax.arguments()->item(index - offset), parameter.type(), parameter.name());

			if (!value.get()) {
				return false;
			};

			@(@values).data()[index] = $value;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::contextual_argument(var Analyzer& this, var Scope& scope, var Syntax& syntax, TypeUse& use, rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression> {
	if (!name.has_value()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("argument block requires a named parameter; selected parameter has type '", 72));
		diagnostic_type(@message, use.type());
		@message.text(rt::string_view("' and no parameter name", 23));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	Type* type = &@use.type();
	Type* value_type = type;
	bool reference = type->kind() == type_kind::reference;

	if (reference) {
		@value_type = type->element();
	};

	var Scope* local = @this.unit->create_scope(&@scope, this.function);

	if (!local) {
		return rt::unique<SemanticExpression>();
	};

	Token token = syntax.token();

	if (name.has_value()) {
		@token = name.value().location();
	};

	var init = @this.node(semantic_kind::noop, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);
	var body = @this.node(semantic_kind::statements, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);
	var Entity* binding = nullptr;

	if (!reference) {
		@binding = @this.unit->create_entity(entity_kind::local, token, &@syntax, local);

		if (!binding) {
			return rt::unique<SemanticExpression>();
		};

		if (name.has_value() && !@binding->set_name(name.value().text())) {
			return rt::unique<SemanticExpression>();
		};

		@binding->set_type(type);
		@binding->set_type_use(use);
		@binding->set_state(entity_state::ready);
		rt::buffer<rt::unique<SemanticExpression>> empty;
		var initial = @this.construct_values(@syntax, type, $empty);
		@init = @this.node(semantic_kind::variable, type, &@syntax);

		if (!initial.get() || !init.get()) {
			return rt::unique<SemanticExpression>();
		};

		@init.get()->bind((var Entity*(binding)), value_category::consumable);

		if (!@init.get()->append($initial)) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (!init.get() || !body.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	while (index < syntax.size()) {
		var Syntax* statement = syntax.item(index);
		rt::unique<SemanticExpression> child;
		var Syntax* target = nullptr;

		if (reference && !binding && statement->kind() == syntax_kind::binary && (statement->token().kind == token_kind::op_assign || statement->token().kind == token_kind::op_copy)) {
			@target = statement->left();

			if (target->kind() == syntax_kind::unary && target->token().kind == token_kind::op_access) {
				@target = target->operand();
			};
		};

		if (target && name.has_value() && target->kind() == syntax_kind::name && name.value().is(target->token().text())) {
			var value = @this.expression(@*local, @*statement->right(), rt::optional_ref<const Type>(*type));

			if (!value.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (value.get()->category() != value_category::place) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("reference contextual argument ", 30));
				@message.quoted(name.value().text());
				@message.text(rt::string_view(" of type '", 10));
				diagnostic_type(@message, *type);
				@message.text(rt::string_view("' requires a borrowed initializer; received a consumable of type '", 66));
				diagnostic_type(@message, *value.get()->type());
				@message.text(rt::string_view("'", 1));
				@this.report(statement->token(), message.view());
				@this.note(name.value().location(), rt::string_view("parameter is declared here", 26));

				return rt::unique<SemanticExpression>();
			};

			@binding = @this.unit->create_entity(entity_kind::local, token, &@syntax, local);

			if (!binding) {
				return rt::unique<SemanticExpression>();
			};

			if (!@binding->set_name(name.value().text())) {
				return rt::unique<SemanticExpression>();
			};

			@binding->set_type(type);
			@binding->set_type_use(use);
			@binding->set_state(entity_state::ready);
			@child = @this.node(semantic_kind::variable, type, statement);

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			@child.get()->bind((var Entity*(binding)), value_category::consumable);

			if (!@child.get()->append($value)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			@child = @this.expression(@*local, @*statement, rt::optional_ref<const Type>());
		};

		if (!child.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@body.get()->append($child)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (!binding) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("reference contextual argument ", 30));
		@message.quoted(name.value().text());
		@message.text(rt::string_view(" of type '", 10));
		diagnostic_type(@message, *type);
		@message.text(rt::string_view("' requires a bound initializer in its argument block", 52));
		@this.report(syntax.token(), message.view());
		@this.note(name.value().location(), rt::string_view("parameter is declared here", 26));

		return rt::unique<SemanticExpression>();
	};

	var yield = @this.node(semantic_kind::name, value_type, &@syntax);

	if (!yield.get()) {
		return rt::unique<SemanticExpression>();
	};

	@yield.get()->bind(binding, value_category::place);

	if (reference) {
		@yield.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	if (!reference) {
		var transfer = @this.node(semantic_kind::relocation, type, &@syntax);

		if (!transfer.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@transfer.get()->append(rt::unique<SemanticExpression>(@yield.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@yield = $transfer;
	};

	var result = @this.node(semantic_kind::sequence, value_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->set_category(yield.get()->category());

	if (reference) {
		@result.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	@result.get()->set_type_use(use.effective());

	if (!@result.get()->append($init)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($body)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($yield)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::select(var Analyzer& this, var Entity* group, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	rt::buffer<var Entity*> candidates;
	rt::buffer<var Entity*>& bindings = group->scope()->bindings();
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];

		if (candidate->kind() == entity_kind::function && candidate->name() == group->name()) {
			if (!@candidates.push_back((var Entity*(candidate)))) {
				@this.error(&@syntax, rt::string_view("out of memory collecting function candidates", 44));

				return nullptr;
			};
		};

		@index = index + 1;
	};

	return @this.select_candidates(candidates, arguments, $skipped, $mode, @syntax);
};

fn Analyzer::select_candidates(var Analyzer& this, rt::buffer<var Entity*>& bindings, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity* {
	var Entity* selected = nullptr;
	i32 best = i32::max;
	i32 best_origin = 2;
	rt::buffer<var Entity*> best_matches;
	rt::buffer<var Entity*> seen;
	usize index = 0;
	while (index < bindings.size()) {
		var Entity* candidate = bindings.data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return nullptr;
		};

		@candidate = candidate->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != candidate) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, rt::string_view("out of memory ranking overload candidates", 41));

			return nullptr;
		};

		if (mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (candidate->parameters().size() < skipped) {
			continue;
		};

		usize fixed = candidate->parameters().size() - skipped;
		bool variadic = candidate->type()->signature().arity() == parameter_arity::variadic;

		if (arguments.size() < fixed || !variadic && arguments.size() != fixed) {
			continue;
		};

		i32 rank = 0;

		if (variadic) {
			@rank = 16;
		};

		usize argument = 0;

		while (argument < fixed) {
			i32 component = @this.argument_rank(*arguments.data()[argument].get(), *candidate->parameters().data()[argument + skipped]->type());

			if (component < 0) {
				@rank = -1;
				break;
			};

			@rank = rank + component;
			@argument = argument + 1;
		};

		i32 origin = 0;

		if (candidate->origin() == declaration_origin::compiler_supplied) {
			@origin = 1;
		};

		if (rank < 0 || rank > best || rank == best && origin > best_origin) {
			continue;
		};

		if (rank != best || origin != best_origin) {
			@best_matches.clear();
		};
		if (!@best_matches.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, rt::string_view("out of memory retaining equally ranked overload candidates", 58));
			return nullptr;
		};
		if (rank == best && origin == best_origin) {
			continue;
		};

		@best_origin = origin;
		@best := rank;
		@selected := candidate;
	};

	if (best_matches.size() > 1) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("ambiguous call to '", 19));
		diagnostic_entity(@message, *selected);
		@message.text(rt::string_view("' with arguments ", 17));
		diagnostic_arguments(@message, arguments);
		@this.diagnostics->error(syntax.token(), message.view());
		usize candidate_index = 0;
		while (candidate_index < best_matches.size()) {
			var Entity* candidate = best_matches.data()[candidate_index];
			@candidate_index = candidate_index + 1;
			var detail = DiagnosticMessage();
			@detail.text(rt::string_view("equally ranked candidate '", 26));
			diagnostic_entity(@detail, *candidate);
			@detail.text(rt::string_view("' has type '", 12));
			diagnostic_type(@detail, *candidate->type());
			@detail.text(rt::string_view("'", 1));
			@this.diagnostics->note(candidate->token(), detail.view());
		};

		return nullptr;
	};

	return $selected;
};

fn Analyzer::overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	rt::buffer<var Entity*> candidates;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		var Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function && candidate->kind() != entity_kind::template_pattern) {
			continue;
		};

		if (candidate->state() == entity_state::ready && candidate->kind() == entity_kind::function) {
			if (candidate->operator_kind() != syntax.token().kind) {
				continue;
			};
		}
		else {
			var Syntax* declaration = candidate->declaration();

			if (!declaration) {
				continue;
			};

			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};

			if (declaration->kind() != syntax_kind::function) {
				continue;
			};

			var Syntax* name = declaration->function_name();

			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};

			if (name->kind() != syntax_kind::operator_name || name->operator_token().kind != syntax.token().kind) {
				continue;
			};
		};

		bool visible = false;
		var Scope* enclosing = &@scope;

		while (enclosing) {
			if (candidate->scope() == enclosing) {
				@visible = true;
			};

			@enclosing = enclosing->parent();
		};

		usize argument = 0;

		while (argument < arguments.size()) {
			Type* type = arguments.data()[argument].get()->type();

			if (type->kind() == type_kind::named) {
				var Entity* owner = type->entity();

				if (candidate->scope() == owner->members() || candidate->scope() == owner->scope()) {
					@visible = true;
				};
			};

			@argument = argument + 1;
		};

		if (!visible) {
			continue;
		};

		if (candidate->kind() == entity_kind::template_pattern) {
			@candidate = @this.templates.deduce(@this, @scope, @*candidate, arguments, @syntax);

			if (!candidate) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!@candidates.push_back((var Entity*(candidate)))) {
			@this.error(&@syntax, rt::string_view("out of memory collecting operator candidates", 44));

			return rt::unique<SemanticExpression>();
		};
	};

	var Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @syntax);

	if (!selected) {
		if (!this.diagnostics->failed()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("no applicable operator ", 23));
			@message.quoted(syntax.token().text());
			@message.text(rt::string_view(" for operands ", 14));
			diagnostic_arguments(@message, arguments);
			@this.diagnostics->error(syntax.token(), message.view());
			usize candidate_index = 0;
			while (candidate_index < candidates.size()) {
				var Entity* candidate = candidates.data()[candidate_index];
				@candidate_index = candidate_index + 1;
				if (!candidate->type()) {
					continue;
				};
				var detail = DiagnosticMessage();
				@detail.text(rt::string_view("candidate '", 11));
				diagnostic_entity(@detail, *candidate);
				@detail.text(rt::string_view("' has type '", 12));
				diagnostic_type(@detail, *candidate->type());
				@detail.text(rt::string_view("'", 1));
				@this.diagnostics->note(candidate->token(), detail.view());
			};
		};
		return rt::unique<SemanticExpression>();
	};

	if (selected->definition() == function_definition::deleted) {
		@this.deleted_function(syntax.token(), *selected);
		return rt::unique<SemanticExpression>();
	};
	if (!this.accessible(*selected, @scope)) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("selected operator '", 19));
		diagnostic_entity(@message, *selected);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *selected->type());
		@message.text(rt::string_view("' is not accessible from this scope", 35));
		@this.diagnostics->error(syntax.token(), message.view());
		@this.diagnostics->note(selected->token(), rt::string_view("operator is declared here", 25));
		return rt::unique<SemanticExpression>();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), &@syntax);

	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	@callable.get()->bind((var Entity*(selected)), value_category::place);

	return @this.invoke(@syntax, selected, $callable, $arguments, expected);
};

fn ConversionSelection::unique(ConversionSelection& this) -> var Entity* {
	if (this.conflict) {
		return nullptr;
	};
	return this.selected;
};

fn Analyzer::implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> var Entity* {
	var result = @this.select_implicit_constructor(value, expected);
	return result.unique();
};

fn Analyzer::conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> var Entity* {
	var result = @this.select_conversion_function(value, expected, $mode);
	return result.unique();
};

fn Analyzer::select_implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> ConversionSelection {
	if (expected.kind() != type_kind::named || expected.entity()->kind() != entity_kind::record) {
		return ConversionSelection();
	};

	var Entity* owner = expected.entity();
	ConversionSelection result;
	i32 best = i32::max;
	usize index = 0;
	while (index < owner->members()->bindings().size()) {
		var Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function || !candidate->token().same(owner->token())) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return ConversionSelection();
		};

		@candidate = candidate->canonical();

		if (candidate->conversion() != conversion_mode::implicit_allowed || candidate->parameters().size() != 2) {
			continue;
		};

		i32 rank = this.builtin_rank(value, *candidate->parameters().data()[1]->type());

		if (rank < 0 || rank > best) {
			continue;
		};

		if (rank == best && result.selected != candidate) {
			@result.conflict = candidate;
			continue;
		};

		if (rank < best) {
			@result.selected = candidate;
			@best := rank;
			@result.conflict = nullptr;
		};
	};

	return $result;
};

fn Analyzer::select_conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> ConversionSelection {
	Type* source = value.type();

	ConversionSelection result;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		var Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		var Syntax* name = nullptr;
		if (candidate->declaration() && candidate->declaration()->kind() == syntax_kind::function) {
			@name = candidate->declaration()->function_name();
			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};
		};

		if (candidate->role() != function_role::conversion && (!name || name->kind() != syntax_kind::conversion_name)) {
			continue;
		};

		if (source->kind() == type_kind::named && candidate->scope() != source->entity()->members() && candidate->scope() != source->entity()->scope()) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return ConversionSelection();
		};

		@candidate = candidate->canonical();

		if (candidate->role() != function_role::conversion || candidate->parameters().size() != 1 || !candidate->type()->signature().result()->same_shape(expected) || mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (this.builtin_rank(value, *candidate->parameters().data()[0]->type()) < 0) {
			continue;
		};

		if (result.selected && result.selected != candidate) {
			@result.conflict = candidate;
			return $result;
		};

		@result.selected = candidate;
	};

	return $result;
};

fn Analyzer::argument_rank(var Analyzer& this, SemanticExpression& value, Type& expected) -> i32 {
	if (value.kind() == semantic_kind::deferred_argument) {
		return 0;
	};

	i32 builtin = this.builtin_rank(value, expected);

	if (expected.kind() != type_kind::reference && value.category() == value_category::place && value.type()->same_shape(expected)) {
		if (@this.implicit_constructor(value, expected)) {
			return 8;
		};

		if (@this.conversion_function(value, expected, conversion_mode::implicit_allowed)) {
			return 9;
		};
	};

	if (builtin >= 0) {
		return builtin;
	};

	if (expected.kind() == type_kind::reference && expected.element()->qualifier() == type_qualifier::mutable) {
		return -1;
	};

	Type* target = &@expected;

	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	var Entity* constructor = @this.implicit_constructor(value, *target);

	if (constructor) {
		return 16 + this.builtin_rank(value, *constructor->parameters().data()[1]->type());
	};

	var Entity* conversion = @this.conversion_function(value, *target, conversion_mode::implicit_allowed);

	if (conversion) {
		return 17 + this.builtin_rank(value, *conversion->parameters().data()[0]->type());
	};

	return -1;
};

fn Analyzer::supply_special_functions(var Analyzer& this, var Entity* entity) -> bool {
	Type* source = entity->type();
	Type* copy = @this.types->reference(@this.types->qualified(*source, type_qualifier::immutable));

	if (!copy) {
		return false;
	};

	bool source_constructor = false;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* member = entity->members()->bindings().data()[index];

		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->origin() == declaration_origin::source) {
			@source_constructor = true;
		};

		@index = index + 1;
	};

	if (!source_constructor) {
		var Entity* constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);

		if (!constructor) {
			return false;
		};

		@entity->set_default_constructor(constructor);
	};

	var Entity* move_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, source, function_definition::defaulted);
	var Entity* copy_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, copy, function_definition::defaulted);

	if (!move_constructor || !copy_constructor) {
		return false;
	};

	@entity->set_move_constructor(move_constructor);
	@entity->set_copy_constructor(copy_constructor);

	if (!@this.supply_special(entity, function_role::assignment, token_kind::op_assign, source, function_definition::defaulted)) {
		return false;
	};

	if (!@this.supply_special(entity, function_role::assignment, token_kind::op_assign, copy, function_definition::defaulted)) {
		return false;
	};

	return @this.supply_special(entity, function_role::assignment, token_kind::op_copy, copy, function_definition::defaulted) != nullptr;
};

fn Analyzer::supply_special(var Analyzer& this, var Entity* entity, function_role role, token_kind operation, Type* source, function_definition definition) -> var Entity* {
	Type* receiver = @this.types->reference(entity->type());

	if (!receiver) {
		return nullptr;
	};

	usize parameter_count = 1;

	if (source) {
		@parameter_count = 2;
	};

	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* candidate = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return nullptr;
		};

		@candidate = candidate->canonical();

		if (candidate->role() == role && (role == function_role::constructor || candidate->operator_kind() == operation) && candidate->parameters().size() == parameter_count && candidate->parameters().data()[0]->type() == receiver && (!source || candidate->parameters().data()[1]->type() == source)) {
			return candidate;
		};
	};

	Token location = entity->token();
	var name = entity->name();
	Type* result = this.types->find_primitive(rt::string_view("void", 4));

	if (role == function_role::assignment) {
		@location.kind = token_kind(operation);
		@name = rt::string_view("operator=", 9);
		@result := receiver;

		if (operation == token_kind::op_copy) {
			@name = rt::string_view("operator:=", 10);
		};
	};

	var Entity* function = @this.unit->create_entity(entity_kind::function, location, nullptr, entity->members());

	if (!function || !@function->set_name(name)) {
		@this.error(entity->declaration(), rt::string_view("cannot declare compiler-supplied special function", 49));
		return nullptr;
	};

	@function->set_origin(declaration_origin::compiler_supplied);
	@function->set_definition(function_definition(definition));
	@function->set_role(function_role(role));
	@function->set_operator_kind(token_kind(operation));
	@function->set_access(access_kind::public_access);
	var Scope* parameters = @this.unit->create_scope(entity->members(), (var Entity*(function)));

	if (!parameters) {
		return nullptr;
	};

	@function->set_members((var Scope*(parameters)));
	rt::buffer<Type*> signature;
	@index = 0;

	while (index < parameter_count) {
		Type* type = source;
		var parameter_name = rt::string_view("other", 5);

		if (!index) {
			@type = receiver;
			@parameter_name = rt::string_view("this", 4);
		};

		var Entity* parameter = @this.unit->create_entity(entity_kind::parameter, location, nullptr, parameters);

		if (!parameter || !@parameter->set_name(parameter_name)) {
			return nullptr;
		};

		@parameter->set_origin(declaration_origin::compiler_supplied);
		@parameter->set_type(type);
		@parameter->set_index(usize(index));
		@parameter->set_state(entity_state::ready);

		if (!@function->add_parameter((var Entity*(parameter))) || !@signature.push_back(type)) {
			return nullptr;
		};

		@index = index + 1;
	};

	@function->set_type(@this.types->function(result, $signature, parameter_arity::fixed));

	if (!function->type()) {
		return nullptr;
	};

	@function->set_state(entity_state::ready);

	return function;
};

fn numeric_literal_expression(SemanticExpression& expression) -> bool {
	if (expression.kind() == semantic_kind::literal_integer || expression.kind() == semantic_kind::literal_real) {
		return expression.token().kind == token_kind::literal_number;
	};

	if (expression.kind() == semantic_kind::unary && (expression.operation() == token_kind::op_plus || expression.operation() == token_kind::op_minus)) {
		return numeric_literal_expression(*expression.item(0));
	};

	if (expression.kind() == semantic_kind::binary && expression.operation() != token_kind::op_assign && expression.operation() != token_kind::op_copy) {
		return numeric_literal_expression(*expression.item(0)) && numeric_literal_expression(*expression.item(1));
	};

	if (expression.kind() == semantic_kind::cast && expression.token().kind == token_kind::literal_number) {
		return numeric_literal_expression(*expression.item(0));
	};

	return false;
};

fn Analyzer::compatible(Analyzer& this, Type* source, Type* target) -> bool {
	if (source == target) {
		return true;
	};

	if (!source || !target) {
		return false;
	};

	if (source->same_shape(*target) && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (target->kind() == type_kind::boolean && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (source->kind() != type_kind::pointer || target->kind() != type_kind::pointer) {
		return false;
	};

	Type* from = source->element();
	Type* to = target->element();

	if (from->kind() == type_kind::null_type) {
		return true;
	};

	if (from->qualifier() == type_qualifier::immutable && to->qualifier() == type_qualifier::mutable) {
		return false;
	};

	if (to->kind() == type_kind::void_type && from->kind() != type_kind::function) {
		return true;
	};

	return from->same_shape(*to) || from->derived_from(*to);
};

fn Analyzer::builtin_rank(Analyzer& this, SemanticExpression& value, Type& expected) -> i32 {
	if (expected.kind() == type_kind::reference) {
		if (value.category() != value_category::place && expected.element()->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		Type* target = expected.element();

		if (target->qualifier() == type_qualifier::mutable && !value.mutable_access()) {
			return -1;
		};

		if (target->qualifier() == type_qualifier::immutable && target->kind().is_numeric() && value.category() == value_category::consumable && numeric_literal_expression(value)) {
			return 1;
		};

		if ((!value.type()->same_shape(*target) && !value.type()->derived_from(*target)) || value.type()->qualifier() == type_qualifier::immutable && target->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		if (value.category() == value_category::consumable) {
			return 1;
		};

		if (!value.type()->same_shape(*target)) {
			return 1;
		};

		return 0;
	};

	if (expected.kind().is_numeric() && numeric_literal_expression(value)) {
		return 0;
	};

	i32 materialization = 0;

	if (value.category() == value_category::place) {
		if (value.type()->kind() == type_kind::named && value.type()->entity()->kind() == entity_kind::record) {
			return -1;
		};

		@materialization = 8;
	};

	if (value.type()->same_shape(expected)) {
		return $materialization;
	};

	if (this.compatible(value.type(), &@expected)) {
		return materialization + 1;
	};

	if (value.kind() == semantic_kind::literal_integer && expected.kind().is_numeric()) {
		return 2;
	};

	return -1;
};

fn Analyzer::convert(var Analyzer& this, rt::unique<SemanticExpression> value, rt::optional_ref<const Type>& expected, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!value.get() || !expected.has_value()) {
		return $value;
	};

	if (@this.argument_rank(*value.get(), expected.value()) < 0) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};

		Type* target = expected.get();
		if (target->kind() == type_kind::reference) {
			@target = target->element();
		};
		if (expected.value().kind() != type_kind::reference || target->qualifier() == type_qualifier::immutable) {
			var constructor = @this.select_implicit_constructor(*value.get(), *target);
			var conversion = @this.select_conversion_function(*value.get(), *target, conversion_mode::implicit_allowed);
			if (this.failed()) {
				return rt::unique<SemanticExpression>();
			};
			if (constructor.conflict) {
				diagnostic_conversion_ambiguity(@*this.diagnostics, syntax.token(), *value.get()->type(), expected.value(), constructor);
				return rt::unique<SemanticExpression>();
			};
			if (conversion.conflict) {
				diagnostic_conversion_ambiguity(@*this.diagnostics, syntax.token(), *value.get()->type(), expected.value(), conversion);
				return rt::unique<SemanticExpression>();
			};
		};

		var message = DiagnosticMessage();
		@message.text(rt::string_view("cannot initialize '", 19));
		diagnostic_type(@message, expected.value());
		@message.text(rt::string_view("' from ", 7));
		if (value.get()->category() == value_category::place) {
			@message.text(rt::string_view("a place of type '", 17));
		}
		else {
			@message.text(rt::string_view("a consumable of type '", 22));
		};
		diagnostic_type(@message, *value.get()->type());
		@message.text(rt::string_view("'", 1));
		@this.diagnostics->error(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference && expected.value().element()->qualifier() == type_qualifier::immutable && expected.value().element()->kind().is_numeric() && !value.get()->type()->same_shape(*expected.value().element()) && numeric_literal_expression(*value.get())) {
		var converted = @this.node(semantic_kind::cast, expected.value().element(), &@syntax);

		if (!converted.get() || !@converted.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@value = $converted;
	};

	i32 builtin = this.builtin_rank(*value.get(), expected.value());
	Type* target = expected.get();
	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	var Entity* constructor = nullptr;
	var Entity* conversion = nullptr;
	if (builtin < 0 || expected.value().kind() != type_kind::reference && value.get()->category() == value_category::place && value.get()->type()->same_shape(*target)) {
		@constructor = @this.implicit_constructor(*value.get(), *target);

		if (!constructor) {
			@conversion = @this.conversion_function(*value.get(), *target, conversion_mode::implicit_allowed);
		};
	};

	if (builtin < 0 || constructor || conversion) {
		var Entity* selected = constructor;
		usize source_index = 1;

		if (!selected) {
			@selected := conversion;
			@source_index = 0;
		};

		if (!selected) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("no applicable implicit conversion from '", 40));
			diagnostic_type(@message, *value.get()->type());
			@message.text(rt::string_view("' to '", 6));
			diagnostic_type(@message, expected.value());
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		if (selected->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *selected);

			return rt::unique<SemanticExpression>();
		};

		@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*selected->parameters().data()[source_index]->type()), @syntax);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		var arguments = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

		if (!arguments.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@arguments.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};

		if (constructor) {
			var construction = @this.node(semantic_kind::construction, target, &@syntax);

			if (!construction.get()) {
				return rt::unique<SemanticExpression>();
			};

			@construction.get()->bind(constructor, value_category::consumable);

			if (!@construction.get()->append($arguments)) {
				return rt::unique<SemanticExpression>();
			};

			@value = $construction;
		}
		else {
			var callable = @this.node(semantic_kind::name, conversion->type(), &@syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind(conversion, value_category::place);
			var call = @this.node(semantic_kind::call, target, &@syntax);

			if (!call.get()) {
				return rt::unique<SemanticExpression>();
			};

			@call.get()->bind(conversion, value_category::consumable);

			if (!@call.get()->append($callable)) {
				return rt::unique<SemanticExpression>();
			};

			if (!@call.get()->append($arguments)) {
				return rt::unique<SemanticExpression>();
			};

			@value = $call;
		};
	};

	if (value.get()->type() == expected.get() && expected.value().kind() != type_kind::reference) {
		return $value;
	};

	var result = @this.node(semantic_kind::cast, target, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($value)) {
		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(target->qualifier() == type_qualifier::mutable);
	};

	return $result;
};

fn diagnostic_unary_operand(var Diagnostics& diagnostics, var Syntax& syntax, rt::string_view& reason, SemanticExpression& operand) {
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text(rt::string_view("; operator ", 11));
	@message.quoted(syntax.token().text());
	@message.text(rt::string_view(" received ", 10));
	if (operand.category() == value_category::place) {
		@message.text(rt::string_view("a place of type '", 17));
	}
	else {
		@message.text(rt::string_view("a consumable of type '", 22));
	};
	diagnostic_type(@message, *operand.type());
	@message.text(rt::string_view("'", 1));
	@diagnostics.error(syntax.token(), message.view());
};

fn diagnostic_binary_operands(var Diagnostics& diagnostics, var Syntax& syntax, rt::string_view& reason, Type& first, Type& second) {
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text(rt::string_view("; operator ", 11));
	@message.quoted(syntax.token().text());
	@message.text(rt::string_view(" received operand types '", 25));
	diagnostic_type(@message, first);
	@message.text(rt::string_view("' and '", 7));
	diagnostic_type(@message, second);
	@message.text(rt::string_view("'", 1));
	@diagnostics.error(syntax.token(), message.view());
};

fn numeric_literal_expression(Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::number) {
		return true;
	};

	if (syntax.kind() == syntax_kind::grouping) {
		return numeric_literal_expression(*syntax.operand());
	};

	if (syntax.kind() == syntax_kind::unary && (syntax.token().kind == token_kind::op_plus || syntax.token().kind == token_kind::op_minus)) {
		return numeric_literal_expression(*syntax.operand());
	};

	if (syntax.kind() == syntax_kind::binary && syntax.token().kind != token_kind::op_assign && syntax.token().kind != token_kind::op_copy) {
		return numeric_literal_expression(*syntax.left()) && numeric_literal_expression(*syntax.right());
	};

	return false;
};

fn Analyzer::unary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.kind == token_kind::op_access && syntax.operand()->kind() == syntax_kind::call) {
		return @this.call(@scope, @*syntax.operand(), expected, true);
	};

	rt::optional_ref<const Type> operand_type;

	if ((operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus || operation.kind == token_kind::op_tilde) && expected.has_value() && expected.value().kind().is_numeric()) {
		@operand_type.bind(expected.value());
	};

	var operand = @this.expression(@scope, @*syntax.operand(), operand_type);

	if (!operand.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* type = operand.get()->type();

	if (operation.kind == token_kind::kw_sizeof) {
		return @this.convert(@this.size_query(@syntax, *type), expected, @syntax);
	};

	semantic_kind category = semantic_kind::unary;

	if (operation.kind == token_kind::op_access || operation.kind == token_kind::op_relocate || operation.kind == token_kind::op_ampersand) {
		if (operand.get()->category() != value_category::place) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("operator requires a place", 25), *operand.get());

			return rt::unique<SemanticExpression>();
		};

		if (operation.kind == token_kind::op_access) {
			@category = semantic_kind::access;
		}
		else if (operation.kind == token_kind::op_ampersand) {
			@category = semantic_kind::address;

			if (!operand.get()->mutable_access()) {
				@type = @this.types->qualified(*type, type_qualifier::immutable);

				if (!type) {
					return rt::unique<SemanticExpression>();
				};
			};

			@type = @this.types->pointer(type);
		}
		else {
			if (type->qualifier() == type_qualifier::immutable || !operand.get()->owned_binding() && !operand.get()->indirect_storage()) {
				if (type->qualifier() == type_qualifier::immutable) {
					diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("cannot relocate a const object", 30), *operand.get());
				}
				else {
					diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("cannot relocate a borrowed reference", 36), *operand.get());
				};

				return rt::unique<SemanticExpression>();
			};

			@category = semantic_kind::relocation;
		};
	}
	else if (operation.kind == token_kind::op_star) {
		if (type->kind() != type_kind::pointer || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("dereference requires a pointer to an object", 43), *operand.get());

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		@category = semantic_kind::dereference;
	}
	else if (operation.kind == token_kind::op_bang) {
		if (!type->kind().is_scalar()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("logical negation requires a scalar", 34), *operand.get());

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive(rt::string_view("bool", 4));
	}
	else if (operation.kind == token_kind::op_tilde) {
		if (!type->kind().is_integer()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("bitwise complement requires an integer", 38), *operand.get());

			return rt::unique<SemanticExpression>();
		};
	}
	else if (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus) {
		if (!type->kind().is_numeric()) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("unary arithmetic requires a numeric value", 41), *operand.get());

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("unary operator is not implemented", 33), *operand.get());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind(category), type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	var Entity* binding = operand.get()->entity();

	if (category == semantic_kind::access || category == semantic_kind::dereference) {
		@result.get()->bind(binding, value_category::place);
	}
	else if (category == semantic_kind::relocation) {
		@result.get()->bind(binding, value_category::consumable);
	};

	if (!@result.get()->append($operand)) {
		return rt::unique<SemanticExpression>();
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::binary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();
	bool assignment = operation.kind == token_kind::op_assign || operation.kind == token_kind::op_copy;
	bool logical = operation.kind == token_kind::op_and || operation.kind == token_kind::op_or;
	bool comparison = operation.kind == token_kind::op_equal || operation.kind == token_kind::op_not_equal || operation.kind == token_kind::op_less || operation.kind == token_kind::op_greater || operation.kind == token_kind::op_less_equal || operation.kind == token_kind::op_greater_equal;
	rt::optional_ref<const Type> left_context;
	rt::unique<SemanticExpression> right;

	if (!assignment && !logical && numeric_literal_expression(*syntax.left())) {
		if (!numeric_literal_expression(*syntax.right())) {
			@right = @this.expression(@scope, @*syntax.right(), rt::optional_ref<const Type>());

			if (!right.get()) {
				return rt::unique<SemanticExpression>();
			};

			@left_context.bind(*right.get()->type());
		}
		else if (expected.has_value() && expected.value().kind().is_numeric()) {
			@left_context.bind(expected.value());

			if (expected.value().kind() == type_kind::boolean) {
				@left_context.bind(*this.types->find_primitive(rt::string_view("f64", 3)));
			};
		};
	};

	var left = @this.expression(@scope, @*syntax.left(), left_context);

	if (!left.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* type = left.get()->type();
	var right_context = rt::optional_ref<const Type>(*type);

	if (type->kind() == type_kind::named) {
		@right_context.reset();
	};

	if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		@right_context.reset();
	};

	if (comparison && type->kind() == type_kind::pointer) {
		@right_context.reset();
	};

	if (logical && type->representation()->kind().is_scalar()) {
		@right_context.bind(*this.types->find_primitive(rt::string_view("bool", 4)));
		@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), right_context, @*syntax.left());

		if (!left.get()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (assignment && (left.get()->category() != value_category::place || !left.get()->mutable_access())) {
		diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("assignment requires explicit mutable access to a place", 54), *left.get());

		return rt::unique<SemanticExpression>();
	};

	if (!right.get()) {
		@right = @this.expression(@scope, @*syntax.right(), right_context);
	};

	if (!right.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* other = right.get()->type();

	if (comparison && (type->kind() == type_kind::pointer || other->kind() == type_kind::pointer)) {
		if (type->kind() != type_kind::pointer || other->kind() != type_kind::pointer) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("pointer comparison requires compatible pointer types", 52), *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if (this.compatible(other, type)) {
			@right = @this.convert(rt::unique<SemanticExpression>(@right.release()), rt::optional_ref<const Type>(*type), @syntax);
		}
		else if (this.compatible(type, other)) {
			@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), rt::optional_ref<const Type>(*other), @syntax);
			@type = other;
		}
		else {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("pointer comparison requires compatible pointer types", 52), *type, *other);

			return rt::unique<SemanticExpression>();
		};
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record || other->kind() == type_kind::named && other->entity()->kind() == entity_kind::record) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;

		if (!@arguments.push_back($left)) {
			return rt::unique<SemanticExpression>();
		};

		if (!@arguments.push_back($right)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.overloaded(@scope, @syntax, $arguments, expected);
	};

	if (assignment) {
		if (type->kind() == type_kind::array) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("aggregate assignment function selection is not implemented", 58), *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::named && !type->same_shape(*other)) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("enumeration assignment requires the same enumeration type", 57), *type, *other);

			return rt::unique<SemanticExpression>();
		};
	}
	else if (logical || comparison) {
		if (!type->representation()->kind().is_scalar() || !other->representation()->kind().is_scalar()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("built-in comparison requires scalar operands", 44), *type, *other);

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive(rt::string_view("bool", 4));
	}
	else if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		if (!other->kind().is_integer() || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("pointer offset requires an integer and object element type", 58), *type, *other);

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		if (!type->kind().is_numeric() || !other->kind().is_numeric() || type->kind() != other->kind() || type->bits() != other->bits()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("arithmetic requires matching numeric types", 42), *type, *other);

			return rt::unique<SemanticExpression>();
		};

		if ((operation.kind == token_kind::op_remainder || operation.kind == token_kind::op_ampersand || operation.kind == token_kind::op_pipe || operation.kind == token_kind::op_caret || operation.kind == token_kind::op_shift_left || operation.kind == token_kind::op_shift_right) && !type->kind().is_integer()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("bitwise arithmetic requires integers", 36), *type, *other);

			return rt::unique<SemanticExpression>();
		};
	};

	var result = @this.node(semantic_kind::binary, type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($left)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($right)) {
		return rt::unique<SemanticExpression>();
	};

	if (assignment) {
		@result.get()->set_category(value_category::place);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.is(rt::string_view("dynamic_cast", 12))) {
		@this.error(&@syntax, rt::string_view("dynamic_cast is not implemented", 31));

		return rt::unique<SemanticExpression>();
	};

	Type* target = @this.type(@scope, @*syntax.cast_type());
	var value = @this.expression(@scope, @*syntax.cast_operand(), rt::optional_ref<const Type>());

	if (!target || !value.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* source = value.get()->type();
	Type* destination = target;

	if (destination->kind() == type_kind::reference) {
		if (value.get()->category() != value_category::place) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("reference cast ", 15));
			@message.quoted(operation.text());
			@message.text(rt::string_view(" to '", 5));
			diagnostic_type(@message, *target);
			@message.text(rt::string_view("' requires a place; received a consumable of type '", 51));
			diagnostic_type(@message, *source);
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		@destination = destination->element();
	};

	bool allowed = false;

	if (operation.is(rt::string_view("const_cast", 10))) {
		if (target->kind() == type_kind::pointer && source->kind() == type_kind::pointer) {
			Type* a = target->element();
			Type* b = source->element();
			@allowed = a->same_shape(*b);
		}
		else if (target->kind() == type_kind::reference) {
			@allowed = source->same_shape(*destination);
		};
	}
	else if (operation.is(rt::string_view("reinterpret_cast", 16))) {
		@allowed = source->kind() == type_kind::pointer && target->kind() == type_kind::pointer || source->kind() == type_kind::pointer && target->kind().is_integer() && target->bits() == this.pointer_bits || source->kind().is_integer() && source->bits() == this.pointer_bits && target->kind() == type_kind::pointer;
	}
	else {
		var Entity* conversion = @this.conversion_function(*value.get(), *destination, conversion_mode::explicit_only);

		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		if (conversion) {
			if (conversion->definition() == function_definition::deleted) {
				@this.deleted_function(syntax.token(), *conversion);
				return rt::unique<SemanticExpression>();
			};
			if (!this.accessible(*conversion, @scope)) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("selected conversion '", 21));
				diagnostic_entity(@message, *conversion);
				@message.text(rt::string_view("' of type '", 11));
				diagnostic_type(@message, *conversion->type());
				@message.text(rt::string_view("' is not accessible from this scope", 35));
				@this.report(syntax.token(), message.view());
				@this.note(conversion->token(), rt::string_view("conversion is declared here", 27));

				return rt::unique<SemanticExpression>();
			};

			rt::buffer<rt::unique<SemanticExpression>> arguments;

			if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};

			var callable = @this.node(semantic_kind::name, conversion->type(), &@syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind((var Entity*(conversion)), value_category::place);

			return @this.invoke(@syntax, conversion, $callable, $arguments, expected);
		};

		Type* from = source->representation();
		Type* to = destination->representation();
		@allowed = from->kind().is_numeric() && to->kind().is_numeric() || source->kind() != type_kind::named && this.compatible(source, destination);

		if (target->kind() == type_kind::reference && (source->same_shape(*destination) || source->derived_from(*destination) || destination->derived_from(*source))) {
			@allowed = source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && destination->element()->derived_from(*source->element())) {
			@allowed = true;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && (source->element()->kind() == type_kind::void_type || destination->element()->kind() == type_kind::void_type)) {
			@allowed = source->element()->kind() != type_kind::function && destination->element()->kind() != type_kind::function;
		};
	};

	if (!operation.is(rt::string_view("const_cast", 10)) && source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && source->element()->qualifier() == type_qualifier::immutable && destination->element()->qualifier() == type_qualifier::mutable) {
		@allowed = false;
	};

	if (!allowed) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("cast ", 5));
		@message.quoted(operation.text());
		@message.text(rt::string_view(" does not permit conversion from '", 34));
		diagnostic_type(@message, *source);
		@message.text(rt::string_view("' to '", 6));
		diagnostic_type(@message, *target);
		@message.text(rt::string_view("'", 1));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::cast, destination, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($value)) {
		return rt::unique<SemanticExpression>();
	};

	if (target->kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(destination->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::component(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var object = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!object.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* type = object.get()->type();

	if (syntax.kind() == syntax_kind::index) {
		if (type->kind() != type_kind::pointer && type->kind() != type_kind::array) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("indexing requires an array or pointer", 37), *object.get());

			return rt::unique<SemanticExpression>();
		};

		Type* element = type->element();
		if (type->kind() == type_kind::array && type->qualifier() == type_qualifier::immutable) {
			@element = @this.types->qualified(*element, type_qualifier::immutable);
		};
		var index = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());

		if (!index.get()) {
			return rt::unique<SemanticExpression>();
		};
		if (!index.get()->type()->kind().is_integer()) {
			diagnostic_binary_operands(@*this.diagnostics, @syntax, rt::string_view("index requires an integer", 25), *type, *index.get()->type());

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::index, element, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($object)) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($index)) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->set_category(value_category::place);

		return @this.convert($result, expected, @syntax);
	};

	if (syntax.token().kind == token_kind::op_arrow) {
		if (type->kind() != type_kind::pointer) {
			diagnostic_unary_operand(@*this.diagnostics, @syntax, rt::string_view("arrow member access requires a pointer", 38), *object.get());

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		var dereference = @this.node(semantic_kind::dereference, type, &@syntax);

		if (!dereference.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@dereference.get()->append(rt::unique<SemanticExpression>(@object.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@dereference.get()->set_category(value_category::place);
		@object = $dereference;
	};

	return @this.member_value(@scope, @syntax, $object, expected);
};

fn Analyzer::member_value(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> object, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Type* type = object.get()->type();

	if (type->kind() != type_kind::named || !type->entity()->members()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("member access for ", 18));
		@message.quoted(syntax.member_name()->token().text());
		@message.text(rt::string_view(" requires a class or enum object; received '", 44));
		diagnostic_type(@message, *type);
		@message.text(rt::string_view("'", 1));
		@this.report(syntax.member_name()->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	if (!@this.unit->record_receiver(@scope, @syntax, @*type->entity())) {
		return rt::unique<SemanticExpression>();
	};

	if (this.editor && syntax.member_name()->kind() == syntax_kind::absent) {
		return @this.node(semantic_kind::noop, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);
	};

	var Entity* field = type->entity()->find_member(syntax.member_name()->token().text());

	if (!field || field->kind() != entity_kind::field) {
		var message = DiagnosticMessage();
		if (!field) {
			@message.text(rt::string_view("unknown data member ", 20));
			@message.quoted(syntax.member_name()->token().text());
			@message.text(rt::string_view(" in type '", 10));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("'", 1));
		}
		else {
			@message.text(rt::string_view("member '", 8));
			diagnostic_entity(@message, *field);
			@message.text(rt::string_view("' does not denote a data member", 31));
		};
		@this.report(syntax.member_name()->token(), message.view());
		if (field) {
			@this.note(field->token(), rt::string_view("member is declared here", 23));
		};

		return rt::unique<SemanticExpression>();
	};

	if (!@this.resolve((var Entity*(field)))) {
		return rt::unique<SemanticExpression>();
	};
	if (!this.accessible(*field, @scope)) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("data member '", 13));
		diagnostic_entity(@message, *field);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *field->type());
		@message.text(rt::string_view("' is not accessible from this scope", 35));
		@this.report(syntax.member_name()->token(), message.view());
		@this.note(field->token(), rt::string_view("data member is declared here", 28));

		return rt::unique<SemanticExpression>();
	};

	Type* field_type = field->type();

	if (field_type->kind() == type_kind::reference) {
		@field_type = field_type->element();
	}
	else if (type->qualifier() == type_qualifier::immutable) {
		@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
	};

	var result = @this.node(semantic_kind::member, field_type, &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($object)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@this.unit->record_name(@this, @scope, @syntax, @*field, 4)) {
		@this.error(&@syntax, rt::string_view("navigation index storage is unavailable", 39));
		return rt::unique<SemanticExpression>();
	};
	@result.get()->bind(field, value_category::place);

	return @this.convert($result, expected, @syntax);
};

fn SemanticExpression::constant_truth(SemanticExpression& this, var bool& result) -> bool {
	if (this.type()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return false;
		};

		@result = value != 0.0;

		return true;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return false;
	};

	@result = value != 0;

	return true;
};

fn SemanticExpression::constant_integer(SemanticExpression& this, var u64& result) -> bool {
	if (this.kind() == semantic_kind::null_pointer) {
		@result = 0;

		return true;
	};

	if (!this.type()->representation()->kind().is_integer()) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_integer) {
		@result = this.type()->normalize_integer(this.integer());

		return true;
	};

	if (this.kind() == semantic_kind::name && this.entity() && this.entity()->kind() == entity_kind::enumerator) {
		@result = this.type()->normalize_integer(this.entity()->integer());

		return true;
	};

	if (this.kind() == semantic_kind::cast) {
		if (this.type()->kind() == type_kind::boolean) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.type()->representation()->kind().is_integer()) {
			return false;
		};

		if (this.item(0)->type()->kind() == type_kind::floating_point) {
			f64 value = 0.0;

			if (!this.item(0)->constant_real(@value)) {
				return false;
			};

			return this.type()->integer_from_real(value, @result);
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() == semantic_kind::unary) {
		if (this.operation() == token_kind::op_bang) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@truth = !truth;
			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = u64(0) - result;
		}
		else if (this.operation() == token_kind::op_tilde) {
			@result = ~result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() != semantic_kind::binary) {
		return false;
	};

	if (this.operation() == token_kind::op_and || this.operation() == token_kind::op_or) {
		bool first = false;

		if (!this.item(0)->constant_truth(@first)) {
			return false;
		};

		if (this.operation() == token_kind::op_and && !first || this.operation() == token_kind::op_or && first) {
			@result = static_cast<u64>($first);

			return true;
		};

		bool second = false;

		if (!this.item(1)->constant_truth(@second)) {
			return false;
		};

		@result = static_cast<u64>($second);

		return true;
	};

	if (this.item(0)->type()->kind() == type_kind::floating_point || this.item(1)->type()->kind() == type_kind::floating_point) {
		return this.real_comparison(@result);
	};

	u64 first = 0;
	u64 second = 0;

	if (!this.item(0)->constant_integer(@first) || !this.item(1)->constant_integer(@second)) {
		return false;
	};

	bool signed_ = this.item(0)->type()->representation()->kind() == type_kind::signed_integer;
	i64 signed_first = 0;
	i64 signed_second = 0;

	if (signed_) {
		@signed_first = this.item(0)->type()->signed_value(first);
		@signed_second = this.item(1)->type()->signed_value(second);
	};

	bool comparison = false;

	switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
		case token_kind::op_remainder: {
			if (!second) {
				return false;
			};

			if (signed_) {
				u32 bits = this.item(0)->type()->representation()->bits();

				if (bits && first == (u64(1) << static_cast<u64>(bits - 1)) && signed_second == -1) {
					return false;
				};

				i64 answer = 0;

				if (this.operation() == token_kind::op_slash) {
					@answer = signed_first / signed_second;
				}
				else {
					@answer = signed_first % signed_second;
				};

				@result = static_cast<u64>($answer);
			}
			else if (this.operation() == token_kind::op_slash) {
				@result = first / second;
			}
			else {
				@result = first % second;
			};

			break;
		};
		case token_kind::op_ampersand:
			@result = first & second;
			break;
		case token_kind::op_pipe:
			@result = first | second;
			break;
		case token_kind::op_caret:
			@result = first ^ second;
			break;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			Type* representation = this.item(0)->type()->representation();
			u64 width = static_cast<u64>(representation->bits());

			if (second >= width) {
				return false;
			};

			if (this.operation() == token_kind::op_shift_left) {
				@result = first << second;
			}
			else if (signed_) {
				i64 shifted = signed_first >> static_cast<i64>(second);
				@result = static_cast<u64>($shifted);
			}
			else {
				@result = first >> second;
			};

			break;
		case token_kind::op_equal:
			@comparison = first == second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_not_equal:
			@comparison = first != second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less:
			@comparison = first < second;

			if (signed_) {
				@comparison = signed_first < signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater:
			@comparison = first > second;

			if (signed_) {
				@comparison = signed_first > signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less_equal:
			@comparison = first <= second;

			if (signed_) {
				@comparison = signed_first <= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater_equal:
			@comparison = first >= second;

			if (signed_) {
				@comparison = signed_first >= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		default:
			return false;
	};

	@result = this.type()->normalize_integer(result);

	return true;
};

fn SemanticExpression::copy_constant(SemanticExpression& this) -> rt::unique<SemanticExpression> {
	if (this.type()->representation()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return rt::unique<SemanticExpression>();
		};

		var result = rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::literal_real, this.type(), this.token()));

		if (result.get()) {
			@result.get()->set_real(value);
		};

		return $result;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return rt::unique<SemanticExpression>();
	};

	var result = rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::literal_integer, this.type(), this.token()));

	if (result.get()) {
		@result.get()->set_integer(this.type()->normalize_integer(value));
	};

	return $result;
};

fn Type::integer_from_real(Type& this, f64 value, var u64& result) -> bool {
	Type* type = this.representation();

	if (type->kind() != type_kind::signed_integer && type->kind() != type_kind::unsigned_integer) {
		return false;
	};

	u32 bits = type->bits();

	if (!bits || bits > 64) {
		return false;
	};

	f64 limit = 1.0;
	u32 index = 0;
	u32 exponent = bits;

	if (type->kind() == type_kind::signed_integer) {
		@exponent = exponent - 1;
	};

	while (index < exponent) {
		@limit = limit * 2.0;
		@index = index + 1;
	};

	if (type->kind() == type_kind::signed_integer) {
		bool valid = value > -limit - 1.0 && value < limit;

		if (bits == 64) {
			@valid = value >= -limit && value < limit;
		};

		if (!valid) {
			return false;
		};

		i64 integer = static_cast<i64>(value);
		@result = type->normalize_integer(static_cast<u64>($integer));

		return true;
	};

	if (!(value > -1.0 && value < limit)) {
		return false;
	};

	if (value < 0.0) {
		@result = 0;

		return true;
	};

	@result = type->normalize_integer(static_cast<u64>(value));

	return true;
};

fn SemanticExpression::constant_real(SemanticExpression& this, var f64& result) -> bool {
	Type* type = this.type()->representation();

	if (type->kind().is_integer()) {
		u64 integer = 0;

		if (!this.constant_integer(@integer)) {
			return false;
		};

		if (type->kind() == type_kind::signed_integer) {
			@result = static_cast<f64>(type->signed_value(integer));

			return true;
		};

		@result = static_cast<f64>(integer);

		return true;
	};

	if (type->kind() != type_kind::floating_point) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_real) {
		@result = this.real();
	}
	else if (this.kind() == semantic_kind::cast) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::unary) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = -result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::binary) {
		f64 first = 0.0;
		f64 second = 0.0;

		if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
			return false;
		};

		switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
			if (!second) {
				return false;
			};

			@result = first / second;
			break;
		default:
			return false;
		};
	}
	else {
		return false;
	};

	if (type->bits() == 32) {
		f64 unrounded := result;
		f32 rounded = static_cast<f32>($unrounded);
		@result = static_cast<f64>($rounded);
	};

	return true;
};

fn SemanticExpression::real_comparison(SemanticExpression& this, var u64& result) -> bool {
	f64 first = 0.0;
	f64 second = 0.0;

	if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
		return false;
	};

	bool comparison = false;

	switch (this.operation()) {
	case token_kind::op_equal:
		@comparison = first == second;
		break;
	case token_kind::op_not_equal:
		@comparison = first != second;
		break;
	case token_kind::op_less:
		@comparison = first < second;
		break;
	case token_kind::op_less_equal:
		@comparison = first <= second;
		break;
	case token_kind::op_greater:
		@comparison = first > second;
		break;
	case token_kind::op_greater_equal:
		@comparison = first >= second;
		break;
	default:
		return false;
	};

	@result = static_cast<u64>($comparison);

	return true;
};

enum constant_flow : [u08] {
	next;
	returned;
	break_loop;
	continue_loop;
	failed;
};

struct ConstantCell {
	rt::unique<SemanticExpression> value;
};

struct ConstantBinding {
	var Entity* entity;
	var ConstantCell* cell;
};

struct ConstantCheckpoint {
	usize bindings;
	usize cells;
};

enum constant_result_kind : [u08] {
	value;
	reference;
};

enum constant_reference_kind : [u08] {
	stored;
	temporary;
	unsupported;
};

struct ConstantFrame {
	fn set_result_type(var ConstantFrame& this, Type& type);
	fn leave(var ConstantFrame& this, ConstantCheckpoint& checkpoint);
	fn return_reference(var ConstantFrame& this, var ConstantCell* cell);
	fn bind(var ConstantFrame& this, var Entity* entity, var ConstantCell* cell) -> bool;
	fn store(var ConstantFrame& this, var Entity* entity, rt::unique<SemanticExpression> value) -> bool;

	fn returns_reference(ConstantFrame& this) -> bool;
	fn checkpoint(ConstantFrame& this) -> ConstantCheckpoint;
	fn returned_reference(ConstantFrame& this) -> var ConstantCell*;
	fn find(ConstantFrame& this, var Entity* entity) -> var ConstantCell*;
	fn owns(ConstantFrame& this, ConstantCell& cell) -> bool;

private:
	rt::buffer<rt::unique<ConstantCell>> cells;
	rt::buffer<ConstantBinding> bindings;
	rt::optional_ref<ConstantCell> reference_result;
	constant_result_kind result_kind;
};

struct ConstantRegion {
	fn ConstantRegion(var ConstantRegion& this, var ConstantFrame& frame);
	fn ~ConstantRegion(var ConstantRegion& this);

private:
	var ConstantFrame* frame;
	ConstantCheckpoint checkpoint;
};

// Each invocation owns its cells. Reference parameters borrow caller cells; unrelated
// mutable global storage is never admitted into an evaluation frame.
struct ConstantEvaluator {
	fn integer(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var u64& result) -> bool;

private:
	fn tick(var ConstantEvaluator& this) -> bool;
	fn bind_reference(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& target, var ConstantFrame& origin, var Entity& binding, SemanticExpression& source) -> bool;
	fn place(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> var ConstantCell*;
	fn global_cell(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, var Entity& entity) -> var ConstantCell*;
	fn value(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn call(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var ConstantCell var*& reference) -> rt::unique<SemanticExpression>;
	fn execute(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn loop(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn selection(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn execute_children(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn initialize_sequence(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> bool;

	fn reference_kind(ConstantEvaluator& this, SemanticExpression& source) -> constant_reference_kind;
	fn literal(ConstantEvaluator& this, SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression>;
	fn copy(ConstantEvaluator& this, SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn contains_label(ConstantEvaluator& this, SemanticExpression& source) -> bool;

	usize steps;
	usize depth;
	ConstantFrame constants;
};

fn ConstantEvaluator::tick(var ConstantEvaluator& this) -> bool {
	@this.steps = this.steps + 1;

	return this.steps <= 100000;
};

fn ConstantEvaluator::reference_kind(ConstantEvaluator& this, SemanticExpression& source) -> constant_reference_kind {
	if (source.category() == value_category::consumable) {
		return constant_reference_kind::temporary;
	};

	switch (source.kind()) {
		case semantic_kind::name:
		case semantic_kind::call:
			return constant_reference_kind::stored;
		case semantic_kind::access:
		case semantic_kind::cast:
			return this.reference_kind(*source.item(0));
		case semantic_kind::sequence:
			return this.reference_kind(*source.item(2));
		default:
			return constant_reference_kind::unsupported;
	};
};

fn ConstantEvaluator::bind_reference(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& target, var ConstantFrame& origin, var Entity& binding, SemanticExpression& source) -> bool {
	constant_reference_kind kind = this.reference_kind(source);

	if (kind == constant_reference_kind::stored) {
		var ConstantCell* cell = @this.place(@analyzer, @origin, source);

		if (!cell || !cell->value.get()) {
			return false;
		};

		return @target.bind(&@binding, cell);
	};

	if (kind != constant_reference_kind::temporary || binding.type()->element()->qualifier() != type_qualifier::immutable) {
		return false;
	};

	var temporary = @this.value(@analyzer, @origin, source);

	if (!temporary.get()) {
		return false;
	};

	return @target.store(&@binding, $temporary);
};

fn ConstantEvaluator::execute_children(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	usize index = 0;
	while (index < source.size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(index), @returned);

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantEvaluator::initialize_sequence(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> bool {
	rt::unique<SemanticExpression> returned;

	if (@this.execute(@analyzer, @frame, *source.item(0), @returned) != constant_flow::next) {
		return false;
	};

	return @this.execute(@analyzer, @frame, *source.item(1), @returned) == constant_flow::next;
};

fn ConstantEvaluator::literal(ConstantEvaluator& this, SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression> {
	var result = rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::literal_integer, source.type(), source.token()));

	if (result.get()) {
		@result.get()->set_integer(source.type()->normalize_integer(value));
	};

	return $result;
};

fn ConstantEvaluator::copy(ConstantEvaluator& this, SemanticExpression& source) -> rt::unique<SemanticExpression> {
	return source.copy_constant();
};

fn ConstantEvaluator::integer(var ConstantEvaluator& this, var Analyzer& analyzer, SemanticExpression& expression, var u64& result) -> bool {
	@this.steps = 0;
	@this.depth = 0;
	@this.constants = ConstantFrame();
	ConstantFrame frame;
	var value = @this.value(@analyzer, @frame, expression);

	return value.get() && value.get()->constant_integer(@result);
};

fn ConstantEvaluator::global_cell(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, var Entity& entity) -> var ConstantCell* {
	if (entity.kind() != entity_kind::global || entity.type()->qualifier() != type_qualifier::immutable) {
		return nullptr;
	};

	var ConstantCell* cell = this.constants.find(&@entity);

	if (cell) {
		return cell;
	};

	if (this.depth >= 128 || !@analyzer.global_initializer(@entity) || !entity.body()) {
		return nullptr;
	};

	@this.depth = this.depth + 1;
	var value = @this.value(@analyzer, @frame, *entity.body());
	@this.depth = this.depth - 1;

	if (!value.get()) {
		return nullptr;
	};

	if (!@this.constants.store(&@entity, $value)) {
		return nullptr;
	};

	return this.constants.find(&@entity);
};

fn ConstantEvaluator::place(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> var ConstantCell* {
	if (!@this.tick()) {
		return nullptr;
	};

	if (source.kind() == semantic_kind::call && source.category() == value_category::place) {
		var ConstantCell* reference = nullptr;
		var value = @this.call(@analyzer, @frame, source, @reference);

		if (!value.get()) {
			return nullptr;
		};

		return $reference;
	};

	if (source.kind() == semantic_kind::name) {
		var ConstantCell* cell = frame.find(source.entity());
		var Entity* entity = source.entity();

		if (!cell && entity) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);
		};

		if (!cell || !cell->value.get()) {
			return nullptr;
		};

		return $cell;
	};

	if (source.kind() == semantic_kind::sequence && source.category() == value_category::place) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return nullptr;
		};

		return @this.place(@analyzer, @frame, *source.item(2));
	};

	if (source.kind() == semantic_kind::access || source.kind() == semantic_kind::cast && source.category() == value_category::place) {
		return @this.place(@analyzer, @frame, *source.item(0));
	};

	return nullptr;
};

fn ConstantEvaluator::value(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source) -> rt::unique<SemanticExpression> {
	if (!@this.tick()) {
		return rt::unique<SemanticExpression>();
	};

	semantic_kind kind = source.kind();

	if (kind == semantic_kind::noop) {
		return rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::noop, source.type(), source.token()));
	};

	if (kind == semantic_kind::sequence) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.value(@analyzer, @frame, *source.item(2));
	};

	if (kind == semantic_kind::name) {
		var ConstantCell* cell = frame.find(source.entity());

		if (cell && cell->value.get()) {
			return this.copy(*cell->value.get());
		};

		var Entity* entity = source.entity();

		if (entity && entity->kind() == entity_kind::global && entity->type()->qualifier() == type_qualifier::immutable) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);

			if (!cell || !cell->value.get()) {
				return rt::unique<SemanticExpression>();
			};

			return this.copy(*cell->value.get());
		};

		return this.copy(source);
	};

	if (kind == semantic_kind::access) {
		return @this.value(@analyzer, @frame, *source.item(0));
	};

	if (kind == semantic_kind::relocation) {
		var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!cell) {
			return rt::unique<SemanticExpression>();
		};

		var value = this.copy(*cell->value.get());
		@cell->value.reset(nullptr);

		return $value;
	};

	if (kind == semantic_kind::call) {
		var ConstantCell* reference = nullptr;

		return @this.call(@analyzer, @frame, source, @reference);
	};

	if (kind == semantic_kind::construction && source.type()->representation()->kind().is_numeric() && !source.entity()) {
		var SemanticExpression* arguments = source.item(0);

		if (!arguments->size()) {
			if (source.type()->representation()->kind() == type_kind::floating_point) {
				return rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::literal_real, source.type(), source.token()));
			};

			return this.literal(source, 0);
		};

		if (arguments->size() == 1) {
			return @this.value(@analyzer, @frame, *arguments->item(0));
		};

		return rt::unique<SemanticExpression>();
	};

	if (kind == semantic_kind::binary && (source.operation() == token_kind::op_assign || source.operation() == token_kind::op_copy)) {
		// Runtime assignment evaluates its source before designating destination storage.
		var assigned = @this.value(@analyzer, @frame, *source.item(1));
		var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!assigned.get() || !cell || this.constants.owns(*cell)) {
			return rt::unique<SemanticExpression>();
		};

		@cell->value = this.copy(*assigned.get());

		if (!cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		return $assigned;
	};

	if (kind == semantic_kind::binary || kind == semantic_kind::unary || kind == semantic_kind::cast) {
		var first = @this.value(@analyzer, @frame, *source.item(0));

		if (!first.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (kind == semantic_kind::binary && (source.operation() == token_kind::op_and || source.operation() == token_kind::op_or)) {
			bool truth = false;

			if (!first.get()->constant_truth(@truth)) {
				return rt::unique<SemanticExpression>();
			};

			if (source.operation() == token_kind::op_and && !truth || source.operation() == token_kind::op_or && truth) {
				return this.literal(source, static_cast<u64>($truth));
			};
		};

		var operation = rt::unique<SemanticExpression>(new var SemanticExpression($kind, source.type(), source.token()));

		if (!operation.get() || !@operation.get()->append(rt::unique<SemanticExpression>(@first.release()))) {
			return rt::unique<SemanticExpression>();
		};

		if (source.size() == 2) {
			var second = @this.value(@analyzer, @frame, *source.item(1));

			if (!second.get() || !@operation.get()->append(rt::unique<SemanticExpression>(@second.release()))) {
				return rt::unique<SemanticExpression>();
			};
		};

		return this.copy(*operation.get());
	};

	return this.copy(source);
};

fn ConstantEvaluator::call(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var ConstantCell var*& reference) -> rt::unique<SemanticExpression> {
	@reference = nullptr;
	var Entity* function = source.entity();

	if (!function || function->kind() != entity_kind::function || this.depth >= 128) {
		return rt::unique<SemanticExpression>();
	};

	@function = function->canonical();

	if (!@analyzer.function_body(function)) {
		return rt::unique<SemanticExpression>();
	};

	if (!function->body() || function->definition() != function_definition::user_defined || function->role() != function_role::ordinary || source.item(1)->size() != function->parameters().size()) {
		return rt::unique<SemanticExpression>();
	};

	ConstantFrame invocation;
	@invocation.set_result_type(*function->type()->signature().result());
	usize index = 0;
	while (index < function->parameters().size()) {
		var Entity* parameter = function->parameters().data()[index];
		var SemanticExpression* argument = source.item(1)->item(index);

		if (parameter->type()->kind() == type_kind::reference) {
			if (!@this.bind_reference(@analyzer, @invocation, @frame, @*parameter, *argument)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			var value = @this.value(@analyzer, @frame, *argument);

			if (!value.get() || !@invocation.store(parameter, rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};
		};

		@index = index + 1;
	};

	@this.depth = this.depth + 1;
	rt::unique<SemanticExpression> returned;
	constant_flow flow = @this.execute(@analyzer, @invocation, *function->body(), @returned);
	@this.depth = this.depth - 1;

	if (flow == constant_flow::next && source.type()->kind() == type_kind::void_type) {
		return rt::unique<SemanticExpression>(new var SemanticExpression(semantic_kind::noop, source.type(), source.token()));
	};

	if (flow != constant_flow::returned) {
		return rt::unique<SemanticExpression>();
	};

	if (function->type()->signature().result()->kind() == type_kind::reference) {
		var ConstantCell* cell = invocation.returned_reference();
		ConstantCheckpoint boundary;
		@invocation.leave(boundary);

		if (!cell || !cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		@reference = cell;

		return this.copy(*cell->value.get());
	};

	return $returned;
};

fn ConstantEvaluator::execute(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	if (!@this.tick()) {
		return constant_flow::failed;
	};

	switch (source.kind()) {
		case semantic_kind::noop:
		case semantic_kind::case_label:
			return constant_flow::next;
		case semantic_kind::brace: {
			var region = ConstantRegion(@frame);

			return @this.execute_children(@analyzer, @frame, source, @returned);
		};
		case semantic_kind::statements:
			return @this.execute_children(@analyzer, @frame, source, @returned);
		case semantic_kind::variable: {
			var Entity* entity = source.entity();

			if (entity->type()->kind() == type_kind::reference) {
				if (!@this.bind_reference(@analyzer, @frame, @frame, @*entity, *source.item(0))) {
					return constant_flow::failed;
				};
			}
			else {
				rt::unique<SemanticExpression> value;

				if (source.item(0)->kind() == semantic_kind::noop && entity->type()->representation()->kind().is_numeric()) {
					semantic_kind kind = semantic_kind::literal_integer;

					if (entity->type()->representation()->kind() == type_kind::floating_point) {
						@kind = semantic_kind::literal_real;
					};

					@value = rt::unique<SemanticExpression>(new var SemanticExpression($kind, entity->type(), source.token()));
				}
				else {
					@value = @this.value(@analyzer, @frame, *source.item(0));
				};

				if (!value.get() || !@frame.store(entity, rt::unique<SemanticExpression>(@value.release()))) {
					return constant_flow::failed;
				};
			};

			return constant_flow::next;
		};
		case semantic_kind::return_value:
			if (frame.returns_reference()) {
				var ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

				if (!cell) {
					return constant_flow::failed;
				};

				@frame.return_reference(cell);
				@returned = this.copy(*cell->value.get());
			}
			else {
				@returned = @this.value(@analyzer, @frame, *source.item(0));
			};

			if (!returned.get()) {
				return constant_flow::failed;
			};

			return constant_flow::returned;
		case semantic_kind::break_loop:
			return constant_flow::break_loop;
		case semantic_kind::continue_loop:
			return constant_flow::continue_loop;
		case semantic_kind::conditional: {
			var condition = @this.value(@analyzer, @frame, *source.item(0));
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			usize selected = 2;

			if (truth) {
				@selected = 1;
			};

			return @this.execute(@analyzer, @frame, *source.item(selected), @returned);
		};
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(@analyzer, @frame, source, @returned);
		case semantic_kind::switch_expression:
			return @this.selection(@analyzer, @frame, source, @returned);
		default: {
			var value = @this.value(@analyzer, @frame, source);

			if (!value.get()) {
				return constant_flow::failed;
			};

			return constant_flow::next;
		};
	};
};

fn ConstantEvaluator::loop(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	usize condition_index = 0;
	usize body_index = 1;

	if (source.kind() == semantic_kind::for_loop) {
		constant_flow initialization = @this.execute(@analyzer, @frame, *source.item(0), @returned);

		if (initialization != constant_flow::next) {
			return $initialization;
		};

		@condition_index = 1;
		@body_index = 3;
	};

	while (true) {
		if (!@this.tick()) {
			return constant_flow::failed;
		};

		var SemanticExpression* expression = source.item(condition_index);

		if (expression->kind() != semantic_kind::noop) {
			var condition = @this.value(@analyzer, @frame, *expression);
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			if (!truth) {
				return constant_flow::next;
			};
		};

		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(body_index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow == constant_flow::returned || flow == constant_flow::failed) {
			return $flow;
		};

		if (source.kind() == semantic_kind::for_loop) {
			constant_flow step = @this.execute(@analyzer, @frame, *source.item(2), @returned);

			if (step != constant_flow::next && step != constant_flow::continue_loop) {
				if (step == constant_flow::break_loop) {
					return constant_flow::next;
				};

				return $step;
			};
		};
	};
};

fn ConstantEvaluator::contains_label(ConstantEvaluator& this, SemanticExpression& source) -> bool {
	if (source.kind() == semantic_kind::case_label) {
		return true;
	};

	if (source.kind() == semantic_kind::switch_expression) {
		return false;
	};

	usize index = 0;
	while (index < source.size()) {
		if (this.contains_label(*source.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantEvaluator::selection(var ConstantEvaluator& this, var Analyzer& analyzer, var ConstantFrame& frame, SemanticExpression& source, var rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	var condition = @this.value(@analyzer, @frame, *source.item(0));
	u64 key = 0;

	if (!condition.get() || !condition.get()->constant_integer(@key) || source.item(1)->kind() != semantic_kind::brace) {
		return constant_flow::failed;
	};

	var SemanticExpression* body = source.item(1);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		var SemanticExpression* item = body->item(index);

		if (item->kind() != semantic_kind::case_label && this.contains_label(*item)) {
			// Nested labels require a resumable statement path, not linear fallthrough.
			return constant_flow::failed;
		};

		if (item->kind() == semantic_kind::case_label) {
			if (item->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (item->integer() == key) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	@index := selected;

	while (index < body->size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *body->item(index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantFrame::set_result_type(var ConstantFrame& this, Type& type) {
	@this.result_kind = constant_result_kind::value;

	if (type.kind() == type_kind::reference) {
		@this.result_kind = constant_result_kind::reference;
	};
};

fn ConstantFrame::returns_reference(ConstantFrame& this) -> bool {
	return this.result_kind == constant_result_kind::reference;
};

fn ConstantFrame::checkpoint(ConstantFrame& this) -> ConstantCheckpoint {
	ConstantCheckpoint checkpoint;
	@checkpoint.bindings = this.bindings.size();
	@checkpoint.cells = this.cells.size();

	return $checkpoint;
};

fn ConstantFrame::leave(var ConstantFrame& this, ConstantCheckpoint& checkpoint) {
	while (this.bindings.size() > checkpoint.bindings) {
		@this.bindings.pop_back();
	};

	usize index = checkpoint.cells;
	while (index < this.cells.size()) {
		// Keep stable tombstones for outstanding borrowed cells, but end the value's lifetime.
		@this.cells.data()[index].get()->value.reset(nullptr);
		@index = index + 1;
	};
};

fn ConstantFrame::return_reference(var ConstantFrame& this, var ConstantCell* cell) {
	@this.reference_result.reset();

	if (cell) {
		@this.reference_result.bind(@*cell);
	};
};

fn ConstantFrame::returned_reference(ConstantFrame& this) -> var ConstantCell* {
	return this.reference_result.get();
};

fn ConstantFrame::find(ConstantFrame& this, var Entity* entity) -> var ConstantCell* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].cell;
		};
	};

	return nullptr;
};

fn ConstantFrame::owns(ConstantFrame& this, ConstantCell& cell) -> bool {
	usize index = 0;
	while (index < this.cells.size()) {
		if (this.cells.data()[index].get() == &@cell) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantFrame::bind(var ConstantFrame& this, var Entity* entity, var ConstantCell* cell) -> bool {
	ConstantBinding binding;
	@binding.entity = $entity;
	@binding.cell = $cell;

	return @this.bindings.push_back($binding);
};

fn ConstantFrame::store(var ConstantFrame& this, var Entity* entity, rt::unique<SemanticExpression> value) -> bool {
	var cell = rt::unique<ConstantCell>::make();

	if (!cell.get()) {
		return false;
	};

	@cell.get()->value = $value;
	var ConstantCell* borrowed = cell.get();

	if (!@this.cells.push_back($cell)) {
		return false;
	};

	return @this.bind($entity, $borrowed);
};

fn ConstantRegion::ConstantRegion(var ConstantRegion& this, var ConstantFrame& frame) {
	@this.frame = &@frame;
	@this.checkpoint = frame.checkpoint();
};

fn ConstantRegion::~ConstantRegion(var ConstantRegion& this) {
	@this.frame->leave(this.checkpoint);
};

fn Type::representation(Type& this) -> Type* {
	Type* type = &@this;

	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration && type->entity()->underlying()) {
		@type = type->entity()->underlying();
	};

	return $type;
};

fn Type::has_layout(Type& this) -> bool {
	switch (this.kind()) {
		case type_kind::void_type:
		case type_kind::null_type:
		case type_kind::function:
			return false;
		case type_kind::array:
			return this.element()->has_layout();
		case type_kind::named: {
			var Entity* entity = this.entity();

			if (entity->kind() == entity_kind::enumeration) {
				return entity->underlying() && entity->underlying()->has_layout();
			};

			return entity->kind() == entity_kind::record && entity->declaration() && entity->declaration()->record_members()->kind() != syntax_kind::noop;
		};
	};

	return true;
};

fn Type::normalize_integer(Type& this, u64 value) -> u64 {
	Type* type = this.representation();

	if (!type->kind().is_integer()) {
		return $value;
	};

	u32 bits = type->bits();

	if (bits && bits < 64) {
		return value & ((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return $value;
};

fn Type::signed_value(Type& this, u64 value) -> i64 {
	Type* type = this.representation();
	u32 bits = type->bits();
	@value = type->normalize_integer(value);

	if (bits && bits < 64 && (value & (u64(1) << static_cast<u64>(bits - 1)))) {
		@value = value | ~((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return static_cast<i64>($value);
};

fn Type::derived_from(Type& this, Type& base) -> bool {
	if (this.kind() != type_kind::named || base.kind() != type_kind::named || this.entity()->kind() != entity_kind::record || base.entity()->kind() != entity_kind::record) {
		return false;
	};

	var Entity* current = this.entity();

	while (current->bases().size() == 1) {
		@current = current->bases().data()[0]->entity();

		if (current == base.entity()) {
			return true;
		};
	};

	return false;
};

enum template_input_kind : [u08] {
	explicit_arguments;
	deduced_arguments;
};

union TemplateInputStorage {
	var Syntax* explicit_arguments;
	rt::buffer<TemplateArgument>* deduced_arguments;
};

struct TemplateInput {
	fn TemplateInput(var TemplateInput& this, var Syntax& arguments);
	fn TemplateInput(var TemplateInput& this, rt::buffer<TemplateArgument>& arguments, Token& request);

	template_input_kind kind;
	TemplateInputStorage storage;
	Token request;
};

fn TemplateInput::TemplateInput(var TemplateInput& this, var Syntax& arguments) {
	@this.kind = template_input_kind::explicit_arguments;
	@this.storage.explicit_arguments = &@arguments;
	@this.request = arguments.token();
};

fn TemplateInput::TemplateInput(var TemplateInput& this, rt::buffer<TemplateArgument>& arguments, Token& request) {
	@this.kind = template_input_kind::deduced_arguments;
	@this.storage.deduced_arguments = &@arguments;
	@this.request = request;
};

struct TemplateInstance {
	var Entity* pattern;
	var Entity* entity;
	rt::buffer<TemplateArgument> arguments;
};

struct TemplateMemberDefinition {
	var Entity* owner;
	var Syntax* source;
	access_kind access;
};

struct TemplateEngine {
	fn clear(var TemplateEngine& this);
	fn collect(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& source) -> bool;
	fn editor_context(var TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& arguments) -> var Entity*;
	fn apply(var TemplateEngine& this, var Analyzer& analyzer, var Scope& lookup_scope, var Scope& argument_scope, var Syntax& source) -> var Entity*;
	fn deduce(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity*;
	fn call_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity*;
	fn specialize_call(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::optional_ref<Syntax> supplied, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity*;

	fn qualifier_dependent(TemplateEngine& this, var Syntax& declaration) -> bool;
	fn qualifier(TemplateEngine& this, var Scope& initial, var Syntax& syntax) -> Type*;
	fn instance(TemplateEngine& this, var Entity& entity) -> var TemplateInstance*;

private:
	fn auto_declaration(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Scope& bindings, var Syntax& declaration, access_kind access) -> bool;
	fn same_auto_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second) -> bool;
	fn same_type_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second, var Syntax& first_parameters, var Syntax& second_parameters) -> bool;
	fn pattern_owner(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity*;
	fn argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& input, var Syntax& parameter, var Entity& pattern, usize position, var TemplateArgument& result) -> bool;
	fn instantiation_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& entity, Token& request);
	fn argument_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& parameter, usize position);
	fn bind(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> bool;
	fn instantiate(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, TemplateInput& input) -> var Entity*;
	fn member_definitions(var TemplateEngine& this, var Analyzer& analyzer, var TemplateInstance& instance) -> bool;
	fn match(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, TypeUse& actual_use, var Syntax& parameters, var rt::buffer<TemplateArgument>& arguments) -> bool;

	fn same_parameter_expression(TemplateEngine& this, Syntax& first, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool;
	fn auto_argument(TemplateEngine& this, var Syntax& syntax, TypeUse& actual) -> TypeUse*;
	fn has_auto(TemplateEngine& this, var Syntax& syntax) -> bool;
	fn contains(TemplateEngine& this, var Syntax& root, var Syntax& syntax) -> bool;
	fn parameter_count(TemplateEngine& this, var Entity& pattern) -> usize;
	fn explicit_count(TemplateEngine& this, var Entity& pattern) -> usize;
	fn function_source(TemplateEngine& this, var Entity& pattern) -> var Syntax*;
	fn deduced_pattern(TemplateEngine& this, var Syntax& syntax, var Syntax& parameters, usize supplied) -> bool;
	fn qualifications(var TemplateEngine& this, var Analyzer& analyzer, var Syntax& declaration, rt::buffer<rt::unique<SemanticExpression>>& values, var rt::buffer<TemplateArgument>& arguments) -> bool;
	fn parameter_at(TemplateEngine& this, var Entity& pattern, usize index) -> var Syntax*;
	fn parameter_name(TemplateEngine& this, var Syntax& parameter) -> var Syntax*;
	fn declaration_name(TemplateEngine& this, var Syntax& declaration) -> var Syntax*;
	fn unqualified(TemplateEngine& this, var Syntax& initial) -> var Syntax*;
	fn argument_syntax(TemplateEngine& this, var Syntax& source, template_argument_kind kind) -> var Syntax*;

	rt::buffer<rt::unique<TemplateInstance>> instances;
	rt::buffer<TemplateMemberDefinition> definitions;
};

fn TemplateEngine::clear(var TemplateEngine& this) {
	@this.instances.clear();
	@this.definitions.clear();
};

fn TemplateEngine::instance(TemplateEngine& this, var Entity& entity) -> var TemplateInstance* {
	usize index = 0;
	while (index < this.instances.size()) {
		var TemplateInstance* instance = this.instances.data()[index].get();

		if (instance->entity == &@entity) {
			return $instance;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::declaration_name(TemplateEngine& this, var Syntax& declaration) -> var Syntax* {
	switch (declaration.kind()) {
		case syntax_kind::function:
			return declaration.function_name();
		case syntax_kind::record:
			return declaration.record_name();
		case syntax_kind::namespace_body:
			return declaration.namespace_name();
		case syntax_kind::using_alias:
			return declaration.alias_name();
		default:
			return nullptr;
	};
};

fn TemplateEngine::unqualified(TemplateEngine& this, var Syntax& initial) -> var Syntax* {
	var Syntax* name = &@initial;
	while (name && name->kind() == syntax_kind::qualified_name) {
		@name = name->right();
	};

	return $name;
};

fn TemplateEngine::pattern_owner(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::template_apply) {
		return @this.pattern_owner(@analyzer, @scope, @*name.callable());
	};

	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name.left());

		if (!owner || !@analyzer.resolve((var Entity*(owner)))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner) {
			return nullptr;
		};

		return @this.pattern_owner(@analyzer, @*owner->members(), @*name.right());
	};

	return scope.lookup(name.token().text());
};

fn TemplateEngine::collect(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& source) -> bool {
	var Syntax* declaration = &@source;

	if (source.kind() == syntax_kind::template_declaration) {
		@declaration = source.template_declaration();
	};

	var Syntax* name = this.declaration_name(@*declaration);

	if (!name) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("template requires a record, function, namespace, or alias declaration; received construct beginning with ", 105));
		@message.quoted(declaration->token().text());
		@analyzer.report(declaration->token(), message.view());

		return false;
	};

	if (source.kind() == syntax_kind::template_declaration && declaration->kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name->left());

		if (!owner || owner->kind() != entity_kind::template_pattern) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("template declaration '", 22));
			diagnostic_name(@message, *name);
			@message.text(rt::string_view("': qualified template member requires a declared owner template", 63));
			@analyzer.report(source.token(), message.view());

			return false;
		};

		TemplateMemberDefinition definition;
		@definition.owner = $owner;
		@definition.source = &@source;
		@definition.access = scope.access();

		if (!@this.definitions.push_back($definition)) {
			@analyzer.error(&@source, rt::string_view("template definition storage is unavailable", 42));

			return false;
		};

		return true;
	};

	if (name->kind() != syntax_kind::name) {
		if (source.kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
			var Entity* owner = @analyzer.lookup(@scope, @*name->left());
			if (!owner || !@analyzer.resolve((var Entity*(owner)))) {
				return false;
			};
			@owner = owner->member_owner();
			if (!owner || !owner->members()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("template declaration '", 22));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("': qualified function owner has no member scope", 47));
				@analyzer.report(source.token(), message.view());
				return false;
			};
			return @this.auto_declaration(@analyzer, @*owner->members(), @*owner->members(), @source, scope.access());
		};

		var message = DiagnosticMessage();
		@message.text(rt::string_view("template declaration '", 22));
		diagnostic_name(@message, *name);
		@message.text(rt::string_view("': requires an unqualified name", 31));
		@analyzer.report(source.token(), message.view());

		return false;
	};
	if (source.kind() == syntax_kind::function) {
		return @this.auto_declaration(@analyzer, @scope, @scope, @source, scope.access());
	};

	var Entity* previous = scope.local(name->token().text());

	if (previous && previous->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("template declaration '", 22));
		diagnostic_name(@message, *name);
		@message.text(rt::string_view("': name conflicts with another declaration", 42));
		@analyzer.report(source.token(), message.view());
		@analyzer.note(previous->token(), rt::string_view("conflicting declaration is here", 31));

		return false;
	};

	if (previous && declaration->kind() == syntax_kind::record) {
		var Syntax* existing = previous->declaration()->template_declaration();

		if (existing->kind() != syntax_kind::record || previous->declaration()->template_parameters()->size() != source.template_parameters()->size()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("template redeclaration '", 24));
			diagnostic_name(@message, *name);
			@message.text(rt::string_view("' has a different parameter list; previous declaration has ", 59));
			@message.number(previous->declaration()->template_parameters()->size());
			@message.text(rt::string_view(" parameters, received ", 22));
			@message.number(source.template_parameters()->size());
			@analyzer.report(source.token(), message.view());
			@analyzer.note(previous->token(), rt::string_view("previous template declaration is here", 37));

			return false;
		};

		if (declaration->record_members()->kind() != syntax_kind::noop) {
			if (existing->record_members()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("template declaration '", 22));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("': duplicate template definition", 32));
				@analyzer.report(source.token(), message.view());
				@analyzer.note(previous->token(), rt::string_view("previous template definition is here", 36));

				return false;
			};

			@previous->replace_declaration(&@source);
		};

		return true;
	};

	var Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &@source, &@scope);

	if (!pattern) {
		@analyzer.error(&@source, rt::string_view("template declaration storage is unavailable", 43));

		return false;
	};

	@pattern->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::same_parameter_expression(TemplateEngine& this, Syntax& first, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind() || first.size() != second.size()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (!first.size()) {
		usize index = 0;
		while (index < first_parameters.size()) {
			if (first_parameters.item(index)->parameter_name()->token().text() == first.token().text()) {
				return second_parameters.item(index)->parameter_name()->token().text() == second.token().text();
			};
			@index = index + 1;
		};
		return first.token().kind == second.token().kind && first.token().text() == second.token().text();
	};
	if (first.token().kind != second.token().kind) {
		return false;
	};
	usize index = 0;
	while (index < first.size()) {
		if (!this.same_parameter_expression(*first.item(index), *second.item(index), first_parameters, second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn TemplateEngine::same_type_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second, var Syntax& first_parameters, var Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (first.kind() == syntax_kind::type_auto || first.kind() == syntax_kind::type_pointer || first.kind() == syntax_kind::type_reference || (first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_mutable) || first.kind() == syntax_kind::type_array) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first.designated_type(), @second_scope, @*second.designated_type(), @first_parameters, @second_parameters)) {
			return false;
		};
		if ((first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_mutable)) {
			return this.same_parameter_expression(*first.qualifier_condition(), *second.qualifier_condition(), first_parameters, second_parameters);
		};
		if (first.kind() == syntax_kind::type_array) {
			return this.same_parameter_expression(*first.array_extent(), *second.array_extent(), first_parameters, second_parameters);
		};
		return true;
	};
	Type* first_type = @analyzer.type(@first_scope, @first);
	Type* second_type = @analyzer.type(@second_scope, @second);
	return first_type && first_type == second_type;
};

fn TemplateEngine::same_auto_signature(var TemplateEngine& this, var Analyzer& analyzer, var Scope& first_scope, var Syntax& first, var Scope& second_scope, var Syntax& second) -> bool {
	var Syntax* first_parameters = first.function_parameters();
	var Syntax* second_parameters = second.function_parameters();
	if (first_parameters->size() != second_parameters->size()) {
		return false;
	};
	usize index = 0;
	while (index < first_parameters->size()) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first_parameters->item(index)->parameter_type(), @second_scope, @*second_parameters->item(index)->parameter_type(), @*first_parameters, @*second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return @this.same_type_pattern(@analyzer, @first_scope, @*first.function_result(), @second_scope, @*second.function_result(), @*first_parameters, @*second_parameters);
};

fn TemplateEngine::auto_declaration(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Scope& bindings, var Syntax& declaration, access_kind access) -> bool {
	var Syntax* name = this.unqualified(@*declaration.function_name());
	usize index = 0;
	while (index < scope.bindings().size()) {
		var Entity* previous = scope.bindings().data()[index];
		@index = index + 1;
		if (previous->name() != name->token().text()) {
			continue;
		};
		if (previous->kind() != entity_kind::template_pattern || previous->declaration()->kind() != syntax_kind::function) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("function template '", 19));
			diagnostic_name(@message, *name);
			@message.text(rt::string_view("': name conflicts with another declaration", 42));
			@analyzer.report(declaration.token(), message.view());
			@analyzer.note(previous->token(), rt::string_view("previous declaration is here", 28));
			return false;
		};
		if (!@this.same_auto_signature(@analyzer, @*previous->resolution_scope(), @*previous->declaration(), @bindings, @declaration)) {
			continue;
		};
		if (declaration.function_body()->kind() != syntax_kind::noop) {
			if (previous->declaration()->function_body()->kind() != syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("function template '", 19));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("': duplicate function definition", 32));
				@analyzer.report(declaration.token(), message.view());
				@analyzer.note(previous->token(), rt::string_view("previous declaration is here", 28));
				return false;
			};
			@previous->replace_declaration(&@declaration);
			@previous->set_resolution_scope(&@bindings);
		};
		return true;
	};
	var Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &@declaration, &@scope);
	if (!pattern) {
		return false;
	};
	@pattern->set_resolution_scope(&@bindings);
	@pattern->set_access($access);
	@pattern->set_state(entity_state::ready);
	return true;
};

fn TemplateEngine::argument_syntax(TemplateEngine& this, var Syntax& source, template_argument_kind kind) -> var Syntax* {
	if (source.kind() != syntax_kind::ambiguity) {
		return &@source;
	};

	usize index = 0;
	while (index < source.size()) {
		var Syntax* candidate = source.item(index);
		bool type = candidate->kind() == syntax_kind::type_name || candidate->kind() == syntax_kind::type_pointer || candidate->kind() == syntax_kind::type_reference || candidate->kind() == syntax_kind::type_array || (candidate->kind() == syntax_kind::type_const || candidate->kind() == syntax_kind::type_mutable) || candidate->kind() == syntax_kind::type_function;

		if ((kind == template_argument_kind::type) == type) {
			return $candidate;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::argument(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& input, var Syntax& parameter, var Entity& pattern, usize position, var TemplateArgument& result) -> bool {
	var Syntax* source = &@input;
	if (parameter.token().kind == token_kind::kw_typename) {
		@result.kind = template_argument_kind::type;
		@source = this.argument_syntax(@*source, template_argument_kind::type);

		if (!source) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("template argument for type parameter ", 37));
			@message.quoted(this.parameter_name(@parameter)->token().text());
			@message.text(rt::string_view(" of template '", 14));
			diagnostic_entity(@message, pattern);
			@message.text(rt::string_view("' at position ", 14));
			@message.number(position + 1);
			@message.text(rt::string_view(" must name a type; received '", 29));
			diagnostic_name(@message, input);
			@message.text(rt::string_view("'", 1));
			@analyzer.report(input.token(), message.view());
			@analyzer.note(parameter.token(), rt::string_view("type parameter is declared here", 31));

			return false;
		};

		@result.type = @analyzer.type(@scope, @*source);

		if (!result.type) {
			this.argument_context(@analyzer, @pattern, @parameter, usize(position));
			return false;
		};

		TypeUse* use = @analyzer.semantic_unit()->describe_type(@analyzer, @scope, *source, *result.type);

		if (!use) {
			return false;
		};

		@result.type_use.bind(*use);

		return true;
	};

	@result.kind = template_argument_kind::value;
	@source = this.argument_syntax(@*source, template_argument_kind::value);
	Type* expected = @analyzer.type(@scope, @*parameter.template_parameter_type());

	if (!source || source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || (source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_mutable) || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("template argument for value parameter ", 38));
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(rt::string_view(" of template '", 14));
		diagnostic_entity(@message, pattern);
		@message.text(rt::string_view("' at position ", 14));
		@message.number(position + 1);
		@message.text(rt::string_view(" requires a value expression; received '", 40));
		diagnostic_name(@message, input);
		@message.text(rt::string_view("'", 1));
		@analyzer.report(input.token(), message.view());
		@analyzer.note(parameter.token(), rt::string_view("value parameter is declared here", 32));
		return false;
	};
	if (!expected) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return false;
	};

	var value = @analyzer.expression(@scope, @*source, rt::optional_ref<const Type>(*expected));

	if (!value.get()) {
		this.argument_context(@analyzer, @pattern, @parameter, usize(position));
		return false;
	};
	if (!@analyzer.constant_integer(*value.get(), @result.value)) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("template argument for value parameter ", 38));
		@message.quoted(this.parameter_name(@parameter)->token().text());
		@message.text(rt::string_view(" of template '", 14));
		diagnostic_entity(@message, pattern);
		@message.text(rt::string_view("' at position ", 14));
		@message.number(position + 1);
		@message.text(rt::string_view(" must be an integer constant of type '", 38));
		diagnostic_type(@message, *expected);
		@message.text(rt::string_view("'", 1));
		@message.text(rt::string_view("; supplied expression '", 23));
		diagnostic_name(@message, *source);
		@message.text(rt::string_view("' has type '", 12));
		diagnostic_type(@message, *value.get()->type());
		@message.text(rt::string_view("'", 1));
		@analyzer.report(source->token(), message.view());
		@analyzer.note(parameter.token(), rt::string_view("value parameter is declared here", 32));

		return false;
	};

	@result.type = $expected;

	return true;
};

fn TemplateEngine::argument_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& parameter, usize position) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text(rt::string_view("while checking argument ", 24));
	@message.number(position + 1);
	@message.text(rt::string_view(" for parameter ", 15));
	@message.quoted(this.parameter_name(@parameter)->token().text());
	@message.text(rt::string_view(" of template '", 14));
	diagnostic_entity(@message, pattern);
	@message.text(rt::string_view("'", 1));
	@analyzer.note(parameter.token(), message.view());
};

fn TemplateEngine::bind(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& parameter, TemplateArgument& argument) -> bool {
	var Syntax* name = this.parameter_name(@parameter);
	entity_kind kind = entity_kind::type_parameter;

	if (argument.kind == template_argument_kind::value) {
		@kind = entity_kind::enumerator;
	};

	var Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), &@parameter, &@scope);

	if (!entity) {
		@analyzer.error(&@parameter, rt::string_view("template parameter binding storage is unavailable", 49));

		return false;
	};

	@entity->set_type(argument.type);

	if (argument.type_use.has_value()) {
		@entity->set_type_use(argument.type_use.value());
	};

	@entity->set_integer(u64(argument.value));
	@entity->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::apply(var TemplateEngine& this, var Analyzer& analyzer, var Scope& lookup_scope, var Scope& argument_scope, var Syntax& source) -> var Entity* {
	var Entity* pattern = @analyzer.lookup(@lookup_scope, @*source.callable());

	if (pattern && pattern->kind() != entity_kind::template_pattern) {
		var TemplateInstance* current = this.instance(@*(var Entity*(pattern)));

		if (current) {
			@pattern = current->pattern;
		};
	};

	if (!pattern || pattern->kind() != entity_kind::template_pattern) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("template arguments for '", 24));
		diagnostic_name(@message, *source.callable());
		@message.text(rt::string_view("' require a template declaration", 32));
		if (pattern) {
			@message.text(rt::string_view("; resolved declaration is '", 27));
			diagnostic_entity(@message, *pattern);
			@message.text(rt::string_view("'", 1));
		};
		@analyzer.report(source.token(), message.view());
		if (pattern) {
			@analyzer.note(pattern->token(), rt::string_view("non-template declaration is here", 32));
		};

		return nullptr;
	};

	return @this.instantiate(@analyzer, @argument_scope, @*pattern, TemplateInput(@*source.arguments()));
};

fn TemplateEngine::instantiate(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, TemplateInput& input) -> var Entity* {
	if (analyzer.cancelled()) {
		return nullptr;
	};
	TemplateDeclarationValidator validator;

	if (!@validator.validate(@analyzer, @pattern)) {
		return nullptr;
	};

	var Syntax* wrapper = pattern.declaration();
	usize parameter_count = this.parameter_count(@pattern);

	if (input.kind == template_input_kind::explicit_arguments && input.storage.explicit_arguments->size() > this.explicit_count(@pattern)) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("too many template arguments for '", 33));
		diagnostic_entity(@message, pattern);
		@message.text(rt::string_view("': expected at most ", 20));
		@message.number(u64(this.explicit_count(@pattern)));
		@message.text(rt::string_view(", received ", 11));
		@message.number(u64(input.storage.explicit_arguments->size()));
		@analyzer.report(input.storage.explicit_arguments->token(), message.view());
		@analyzer.note(pattern.token(), rt::string_view("template is declared here", 25));

		return nullptr;
	};

	var Scope* bindings = @analyzer.semantic_unit()->create_scope(pattern.resolution_scope(), pattern.scope()->owner());

	if (!bindings) {
		@analyzer.error(wrapper, rt::string_view("template binding scope storage is unavailable", 45));

		return nullptr;
	};

	var instance = rt::unique<TemplateInstance>(new var TemplateInstance());

	if (!instance.get()) {
		@analyzer.error(wrapper, rt::string_view("template instance storage is unavailable", 40));

		return nullptr;
	};

	@instance.get()->pattern = &@pattern;
	usize index = 0;
	while (index < parameter_count) {
		var Syntax* parameter = this.parameter_at(@pattern, index);
		TemplateArgument argument;

		if (input.kind == template_input_kind::explicit_arguments && index < input.storage.explicit_arguments->size()) {
			if (!@this.argument(@analyzer, @scope, @*input.storage.explicit_arguments->item(index), @*parameter, @pattern, usize(index), @argument)) {
				return nullptr;
			};
		}
		else if (input.kind == template_input_kind::deduced_arguments && index < input.storage.deduced_arguments->size() && input.storage.deduced_arguments->data()[index].type) {
			@argument := input.storage.deduced_arguments->data()[index];
		}
		else {
			var Syntax* fallback = nullptr;

			if (parameter->kind() == syntax_kind::template_parameter) {
				@fallback = parameter->template_parameter_default();
			};

			if (!fallback || fallback->kind() == syntax_kind::absent) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("missing argument for template parameter ", 40));
				@message.quoted(this.parameter_name(@*parameter)->token().text());
				@message.text(rt::string_view(" of '", 5));
				diagnostic_entity(@message, pattern);
				@message.text(rt::string_view("'; the argument could not be deduced and has no default", 55));
				@analyzer.report(input.request, message.view());
				@analyzer.note(parameter->token(), rt::string_view("template parameter is declared here", 35));

				return nullptr;
			};

			if (!@this.argument(@analyzer, @*bindings, @*fallback, @*parameter, @pattern, usize(index), @argument)) {
				if (analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("while evaluating default argument for parameter ", 48));
					@message.quoted(this.parameter_name(@*parameter)->token().text());
					@message.text(rt::string_view(" of template '", 14));
					diagnostic_entity(@message, pattern);
					@message.text(rt::string_view("'", 1));
					@analyzer.note(fallback->token(), message.view());
					@analyzer.note(input.request, rt::string_view("template instantiation is requested here", 40));
				};
				return nullptr;
			};
		};

		if (index < this.explicit_count(@pattern) && !@this.bind(@analyzer, @*bindings, @*parameter, argument)) {
			return nullptr;
		};

		if (!@instance.get()->arguments.push_back($argument)) {
			@analyzer.error(wrapper, rt::string_view("template argument storage is unavailable", 40));
			return nullptr;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < this.instances.size()) {
		var TemplateInstance* existing = this.instances.data()[index].get();
		@index = index + 1;

		if (existing->pattern != &@pattern || existing->arguments.size() != instance.get()->arguments.size()) {
			continue;
		};

		usize argument = 0;

		while (argument < existing->arguments.size() && existing->arguments.data()[argument].same(instance.get()->arguments.data()[argument])) {
			@argument = argument + 1;
		};

		if (argument == existing->arguments.size()) {
			return existing->entity;
		};
	};

	var Syntax* declaration = wrapper;

	if (wrapper->kind() == syntax_kind::template_declaration) {
		@declaration = wrapper->template_declaration();
	};

	var Syntax* name = this.unqualified(@*this.declaration_name(@*declaration));
	entity_kind kind = entity_kind::record;

	if (declaration->kind() == syntax_kind::function) {
		@kind = entity_kind::function;
	}
	else if (declaration->kind() == syntax_kind::namespace_body) {
		@kind = entity_kind::namespace_body;
	}
	else if (declaration->kind() == syntax_kind::using_alias) {
		@kind = entity_kind::alias;
	};

	var Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), declaration, bindings);

	if (!entity) {
		@analyzer.error(declaration, rt::string_view("template instance storage is unavailable", 40));

		return nullptr;
	};

	@entity->set_access(pattern.access());
	@instance.get()->entity = entity;
	@entity->set_instantiated();
	if (!@analyzer.semantic_unit()->record_origin(@*entity, @pattern, instance.get()->arguments, this.explicit_count(@pattern))) {
		@analyzer.error(declaration, rt::string_view("template navigation storage is unavailable", 42));
		return nullptr;
	};
	var TemplateInstance* published = instance.get();

	if (!@this.instances.push_back($instance)) {
		@analyzer.error(declaration, rt::string_view("template instance storage is unavailable", 40));

		return nullptr;
	};

	// Publish the canonical identity before members can recursively refer to the instance.
	if (entity->kind() == entity_kind::record || entity->kind() == entity_kind::namespace_body) {
		var Scope* members = @analyzer.semantic_unit()->create_scope(bindings, (var Entity*(entity)));

		if (!members) {
			@analyzer.error(declaration, rt::string_view("template member scope storage is unavailable", 44));
			return nullptr;
		};

		@entity->set_members((var Scope*(members)));
		var Syntax* body = declaration->record_members();

		if (entity->kind() == entity_kind::namespace_body) {
			@body = declaration->namespace_members();
		};

		if (!@analyzer.collect(@*members, @*body) || !@this.member_definitions(@analyzer, @*published)) {
			this.instantiation_context(@analyzer, @*entity, input.request);
			return nullptr;
		};
	};

	if (!@analyzer.resolve((var Entity*(entity)))) {
		this.instantiation_context(@analyzer, @*entity, input.request);
		return nullptr;
	};

	return $entity;
};

fn TemplateEngine::instantiation_context(TemplateEngine& this, var Analyzer& analyzer, var Entity& entity, Token& request) {
	if (!analyzer.failed()) {
		return;
	};
	var message = DiagnosticMessage();
	@message.text(rt::string_view("while instantiating '", 21));
	diagnostic_entity(@message, entity);
	@message.text(rt::string_view("' requested here", 16));
	@analyzer.note(request, message.view());
};

fn TemplateEngine::member_definitions(var TemplateEngine& this, var Analyzer& analyzer, var TemplateInstance& instance) -> bool {
	usize index = 0;
	while (index < this.definitions.size()) {
		TemplateMemberDefinition definition := this.definitions.data()[index];
		@index = index + 1;

		if (definition.owner != instance.pattern) {
			continue;
		};

		var Syntax* parameters = definition.source->template_parameters();

		if (parameters->size() != instance.arguments.size()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("member definition '", 19));
			diagnostic_name(@message, *definition.source->template_declaration()->function_name());
			@message.text(rt::string_view("' has ", 6));
			@message.number(parameters->size());
			@message.text(rt::string_view(" template parameters; owning template '", 39));
			diagnostic_entity(@message, *instance.pattern);
			@message.text(rt::string_view("' requires ", 11));
			@message.number(instance.arguments.size());
			@analyzer.report(definition.source->token(), message.view());
			@analyzer.note(instance.pattern->token(), rt::string_view("owning template is declared here", 32));

			return false;
		};

		var Scope* bindings = @analyzer.semantic_unit()->create_scope(instance.entity->members(), (var Entity*(instance.entity)));

		if (!bindings) {
			@analyzer.error(definition.source, rt::string_view("template member binding scope storage is unavailable", 52));
			return false;
		};

		usize parameter = 0;

		while (parameter < parameters->size()) {
			if (!@this.bind(@analyzer, @*bindings, @*parameters->item(parameter), instance.arguments.data()[parameter])) {
				return false;
			};

			@parameter = parameter + 1;
		};

		var Syntax* declaration = definition.source->template_declaration();
		var Syntax* name = this.unqualified(@*declaration->function_name());
		entity_kind category = entity_kind::function;

		if (this.qualifier_dependent(@*declaration)) {
			if (!@this.auto_declaration(@analyzer, @*instance.entity->members(), @*bindings, @*declaration, access_kind(definition.access))) {
				return false;
			};
			continue;
		};

		var Entity* function = @analyzer.semantic_unit()->create_entity($category, name->token(), declaration, instance.entity->members());

		if (!function) {
			return false;
		};

		@function->set_access(access_kind(definition.access));
		@function->set_resolution_scope($bindings);

		if (function->kind() == entity_kind::template_pattern) {
			@function->set_state(entity_state::ready);
		};
	};

	return true;
};

fn TemplateEngine::match(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax, TypeUse& actual_use, var Syntax& parameters, var rt::buffer<TemplateArgument>& arguments) -> bool {
	Type* actual = &@actual_use.type();
	TypeUse* use = &@actual_use;

	if (syntax.kind() == syntax_kind::type_auto) {
		Type* unqualified = @analyzer.type_store()->qualified(*actual, type_qualifier::mutable);
		@use = @analyzer.semantic_unit()->retype_use(*use, *unqualified);

		return use && @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_name) {
		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_reference || (syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable)) {
		if (actual->kind() == type_kind::reference) {
			@actual = actual->element();
			@use = &@use->element();
		};

		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_pointer) {
		return actual->kind() == type_kind::pointer && @this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_array) {
		if (actual->kind() != type_kind::array || !@this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments)) {
			return false;
		};

		var Syntax* extent = syntax.array_extent();
		usize index = 0;
		while (index < parameters.size()) {
			var Syntax* parameter = parameters.item(index);

			if (parameter->token().kind != token_kind::kw_typename && parameter->template_parameter_name()->token().text() == extent->token().text()) {
				var TemplateArgument* argument = (@arguments).data() + index;
				Type* type = @analyzer.type(@scope, @*parameter->template_parameter_type());

				if (!type || argument->type && argument->value != actual->count()) {
					return false;
				};

				@argument->kind = template_argument_kind::value;
				@argument->type = $type;
				@argument->value = actual->count();

				return true;
			};

			@index = index + 1;
		};

		u64 expected = 0;

		return @analyzer.integer(@*extent, @expected) && expected == actual->count();
	};

	if (syntax.kind() == syntax_kind::name) {
		usize index = 0;
		while (index < parameters.size()) {
			var Syntax* parameter = parameters.item(index);

			if (parameter->token().kind == token_kind::kw_typename && parameter->template_parameter_name()->token().text() == syntax.token().text()) {
				var TemplateArgument* argument = (@arguments).data() + index;

				if (argument->type && argument->type != actual) {
					return false;
				};

				@argument->kind = template_argument_kind::type;
				@argument->type = $actual;

				if (!argument->type_use.has_value()) {
					@argument->type_use.bind(*use);
				};

				return true;
			};

			@index = index + 1;
		};
	};

	var Syntax* application = &@syntax;

	if (syntax.kind() == syntax_kind::qualified_name) {
		@application = syntax.right();
	};

	if (application->kind() == syntax_kind::template_apply && actual->kind() == type_kind::named) {
		var TemplateInstance* instance = this.instance(@*actual->entity());
		var Entity* pattern = @this.pattern_owner(@analyzer, @scope, @syntax);

		if (!instance || instance->pattern != pattern || application->arguments()->size() > instance->arguments.size()) {
			return false;
		};

		usize index = 0;
		while (index < application->arguments()->size()) {
			TemplateArgument& argument = instance->arguments.data()[index];
			var Syntax* argument_source = this.argument_syntax(@*application->arguments()->item(index), template_argument_kind(argument.kind));

			if (!argument_source) {
				return false;
			};

			if (argument.kind == template_argument_kind::type) {
				TypeUse* argument_use = argument.type_use.get();

				if (!argument_use) {
					@argument_use = @analyzer.semantic_unit()->canonical_use(*argument.type);
				};

				if (!argument_use || !@this.match(@analyzer, @scope, @*argument_source, *argument_use, @parameters, @arguments)) {
					return false;
				};
			}
			else {
				usize parameter = 0;

				while (parameter < parameters.size()) {
					var Syntax* name = parameters.item(parameter)->template_parameter_name();

					if (name->token().text() == argument_source->token().text()) {
						break;
					};

					@parameter = parameter + 1;
				};

				if (parameter < parameters.size()) {
					var TemplateArgument* bound = (@arguments).data() + parameter;

					if (bound->type && !bound->same(argument)) {
						return false;
					};

					@*bound := argument;
				}
				else {
					var value = @analyzer.expression(@scope, @*argument_source, rt::optional_ref<const Type>(*argument.type));
					u64 expected = 0;

					if (!value.get() || !@analyzer.constant_integer(*value.get(), @expected) || expected != argument.value) {
						return false;
					};
				};
			};

			@index = index + 1;
		};

		return true;
	};

	Type* expected = @analyzer.type(@scope, @syntax);

	return expected && expected == actual;
};

fn TemplateEngine::call_pattern(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name) -> var Entity* {
	var Syntax* application = &@name;
	var Scope* lookup = &@scope;

	if (name.kind() == syntax_kind::qualified_name) {
		@application = name.right();
	};

	if (application->kind() != syntax_kind::template_apply) {
		return nullptr;
	};

	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @analyzer.lookup(@scope, @*name.left());

		if (!owner || !@analyzer.resolve((var Entity*(owner)))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner || !owner->members()) {
			return nullptr;
		};

		@lookup = owner->members();
	};

	var Entity* pattern = @analyzer.lookup(@*lookup, @*application->callable());

	if (!pattern || pattern->kind() != entity_kind::template_pattern || !this.function_source(@*pattern)) {
		return nullptr;
	};

	return pattern;
};

fn TemplateEngine::deduced_pattern(TemplateEngine& this, var Syntax& syntax, var Syntax& parameters, usize supplied) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		usize index = supplied;
		while (index < parameters.size()) {
			if (parameters.item(index)->template_parameter_name()->token().text() == syntax.token().text()) {
				return true;
			};

			@index = index + 1;
		};
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.deduced_pattern(@*syntax.item(index), @parameters, usize(supplied))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifications(var TemplateEngine& this, var Analyzer& analyzer, var Syntax& declaration, rt::buffer<rt::unique<SemanticExpression>>& values, var rt::buffer<TemplateArgument>& arguments) -> bool {
	usize index = 0;
	while (index < values.size()) {
		var Syntax* parameter = declaration.function_parameters()->item(index);
		var SemanticExpression* value = values.data()[index].get();
		@index = index + 1;

		if (!this.has_auto(@*parameter->parameter_type())) {
			continue;
		};

		TypeUse* use = value->type_use().get();

		if (!use) {
			@use = @analyzer.semantic_unit()->canonical_use(*value->type());
		};

		if (!use) {
			return false;
		};

		@use = this.auto_argument(@*parameter->parameter_type(), *use);

		if (!use) {
			return false;
		};

		bool readonly = use->type().qualifier() == type_qualifier::immutable || parameter->parameter_type()->kind() == syntax_kind::type_reference && !value->mutable_access();
		type_qualifier qualifier = type_qualifier::mutable;

		if (readonly) {
			@qualifier = type_qualifier::immutable;
		};

		TemplateArgument argument;
		@argument.kind = template_argument_kind::value;
		@argument.type = @analyzer.type_store()->qualified(*analyzer.type_store()->find_primitive(rt::string_view("bool", 4)), $qualifier);
		@argument.value = static_cast<u64>($readonly);

		if (!argument.type || !@arguments.push_back($argument)) {
			return false;
		};
	};

	return true;
};

fn TemplateEngine::deduce(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity* {
	return @this.specialize_call(@analyzer, @scope, @pattern, rt::optional_ref<Syntax>(), values, @request);
};

fn TemplateEngine::specialize_call(var TemplateEngine& this, var Analyzer& analyzer, var Scope& scope, var Entity& pattern, rt::optional_ref<Syntax> supplied, rt::buffer<rt::unique<SemanticExpression>>& values, var Syntax& request) -> var Entity* {
	var Syntax* declaration = this.function_source(@pattern);

	if (!declaration || declaration->function_parameters()->size() != values.size()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("function template '", 19));
		diagnostic_entity(@message, pattern);
		if (declaration) {
			@message.text(rt::string_view("' expects ", 10));
			@message.number(u64(declaration->function_parameters()->size()));
			@message.text(rt::string_view(" call arguments, received ", 26));
			@message.number(u64(values.size()));
			@message.text(rt::string_view(" with types ", 12));
			diagnostic_arguments(@message, values);
		}
		else {
			@message.text(rt::string_view("' does not declare a callable function", 38));
		};
		@analyzer.report(request.token(), message.view());
		@analyzer.note(pattern.token(), rt::string_view("template is declared here", 25));
		return nullptr;
	};

	usize visible = this.explicit_count(@pattern);
	usize provided = 0;

	if (supplied.has_value()) {
		@provided = supplied.value().size();
	};

	if (provided > visible) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("too many template arguments for '", 33));
		diagnostic_entity(@message, pattern);
		@message.text(rt::string_view("': expected at most ", 20));
		@message.number(u64(visible));
		@message.text(rt::string_view(", received ", 11));
		@message.number(u64(provided));
		@analyzer.report(request.token(), message.view());
		@analyzer.note(pattern.token(), rt::string_view("template is declared here", 25));
		return nullptr;
	};

	rt::buffer<TemplateArgument> arguments;
	usize index = 0;
	while (index < visible) {
		TemplateArgument argument;

		if (index < provided && !@this.argument(@analyzer, @scope, @*supplied.value().item(index), @*this.parameter_at(@pattern, index), @pattern, usize(index), @argument)) {
			return nullptr;
		};

		if (!@arguments.push_back($argument)) {
			@analyzer.error(&@request, rt::string_view("template deduction argument storage is unavailable", 50));
			return nullptr;
		};

		@index = index + 1;
	};

	if (visible) {
		var Syntax* parameters = pattern.declaration()->template_parameters();
		@index = 0;

		while (index < values.size()) {
			var Syntax* parameter = declaration->function_parameters()->item(index)->parameter_type();
			var SemanticExpression* value = values.data()[index].get();
			@index = index + 1;

			if (!this.deduced_pattern(@*parameter, @*parameters, usize(provided))) {
				continue;
			};

			TypeUse* use = value->type_use().get();

			if (!use) {
				@use = @analyzer.semantic_unit()->canonical_use(*value->type());
			};

			if (!use || !@this.match(@analyzer, @*pattern.scope(), @*parameter, *use, @*parameters, @arguments)) {
				if (!analyzer.failed()) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("cannot deduce template arguments for '", 38));
					diagnostic_entity(@message, pattern);
					@message.text(rt::string_view("' with arguments ", 17));
					diagnostic_arguments(@message, values);
					@message.text(rt::string_view(": call argument ", 16));
					@message.number(u64(index));
					@message.text(rt::string_view(" of type '", 10));
					diagnostic_type(@message, *value->type());
					@message.text(rt::string_view("' does not match parameter ", 27));
					@message.number(u64(index));
					var Syntax* parameter_name = declaration->function_parameters()->item(index - 1)->parameter_name();
					if (parameter_name && parameter_name->kind() != syntax_kind::absent) {
						@message.text(rt::string_view(" ", 1));
						@message.quoted(parameter_name->token().text());
					};
					@analyzer.report(request.token(), message.view());
					@analyzer.note(pattern.token(), rt::string_view("function template is declared here", 34));
					@analyzer.note(parameter->token(), rt::string_view("deduction failed for this parameter type", 40));
					usize binding = 0;
					while (binding < visible && binding < arguments.size()) {
						TemplateArgument& bound = arguments.data()[binding];
						var Syntax* bound_parameter = this.parameter_at(@pattern, binding);
						@binding = binding + 1;
						if (!bound.type) {
							continue;
						};
						var binding_message = DiagnosticMessage();
						@binding_message.text(rt::string_view("template parameter ", 19));
						@binding_message.quoted(this.parameter_name(@*bound_parameter)->token().text());
						if (bound.kind == template_argument_kind::type) {
							@binding_message.text(rt::string_view(" is bound to type '", 19));
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text(rt::string_view("'", 1));
						}
						else {
							@binding_message.text(rt::string_view(" is bound to value ", 19));
							if (bound.type->kind() == type_kind::signed_integer && bound.type->signed_value(bound.value) < 0) {
								@binding_message.text(rt::string_view("-", 1));
								@binding_message.number(u64(0) - u64(bound.type->signed_value(bound.value)));
							}
							else {
								@binding_message.number(bound.value);
							};
							@binding_message.text(rt::string_view(" of type '", 10));
							diagnostic_type(@binding_message, *bound.type);
							@binding_message.text(rt::string_view("'", 1));
						};
						@analyzer.note(bound_parameter->token(), binding_message.view());
					};
				};
				return nullptr;
			};
		};
	};

	if (!@this.qualifications(@analyzer, @*declaration, values, @arguments)) {
		if (!analyzer.failed()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("cannot deduce automatic qualification for function template '", 61));
			diagnostic_entity(@message, pattern);
			@message.text(rt::string_view("' with argument types ", 22));
			diagnostic_arguments(@message, values);
			@analyzer.report(request.token(), message.view());
			@analyzer.note(pattern.token(), rt::string_view("function template is declared here", 34));
		};
		return nullptr;
	};

	return @this.instantiate(@analyzer, @scope, @pattern, TemplateInput(arguments, request.token()));
};

fn TemplateEngine::has_auto(TemplateEngine& this, var Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_auto) {
		return true;
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.has_auto(@*syntax.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::contains(TemplateEngine& this, var Syntax& root, var Syntax& syntax) -> bool {
	if (&@root == &@syntax) {
		return true;
	};

	usize index = 0;
	while (index < root.size()) {
		if (this.contains(@*root.item(index), @syntax)) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifier_dependent(TemplateEngine& this, var Syntax& declaration) -> bool {
	return declaration.kind() == syntax_kind::function && this.has_auto(@*declaration.function_parameters());
};

fn TemplateEngine::function_source(TemplateEngine& this, var Entity& pattern) -> var Syntax* {
	var Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};

	if (source->kind() != syntax_kind::function) {
		return nullptr;
	};

	return source;
};

fn TemplateEngine::explicit_count(TemplateEngine& this, var Entity& pattern) -> usize {
	var Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		return source->template_parameters()->size();
	};

	return 0;
};

fn TemplateEngine::parameter_count(TemplateEngine& this, var Entity& pattern) -> usize {
	usize count = this.explicit_count(@pattern);
	var Syntax* source = this.function_source(@pattern);

	if (!source) {
		return $count;
	};

	usize index = 0;
	while (index < source->function_parameters()->size()) {
		if (this.has_auto(@*source->function_parameters()->item(index)->parameter_type())) {
			@count = count + 1;
		};

		@index = index + 1;
	};

	return $count;
};

fn TemplateEngine::parameter_at(TemplateEngine& this, var Entity& pattern, usize position) -> var Syntax* {
	usize visible = this.explicit_count(@pattern);

	if (position < visible) {
		return pattern.declaration()->template_parameters()->item(position);
	};

	var Syntax* source = this.function_source(@pattern);

	if (!source) {
		return nullptr;
	};

	usize index = 0;
	usize parameter = visible;
	while (index < source->function_parameters()->size()) {
		var Syntax* candidate = source->function_parameters()->item(index);
		@index = index + 1;

		if (!this.has_auto(@*candidate->parameter_type())) {
			continue;
		};

		if (parameter == position) {
			return $candidate;
		};

		@parameter = parameter + 1;
	};

	return nullptr;
};

fn TemplateEngine::parameter_name(TemplateEngine& this, var Syntax& parameter) -> var Syntax* {
	if (parameter.kind() == syntax_kind::parameter) {
		return parameter.parameter_name();
	};

	return parameter.template_parameter_name();
};

fn TemplateEngine::qualifier(TemplateEngine& this, var Scope& initial, var Syntax& syntax) -> Type* {
	var Scope* scope = &@initial;
	while (scope) {
		var Entity* owner = scope->owner();
		var TemplateInstance* instance = nullptr;

		if (owner) {
			@instance = this.instance(@*owner);
		};

		if (instance && owner->declaration()->kind() == syntax_kind::function && this.function_source(@*instance->pattern)) {
			usize index = this.explicit_count(@*instance->pattern);
			while (index < instance->arguments.size()) {
				var Syntax* parameter = this.parameter_at(@*instance->pattern, index);

				if (this.contains(@*parameter->parameter_type(), @syntax)) {
					return instance->arguments.data()[index].type;
				};

				@index = index + 1;
			};
		};

		@scope = scope->parent();
	};

	return nullptr;
};

fn TemplateEngine::auto_argument(TemplateEngine& this, var Syntax& syntax, TypeUse& actual) -> TypeUse* {
	if (syntax.kind() == syntax_kind::type_auto) {
		return &@actual;
	};

	if (syntax.kind() == syntax_kind::type_reference) {
		if (actual.type().kind() == type_kind::reference) {
			return this.auto_argument(@*syntax.designated_type(), actual.element());
		};

		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	if (syntax.kind() == syntax_kind::type_pointer && actual.type().kind() == type_kind::pointer || syntax.kind() == syntax_kind::type_array && actual.type().kind() == type_kind::array) {
		return this.auto_argument(@*syntax.designated_type(), actual.element());
	};

	if ((syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable)) {
		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	return nullptr;
};

fn TemplateArgument::same(TemplateArgument& this, TemplateArgument& other) -> bool {
	return this.kind == other.kind && this.type == other.type && (this.kind == template_argument_kind::type || this.value == other.value);
};

fn TemplateEngine::editor_context(var TemplateEngine& this, var Analyzer& analyzer, var Entity& pattern, var Syntax& arguments) -> var Entity* {
	return @this.instantiate(@analyzer, @*pattern.resolution_scope(), @pattern, TemplateInput(@arguments));
};

fn Analyzer::editor_template_context(var Analyzer& this, var SemanticUnit& unit, var SourceFile& source, usize anchor, var Syntax& arguments, var rt::string& label) -> bool {
	@this.unit = &@unit;
	var Entity* pattern = nullptr;
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* candidate = unit.entities().data()[index].get();
		Token token = candidate->token();
		if (candidate->kind() == entity_kind::template_pattern && token.source == &@source && token.begin == anchor) {
			@pattern = candidate;
			break;
		};
		@index = index + 1;
	};
	if (!pattern) {
		@this.unit = nullptr;
		Token token;
		@this.report(token, rt::string_view("the selected template declaration is no longer available", 56));
		return false;
	};
	var Entity* instance = @this.templates.editor_context(@this, @*pattern, @arguments);
	if (!instance) {
		@this.unit = nullptr;
		return false;
	};
	@index = 0;
	while (index < unit.entities().size() && !this.failed()) {
		var Entity* entity = unit.entities().data()[index].get();
		@index = index + 1;
		var Scope* scope = entity->scope();
		while (scope && scope->owner() != instance) {
			@scope = scope->parent();
		};
		if (entity != instance && !scope) {
			continue;
		};
		if (!@this.resolve(entity)) {
			break;
		};
		if (entity->kind() == entity_kind::function && entity->origin() != declaration_origin::compiler_supplied && entity->definition() != function_definition::deleted && !@this.function_body(entity)) {
			break;
		};
	};
	if (!this.failed()) {
		var detail = DiagnosticMessage();
		diagnostic_entity(@detail, *instance);
		@label = rt::string(detail.view());
	};
	@this.unit = nullptr;
	return !this.failed();
};

enum template_validation_role : [u08] {
	dependent_type;
	template_type;
	dependent_value;
	value;
};

struct TemplateValidationSymbol {
	Token name;
	template_validation_role role;
};

struct TemplateDeclarationValidator {
	fn validate(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Entity& pattern) -> bool;

private:
	fn dependent(TemplateDeclarationValidator& this, Syntax& syntax) -> bool;
	fn lookup(TemplateDeclarationValidator& this, Token& name) -> TemplateValidationSymbol*;
	fn remember(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Syntax& name, template_validation_role role) -> bool;
	fn restore(var TemplateDeclarationValidator& this, usize checkpoint, usize frame);
	fn type_names(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> bool;
	fn declaration(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> bool;
	fn members(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& owner, var Syntax& body) -> bool;
	fn certain(TemplateDeclarationValidator& this, var Syntax& syntax) -> var Syntax*;

	rt::buffer<TemplateValidationSymbol> symbols;
	usize frame_start;
};

fn TemplateDeclarationValidator::lookup(TemplateDeclarationValidator& this, Token& name) -> TemplateValidationSymbol* {
	usize index = this.symbols.size();
	while (index) {
		@index = index - 1;
		if (this.symbols.data()[index].name.same(name)) {
			return &@this.symbols.data()[index];
		};
	};
	return nullptr;
};

fn TemplateDeclarationValidator::dependent(TemplateDeclarationValidator& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		TemplateValidationSymbol* symbol = this.lookup(syntax.token());
		return symbol && symbol->role != template_validation_role::value;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.dependent(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn TemplateDeclarationValidator::remember(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Syntax& name, template_validation_role role) -> bool {
	if (name.kind() != syntax_kind::name) {
		return true;
	};
	usize index = this.frame_start;
	while (index < this.symbols.size()) {
		TemplateValidationSymbol& previous = this.symbols.data()[index];
		if (previous.name.same(name.token())) {
			if ((previous.role == template_validation_role::dependent_type || previous.role == template_validation_role::template_type) && (role == template_validation_role::dependent_type || role == template_validation_role::template_type)) {
				return true;
			};
			var message = DiagnosticMessage();
			@message.text(rt::string_view("duplicate declaration of '", 26));
			diagnostic_name(@message, name);
			@message.text(rt::string_view("' in template member scope", 26));
			@analyzer.report(name.token(), message.view());
			@analyzer.note(previous.name, rt::string_view("previous declaration is here", 28));
			return false;
		};
		@index = index + 1;
	};
	TemplateValidationSymbol symbol;
	@symbol.name = name.token();
	@symbol.role = $role;
	if (!@this.symbols.push_back($symbol)) {
		@analyzer.error(&@name, rt::string_view("out of memory storing template declaration names", 48));
		return false;
	};
	return true;
};

fn TemplateDeclarationValidator::restore(var TemplateDeclarationValidator& this, usize checkpoint, usize frame) {
	while (this.symbols.size() > checkpoint) {
		@this.symbols.pop_back();
	};
	@this.frame_start = $frame;
};

fn TemplateDeclarationValidator::certain(TemplateDeclarationValidator& this, var Syntax& syntax) -> var Syntax* {
	if (syntax.kind() != syntax_kind::ambiguity) {
		return &@syntax;
	};
	if (this.dependent(syntax)) {
		return nullptr;
	};
	var Syntax* selected = nullptr;
	usize index = 0;
	while (index < syntax.size()) {
		var Syntax* candidate = syntax.item(index);
		syntax_kind kind = candidate->kind();
		if (kind == syntax_kind::variable || kind == syntax_kind::function || kind == syntax_kind::record || kind == syntax_kind::enumeration || kind == syntax_kind::using_alias || kind == syntax_kind::template_declaration) {
			if (selected) {
				return nullptr;
			};
			@selected = candidate;
		};
		@index = index + 1;
	};
	return selected;
};

fn TemplateDeclarationValidator::type_names(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_name) {
		if (this.dependent(syntax)) {
			var Syntax* name = syntax.designated_type();
			if (name->kind() == syntax_kind::name) {
				TemplateValidationSymbol* symbol = this.lookup(name->token());
				if (symbol && symbol->role == template_validation_role::template_type) {
					return @analyzer.semantic_unit()->record_classification(name->token(), 6, 0);
				};
			};
			return true;
		};
		var Syntax* name = syntax.designated_type();
		// Applications have their own argument roles and are checked when instantiated.
		if (name->kind() == syntax_kind::template_apply || name->kind() == syntax_kind::qualified_name) {
			return true;
		};
		TemplateValidationSymbol* symbol = this.lookup(name->token());
		if (symbol && symbol->role == template_validation_role::value) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("'", 1));
			diagnostic_name(@message, *name);
			@message.text(rt::string_view("' names a value; a type is required here", 40));
			@analyzer.report(name->token(), message.view());
			return false;
		};
		var Entity* entity = @analyzer.lookup(@scope, @*name);
		if (!entity || !entity->denotes_type()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("'", 1));
			diagnostic_name(@message, *name);
			@message.text(rt::string_view("' does not name a type entity", 29));
			@analyzer.report(name->token(), message.view());
			return false;
		};
		return true;
	};
	if (syntax.kind() == syntax_kind::type_pointer || syntax.kind() == syntax_kind::type_reference || (syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_mutable) || syntax.kind() == syntax_kind::type_array) {
		return @this.type_names(@analyzer, @scope, @*syntax.designated_type());
	};
	if (syntax.kind() == syntax_kind::type_function) {
		if (!@this.type_names(@analyzer, @scope, @*syntax.function_type_result())) {
			return false;
		};
		var Syntax* parameters = syntax.function_type_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			if (!@this.type_names(@analyzer, @scope, @*parameters->item(index)->parameter_type())) {
				return false;
			};
			@index = index + 1;
		};
	};
	return true;
};

fn TemplateDeclarationValidator::members(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& owner, var Syntax& body) -> bool {
	usize checkpoint = this.symbols.size();
	usize frame = this.frame_start;
	@this.frame_start = checkpoint;
	usize index = 0;
	while (index < body.size()) {
		var Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::record || member->kind() == syntax_kind::enumeration || member->kind() == syntax_kind::using_alias) {
			var Syntax* name = member->record_name();
			if (member->kind() == syntax_kind::using_alias) {
				@name = member->alias_name();
			};
			if (!@this.remember(@analyzer, @*name, template_validation_role::dependent_type)) {
				return false;
			};
		};
	};
	@index = 0;
	while (index < body.size()) {
		var Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::function && owner.kind() == syntax_kind::record) {
			var Syntax* name = member->function_name();
			bool special = name->kind() == syntax_kind::unary || name->kind() == syntax_kind::operator_name && name->operator_token().kind == token_kind::op_assign || name->kind() == syntax_kind::conversion_name || name->kind() == syntax_kind::name && name->token().same(owner.record_name()->token());
			if (special && (!member->function_parameters()->size() || !member->function_parameters()->item(0)->parameter_name()->token().is(rt::string_view("this", 4)))) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("instance function '", 19));
				diagnostic_name(@message, *owner.record_name());
				@message.text(rt::string_view("::", 2));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("' requires an explicit first reference parameter named 'this'", 61));
				@analyzer.report(name->token(), message.view());
				return false;
			};
		};
		if (!@this.declaration(@analyzer, @scope, @*member)) {
			return false;
		};
		if (member->kind() == syntax_kind::variable && !@this.remember(@analyzer, @*member->variable_name(), template_validation_role::value)) {
			return false;
		};
	};
	@this.restore($checkpoint, $frame);
	return true;
};

fn TemplateDeclarationValidator::declaration(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Scope& scope, var Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::template_declaration) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		var Syntax* parameters = syntax.template_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			var Syntax* parameter = parameters->item(index);
			var Syntax* type = parameter->template_parameter_type();
			usize prior = 0;
			while (prior < index) {
				if (parameters->item(prior)->template_parameter_name()->token().same(parameter->template_parameter_name()->token())) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("duplicate template parameter '", 30));
					diagnostic_name(@message, *parameter->template_parameter_name());
					@message.text(rt::string_view("' at position ", 14));
					@message.number(index + 1);
					@analyzer.report(parameter->template_parameter_name()->token(), message.view());
					@analyzer.note(parameters->item(prior)->template_parameter_name()->token(), rt::string_view("previous template parameter is declared here", 44));
					return false;
				};
				@prior = prior + 1;
			};
			if (type->kind() != syntax_kind::absent && !this.dependent(*type)) {
				Type* resolved = @analyzer.type(@scope, @*type);
				if (!resolved) {
					return false;
				};
				if (!resolved->kind().is_integer()) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("non-type template parameter '", 29));
					diagnostic_name(@message, *parameter->template_parameter_name());
					@message.text(rt::string_view("' at position ", 14));
					@message.number(index + 1);
					@message.text(rt::string_view(" requires an integral type; received '", 38));
					diagnostic_type(@message, *resolved);
					@message.text(rt::string_view("'", 1));
					@analyzer.report(parameter->template_parameter_name()->token(), message.view());
					return false;
				};
			};
			template_validation_role role = template_validation_role::template_type;
			if (type->kind() != syntax_kind::absent) {
				@role = template_validation_role::dependent_value;
			};
			if (!@this.remember(@analyzer, @*parameter->template_parameter_name(), $role)) {
				return false;
			};
			if (type->kind() == syntax_kind::absent && !@analyzer.semantic_unit()->record_classification(parameter->template_parameter_name()->token(), 6, 1)) {
				return false;
			};
			@index = index + 1;
		};
		bool valid = @this.declaration(@analyzer, @scope, @*syntax.template_declaration());
		@this.restore($checkpoint, $frame);
		return valid;
	};
	if (syntax.kind() == syntax_kind::record) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		if (!@this.remember(@analyzer, @*syntax.record_name(), template_validation_role::dependent_type)) {
			return false;
		};
		bool valid = @this.members(@analyzer, @scope, @syntax, @*syntax.record_members());
		@this.restore($checkpoint, $frame);
		return valid;
	};
	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.members(@analyzer, @scope, @syntax, @*syntax.namespace_members());
	};
	if (syntax.kind() == syntax_kind::variable) {
		return @this.type_names(@analyzer, @scope, @*syntax.variable_type());
	};
	if (syntax.kind() == syntax_kind::using_alias) {
		return @this.type_names(@analyzer, @scope, @*syntax.alias_type());
	};
	if (syntax.kind() == syntax_kind::function) {
		if (!@this.type_names(@analyzer, @scope, @*syntax.function_result())) {
			return false;
		};
		usize index = 0;
		while (index < syntax.function_parameters()->size()) {
			if (!@this.type_names(@analyzer, @scope, @*syntax.function_parameters()->item(index)->parameter_type())) {
				return false;
			};
			@index = index + 1;
		};
	};
	return true;
};

fn TemplateDeclarationValidator::validate(var TemplateDeclarationValidator& this, var Analyzer& analyzer, var Entity& pattern) -> bool {
	@this.symbols.clear();
	@this.frame_start = 0;
	if (!pattern.declaration() || !pattern.resolution_scope()) {
		return true;
	};
	return @this.declaration(@analyzer, @*pattern.resolution_scope(), @*pattern.declaration());
};

struct TypeUse;

// A label's semantic spelling can be generated independently of its source location.
struct ParameterLabel {
	fn ParameterLabel(var ParameterLabel& this, Token& location, rt::string_view& spelling);

	fn location(ParameterLabel& this) -> Token;
	fn text(ParameterLabel& this) -> rt::string_view;
	fn is(ParameterLabel& this, rt::string_view& spelling) -> bool;

private:
	Token source_location;
	rt::string_view spelling;
};

struct ParameterUse {
	fn ParameterUse(var ParameterUse& this, rt::optional<ParameterLabel> name, TypeUse& type);

	fn name(ParameterUse& this) -> rt::optional<ParameterLabel>&;
	fn type(ParameterUse& this) -> TypeUse&;

private:
	rt::optional<ParameterLabel> parameter_name;
	TypeUse* parameter_type;
};

struct FunctionUse {
	fn FunctionUse(var FunctionUse& this, rt::buffer<ParameterUse> parameters, TypeUse& result);

	fn parameters(FunctionUse& this) -> rt::buffer<ParameterUse>&;
	fn result(FunctionUse& this) -> TypeUse&;

private:
	rt::buffer<ParameterUse> arguments;
	TypeUse* return_type;
};

union TypeUseDetail {
	TypeUse* element;
	FunctionUse* callable;
};

// A declaration's type spelling supplies metadata without changing canonical type identity.
// Nominal and primitive uses are leaves. Indirect/array uses carry their element use;
// callable uses carry parameter labels and nested uses in a separately owned FunctionUse.
struct TypeUse {
	fn TypeUse(var TypeUse& this, Type& type);
	fn TypeUse(var TypeUse& this, Type& type, TypeUse& element);
	fn TypeUse(var TypeUse& this, Type& type, FunctionUse& callable);

	fn type(TypeUse& this) -> Type&;
	fn element(TypeUse& this) -> TypeUse&;
	fn callable(TypeUse& this) -> FunctionUse&;
	fn effective(TypeUse& this) -> TypeUse&;

private:
	Type* canonical_type;
	TypeUseDetail detail;
};

fn ParameterLabel::ParameterLabel(var ParameterLabel& this, Token& location, rt::string_view& spelling) {
	@this.source_location := location;
	@this.spelling = rt::string_view(spelling.data(), spelling.size());
};

fn ParameterLabel::location(ParameterLabel& this) -> Token {
	return Token(this.source_location);
};

fn ParameterLabel::text(ParameterLabel& this) -> rt::string_view {
	return rt::string_view(this.spelling.data(), this.spelling.size());
};

fn ParameterLabel::is(ParameterLabel& this, rt::string_view& spelling) -> bool {
	return this.spelling == spelling;
};

fn ParameterUse::ParameterUse(var ParameterUse& this, rt::optional<ParameterLabel> name, TypeUse& type) {
	@this.parameter_name = $name;
	@this.parameter_type = &@type;
};

fn ParameterUse::name(ParameterUse& this) -> rt::optional<ParameterLabel>& {
	return this.parameter_name;
};

fn ParameterUse::type(ParameterUse& this) -> TypeUse& {
	return *this.parameter_type;
};

fn FunctionUse::FunctionUse(var FunctionUse& this, rt::buffer<ParameterUse> parameters, TypeUse& result) {
	@this.arguments = $parameters;
	@this.return_type = &@result;
};

fn FunctionUse::parameters(FunctionUse& this) -> rt::buffer<ParameterUse>& {
	return this.arguments;
};

fn FunctionUse::result(FunctionUse& this) -> TypeUse& {
	return *this.return_type;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type) {
	@this.canonical_type = &@type;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type, TypeUse& element) {
	@this.canonical_type = &@type;
	@this.detail.element = &@element;
};

fn TypeUse::TypeUse(var TypeUse& this, Type& type, FunctionUse& callable) {
	@this.canonical_type = &@type;
	@this.detail.callable = &@callable;
};

fn TypeUse::type(TypeUse& this) -> Type& {
	return *this.canonical_type;
};

fn TypeUse::element(TypeUse& this) -> TypeUse& {
	return *this.detail.element;
};

fn TypeUse::callable(TypeUse& this) -> FunctionUse& {
	return *this.detail.callable;
};

fn TypeUse::effective(TypeUse& this) -> TypeUse& {
	if (this.type().kind() == type_kind::reference) {
		return this.element();
	};

	return this;
};

fn SemanticUnit::retain_use(var SemanticUnit& this, rt::unique<TypeUse> use) -> TypeUse* {
	TypeUse* borrowed = use.get();

	if (!borrowed || !@this.type_uses.push_back(rt::unique<TypeUse>(@use.release()))) {
		return nullptr;
	};

	return $borrowed;
};

fn SemanticUnit::leaf_use(var SemanticUnit& this, Type& type) -> TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array || type.kind() == type_kind::function) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new var TypeUse(type)));
};

fn SemanticUnit::indirect_use(var SemanticUnit& this, Type& type, TypeUse& element) -> TypeUse* {
	if (type.kind() != type_kind::pointer && type.kind() != type_kind::reference && type.kind() != type_kind::array) {
		return nullptr;
	};

	if (type.element() != &@element.type()) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new var TypeUse(type, element)));
};

fn SemanticUnit::function_use(var SemanticUnit& this, Type& type, rt::buffer<ParameterUse> parameters, TypeUse& result) -> TypeUse* {
	if (type.kind() != type_kind::function || type.signature().parameters().size() != parameters.size()) {
		return nullptr;
	};

	if (type.signature().result() != &@result.type()) {
		return nullptr;
	};

	usize index = 0;
	while (index < parameters.size()) {
		if (type.signature().parameters().data()[index] != &@parameters.data()[index].type().type()) {
			return nullptr;
		};

		@index = index + 1;
	};

	var function = rt::unique<FunctionUse>(new var FunctionUse($parameters, result));
	var FunctionUse* borrowed = function.get();

	if (!borrowed || !@this.function_uses.push_back(rt::unique<FunctionUse>(@function.release()))) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new var TypeUse(type, *borrowed)));
};

fn SemanticUnit::canonical_use(var SemanticUnit& this, Type& type) -> TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		TypeUse* element = @this.canonical_use(*type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function) {
		return @this.leaf_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		TypeUse* element = @this.canonical_use(*type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	TypeUse* result = @this.canonical_use(*type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::retype_use(var SemanticUnit& this, TypeUse& source, Type& type) -> TypeUse* {
	if (&@source.type() == &@type) {
		return &@source;
	};

	if (source.type().kind() != type.kind()) {
		return @this.canonical_use(type);
	};

	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		TypeUse* element = @this.retype_use(source.element(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function || source.callable().parameters().size() != type.signature().parameters().size()) {
		return @this.canonical_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		ParameterUse& previous = source.callable().parameters().data()[index];
		TypeUse* element = @this.retype_use(previous.type(), *type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(previous.name()), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	TypeUse* result = @this.retype_use(source.callable().result(), *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_type(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, Type& type) -> TypeUse* {
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_name || (kind == syntax_kind::type_const || kind == syntax_kind::type_mutable) || kind == syntax_kind::type_auto) {
		return @this.describe_type(@analyzer, @scope, *syntax.designated_type(), type);
	};

	if ((kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array) && (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array)) {
		TypeUse* element = @this.describe_type(@analyzer, @scope, *syntax.designated_type(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		var Entity* entity = @analyzer.lookup(@scope, @*(const_cast<var Syntax*>(&@syntax)));

		if (entity && entity->type_use().has_value()) {
			return @this.retype_use(entity->type_use().value(), type);
		};
	};

	if ((kind != syntax_kind::type_function && kind != syntax_kind::function) || type.kind() != type_kind::function) {
		return @this.canonical_use(type);
	};

	var Syntax* inputs = syntax.function_type_parameters();
	var Syntax* output = syntax.function_type_result();

	if (kind == syntax_kind::function) {
		@inputs = syntax.function_parameters();
		@output = syntax.function_result();
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		var Syntax* parameter = inputs->item(index);
		TypeUse* element = @this.describe_type(@analyzer, @scope, *parameter->parameter_type(), *type.signature().parameters().data()[index]);

		if (!element) {
			return nullptr;
		};

		rt::optional<ParameterLabel> name;

		if (parameter->parameter_name()->kind() != syntax_kind::absent) {
			Token location = parameter->parameter_name()->token();
			@name = rt::optional<ParameterLabel>(ParameterLabel(location, location.text()));
		};

		if (!@parameters.push_back(ParameterUse($name, *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	TypeUse* result = @this.describe_type(@analyzer, @scope, *output, *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_entity(var SemanticUnit& this, var Analyzer& analyzer, var Entity& entity) -> bool {
	if (!entity.type() || entity.type_use().has_value() || entity.kind() == entity_kind::template_pattern) {
		return true;
	};

	var Syntax* source = entity.declaration();
	TypeUse* use = nullptr;

	if (entity.kind() == entity_kind::function) {
		rt::buffer<ParameterUse> parameters;
		usize index = 0;
		while (index < entity.parameters().size()) {
			var Entity* parameter = entity.parameters().data()[index];

			if (!@this.describe_entity(@analyzer, @*parameter) || !parameter->type_use().has_value()) {
				return false;
			};

			rt::optional<ParameterLabel> name;

			if (!parameter->name().empty()) {
				@name = rt::optional<ParameterLabel>(ParameterLabel(parameter->token(), parameter->name()));
			};

			if (!@parameters.push_back(ParameterUse($name, parameter->type_use().value()))) {
				return false;
			};

			@index = index + 1;
		};

		TypeUse* result = nullptr;

		if (source && source->kind() == syntax_kind::function) {
			var Scope* signature_scope = entity.members();

			if (entity.parameters().size()) {
				@signature_scope = entity.parameters().data()[0]->resolution_scope();
			};

			@result = @this.describe_type(@analyzer, @*signature_scope, *source->function_result(), *entity.type()->signature().result());
		}
		else {
			@result = @this.canonical_use(*entity.type()->signature().result());
		};

		if (!result) {
			return false;
		};

		@use = @this.function_use(*entity.type(), $parameters, *result);
	}
	else if (!source) {
		@use = @this.canonical_use(*entity.type());
	}
	else {
		if (entity.kind() == entity_kind::alias) {
			@source = source->alias_type();
		}
		else if (entity.kind() == entity_kind::local || entity.kind() == entity_kind::global || entity.kind() == entity_kind::field) {
			@source = source->variable_type();
		}
		else if (entity.kind() == entity_kind::parameter) {
			@source = source->parameter_type();
		};

		@use = @this.describe_type(@analyzer, @*entity.resolution_scope(), *source, *entity.type());
	};

	if (!use) {
		return false;
	};

	@entity.set_type_use(*use);

	return true;
};

fn SemanticUnit::available_use(SemanticUnit& this, SemanticExpression& expression) -> TypeUse* {
	if (expression.type_use().has_value()) {
		return expression.type_use().get();
	};

	var Entity* binding = expression.entity();

	if (binding && binding->type_use().has_value()) {
		return &@binding->type_use().value().effective();
	};

	return nullptr;
};

fn SemanticUnit::describe_expression(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, var SemanticExpression& expression) -> bool {
	if (expression.type_use().has_value()) {
		return true;
	};

	semantic_kind kind = expression.kind();

	if (kind == semantic_kind::variable) {
		var Entity* entity = expression.entity();
		TypeUse* use = nullptr;
		var Syntax* declaration = entity->declaration();

		if (declaration->kind() == syntax_kind::variable && declaration->variable_type()->kind() != syntax_kind::absent) {
			@use = @this.describe_type(@analyzer, @scope, *declaration->variable_type(), *entity->type());
		}
		else {
			@use = this.available_use(*expression.item(0));
		};

		if (use) {
			@entity->set_type_use(*use);
		};

		return true;
	};

	if (expression.type()->kind() == type_kind::void_type) {
		return true;
	};

	TypeUse* use = this.available_use(expression);

	if (kind == semantic_kind::allocation && syntax.kind() == syntax_kind::allocation) {
		var Syntax* allocated = syntax.allocation_type();

		if (allocated->kind() == syntax_kind::type_array) {
			@allocated = allocated->designated_type();
		};

		TypeUse* element = @this.describe_type(@analyzer, @scope, *allocated, *expression.type()->element());

		if (element) {
			@use = @this.indirect_use(*expression.type(), *element);
		};
	}
	else if (kind == semantic_kind::construction && syntax.kind() == syntax_kind::call) {
		@use = @this.describe_type(@analyzer, @scope, *syntax.callable(), *expression.type());
	}
	else if (kind == semantic_kind::address) {
		TypeUse* child = this.available_use(*expression.item(0));

		if (child) {
			@use = @this.indirect_use(*expression.type(), *child);
		};
	}
	else if (kind == semantic_kind::access || kind == semantic_kind::relocation || kind == semantic_kind::cast) {
		@use = this.available_use(*expression.item(0));

		if (syntax.kind() == syntax_kind::cast) {
			Type* target = @analyzer.type(@scope, @*syntax.cast_type());

			if (!target) {
				return false;
			};

			@use = @this.describe_type(@analyzer, @scope, *syntax.cast_type(), *target);

			if (use) {
				@use = &@use->effective();
			};
		};
	}
	else if (kind == semantic_kind::dereference || kind == semantic_kind::index) {
		TypeUse* child = this.available_use(*expression.item(0));

		if (child && (child->type().kind() == type_kind::pointer || child->type().kind() == type_kind::array)) {
			@use = &@child->element().effective();
		};
	}
	else if (kind == semantic_kind::binary) {
		if (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy || expression.type()->kind() == type_kind::pointer) {
			@use = this.available_use(*expression.item(0));

			if (!use || use->type().kind() != expression.type()->kind()) {
				@use = this.available_use(*expression.item(1));
			};
		};
	}
	else if (kind == semantic_kind::sequence && expression.size()) {
		@use = this.available_use(*expression.item(expression.size() - 1));
	}
	else if (kind == semantic_kind::call) {
		TypeUse* callable = this.available_use(*expression.item(0));

		if (callable && callable->type().kind() == type_kind::pointer) {
			@callable = &@callable->element();
		};

		if (callable && callable->type().kind() == type_kind::function) {
			@use = &@callable->callable().result().effective();
		};
	};

	if (use) {
		@use = @this.retype_use(*use, *expression.type());
	}
	else {
		@use = @this.canonical_use(*expression.type());
	};

	if (!use) {
		return false;
	};

	@expression.set_type_use(*use);

	return true;
};

fn Analyzer::resolve(var Analyzer& this, var Entity* entity) -> bool {
	if (!@this.resolve_impl(entity)) {
		return false;
	};

	return @this.unit->describe_entity(@this, @*entity);
};

fn Analyzer::expression(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!@this.unit->record_scope(@scope, @syntax)) {
		@this.error(&@syntax, rt::string_view("semantic scope metadata storage is unavailable", 46));
		return rt::unique<SemanticExpression>();
	};
	var result = @this.expression_impl(@scope, @syntax, expected);

	if (!result.get()) {
		return $result;
	};

	if (!@this.unit->record_call(@scope, @syntax, *result.get()) || !@this.unit->describe_expression(@this, @scope, syntax, @*result.get())) {
		@this.error(&@syntax, rt::string_view("could not describe the expression's type use", 44));

		return rt::unique<SemanticExpression>();
	};

	return $result;
};

struct AnalysisSource {
	rt::string_view path;
	rt::string_view text;
};

struct SourceRange {
	fn SourceRange(var SourceRange& this) : [default];
	fn SourceRange(var SourceRange& this, SourceRange& other) : [implicit, default];

	usize source;
	usize begin;
	usize end;
};

struct NavigationSymbol {
	fn NavigationSymbol(var NavigationSymbol& this) : [default];
	fn NavigationSymbol(var NavigationSymbol& this, NavigationSymbol& other) : [implicit, default];

	u64 id;
	u64 container;
	u64 origin;
	u32 kind;
	u32 flags;
	SourceRange declaration;
	SourceRange definition;
	rt::string_view name;
	rt::string_view detail;
};

struct NavigationOccurrence {
	fn NavigationOccurrence(var NavigationOccurrence& this) : [default];
	fn NavigationOccurrence(var NavigationOccurrence& this, NavigationOccurrence& other) : [implicit, default];

	SourceRange range;
	u64 symbol;
	u64 context;
	u32 roles;
};

struct LanguageDiagnostic {
	fn LanguageDiagnostic(var LanguageDiagnostic& this) : [default];
	fn LanguageDiagnostic(var LanguageDiagnostic& this, LanguageDiagnostic& other) : [implicit, default];

	SourceRange range;
	u32 severity;
	rt::string_view message;
};

struct NavigationScope {
	fn NavigationScope(var NavigationScope& this) : [default];
	fn NavigationScope(var NavigationScope& this, NavigationScope& other) : [implicit, default];
	u64 id;
	u64 parent;
	u64 context;
	SourceRange range;
};

struct NavigationBinding {
	u64 scope;
	u64 symbol;
};

struct NavigationCall {
	u64 symbol;
	u64 scope;
	u64 context;
	SourceRange range;
	SourceRange callee;
	bool bound_receiver;
	rt::buffer<u64> candidates;
	rt::buffer<SourceRange> arguments;
};

struct NavigationReceiver {
	u64 scope;
	u64 context;
	SourceRange range;
	SourceRange root;
	SourceRange selector;
	rt::buffer<u64> candidates;
};

struct NavigationParameter {
	rt::string_view name;
	rt::string_view detail;
};

struct NavigationParameterEntry {
	NavigationParameter value;
	rt::string detail;
};

struct NavigationEntry {
	var Entity* entity;
	u64 member_scope;
	NavigationSymbol value;
	rt::string name;
	rt::string detail;
	rt::buffer<rt::unique<NavigationParameterEntry>> parameters;
};

struct NavigationClassification {
	SourceRange range;
	u32 type;
	u32 modifiers;
};

struct NavigationIndex {
	fn register_source(var NavigationIndex& this, var SourceFile& source, usize index) -> bool;
	fn build(var NavigationIndex& this, SemanticUnit& semantics) -> bool;
	fn symbol_count(NavigationIndex& this) -> usize;
	fn symbol_at(NavigationIndex& this, usize index) -> NavigationSymbol*;
	fn occurrence_count(NavigationIndex& this) -> usize;
	fn occurrence_at(NavigationIndex& this, usize index) -> NavigationOccurrence*;
	fn range(NavigationIndex& this, Token& token) -> SourceRange;
	fn syntax_range(NavigationIndex& this, Syntax& syntax) -> SourceRange;
	fn scope_count(NavigationIndex& this) -> usize;
	fn scope_at(NavigationIndex& this, usize index) -> NavigationScope*;
	fn classification_count(NavigationIndex& this) -> usize;
	fn classification_at(NavigationIndex& this, usize index) -> NavigationClassification*;
	fn type_symbol(NavigationIndex& this, u64 symbol) -> u64;
	fn semantic_token_type(NavigationIndex& this, u64 symbol) -> u32;
	fn symbol_readonly(NavigationIndex& this, u64 symbol) -> bool;
	fn member_scope(NavigationIndex& this, u64 symbol) -> u64;
	fn accessible(NavigationIndex& this, u64 symbol, u64 scope) -> bool;
	fn binding_count(NavigationIndex& this) -> usize;
	fn binding_at(NavigationIndex& this, usize index) -> NavigationBinding*;
	fn parameter_count(NavigationIndex& this, u64 symbol) -> usize;
	fn parameter_at(NavigationIndex& this, u64 symbol, usize index) -> NavigationParameter*;
	fn receiver_count(NavigationIndex& this) -> usize;
	fn receiver_at(NavigationIndex& this, usize index) -> NavigationReceiver*;
	fn call_count(NavigationIndex& this) -> usize;
	fn call_at(NavigationIndex& this, usize index) -> NavigationCall*;

private:
	fn scope_id(var NavigationIndex& this, Scope& scope) -> u64;
	fn receiver_candidates(var NavigationIndex& this, var NavigationReceiver& site, Entity& owner, Entity& visible_owner, Scope& scope) -> bool;
	fn build_receivers(var NavigationIndex& this, SemanticUnit& semantics) -> bool;
	fn build_contexts(var NavigationIndex& this, SemanticUnit& semantics) -> bool;
	fn symbol_id(NavigationIndex& this, Entity* entity) -> u64;
	fn declaration_name(NavigationIndex& this, var Syntax& declaration) -> Token;
	fn symbol_kind(NavigationIndex& this, Entity& entity) -> u32;

	rt::buffer<rt::unique<NavigationEntry>> symbols;
	rt::buffer<NavigationOccurrence> occurrences;
	rt::buffer<NavigationClassification> classifications;
	rt::buffer<NavigationScope> scope_locations;
	rt::buffer<NavigationBinding> bindings;
	rt::buffer<rt::unique<NavigationCall>> calls;
	rt::buffer<rt::unique<NavigationReceiver>> receivers;
	rt::unordered_map<Scope*, u64> scope_ids;
	rt::buffer<Scope*> scope_records;
	rt::unordered_map<Entity*, u64> ids;
	rt::unordered_map<SourceFile*, usize> source_ids;
};

fn NavigationIndex::range(NavigationIndex& this, Token& token) -> SourceRange {
	SourceRange result;
	@result.source = usize::max;
	if (!token.source) {
		return $result;
	};
	SourceFile* source = token.source;
	usize* id = this.source_ids.find(source);
	if (id) {
		@result.source = *id;
		@result.begin = token.begin;
		@result.end = token.begin + token.length;
	};
	return $result;
};

fn NavigationIndex::symbol_id(NavigationIndex& this, Entity* entity) -> u64 {
	if (!entity) {
		return 0;
	};
	Entity* canonical = entity->canonical();
	u64* id = this.ids.find(canonical);
	if (!id) {
		return 0;
	};
	return *id;
};

fn NavigationIndex::declaration_name(NavigationIndex& this, var Syntax& declaration) -> Token {
	var Syntax* source = &@declaration;
	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};
	var Syntax* name = nullptr;
	switch (source->kind()) {
		case syntax_kind::function: @name = source->function_name(); break;
		case syntax_kind::record: @name = source->record_name(); break;
		case syntax_kind::enumeration: @name = source->enum_name(); break;
		case syntax_kind::namespace_body: @name = source->namespace_name(); break;
		case syntax_kind::using_alias: @name = source->alias_name(); break;
		case syntax_kind::variable: @name = source->variable_name(); break;
		case syntax_kind::parameter: @name = source->parameter_name(); break;
		case syntax_kind::template_parameter: @name = source->template_parameter_name(); break;
		case syntax_kind::enumerator: @name = source->enumerator_name(); break;
	};
	if (!name) {
		Token missing;
		return $missing;
	};
	while (name->kind() == syntax_kind::qualified_name || name->kind() == syntax_kind::template_apply || name->kind() == syntax_kind::unary) {
		if (name->kind() == syntax_kind::qualified_name) {
			@name = name->right();
		}
		else if (name->kind() == syntax_kind::template_apply) {
			@name = name->callable();
		}
		else {
			@name = name->operand();
		};
	};
	return name->token();
};

fn NavigationIndex::symbol_kind(NavigationIndex& this, Entity& entity) -> u32 {
	if (entity.declaration() && entity.declaration()->kind() == syntax_kind::template_parameter) {
		return 26;
	};
	switch (entity.kind()) {
		case entity_kind::function:
			if (entity.role() == function_role::constructor) {
				return 9;
			};
			if (entity.scope() && entity.scope()->owner() && entity.scope()->owner()->kind() == entity_kind::record) {
				return 6;
			};
			return 12;
		case entity_kind::record: return 23;
		case entity_kind::field: return 8;
		case entity_kind::enumeration: return 10;
		case entity_kind::enumerator: return 22;
		case entity_kind::namespace_body: return 3;
		case entity_kind::type_parameter: return 26;
		case entity_kind::constant: return 14;
		case entity_kind::template_pattern: {
			var Syntax* declaration = entity.declaration();
			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};
			if (declaration->kind() == syntax_kind::record) {
				return 23;
			};
			if (declaration->kind() == syntax_kind::namespace_body) {
				return 3;
			};
			return 12;
		};
	};
	return 13;
};

fn NavigationIndex::build(var NavigationIndex& this, SemanticUnit& semantics) -> bool {
	rt::buffer<rt::unique<Entity>>& entities = semantics.entities();
	usize index = 0;
	while (index < entities.size()) {
		var Entity* entity = entities.data()[index].get()->canonical();
		@index = index + 1;
		if (entity->origin() == declaration_origin::compiler_supplied || this.symbol_id(entity)) {
			continue;
		};
		var entry = rt::unique<NavigationEntry>::make();
		if (!entry.get()) {
			return false;
		};
		@entry.get()->entity = entity;
		@entry.get()->value.id = static_cast<u64>(this.symbols.size()) + 1;
		@entry.get()->value.kind = this.symbol_kind(*entity);
		@entry.get()->value.declaration = this.range(entity->token());
		@entry.get()->value.definition.source = usize::max;
		if (!@entry.get()->name.append(entity->name())) {
			return false;
		};
		var detail = DiagnosticMessage();
		diagnostic_entity(@detail, *entity);
		if (entity->type()) {
			@detail.text(rt::string_view(": ", 2));
			diagnostic_type(@detail, *entity->type());
		};
		if (!@entry.get()->detail.append(detail.view())) {
			return false;
		};
		@entry.get()->value.name = entry.get()->name.view();
		@entry.get()->value.detail = entry.get()->detail.view();
		usize parameter_index = 0;
		while (parameter_index < entity->parameters().size()) {
			var Entity* parameter = entity->parameters().data()[parameter_index];
			@parameter_index = parameter_index + 1;
			var parameter_entry = rt::unique<NavigationParameterEntry>::make();
			if (!parameter_entry.get()) {
				return false;
			};
			var parameter_detail = DiagnosticMessage();
			@parameter_detail.text(parameter->name());
			@parameter_detail.text(rt::string_view(": ", 2));
			if (parameter->type()) {
				diagnostic_type(@parameter_detail, *parameter->type());
			};
			if (!@parameter_entry.get()->detail.append(parameter_detail.view())) {
				return false;
			};
			@parameter_entry.get()->value.name = parameter->name();
			@parameter_entry.get()->value.detail = parameter_entry.get()->detail.view();
			if (!@entry.get()->parameters.push_back($parameter_entry)) {
				return false;
			};
		};
		var Syntax* declaration = entity->declaration();
		if (declaration) {
			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};
			bool defined = true;
			if (declaration->kind() == syntax_kind::function) {
				@defined = declaration->function_body()->kind() != syntax_kind::noop || entity->definition() == function_definition::defaulted || entity->definition() == function_definition::deleted;
			}
			else if (declaration->kind() == syntax_kind::record) {
				@defined = declaration->record_members()->kind() != syntax_kind::noop;
			};
			if (defined) {
				@entry.get()->value.definition = this.range(this.declaration_name(@*declaration));
				@entry.get()->value.flags = 1;
			};
			if (declaration->kind() == syntax_kind::template_parameter) {
				@entry.get()->value.flags = entry.get()->value.flags | 2;
			};
		};
		if (entity->instantiated()) {
			@entry.get()->value.flags = entry.get()->value.flags | 4;
		};
		Entity* key = entity;
		if (!@this.ids.insert($key, u64(entry.get()->value.id)) || !@this.symbols.push_back($entry)) {
			return false;
		};
	};

	@index = 0;
	while (index < this.symbols.size()) {
		var NavigationEntry* entry = this.symbols.data()[index].get();
		var Entity* entity = entry->entity;
		@entry->value.origin = this.symbol_id(semantics.template_origin(*entity));
		var Scope* scope = entity->scope();
		while (scope && !scope->owner()) {
			@scope = scope->parent();
		};
		if (scope) {
			@entry->value.container = this.symbol_id(scope->owner());
		};
		NavigationOccurrence occurrence;
		@occurrence.range = entry->value.declaration;
		@occurrence.symbol = entry->value.id;
		@occurrence.roles = 1;
		if (entity->scope()) {
			@occurrence.context = this.symbol_id(semantics.reference_context(@*entity->scope()));
		};
		if (occurrence.range.source != usize::max && !@this.occurrences.push_back($occurrence)) {
			return false;
		};
		if (entry->value.definition.source != usize::max && (entry->value.definition.source != entry->value.declaration.source || entry->value.definition.begin != entry->value.declaration.begin)) {
			NavigationOccurrence definition;
			@definition.range = entry->value.definition;
			@definition.symbol = entry->value.id;
			@definition.roles = 1;
			if (!@this.occurrences.push_back($definition)) {
				return false;
			};
		};
		@index = index + 1;
	};

	rt::buffer<ResolvedReference>& references = semantics.references();
	@index = 0;
	while (index < references.size()) {
		ResolvedReference& reference = references.data()[index];
		NavigationOccurrence occurrence;
		@occurrence.range = this.range(reference.location);
		@occurrence.symbol = this.symbol_id(reference.target);
		@occurrence.context = this.symbol_id(reference.context);
		@occurrence.roles = reference.roles;
		if (occurrence.symbol && occurrence.range.source != usize::max && !@this.occurrences.push_back($occurrence)) {
			return false;
		};
		@index = index + 1;
	};
	@index = 0;
	while (index < semantics.classifications().size()) {
		SemanticClassification& source = semantics.classifications().data()[index];
		NavigationClassification classification;
		@classification.range = this.range(source.location);
		@classification.type = source.type;
		@classification.modifiers = source.modifiers;
		if (!@this.classifications.push_back($classification)) {
			return false;
		};
		@index = index + 1;
	};
	return @this.build_contexts(semantics) && @this.build_receivers(semantics);
};

fn NavigationIndex::register_source(var NavigationIndex& this, var SourceFile& source, usize index) -> bool {
	SourceFile* key = &@source;
	return @this.source_ids.insert($key, $index);
};

fn NavigationIndex::symbol_count(NavigationIndex& this) -> usize {
	return this.symbols.size();
};

fn NavigationIndex::symbol_at(NavigationIndex& this, usize index) -> NavigationSymbol* {
	if (index >= this.symbols.size()) {
		return nullptr;
	};
	return &@this.symbols.data()[index].get()->value;
};

fn NavigationIndex::occurrence_count(NavigationIndex& this) -> usize {
	return this.occurrences.size();
};

fn NavigationIndex::occurrence_at(NavigationIndex& this, usize index) -> NavigationOccurrence* {
	if (index >= this.occurrences.size()) {
		return nullptr;
	};
	return &@this.occurrences.data()[index];
};

fn NavigationIndex::syntax_range(NavigationIndex& this, Syntax& syntax) -> SourceRange {
	var result = this.range(syntax.token());
	usize index = 0;
	while (index < syntax.size()) {
		var child = this.syntax_range(*syntax.item(index));
		if (child.source != usize::max && (result.source == usize::max || child.source == result.source)) {
			if (result.source == usize::max) {
				@result = child;
			}
			else {
				if (child.begin < result.begin) {
					@result.begin = child.begin;
				};
				if (child.end > result.end) {
					@result.end = child.end;
				};
			};
		};
		@index = index + 1;
	};
	Token opening = syntax.token();
	if (syntax.kind() == syntax_kind::unit && opening.source) {
		@result.begin = 0;
		@result.end = opening.source->text().size();
	};
	if (opening.source && (opening.kind == token_kind::punct_left_brace || opening.kind == token_kind::punct_left_paren || opening.kind == token_kind::punct_left_bracket)) {
		rt::buffer<Token>& tokens = opening.source->tokens();
		usize depth = 0;
		@index = 0;
		while (index < tokens.size()) {
			Token token = tokens.data()[index];
			@index = index + 1;
			if (token.begin < opening.begin) {
				continue;
			};
			if (token.kind == opening.kind) {
				@depth = depth + 1;
			};
			bool closes = opening.kind == token_kind::punct_left_brace && token.kind == token_kind::punct_right_brace || opening.kind == token_kind::punct_left_paren && token.kind == token_kind::punct_right_paren || opening.kind == token_kind::punct_left_bracket && token.kind == token_kind::punct_right_bracket;
			if (closes) {
				@depth = depth - 1;
				if (!depth) {
					@result.end = token.begin + token.length;
					break;
				};
			};
		};
	};
	return $result;
};

fn NavigationIndex::scope_id(var NavigationIndex& this, Scope& scope) -> u64 {
	Scope* key = &@scope;
	u64* present = this.scope_ids.find(key);
	if (present) {
		return *present;
	};
	NavigationScope descriptor;
	@descriptor.range.source = usize::max;
	if (scope.parent()) {
		@descriptor.parent = @this.scope_id(*scope.parent());
		if (!descriptor.parent) {
			return 0;
		};
	};
	Scope* cursor = &@scope;
	while (cursor) {
		if (cursor->owner() && cursor->owner()->instantiated()) {
			@descriptor.context = this.symbol_id(cursor->owner());
			if (cursor == &@scope && cursor->owner()->declaration()) {
				@descriptor.range = this.syntax_range(*cursor->owner()->declaration());
			};
			break;
		};
		@cursor = cursor->parent();
	};
	u64 id = u64(this.scope_ids.size()) + 1;
	@descriptor.id = id;
	Scope* retained_scope = &@scope;
	if (!@this.scope_ids.insert($key, u64(id)) || !@this.scope_locations.push_back($descriptor) || !@this.scope_records.push_back($retained_scope)) {
		return 0;
	};
	return $id;
};

fn NavigationIndex::build_contexts(var NavigationIndex& this, SemanticUnit& semantics) -> bool {
	rt::buffer<SemanticScopeRegion>& regions = semantics.scope_regions();
	usize index = 0;
	while (index < regions.size()) {
		SemanticScopeRegion& source = regions.data()[index];
		NavigationScope region;
		@region.id = @this.scope_id(*source.scope);
		if (source.scope->parent()) {
			@region.parent = @this.scope_id(*source.scope->parent());
		};
		@region.context = this.symbol_id(semantics.reference_context(@*source.scope));
		@region.range = this.syntax_range(*source.syntax);
		if (!region.id || !@this.scope_locations.push_back($region)) {
			return false;
		};
		@index = index + 1;
	};
	rt::buffer<rt::unique<Entity>>& entities = semantics.entities();
	@index = 0;
	while (index < entities.size()) {
		var Entity* entity = entities.data()[index].get();
		@index = index + 1;
		if (!entity->scope() || !this.symbol_id(entity)) {
			continue;
		};
		NavigationBinding binding;
		@binding.scope = @this.scope_id(*entity->scope());
		@binding.symbol = this.symbol_id(entity);
		if (!binding.scope || !@this.bindings.push_back($binding)) {
			return false;
		};
	};
	@index = 0;
	while (index < this.symbols.size()) {
		var NavigationEntry* entry = this.symbols.data()[index].get();
		@index = index + 1;
		var Entity* owner = entry->entity->member_owner();
		Type* type = entry->entity->type();
		while (type && (type->kind() == type_kind::pointer || type->kind() == type_kind::reference)) {
			@type = type->element();
		};
		if (!owner && type) {
			if (type->kind() == type_kind::named || type->kind() == type_kind::parameter) {
				@owner = type->entity()->member_owner();
			};
			if (!owner) {
				@owner = semantics.associated_owner(*type);
			};
		};
		if (owner && owner->members()) {
			@entry->member_scope = @this.scope_id(*owner->members());
			if (!entry->member_scope) {
				return false;
			};
		};
	};
	rt::buffer<SemanticCallSite>& sites = semantics.call_sites();
	@index = 0;
	while (index < sites.size()) {
		SemanticCallSite& source = sites.data()[index];
		@index = index + 1;
		var call = rt::unique<NavigationCall>::make();
		if (!call.get()) {
			return false;
		};
		@call.get()->symbol = this.symbol_id(source.selected);
		@call.get()->bound_receiver = source.bound_receiver;
		if (source.candidates && source.candidates->scope()) {
			rt::buffer<var Entity*>& candidates = source.candidates->scope()->bindings();
			usize candidate = 0;
			while (candidate < candidates.size()) {
				Entity& function = *candidates.data()[candidate];
				@candidate = candidate + 1;
				if (function.kind() != entity_kind::function || function.name() != source.candidates->name() || !function.accessible_from(*source.scope)) {
					continue;
				};
				u64 symbol = this.symbol_id(&@function);
				if (symbol && !@call.get()->candidates.push_back($symbol)) {
					return false;
				};
			};
		};
		@call.get()->scope = @this.scope_id(*source.scope);
		@call.get()->context = this.symbol_id(semantics.reference_context(@*source.scope));
		@call.get()->range = this.syntax_range(*source.syntax);
		@call.get()->callee = this.syntax_range(*source.syntax->callable());
		var Syntax* arguments = source.syntax->arguments();
		usize argument = 0;
		while (argument < arguments->size()) {
			if (!@call.get()->arguments.push_back(this.syntax_range(*arguments->item(argument)))) {
				return false;
			};
			@argument = argument + 1;
		};
		if (!@this.calls.push_back($call)) {
			return false;
		};
	};
	return true;
};

fn NavigationIndex::scope_count(NavigationIndex& this) -> usize {
	return this.scope_locations.size();
};

fn NavigationIndex::scope_at(NavigationIndex& this, usize index) -> NavigationScope* {
	if (index >= this.scope_locations.size()) {
		return nullptr;
	};
	return this.scope_locations.data() + index;
};

fn NavigationIndex::binding_count(NavigationIndex& this) -> usize {
	return this.bindings.size();
};

fn NavigationIndex::binding_at(NavigationIndex& this, usize index) -> NavigationBinding* {
	if (index >= this.bindings.size()) {
		return nullptr;
	};
	return this.bindings.data() + index;
};

fn NavigationIndex::call_count(NavigationIndex& this) -> usize {
	return this.calls.size();
};

fn NavigationIndex::call_at(NavigationIndex& this, usize index) -> NavigationCall* {
	if (index >= this.calls.size()) {
		return nullptr;
	};
	return this.calls.data()[index].get();
};

fn NavigationIndex::parameter_count(NavigationIndex& this, u64 symbol) -> usize {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	return this.symbols.data()[symbol - 1].get()->parameters.size();
};

fn NavigationIndex::parameter_at(NavigationIndex& this, u64 symbol, usize index) -> NavigationParameter* {
	if (index >= this.parameter_count(symbol)) {
		return nullptr;
	};
	return &@this.symbols.data()[symbol - 1].get()->parameters.data()[index].get()->value;
};

fn NavigationIndex::member_scope(NavigationIndex& this, u64 symbol) -> u64 {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	return this.symbols.data()[symbol - 1].get()->member_scope;
};

fn NavigationIndex::accessible(NavigationIndex& this, u64 symbol, u64 scope) -> bool {
	if (!symbol || symbol > this.symbols.size() || !scope || scope > this.scope_records.size()) {
		return false;
	};
	return this.symbols.data()[symbol - 1].get()->entity->accessible_from(*this.scope_records.data()[scope - 1]);
};

fn NavigationIndex::receiver_candidates(var NavigationIndex& this, var NavigationReceiver& site, Entity& owner, Entity& visible_owner, Scope& scope) -> bool {
	if (!owner.members()) {
		return true;
	};

	rt::buffer<var Entity*>& members = owner.members()->bindings();
	usize index = 0;
	while (index < members.size()) {
		Entity& member = *members.data()[index];
		@index = index + 1;
		var Entity* visible = visible_owner.find_member(member.name());
		if (!visible || visible->scope() != member.scope() || !member.accessible_from(scope)) {
			continue;
		};
		u64 symbol = this.symbol_id(&@member);
		if (!symbol) {
			continue;
		};
		usize previous = 0;
		while (previous < site.candidates.size() && site.candidates.data()[previous] != symbol) {
			@previous = previous + 1;
		};
		if (previous == site.candidates.size() && !@site.candidates.push_back($symbol)) {
			return false;
		};
	};

	if (owner.bases().size() == 1) {
		return @this.receiver_candidates(@site, *owner.bases().data()[0]->entity(), visible_owner, scope);
	};
	return true;
};

fn NavigationIndex::build_receivers(var NavigationIndex& this, SemanticUnit& semantics) -> bool {
	rt::buffer<SemanticReceiverSite>& sites = semantics.receiver_sites();
	usize index = 0;
	while (index < sites.size()) {
		SemanticReceiverSite& source = sites.data()[index];
		@index = index + 1;
		var receiver = rt::unique<NavigationReceiver>::make();
		if (!receiver.get()) {
			return false;
		};
		@receiver.get()->scope = @this.scope_id(*source.scope);
		@receiver.get()->context = this.symbol_id(semantics.reference_context(@*source.scope));
		@receiver.get()->range = this.syntax_range(*source.syntax->left());
		const Syntax* root = source.syntax->left();
		while (root && root->kind() == syntax_kind::member) {
			@root = root->left();
		};
		@receiver.get()->root.source = usize::max;
		if (root && root->kind() == syntax_kind::name) {
			@receiver.get()->root = this.syntax_range(*root);
		};
		@receiver.get()->selector = this.range(source.syntax->token());
		SourceRange member = this.syntax_range(*source.syntax->right());
		if (member.source == receiver.get()->selector.source && member.end > receiver.get()->selector.end) {
			@receiver.get()->selector.end = member.end;
		};
		if (!@this.receiver_candidates(@*receiver.get(), *source.owner, *source.owner, *source.scope) || !@this.receivers.push_back($receiver)) {
			return false;
		};
	};
	return true;
};

fn NavigationIndex::receiver_count(NavigationIndex& this) -> usize {
	return this.receivers.size();
};

fn NavigationIndex::receiver_at(NavigationIndex& this, usize index) -> NavigationReceiver* {
	if (index >= this.receivers.size()) {
		return nullptr;
	};
	return this.receivers.data()[index].get();
};

fn NavigationIndex::type_symbol(NavigationIndex& this, u64 symbol) -> u64 {
	if (!symbol || symbol > this.symbols.size()) {
		return 0;
	};
	Type* type = this.symbols.data()[symbol - 1].get()->entity->type();
	while (type && (type->kind() == type_kind::pointer || type->kind() == type_kind::reference || type->kind() == type_kind::array)) {
		@type = type->element();
	};
	if (!type || (type->kind() != type_kind::named && type->kind() != type_kind::parameter)) {
		return 0;
	};
	return this.symbol_id(type->entity());
};

fn NavigationIndex::semantic_token_type(NavigationIndex& this, u64 symbol) -> u32 {
	if (!symbol || symbol > this.symbols.size()) {
		return 8;
	};
	Entity& entity = *this.symbols.data()[symbol - 1].get()->entity;
	switch (entity.kind()) {
		case entity_kind::namespace_body: return 0;
		case entity_kind::alias: return 1;
		case entity_kind::record: return 5;
		case entity_kind::enumeration: return 3;
		case entity_kind::type_parameter: return 6;
		case entity_kind::parameter: return 7;
		case entity_kind::field: return 9;
		case entity_kind::enumerator: return 10;
		case entity_kind::function: {
			if (entity.scope() && entity.scope()->owner() && entity.scope()->owner()->kind() == entity_kind::record) {
				return 12;
			};
			return 11;
		};
	};
	NavigationSymbol& value = this.symbols.data()[symbol - 1].get()->value;
	if (value.kind == 23) {
		return 5;
	};
	if (value.kind == 26) {
		return 6;
	};
	return 8;
};

fn NavigationIndex::symbol_readonly(NavigationIndex& this, u64 symbol) -> bool {
	if (!symbol || symbol > this.symbols.size()) {
		return false;
	};
	Entity& entity = *this.symbols.data()[symbol - 1].get()->entity;
	Type* type = entity.type();
	if (type && type->kind() == type_kind::reference) {
		@type = type->element();
	};
	return entity.kind() == entity_kind::constant || entity.kind() == entity_kind::enumerator || type && type->qualifier() == type_qualifier::immutable;
};

fn NavigationIndex::classification_count(NavigationIndex& this) -> usize {
	return this.classifications.size();
};

fn NavigationIndex::classification_at(NavigationIndex& this, usize index) -> NavigationClassification* {
	if (index >= this.classifications.size()) {
		return nullptr;
	};
	return &@this.classifications.data()[index];
};

struct AnalysisCancellationScope {
	fn AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics);
	fn ~AnalysisCancellationScope(var AnalysisCancellationScope& this);

private:
	var Diagnostics* diagnostics;
};

fn AnalysisCancellationScope::AnalysisCancellationScope(var AnalysisCancellationScope& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn AnalysisCancellationScope::~AnalysisCancellationScope(var AnalysisCancellationScope& this) {
	@this.diagnostics->set_cancellation(nullptr, nullptr);
};

fn Analysis::analyze(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> bool {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, false);
};

fn Analysis::analyze_editor(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> bool {
	return @this.analyze_impl($pointer_bits, $cancelled, $context, true);
};

fn Analysis::analyze_impl(var Analysis& this, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context, bool editor) -> bool {
	@this.messages.set_cancellation(cancelled, context);
	var cancellation_scope = AnalysisCancellationScope(@this.messages);
	@this.target_pointer_bits = pointer_bits;
	@this.semantic_unit = rt::unique<SemanticUnit>::make();
	if (!this.semantic_unit.get()) {
		return false;
	};
	Token location;
	if (pointer_bits != 32 && pointer_bits != 64) {
		@this.messages.error(location, rt::string_view("language analysis requires a 32-bit or 64-bit target", 52));
		return true;
	};
	Diagnostics parse_errors;
	usize index = 0;
	while (index < this.sources.count()) {
		if (this.messages.cancelled()) {
			return false;
		};
		var SourceFile* file = @this.sources.at(index);
		var lexer = Lexer(@*file);
		if (!@lexer.scan()) {
			@parse_errors.syntax_error(lexer.error_token(), lexer.error());
			@index = index + 1;
			continue;
		};
		var parser = Parser(file->tokens());
		@parser.set_cancellation(cancelled, context);
		rt::unique<Syntax> syntax;
		if (editor) {
			@syntax = @parser.parse_editor();
			usize issue = 0;
			while (issue < parser.issues().size()) {
				@parse_errors.syntax_error(parser.issues().data()[issue].location, parser.issues().data()[issue].message.view());
				@issue = issue + 1;
			};
		}
		else {
			@syntax = @parser.parse();
		};
		if (!syntax.get()) {
			if (this.messages.cancelled()) {
				return false;
			};
			@parse_errors.syntax_error(parser.error_token(), parser.error());
		}
		else if (!@this.syntax.push_back($syntax)) {
			return false;
		};
		@index = index + 1;
	};
	var analyzer = Analyzer(@this.types, @this.messages, $pointer_bits);
	@analyzer.set_editor($editor);
	bool analyzed = @analyzer.analyze_into(@*this.semantic_unit.get(), this.syntax);
	if (!analyzed && !this.messages.failed()) {
		@this.messages.error(location, rt::string_view("internal compiler error: semantic analysis failed without a diagnostic", 70));
	};
	if (analyzed && this.template_selection.get()) {
		var EditorTemplateSelection& selection = @*this.template_selection.get();
		rt::string input;
		@input.append(rt::string_view("using __context = __arguments<", 30));
		@input.append(selection.arguments.view());
		@input.append(rt::string_view(">;", 2));
		@selection.input.assign(selection.path.view(), input.view());
		var lexer = Lexer(@selection.input);
		if (!@lexer.scan()) {
			@this.messages.syntax_error(lexer.error_token(), lexer.error());
			@analyzed = false;
		}
		else {
			var parser = Parser(selection.input.tokens());
			@parser.set_cancellation(cancelled, context);
			@selection.syntax = @parser.parse();
			if (!selection.syntax.get()) {
				@this.messages.syntax_error(parser.error_token(), parser.error());
				@analyzed = false;
			}
			else if (selection.syntax.get()->size() != 1 || selection.syntax.get()->item(0)->kind() != syntax_kind::using_alias) {
				@this.messages.error(location, rt::string_view("enter only template arguments, without declarations or statements", 65));
				@analyzed = false;
			}
			else {
				usize source = 0;
				while (source < this.sources.count() && this.sources.at(source)->path() != selection.path.view()) {
					@source = source + 1;
				};
				var Syntax* applied = selection.syntax.get()->item(0)->alias_type();
				while (applied->kind() == syntax_kind::type_name) {
					@applied = applied->designated_type();
				};
				if (source == this.sources.count() || applied->kind() != syntax_kind::template_apply) {
					@this.messages.error(location, rt::string_view("cannot read the template argument list", 38));
					@analyzed = false;
				}
				else {
					@analyzed = @analyzer.editor_template_context(@*this.semantic_unit.get(), @*(@this.sources).at(source), selection.anchor, @*applied->arguments(), @selection.label);
				};
			};
		};
	};
	if (analyzed) {
		var lifetimes = LifetimeAnalyzer(@this.messages);
		if (!@lifetimes.validate(*this.semantic_unit.get()) && !this.messages.failed()) {
			@this.messages.error(location, rt::string_view("internal compiler error: lifetime analysis failed without a diagnostic", 70));
		};
	};
	if (this.messages.cancelled()) {
		return false;
	};
	rt::buffer<DiagnosticRecord>& records = parse_errors.records();
	@index = 0;
	while (index < records.size()) {
		DiagnosticRecord& record = records.data()[index];
		@this.messages.error(record.location, record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			@this.messages.note(record.notes.data()[note].location, record.notes.data()[note].message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
	return @this.index.build(*this.semantic_unit.get());
};

fn rutile_language_analyze(AnalysisSource* sources, usize count, u32 pointer_bits, ((var void*) -> i32)* cancelled, var void* context) -> var void* {
	if (count && !sources || cancelled && cancelled(context)) {
		return nullptr;
	};
	var analysis = rt::unique<Analysis>::make();
	var compiler = rt::unique<Compiler>::make();
	if (!analysis.get() || !compiler.get()) {
		return nullptr;
	};
	usize index = 0;
	while (index < count) {
		if (!@analysis.get()->add_source(sources[index].path, sources[index].text)) {
			return nullptr;
		};
		@index = index + 1;
	};
	if (!@analysis.get()->analyze($pointer_bits, $cancelled, $context) || !@compiler.get()->publish($analysis)) {
		return nullptr;
	};
	return @compiler.release();
};

fn rutile_language_destroy(var void* snapshot) {
	delete static_cast<var Compiler*>($snapshot);
};

fn rutile_language_symbol_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().navigation().symbol_count();
};

fn rutile_language_symbol(void* snapshot, usize index, var NavigationSymbol* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	NavigationSymbol* symbol = lease.value().navigation().symbol_at($index);
	if (!symbol) {
		return 0;
	};
	@*result := *symbol;
	return 1;
};

fn rutile_language_occurrence_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().navigation().occurrence_count();
};

fn rutile_language_occurrence(void* snapshot, usize index, var NavigationOccurrence* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	NavigationOccurrence* occurrence = lease.value().navigation().occurrence_at($index);
	if (!occurrence) {
		return 0;
	};
	@*result := *occurrence;
	return 1;
};

fn rutile_language_diagnostic_count(void* snapshot) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	return lease.value().diagnostics().records().size();
};

fn rutile_language_diagnostic(void* snapshot, usize index, var LanguageDiagnostic* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (index >= records.size()) {
		return 0;
	};
	DiagnosticRecord& record = records.data()[index];
	@result->range = lease.value().navigation().range(record.location);
	@result->severity = 1;
	@result->message = record.message.view();
	return 1;
};

fn rutile_language_related_count(void* snapshot, usize diagnostic) -> usize {
	if (!snapshot) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (diagnostic >= records.size()) {
		return 0;
	};
	return records.data()[diagnostic].notes.size();
};

fn rutile_language_related(void* snapshot, usize diagnostic, usize index, var LanguageDiagnostic* result) -> i32 {
	if (!snapshot || !result) {
		return 0;
	};
	var lease = @const_cast<var Compiler*>(static_cast<Compiler*>(snapshot))->acquire_analysis();
	if (!lease.get()) {
		return 0;
	};
	rt::buffer<DiagnosticRecord>& records = lease.value().diagnostics().records();
	if (diagnostic >= records.size() || index >= records.data()[diagnostic].notes.size()) {
		return 0;
	};
	DiagnosticNote& note = records.data()[diagnostic].notes.data()[index];
	@result->range = lease.value().navigation().range(note.location);
	@result->severity = 3;
	@result->message = note.message.view();
	return 1;
};

