	if (value) {
		LLVMDisposePassBuilderOptions(value);
	};
};

struct NativeType {
	const Type* source;
	LLVMOpaqueType* value;
};

struct NativeEntity {
	Entity* source;
	LLVMOpaqueValue* value;
	LLVMOpaqueValue* implementation;
};

struct NativeTable {
	Entity* source;
	LLVMOpaqueValue* value;
};

struct Backend {
	fn Backend(Backend& this, Diagnostics& diagnostics);

	fn ~Backend(Backend& this);

	fn initialize(Backend& this, i32 optimization) -> bool;
	fn emit(Backend& this, const SemanticUnit& unit, const rt::string_view& entry, output_kind output) -> bool;
	fn write(Backend& this, File& output) -> bool;

	fn pointer_bits(const Backend& this) -> u32;
	fn type(Backend& this, const Type* source) -> LLVMOpaqueType*;
	fn symbol(const Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn implementation(const Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn table(Backend& this, Entity* entity) -> LLVMOpaqueValue*;
	fn field_index(const Backend& this, Entity* entity, usize index) -> u32;

	fn context(const Backend& this) -> LLVMOpaqueContext*;
	fn module(const Backend& this) -> LLVMOpaqueModule*;
	fn builder(const Backend& this) -> LLVMOpaqueBuilder*;
	fn layout(const Backend& this) -> LLVMOpaqueTargetData*;

	fn error(Backend& this, const Token& token, const rt::string_view& message) -> bool;
	fn failed(const Backend& this) -> bool;

private:
	fn verify(Backend& this) -> bool;
	fn optimize(Backend& this) -> bool;

	fn declare(Backend& this, Entity* entity) -> bool;
	fn required(const Backend& this, Entity* entity) -> bool;
	fn external_signature(Backend& this, Entity* entity) -> bool;

	fn emit_dispatch(Backend& this, Entity* entity) -> bool;
	fn dispatch_target(Backend& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue*;
	fn entry(Backend& this, Entity* entity) -> bool;
	fn register_lifecycle(Backend& this, LLVMOpaqueValue* function, const char* name);

	Diagnostics* diagnostics;
	Entity* selected_entry;
	i32 optimization;
	rt::unique<LLVMOpaqueContext, ContextDisposer> native_context;
	rt::unique<LLVMOpaqueTargetMachine, MachineDisposer> native_machine;
	rt::unique<LLVMOpaqueModule, ModuleDisposer> native_module;
	rt::unique<LLVMOpaqueBuilder, BuilderDisposer> native_builder;
	rt::unique<LLVMOpaqueTargetData, LayoutDisposer> native_layout;
	rt::buffer<NativeType> types;
	rt::buffer<NativeEntity> entities;
	rt::buffer<NativeTable> tables;
};

fn Backend::Backend(Backend& this, Diagnostics& diagnostics) {
	@this.diagnostics = &diagnostics;
};

fn Backend::~Backend(Backend& this) {
	@this.native_layout.reset(nullptr);
	@this.native_builder.reset(nullptr);
	@this.native_module.reset(nullptr);
	@this.native_machine.reset(nullptr);
	@this.native_context.reset(nullptr);
};

fn Backend::context(const Backend& this) -> LLVMOpaqueContext* {
	return this.native_context.get();
};

fn Backend::module(const Backend& this) -> LLVMOpaqueModule* {
	return this.native_module.get();
};

fn Backend::builder(const Backend& this) -> LLVMOpaqueBuilder* {
	return this.native_builder.get();
};

fn Backend::layout(const Backend& this) -> LLVMOpaqueTargetData* {
	return this.native_layout.get();
};

fn Backend::failed(const Backend& this) -> bool {
	return this.diagnostics->failed();
};

fn Backend::error(Backend& this, const Token& token, const rt::string_view& message) -> bool {
	@this.diagnostics->error(token, message);
	return false;
};

fn Backend::pointer_bits(const Backend& this) -> u32 {
	if (!this.native_layout.get()) {
		return 0;
	};

	return LLVMPointerSize(this.native_layout.get()) * 8;
};

fn Backend::initialize(Backend& this, i32 optimization) -> bool {
	Token location;

	if (optimization < 0 || optimization > 3) {
		return @this.error(location, rt::string_view("optimization level must be between 0 and 3\0"));
	};

	@this.optimization = $optimization;
	u32 major;
	u32 minor;
	u32 patch;
	LLVMGetVersion(&major, &minor, &patch);

	if (major != 21 || minor != 1 || patch != 0) {
		return @this.error(location, rt::string_view("LLVM runtime version must be 21.1.0\0"));
	};

	LLVMInitializeX86TargetInfo();
	LLVMInitializeX86Target();
	LLVMInitializeX86TargetMC();
	LLVMInitializeX86AsmPrinter();
	@this.native_context.reset(LLVMContextCreate());

	if (!this.context()) {
		return @this.error(location, rt::string_view("cannot create LLVM context\0"));
	};

	@this.native_module.reset(LLVMModuleCreateWithNameInContext("rutile\0", this.context()));
	@this.native_builder.reset(LLVMCreateBuilderInContext(this.context()));

	if (!this.module() || !this.builder()) {
		return @this.error(location, rt::string_view("cannot create LLVM module or builder\0"));
	};

	var triple = rt::unique<char, MessageDisposer>(LLVMGetDefaultTargetTriple());

	if (!triple.get()) {
		return @this.error(location, rt::string_view("cannot obtain target triple\0"));
	};

	LLVMTarget* target;
	char* failure;

	if (LLVMGetTargetFromTriple(triple.get(), &target, &failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return @this.error(location, rt::string_view(message.get()));
	};

	@this.native_machine.reset(LLVMCreateTargetMachine(target, triple.get(), "generic\0", "\0", i32(this.optimization), 2, 0));

	if (!this.native_machine.get()) {
		return @this.error(location, rt::string_view("cannot create target machine\0"));
	};

	@this.native_layout.reset(LLVMCreateTargetDataLayout(this.native_machine.get()));

	if (!this.layout()) {
		return @this.error(location, rt::string_view("cannot create target layout\0"));
	};

	var layout = rt::unique<char, MessageDisposer>(LLVMCopyStringRepOfTargetData(this.layout()));

	if (!layout.get()) {
		return @this.error(location, rt::string_view("cannot describe target layout\0"));
	};

	LLVMSetTarget(this.module(), triple.get());
	LLVMSetDataLayout(this.module(), layout.get());

	return true;
};

fn Backend::verify(Backend& this) -> bool {
	char* failure;

	if (!LLVMVerifyModule(this.module(), 2, &failure)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return true;
	};

	var message = rt::unique<char, MessageDisposer>(failure);
	Token location;

	return @this.error(location, rt::string_view(message.get()));
};

fn Backend::optimize(Backend& this) -> bool {
	if (!@this.verify()) {
		return false;
	};

	var options = rt::unique<LLVMOpaquePassBuilderOptions, PassOptionsDisposer>(LLVMCreatePassBuilderOptions());
	Token location;

	if (!options.get()) {
		return @this.error(location, rt::string_view("cannot create optimization options\0"));
	};

	LLVMPassBuilderOptionsSetVerifyEach(options.get(), 1);
	const char* pipeline = "default<O0>\0";

	switch (this.optimization) {
		case 1:
			@pipeline = "default<O1>\0";
			break;
		case 2:
			@pipeline = "default<O2>\0";
			break;
		case 3:
			@pipeline = "default<O3>\0";
			break;
	};

	LLVMOpaqueError* error = LLVMRunPasses(this.module(), pipeline, this.native_machine.get(), options.get());

	if (error) {
		var message = rt::unique<char, ErrorMessageDisposer>(LLVMGetErrorMessage(error));

		return @this.error(location, rt::string_view(message.get()));
	};

	return @this.verify();
};

fn Backend::write(Backend& this, File& output) -> bool {
	if (this.failed() || !@this.optimize()) {
		return false;
	};

	LLVMOpaqueMemoryBuffer* bytes;
	char* failure;
	Token location;

	if (LLVMTargetMachineEmitToMemoryBuffer(this.native_machine.get(), this.module(), 1, &failure, &bytes)) {
		var message = rt::unique<char, MessageDisposer>(failure);

		return @this.error(location, rt::string_view(message.get()));
	};

	var buffer = rt::unique<LLVMOpaqueMemoryBuffer, BufferDisposer>(bytes);

	if (!@output.write(rt::string_view(LLVMGetBufferStart(buffer.get()), LLVMGetBufferSize(buffer.get())))) {
		return @this.error(location, rt::string_view("cannot write native object output\0"));
	};

	return true;
};

fn Backend::type(Backend& this, const Type* source) -> LLVMOpaqueType* {
	if (!source || this.failed()) {
		return nullptr;
	};

	usize index = 0;

	while (index < this.types.size()) {
		const Type* stored = this.types.data()[index].source;

		if (stored == source || (stored->kind() == type_kind::named && source->kind() == type_kind::named && stored->entity() == source->entity())) {
			return this.types.data()[index].value;
		};

		@index = index + 1;
	};

	LLVMOpaqueType* result;

	switch (source->kind()) {
		case type_kind::void_type:
			@result = LLVMVoidTypeInContext(this.context());
			break;
		case type_kind::boolean:
			@result = LLVMIntTypeInContext(this.context(), 1);
			break;
		case type_kind::character:
			@result = LLVMIntTypeInContext(this.context(), 8);
			break;
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
			@result = LLVMIntTypeInContext(this.context(), source->bits());
			break;
		case type_kind::floating_point:
			@result = LLVMDoubleTypeInContext(this.context());

			if (source->bits() == 32) {
				@result = LLVMFloatTypeInContext(this.context());
			};

			break;
		case type_kind::pointer:
		case type_kind::reference:
			@result = LLVMPointerTypeInContext(this.context(), 0);
			break;
		case type_kind::array: {
			LLVMOpaqueType* element = @this.type(source->element());

			if (!element) {
				return nullptr;
			};

			u64 element_size = LLVMABISizeOfType(this.layout(), element);
			u64 maximum = (u64::max) >> (64 - static_cast<u64>(this.pointer_bits()));

			if (element_size && source->count() > maximum / element_size) {
				Token location;
				@this.error(location, rt::string_view("array storage size exceeds target address space\0"));
				return nullptr;
			};

			@result = LLVMArrayType2(element, source->count());
			break;
		};

		case type_kind::function: {
			const FunctionSignature& signature = source->signature();
			rt::buffer<LLVMOpaqueType*> parameters;
			@index = 0;

			while (index < signature.parameters().size()) {
				LLVMOpaqueType* parameter = @this.type(signature.parameters().data()[index]);

				if (!parameter || !@parameters.push_back(parameter)) {
					Token location;
					@this.error(location, rt::string_view("cannot allocate native signature\0"));
					return nullptr;
				};

				@index = index + 1;
			};

			LLVMOpaqueType* result_type = @this.type(signature.result());

			if (!result_type) {
				return nullptr;
			};

			@result = LLVMFunctionType(result_type, (@parameters).data(), static_cast<u32>(parameters.size()), static_cast<i32>(signature.arity() == parameter_arity::variadic));
			break;
		};

		case type_kind::named: {
			Entity* record = source->entity();

			if (record && record->kind() == entity_kind::enumeration) {
				@result = @this.type(record->underlying());
				break;
			};

			if (!record || record->kind() != entity_kind::record) {
				Token location;
				@this.error(location, rt::string_view("native named type requires a resolved record\0"));
				return nullptr;
			};

			rt::string name;

			if (!@name.append(record->name())) {
				@this.error(record->token(), rt::string_view("cannot allocate native type name\0"));
				return nullptr;
			};

			@result = LLVMStructCreateNamed(this.context(), name.c_str());
			NativeType native;
			@native.source := source;
			@native.value := result;

			if (!@this.types.push_back($native)) {
				@this.error(record->token(), rt::string_view("cannot retain native type identity\0"));
				return nullptr;
			};

			rt::buffer<LLVMOpaqueType*> fields;
			@index = 0;

			while (index < record->bases().size()) {
				LLVMOpaqueType* base = @this.type(record->bases().data()[index]);

				if (!base || !@fields.push_back(base)) {
					@this.error(record->token(), rt::string_view("cannot allocate native base layout\0"));
					return nullptr;
				};

				@index = index + 1;
			};

			if (record->owns_dispatch() && !@fields.push_back(LLVMPointerTypeInContext(this.context(), 0))) {
				@this.error(record->token(), rt::string_view("cannot allocate native dispatch layout\0"));
				return nullptr;
			};

			@index = 0;

			while (index < record->fields().size()) {
				LLVMOpaqueType* field = @this.type(record->fields().data()[index]->type());

				if (!field || !@fields.push_back(field)) {
					@this.error(record->token(), rt::string_view("cannot allocate native record layout\0"));
					return nullptr;
				};

				@index = index + 1;
			};

			if (record->layout() == record_layout::overlapping && fields.size()) {
				LLVMOpaqueType* aligned = fields.data()[0];
				u64 maximum = 0;
				u64 alignment = 1;
				@index = 0;

				while (index < fields.size()) {
					LLVMOpaqueType* field = fields.data()[index];
					u64 size = LLVMABISizeOfType(this.layout(), field);
					u64 field_alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.layout(), field));

					if (size > maximum) {
						@maximum = size;
					};

					if (field_alignment > alignment) {
						@alignment = field_alignment;
						@aligned = field;
					};

					@index = index + 1;
				};

				@maximum = (maximum + alignment - 1) / alignment * alignment;
				@fields.clear();

				if (!@fields.push_back(aligned)) {
					@this.error(record->token(), rt::string_view("cannot allocate native union layout\0"));
					return nullptr;
				};

				u64 occupied = LLVMABISizeOfType(this.layout(), aligned);

				if (maximum > occupied) {
					LLVMOpaqueType* padding = LLVMArrayType2(LLVMIntTypeInContext(this.context(), 8), maximum - occupied);

					if (!@fields.push_back(padding)) {
						@this.error(record->token(), rt::string_view("cannot allocate native union padding\0"));
						return nullptr;
					};
				};
			};

			LLVMStructSetBody(LLVMOpaqueType*(result), (@fields).data(), static_cast<u32>(fields.size()), 0);

			return result;
		};

		default: {
			Token location;
			@this.error(location, rt::string_view("type has no native representation\0"));
			return nullptr;
		};
	};

	NativeType native;
	@native.source = source;
	@native.value := result;

	if (!@this.types.push_back($native)) {
		Token location;
		@this.error(location, rt::string_view("cannot retain native type identity\0"));
		return nullptr;
	};

	return result;
};

fn Backend::symbol(const Backend& this, Entity* entity) -> LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].value;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::declare(Backend& this, Entity* entity) -> bool {
	if (!this.required(entity) || this.symbol(Entity*(entity))) {
		return true;
	};

	if (!entity->type()) {
		return @this.error(entity->token(), rt::string_view("native declaration has no resolved type\0"));
	};

	if (entity->kind() == entity_kind::function && entity->definition() == function_definition::declaration && !@this.external_signature(entity)) {
		return false;
	};

	rt::string name;
	var spelling = entity->name();

	if (this.selected_entry && spelling == rt::string_view("main\0")) {
		@spelling = rt::string_view("rt.user.main\0");

		if (entity == this.selected_entry) {
			@spelling = rt::string_view("rt.entry\0");
		};
	};

	if (!@name.append(spelling)) {
		return @this.error(entity->token(), rt::string_view("cannot allocate native symbol name\0"));
	};

	LLVMOpaqueType* type = @this.type(entity->type());

	if (!type) {
		return false;
	};

	LLVMOpaqueValue* value;

	if (entity->kind() == entity_kind::function) {
		@value = LLVMAddFunction(this.module(), name.c_str(), type);
	}
	else {
		@value = LLVMAddGlobal(this.module(), LLVMOpaqueType*(type), name.c_str());
		LLVMSetInitializer(LLVMOpaqueValue*(value), LLVMConstNull(type));
	};

	NativeEntity native;
	@native.source = entity;
	@native.value = value;
	@native.implementation = value;

	if (entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary) {
		rt::string wrapper;

		if (!@wrapper.append(rt::string_view("rt.dispatch.\0")) || !@wrapper.append(name.view())) {
			return @this.error(entity->token(), rt::string_view("cannot allocate dispatch symbol name\0"));
		};

		@native.value = LLVMAddFunction(this.module(), wrapper.c_str(), type);
	};

	if (!@this.entities.push_back($native)) {
		Token location;

		return @this.error(location, rt::string_view("cannot retain native symbol identity\0"));
	};

	return true;
};

fn Backend::required(const Backend& this, Entity* entity) -> bool {
	if (entity->canonical() != entity || (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global)) {
		return false;
	};

	if (entity->kind() == entity_kind::function && (entity->instantiated() || entity->origin() == declaration_origin::compiler_supplied) && entity->body_state() != entity_state::ready) {
		return false;
	};

	return true;
};

fn Backend::external_signature(Backend& this, Entity* entity) -> bool {
	const FunctionSignature& signature = entity->type()->signature();
	const Type* result = signature.result()->representation();

	if (result->kind() == type_kind::array || result->kind() == type_kind::named) {
		return @this.error(entity->token(), rt::string_view("external aggregate return requires unsupported C ABI lowering\0"));
	};

	usize index = 0;

	while (index < signature.parameters().size()) {
		const Type* parameter = signature.parameters().data()[index]->representation();

		if (parameter->kind() == type_kind::array || parameter->kind() == type_kind::named) {
			return @this.error(entity->token(), rt::string_view("external aggregate parameter requires unsupported C ABI lowering\0"));
		};

		@index = index + 1;
	};

	return true;
};

struct NativeBinding {
	Entity* entity;
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* live;
};

struct NativeTemporary {
	SemanticExpression* expression;
	LLVMOpaqueValue* address;
	LLVMOpaqueValue* live;
};

struct NativeAssignment {
	LLVMOpaqueValue* value;
	LLVMOpaqueValue* address;
};

struct NativeControl {
	LLVMOpaqueBasicBlock* leave;
	LLVMOpaqueBasicBlock* resume;
	NativeControl* parent;
	usize binding_boundary;
	usize leave_edges;
};

enum native_evaluation : [u08] {
	value;
	address;
};

struct FunctionEmitter {
	fn FunctionEmitter(FunctionEmitter& this, Backend& backend, LLVMOpaqueValue* function, const Type* result);

	fn emit(FunctionEmitter& this, Entity* function) -> bool;
	fn statement(FunctionEmitter& this, SemanticExpression* expression) -> bool;
	fn value(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn address(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;

	fn bind(FunctionEmitter& this, Entity* entity, LLVMOpaqueValue* address) -> bool;
	fn destroy(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool;
	fn needs_destruction(const Type* type) -> bool;

	fn take(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn construct_into(FunctionEmitter& this, SemanticExpression* expression, LLVMOpaqueValue* address) -> bool;
	fn initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool;
	fn initialize_value(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address, SemanticExpression* value) -> bool;

	fn finish_expression(FunctionEmitter& this) -> bool;
	fn copy_initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;
	fn move_initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;
	fn copy_representation(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;

private:
	fn storage(const FunctionEmitter& this, Entity* entity) -> LLVMOpaqueValue*;
	fn terminated(const FunctionEmitter& this) -> bool;
	fn block(FunctionEmitter& this, const char* name) -> LLVMOpaqueBasicBlock*;

	fn slot(FunctionEmitter& this, const Type* type) -> LLVMOpaqueValue*;
	fn native_slot(FunctionEmitter& this, LLVMOpaqueType* type) -> LLVMOpaqueValue*;

	fn live_flag(FunctionEmitter& this) -> LLVMOpaqueValue*;
	fn set_live(FunctionEmitter& this, SemanticExpression* expression, bool live);
	fn remember(FunctionEmitter& this, SemanticExpression* expression, LLVMOpaqueValue* address) -> bool;
	fn temporary(const FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;

	fn cleanup_temporaries(FunctionEmitter& this, usize begin) -> bool;
	fn cleanup_bindings(FunctionEmitter& this, usize begin) -> bool;
	fn guarded_destroy(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address, LLVMOpaqueValue* live) -> bool;
	fn forget_temporaries(FunctionEmitter& this, usize begin);
	fn leave_scope(FunctionEmitter& this, usize begin) -> bool;

	fn scoped_statement(FunctionEmitter& this, SemanticExpression* expression) -> bool;
	fn lower_statement(FunctionEmitter& this, SemanticExpression* expression) -> bool;

	fn generated(FunctionEmitter& this, Entity* function) -> bool;
	fn initialize_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool;
	fn initialize_dispatch(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool;
	fn copy_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;
	fn transfer_elements(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, component_transfer operation) -> bool;
	fn copy_assign(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;
	fn copy_assign_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool;

	fn binding_live(FunctionEmitter& this, Entity* entity, bool live);

	fn evaluate(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn call(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn truth(FunctionEmitter& this, LLVMOpaqueValue* value, const Type* type) -> LLVMOpaqueValue*;
	fn convert(FunctionEmitter& this, LLVMOpaqueValue* value, const Type* source, const Type* target) -> LLVMOpaqueValue*;
	fn binary(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn assign(FunctionEmitter& this, SemanticExpression* expression) -> NativeAssignment;
	fn logical(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;

	fn conditional(FunctionEmitter& this, SemanticExpression* expression) -> bool;
	fn loop(FunctionEmitter& this, SemanticExpression* expression) -> bool;
	fn selection(FunctionEmitter& this, SemanticExpression* expression) -> bool;
	fn sequence(FunctionEmitter& this, SemanticExpression* expression, native_evaluation form, LLVMOpaqueValue*& result) -> bool;
	fn validate_switch_item(FunctionEmitter& this, SemanticExpression* expression) -> bool;

	fn construct(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;

	fn allocate(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn allocate_array(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;
	fn deallocate_array(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue*;

	fn destroy_range(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* memory, LLVMOpaqueValue* count) -> bool;
	fn allocation_prefix(FunctionEmitter& this, const Type* type) -> u64;

	fn representation(const Type* type) -> const Type*;

	Backend* backend;
	LLVMOpaqueValue* function;
	const Type* result;
	NativeControl* active_control;
	rt::buffer<NativeBinding> bindings;
	rt::buffer<NativeTemporary> temporaries;
};

fn FunctionEmitter::FunctionEmitter(FunctionEmitter& this, Backend& backend, LLVMOpaqueValue* function, const Type* result) {
	@this.backend = &backend;
	@this.function = function;
	@this.result = result;
};

fn FunctionEmitter::terminated(const FunctionEmitter& this) -> bool {
	LLVMOpaqueBasicBlock* current = LLVMGetInsertBlock(this.backend->builder());

	return current && LLVMGetBasicBlockTerminator(current) != nullptr;
};

fn FunctionEmitter::block(FunctionEmitter& this, const char* name) -> LLVMOpaqueBasicBlock* {
	return LLVMAppendBasicBlockInContext(this.backend->context(), this.function, name);
};

fn FunctionEmitter::bind(FunctionEmitter& this, Entity* entity, LLVMOpaqueValue* address) -> bool {
	NativeBinding binding;
	@binding.entity = entity;
	@binding.address = address;

	if (FunctionEmitter::needs_destruction(entity->type())) {
		@binding.live = @this.live_flag();

		if (!binding.live) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), binding.live);
	};

	if (!@this.bindings.push_back($binding)) {
		Token location;

		return @this.backend->error(location, rt::string_view("cannot retain native local storage\0"));
	};

	return true;
};

fn FunctionEmitter::storage(const FunctionEmitter& this, Entity* entity) -> LLVMOpaqueValue* {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].address;
		};
	};

	return this.backend->symbol(entity);
};

fn FunctionEmitter::emit(FunctionEmitter& this, Entity* function) -> bool {
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block("entry\0"));
	usize index = 0;

	while (index < function->parameters().size()) {
		Entity* parameter = function->parameters().data()[index];
		LLVMOpaqueValue* slot = @this.slot(parameter->type());

		if (!slot) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMGetParam(this.function, static_cast<u32>(index)), LLVMOpaqueValue*(slot));

		if (!@this.bind(parameter, slot)) {
			return false;
		};

		@index = index + 1;
	};

	if (function->definition() == function_definition::defaulted) {
		return @this.generated(function);
	};

	if (function->role() == function_role::constructor) {
		const Type* type = function->parameters().data()[0]->type()->element();

		if (!@this.initialize_members(type, LLVMGetParam(this.function, 0))) {
			return false;
		};
	};

	if (!@this.statement(function->body())) {
		return false;
	};

	if (this.terminated()) {
		return true;
	};

	if (function->completion() == function_completion::no_fallthrough) {
		LLVMBuildUnreachable(this.backend->builder());

		return true;
	};

	if (this.result->kind() == type_kind::void_type) {
		if (!@this.cleanup_bindings(0)) {
			return false;
		};

		LLVMBuildRetVoid(this.backend->builder());

		return true;
	};

	return @this.backend->error(function->token(), rt::string_view("non-void function reaches the end without a result\0"));
};

fn FunctionEmitter::address(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::name: {
			Entity* entity = expression->entity();
			LLVMOpaqueValue* address = this.storage(Entity*(entity));

			if (!address) {
				@this.backend->error(expression->token(), rt::string_view("entity has no native storage\0"));
				return nullptr;
			};

			if (entity->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(entity->type()), address, "reference\0");
			};

			return address;
		};

		case semantic_kind::access:
			return @this.address(expression->item(0));
		case semantic_kind::dereference:
			return @this.value(expression->item(0));
		case semantic_kind::call: {
			const Type* callable = expression->item(0)->type();

			if (callable->kind() == type_kind::pointer) {
				@callable = callable->element();
			};

			if (callable->signature().result()->kind() == type_kind::reference) {
				return @this.call(expression);
			};

			break;
		};

		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_assign || expression->operation() == token_kind::op_copy) {
				var assigned = @this.assign(expression);

				return assigned.address;
			};

			break;
		case semantic_kind::member: {
			SemanticExpression* object = expression->item(0);
			LLVMOpaqueValue* address = @this.address(object);

			if (!address) {
				return nullptr;
			};

			LLVMOpaqueValue* field = address;
			const Type* owner = expression->entity()->scope()->owner()->type();

			if (owner->entity()->layout() == record_layout::sequential) {
				@field = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(owner), address, this.backend->field_index(owner->entity(), expression->entity()->index()), "field\0");
			};

			if (expression->entity()->type()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->entity()->type()), field, "field.reference\0");
			};

			return field;
		};

		case semantic_kind::index: {
			SemanticExpression* object = expression->item(0);
			LLVMOpaqueValue* index = @this.value(expression->item(1));

			if (!index) {
				return nullptr;
			};

			const Type* offset_type = expression->item(1)->type()->representation();
			bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
			@index = LLVMBuildIntCast2(this.backend->builder(), index, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "element.offset\0");

			rt::buffer<LLVMOpaqueValue*> indices;
			LLVMOpaqueValue* base;
			const Type* element = object->type();

			if (element->kind() == type_kind::array) {
				@base = @this.address(object);

				if (!@indices.push_back(LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 32), 0, 0))) {
					@this.backend->error(expression->token(), rt::string_view("cannot allocate native array indices\0"));
					return nullptr;
				};
			}
			else {
				@base = @this.value(object);
				@element = element->element();
			};

			if (!base) {
				return nullptr;
			};

			if (!@indices.push_back(index)) {
				@this.backend->error(expression->token(), rt::string_view("cannot allocate native array indices\0"));
				return nullptr;
			};

			return LLVMBuildGEP2(this.backend->builder(), @this.backend->type(element), base, (@indices).data(), static_cast<u32>(indices.size()), "element\0");
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				return @this.address(expression->item(0));
			};

			break;
		case semantic_kind::construction:
			if (expression->size() > 1) {
				LLVMOpaqueValue* storage = @this.address(expression->item(1));

				if (!storage || !@this.construct_into(expression, storage)) {
					return nullptr;
				};

				@this.set_live(expression->item(1), true);

				return storage;
			};

			@this.value(expression);

			return this.temporary(expression);
		case semantic_kind::sequence:
			if (expression->category() == value_category::place) {
				LLVMOpaqueValue* result;

				if (!@this.sequence(expression, native_evaluation::address, @result)) {
					return nullptr;
				};

				return result;
			};

			break;
	};

	if (expression->category() == value_category::consumable) {
		LLVMOpaqueValue* value = @this.value(expression);

		if (!value) {
			return nullptr;
		};

		LLVMOpaqueValue* storage = this.temporary(expression);

		if (storage) {
			return storage;
		};

		@storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		if (!@this.remember(expression, storage)) {
			return nullptr;
		};

		return storage;
	};

	@this.backend->error(expression->token(), rt::string_view("expression does not designate native storage\0"));
	return nullptr;
};

fn FunctionEmitter::call(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	SemanticExpression* callable = expression->item(0);
	const Type* type = callable->type();

	if (type->kind() == type_kind::pointer) {
		@type = type->element();
	};

	if (type->kind() != type_kind::function) {
		@this.backend->error(expression->token(), rt::string_view("call target has no native function signature\0"));
		return nullptr;
	};

	LLVMOpaqueValue* function = @this.value(callable);

	if (!function) {
		return nullptr;
	};

	const FunctionSignature& signature = type->signature();
	SemanticExpression* source_arguments = expression->item(1);
	rt::buffer<LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < source_arguments->size()) {
		SemanticExpression* source = source_arguments->item(index);

		if (index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic && !source->type()->representation()->kind().is_scalar()) {
			@this.backend->error(source->token(), rt::string_view("aggregate variadic arguments require unsupported C ABI lowering\0"));
			return nullptr;
		};

		LLVMOpaqueValue* argument;

		if (index < signature.parameters().size() && signature.parameters().data()[index]->kind() == type_kind::reference) {
			@argument = @this.address(source);
		}
		else {
			@argument = @this.take(source);

			if (argument && index >= signature.parameters().size() && signature.arity() == parameter_arity::variadic) {
				const Type* type = FunctionEmitter::representation(source->type());

				if (type->kind() == type_kind::floating_point && type->bits() == 32) {
					@argument = LLVMBuildFPExt(this.backend->builder(), argument, LLVMDoubleTypeInContext(this.backend->context()), "vararg.float\0");
				}
				else if (type->kind() == type_kind::boolean || type->kind() == type_kind::character || (type->kind().is_integer() && type->bits() < 32)) {
					bool signed_value = type->kind() != type_kind::unsigned_integer && type->kind() != type_kind::boolean;
					@argument = LLVMBuildIntCast2(this.backend->builder(), argument, LLVMIntTypeInContext(this.backend->context(), 32), static_cast<i32>($signed_value), "vararg.integer\0");
				};
			};
		};

		if (!argument) {
			return nullptr;
		};

		if (!@arguments.push_back(argument)) {
			@this.backend->error(expression->token(), rt::string_view("cannot allocate native call arguments\0"));
			return nullptr;
		};

		@index = index + 1;
	};

	return LLVMBuildCall2(this.backend->builder(), @this.backend->type(type), function, (@arguments).data(), static_cast<u32>(arguments.size()), "\0");
};

fn FunctionEmitter::native_slot(FunctionEmitter& this, LLVMOpaqueType* native) -> LLVMOpaqueValue* {
	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		Token location;
		@this.backend->error(location, rt::string_view("cannot create storage builder\0"));
		return nullptr;
	};

	LLVMOpaqueBasicBlock* entry = LLVMGetEntryBasicBlock(this.function);
	LLVMOpaqueValue* first = LLVMGetFirstInstruction(LLVMOpaqueBasicBlock*(entry));

	if (first) {
		LLVMPositionBuilderBefore(builder.get(), first);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), entry);
	};

	return LLVMBuildAlloca(builder.get(), native, "storage\0");
};

fn FunctionEmitter::needs_destruction(const Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return FunctionEmitter::needs_destruction(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return false;
	};

	Entity* record = type->entity();

	if (record->destructor()) {
		return true;
	};

	usize index = 0;

	while (index < record->bases().size()) {
		if (FunctionEmitter::needs_destruction(record->bases().data()[index])) {
			return true;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn FunctionEmitter::destroy(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool {
	if (!FunctionEmitter::needs_destruction(type)) {
		return true;
	};

	if (type->kind() == type_kind::array) {
		LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
		LLVMOpaqueValue* count = LLVMConstInt(integer, type->count(), 0);

		return @this.destroy_range(type->element(), address, count);
	};

	Entity* record = type->entity();
	Entity* destructor = record->destructor();

	if (!@this.initialize_dispatch(type, address)) {
		return false;
	};

	if (record->layout() == record_layout::overlapping && (!destructor || destructor->definition() == function_definition::defaulted)) {
		usize index = 0;

		while (index < record->fields().size()) {
			if (FunctionEmitter::needs_destruction(record->fields().data()[index]->type())) {
				return @this.backend->error(record->token(), rt::string_view("union with nontrivial members requires an explicit destructor\0"));
			};

			@index = index + 1;
		};
	};

	if (destructor) {
		if (destructor->definition() == function_definition::deleted) {
			return @this.backend->error(destructor->token(), rt::string_view("selected destructor is deleted\0"));
		};

		LLVMOpaqueValue*[1] arguments {};
		@arguments[0] = address;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(destructor->type()), this.backend->symbol(destructor), &arguments[0], 1, "\0");
	};

	if (record->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = record->fields().size();

	while (index) {
		@index = index - 1;
		Entity* field = record->fields().data()[index];

		if (FunctionEmitter::needs_destruction(field->type())) {
			LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, this.backend->field_index(record, index), "destroy.field\0");

			if (!@this.destroy(field->type(), member)) {
				return false;
			};
		};
	};

	@index = record->bases().size();

	while (index) {
		@index = index - 1;
		LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(type), address, static_cast<u32>(index), "destroy.base\0");

		if (!@this.destroy(record->bases().data()[index], base)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::slot(FunctionEmitter& this, const Type* type) -> LLVMOpaqueValue* {
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return nullptr;
	};

	return @this.native_slot(native);
};

fn FunctionEmitter::live_flag(FunctionEmitter& this) -> LLVMOpaqueValue* {
	LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	LLVMOpaqueValue* flag = @this.native_slot(boolean);

	if (!flag) {
		return nullptr;
	};

	var builder = rt::unique<LLVMOpaqueBuilder, BuilderDisposer>(LLVMCreateBuilderInContext(this.backend->context()));

	if (!builder.get()) {
		Token location;
		@this.backend->error(location, rt::string_view("cannot create lifetime builder\0"));
		return nullptr;
	};

	LLVMOpaqueValue* next = LLVMGetNextInstruction(flag);

	if (next) {
		LLVMPositionBuilderBefore(builder.get(), next);
	}
	else {
		LLVMPositionBuilderAtEnd(builder.get(), LLVMGetEntryBasicBlock(this.function));
	};

	LLVMBuildStore(builder.get(), LLVMConstNull(boolean), flag);

	return flag;
};

fn FunctionEmitter::temporary(const FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;

		if (this.temporaries.data()[index].expression == expression) {
			return this.temporaries.data()[index].address;
		};
	};

	return nullptr;
};

fn FunctionEmitter::remember(FunctionEmitter& this, SemanticExpression* expression, LLVMOpaqueValue* address) -> bool {
	NativeTemporary temporary;
	@temporary.expression = expression;
	@temporary.address = address;

	if (FunctionEmitter::needs_destruction(expression->type())) {
		@temporary.live = @this.live_flag();

		if (!temporary.live) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0), temporary.live);
	};

	if (!@this.temporaries.push_back($temporary)) {
		return @this.backend->error(expression->token(), rt::string_view("cannot retain a consumable lifetime\0"));
	};

	return true;
};

fn FunctionEmitter::value(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	LLVMOpaqueValue* value = @this.evaluate(expression);

	if (!value) {
		return nullptr;
	};

	if (expression->category() == value_category::consumable && FunctionEmitter::needs_destruction(expression->type()) && !this.temporary(expression)) {
		LLVMOpaqueValue* storage = @this.slot(expression->type());

		if (!storage) {
			return nullptr;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		if (!@this.remember(expression, storage)) {
			return nullptr;
		};
	};

	return value;
};

fn FunctionEmitter::take(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	LLVMOpaqueValue* value = @this.value(expression);
	usize index = this.temporaries.size();

	while (index) {
		@index = index - 1;
		const NativeTemporary& temporary = this.temporaries.data()[index];

		if (temporary.expression == expression && temporary.live) {
			LLVMBuildStore(this.backend->builder(), LLVMConstNull(LLVMIntTypeInContext(this.backend->context(), 1)), temporary.live);
			break;
		};
	};

	return value;
};

fn FunctionEmitter::set_live(FunctionEmitter& this, SemanticExpression* expression, bool live) {
	if (expression->indirect_storage()) {
		return;
	};

	@this.binding_live(expression->owned_binding(), live);
};

fn FunctionEmitter::binding_live(FunctionEmitter& this, Entity* entity, bool live) {
	usize index = this.bindings.size();

	while (index) {
		@index = index - 1;
		const NativeBinding& binding = this.bindings.data()[index];

		if (binding.entity == entity && binding.live) {
			LLVMBuildStore(this.backend->builder(), LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), static_cast<u64>(live), 0), binding.live);
			return;
		};
	};
};

fn FunctionEmitter::guarded_destroy(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address, LLVMOpaqueValue* live) -> bool {
	if (!live) {
		return true;
	};

	LLVMOpaqueBasicBlock* destroy = @this.block("cleanup.destroy\0");
	LLVMOpaqueBasicBlock* after = @this.block("cleanup.after\0");
	LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), boolean, live, "live\0"), destroy, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);
	LLVMBuildStore(this.backend->builder(), LLVMConstNull(boolean), live);

	if (!@this.destroy(type, address)) {
		return false;
	};

	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::cleanup_temporaries(FunctionEmitter& this, usize begin) -> bool {
	usize index = this.temporaries.size();

	while (index > begin) {
		@index = index - 1;
		const NativeTemporary& temporary = this.temporaries.data()[index];

		if (!@this.guarded_destroy(temporary.expression->type(), temporary.address, temporary.live)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::cleanup_bindings(FunctionEmitter& this, usize begin) -> bool {
	usize index = this.bindings.size();

	while (index > begin) {
		@index = index - 1;
		const NativeBinding& binding = this.bindings.data()[index];

		if (!@this.guarded_destroy(binding.entity->type(), binding.address, binding.live)) {
			return false;
		};
	};

	return true;
};

fn FunctionEmitter::forget_temporaries(FunctionEmitter& this, usize begin) {
	while (this.temporaries.size() > begin) {
		@this.temporaries.pop_back();
	};
};

fn FunctionEmitter::leave_scope(FunctionEmitter& this, usize begin) -> bool {
	if (!this.terminated() && !@this.cleanup_bindings(begin)) {
		return false;
	};

	while (this.bindings.size() > begin) {
		@this.bindings.pop_back();
	};

	return true;
};

fn FunctionEmitter::scoped_statement(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	usize begin = this.bindings.size();

	if (!@this.statement(expression)) {
		return false;
	};

	return @this.leave_scope(begin);
};

enum component_transfer : [u08] {
	initialize;
	copy_construct;
	copy_assign;
};

fn FunctionEmitter::initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool {
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	LLVMBuildStore(this.backend->builder(), LLVMConstNull(native), address);

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, address, nullptr, component_transfer::initialize);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	Entity* record = type->entity();
	Entity* constructor = record->default_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			return @this.backend->error(constructor->token(), rt::string_view("default construction selects a deleted function\0"));
		};

		LLVMOpaqueValue*[1] inputs {};
		@inputs[0] = address;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type()), this.backend->symbol(constructor), &inputs[0], 1, "\0");

		return true;
	};

	return @this.initialize_members(type, address);
};

fn FunctionEmitter::copy_initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_construct);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		LLVMBuildStore(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), native, source, "copied\0"), destination);

		return true;
	};

	Entity* record = type->entity();
	Entity* constructor = record->copy_constructor();

	if (constructor) {
		if (constructor->definition() == function_definition::deleted) {
			return @this.backend->error(constructor->token(), rt::string_view("member copy selects a deleted function\0"));
		};

		LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = source;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type()), this.backend->symbol(constructor), &inputs[0], 2, "\0");

		return true;
	};

	return @this.copy_members(type, destination, source);
};

fn FunctionEmitter::move_initialize(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "move.source\0");

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		Entity* constructor = type->entity()->move_constructor();

		if (constructor->definition() == function_definition::deleted) {
			return @this.backend->error(constructor->token(), rt::string_view("move construction selects a deleted function\0"));
		};

		LLVMOpaqueValue*[2] inputs {};
		@inputs[0] = destination;
		@inputs[1] = value;
		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type()), this.backend->symbol(constructor), &inputs[0], 2, "\0");

		return true;
	};

	return @this.copy_representation(type, destination, source);
};

fn FunctionEmitter::generated(FunctionEmitter& this, Entity* function) -> bool {
	if (!function->parameters().size() || function->parameters().data()[0]->type()->kind() != type_kind::reference) {
		return @this.backend->error(function->token(), rt::string_view("defaulted function requires an object receiver\0"));
	};

	const Type* type = function->parameters().data()[0]->type()->element();
	LLVMOpaqueValue* destination = LLVMGetParam(this.function, 0);

	if (function->role() == function_role::constructor && function->parameters().size() == 1) {
		LLVMBuildStore(this.backend->builder(), LLVMConstNull(@this.backend->type(type)), destination);

		if (!@this.initialize_members(type, destination)) {
			return false;
		};
	}
	else if (function->role() == function_role::constructor && function->parameters().size() == 2) {
		Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			LLVMOpaqueValue* input = LLVMGetParam(this.function, 1);

			if (!@this.copy_members(type, destination, input)) {
				return false;
			};
		}
		else {
			if (!@this.copy_representation(type, destination, this.storage(source))) {
				return false;
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() == function_role::assignment && function->parameters().size() == 2) {
		Entity* source = function->parameters().data()[1];

		if (source->type()->kind() == type_kind::reference) {
			if (!@this.copy_assign_members(type, destination, LLVMGetParam(this.function, 1))) {
				return false;
			};
		}
		else {
			if (!@this.destroy(type, destination)) {
				return false;
			};

			if (!@this.move_initialize(type, destination, this.storage(source))) {
				return false;
			};

			@this.binding_live(source, false);
		};
	}
	else if (function->role() != function_role::destructor) {
		return @this.backend->error(function->token(), rt::string_view("defaulted function role has no native implementation\0"));
	};

	if (!@this.cleanup_bindings(0)) {
		return false;
	};

	if (this.result->kind() == type_kind::void_type) {
		LLVMBuildRetVoid(this.backend->builder());
	}
	else if (this.result->kind() == type_kind::reference) {
		LLVMBuildRet(this.backend->builder(), destination);
	}
	else {
		LLVMBuildRet(this.backend->builder(), LLVMBuildLoad2(this.backend->builder(), @this.backend->type(this.result), destination, "generated.result\0"));
	};

	return true;
};

fn FunctionEmitter::transfer_elements(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source, component_transfer operation) -> bool {
	LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	LLVMOpaqueBasicBlock* test = @this.block("array.initialize.test\0");
	LLVMOpaqueBasicBlock* body = @this.block("array.initialize.element\0");
	LLVMOpaqueBasicBlock* after = @this.block("array.initialize.after\0");
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "index\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, LLVMConstInt(integer, type->count(), 0), "within.array\0"), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	LLVMOpaqueValue*[2] indices {};
	@indices[0] = LLVMConstNull(integer);
	@indices[1] = index;
	LLVMOpaqueValue* output = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), destination, &indices[0], 2, "initialize.destination\0");

	if (operation != component_transfer::initialize) {
		LLVMOpaqueValue* input = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), source, &indices[0], 2, "initialize.source\0");

		if (operation == component_transfer::copy_assign) {
			if (!@this.copy_assign(type->element(), output, input)) {
				return false;
			};
		}
		else {
			if (!@this.copy_initialize(type->element(), output, input)) {
				return false;
			};
		};
	}
	else {
		if (!@this.initialize(type->element(), output)) {
			return false;
		};
	};

	LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "next\0");
	LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &values[0], &blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::initialize_value(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address, SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop) {
		return @this.initialize(type, address);
	};

	if (type->kind() == type_kind::reference) {
		LLVMOpaqueValue* value = @this.address(expression);

		if (!value) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, address);

		return true;
	};

	if (expression->kind() == semantic_kind::construction && expression->category() == value_category::consumable) {
		return @this.construct_into(expression, address);
	};

	LLVMOpaqueValue* value = @this.take(expression);

	if (!value) {
		return false;
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record && type->entity()->move_constructor()) {
		LLVMOpaqueValue* source = @this.slot(type);

		if (!source) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, source);

		return @this.move_initialize(type, address, source);
	};

	LLVMBuildStore(this.backend->builder(), value, address);

	return true;
};

fn FunctionEmitter::finish_expression(FunctionEmitter& this) -> bool {
	if (!@this.cleanup_temporaries(0)) {
		return false;
	};

	@this.forget_temporaries(0);

	return true;
};

fn FunctionEmitter::copy_representation(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	if (type->kind() != type_kind::array && (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record)) {
		LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), native, source, "transfer.value\0");
		LLVMBuildStore(this.backend->builder(), value, destination);

		return true;
	};

	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	LLVMOpaqueValue* bytes = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 64), size, 0);
	LLVMBuildMemCpy(this.backend->builder(), destination, 0, source, 0, bytes);

	return true;
};

fn FunctionEmitter::initialize_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool {
	Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return true;
	};

	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	usize index = 0;

	while (index < record->bases().size()) {
		LLVMOpaqueValue* base = LLVMBuildStructGEP2(this.backend->builder(), native, address, static_cast<u32>(index), "initialize.base\0");

		if (!@this.initialize(record->bases().data()[index], base)) {
			return false;
		};

		@index = index + 1;
	};

	if (!@this.initialize_dispatch(type, address)) {
		return false;
	};

	@index = 0;

	while (index < record->fields().size()) {
		Entity* field = record->fields().data()[index];

		if (field->type()->kind() == type_kind::reference && !field->body()) {
			return @this.backend->error(field->token(), rt::string_view("reference member requires an explicit initializer\0"));
		};

		LLVMOpaqueValue* member = LLVMBuildStructGEP2(this.backend->builder(), native, address, this.backend->field_index(record, index), "initialize.field\0");
		usize temporary_boundary = this.temporaries.size();

		if (!@this.initialize_value(field->type(), member, field->body()) || !@this.cleanup_temporaries(temporary_boundary)) {
			return false;
		};

		@this.forget_temporaries(temporary_boundary);
		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::copy_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "copy.base.destination\0");
		LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "copy.base.source\0");

		if (!@this.copy_initialize(record->bases().data()[index], output, input)) {
			return false;
		};

		@index = index + 1;
	};

	if (!@this.initialize_dispatch(type, destination)) {
		return false;
	};

	@index = 0;

	while (index < record->fields().size()) {
		Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "copy.field.destination\0");
		LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "copy.field.source\0");

		if (!@this.copy_initialize(field->type(), output, input)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::copy_assign(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		Token token;

		return @this.backend->error(token, rt::string_view("generated assignment cannot replace a const or reference component\0"));
	};

	if (type->kind() == type_kind::array) {
		return @this.transfer_elements(type, destination, source, component_transfer::copy_assign);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return @this.copy_initialize(type, destination, source);
	};

	CopyAssignmentPlan* assignment = type->entity()->copy_assignment();

	if (!assignment) {
		return @this.backend->error(type->entity()->token(), rt::string_view("member copy assignment has no prepared function\0"));
	};

	usize binding_boundary = this.bindings.size();
	usize temporary_boundary = this.temporaries.size();
	LLVMOpaqueValue* destination_slot = @this.slot(assignment->destination().type());
	LLVMOpaqueValue* source_slot = @this.slot(assignment->source().type());

	if (!destination_slot || !source_slot) {
		return false;
	};

	LLVMBuildStore(this.backend->builder(), destination, destination_slot);
	LLVMBuildStore(this.backend->builder(), source, source_slot);

	if (!@this.bind(&assignment->destination(), destination_slot) || !@this.bind(&assignment->source(), source_slot)) {
		return false;
	};

	if (!@this.value(&assignment->expression()) || !@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);

	return @this.leave_scope(binding_boundary);
};

fn FunctionEmitter::copy_assign_members(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* destination, LLVMOpaqueValue* source) -> bool {
	Entity* record = type->entity();

	if (record->layout() == record_layout::overlapping) {
		return @this.copy_representation(type, destination, source);
	};

	LLVMOpaqueType* native = @this.backend->type(type);
	usize index = 0;

	while (index < record->bases().size()) {
		LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, static_cast<u32>(index), "assign.base.destination\0");
		LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, static_cast<u32>(index), "assign.base.source\0");

		if (!@this.copy_assign(record->bases().data()[index], output, input)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < record->fields().size()) {
		Entity* field = record->fields().data()[index];
		u32 component = this.backend->field_index(record, index);
		LLVMOpaqueValue* output = LLVMBuildStructGEP2(this.backend->builder(), native, destination, component, "assign.field.destination\0");
		LLVMOpaqueValue* input = LLVMBuildStructGEP2(this.backend->builder(), native, source, component, "assign.field.source\0");

		if (!@this.copy_assign(field->type(), output, input)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::truth(FunctionEmitter& this, LLVMOpaqueValue* value, const Type* type) -> LLVMOpaqueValue* {
	if (!value) {
		return nullptr;
	};

	if (type->kind() == type_kind::boolean) {
		return value;
	};

	LLVMOpaqueValue* zero = LLVMConstNull(@this.backend->type(type));

	if (type->kind() == type_kind::floating_point) {
		return LLVMBuildFCmp(this.backend->builder(), 14, value, zero, "truth\0");
	};

	return LLVMBuildICmp(this.backend->builder(), 33, value, zero, "truth\0");
};

fn FunctionEmitter::convert(FunctionEmitter& this, LLVMOpaqueValue* value, const Type* source, const Type* target) -> LLVMOpaqueValue* {
	if (!value || !source || !target) {
		return nullptr;
	};

	@source = FunctionEmitter::representation(source);
	@target = FunctionEmitter::representation(target);
	LLVMOpaqueType* native = @this.backend->type(target);

	if (LLVMTypeOf(LLVMOpaqueValue*(value)) == native) {
		return value;
	};

	if (target->kind() == type_kind::boolean) {
		return @this.truth(value, source);
	};

	if (source->kind() == type_kind::pointer && target->kind() == type_kind::pointer) {
		return value;
	};

	if (source->kind() == type_kind::pointer) {
		return LLVMBuildPtrToInt(this.backend->builder(), value, native, "pointer.integer\0");
	};

	if (target->kind() == type_kind::pointer) {
		return LLVMBuildIntToPtr(this.backend->builder(), value, native, "integer.pointer\0");
	};

	if (source->kind() == type_kind::floating_point) {
		if (target->kind() == type_kind::floating_point) {
			if (source->bits() > target->bits()) {
				return LLVMBuildFPTrunc(this.backend->builder(), value, native, "float.narrow\0");
			};

			return LLVMBuildFPExt(this.backend->builder(), value, native, "float.widen\0");
		};

		if (target->kind() == type_kind::unsigned_integer) {
			return LLVMBuildFPToUI(this.backend->builder(), value, native, "float.unsigned\0");
		};

		return LLVMBuildFPToSI(this.backend->builder(), value, native, "float.signed\0");
	};

	if (target->kind() == type_kind::floating_point) {
		if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
			return LLVMBuildUIToFP(this.backend->builder(), value, native, "unsigned.float\0");
		};

		return LLVMBuildSIToFP(this.backend->builder(), value, native, "signed.float\0");
	};

	u32 source_bits = source->bits();
	u32 target_bits = target->bits();

	if (source->kind() == type_kind::boolean) {
		@source_bits = 1;
	};

	if (source->kind() == type_kind::character) {
		@source_bits = 8;
	};

	if (target->kind() == type_kind::character) {
		@target_bits = 8;
	};

	if (source_bits > target_bits) {
		return LLVMBuildTrunc(this.backend->builder(), value, native, "integer.narrow\0");
	};

	if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
		return LLVMBuildZExt(this.backend->builder(), value, native, "unsigned.widen\0");
	};

	return LLVMBuildSExt(this.backend->builder(), value, native, "signed.widen\0");
};

fn FunctionEmitter::logical(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	SemanticExpression* left = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	LLVMOpaqueValue* first = @this.truth(@this.value(left), left->type());

	if (!first) {
		return nullptr;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	LLVMOpaqueBasicBlock* right = @this.block("logical.right\0");
	LLVMOpaqueBasicBlock* after = @this.block("logical.after\0");
	u64 immediate = 0;

	if (expression->operation() == token_kind::op_and) {
		LLVMBuildCondBr(this.backend->builder(), first, LLVMOpaqueBasicBlock*(right), LLVMOpaqueBasicBlock*(after));
	}
	else {
		@immediate = 1;
		LLVMBuildCondBr(this.backend->builder(), first, LLVMOpaqueBasicBlock*(after), LLVMOpaqueBasicBlock*(right));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), right);
	SemanticExpression* source = expression->item(1);
	LLVMOpaqueValue* second = @this.truth(@this.value(source), source->type());

	if (!second) {
		return nullptr;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	LLVMOpaqueBasicBlock* last = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(after));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	LLVMOpaqueValue* phi = LLVMBuildPhi(this.backend->builder(), LLVMOpaqueType*(boolean), "logical\0");
	LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstInt(boolean, $immediate, 0);
	@values[1] = second;
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = last;
	LLVMAddIncoming(LLVMOpaqueValue*(phi), &values[0], &blocks[0], 2);

	return phi;
};

fn FunctionEmitter::binary(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	token_kind operation = expression->operation();

	if (operation == token_kind::op_and || operation == token_kind::op_or) {
		return @this.logical(expression);
	};

	SemanticExpression* left = expression->item(0);
	SemanticExpression* right = expression->item(1);

	if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
		var assigned = @this.assign(expression);

		return assigned.value;
	};

	LLVMOpaqueValue* first = @this.value(left);
	LLVMOpaqueValue* second = @this.value(right);

	if (!first || !second) {
		return nullptr;
	};

	if ((operation == token_kind::op_plus || operation == token_kind::op_minus) && (left->type()->kind() == type_kind::pointer || right->type()->kind() == type_kind::pointer)) {
		if (left->type()->kind() == type_kind::pointer && right->type()->kind() == type_kind::pointer) {
			LLVMOpaqueValue* difference = LLVMBuildPtrDiff2(this.backend->builder(), @this.backend->type(left->type()->element()), first, second, "pointer.difference\0");

			return LLVMBuildIntCast2(this.backend->builder(), difference, @this.backend->type(expression->type()), 1, "pointer.distance\0");
		};

		const Type* pointer_type = left->type();
		const Type* offset_type = right->type();

		if (right->type()->kind() == type_kind::pointer) {
			@pointer_type = right->type();
			@offset_type = left->type();
			LLVMOpaqueValue* swap = first;
			@first = second;
			@second = swap;
		};

		if (pointer_type->element()->kind() == type_kind::void_type || pointer_type->element()->kind() == type_kind::null_type || pointer_type->element()->kind() == type_kind::function) {
			@this.backend->error(expression->token(), rt::string_view("pointer arithmetic requires an object element type\0"));
			return nullptr;
		};

		bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
		@second = LLVMBuildIntCast2(this.backend->builder(), second, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "pointer.offset\0");

		if (operation == token_kind::op_minus) {
			@second = LLVMBuildNeg(this.backend->builder(), second, "pointer.backward\0");
		};

		return LLVMBuildGEP2(this.backend->builder(), @this.backend->type(pointer_type->element()), first, &second, 1, "pointer.advance\0");
	};

	const Type* operand_type = FunctionEmitter::representation(left->type());
	bool real = operand_type->kind() == type_kind::floating_point;
	bool unsigned_value = operand_type->kind() == type_kind::unsigned_integer || operand_type->kind() == type_kind::boolean || operand_type->kind() == type_kind::pointer;
	LLVMOpaqueBuilder* builder = this.backend->builder();

	switch (operation) {
		case token_kind::op_plus:
			if (real) {
				return LLVMBuildFAdd(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildAdd(builder, first, second, "arithmetic\0");
		case token_kind::op_minus:
			if (real) {
				return LLVMBuildFSub(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSub(builder, first, second, "arithmetic\0");
		case token_kind::op_star:
			if (real) {
				return LLVMBuildFMul(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildMul(builder, first, second, "arithmetic\0");
		case token_kind::op_slash:
			if (real) {
				return LLVMBuildFDiv(builder, first, second, "arithmetic\0");
			};

			if (unsigned_value) {
				return LLVMBuildUDiv(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSDiv(builder, first, second, "arithmetic\0");
		case token_kind::op_remainder:
			if (real) {
				return LLVMBuildFRem(builder, first, second, "arithmetic\0");
			};

			if (unsigned_value) {
				return LLVMBuildURem(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildSRem(builder, first, second, "arithmetic\0");
		case token_kind::op_shift_right:
			if (unsigned_value) {
				return LLVMBuildLShr(builder, first, second, "arithmetic\0");
			};

			return LLVMBuildAShr(builder, first, second, "arithmetic\0");
		case token_kind::op_shift_left:
			return LLVMBuildShl(builder, first, second, "arithmetic\0");
		case token_kind::op_ampersand:
			return LLVMBuildAnd(builder, first, second, "arithmetic\0");
		case token_kind::op_pipe:
			return LLVMBuildOr(builder, first, second, "arithmetic\0");
		case token_kind::op_caret:
			return LLVMBuildXor(builder, first, second, "arithmetic\0");
	};

	i32 predicate = -1;

	switch (operation) {
		case token_kind::op_equal:
			@predicate = 32;

			if (real) {
				@predicate = 1;
			};

			break;
		case token_kind::op_not_equal:
			@predicate = 33;

			if (real) {
				@predicate = 14;
			};

			break;
		case token_kind::op_greater:
			@predicate = 34;

			if (real) {
				@predicate = 2;
			};

			break;
		case token_kind::op_greater_equal:
			@predicate = 35;

			if (real) {
				@predicate = 3;
			};

			break;
		case token_kind::op_less:
			@predicate = 36;

			if (real) {
				@predicate = 4;
			};

			break;
		case token_kind::op_less_equal:
			@predicate = 37;

			if (real) {
				@predicate = 5;
			};

			break;
	};

	if (predicate < 0) {
		@this.backend->error(expression->token(), rt::string_view("operator has no native lowering\0"));
		return nullptr;
	};

	if (real) {
		return LLVMBuildFCmp(builder, $predicate, first, second, "compare\0");
	};

	if (!unsigned_value && predicate >= 34) {
		@predicate = predicate + 4;
	};

	return LLVMBuildICmp(builder, $predicate, first, second, "compare\0");
};

fn FunctionEmitter::representation(const Type* type) -> const Type* {
	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration) {
		@type = type->entity()->underlying();
	};

	return type;
};

fn FunctionEmitter::assign(FunctionEmitter& this, SemanticExpression* expression) -> NativeAssignment {
	NativeAssignment result;
	LLVMOpaqueValue* value = @this.value(expression->item(1));
	LLVMOpaqueValue* address = @this.address(expression->item(0));

	if (!address || !value) {
		return $result;
	};

	LLVMBuildStore(this.backend->builder(), value, address);
	@result.value = value;
	@result.address = address;

	return $result;
};

fn FunctionEmitter::evaluate(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	if (!expression || this.backend->failed()) {
		return nullptr;
	};

	LLVMOpaqueType* type = @this.backend->type(expression->type());

	if (!type) {
		return nullptr;
	};

	switch (expression->kind()) {
		case semantic_kind::sequence: {
			LLVMOpaqueValue* result;

			if (!@this.sequence(expression, native_evaluation::value, @result)) {
				return nullptr;
			};

			return result;
		};

		case semantic_kind::sizeof_type: {
			const Type* queried = expression->item(0)->type();

			if (queried->kind() == type_kind::void_type || queried->kind() == type_kind::null_type || queried->kind() == type_kind::function) {
				@this.backend->error(expression->token(), rt::string_view("size query requires an object type\0"));
				return nullptr;
			};

			return LLVMConstInt(type, LLVMABISizeOfType(this.backend->layout(), @this.backend->type(queried)), 0);
		};

		case semantic_kind::literal_integer:
			return LLVMConstInt(type, expression->integer(), 0);
		case semantic_kind::literal_real:
			return LLVMConstReal(type, expression->real());
		case semantic_kind::null_pointer:
			return LLVMConstNull(type);
		case semantic_kind::literal_text: {
			var text = expression->text();
			LLVMOpaqueValue* bytes = LLVMConstStringInContext2(this.backend->context(), text.data(), text.size(), 1);
			LLVMOpaqueValue* global = LLVMAddGlobal(this.backend->module(), LLVMTypeOf(LLVMOpaqueValue*(bytes)), "literal\0");
			LLVMSetInitializer(LLVMOpaqueValue*(global), bytes);
			LLVMSetGlobalConstant(LLVMOpaqueValue*(global), 1);
			LLVMSetLinkage(LLVMOpaqueValue*(global), 9);

			return global;
		};

		case semantic_kind::name: {
			Entity* entity = expression->entity();

			if (entity->kind() == entity_kind::function) {
				return this.backend->symbol(entity);
			};

			if (entity->kind() == entity_kind::enumerator) {
				return LLVMConstInt(type, entity->integer(), 0);
			};

			LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0");
		};

		case semantic_kind::access:
		case semantic_kind::dereference:
		case semantic_kind::index:
		case semantic_kind::member: {
			LLVMOpaqueValue* storage = @this.address(expression);

			if (!storage) {
				return nullptr;
			};

			return LLVMBuildLoad2(this.backend->builder(), type, storage, "read\0");
		};

		case semantic_kind::address:
			return @this.address(expression->item(0));
		case semantic_kind::relocation: {
			LLVMOpaqueValue* storage = @this.address(expression->item(0));

			if (!storage) {
				return nullptr;
			};

			LLVMOpaqueValue* value = LLVMBuildLoad2(this.backend->builder(), type, storage, "relocated\0");
			@this.set_live(expression->item(0), false);

			return value;
		};

		case semantic_kind::call: {
			LLVMOpaqueValue* value = @this.call(expression);

			if (!value) {
				return nullptr;
			};

			const Type* signature = expression->item(0)->type();

			if (signature->kind() == type_kind::pointer) {
				@signature = signature->element();
			};

			if (signature->signature().result()->kind() == type_kind::reference) {
				return LLVMBuildLoad2(this.backend->builder(), type, value, "call.reference\0");
			};

			return value;
		};

		case semantic_kind::binary:
			return @this.binary(expression);
		case semantic_kind::unary: {
			SemanticExpression* operand = expression->item(0);
			LLVMOpaqueValue* value = @this.value(operand);

			if (!value) {
				return nullptr;
			};

			switch (expression->operation()) {
				case token_kind::op_plus:
					return value;
				case token_kind::op_minus:
					if (expression->type()->kind() == type_kind::floating_point) {
						return LLVMBuildFNeg(this.backend->builder(), value, "negate\0");
					};

					return LLVMBuildNeg(this.backend->builder(), value, "negate\0");
				case token_kind::op_tilde:
					return LLVMBuildNot(this.backend->builder(), value, "complement\0");
				case token_kind::op_bang:
					return LLVMBuildNot(this.backend->builder(), @this.truth(value, operand->type()), "not\0");
			};

			break;
		};

		case semantic_kind::cast:
			if (expression->category() == value_category::place) {
				LLVMOpaqueValue* storage = @this.address(expression);

				if (!storage) {
					return nullptr;
				};

				return LLVMBuildLoad2(this.backend->builder(), type, storage, "cast.reference\0");
			};

			return @this.convert(@this.take(expression->item(0)), expression->item(0)->type(), expression->type());
		case semantic_kind::construction:
			return @this.construct(expression);
		case semantic_kind::allocation:
			return @this.allocate(expression);
		case semantic_kind::deallocation: {
			LLVMOpaqueValue* pointer = @this.value(expression->item(0));

			if (!pointer) {
				return nullptr;
			};

			const Type* element = expression->item(0)->type()->element();

			if (FunctionEmitter::needs_destruction(element)) {
				LLVMOpaqueBasicBlock* destroy = @this.block("delete.destroy\0");
				LLVMOpaqueBasicBlock* after = @this.block("delete.after\0");
				LLVMBuildCondBr(this.backend->builder(), @this.truth(pointer, expression->item(0)->type()), destroy, after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), destroy);

				if (!@this.destroy(element, pointer)) {
					return nullptr;
				};

				LLVMOpaqueValue* disposed = LLVMBuildFree(this.backend->builder(), pointer);
				LLVMBuildBr(this.backend->builder(), after);
				LLVMPositionBuilderAtEnd(this.backend->builder(), after);

				return disposed;
			};

			return LLVMBuildFree(this.backend->builder(), pointer);
		};

		case semantic_kind::array_deallocation:
			return @this.deallocate_array(expression);
		case semantic_kind::discard_value:
			return @this.take(expression->item(0));
		case semantic_kind::noop:
			return LLVMConstNull(type);
	};

	@this.backend->error(expression->token(), rt::string_view("expression has no implemented native lowering\0"));
	return nullptr;
};

fn FunctionEmitter::conditional(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	SemanticExpression* condition = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	LLVMOpaqueValue* truth = @this.truth(@this.value(condition), condition->type());

	if (!truth) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);
	LLVMOpaqueBasicBlock* yes = @this.block("if.yes\0");
	LLVMOpaqueBasicBlock* no = @this.block("if.no\0");
	LLVMOpaqueBasicBlock* after = @this.block("if.after\0");
	LLVMBuildCondBr(this.backend->builder(), truth, LLVMOpaqueBasicBlock*(yes), LLVMOpaqueBasicBlock*(no));
	LLVMPositionBuilderAtEnd(this.backend->builder(), yes);

	if (!@this.scoped_statement(expression->item(1))) {
		return false;
	};

	bool yes_returns = this.terminated();

	if (!yes_returns) {
		LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(after));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), no);

	if (!@this.scoped_statement(expression->item(2))) {
		return false;
	};

	bool no_returns = this.terminated();

	if (!no_returns) {
		LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(after));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (yes_returns && no_returns) {
		LLVMBuildUnreachable(this.backend->builder());
	};

	return true;
};

fn FunctionEmitter::loop(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	usize scope_boundary = this.bindings.size();
	usize condition_index = 0;
	usize body_index = 1;

	if (expression->kind() == semantic_kind::for_loop) {
		if (!@this.statement(expression->item(0))) {
			return false;
		};

		@condition_index = 1;
		@body_index = 3;
	};

	LLVMOpaqueBasicBlock* test = @this.block("loop.condition\0");
	LLVMOpaqueBasicBlock* body = @this.block("loop.body\0");
	LLVMOpaqueBasicBlock* step = test;

	if (expression->kind() == semantic_kind::for_loop) {
		@step = @this.block("loop.step\0");
	};

	LLVMOpaqueBasicBlock* after = @this.block("loop.after\0");
	LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(test));
	LLVMPositionBuilderAtEnd(this.backend->builder(), LLVMOpaqueBasicBlock*(test));
	SemanticExpression* condition = expression->item(condition_index);
	usize temporary_boundary = this.temporaries.size();
	LLVMOpaqueValue* truth = LLVMConstInt(LLVMIntTypeInContext(this.backend->context(), 1), 1, 0);

	if (condition && condition->kind() != semantic_kind::noop) {
		@truth = @this.truth(@this.value(condition), condition->type());
	};

	if (!truth) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);
	LLVMBuildCondBr(this.backend->builder(), truth, LLVMOpaqueBasicBlock*(body), LLVMOpaqueBasicBlock*(after));
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	NativeControl loop;
	@loop.leave := after;
	@loop.resume := step;
	@loop.parent := this.active_control;
	@loop.binding_boundary = this.bindings.size();
	@this.active_control = &loop;
	bool emitted = @this.scoped_statement(expression->item(body_index));
	@this.active_control := loop.parent;

	if (!emitted) {
		return false;
	};

	if (!this.terminated()) {
		LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(step));
	};

	if (expression->kind() == semantic_kind::for_loop) {
		LLVMPositionBuilderAtEnd(this.backend->builder(), step);

		if (!@this.statement(expression->item(2))) {
			return false;
		};

		if (!this.terminated()) {
			LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(test));
		};
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::lower_statement(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return true;
	};

	if (this.backend->failed()) {
		return false;
	};

	switch (expression->kind()) {
		case semantic_kind::statements: {
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!@this.statement(expression->item(index))) {
					return false;
				};

				@index = index + 1;
			};

			return true;
		};

		case semantic_kind::sequence:
			if (expression->type()->kind() == type_kind::void_type) {
				LLVMOpaqueValue* result;

				return @this.sequence(expression, native_evaluation::value, @result);
			};

			break;
		case semantic_kind::brace: {
			usize scope_boundary = this.bindings.size();
			usize index = 0;

			while (index < expression->size() && !this.terminated()) {
				if (!@this.statement(expression->item(index))) {
					return false;
				};

				@index = index + 1;
			};

			return @this.leave_scope(scope_boundary);
		};

		case semantic_kind::variable: {
			Entity* entity = expression->entity();
			LLVMOpaqueType* type = @this.backend->type(entity->type());

			if (!type) {
				return false;
			};

			LLVMOpaqueValue* slot = @this.slot(entity->type());

			if (!slot || !@this.bind(Entity*(entity), LLVMOpaqueValue*(slot))) {
				return false;
			};

			return @this.initialize_value(entity->type(), slot, expression->item(0));
		};

		case semantic_kind::return_value: {
			if (this.result->kind() == type_kind::void_type) {
				SemanticExpression* operand = expression->item(0);

				if (operand && operand->kind() != semantic_kind::noop && !@this.statement(operand)) {
					return false;
				};

				if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(0)) {
					return false;
				};

				LLVMBuildRetVoid(this.backend->builder());

				return true;
			};

			LLVMOpaqueValue* value;

			if (this.result->kind() == type_kind::reference) {
				@value = @this.address(expression->item(0));
			}
			else {
				@value = @this.take(expression->item(0));
			};

			if (!value) {
				return false;
			};

			if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(0)) {
				return false;
			};

			LLVMBuildRet(this.backend->builder(), value);

			return true;
		};

		case semantic_kind::conditional:
			return @this.conditional(expression);
		case semantic_kind::destruction: {
			SemanticExpression* object = expression->item(0);
			LLVMOpaqueValue* address = @this.address(object);

			if (!address || !@this.destroy(object->type(), address)) {
				return false;
			};

			@this.set_live(object, false);

			return true;
		};

		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(expression);
		case semantic_kind::switch_expression:
			return @this.selection(expression);
		case semantic_kind::break_loop:
		case semantic_kind::continue_loop: {
			NativeControl* target = this.active_control;

			if (expression->kind() == semantic_kind::continue_loop) {
				while (target && !target->resume) {
					@target = target->parent;
				};
			};

			if (!target) {
				return @this.backend->error(expression->token(), rt::string_view("control transfer has no enclosing native destination\0"));
			};

			if (!@this.cleanup_temporaries(0) || !@this.cleanup_bindings(target->binding_boundary)) {
				return false;
			};

			if (expression->kind() == semantic_kind::break_loop) {
				@target->leave_edges = target->leave_edges + 1;
				LLVMBuildBr(this.backend->builder(), target->leave);
			}
			else {
				LLVMBuildBr(this.backend->builder(), target->resume);
			};

			return true;
		};
	};

	return @this.value(expression) != nullptr;
};

fn FunctionEmitter::statement(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	if (!expression || expression->kind() == semantic_kind::noop || this.terminated()) {
		return true;
	};

	usize begin = this.temporaries.size();

	if (!@this.lower_statement(expression)) {
		return false;
	};

	if (!this.terminated() && !@this.cleanup_temporaries(begin)) {
		return false;
	};

	@this.forget_temporaries(begin);

	return true;
};

fn FunctionEmitter::selection(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	SemanticExpression* condition = expression->item(0);
	SemanticExpression* body = expression->item(1);
	usize temporary_boundary = this.temporaries.size();
	LLVMOpaqueValue* value = @this.value(condition);

	if (!value || !@this.cleanup_temporaries(temporary_boundary)) {
		return false;
	};

	@this.forget_temporaries(temporary_boundary);

	if (!body) {
		return true;
	};

	if (body->kind() != semantic_kind::brace) {
		return @this.validate_switch_item(body);
	};

	LLVMOpaqueBasicBlock* after = @this.block("switch.after\0");
	LLVMOpaqueBasicBlock* otherwise = after;
	rt::buffer<LLVMOpaqueBasicBlock*> labels;
	usize index = 0;
	u32 count = 0;

	while (index < body->size()) {
		SemanticExpression* item = body->item(index);
		LLVMOpaqueBasicBlock* destination;

		if (item->kind() == semantic_kind::case_label) {
			@destination = @this.block("switch.case\0");

			if (item->token().kind == token_kind::kw_default) {
				@otherwise = destination;
			}
			else {
				@count = count + 1;
			};
		}
		else if (!@this.validate_switch_item(item)) {
			return false;
		};

		if (!@labels.push_back(destination)) {
			return @this.backend->error(item->token(), rt::string_view("cannot retain native switch labels\0"));
		};

		@index = index + 1;
	};

	LLVMOpaqueValue* instruction = LLVMBuildSwitch(this.backend->builder(), value, otherwise, count);
	@index = 0;

	while (index < body->size()) {
		SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label && item->token().kind != token_kind::kw_default) {
			LLVMOpaqueValue* constant = LLVMConstInt(@this.backend->type(condition->type()), item->integer(), 0);
			LLVMAddCase(instruction, constant, labels.data()[index]);
		};

		@index = index + 1;
	};

	usize scope_boundary = this.bindings.size();
	NativeControl control;
	@control.leave = after;
	@control.parent = this.active_control;
	@control.binding_boundary = scope_boundary;

	if (otherwise == after) {
		@control.leave_edges = 1;
	};

	@this.active_control = &control;
	LLVMPositionBuilderAtEnd(this.backend->builder(), @this.block("switch.unreachable\0"));
	@index = 0;

	while (index < body->size()) {
		SemanticExpression* item = body->item(index);

		if (item->kind() == semantic_kind::case_label) {
			if (!this.terminated()) {
				LLVMBuildBr(this.backend->builder(), labels.data()[index]);
			};

			LLVMPositionBuilderAtEnd(this.backend->builder(), labels.data()[index]);
		}
		else if (!@this.statement(item)) {
			@this.active_control = control.parent;

			return false;
		};

		@index = index + 1;
	};

	@this.active_control = control.parent;

	if (!this.terminated()) {
		@control.leave_edges = control.leave_edges + 1;
		LLVMBuildBr(this.backend->builder(), after);
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	if (!control.leave_edges) {
		LLVMBuildUnreachable(this.backend->builder());
	};

	return @this.leave_scope(scope_boundary);
};

fn FunctionEmitter::validate_switch_item(FunctionEmitter& this, SemanticExpression* expression) -> bool {
	if (expression->kind() == semantic_kind::switch_expression) {
		return true;
	};

	if (expression->kind() == semantic_kind::case_label) {
		return @this.backend->error(expression->token(), rt::string_view("nested case label lowering is not implemented\0"));
	};

	usize index = 0;

	while (index < expression->size()) {
		if (!@this.validate_switch_item(expression->item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FunctionEmitter::construct(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	if (expression->size() > 1) {
		LLVMOpaqueValue* storage = @this.address(expression);

		if (!storage) {
			return nullptr;
		};

		return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type()), storage, "reconstructed\0");
	};

	LLVMOpaqueValue* storage = @this.slot(expression->type());

	if (!storage || !@this.construct_into(expression, storage) || !@this.remember(expression, storage)) {
		return nullptr;
	};

	return LLVMBuildLoad2(this.backend->builder(), @this.backend->type(expression->type()), storage, "constructed\0");
};

fn FunctionEmitter::construct_into(FunctionEmitter& this, SemanticExpression* expression, LLVMOpaqueValue* storage) -> bool {
	const Type* type = expression->type();
	LLVMOpaqueType* native = @this.backend->type(type);

	if (!native) {
		return false;
	};

	SemanticExpression* arguments = expression->item(0);
	LLVMOpaqueValue* value = LLVMConstNull(native);
	LLVMBuildStore(this.backend->builder(), value, storage);
	Entity* constructor = expression->entity();

	if (constructor) {
		rt::buffer<LLVMOpaqueValue*> inputs;

		if (!@inputs.push_back(storage)) {
			return @this.backend->error(expression->token(), rt::string_view("cannot allocate constructor arguments\0"));
		};

		usize index = 0;

		while (index < arguments->size()) {
			LLVMOpaqueValue* argument;

			if (constructor->parameters().data()[index + 1]->type()->kind() == type_kind::reference) {
				@argument = @this.address(arguments->item(index));
			}
			else {
				@argument = @this.take(arguments->item(index));
			};

			if (!argument) {
				return false;
			};

			if (!@inputs.push_back(argument)) {
				return @this.backend->error(expression->token(), rt::string_view("cannot allocate constructor arguments\0"));
			};

			@index = index + 1;
		};

		LLVMBuildCall2(this.backend->builder(), @this.backend->type(constructor->type()), this.backend->symbol(constructor), (@inputs).data(), static_cast<u32>(inputs.size()), "\0");

		return true;
	};

	if (!arguments || !arguments->size()) {
		return @this.initialize(type, storage);
	};

	if (type->kind().is_scalar() || (arguments->size() == 1 && arguments->item(0)->type()->same_shape(*type))) {
		if (!type->kind().is_scalar() && arguments->item(0)->category() == value_category::place) {
			LLVMOpaqueValue* source = @this.address(arguments->item(0));

			if (!source) {
				return false;
			};

			return @this.copy_initialize(type, storage, source);
		};

		@value = @this.take(arguments->item(0));

		if (!value) {
			return false;
		};

		LLVMBuildStore(this.backend->builder(), value, storage);

		return true;
	};

	usize index = 0;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		if (type->entity()->bases().size()) {
			return @this.backend->error(expression->token(), rt::string_view("base aggregate argument initialization is not implemented\0"));
		};

		if (type->entity()->layout() == record_layout::overlapping) {
			return @this.backend->error(expression->token(), rt::string_view("union aggregate argument selection is not implemented\0"));
		};

		if (!@this.initialize_dispatch(type, storage)) {
			return false;
		};

		while (index < type->entity()->fields().size()) {
			Entity* field = type->entity()->fields().data()[index];
			LLVMOpaqueValue* destination = LLVMBuildStructGEP2(this.backend->builder(), native, storage, this.backend->field_index(type->entity(), index), "aggregate.field\0");

			if (!@this.initialize_value(field->type(), destination, arguments->item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	while (index < arguments->size()) {
		LLVMOpaqueValue* element = @this.take(arguments->item(index));

		if (!element) {
			return false;
		};

		@value = LLVMBuildInsertValue(this.backend->builder(), value, element, static_cast<u32>(index), "aggregate\0");
		@index = index + 1;
	};

	LLVMBuildStore(this.backend->builder(), value, storage);

	return true;
};

fn FunctionEmitter::allocate(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	if (expression->size() != 1) {
		return @this.allocate_array(expression);
	};

	const Type* element = expression->type()->element();
	LLVMOpaqueType* type = @this.backend->type(element);

	if (!type) {
		return nullptr;
	};

	LLVMOpaqueValue* pointer = LLVMBuildMalloc(this.backend->builder(), type, "allocation\0");
	LLVMOpaqueValue* exists = @this.truth(LLVMOpaqueValue*(pointer), expression->type());
	LLVMOpaqueBasicBlock* initialize = @this.block("new.initialize\0");
	LLVMOpaqueBasicBlock* after = @this.block("new.after\0");
	LLVMBuildCondBr(this.backend->builder(), exists, LLVMOpaqueBasicBlock*(initialize), LLVMOpaqueBasicBlock*(after));
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);

	if (!@this.construct_into(expression->item(0), pointer)) {
		return nullptr;
	};

	LLVMBuildBr(this.backend->builder(), LLVMOpaqueBasicBlock*(after));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return pointer;
};

fn FunctionEmitter::allocation_prefix(FunctionEmitter& this, const Type* type) -> u64 {
	u64 header = static_cast<u64>(this.backend->pointer_bits()) / 8;
	u64 alignment = static_cast<u64>(LLVMABIAlignmentOfType(this.backend->layout(), @this.backend->type(type)));

	return (header + alignment - 1) / alignment * alignment;
};

fn FunctionEmitter::allocate_array(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	SemanticExpression* construction = expression->item(0);

	if (construction->item(0)->size()) {
		@this.backend->error(expression->token(), rt::string_view("array constructor argument evaluation is not specified\0"));
		return nullptr;
	};

	const Type* element = expression->type()->element();
	LLVMOpaqueType* native = @this.backend->type(element);

	if (!native) {
		return nullptr;
	};

	u32 bits = this.backend->pointer_bits();
	LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), bits);
	LLVMOpaqueType* character = LLVMIntTypeInContext(this.backend->context(), 8);
	SemanticExpression* length = expression->item(1);
	LLVMOpaqueValue* original = @this.value(length);

	if (!original) {
		return nullptr;
	};

	bool signed_count = length->type()->representation()->kind() == type_kind::signed_integer;
	LLVMOpaqueValue* count = LLVMBuildIntCast2(this.backend->builder(), original, integer, static_cast<i32>(signed_count), "array.count\0");
	u64 prefix = @this.allocation_prefix(element);
	u64 size = LLVMABISizeOfType(this.backend->layout(), native);
	u64 maximum = (u64::max) >> (64 - static_cast<u64>(bits));

	if (prefix > maximum) {
		return LLVMConstNull(@this.backend->type(expression->type()));
	};

	u64 maximum_count = maximum;

	if (size) {
		@maximum_count = (maximum - prefix) / size;
	};

	LLVMOpaqueValue* checked = count;
	LLVMOpaqueType* checked_type = integer;

	if (length->type()->representation()->bits() > bits) {
		@checked = original;
		@checked_type = LLVMTypeOf(original);
	};

	LLVMOpaqueValue* invalid = LLVMBuildICmp(this.backend->builder(), 34, checked, LLVMConstInt(checked_type, maximum_count, 0), "array.overflow\0");

	if (signed_count) {
		LLVMOpaqueValue* negative = LLVMBuildICmp(this.backend->builder(), 40, original, LLVMConstNull(LLVMTypeOf(original)), "array.negative\0");
		@invalid = LLVMBuildOr(this.backend->builder(), invalid, negative, "array.invalid\0");
	};

	LLVMOpaqueBasicBlock* allocate = @this.block("array.allocate\0");
	LLVMOpaqueBasicBlock* initialize = @this.block("array.initialize\0");
	LLVMOpaqueBasicBlock* failure = @this.block("array.failure\0");
	LLVMOpaqueBasicBlock* after = @this.block("array.after\0");
	LLVMBuildCondBr(this.backend->builder(), invalid, failure, allocate);
	LLVMPositionBuilderAtEnd(this.backend->builder(), allocate);
	LLVMOpaqueValue* bytes = LLVMBuildMul(this.backend->builder(), count, LLVMConstInt(integer, size, 0), "array.bytes\0");
	@bytes = LLVMBuildAdd(this.backend->builder(), bytes, LLVMConstInt(integer, prefix, 0), "array.storage.bytes\0");
	LLVMOpaqueValue* memory = LLVMBuildArrayMalloc(this.backend->builder(), character, bytes, "array.storage\0");
	LLVMOpaqueValue* exists = LLVMBuildICmp(this.backend->builder(), 33, memory, LLVMConstNull(LLVMTypeOf(memory)), "array.exists\0");
	LLVMBuildCondBr(this.backend->builder(), exists, initialize, failure);
	LLVMPositionBuilderAtEnd(this.backend->builder(), initialize);
	LLVMBuildStore(this.backend->builder(), count, memory);
	LLVMOpaqueValue* offset = LLVMConstInt(integer, prefix, 0);
	LLVMOpaqueValue* data = LLVMBuildGEP2(this.backend->builder(), character, memory, &offset, 1, "array.data\0");
	LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	LLVMOpaqueBasicBlock* test = @this.block("array.construct.test\0");
	LLVMOpaqueBasicBlock* body = @this.block("array.construct.element\0");
	LLVMOpaqueBasicBlock* done = @this.block("array.construct.done\0");
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	LLVMOpaqueValue* index = LLVMBuildPhi(this.backend->builder(), integer, "array.index\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 36, index, count, "array.within\0"), body, done);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	LLVMOpaqueValue* address = LLVMBuildGEP2(this.backend->builder(), native, data, &index, 1, "array.element\0");

	if (!@this.construct_into(construction, address)) {
		return nullptr;
	};

	LLVMOpaqueValue* next = LLVMBuildAdd(this.backend->builder(), index, LLVMConstInt(integer, 1, 0), "array.next\0");
	LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstNull(integer);
	@values[1] = next;
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(index, &values[0], &blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), done);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), failure);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	LLVMOpaqueValue* result = LLVMBuildPhi(this.backend->builder(), @this.backend->type(expression->type()), "array.result\0");
	@values[0] = data;
	@values[1] = LLVMConstNull(@this.backend->type(expression->type()));
	@blocks[0] = done;
	@blocks[1] = failure;
	LLVMAddIncoming(result, &values[0], &blocks[0], 2);

	return result;
};

fn FunctionEmitter::deallocate_array(FunctionEmitter& this, SemanticExpression* expression) -> LLVMOpaqueValue* {
	SemanticExpression* operand = expression->item(0);
	const Type* element = operand->type()->element();

	if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::function) {
		@this.backend->error(expression->token(), rt::string_view("array deallocation requires a supported object layout\0"));
		return nullptr;
	};

	LLVMOpaqueValue* data = @this.value(operand);

	if (!data) {
		return nullptr;
	};

	LLVMOpaqueType* integer = LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits());
	LLVMOpaqueBasicBlock* dispose = @this.block("array.delete\0");
	LLVMOpaqueBasicBlock* after = @this.block("array.delete.after\0");
	LLVMBuildCondBr(this.backend->builder(), @this.truth(data, operand->type()), dispose, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), dispose);
	LLVMOpaqueValue* offset = LLVMConstInt(integer, 0 - @this.allocation_prefix(element), 1);
	LLVMOpaqueValue* memory = LLVMBuildGEP2(this.backend->builder(), LLVMIntTypeInContext(this.backend->context(), 8), data, &offset, 1, "array.base\0");
	LLVMOpaqueValue* count = LLVMBuildLoad2(this.backend->builder(), integer, memory, "array.count\0");

	if (!@this.destroy_range(element, data, count)) {
		return nullptr;
	};

	LLVMOpaqueValue* result = LLVMBuildFree(this.backend->builder(), memory);
	LLVMBuildBr(this.backend->builder(), after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return result;
};

fn FunctionEmitter::destroy_range(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* memory, LLVMOpaqueValue* count) -> bool {
	if (!FunctionEmitter::needs_destruction(type)) {
		return true;
	};

	LLVMOpaqueType* integer = LLVMTypeOf(count);
	LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	LLVMOpaqueBasicBlock* test = @this.block("array.destroy.test\0");
	LLVMOpaqueBasicBlock* body = @this.block("array.destroy.element\0");
	LLVMOpaqueBasicBlock* after = @this.block("array.destroy.after\0");
	LLVMBuildBr(this.backend->builder(), test);
	LLVMPositionBuilderAtEnd(this.backend->builder(), test);
	LLVMOpaqueValue* remaining = LLVMBuildPhi(this.backend->builder(), integer, "array.remaining\0");
	LLVMBuildCondBr(this.backend->builder(), LLVMBuildICmp(this.backend->builder(), 33, remaining, LLVMConstNull(integer), "array.remaining.truth\0"), body, after);
	LLVMPositionBuilderAtEnd(this.backend->builder(), body);
	LLVMOpaqueValue* previous = LLVMBuildSub(this.backend->builder(), remaining, LLVMConstInt(integer, 1, 0), "array.previous\0");
	LLVMOpaqueValue* element = LLVMBuildGEP2(this.backend->builder(), @this.backend->type(type), memory, &previous, 1, "array.destroy.address\0");

	if (!@this.destroy(type, element)) {
		return false;
	};

	LLVMOpaqueBasicBlock* tail = LLVMGetInsertBlock(this.backend->builder());
	LLVMBuildBr(this.backend->builder(), test);
	LLVMOpaqueValue*[2] values {};
	@values[0] = count;
	@values[1] = previous;
	LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = tail;
	LLVMAddIncoming(remaining, &values[0], &blocks[0], 2);
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);

	return true;
};

fn FunctionEmitter::sequence(FunctionEmitter& this, SemanticExpression* expression, native_evaluation form, LLVMOpaqueValue*& result) -> bool {
	usize bindings = this.bindings.size();
	usize temporaries = this.temporaries.size();

	if (!@this.statement(expression->item(0)) || !@this.statement(expression->item(1))) {
		return false;
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), rt::string_view("control transfer within a sequence initializer is not implemented\0"));
	};

	SemanticExpression* yielded = expression->item(2);

	if (expression->type()->kind() == type_kind::void_type) {
		if (!@this.statement(yielded)) {
			return false;
		};
	}
	else if (form == native_evaluation::address) {
		@result = @this.address(yielded);
	}
	else if (yielded->category() == value_category::consumable) {
		@result = @this.take(yielded);
	}
	else {
		@result = @this.value(yielded);
	};

	if (this.terminated()) {
		return @this.backend->error(expression->token(), rt::string_view("control transfer within a sequence yield is not implemented\0"));
	};

	if (expression->type()->kind() != type_kind::void_type && !result) {
		return false;
	};

	if (!@this.cleanup_temporaries(temporaries) || !@this.leave_scope(bindings)) {
		return false;
	};

	@this.forget_temporaries(temporaries);

	return true;
};

fn Backend::implementation(const Backend& this, Entity* entity) -> LLVMOpaqueValue* {
	@entity = entity->canonical();
	usize index = 0;

	while (index < this.entities.size()) {
		if (this.entities.data()[index].source == entity) {
			return this.entities.data()[index].implementation;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn Backend::field_index(const Backend& this, Entity* entity, usize index) -> u32 {
	return static_cast<u32>(entity->bases().size() + static_cast<usize>(entity->owns_dispatch()) + index);
};

fn Backend::table(Backend& this, Entity* entity) -> LLVMOpaqueValue* {
	usize index = 0;

	while (index < this.tables.size()) {
		if (this.tables.data()[index].source == entity) {
			return this.tables.data()[index].value;
		};

		@index = index + 1;
	};

	rt::buffer<LLVMOpaqueValue*> functions;
	@index = 0;

	while (index < entity->virtual_functions().size()) {
		Entity* function = entity->virtual_functions().data()[index];
		LLVMOpaqueValue* implementation = this.implementation(function);

		if (!implementation) {
			@this.error(function->token(), rt::string_view("virtual implementation has no prepared native declaration\0"));
			return nullptr;
		};

		if (!@functions.push_back(implementation)) {
			@this.error(function->token(), rt::string_view("cannot retain native virtual implementations\0"));
			return nullptr;
		};

		@index = index + 1;
	};

	LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	LLVMOpaqueValue* contents = LLVMConstArray2(pointer, (@functions).data(), functions.size());
	LLVMOpaqueValue* value = LLVMAddGlobal(this.module(), LLVMTypeOf(contents), "rt.vtable\0");
	LLVMSetInitializer(value, contents);
	LLVMSetGlobalConstant(value, 1);
	LLVMSetLinkage(value, 9);
	NativeTable table;
	@table.source = entity;
	@table.value = value;

	if (!@this.tables.push_back($table)) {
		@this.error(entity->token(), rt::string_view("cannot retain native virtual table\0"));
		return nullptr;
	};

	return value;
};

fn Backend::dispatch_target(Backend& this, Entity* entity, LLVMOpaqueValue* receiver) -> LLVMOpaqueValue* {
	Entity* owner = entity->scope()->owner()->virtual_owner();

	if (!owner || !receiver) {
		@this.error(entity->token(), rt::string_view("virtual dispatch has no owning receiver layout\0"));
		return nullptr;
	};

	LLVMOpaqueType* pointer = LLVMPointerTypeInContext(this.context(), 0);
	LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.builder(), @this.type(owner->type()), receiver, static_cast<u32>(owner->bases().size()), "dispatch.header\0");
	LLVMOpaqueValue* table = LLVMBuildLoad2(this.builder(), pointer, header, "dispatch.table\0");
	LLVMOpaqueValue* index = LLVMConstInt(LLVMIntTypeInContext(this.context(), this.pointer_bits()), entity->virtual_slot(), 0);
	LLVMOpaqueValue* slot = LLVMBuildGEP2(this.builder(), pointer, table, &index, 1, "dispatch.slot\0");

	return LLVMBuildLoad2(this.builder(), pointer, slot, "dispatch.target\0");
};

fn Backend::emit_dispatch(Backend& this, Entity* entity) -> bool {
	const FunctionSignature& signature = entity->type()->signature();

	if (!signature.parameters().size() || signature.parameters().data()[0]->kind() != type_kind::reference || signature.arity() == parameter_arity::variadic) {
		return @this.error(entity->token(), rt::string_view("virtual dispatch requires a fixed signature with an object receiver\0"));
	};

	LLVMOpaqueValue* function = this.symbol(entity);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), function, "entry\0"));
	rt::buffer<LLVMOpaqueValue*> arguments;
	usize index = 0;

	while (index < signature.parameters().size()) {
		if (!@arguments.push_back(LLVMGetParam(function, static_cast<u32>(index)))) {
			return @this.error(entity->token(), rt::string_view("cannot retain virtual call arguments\0"));
		};

		@index = index + 1;
	};

	LLVMOpaqueValue* target = @this.dispatch_target(entity, arguments.data()[0]);

	if (!target) {
		return false;
	};

	LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), target, (@arguments).data(), static_cast<u32>(arguments.size()), "\0");

	if (signature.result()->kind() == type_kind::void_type) {
		LLVMBuildRetVoid(this.builder());
	}
	else {
		LLVMBuildRet(this.builder(), result);
	};

	return true;
};

fn FunctionEmitter::initialize_dispatch(FunctionEmitter& this, const Type* type, LLVMOpaqueValue* address) -> bool {
	Entity* record = type->entity();
	Entity* owner = record->virtual_owner();

	if (!owner) {
		return true;
	};

	LLVMOpaqueValue* table = @this.backend->table(record);

	if (!table) {
		return false;
	};

	LLVMOpaqueValue* header = LLVMBuildStructGEP2(this.backend->builder(), @this.backend->type(owner->type()), address, static_cast<u32>(owner->bases().size()), "initialize.dispatch\0");
	LLVMBuildStore(this.backend->builder(), table, header);

	return true;
};

fn Backend::entry(Backend& this, Entity* entity) -> bool {
	const FunctionSignature& signature = entity->type()->signature();

	if (signature.parameters().size() || (signature.result()->kind() != type_kind::void_type && !signature.result()->kind().is_integer())) {
		return @this.error(entity->token(), rt::string_view("executable entry requires no parameters and an integer or void result\0"));
	};

	LLVMOpaqueType* integer = LLVMIntTypeInContext(this.context(), 32);
	LLVMOpaqueType* type = LLVMFunctionType(LLVMOpaqueType*(integer), nullptr, 0, 0);
	LLVMOpaqueValue* main = LLVMAddFunction(this.module(), "main\0", type);
	LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), main, "entry\0"));
	LLVMOpaqueValue* result = LLVMBuildCall2(this.builder(), @this.type(entity->type()), this.symbol(entity), nullptr, 0, "\0");

	if (signature.result()->kind() == type_kind::void_type) {
		@result = LLVMConstInt(integer, 0, 0);
	}
	else if (@this.type(signature.result()) != integer) {
		u32 bits = signature.result()->bits();

		if (signature.result()->kind() == type_kind::boolean) {
			@bits = 1;
		};

		if (signature.result()->kind() == type_kind::character) {
			@bits = 8;
		};

		if (bits > 32) {
			@result = LLVMBuildTrunc(this.builder(), LLVMOpaqueValue*(result), integer, "entry.result\0");
		}
		else if (signature.result()->kind() == type_kind::unsigned_integer || signature.result()->kind() == type_kind::boolean) {
			@result = LLVMBuildZExt(this.builder(), LLVMOpaqueValue*(result), integer, "entry.result\0");
		}
		else {
			@result = LLVMBuildSExt(this.builder(), LLVMOpaqueValue*(result), integer, "entry.result\0");
		};
	};

	LLVMBuildRet(this.builder(), result);

	return true;
};

fn Backend::emit(Backend& this, const SemanticUnit& unit, const rt::string_view& entry, output_kind output) -> bool {
	if (output == output_kind::executable) {
		Entity* selected = unit.root_scope()->lookup(entry);

		if (!selected || selected->kind() != entity_kind::function || !selected->body() || selected->body()->kind() == semantic_kind::noop) {
			Token location;

			return @this.error(location, rt::string_view("executable entry requires a defined function\0"));
		};

		@this.selected_entry = selected->canonical();
	};

	usize index = 0;

	while (index < unit.entities().size()) {
		if (!@this.declare(unit.entities().data()[index].get())) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < unit.entities().size()) {
		Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && entity->kind() == entity_kind::function && (entity->definition() == function_definition::defaulted || entity->body() && entity->body()->kind() != semantic_kind::noop)) {
			var emitter = FunctionEmitter(@this, this.implementation(entity), entity->type()->signature().result());

			if (!@emitter.emit(entity)) {
				return false;
			};
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < unit.entities().size()) {
		Entity* entity = unit.entities().data()[index].get();

		if (this.required(entity) && entity->kind() == entity_kind::function && entity->dispatch() != function_dispatch::ordinary && !@this.emit_dispatch(entity)) {
			return false;
		};

		@index = index + 1;
	};

	LLVMOpaqueValue* initialize;
	@index = 0;

	while (index < unit.entities().size()) {
		Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && entity->kind() == entity_kind::global) {
			if (!initialize) {
				@initialize = LLVMAddFunction(this.module(), "rt.initialize\0", LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage(LLVMOpaqueValue*(initialize), 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), LLVMOpaqueValue*(initialize), "entry\0"));
			};

			var emitter = FunctionEmitter(@this, LLVMOpaqueValue*(initialize), nullptr);

			if (!@emitter.initialize_value(entity->type(), this.symbol(entity), entity->body()) || !@emitter.finish_expression()) {
				return false;
			};
		};

		@index = index + 1;
	};

	if (initialize) {
		LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(initialize, "llvm.global_ctors\0");
	};

	LLVMOpaqueValue* finalize;
	@index = unit.entities().size();

	while (index) {
		@index = index - 1;
		Entity* entity = unit.entities().data()[index].get();

		if (entity->canonical() == entity && entity->kind() == entity_kind::global && FunctionEmitter::needs_destruction(entity->type())) {
			if (!finalize) {
				@finalize = LLVMAddFunction(this.module(), "rt.finalize\0", LLVMFunctionType(LLVMVoidTypeInContext(this.context()), nullptr, 0, 0));
				LLVMSetLinkage(finalize, 9);
				LLVMPositionBuilderAtEnd(this.builder(), LLVMAppendBasicBlockInContext(this.context(), finalize, "entry\0"));
			};

			var emitter = FunctionEmitter(@this, finalize, nullptr);

			if (!@emitter.destroy(entity->type(), this.symbol(entity))) {
				return false;
			};
		};
	};

	if (finalize) {
		LLVMBuildRetVoid(this.builder());
		@this.register_lifecycle(finalize, "llvm.global_dtors\0");
	};

	if (output == output_kind::executable) {
		if (!@this.entry(this.selected_entry)) {
			return false;
		};
	};

	return @this.verify();
};

fn Backend::register_lifecycle(Backend& this, LLVMOpaqueValue* function, const char* name) {
	LLVMOpaqueType*[3] fields {};
	@fields[0] = LLVMIntTypeInContext(this.context(), 32);
	@fields[1] = LLVMPointerTypeInContext(this.context(), 0);
	@fields[2] := fields[1];
	LLVMOpaqueType* record = LLVMStructTypeInContext(this.context(), &fields[0], 3, 0);
	LLVMOpaqueValue*[3] values {};
	@values[0] = LLVMConstInt(LLVMOpaqueType*(fields[0]), 65535, 0);
	@values[1] = function;
	@values[2] = LLVMConstNull(LLVMOpaqueType*(fields[2]));
	LLVMOpaqueValue*[1] records {};
	@records[0] = LLVMConstNamedStruct(LLVMOpaqueType*(record), &values[0], 3);
	LLVMOpaqueValue* global = LLVMAddGlobal(this.module(), LLVMArrayType2(LLVMOpaqueType*(record), 1), name);
	LLVMSetInitializer(global, LLVMConstArray2(record, &records[0], 1));
	LLVMSetLinkage(global, 7);
};

struct Compilation {
	fn Compilation(Compilation& this, const Compilation& other) : [delete];
	fn Compilation(Compilation& this, Compilation other) : [delete];
	fn Compilation(Compilation& this, NativeFile* diagnostics);

	fn run(Compilation& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, output_kind kind) -> i32;

private:
	Diagnostics diagnostics;
	SourceManager sources;
	TypeStore types;
	rt::buffer<rt::unique<Syntax>> syntax_units;
	rt::unique<SemanticUnit> semantics;
	rt::unique<Backend> backend;

	fn failure(Compilation& this, const char* message) -> i32;
};

struct Compiler {
	fn compile(Compiler& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, NativeFile* diagnostics, output_kind kind) -> i32;

private:
	rt::unique<Compilation> current;
};

fn Compilation::run(Compilation& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, output_kind kind) -> i32 {
	Token location;

	if (!paths || !count) {
		@this.diagnostics.error(location, "no source files\0");
		return 1;
	};

	if (!output_path) {
		@this.diagnostics.error(location, "native object output path is required\0");
		return 1;
	};

	if (optimization < 0 || optimization > 3) {
		@this.diagnostics.error(location, "optimization level must be between 0 and 3\0");
		return 1;
	};

	var reader = SourceReader(FileOpener(opener), @this.sources, @this.diagnostics);
	usize index = 0;

	while (index < count) {
		char* path := paths[index];

		if (!path || rt::string_view(path) == rt::string_view(output_path)) {
			@this.diagnostics.error(location, "output cannot overwrite a source file\0");
			return 1;
		};

		SourceFile* source = @reader.load($path);

		if (!source) {
			return 1;
		};

		var lexer = Lexer(@*source);

		if (!@lexer.scan()) {
			@this.diagnostics.error(lexer.error_token(), lexer.error());
			return 1;
		};

		var parser = Parser(source->tokens());
		var unit = @parser.parse();

		if (!unit.get()) {
			@this.diagnostics.error(parser.error_token(), parser.error());
			return 1;
		};

		if (!@this.syntax_units.push_back($unit)) {
			@this.diagnostics.error(location, "syntax storage is unavailable\0");
			return 1;
		};

		@index = index + 1;
	};

	@this.backend = rt::unique<Backend>(new Backend(@this.diagnostics));

	if (!this.backend.get()) {
		@this.diagnostics.error(location, "backend storage is unavailable\0");
		return 1;
	};

	if (!@this.backend.get()->initialize($optimization)) {
		return @this.failure("internal compiler error: target initialization failed without a diagnostic\0");
	};

	var analyzer = Analyzer(@this.types, @this.diagnostics, this.backend.get()->pointer_bits());
	@this.semantics = @analyzer.analyze(this.syntax_units);

	if (!this.semantics.get() || this.diagnostics.failed()) {
		return @this.failure("internal compiler error: semantic analysis failed without a diagnostic\0");
	};

	var lifetimes = LifetimeAnalyzer(@this.diagnostics);

	if (!@lifetimes.validate(*this.semantics.get())) {
		return @this.failure("internal compiler error: lifetime analysis failed without a diagnostic\0");
	};

	var entry_name = rt::string_view("main\0");

	if (entry) {
		@entry_name = rt::string_view(entry);
	};

	if (!@this.backend.get()->emit(*this.semantics.get(), entry_name, $kind)) {
		return @this.failure("internal compiler error: native emission failed without a diagnostic\0");
	};

	var output = File(opener($output_path, "wb\0"));

	if (!output.is_open()) {
		@this.diagnostics.error(location, "cannot open native object output\0");
		return 1;
	};

	if (!@this.backend.get()->write(@output) || !@output.close()) {
		@this.diagnostics.error(location, "cannot write native object output\0");
		return 1;
	};

	return 0;
};

fn Compilation::Compilation(Compilation& this, NativeFile* diagnostics) {
	@this.diagnostics = Diagnostics($diagnostics);
};

fn Compilation::failure(Compilation& this, const char* message) -> i32 {
	if (!this.diagnostics.failed()) {
		Token location;
		@this.diagnostics.error(location, message);
	};

	return 1;
};

fn Compiler::compile(Compiler& this, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, NativeFile* diagnostics, output_kind kind) -> i32 {
	@this.current = rt::unique<Compilation>(new Compilation($diagnostics));

	if (!this.current.get()) {
		return 1;
	};

	return @this.current.get()->run($paths, $count, $output_path, $opener, $entry, $optimization, $kind);
};

fn fopen(const char* path, const char* mode) -> NativeFile*;

fn platform_standard_error() -> NativeFile*;

fn rutile_compiler_session(((Compiler*, void*) -> i32)* callback, void* data) -> i32 {
	var compiler = rt::unique<Compiler>::make();

	if (!compiler.get()) {
		return 1;
	};

	return callback(compiler.get(), $data);
};

fn rutile_compile(Compiler* compiler, char** paths, usize count, char* output_path, FileOpener opener, char* entry, i32 optimization, NativeFile* diagnostics) -> i32 {
	if (!compiler) {
		return 1;
	};

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler->compile($paths, $count, $output_path, $opener, $entry, $optimization, $diagnostics, output_kind::executable);
};

fn rutile_compile_library(char** paths, usize count, char* output_path, FileOpener opener, i32 optimization, NativeFile* diagnostics) -> i32 {
	Compiler compiler;

	if (!opener) {
		@opener = &fopen;
	};

	if (!diagnostics) {
		@diagnostics = platform_standard_error();
	};

	return @compiler.compile($paths, $count, $output_path, $opener, nullptr, $optimization, $diagnostics, output_kind::library);
};

fn Analyzer::construct(Analyzer& this, Scope& scope, Syntax& syntax, const Type* type, Syntax& arguments) -> rt::unique<SemanticExpression> {
	if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function || type->kind() == type_kind::reference) {
		@this.error(&syntax, "construction requires an object type\0");

		return rt::unique<SemanticExpression>();
	};

	rt::buffer<rt::unique<SemanticExpression>> raw;
	usize index = 0;
	while (index < arguments.size()) {
		var value = @this.expression(@scope, @*arguments.item(index), rt::optional_ref<const Type>());

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@raw.push_back($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	return @this.construct_values(@syntax, type, $raw);
};

fn Analyzer::construct_values(Analyzer& this, Syntax& syntax, const Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression> {
	var values = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void\0")), &syntax);

	if (!values.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	Entity* constructor = nullptr;
	bool transfer = false;

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
		Entity* owner = type->entity();

		if (!@this.resolve(Entity*(owner))) {
			return rt::unique<SemanticExpression>();
		};

		Entity* candidate = owner->members()->local(owner->name());

		if (candidate && candidate->kind() == entity_kind::function) {
			@constructor = @this.select(candidate, raw, 1, conversion_mode::explicit_only, @syntax);

			if (this.diagnostics->failed()) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.error(&syntax, "selected constructor is deleted\0");

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && raw.size() == 1 && raw.data()[0].get()->type()->same_shape(*type)) {
			@transfer = true;
		};

		bool declared_constructor = false;
		usize member = 0;
		while (member < owner->members()->bindings().size()) {
			Entity* declaration = owner->members()->bindings().data()[member];
			if (declaration->kind() == entity_kind::function && declaration->name() == owner->name() && declaration->origin() == declaration_origin::source) {
				@declared_constructor = true;
			};
			@member = member + 1;
		};

		if (!constructor && declared_constructor && !transfer) {
			@this.error(&syntax, "no applicable constructor\0");

			return rt::unique<SemanticExpression>();
		};

		if (!constructor && !transfer && raw.size() > owner->fields().size()) {
			@this.error(&syntax, "too many aggregate initializer arguments\0");

			return rt::unique<SemanticExpression>();
		};
	}
	else if (raw.size() > 1) {
		@this.error(&syntax, "scalar construction accepts at most one argument\0");

		return rt::unique<SemanticExpression>();
	};

	@index = 0;
	rt::unique<SemanticExpression>* owned = (@raw).data();

	while (index < raw.size()) {
		const Type* expected = type;

		if (constructor) {
			@expected = constructor->parameters().data()[index + 1]->type();
		}
		else if (!transfer && type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) {
			@expected = type->entity()->fields().data()[index]->type();
		};

		var value = rt::unique<SemanticExpression>(@owned[index].release());

		if (transfer) {
			if (value.get()->category() == value_category::place && !@this.prepare_copy(type)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else if (type->kind().is_numeric() && value.get()->type()->kind().is_numeric() || type->kind() != type_kind::named && type->same_shape(*value.get()->type())) {
			var conversion = @this.node(semantic_kind::cast, type, &syntax);

			if (!conversion.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@conversion.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@value = $conversion;
		}
		else {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*expected), @syntax);
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@values.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	var result = @this.node(semantic_kind::construction, type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($values)) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->bind($constructor, value_category::consumable);

	return $result;
};

fn Analyzer::initialize(Analyzer& this, Syntax& syntax, const Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression> {
	if (!type) {
		return $value;
	};

	bool explicit_copy = syntax.kind() == syntax_kind::variable && syntax.variable_initializer()->kind() == syntax_kind::unary && syntax.variable_initializer()->token().kind == token_kind::op_copy;
	if (explicit_copy && value.get()->kind() != semantic_kind::noop) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};
		return @this.construct_values(@syntax, type, $arguments);
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		if (value.get()->kind() == semantic_kind::noop) {
			return $value;
		};

		return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
	};

	if (value.get()->kind() == semantic_kind::construction && value.get()->type()->same_shape(*type)) {
		return $value;
	};

	if (!explicit_copy && value.get()->category() == value_category::place && value.get()->type()->same_shape(*type)) {
		if (@this.implicit_constructor(*value.get(), *type) || @this.conversion_function(*value.get(), *type, conversion_mode::implicit_allowed)) {
			return @this.convert($value, rt::optional_ref<const Type>(*type), @syntax);
		};
	};

	rt::buffer<rt::unique<SemanticExpression>> arguments;

	if (value.get()->kind() != semantic_kind::noop) {
		if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};
	};

	return @this.construct_values(@syntax, type, $arguments);
};

fn Analyzer::call(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression> {
	Syntax* source = syntax.callable();
	Syntax* arguments = syntax.arguments();
	Entity* explicit_pattern = @this.templates.call_pattern(@this, @scope, @*source);
	rt::optional_ref<Syntax> supplied;

	if (explicit_pattern) {
		Syntax* application = source;

		if (application->kind() == syntax_kind::qualified_name) {
			@application = application->right();
		};

		@supplied.bind(@*application->arguments());
	};

	if (source->kind() == syntax_kind::type_name || source->kind() == syntax_kind::type_pointer || source->kind() == syntax_kind::type_reference || source->kind() == syntax_kind::type_array || source->kind() == syntax_kind::type_const || source->kind() == syntax_kind::type_function || source->kind() == syntax_kind::type_auto) {
		const Type* target = @this.type(@scope, @*source);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
	};

	if (!explicit_pattern && (source->kind() == syntax_kind::name || source->kind() == syntax_kind::qualified_name || source->kind() == syntax_kind::template_apply)) {
		const Type* target = nullptr;
		Entity* named = @this.lookup(@scope, @*source);

		if (source->kind() == syntax_kind::name && !named) {
			@target = this.types->find_primitive(source->token().text());
		};

		if (named && named->denotes_type()) {
			@target = @this.type(@scope, @*source);
		};

		if (target) {
			return @this.convert(@this.construct(@scope, @syntax, target, @*arguments), expected, @syntax);
		};
	};

	Entity* group = nullptr;
	rt::unique<SemanticExpression> receiver;
	rt::unique<SemanticExpression> callable;

	if (source->kind() == syntax_kind::member) {
		@receiver = @this.expression(@scope, @*source->member_object(), rt::optional_ref<const Type>());

		if (!receiver.get()) {
			return rt::unique<SemanticExpression>();
		};

		const Type* owner = receiver.get()->type();

		if (source->token().kind == token_kind::op_arrow) {
			if (owner->kind() != type_kind::pointer) {
				@this.error(source, "arrow method access requires a pointer\0");

				return rt::unique<SemanticExpression>();
			};

			@owner = owner->element();
			var dereference = @this.node(semantic_kind::dereference, owner, source);

			if (!dereference.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@dereference.get()->append(rt::unique<SemanticExpression>(@receiver.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@dereference.get()->set_category(value_category::place);
			@receiver = $dereference;
		};

		if (owner->kind() != type_kind::named || !owner->entity()->members()) {
			if (source->member_name()->kind() != syntax_kind::unary) {
				Entity* alias = @this.lookup(@scope, @*source->member_name());
				const Type* builtin = this.types->find_primitive(source->member_name()->token().text());

				if (!builtin && (!alias || !alias->denotes_type())) {
					@this.error(source, "method requires a class or enum object\0");

					return rt::unique<SemanticExpression>();
				};
			};
		};

		Syntax* member = source->member_name();
		bool destructor = member->kind() == syntax_kind::unary && member->token().kind == token_kind::op_tilde;
		const Type* designated = nullptr;

		if (destructor) {
			@designated = @this.type(@scope, @*member->operand());
		}
		else {
			@designated = this.types->find_primitive(member->token().text());
			Entity* alias = @this.lookup(@scope, @*member);

			if (alias && alias->denotes_type()) {
				if (!@this.resolve(Entity*(alias))) {
					return rt::unique<SemanticExpression>();
				};

				@designated = alias->type();
			};
		};

		if (designated && designated->same_shape(*owner)) {
			if (owner->qualifier() == type_qualifier::immutable || !accessed && receiver.get()->kind() != semantic_kind::access) {
				@this.error(source, "explicit construction or destruction requires mutable access\0");

				return rt::unique<SemanticExpression>();
			};

			if (destructor) {
				if (arguments->size()) {
					@this.error(source, "destructor accepts no arguments after its receiver\0");

					return rt::unique<SemanticExpression>();
				};

				var result = @this.node(semantic_kind::destruction, this.types->find_primitive(rt::string_view("void\0")), &syntax);

				if (!result.get()) {
					return rt::unique<SemanticExpression>();
				};

				Entity* finalizer = nullptr;

				if (owner->kind() == type_kind::named && owner->entity()->kind() == entity_kind::record) {
					@finalizer = owner->entity()->destructor();
				};

				@result.get()->bind(finalizer, value_category::consumable);

				if (!@result.get()->append($receiver)) {
					return rt::unique<SemanticExpression>();
				};

				return $result;
			};

			var result = @this.construct(@scope, @syntax, designated, @*arguments);

			if (!result.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($receiver)) {
				return rt::unique<SemanticExpression>();
			};

			@result.get()->set_category(value_category::place);

			return @this.convert($result, expected, @syntax);
		};

		if (destructor) {
			@this.error(source, "destructor type does not match its object\0");

			return rt::unique<SemanticExpression>();
		};

		if (owner->kind() != type_kind::named) {
			@this.error(source, "explicit construction type does not match its destination\0");

			return rt::unique<SemanticExpression>();
		};

		@group = owner->entity()->find_member(source->member_name()->token().text());

		if (group && group->kind() == entity_kind::field) {
			@callable = @this.member_value(@scope, @*source, rt::unique<SemanticExpression>(@receiver.release()), rt::optional_ref<const Type>());

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@group = nullptr;
		};

		if (accessed && receiver.get()) {
			var access = @this.node(semantic_kind::access, owner, source);

			if (!access.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@access.get()->append(rt::unique<SemanticExpression>(@receiver.release()))) {
				return rt::unique<SemanticExpression>();
			};

			@access.get()->set_category(value_category::place);
			@receiver = $access;
		};
	}
	else if (explicit_pattern) {
		@group = explicit_pattern;
	}
	else {
		@group = @this.lookup(@scope, @*source);
	};

	rt::buffer<rt::unique<SemanticExpression>> values;

	if (receiver.get()) {
		if (!@values.push_back(rt::unique<SemanticExpression>(@receiver.release()))) {
			return rt::unique<SemanticExpression>();
		};
	};

	usize index = 0;
	while (index < arguments->size()) {
		rt::unique<SemanticExpression> value;

		if (arguments->item(index)->kind() == syntax_kind::brace) {
			@value = @this.node(semantic_kind::deferred_argument, this.types->find_primitive(rt::string_view("void\0")), arguments->item(index));
		}
		else {
			@value = @this.expression(@scope, @*arguments->item(index), rt::optional_ref<const Type>());
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@values.push_back($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (group && group->kind() == entity_kind::template_pattern) {
		@group = @this.templates.specialize_call(@this, @scope, @*group, supplied, values);

		if (!group) {
			return rt::unique<SemanticExpression>();
		};
	};

	Entity* selected = nullptr;

	if (group && group->kind() == entity_kind::function) {
		@selected = @this.select(group, values, 0, conversion_mode::explicit_only, @syntax);

		if (!selected) {
			@this.error(&syntax, "call has no unique applicable function\0");

			return rt::unique<SemanticExpression>();
		};

		if (selected->definition() == function_definition::deleted) {
			@this.error(&syntax, "selected function is deleted\0");

			return rt::unique<SemanticExpression>();
		};

		if (!this.accessible(*selected, @scope)) {
			@this.error(&syntax, "private or protected function is not accessible\0");

			return rt::unique<SemanticExpression>();
		};

		@callable = @this.node(semantic_kind::name, selected->type(), source);

		if (!callable.get()) {
			return rt::unique<SemanticExpression>();
		};

		@callable.get()->bind(Entity*(selected), value_category::place);
	}
	else if (!callable.get()) {
		@callable = @this.expression(@scope, @*source, rt::optional_ref<const Type>());
	};

	if (callable.get() && !@this.contextual_arguments(@scope, @syntax, @*callable.get(), @values)) {
		return rt::unique<SemanticExpression>();
	};

	return @this.invoke(@syntax, selected, $callable, $values, expected);
};

fn Analyzer::invoke(Analyzer& this, Syntax& syntax, Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* signature = callable.get()->type();

	if (signature->kind() == type_kind::pointer) {
		@signature = signature->element();
	};

	if (signature->kind() != type_kind::function) {
		@this.error(&syntax, "call requires a function\0");

		return rt::unique<SemanticExpression>();
	};

	usize fixed = signature->signature().parameters().size();

	if (values.size() < fixed || signature->signature().arity() != parameter_arity::variadic && values.size() != fixed) {
		@this.error(&syntax, "call requires a function and matching arguments\0");

		return rt::unique<SemanticExpression>();
	};

	var converted = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void\0")), &syntax);

	if (!converted.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	rt::unique<SemanticExpression>* owners = (@values).data();

	while (index < values.size()) {
		var value = rt::unique<SemanticExpression>(@owners[index].release());

		if (index < fixed) {
			@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*signature->signature().parameters().data()[index]), @syntax);
		}
		else if (!value.get()->type()->representation()->kind().is_scalar()) {
			@this.error(&syntax, "variadic argument requires a scalar value\0");

			return rt::unique<SemanticExpression>();
		};

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@converted.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	const Type* result_type = signature->signature().result();
	value_category category = value_category::consumable;

	if (result_type->kind() == type_kind::reference) {
		@result_type = result_type->element();
		@category = value_category::place;
	};

	var result = @this.node(semantic_kind::call, result_type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($callable)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($converted)) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->bind(selected, $category);

	if (signature->signature().result()->kind() == type_kind::reference) {
		@result.get()->set_mutable_access(result_type->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::contextual_arguments(Analyzer& this, Scope& scope, Syntax& syntax, SemanticExpression& callable, rt::buffer<rt::unique<SemanticExpression>>& values) -> bool {
	const TypeUse* use = callable.type_use().get();

	if (!use && callable.entity()) {
		@use = callable.entity()->type_use().get();
	};

	if (use && use->type().kind() == type_kind::pointer) {
		@use = &use->element();
	};

	usize offset = values.size() - syntax.arguments()->size();
	usize index = 0;
	while (index < values.size()) {
		if (values.data()[index].get()->kind() == semantic_kind::deferred_argument) {
			if (!use || use->type().kind() != type_kind::function || index >= use->callable().parameters().size()) {
				@this.error(&syntax, "contextual argument requires a fixed parameter type\0");
				return false;
			};

			const ParameterUse& parameter = use->callable().parameters().data()[index];
			var value = @this.contextual_argument(@scope, @*syntax.arguments()->item(index - offset), parameter.type(), parameter.name());

			if (!value.get()) {
				return false;
			};

			@(@values).data()[index] = $value;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::contextual_argument(Analyzer& this, Scope& scope, Syntax& syntax, const TypeUse& use, const rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression> {
	if (!name.has_value()) {
		@this.error(&syntax, "argument block requires a named parameter\0");

		return rt::unique<SemanticExpression>();
	};

	const Type* type = &use.type();
	const Type* value_type = type;
	bool reference = type->kind() == type_kind::reference;

	if (reference) {
		@value_type = type->element();
	};

	Scope* local = @this.unit->create_scope(&scope, this.function);

	if (!local) {
		return rt::unique<SemanticExpression>();
	};

	Token token = syntax.token();

	if (name.has_value()) {
		@token = name.value().location();
	};

	var init = @this.node(semantic_kind::noop, this.types->find_primitive(rt::string_view("void\0")), &syntax);
	var body = @this.node(semantic_kind::statements, this.types->find_primitive(rt::string_view("void\0")), &syntax);
	Entity* binding = nullptr;

	if (!reference) {
		@binding = @this.unit->create_entity(entity_kind::local, token, &syntax, local);

		if (!binding) {
			return rt::unique<SemanticExpression>();
		};

		if (name.has_value() && !@binding->set_name(name.value().text())) {
			return rt::unique<SemanticExpression>();
		};

		@binding->set_type(type);
		@binding->set_type_use(use);
		@binding->set_state(entity_state::ready);
		rt::buffer<rt::unique<SemanticExpression>> empty;
		var initial = @this.construct_values(@syntax, type, $empty);
		@init = @this.node(semantic_kind::variable, type, &syntax);

		if (!initial.get() || !init.get()) {
			return rt::unique<SemanticExpression>();
		};

		@init.get()->bind(Entity*(binding), value_category::consumable);

		if (!@init.get()->append($initial)) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (!init.get() || !body.get()) {
		return rt::unique<SemanticExpression>();
	};

	usize index = 0;
	while (index < syntax.size()) {
		Syntax* statement = syntax.item(index);
		rt::unique<SemanticExpression> child;
		Syntax* target = nullptr;

		if (reference && !binding && statement->kind() == syntax_kind::binary && (statement->token().kind == token_kind::op_assign || statement->token().kind == token_kind::op_copy)) {
			@target = statement->left();

			if (target->kind() == syntax_kind::unary && target->token().kind == token_kind::op_access) {
				@target = target->operand();
			};
		};

		if (target && name.has_value() && target->kind() == syntax_kind::name && name.value().is(target->token().text())) {
			var value = @this.expression(@*local, @*statement->right(), rt::optional_ref<const Type>(*type));

			if (!value.get() || value.get()->category() != value_category::place) {
				@this.error(statement, "reference contextual argument requires a borrowed initializer\0");

				return rt::unique<SemanticExpression>();
			};

			@binding = @this.unit->create_entity(entity_kind::local, token, &syntax, local);

			if (!binding) {
				return rt::unique<SemanticExpression>();
			};

			if (!@binding->set_name(name.value().text())) {
				return rt::unique<SemanticExpression>();
			};

			@binding->set_type(type);
			@binding->set_type_use(use);
			@binding->set_state(entity_state::ready);
			@child = @this.node(semantic_kind::variable, type, statement);

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			@child.get()->bind(Entity*(binding), value_category::consumable);

			if (!@child.get()->append($value)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			@child = @this.expression(@*local, @*statement, rt::optional_ref<const Type>());
		};

		if (!child.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@body.get()->append($child)) {
			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	if (!binding) {
		@this.error(&syntax, "reference requires a bound initializer\0");

		return rt::unique<SemanticExpression>();
	};

	var yield = @this.node(semantic_kind::name, value_type, &syntax);

	if (!yield.get()) {
		return rt::unique<SemanticExpression>();
	};

	@yield.get()->bind(binding, value_category::place);

	if (reference) {
		@yield.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	if (!reference) {
		var transfer = @this.node(semantic_kind::relocation, type, &syntax);

		if (!transfer.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@transfer.get()->append(rt::unique<SemanticExpression>(@yield.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@yield = $transfer;
	};

	var result = @this.node(semantic_kind::sequence, value_type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->set_category(yield.get()->category());

	if (reference) {
		@result.get()->set_mutable_access(value_type->qualifier() == type_qualifier::mutable);
	};

	@result.get()->set_type_use(use.effective());

	if (!@result.get()->append($init)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($body)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($yield)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::select(Analyzer& this, Entity* group, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity* {
	rt::buffer<Entity*> candidates;
	const rt::buffer<Entity*>& bindings = group->scope()->bindings();
	usize index = 0;
	while (index < bindings.size()) {
		Entity* candidate = bindings.data()[index];

		if (candidate->kind() == entity_kind::function && candidate->name() == group->name()) {
			if (!@candidates.push_back(Entity*(candidate))) {
				@this.error(&syntax, "out of memory collecting function candidates\0");

				return nullptr;
			};
		};

		@index = index + 1;
	};

	return @this.select_candidates(candidates, arguments, $skipped, $mode, @syntax);
};

fn Analyzer::select_candidates(Analyzer& this, const rt::buffer<Entity*>& bindings, const rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, Syntax& syntax) -> Entity* {
	Entity* selected = nullptr;
	i32 best = i32::max;
	i32 best_origin = 2;
	bool ambiguous = false;
	rt::buffer<Entity*> seen;
	usize index = 0;
	while (index < bindings.size()) {
		Entity* candidate = bindings.data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return nullptr;
		};

		@candidate = candidate->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != candidate) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back(Entity*(candidate))) {
			@this.error(&syntax, "out of memory ranking overload candidates\0");

			return nullptr;
		};

		if (mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (candidate->parameters().size() < skipped) {
			continue;
		};

		usize fixed = candidate->parameters().size() - skipped;
		bool variadic = candidate->type()->signature().arity() == parameter_arity::variadic;

		if (arguments.size() < fixed || !variadic && arguments.size() != fixed) {
			continue;
		};

		i32 rank = 0;

		if (variadic) {
			@rank = 16;
		};

		usize argument = 0;

		while (argument < fixed) {
			i32 component = @this.argument_rank(*arguments.data()[argument].get(), *candidate->parameters().data()[argument + skipped]->type());

			if (component < 0) {
				@rank = -1;
				break;
			};

			@rank = rank + component;
			@argument = argument + 1;
		};

		i32 origin = 0;

		if (candidate->origin() == declaration_origin::compiler_supplied) {
			@origin = 1;
		};

		if (rank < 0 || rank > best || rank == best && origin > best_origin) {
			continue;
		};

		if (rank == best && origin == best_origin) {
			@ambiguous = true;
			continue;
		};

		@best_origin = origin;
		@best := rank;
		@selected := candidate;
		@ambiguous = false;
	};

	if (ambiguous) {
		@this.error(&syntax, "function selection is ambiguous\0");

		return nullptr;
	};

	return $selected;
};

fn Analyzer::overloaded(Analyzer& this, Scope& scope, Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	rt::buffer<Entity*> candidates;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function && candidate->kind() != entity_kind::template_pattern) {
			continue;
		};

		if (candidate->state() == entity_state::ready && candidate->kind() == entity_kind::function) {
			if (candidate->operator_kind() != syntax.token().kind) {
				continue;
			};
		}
		else {
			Syntax* declaration = candidate->declaration();

			if (!declaration) {
				continue;
			};

			if (declaration->kind() == syntax_kind::template_declaration) {
				@declaration = declaration->template_declaration();
			};

			if (declaration->kind() != syntax_kind::function) {
				continue;
			};

			Syntax* name = declaration->function_name();

			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};

			if (name->kind() != syntax_kind::operator_name || name->operator_token().kind != syntax.token().kind) {
				continue;
			};
		};

		bool visible = false;
		Scope* enclosing = &scope;

		while (enclosing) {
			if (candidate->scope() == enclosing) {
				@visible = true;
			};

			@enclosing = enclosing->parent();
		};

		usize argument = 0;

		while (argument < arguments.size()) {
			const Type* type = arguments.data()[argument].get()->type();

			if (type->kind() == type_kind::named) {
				Entity* owner = type->entity();

				if (candidate->scope() == owner->members() || candidate->scope() == owner->scope()) {
					@visible = true;
				};
			};

			@argument = argument + 1;
		};

		if (!visible) {
			continue;
		};

		if (candidate->kind() == entity_kind::template_pattern) {
			@candidate = @this.templates.deduce(@this, @scope, @*candidate, arguments);

			if (!candidate) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!@candidates.push_back(Entity*(candidate))) {
			@this.error(&syntax, "out of memory collecting operator candidates\0");

			return rt::unique<SemanticExpression>();
		};
	};

	Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @syntax);

	if (!selected) {
		@this.error(&syntax, "operator has no unique applicable function\0");

		return rt::unique<SemanticExpression>();
	};

	if (selected->definition() == function_definition::deleted || !this.accessible(*selected, @scope)) {
		@this.error(&syntax, "selected operator is deleted or inaccessible\0");

		return rt::unique<SemanticExpression>();
	};

	var callable = @this.node(semantic_kind::name, selected->type(), &syntax);

	if (!callable.get()) {
		return rt::unique<SemanticExpression>();
	};

	@callable.get()->bind(Entity*(selected), value_category::place);

	return @this.invoke(@syntax, selected, $callable, $arguments, expected);
};

fn Analyzer::implicit_constructor(Analyzer& this, const SemanticExpression& value, const Type& expected) -> Entity* {
	if (expected.kind() != type_kind::named || expected.entity()->kind() != entity_kind::record) {
		return nullptr;
	};

	Entity* owner = expected.entity();
	Entity* selected = nullptr;
	i32 best = i32::max;
	bool ambiguous = false;
	usize index = 0;
	while (index < owner->members()->bindings().size()) {
		Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function || !candidate->token().same(owner->token())) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return nullptr;
		};

		@candidate = candidate->canonical();

		if (candidate->conversion() != conversion_mode::implicit_allowed || candidate->parameters().size() != 2) {
			continue;
		};

		i32 rank = this.builtin_rank(value, *candidate->parameters().data()[1]->type());

		if (rank < 0 || rank > best) {
			continue;
		};

		if (rank == best && selected != candidate) {
			@ambiguous = true;
			continue;
		};

		if (rank < best) {
			@selected := candidate;
			@best := rank;
			@ambiguous = false;
		};
	};

	if (ambiguous) {
		return nullptr;
	};

	return $selected;
};

fn Analyzer::conversion_function(Analyzer& this, const SemanticExpression& value, const Type& expected, conversion_mode mode) -> Entity* {
	const Type* source = value.type();

	Entity* selected = nullptr;
	usize index = 0;
	while (index < this.unit->entities().size()) {
		Entity* candidate = this.unit->entities().data()[index].get();
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		Syntax* name = nullptr;
		if (candidate->declaration() && candidate->declaration()->kind() == syntax_kind::function) {
			@name = candidate->declaration()->function_name();
			while (name->kind() == syntax_kind::qualified_name) {
				@name = name->right();
			};
		};

		if (candidate->role() != function_role::conversion && (!name || name->kind() != syntax_kind::conversion_name)) {
			continue;
		};

		if (source->kind() == type_kind::named && candidate->scope() != source->entity()->members() && candidate->scope() != source->entity()->scope()) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return nullptr;
		};

		@candidate = candidate->canonical();

		if (candidate->role() != function_role::conversion || candidate->parameters().size() != 1 || !candidate->type()->signature().result()->same_shape(expected) || mode == conversion_mode::implicit_allowed && candidate->conversion() != conversion_mode::implicit_allowed) {
			continue;
		};

		if (this.builtin_rank(value, *candidate->parameters().data()[0]->type()) < 0) {
			continue;
		};

		if (selected && selected != candidate) {
			return nullptr;
		};

		@selected := candidate;
	};

	return $selected;
};

fn Analyzer::argument_rank(Analyzer& this, const SemanticExpression& value, const Type& expected) -> i32 {
	if (value.kind() == semantic_kind::deferred_argument) {
		return 0;
	};

	i32 builtin = this.builtin_rank(value, expected);

	if (expected.kind() != type_kind::reference && value.category() == value_category::place && value.type()->same_shape(expected)) {
		if (@this.implicit_constructor(value, expected)) {
			return 8;
		};

		if (@this.conversion_function(value, expected, conversion_mode::implicit_allowed)) {
			return 9;
		};
	};

	if (builtin >= 0) {
		return builtin;
	};

	if (expected.kind() == type_kind::reference && expected.element()->qualifier() == type_qualifier::mutable) {
		return -1;
	};

	const Type* target = &expected;

	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	Entity* constructor = @this.implicit_constructor(value, *target);

	if (constructor) {
		return 16 + this.builtin_rank(value, *constructor->parameters().data()[1]->type());
	};

	Entity* conversion = @this.conversion_function(value, *target, conversion_mode::implicit_allowed);

	if (conversion) {
		return 17 + this.builtin_rank(value, *conversion->parameters().data()[0]->type());
	};

	return -1;
};

fn Analyzer::supply_special_functions(Analyzer& this, Entity* entity) -> bool {
	const Type* source = entity->type();
	const Type* copy = @this.types->reference(@this.types->qualified(*source, type_qualifier::immutable));

	if (!copy) {
		return false;
	};

	bool source_constructor = false;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		Entity* member = entity->members()->bindings().data()[index];

		if (member->kind() == entity_kind::function && member->role() == function_role::constructor && member->origin() == declaration_origin::source) {
			@source_constructor = true;
		};

		@index = index + 1;
	};

	if (!source_constructor) {
		Entity* constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, nullptr, function_definition::defaulted);

		if (!constructor) {
			return false;
		};

		@entity->set_default_constructor(constructor);
	};

	Entity* move_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, source, function_definition::defaulted);
	Entity* copy_constructor = @this.supply_special(entity, function_role::constructor, token_kind::identifier, copy, function_definition::defaulted);

	if (!move_constructor || !copy_constructor) {
		return false;
	};

	@entity->set_move_constructor(move_constructor);
	@entity->set_copy_constructor(copy_constructor);

	if (!@this.supply_special(entity, function_role::assignment, token_kind::op_assign, source, function_definition::defaulted)) {
		return false;
	};

	if (!@this.supply_special(entity, function_role::assignment, token_kind::op_assign, copy, function_definition::defaulted)) {
		return false;
	};

	return @this.supply_special(entity, function_role::assignment, token_kind::op_copy, copy, function_definition::defaulted) != nullptr;
};

fn Analyzer::supply_special(Analyzer& this, Entity* entity, function_role role, token_kind operation, const Type* source, function_definition definition) -> Entity* {
	const Type* receiver = @this.types->reference(entity->type());

	if (!receiver) {
		return nullptr;
	};

	usize parameter_count = 1;

	if (source) {
		@parameter_count = 2;
	};

	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		Entity* candidate = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve(Entity*(candidate))) {
			return nullptr;
		};

		@candidate = candidate->canonical();

		if (candidate->role() == role && (role == function_role::constructor || candidate->operator_kind() == operation) && candidate->parameters().size() == parameter_count && candidate->parameters().data()[0]->type() == receiver && (!source || candidate->parameters().data()[1]->type() == source)) {
			return candidate;
		};
	};

	Token location = entity->token();
	var name = entity->name();
	const Type* result = this.types->find_primitive(rt::string_view("void\0"));

	if (role == function_role::assignment) {
		@location.kind = token_kind(operation);
		@name = rt::string_view("operator=\0");
		@result := receiver;

		if (operation == token_kind::op_copy) {
			@name = rt::string_view("operator:=\0");
		};
	};

	Entity* function = @this.unit->create_entity(entity_kind::function, location, nullptr, entity->members());

	if (!function || !@function->set_name(name)) {
		@this.error(entity->declaration(), "cannot declare compiler-supplied special function\0");
		return nullptr;
	};

	@function->set_origin(declaration_origin::compiler_supplied);
	@function->set_definition(function_definition(definition));
	@function->set_role(function_role(role));
	@function->set_operator_kind(token_kind(operation));
	@function->set_access(access_kind::public_access);
	Scope* parameters = @this.unit->create_scope(entity->members(), Entity*(function));

	if (!parameters) {
		return nullptr;
	};

	@function->set_members(Scope*(parameters));
	rt::buffer<const Type*> signature;
	@index = 0;

	while (index < parameter_count) {
		const Type* type = source;
		var parameter_name = rt::string_view("other\0");

		if (!index) {
			@type = receiver;
			@parameter_name = rt::string_view("this\0");
		};

		Entity* parameter = @this.unit->create_entity(entity_kind::parameter, location, nullptr, parameters);

		if (!parameter || !@parameter->set_name(parameter_name)) {
			return nullptr;
		};

		@parameter->set_type(type);
		@parameter->set_index(usize(index));
		@parameter->set_state(entity_state::ready);

		if (!@function->add_parameter(Entity*(parameter)) || !@signature.push_back(type)) {
			return nullptr;
		};

		@index = index + 1;
	};

	@function->set_type(@this.types->function(result, $signature, parameter_arity::fixed));

	if (!function->type()) {
		return nullptr;
	};

	@function->set_state(entity_state::ready);

	return function;
};

fn numeric_literal_expression(const SemanticExpression& expression) -> bool {
	if (expression.kind() == semantic_kind::literal_integer || expression.kind() == semantic_kind::literal_real) {
		return expression.token().kind == token_kind::literal_number;
	};

	if (expression.kind() == semantic_kind::unary && (expression.operation() == token_kind::op_plus || expression.operation() == token_kind::op_minus)) {
		return numeric_literal_expression(*expression.item(0));
	};

	if (expression.kind() == semantic_kind::binary && expression.operation() != token_kind::op_assign && expression.operation() != token_kind::op_copy) {
		return numeric_literal_expression(*expression.item(0)) && numeric_literal_expression(*expression.item(1));
	};

	if (expression.kind() == semantic_kind::cast && expression.token().kind == token_kind::literal_number) {
		return numeric_literal_expression(*expression.item(0));
	};

	return false;
};

fn Analyzer::compatible(const Analyzer& this, const Type* source, const Type* target) -> bool {
	if (source == target) {
		return true;
	};

	if (!source || !target) {
		return false;
	};

	if (source->same_shape(*target) && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (target->kind() == type_kind::boolean && source->representation()->kind().is_scalar()) {
		return true;
	};

	if (source->kind() != type_kind::pointer || target->kind() != type_kind::pointer) {
		return false;
	};

	const Type* from = source->element();
	const Type* to = target->element();

	if (from->kind() == type_kind::null_type) {
		return true;
	};

	if (from->qualifier() == type_qualifier::immutable && to->qualifier() == type_qualifier::mutable) {
		return false;
	};

	if (to->kind() == type_kind::void_type && from->kind() != type_kind::function) {
		return true;
	};

	return from->same_shape(*to) || from->derived_from(*to);
};

fn Analyzer::builtin_rank(const Analyzer& this, const SemanticExpression& value, const Type& expected) -> i32 {
	if (expected.kind() == type_kind::reference) {
		if (value.category() != value_category::place && expected.element()->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		const Type* target = expected.element();

		if (target->qualifier() == type_qualifier::mutable && !value.mutable_access()) {
			return -1;
		};

		if (target->qualifier() == type_qualifier::immutable && target->kind().is_numeric() && value.category() == value_category::consumable && numeric_literal_expression(value)) {
			return 1;
		};

		if ((!value.type()->same_shape(*target) && !value.type()->derived_from(*target)) || value.type()->qualifier() == type_qualifier::immutable && target->qualifier() == type_qualifier::mutable) {
			return -1;
		};

		if (value.category() == value_category::consumable) {
			return 1;
		};

		if (!value.type()->same_shape(*target)) {
			return 1;
		};

		return 0;
	};

	if (expected.kind().is_numeric() && numeric_literal_expression(value)) {
		return 0;
	};

	i32 materialization = 0;

	if (value.category() == value_category::place) {
		if (value.type()->kind() == type_kind::named && value.type()->entity()->kind() == entity_kind::record) {
			return -1;
		};

		@materialization = 8;
	};

	if (value.type()->same_shape(expected)) {
		return $materialization;
	};

	if (this.compatible(value.type(), &expected)) {
		return materialization + 1;
	};

	if (value.kind() == semantic_kind::literal_integer && expected.kind().is_numeric()) {
		return 2;
	};

	return -1;
};

fn Analyzer::convert(Analyzer& this, rt::unique<SemanticExpression> value, const rt::optional_ref<const Type>& expected, Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!value.get() || !expected.has_value()) {
		return $value;
	};

	if (@this.argument_rank(*value.get(), expected.value()) < 0) {
		@this.error(&syntax, "expression cannot initialize the required type or reference\0");

		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference && expected.value().element()->qualifier() == type_qualifier::immutable && expected.value().element()->kind().is_numeric() && !value.get()->type()->same_shape(*expected.value().element()) && numeric_literal_expression(*value.get())) {
		var converted = @this.node(semantic_kind::cast, expected.value().element(), &syntax);

		if (!converted.get() || !@converted.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@value = $converted;
	};

	i32 builtin = this.builtin_rank(*value.get(), expected.value());
	const Type* target = expected.get();
	if (target->kind() == type_kind::reference) {
		@target = target->element();
	};

	Entity* constructor = nullptr;
	Entity* conversion = nullptr;
	if (builtin < 0 || expected.value().kind() != type_kind::reference && value.get()->category() == value_category::place && value.get()->type()->same_shape(*target)) {
		@constructor = @this.implicit_constructor(*value.get(), *target);

		if (!constructor) {
			@conversion = @this.conversion_function(*value.get(), *target, conversion_mode::implicit_allowed);
		};
	};

	if (builtin < 0 || constructor || conversion) {
		Entity* selected = constructor;
		usize source_index = 1;

		if (!selected) {
			@selected := conversion;
			@source_index = 0;
		};

		if (!selected || selected->definition() == function_definition::deleted) {
			@this.error(&syntax, "implicit conversion selects a deleted or ambiguous function\0");

			return rt::unique<SemanticExpression>();
		};

		@value = @this.convert(rt::unique<SemanticExpression>(@value.release()), rt::optional_ref<const Type>(*selected->parameters().data()[source_index]->type()), @syntax);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		var arguments = @this.node(semantic_kind::brace, this.types->find_primitive(rt::string_view("void\0")), &syntax);

		if (!arguments.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@arguments.get()->append(rt::unique<SemanticExpression>(@value.release()))) {
			return rt::unique<SemanticExpression>();
		};

		if (constructor) {
			var construction = @this.node(semantic_kind::construction, target, &syntax);

			if (!construction.get()) {
				return rt::unique<SemanticExpression>();
			};

			@construction.get()->bind(constructor, value_category::consumable);

			if (!@construction.get()->append($arguments)) {
				return rt::unique<SemanticExpression>();
			};

			@value = $construction;
		}
		else {
			var callable = @this.node(semantic_kind::name, conversion->type(), &syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind(conversion, value_category::place);
			var call = @this.node(semantic_kind::call, target, &syntax);

			if (!call.get()) {
				return rt::unique<SemanticExpression>();
			};

			@call.get()->bind(conversion, value_category::consumable);

			if (!@call.get()->append($callable)) {
				return rt::unique<SemanticExpression>();
			};

			if (!@call.get()->append($arguments)) {
				return rt::unique<SemanticExpression>();
			};

			@value = $call;
		};
	};

	if (value.get()->type() == expected.get() && expected.value().kind() != type_kind::reference) {
		return $value;
	};

	var result = @this.node(semantic_kind::cast, target, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($value)) {
		return rt::unique<SemanticExpression>();
	};

	if (expected.value().kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(target->qualifier() == type_qualifier::mutable);
	};

	return $result;
};

fn numeric_literal_expression(const Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::number) {
		return true;
	};

	if (syntax.kind() == syntax_kind::grouping) {
		return numeric_literal_expression(*syntax.operand());
	};

	if (syntax.kind() == syntax_kind::unary && (syntax.token().kind == token_kind::op_plus || syntax.token().kind == token_kind::op_minus)) {
		return numeric_literal_expression(*syntax.operand());
	};

	if (syntax.kind() == syntax_kind::binary && syntax.token().kind != token_kind::op_assign && syntax.token().kind != token_kind::op_copy) {
		return numeric_literal_expression(*syntax.left()) && numeric_literal_expression(*syntax.right());
	};

	return false;
};

fn Analyzer::unary(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.kind == token_kind::op_access && syntax.operand()->kind() == syntax_kind::call) {
		return @this.call(@scope, @*syntax.operand(), expected, true);
	};

	rt::optional_ref<const Type> operand_type;

	if ((operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus || operation.kind == token_kind::op_tilde) && expected.has_value() && expected.value().kind().is_numeric()) {
		@operand_type.bind(expected.value());
	};

	var operand = @this.expression(@scope, @*syntax.operand(), operand_type);

	if (!operand.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* type = operand.get()->type();

	if (operation.kind == token_kind::kw_sizeof) {
		return @this.convert(@this.size_query(@syntax, *type), expected, @syntax);
	};

	semantic_kind category = semantic_kind::unary;

	if (operation.kind == token_kind::op_access || operation.kind == token_kind::op_relocate || operation.kind == token_kind::op_ampersand) {
		if (operand.get()->category() != value_category::place) {
			@this.error(&syntax, "operator requires a place\0");

			return rt::unique<SemanticExpression>();
		};

		if (operation.kind == token_kind::op_access) {
			@category = semantic_kind::access;
		}
		else if (operation.kind == token_kind::op_ampersand) {
			@category = semantic_kind::address;
			@type = @this.types->pointer(type);
		}
		else {
			if (type->qualifier() == type_qualifier::immutable || !operand.get()->owned_binding() && !operand.get()->indirect_storage()) {
				@this.error(&syntax, "cannot relocate a const object or a borrowed reference\0");

				return rt::unique<SemanticExpression>();
			};

			@category = semantic_kind::relocation;
		};
	}
	else if (operation.kind == token_kind::op_star) {
		if (type->kind() != type_kind::pointer || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			@this.error(&syntax, "dereference requires a pointer to an object\0");

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		@category = semantic_kind::dereference;
	}
	else if (operation.kind == token_kind::op_bang) {
		if (!type->kind().is_scalar()) {
			@this.error(&syntax, "logical negation requires a scalar\0");

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive(rt::string_view("bool\0"));
	}
	else if (operation.kind == token_kind::op_tilde) {
		if (!type->kind().is_integer()) {
			@this.error(&syntax, "bitwise complement requires an integer\0");

			return rt::unique<SemanticExpression>();
		};
	}
	else if (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus) {
		if (!type->kind().is_numeric()) {
			@this.error(&syntax, "unary arithmetic requires a numeric value\0");

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		@this.error(&syntax, "unary operator is not implemented\0");

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind(category), type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	Entity* binding = operand.get()->entity();

	if (category == semantic_kind::access || category == semantic_kind::dereference) {
		@result.get()->bind(binding, value_category::place);
	}
	else if (category == semantic_kind::relocation) {
		@result.get()->bind(binding, value_category::consumable);
	};

	if (!@result.get()->append($operand)) {
		return rt::unique<SemanticExpression>();
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::binary(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();
	bool assignment = operation.kind == token_kind::op_assign || operation.kind == token_kind::op_copy;
	bool logical = operation.kind == token_kind::op_and || operation.kind == token_kind::op_or;
	bool comparison = operation.kind == token_kind::op_equal || operation.kind == token_kind::op_not_equal || operation.kind == token_kind::op_less || operation.kind == token_kind::op_greater || operation.kind == token_kind::op_less_equal || operation.kind == token_kind::op_greater_equal;
	rt::optional_ref<const Type> left_context;
	rt::unique<SemanticExpression> right;

	if (!assignment && !logical && numeric_literal_expression(*syntax.left())) {
		if (!numeric_literal_expression(*syntax.right())) {
			@right = @this.expression(@scope, @*syntax.right(), rt::optional_ref<const Type>());

			if (!right.get()) {
				return rt::unique<SemanticExpression>();
			};

			@left_context.bind(*right.get()->type());
		}
		else if (expected.has_value() && expected.value().kind().is_numeric()) {
			@left_context.bind(expected.value());

			if (expected.value().kind() == type_kind::boolean) {
				@left_context.bind(*this.types->find_primitive(rt::string_view("f64\0")));
			};
		};
	};

	var left = @this.expression(@scope, @*syntax.left(), left_context);

	if (!left.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* type = left.get()->type();
	var right_context = rt::optional_ref<const Type>(*type);

	if (type->kind() == type_kind::named) {
		@right_context.reset();
	};

	if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		@right_context.reset();
	};

	if (comparison && type->kind() == type_kind::pointer) {
		@right_context.reset();
	};

	if (logical && type->representation()->kind().is_scalar()) {
		@right_context.bind(*this.types->find_primitive(rt::string_view("bool\0")));
		@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), right_context, @*syntax.left());

		if (!left.get()) {
			return rt::unique<SemanticExpression>();
		};
	};

	if (assignment && (left.get()->category() != value_category::place || !left.get()->mutable_access())) {
		@this.error(&syntax, "assignment requires explicit mutable access to a place\0");

		return rt::unique<SemanticExpression>();
	};

	if (!right.get()) {
		@right = @this.expression(@scope, @*syntax.right(), right_context);
	};

	if (!right.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* other = right.get()->type();

	if (comparison && (type->kind() == type_kind::pointer || other->kind() == type_kind::pointer)) {
		if (type->kind() != type_kind::pointer || other->kind() != type_kind::pointer) {
			@this.error(&syntax, "pointer comparison requires compatible pointer types\0");

			return rt::unique<SemanticExpression>();
		};

		if (this.compatible(other, type)) {
			@right = @this.convert(rt::unique<SemanticExpression>(@right.release()), rt::optional_ref<const Type>(*type), @syntax);
		}
		else if (this.compatible(type, other)) {
			@left = @this.convert(rt::unique<SemanticExpression>(@left.release()), rt::optional_ref<const Type>(*other), @syntax);
			@type = other;
		}
		else {
			@this.error(&syntax, "pointer comparison requires compatible pointer types\0");

			return rt::unique<SemanticExpression>();
		};
	};

	if (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record || other->kind() == type_kind::named && other->entity()->kind() == entity_kind::record) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;

		if (!@arguments.push_back($left)) {
			return rt::unique<SemanticExpression>();
		};

		if (!@arguments.push_back($right)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.overloaded(@scope, @syntax, $arguments, expected);
	};

	if (assignment) {
		if (type->kind() == type_kind::array) {
			@this.error(&syntax, "aggregate assignment function selection is not implemented\0");

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::named && !type->same_shape(*other)) {
			@this.error(&syntax, "enumeration assignment requires the same enumeration type\0");

			return rt::unique<SemanticExpression>();
		};
	}
	else if (logical || comparison) {
		if (!type->representation()->kind().is_scalar() || !other->representation()->kind().is_scalar()) {
			@this.error(&syntax, "built-in comparison requires scalar operands\0");

			return rt::unique<SemanticExpression>();
		};

		@type = this.types->find_primitive(rt::string_view("bool\0"));
	}
	else if (type->kind() == type_kind::pointer && (operation.kind == token_kind::op_plus || operation.kind == token_kind::op_minus)) {
		if (!other->kind().is_integer() || type->element()->kind() == type_kind::void_type || type->element()->kind() == type_kind::null_type) {
			@this.error(&syntax, "pointer offset requires an integer and object element type\0");

			return rt::unique<SemanticExpression>();
		};
	}
	else {
		if (!type->kind().is_numeric() || !other->kind().is_numeric() || type->kind() != other->kind() || type->bits() != other->bits()) {
			@this.error(&syntax, "arithmetic requires matching numeric types\0");

			return rt::unique<SemanticExpression>();
		};

		if ((operation.kind == token_kind::op_remainder || operation.kind == token_kind::op_ampersand || operation.kind == token_kind::op_pipe || operation.kind == token_kind::op_caret || operation.kind == token_kind::op_shift_left || operation.kind == token_kind::op_shift_right) && !type->kind().is_integer()) {
			@this.error(&syntax, "bitwise arithmetic requires integers\0");

			return rt::unique<SemanticExpression>();
		};
	};

	var result = @this.node(semantic_kind::binary, type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($left)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($right)) {
		return rt::unique<SemanticExpression>();
	};

	if (assignment) {
		@result.get()->set_category(value_category::place);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::cast(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	Token operation = syntax.token();

	if (operation.is(rt::string_view("dynamic_cast\0"))) {
		@this.error(&syntax, "dynamic_cast is not implemented\0");

		return rt::unique<SemanticExpression>();
	};

	const Type* target = @this.type(@scope, @*syntax.cast_type());
	var value = @this.expression(@scope, @*syntax.cast_operand(), rt::optional_ref<const Type>());

	if (!target || !value.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* source = value.get()->type();
	const Type* destination = target;

	if (destination->kind() == type_kind::reference) {
		if (value.get()->category() != value_category::place) {
			@this.error(&syntax, "reference cast requires a place\0");

			return rt::unique<SemanticExpression>();
		};

		@destination = destination->element();
	};

	bool allowed = false;

	if (operation.is(rt::string_view("const_cast\0"))) {
		if (target->kind() == type_kind::pointer && source->kind() == type_kind::pointer) {
			const Type* a = target->element();
			const Type* b = source->element();
			@allowed = a->same_shape(*b);
		}
		else if (target->kind() == type_kind::reference) {
			@allowed = source->same_shape(*destination);
		};
	}
	else if (operation.is(rt::string_view("reinterpret_cast\0"))) {
		@allowed = source->kind() == type_kind::pointer && target->kind() == type_kind::pointer || source->kind() == type_kind::pointer && target->kind().is_integer() && target->bits() == this.pointer_bits || source->kind().is_integer() && source->bits() == this.pointer_bits && target->kind() == type_kind::pointer;
	}
	else {
		Entity* conversion = @this.conversion_function(*value.get(), *destination, conversion_mode::explicit_only);

		if (conversion) {
			if (conversion->definition() == function_definition::deleted || !this.accessible(*conversion, @scope)) {
				@this.error(&syntax, "selected conversion is deleted or inaccessible\0");

				return rt::unique<SemanticExpression>();
			};

			rt::buffer<rt::unique<SemanticExpression>> arguments;

			if (!@arguments.push_back(rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};

			var callable = @this.node(semantic_kind::name, conversion->type(), &syntax);

			if (!callable.get()) {
				return rt::unique<SemanticExpression>();
			};

			@callable.get()->bind(Entity*(conversion), value_category::place);

			return @this.invoke(@syntax, conversion, $callable, $arguments, expected);
		};

		const Type* from = source->representation();
		const Type* to = destination->representation();
		@allowed = from->kind().is_numeric() && to->kind().is_numeric() || source->kind() != type_kind::named && this.compatible(source, destination);

		if (target->kind() == type_kind::reference && (source->same_shape(*destination) || source->derived_from(*destination) || destination->derived_from(*source))) {
			@allowed = source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && destination->element()->derived_from(*source->element())) {
			@allowed = true;
		};

		if (source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && (source->element()->kind() == type_kind::void_type || destination->element()->kind() == type_kind::void_type)) {
			@allowed = source->element()->kind() != type_kind::function && destination->element()->kind() != type_kind::function;
		};
	};

	if (!operation.is(rt::string_view("const_cast\0")) && source->kind() == type_kind::pointer && destination->kind() == type_kind::pointer && source->element()->qualifier() == type_qualifier::immutable && destination->element()->qualifier() == type_qualifier::mutable) {
		@allowed = false;
	};

	if (!allowed) {
		@this.error(&syntax, "cast does not permit this conversion\0");

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::cast, destination, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($value)) {
		return rt::unique<SemanticExpression>();
	};

	if (target->kind() == type_kind::reference) {
		@result.get()->set_category(value_category::place);
		@result.get()->set_mutable_access(destination->qualifier() == type_qualifier::mutable);
	};

	return @this.convert($result, expected, @syntax);
};

fn Analyzer::component(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var object = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!object.get()) {
		return rt::unique<SemanticExpression>();
	};

	const Type* type = object.get()->type();

	if (syntax.kind() == syntax_kind::index) {
		if (type->kind() != type_kind::pointer && type->kind() != type_kind::array) {
			@this.error(&syntax, "indexing requires an array or pointer\0");

			return rt::unique<SemanticExpression>();
		};

		const Type* element = type->element();
		var index = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());

		if (!index.get() || !index.get()->type()->kind().is_integer()) {
			@this.error(&syntax, "index requires an integer\0");

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::index, element, &syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($object)) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($index)) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->set_category(value_category::place);

		return @this.convert($result, expected, @syntax);
	};

	if (syntax.token().kind == token_kind::op_arrow) {
		if (type->kind() != type_kind::pointer) {
			@this.error(&syntax, "arrow member access requires a pointer\0");

			return rt::unique<SemanticExpression>();
		};

		@type = type->element();
		var dereference = @this.node(semantic_kind::dereference, type, &syntax);

		if (!dereference.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@dereference.get()->append(rt::unique<SemanticExpression>(@object.release()))) {
			return rt::unique<SemanticExpression>();
		};

		@dereference.get()->set_category(value_category::place);
		@object = $dereference;
	};

	return @this.member_value(@scope, @syntax, $object, expected);
};

fn Analyzer::member_value(Analyzer& this, Scope& scope, Syntax& syntax, rt::unique<SemanticExpression> object, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	const Type* type = object.get()->type();

	if (type->kind() != type_kind::named || !type->entity()->members()) {
		@this.error(&syntax, "member access requires a class or enum object\0");

		return rt::unique<SemanticExpression>();
	};

	Entity* field = type->entity()->find_member(syntax.member_name()->token().text());

	if (!field || field->kind() != entity_kind::field || !@this.resolve(Entity*(field))) {
		@this.error(&syntax, "unknown data member\0");

		return rt::unique<SemanticExpression>();
	};

	if (!this.accessible(*field, @scope)) {
		@this.error(&syntax, "private or protected member is not accessible\0");

		return rt::unique<SemanticExpression>();
	};

	const Type* field_type = field->type();

	if (field_type->kind() == type_kind::reference) {
		@field_type = field_type->element();
	}
	else if (type->qualifier() == type_qualifier::immutable) {
		@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
	};

	var result = @this.node(semantic_kind::member, field_type, &syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($object)) {
		return rt::unique<SemanticExpression>();
	};

	@result.get()->bind(field, value_category::place);

	return @this.convert($result, expected, @syntax);
};

fn SemanticExpression::constant_truth(const SemanticExpression& this, bool& result) -> bool {
	if (this.type()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return false;
		};

		@result = value != 0.0;

		return true;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return false;
	};

	@result = value != 0;

	return true;
};

fn SemanticExpression::constant_integer(const SemanticExpression& this, u64& result) -> bool {
	if (this.kind() == semantic_kind::null_pointer) {
		@result = 0;

		return true;
	};

	if (!this.type()->representation()->kind().is_integer()) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_integer) {
		@result = this.type()->normalize_integer(this.integer());

		return true;
	};

	if (this.kind() == semantic_kind::name && this.entity() && this.entity()->kind() == entity_kind::enumerator) {
		@result = this.type()->normalize_integer(this.entity()->integer());

		return true;
	};

	if (this.kind() == semantic_kind::cast) {
		if (this.type()->kind() == type_kind::boolean) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.type()->representation()->kind().is_integer()) {
			return false;
		};

		if (this.item(0)->type()->kind() == type_kind::floating_point) {
			f64 value = 0.0;

			if (!this.item(0)->constant_real(@value)) {
				return false;
			};

			return this.type()->integer_from_real(value, @result);
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() == semantic_kind::unary) {
		if (this.operation() == token_kind::op_bang) {
			bool truth = false;

			if (!this.item(0)->constant_truth(@truth)) {
				return false;
			};

			@truth = !truth;
			@result = static_cast<u64>($truth);

			return true;
		};

		if (!this.item(0)->constant_integer(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = u64(0) - result;
		}
		else if (this.operation() == token_kind::op_tilde) {
			@result = ~result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};

		@result = this.type()->normalize_integer(result);

		return true;
	};

	if (this.kind() != semantic_kind::binary) {
		return false;
	};

	if (this.operation() == token_kind::op_and || this.operation() == token_kind::op_or) {
		bool first = false;

		if (!this.item(0)->constant_truth(@first)) {
			return false;
		};

		if (this.operation() == token_kind::op_and && !first || this.operation() == token_kind::op_or && first) {
			@result = static_cast<u64>($first);

			return true;
		};

		bool second = false;

		if (!this.item(1)->constant_truth(@second)) {
			return false;
		};

		@result = static_cast<u64>($second);

		return true;
	};

	if (this.item(0)->type()->kind() == type_kind::floating_point || this.item(1)->type()->kind() == type_kind::floating_point) {
		return this.real_comparison(@result);
	};

	u64 first = 0;
	u64 second = 0;

	if (!this.item(0)->constant_integer(@first) || !this.item(1)->constant_integer(@second)) {
		return false;
	};

	bool signed_ = this.item(0)->type()->representation()->kind() == type_kind::signed_integer;
	i64 signed_first = 0;
	i64 signed_second = 0;

	if (signed_) {
		@signed_first = this.item(0)->type()->signed_value(first);
		@signed_second = this.item(1)->type()->signed_value(second);
	};

	bool comparison = false;

	switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
		case token_kind::op_remainder: {
			if (!second) {
				return false;
			};

			if (signed_) {
				u32 bits = this.item(0)->type()->representation()->bits();

				if (bits && first == (u64(1) << static_cast<u64>(bits - 1)) && signed_second == -1) {
					return false;
				};

				i64 answer = 0;

				if (this.operation() == token_kind::op_slash) {
					@answer = signed_first / signed_second;
				}
				else {
					@answer = signed_first % signed_second;
				};

				@result = static_cast<u64>($answer);
			}
			else if (this.operation() == token_kind::op_slash) {
				@result = first / second;
			}
			else {
				@result = first % second;
			};

			break;
		};
		case token_kind::op_ampersand:
			@result = first & second;
			break;
		case token_kind::op_pipe:
			@result = first | second;
			break;
		case token_kind::op_caret:
			@result = first ^ second;
			break;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			const Type* representation = this.item(0)->type()->representation();
			u64 width = static_cast<u64>(representation->bits());

			if (second >= width) {
				return false;
			};

			if (this.operation() == token_kind::op_shift_left) {
				@result = first << second;
			}
			else if (signed_) {
				i64 shifted = signed_first >> static_cast<i64>(second);
				@result = static_cast<u64>($shifted);
			}
			else {
				@result = first >> second;
			};

			break;
		case token_kind::op_equal:
			@comparison = first == second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_not_equal:
			@comparison = first != second;
			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less:
			@comparison = first < second;

			if (signed_) {
				@comparison = signed_first < signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater:
			@comparison = first > second;

			if (signed_) {
				@comparison = signed_first > signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_less_equal:
			@comparison = first <= second;

			if (signed_) {
				@comparison = signed_first <= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		case token_kind::op_greater_equal:
			@comparison = first >= second;

			if (signed_) {
				@comparison = signed_first >= signed_second;
			};

			@result = static_cast<u64>($comparison);

			return true;
		default:
			return false;
	};

	@result = this.type()->normalize_integer(result);

	return true;
};

fn SemanticExpression::copy_constant(const SemanticExpression& this) -> rt::unique<SemanticExpression> {
	if (this.type()->representation()->kind() == type_kind::floating_point) {
		f64 value = 0.0;

		if (!this.constant_real(@value)) {
			return rt::unique<SemanticExpression>();
		};

		var result = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::literal_real, this.type(), this.token()));

		if (result.get()) {
			@result.get()->set_real(value);
		};

		return $result;
	};

	u64 value = 0;

	if (!this.constant_integer(@value)) {
		return rt::unique<SemanticExpression>();
	};

	var result = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::literal_integer, this.type(), this.token()));

	if (result.get()) {
		@result.get()->set_integer(this.type()->normalize_integer(value));
	};

	return $result;
};

fn Type::integer_from_real(const Type& this, f64 value, u64& result) -> bool {
	const Type* type = this.representation();

	if (type->kind() != type_kind::signed_integer && type->kind() != type_kind::unsigned_integer) {
		return false;
	};

	u32 bits = type->bits();

	if (!bits || bits > 64) {
		return false;
	};

	f64 limit = 1.0;
	u32 index = 0;
	u32 exponent = bits;

	if (type->kind() == type_kind::signed_integer) {
		@exponent = exponent - 1;
	};

	while (index < exponent) {
		@limit = limit * 2.0;
		@index = index + 1;
	};

	if (type->kind() == type_kind::signed_integer) {
		bool valid = value > -limit - 1.0 && value < limit;

		if (bits == 64) {
			@valid = value >= -limit && value < limit;
		};

		if (!valid) {
			return false;
		};

		i64 integer = static_cast<i64>(value);
		@result = type->normalize_integer(static_cast<u64>($integer));

		return true;
	};

	if (!(value > -1.0 && value < limit)) {
		return false;
	};

	if (value < 0.0) {
		@result = 0;

		return true;
	};

	@result = type->normalize_integer(static_cast<u64>(value));

	return true;
};

fn SemanticExpression::constant_real(const SemanticExpression& this, f64& result) -> bool {
	const Type* type = this.type()->representation();

	if (type->kind().is_integer()) {
		u64 integer = 0;

		if (!this.constant_integer(@integer)) {
			return false;
		};

		if (type->kind() == type_kind::signed_integer) {
			@result = static_cast<f64>(type->signed_value(integer));

			return true;
		};

		@result = static_cast<f64>(integer);

		return true;
	};

	if (type->kind() != type_kind::floating_point) {
		return false;
	};

	if (this.kind() == semantic_kind::literal_real) {
		@result = this.real();
	}
	else if (this.kind() == semantic_kind::cast) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::unary) {
		if (!this.item(0)->constant_real(@result)) {
			return false;
		};

		if (this.operation() == token_kind::op_minus) {
			@result = -result;
		}
		else if (this.operation() != token_kind::op_plus) {
			return false;
		};
	}
	else if (this.kind() == semantic_kind::binary) {
		f64 first = 0.0;
		f64 second = 0.0;

		if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
			return false;
		};

		switch (this.operation()) {
		case token_kind::op_plus:
			@result = first + second;
			break;
		case token_kind::op_minus:
			@result = first - second;
			break;
		case token_kind::op_star:
			@result = first * second;
			break;
		case token_kind::op_slash:
			if (!second) {
				return false;
			};

			@result = first / second;
			break;
		default:
			return false;
		};
	}
	else {
		return false;
	};

	if (type->bits() == 32) {
		f64 unrounded := result;
		f32 rounded = static_cast<f32>($unrounded);
		@result = static_cast<f64>($rounded);
	};

	return true;
};

fn SemanticExpression::real_comparison(const SemanticExpression& this, u64& result) -> bool {
	f64 first = 0.0;
	f64 second = 0.0;

	if (!this.item(0)->constant_real(@first) || !this.item(1)->constant_real(@second)) {
		return false;
	};

	bool comparison = false;

	switch (this.operation()) {
	case token_kind::op_equal:
		@comparison = first == second;
		break;
	case token_kind::op_not_equal:
		@comparison = first != second;
		break;
	case token_kind::op_less:
		@comparison = first < second;
		break;
	case token_kind::op_less_equal:
		@comparison = first <= second;
		break;
	case token_kind::op_greater:
		@comparison = first > second;
		break;
	case token_kind::op_greater_equal:
		@comparison = first >= second;
		break;
	default:
		return false;
	};

	@result = static_cast<u64>($comparison);

	return true;
};

enum constant_flow : [u08] {
	next;
	returned;
	break_loop;
	continue_loop;
	failed;
};

struct ConstantCell {
	rt::unique<SemanticExpression> value;
};

struct ConstantBinding {
	Entity* entity;
	ConstantCell* cell;
};

struct ConstantCheckpoint {
	usize bindings;
	usize cells;
};

enum constant_result_kind : [u08] {
	value;
	reference;
};

enum constant_reference_kind : [u08] {
	stored;
	temporary;
	unsupported;
};

struct ConstantFrame {
	fn set_result_type(ConstantFrame& this, const Type& type);
	fn leave(ConstantFrame& this, const ConstantCheckpoint& checkpoint);
	fn return_reference(ConstantFrame& this, ConstantCell* cell);
	fn bind(ConstantFrame& this, Entity* entity, ConstantCell* cell) -> bool;
	fn store(ConstantFrame& this, Entity* entity, rt::unique<SemanticExpression> value) -> bool;

	fn returns_reference(const ConstantFrame& this) -> bool;
	fn checkpoint(const ConstantFrame& this) -> ConstantCheckpoint;
	fn returned_reference(const ConstantFrame& this) -> ConstantCell*;
	fn find(const ConstantFrame& this, Entity* entity) -> ConstantCell*;
	fn owns(const ConstantFrame& this, const ConstantCell& cell) -> bool;

private:
	rt::buffer<rt::unique<ConstantCell>> cells;
	rt::buffer<ConstantBinding> bindings;
	rt::optional_ref<ConstantCell> reference_result;
	constant_result_kind result_kind;
};

struct ConstantRegion {
	fn ConstantRegion(ConstantRegion& this, ConstantFrame& frame);
	fn ~ConstantRegion(ConstantRegion& this);

private:
	ConstantFrame* frame;
	ConstantCheckpoint checkpoint;
};

// Each invocation owns its cells. Reference parameters borrow caller cells; unrelated
// mutable global storage is never admitted into an evaluation frame.
struct ConstantEvaluator {
	fn integer(ConstantEvaluator& this, Analyzer& analyzer, const SemanticExpression& expression, u64& result) -> bool;

private:
	fn tick(ConstantEvaluator& this) -> bool;
	fn bind_reference(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& target, ConstantFrame& origin, Entity& binding, const SemanticExpression& source) -> bool;
	fn place(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> ConstantCell*;
	fn global_cell(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, Entity& entity) -> ConstantCell*;
	fn value(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn call(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, ConstantCell*& reference) -> rt::unique<SemanticExpression>;
	fn execute(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn loop(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn selection(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn execute_children(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow;
	fn initialize_sequence(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> bool;

	fn reference_kind(const ConstantEvaluator& this, const SemanticExpression& source) -> constant_reference_kind;
	fn literal(const ConstantEvaluator& this, const SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression>;
	fn copy(const ConstantEvaluator& this, const SemanticExpression& source) -> rt::unique<SemanticExpression>;
	fn contains_label(const ConstantEvaluator& this, const SemanticExpression& source) -> bool;

	usize steps;
	usize depth;
	ConstantFrame constants;
};

fn ConstantEvaluator::tick(ConstantEvaluator& this) -> bool {
	@this.steps = this.steps + 1;

	return this.steps <= 100000;
};

fn ConstantEvaluator::reference_kind(const ConstantEvaluator& this, const SemanticExpression& source) -> constant_reference_kind {
	if (source.category() == value_category::consumable) {
		return constant_reference_kind::temporary;
	};

	switch (source.kind()) {
		case semantic_kind::name:
		case semantic_kind::call:
			return constant_reference_kind::stored;
		case semantic_kind::access:
		case semantic_kind::cast:
			return this.reference_kind(*source.item(0));
		case semantic_kind::sequence:
			return this.reference_kind(*source.item(2));
		default:
			return constant_reference_kind::unsupported;
	};
};

fn ConstantEvaluator::bind_reference(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& target, ConstantFrame& origin, Entity& binding, const SemanticExpression& source) -> bool {
	constant_reference_kind kind = this.reference_kind(source);

	if (kind == constant_reference_kind::stored) {
		ConstantCell* cell = @this.place(@analyzer, @origin, source);

		if (!cell || !cell->value.get()) {
			return false;
		};

		return @target.bind(&binding, cell);
	};

	if (kind != constant_reference_kind::temporary || binding.type()->element()->qualifier() != type_qualifier::immutable) {
		return false;
	};

	var temporary = @this.value(@analyzer, @origin, source);

	if (!temporary.get()) {
		return false;
	};

	return @target.store(&binding, $temporary);
};

fn ConstantEvaluator::execute_children(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow {
	usize index = 0;
	while (index < source.size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(index), @returned);

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantEvaluator::initialize_sequence(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> bool {
	rt::unique<SemanticExpression> returned;

	if (@this.execute(@analyzer, @frame, *source.item(0), @returned) != constant_flow::next) {
		return false;
	};

	return @this.execute(@analyzer, @frame, *source.item(1), @returned) == constant_flow::next;
};

fn ConstantEvaluator::literal(const ConstantEvaluator& this, const SemanticExpression& source, u64 value) -> rt::unique<SemanticExpression> {
	var result = rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::literal_integer, source.type(), source.token()));

	if (result.get()) {
		@result.get()->set_integer(source.type()->normalize_integer(value));
	};

	return $result;
};

fn ConstantEvaluator::copy(const ConstantEvaluator& this, const SemanticExpression& source) -> rt::unique<SemanticExpression> {
	return source.copy_constant();
};

fn ConstantEvaluator::integer(ConstantEvaluator& this, Analyzer& analyzer, const SemanticExpression& expression, u64& result) -> bool {
	@this.steps = 0;
	@this.depth = 0;
	@this.constants = ConstantFrame();
	ConstantFrame frame;
	var value = @this.value(@analyzer, @frame, expression);

	return value.get() && value.get()->constant_integer(@result);
};

fn ConstantEvaluator::global_cell(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, Entity& entity) -> ConstantCell* {
	if (entity.kind() != entity_kind::global || entity.type()->qualifier() != type_qualifier::immutable) {
		return nullptr;
	};

	ConstantCell* cell = this.constants.find(&entity);

	if (cell) {
		return cell;
	};

	if (this.depth >= 128 || !@analyzer.global_initializer(@entity) || !entity.body()) {
		return nullptr;
	};

	@this.depth = this.depth + 1;
	var value = @this.value(@analyzer, @frame, *entity.body());
	@this.depth = this.depth - 1;

	if (!value.get()) {
		return nullptr;
	};

	if (!@this.constants.store(&entity, $value)) {
		return nullptr;
	};

	return this.constants.find(&entity);
};

fn ConstantEvaluator::place(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> ConstantCell* {
	if (!@this.tick()) {
		return nullptr;
	};

	if (source.kind() == semantic_kind::call && source.category() == value_category::place) {
		ConstantCell* reference = nullptr;
		var value = @this.call(@analyzer, @frame, source, @reference);

		if (!value.get()) {
			return nullptr;
		};

		return $reference;
	};

	if (source.kind() == semantic_kind::name) {
		ConstantCell* cell = frame.find(source.entity());
		Entity* entity = source.entity();

		if (!cell && entity) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);
		};

		if (!cell || !cell->value.get()) {
			return nullptr;
		};

		return $cell;
	};

	if (source.kind() == semantic_kind::sequence && source.category() == value_category::place) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return nullptr;
		};

		return @this.place(@analyzer, @frame, *source.item(2));
	};

	if (source.kind() == semantic_kind::access || source.kind() == semantic_kind::cast && source.category() == value_category::place) {
		return @this.place(@analyzer, @frame, *source.item(0));
	};

	return nullptr;
};

fn ConstantEvaluator::value(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source) -> rt::unique<SemanticExpression> {
	if (!@this.tick()) {
		return rt::unique<SemanticExpression>();
	};

	semantic_kind kind = source.kind();

	if (kind == semantic_kind::noop) {
		return rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::noop, source.type(), source.token()));
	};

	if (kind == semantic_kind::sequence) {
		var region = ConstantRegion(@frame);

		if (!@this.initialize_sequence(@analyzer, @frame, source)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.value(@analyzer, @frame, *source.item(2));
	};

	if (kind == semantic_kind::name) {
		ConstantCell* cell = frame.find(source.entity());

		if (cell && cell->value.get()) {
			return this.copy(*cell->value.get());
		};

		Entity* entity = source.entity();

		if (entity && entity->kind() == entity_kind::global && entity->type()->qualifier() == type_qualifier::immutable) {
			@cell = @this.global_cell(@analyzer, @frame, @*entity);

			if (!cell || !cell->value.get()) {
				return rt::unique<SemanticExpression>();
			};

			return this.copy(*cell->value.get());
		};

		return this.copy(source);
	};

	if (kind == semantic_kind::access) {
		return @this.value(@analyzer, @frame, *source.item(0));
	};

	if (kind == semantic_kind::relocation) {
		ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!cell) {
			return rt::unique<SemanticExpression>();
		};

		var value = this.copy(*cell->value.get());
		@cell->value.reset(nullptr);

		return $value;
	};

	if (kind == semantic_kind::call) {
		ConstantCell* reference = nullptr;

		return @this.call(@analyzer, @frame, source, @reference);
	};

	if (kind == semantic_kind::construction && source.type()->representation()->kind().is_numeric() && !source.entity()) {
		SemanticExpression* arguments = source.item(0);

		if (!arguments->size()) {
			if (source.type()->representation()->kind() == type_kind::floating_point) {
				return rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::literal_real, source.type(), source.token()));
			};

			return this.literal(source, 0);
		};

		if (arguments->size() == 1) {
			return @this.value(@analyzer, @frame, *arguments->item(0));
		};

		return rt::unique<SemanticExpression>();
	};

	if (kind == semantic_kind::binary && (source.operation() == token_kind::op_assign || source.operation() == token_kind::op_copy)) {
		// Runtime assignment evaluates its source before designating destination storage.
		var assigned = @this.value(@analyzer, @frame, *source.item(1));
		ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

		if (!assigned.get() || !cell || this.constants.owns(*cell)) {
			return rt::unique<SemanticExpression>();
		};

		@cell->value = this.copy(*assigned.get());

		if (!cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		return $assigned;
	};

	if (kind == semantic_kind::binary || kind == semantic_kind::unary || kind == semantic_kind::cast) {
		var first = @this.value(@analyzer, @frame, *source.item(0));

		if (!first.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (kind == semantic_kind::binary && (source.operation() == token_kind::op_and || source.operation() == token_kind::op_or)) {
			bool truth = false;

			if (!first.get()->constant_truth(@truth)) {
				return rt::unique<SemanticExpression>();
			};

			if (source.operation() == token_kind::op_and && !truth || source.operation() == token_kind::op_or && truth) {
				return this.literal(source, static_cast<u64>($truth));
			};
		};

		var operation = rt::unique<SemanticExpression>(new SemanticExpression($kind, source.type(), source.token()));

		if (!operation.get() || !@operation.get()->append(rt::unique<SemanticExpression>(@first.release()))) {
			return rt::unique<SemanticExpression>();
		};

		if (source.size() == 2) {
			var second = @this.value(@analyzer, @frame, *source.item(1));

			if (!second.get() || !@operation.get()->append(rt::unique<SemanticExpression>(@second.release()))) {
				return rt::unique<SemanticExpression>();
			};
		};

		return this.copy(*operation.get());
	};

	return this.copy(source);
};

fn ConstantEvaluator::call(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, ConstantCell*& reference) -> rt::unique<SemanticExpression> {
	@reference = nullptr;
	Entity* function = source.entity();

	if (!function || function->kind() != entity_kind::function || this.depth >= 128) {
		return rt::unique<SemanticExpression>();
	};

	@function = function->canonical();

	if (!@analyzer.function_body(function)) {
		return rt::unique<SemanticExpression>();
	};

	if (!function->body() || function->definition() != function_definition::user_defined || function->role() != function_role::ordinary || source.item(1)->size() != function->parameters().size()) {
		return rt::unique<SemanticExpression>();
	};

	ConstantFrame invocation;
	@invocation.set_result_type(*function->type()->signature().result());
	usize index = 0;
	while (index < function->parameters().size()) {
		Entity* parameter = function->parameters().data()[index];
		SemanticExpression* argument = source.item(1)->item(index);

		if (parameter->type()->kind() == type_kind::reference) {
			if (!@this.bind_reference(@analyzer, @invocation, @frame, @*parameter, *argument)) {
				return rt::unique<SemanticExpression>();
			};
		}
		else {
			var value = @this.value(@analyzer, @frame, *argument);

			if (!value.get() || !@invocation.store(parameter, rt::unique<SemanticExpression>(@value.release()))) {
				return rt::unique<SemanticExpression>();
			};
		};

		@index = index + 1;
	};

	@this.depth = this.depth + 1;
	rt::unique<SemanticExpression> returned;
	constant_flow flow = @this.execute(@analyzer, @invocation, *function->body(), @returned);
	@this.depth = this.depth - 1;

	if (flow == constant_flow::next && source.type()->kind() == type_kind::void_type) {
		return rt::unique<SemanticExpression>(new SemanticExpression(semantic_kind::noop, source.type(), source.token()));
	};

	if (flow != constant_flow::returned) {
		return rt::unique<SemanticExpression>();
	};

	if (function->type()->signature().result()->kind() == type_kind::reference) {
		ConstantCell* cell = invocation.returned_reference();
		ConstantCheckpoint boundary;
		@invocation.leave(boundary);

		if (!cell || !cell->value.get()) {
			return rt::unique<SemanticExpression>();
		};

		@reference = cell;

		return this.copy(*cell->value.get());
	};

	return $returned;
};

fn ConstantEvaluator::execute(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow {
	if (!@this.tick()) {
		return constant_flow::failed;
	};

	switch (source.kind()) {
		case semantic_kind::noop:
		case semantic_kind::case_label:
			return constant_flow::next;
		case semantic_kind::brace: {
			var region = ConstantRegion(@frame);

			return @this.execute_children(@analyzer, @frame, source, @returned);
		};
		case semantic_kind::statements:
			return @this.execute_children(@analyzer, @frame, source, @returned);
		case semantic_kind::variable: {
			Entity* entity = source.entity();

			if (entity->type()->kind() == type_kind::reference) {
				if (!@this.bind_reference(@analyzer, @frame, @frame, @*entity, *source.item(0))) {
					return constant_flow::failed;
				};
			}
			else {
				rt::unique<SemanticExpression> value;

				if (source.item(0)->kind() == semantic_kind::noop && entity->type()->representation()->kind().is_numeric()) {
					semantic_kind kind = semantic_kind::literal_integer;

					if (entity->type()->representation()->kind() == type_kind::floating_point) {
						@kind = semantic_kind::literal_real;
					};

					@value = rt::unique<SemanticExpression>(new SemanticExpression($kind, entity->type(), source.token()));
				}
				else {
					@value = @this.value(@analyzer, @frame, *source.item(0));
				};

				if (!value.get() || !@frame.store(entity, rt::unique<SemanticExpression>(@value.release()))) {
					return constant_flow::failed;
				};
			};

			return constant_flow::next;
		};
		case semantic_kind::return_value:
			if (frame.returns_reference()) {
				ConstantCell* cell = @this.place(@analyzer, @frame, *source.item(0));

				if (!cell) {
					return constant_flow::failed;
				};

				@frame.return_reference(cell);
				@returned = this.copy(*cell->value.get());
			}
			else {
				@returned = @this.value(@analyzer, @frame, *source.item(0));
			};

			if (!returned.get()) {
				return constant_flow::failed;
			};

			return constant_flow::returned;
		case semantic_kind::break_loop:
			return constant_flow::break_loop;
		case semantic_kind::continue_loop:
			return constant_flow::continue_loop;
		case semantic_kind::conditional: {
			var condition = @this.value(@analyzer, @frame, *source.item(0));
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			usize selected = 2;

			if (truth) {
				@selected = 1;
			};

			return @this.execute(@analyzer, @frame, *source.item(selected), @returned);
		};
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop(@analyzer, @frame, source, @returned);
		case semantic_kind::switch_expression:
			return @this.selection(@analyzer, @frame, source, @returned);
		default: {
			var value = @this.value(@analyzer, @frame, source);

			if (!value.get()) {
				return constant_flow::failed;
			};

			return constant_flow::next;
		};
	};
};

fn ConstantEvaluator::loop(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	usize condition_index = 0;
	usize body_index = 1;

	if (source.kind() == semantic_kind::for_loop) {
		constant_flow initialization = @this.execute(@analyzer, @frame, *source.item(0), @returned);

		if (initialization != constant_flow::next) {
			return $initialization;
		};

		@condition_index = 1;
		@body_index = 3;
	};

	while (true) {
		if (!@this.tick()) {
			return constant_flow::failed;
		};

		SemanticExpression* expression = source.item(condition_index);

		if (expression->kind() != semantic_kind::noop) {
			var condition = @this.value(@analyzer, @frame, *expression);
			bool truth = false;

			if (!condition.get() || !condition.get()->constant_truth(@truth)) {
				return constant_flow::failed;
			};

			if (!truth) {
				return constant_flow::next;
			};
		};

		constant_flow flow = @this.execute(@analyzer, @frame, *source.item(body_index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow == constant_flow::returned || flow == constant_flow::failed) {
			return $flow;
		};

		if (source.kind() == semantic_kind::for_loop) {
			constant_flow step = @this.execute(@analyzer, @frame, *source.item(2), @returned);

			if (step != constant_flow::next && step != constant_flow::continue_loop) {
				if (step == constant_flow::break_loop) {
					return constant_flow::next;
				};

				return $step;
			};
		};
	};
};

fn ConstantEvaluator::contains_label(const ConstantEvaluator& this, const SemanticExpression& source) -> bool {
	if (source.kind() == semantic_kind::case_label) {
		return true;
	};

	if (source.kind() == semantic_kind::switch_expression) {
		return false;
	};

	usize index = 0;
	while (index < source.size()) {
		if (this.contains_label(*source.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantEvaluator::selection(ConstantEvaluator& this, Analyzer& analyzer, ConstantFrame& frame, const SemanticExpression& source, rt::unique<SemanticExpression>& returned) -> constant_flow {
	var region = ConstantRegion(@frame);
	var condition = @this.value(@analyzer, @frame, *source.item(0));
	u64 key = 0;

	if (!condition.get() || !condition.get()->constant_integer(@key) || source.item(1)->kind() != semantic_kind::brace) {
		return constant_flow::failed;
	};

	SemanticExpression* body = source.item(1);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		SemanticExpression* item = body->item(index);

		if (item->kind() != semantic_kind::case_label && this.contains_label(*item)) {
			// Nested labels require a resumable statement path, not linear fallthrough.
			return constant_flow::failed;
		};

		if (item->kind() == semantic_kind::case_label) {
			if (item->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (item->integer() == key) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	@index := selected;

	while (index < body->size()) {
		constant_flow flow = @this.execute(@analyzer, @frame, *body->item(index), @returned);

		if (flow == constant_flow::break_loop) {
			return constant_flow::next;
		};

		if (flow != constant_flow::next) {
			return $flow;
		};

		@index = index + 1;
	};

	return constant_flow::next;
};

fn ConstantFrame::set_result_type(ConstantFrame& this, const Type& type) {
	@this.result_kind = constant_result_kind::value;

	if (type.kind() == type_kind::reference) {
		@this.result_kind = constant_result_kind::reference;
	};
};

fn ConstantFrame::returns_reference(const ConstantFrame& this) -> bool {
	return this.result_kind == constant_result_kind::reference;
};

fn ConstantFrame::checkpoint(const ConstantFrame& this) -> ConstantCheckpoint {
	ConstantCheckpoint checkpoint;
	@checkpoint.bindings = this.bindings.size();
	@checkpoint.cells = this.cells.size();

	return $checkpoint;
};

fn ConstantFrame::leave(ConstantFrame& this, const ConstantCheckpoint& checkpoint) {
	while (this.bindings.size() > checkpoint.bindings) {
		@this.bindings.pop_back();
	};

	usize index = checkpoint.cells;
	while (index < this.cells.size()) {
		// Keep stable tombstones for outstanding borrowed cells, but end the value's lifetime.
		@this.cells.data()[index].get()->value.reset(nullptr);
		@index = index + 1;
	};
};

fn ConstantFrame::return_reference(ConstantFrame& this, ConstantCell* cell) {
	@this.reference_result.reset();

	if (cell) {
		@this.reference_result.bind(@*cell);
	};
};

fn ConstantFrame::returned_reference(const ConstantFrame& this) -> ConstantCell* {
	return this.reference_result.get();
};

fn ConstantFrame::find(const ConstantFrame& this, Entity* entity) -> ConstantCell* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return this.bindings.data()[index].cell;
		};
	};

	return nullptr;
};

fn ConstantFrame::owns(const ConstantFrame& this, const ConstantCell& cell) -> bool {
	usize index = 0;
	while (index < this.cells.size()) {
		if (this.cells.data()[index].get() == &cell) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ConstantFrame::bind(ConstantFrame& this, Entity* entity, ConstantCell* cell) -> bool {
	ConstantBinding binding;
	@binding.entity = $entity;
	@binding.cell = $cell;

	return @this.bindings.push_back($binding);
};

fn ConstantFrame::store(ConstantFrame& this, Entity* entity, rt::unique<SemanticExpression> value) -> bool {
	var cell = rt::unique<ConstantCell>::make();

	if (!cell.get()) {
		return false;
	};

	@cell.get()->value = $value;
	ConstantCell* borrowed = cell.get();

	if (!@this.cells.push_back($cell)) {
		return false;
	};

	return @this.bind($entity, $borrowed);
};

fn ConstantRegion::ConstantRegion(ConstantRegion& this, ConstantFrame& frame) {
	@this.frame = &frame;
	@this.checkpoint = frame.checkpoint();
};

fn ConstantRegion::~ConstantRegion(ConstantRegion& this) {
	@this.frame->leave(this.checkpoint);
};

fn Type::representation(const Type& this) -> const Type* {
	const Type* type = &this;

	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration && type->entity()->underlying()) {
		@type = type->entity()->underlying();
	};

	return $type;
};

fn Type::has_layout(const Type& this) -> bool {
	switch (this.kind()) {
		case type_kind::void_type:
		case type_kind::null_type:
		case type_kind::function:
			return false;
		case type_kind::array:
			return this.element()->has_layout();
		case type_kind::named: {
			Entity* entity = this.entity();

			if (entity->kind() == entity_kind::enumeration) {
				return entity->underlying() && entity->underlying()->has_layout();
			};

			return entity->kind() == entity_kind::record && entity->declaration() && entity->declaration()->record_members()->kind() != syntax_kind::noop;
		};
	};

	return true;
};

fn Type::normalize_integer(const Type& this, u64 value) -> u64 {
	const Type* type = this.representation();

	if (!type->kind().is_integer()) {
		return $value;
	};

	u32 bits = type->bits();

	if (bits && bits < 64) {
		return value & ((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return $value;
};

fn Type::signed_value(const Type& this, u64 value) -> i64 {
	const Type* type = this.representation();
	u32 bits = type->bits();
	@value = type->normalize_integer(value);

	if (bits && bits < 64 && (value & (u64(1) << static_cast<u64>(bits - 1)))) {
		@value = value | ~((u64(1) << static_cast<u64>(bits)) - 1);
	};

	return static_cast<i64>($value);
};

fn Type::derived_from(const Type& this, const Type& base) -> bool {
	if (this.kind() != type_kind::named || base.kind() != type_kind::named || this.entity()->kind() != entity_kind::record || base.entity()->kind() != entity_kind::record) {
		return false;
	};

	Entity* current = this.entity();

	while (current->bases().size() == 1) {
		@current = current->bases().data()[0]->entity();

		if (current == base.entity()) {
			return true;
		};
	};

	return false;
};

enum template_argument_kind : [u08] {
	type;
	value;
};

struct TemplateArgument {
	template_argument_kind kind;
	const Type* type;
	rt::optional_ref<const TypeUse> type_use;
	u64 value;

	fn same(const TemplateArgument& this, const TemplateArgument& other) -> bool;
};

enum template_input_kind : [u08] {
	explicit_arguments;
	deduced_arguments;
};

union TemplateInputStorage {
	Syntax* explicit_arguments;
	const rt::buffer<TemplateArgument>* deduced_arguments;
};

struct TemplateInput {
	fn TemplateInput(TemplateInput& this, Syntax& arguments);
	fn TemplateInput(TemplateInput& this, const rt::buffer<TemplateArgument>& arguments);

	template_input_kind kind;
	TemplateInputStorage storage;
};

fn TemplateInput::TemplateInput(TemplateInput& this, Syntax& arguments) {
	@this.kind = template_input_kind::explicit_arguments;
	@this.storage.explicit_arguments = &arguments;
};

fn TemplateInput::TemplateInput(TemplateInput& this, const rt::buffer<TemplateArgument>& arguments) {
	@this.kind = template_input_kind::deduced_arguments;
	@this.storage.deduced_arguments = &arguments;
};

struct TemplateInstance {
	Entity* pattern;
	Entity* entity;
	rt::buffer<TemplateArgument> arguments;
};

struct TemplateMemberDefinition {
	Entity* owner;
	Syntax* source;
	access_kind access;
};

struct TemplateEngine {
	fn clear(TemplateEngine& this);
	fn collect(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& source) -> bool;
	fn apply(TemplateEngine& this, Analyzer& analyzer, Scope& lookup_scope, Scope& argument_scope, Syntax& source) -> Entity*;
	fn deduce(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const rt::buffer<rt::unique<SemanticExpression>>& values) -> Entity*;
	fn call_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity*;
	fn specialize_call(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, rt::optional_ref<Syntax> supplied, const rt::buffer<rt::unique<SemanticExpression>>& values) -> Entity*;

	fn qualifier_dependent(const TemplateEngine& this, Syntax& declaration) -> bool;
	fn qualifier(const TemplateEngine& this, Scope& initial, Syntax& syntax) -> const Type*;
	fn instance(const TemplateEngine& this, Entity& entity) -> TemplateInstance*;

private:
	fn auto_declaration(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Scope& bindings, Syntax& declaration, access_kind access) -> bool;
	fn same_auto_signature(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second) -> bool;
	fn same_type_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool;
	fn pattern_owner(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity*;
	fn argument(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& input, Syntax& parameter, TemplateArgument& result) -> bool;
	fn bind(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& parameter, const TemplateArgument& argument) -> bool;
	fn instantiate(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const TemplateInput& input) -> Entity*;
	fn member_definitions(TemplateEngine& this, Analyzer& analyzer, TemplateInstance& instance) -> bool;
	fn match(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& syntax, const TypeUse& actual_use, Syntax& parameters, rt::buffer<TemplateArgument>& arguments) -> bool;

	fn same_parameter_expression(const TemplateEngine& this, const Syntax& first, const Syntax& second, const Syntax& first_parameters, const Syntax& second_parameters) -> bool;
	fn auto_argument(const TemplateEngine& this, Syntax& syntax, const TypeUse& actual) -> const TypeUse*;
	fn has_auto(const TemplateEngine& this, Syntax& syntax) -> bool;
	fn contains(const TemplateEngine& this, Syntax& root, Syntax& syntax) -> bool;
	fn parameter_count(const TemplateEngine& this, Entity& pattern) -> usize;
	fn explicit_count(const TemplateEngine& this, Entity& pattern) -> usize;
	fn function_source(const TemplateEngine& this, Entity& pattern) -> Syntax*;
	fn deduced_pattern(const TemplateEngine& this, Syntax& syntax, Syntax& parameters, usize supplied) -> bool;
	fn qualifications(TemplateEngine& this, Analyzer& analyzer, Syntax& declaration, const rt::buffer<rt::unique<SemanticExpression>>& values, rt::buffer<TemplateArgument>& arguments) -> bool;
	fn parameter_at(const TemplateEngine& this, Entity& pattern, usize index) -> Syntax*;
	fn parameter_name(const TemplateEngine& this, Syntax& parameter) -> Syntax*;
	fn declaration_name(const TemplateEngine& this, Syntax& declaration) -> Syntax*;
	fn unqualified(const TemplateEngine& this, Syntax& initial) -> Syntax*;
	fn argument_syntax(const TemplateEngine& this, Syntax& source, template_argument_kind kind) -> Syntax*;

	rt::buffer<rt::unique<TemplateInstance>> instances;
	rt::buffer<TemplateMemberDefinition> definitions;
};

fn TemplateEngine::clear(TemplateEngine& this) {
	@this.instances.clear();
	@this.definitions.clear();
};

fn TemplateEngine::instance(const TemplateEngine& this, Entity& entity) -> TemplateInstance* {
	usize index = 0;
	while (index < this.instances.size()) {
		TemplateInstance* instance = this.instances.data()[index].get();

		if (instance->entity == &entity) {
			return $instance;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::declaration_name(const TemplateEngine& this, Syntax& declaration) -> Syntax* {
	switch (declaration.kind()) {
		case syntax_kind::function:
			return declaration.function_name();
		case syntax_kind::record:
			return declaration.record_name();
		case syntax_kind::namespace_body:
			return declaration.namespace_name();
		case syntax_kind::using_alias:
			return declaration.alias_name();
		default:
			return nullptr;
	};
};

fn TemplateEngine::unqualified(const TemplateEngine& this, Syntax& initial) -> Syntax* {
	Syntax* name = &initial;
	while (name && name->kind() == syntax_kind::qualified_name) {
		@name = name->right();
	};

	return $name;
};

fn TemplateEngine::pattern_owner(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity* {
	if (name.kind() == syntax_kind::template_apply) {
		return @this.pattern_owner(@analyzer, @scope, @*name.callable());
	};

	if (name.kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name.left());

		if (!owner || !@analyzer.resolve(Entity*(owner))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner) {
			return nullptr;
		};

		return @this.pattern_owner(@analyzer, @*owner->members(), @*name.right());
	};

	return scope.lookup(name.token().text());
};

fn TemplateEngine::collect(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& source) -> bool {
	Syntax* declaration = &source;

	if (source.kind() == syntax_kind::template_declaration) {
		@declaration = source.template_declaration();
	};

	Syntax* name = this.declaration_name(@*declaration);

	if (!name) {
		@analyzer.error(&source, "template requires a record, function, namespace, or alias declaration\0");

		return false;
	};

	if (source.kind() == syntax_kind::template_declaration && declaration->kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
		Entity* owner = @this.pattern_owner(@analyzer, @scope, @*name->left());

		if (!owner || owner->kind() != entity_kind::template_pattern) {
			@analyzer.error(&source, "qualified template member requires a declared owner template\0");

			return false;
		};

		TemplateMemberDefinition definition;
		@definition.owner = $owner;
		@definition.source = &source;
		@definition.access = scope.access();

		if (!@this.definitions.push_back($definition)) {
			@analyzer.error(&source, "template definition storage is unavailable\0");

			return false;
		};

		return true;
	};

	if (name->kind() != syntax_kind::name) {
		if (source.kind() == syntax_kind::function && name->kind() == syntax_kind::qualified_name) {
			Entity* owner = @analyzer.lookup(@scope, @*name->left());
			if (!owner || !@analyzer.resolve(Entity*(owner))) {
				return false;
			};
			@owner = owner->member_owner();
			if (!owner || !owner->members()) {
				@analyzer.error(&source, "qualified function owner has no member scope\0");
				return false;
			};
			return @this.auto_declaration(@analyzer, @*owner->members(), @*owner->members(), @source, scope.access());
		};

		@analyzer.error(&source, "template declaration requires an unqualified name\0");

		return false;
	};
	if (source.kind() == syntax_kind::function) {
		return @this.auto_declaration(@analyzer, @scope, @scope, @source, scope.access());
	};

	Entity* previous = scope.local(name->token().text());

	if (previous && previous->kind() != entity_kind::template_pattern) {
		@analyzer.error(&source, "template name conflicts with another declaration\0");

		return false;
	};

	if (previous && declaration->kind() == syntax_kind::record) {
		Syntax* existing = previous->declaration()->template_declaration();

		if (existing->kind() != syntax_kind::record || previous->declaration()->template_parameters()->size() != source.template_parameters()->size()) {
			@analyzer.error(&source, "template redeclaration has a different parameter list\0");

			return false;
		};

		if (declaration->record_members()->kind() != syntax_kind::noop) {
			if (existing->record_members()->kind() != syntax_kind::noop) {
				@analyzer.error(&source, "duplicate template definition\0");

				return false;
			};

			@previous->replace_declaration(&source);
		};

		return true;
	};

	Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &source, &scope);

	if (!pattern) {
		@analyzer.error(&source, "template declaration storage is unavailable\0");

		return false;
	};

	@pattern->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::same_parameter_expression(const TemplateEngine& this, const Syntax& first, const Syntax& second, const Syntax& first_parameters, const Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind() || first.size() != second.size()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (!first.size()) {
		usize index = 0;
		while (index < first_parameters.size()) {
			if (first_parameters.item(index)->parameter_name()->token().text() == first.token().text()) {
				return second_parameters.item(index)->parameter_name()->token().text() == second.token().text();
			};
			@index = index + 1;
		};
		return first.token().kind == second.token().kind && first.token().text() == second.token().text();
	};
	if (first.token().kind != second.token().kind) {
		return false;
	};
	usize index = 0;
	while (index < first.size()) {
		if (!this.same_parameter_expression(*first.item(index), *second.item(index), first_parameters, second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn TemplateEngine::same_type_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second, Syntax& first_parameters, Syntax& second_parameters) -> bool {
	if (first.kind() != second.kind()) {
		return false;
	};
	if (first.kind() == syntax_kind::absent) {
		return true;
	};
	if (first.kind() == syntax_kind::type_auto || first.kind() == syntax_kind::type_pointer || first.kind() == syntax_kind::type_reference || first.kind() == syntax_kind::type_const || first.kind() == syntax_kind::type_array) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first.designated_type(), @second_scope, @*second.designated_type(), @first_parameters, @second_parameters)) {
			return false;
		};
		if (first.kind() == syntax_kind::type_const) {
			return this.same_parameter_expression(*first.qualifier_condition(), *second.qualifier_condition(), first_parameters, second_parameters);
		};
		if (first.kind() == syntax_kind::type_array) {
			return this.same_parameter_expression(*first.array_extent(), *second.array_extent(), first_parameters, second_parameters);
		};
		return true;
	};
	const Type* first_type = @analyzer.type(@first_scope, @first);
	const Type* second_type = @analyzer.type(@second_scope, @second);
	return first_type && first_type == second_type;
};

fn TemplateEngine::same_auto_signature(TemplateEngine& this, Analyzer& analyzer, Scope& first_scope, Syntax& first, Scope& second_scope, Syntax& second) -> bool {
	Syntax* first_parameters = first.function_parameters();
	Syntax* second_parameters = second.function_parameters();
	if (first_parameters->size() != second_parameters->size()) {
		return false;
	};
	usize index = 0;
	while (index < first_parameters->size()) {
		if (!@this.same_type_pattern(@analyzer, @first_scope, @*first_parameters->item(index)->parameter_type(), @second_scope, @*second_parameters->item(index)->parameter_type(), @*first_parameters, @*second_parameters)) {
			return false;
		};
		@index = index + 1;
	};
	return @this.same_type_pattern(@analyzer, @first_scope, @*first.function_result(), @second_scope, @*second.function_result(), @*first_parameters, @*second_parameters);
};

fn TemplateEngine::auto_declaration(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Scope& bindings, Syntax& declaration, access_kind access) -> bool {
	Syntax* name = this.unqualified(@*declaration.function_name());
	usize index = 0;
	while (index < scope.bindings().size()) {
		Entity* previous = scope.bindings().data()[index];
		@index = index + 1;
		if (previous->name() != name->token().text()) {
			continue;
		};
		if (previous->kind() != entity_kind::template_pattern || previous->declaration()->kind() != syntax_kind::function) {
			@analyzer.error(&declaration, "template name conflicts with another declaration\0");
			return false;
		};
		if (!@this.same_auto_signature(@analyzer, @*previous->resolution_scope(), @*previous->declaration(), @bindings, @declaration)) {
			continue;
		};
		if (declaration.function_body()->kind() != syntax_kind::noop) {
			if (previous->declaration()->function_body()->kind() != syntax_kind::noop) {
				@analyzer.error(&declaration, "duplicate function definition\0");
				return false;
			};
			@previous->replace_declaration(&declaration);
			@previous->set_resolution_scope(&bindings);
		};
		return true;
	};
	Entity* pattern = @analyzer.semantic_unit()->create_entity(entity_kind::template_pattern, name->token(), &declaration, &scope);
	if (!pattern) {
		return false;
	};
	@pattern->set_resolution_scope(&bindings);
	@pattern->set_access($access);
	@pattern->set_state(entity_state::ready);
	return true;
};

fn TemplateEngine::argument_syntax(const TemplateEngine& this, Syntax& source, template_argument_kind kind) -> Syntax* {
	if (source.kind() != syntax_kind::ambiguity) {
		return &source;
	};

	usize index = 0;
	while (index < source.size()) {
		Syntax* candidate = source.item(index);
		bool type = candidate->kind() == syntax_kind::type_name || candidate->kind() == syntax_kind::type_pointer || candidate->kind() == syntax_kind::type_reference || candidate->kind() == syntax_kind::type_array || candidate->kind() == syntax_kind::type_const || candidate->kind() == syntax_kind::type_function;

		if ((kind == template_argument_kind::type) == type) {
			return $candidate;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn TemplateEngine::argument(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& input, Syntax& parameter, TemplateArgument& result) -> bool {
	Syntax* source = &input;
	if (parameter.token().kind == token_kind::kw_typename) {
		@result.kind = template_argument_kind::type;
		@source = this.argument_syntax(@*source, template_argument_kind::type);

		if (!source) {
			@analyzer.error(&parameter, "template type argument requires a type\0");

			return false;
		};

		@result.type = @analyzer.type(@scope, @*source);

		if (!result.type) {
			return false;
		};

		const TypeUse* use = @analyzer.semantic_unit()->describe_type(@analyzer, @scope, *source, *result.type);

		if (!use) {
			return false;
		};

		@result.type_use.bind(*use);

		return true;
	};

	@result.kind = template_argument_kind::value;
	@source = this.argument_syntax(@*source, template_argument_kind::value);
	const Type* expected = @analyzer.type(@scope, @*parameter.template_parameter_type());

	if (!source || !expected) {
		return false;
	};

	var value = @analyzer.expression(@scope, @*source, rt::optional_ref<const Type>(*expected));

	if (!value.get() || !@analyzer.constant_integer(*value.get(), @result.value)) {
		@analyzer.error(source, "template value argument shall be an integer constant\0");

		return false;
	};

	@result.type = $expected;

	return true;
};

fn TemplateEngine::bind(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& parameter, const TemplateArgument& argument) -> bool {
	Syntax* name = this.parameter_name(@parameter);
	entity_kind kind = entity_kind::type_parameter;

	if (argument.kind == template_argument_kind::value) {
		@kind = entity_kind::enumerator;
	};

	Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), &parameter, &scope);

	if (!entity) {
		@analyzer.error(&parameter, "template parameter binding storage is unavailable\0");

		return false;
	};

	@entity->set_type(argument.type);

	if (argument.type_use.has_value()) {
		@entity->set_type_use(argument.type_use.value());
	};

	@entity->set_integer(u64(argument.value));
	@entity->set_state(entity_state::ready);

	return true;
};

fn TemplateEngine::apply(TemplateEngine& this, Analyzer& analyzer, Scope& lookup_scope, Scope& argument_scope, Syntax& source) -> Entity* {
	Entity* pattern = @analyzer.lookup(@lookup_scope, @*source.callable());

	if (pattern && pattern->kind() != entity_kind::template_pattern) {
		TemplateInstance* current = this.instance(@*Entity*(pattern));

		if (current) {
			@pattern = current->pattern;
		};
	};

	if (!pattern || pattern->kind() != entity_kind::template_pattern) {
		@analyzer.error(&source, "template arguments require a template declaration\0");

		return nullptr;
	};

	return @this.instantiate(@analyzer, @argument_scope, @*pattern, TemplateInput(@*source.arguments()));
};

fn TemplateEngine::instantiate(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const TemplateInput& input) -> Entity* {
	TemplateDeclarationValidator validator;

	if (!@validator.validate(@analyzer, @pattern)) {
		return nullptr;
	};

	Syntax* wrapper = pattern.declaration();
	usize parameter_count = this.parameter_count(@pattern);

	if (input.kind == template_input_kind::explicit_arguments && input.storage.explicit_arguments->size() > this.explicit_count(@pattern)) {
		@analyzer.error(input.storage.explicit_arguments, "too many template arguments\0");

		return nullptr;
	};

	Scope* bindings = @analyzer.semantic_unit()->create_scope(pattern.resolution_scope(), pattern.scope()->owner());

	if (!bindings) {
		@analyzer.error(wrapper, "template binding scope storage is unavailable\0");

		return nullptr;
	};

	var instance = rt::unique<TemplateInstance>(new TemplateInstance());

	if (!instance.get()) {
		@analyzer.error(wrapper, "template instance storage is unavailable\0");

		return nullptr;
	};

	@instance.get()->pattern = &pattern;
	usize index = 0;
	while (index < parameter_count) {
		Syntax* parameter = this.parameter_at(@pattern, index);
		TemplateArgument argument;

		if (input.kind == template_input_kind::explicit_arguments && index < input.storage.explicit_arguments->size()) {
			if (!@this.argument(@analyzer, @scope, @*input.storage.explicit_arguments->item(index), @*parameter, @argument)) {
				return nullptr;
			};
		}
		else if (input.kind == template_input_kind::deduced_arguments && index < input.storage.deduced_arguments->size() && input.storage.deduced_arguments->data()[index].type) {
			@argument := input.storage.deduced_arguments->data()[index];
		}
		else {
			Syntax* fallback = nullptr;

			if (parameter->kind() == syntax_kind::template_parameter) {
				@fallback = parameter->template_parameter_default();
			};

			if (!fallback || fallback->kind() == syntax_kind::absent) {
				@analyzer.error(parameter, "template argument could not be deduced and has no default\0");

				return nullptr;
			};

			if (!@this.argument(@analyzer, @*bindings, @*fallback, @*parameter, @argument)) {
				return nullptr;
			};
		};

		if (index < this.explicit_count(@pattern) && !@this.bind(@analyzer, @*bindings, @*parameter, argument)) {
			return nullptr;
		};

		if (!@instance.get()->arguments.push_back($argument)) {
			return nullptr;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < this.instances.size()) {
		TemplateInstance* existing = this.instances.data()[index].get();
		@index = index + 1;

		if (existing->pattern != &pattern || existing->arguments.size() != instance.get()->arguments.size()) {
			continue;
		};

		usize argument = 0;

		while (argument < existing->arguments.size() && existing->arguments.data()[argument].same(instance.get()->arguments.data()[argument])) {
			@argument = argument + 1;
		};

		if (argument == existing->arguments.size()) {
			return existing->entity;
		};
	};

	Syntax* declaration = wrapper;

	if (wrapper->kind() == syntax_kind::template_declaration) {
		@declaration = wrapper->template_declaration();
	};

	Syntax* name = this.unqualified(@*this.declaration_name(@*declaration));
	entity_kind kind = entity_kind::record;

	if (declaration->kind() == syntax_kind::function) {
		@kind = entity_kind::function;
	}
	else if (declaration->kind() == syntax_kind::namespace_body) {
		@kind = entity_kind::namespace_body;
	}
	else if (declaration->kind() == syntax_kind::using_alias) {
		@kind = entity_kind::alias;
	};

	Entity* entity = @analyzer.semantic_unit()->create_entity($kind, name->token(), declaration, bindings);

	if (!entity) {
		@analyzer.error(declaration, "template instance storage is unavailable\0");

		return nullptr;
	};

	@entity->set_access(pattern.access());
	@instance.get()->entity = entity;
	@entity->set_instantiated();
	TemplateInstance* published = instance.get();

	if (!@this.instances.push_back($instance)) {
		@analyzer.error(declaration, "template instance storage is unavailable\0");

		return nullptr;
	};

	// Publish the canonical identity before members can recursively refer to the instance.
	if (entity->kind() == entity_kind::record || entity->kind() == entity_kind::namespace_body) {
		Scope* members = @analyzer.semantic_unit()->create_scope(bindings, Entity*(entity));

		if (!members) {
			return nullptr;
		};

		@entity->set_members(Scope*(members));
		Syntax* body = declaration->record_members();

		if (entity->kind() == entity_kind::namespace_body) {
			@body = declaration->namespace_members();
		};

		if (!@analyzer.collect(@*members, @*body) || !@this.member_definitions(@analyzer, @*published)) {
			return nullptr;
		};
	};

	if (!@analyzer.resolve(Entity*(entity))) {
		return nullptr;
	};

	return $entity;
};

fn TemplateEngine::member_definitions(TemplateEngine& this, Analyzer& analyzer, TemplateInstance& instance) -> bool {
	usize index = 0;
	while (index < this.definitions.size()) {
		TemplateMemberDefinition definition := this.definitions.data()[index];
		@index = index + 1;

		if (definition.owner != instance.pattern) {
			continue;
		};

		Syntax* parameters = definition.source->template_parameters();

		if (parameters->size() != instance.arguments.size()) {
			@analyzer.error(definition.source, "member definition template parameters do not match the owning template\0");

			return false;
		};

		Scope* bindings = @analyzer.semantic_unit()->create_scope(instance.entity->members(), Entity*(instance.entity));

		if (!bindings) {
			return false;
		};

		usize parameter = 0;

		while (parameter < parameters->size()) {
			if (!@this.bind(@analyzer, @*bindings, @*parameters->item(parameter), instance.arguments.data()[parameter])) {
				return false;
			};

			@parameter = parameter + 1;
		};

		Syntax* declaration = definition.source->template_declaration();
		Syntax* name = this.unqualified(@*declaration->function_name());
		entity_kind category = entity_kind::function;

		if (this.qualifier_dependent(@*declaration)) {
			if (!@this.auto_declaration(@analyzer, @*instance.entity->members(), @*bindings, @*declaration, access_kind(definition.access))) {
				return false;
			};
			continue;
		};

		Entity* function = @analyzer.semantic_unit()->create_entity($category, name->token(), declaration, instance.entity->members());

		if (!function) {
			return false;
		};

		@function->set_access(access_kind(definition.access));
		@function->set_resolution_scope($bindings);

		if (function->kind() == entity_kind::template_pattern) {
			@function->set_state(entity_state::ready);
		};
	};

	return true;
};

fn TemplateEngine::match(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& syntax, const TypeUse& actual_use, Syntax& parameters, rt::buffer<TemplateArgument>& arguments) -> bool {
	const Type* actual = &actual_use.type();
	const TypeUse* use = &actual_use;

	if (syntax.kind() == syntax_kind::type_auto) {
		const Type* unqualified = @analyzer.type_store()->qualified(*actual, type_qualifier::mutable);
		@use = @analyzer.semantic_unit()->retype_use(*use, *unqualified);

		return use && @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_name) {
		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_reference || syntax.kind() == syntax_kind::type_const) {
		if (actual->kind() == type_kind::reference) {
			@actual = actual->element();
			@use = &use->element();
		};

		return @this.match(@analyzer, @scope, @*syntax.designated_type(), *use, @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_pointer) {
		return actual->kind() == type_kind::pointer && @this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments);
	};

	if (syntax.kind() == syntax_kind::type_array) {
		if (actual->kind() != type_kind::array || !@this.match(@analyzer, @scope, @*syntax.designated_type(), use->element(), @parameters, @arguments)) {
			return false;
		};

		Syntax* extent = syntax.array_extent();
		usize index = 0;
		while (index < parameters.size()) {
			Syntax* parameter = parameters.item(index);

			if (parameter->token().kind != token_kind::kw_typename && parameter->template_parameter_name()->token().text() == extent->token().text()) {
				TemplateArgument* argument = (@arguments).data() + index;
				const Type* type = @analyzer.type(@scope, @*parameter->template_parameter_type());

				if (!type || argument->type && argument->value != actual->count()) {
					return false;
				};

				@argument->kind = template_argument_kind::value;
				@argument->type = $type;
				@argument->value = actual->count();

				return true;
			};

			@index = index + 1;
		};

		u64 expected = 0;

		return @analyzer.integer(@*extent, @expected) && expected == actual->count();
	};

	if (syntax.kind() == syntax_kind::name) {
		usize index = 0;
		while (index < parameters.size()) {
			Syntax* parameter = parameters.item(index);

			if (parameter->token().kind == token_kind::kw_typename && parameter->template_parameter_name()->token().text() == syntax.token().text()) {
				TemplateArgument* argument = (@arguments).data() + index;

				if (argument->type && argument->type != actual) {
					return false;
				};

				@argument->kind = template_argument_kind::type;
				@argument->type = $actual;

				if (!argument->type_use.has_value()) {
					@argument->type_use.bind(*use);
				};

				return true;
			};

			@index = index + 1;
		};
	};

	Syntax* application = &syntax;

	if (syntax.kind() == syntax_kind::qualified_name) {
		@application = syntax.right();
	};

	if (application->kind() == syntax_kind::template_apply && actual->kind() == type_kind::named) {
		TemplateInstance* instance = this.instance(@*actual->entity());
		Entity* pattern = @this.pattern_owner(@analyzer, @scope, @syntax);

		if (!instance || instance->pattern != pattern || application->arguments()->size() > instance->arguments.size()) {
			return false;
		};

		usize index = 0;
		while (index < application->arguments()->size()) {
			const TemplateArgument& argument = instance->arguments.data()[index];
			Syntax* argument_source = this.argument_syntax(@*application->arguments()->item(index), template_argument_kind(argument.kind));

			if (!argument_source) {
				return false;
			};

			if (argument.kind == template_argument_kind::type) {
				const TypeUse* argument_use = argument.type_use.get();

				if (!argument_use) {
					@argument_use = @analyzer.semantic_unit()->canonical_use(*argument.type);
				};

				if (!argument_use || !@this.match(@analyzer, @scope, @*argument_source, *argument_use, @parameters, @arguments)) {
					return false;
				};
			}
			else {
				usize parameter = 0;

				while (parameter < parameters.size()) {
					Syntax* name = parameters.item(parameter)->template_parameter_name();

					if (name->token().text() == argument_source->token().text()) {
						break;
					};

					@parameter = parameter + 1;
				};

				if (parameter < parameters.size()) {
					TemplateArgument* bound = (@arguments).data() + parameter;

					if (bound->type && !bound->same(argument)) {
						return false;
					};

					@*bound := argument;
				}
				else {
					var value = @analyzer.expression(@scope, @*argument_source, rt::optional_ref<const Type>(*argument.type));
					u64 expected = 0;

					if (!value.get() || !@analyzer.constant_integer(*value.get(), @expected) || expected != argument.value) {
						return false;
					};
				};
			};

			@index = index + 1;
		};

		return true;
	};

	const Type* expected = @analyzer.type(@scope, @syntax);

	return expected && expected == actual;
};

fn TemplateEngine::call_pattern(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Syntax& name) -> Entity* {
	Syntax* application = &name;
	Scope* lookup = &scope;

	if (name.kind() == syntax_kind::qualified_name) {
		@application = name.right();
	};

	if (application->kind() != syntax_kind::template_apply) {
		return nullptr;
	};

	if (name.kind() == syntax_kind::qualified_name) {
		Entity* owner = @analyzer.lookup(@scope, @*name.left());

		if (!owner || !@analyzer.resolve(Entity*(owner))) {
			return nullptr;
		};

		@owner = owner->member_owner();

		if (!owner || !owner->members()) {
			return nullptr;
		};

		@lookup = owner->members();
	};

	Entity* pattern = @analyzer.lookup(@*lookup, @*application->callable());

	if (!pattern || pattern->kind() != entity_kind::template_pattern || !this.function_source(@*pattern)) {
		return nullptr;
	};

	return pattern;
};

fn TemplateEngine::deduced_pattern(const TemplateEngine& this, Syntax& syntax, Syntax& parameters, usize supplied) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		usize index = supplied;
		while (index < parameters.size()) {
			if (parameters.item(index)->template_parameter_name()->token().text() == syntax.token().text()) {
				return true;
			};

			@index = index + 1;
		};
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.deduced_pattern(@*syntax.item(index), @parameters, usize(supplied))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifications(TemplateEngine& this, Analyzer& analyzer, Syntax& declaration, const rt::buffer<rt::unique<SemanticExpression>>& values, rt::buffer<TemplateArgument>& arguments) -> bool {
	usize index = 0;
	while (index < values.size()) {
		Syntax* parameter = declaration.function_parameters()->item(index);
		SemanticExpression* value = values.data()[index].get();
		@index = index + 1;

		if (!this.has_auto(@*parameter->parameter_type())) {
			continue;
		};

		const TypeUse* use = value->type_use().get();

		if (!use) {
			@use = @analyzer.semantic_unit()->canonical_use(*value->type());
		};

		if (!use) {
			return false;
		};

		@use = this.auto_argument(@*parameter->parameter_type(), *use);

		if (!use) {
			return false;
		};

		bool readonly = use->type().qualifier() == type_qualifier::immutable || parameter->parameter_type()->kind() == syntax_kind::type_reference && !value->mutable_access();
		type_qualifier qualifier = type_qualifier::mutable;

		if (readonly) {
			@qualifier = type_qualifier::immutable;
		};

		TemplateArgument argument;
		@argument.kind = template_argument_kind::value;
		@argument.type = @analyzer.type_store()->qualified(*analyzer.type_store()->find_primitive(rt::string_view("bool\0")), $qualifier);
		@argument.value = static_cast<u64>($readonly);

		if (!argument.type || !@arguments.push_back($argument)) {
			return false;
		};
	};

	return true;
};

fn TemplateEngine::deduce(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, const rt::buffer<rt::unique<SemanticExpression>>& values) -> Entity* {
	return @this.specialize_call(@analyzer, @scope, @pattern, rt::optional_ref<Syntax>(), values);
};

fn TemplateEngine::specialize_call(TemplateEngine& this, Analyzer& analyzer, Scope& scope, Entity& pattern, rt::optional_ref<Syntax> supplied, const rt::buffer<rt::unique<SemanticExpression>>& values) -> Entity* {
	Syntax* declaration = this.function_source(@pattern);

	if (!declaration || declaration->function_parameters()->size() != values.size()) {
		@analyzer.error(pattern.declaration(), "function template requires matching call arguments\0");
		return nullptr;
	};

	usize visible = this.explicit_count(@pattern);
	usize provided = 0;

	if (supplied.has_value()) {
		@provided = supplied.value().size();
	};

	if (provided > visible) {
		@analyzer.error(supplied.get(), "too many template arguments\0");
		return nullptr;
	};

	rt::buffer<TemplateArgument> arguments;
	usize index = 0;
	while (index < visible) {
		TemplateArgument argument;

		if (index < provided && !@this.argument(@analyzer, @scope, @*supplied.value().item(index), @*this.parameter_at(@pattern, index), @argument)) {
			return nullptr;
		};

		if (!@arguments.push_back($argument)) {
			return nullptr;
		};

		@index = index + 1;
	};

	if (visible) {
		Syntax* parameters = pattern.declaration()->template_parameters();
		@index = 0;

		while (index < values.size()) {
			Syntax* parameter = declaration->function_parameters()->item(index)->parameter_type();
			SemanticExpression* value = values.data()[index].get();
			@index = index + 1;

			if (!this.deduced_pattern(@*parameter, @*parameters, usize(provided))) {
				continue;
			};

			const TypeUse* use = value->type_use().get();

			if (!use) {
				@use = @analyzer.semantic_unit()->canonical_use(*value->type());
			};

			if (!use || !@this.match(@analyzer, @*pattern.scope(), @*parameter, *use, @*parameters, @arguments)) {
				return nullptr;
			};
		};
	};

	if (!@this.qualifications(@analyzer, @*declaration, values, @arguments)) {
		return nullptr;
	};

	return @this.instantiate(@analyzer, @scope, @pattern, TemplateInput(arguments));
};

fn TemplateEngine::has_auto(const TemplateEngine& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_auto) {
		return true;
	};

	usize index = 0;
	while (index < syntax.size()) {
		if (this.has_auto(@*syntax.item(index))) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::contains(const TemplateEngine& this, Syntax& root, Syntax& syntax) -> bool {
	if (&root == &syntax) {
		return true;
	};

	usize index = 0;
	while (index < root.size()) {
		if (this.contains(@*root.item(index), @syntax)) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn TemplateEngine::qualifier_dependent(const TemplateEngine& this, Syntax& declaration) -> bool {
	return declaration.kind() == syntax_kind::function && this.has_auto(@*declaration.function_parameters());
};

fn TemplateEngine::function_source(const TemplateEngine& this, Entity& pattern) -> Syntax* {
	Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		@source = source->template_declaration();
	};

	if (source->kind() != syntax_kind::function) {
		return nullptr;
	};

	return source;
};

fn TemplateEngine::explicit_count(const TemplateEngine& this, Entity& pattern) -> usize {
	Syntax* source = pattern.declaration();

	if (source->kind() == syntax_kind::template_declaration) {
		return source->template_parameters()->size();
	};

	return 0;
};

fn TemplateEngine::parameter_count(const TemplateEngine& this, Entity& pattern) -> usize {
	usize count = this.explicit_count(@pattern);
	Syntax* source = this.function_source(@pattern);

	if (!source) {
		return $count;
	};

	usize index = 0;
	while (index < source->function_parameters()->size()) {
		if (this.has_auto(@*source->function_parameters()->item(index)->parameter_type())) {
			@count = count + 1;
		};

		@index = index + 1;
	};

	return $count;
};

fn TemplateEngine::parameter_at(const TemplateEngine& this, Entity& pattern, usize position) -> Syntax* {
	usize visible = this.explicit_count(@pattern);

	if (position < visible) {
		return pattern.declaration()->template_parameters()->item(position);
	};

	Syntax* source = this.function_source(@pattern);

	if (!source) {
		return nullptr;
	};

	usize index = 0;
	usize parameter = visible;
	while (index < source->function_parameters()->size()) {
		Syntax* candidate = source->function_parameters()->item(index);
		@index = index + 1;

		if (!this.has_auto(@*candidate->parameter_type())) {
			continue;
		};

		if (parameter == position) {
			return $candidate;
		};

		@parameter = parameter + 1;
	};

	return nullptr;
};

fn TemplateEngine::parameter_name(const TemplateEngine& this, Syntax& parameter) -> Syntax* {
	if (parameter.kind() == syntax_kind::parameter) {
		return parameter.parameter_name();
	};

	return parameter.template_parameter_name();
};

fn TemplateEngine::qualifier(const TemplateEngine& this, Scope& initial, Syntax& syntax) -> const Type* {
	Scope* scope = &initial;
	while (scope) {
		Entity* owner = scope->owner();
		TemplateInstance* instance = nullptr;

		if (owner) {
			@instance = this.instance(@*owner);
		};

		if (instance && owner->declaration()->kind() == syntax_kind::function && this.function_source(@*instance->pattern)) {
			usize index = this.explicit_count(@*instance->pattern);
			while (index < instance->arguments.size()) {
				Syntax* parameter = this.parameter_at(@*instance->pattern, index);

				if (this.contains(@*parameter->parameter_type(), @syntax)) {
					return instance->arguments.data()[index].type;
				};

				@index = index + 1;
			};
		};

		@scope = scope->parent();
	};

	return nullptr;
};

fn TemplateEngine::auto_argument(const TemplateEngine& this, Syntax& syntax, const TypeUse& actual) -> const TypeUse* {
	if (syntax.kind() == syntax_kind::type_auto) {
		return &actual;
	};

	if (syntax.kind() == syntax_kind::type_reference) {
		if (actual.type().kind() == type_kind::reference) {
			return this.auto_argument(@*syntax.designated_type(), actual.element());
		};

		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	if (syntax.kind() == syntax_kind::type_pointer && actual.type().kind() == type_kind::pointer || syntax.kind() == syntax_kind::type_array && actual.type().kind() == type_kind::array) {
		return this.auto_argument(@*syntax.designated_type(), actual.element());
	};

	if (syntax.kind() == syntax_kind::type_const) {
		return this.auto_argument(@*syntax.designated_type(), actual);
	};

	return nullptr;
};

fn TemplateArgument::same(const TemplateArgument& this, const TemplateArgument& other) -> bool {
	return this.kind == other.kind && this.type == other.type && (this.kind == template_argument_kind::type || this.value == other.value);
};

enum template_validation_role : [u08] {
	dependent_type;
	dependent_value;
	value;
};

struct TemplateValidationSymbol {
	Token name;
	template_validation_role role;
};

struct TemplateDeclarationValidator {
	fn validate(TemplateDeclarationValidator& this, Analyzer& analyzer, Entity& pattern) -> bool;

private:
	fn dependent(const TemplateDeclarationValidator& this, const Syntax& syntax) -> bool;
	fn lookup(const TemplateDeclarationValidator& this, const Token& name) -> const TemplateValidationSymbol*;
	fn remember(TemplateDeclarationValidator& this, Analyzer& analyzer, Syntax& name, template_validation_role role) -> bool;
	fn restore(TemplateDeclarationValidator& this, usize checkpoint, usize frame);
	fn type_names(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& syntax) -> bool;
	fn declaration(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& syntax) -> bool;
	fn members(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& owner, Syntax& body) -> bool;
	fn certain(const TemplateDeclarationValidator& this, Syntax& syntax) -> Syntax*;

	rt::buffer<TemplateValidationSymbol> symbols;
	usize frame_start;
};

fn TemplateDeclarationValidator::lookup(const TemplateDeclarationValidator& this, const Token& name) -> const TemplateValidationSymbol* {
	usize index = this.symbols.size();
	while (index) {
		@index = index - 1;
		if (this.symbols.data()[index].name.same(name)) {
			return &this.symbols.data()[index];
		};
	};
	return nullptr;
};

fn TemplateDeclarationValidator::dependent(const TemplateDeclarationValidator& this, const Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::name) {
		const TemplateValidationSymbol* symbol = this.lookup(syntax.token());
		return symbol && symbol->role != template_validation_role::value;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.dependent(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn TemplateDeclarationValidator::remember(TemplateDeclarationValidator& this, Analyzer& analyzer, Syntax& name, template_validation_role role) -> bool {
	if (name.kind() != syntax_kind::name) {
		return true;
	};
	usize index = this.frame_start;
	while (index < this.symbols.size()) {
		const TemplateValidationSymbol& previous = this.symbols.data()[index];
		if (previous.name.same(name.token())) {
			if (previous.role == template_validation_role::dependent_type && role == template_validation_role::dependent_type) {
				return true;
			};
			@analyzer.error(&name, "duplicate declaration in template member scope\0");
			return false;
		};
		@index = index + 1;
	};
	TemplateValidationSymbol symbol;
	@symbol.name = name.token();
	@symbol.role = $role;
	if (!@this.symbols.push_back($symbol)) {
		@analyzer.error(&name, "out of memory storing template declaration names\0");
		return false;
	};
	return true;
};

fn TemplateDeclarationValidator::restore(TemplateDeclarationValidator& this, usize checkpoint, usize frame) {
	while (this.symbols.size() > checkpoint) {
		@this.symbols.pop_back();
	};
	@this.frame_start = $frame;
};

fn TemplateDeclarationValidator::certain(const TemplateDeclarationValidator& this, Syntax& syntax) -> Syntax* {
	if (syntax.kind() != syntax_kind::ambiguity) {
		return &syntax;
	};
	if (this.dependent(syntax)) {
		return nullptr;
	};
	Syntax* selected = nullptr;
	usize index = 0;
	while (index < syntax.size()) {
		Syntax* candidate = syntax.item(index);
		syntax_kind kind = candidate->kind();
		if (kind == syntax_kind::variable || kind == syntax_kind::function || kind == syntax_kind::record || kind == syntax_kind::enumeration || kind == syntax_kind::using_alias || kind == syntax_kind::template_declaration) {
			if (selected) {
				return nullptr;
			};
			@selected = candidate;
		};
		@index = index + 1;
	};
	return selected;
};

fn TemplateDeclarationValidator::type_names(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::type_name) {
		if (this.dependent(syntax)) {
			return true;
		};
		Syntax* name = syntax.designated_type();
		// Applications have their own argument roles and are checked when instantiated.
		if (name->kind() == syntax_kind::template_apply || name->kind() == syntax_kind::qualified_name) {
			return true;
		};
		const TemplateValidationSymbol* symbol = this.lookup(name->token());
		if (symbol && symbol->role == template_validation_role::value) {
			@analyzer.error(&syntax, "identifier does not name a type entity\0");
			return false;
		};
		Entity* entity = @analyzer.lookup(@scope, @*name);
		if (!entity || !entity->denotes_type()) {
			@analyzer.error(&syntax, "identifier does not name a type entity\0");
			return false;
		};
		return true;
	};
	if (syntax.kind() == syntax_kind::type_pointer || syntax.kind() == syntax_kind::type_reference || syntax.kind() == syntax_kind::type_const || syntax.kind() == syntax_kind::type_array) {
		return @this.type_names(@analyzer, @scope, @*syntax.designated_type());
	};
	if (syntax.kind() == syntax_kind::type_function) {
		if (!@this.type_names(@analyzer, @scope, @*syntax.function_type_result())) {
			return false;
		};
		Syntax* parameters = syntax.function_type_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			if (!@this.type_names(@analyzer, @scope, @*parameters->item(index)->parameter_type())) {
				return false;
			};
			@index = index + 1;
		};
	};
	return true;
};

fn TemplateDeclarationValidator::members(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& owner, Syntax& body) -> bool {
	usize checkpoint = this.symbols.size();
	usize frame = this.frame_start;
	@this.frame_start = checkpoint;
	usize index = 0;
	while (index < body.size()) {
		Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::record || member->kind() == syntax_kind::enumeration || member->kind() == syntax_kind::using_alias) {
			Syntax* name = member->record_name();
			if (member->kind() == syntax_kind::using_alias) {
				@name = member->alias_name();
			};
			if (!@this.remember(@analyzer, @*name, template_validation_role::dependent_type)) {
				return false;
			};
		};
	};
	@index = 0;
	while (index < body.size()) {
		Syntax* member = this.certain(@*body.item(index));
		@index = index + 1;
		if (!member) {
			continue;
		};
		if (member->kind() == syntax_kind::function && owner.kind() == syntax_kind::record) {
			Syntax* name = member->function_name();
			bool special = name->kind() == syntax_kind::unary || name->kind() == syntax_kind::operator_name && name->operator_token().kind == token_kind::op_assign || name->kind() == syntax_kind::conversion_name || name->kind() == syntax_kind::name && name->token().same(owner.record_name()->token());
			if (special && (!member->function_parameters()->size() || !member->function_parameters()->item(0)->parameter_name()->token().is(rt::string_view("this\0")))) {
				@analyzer.error(member, "instance function requires an explicit 'this' reference parameter\0");
				return false;
			};
		};
		if (!@this.declaration(@analyzer, @scope, @*member)) {
			return false;
		};
		if (member->kind() == syntax_kind::variable && !@this.remember(@analyzer, @*member->variable_name(), template_validation_role::value)) {
			return false;
		};
	};
	@this.restore($checkpoint, $frame);
	return true;
};

fn TemplateDeclarationValidator::declaration(TemplateDeclarationValidator& this, Analyzer& analyzer, Scope& scope, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::template_declaration) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		Syntax* parameters = syntax.template_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			Syntax* parameter = parameters->item(index);
			Syntax* type = parameter->template_parameter_type();
			usize prior = 0;
			while (prior < index) {
				if (parameters->item(prior)->template_parameter_name()->token().same(parameter->template_parameter_name()->token())) {
					@analyzer.error(parameter, "duplicate template parameter declaration\0");
					return false;
				};
				@prior = prior + 1;
			};
			if (type->kind() != syntax_kind::absent && !this.dependent(*type)) {
				const Type* resolved = @analyzer.type(@scope, @*type);
				if (!resolved) {
					return false;
				};
				if (!resolved->kind().is_integer()) {
					@analyzer.error(parameter, "non-type template parameter requires an integral type\0");
					return false;
				};
			};
			template_validation_role role = template_validation_role::dependent_type;
			if (type->kind() != syntax_kind::absent) {
				@role = template_validation_role::dependent_value;
			};
			if (!@this.remember(@analyzer, @*parameter->template_parameter_name(), $role)) {
				return false;
			};
			@index = index + 1;
		};
		bool valid = @this.declaration(@analyzer, @scope, @*syntax.template_declaration());
		@this.restore($checkpoint, $frame);
		return valid;
	};
	if (syntax.kind() == syntax_kind::record) {
		usize checkpoint = this.symbols.size();
		usize frame = this.frame_start;
		@this.frame_start = checkpoint;
		if (!@this.remember(@analyzer, @*syntax.record_name(), template_validation_role::dependent_type)) {
			return false;
		};
		bool valid = @this.members(@analyzer, @scope, @syntax, @*syntax.record_members());
		@this.restore($checkpoint, $frame);
		return valid;
	};
	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.members(@analyzer, @scope, @syntax, @*syntax.namespace_members());
	};
	if (syntax.kind() == syntax_kind::variable) {
		return @this.type_names(@analyzer, @scope, @*syntax.variable_type());
	};
	if (syntax.kind() == syntax_kind::using_alias) {
		return @this.type_names(@analyzer, @scope, @*syntax.alias_type());
	};
	if (syntax.kind() == syntax_kind::function) {
		if (!@this.type_names(@analyzer, @scope, @*syntax.function_result())) {
			return false;
		};
		usize index = 0;
		while (index < syntax.function_parameters()->size()) {
			if (!@this.type_names(@analyzer, @scope, @*syntax.function_parameters()->item(index)->parameter_type())) {
				return false;
			};
			@index = index + 1;
		};
	};
	return true;
};

fn TemplateDeclarationValidator::validate(TemplateDeclarationValidator& this, Analyzer& analyzer, Entity& pattern) -> bool {
	@this.symbols.clear();
	@this.frame_start = 0;
	if (!pattern.declaration() || !pattern.resolution_scope()) {
		return true;
	};
	return @this.declaration(@analyzer, @*pattern.resolution_scope(), @*pattern.declaration());
};

struct TypeUse;

// A label's semantic spelling can be generated independently of its source location.
struct ParameterLabel {
	fn ParameterLabel(ParameterLabel& this, const Token& location, const rt::string_view& spelling);

	fn location(const ParameterLabel& this) -> Token;
	fn text(const ParameterLabel& this) -> rt::string_view;
	fn is(const ParameterLabel& this, const rt::string_view& spelling) -> bool;

private:
	Token source_location;
	rt::string_view spelling;
};

struct ParameterUse {
	fn ParameterUse(ParameterUse& this, rt::optional<ParameterLabel> name, const TypeUse& type);

	fn name(const ParameterUse& this) -> const rt::optional<ParameterLabel>&;
	fn type(const ParameterUse& this) -> const TypeUse&;

private:
	rt::optional<ParameterLabel> parameter_name;
	const TypeUse* parameter_type;
};

struct FunctionUse {
	fn FunctionUse(FunctionUse& this, rt::buffer<ParameterUse> parameters, const TypeUse& result);

	fn parameters(const FunctionUse& this) -> const rt::buffer<ParameterUse>&;
	fn result(const FunctionUse& this) -> const TypeUse&;

private:
	rt::buffer<ParameterUse> arguments;
	const TypeUse* return_type;
};

union TypeUseDetail {
	const TypeUse* element;
	const FunctionUse* callable;
};

// A declaration's type spelling supplies metadata without changing canonical type identity.
// Nominal and primitive uses are leaves. Indirect/array uses carry their element use;
// callable uses carry parameter labels and nested uses in a separately owned FunctionUse.
struct TypeUse {
	fn TypeUse(TypeUse& this, const Type& type);
	fn TypeUse(TypeUse& this, const Type& type, const TypeUse& element);
	fn TypeUse(TypeUse& this, const Type& type, const FunctionUse& callable);

	fn type(const TypeUse& this) -> const Type&;
	fn element(const TypeUse& this) -> const TypeUse&;
	fn callable(const TypeUse& this) -> const FunctionUse&;
	fn effective(const TypeUse& this) -> const TypeUse&;

private:
	const Type* canonical_type;
	TypeUseDetail detail;
};

fn ParameterLabel::ParameterLabel(ParameterLabel& this, const Token& location, const rt::string_view& spelling) {
	@this.source_location := location;
	@this.spelling = rt::string_view(spelling.data(), spelling.size());
};

fn ParameterLabel::location(const ParameterLabel& this) -> Token {
	return Token(this.source_location);
};

fn ParameterLabel::text(const ParameterLabel& this) -> rt::string_view {
	return rt::string_view(this.spelling.data(), this.spelling.size());
};

fn ParameterLabel::is(const ParameterLabel& this, const rt::string_view& spelling) -> bool {
	return this.spelling == spelling;
};

fn ParameterUse::ParameterUse(ParameterUse& this, rt::optional<ParameterLabel> name, const TypeUse& type) {
	@this.parameter_name = $name;
	@this.parameter_type = &type;
};

fn ParameterUse::name(const ParameterUse& this) -> const rt::optional<ParameterLabel>& {
	return this.parameter_name;
};

fn ParameterUse::type(const ParameterUse& this) -> const TypeUse& {
	return *this.parameter_type;
};

fn FunctionUse::FunctionUse(FunctionUse& this, rt::buffer<ParameterUse> parameters, const TypeUse& result) {
	@this.arguments = $parameters;
	@this.return_type = &result;
};

fn FunctionUse::parameters(const FunctionUse& this) -> const rt::buffer<ParameterUse>& {
	return this.arguments;
};

fn FunctionUse::result(const FunctionUse& this) -> const TypeUse& {
	return *this.return_type;
};

fn TypeUse::TypeUse(TypeUse& this, const Type& type) {
	@this.canonical_type = &type;
};

fn TypeUse::TypeUse(TypeUse& this, const Type& type, const TypeUse& element) {
	@this.canonical_type = &type;
	@this.detail.element = &element;
};

fn TypeUse::TypeUse(TypeUse& this, const Type& type, const FunctionUse& callable) {
	@this.canonical_type = &type;
	@this.detail.callable = &callable;
};

fn TypeUse::type(const TypeUse& this) -> const Type& {
	return *this.canonical_type;
};

fn TypeUse::element(const TypeUse& this) -> const TypeUse& {
	return *this.detail.element;
};

fn TypeUse::callable(const TypeUse& this) -> const FunctionUse& {
	return *this.detail.callable;
};

fn TypeUse::effective(const TypeUse& this) -> const TypeUse& {
	if (this.type().kind() == type_kind::reference) {
		return this.element();
	};

	return this;
};

fn SemanticUnit::retain_use(SemanticUnit& this, rt::unique<TypeUse> use) -> const TypeUse* {
	const TypeUse* borrowed = use.get();

	if (!borrowed || !@this.type_uses.push_back(rt::unique<TypeUse>(@use.release()))) {
		return nullptr;
	};

	return $borrowed;
};

fn SemanticUnit::leaf_use(SemanticUnit& this, const Type& type) -> const TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array || type.kind() == type_kind::function) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type)));
};

fn SemanticUnit::indirect_use(SemanticUnit& this, const Type& type, const TypeUse& element) -> const TypeUse* {
	if (type.kind() != type_kind::pointer && type.kind() != type_kind::reference && type.kind() != type_kind::array) {
		return nullptr;
	};

	if (type.element() != &element.type()) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type, element)));
};

fn SemanticUnit::function_use(SemanticUnit& this, const Type& type, rt::buffer<ParameterUse> parameters, const TypeUse& result) -> const TypeUse* {
	if (type.kind() != type_kind::function || type.signature().parameters().size() != parameters.size()) {
		return nullptr;
	};

	if (type.signature().result() != &result.type()) {
		return nullptr;
	};

	usize index = 0;
	while (index < parameters.size()) {
		if (type.signature().parameters().data()[index] != &parameters.data()[index].type().type()) {
			return nullptr;
		};

		@index = index + 1;
	};

	var function = rt::unique<FunctionUse>(new FunctionUse($parameters, result));
	FunctionUse* borrowed = function.get();

	if (!borrowed || !@this.function_uses.push_back(rt::unique<FunctionUse>(@function.release()))) {
		return nullptr;
	};

	return @this.retain_use(rt::unique<TypeUse>(new TypeUse(type, *borrowed)));
};

fn SemanticUnit::canonical_use(SemanticUnit& this, const Type& type) -> const TypeUse* {
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		const TypeUse* element = @this.canonical_use(*type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function) {
		return @this.leaf_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		const TypeUse* element = @this.canonical_use(*type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.canonical_use(*type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::retype_use(SemanticUnit& this, const TypeUse& source, const Type& type) -> const TypeUse* {
	if (&source.type() == &type) {
		return &source;
	};

	if (source.type().kind() != type.kind()) {
		return @this.canonical_use(type);
	};

	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		const TypeUse* element = @this.retype_use(source.element(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (type.kind() != type_kind::function || source.callable().parameters().size() != type.signature().parameters().size()) {
		return @this.canonical_use(type);
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		const ParameterUse& previous = source.callable().parameters().data()[index];
		const TypeUse* element = @this.retype_use(previous.type(), *type.signature().parameters().data()[index]);

		if (!element || !@parameters.push_back(ParameterUse(rt::optional<ParameterLabel>(previous.name()), *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.retype_use(source.callable().result(), *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_type(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, const Type& type) -> const TypeUse* {
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_name || kind == syntax_kind::type_const || kind == syntax_kind::type_auto) {
		return @this.describe_type(@analyzer, @scope, *syntax.designated_type(), type);
	};

	if ((kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array) && (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array)) {
		const TypeUse* element = @this.describe_type(@analyzer, @scope, *syntax.designated_type(), *type.element());

		if (!element) {
			return nullptr;
		};

		return @this.indirect_use(type, *element);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Entity* entity = @analyzer.lookup(@scope, @*(const_cast<Syntax*>(&syntax)));

		if (entity && entity->type_use().has_value()) {
			return @this.retype_use(entity->type_use().value(), type);
		};
	};

	if ((kind != syntax_kind::type_function && kind != syntax_kind::function) || type.kind() != type_kind::function) {
		return @this.canonical_use(type);
	};

	Syntax* inputs = syntax.function_type_parameters();
	Syntax* output = syntax.function_type_result();

	if (kind == syntax_kind::function) {
		@inputs = syntax.function_parameters();
		@output = syntax.function_result();
	};

	rt::buffer<ParameterUse> parameters;
	usize index = 0;
	while (index < type.signature().parameters().size()) {
		Syntax* parameter = inputs->item(index);
		const TypeUse* element = @this.describe_type(@analyzer, @scope, *parameter->parameter_type(), *type.signature().parameters().data()[index]);

		if (!element) {
			return nullptr;
		};

		rt::optional<ParameterLabel> name;

		if (parameter->parameter_name()->kind() != syntax_kind::absent) {
			Token location = parameter->parameter_name()->token();
			@name = rt::optional<ParameterLabel>(ParameterLabel(location, location.text()));
		};

		if (!@parameters.push_back(ParameterUse($name, *element))) {
			return nullptr;
		};

		@index = index + 1;
	};

	const TypeUse* result = @this.describe_type(@analyzer, @scope, *output, *type.signature().result());

	if (!result) {
		return nullptr;
	};

	return @this.function_use(type, $parameters, *result);
};

fn SemanticUnit::describe_entity(SemanticUnit& this, Analyzer& analyzer, Entity& entity) -> bool {
	if (!entity.type() || entity.type_use().has_value() || entity.kind() == entity_kind::template_pattern) {
		return true;
	};

	Syntax* source = entity.declaration();
	const TypeUse* use = nullptr;

	if (entity.kind() == entity_kind::function) {
		rt::buffer<ParameterUse> parameters;
		usize index = 0;
		while (index < entity.parameters().size()) {
			Entity* parameter = entity.parameters().data()[index];

			if (!@this.describe_entity(@analyzer, @*parameter) || !parameter->type_use().has_value()) {
				return false;
			};

			rt::optional<ParameterLabel> name;

			if (!parameter->name().empty()) {
				@name = rt::optional<ParameterLabel>(ParameterLabel(parameter->token(), parameter->name()));
			};

			if (!@parameters.push_back(ParameterUse($name, parameter->type_use().value()))) {
				return false;
			};

			@index = index + 1;
		};

		const TypeUse* result = nullptr;

		if (source && source->kind() == syntax_kind::function) {
			Scope* signature_scope = entity.members();

			if (entity.parameters().size()) {
				@signature_scope = entity.parameters().data()[0]->resolution_scope();
			};

			@result = @this.describe_type(@analyzer, @*signature_scope, *source->function_result(), *entity.type()->signature().result());
		}
		else {
			@result = @this.canonical_use(*entity.type()->signature().result());
		};

		if (!result) {
			return false;
		};

		@use = @this.function_use(*entity.type(), $parameters, *result);
	}
	else if (!source) {
		@use = @this.canonical_use(*entity.type());
	}
	else {
		if (entity.kind() == entity_kind::alias) {
			@source = source->alias_type();
		}
		else if (entity.kind() == entity_kind::local || entity.kind() == entity_kind::global || entity.kind() == entity_kind::field) {
			@source = source->variable_type();
		}
		else if (entity.kind() == entity_kind::parameter) {
			@source = source->parameter_type();
		};

		@use = @this.describe_type(@analyzer, @*entity.resolution_scope(), *source, *entity.type());
	};

	if (!use) {
		return false;
	};

	@entity.set_type_use(*use);

	return true;
};

fn SemanticUnit::available_use(const SemanticUnit& this, const SemanticExpression& expression) -> const TypeUse* {
	if (expression.type_use().has_value()) {
		return expression.type_use().get();
	};

	Entity* binding = expression.entity();

	if (binding && binding->type_use().has_value()) {
		return &binding->type_use().value().effective();
	};

	return nullptr;
};

fn SemanticUnit::describe_expression(SemanticUnit& this, Analyzer& analyzer, Scope& scope, const Syntax& syntax, SemanticExpression& expression) -> bool {
	if (expression.type_use().has_value()) {
		return true;
	};

	semantic_kind kind = expression.kind();

	if (kind == semantic_kind::variable) {
		Entity* entity = expression.entity();
		const TypeUse* use = nullptr;
		Syntax* declaration = entity->declaration();

		if (declaration->kind() == syntax_kind::variable && declaration->variable_type()->kind() != syntax_kind::absent) {
			@use = @this.describe_type(@analyzer, @scope, *declaration->variable_type(), *entity->type());
		}
		else {
			@use = this.available_use(*expression.item(0));
		};

		if (use) {
			@entity->set_type_use(*use);
		};

		return true;
	};

	if (expression.type()->kind() == type_kind::void_type) {
		return true;
	};

	const TypeUse* use = this.available_use(expression);

	if (kind == semantic_kind::allocation && syntax.kind() == syntax_kind::allocation) {
		Syntax* allocated = syntax.allocation_type();

		if (allocated->kind() == syntax_kind::type_array) {
			@allocated = allocated->designated_type();
		};

		const TypeUse* element = @this.describe_type(@analyzer, @scope, *allocated, *expression.type()->element());

		if (element) {
			@use = @this.indirect_use(*expression.type(), *element);
		};
	}
	else if (kind == semantic_kind::construction && syntax.kind() == syntax_kind::call) {
		@use = @this.describe_type(@analyzer, @scope, *syntax.callable(), *expression.type());
	}
	else if (kind == semantic_kind::address) {
		const TypeUse* child = this.available_use(*expression.item(0));

		if (child) {
			@use = @this.indirect_use(*expression.type(), *child);
		};
	}
	else if (kind == semantic_kind::access || kind == semantic_kind::relocation || kind == semantic_kind::cast) {
		@use = this.available_use(*expression.item(0));

		if (syntax.kind() == syntax_kind::cast) {
			const Type* target = @analyzer.type(@scope, @*syntax.cast_type());

			if (!target) {
				return false;
			};

			@use = @this.describe_type(@analyzer, @scope, *syntax.cast_type(), *target);

			if (use) {
				@use = &use->effective();
			};
		};
	}
	else if (kind == semantic_kind::dereference || kind == semantic_kind::index) {
		const TypeUse* child = this.available_use(*expression.item(0));

		if (child && (child->type().kind() == type_kind::pointer || child->type().kind() == type_kind::array)) {
			@use = &child->element().effective();
		};
	}
	else if (kind == semantic_kind::binary) {
		if (expression.operation() == token_kind::op_assign || expression.operation() == token_kind::op_copy || expression.type()->kind() == type_kind::pointer) {
			@use = this.available_use(*expression.item(0));

			if (!use || use->type().kind() != expression.type()->kind()) {
				@use = this.available_use(*expression.item(1));
			};
		};
	}
	else if (kind == semantic_kind::sequence && expression.size()) {
		@use = this.available_use(*expression.item(expression.size() - 1));
	}
	else if (kind == semantic_kind::call) {
		const TypeUse* callable = this.available_use(*expression.item(0));

		if (callable && callable->type().kind() == type_kind::pointer) {
			@callable = &callable->element();
		};

		if (callable && callable->type().kind() == type_kind::function) {
			@use = &callable->callable().result().effective();
		};
	};

	if (use) {
		@use = @this.retype_use(*use, *expression.type());
	}
	else {
		@use = @this.canonical_use(*expression.type());
	};

	if (!use) {
		return false;
	};

	@expression.set_type_use(*use);

	return true;
};

fn Analyzer::resolve(Analyzer& this, Entity* entity) -> bool {
	if (!@this.resolve_impl(entity)) {
		return false;
	};

	return @this.unit->describe_entity(@this, @*entity);
};

fn Analyzer::expression(Analyzer& this, Scope& scope, Syntax& syntax, const rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	var result = @this.expression_impl(@scope, @syntax, expected);

	if (!result.get()) {
		return $result;
	};

	if (!@this.unit->describe_expression(@this, @scope, syntax, @*result.get())) {
		@this.error(&syntax, "could not describe the expression's type use\0");

		return rt::unique<SemanticExpression>();
	};

	return $result;
};

