};

fn malloc(usize size) -> void*;
fn calloc(usize count, usize size) -> void*;
fn realloc(void* memory, usize size) -> void*;
fn free(void* memory);
fn memcpy(void* destination, void* source, usize size) -> void*;
fn memset(void* destination, i32 value, usize size) -> void*;
fn memcmp(void* first, void* second, usize size) -> i32;
fn strlen(char* text) -> usize;
fn strtod(char* text, char** end) -> f64;
fn fopen(char* path, char* mode) -> void*;
fn fclose(void* file) -> i32;
fn fread(void* destination, usize size, usize count, void* file) -> usize;
fn fwrite(void* source, usize size, usize count, void* file) -> usize;
fn ferror(void* file) -> i32;
fn fputs(char* text, void* file) -> i32;
fn fprintf(void* file, char* format, ...) -> i32;
fn strcmp(char* first, char* second) -> i32;
fn platform_standard_error() -> void*;

fn memory_allocate(Compiler* compiler, usize size) -> void* {
	unique_ptr memory = unique_ptr(calloc(1, $size));
	if (!unique_ptr::get(memory)) {
		@compiler->result = COMPILATION_FAILURE;
		return nullptr;
	};

	Allocation* allocation = (Allocation*)malloc(sizeof(Allocation));
	if (!allocation) {
		@compiler->result = COMPILATION_FAILURE;
		return nullptr;
	};

	void* result = unique_ptr::release(@memory);
	@allocation->memory := result;
	@allocation->next := compiler->allocations.head;
	@compiler->allocations.head = $allocation;

	return $result;
};

fn memory_text(Compiler* compiler, char* text, usize length) -> char* {
	char* copy = (char*)memory_allocate($compiler, length + 1);
	if (!copy) {
		return nullptr;
	};

	memcpy((void*)copy, (void*)text, $length);

	return $copy;
};

fn token_is(Token token, char* text) -> i32 {
	usize length = strlen((char*)text);

	return token.source && token.length == length && !memcmp((void*)(token.source->bytes + token.begin), (void*)text, (u64)length);
};

fn token_same(Token first, Token second) -> i32 {
	return first.source && second.source && first.length == second.length && !memcmp((void*)(first.source->bytes + first.begin), (void*)(second.source->bytes + second.begin), (u64)first.length);
};

fn compiler_error(Compiler* compiler, Token token, char* message) {
	@compiler->result = COMPILATION_FAILURE;
	if (compiler->diagnostics) {
		char* path = "<compiler>\0";
		if (token.source && token.source->path) {
			@path := token.source->path;
		};
		fprintf((void*)compiler->diagnostics, "%s:%llu:%llu: error: %s\n\0", $path, (u64)token.line, (u64)token.column, (char*)message);
	};
};

fn scope_create(Compiler* compiler, Scope* parent, ContextKind context, Entity* owner) -> Scope* {
	Scope* scope = (Scope*)memory_allocate((Compiler*)compiler, sizeof(Scope));
	if (!scope) {
		return nullptr;
	};

	@scope->compiler := compiler;
	@scope->parent = $parent;
	@scope->context = $context;
	@scope->owner = $owner;
	@scope->bucket_count = 64;
	@scope->buckets = (Binding**)memory_allocate($compiler, scope->bucket_count * sizeof(Binding*));
	if (!scope->buckets) {
		return nullptr;
	};

	return $scope;
};

fn token_hash(Token token) -> usize {
	usize hash = 5381;
	usize index = 0;

	while (index < token.length) {
		@hash = hash * 33 + (usize)token.source->bytes[token.begin + index];
		@index = index + 1;
	};

	return $hash;
};

fn scope_local(Scope* scope, Token name) -> Entity* {
	Binding* binding := scope->buckets[token_hash(Token(name)) % scope->bucket_count];

	while (binding) {
		if (token_same(Token(binding->name), Token(name))) {
			return (Entity*)binding->entity;
		};
		@binding := binding->hash_next;
	};

	return nullptr;
};

fn scope_lookup(Scope* scope, Token name) -> Entity* {
	while (scope) {
		Entity* entity = scope_local((Scope*)scope, Token(name));
		if (entity) {
			return $entity;
		};
		if (scope->owner && scope->owner->kind == ENTITY_STRUCT) {
			@entity = associated_lookup((Compiler*)scope->compiler, (Entity*)scope->owner, Token(name));
			if (entity || scope->compiler->result == COMPILATION_FAILURE) {
				return $entity;
			};
		};
		RemovedBinding* removed := scope->removed;
		while (removed) {
			if (token_same(Token(removed->entity->name), Token(name))) {
				return nullptr;
			};
			@removed := removed->next;
		};
		@scope := scope->parent;
	};

	return nullptr;
};

fn scope_bind_named(Compiler* compiler, Scope* scope, Token name, Entity* entity, Scope* declaration_scope, Source* source) -> i32 {
	Binding* binding = (Binding*)memory_allocate($compiler, sizeof(Binding));
	if (!binding) {
		return 0;
	};

	usize bucket = token_hash(Token(name)) % scope->bucket_count;
	if (!entity->scope) {
		@entity->scope := scope;
	};
	@binding->name = $name;
	@binding->declaration_scope = $declaration_scope;
	@binding->source = $source;
	@binding->entity = $entity;
	@binding->hash_next := scope->buckets[bucket];
	@scope->buckets[bucket] := binding;
	if (scope->last_binding) {
		@scope->last_binding->next := binding;
	}
	else {
		@scope->bindings := binding;
	};
	@scope->last_binding = $binding;
	@scope->binding_count = scope->binding_count + 1;
	return 1;
};

fn scope_bind(Compiler* compiler, Scope* scope, Entity* entity) -> i32 {
	return scope_bind_named($compiler, (Scope*)scope, Token(entity->name), (Entity*)entity, $scope, (Source*)entity->name.source);
};

fn scope_define(Compiler* compiler, Scope* scope, Entity* entity) -> i32 {
	if (scope_local((Scope*)scope, Token(entity->name))) {
		compiler_error((Compiler*)compiler, Token(entity->name), "duplicate declaration\0");
		return 0;
	};

	return scope_bind($compiler, $scope, $entity);
};

fn scope_remove(Compiler* compiler, Scope* scope, Entity* entity) {
	while (scope) {
		usize bucket = token_hash(Token(entity->name)) % scope->bucket_count;
		Binding** link = &scope->buckets[bucket];
		while (*link) {
			Binding* binding := *link;
			if (binding->entity == entity) {
				@*link := binding->hash_next;
				RemovedBinding* removed = (RemovedBinding*)memory_allocate((Compiler*)compiler, sizeof(RemovedBinding));
				if (!removed) {
					return;
				};

				@removed->entity = (Entity*)entity;
				@removed->next := scope->removed;
				@scope->removed = $removed;
				return;
			};
			@link = &binding->hash_next;
		};
		@scope := scope->parent;
	};
};

fn scope_snapshot(Compiler* compiler, Scope* source) -> Scope* {
	if (!source || source->context == CONTEXT_MODULE) {
		return $source;
	};

	Scope* scope = scope_create((Compiler*)compiler, scope_snapshot((Compiler*)compiler, (Scope*)source->parent), (ContextKind)source->context, (Entity*)source->owner);
	if (!scope) {
		return nullptr;
	};

	@scope->removed := source->removed;
	usize bucket = 0;
	while (bucket < source->bucket_count) {
		Binding* binding := source->buckets[bucket];
		while (binding) {
			scope_bind_named((Compiler*)compiler, (Scope*)scope, Token(binding->name), (Entity*)binding->entity, (Scope*)binding->declaration_scope, (Source*)binding->source);
			@binding := binding->hash_next;
		};
		@bucket = bucket + 1;
	};

	return $scope;
};

fn scope_merge_removals(Compiler* compiler, Scope* destination, Scope* branch) {
	while (branch && branch->context != CONTEXT_MODULE) {
		RemovedBinding* removed := branch->removed;
		while (removed) {
			scope_remove((Compiler*)compiler, (Scope*)destination, (Entity*)removed->entity);
			@removed := removed->next;
		};
		@branch := branch->parent;
	};
};

fn entity_create(Compiler* compiler, EntityKind kind, Token name) -> Entity* {
	Entity* entity = (Entity*)memory_allocate($compiler, sizeof(Entity));
	if (!entity) {
		return nullptr;
	};

	@entity->kind = $kind;
	@entity->name = $name;

	return $entity;
};

fn primitive_define(Compiler* compiler, char* name, TypeKind kind, i32 bits) -> Type* {
	Source* source = (Source*)memory_allocate((Compiler*)compiler, sizeof(Source));
	if (!source) {
		return nullptr;
	};

	@source->path = "<builtins>\0";
	@source->length = strlen((char*)name);
	@source->bytes = $name;
	Token token;
	@token.kind = TOKEN_NAME;
	@token.length := source->length;
	@token.source = $source;
	Type* type = (Type*)memory_allocate((Compiler*)compiler, sizeof(Type));
	if (!type) {
		return nullptr;
	};

	if (kind == TYPE_SIGNED || kind == TYPE_UNSIGNED || kind == TYPE_FLOAT) {
		@type->data.bits = (i32)bits;
	};
	@type->kind = $kind;
	Entity* entity = entity_create((Compiler*)compiler, ENTITY_PRIMITIVE, $token);
	if (!entity) {
		return nullptr;
	};

	@entity->resolution = RESOLUTION_READY;
	@entity->data.primitive.type := type;
	scope_define((Compiler*)compiler, (Scope*)compiler->module, $entity);

	return $type;
};

fn boolean_define(Compiler* compiler, char* name, bool value) {
	Source* source = (Source*)memory_allocate((Compiler*)compiler, sizeof(Source));
	if (!source) {
		return;
	};

	@source->path = "<builtins>\0";
	@source->length = strlen((char*)name);
	@source->bytes = $name;
	Token token;
	@token.kind = TOKEN_NAME;
	@token.length := source->length;
	@token.source = $source;
	Entity* entity = entity_create((Compiler*)compiler, ENTITY_VARIABLE, $token);
	if (!entity) {
		return;
	};

	@entity->resolution = RESOLUTION_READY;
	@entity->data.variable.storage = STORAGE_CONSTANT;
	@entity->data.variable.type := compiler->bool_type;
	@entity->data.variable.data.integer = (u64)value;
	scope_define((Compiler*)compiler, (Scope*)compiler->module, $entity);
};

fn compiler_builtins(Compiler* compiler, i32 pointer_bits) {
	declaration_rule_define(&compiler->declaration_rules[0], TOKEN_FN, ENTITY_FUNCTION, CONTEXT_FUNCTION);
	declaration_rule_define(&compiler->declaration_rules[1], TOKEN_STRUCT, ENTITY_STRUCT, CONTEXT_STRUCT);
	declaration_rule_define(&compiler->declaration_rules[2], TOKEN_UNION, ENTITY_UNION, CONTEXT_UNION);
	declaration_rule_define(&compiler->declaration_rules[3], TOKEN_ENUM, ENTITY_ENUM, CONTEXT_ENUM);

	@compiler->module = scope_create((Compiler*)compiler, nullptr, CONTEXT_MODULE, nullptr);
	@compiler->void_type = primitive_define((Compiler*)compiler, "void\0", TYPE_VOID, 0);
	@compiler->null_type = primitive_define((Compiler*)compiler, "null\0", TYPE_NULL, 0);
	@compiler->bool_type = primitive_define((Compiler*)compiler, "bool\0", TYPE_BOOL, 0);
	boolean_define((Compiler*)compiler, "false\0", false);
	boolean_define((Compiler*)compiler, "true\0", true);
	@compiler->char_type = primitive_define((Compiler*)compiler, "char\0", TYPE_CHAR, 0);
	primitive_define((Compiler*)compiler, "i08\0", TYPE_SIGNED, 8);
	primitive_define((Compiler*)compiler, "i16\0", TYPE_SIGNED, 16);
	@compiler->i32_type = primitive_define((Compiler*)compiler, "i32\0", TYPE_SIGNED, 32);
	primitive_define((Compiler*)compiler, "i64\0", TYPE_SIGNED, 64);
	primitive_define((Compiler*)compiler, "u08\0", TYPE_UNSIGNED, 8);
	primitive_define((Compiler*)compiler, "u16\0", TYPE_UNSIGNED, 16);
	primitive_define((Compiler*)compiler, "u32\0", TYPE_UNSIGNED, 32);
	primitive_define((Compiler*)compiler, "u64\0", TYPE_UNSIGNED, 64);
	@compiler->usize_type = primitive_define((Compiler*)compiler, "usize\0", TYPE_UNSIGNED, $pointer_bits);
	primitive_define((Compiler*)compiler, "f32\0", TYPE_FLOAT, 32);
	primitive_define($compiler, "f64\0", TYPE_FLOAT, 64);
};

fn declaration_rule_define(DeclarationRule* rule, TokenKind keyword, EntityKind entity, ContextKind context) {
	@rule->keyword = $keyword;
	@rule->entity = $entity;
	@rule->context = $context;
};

fn declaration_rule(Compiler* compiler, TokenKind token_kind) -> DeclarationRule* {
	usize count = sizeof(compiler->declaration_rules) / sizeof(DeclarationRule);
	usize index = 0;

	while (index < count) {
		if (compiler->declaration_rules[index].keyword == token_kind) {
			return &compiler->declaration_rules[index];
		};

		@index = index + 1;
	};

	return nullptr;
};

fn declaration_entity(Compiler* compiler, Scope* scope, EntityKind kind, Token name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, Token(name));
	if (entity && entity->kind == ENTITY_NAMESPACE && (kind == ENTITY_STRUCT || kind == ENTITY_UNION)) {
		Scope* members = entity_members((Entity*)entity);
		@entity->kind := kind;
		@entity->resolution = RESOLUTION_PENDING;
		@entity->data.aggregate.type = nullptr;
		@entity->data.aggregate.scope = $members;
	};
	if (entity && entity->kind != kind) {
		compiler_error((Compiler*)compiler, Token(name), "conflicting declaration kind\0");
		return nullptr;
	};
	if (!entity) {
		@entity = entity_create((Compiler*)compiler, (EntityKind)kind, Token(name));
		if (!entity) {
			return nullptr;
		};
		scope_define((Compiler*)compiler, (Scope*)scope, (Entity*)entity);
	};
	if ((kind == ENTITY_STRUCT || kind == ENTITY_UNION) && !entity->data.aggregate.scope) {
		@entity->data.aggregate.scope = scope_create((Compiler*)compiler, (Scope*)scope, CONTEXT_MODULE, (Entity*)entity);
	};
	return $entity;
};

fn parser_bases(Parser* parser) -> BaseRelation* {
	BaseRelation* first = nullptr;
	BaseRelation* last = nullptr;
	while (true) {
		BaseRelation* base = (BaseRelation*)memory_allocate((Compiler*)parser->compiler, sizeof(BaseRelation));
		if (parser_take((Parser*)parser, TOKEN_VIRTUAL)) {
			@base->kind = BASE_VIRTUAL;
		};
		@base->name = parser_name((Parser*)parser);
		if (last) {
			@last->next := base;
		}
		else {
			@first := base;
		};
		@last = $base;
		if (!parser_take((Parser*)parser, TOKEN_COMMA)) {
			break;
		};
	};
	return $first;
};

fn namespace_define(Compiler* compiler, Scope* scope, Token name) -> Entity* {
	Entity* entity = scope_local((Scope*)scope, Token(name));
	if (entity) {
		if (entity->kind != ENTITY_NAMESPACE && entity->kind != ENTITY_STRUCT && entity->kind != ENTITY_UNION) {
			compiler_error((Compiler*)compiler, Token(name), "namespace conflicts with another declaration\0");
			return nullptr;
		};
		return $entity;
	};

	@entity = entity_create((Compiler*)compiler, ENTITY_NAMESPACE, $name);
	if (!entity) {
		return nullptr;
	};
	@entity->data.namespace_entity.scope = scope_create((Compiler*)compiler, (Scope*)scope, CONTEXT_MODULE, (Entity*)entity);
	@entity->resolution = RESOLUTION_READY;
	scope_define($compiler, $scope, (Entity*)entity);
	return $entity;
};

enum DeclarationPhase {
	DECLARATION_IDENTITIES,
	DECLARATION_MEMBERS,
};

fn scope_identity_lookup(Scope* scope, Token name) -> Entity* {
	while (scope) {
		Entity* entity = scope_local((Scope*)scope, Token(name));
		if (entity) {
			return $entity;
		};
		@scope := scope->parent;
	};
	return nullptr;
};

fn parser_predeclare_range(Parser* parser, Scope* scope, usize* position, DeclarationPhase phase) {
	while (*position + 1 < parser->count && parser->compiler->result != COMPILATION_FAILURE) {
		Token token := parser->tokens[*position];
		if (token.kind == TOKEN_RIGHT_BRACE || token.kind == TOKEN_END) {
			return;
		};
		if (token.kind == TOKEN_NAMESPACE) {
			@*position = *position + 1;
			Scope* members := scope;
			while (*position < parser->count) {
				Token name := parser->tokens[*position];
				if (name.kind != TOKEN_NAME) {
					compiler_error((Compiler*)parser->compiler, Token(name), "expected namespace identifier\0");
					return;
				};
				Entity* entity = namespace_define((Compiler*)parser->compiler, (Scope*)members, $name);
				if (!entity) {
					return;
				};
				@members = entity_members($entity);
				@*position = *position + 1;
				if (parser->tokens[*position].kind != TOKEN_SCOPE) {
					break;
				};
				@*position = *position + 1;
			};
			if (parser->tokens[*position].kind != TOKEN_LEFT_BRACE) {
				compiler_error((Compiler*)parser->compiler, Token(parser->tokens[*position]), "expected namespace body\0");
				return;
			};
			@*position = *position + 1;
			parser_predeclare_range((Parser*)parser, $members, (u64*)position, (DeclarationPhase)phase);
			@*position = *position + 1;
		}
		else {
			DeclarationRule* rule = declaration_rule((Compiler*)parser->compiler, (TokenKind)token.kind);
			Entity* declared = nullptr;
			if (rule && parser->tokens[*position + 1].kind == TOKEN_NAME) {
				usize name_position = *position + 1;
				Token name := parser->tokens[name_position];
				Scope* owner := scope;
				while (name_position + 2 < parser->count && parser->tokens[name_position + 1].kind == TOKEN_SCOPE) {
					Entity* entity = nullptr;
					if (owner) {
						if (phase == DECLARATION_MEMBERS) {
							@entity = scope_lookup((Scope*)owner, Token(name));
						}
						else {
							@entity = scope_identity_lookup((Scope*)owner, Token(name));
						};
					};
					@owner = entity_members($entity);
					@name_position = name_position + 2;
					if (rule->entity == ENTITY_FUNCTION && parser->tokens[name_position].kind == TOKEN_TILDE && name_position + 1 < parser->count) {
						@name_position = name_position + 1;
					};
					@name := parser->tokens[name_position];
				};
				if (owner) {
					i32 special = rule->entity == ENTITY_FUNCTION && owner->owner && (owner->owner->kind == ENTITY_STRUCT || owner->owner->kind == ENTITY_UNION) && (token_same(Token(name), Token(owner->owner->name)) || token_is(Token(name), "operator\0"));
					if (!special) {
						@declared = declaration_entity((Compiler*)parser->compiler, (Scope*)owner, (EntityKind)rule->entity, Token(name));
					};
					if (declared && declared->kind == ENTITY_STRUCT && !declared->data.aggregate.bases && name_position + 1 < parser->count && parser->tokens[name_position + 1].kind == TOKEN_COLON) {
						Parser inheritance;
						@inheritance.compiler := parser->compiler;
						@inheritance.scope := owner;
						@inheritance.tokens := parser->tokens;
						@inheritance.count := parser->count;
						@inheritance.offset = name_position + 2;
						@declared->data.aggregate.bases = parser_bases(&inheritance);
					};
				};
			};
			usize depth = 0;
			while (*position < parser->count) {
				TokenKind kind := parser->tokens[*position].kind;
				if (!depth && (kind == TOKEN_SEMICOLON || kind == TOKEN_END || kind == TOKEN_RIGHT_BRACE)) {
					break;
				};
				if (!depth && kind == TOKEN_LEFT_BRACE && declared && (declared->kind == ENTITY_STRUCT || declared->kind == ENTITY_UNION)) {
					@*position = *position + 1;
					parser_predeclare_range((Parser*)parser, entity_members((Entity*)declared), (u64*)position, (DeclarationPhase)phase);
					@*position = *position + 1;
					continue;
				};
				if (kind == TOKEN_LEFT_BRACE) {
					@depth = depth + 1;
				};
				if (kind == TOKEN_RIGHT_BRACE && depth) {
					@depth = depth - 1;
				};
				@*position = *position + 1;
			};
		};
		if (parser->tokens[*position].kind == TOKEN_SEMICOLON) {
			@*position = *position + 1;
		};
	};
};

fn parser_predeclare(Parser* parser, DeclarationPhase phase) {
	usize position = 0;
	parser_predeclare_range((Parser*)parser, (Scope*)parser->scope, &position, $phase);
};

fn lexer_peek(Lexer* lexer, usize distance) -> char {
	if (lexer->offset + distance >= lexer->source->length) {
		return 0;
	};
	return (char)lexer->source->bytes[lexer->offset + distance];
};



fn lexer_advance(Lexer* lexer) -> char {
	char value = lexer_peek((Lexer*)lexer, 0);
	if (!value) {
		return 0;
	};

	@lexer->offset = lexer->offset + 1;
	if (value == '\n') {
		@lexer->line = lexer->line + 1;
		@lexer->column = 1;
	}
	else {
		@lexer->column = lexer->column + 1;
	};

	return $value;
};

fn lexer_alpha(char value) -> i32 {
	return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z') || value == '_';
};

fn lexer_digit(char value) -> i32 {
	return value >= '0' && value <= '9';
};

struct Keyword {
	char* text;
	TokenKind kind;
};

fn lexer_keywords(Keyword* keywords) {
	@keywords[23].text = "nullptr\0";
	@keywords[23].kind = TOKEN_NULLPTR;
	@keywords[22].text = "delete\0";
	@keywords[22].kind = TOKEN_DELETE;
	@keywords[21].text = "discard\0";
	@keywords[21].kind = TOKEN_DISCARD;
	@keywords[20].text = "const\0";
	@keywords[20].kind = TOKEN_CONST;
	@keywords[17].text = "virtual\0";
	@keywords[17].kind = TOKEN_VIRTUAL;
	@keywords[18].text = "override\0";
	@keywords[18].kind = TOKEN_OVERRIDE;
	@keywords[19].text = "final\0";
	@keywords[19].kind = TOKEN_FINAL;
	@keywords[16].text = "namespace\0";
	@keywords[16].kind = TOKEN_NAMESPACE;
	@keywords[0].text = "fn\0";
	@keywords[0].kind = TOKEN_FN;
	@keywords[1].text = "var\0";
	@keywords[1].kind = TOKEN_VAR;
	@keywords[2].text = "struct\0";
	@keywords[2].kind = TOKEN_STRUCT;
	@keywords[3].text = "union\0";
	@keywords[3].kind = TOKEN_UNION;
	@keywords[4].text = "enum\0";
	@keywords[4].kind = TOKEN_ENUM;
	@keywords[5].text = "return\0";
	@keywords[5].kind = TOKEN_RETURN;
	@keywords[6].text = "if\0";
	@keywords[6].kind = TOKEN_IF;
	@keywords[7].text = "else\0";
	@keywords[7].kind = TOKEN_ELSE;
	@keywords[8].text = "while\0";
	@keywords[8].kind = TOKEN_WHILE;
	@keywords[9].text = "for\0";
	@keywords[9].kind = TOKEN_FOR;
	@keywords[10].text = "switch\0";
	@keywords[10].kind = TOKEN_SWITCH;
	@keywords[11].text = "case\0";
	@keywords[11].kind = TOKEN_CASE;
	@keywords[12].text = "default\0";
	@keywords[12].kind = TOKEN_DEFAULT;
	@keywords[13].text = "break\0";
	@keywords[13].kind = TOKEN_BREAK;
	@keywords[14].text = "continue\0";
	@keywords[14].kind = TOKEN_CONTINUE;
	@keywords[15].text = "sizeof\0";
	@keywords[15].kind = TOKEN_SIZEOF;
};

fn lexer_keyword(Token token, Keyword* keywords, usize count) -> TokenKind {
	usize index = 0;

	while (index < count) {
		if (token_is(Token(token), (char*)keywords[index].text)) {
			return (TokenKind)keywords[index].kind;
		};
		@index = index + 1;
	};

	return TOKEN_NAME;
};

fn lexer_operators(Keyword* operators) {
	@operators[35].text = "@\0";
	@operators[35].kind = TOKEN_ACCESS;
	@operators[36].text = "$\0";
	@operators[36].kind = TOKEN_RELOCATE;
	@operators[34].text = ":\0";
	@operators[34].kind = TOKEN_COLON;
	@operators[0].text = "...\0";
	@operators[0].kind = TOKEN_ELLIPSIS;
	@operators[1].text = "->\0";
	@operators[1].kind = TOKEN_ARROW;
	@operators[2].text = ":=\0";
	@operators[2].kind = TOKEN_COPY;
	@operators[3].text = "==\0";
	@operators[3].kind = TOKEN_EQUAL;
	@operators[4].text = "!=\0";
	@operators[4].kind = TOKEN_NOT_EQUAL;
	@operators[5].text = "<=\0";
	@operators[5].kind = TOKEN_LESS_EQUAL;
	@operators[6].text = ">=\0";
	@operators[6].kind = TOKEN_GREATER_EQUAL;
	@operators[7].text = "&&\0";
	@operators[7].kind = TOKEN_AND;
	@operators[8].text = "||\0";
	@operators[8].kind = TOKEN_OR;
	@operators[9].text = "<<\0";
	@operators[9].kind = TOKEN_SHIFT_LEFT;
	@operators[10].text = ">>\0";
	@operators[10].kind = TOKEN_SHIFT_RIGHT;
	@operators[11].text = "(\0";
	@operators[11].kind = TOKEN_LEFT_PAREN;
	@operators[12].text = ")\0";
	@operators[12].kind = TOKEN_RIGHT_PAREN;
	@operators[13].text = "[\0";
	@operators[13].kind = TOKEN_LEFT_BRACKET;
	@operators[14].text = "]\0";
	@operators[14].kind = TOKEN_RIGHT_BRACKET;
	@operators[15].text = "{\0";
	@operators[15].kind = TOKEN_LEFT_BRACE;
	@operators[16].text = "}\0";
	@operators[16].kind = TOKEN_RIGHT_BRACE;
	@operators[17].text = ";\0";
	@operators[17].kind = TOKEN_SEMICOLON;
	@operators[18].text = ",\0";
	@operators[18].kind = TOKEN_COMMA;
	@operators[19].text = "::\0";
	@operators[19].kind = TOKEN_SCOPE;
	@operators[20].text = ".\0";
	@operators[20].kind = TOKEN_DOT;
	@operators[21].text = "=\0";
	@operators[21].kind = TOKEN_ASSIGN;
	@operators[22].text = "+\0";
	@operators[22].kind = TOKEN_PLUS;
	@operators[23].text = "-\0";
	@operators[23].kind = TOKEN_MINUS;
	@operators[24].text = "*\0";
	@operators[24].kind = TOKEN_STAR;
	@operators[25].text = "/\0";
	@operators[25].kind = TOKEN_SLASH;
	@operators[26].text = "%\0";
	@operators[26].kind = TOKEN_REMAINDER;
	@operators[27].text = "&\0";
	@operators[27].kind = TOKEN_AMPERSAND;
	@operators[28].text = "|\0";
	@operators[28].kind = TOKEN_PIPE;
	@operators[29].text = "^\0";
	@operators[29].kind = TOKEN_CARET;
	@operators[30].text = "!\0";
	@operators[30].kind = TOKEN_BANG;
	@operators[31].text = "~\0";
	@operators[31].kind = TOKEN_TILDE;
	@operators[32].text = "<\0";
	@operators[32].kind = TOKEN_LESS;
	@operators[33].text = ">\0";
	@operators[33].kind = TOKEN_GREATER;
};

fn lexer_operator(Lexer* lexer, Token* token, Keyword* operators, usize count) -> i32 {
	usize index = 0;
	usize longest = 0;
	while (index < count) {
		usize length = strlen((char*)operators[index].text);
		if (length > longest && length <= lexer->source->length - token->begin && !memcmp((void*)(lexer->source->bytes + token->begin), (void*)operators[index].text, (u64)length)) {
			@longest = (u64)length;
			@token->kind := operators[index].kind;
		};
		@index = index + 1;
	};
	if (!longest) {
		return 0;
	};
	while (lexer->offset < token->begin + longest) {
		lexer_advance((Lexer*)lexer);
	};
	return 1;
};

fn tokenize(Compiler* compiler, Source* source, Token** result, usize* count) -> i32 {
	Lexer lexer {
		@lexer.source := source;
		@lexer.offset = 0;
		@lexer.line = 1;
		@lexer.column = 1;
	};
	Token* tokens = (Token*)memory_allocate((Compiler*)compiler, (source->length + 1) * sizeof(Token));
	usize used = 0;
	Keyword[24] keywords {};
	lexer_keywords(&keywords[0]);
	Keyword[37] operators {};
	lexer_operators(&operators[0]);
	usize operator_count = sizeof(operators) / sizeof(Keyword);
	while (true) {
		char value = lexer_peek(&lexer, 0);
		if (value == ' ' || value == '	' || value == '\n' || value == '\r') {
			lexer_advance(&lexer);
			continue;
		};
		if (value == '/' && lexer_peek(&lexer, 1) == '/') {
			while (lexer_peek(&lexer, 0) && lexer_peek(&lexer, 0) != '\n') {
				lexer_advance(&lexer);
			};
			continue;
		};
		Token token {
			@token.kind = TOKEN_NAME;
			@token.length = 0;
			@token.source := source;
			@token.begin := lexer.offset;
			@token.line := lexer.line;
			@token.column := lexer.column;
		};
		if (value == '/' && lexer_peek(&lexer, 1) == '*') {
			lexer_advance(&lexer);
			lexer_advance(&lexer);
			while (lexer_peek(&lexer, 0) && !(lexer_peek(&lexer, 0) == '*' && lexer_peek(&lexer, 1) == '/')) {
				lexer_advance(&lexer);
			};
			if (!lexer_peek(&lexer, 0)) {
				compiler_error((Compiler*)compiler, Token(token), "unterminated comment\0");
				return 0;
			};
			lexer_advance(&lexer);
			lexer_advance(&lexer);
			continue;
		};
		if (!value) {
			if (lexer.offset < source->length) {
				compiler_error((Compiler*)compiler, Token(token), "NUL byte in source\0");
				return 0;
			};
			@token.kind = TOKEN_END;
			@tokens[used] := token;
			@*result := tokens;
			@*count = used + 1;
			return 1;
		};
		lexer_advance(&lexer);
		if (lexer_alpha((char)value)) {
			while (lexer_alpha(lexer_peek(&lexer, 0)) || lexer_digit(lexer_peek(&lexer, 0))) {
				lexer_advance(&lexer);
			};
			@token.length = lexer.offset - token.begin;
			@token.kind = lexer_keyword(Token(token), &keywords[0], sizeof(keywords) / sizeof(Keyword));
		}
		else if (lexer_digit((char)value)) {
			@token.kind = TOKEN_NUMBER;
			while (lexer_digit(lexer_peek(&lexer, 0))) {
				lexer_advance(&lexer);
			};
			if (lexer_peek(&lexer, 0) == '.' && lexer_digit(lexer_peek(&lexer, 1))) {
				lexer_advance(&lexer);
				while (lexer_digit(lexer_peek(&lexer, 0))) {
					lexer_advance(&lexer);
				};
			};
			if (lexer_peek(&lexer, 0) == 'e' || lexer_peek(&lexer, 0) == 'E') {
				lexer_advance(&lexer);
				if (lexer_peek(&lexer, 0) == '+' || lexer_peek(&lexer, 0) == '-') {
					lexer_advance(&lexer);
				};
				if (!lexer_digit(lexer_peek(&lexer, 0))) {
					compiler_error((Compiler*)compiler, Token(token), "expected exponent digits\0");
					return 0;
				};
				while (lexer_digit(lexer_peek(&lexer, 0))) {
					lexer_advance(&lexer);
				};
			};
		}
		else if (value == '"') {
			@token.kind = TOKEN_STRING;
			while (lexer_peek(&lexer, 0) && lexer_peek(&lexer, 0) != '"') {
				if (lexer_peek(&lexer, 0) == '\n') {
					compiler_error((Compiler*)compiler, Token(token), "newline in string literal\0");
					return 0;
				};
				if (lexer_advance(&lexer) == '\\' && lexer_peek(&lexer, 0)) {
					lexer_advance(&lexer);
				};
			};
			if (!lexer_peek(&lexer, 0)) {
				compiler_error((Compiler*)compiler, Token(token), "unterminated string literal\0");
				return 0;
			};
			lexer_advance(&lexer);
		}
		else if (value == '\'') {
			@token.kind = TOKEN_NUMBER;
			char character = lexer_advance(&lexer);

			if (!character || character == '\'' || character == '\n' || character == '\r') {
				compiler_error((Compiler*)compiler, Token(token), "expected one character in literal\0");
				return 0;
			};

			if (character == '\\') {
				char escaped = lexer_advance(&lexer);

				if (!escaped || escaped == '\n' || escaped == '\r') {
					compiler_error((Compiler*)compiler, Token(token), "unterminated character escape\0");
					return 0;
				};
			};

			if (lexer_advance(&lexer) != '\'') {
				compiler_error((Compiler*)compiler, Token(token), "expected closing quote after character\0");
				return 0;
			};
		}
		else {
			if (!lexer_operator(&lexer, &token, &operators[0], (u64)operator_count)) {
				compiler_error((Compiler*)compiler, Token(token), "unknown source character\0");
				return 0;
			};
		};
		@token.length = lexer.offset - token.begin;
		@tokens[used] = $token;
		@used = used + 1;
	};
	return 0;
};

fn parser_token(Parser* parser) -> Token {
	return Token(parser->tokens[parser->offset]);
};

fn parser_at(Parser* parser, TokenKind kind) -> i32 {
	return parser_token($parser).kind == kind;
};

fn parser_take(Parser* parser, TokenKind kind) -> i32 {
	if (!parser_at((Parser*)parser, $kind)) {
		return 0;
	};

	if (parser->offset + 1 < parser->count) {
		@parser->offset = parser->offset + 1;
	};

	return 1;
};

fn parser_require(Parser* parser, TokenKind kind, char* message) -> Token {
	Token token = parser_token((Parser*)parser);

	if (!parser_take((Parser*)parser, $kind)) {
		compiler_error((Compiler*)parser->compiler, Token(token), (char*)message);
	};

	return $token;
};

fn syntax_new(Parser* parser, SyntaxKind kind, Token token) -> Syntax* {
	Syntax* syntax = (Syntax*)memory_allocate((Compiler*)parser->compiler, sizeof(Syntax));
	if (!syntax) {
		return nullptr;
	};

	@syntax->kind = $kind;
	@syntax->token = $token;

	return $syntax;
};

fn syntax_append(Syntax** first, Syntax** last, Syntax* node) {
	if (!node) {
		return;
	};

	if (*last) {
		(@*last)->next := node;
	}
	else {
		@*first := node;
	};
	@*last = $node;
};

fn parser_type(Parser* parser) -> Syntax*;
fn parser_expression(Parser* parser, i32 minimum) -> Syntax*;
fn parser_statement(Parser* parser) -> Syntax*;
fn parser_block(Parser* parser) -> Syntax*;

fn parser_signature_arrow(Parser* parser, usize offset) -> usize {
	usize depth = 0;
	while (offset < parser->count) {
		TokenKind kind := parser->tokens[offset].kind;
		if (kind == TOKEN_LEFT_PAREN) {
			@depth = depth + 1;
		};
		if (kind == TOKEN_RIGHT_PAREN) {
			@depth = depth - 1;
			if (!depth) {
				if (offset + 1 < parser->count && parser->tokens[offset + 1].kind == TOKEN_ARROW) {
					return offset + 1;
				};
				return 0;
			};
		};
		@offset = offset + 1;
	};
	return 0;
};

fn entity_members(Entity* entity) -> Scope* {
	if (entity && entity->kind == ENTITY_NAMESPACE) {
		return (Scope*)entity->data.namespace_entity.scope;
	};
	if (entity && (entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION)) {
		return (Scope*)entity->data.aggregate.scope;
	};
	if (entity && entity->kind == ENTITY_ENUM && entity->declaration && entity->declaration->data.declaration.body) {
		return (Scope*)entity->declaration->data.declaration.body->scope;
	};
	return nullptr;
};

fn aggregate_header(Entity* entity) -> bool {
	return entity->data.aggregate.virtual_types || entity->data.aggregate.virtual_callables;
};

fn virtual_type_add(Compiler* compiler, Entity* owner, Entity* target) {
	VirtualType* current := owner->data.aggregate.virtual_types;
	VirtualType* last = nullptr;
	usize index = 0;
	while (current) {
		if (current->entity == target) {
			return;
		};
		@last := current;
		@current := current->next;
		@index = index + 1;
	};
	VirtualType* type = (VirtualType*)memory_allocate($compiler, sizeof(VirtualType));
	@type->entity = $target;
	@type->index = $index;
	if (last) {
		@last->next = (VirtualType*)type;
	}
	else {
		@owner->data.aggregate.virtual_types = (VirtualType*)type;
	};
};

fn virtual_type_index(Entity* owner, Entity* target) -> usize {
	VirtualType* type := owner->data.aggregate.virtual_types;
	while (type && type->entity != target) {
		@type := type->next;
	};
	if (!type) {
		return 0;
	};
	return (u64)type->index;
};

fn bases_resolve(Compiler* compiler, Entity* record) {
	if (record->kind != ENTITY_STRUCT || record->data.aggregate.bases_resolution == RESOLUTION_READY) {
		return;
	};
	if (record->data.aggregate.bases_resolution == RESOLUTION_ACTIVE) {
		compiler_error((Compiler*)compiler, Token(record->name), "cyclic base relationship\0");
		return;
	};
	@record->data.aggregate.bases_resolution = RESOLUTION_ACTIVE;
	BaseRelation* base := record->data.aggregate.bases;
	usize component = 0;
	while (base && compiler->result != COMPILATION_FAILURE) {
		@base->entity = syntax_lookup((Scope*)record->scope, (Syntax*)base->name);
		if (!base->entity || base->entity->kind != ENTITY_STRUCT) {
			compiler_error((Compiler*)compiler, Token(base->name->token), "base relationship requires a struct entity\0");
			return;
		};
		BaseRelation* previous := record->data.aggregate.bases;
		while (previous != base) {
			if (previous->entity == base->entity) {
				compiler_error((Compiler*)compiler, Token(base->name->token), "duplicate direct base relationship\0");
				return;
			};
			@previous := previous->next;
		};
		bases_resolve((Compiler*)compiler, (Entity*)base->entity);
		if (base->kind == BASE_VIRTUAL) {
			virtual_type_add((Compiler*)compiler, (Entity*)record, (Entity*)base->entity);
		};
		VirtualType* inherited := base->entity->data.aggregate.virtual_types;
		while (inherited) {
			virtual_type_add((Compiler*)compiler, (Entity*)record, (Entity*)inherited->entity);
			@inherited := inherited->next;
		};
		@base := base->next;
	};
	if (aggregate_header((Entity*)record)) {
		@component = 1;
	};
	@base := record->data.aggregate.bases;
	while (base) {
		if (base->kind == BASE_NONVIRTUAL) {
			@base->component := component;
			@component = component + 1;
		}
		else {
			@base->component = virtual_type_index((Entity*)record, (Entity*)base->entity);
		};
		@base := base->next;
	};
	@record->data.aggregate.bases_resolution = RESOLUTION_READY;
};

fn subobject_create(Compiler* compiler, CompleteGraph* graph, Entity* entity, SubobjectKind kind) -> Subobject* {
	Subobject* object = (Subobject*)memory_allocate($compiler, sizeof(Subobject));
	@object->entity = $entity;
	@object->kind := kind;
	if (graph->last_object) {
		@graph->last_object->next := object;
	}
	else {
		@graph->objects := object;
	};
	@graph->last_object := object;
	if (kind == SUBOBJECT_VIRTUAL) {
		if (graph->last_virtual) {
			@object->component = graph->last_virtual->component + 1;
			@graph->last_virtual->virtual_next := object;
		}
		else {
			@object->component = 1;
			@graph->virtuals := object;
		};
		@graph->last_virtual := object;
	};
	return $object;
};

fn subobject_expand(Compiler* compiler, CompleteGraph* graph, Subobject* object);

fn subobject_virtual(Compiler* compiler, CompleteGraph* graph, Entity* entity) -> Subobject* {
	Subobject* object := graph->virtuals;
	while (object) {
		if (object->entity == entity) {
			return $object;
		};
		@object := object->virtual_next;
	};
	@object = subobject_create((Compiler*)compiler, (CompleteGraph*)graph, $entity, SUBOBJECT_VIRTUAL);
	subobject_expand($compiler, $graph, (Subobject*)object);
	return $object;
};

fn subobject_expand(Compiler* compiler, CompleteGraph* graph, Subobject* object) {
	BaseRelation* base := object->entity->data.aggregate.bases;
	SubobjectEdge* last = nullptr;
	while (base) {
		SubobjectEdge* edge = (SubobjectEdge*)memory_allocate((Compiler*)compiler, sizeof(SubobjectEdge));
		@edge->relation := base;
		if (base->kind == BASE_VIRTUAL) {
			@edge->target = subobject_virtual((Compiler*)compiler, (CompleteGraph*)graph, (Entity*)base->entity);
		}
		else {
			@edge->target = subobject_create((Compiler*)compiler, (CompleteGraph*)graph, (Entity*)base->entity, SUBOBJECT_NONVIRTUAL);
			subobject_expand((Compiler*)compiler, (CompleteGraph*)graph, (Subobject*)edge->target);
		};
		if (last) {
			@last->next := edge;
		}
		else {
			@object->edges := edge;
		};
		@last = $edge;
		@base := base->next;
	};
};

fn complete_graph(Compiler* compiler, Entity* entity) -> CompleteGraph* {
	if (entity->data.aggregate.complete_graph) {
		return (CompleteGraph*)entity->data.aggregate.complete_graph;
	};
	bases_resolve((Compiler*)compiler, (Entity*)entity);
	if (compiler->result == COMPILATION_FAILURE) {
		return nullptr;
	};
	CompleteGraph* graph = (CompleteGraph*)memory_allocate((Compiler*)compiler, sizeof(CompleteGraph));
	@graph->entity := entity;
	@graph->root = subobject_create((Compiler*)compiler, (CompleteGraph*)graph, (Entity*)entity, SUBOBJECT_ROOT);
	@entity->data.aggregate.complete_graph := graph;
	subobject_expand($compiler, (CompleteGraph*)graph, (Subobject*)graph->root);
	return $graph;
};

fn subobject_edge(Subobject* object, BaseRelation* relation) -> Subobject* {
	if (!object) {
		return nullptr;
	};
	SubobjectEdge* edge := object->edges;
	while (edge && edge->relation != relation) {
		@edge := edge->next;
	};
	if (!edge) {
		return nullptr;
	};
	return (Subobject*)edge->target;
};

fn subobject_path(Subobject* object, BasePath* path) -> Subobject* {
	while (path && object) {
		@object = subobject_edge((Subobject*)object, (BaseRelation*)path->relation);
		@path := path->next;
	};
	return $object;
};

struct SubobjectVisit {
	Subobject* object;
	SubobjectVisit* next;
};

fn base_paths_graph(Compiler* compiler, Subobject* object, Entity* target, BasePath* prefix, SubobjectVisit** visited, BaseSearch* result) {
	SubobjectVisit* previous := *visited;
	while (previous) {
		if (previous->object == object) {
			return;
		};
		@previous := previous->next;
	};
	SubobjectVisit* current = (SubobjectVisit*)memory_allocate((Compiler*)compiler, sizeof(SubobjectVisit));
	@current->object := object;
	@current->next := *visited;
	@*visited = $current;
	if (object->entity == target) {
		if (!result->count) {
			@result->path := prefix;
		};
		@result->count = result->count + 1;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* path = (BasePath*)memory_allocate((Compiler*)compiler, sizeof(BasePath));
		@path->relation := edge->relation;
		if (prefix) {
			BasePath* first = (BasePath*)memory_allocate((Compiler*)compiler, sizeof(BasePath));
			@*first := *prefix;
			BasePath* last := first;
			BasePath* next := prefix->next;
			while (next) {
				BasePath* copy = (BasePath*)memory_allocate((Compiler*)compiler, sizeof(BasePath));
				@*copy := *next;
				@last->next := copy;
				@last = $copy;
				@next := next->next;
			};
			@last->next := path;
			@path = $first;
		};
		base_paths_graph((Compiler*)compiler, (Subobject*)edge->target, (Entity*)target, $path, (SubobjectVisit**)visited, (BaseSearch*)result);
		@edge := edge->next;
	};
};

fn subobject_find_path(Compiler* compiler, Subobject* object, Subobject* target, BasePath** result) -> bool {
	if (object == target) {
		return true;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		BasePath* tail = nullptr;
		if (subobject_find_path((Compiler*)compiler, (Subobject*)edge->target, (Subobject*)target, &tail)) {
			BasePath* path = (BasePath*)memory_allocate((Compiler*)compiler, sizeof(BasePath));
			@path->relation := edge->relation;
			@path->next = (BasePath*)tail;
			@*result = $path;
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn base_path_virtual(BasePath* path) -> bool {
	while (path) {
		if (path->relation->kind == BASE_VIRTUAL) {
			return true;
		};
		@path := path->next;
	};
	return false;
};

enum MemberLookupKind {
	MEMBER_NONE,
	MEMBER_FOUND,
	MEMBER_AMBIGUOUS,
};

struct LookupObject {
	Subobject* object;
	LookupObject* next;
};

struct MemberLookup {
	MemberLookupKind kind;
	Entity* entity;
	LookupObject* objects;
};

fn subobject_contains(Subobject* derived, Subobject* base) -> bool {
	if (derived == base) {
		return true;
	};
	SubobjectEdge* edge := derived->edges;
	while (edge) {
		if (subobject_contains((Subobject*)edge->target, (Subobject*)base)) {
			return true;
		};
		@edge := edge->next;
	};
	return false;
};

fn lookup_dominates(LookupObject* derived, LookupObject* bases) -> bool {
	while (bases) {
		LookupObject* candidate := derived;
		while (candidate && !subobject_contains((Subobject*)candidate->object, (Subobject*)bases->object)) {
			@candidate := candidate->next;
		};
		if (!candidate) {
			return false;
		};
		@bases := bases->next;
	};
	return true;
};

fn lookup_objects_merge(Compiler* compiler, LookupObject** destination, LookupObject* source) {
	while (source) {
		LookupObject* existing := *destination;
		while (existing && existing->object != source->object) {
			@existing := existing->next;
		};
		if (!existing) {
			LookupObject* entry = (LookupObject*)memory_allocate((Compiler*)compiler, sizeof(LookupObject));
			@entry->object := source->object;
			@entry->next := *destination;
			@*destination = $entry;
		};
		@source := source->next;
	};
};

fn member_find_object(Compiler* compiler, Subobject* object, Token name) -> MemberLookup {
	MemberLookup result;
	@result.entity = scope_local(entity_members((Entity*)object->entity), Token(name));
	if (result.entity) {
		@result.kind = MEMBER_FOUND;
		@result.objects = (LookupObject*)memory_allocate((Compiler*)compiler, sizeof(LookupObject));
		@result.objects->object := object;
		return $result;
	};
	SubobjectEdge* edge := object->edges;
	while (edge) {
		MemberLookup inherited = member_find_object((Compiler*)compiler, (Subobject*)edge->target, Token(name));
		if (inherited.kind == MEMBER_NONE) {
			@edge := edge->next;
			continue;
		};
		if (result.kind == MEMBER_NONE || lookup_dominates((LookupObject*)inherited.objects, (LookupObject*)result.objects)) {
			@result = MemberLookup(inherited);
		}
		else if (!lookup_dominates((LookupObject*)result.objects, (LookupObject*)inherited.objects)) {
			if (inherited.kind != MEMBER_FOUND || result.kind != MEMBER_FOUND || inherited.entity != result.entity) {
				@result.kind = MEMBER_AMBIGUOUS;
				@result.entity = nullptr;
			};
			lookup_objects_merge((Compiler*)compiler, &result.objects, (LookupObject*)inherited.objects);
		};
		@edge := edge->next;
	};
	return $result;
};

fn member_find(Compiler* compiler, Entity* owner, Token name) -> MemberLookup {
	if (owner->kind == ENTITY_STRUCT) {
		CompleteGraph* graph = complete_graph((Compiler*)compiler, (Entity*)owner);
		if (graph) {
			return member_find_object($compiler, (Subobject*)graph->root, Token(name));
		};
	};
	MemberLookup result;
	@result.entity = scope_local(entity_members($owner), $name);
	if (result.entity) {
		@result.kind = MEMBER_FOUND;
	};
	return $result;
};

fn associated_lookup(Compiler* compiler, Entity* owner, Token name) -> Entity* {
	MemberLookup result = member_find((Compiler*)compiler, $owner, Token(name));
	if (result.kind == MEMBER_AMBIGUOUS) {
		compiler_error((Compiler*)compiler, Token(name), "ambiguous inherited declaration\0");
		return nullptr;
	};
	return (Entity*)result.entity;
};

fn base_paths(Compiler* compiler, Entity* source, Entity* target, BaseSearch* result) {
	if (source == target) {
		@result->count = result->count + 1;
		return;
	};
	if (source->kind != ENTITY_STRUCT || target->kind != ENTITY_STRUCT) {
		return;
	};
	CompleteGraph* graph = complete_graph((Compiler*)compiler, $source);
	if (!graph) {
		return;
	};
	SubobjectVisit* visited = nullptr;
	base_paths_graph($compiler, (Subobject*)graph->root, $target, nullptr, &visited, $result);
};

fn base_search(Compiler* compiler, Type* source, Type* target) -> BaseSearch {
	BaseSearch result;
	if (source && target && source->kind == TYPE_NAMED && target->kind == TYPE_NAMED) {
		base_paths((Compiler*)compiler, (Entity*)source->data.entity, (Entity*)target->data.entity, &result);
	};
	return $result;
};

fn syntax_lookup(Scope* scope, Syntax* syntax) -> Entity* {
	if (!syntax->data.expression) {
		return scope_lookup((Scope*)scope, Token(syntax->token));
	};
	Scope* members = entity_members(syntax_lookup((Scope*)scope, (Syntax*)syntax->data.expression));
	if (!members) {
		return nullptr;
	};
	return associated_lookup((Compiler*)scope->compiler, (Entity*)members->owner, Token(syntax->token));
};

fn parser_name(Parser* parser) -> Syntax* {
	Token token = parser_require((Parser*)parser, TOKEN_NAME, "expected identifier\0");
	Syntax* name = syntax_new((Parser*)parser, SYNTAX_NAME, $token);
	while (parser_take((Parser*)parser, TOKEN_SCOPE)) {
		Token member = parser_require((Parser*)parser, TOKEN_NAME, "expected qualified identifier\0");
		Syntax* qualified = syntax_new((Parser*)parser, SYNTAX_NAME, $member);
		@qualified->data.expression := name;
		@name = $qualified;
	};
	return $name;
};

fn parser_type_end(Parser* parser, usize offset) -> usize {
	if (offset >= parser->count) {
		return 0;
	};
	TokenKind kind := parser->tokens[offset].kind;
	if (kind == TOKEN_CONST) {
		return parser_type_end((Parser*)parser, offset + 1);
	};
	if (kind == TOKEN_NAME) {
		Entity* entity = scope_lookup((Scope*)parser->scope, Token(parser->tokens[offset]));
		@offset = offset + 1;
		while (entity && offset + 1 < parser->count && parser->tokens[offset].kind == TOKEN_SCOPE && parser->tokens[offset + 1].kind == TOKEN_NAME) {
			Scope* members = entity_members((Entity*)entity);
			if (!members) {
				return 0;
			};
			@entity = associated_lookup((Compiler*)parser->compiler, (Entity*)members->owner, Token(parser->tokens[offset + 1]));
			@offset = offset + 2;
		};
		if (!entity) {
			return 0;
		};
		if (entity->kind == ENTITY_PRIMITIVE || entity->kind == ENTITY_STRUCT || entity->kind == ENTITY_UNION || entity->kind == ENTITY_ENUM) {
			return parser_type_suffix_end((Parser*)parser, (u64)offset);
		};
		return 0;
	};
	if (kind != TOKEN_LEFT_PAREN) {
		return 0;
	};

	usize arrow = parser_signature_arrow((Parser*)parser, (u64)offset);
	if (!arrow) {
		usize end = parser_type_end((Parser*)parser, offset + 1);
		if (!end || end >= parser->count || parser->tokens[end].kind != TOKEN_RIGHT_PAREN) {
			return 0;
		};
		return parser_type_suffix_end((Parser*)parser, end + 1);
	};

	@offset = offset + 1;
	while (offset < arrow - 1) {
		if (parser->tokens[offset].kind == TOKEN_ELLIPSIS) {
			@offset = offset + 1;
			break;
		};
		@offset = parser_type_end((Parser*)parser, (u64)offset);
		if (!offset || offset >= parser->count) {
			return 0;
		};
		if (parser->tokens[offset].kind == TOKEN_NAME) {
			@offset = offset + 1;
		};
		if (offset == arrow - 1) {
			break;
		};
		if (offset >= parser->count || parser->tokens[offset].kind != TOKEN_COMMA) {
			return 0;
		};
		@offset = offset + 1;
	};
	if (offset != arrow - 1) {
		return 0;
	};
	return parser_type_end($parser, arrow + 1);
};

fn parser_type_suffix_end(Parser* parser, usize offset) -> usize {
	while (offset < parser->count) {
		TokenKind kind := parser->tokens[offset].kind;
		if (kind == TOKEN_STAR || kind == TOKEN_AMPERSAND) {
			@offset = offset + 1;
			continue;
		};

		if (kind != TOKEN_LEFT_BRACKET) {
			break;
		};
		if (offset + 2 >= parser->count || parser->tokens[offset + 1].kind != TOKEN_NUMBER || parser->tokens[offset + 2].kind != TOKEN_RIGHT_BRACKET) {
			return 0;
		};

		@offset = offset + 3;
	};
	return $offset;
};

fn parser_signature(Parser* parser, Token token) -> Syntax* {
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_SIGNATURE, $token);
	ParameterSyntax* last = nullptr;
	parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' in signature\0");
	while (!parser_at((Parser*)parser, TOKEN_RIGHT_PAREN) && !parser_at((Parser*)parser, TOKEN_END) && parser->compiler->result != COMPILATION_FAILURE) {
		if (parser_take((Parser*)parser, TOKEN_ELLIPSIS)) {
			@node->data.signature.arity = PARAMETERS_VARIADIC;
			break;
		};
		ParameterSyntax* parameter = (ParameterSyntax*)memory_allocate((Compiler*)parser->compiler, sizeof(ParameterSyntax));
		@parameter->type = parser_type((Parser*)parser);
		if (parser_at((Parser*)parser, TOKEN_NAME)) {
			@parameter->name = parser_require((Parser*)parser, TOKEN_NAME, "expected parameter name\0");
		};
		if (last) {
			@last->next := parameter;
		}
		else {
			@node->data.signature.parameters := parameter;
		};
		@last = $parameter;
		if (!parser_take((Parser*)parser, TOKEN_COMMA)) {
			break;
		};
	};
	parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after signature\0");
	if (parser_take((Parser*)parser, TOKEN_ARROW)) {
		@node->data.signature.result = parser_type((Parser*)parser);
	};
	return $node;
};

fn parser_type(Parser* parser) -> Syntax* {
	Token token = parser_token((Parser*)parser);
	i32 constant = parser_take((Parser*)parser, TOKEN_CONST);
	Syntax* node;
	if (parser_at((Parser*)parser, TOKEN_LEFT_PAREN)) {
		if (parser_signature_arrow((Parser*)parser, (u64)parser->offset)) {
			return parser_signature((Parser*)parser, Token(token));
		};

		parser_take((Parser*)parser, TOKEN_LEFT_PAREN);
		@node = parser_type((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after grouped type\0");
	}
	else {
		@node = parser_name((Parser*)parser);
	};
	if (constant) {
		Syntax* qualified = syntax_new((Parser*)parser, SYNTAX_CONST, Token(token));
		@qualified->data.expression := node;
		@node = $qualified;
	};

	while (true) {
		Token modifier = parser_token((Parser*)parser);
		if (parser_take((Parser*)parser, TOKEN_STAR) || parser_take((Parser*)parser, TOKEN_AMPERSAND)) {
			SyntaxKind kind = SYNTAX_POINTER;
			if (modifier.kind == TOKEN_AMPERSAND) {
				@kind = SYNTAX_REFERENCE;
			};

			Syntax* modified = syntax_new((Parser*)parser, $kind, Token(modifier));
			@modified->data.expression := node;
			@node = $modified;
			continue;
		};

		if (!parser_take((Parser*)parser, TOKEN_LEFT_BRACKET)) {
			break;
		};

		Syntax* modified = syntax_new((Parser*)parser, SYNTAX_ARRAY, $modifier);
		@modified->data.array.count = parser_require((Parser*)parser, TOKEN_NUMBER, "array requires an explicit length\0");
		parser_require((Parser*)parser, TOKEN_RIGHT_BRACKET, "expected ']' after array length\0");
		@modified->data.array.element := node;
		@node = $modified;
	};
	return $node;
};

fn literal_escape(Compiler* compiler, Token token, char value) -> char {
	switch (value) {
		case '0':
			return '\0';

		case 'n':
			return '\n';

		case 'r':
			return '\r';

		case 't':
			return '	';

		case '\\':
		case '"':
		case '\'':
			return $value;

		default:
			compiler_error((Compiler*)compiler, Token(token), "unsupported literal escape\0");
			return '\0';
	};
};

fn parser_string(Parser* parser, Token token) -> Syntax* {
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_STRING, Token(token));
	@node->data.string.bytes = (char*)memory_allocate((Compiler*)parser->compiler, (u64)token.length);
	usize index = 1;
	usize length = 0;

	while (index + 1 < token.length) {
		char value := token.source->bytes[token.begin + index];
		@index = index + 1;

		if (value == '\\') {
			@value = literal_escape((Compiler*)parser->compiler, Token(token), (char)token.source->bytes[token.begin + index]);
			@index = index + 1;
		};

		@node->data.string.bytes[length] = $value;
		@length = length + 1;
	};

	@node->data.string.length = $length;
	return $node;
};

fn parser_precedence(TokenKind operation) -> i32 {
	switch (operation) {
		case TOKEN_ASSIGN:
			return 1;
		case TOKEN_COPY:
			return 1;
		case TOKEN_OR:
			return 2;
		case TOKEN_AND:
			return 3;
		case TOKEN_PIPE:
			return 4;
		case TOKEN_CARET:
			return 5;
		case TOKEN_AMPERSAND:
			return 6;
		case TOKEN_EQUAL:
			return 7;
		case TOKEN_NOT_EQUAL:
			return 7;
		case TOKEN_LESS:
			return 8;
		case TOKEN_GREATER:
			return 8;
		case TOKEN_LESS_EQUAL:
			return 8;
		case TOKEN_GREATER_EQUAL:
			return 8;
		case TOKEN_SHIFT_LEFT:
			return 9;
		case TOKEN_SHIFT_RIGHT:
			return 9;
		case TOKEN_PLUS:
			return 10;
		case TOKEN_MINUS:
			return 10;
		case TOKEN_STAR:
			return 11;
		case TOKEN_SLASH:
			return 11;
		case TOKEN_REMAINDER:
			return 11;
		default:
			return 0;
	};
};

fn parser_primary(Parser* parser) -> Syntax* {
	Token token = parser_token((Parser*)parser);
	if (parser_at((Parser*)parser, TOKEN_NAME)) {
		return parser_name((Parser*)parser);
	};
	if (parser_take((Parser*)parser, TOKEN_NULLPTR)) {
		return syntax_new($parser, SYNTAX_NULLPTR, $token);
	};
	if (parser_take((Parser*)parser, TOKEN_NUMBER)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_NUMBER, Token(token));
		@node->entity = entity_create((Compiler*)parser->compiler, ENTITY_NUMBER, Token(token));
		@node->entity->data.number.spelling := token;
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_STRING)) {
		return parser_string((Parser*)parser, Token(token));
	};
	if (parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
		return parser_block((Parser*)parser);
	};
	if (parser_take((Parser*)parser, TOKEN_LEFT_PAREN)) {
		Syntax* node = parser_expression((Parser*)parser, 1);
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after expression\0");
		return $node;
	};
	compiler_error((Compiler*)parser->compiler, Token(token), "expected expression\0");
	return syntax_new($parser, SYNTAX_NUMBER, $token);
};

fn parser_type_at(Parser* parser, usize offset) -> i32 {
	return !!parser_type_end($parser, $offset);
};

fn parser_unary(Parser* parser) -> Syntax* {
	Token token = parser_token((Parser*)parser);
	if (parser_take((Parser*)parser, TOKEN_DISCARD)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_DISCARD, Token(token));
		@node->data.expression = parser_name((Parser*)parser);
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_ACCESS) || parser_take((Parser*)parser, TOKEN_RELOCATE)) {
		SyntaxKind kind = SYNTAX_ACCESS;
		if (token.kind == TOKEN_RELOCATE) {
			@kind = SYNTAX_RELOCATE;
		};
		Syntax* node = syntax_new((Parser*)parser, $kind, Token(token));
		@node->data.expression = parser_unary((Parser*)parser);
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_SIZEOF)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_SIZEOF, Token(token));
		parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' after sizeof\0");
		if (parser_type_at((Parser*)parser, (u64)parser->offset)) {
			@node->data.expression = parser_type((Parser*)parser);
		}
		else {
			@node->data.expression = parser_expression((Parser*)parser, 1);
		};
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after sizeof operand\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_PLUS) || parser_take((Parser*)parser, TOKEN_MINUS) || parser_take((Parser*)parser, TOKEN_BANG) || parser_take((Parser*)parser, TOKEN_TILDE) || parser_take((Parser*)parser, TOKEN_STAR) || parser_take((Parser*)parser, TOKEN_AMPERSAND)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_UNARY, Token(token));
		@node->data.unary.operation := token.kind;
		@node->data.unary.value = parser_unary((Parser*)parser);
		return $node;
	};
	usize cast_end = 0;
	if (parser_at((Parser*)parser, TOKEN_LEFT_PAREN)) {
		@cast_end = parser_type_end((Parser*)parser, parser->offset + 1);
	};
	if (cast_end && cast_end < parser->count && parser->tokens[cast_end].kind == TOKEN_RIGHT_PAREN) {
		parser_take((Parser*)parser, TOKEN_LEFT_PAREN);
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_CAST, Token(token));
		@node->data.cast.type = parser_type((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after cast type\0");
		@node->data.cast.value = parser_unary((Parser*)parser);
		return $node;
	};
	Syntax* value = parser_primary((Parser*)parser);
	while (parser->compiler->result != COMPILATION_FAILURE) {
		Token operation = parser_token((Parser*)parser);
		if (parser_take((Parser*)parser, TOKEN_LEFT_PAREN)) {
			Syntax* call = syntax_new((Parser*)parser, SYNTAX_CALL, Token(operation));
			@call->data.call.callable := value;
			Syntax* last = nullptr;
			while (!parser_at((Parser*)parser, TOKEN_RIGHT_PAREN) && !parser_at((Parser*)parser, TOKEN_END) && parser->compiler->result != COMPILATION_FAILURE) {
				Syntax* argument = parser_expression((Parser*)parser, 1);
				syntax_append(&call->data.call.arguments, &last, $argument);
				if (!parser_take((Parser*)parser, TOKEN_COMMA)) {
					break;
				};
			};
			parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after arguments\0");
			@value = $call;
		}
		else if (parser_take((Parser*)parser, TOKEN_LEFT_BRACKET)) {
			Syntax* index = syntax_new((Parser*)parser, SYNTAX_INDEX, Token(operation));
			@index->data.binary.left := value;
			@index->data.binary.right = parser_expression((Parser*)parser, 1);
			parser_require((Parser*)parser, TOKEN_RIGHT_BRACKET, "expected ']' after index\0");
			@value = $index;
		}
		else if (parser_take((Parser*)parser, TOKEN_DOT) || parser_take((Parser*)parser, TOKEN_ARROW)) {
			Syntax* member = syntax_new((Parser*)parser, SYNTAX_MEMBER, Token(operation));
			@member->data.member.object := value;
			Syntax* path = parser_name((Parser*)parser);
			@member->data.member.name := path->token;
			@member->data.member.qualifier := path->data.expression;
			@value = $member;
		}
		else {
			break;
		};
	};
	return $value;
};

fn parser_expression(Parser* parser, i32 minimum) -> Syntax* {
	Syntax* left = parser_unary((Parser*)parser);
	while (parser->compiler->result != COMPILATION_FAILURE) {
		Token operation = parser_token((Parser*)parser);
		i32 precedence = parser_precedence((TokenKind)operation.kind);
		if (precedence < minimum) {
			break;
		};
		parser_take((Parser*)parser, (TokenKind)operation.kind);
		i32 next = precedence + 1;
		if (operation.kind == TOKEN_ASSIGN || operation.kind == TOKEN_COPY) {
			@next = (i32)precedence;
		};
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_BINARY, Token(operation));
		@node->data.binary.operation := operation.kind;
		@node->data.binary.left := left;
		@node->data.binary.right = parser_expression((Parser*)parser, $next);
		@left = $node;
	};
	return $left;
};

fn parser_variable(Parser* parser) -> Syntax* {
	Token token = parser_token((Parser*)parser);
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_DECLARATION, $token);
	if (!parser_take((Parser*)parser, TOKEN_VAR)) {
		@node->data.declaration.type = parser_type((Parser*)parser);
	};
	@node->data.declaration.name = parser_require((Parser*)parser, TOKEN_NAME, "expected declaration identifier\0");
	@node->entity = entity_create((Compiler*)parser->compiler, ENTITY_VARIABLE, Token(node->data.declaration.name));
	@node->entity->declaration := node;
	if (parser->scope->context == CONTEXT_STRUCT || parser->scope->context == CONTEXT_UNION) {
		@node->entity->data.variable.storage = STORAGE_FIELD;
	};
	if (parser->scope->context == CONTEXT_MODULE || parser->scope->context == CONTEXT_STRUCT || parser->scope->context == CONTEXT_UNION) {
		scope_define((Compiler*)parser->compiler, (Scope*)parser->scope, (Entity*)node->entity);
	}
	else {
		scope_bind((Compiler*)parser->compiler, (Scope*)parser->scope, (Entity*)node->entity);
	};
	if (parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
		@node->data.declaration.body = parser_block((Parser*)parser);
		@node->data.declaration.body->scope->context = CONTEXT_INITIALIZATION;
		@node->data.declaration.body->scope->owner := node->entity;
	};
	if (parser_at((Parser*)parser, TOKEN_COPY) || parser_at((Parser*)parser, TOKEN_ASSIGN)) {
		Token operation = parser_token((Parser*)parser);
		parser_take((Parser*)parser, (TokenKind)operation.kind);
		Syntax* block = syntax_new((Parser*)parser, SYNTAX_BLOCK, Token(operation));
		@block->scope = scope_create((Compiler*)parser->compiler, (Scope*)parser->scope, CONTEXT_INITIALIZATION, (Entity*)node->entity);
		Syntax* assignment = syntax_new((Parser*)parser, SYNTAX_INITIALIZE, Token(operation));
		@assignment->data.binary.access = DECLARATION_ACCESS;
		@assignment->data.binary.operation := operation.kind;
		@assignment->data.binary.left = syntax_new((Parser*)parser, SYNTAX_NAME, Token(node->data.declaration.name));
		@assignment->data.binary.left->entity := node->entity;
		@assignment->data.binary.right = parser_expression((Parser*)parser, 1);
		@block->data.statements = $assignment;
		@node->data.declaration.body = $block;
	};
	parser_require($parser, TOKEN_SEMICOLON, "expected ';' after variable declaration\0");
	return $node;
};

fn parser_declaration_start(Parser* parser) -> i32 {
	if (parser_at((Parser*)parser, TOKEN_VAR)) {
		return 1;
	};

	usize end = parser_type_end((Parser*)parser, (u64)parser->offset);
	if (end && parser_at((Parser*)parser, TOKEN_LEFT_PAREN) && parser->tokens[end - 1].kind == TOKEN_RIGHT_PAREN) {
		return 0;
	};
	return end && end < parser->count && parser->tokens[end].kind == TOKEN_NAME;
};

fn parser_enum_block(Parser* parser) -> Syntax* {
	Token token = parser_require((Parser*)parser, TOKEN_LEFT_BRACE, "expected '{' after enum name\0");
	Syntax* block = syntax_new((Parser*)parser, SYNTAX_BLOCK, $token);
	@block->scope := parser->scope;
	Syntax* last = nullptr;
	while (!parser_at((Parser*)parser, TOKEN_RIGHT_BRACE) && !parser_at((Parser*)parser, TOKEN_END) && parser->compiler->result != COMPILATION_FAILURE) {
		Token name = parser_require((Parser*)parser, TOKEN_NAME, "expected enum member identifier\0");
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_DECLARATION, Token(name));
		@node->entity = entity_create((Compiler*)parser->compiler, ENTITY_VARIABLE, Token(name));
		@node->data.declaration.name = $name;
		@node->entity->data.variable.storage = STORAGE_CONSTANT;
		@node->entity->declaration := node;
		scope_define((Compiler*)parser->compiler, (Scope*)parser->scope, (Entity*)node->entity);
		scope_define((Compiler*)parser->compiler, (Scope*)parser->scope->parent, (Entity*)node->entity);
		if (parser_take((Parser*)parser, TOKEN_ASSIGN)) {
			@node->data.declaration.body = parser_expression((Parser*)parser, 2);
		};
		syntax_append(&block->data.statements, &last, $node);
		if (!parser_take((Parser*)parser, TOKEN_COMMA)) {
			break;
		};
	};
	parser_require($parser, TOKEN_RIGHT_BRACE, "expected '}' after enum members\0");
	return $block;
};

fn token_synthetic(Compiler* compiler, Token location, char* spelling) -> Token {
	Source* source = (Source*)memory_allocate($compiler, sizeof(Source));
	if (!source) {
		return $location;
	};
	@source->path := location.source->path;
	@source->length = strlen((char*)spelling);
	@source->bytes = $spelling;
	@location.source = $source;
	@location.begin = 0;
	@location.length := location.source->length;
	@location.kind = TOKEN_NAME;
	return $location;
};

fn parser_receiver(Parser* parser, Syntax* signature, Entity* owner) {
	ParameterSyntax* first := signature->data.signature.parameters;
	if (first && token_is(Token(first->name), "this\0")) {
		return;
	};
	compiler_error((Compiler*)parser->compiler, Token(signature->token), "instance function requires an explicit 'this' reference parameter\0");
};

fn special_functions(Entity* owner, FunctionRole role) -> Entity** {
	if (role == CONSTRUCTOR_ROLE) {
		return &owner->data.aggregate.constructors;
	};
	if (role == ASSIGNMENT_ROLE) {
		return &owner->data.aggregate.assignments;
	};
	return &owner->data.aggregate.destructor;
};

fn parser_special_register(Parser* parser, Scope* owner, Syntax* declaration) {
	Entity* function := declaration->entity;
	FunctionRole role := function->data.function.role;
	Type* signature = type_resolve((Compiler*)parser->compiler, (Scope*)owner, (Syntax*)declaration->data.declaration.type);
	Entity** tail = special_functions((Entity*)owner->owner, (FunctionRole)role);
	usize index = 0;
	while (*tail) {
		Entity* existing := *tail;
		Type* other = type_resolve((Compiler*)parser->compiler, (Scope*)owner, (Syntax*)existing->declaration->data.declaration.type);
		if (type_equal((Type*)signature, $other)) {
			if (declaration->data.declaration.definition != FUNCTION_DECLARATION && existing->declaration->data.declaration.definition != FUNCTION_DECLARATION) {
				compiler_error((Compiler*)parser->compiler, Token(declaration->token), "duplicate special function definition\0");
				return;
			};
			@declaration->entity := existing;
			if (declaration->data.declaration.definition != FUNCTION_DECLARATION) {
				@existing->declaration := declaration;
				if (declaration->data.declaration.body) {
					@declaration->data.declaration.body->scope->owner := existing;
				};
			};
			return;
		};
		@index = index + 1;
		@tail = &existing->data.function.overload_next;
	};
	if (role == DESTRUCTOR_ROLE && index) {
		compiler_error((Compiler*)parser->compiler, Token(declaration->token), "a type has exactly one destructor signature\0");
		return;
	};
	@function->data.function.overload_index = $index;
	@*tail := function;
	Token alias = token_synthetic((Compiler*)parser->compiler, Token(function->name), "<special-function>\0");
	scope_bind_named((Compiler*)parser->compiler, (Scope*)owner, $alias, $function, $owner, (Source*)declaration->token.source);
};

fn parser_block_scope(Parser* parser, Scope* scope) -> Syntax* {
	Token token = parser_require((Parser*)parser, TOKEN_LEFT_BRACE, "expected '{'\0");
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_BLOCK, $token);
	Scope* outer := parser->scope;
	@node->scope := scope;
	@parser->scope = $scope;
	Syntax* last = nullptr;
	while (!parser_at((Parser*)parser, TOKEN_RIGHT_BRACE) && !parser_at((Parser*)parser, TOKEN_END) && parser->compiler->result != COMPILATION_FAILURE) {
		Syntax* statement = parser_statement((Parser*)parser);
		syntax_append(&node->data.statements, &last, $statement);
	};
	parser_require((Parser*)parser, TOKEN_RIGHT_BRACE, "expected '}' after block\0");
	@parser->scope = $outer;
	return $node;
};

fn parser_function_name(Parser* parser, FunctionRole* role) -> Syntax* {
	if (parser_take((Parser*)parser, TOKEN_TILDE)) {
		@*role = DESTRUCTOR_ROLE;
	};
	Token token = parser_require((Parser*)parser, TOKEN_NAME, "expected function identifier\0");
	Syntax* name = syntax_new((Parser*)parser, SYNTAX_NAME, $token);
	while (parser_take((Parser*)parser, TOKEN_SCOPE)) {
		if (*role == DESTRUCTOR_ROLE) {
			compiler_error((Compiler*)parser->compiler, Token(name->token), "destructor name must be the final qualified component\0");
			return $name;
		};
		if (parser_take((Parser*)parser, TOKEN_TILDE)) {
			@*role = DESTRUCTOR_ROLE;
		};
		Token member = parser_require((Parser*)parser, TOKEN_NAME, "expected qualified function identifier\0");
		Syntax* qualified = syntax_new((Parser*)parser, SYNTAX_NAME, $member);
		@qualified->data.expression := name;
		@name = $qualified;
	};
	return $name;
};

fn parser_named_declaration(Parser* parser, DeclarationRule* rule) -> Syntax* {
	Token token = parser_token((Parser*)parser);
	parser_take((Parser*)parser, (TokenKind)token.kind);
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_DECLARATION, Token(token));
	FunctionRole role = ORDINARY_ROLE;
	if (token.kind == TOKEN_FN) {
		@node->data.declaration.path = parser_function_name((Parser*)parser, &role);
	}
	else {
		@node->data.declaration.path = parser_name((Parser*)parser);
	};
	@node->data.declaration.name := node->data.declaration.path->token;
	Scope* owner := parser->scope;
	if (node->data.declaration.path->data.expression) {
		@owner = entity_members(syntax_lookup((Scope*)parser->scope, (Syntax*)node->data.declaration.path->data.expression));
		if (!owner) {
			compiler_error((Compiler*)parser->compiler, Token(node->data.declaration.name), "qualified declaration owner has no associated scope\0");
			return $node;
		};
	};
	Entity* aggregate := owner->owner;
	if (token.kind == TOKEN_FN && role != DESTRUCTOR_ROLE && aggregate && (aggregate->kind == ENTITY_STRUCT || aggregate->kind == ENTITY_UNION)) {
		if (token_same(Token(node->data.declaration.name), Token(aggregate->name))) {
			@role = CONSTRUCTOR_ROLE;
		}
		else if (token_is(Token(node->data.declaration.name), "operator\0") && parser_take((Parser*)parser, TOKEN_ASSIGN)) {
			@role = ASSIGNMENT_ROLE;
		};
	};
	if (role == DESTRUCTOR_ROLE && (!aggregate || (aggregate->kind != ENTITY_STRUCT && aggregate->kind != ENTITY_UNION) || !token_same(Token(node->data.declaration.name), Token(aggregate->name)))) {
		compiler_error((Compiler*)parser->compiler, Token(token), "destructor name must match its owning type\0");
		return $node;
	};
	if (role != ORDINARY_ROLE) {
		@node->entity = entity_create((Compiler*)parser->compiler, ENTITY_FUNCTION, Token(node->data.declaration.name));
		@node->entity->scope := owner;
		@node->entity->data.function.role := role;
	}
	else {
		@node->entity = declaration_entity((Compiler*)parser->compiler, (Scope*)owner, (EntityKind)rule->entity, Token(node->data.declaration.name));
	};
	if (!node->entity) {
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_COLON)) {
		if (token.kind != TOKEN_STRUCT) {
			compiler_error((Compiler*)parser->compiler, Token(token), "base relationships require a struct declaration\0");
			return $node;
		};
		@node->data.declaration.bases = parser_bases((Parser*)parser);
		if (!node->entity->data.aggregate.bases) {
			@node->entity->data.aggregate.bases := node->data.declaration.bases;
		};
		if (!parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
			compiler_error((Compiler*)parser->compiler, Token(token), "base relationships require a struct definition\0");
			return $node;
		};
	};
	if (token.kind == TOKEN_FN) {
		@node->data.declaration.type = parser_signature((Parser*)parser, Token(token));
		if ((role != ORDINARY_ROLE || parser->scope->context == CONTEXT_STRUCT || parser->scope->context == CONTEXT_UNION) && !node->data.declaration.path->data.expression) {
			parser_receiver((Parser*)parser, (Syntax*)node->data.declaration.type, (Entity*)parser->scope->owner);
		};
		if ((role == CONSTRUCTOR_ROLE || role == DESTRUCTOR_ROLE) && node->data.declaration.type->data.signature.result) {
			compiler_error((Compiler*)parser->compiler, Token(token), "constructors and destructors have no return type\0");
		};
	};
	if (token.kind == TOKEN_FN) {
		if (parser_take((Parser*)parser, TOKEN_COLON)) {
			Token modifier = parser_token((Parser*)parser);
			if (parser_take((Parser*)parser, TOKEN_DELETE)) {
				@node->data.declaration.definition = FUNCTION_DELETED;
			}
			else if (parser_take((Parser*)parser, TOKEN_VIRTUAL)) {
				@node->data.declaration.modification = FUNCTION_VIRTUAL;
			}
			else if (parser_take((Parser*)parser, TOKEN_OVERRIDE)) {
				@node->data.declaration.modification = FUNCTION_OVERRIDE;
			}
			else if (parser_take((Parser*)parser, TOKEN_FINAL)) {
				@node->data.declaration.modification = FUNCTION_FINAL;
			}
			else {
				compiler_error((Compiler*)parser->compiler, Token(modifier), "expected delete, virtual, override, or final modifier\0");
				return $node;
			};
		};
		if (parser->scope->context == CONTEXT_STRUCT && !node->data.declaration.path->data.expression) {
			@node->entity->data.function.interface_owner := parser->scope->owner;
			if (node->entity->data.function.modification != FUNCTION_ORDINARY && node->entity->data.function.modification != node->data.declaration.modification) {
				compiler_error((Compiler*)parser->compiler, Token(token), "conflicting virtual relationship declarations\0");
			};
			@node->entity->data.function.modification := node->data.declaration.modification;
			if (node->data.declaration.modification != FUNCTION_ORDINARY && !node->entity->data.function.callable) {
				VirtualCallable* callable = (VirtualCallable*)memory_allocate((Compiler*)parser->compiler, sizeof(VirtualCallable));
				@callable->function := node->entity;
				VirtualCallable** link = &parser->scope->owner->data.aggregate.virtual_callables;
				while (*link) {
					@callable->index = callable->index + 1;
					@link = &(*link)->next;
				};
				@node->entity->data.function.callable := callable;
				@*link = $callable;
			};
		};
	};
	if (parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
		if (node->data.declaration.definition == FUNCTION_DELETED) {
			compiler_error((Compiler*)parser->compiler, Token(token), "deleted function cannot have a body\0");
			return $node;
		};
		if (token.kind == TOKEN_FN) {
			@node->data.declaration.definition = FUNCTION_DEFINITION;
		};
		Scope* outer := parser->scope;
		ContextKind context := rule->context;
		if (token.kind == TOKEN_STRUCT || token.kind == TOKEN_UNION) {
			Scope* members = entity_members((Entity*)node->entity);
			@members->context := context;
			@node->data.declaration.body = parser_block_scope((Parser*)parser, (Scope*)members);
			@members->context = CONTEXT_MODULE;
		}
		else {
			@parser->scope = scope_create((Compiler*)parser->compiler, (Scope*)owner, (ContextKind)context, (Entity*)node->entity);
			if (token.kind == TOKEN_FN) {
				ParameterSyntax* parameter := node->data.declaration.type->data.signature.parameters;
				while (parameter) {
					if (parameter->name.source) {
						Entity* entity = entity_create((Compiler*)parser->compiler, ENTITY_VARIABLE, Token(parameter->name));
						@entity->data.variable.storage = STORAGE_PARAMETER;
						scope_define((Compiler*)parser->compiler, (Scope*)parser->scope, (Entity*)entity);
						@parameter->entity = $entity;
					};
					@parameter := parameter->next;
				};
			};
			if (token.kind == TOKEN_ENUM) {
				@node->data.declaration.body = parser_enum_block((Parser*)parser);
			}
			else {
				@node->data.declaration.body = parser_block((Parser*)parser);
			};
			@node->data.declaration.body->scope->context := context;
			@node->data.declaration.body->scope->owner := node->entity;
		};
		@parser->scope = $outer;
	};
	if (!node->entity->declaration || node->data.declaration.body || node->data.declaration.definition == FUNCTION_DELETED) {
		@node->entity->declaration := node;
	};
	if (role != ORDINARY_ROLE) {
		parser_special_register((Parser*)parser, (Scope*)owner, (Syntax*)node);
	};
	parser_require($parser, TOKEN_SEMICOLON, "expected ';' after declaration\0");
	return $node;
};

fn parser_control_body(Parser* parser) -> Syntax* {
	if (parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
		return parser_block((Parser*)parser);
	};

	return parser_statement($parser);
};

fn parser_conditional(Parser* parser) -> Syntax* {
	Token token = parser_require((Parser*)parser, TOKEN_IF, "expected if\0");
	Syntax* node = syntax_new((Parser*)parser, SYNTAX_IF, $token);
	parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' after if\0");
	@node->data.branch.condition = parser_expression((Parser*)parser, 1);
	parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after condition\0");
	@node->data.branch.first = parser_control_body((Parser*)parser);

	if (!parser_take((Parser*)parser, TOKEN_ELSE)) {
		return $node;
	};

	if (parser_at((Parser*)parser, TOKEN_IF)) {
		@node->data.branch.second = parser_conditional((Parser*)parser);
		return $node;
	};

	@node->data.branch.second = parser_control_body($parser);
	return $node;
};

fn parser_namespace(Parser* parser) -> Syntax* {
	Token token = parser_require((Parser*)parser, TOKEN_NAMESPACE, "expected namespace\0");
	if (parser->scope->context != CONTEXT_MODULE) {
		compiler_error((Compiler*)parser->compiler, Token(token), "namespace requires module context\0");
		return nullptr;
	};

	Scope* outer := parser->scope;
	Entity* entity = nullptr;
	while (true) {
		Token name = parser_require((Parser*)parser, TOKEN_NAME, "expected namespace identifier\0");
		@entity = namespace_define((Compiler*)parser->compiler, (Scope*)parser->scope, $name);
		if (!entity) {
			return nullptr;
		};
		@parser->scope = entity_members((Entity*)entity);
		if (!parser_take((Parser*)parser, TOKEN_SCOPE)) {
			break;
		};
	};

	Syntax* node = syntax_new((Parser*)parser, SYNTAX_DECLARATION, Token(token));
	@node->entity = $entity;
	parser_require((Parser*)parser, TOKEN_LEFT_BRACE, "expected namespace body\0");
	Syntax* body = syntax_new((Parser*)parser, SYNTAX_BLOCK, $token);
	@body->scope := parser->scope;
	Syntax* last = nullptr;
	while (!parser_at((Parser*)parser, TOKEN_RIGHT_BRACE) && !parser_at((Parser*)parser, TOKEN_END) && parser->compiler->result != COMPILATION_FAILURE) {
		Syntax* statement = parser_statement((Parser*)parser);
		syntax_append(&body->data.statements, &last, $statement);
	};
	parser_require((Parser*)parser, TOKEN_RIGHT_BRACE, "expected '}' after namespace\0");
	parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after namespace\0");
	@parser->scope = $outer;
	@node->data.declaration.body = $body;
	return $node;
};

fn parser_statement(Parser* parser) -> Syntax* {
	if (parser_at((Parser*)parser, TOKEN_NAMESPACE)) {
		return parser_namespace((Parser*)parser);
	};
	Token token = parser_token((Parser*)parser);
	DeclarationRule* rule = declaration_rule((Compiler*)parser->compiler, (TokenKind)token.kind);

	if (rule) {
		return parser_named_declaration((Parser*)parser, $rule);
	};
	if (parser_declaration_start((Parser*)parser)) {
		return parser_variable((Parser*)parser);
	};
	if (parser_take((Parser*)parser, TOKEN_SEMICOLON)) {
		return syntax_new((Parser*)parser, SYNTAX_BLOCK, Token(token));
	};
	if (parser_at((Parser*)parser, TOKEN_LEFT_BRACE)) {
		Syntax* node = parser_block((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after block expression\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_RETURN)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_RETURN, Token(token));
		if (!parser_at((Parser*)parser, TOKEN_SEMICOLON)) {
			@node->data.expression = parser_expression((Parser*)parser, 1);
		};
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after return\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_BREAK) || parser_take((Parser*)parser, TOKEN_CONTINUE)) {
		SyntaxKind kind = SYNTAX_BREAK;
		if (token.kind == TOKEN_CONTINUE) {
			@kind = SYNTAX_CONTINUE;
		};
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after flow statement\0");
		return syntax_new((Parser*)parser, $kind, Token(token));
	};
	if (parser_at((Parser*)parser, TOKEN_IF)) {
		Syntax* node = parser_conditional((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after if statement\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_WHILE)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_WHILE, Token(token));
		parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' after while\0");
		@node->data.loop.condition = parser_expression((Parser*)parser, 1);
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after condition\0");
		@node->data.loop.body = parser_control_body((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after loop statement\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_FOR)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_FOR, Token(token));
		Scope* outer := parser->scope;
		@node->scope = scope_create((Compiler*)parser->compiler, (Scope*)outer, CONTEXT_LOCAL, nullptr);
		@parser->scope := node->scope;
		parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' after for\0");
		if (parser_declaration_start((Parser*)parser)) {
			@node->data.loop.initializer = parser_variable((Parser*)parser);
		}
		else {
			if (!parser_at((Parser*)parser, TOKEN_SEMICOLON)) {
				@node->data.loop.initializer = parser_expression((Parser*)parser, 1);
			};
			parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after for initializer\0");
		};
		if (!parser_at((Parser*)parser, TOKEN_SEMICOLON)) {
			@node->data.loop.condition = parser_expression((Parser*)parser, 1);
		};
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after for condition\0");
		if (!parser_at((Parser*)parser, TOKEN_RIGHT_PAREN)) {
			@node->data.loop.step = parser_expression((Parser*)parser, 1);
		};
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after for step\0");
		@node->data.loop.body = parser_control_body((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after loop statement\0");
		@parser->scope = $outer;
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_SWITCH)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_SWITCH, Token(token));
		parser_require((Parser*)parser, TOKEN_LEFT_PAREN, "expected '(' after switch\0");
		@node->data.selection.value = parser_expression((Parser*)parser, 1);
		parser_require((Parser*)parser, TOKEN_RIGHT_PAREN, "expected ')' after switch value\0");
		@node->data.selection.cases = parser_block((Parser*)parser);
		parser_require((Parser*)parser, TOKEN_SEMICOLON, "expected ';' after switch block\0");
		return $node;
	};
	if (parser_take((Parser*)parser, TOKEN_CASE) || parser_take((Parser*)parser, TOKEN_DEFAULT)) {
		Syntax* node = syntax_new((Parser*)parser, SYNTAX_CASE, Token(token));
		if (token.kind == TOKEN_CASE) {
			@node->data.selection_case.value = parser_expression((Parser*)parser, 2);
		};
		parser_require((Parser*)parser, TOKEN_COLON, "expected ':' after case label\0");
		return $node;
	};
	Syntax* node = parser_expression((Parser*)parser, 1);
	parser_require($parser, TOKEN_SEMICOLON, "expected ';' after expression\0");
	return $node;
};

fn parser_block(Parser* parser) -> Syntax* {
	Scope* scope = scope_create((Compiler*)parser->compiler, (Scope*)parser->scope, CONTEXT_LOCAL, nullptr);
	return parser_block_scope($parser, $scope);
};

fn prepare_source(Compiler* compiler, Source* source) -> i32 {
	if (source->tokens) {
		return compiler->result == COMPILATION_SUCCESS;
	};
	if (!tokenize((Compiler*)compiler, (Source*)source, &source->tokens, &source->token_count)) {
		return 0;
	};
	Parser parser {
		@parser.compiler := compiler;
		@parser.scope := compiler->module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		@parser.offset = 0;
	};
	parser_predeclare(&parser, DECLARATION_IDENTITIES);
	return compiler->result == COMPILATION_SUCCESS;
};

fn prepare_sources(Compiler* compiler) -> i32 {
	Source* source := compiler->sources;
	while (source) {
		if (!prepare_source((Compiler*)compiler, (Source*)source)) {
			return 0;
		};
		@source := source->next;
	};
	@source := compiler->sources;
	while (source) {
		Parser parser;
		@parser.compiler := compiler;
		@parser.scope := compiler->module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		parser_predeclare(&parser, DECLARATION_MEMBERS);
		@source := source->next;
	};
	return compiler->result == COMPILATION_SUCCESS;
};

fn parse_source(Compiler* compiler, Source* source) -> Syntax* {
	if (!prepare_source((Compiler*)compiler, (Source*)source)) {
		return nullptr;
	};
	Parser parser {
		@parser.compiler := compiler;
		@parser.scope := compiler->module;
		@parser.tokens := source->tokens;
		@parser.count := source->token_count;
		@parser.offset = 0;
	};
	Token token = parser_token(&parser);
	Syntax* module = syntax_new(&parser, SYNTAX_BLOCK, $token);
	@module->scope := compiler->module;
	Syntax* last = nullptr;
	while (!parser_at(&parser, TOKEN_END) && compiler->result != COMPILATION_FAILURE) {
		Syntax* statement = parser_statement(&parser);
		syntax_append(&module->data.statements, &last, $statement);
	};
	return $module;
};

