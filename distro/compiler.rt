namespace rt {
	template<typename T>
	struct default_delete {
		fn dispose(var T* pointer);
	};

	template<typename T, typename D = default_delete<T>>
	struct unique {
		fn unique(var unique& this) : [default];
		fn unique(var unique& this, var T* pointer);
		fn unique(var unique& this, unique& other) : [delete];
		fn operator=(var unique& this, unique& other) -> var unique& : [delete];
		fn operator:=(var unique& this, unique& other) -> var unique& : [delete];
		fn ~unique(var unique& this);
		fn make() -> unique;

		fn release(var unique& this) -> var T*;
		fn reset(var unique& this, var T* pointer);

		fn get(unique& this) -> var T*;

	private:
		var T* pointer;
	};

	template<typename T>
	fn default_delete<T>::dispose(var T* pointer) {
		delete pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::unique(var unique& this, var T* pointer) {
		@this.pointer = $pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::~unique(var unique& this) {
		@this.reset(nullptr);
	};

	template<typename T, typename D>
	fn unique<T, D>::get(unique& this) -> var T* {
		return this.pointer;
	};

	template<typename T, typename D>
	fn unique<T, D>::release(var unique& this) -> var T* {
		var T* result := this.pointer;

		@this.pointer = nullptr;

		return $result;
	};

	template<typename T, typename D>
	fn unique<T, D>::reset(var unique& this, var T* pointer) {
		var T* previous := this.pointer;

		@this.pointer = $pointer;
		D::dispose($previous);
	};

	template<typename T, typename D>
	fn unique<T, D>::make() -> unique {
		return unique(new var T());
	};
};

namespace rt {
	enum optional_state : [u08] {
		empty;
		engaged;
	};

	template<typename T>
	union optional_storage {
		fn optional_storage(var optional_storage& this);
		fn ~optional_storage(var optional_storage& this);

		u08 empty;
		T value;
	};

	template<typename T>
	struct optional {
		fn optional(var optional& this);
		fn optional(var optional& this, T value);
		fn optional(var optional& this, optional& other);
		fn optional(var optional& this, optional other);
		fn ~optional(var optional& this);

		fn reset(var optional& this);
		fn emplace(var optional& this, T value) -> var T&;

		fn has_value(optional& this) -> bool;
		fn get(auto optional& this) -> const[this] T*;
		// Requires has_value(). The reference borrows the contained object's lifetime.
		fn value(auto optional& this) -> const[this] T&;

	private:
		optional_storage<T> storage;
		optional_state state;
	};

	template<typename T>
	struct optional_ref {
		fn optional_ref(var optional_ref& this) : [default];
		fn optional_ref(var optional_ref& this, var T& value);
		fn optional_ref(var optional_ref& this, optional_ref& other) : [implicit];

		fn reset(var optional_ref& this);
		fn bind(var optional_ref& this, var T& value);

		fn has_value(optional_ref& this) -> bool;
		fn get(optional_ref& this) -> var T*;
		// Requires has_value(). Resetting the optional never destroys its referent.
		fn value(optional_ref& this) -> var T&;

	private:
		var T* pointer;
	};

	template<typename T>
	fn optional_storage<T>::optional_storage(var optional_storage& this) {
		@this.empty = 0;
	};

	template<typename T>
	fn optional_storage<T>::~optional_storage(var optional_storage& this) {
	};

	template<typename T>
	fn optional<T>::optional(var optional& this) {
	};

	template<typename T>
	fn optional<T>::optional(var optional& this, T value) {
		@this.storage.value.T($value);
		@this.state = optional_state::engaged;
	};

	template<typename T>
	fn optional<T>::optional(var optional& this, optional& other) {
		if (other.has_value()) {
			@this.storage.value.T(other.storage.value);
			@this.state = optional_state::engaged;
		};
	};

	template<typename T>
	fn optional<T>::optional(var optional& this, optional other) {
		if (other.has_value()) {
			var T* source = &@other.storage.value;

			@this.storage.value.T($(*source));
			@this.state = optional_state::engaged;
			@other.state = optional_state::empty;
		};
	};

	template<typename T>
	fn optional<T>::~optional(var optional& this) {
		@this.reset();
	};

	template<typename T>
	fn optional<T>::has_value(optional& this) -> bool {
		return this.state == optional_state::engaged;
	};

	template<typename T>
	fn optional<T>::get(auto optional& this) -> const[this] T* {
		if (!this.has_value()) {
			return nullptr;
		};

		return &@this.storage.value;
	};

	template<typename T>
	fn optional<T>::value(auto optional& this) -> const[this] T& {
		return const_cast<const[this] T&>(@const_cast<var T&>(this.storage.value));
	};

	template<typename T>
	fn optional<T>::reset(var optional& this) {
		if (!this.has_value()) {
			return;
		};

		@this.storage.value.~T();
		@this.state = optional_state::empty;
	};

	template<typename T>
	fn optional<T>::emplace(var optional& this, T value) -> var T& {
		@this.reset();
		@this.storage.value.T($value);
		@this.state = optional_state::engaged;

		return @this.storage.value;
	};

	template<typename T>
	fn optional_ref<T>::optional_ref(var optional_ref& this, var T& value) {
		@this.pointer = &@value;
	};

	template<typename T>
	fn optional_ref<T>::optional_ref(var optional_ref& this, optional_ref& other) : [implicit] {
		@this.pointer := other.pointer;
	};

	template<typename T>
	fn optional_ref<T>::has_value(optional_ref& this) -> bool {
		return this.pointer != nullptr;
	};

	template<typename T>
	fn optional_ref<T>::get(optional_ref& this) -> var T* {
		return this.pointer;
	};

	template<typename T>
	fn optional_ref<T>::value(optional_ref& this) -> var T& {
		return static_cast<var T&>(*this.pointer);
	};

	template<typename T>
	fn optional_ref<T>::reset(var optional_ref& this) {
		@this.pointer = nullptr;
	};

	template<typename T>
	fn optional_ref<T>::bind(var optional_ref& this, var T& value) {
		@this.pointer = &@value;
	};
};

fn malloc(usize size) -> var void*;

fn free(void* memory);

namespace rt {
	template<typename T>
	struct buffer {
		fn buffer(var buffer& this) : [default];
		fn buffer(var buffer& this, buffer& other);
		fn ~buffer(var buffer& this);

		fn operator=(var buffer& this, buffer& other) -> var buffer&;
		fn operator:=(var buffer& this, buffer& other) -> var buffer&;
		fn reserve(var buffer& this, usize required) -> bool;
		fn push_back(var buffer& this, T value) -> bool;
		fn pop_back(var buffer& this) -> bool;
		fn clear(var buffer& this);

		fn data(auto buffer& this) -> const[this] T*;
		fn size(buffer& this) -> usize;
		fn capacity(buffer& this) -> usize;

	private:
		fn copy_from(var buffer& this, buffer& other) -> bool;

		var T* _storage;
		usize _size;
		usize _capacity;
	};

	template<typename T>
	fn buffer<T>::buffer(var buffer& this, buffer& other) {
		@this.copy_from(other);
	};

	template<typename T>
	fn buffer<T>::operator=(var buffer& this, buffer& other) -> var buffer& {
		buffer replacement;
		if (!@replacement.copy_from(other)) {
			return @this;
		};

		@this = $replacement;

		return @this;
	};

	template<typename T>
	fn buffer<T>::copy_from(var buffer& this, buffer& other) -> bool {
		if (!@this.reserve(other._size)) {
			return false;
		};

		while (this._size < other._size) {
			@this._storage[this._size].T(other._storage[this._size]);
			@this._size = this._size + 1;
		};

		return true;
	};

	template<typename T>
	fn buffer<T>::operator:=(var buffer& this, buffer& other) -> var buffer& {
		return @this = other;
	};

	template<typename T>
	fn buffer<T>::~buffer(var buffer& this) {
		@this.clear();
		free(this._storage);
	};

	template<typename T>
	fn buffer<T>::reserve(var buffer& this, usize required) -> bool {
		if (required <= this._capacity) {
			return true;
		};

		usize element_size = sizeof(T);
		usize maximum = usize::max;
		if (element_size) {
			@maximum = maximum / element_size;
		};

		if (required > maximum) {
			return false;
		};

		usize count = $required;
		if (this._capacity <= (maximum >> 1)) {
			usize grown = this._capacity << 1;
			if (grown > count) {
				@count = $grown;
			};
		};

		usize bytes = count * element_size;
		if (!bytes) {
			@bytes = 1;
		};

		var T* replacement = static_cast<var T*>(malloc($bytes));
		if (!replacement) {
			return false;
		};

		usize index = 0;
		while (index < this._size) {
			@replacement[index].T($(this._storage[index]));
			@index = index + 1;
		};

		free(this._storage);
		@this._storage = $replacement;
		@this._capacity = $count;

		return true;
	};

	template<typename T>
	fn buffer<T>::push_back(var buffer& this, T value) -> bool {
		if (this._size == usize::max || !@this.reserve(this._size + 1)) {
			return false;
		};

		@this._storage[this._size].T($value);
		@this._size = this._size + 1;

		return true;
	};

	template<typename T>
	fn buffer<T>::pop_back(var buffer& this) -> bool {
		if (!this._size) {
			return false;
		};

		@this._size = this._size - 1;
		@this._storage[this._size].~T();

		return true;
	};

	template<typename T>
	fn buffer<T>::clear(var buffer& this) {
		for (usize index = 0; index < this._size; @index = index + 1) {
			@this._storage[index].~T();
		};

		@this._size = 0;
	};

	template<typename T>
	fn buffer<T>::size(buffer& this) -> usize {
		return this._size;
	};

	template<typename T>
	fn buffer<T>::capacity(buffer& this) -> usize {
		return this._capacity;
	};

	template<typename T>
	fn buffer<T>::data(auto buffer& this) -> const[this] T* {
		return this._storage;
	};
};

namespace rt {
	struct string_view {
		fn string_view(var string_view& this) : [default];
		fn string_view(var string_view& this, string_view& other) : [implicit, default];
		fn string_view(var string_view& this, string& text) : [implicit];
		fn string_view(var string_view& this, char* data, usize size);
		fn string_view(var string_view& this, char* text) : [implicit];

		fn data(string_view& this) -> char*;
		fn size(string_view& this) -> usize;
		fn empty(string_view& this) -> bool;
		fn slice(string_view& this, usize begin, usize count) -> string_view;
		fn compare(string_view& this, string_view& other) -> i32;

	private:
		char* bytes;
		usize length;
	};

	fn operator==(string_view& first, string_view& second) -> bool {
		return !first.compare(second);
	};

	fn operator!=(string_view& first, string_view& second) -> bool {
		return first.compare(second) != 0;
	};

	fn operator<(string_view& first, string_view& second) -> bool {
		return first.compare(second) < 0;
	};

	fn operator<=(string_view& first, string_view& second) -> bool {
		return first.compare(second) <= 0;
	};

	fn operator>(string_view& first, string_view& second) -> bool {
		return first.compare(second) > 0;
	};

	fn operator>=(string_view& first, string_view& second) -> bool {
		return first.compare(second) >= 0;
	};

	fn string_view::string_view(var string_view& this, char* data, usize size) {
		@this.bytes = $data;
		@this.length = $size;
	};

	fn string_view::string_view(var string_view& this, char* text) : [implicit] {
		@this.bytes = $text;
		while (this.bytes && this.bytes[this.length]) {
			@this.length = this.length + 1;
		};
	};

	fn string_view::data(string_view& this) -> char* {
		return this.bytes;
	};

	fn string_view::size(string_view& this) -> usize {
		return this.length;
	};

	fn string_view::empty(string_view& this) -> bool {
		return !this.length;
	};

	fn string_view::slice(string_view& this, usize begin, usize count) -> string_view {
		return string_view(this.bytes + begin, $count);
	};

	fn string_view::compare(string_view& this, string_view& other) -> i32 {
		usize count := this.length;
		if (other.length < count) {
			@count := other.length;
		};

		usize index = 0;
		while (index < count) {
			char first_byte := this.bytes[index];
			char second_byte := other.bytes[index];
			u08 first = static_cast<u08>($first_byte);
			u08 second = static_cast<u08>($second_byte);
			if (first < second) {
				return -1;
			};

			if (first > second) {
				return 1;
			};

			@index = index + 1;
		};

		if (this.length < other.length) {
			return -1;
		};

		if (this.length > other.length) {
			return 1;
		};

		return 0;
	};
};

namespace rt {
	struct string {
		fn string(var string& this) : [default];
		fn string(var string& this, string& other);
		fn string(var string& this, string_view& text);
		fn string(var string& this, char* text);

		fn operator=(var string& this, string& other) -> var string&;
		fn clear(var string& this);
		fn append(var string& this, string_view& text) -> bool;

		fn size(string& this) -> usize;
		fn empty(string& this) -> bool;
		fn data(auto string& this) -> const[this] char*;
		fn c_str(string& this) -> char*;
		fn view(string& this) -> string_view;

	private:
		buffer<char> bytes;
	};

	fn string_view::string_view(var string_view& this, string& text) {
		@this.bytes = text.data();
		@this.length = text.size();
	};

	fn string::append(var string& this, string_view& text) -> bool {
		if (text.empty()) {
			return true;
		};

		usize size = this.size();
		if (text.size() > usize::max - size - 1) {
			return false;
		};

		char* source = text.data();
		usize offset = 0;
		usize address = reinterpret_cast<usize>(source);
		usize begin = reinterpret_cast<usize>(this.bytes.data());
		bool aliases = address >= begin && address - begin < this.bytes.size();
		if (aliases) {
			@offset = address - begin;
		};

		if (!@this.bytes.reserve(size + text.size() + 1)) {
			return false;
		};

		if (aliases) {
			@source = this.bytes.data() + offset;
		};

		@this.bytes.pop_back();

		usize index = 0;
		while (index < text.size()) {
			@this.bytes.push_back(char(source[index]));
			@index = index + 1;
		};

		@this.bytes.push_back('\0');

		return true;
	};

	fn string::string(var string& this, string& other) {
		@this.append(other.view());
	};

	fn string::string(var string& this, string_view& text) {
		@this.append(text);
	};

	fn string::string(var string& this, char* text) {
		@this.append(string_view($text));
	};

	fn string::operator=(var string& this, string& other) -> var string& {
		string replacement;
		if (!@replacement.append(other.view())) {
			return @this;
		};

		@this = $replacement;

		return @this;
	};

	fn string::size(string& this) -> usize {
		if (!this.bytes.size()) {
			return 0;
		};

		return this.bytes.size() - 1;
	};

	fn string::empty(string& this) -> bool {
		return !this.size();
	};

	fn string::data(auto string& this) -> const[this] char* {
		return const_cast<const[this] char*>(this.bytes.data());
	};

	fn string::c_str(string& this) -> char* {
		if (!this.bytes.size()) {
			return "\0";
		};

		return this.bytes.data();
	};

	fn string::view(string& this) -> string_view {
		return string_view(this.bytes.data(), this.size());
	};

	fn string::clear(var string& this) {
		@this.bytes.clear();
	};
};

namespace rt {
	const u64 splitmix64_first_multiplier = 13787848793156543929;
	const u64 splitmix64_second_multiplier = 10723151780598845931;
	const u64 splitmix64_first_shift = 30;
	const u64 splitmix64_second_shift = 27;
	const u64 splitmix64_final_shift = 31;
	const u64 fnv1a64_offset_basis = 14695981039346656037;
	const u64 fnv1a64_prime = 1099511628211;

	fn mix_hash(u64 value) -> usize {
		@value = (value ^ (value >> splitmix64_first_shift)) * splitmix64_first_multiplier;
		@value = (value ^ (value >> splitmix64_second_shift)) * splitmix64_second_multiplier;

		return static_cast<usize>(value ^ (value >> splitmix64_final_shift));
	};

	template<typename K>
	struct integer_hash {
		fn hash(integer_hash& this, K& value) -> usize;
	};

	template<typename T>
	struct pointer_hash {
		fn hash(pointer_hash& this, T* value) -> usize;
	};

	struct f32_hash {
		fn hash(f32_hash& this, f32& value) -> usize;
	};

	struct f64_hash {
		fn hash(f64_hash& this, f64& value) -> usize;
	};

	struct string_view_hash {
		fn hash(string_view_hash& this, string_view& value) -> usize;
	};

	template<typename K>
	fn integer_hash<K>::hash(integer_hash& this, K& value) -> usize {
		return mix_hash(static_cast<u64>(value));
	};

	template<typename T>
	fn pointer_hash<T>::hash(pointer_hash& this, T* value) -> usize {
		return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));
	};

	fn f32_hash::hash(f32_hash& this, f32& value) -> usize {
		if (value == 0.0) {
			return 0;
		};

		return mix_hash(static_cast<u64>(*reinterpret_cast<u32*>(&@value)));
	};

	fn f64_hash::hash(f64_hash& this, f64& value) -> usize {
		if (value == 0.0) {
			return 0;
		};

		return mix_hash(*reinterpret_cast<u64*>(&@value));
	};

	fn string_view_hash::hash(string_view_hash& this, string_view& value) -> usize {
		u64 result := fnv1a64_offset_basis;
		usize index = 0;
		while (index < value.size()) {
			char byte = value.data()[index];

			@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * fnv1a64_prime;
			@index = index + 1;
		};

		return static_cast<usize>(result);
	};

	// Default pointer hashing accepts object pointers through const void*.
	// Function pointers require an explicit compatible hash policy.
	template<typename K>
	struct default_hash {
		fn hash(default_hash& this, K& value) -> usize;
	};

	fn hash_value(bool& value) -> usize {
		integer_hash<bool> policy;

		return policy.hash(value);
	};

	fn hash_value(char& value) -> usize {
		integer_hash<char> policy;

		return policy.hash(value);
	};

	fn hash_value(i08& value) -> usize {
		integer_hash<i08> policy;

		return policy.hash(value);
	};

	fn hash_value(i16& value) -> usize {
		integer_hash<i16> policy;

		return policy.hash(value);
	};

	fn hash_value(i32& value) -> usize {
		integer_hash<i32> policy;

		return policy.hash(value);
	};

	fn hash_value(i64& value) -> usize {
		integer_hash<i64> policy;

		return policy.hash(value);
	};

	fn hash_value(u08& value) -> usize {
		integer_hash<u08> policy;

		return policy.hash(value);
	};

	fn hash_value(u16& value) -> usize {
		integer_hash<u16> policy;

		return policy.hash(value);
	};

	fn hash_value(u32& value) -> usize {
		integer_hash<u32> policy;

		return policy.hash(value);
	};

	fn hash_value(u64& value) -> usize {
		integer_hash<u64> policy;

		return policy.hash(value);
	};

	fn hash_value(f32& value) -> usize {
		f32_hash policy;

		return policy.hash(value);
	};

	fn hash_value(f64& value) -> usize {
		f64_hash policy;

		return policy.hash(value);
	};

	fn hash_value(string_view& value) -> usize {
		string_view_hash policy;

		return policy.hash(value);
	};

	fn hash_value(void* value) -> usize {
		return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));
	};

	template<typename K>
	fn default_hash<K>::hash(default_hash& this, K& value) -> usize {
		return hash_value(value);
	};
};

namespace rt {
	template<typename K>
	struct default_equal {
		fn equal(default_equal& this, K& first, K& second) -> bool;
	};

	template<typename K>
	fn default_equal<K>::equal(default_equal& this, K& first, K& second) -> bool {
		return first == second;
	};
};

namespace rt {
	template<typename T>
	union unordered_slot {
		fn unordered_slot(var unordered_slot& this) : [default];
		fn ~unordered_slot(var unordered_slot& this) : [default];

		u08 empty;
		T object;
	};

	template<typename K, typename V>
	struct unordered_node {
		fn unordered_node(var unordered_node& this, K key, V value, usize code);
		fn ~unordered_node(var unordered_node& this);

		unordered_slot<K> key;
		unordered_slot<V> value;
		var unordered_node* next;
		usize hash_code;
	};

	// Equal must define an equivalence relation; equivalent keys must have equal hashes.
	// Hash and Equal are called through const references and must remain stable while keys are stored.
	// Key storage borrowed by a key (such as string_view bytes) must remain valid and unchanged.
	// Insert consumes both arguments, returning false on duplicate or allocation failure.
	// Pointers returned by find survive insert/reserve and moves of their owning map.
	// Erase invalidates only the erased value; clear and destruction invalidate all values.
	template<typename K, typename V, typename Hash = default_hash<K>, typename Equal = default_equal<K>>
	struct unordered_map {
		fn unordered_map(var unordered_map& this);
		fn unordered_map(var unordered_map& this, Hash hash, Equal equal);
		fn unordered_map(var unordered_map& this, unordered_map& other) : [delete];
		fn operator=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];
		fn operator:=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];
		fn ~unordered_map(var unordered_map& this);

		fn insert(var unordered_map& this, K key, V value) -> bool;
		fn erase(var unordered_map& this, K& key) -> bool;
		fn clear(var unordered_map& this);
		fn reserve(var unordered_map& this, usize required) -> bool;

		fn size(unordered_map& this) -> usize;
		fn empty(unordered_map& this) -> bool;
		fn find(auto unordered_map& this, K& key) -> const[this] V*;

	private:
		buffer<var unordered_node<K, V>*> buckets;
		unordered_slot<Hash> hasher;
		unordered_slot<Equal> comparison;
		usize length;
	};

	template<typename K, typename V>
	fn unordered_node<K, V>::unordered_node(var unordered_node& this, K key, V value, usize code) {
		@this.key.object.K($key);
		@this.value.object.V($value);
		@this.hash_code = $code;
	};

	template<typename K, typename V>
	fn unordered_node<K, V>::~unordered_node(var unordered_node& this) {
		@this.value.object.~V();
		@this.key.object.~K();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash();
		@this.comparison.object.Equal();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this, Hash hash, Equal equal) {
		@this.hasher.unordered_slot<Hash>();
		@this.comparison.unordered_slot<Equal>();
		@this.hasher.object.Hash($hash);
		@this.comparison.object.Equal($equal);
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::~unordered_map(var unordered_map& this) {
		@this.clear();
		@this.comparison.object.~Equal();
		@this.hasher.object.~Hash();
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::size(unordered_map& this) -> usize {
		return this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::empty(unordered_map& this) -> bool {
		return !this.length;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::find(auto unordered_map& this, K& key) -> const[this] V* {
		if (!this.buckets.size()) {
			return nullptr;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		var unordered_node<K, V>* node = this.buckets.data()[index];
		while (node) {
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				return const_cast<const[this] V*>(&@node->value.object);
			};

			@node = node->next;
		};

		return nullptr;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::insert(var unordered_map& this, K key, V value) -> bool {
		if (this.find(key) || this.length == usize::max) {
			return false;
		};

		usize code = this.hasher.object.hash(key);
		if (!@this.reserve(this.length + 1)) {
			return false;
		};

		using Node = unordered_node<K, V>;
		var Node* node = static_cast<var Node*>(malloc(sizeof(Node)));
		if (!node) {
			return false;
		};

		@node->Node($key, $value, $code);

		usize index = node->hash_code % this.buckets.size();

		@node->next = this.buckets.data()[index];
		@(@this.buckets).data()[index] = node;
		@this.length = this.length + 1;

		return true;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::erase(var unordered_map& this, K& key) -> bool {
		if (!this.buckets.size()) {
			return false;
		};

		usize code = this.hasher.object.hash(key);
		usize index = code % this.buckets.size();
		var (var unordered_node<K, V>*)* link = &@(@this.buckets).data()[index];
		while (*link) {
			var unordered_node<K, V>* node = *link;
			if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {
				@*link = node->next;

				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@this.length = this.length - 1;

				return true;
			};

			@link = &@node->next;
		};

		return false;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::clear(var unordered_map& this) {
		usize index = 0;
		while (index < this.buckets.size()) {
			var unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				var unordered_node<K, V>* next = node->next;
				using Node = unordered_node<K, V>;

				@node->~Node();
				free(node);
				@node = next;
			};

			@(@this.buckets).data()[index] = nullptr;
			@index = index + 1;
		};

		@this.length = 0;
	};

	template<typename K, typename V, typename Hash, typename Equal>
	fn unordered_map<K, V, Hash, Equal>::reserve(var unordered_map& this, usize required) -> bool {
		if (required <= this.buckets.size()) {
			return true;
		};

		usize maximum = usize::max / sizeof(var unordered_node<K, V>*);
		if (required > maximum) {
			return false;
		};

		usize count = $required;
		if (count < 8) {
			@count = 8;
		};

		if (this.buckets.size() <= (maximum >> 1)) {
			usize grown = this.buckets.size() << 1;
			if (grown > count) {
				@count = grown;
			};
		};

		buffer<var unordered_node<K, V>*> replacement;
		if (!@replacement.reserve(count)) {
			return false;
		};

		usize index = 0;
		while (index < count) {
			if (!@replacement.push_back(nullptr)) {
				return false;
			};

			@index = index + 1;
		};

		@index = 0;
		while (index < this.buckets.size()) {
			var unordered_node<K, V>* node = this.buckets.data()[index];
			while (node) {
				var unordered_node<K, V>* next = node->next;
				usize bucket = node->hash_code % count;

				@node->next = replacement.data()[bucket];
				@(@replacement).data()[bucket] = node;
				@node = next;
			};

			@index = index + 1;
		};

		@this.buckets = $replacement;

		return true;
	};
};

enum token_kind : [i32] {
	identifier;
	literal_number;
	literal_string;
	kw_fn;
	kw_using;
	kw_const;
	kw_discard;
	kw_delete;
	kw_new;
	kw_implicit;
	kw_nullptr;
	kw_template;
	kw_typename;
	kw_class;
	kw_var;
	kw_struct;
	kw_union;
	kw_enum;
	kw_namespace;
	kw_virtual;
	kw_override;
	kw_final;
	kw_return;
	kw_if;
	kw_else;
	kw_while;
	kw_for;
	kw_switch;
	kw_case;
	kw_default;
	kw_break;
	kw_continue;
	kw_sizeof;
	op_arrow;
	op_copy;
	op_equal;
	op_not_equal;
	op_less_equal;
	op_greater_equal;
	op_and;
	op_or;
	op_shift_left;
	op_shift_right;
	punct_ellipsis;
	punct_left_paren;
	punct_right_paren;
	punct_left_bracket;
	punct_right_bracket;
	punct_left_brace;
	punct_right_brace;
	punct_semicolon;
	punct_comma;
	punct_colon;
	op_scope;
	op_dot;
	op_assign;
	op_plus;
	op_minus;
	op_star;
	op_slash;
	op_remainder;
	op_ampersand;
	op_pipe;
	op_caret;
	op_bang;
	op_tilde;
	op_access;
	op_relocate;
	op_less;
	op_greater;
	eof;
};

struct Token {
	fn text(Token& this) -> rt::string_view;
	fn is(Token& this, rt::string_view& spelling) -> bool;
	fn same(Token& this, Token& other) -> bool;

	var SourceFile* source;
	usize begin;
	usize length;
	usize line;
	usize column;
	token_kind kind;
};

fn Token::text(Token& this) -> rt::string_view {
	if (!this.source) {
		return rt::string_view();
	};

	var source = this.source->text();

	if (this.begin > source.size() || this.length > source.size() - this.begin) {
		return rt::string_view();
	};

	return rt::string_view(source.data() + this.begin, this.length);
};

fn Token::is(Token& this, rt::string_view& spelling) -> bool {
	return this.source && this.text() == spelling;
};

fn Token::same(Token& this, Token& other) -> bool {
	return this.source && other.source && this.text() == other.text();
};

struct SourceFile {
	fn SourceFile(var SourceFile& this) : [default];

	fn assign(var SourceFile& this, rt::string_view& path, rt::string_view& text) -> bool;
	fn append_token(var SourceFile& this, Token token) -> bool;
	fn clear_tokens(var SourceFile& this);

	fn path(SourceFile& this) -> rt::string_view;
	fn text(SourceFile& this) -> rt::string_view;
	fn line(SourceFile& this, usize number) -> rt::string_view;
	fn tokens(SourceFile& this) -> rt::buffer<Token>&;
	fn token_count(SourceFile& this) -> usize;

private:
	rt::string file_path;
	rt::string contents;
	rt::buffer<usize> line_offsets;
	rt::buffer<Token> token_buffer;
};

struct SourceManager {
	fn add(var SourceManager& this, rt::string_view& path, rt::string_view& text) -> var SourceFile*;
	fn at(auto SourceManager& this, usize index) -> const[this] SourceFile*;
	fn clear(var SourceManager& this);

	fn count(SourceManager& this) -> usize;

private:
	rt::buffer<rt::unique<SourceFile>> files;
};

fn SourceFile::assign(var SourceFile& this, rt::string_view& path, rt::string_view& text) -> bool {
	rt::string next_path;
	rt::string next_text;
	rt::buffer<usize> next_lines;

	if (!@next_path.append(path) || !@next_text.append(text) || !@next_lines.push_back(0)) {
		return false;
	};

	usize offset = 0;

	while (offset < text.size()) {
		if (text.data()[offset] == '\n' && !@next_lines.push_back(offset + 1)) {
			return false;
		};

		@offset = offset + 1;
	};

	@this.token_buffer.clear();
	@this.file_path = $next_path;
	@this.contents = $next_text;
	@this.line_offsets = $next_lines;

	return true;
};

fn SourceFile::path(SourceFile& this) -> rt::string_view {
	return this.file_path.view();
};

fn SourceFile::text(SourceFile& this) -> rt::string_view {
	return this.contents.view();
};

fn SourceFile::line(SourceFile& this, usize number) -> rt::string_view {
	if (!number || number > this.line_offsets.size()) {
		return rt::string_view();
	};

	usize begin = this.line_offsets.data()[number - 1];
	usize end = this.contents.size();

	if (number < this.line_offsets.size()) {
		@end = this.line_offsets.data()[number] - 1;
	};

	if (end > begin && this.contents.data()[end - 1] == '\r') {
		@end = end - 1;
	};

	return rt::string_view(this.contents.data() + begin, end - begin);
};

fn SourceFile::tokens(SourceFile& this) -> rt::buffer<Token>& {
	return this.token_buffer;
};

fn SourceFile::token_count(SourceFile& this) -> usize {
	return this.token_buffer.size();
};

fn SourceFile::append_token(var SourceFile& this, Token token) -> bool {
	return @this.token_buffer.push_back($token);
};

fn SourceFile::clear_tokens(var SourceFile& this) {
	@this.token_buffer.clear();
};

fn SourceManager::add(var SourceManager& this, rt::string_view& path, rt::string_view& text) -> var SourceFile* {
	var file = rt::unique<SourceFile>::make();

	if (!file.get() || !@file.get()->assign(path, text)) {
		return nullptr;
	};

	var SourceFile* result = file.get();

	if (!@this.files.push_back($file)) {
		return nullptr;
	};

	return result;
};

fn SourceManager::count(SourceManager& this) -> usize {
	return this.files.size();
};

fn SourceManager::at(auto SourceManager& this, usize index) -> const[this] SourceFile* {
	if (index >= this.files.size()) {
		return nullptr;
	};

	return const_cast<const[this] SourceFile*>(this.files.data()[index].get());
};

fn SourceManager::clear(var SourceManager& this) {
	@this.files.clear();
};

struct Lexer {
	fn Lexer(var Lexer& this, var SourceFile& source);

	fn scan(var Lexer& this) -> bool;

	fn error(Lexer& this) -> rt::string_view;
	fn error_token(Lexer& this) -> Token;

private:
	var SourceFile* source;
	usize offset;
	usize line;
	usize column;
	rt::string_view failure;
	Token failure_token;

	fn advance(var Lexer& this) -> char;
	fn fail(var Lexer& this, Token& token, rt::string_view& message) -> bool;
	fn trivia(var Lexer& this) -> bool;
	fn number(var Lexer& this, Token& token) -> bool;
	fn quoted(var Lexer& this, Token& token, char quote) -> bool;
	fn symbol(var Lexer& this, var Token& token) -> bool;
	fn identifier_kind(rt::string_view& spelling) -> token_kind;
	fn identifier_start(char value) -> bool;
	fn digit(char value) -> bool;

	fn peek(Lexer& this, usize distance) -> char;
	fn location(Lexer& this) -> Token;
};

fn Lexer::Lexer(var Lexer& this, var SourceFile& source) {
	@this.source = &@source;
	@this.line = 1;
	@this.column = 1;
};

fn Lexer::peek(Lexer& this, usize distance) -> char {
	var text = this.source->text();

	if (this.offset >= text.size() || distance >= text.size() - this.offset) {
		return 0;
	};

	return text.data()[this.offset + distance];
};

fn Lexer::advance(var Lexer& this) -> char {
	char value = this.peek(0);

	if (!value) {
		return 0;
	};

	@this.offset = this.offset + 1;

	if (value == '\n') {
		@this.line = this.line + 1;
		@this.column = 1;
	}
	else {
		@this.column = this.column + 1;
	};

	return value;
};

fn Lexer::location(Lexer& this) -> Token {
	Token token;
	@token.source = this.source;
	@token.begin = this.offset;
	@token.line = this.line;
	@token.column = this.column;

	return $token;
};

fn Lexer::fail(var Lexer& this, Token& token, rt::string_view& message) -> bool {
	@this.failure = rt::string_view(message);
	@this.failure_token = Token(token);
	usize size = this.source->text().size();
	if (token.begin <= size) {
		usize consumed = 0;
		if (this.offset >= token.begin) {
			@consumed = this.offset - token.begin;
		};
		if (consumed > this.failure_token.length) {
			@this.failure_token.length = consumed;
		};
		if (!this.failure_token.length && token.begin < size) {
			@this.failure_token.length = 1;
		};
		if (this.failure_token.length > size - token.begin) {
			@this.failure_token.length = size - token.begin;
		};
		if (token.begin == size) {
			@this.failure_token.kind = token_kind::eof;
		};
	};

	return false;
};

fn Lexer::error(Lexer& this) -> rt::string_view {
	return rt::string_view(this.failure);
};

fn Lexer::error_token(Lexer& this) -> Token {
	return Token(this.failure_token);
};

fn Lexer::identifier_start(char value) -> bool {
	return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || value == '_';
};

fn Lexer::digit(char value) -> bool {
	return value >= '0' && value <= '9';
};

fn Lexer::identifier_kind(rt::string_view& spelling) -> token_kind {
	if (spelling == rt::string_view("fn", 2)) {
		return token_kind::kw_fn;
	};

	if (spelling == rt::string_view("using", 5)) {
		return token_kind::kw_using;
	};

	if (spelling == rt::string_view("const", 5)) {
		return token_kind::kw_const;
	};

	if (spelling == rt::string_view("discard", 7)) {
		return token_kind::kw_discard;
	};

	if (spelling == rt::string_view("delete", 6)) {
		return token_kind::kw_delete;
	};

	if (spelling == rt::string_view("new", 3)) {
		return token_kind::kw_new;
	};

	if (spelling == rt::string_view("implicit", 8)) {
		return token_kind::kw_implicit;
	};

	if (spelling == rt::string_view("nullptr", 7)) {
		return token_kind::kw_nullptr;
	};

	if (spelling == rt::string_view("template", 8)) {
		return token_kind::kw_template;
	};

	if (spelling == rt::string_view("typename", 8)) {
		return token_kind::kw_typename;
	};

	if (spelling == rt::string_view("class", 5)) {
		return token_kind::kw_class;
	};

	if (spelling == rt::string_view("var", 3)) {
		return token_kind::kw_var;
	};

	if (spelling == rt::string_view("struct", 6)) {
		return token_kind::kw_struct;
	};

	if (spelling == rt::string_view("union", 5)) {
		return token_kind::kw_union;
	};

	if (spelling == rt::string_view("enum", 4)) {
		return token_kind::kw_enum;
	};

	if (spelling == rt::string_view("namespace", 9)) {
		return token_kind::kw_namespace;
	};

	if (spelling == rt::string_view("virtual", 7)) {
		return token_kind::kw_virtual;
	};

	if (spelling == rt::string_view("override", 8)) {
		return token_kind::kw_override;
	};

	if (spelling == rt::string_view("final", 5)) {
		return token_kind::kw_final;
	};

	if (spelling == rt::string_view("return", 6)) {
		return token_kind::kw_return;
	};

	if (spelling == rt::string_view("if", 2)) {
		return token_kind::kw_if;
	};

	if (spelling == rt::string_view("else", 4)) {
		return token_kind::kw_else;
	};

	if (spelling == rt::string_view("while", 5)) {
		return token_kind::kw_while;
	};

	if (spelling == rt::string_view("for", 3)) {
		return token_kind::kw_for;
	};

	if (spelling == rt::string_view("switch", 6)) {
		return token_kind::kw_switch;
	};

	if (spelling == rt::string_view("case", 4)) {
		return token_kind::kw_case;
	};

	if (spelling == rt::string_view("default", 7)) {
		return token_kind::kw_default;
	};

	if (spelling == rt::string_view("break", 5)) {
		return token_kind::kw_break;
	};

	if (spelling == rt::string_view("continue", 8)) {
		return token_kind::kw_continue;
	};

	if (spelling == rt::string_view("sizeof", 6)) {
		return token_kind::kw_sizeof;
	};

	return token_kind::identifier;
};

fn Lexer::trivia(var Lexer& this) -> bool {
	while (true) {
		char value = this.peek(0);

		if (value == ' ' || value == '\t' || value == '\r' || value == '\n') {
			@this.advance();
			continue;
		};

		if (value != '/') {
			break;
		};

		if (this.peek(1) == '/') {
			while (this.peek(0) && this.peek(0) != '\n') {
				@this.advance();
			};

			continue;
		};

		if (this.peek(1) != '*') {
			break;
		};

		var start = this.location();
		@this.advance();
		@this.advance();

		while (true) {
			if (!this.peek(0)) {
				return @this.fail(start, rt::string_view("unterminated comment", 20));
			};

			if (this.peek(0) == '*' && this.peek(1) == '/') {
				@this.advance();
				@this.advance();
				break;
			};

			@this.advance();
		};
	};

	return true;
};

fn Lexer::number(var Lexer& this, Token& token) -> bool {
	while (Lexer::digit(this.peek(0))) {
		@this.advance();
	};

	if (this.peek(0) == '.' && Lexer::digit(this.peek(1))) {
		@this.advance();

		while (Lexer::digit(this.peek(0))) {
			@this.advance();
		};
	};

	if (this.peek(0) != 'e' && this.peek(0) != 'E') {
		return true;
	};

	@this.advance();

	if (this.peek(0) == '+' || this.peek(0) == '-') {
		@this.advance();
	};

	if (!Lexer::digit(this.peek(0))) {
		return @this.fail(token, rt::string_view("expected exponent digits", 24));
	};

	while (Lexer::digit(this.peek(0))) {
		@this.advance();
	};

	return true;
};

fn Lexer::quoted(var Lexer& this, Token& token, char quote) -> bool {
	@this.advance();

	if (quote == '\'') {
		char value = @this.advance();

		if (!value || value == '\'' || value == '\n' || value == '\r') {
			return @this.fail(token, rt::string_view("expected one character in literal", 33));
		};

		if (value == '\\') {
			char escaped = @this.advance();

			if (!escaped || escaped == '\n' || escaped == '\r') {
				return @this.fail(token, rt::string_view("unterminated character escape", 29));
			};
		};

		if (@this.advance() != '\'') {
			return @this.fail(token, rt::string_view("expected closing quote after character", 38));
		};

		return true;
	};

	while (this.peek(0) != '"') {
		if (!this.peek(0)) {
			return @this.fail(token, rt::string_view("unterminated string literal", 27));
		};

		if (this.peek(0) == '\n') {
			return @this.fail(token, rt::string_view("newline in string literal", 25));
		};

		if (@this.advance() == '\\' && this.peek(0)) {
			@this.advance();
		};
	};

	@this.advance();

	return true;
};

fn Lexer::symbol(var Lexer& this, var Token& token) -> bool {
	usize width = 1;
	char next = this.peek(1);

	switch (this.peek(0)) {
		case '(':
			@token.kind = token_kind::punct_left_paren;
			break;
		case ')':
			@token.kind = token_kind::punct_right_paren;
			break;
		case '[':
			@token.kind = token_kind::punct_left_bracket;
			break;
		case ']':
			@token.kind = token_kind::punct_right_bracket;
			break;
		case '{':
			@token.kind = token_kind::punct_left_brace;
			break;
		case '}':
			@token.kind = token_kind::punct_right_brace;
			break;
		case ';':
			@token.kind = token_kind::punct_semicolon;
			break;
		case ',':
			@token.kind = token_kind::punct_comma;
			break;
		case '+':
			@token.kind = token_kind::op_plus;
			break;
		case '*':
			@token.kind = token_kind::op_star;
			break;
		case '/':
			@token.kind = token_kind::op_slash;
			break;
		case '%':
			@token.kind = token_kind::op_remainder;
			break;
		case '^':
			@token.kind = token_kind::op_caret;
			break;
		case '~':
			@token.kind = token_kind::op_tilde;
			break;
		case '@':
			@token.kind = token_kind::op_access;
			break;
		case '$':
			@token.kind = token_kind::op_relocate;
			break;
		case ':':
			@token.kind = token_kind::punct_colon;

			if (next == ':') {
				@token.kind = token_kind::op_scope;
				@width = 2;
			};

			if (next == '=') {
				@token.kind = token_kind::op_copy;
				@width = 2;
			};

			break;
		case '-':
			@token.kind = token_kind::op_minus;

			if (next == '>') {
				@token.kind = token_kind::op_arrow;
				@width = 2;
			};

			break;
		case '=':
			@token.kind = token_kind::op_assign;

			if (next == '=') {
				@token.kind = token_kind::op_equal;
				@width = 2;
			};

			break;
		case '!':
			@token.kind = token_kind::op_bang;

			if (next == '=') {
				@token.kind = token_kind::op_not_equal;
				@width = 2;
			};

			break;
		case '<':
			@token.kind = token_kind::op_less;

			if (next == '=') {
				@token.kind = token_kind::op_less_equal;
				@width = 2;
			};

			if (next == '<') {
				@token.kind = token_kind::op_shift_left;
				@width = 2;
			};

			break;
		case '>':
			@token.kind = token_kind::op_greater;

			if (next == '=') {
				@token.kind = token_kind::op_greater_equal;
				@width = 2;
			};

			if (next == '>') {
				@token.kind = token_kind::op_shift_right;
				@width = 2;
			};

			break;
		case '&':
			@token.kind = token_kind::op_ampersand;

			if (next == '&') {
				@token.kind = token_kind::op_and;
				@width = 2;
			};

			break;
		case '|':
			@token.kind = token_kind::op_pipe;

			if (next == '|') {
				@token.kind = token_kind::op_or;
				@width = 2;
			};

			break;
		case '.':
			@token.kind = token_kind::op_dot;

			if (next == '.' && this.peek(2) == '.') {
				@token.kind = token_kind::punct_ellipsis;
				@width = 3;
			};

			break;
		default:
			return @this.fail(token, rt::string_view("unknown source character", 24));
	};

	usize consumed = 0;

	while (consumed < width) {
		@this.advance();
		@consumed = consumed + 1;
	};

	return true;
};

fn Lexer::scan(var Lexer& this) -> bool {
	@this.offset = 0;
	@this.line = 1;
	@this.column = 1;
	@this.failure = rt::string_view();
	@this.failure_token = Token();
	@this.source->clear_tokens();

	while (true) {
		if (!@this.trivia()) {
			return false;
		};

		var token = this.location();
		char value = this.peek(0);

		if (!value) {
			if (this.offset < this.source->text().size()) {
				return @this.fail(token, rt::string_view("NUL byte in source", 18));
			};

			@token.kind = token_kind::eof;
		}
		else if (Lexer::identifier_start(value)) {
			while (Lexer::identifier_start(this.peek(0)) || Lexer::digit(this.peek(0))) {
				@this.advance();
			};

			@token.length = this.offset - token.begin;
			@token.kind = Lexer::identifier_kind(token.text());
		}
		else if (Lexer::digit(value)) {
			@token.kind = token_kind::literal_number;

			if (!@this.number(token)) {
				return false;
			};
		}
		else if (value == '"' || value == '\'') {
			@token.kind = token_kind::literal_string;

			if (value == '\'') {
				@token.kind = token_kind::literal_number;
			};

			if (!@this.quoted(token, value)) {
				return false;
			};
		}
		else {
			if (!@this.symbol(@token)) {
				return false;
			};
		};

		@token.length = this.offset - token.begin;

		if (!@this.source->append_token(Token(token))) {
			return @this.fail(token, rt::string_view("token storage allocation failed", 31));
		};

		if (token.kind == token_kind::eof) {
			break;
		};
	};

	return true;
};

enum syntax_kind : [i32] {
	absent;
	error_expression;
	noop;
	unit;
	name;
	number;
	string;
	null_pointer;
	unary;
	grouping;
	binary;
	call;
	member;
	index;
	brace;
	array;
	conditional;
	while_loop;
	for_loop;
	return_value;
	break_loop;
	continue_loop;
	discard_value;
	allocation;
	deallocation;
	array_deallocation;
	switch_expression;
	case_label;
	sizeof_type;
	cast;
	variable;
	parameter;
	function;
	record;
	enumeration;
	enumerator;
	namespace_body;
	template_declaration;
	template_parameter;
	using_alias;
	list;
	attributes;
	ambiguity;
	type_name;
	type_pointer;
	type_reference;
	type_array;
	type_function;
	type_const;
	type_mutable;
	type_auto;
	access_label;
	qualified_name;
	conversion_name;
	operator_name;
	operator_array;
	template_apply;
};

// Syntax owns source structure. Resolved entities and types belong to semantic analysis.
// Slots are explicit: absent has no source expression; noop denotes the token ';'.
// Fixed shapes are constructed in grammar order and checked before publication:
// variable = [name, type, initializer], parameter = [name, type, default]
// function = [name, parameters, result, attributes, body]
// record = [name, bases, members], enumeration = [name, underlying, members]
// conditional = [condition, body, alternative], while/switch = [condition, body]
// for = [initializer, condition, step, body], call = [callable, arguments]
// namespace/template = [name-or-parameters, body-or-declaration]
// indirect type = [element], array type = [element, extent]
// function type = [parameters, result], const type = [element, condition]
// Lists, brace expressions, units, and attributes own a sequence of children.
// Ambiguity owns complete source interpretations, never borrowed alternatives.

struct Syntax {
	fn Syntax(var Syntax& this, syntax_kind kind, Token& token);
	fn Syntax(var Syntax& this, Syntax& other) : [delete];
	fn Syntax(var Syntax& this, Syntax other) : [default];

	fn operator=(var Syntax& this, Syntax& other) -> var Syntax& : [delete];
	fn operator=(var Syntax& this, Syntax other) -> var Syntax& : [default];
	fn append(var Syntax& this, rt::unique<Syntax> child) -> bool;

	fn kind(Syntax& this) -> syntax_kind;
	fn explicitly_qualified(Syntax& this) -> bool;
	fn token(Syntax& this) -> Token;
	fn size(Syntax& this) -> usize;
	fn item(Syntax& this, usize index) -> var Syntax*;
	fn complete(Syntax& this) -> bool;
	fn fixed_arity(Syntax& this) -> usize;

private:
	syntax_kind category;
	Token location;
	rt::buffer<rt::unique<Syntax>> children;
};

fn Syntax::Syntax(var Syntax& this, syntax_kind kind, Token& token) {
	@this.category = $kind;
	@this.location := token;
};

fn Syntax::kind(Syntax& this) -> syntax_kind {
	return syntax_kind(this.category);
};

fn Syntax::explicitly_qualified(Syntax& this) -> bool {
	return this.category == syntax_kind::type_const || this.category == syntax_kind::type_mutable || this.category == syntax_kind::type_auto;
};

fn Syntax::token(Syntax& this) -> Token {
	return Token(this.location);
};

fn Syntax::size(Syntax& this) -> usize {
	return this.children.size();
};

fn Syntax::item(Syntax& this, usize index) -> var Syntax* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn Syntax::append(var Syntax& this, rt::unique<Syntax> child) -> bool {
	if (!child.get() || this.children.size() >= this.fixed_arity()) {
		return false;
	};

	return @this.children.push_back($child);
};

fn Syntax::operand(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::left(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::right(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::callable(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::arguments(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::member_object(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::member_name(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::index_object(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::index_value(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::condition(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::body(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alternative(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_initializer(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::for_condition(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::for_step(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::for_body(Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::variable_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::variable_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::variable_initializer(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::parameter_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::parameter_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::parameter_default(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_parameters(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_result(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::function_attributes(Syntax& this) -> var Syntax* {
	return this.item(3);
};

fn Syntax::function_body(Syntax& this) -> var Syntax* {
	return this.item(4);
};

fn Syntax::record_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::record_bases(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::record_members(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::enum_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enum_underlying(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::enum_members(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::namespace_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::namespace_members(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameters(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_declaration(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::alias_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::alias_type(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::cast_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::cast_operand(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::allocation_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::allocation_arguments(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::designated_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::array_extent(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::function_type_parameters(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::function_type_result(Syntax& this) -> var Syntax* {
	return this.item(1);
};

// TypeSyntax is a borrowed view of the owned syntax subtree for a type-id.

struct TypeSyntax {
	fn TypeSyntax(var TypeSyntax& this, var Syntax* syntax);

	fn kind(TypeSyntax& this) -> syntax_kind;
	fn element(TypeSyntax& this) -> var Syntax*;
	fn extent(TypeSyntax& this) -> var Syntax*;
	fn parameters(TypeSyntax& this) -> var Syntax*;
	fn result(TypeSyntax& this) -> var Syntax*;

private:
	var Syntax* syntax;
};

fn TypeSyntax::TypeSyntax(var TypeSyntax& this, var Syntax* syntax) {
	@this.syntax = $syntax;
};

fn TypeSyntax::kind(TypeSyntax& this) -> syntax_kind {
	return this.syntax->kind();
};

fn TypeSyntax::element(TypeSyntax& this) -> var Syntax* {
	return this.syntax->designated_type();
};

fn TypeSyntax::extent(TypeSyntax& this) -> var Syntax* {
	return this.syntax->array_extent();
};

fn TypeSyntax::parameters(TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_parameters();
};

fn TypeSyntax::result(TypeSyntax& this) -> var Syntax* {
	return this.syntax->function_type_result();
};

fn Syntax::qualifier_condition(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::same_tree(Syntax& this, Syntax& other) -> bool {
	if (this.kind() != other.kind() || this.token().source != other.token().source || this.token().begin != other.token().begin || this.token().length != other.token().length || this.size() != other.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.size()) {
		if (!this.item(index)->same_tree(*other.item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::take_item(var Syntax& this, usize index) -> rt::unique<Syntax> {
	if (index >= this.children.size()) {
		return rt::unique<Syntax>();
	};

	return rt::unique<Syntax>(@((@this.children).data()[index]).release());
};

fn Syntax::fixed_arity(Syntax& this) -> usize {
	switch (this.category) {
		case syntax_kind::error_expression:
		case syntax_kind::absent:
		case syntax_kind::noop:
		case syntax_kind::name:
		case syntax_kind::number:
		case syntax_kind::string:
		case syntax_kind::null_pointer:
		case syntax_kind::break_loop:
		case syntax_kind::continue_loop:
		case syntax_kind::access_label:
		case syntax_kind::operator_array:
			return 0;
		case syntax_kind::unary:
		case syntax_kind::grouping:
		case syntax_kind::return_value:
		case syntax_kind::discard_value:
		case syntax_kind::deallocation:
		case syntax_kind::array_deallocation:
		case syntax_kind::sizeof_type:
		case syntax_kind::conversion_name:
		case syntax_kind::type_name:
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_auto:
		case syntax_kind::array:
			return 1;
		case syntax_kind::binary:
		case syntax_kind::call:
		case syntax_kind::member:
		case syntax_kind::index:
		case syntax_kind::while_loop:
		case syntax_kind::switch_expression:
		case syntax_kind::cast:
		case syntax_kind::allocation:
		case syntax_kind::namespace_body:
		case syntax_kind::template_declaration:
		case syntax_kind::using_alias:
		case syntax_kind::enumerator:
		case syntax_kind::type_array:
		case syntax_kind::type_function:
		case syntax_kind::type_const:
		case syntax_kind::type_mutable:
		case syntax_kind::qualified_name:
		case syntax_kind::template_apply:
		case syntax_kind::operator_name:
			return 2;
		case syntax_kind::conditional:
		case syntax_kind::variable:
		case syntax_kind::parameter:
		case syntax_kind::record:
		case syntax_kind::enumeration:
		case syntax_kind::template_parameter:
			return 3;
		case syntax_kind::for_loop:
			return 4;
		case syntax_kind::function:
			return 5;
		case syntax_kind::case_label:
			return 1;
		default:
			return usize::max;
	};
};

fn Syntax::complete(Syntax& this) -> bool {
	usize arity = this.fixed_arity();

	if (arity != usize::max && this.children.size() != arity) {
		return false;
	};

	if (this.category == syntax_kind::ambiguity && this.children.size() < 2) {
		return false;
	};

	usize index = 0;

	while (index < this.children.size()) {
		if (!this.item(index) || !this.item(index)->complete()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Syntax::case_value(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_name(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::enumerator_value(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_name(Syntax& this) -> var Syntax* {
	return this.item(1);
};

fn Syntax::template_parameter_type(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::template_parameter_default(Syntax& this) -> var Syntax* {
	return this.item(2);
};

fn Syntax::operator_target(Syntax& this) -> var Syntax* {
	return this.item(0);
};

fn Syntax::operator_token(Syntax& this) -> Token {
	return this.item(0)->token();
};

fn Syntax::operator_suffix(Syntax& this) -> var Syntax* {
	return this.item(1);
};

enum parse_mode : [u08] {
	strict;
	editor;
};

struct ParseIssue {
	Token location;
	rt::string message;
};

enum name_role : [u08] {
	designator;
	value;
};

struct ParseChoices {
	rt::buffer<usize> operators;

	fn contains(ParseChoices& this, usize position) -> bool;
	fn extended(ParseChoices& this, usize position) -> rt::unique<ParseChoices>;
	fn same(ParseChoices& this, ParseChoices& other) -> bool;
};

struct Parser {
	fn Parser(var Parser& this, rt::buffer<Token>& tokens);

	fn parse(var Parser& this) -> rt::unique<Syntax>;
	fn parse_editor(var Parser& this) -> rt::unique<Syntax>;
	fn issues(Parser& this) -> rt::buffer<ParseIssue>&;
	fn set_cancellation(var Parser& this, ((var void*) -> i32)* callback, var void* context);

	fn error(Parser& this) -> rt::string_view;
	fn error_token(Parser& this) -> Token;

private:
	rt::buffer<Token>* tokens;
	usize offset;
	parse_mode mode;
	rt::buffer<ParseIssue> recovery_issues;
	usize pending_greater;
	ParseChoices* selections;
	var rt::buffer<usize>* discoveries;
	((var void*) -> i32)* cancellation;
	var void* cancellation_context;
	fn cancelled(var Parser& this) -> bool;
	fn parse_impl(var Parser& this) -> rt::unique<Syntax>;
	fn recovery_boundary(Parser& this) -> bool;
	fn synchronize(var Parser& this, usize start);
	fn collect_issues(var Parser& this, Syntax& syntax) -> bool;
	rt::string_view failure;
	Token failure_location;

	fn peek(Parser& this) -> Token;
	fn take(var Parser& this) -> Token;
	fn accept(var Parser& this, token_kind& kind) -> bool;
	fn require(var Parser& this, token_kind& kind, rt::string_view& message) -> bool;
	fn fail(var Parser& this, rt::string_view& message);

	fn node(var Parser& this, syntax_kind kind, Token& token) -> rt::unique<Syntax>;
	fn absent(var Parser& this) -> rt::unique<Syntax>;
	fn add(var Parser& this, var Syntax& parent, rt::unique<Syntax> child) -> bool;
	fn factor(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn factor_group(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax>;
	fn alternative_add(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> bool;

	fn expression(var Parser& this, i32 minimum) -> rt::unique<Syntax>;
	fn primary(var Parser& this) -> rt::unique<Syntax>;
	fn postfix(var Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax>;
	fn sequence(var Parser& this, Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax>;
	fn arguments(var Parser& this, token_kind close) -> rt::unique<Syntax>;

	fn type(var Parser& this) -> rt::unique<Syntax>;
	fn close_template(var Parser& this) -> bool;
	fn name_part(var Parser& this, name_role& role) -> rt::unique<Syntax>;
	fn name_in(var Parser& this, name_role& role) -> rt::unique<Syntax>;
	fn name(var Parser& this) -> rt::unique<Syntax>;
	fn precedence(token_kind& kind) -> i32;

	fn statement_one(var Parser& this) -> rt::unique<Syntax>;
	fn statement(var Parser& this) -> rt::unique<Syntax>;
	fn variable(var Parser& this) -> rt::unique<Syntax>;
	fn parameters(var Parser& this) -> rt::unique<Syntax>;
	fn function(var Parser& this) -> rt::unique<Syntax>;
	fn record(var Parser& this) -> rt::unique<Syntax>;
	fn enumeration(var Parser& this) -> rt::unique<Syntax>;
	fn namespace_body(var Parser& this) -> rt::unique<Syntax>;
	fn template_declaration(var Parser& this) -> rt::unique<Syntax>;
	fn control(var Parser& this) -> rt::unique<Syntax>;
};

fn Parser::Parser(var Parser& this, rt::buffer<Token>& tokens) {
	@this.tokens = &@tokens;
};

fn Parser::set_cancellation(var Parser& this, ((var void*) -> i32)* callback, var void* context) {
	@this.cancellation = $callback;
	@this.cancellation_context = $context;
};

fn Parser::cancelled(var Parser& this) -> bool {
	if (this.cancellation && this.cancellation(this.cancellation_context)) {
		@this.fail(rt::string_view("analysis cancelled", 18));
		return true;
	};
	return false;
};

fn Parser::error(Parser& this) -> rt::string_view {
	if (this.failure.empty()) {
		return rt::string_view();
	};

	return this.failure;
};

fn Parser::error_token(Parser& this) -> Token {
	return Token(this.failure_location);
};

fn Parser::peek(Parser& this) -> Token {
	if (this.pending_greater) {
		Token remainder := this.tokens->data()[this.offset - 1];
		@remainder.kind = token_kind::op_greater;
		@remainder.begin = remainder.begin + 1;
		@remainder.length = 1;

		return $remainder;
	};

	if (this.offset < this.tokens->size()) {
		return Token(this.tokens->data()[this.offset]);
	};

	Token token;
	@token.kind = token_kind::eof;

	return $token;
};

fn Parser::take(var Parser& this) -> Token {
	Token token = this.peek();

	if (this.pending_greater) {
		@this.pending_greater = this.pending_greater - 1;

		return $token;
	};

	if (token.kind != token_kind::eof) {
		@this.offset = this.offset + 1;
	};

	return $token;
};

fn Parser::accept(var Parser& this, token_kind& kind) -> bool {
	if (this.peek().kind != kind) {
		return false;
	};

	@this.take();

	return true;
};

fn Parser::require(var Parser& this, token_kind& kind, rt::string_view& message) -> bool {
	if (@this.accept(kind)) {
		return true;
	};

	if (this.mode == parse_mode::editor && kind == token_kind::punct_semicolon && (this.peek().kind == token_kind::eof || this.peek().kind == token_kind::punct_right_brace)) {
		return true;
	};
	@this.fail(message);
	return false;
};

fn Parser::fail(var Parser& this, rt::string_view& message) {
	if (this.failure.empty()) {
		@this.failure := message;
		@this.failure_location = this.peek();
	};
};

fn Parser::node(var Parser& this, syntax_kind kind, Token& token) -> rt::unique<Syntax> {
	var result = rt::unique<Syntax>(new var Syntax($kind, token));

	if (!result.get()) {
		@this.fail(rt::string_view("syntax allocation failed", 24));
	};

	return $result;
};

fn Parser::absent(var Parser& this) -> rt::unique<Syntax> {
	return @this.node(syntax_kind::absent, this.peek());
};

fn Parser::add(var Parser& this, var Syntax& parent, rt::unique<Syntax> child) -> bool {
	if (!child.get()) {
		return false;
	};

	if (!@parent.append($child)) {
		@this.fail(rt::string_view("syntax allocation failed", 24));
		return false;
	};

	return true;
};

fn Parser::precedence(token_kind& kind) -> i32 {
	switch (kind) {
		case token_kind::op_assign:
		case token_kind::op_copy:
			return 1;
		case token_kind::op_or:
			return 2;
		case token_kind::op_and:
			return 3;
		case token_kind::op_pipe:
			return 4;
		case token_kind::op_caret:
			return 5;
		case token_kind::op_ampersand:
			return 6;
		case token_kind::op_equal:
		case token_kind::op_not_equal:
			return 7;
		case token_kind::op_less:
		case token_kind::op_greater:
		case token_kind::op_less_equal:
		case token_kind::op_greater_equal:
			return 8;
		case token_kind::op_shift_left:
		case token_kind::op_shift_right:
			return 9;
		case token_kind::op_plus:
		case token_kind::op_minus:
			return 10;
		case token_kind::op_star:
		case token_kind::op_slash:
		case token_kind::op_remainder:
			return 11;
		default:
			return 0;
	};
};

fn Parser::issues(Parser& this) -> rt::buffer<ParseIssue>& {
	return this.recovery_issues;
};

fn Parser::parse_editor(var Parser& this) -> rt::unique<Syntax> {
	var strict = @this.parse();

	if (strict.get() || @this.cancelled() || !this.error().compare(rt::string_view("syntax allocation failed", 24)) || !this.error().compare(rt::string_view("parse alternatives storage is unavailable", 41))) {
		return $strict;
	};

	ParseIssue first_issue;
	@first_issue.location := this.failure_location;
	@first_issue.message = rt::string(this.error());

	if (!@this.recovery_issues.push_back($first_issue)) {
		return rt::unique<Syntax>();
	};
	@this.offset = 0;
	@this.pending_greater = 0;
	@this.failure = rt::string_view();
	@this.mode = parse_mode::editor;
	var result = @this.parse_impl();

	if (result.get() && !@this.collect_issues(*result.get())) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::recovery_boundary(Parser& this) -> bool {
	token_kind kind = this.peek().kind;
	return kind == token_kind::punct_semicolon || kind == token_kind::punct_right_brace || kind == token_kind::punct_right_paren || kind == token_kind::punct_right_bracket || kind == token_kind::punct_comma || kind == token_kind::eof;
};

fn Parser::synchronize(var Parser& this, usize start) {
	@this.offset = start;
	@this.pending_greater = 0;
	usize braces = 0;

	while (this.peek().kind != token_kind::eof) {
		if (@this.cancelled()) {
			return;
		};
		token_kind kind = this.peek().kind;

		if (!braces && kind == token_kind::punct_right_brace) {
			break;
		};
		if (!braces && this.offset > start && (kind == token_kind::kw_fn || kind == token_kind::kw_struct || kind == token_kind::kw_class || kind == token_kind::kw_namespace || kind == token_kind::kw_template)) {
			break;
		};

		@this.take();

		if (kind == token_kind::punct_left_brace) {
			@braces = braces + 1;
		}
		else if (kind == token_kind::punct_right_brace && braces) {
			@braces = braces - 1;
		}
		else if (kind == token_kind::punct_semicolon && !braces) {
			break;
		};
	};
};

fn Parser::collect_issues(var Parser& this, Syntax& syntax) -> bool {
	if (@this.cancelled()) {
		return false;
	};
	rt::string_view message;

	if (syntax.kind() == syntax_kind::error_expression) {
		@message = rt::string_view("incomplete expression or declaration", 36);
	}
	else if ((syntax.kind() == syntax_kind::member || syntax.kind() == syntax_kind::qualified_name) && syntax.item(1)->kind() == syntax_kind::absent) {
		@message = rt::string_view("expected a member name after the access operator", 48);
	};

	if (!message.empty()) {
		Token token = syntax.token();
		usize index = 0;

		while (index < this.recovery_issues.size() && (this.recovery_issues.data()[index].location.source != token.source || this.recovery_issues.data()[index].location.begin != token.begin)) {
			@index = index + 1;
		};
		if (index == this.recovery_issues.size()) {
			ParseIssue issue;
			@issue.location := token;
			@issue.message = rt::string(message);

			if (!@this.recovery_issues.push_back($issue)) {
				return false;
			};
		};
	};

	usize index = 0;

	while (index < syntax.size()) {
		if (!@this.collect_issues(*syntax.item(index))) {
			return false;
		};
		@index = index + 1;
	};
	return true;
};

fn Parser::parse(var Parser& this) -> rt::unique<Syntax> {
	@this.mode = parse_mode::strict;
	return @this.parse_impl();
};

fn Parser::parse_impl(var Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::unit, this.peek());

	while (this.peek().kind != token_kind::eof && this.failure.empty()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		usize before = this.offset;

		if (!@this.add(@*result.get(), @this.statement())) {
			break;
		};

		if (this.offset == before) {
			if (this.mode == parse_mode::editor && this.peek().kind != token_kind::eof) {
				@this.take();
				continue;
			};
			@this.fail(rt::string_view("parser did not consume a declaration", 36));
		};
	};

	if (this.failure.empty() && !result.get()->complete()) {
		@this.fail(rt::string_view("incomplete syntax structure", 27));
	};

	if (!this.failure.empty()) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::sequence(var Parser& this, Token& opening, token_kind close, syntax_kind kind) -> rt::unique<Syntax> {
	var result = @this.node($kind, opening);

	while (this.peek().kind != close && this.peek().kind != token_kind::eof && this.failure.empty()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		usize before = this.offset;

		if (!@this.add(@*result.get(), @this.statement())) {
			return rt::unique<Syntax>();
		};
		if (this.offset == before) {
			if (this.mode == parse_mode::editor) {
				@this.take();
			}
			else {
				@this.fail(rt::string_view("parser did not consume a statement", 34));
			};
		};
	};

	if (this.mode == parse_mode::editor && this.peek().kind == token_kind::eof) {
		@this.add(@*result.get(), @this.node(syntax_kind::error_expression, this.peek()));
		return $result;
	};

	if (!@this.require($close, rt::string_view("expected closing delimiter", 26))) {
		return rt::unique<Syntax>();
	};

	return $result;
};

fn Parser::arguments(var Parser& this, token_kind close) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(close)) {
		return $result;
	};

	while (this.failure.empty()) {
		var argument = rt::unique<Syntax>();

		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			@argument = @this.node(syntax_kind::error_expression, this.peek());
		}
		else {
			@argument = @this.expression(1);
		};
		if (!@this.add(@*result.get(), $argument)) {
			return rt::unique<Syntax>();
		};

		if (@this.accept(close)) {
			return $result;
		};

		if (this.mode == parse_mode::editor && @this.recovery_boundary() && this.peek().kind != token_kind::punct_comma) {
			@this.add(@*result.get(), @this.node(syntax_kind::error_expression, this.peek()));
			return $result;
		};

		if (!@this.require(token_kind::punct_comma, rt::string_view("expected ',' between arguments", 30))) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::close_template(var Parser& this) -> bool {
	if (@this.accept(token_kind::op_greater)) {
		return true;
	};

	if (@this.accept(token_kind::op_shift_right)) {
		@this.pending_greater = 1;

		return true;
	};

	@this.fail(rt::string_view("expected '>' after template arguments", 37));
	return false;
};

fn Parser::name_part(var Parser& this, name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();

	if (@this.accept(token_kind::op_tilde)) {
		var destructor = @this.node(syntax_kind::unary, first);
		Token identifier = this.peek();
		@this.require(token_kind::identifier, rt::string_view("expected destructor type name", 29));
		@this.add(@*destructor.get(), @this.node(syntax_kind::name, $identifier));

		return $destructor;
	};

	if (!@this.require(token_kind::identifier, rt::string_view("expected identifier", 19))) {
		return rt::unique<Syntax>();
	};

	var conversion_type = @this.absent();
	var operator_symbol = @this.absent();
	var operator_suffix = @this.absent();

	if (first.is(rt::string_view("operator", 8))) {
		usize beginning = this.offset;
		Token operation = @this.take();
		@operator_symbol = @this.node(syntax_kind::name, operation);

		if (operation.kind == token_kind::punct_left_paren) {
			@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' in operator name", 29));
		}
		else if (operation.kind == token_kind::punct_left_bracket) {
			@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' in operator name", 29));
		}
		else if ((operation.kind == token_kind::kw_new || operation.kind == token_kind::kw_delete) && @this.accept(token_kind::punct_left_bracket)) {
			@operator_suffix = @this.node(syntax_kind::operator_array, this.peek());
			@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' in allocation operator name", 40));
		};

		if (operation.kind == token_kind::literal_string) {
			@operator_suffix = @this.node(syntax_kind::name, this.peek());
			@this.require(token_kind::identifier, rt::string_view("expected literal operator suffix", 32));
		}
		else if (operation.kind == token_kind::identifier || operation.kind == token_kind::kw_var || operation.kind == token_kind::kw_const) {
			var conversion = Parser(*this.tokens);
		@conversion.set_cancellation(this.cancellation, this.cancellation_context);
	@conversion.mode = this.mode;
			@conversion.offset = beginning;
			var target = @conversion.type();

			if (target.get() && conversion.failure.empty()) {
				@conversion_type = $target;
				@this.offset = conversion.offset;
				@this.pending_greater = conversion.pending_greater;

			};
		};

		Token end := this.tokens->data()[this.offset - 1];
		@first.length = end.begin + end.length - first.begin;
	};

	syntax_kind category = syntax_kind::name;

	if (operator_symbol.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::operator_name;
	};

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		@category = syntax_kind::conversion_name;
	};

	var result = @this.node($category, first);

	if (conversion_type.get()->kind() != syntax_kind::absent) {
		@this.add(@*result.get(), rt::unique<Syntax>(@conversion_type.release()));
	}
	else if (operator_symbol.get()->kind() != syntax_kind::absent) {
		@this.add(@*result.get(), rt::unique<Syntax>(@operator_symbol.release()));
		@this.add(@*result.get(), rt::unique<Syntax>(@operator_suffix.release()));
	};

	if (this.peek().kind != token_kind::op_less) {
		return $result;
	};

	var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
	@candidate.offset = this.offset;
	@candidate.pending_greater = this.pending_greater;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
	@candidate.take();
	var arguments = @candidate.node(syntax_kind::list, candidate.peek());

	while (candidate.failure.empty() && candidate.peek().kind != token_kind::op_greater && candidate.peek().kind != token_kind::op_shift_right) {
		var type_parser = Parser(*candidate.tokens);
		@type_parser.offset = candidate.offset;
		@type_parser.pending_greater = candidate.pending_greater;
	@type_parser.selections = candidate.selections;
	@type_parser.discoveries = candidate.discoveries;
		var type = @type_parser.type();
		var value_parser = Parser(*candidate.tokens);
		@value_parser.offset = candidate.offset;
		@value_parser.pending_greater = candidate.pending_greater;
	@value_parser.selections = candidate.selections;
	@value_parser.discoveries = candidate.discoveries;
		var value = @value_parser.expression(10);

		if (type.get() && type_parser.failure.empty() && (type_parser.peek().kind == token_kind::punct_comma || type_parser.peek().kind == token_kind::op_greater || type_parser.peek().kind == token_kind::op_shift_right)) {
			@candidate.offset = type_parser.offset;
			@candidate.pending_greater = type_parser.pending_greater;
	@candidate.selections = type_parser.selections;
	@candidate.discoveries = type_parser.discoveries;

			if (value.get() && value_parser.failure.empty() && value_parser.offset == type_parser.offset && value_parser.pending_greater == type_parser.pending_greater) {
				var alternatives = @candidate.node(syntax_kind::ambiguity, type.get()->token());
				@candidate.add(@*alternatives.get(), rt::unique<Syntax>(@type.release()));
				@candidate.add(@*alternatives.get(), rt::unique<Syntax>(@value.release()));
				@candidate.add(@*arguments.get(), rt::unique<Syntax>(@alternatives.release()));
			}
			else {
				@candidate.add(@*arguments.get(), rt::unique<Syntax>(@type.release()));
			};
		}
		else if (value.get() && value_parser.failure.empty()) {
			@candidate.offset = value_parser.offset;
			@candidate.pending_greater = value_parser.pending_greater;
	@candidate.selections = value_parser.selections;
	@candidate.discoveries = value_parser.discoveries;
			@candidate.add(@*arguments.get(), rt::unique<Syntax>(@value.release()));
		}
		else {
			@candidate.fail(rt::string_view("expected template argument", 26));
			break;
		};

		if (!@candidate.accept(token_kind::punct_comma)) {
			break;
		};
	};

	if (!@candidate.close_template() || !candidate.failure.empty()) {
		return $result;
	};

	if (role == name_role::value) {
		if (this.selections && this.selections->contains(usize(this.offset))) {
			return $result;
		};

		if (this.discoveries && !@this.discoveries->push_back(usize(this.offset))) {
			@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
			return rt::unique<Syntax>();
		};
	};

	var applied = @this.node(syntax_kind::template_apply, first);
	@this.add(@*applied.get(), rt::unique<Syntax>(@result.release()));
	@this.add(@*applied.get(), rt::unique<Syntax>(@arguments.release()));
	@this.offset = candidate.offset;
	@this.pending_greater = candidate.pending_greater;

	return $applied;
};

fn Parser::name(var Parser& this) -> rt::unique<Syntax> {
	return @this.name_in(name_role::designator);
};

fn Parser::name_in(var Parser& this, name_role& role) -> rt::unique<Syntax> {
	Token first = this.peek();
	var result = @this.name_part(role);

	while (this.peek().kind == token_kind::op_scope) {
		Token separator = @this.take();
		var path = @this.node(syntax_kind::qualified_name, first);
		if (this.mode == parse_mode::editor && this.peek().kind != token_kind::identifier && this.peek().kind != token_kind::kw_new && this.peek().kind != token_kind::kw_delete) {
			@path = @this.node(syntax_kind::qualified_name, separator);
			@this.add(@*path.get(), rt::unique<Syntax>(@result.release()));
			@this.add(@*path.get(), @this.absent());
		}
		else {
			@this.add(@*path.get(), rt::unique<Syntax>(@result.release()));
			@this.add(@*path.get(), @this.name_part(role));
		};
		@result = rt::unique<Syntax>(@path.release());
	};

	return $result;
};

fn Parser::type(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	bool automatic = start.kind == token_kind::identifier && start.is(rt::string_view("auto", 4));

	if (automatic) {
		@this.take();
	};

	bool qualified = @this.accept(token_kind::kw_const);
	bool mutable_type = false;
	if (!qualified) {
		@mutable_type = @this.accept(token_kind::kw_var);
		@qualified = mutable_type;
	};
	var condition = @this.absent();

	if (qualified && @this.accept(token_kind::punct_left_bracket)) {
		@condition = @this.expression(1);
		@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after qualifier condition", 38));
	};

	var result = @this.absent();

	if (@this.accept(token_kind::punct_left_paren)) {
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
	@candidate.selections = this.selections;
	@candidate.discoveries = this.discoveries;
		var parameters = @candidate.parameters();

		if (parameters.get() && candidate.failure.empty() && @candidate.accept(token_kind::op_arrow)) {
			@result = @this.node(syntax_kind::type_function, start);
			@this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
			@this.add(@*result.get(), @candidate.type());
			@this.offset = candidate.offset;
			@this.pending_greater = candidate.pending_greater;

			if (!candidate.failure.empty()) {
				@this.fail(candidate.failure);
			};
		}
		else {
			@result = @this.type();
			@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' after grouped type", 31));
		};
	}
	else if (this.peek().kind == token_kind::kw_struct || this.peek().kind == token_kind::kw_class || this.peek().kind == token_kind::kw_union) {
		@result = @this.record();
	}
	else {
		@result = @this.node(syntax_kind::type_name, start);

		if (!@this.add(@*result.get(), @this.name())) {
			return rt::unique<Syntax>();
		};
	};

	if (qualified) {
		syntax_kind qualifier_kind = syntax_kind::type_const;
		if (mutable_type) {
			@qualifier_kind = syntax_kind::type_mutable;
		};
		var constant = @this.node($qualifier_kind, start);
		@this.add(@*constant.get(), rt::unique<Syntax>(@result.release()));
		@this.add(@*constant.get(), rt::unique<Syntax>(@condition.release()));
		@result = $constant;
	};

	if (automatic) {
		var inferred = @this.node(syntax_kind::type_auto, start);
		@this.add(@*inferred.get(), rt::unique<Syntax>(@result.release()));
		@result = $inferred;
	};

	while (this.failure.empty()) {
		Token suffix = this.peek();
		bool mutable_pointer = suffix.kind == token_kind::kw_var;
		if (mutable_pointer) {
			@this.take();
			if (this.peek().kind != token_kind::op_star) {
				@this.fail(rt::string_view("a suffix var qualifier shall precede a pointer '*'; use a grouped type to qualify another type constructor", 106));
				return rt::unique<Syntax>();
			};
		};
		syntax_kind kind = syntax_kind::absent;

		if (@this.accept(token_kind::op_star)) {
			@kind = syntax_kind::type_pointer;
		}
		else if (@this.accept(token_kind::op_ampersand)) {
			@kind = syntax_kind::type_reference;
		}
		else if (@this.accept(token_kind::punct_left_bracket)) {
			var array = @this.node(syntax_kind::type_array, suffix);
			@this.add(@*array.get(), rt::unique<Syntax>(@result.release()));
			@this.add(@*array.get(), @this.expression(1));
			@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after array extent", 31));
			@result = rt::unique<Syntax>(@array.release());
			continue;
		}
		else {
			break;
		};

		var indirect = @this.node($kind, suffix);
		@this.add(@*indirect.get(), rt::unique<Syntax>(@result.release()));
		@result = rt::unique<Syntax>(@indirect.release());
		if (mutable_pointer) {
			var qualifier = @this.node(syntax_kind::type_mutable, suffix);
			@this.add(@*qualifier.get(), rt::unique<Syntax>(@result.release()));
			@this.add(@*qualifier.get(), @this.absent());
			@result = rt::unique<Syntax>(@qualifier.release());
		};
	};

	return $result;
};

fn Parser::expression(var Parser& this, i32 minimum) -> rt::unique<Syntax> {
	if (this.mode == parse_mode::editor && minimum > 1 && this.peek().kind == token_kind::punct_semicolon) {
		return @this.node(syntax_kind::error_expression, this.peek());
	};
	var left = @this.primary();

	if (!left.get()) {
		return $left;
	};

	@left = @this.postfix(rt::unique<Syntax>(@left.release()));

	while (this.failure.empty()) {
		Token operation = this.peek();
		i32 precedence = Parser::precedence(operation.kind);

		if (!precedence || precedence < minimum) {
			break;
		};

		@this.take();
		i32 next = precedence + 1;

		if (precedence == 1) {
			@next = precedence;
		};

		var binary = @this.node(syntax_kind::binary, operation);
		@this.add(@*binary.get(), rt::unique<Syntax>(@left.release()));

		var right = rt::unique<Syntax>();

		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			@right = @this.node(syntax_kind::error_expression, this.peek());
		}
		else {
			@right = @this.expression($next);
		};

		if (!@this.add(@*binary.get(), $right)) {
			return rt::unique<Syntax>();
		};

		@left = $binary;
	};

	return $left;
};

fn Parser::postfix(var Parser& this, rt::unique<Syntax> value) -> rt::unique<Syntax> {
	while (this.failure.empty()) {
		Token token = this.peek();

		if (@this.accept(token_kind::punct_left_paren)) {
			var call = @this.node(syntax_kind::call, token);
			@this.add(@*call.get(), rt::unique<Syntax>(@value.release()));
			@this.add(@*call.get(), @this.arguments(token_kind::punct_right_paren));
			@value = rt::unique<Syntax>(@call.release());
			continue;
		};

		if (@this.accept(token_kind::punct_left_bracket)) {
			var index = @this.node(syntax_kind::index, token);
			@this.add(@*index.get(), rt::unique<Syntax>(@value.release()));
			@this.add(@*index.get(), @this.expression(1));
			@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after index", 24));
			@value = rt::unique<Syntax>(@index.release());
			continue;
		};

		if (token.kind == token_kind::op_dot || token.kind == token_kind::op_arrow) {
			@this.take();
			var member = @this.node(syntax_kind::member, token);
			@this.add(@*member.get(), rt::unique<Syntax>(@value.release()));
			Token tilde = this.peek();

			if (@this.accept(token_kind::op_tilde)) {
				var destructor = @this.node(syntax_kind::unary, tilde);
				@this.add(@*destructor.get(), @this.type());
				@this.add(@*member.get(), rt::unique<Syntax>(@destructor.release()));
			}
			else if (this.mode == parse_mode::editor && this.peek().kind != token_kind::identifier) {
				@this.add(@*member.get(), @this.absent());
			}
			else {
				@this.add(@*member.get(), @this.name());
			};

			@value = rt::unique<Syntax>(@member.release());
			continue;
		};

		break;
	};

	return $value;
};

fn Parser::primary(var Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (this.mode == parse_mode::editor && @this.recovery_boundary() && token.kind != token_kind::punct_semicolon) {
		return @this.node(syntax_kind::error_expression, token);
	};

	if (token.kind == token_kind::identifier || token.kind == token_kind::kw_var || token.kind == token_kind::kw_const || token.kind == token_kind::kw_struct || token.kind == token_kind::kw_class || token.kind == token_kind::kw_union) {
		// Type suffixes and value operators share tokens. Enumerate both complete
		// continuations instead of deciding whether an identifier denotes a type here.
		usize choice = this.tokens->size() + this.offset;

		if (!this.selections || !this.selections->contains(choice)) {
			var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
			@candidate.offset = this.offset;
			@candidate.pending_greater = this.pending_greater;
			@candidate.selections = this.selections;
			@candidate.discoveries = this.discoveries;
			var type = @candidate.type();

			if (type.get() && candidate.failure.empty() && type.get()->kind() != syntax_kind::type_name && candidate.peek().kind == token_kind::punct_left_paren) {
				if (this.discoveries && !@this.discoveries->push_back(choice)) {
					@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
					return rt::unique<Syntax>();
				};

				@this.offset = candidate.offset;
				@this.pending_greater = candidate.pending_greater;

				return $type;
			};
		};
	};

	switch (token.kind) {
		case token_kind::identifier:
			if (token.is(rt::string_view("static_cast", 11)) || token.is(rt::string_view("reinterpret_cast", 16)) || token.is(rt::string_view("const_cast", 10)) || token.is(rt::string_view("dynamic_cast", 12))) {
				@this.take();
				var cast = @this.node(syntax_kind::cast, token);
				@this.require(token_kind::op_less, rt::string_view("expected '<' in named cast", 26));
				@this.add(@*cast.get(), @this.type());
				@this.close_template();
				@this.require(token_kind::punct_left_paren, rt::string_view("expected '(' in named cast", 26));
				@this.add(@*cast.get(), @this.expression(1));
				@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' in named cast", 26));

				return $cast;
			};

			return @this.name_in(name_role::value);
		case token_kind::literal_number:
			@this.take();

			return @this.node(syntax_kind::number, $token);
		case token_kind::literal_string:
			@this.take();

			return @this.node(syntax_kind::string, $token);
		case token_kind::kw_nullptr:
			@this.take();

			return @this.node(syntax_kind::null_pointer, $token);
		case token_kind::punct_semicolon:
			@this.take();

			return @this.node(syntax_kind::noop, $token);
		case token_kind::punct_left_brace:
			@this.take();

			return @this.sequence($token, token_kind::punct_right_brace, syntax_kind::brace);
		case token_kind::punct_left_bracket:
			@this.take();
			var array = @this.node(syntax_kind::array, $token);
			@this.add(@*array.get(), @this.arguments(token_kind::punct_right_bracket));

			return $array;
		case token_kind::punct_left_paren: {
			@this.take();
			var grouped = @this.node(syntax_kind::grouping, token);
			@this.add(@*grouped.get(), @this.expression(1));
			@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' after expression", 29));

			return $grouped;
		};

		case token_kind::kw_struct:
		case token_kind::kw_class:
		case token_kind::kw_union:
			return @this.record();
		case token_kind::kw_if:
		case token_kind::kw_while:
		case token_kind::kw_for:
		case token_kind::kw_switch:
			return @this.control();
		case token_kind::kw_break:
		case token_kind::kw_continue:
			@this.take();

			if (token.kind == token_kind::kw_break) {
				return @this.node(syntax_kind::break_loop, $token);
			};

			return @this.node(syntax_kind::continue_loop, $token);
		case token_kind::kw_return: {
			@this.take();
			var result = @this.node(syntax_kind::return_value, $token);

			if (this.peek().kind == token_kind::punct_semicolon) {
				@this.add(@*result.get(), @this.absent());
			}
			else {
				@this.add(@*result.get(), @this.expression(1));
			};

			return $result;
		};

		case token_kind::op_plus:
		case token_kind::op_minus:
		case token_kind::op_star:
		case token_kind::op_ampersand:
		case token_kind::op_bang:
		case token_kind::op_tilde:
		case token_kind::op_access:
		case token_kind::op_relocate: {
			@this.take();
			var unary = @this.node(syntax_kind::unary, $token);
			@this.add(@*unary.get(), @this.expression(12));

			return $unary;
		};

		case token_kind::kw_sizeof: {
			@this.take();
			var type_parser = Parser(*this.tokens);
		@type_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@type_parser.mode = this.mode;
			@type_parser.offset = this.offset;
			@type_parser.pending_greater = this.pending_greater;
	@type_parser.selections = this.selections;
	@type_parser.discoveries = this.discoveries;
			var type = @type_parser.absent();

			if (@type_parser.accept(token_kind::punct_left_paren)) {
				@type = @type_parser.type();
				@type_parser.require(token_kind::punct_right_paren, rt::string_view("expected ')' after sizeof type", 30));
			}
			else {
				@type_parser.fail(rt::string_view("expected sizeof type", 20));
			};

			var value = @this.expression(12);

			if (type.get() && type_parser.failure.empty()) {
				var measured_type = @this.node(syntax_kind::sizeof_type, token);
				@this.add(@*measured_type.get(), rt::unique<Syntax>(@type.release()));

				if (value.get() && this.failure.empty() && this.offset == type_parser.offset && this.pending_greater == type_parser.pending_greater) {
					var measured_value = @this.node(syntax_kind::unary, token);
					@this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));
					var alternatives = @this.node(syntax_kind::ambiguity, token);
					@this.add(@*alternatives.get(), $measured_type);
					@this.add(@*alternatives.get(), $measured_value);

					return $alternatives;
				};

				@this.offset = type_parser.offset;
				@this.pending_greater = type_parser.pending_greater;

				@this.failure = rt::string_view();

				return $measured_type;
			};

			var measured_value = @this.node(syntax_kind::unary, token);
			@this.add(@*measured_value.get(), rt::unique<Syntax>(@value.release()));

			return $measured_value;
		};

		case token_kind::kw_discard: {
			@this.take();
			var discard_expression = @this.node(syntax_kind::discard_value, token);
			@this.add(@*discard_expression.get(), @this.expression(12));

			return $discard_expression;
		};

		case token_kind::kw_delete: {
			@this.take();
			syntax_kind kind = syntax_kind::deallocation;

			if (@this.accept(token_kind::punct_left_bracket)) {
				@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' in delete[]", 24));
				@kind = syntax_kind::array_deallocation;
			};

			var deletion = @this.node($kind, token);
			@this.add(@*deletion.get(), @this.expression(12));

			return $deletion;
		};

		case token_kind::kw_new: {
			@this.take();
			var allocation = @this.node(syntax_kind::allocation, $token);
			var allocated_type = @this.type();
			bool array = allocated_type.get() && allocated_type.get()->kind() == syntax_kind::type_array;
			@this.add(@*allocation.get(), $allocated_type);

			if (@this.accept(token_kind::punct_left_paren)) {
				@this.add(@*allocation.get(), @this.arguments(token_kind::punct_right_paren));
			}
			else {
				if (array) {
					@this.fail(rt::string_view("array allocation requires a construction argument list; use 'new T[count]()' for default construction", 101));
					return rt::unique<Syntax>();
				};
				@this.add(@*allocation.get(), @this.node(syntax_kind::list, this.peek()));
			};

			return $allocation;
		};

		default:
			@this.fail(rt::string_view("expected expression", 19));
			return rt::unique<Syntax>();
	};
};

fn Parser::variable(var Parser& this) -> rt::unique<Syntax> {
	Token start = this.peek();
	var declared_type = @this.absent();
	var declared_name = @this.absent();

	if (start.kind == token_kind::kw_var) {
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.selections = this.selections;
		@candidate.discoveries = this.discoveries;
		var typed = @candidate.type();
		var named = @candidate.name();
		if (candidate.failure.empty() && typed.get() && named.get()) {
			@declared_type = rt::unique<Syntax>(@typed.release());
			@declared_name = rt::unique<Syntax>(@named.release());
			@this.offset = candidate.offset;
			@this.pending_greater = candidate.pending_greater;
		}
		else {
			@this.take();
			@declared_name = @this.name();
			if (@this.accept(token_kind::punct_colon)) {
				@declared_type = @this.type();
			};
		};
	}
	else {
		@declared_type = @this.type();
		@declared_name = @this.name();
	};

	var initializer = @this.absent();

	if (this.peek().kind == token_kind::op_assign || this.peek().kind == token_kind::op_copy) {
		Token operation = @this.take();
		var initialized = @this.node(syntax_kind::unary, operation);
		if (this.mode == parse_mode::editor && @this.recovery_boundary()) {
			@this.add(@*initialized.get(), @this.node(syntax_kind::error_expression, this.peek()));
		}
		else {
			@this.add(@*initialized.get(), @this.expression(1));
		};
		@initializer = rt::unique<Syntax>(@initialized.release());
	}
	else if (this.peek().kind == token_kind::punct_left_brace) {
		@initializer = @this.primary();
	};

	if (!@this.require(token_kind::punct_semicolon, rt::string_view("expected ';' after variable declaration", 39))) {
		return rt::unique<Syntax>();
	};

	var result = @this.node(syntax_kind::variable, start);
	@this.add(@*result.get(), rt::unique<Syntax>(@declared_name.release()));
	@this.add(@*result.get(), rt::unique<Syntax>(@declared_type.release()));
	@this.add(@*result.get(), rt::unique<Syntax>(@initializer.release()));

	return $result;
};

fn Parser::parameters(var Parser& this) -> rt::unique<Syntax> {
	var result = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_right_paren)) {
		return $result;
	};

	while (this.failure.empty()) {
		Token location = this.peek();

		if (@this.accept(token_kind::punct_ellipsis)) {
			var variadic = @this.node(syntax_kind::parameter, location);
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*variadic.get(), @this.absent());
			@this.add(@*result.get(), $variadic);
			@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' after variadic parameter", 37));

			return $result;
		};

		var parameter_type = @this.type();
		var parameter_name = @this.absent();

		if (this.peek().kind == token_kind::identifier) {
			@parameter_name = @this.name();
		};

		var default_value = @this.absent();

		if (@this.accept(token_kind::op_assign)) {
			@default_value = @this.expression(1);
		};

		var parameter = @this.node(syntax_kind::parameter, location);
		@this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_name.release()));
		@this.add(@*parameter.get(), rt::unique<Syntax>(@parameter_type.release()));
		@this.add(@*parameter.get(), rt::unique<Syntax>(@default_value.release()));
		@this.add(@*result.get(), rt::unique<Syntax>(@parameter.release()));

		if (@this.accept(token_kind::punct_right_paren)) {
			return $result;
		};

		if (!@this.require(token_kind::punct_comma, rt::string_view("expected ',' between parameters", 31))) {
			break;
		};
	};

	return rt::unique<Syntax>();
};

fn Parser::function(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::function, start);
	@this.add(@*result.get(), @this.name());

	if (!@this.require(token_kind::punct_left_paren, rt::string_view("expected function parameter list", 32))) {
		return rt::unique<Syntax>();
	};

	@this.add(@*result.get(), @this.parameters());
	var result_type = @this.absent();

	if (@this.accept(token_kind::op_arrow)) {
		@result_type = @this.type();
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@result_type.release()));
	var attributes = @this.node(syntax_kind::attributes, this.peek());

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, rt::string_view("expected attribute list", 23));

		while (this.peek().kind != token_kind::punct_right_bracket && this.peek().kind != token_kind::eof && this.failure.empty()) {
			@this.add(@*attributes.get(), @this.node(syntax_kind::name, @this.take()));

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after attributes", 29));
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@attributes.release()));
	@this.add(@*result.get(), @this.expression(1));

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		@this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::record(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::record, start);

	if (this.peek().kind == token_kind::identifier) {
		@this.add(@*result.get(), @this.name());
	}
	else {
		@this.add(@*result.get(), @this.absent());
	};

	var bases = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, rt::string_view("expected '[' before record bases", 32));

		while (this.failure.empty()) {
			@this.add(@*bases.get(), @this.type());

			if (!@this.accept(token_kind::punct_comma)) {
				break;
			};
		};

		@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after record bases", 31));
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@bases.release()));
	@this.add(@*result.get(), @this.expression(1));

	return $result;
};

fn Parser::enumeration(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::enumeration, start);
	@this.add(@*result.get(), @this.name());
	var underlying = @this.absent();

	if (@this.accept(token_kind::punct_colon)) {
		@this.require(token_kind::punct_left_bracket, rt::string_view("expected enum underlying type", 29));
		@underlying = @this.type();
		@this.require(token_kind::punct_right_bracket, rt::string_view("expected ']' after enum underlying type", 39));
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@underlying.release()));
	var members = @this.node(syntax_kind::list, this.peek());

	if (@this.accept(token_kind::punct_semicolon)) {
		@members = @this.node(syntax_kind::noop, start);
	}
	else {
		@this.require(token_kind::punct_left_brace, rt::string_view("expected enum body", 18));

		while (this.failure.empty() && this.peek().kind != token_kind::punct_right_brace) {
			if (this.peek().kind == token_kind::kw_fn) {
				@this.add(@*members.get(), @this.function());
				continue;
			};

			Token member = this.peek();
			var entry = @this.node(syntax_kind::enumerator, member);
			@this.add(@*entry.get(), @this.name());

			if (@this.accept(token_kind::op_assign)) {
				@this.add(@*entry.get(), @this.expression(1));
			}
			else {
				@this.add(@*entry.get(), @this.absent());
			};

			@this.add(@*members.get(), rt::unique<Syntax>(@entry.release()));
			@this.require(token_kind::punct_semicolon, rt::string_view("expected ';' after enumerator", 29));
		};

		@this.require(token_kind::punct_right_brace, rt::string_view("expected '}' after enum body", 28));
		@this.accept(token_kind::punct_semicolon);
	};

	@this.add(@*result.get(), rt::unique<Syntax>(@members.release()));

	return $result;
};

fn Parser::namespace_body(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::namespace_body, start);
	@this.add(@*result.get(), @this.name());
	@this.add(@*result.get(), @this.expression(1));

	if (result.get()->item(result.get()->size() - 1)->kind() != syntax_kind::noop) {
		@this.accept(token_kind::punct_semicolon);
	};

	return $result;
};

fn Parser::template_declaration(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	var result = @this.node(syntax_kind::template_declaration, start);
	var parameters = @this.node(syntax_kind::list, this.peek());
	@this.require(token_kind::op_less, rt::string_view("expected '<' after template", 27));

	while (this.failure.empty()) {
		Token location = this.peek();
		var parameter = @this.node(syntax_kind::template_parameter, location);

		if (@this.accept(token_kind::kw_typename)) {
			@this.add(@*parameter.get(), @this.absent());
		}
		else {
			@this.add(@*parameter.get(), @this.type());
		};

		@this.add(@*parameter.get(), @this.name());

		if (@this.accept(token_kind::op_assign)) {
			if (location.kind == token_kind::kw_typename) {
				@this.add(@*parameter.get(), @this.type());
			}
			else {
				@this.add(@*parameter.get(), @this.expression(10));
			};
		}
		else {
			@this.add(@*parameter.get(), @this.absent());
		};

		@this.add(@*parameters.get(), rt::unique<Syntax>(@parameter.release()));

		if (!@this.accept(token_kind::punct_comma)) {
			break;
		};
	};

	@this.close_template();
	@this.add(@*result.get(), rt::unique<Syntax>(@parameters.release()));
	@this.add(@*result.get(), @this.statement());

	return $result;
};

fn Parser::control(var Parser& this) -> rt::unique<Syntax> {
	Token start = @this.take();
	@this.require(token_kind::punct_left_paren, rt::string_view("expected '(' before control condition", 37));

	if (start.kind == token_kind::kw_for) {
		var loop = @this.node(syntax_kind::for_loop, start);
		@this.add(@*loop.get(), @this.statement());

		if (this.peek().kind == token_kind::punct_semicolon) {
			@this.add(@*loop.get(), @this.absent());
		}
		else {
			@this.add(@*loop.get(), @this.expression(1));
		};

		@this.require(token_kind::punct_semicolon, rt::string_view("expected ';' after for condition", 32));

		if (this.peek().kind == token_kind::punct_right_paren) {
			@this.add(@*loop.get(), @this.absent());
		}
		else {
			@this.add(@*loop.get(), @this.expression(1));
		};

		@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' after for control", 30));
		@this.add(@*loop.get(), @this.statement());

		return $loop;
	};

	syntax_kind kind = syntax_kind::conditional;

	if (start.kind == token_kind::kw_while) {
		@kind = syntax_kind::while_loop;
	}
	else if (start.kind == token_kind::kw_switch) {
		@kind = syntax_kind::switch_expression;
	};

	var result = @this.node($kind, start);
	@this.add(@*result.get(), @this.expression(1));
	@this.require(token_kind::punct_right_paren, rt::string_view("expected ')' after condition", 28));
	@this.add(@*result.get(), @this.statement());

	if (start.kind == token_kind::kw_if) {
		if (@this.accept(token_kind::kw_else)) {
			@this.add(@*result.get(), @this.statement());
		}
		else {
			@this.add(@*result.get(), @this.absent());
		};
	};

	return $result;
};

fn Parser::statement_one(var Parser& this) -> rt::unique<Syntax> {
	Token token = this.peek();

	if (token.kind == token_kind::identifier && (token.is(rt::string_view("public", 6)) || token.is(rt::string_view("private", 7)) || token.is(rt::string_view("protected", 9)))) {
		@this.take();
		@this.require(token_kind::punct_colon, rt::string_view("expected ':' after access label", 31));

		return @this.node(syntax_kind::access_label, token);
	};

	switch (token.kind) {
		case token_kind::kw_case:
		case token_kind::kw_default: {
			@this.take();
			var label = @this.node(syntax_kind::case_label, token);

			if (token.kind == token_kind::kw_case) {
				@this.add(@*label.get(), @this.expression(1));
			}
			else {
				@this.add(@*label.get(), @this.absent());
			};

			@this.require(token_kind::punct_colon, rt::string_view("expected ':' after switch label", 31));

			return $label;
		};

		case token_kind::kw_var:
			return @this.variable();
		case token_kind::kw_fn:
			return @this.function();
		case token_kind::kw_enum:
			return @this.enumeration();
		case token_kind::kw_namespace:
			return @this.namespace_body();
		case token_kind::kw_template:
			return @this.template_declaration();
		case token_kind::kw_using: {
			@this.take();
			var alias = @this.node(syntax_kind::using_alias, token);
			@this.add(@*alias.get(), @this.name());
			@this.require(token_kind::op_assign, rt::string_view("expected '=' in type alias", 26));
			@this.add(@*alias.get(), @this.type());
			@this.require(token_kind::punct_semicolon, rt::string_view("expected ';' after alias", 24));

			return $alias;
		};

		default:
			break;
	};

	// Parsing does not classify identifiers by their spelling. A declaration and
	// expression that consume the same tokens remain alternatives for name binding.
	var declaration_parser = Parser(*this.tokens);
		@declaration_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@declaration_parser.mode = this.mode;
	@declaration_parser.offset = this.offset;
	@declaration_parser.pending_greater = this.pending_greater;
	@declaration_parser.selections = this.selections;
	@declaration_parser.discoveries = this.discoveries;
	var declaration = @declaration_parser.variable();
	var expression_parser = Parser(*this.tokens);
		@expression_parser.set_cancellation(this.cancellation, this.cancellation_context);
	@expression_parser.mode = this.mode;
	@expression_parser.offset = this.offset;
	@expression_parser.pending_greater = this.pending_greater;
	@expression_parser.selections = this.selections;
	@expression_parser.discoveries = this.discoveries;
	var expression = @expression_parser.expression(1);

	if (expression.get() && expression_parser.failure.empty()) {
		syntax_kind kind = expression.get()->kind();

		if (kind != syntax_kind::noop && kind != syntax_kind::brace && kind != syntax_kind::conditional && kind != syntax_kind::while_loop && kind != syntax_kind::for_loop && kind != syntax_kind::switch_expression && kind != syntax_kind::record) {
			@expression_parser.require(token_kind::punct_semicolon, rt::string_view("expected ';' after expression", 29));
		}
		else if (kind != syntax_kind::noop && (kind != syntax_kind::record || expression.get()->record_members()->kind() != syntax_kind::noop)) {
			@expression_parser.accept(token_kind::punct_semicolon);
		};
	};

	if (declaration.get() && declaration_parser.failure.empty()) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;

		if (expression.get() && expression_parser.failure.empty() && expression_parser.offset == declaration_parser.offset) {
			var alternatives = @this.node(syntax_kind::ambiguity, token);
			@this.add(@*alternatives.get(), rt::unique<Syntax>(@declaration.release()));
			@this.add(@*alternatives.get(), rt::unique<Syntax>(@expression.release()));

			return $alternatives;
		};

		return $declaration;
	};

	if (!declaration_parser.failure.empty() && !expression_parser.failure.empty() && declaration_parser.offset > expression_parser.offset) {
		@this.offset = declaration_parser.offset;
		@this.pending_greater = declaration_parser.pending_greater;

		@this.failure := declaration_parser.failure;
		@this.failure_location := declaration_parser.failure_location;

		return rt::unique<Syntax>();
	};

	@this.offset = expression_parser.offset;
	@this.pending_greater = expression_parser.pending_greater;

	if (!expression_parser.failure.empty()) {
		@this.failure := expression_parser.failure;
		@this.failure_location := expression_parser.failure_location;

		return rt::unique<Syntax>();
	};

	return $expression;
};

fn Parser::statement(var Parser& this) -> rt::unique<Syntax> {
	rt::buffer<rt::unique<ParseChoices>> work;
	rt::buffer<rt::unique<Syntax>> alternatives;

	if (!@work.push_back(rt::unique<ParseChoices>(new var ParseChoices()))) {
		@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
		return rt::unique<Syntax>();
	};

	usize next = 0;
	usize end = this.offset;
	usize pending = this.pending_greater;
	usize failed_at = this.offset;
	Token failed_token = this.peek();
	rt::string_view failure = rt::string_view("expected declaration or expression", 34);

	while (next < work.size()) {
		if (@this.cancelled()) {
			return rt::unique<Syntax>();
		};
		var ParseChoices* choices = work.data()[next].get();
		var candidate = Parser(*this.tokens);
		@candidate.set_cancellation(this.cancellation, this.cancellation_context);
	@candidate.mode = this.mode;
		@candidate.offset = this.offset;
		@candidate.pending_greater = this.pending_greater;
		@candidate.selections = choices;
		rt::buffer<usize> discoveries;
		@candidate.discoveries = &@discoveries;
		var syntax = @candidate.statement_one();

		if (syntax.get() && candidate.failure.empty()) {
			if (alternatives.size() && (candidate.offset != end || candidate.pending_greater != pending)) {
				@this.fail(rt::string_view("source interpretations have different statement boundaries", 58));
				return rt::unique<Syntax>();
			};

			@end = candidate.offset;
			@pending = candidate.pending_greater;

			if (!@this.alternative_add(@alternatives, rt::unique<Syntax>(@syntax.release()))) {
				return rt::unique<Syntax>();
			};
		}
		else if (!candidate.failure.empty() && candidate.offset >= failed_at) {
			@failed_at = candidate.offset;
			@failed_token := candidate.failure_location;
			@failure = candidate.failure;
		};

		usize index = 0;

		while (index < discoveries.size()) {
			usize position = discoveries.data()[index];

			if (!choices->contains(position)) {
				var extension = choices->extended(position);

				if (!extension.get()) {
					@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
					return rt::unique<Syntax>();
				};

				usize known = 0;

				while (known < work.size() && !work.data()[known].get()->same(*extension.get())) {
					@known = known + 1;
				};

				if (known == work.size() && !@work.push_back(rt::unique<ParseChoices>(@extension.release()))) {
					@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
					return rt::unique<Syntax>();
				};
			};

			@index = index + 1;
		};

		@next = next + 1;
	};

	if (!alternatives.size()) {
		if (this.mode == parse_mode::editor && !@this.cancelled() && failure.compare(rt::string_view("syntax allocation failed", 24)) && failure.compare(rt::string_view("parse alternatives storage is unavailable", 41))) {
			usize start = this.offset;
			@this.synchronize(start);

			if (!this.failure.empty()) {
				return rt::unique<Syntax>();
			};
			return @this.node(syntax_kind::error_expression, failed_token);
		};
		@this.offset = failed_at;
		@this.failure_location := failed_token;
		@this.failure = $failure;

		return rt::unique<Syntax>();
	};

	@this.offset = end;
	@this.pending_greater = pending;

	return @this.factor(@alternatives);
};

fn Parser::alternative_add(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives, rt::unique<Syntax> syntax) -> bool {
	if (syntax.get()->kind() == syntax_kind::ambiguity) {
		usize index = 0;

		while (index < syntax.get()->size()) {
			if (!@this.alternative_add(@alternatives, @syntax.get()->take_item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	usize index = 0;

	while (index < alternatives.size()) {
		if (alternatives.data()[index].get()->same_tree(*syntax.get())) {
			return true;
		};

		@index = index + 1;
	};

	if (!@alternatives.push_back($syntax)) {
		@this.fail(rt::string_view("parse alternatives storage is unavailable", 41));
		return false;
	};

	return true;
};

fn Parser::factor(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	// Factor each parent shape before preserving alternatives of different grammar roles.
	// This keeps type/value choices local even when declarations also compete with expressions.
	rt::buffer<rt::unique<Syntax>> factored;
	usize index = 0;

	while (index < alternatives.size()) {
		var Syntax* first = alternatives.data()[index].get();

		if (!first) {
			@index = index + 1;
			continue;
		};

		rt::buffer<rt::unique<Syntax>> group;
		usize candidate = index;

		while (candidate < alternatives.size()) {
			var Syntax* other = alternatives.data()[candidate].get();

			if (other && other->kind() == first->kind() && other->token().source == first->token().source && other->token().begin == first->token().begin && other->token().length == first->token().length && other->size() == first->size()) {
				if (!@this.alternative_add(@group, rt::unique<Syntax>(@((@alternatives).data()[candidate]).release()))) {
					return rt::unique<Syntax>();
				};
			};

			@candidate = candidate + 1;
		};

		if (!@this.alternative_add(@factored, @this.factor_group(@group))) {
			return rt::unique<Syntax>();
		};

		@index = index + 1;
	};

	return @this.factor_group(@factored);
};

fn Parser::factor_group(var Parser& this, var rt::buffer<rt::unique<Syntax>>& alternatives) -> rt::unique<Syntax> {
	if (alternatives.size() == 1) {
		return rt::unique<Syntax>(@((@alternatives).data()[0]).release());
	};

	var Syntax* first = alternatives.data()[0].get();
	usize difference = usize::max;
	bool compatible = true;
	usize candidate = 1;

	while (candidate < alternatives.size() && compatible) {
		var Syntax* other = alternatives.data()[candidate].get();

		if (other->kind() != first->kind() || other->token().source != first->token().source || other->token().begin != first->token().begin || other->token().length != first->token().length || other->size() != first->size()) {
			@compatible = false;
			break;
		};

		usize index = 0;

		while (index < first->size()) {
			if (!first->item(index)->same_tree(*other->item(index))) {
				if (first->kind() == syntax_kind::call && !index) {
					@compatible = false;
					break;
				};

				@difference = index;
			};

			@index = index + 1;
		};

		@candidate = candidate + 1;
	};

	if (compatible) {
		// Independent child choices may be factored only when every combination
		// occurs in the parsed alternatives. Unique trees make the product count
		// a completeness proof; correlated grammar choices remain whole trees.
		usize combinations = 1;
		usize index = 0;

		while (index < first->size() && compatible) {
			usize distinct = 0;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				usize previous = 0;

				while (previous < candidate && !alternatives.data()[previous].get()->item(index)->same_tree(*alternatives.data()[candidate].get()->item(index))) {
					@previous = previous + 1;
				};

				if (previous == candidate) {
					@distinct = distinct + 1;
				};

				@candidate = candidate + 1;
			};

			if (distinct > alternatives.size() / combinations) {
				@compatible = false;
				break;
			};

			@combinations = combinations * distinct;
			@index = index + 1;
		};

		if (combinations != alternatives.size()) {
			@compatible = false;
		};
	};

	if (compatible && difference != usize::max) {
		var result = @this.node(first->kind(), first->token());
		usize index = 0;

		while (index < first->size()) {
			rt::buffer<rt::unique<Syntax>> children;
			@candidate = 0;

			while (candidate < alternatives.size()) {
				if (!@this.alternative_add(@children, @alternatives.data()[candidate].get()->take_item(index))) {
					return rt::unique<Syntax>();
				};

				@candidate = candidate + 1;
			};

			@this.add(@*result.get(), @this.factor(@children));
			@index = index + 1;
		};

		return $result;
	};

	var result = @this.node(syntax_kind::ambiguity, first->token());
	usize index = 0;

	while (index < alternatives.size()) {
		@this.add(@*result.get(), rt::unique<Syntax>(@((@alternatives).data()[index]).release()));
		@index = index + 1;
	};

	return $result;
};

fn ParseChoices::contains(ParseChoices& this, usize position) -> bool {
	usize index = 0;

	while (index < this.operators.size()) {
		if (this.operators.data()[index] == position) {
			return true;
		};

		@index = index + 1;
	};

	return false;
};

fn ParseChoices::extended(ParseChoices& this, usize position) -> rt::unique<ParseChoices> {
	var result = rt::unique<ParseChoices>(new var ParseChoices());
	usize index = 0;

	while (index < this.operators.size()) {
		if (!@result.get()->operators.push_back(usize(this.operators.data()[index]))) {
			return rt::unique<ParseChoices>();
		};

		@index = index + 1;
	};

	if (!@result.get()->operators.push_back($position)) {
		return rt::unique<ParseChoices>();
	};

	return $result;
};

fn ParseChoices::same(ParseChoices& this, ParseChoices& other) -> bool {
	if (this.operators.size() != other.operators.size()) {
		return false;
	};

	usize index = 0;

	while (index < this.operators.size()) {
		if (!other.contains(usize(this.operators.data()[index]))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

struct Entity;

enum type_kind : [u08] {
	void_type;
	null_type;
	boolean;
	character;
	signed_integer;
	unsigned_integer;
	floating_point;
	named;
	pointer;
	reference;
	array;
	function;
	parameter;
};

enum type_qualifier : [u08] {
	mutable;
	immutable;
};

enum parameter_arity : [u08] {
	fixed;
	variadic;
};

fn type_kind::is_integer(type_kind& this) -> bool {
	return this == type_kind::boolean || this == type_kind::character || this == type_kind::signed_integer || this == type_kind::unsigned_integer;
};

fn type_kind::is_numeric(type_kind& this) -> bool {
	return this.is_integer() || this == type_kind::floating_point;
};

fn type_kind::is_scalar(type_kind& this) -> bool {
	return this.is_numeric() || this == type_kind::pointer || this == type_kind::reference;
};

struct FunctionSignature {
	fn FunctionSignature(var FunctionSignature& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity);

	fn result(FunctionSignature& this) -> Type*;
	fn parameters(FunctionSignature& this) -> rt::buffer<Type*>&;
	fn arity(FunctionSignature& this) -> parameter_arity;
	fn equals(FunctionSignature& this, FunctionSignature& other) -> bool;

private:
	Type* return_type;
	rt::buffer<Type*> parameter_types;
	parameter_arity argument_arity;
};

struct ArrayShape {
	Type* element;
	u64 count;
};

union TypeShape {
	u32 bits;
	var Entity* entity;
	Type* element;
	ArrayShape array;
	FunctionSignature* signature;
};

struct Type {
	fn Type(var Type& this) : [default];
	fn Type(var Type& this, type_kind kind, TypeShape shape);

	fn kind(Type& this) -> type_kind;
	fn qualifier(Type& this) -> type_qualifier;
	fn bits(Type& this) -> u32;
	fn entity(Type& this) -> var Entity*;
	fn element(Type& this) -> Type*;
	fn count(Type& this) -> u64;
	fn signature(Type& this) -> FunctionSignature&;
	fn qualified(Type& this, type_qualifier qualifier) -> Type;
	fn equals(Type& this, Type& other) -> bool;
	fn same_shape(Type& this, Type& other) -> bool;
	fn representation(Type& this) -> Type*;
	fn has_layout(Type& this) -> bool;
	fn normalize_integer(Type& this, u64 value) -> u64;
	fn signed_value(Type& this, u64 value) -> i64;
	fn integer_from_real(Type& this, f64 value, var u64& result) -> bool;
	fn derived_from(Type& this, Type& base) -> bool;
	fn hash(Type& this) -> usize;

private:
	TypeShape shape;
	type_kind category;
	type_qualifier qualification;
};

fn Type::equals(Type& this, Type& other) -> bool {
	if (this.category != other.category || this.qualification != other.qualification) {
		return false;
	};

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return this.shape.entity == other.shape.entity;
		case type_kind::pointer:
		case type_kind::reference:
			return this.shape.element == other.shape.element;
		case type_kind::array:
			return this.shape.array.element == other.shape.array.element && this.shape.array.count == other.shape.array.count;
		case type_kind::function:
			return this.shape.signature->equals(*other.shape.signature);
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return this.shape.bits == other.shape.bits;
		default:
			return true;
	};
};

fn Type::hash(Type& this) -> usize {
	usize hash = static_cast<usize>(this.category) * 37 + static_cast<usize>(this.qualification);

	switch (this.category) {
		case type_kind::named:
		case type_kind::parameter:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.entity) >> 3);
		case type_kind::pointer:
		case type_kind::reference:
			return hash * 37 + (reinterpret_cast<usize>(this.shape.element) >> 3);
		case type_kind::array:
			return (hash * 37 + (reinterpret_cast<usize>(this.shape.array.element) >> 3)) * 37 + static_cast<usize>(this.shape.array.count);
		case type_kind::function: {
			FunctionSignature& signature = *this.shape.signature;
			@hash = (hash * 37 + (reinterpret_cast<usize>(signature.result()) >> 3)) * 37 + static_cast<usize>(signature.arity());
			usize index = 0;
			while (index < signature.parameters().size()) {
				@hash = hash * 37 + (reinterpret_cast<usize>(signature.parameters().data()[index]) >> 3);
				@index = index + 1;
			};

			return $hash;
		};
		case type_kind::signed_integer:
		case type_kind::unsigned_integer:
		case type_kind::floating_point:
			return hash * 37 + static_cast<usize>(this.shape.bits);
		default:
			return $hash;
	};
};

fn FunctionSignature::FunctionSignature(var FunctionSignature& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) {
	@this.return_type = $result;
	@this.parameter_types = $parameters;
	@this.argument_arity = $arity;
};

fn FunctionSignature::result(FunctionSignature& this) -> Type* {
	return this.return_type;
};

fn FunctionSignature::parameters(FunctionSignature& this) -> rt::buffer<Type*>& {
	return this.parameter_types;
};

fn FunctionSignature::arity(FunctionSignature& this) -> parameter_arity {
	return parameter_arity(this.argument_arity);
};

fn FunctionSignature::equals(FunctionSignature& this, FunctionSignature& other) -> bool {
	if (this.return_type != other.return_type || this.argument_arity != other.argument_arity || this.parameter_types.size() != other.parameter_types.size()) {
		return false;
	};

	usize index = 0;
	while (index < this.parameter_types.size()) {
		if (this.parameter_types.data()[index] != other.parameter_types.data()[index]) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Type::Type(var Type& this, type_kind kind, TypeShape shape) {
	@this.category = $kind;
	@this.shape = $shape;
};

fn Type::kind(Type& this) -> type_kind {
	return type_kind(this.category);
};

fn Type::qualifier(Type& this) -> type_qualifier {
	return type_qualifier(this.qualification);
};

fn Type::bits(Type& this) -> u32 {
	return this.shape.bits;
};

fn Type::entity(Type& this) -> var Entity* {
	return this.shape.entity;
};

fn Type::element(Type& this) -> Type* {
	if (this.category == type_kind::array) {
		return this.shape.array.element;
	};

	return this.shape.element;
};

fn Type::count(Type& this) -> u64 {
	return this.shape.array.count;
};

fn Type::signature(Type& this) -> FunctionSignature& {
	return *this.shape.signature;
};

fn Type::qualified(Type& this, type_qualifier qualifier) -> Type {
	Type result := this;
	@result.qualification = $qualifier;

	return $result;
};

fn Type::same_shape(Type& this, Type& other) -> bool {
	Type first = this.qualified(type_qualifier::mutable);
	Type second = other.qualified(type_qualifier::mutable);

	return first.equals(second);
};

struct TypeEntry {
	Type value;
	var TypeEntry* next;
};

struct TypeStore {
	fn TypeStore(var TypeStore& this) : [default];
	fn TypeStore(var TypeStore& this, TypeStore& other) : [delete];
	fn TypeStore(var TypeStore& this, TypeStore other) : [default];

	fn operator=(var TypeStore& this, TypeStore& other) -> var TypeStore& : [delete];
	fn operator=(var TypeStore& this, TypeStore other) -> var TypeStore& : [default];
	fn primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type*;
	fn initialize_primitives(var TypeStore& this, u32 pointer_bits) -> bool;
	fn named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type*;
	fn pointer(var TypeStore& this, Type* element) -> Type*;
	fn reference(var TypeStore& this, Type* element) -> Type*;
	fn array(var TypeStore& this, Type* element, u64 count) -> Type*;
	fn function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type*;
	fn qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type*;
	fn clear(var TypeStore& this);

	fn find_primitive(TypeStore& this, rt::string_view& name) -> Type*;

private:
	fn register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) -> bool;
	fn intern(var TypeStore& this, Type key) -> Type*;
	fn rehash(var TypeStore& this, usize count) -> bool;

	fn find(TypeStore& this, Type& key) -> Type*;

	rt::buffer<rt::unique<FunctionSignature>> signatures;
	rt::buffer<rt::unique<TypeEntry>> entries;
	rt::buffer<var TypeEntry*> buckets;
	rt::unordered_map<rt::string_view, Type*> primitive_names;
};

fn TypeStore::find(TypeStore& this, Type& key) -> Type* {
	if (!this.buckets.size()) {
		return nullptr;
	};

	var TypeEntry* entry := this.buckets.data()[key.hash() % this.buckets.size()];

	while (entry) {
		if (entry->value.equals(key)) {
			return &@entry->value;
		};

		@entry := entry->next;
	};

	return nullptr;
};

fn TypeStore::rehash(var TypeStore& this, usize count) -> bool {
	rt::buffer<var TypeEntry*> replacement;

	if (!@replacement.reserve(usize(count))) {
		return false;
	};

	usize index = 0;
	while (index < count) {
		if (!@replacement.push_back(nullptr)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;
	var TypeEntry var** buckets = (@replacement).data();

	while (index < this.entries.size()) {
		var TypeEntry* entry = this.entries.data()[index].get();
		usize bucket = entry->value.hash() % count;
		@entry->next := buckets[bucket];
		@buckets[bucket] := entry;
		@index = index + 1;
	};

	@this.buckets = $replacement;

	return true;
};

fn TypeStore::intern(var TypeStore& this, Type key) -> Type* {
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!this.buckets.size()) {
		if (!@this.rehash(64)) {
			return nullptr;
		};
	}
	else if (this.entries.size() >= this.buckets.size()) {
		if (this.buckets.size() > usize::max / 2 || !@this.rehash(this.buckets.size() * 2)) {
			return nullptr;
		};
	};

	var owner = rt::unique<TypeEntry>::make();

	if (!owner.get()) {
		return nullptr;
	};

	var TypeEntry* entry = owner.get();
	@entry->value = $key;

	if (!@this.entries.push_back($owner)) {
		return nullptr;
	};

	usize bucket = entry->value.hash() % this.buckets.size();
	var TypeEntry var** buckets = (@this.buckets).data();
	@entry->next := buckets[bucket];
	@buckets[bucket] := entry;

	return &@entry->value;
};

fn TypeStore::primitive(var TypeStore& this, type_kind kind, u32 bits) -> Type* {
	TypeShape shape;
	@shape.bits = $bits;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::named(var TypeStore& this, type_kind kind, var Entity* entity) -> Type* {
	TypeShape shape;
	@shape.entity = $entity;

	return @this.intern(Type($kind, $shape));
};

fn TypeStore::pointer(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::pointer, $shape));
};

fn TypeStore::reference(var TypeStore& this, Type* element) -> Type* {
	TypeShape shape;
	@shape.element = $element;

	return @this.intern(Type(type_kind::reference, $shape));
};

fn TypeStore::array(var TypeStore& this, Type* element, u64 count) -> Type* {
	TypeShape shape;
	@shape.array.element = $element;
	@shape.array.count = $count;

	return @this.intern(Type(type_kind::array, $shape));
};

fn TypeStore::function(var TypeStore& this, Type* result, rt::buffer<Type*> parameters, parameter_arity arity) -> Type* {
	var signature = rt::unique<FunctionSignature>(new var FunctionSignature($result, $parameters, $arity));

	if (!signature.get()) {
		return nullptr;
	};

	TypeShape shape;
	@shape.signature = signature.get();
	var key = Type(type_kind::function, $shape);
	Type* found = this.find(key);

	if (found) {
		return $found;
	};

	if (!@this.signatures.push_back($signature)) {
		return nullptr;
	};

	return @this.intern($key);
};

fn TypeStore::qualified(var TypeStore& this, Type& type, type_qualifier qualifier) -> Type* {
	return @this.intern(type.qualified($qualifier));
};

fn TypeStore::clear(var TypeStore& this) {
	@this.primitive_names.clear();
	@this.buckets.clear();
	@this.entries.clear();
	@this.signatures.clear();
};

fn TypeStore::register_primitive(var TypeStore& this, var rt::unordered_map<rt::string_view, Type*>& names, rt::string_view name, type_kind kind, u32 bits) -> bool {
	Type* type = @this.primitive($kind, $bits);

	if (!type) {
		return false;
	};

	return @names.insert($name, $type);
};

fn TypeStore::initialize_primitives(var TypeStore& this, u32 pointer_bits) -> bool {
	rt::unordered_map<rt::string_view, Type*> names;

	if (!@names.reserve(20)) {
		return false;
	};

	if (false
		|| !@this.register_primitive(@names, rt::string_view("void", 4), type_kind::void_type, 0)
		|| !@this.register_primitive(@names, rt::string_view("null", 4), type_kind::null_type, 0)
		|| !@this.register_primitive(@names, rt::string_view("bool", 4), type_kind::boolean, 1)
		|| !@this.register_primitive(@names, rt::string_view("char", 4), type_kind::character, 8)
		|| !@this.register_primitive(@names, rt::string_view("usize", 5), type_kind::unsigned_integer, pointer_bits)
		|| !@this.register_primitive(@names, rt::string_view("ptrdiff", 7), type_kind::signed_integer, pointer_bits)
		|| !@this.register_primitive(@names, rt::string_view("i8", 2), type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("i08", 3), type_kind::signed_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("i16", 3), type_kind::signed_integer, 16)
		|| !@this.register_primitive(@names, rt::string_view("i32", 3), type_kind::signed_integer, 32)
		|| !@this.register_primitive(@names, rt::string_view("i64", 3), type_kind::signed_integer, 64)
		|| !@this.register_primitive(@names, rt::string_view("u8", 2), type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("u08", 3), type_kind::unsigned_integer, 8)
		|| !@this.register_primitive(@names, rt::string_view("u16", 3), type_kind::unsigned_integer, 16)
		|| !@this.register_primitive(@names, rt::string_view("u32", 3), type_kind::unsigned_integer, 32)
		|| !@this.register_primitive(@names, rt::string_view("u64", 3), type_kind::unsigned_integer, 64)
		|| !@this.register_primitive(@names, rt::string_view("f32", 3), type_kind::floating_point, 32)
		|| !@this.register_primitive(@names, rt::string_view("f64", 3), type_kind::floating_point, 64)
		) {
		return false;
	};

	@this.primitive_names = $names;

	return true;
};

fn TypeStore::find_primitive(TypeStore& this, rt::string_view& name) -> Type* {
	var found = this.primitive_names.find(name);

	if (!found) {
		return nullptr;
	};

	return *found;
};

struct NativeFile;

fn platform_open_utf8_file(const char* path, const char* mode) -> var NativeFile*;
fn fclose(var NativeFile* file) -> i32;
fn fread(var void* destination, usize size, usize count, var NativeFile* file) -> usize;
fn fwrite(const void* source, usize size, usize count, var NativeFile* file) -> usize;
fn ferror(var NativeFile* file) -> i32;

using FileOpener = ((const char*, const char*) -> var NativeFile*)*;

struct FileCloser {
	fn dispose(var NativeFile* file);
};

struct File {
	fn File(var File& this, var NativeFile* file);
	fn File(var File& this, const File& other) : [delete];
	fn File(var File& this, File other) : [default];

	fn operator=(var File& this, const File& other) -> var File& : [delete];
	fn operator=(var File& this, File other) -> var File& : [default];
	fn read(var File& this, var char* destination, usize capacity) -> usize;
	fn write(var File& this, const rt::string_view& bytes) -> bool;
	fn close(var File& this) -> bool;

	fn is_open(const File& this) -> bool;
	fn failed(const File& this) -> bool;

private:
	rt::unique<NativeFile, FileCloser> handle;
};

fn FileCloser::dispose(var NativeFile* file) {
	if (file) {
		fclose($file);
	};
};

fn File::File(var File& this, var NativeFile* file) {
	@this.handle = rt::unique<NativeFile, FileCloser>($file);
};

fn File::is_open(const File& this) -> bool {
	return this.handle.get() != nullptr;
};

fn File::failed(const File& this) -> bool {
	return !this.handle.get() || ferror(this.handle.get());
};

fn File::read(var File& this, var char* destination, usize capacity) -> usize {
	return fread($destination, 1, $capacity, this.handle.get());
};

fn File::write(var File& this, const rt::string_view& bytes) -> bool {
	return fwrite(bytes.data(), 1, bytes.size(), this.handle.get()) == bytes.size();
};

fn File::close(var File& this) -> bool {
	var NativeFile* handle = @this.handle.release();

	if (!handle) {
		return true;
	};

	return !fclose($handle);
};

fn fprintf(var NativeFile* file, char* format, ...) -> i32;

enum diagnostic_state : [u08] {
	clean;
	failed;
};

enum diagnostic_message_state : [u08] {
	complete;
	unavailable;
};

struct DiagnosticMessage {
	fn text(var DiagnosticMessage& this, rt::string_view& value);
	fn quoted(var DiagnosticMessage& this, rt::string_view& value);
	fn number(var DiagnosticMessage& this, u64 value);
	fn view(DiagnosticMessage& this) -> rt::string_view;

private:
	rt::string contents;
	diagnostic_message_state state;
};

struct DiagnosticNote {
	Token location;
	rt::string message;
};

struct DiagnosticRecord {
	Token location;
	rt::string message;
	rt::buffer<DiagnosticNote> notes;
};

struct Diagnostics {
	fn Diagnostics(var Diagnostics& this) : [default];
	fn Diagnostics(var Diagnostics& this, var NativeFile* output);

	fn error(var Diagnostics& this, Token& location, rt::string_view& message);
	fn syntax_error(var Diagnostics& this, Token& location, rt::string_view& message);
	fn note(var Diagnostics& this, Token& location, rt::string_view& message);
	fn replay(Diagnostics& this, var NativeFile* output);
	fn records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>&;
	fn set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context);
	fn cancelled(Diagnostics& this) -> bool;

	fn failed(Diagnostics& this) -> bool;

private:
	var NativeFile* output;
	diagnostic_state state;
	rt::buffer<DiagnosticRecord> messages;
	((var void*) -> i32)* cancellation;
	var void* cancellation_context;

	fn write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view& severity, rt::string_view& message);
};

fn DiagnosticMessage::text(var DiagnosticMessage& this, rt::string_view& value) {
	if (this.state == diagnostic_message_state::complete && !@this.contents.append(value)) {
		@this.state = diagnostic_message_state::unavailable;
	};
};

fn DiagnosticMessage::quoted(var DiagnosticMessage& this, rt::string_view& value) {
	@this.text(rt::string_view("'", 1));
	usize index = 0;
	while (index < value.size()) {
		char byte = value.data()[index];
		if (byte == '\n') {
			@this.text(rt::string_view("\\n", 2));
		}
		else if (byte == '\r') {
			@this.text(rt::string_view("\\r", 2));
		}
		else if (byte == '\t') {
			@this.text(rt::string_view("\\t", 2));
		}
		else if (byte == '\0') {
			@this.text(rt::string_view("\\0", 2));
		}
		else if (byte == '\\' || byte == '\'') {
			@this.text(rt::string_view("\\", 1));
			@this.text(rt::string_view(&@byte, 1));
		}
		else {
			@this.text(rt::string_view(&@byte, 1));
		};
		@index = index + 1;
	};
	@this.text(rt::string_view("'", 1));
};

fn DiagnosticMessage::number(var DiagnosticMessage& this, u64 value) {
	char[20] digits;
	usize begin = sizeof(digits);
	while (true) {
		@begin = begin - 1;
		@digits[begin] = static_cast<char>(value % 10 + static_cast<u64>('0'));
		@value = value / 10;
		if (!value) {
			break;
		};
	};
	@this.text(rt::string_view(&@digits[begin], sizeof(digits) - begin));
};

fn DiagnosticMessage::view(DiagnosticMessage& this) -> rt::string_view {
	if (this.state == diagnostic_message_state::unavailable) {
		return rt::string_view("cannot format diagnostic: insufficient memory", 45);
	};
	return this.contents.view();
};

fn Diagnostics::Diagnostics(var Diagnostics& this, var NativeFile* output) {
	@this.output = $output;
};

fn Diagnostics::failed(Diagnostics& this) -> bool {
	return this.state == diagnostic_state::failed || this.cancelled();
};

fn Diagnostics::error(var Diagnostics& this, Token& location, rt::string_view& message) {
	@this.state = diagnostic_state::failed;
	DiagnosticRecord record;
	@record.location = location;
	@record.message.append(message);
	@this.messages.push_back($record);
	this.write(this.output, location, "error\0", message);
};

fn Diagnostics::note(var Diagnostics& this, Token& location, rt::string_view& message) {
	if (!this.messages.size()) {
		return;
	};
	DiagnosticNote note;
	@note.location = location;
	@note.message.append(message);
	var DiagnosticRecord* records = @this.messages.data();
	var DiagnosticRecord& record = @records[this.messages.size() - 1];
	@record.notes.push_back($note);
	this.write(this.output, location, "note\0", message);
};

fn Diagnostics::records(Diagnostics& this) -> rt::buffer<DiagnosticRecord>& {
	return this.messages;
};

fn Diagnostics::set_cancellation(var Diagnostics& this, ((var void*) -> i32)* callback, var void* context) {
	@this.cancellation = $callback;
	@this.cancellation_context = $context;
};

fn Diagnostics::cancelled(Diagnostics& this) -> bool {
	return this.cancellation && this.cancellation(this.cancellation_context) != 0;
};

fn Diagnostics::write(Diagnostics& this, var NativeFile* output, Token& location, rt::string_view& severity, rt::string_view& message) {

	if (!output) {
		return;
	};

	var path = rt::string_view("<compiler>", 10);

	if (location.source) {
		@path = location.source->path();
	};

	usize path_size = path.size();
	usize message_size = message.size();

	if (path_size > static_cast<usize>(i32::max)) {
		@path_size = static_cast<usize>(i32::max);
	};

	if (message_size > static_cast<usize>(i32::max)) {
		@message_size = static_cast<usize>(i32::max);
	};

	fprintf(output, "%.*s:%llu:%llu: %.*s: %.*s\n\0", static_cast<i32>($path_size), path.data(), u64(location.line), u64(location.column), static_cast<i32>(severity.size()), severity.data(), static_cast<i32>($message_size), message.data());
};

fn Diagnostics::replay(Diagnostics& this, var NativeFile* output) {
	usize index = 0;
	while (index < this.messages.size()) {
		DiagnosticRecord& record = this.messages.data()[index];
		this.write(output, record.location, "error\0", record.message.view());
		usize note = 0;
		while (note < record.notes.size()) {
			DiagnosticNote& related = record.notes.data()[note];
			this.write(output, related.location, "note\0", related.message.view());
			@note = note + 1;
		};
		@index = index + 1;
	};
};

fn Diagnostics::syntax_error(var Diagnostics& this, Token& location, rt::string_view& message) {
	var rendered = DiagnosticMessage();
	@rendered.text(message);
	if (location.source) {
		if (location.kind == token_kind::eof) {
			@rendered.text(rt::string_view("; found end of file", 19));
		}
		else if (location.length) {
			@rendered.text(rt::string_view("; found ", 8));
			@rendered.quoted(location.text());
		};
	};
	@this.error(location, rendered.view());
};

struct SourceReader {
	fn SourceReader(var SourceReader& this, FileOpener opener, var SourceManager& sources, var Diagnostics& diagnostics);

	fn load(var SourceReader& this, rt::string_view& path) -> var SourceFile*;

private:
	fn error(var SourceReader& this, rt::string_view& path, rt::string_view& operation);
	FileOpener opener;
	var SourceManager* sources;
	var Diagnostics* diagnostics;
};

fn SourceReader::error(var SourceReader& this, rt::string_view& path, rt::string_view& operation) {
	var message = DiagnosticMessage();
	@message.text(operation);
	@message.text(rt::string_view(" source file ", 13));
	@message.quoted(path);
	Token location;
	@this.diagnostics->error(location, message.view());
};

fn SourceReader::SourceReader(var SourceReader& this, FileOpener opener, var SourceManager& sources, var Diagnostics& diagnostics) {
	@this.opener = $opener;
	@this.sources = &@sources;
	@this.diagnostics = &@diagnostics;
};

fn SourceReader::load(var SourceReader& this, rt::string_view& path) -> var SourceFile* {
	var native_path = rt::string(path);
	var file = File(this.opener(native_path.c_str(), "rb\0"));

	if (!file.is_open()) {
		@this.error(path, rt::string_view("cannot open", 11));
		return nullptr;
	};

	rt::string contents;
	char[4096] chunk {};

	while (true) {
		usize count = @file.read(&@chunk[0], sizeof(chunk));

		if (!count) {
			break;
		};

		if (!@contents.append(rt::string_view(&@chunk[0], $count))) {
			@this.error(path, rt::string_view("cannot buffer", 13));
			return nullptr;
		};
	};

	if (file.failed()) {
		@this.error(path, rt::string_view("cannot read", 11));
		return nullptr;
	};

	if (!@file.close()) {
		@this.error(path, rt::string_view("cannot close", 12));
		return nullptr;
	};

	var SourceFile* source = @this.sources->add(path, contents.view());

	if (!source) {
		@this.error(path, rt::string_view("cannot retain", 13));
	};

	return $source;
};

enum output_kind : [u08] {
	executable;
	library;
};

struct TemplateInstantiation;

enum entity_kind : [u08] {
	function;
	global;
	local;
	parameter;
	record;
	field;
	enumeration;
	enumerator;
	namespace_body;
	alias;
	type_parameter;
	template_pattern;
	primitive_type;
	constant;
};

enum entity_state : [u08] {
	declared;
	resolving;
	ready;
};

enum binding_lifetime : [u08] {
	live;
	consumed;
};

enum function_definition : [u08] {
	declaration;
	user_defined;
	defaulted;
	deleted;
};

enum function_completion : [u08] {
	unchecked;
	reaches_end;
	no_fallthrough;
};

enum function_role : [u08] {
	ordinary;
	constructor;
	destructor;
	assignment;
	conversion;
};

enum conversion_mode : [u08] {
	explicit_only;
	implicit_allowed;
};

enum access_kind : [u08] {
	public_access;
	protected_access;
	private_access;
};

enum record_layout : [u08] {
	sequential;
	overlapping;
};

enum function_dispatch : [u08] {
	ordinary;
	virtual_function;
	override_function;
	final_function;
};

enum declaration_origin : [u08] {
	source;
	compiler_supplied;
};

struct Scope;
struct CopyAssignmentPlan;

struct Entity {
	fn Entity(var Entity& this, entity_kind kind, Token& token, var Syntax* source, var Scope* scope);

	fn kind(Entity& this) -> entity_kind;
	fn canonical(Entity& this) -> var Entity*;
	fn token(Entity& this) -> Token;
	fn name(Entity& this) -> rt::string_view;
	fn set_name(var Entity& this, rt::string_view& name) -> bool;
	fn origin(Entity& this) -> declaration_origin;
	fn set_origin(var Entity& this, declaration_origin origin);
	fn merge_into(var Entity& this, var Entity* canonical);
	fn adopt_definition(var Entity& this, Entity& source) -> bool;

	fn type(Entity& this) -> Type*;
	fn set_type(var Entity& this, Type* type);
	fn type_use(Entity& this) -> rt::optional_ref<const TypeUse>&;
	fn set_type_use(var Entity& this, TypeUse& use);
	fn underlying(Entity& this) -> Type*;
	fn set_underlying(var Entity& this, Type* type);
	fn denotes_type(Entity& this) -> bool;
	fn layout(Entity& this) -> record_layout;
	fn member_owner(Entity& this) -> var Entity*;
	fn accessible_from(Entity& this, Scope& scope) -> bool;
	fn bases(Entity& this) -> rt::buffer<Type*>&;
	fn add_base(var Entity& this, Type* type) -> bool;

	fn declaration(Entity& this) -> var Syntax*;
	fn replace_declaration(var Entity& this, var Syntax* syntax);
	fn scope(Entity& this) -> var Scope*;
	fn resolution_scope(Entity& this) -> var Scope*;
	fn set_resolution_scope(var Entity& this, var Scope* scope);
	fn members(Entity& this) -> var Scope*;
	fn set_members(var Entity& this, var Scope* scope);
	fn find_member(Entity& this, rt::string_view& name) -> var Entity*;

	fn parameters(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_parameter(var Entity& this, var Entity* parameter) -> bool;
	fn fields(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_field(var Entity& this, var Entity* field) -> bool;
	fn index(Entity& this) -> usize;
	fn set_index(var Entity& this, usize index);
	fn body(Entity& this) -> var SemanticExpression*;
	fn set_body(var Entity& this, rt::unique<SemanticExpression> body);
	fn body_state(Entity& this) -> entity_state;
	fn set_body_state(var Entity& this, entity_state state);
	fn completion(Entity& this) -> function_completion;
	fn set_completion(var Entity& this, function_completion completion);

	fn destructor(Entity& this) -> var Entity*;
	fn set_destructor(var Entity& this, var Entity* function);
	fn default_constructor(Entity& this) -> var Entity*;
	fn set_default_constructor(var Entity& this, var Entity* function);
	fn copy_constructor(Entity& this) -> var Entity*;
	fn set_copy_constructor(var Entity& this, var Entity* function);
	fn move_constructor(Entity& this) -> var Entity*;
	fn set_move_constructor(var Entity& this, var Entity* function);
	fn copy_assignment(Entity& this) -> var CopyAssignmentPlan*;
	fn set_copy_assignment(var Entity& this, rt::unique<CopyAssignmentPlan> plan);

	fn virtual_owner(Entity& this) -> var Entity*;
	fn owns_dispatch(Entity& this) -> bool;
	fn virtual_functions(Entity& this) -> rt::buffer<var Entity*>&;
	fn add_virtual(var Entity& this, var Entity* function) -> bool;
	fn replace_virtual(var Entity& this, usize index, var Entity& function);
	fn dispatch(Entity& this) -> function_dispatch;
	fn set_dispatch(var Entity& this, function_dispatch dispatch);
	fn declares_virtual(Entity& this) -> bool;
	fn requires_override(Entity& this) -> bool;
	fn is_final(Entity& this) -> bool;
	fn merge_dispatch(var Entity& this, Entity& source);
	fn virtual_slot(Entity& this) -> usize;
	fn set_virtual_slot(var Entity& this, usize slot);
	fn dispatch_required(Entity& this) -> bool;
	fn require_dispatch(var Entity& this);

	fn definition(Entity& this) -> function_definition;
	fn set_definition(var Entity& this, function_definition definition);
	fn role(Entity& this) -> function_role;
	fn set_role(var Entity& this, function_role role);
	fn conversion(Entity& this) -> conversion_mode;
	fn set_conversion(var Entity& this, conversion_mode mode);
	fn access(Entity& this) -> access_kind;
	fn set_access(var Entity& this, access_kind access);
	fn operator_kind(Entity& this) -> token_kind;
	fn set_operator_kind(var Entity& this, token_kind operation);

	fn state(Entity& this) -> entity_state;
	fn set_state(var Entity& this, entity_state state);
	fn lifetime(Entity& this) -> binding_lifetime;
	fn set_lifetime(var Entity& this, binding_lifetime lifetime);
	fn integer(Entity& this) -> u64;
	fn set_integer(var Entity& this, u64 value);
	fn instantiated(Entity& this) -> bool;
	fn set_instantiated(var Entity& this);
	fn template_arguments(Entity& this) -> TemplateInstantiation*;
	fn set_template_arguments(var Entity& this, TemplateInstantiation* arguments);

private:
	entity_kind category;
	declaration_origin declaration_origin_kind;
	rt::string generated_name;
	entity_state resolution;
	entity_state body_resolution;
	function_completion body_completion;
	bool template_instance;
	TemplateInstantiation* retained_arguments;
	bool virtual_specified;
	bool override_specified;
	bool final_specified;
	bool dispatch_live;
	usize dispatch_slot;
	function_definition body_kind;
	function_role function_kind;
	conversion_mode conversion_kind;
	access_kind visibility;
	token_kind operator_symbol;
	binding_lifetime validity;
	Token location;
	var Syntax* source;
	var Scope* declaration_scope;
	var Scope* definition_scope;
	var Scope* member_scope;
	var Entity* previous_declaration;
	var Entity* finalizer;
	var Entity* default_initializer;
	var Entity* copy_initializer;
	rt::unique<CopyAssignmentPlan> copy_assigner;
	var Entity* move_initializer;
	Type* value_type;
	rt::optional_ref<const TypeUse> use;
	Type* underlying_type;
	usize position;
	u64 constant_value;
	rt::buffer<var Entity*> arguments;
	rt::buffer<var Entity*> member_fields;
	rt::buffer<Type*> base_types;
	rt::buffer<var Entity*> dispatch_table;
	rt::unique<SemanticExpression> implementation;
};

fn Entity::find_member(Entity& this, rt::string_view& name) -> var Entity* {
	if (!this.members()) {
		return nullptr;
	};

	var Entity* result = this.members()->local(name);

	if (result || this.bases().size() != 1) {
		return result;
	};

	var Entity* base = this.bases().data()[0]->entity();

	if (base->name() == name) {
		return $base;
	};

	return base->find_member(name);
};

fn Entity::virtual_owner(Entity& this) -> var Entity* {
	if (!this.virtual_functions().size()) {
		return nullptr;
	};

	if (this.bases().size() && this.bases().data()[0]->entity()->virtual_functions().size()) {
		return this.bases().data()[0]->entity()->virtual_owner();
	};

	return const_cast<var Entity*>(&@this);
};

fn Entity::owns_dispatch(Entity& this) -> bool {
	return this.virtual_functions().size() && (!this.bases().size() || !this.bases().data()[0]->entity()->virtual_functions().size());
};

fn Entity::virtual_functions(Entity& this) -> rt::buffer<var Entity*>& {
	return this.dispatch_table;
};

fn Entity::add_virtual(var Entity& this, var Entity* function) -> bool {
	return @this.dispatch_table.push_back($function);
};

fn Entity::replace_virtual(var Entity& this, usize index, var Entity& function) {
	var entries = (@this.dispatch_table).data();
	@entries[index] = &@function;
};

fn Entity::dispatch(Entity& this) -> function_dispatch {
	if (this.final_specified) {
		return function_dispatch::final_function;
	};

	if (this.override_specified) {
		return function_dispatch::override_function;
	};

	if (this.virtual_specified) {
		return function_dispatch::virtual_function;
	};

	return function_dispatch::ordinary;
};

fn Entity::declares_virtual(Entity& this) -> bool {
	return this.virtual_specified;
};

fn Entity::requires_override(Entity& this) -> bool {
	return this.override_specified;
};

fn Entity::is_final(Entity& this) -> bool {
	return this.final_specified;
};

fn Entity::set_dispatch(var Entity& this, function_dispatch dispatch) {
	if (dispatch == function_dispatch::virtual_function) {
		@this.virtual_specified = true;
	};

	if (dispatch == function_dispatch::override_function) {
		@this.override_specified = true;
	};

	if (dispatch == function_dispatch::final_function) {
		@this.final_specified = true;
	};
};

fn Entity::merge_dispatch(var Entity& this, Entity& source) {
	@this.virtual_specified = this.virtual_specified || source.virtual_specified;
	@this.override_specified = this.override_specified || source.override_specified;
	@this.final_specified = this.final_specified || source.final_specified;
};

fn Entity::virtual_slot(Entity& this) -> usize {
	return this.dispatch_slot;
};

fn Entity::set_virtual_slot(var Entity& this, usize slot) {
	@this.dispatch_slot = $slot;
};

fn Entity::dispatch_required(Entity& this) -> bool {
	return this.dispatch_live;
};

fn Entity::require_dispatch(var Entity& this) {
	@this.dispatch_live = true;
};

fn Entity::bases(Entity& this) -> rt::buffer<Type*>& {
	return this.base_types;
};

fn Entity::add_base(var Entity& this, Type* type) -> bool {
	return @this.base_types.push_back($type);
};

fn Entity::Entity(var Entity& this, entity_kind kind, Token& token, var Syntax* source, var Scope* scope) {
	@this.category = $kind;
	@this.location := token;
	@this.source = $source;
	@this.declaration_scope = $scope;
};

fn Entity::kind(Entity& this) -> entity_kind {
	return entity_kind(this.category);
};

fn Entity::layout(Entity& this) -> record_layout {
	if (this.declaration() && this.declaration()->token().kind == token_kind::kw_union) {
		return record_layout::overlapping;
	};

	return record_layout::sequential;
};

fn Entity::denotes_type(Entity& this) -> bool {
	switch (this.kind()) {
		case entity_kind::primitive_type:
		case entity_kind::record:
		case entity_kind::enumeration:
		case entity_kind::alias:
		case entity_kind::type_parameter:
			return true;
		case entity_kind::template_pattern:
			return this.declaration()->kind() == syntax_kind::template_declaration && (this.declaration()->template_declaration()->kind() == syntax_kind::record || this.declaration()->template_declaration()->kind() == syntax_kind::using_alias);
		default:
			return false;
	};
};

fn Entity::member_owner(Entity& this) -> var Entity* {
	if (this.kind() == entity_kind::alias || this.kind() == entity_kind::type_parameter) {
		if (!this.type() || this.type()->kind() != type_kind::named) {
			return nullptr;
		};

		return this.type()->entity();
	};

	if (this.members()) {
		return const_cast<var Entity*>(&@this);
	};

	return nullptr;
};

fn Entity::instantiated(Entity& this) -> bool {
	return this.template_instance;
};

fn Entity::set_instantiated(var Entity& this) {
	@this.template_instance = true;
};

fn Entity::body_state(Entity& this) -> entity_state {
	return entity_state(this.body_resolution);
};

fn Entity::set_body_state(var Entity& this, entity_state state) {
	@this.body_resolution = $state;
};

fn Entity::completion(Entity& this) -> function_completion {
	return function_completion(this.body_completion);
};

fn Entity::set_completion(var Entity& this, function_completion completion) {
	@this.body_completion = $completion;
};

fn Entity::canonical(Entity& this) -> var Entity* {
	if (this.previous_declaration) {
		return this.previous_declaration->canonical();
	};

	return const_cast<var Entity*>(&@this);
};

fn Entity::token(Entity& this) -> Token {
	return Token(this.location);
};

fn Entity::name(Entity& this) -> rt::string_view {
	if (!this.generated_name.empty()) {
		return this.generated_name.view();
	};

	return this.location.text();
};

fn Entity::set_name(var Entity& this, rt::string_view& name) -> bool {
	return @this.generated_name.append(name);
};

fn Entity::origin(Entity& this) -> declaration_origin {
	return declaration_origin(this.declaration_origin_kind);
};

fn Entity::set_origin(var Entity& this, declaration_origin origin) {
	@this.declaration_origin_kind = $origin;
};

fn Entity::type_use(Entity& this) -> rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn Entity::set_type_use(var Entity& this, TypeUse& use) {
	@this.use.bind(use);
};

fn Entity::type(Entity& this) -> Type* {
	return this.value_type;
};

fn Entity::declaration(Entity& this) -> var Syntax* {
	return this.source;
};

fn Entity::scope(Entity& this) -> var Scope* {
	return this.declaration_scope;
};

fn Entity::resolution_scope(Entity& this) -> var Scope* {
	if (this.definition_scope) {
		return this.definition_scope;
	};

	return this.declaration_scope;
};

fn Entity::set_resolution_scope(var Entity& this, var Scope* scope) {
	@this.definition_scope = $scope;
};

fn Entity::members(Entity& this) -> var Scope* {
	return this.member_scope;
};

fn Entity::body(Entity& this) -> var SemanticExpression* {
	return this.implementation.get();
};

fn Entity::parameters(Entity& this) -> rt::buffer<var Entity*>& {
	return this.arguments;
};

fn Entity::fields(Entity& this) -> rt::buffer<var Entity*>& {
	return this.member_fields;
};

fn Entity::index(Entity& this) -> usize {
	return this.position;
};

fn Entity::state(Entity& this) -> entity_state {
	return entity_state(this.resolution);
};

fn Entity::lifetime(Entity& this) -> binding_lifetime {
	return binding_lifetime(this.validity);
};

fn Entity::integer(Entity& this) -> u64 {
	return this.constant_value;
};

fn Entity::underlying(Entity& this) -> Type* {
	return this.underlying_type;
};

fn Entity::destructor(Entity& this) -> var Entity* {
	if (!this.finalizer) {
		return nullptr;
	};

	return this.finalizer->canonical();
};

fn Entity::default_constructor(Entity& this) -> var Entity* {
	return this.default_initializer;
};

fn Entity::copy_constructor(Entity& this) -> var Entity* {
	return this.copy_initializer;
};

fn Entity::move_constructor(Entity& this) -> var Entity* {
	return this.move_initializer;
};

fn Entity::set_default_constructor(var Entity& this, var Entity* function) {
	@this.default_initializer = $function;
};

fn Entity::set_copy_constructor(var Entity& this, var Entity* function) {
	@this.copy_initializer = $function;
};

fn Entity::set_move_constructor(var Entity& this, var Entity* function) {
	@this.move_initializer = $function;
};

fn Entity::definition(Entity& this) -> function_definition {
	return function_definition(this.body_kind);
};

fn Entity::role(Entity& this) -> function_role {
	return function_role(this.function_kind);
};

fn Entity::conversion(Entity& this) -> conversion_mode {
	return conversion_mode(this.conversion_kind);
};

fn Entity::access(Entity& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Entity::set_access(var Entity& this, access_kind access) {
	@this.visibility = $access;
};

fn Entity::operator_kind(Entity& this) -> token_kind {
	return token_kind(this.operator_symbol);
};

fn Entity::set_operator_kind(var Entity& this, token_kind operation) {
	@this.operator_symbol = $operation;
};

fn Entity::set_definition(var Entity& this, function_definition definition) {
	@this.body_kind = $definition;
};

fn Entity::set_role(var Entity& this, function_role role) {
	@this.function_kind = $role;
};

fn Entity::set_conversion(var Entity& this, conversion_mode mode) {
	@this.conversion_kind = $mode;
};

fn Entity::set_destructor(var Entity& this, var Entity* function) {
	@this.finalizer = $function;
};

fn Entity::set_type(var Entity& this, Type* type) {
	@this.value_type = $type;
};

fn Entity::merge_into(var Entity& this, var Entity* canonical) {
	@this.previous_declaration = $canonical;
};

fn Entity::replace_declaration(var Entity& this, var Syntax* syntax) {
	@this.source = $syntax;
};

fn Entity::adopt_definition(var Entity& this, Entity& source) -> bool {
	@this.source = source.declaration();
	@this.member_scope = source.members();
	@this.body_kind = source.definition();
	@this.function_kind = source.role();

	if (source.conversion() == conversion_mode::implicit_allowed) {
		@this.conversion_kind = conversion_mode::implicit_allowed;
	};

	@this.arguments.clear();
	usize index = 0;
	while (index < source.parameters().size()) {
		if (!@this.arguments.push_back(source.parameters().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Entity::set_members(var Entity& this, var Scope* scope) {
	@this.member_scope = $scope;
};

fn Entity::set_body(var Entity& this, rt::unique<SemanticExpression> body) {
	@this.implementation = $body;
	@this.body_completion = function_completion::unchecked;
};

fn Entity::set_state(var Entity& this, entity_state state) {
	@this.resolution = $state;
};

fn Entity::set_lifetime(var Entity& this, binding_lifetime lifetime) {
	@this.validity = $lifetime;
};

fn Entity::set_integer(var Entity& this, u64 value) {
	@this.constant_value = $value;
};

fn Entity::set_underlying(var Entity& this, Type* type) {
	@this.underlying_type = $type;
};

fn Entity::set_index(var Entity& this, usize index) {
	@this.position = $index;
};

fn Entity::add_parameter(var Entity& this, var Entity* parameter) -> bool {
	return @this.arguments.push_back($parameter);
};

fn Entity::add_field(var Entity& this, var Entity* field) -> bool {
	return @this.member_fields.push_back($field);
};

fn Entity::template_arguments(Entity& this) -> TemplateInstantiation* {
	return this.retained_arguments;
};

fn Entity::set_template_arguments(var Entity& this, TemplateInstantiation* arguments) {
	@this.retained_arguments = $arguments;
};

fn Entity::accessible_from(Entity& this, Scope& scope) -> bool {
	Scope* scope_cursor = &@scope;

	if (this.access() == access_kind::public_access) {
		return true;
	};

	while (scope_cursor) {
		if (scope_cursor->owner() == this.scope()->owner()) {
			return true;
		};

		if (this.access() == access_kind::protected_access && scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record && this.scope()->owner() && scope_cursor->owner()->type() && this.scope()->owner()->type() && scope_cursor->owner()->type()->derived_from(*this.scope()->owner()->type())) {
			return true;
		};

		@scope_cursor = scope_cursor->parent();
	};

	return false;
};

struct Scope {
	fn Scope(var Scope& this, var Scope* parent, var Entity* owner);

	fn set_access(var Scope& this, access_kind access);
	fn define(var Scope& this, var Entity* entity) -> bool;

	fn parent(Scope& this) -> var Scope*;
	fn owner(Scope& this) -> var Entity*;
	fn bindings(Scope& this) -> rt::buffer<var Entity*>&;
	fn access(Scope& this) -> access_kind;
	fn local(Scope& this, rt::string_view& name) -> var Entity*;
	fn lookup(Scope& this, rt::string_view& name) -> var Entity*;

private:
	var Scope* enclosing;
	var Entity* declaration_owner;
	access_kind visibility;
	rt::buffer<var Entity*> names;
};

fn Scope::Scope(var Scope& this, var Scope* parent, var Entity* owner) {
	@this.enclosing = $parent;
	@this.declaration_owner = $owner;
};

fn Scope::parent(Scope& this) -> var Scope* {
	return this.enclosing;
};

fn Scope::owner(Scope& this) -> var Entity* {
	return this.declaration_owner;
};

fn Scope::bindings(Scope& this) -> rt::buffer<var Entity*>& {
	return this.names;
};

fn Scope::access(Scope& this) -> access_kind {
	return access_kind(this.visibility);
};

fn Scope::set_access(var Scope& this, access_kind access) {
	@this.visibility = $access;
};

fn Scope::local(Scope& this, rt::string_view& name) -> var Entity* {
	usize index = this.names.size();
	while (index) {
		@index = index - 1;
		var Entity* entity := this.names.data()[index];

		if (entity->name() == name) {
			return $entity;
		};
	};

	return nullptr;
};

fn Scope::lookup(Scope& this, rt::string_view& name) -> var Entity* {
	if (this.declaration_owner && this.declaration_owner->kind() == entity_kind::record && this.declaration_owner->name() == name) {
		return this.declaration_owner;
	};

	var Entity* result = this.local(name);

	if (!result && this.declaration_owner && this.declaration_owner->kind() == entity_kind::record) {
		@result = this.declaration_owner->find_member(name);
	};

	if (result || !this.enclosing) {
		return $result;
	};

	return this.enclosing->lookup(name);
};

fn Scope::define(var Scope& this, var Entity* entity) -> bool {
	return @this.names.push_back($entity);
};

enum value_category : [u08] {
	place;
	consumable;
};

enum semantic_kind : [u08] {
	noop;
	literal_integer;
	literal_real;
	literal_text;
	null_pointer;
	name;
	unary;
	binary;
	call;
	brace;
	statements;
	sequence;
	deferred_argument;
	variable;
	return_value;
	conditional;
	switch_expression;
	case_label;
	while_loop;
	for_loop;
	break_loop;
	continue_loop;
	cast;
	relocation;
	access;
	dereference;
	address;
	index;
	member;
	construction;
	allocation;
	deallocation;
	array_deallocation;
	destruction;
	sizeof_type;
	discard_value;
};

struct SemanticExpression {
	fn SemanticExpression(var SemanticExpression& this, semantic_kind kind, Type* type, Token& token);

	fn set_type_use(var SemanticExpression& this, TypeUse& use);
	fn set_mutable_access(var SemanticExpression& this, bool permitted);
	fn append(var SemanticExpression& this, rt::unique<SemanticExpression> child) -> bool;
	fn bind(var SemanticExpression& this, var Entity* entity, value_category category);
	fn set_category(var SemanticExpression& this, value_category category);
	fn set_integer(var SemanticExpression& this, u64 value);
	fn set_real(var SemanticExpression& this, f64 value);
	fn set_text(var SemanticExpression& this, rt::string_view& value) -> bool;

	fn copy_constant(SemanticExpression& this) -> rt::unique<SemanticExpression>;
	fn constant_truth(SemanticExpression& this, var bool& result) -> bool;
	fn constant_integer(SemanticExpression& this, var u64& result) -> bool;
	fn constant_real(SemanticExpression& this, var f64& result) -> bool;
	fn real_comparison(SemanticExpression& this, var u64& result) -> bool;
	fn owned_binding(SemanticExpression& this) -> var Entity*;
	fn indirect_storage(SemanticExpression& this) -> bool;
	fn kind(SemanticExpression& this) -> semantic_kind;
	fn type_use(SemanticExpression& this) -> rt::optional_ref<const TypeUse>&;
	fn type(SemanticExpression& this) -> Type*;
	fn token(SemanticExpression& this) -> Token;
	fn entity(SemanticExpression& this) -> var Entity*;
	fn operation(SemanticExpression& this) -> token_kind;
	fn category(SemanticExpression& this) -> value_category;
	fn mutable_access(SemanticExpression& this) -> bool;
	fn integer(SemanticExpression& this) -> u64;
	fn real(SemanticExpression& this) -> f64;
	fn text(SemanticExpression& this) -> rt::string_view;
	fn size(SemanticExpression& this) -> usize;
	fn item(SemanticExpression& this, usize index) -> var SemanticExpression*;

private:
	semantic_kind category_kind;
	value_category value_kind;
	bool reference_access;
	Type* value_type;
	rt::optional_ref<const TypeUse> use;
	Token location;
	var Entity* binding;
	u64 integer_value;
	f64 real_value;
	rt::string text_value;
	rt::buffer<rt::unique<SemanticExpression>> children;
};

fn SemanticExpression::owned_binding(SemanticExpression& this) -> var Entity* {
	if (this.kind() == semantic_kind::name) {
		var Entity* entity = this.entity();

		if (entity && (entity->kind() == entity_kind::local || entity->kind() == entity_kind::parameter) && entity->type()->kind() != type_kind::reference) {
			return $entity;
		};

		return nullptr;
	};

	if (this.kind() == semantic_kind::access || this.kind() == semantic_kind::cast && this.category() == value_category::place) {
		return this.item(0)->owned_binding();
	};

	return nullptr;
};

fn SemanticExpression::indirect_storage(SemanticExpression& this) -> bool {
	switch (this.kind()) {
		case semantic_kind::dereference:
			return true;
		case semantic_kind::index:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::member:
			return this.item(0)->type()->kind() == type_kind::pointer || this.item(0)->indirect_storage();
		case semantic_kind::access:
		case semantic_kind::cast:
			return this.category() == value_category::place && this.item(0)->indirect_storage();
		default:
			return false;
	};
};

fn SemanticExpression::SemanticExpression(var SemanticExpression& this, semantic_kind kind, Type* type, Token& token) {
	@this.category_kind = $kind;
	@this.value_type = $type;
	@this.location := token;
	@this.value_kind = value_category::consumable;
};

fn SemanticExpression::kind(SemanticExpression& this) -> semantic_kind {
	return semantic_kind(this.category_kind);
};

fn SemanticExpression::type_use(SemanticExpression& this) -> rt::optional_ref<const TypeUse>& {
	return this.use;
};

fn SemanticExpression::set_type_use(var SemanticExpression& this, TypeUse& use) {
	@this.use.bind(use);
};

fn SemanticExpression::type(SemanticExpression& this) -> Type* {
	return this.value_type;
};

fn SemanticExpression::token(SemanticExpression& this) -> Token {
	return Token(this.location);
};

fn SemanticExpression::entity(SemanticExpression& this) -> var Entity* {
	return this.binding;
};

fn SemanticExpression::operation(SemanticExpression& this) -> token_kind {
	return token_kind(this.location.kind);
};

fn SemanticExpression::category(SemanticExpression& this) -> value_category {
	return value_category(this.value_kind);
};

fn SemanticExpression::mutable_access(SemanticExpression& this) -> bool {
	if (this.type()->qualifier() == type_qualifier::immutable) {
		return false;
	};

	if (this.kind() == semantic_kind::access || this.reference_access) {
		return true;
	};

	return this.binding && this.binding->type() && this.binding->type()->kind() == type_kind::reference && this.binding->type()->element()->qualifier() == type_qualifier::mutable;
};

fn SemanticExpression::set_mutable_access(var SemanticExpression& this, bool permitted) {
	@this.reference_access = $permitted;
};

fn SemanticExpression::integer(SemanticExpression& this) -> u64 {
	return this.integer_value;
};

fn SemanticExpression::real(SemanticExpression& this) -> f64 {
	return this.real_value;
};

fn SemanticExpression::text(SemanticExpression& this) -> rt::string_view {
	return this.text_value.view();
};

fn SemanticExpression::size(SemanticExpression& this) -> usize {
	return this.children.size();
};

fn SemanticExpression::item(SemanticExpression& this, usize index) -> var SemanticExpression* {
	if (index >= this.children.size()) {
		return nullptr;
	};

	return this.children.data()[index].get();
};

fn SemanticExpression::append(var SemanticExpression& this, rt::unique<SemanticExpression> child) -> bool {
	if (!child.get()) {
		return false;
	};

	return @this.children.push_back($child);
};

fn SemanticExpression::bind(var SemanticExpression& this, var Entity* entity, value_category category) {
	@this.binding = $entity;
	@this.value_kind = $category;
};

fn SemanticExpression::set_category(var SemanticExpression& this, value_category category) {
	@this.value_kind = $category;
};

fn SemanticExpression::set_integer(var SemanticExpression& this, u64 value) {
	@this.integer_value = $value;
};

fn SemanticExpression::set_real(var SemanticExpression& this, f64 value) {
	@this.real_value = $value;
};

fn SemanticExpression::set_text(var SemanticExpression& this, rt::string_view& value) -> bool {
	return @this.text_value.append(value);
};

enum template_argument_kind : [u08] {
	type;
	value;
};

struct TemplateArgument {
	template_argument_kind kind;
	Type* type;
	rt::optional_ref<const TypeUse> type_use;
	u64 value;

	fn same(TemplateArgument& this, TemplateArgument& other) -> bool;
};

struct TemplateInstantiation {
	var Entity* pattern;
	usize source_argument_count;
	rt::buffer<TemplateArgument> arguments;
};

struct AssociatedScope {
	Type* type;
	var Entity* owner;
};

struct ResolvedReference {
	Token location;
	var Entity* target;
	var Entity* context;
	u32 roles;
};

struct TemplateOrigin {
	var Entity* instance;
	var Entity* pattern;
};

struct SemanticScopeRegion {
	var Scope* scope;
	var Syntax* syntax;
};

struct SemanticCallSite {
	var Scope* scope;
	var Syntax* syntax;
	var Entity* selected;
	var Entity* candidates;
	bool bound_receiver;
};

struct SemanticReceiverSite {
	var Scope* scope;
	var Syntax* syntax;
	var Entity* owner;
};

struct SemanticClassification {
	Token location;
	u32 type;
	u32 modifiers;
};

struct SemanticUnit {
	fn associate(var SemanticUnit& this, Type& type, var Entity& owner) -> bool;
	fn canonical_use(var SemanticUnit& this, Type& type) -> TypeUse*;
	fn retype_use(var SemanticUnit& this, TypeUse& source, Type& type) -> TypeUse*;
	fn describe_type(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, Type& type) -> TypeUse*;
	fn describe_entity(var SemanticUnit& this, var Analyzer& analyzer, var Entity& entity) -> bool;
	fn describe_expression(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, Syntax& syntax, var SemanticExpression& expression) -> bool;
	fn leaf_use(var SemanticUnit& this, Type& type) -> TypeUse*;
	fn indirect_use(var SemanticUnit& this, Type& type, TypeUse& element) -> TypeUse*;
	fn function_use(var SemanticUnit& this, Type& type, rt::buffer<ParameterUse> parameters, TypeUse& result) -> TypeUse*;
	fn create_scope(var SemanticUnit& this, var Scope* parent, var Entity* owner) -> var Scope*;
	fn create_entity(var SemanticUnit& this, entity_kind kind, Token& token, var Syntax* syntax, var Scope* scope) -> var Entity*;

	fn associated_owner(SemanticUnit& this, Type& type) -> var Entity*;
	fn entities(SemanticUnit& this) -> rt::buffer<rt::unique<Entity>>&;
	fn root_scope(SemanticUnit& this) -> var Scope*;

	fn record_name(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Entity& target, u32 roles) -> bool;
	fn record_reference(var SemanticUnit& this, Token& token, var Entity& target, var Entity* context, u32 roles) -> bool;
	fn record_origin(var SemanticUnit& this, var Entity& instance, var Entity& pattern, rt::buffer<TemplateArgument>& arguments, usize source_argument_count) -> bool;
	fn reference_context(SemanticUnit& this, var Scope& scope) -> var Entity*;
	fn template_origin(SemanticUnit& this, Entity& entity) -> var Entity*;
	fn record_scope(var SemanticUnit& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn record_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, SemanticExpression& expression) -> bool;
	fn scope_regions(SemanticUnit& this) -> rt::buffer<SemanticScopeRegion>&;
	fn record_incomplete_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& group, bool bound_receiver) -> bool;
	fn record_receiver(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& owner) -> bool;
	fn receiver_sites(SemanticUnit& this) -> rt::buffer<SemanticReceiverSite>&;
	fn call_sites(SemanticUnit& this) -> rt::buffer<SemanticCallSite>&;
	fn record_classification(var SemanticUnit& this, Token& location, u32 type, u32 modifiers) -> bool;
	fn classifications(SemanticUnit& this) -> rt::buffer<SemanticClassification>&;
	fn references(SemanticUnit& this) -> rt::buffer<ResolvedReference>&;

private:
	fn retain_use(var SemanticUnit& this, rt::unique<TypeUse> use) -> TypeUse*;

	fn available_use(SemanticUnit& this, SemanticExpression& expression) -> TypeUse*;

	rt::buffer<AssociatedScope> associated_scopes;
	rt::buffer<rt::unique<TypeUse>> type_uses;
	rt::buffer<rt::unique<FunctionUse>> function_uses;
	rt::buffer<ResolvedReference> resolved_references;
	rt::buffer<SemanticClassification> token_classifications;
	rt::buffer<TemplateOrigin> template_origins;
	rt::buffer<rt::unique<TemplateInstantiation>> template_instantiations;
	rt::buffer<SemanticScopeRegion> regions;
	rt::buffer<SemanticCallSite> calls;
	rt::buffer<SemanticReceiverSite> receivers;
	var Scope* global_scope;
	rt::buffer<rt::unique<Scope>> scopes;
	rt::buffer<rt::unique<Entity>> declarations;
};

fn SemanticUnit::entities(SemanticUnit& this) -> rt::buffer<rt::unique<Entity>>& {
	return this.declarations;
};

fn SemanticUnit::root_scope(SemanticUnit& this) -> var Scope* {
	return this.global_scope;
};

fn SemanticUnit::create_scope(var SemanticUnit& this, var Scope* parent, var Entity* owner) -> var Scope* {
	var owned = rt::unique<Scope>(new var Scope($parent, $owner));
	var Scope* result = owned.get();

	if (!result) {
		return nullptr;
	};

	if (!@this.scopes.push_back($owned)) {
		return nullptr;
	};

	if (!this.global_scope) {
		@this.global_scope := result;
	};

	return $result;
};

fn SemanticUnit::create_entity(var SemanticUnit& this, entity_kind kind, Token& token, var Syntax* syntax, var Scope* scope) -> var Entity* {
	var owned = rt::unique<Entity>(new var Entity($kind, token, $syntax, scope));
	var Entity* result = owned.get();

	if (!result) {
		return nullptr;
	};

	@result->set_access(scope->access());

	if (scope->owner() && scope->owner()->instantiated()) {
		@result->set_instantiated();
	};

	if (!@this.declarations.push_back($owned)) {
		return nullptr;
	};

	if (!@scope->define((var Entity*(result)))) {
		return nullptr;
	};

	return $result;
};

fn SemanticUnit::record_reference(var SemanticUnit& this, Token& token, var Entity& target, var Entity* context, u32 roles) -> bool {
	if (!token.source || !token.length || target.origin() == declaration_origin::compiler_supplied) {
		return true;
	};
	ResolvedReference reference;
	@reference.location = token;
	@reference.target = target.canonical();
	@reference.context = $context;
	@reference.roles = $roles;
	return @this.resolved_references.push_back($reference);
};

fn SemanticUnit::record_origin(var SemanticUnit& this, var Entity& instance, var Entity& pattern, rt::buffer<TemplateArgument>& arguments, usize source_argument_count) -> bool {
	var metadata = rt::unique<TemplateInstantiation>::make();
	if (!metadata.get()) {
		return false;
	};
	@metadata.get()->pattern = &@pattern;
	@metadata.get()->source_argument_count = $source_argument_count;
	usize index = 0;
	while (index < arguments.size()) {
		TemplateArgument& source = arguments.data()[index];
		TemplateArgument argument;
		@argument.kind = source.kind;
		@argument.type = source.type;
		@argument.type_use = source.type_use;
		@argument.value = source.value;
		if (!@metadata.get()->arguments.push_back($argument)) {
			return false;
		};
		@index = index + 1;
	};
	TemplateInstantiation* retained = metadata.get();
	if (!@this.template_instantiations.push_back($metadata)) {
		return false;
	};
	@instance.set_template_arguments(retained);

	TemplateOrigin origin;
	@origin.instance = &@instance;
	@origin.pattern = &@pattern;
	return @this.template_origins.push_back($origin);
};

fn SemanticUnit::reference_context(SemanticUnit& this, var Scope& scope) -> var Entity* {
	var Scope* current = &@scope;
	while (current) {
		var Entity* owner = current->owner();
		if (owner && owner->instantiated()) {
			return owner->canonical();
		};
		@current = current->parent();
	};
	return nullptr;
};

fn SemanticUnit::template_origin(SemanticUnit& this, Entity& entity) -> var Entity* {
	usize index = 0;
	while (index < this.template_origins.size()) {
		TemplateOrigin& origin = this.template_origins.data()[index];
		if (origin.instance == &@entity) {
			return origin.pattern;
		};
		@index = index + 1;
	};
	return nullptr;
};

fn SemanticUnit::references(SemanticUnit& this) -> rt::buffer<ResolvedReference>& {
	return this.resolved_references;
};

fn SemanticUnit::record_name(var SemanticUnit& this, var Analyzer& analyzer, var Scope& scope, var Syntax& name, var Entity& target, u32 roles) -> bool {
	if (name.kind() == syntax_kind::type_name) {
		return @this.record_name(@analyzer, @scope, @*name.designated_type(), @target, $roles);
	};
	if (name.kind() == syntax_kind::call || name.kind() == syntax_kind::template_apply) {
		return @this.record_name(@analyzer, @scope, @*name.callable(), @target, $roles);
	};
	if (name.kind() == syntax_kind::member) {
		return @this.record_name(@analyzer, @scope, @*name.member_name(), @target, $roles);
	};
	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @analyzer.lookup(@scope, @*name.left());
		if (owner && !@this.record_name(@analyzer, @scope, @*name.left(), @*owner, 2)) {
			return false;
		};
		return @this.record_name(@analyzer, @scope, @*name.right(), @target, $roles);
	};
	if (name.kind() == syntax_kind::unary) {
		return @this.record_name(@analyzer, @scope, @*name.operand(), @target, $roles);
	};
	return @this.record_reference(name.token(), @target, this.reference_context(@scope), $roles);
};

fn SemanticUnit::record_scope(var SemanticUnit& this, var Scope& scope, var Syntax& syntax) -> bool {
	SemanticScopeRegion region;
	@region.scope = &@scope;
	@region.syntax = &@syntax;
	return @this.regions.push_back($region);
};

fn SemanticUnit::scope_regions(SemanticUnit& this) -> rt::buffer<SemanticScopeRegion>& {
	return this.regions;
};

fn SemanticUnit::call_sites(SemanticUnit& this) -> rt::buffer<SemanticCallSite>& {
	return this.calls;
};

fn SemanticUnit::record_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, SemanticExpression& expression) -> bool {
	if (syntax.kind() != syntax_kind::call) {
		return true;
	};
	SemanticExpression* call = &@expression;
	while (call->kind() != semantic_kind::call && call->size() == 1) {
		@call = call->item(0);
	};
	if (call->kind() != semantic_kind::call || !call->entity()) {
		return true;
	};
	SemanticCallSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.selected = call->entity()->canonical();
	@site.bound_receiver = syntax.callable()->kind() == syntax_kind::member && call->size() > 1 && call->item(1)->size() == syntax.arguments()->size() + 1;
	return @this.calls.push_back($site);
};

fn SemanticUnit::record_receiver(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& owner) -> bool {
	SemanticReceiverSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.owner = &@owner;

	return @this.receivers.push_back($site);
};

fn SemanticUnit::receiver_sites(SemanticUnit& this) -> rt::buffer<SemanticReceiverSite>& {
	return this.receivers;
};

fn SemanticUnit::record_incomplete_call(var SemanticUnit& this, var Scope& scope, var Syntax& syntax, var Entity& group, bool bound_receiver) -> bool {
	SemanticCallSite site;
	@site.scope = &@scope;
	@site.syntax = &@syntax;
	@site.candidates = &@group;
	@site.bound_receiver = $bound_receiver;

	return @this.calls.push_back($site);
};

fn SemanticUnit::record_classification(var SemanticUnit& this, Token& location, u32 type, u32 modifiers) -> bool {
	SemanticClassification classification;
	@classification.location = location;
	@classification.type = $type;
	@classification.modifiers = $modifiers;

	return @this.token_classifications.push_back($classification);
};

fn SemanticUnit::classifications(SemanticUnit& this) -> rt::buffer<SemanticClassification>& {
	return this.token_classifications;
};

fn strtod(char* text, var char var** end) -> f64;

struct SwitchAnalysis;

struct ConversionSelection {
	var Entity* selected;
	var Entity* conflict;

	fn unique(ConversionSelection& this) -> var Entity*;
};

struct Analyzer {
	fn Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits);

	fn set_editor(var Analyzer& this, bool enabled);
	fn analyze(var Analyzer& this, rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit>;
	fn editor_template_context(var Analyzer& this, var SemanticUnit& unit, var SourceFile& source, usize anchor, var Syntax& arguments, var rt::string& label) -> bool;
	fn analyze_into(var Analyzer& this, var SemanticUnit& unit, rt::buffer<rt::unique<Syntax>>& syntax) -> bool;
	fn error(var Analyzer& this, var Syntax* syntax, rt::string_view& message);
	fn report(var Analyzer& this, Token& token, rt::string_view& message);
	fn note(var Analyzer& this, Token& token, rt::string_view& message);
	fn deleted_function(var Analyzer& this, Token& token, Entity& function);
	fn cancelled(Analyzer& this) -> bool;
	fn failed(Analyzer& this) -> bool;
	fn infer_variable(var Analyzer& this, var Syntax& declaration, SemanticExpression& initializer) -> Type*;
	fn type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type*;
	fn lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity*;
	fn primitive_scope(var Analyzer& this, Type& type, Token& location) -> var Entity*;
	fn primitive_constants(var Analyzer& this, var Entity& owner) -> bool;
	fn collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn resolve(var Analyzer& this, var Entity* entity) -> bool;
	fn integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> bool;
	fn expression(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn function_body(var Analyzer& this, var Entity* entity) -> bool;
	fn global_initializer(var Analyzer& this, var Entity& entity) -> bool;
	fn constant_integer(var Analyzer& this, SemanticExpression& expression, var u64& result) -> bool;
	fn validate_dispatch_syntax(var Analyzer& this, var Syntax& syntax, bool class_scope) -> bool;

	fn semantic_unit(Analyzer& this) -> var SemanticUnit*;
	fn type_store(Analyzer& this) -> var TypeStore*;
	fn accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool;

private:
	bool editor;
	fn resolve_impl(var Analyzer& this, var Entity* entity) -> bool;
	fn recovery_operand(Analyzer& this, Syntax& syntax) -> bool;
	fn expression_impl(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn names_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool;
	fn size_query(var Analyzer& this, var Syntax& syntax, Type& type) -> rt::unique<SemanticExpression>;
	fn selection(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn label(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn prepare_expression(var Analyzer& this, var SemanticExpression* expression) -> bool;
	fn prepare_lifetime(var Analyzer& this, Type* type) -> bool;
	fn prepare_default(var Analyzer& this, Type* type) -> bool;
	fn prepare_copy(var Analyzer& this, Type* type) -> bool;
	fn prepare_copy_assignment(var Analyzer& this, Type* type) -> bool;
	fn field_initializer(var Analyzer& this, var Entity* entity) -> bool;
	fn resolve_bases(var Analyzer& this, var Entity* entity) -> bool;
	fn build_dispatch(var Analyzer& this, var Entity* entity) -> bool;
	fn supply_special_functions(var Analyzer& this, var Entity* entity) -> bool;
	fn contextual_argument(var Analyzer& this, var Scope& scope, var Syntax& syntax, TypeUse& use, rt::optional<ParameterLabel>& name) -> rt::unique<SemanticExpression>;
	fn contextual_arguments(var Analyzer& this, var Scope& scope, var Syntax& syntax, var SemanticExpression& callable, var rt::buffer<rt::unique<SemanticExpression>>& values) -> bool;
	fn supply_special(var Analyzer& this, var Entity* entity, function_role role, token_kind operation, Type* source, function_definition definition) -> var Entity*;
	fn node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression>;
	fn unary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn binary(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn call(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected, bool accessed) -> rt::unique<SemanticExpression>;
	fn cast(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn component(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn member_value(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::unique<SemanticExpression> object, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn construct(var Analyzer& this, var Scope& scope, var Syntax& syntax, Type* type, var Syntax& arguments) -> rt::unique<SemanticExpression>;
	fn construct_values(var Analyzer& this, var Syntax& syntax, Type* type, rt::buffer<rt::unique<SemanticExpression>> raw) -> rt::unique<SemanticExpression>;
	fn initialize(var Analyzer& this, var Syntax& syntax, Type* type, rt::unique<SemanticExpression> value) -> rt::unique<SemanticExpression>;
	fn select_candidates(var Analyzer& this, rt::buffer<var Entity*>& candidates, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn invoke(var Analyzer& this, var Syntax& syntax, var Entity* selected, rt::unique<SemanticExpression> callable, rt::buffer<rt::unique<SemanticExpression>> values, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn overloaded(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::buffer<rt::unique<SemanticExpression>> arguments, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression>;
	fn select(var Analyzer& this, var Entity* group, rt::buffer<rt::unique<SemanticExpression>>& arguments, usize skipped, conversion_mode mode, var Syntax& syntax) -> var Entity*;
	fn convert(var Analyzer& this, rt::unique<SemanticExpression> value, rt::optional_ref<const Type>& expected, var Syntax& syntax) -> rt::unique<SemanticExpression>;
	fn argument_rank(var Analyzer& this, SemanticExpression& value, Type& expected) -> i32;
	fn implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> var Entity*;
	fn select_implicit_constructor(var Analyzer& this, SemanticExpression& value, Type& expected) -> ConversionSelection;
	fn conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> var Entity*;
	fn select_conversion_function(var Analyzer& this, SemanticExpression& value, Type& expected, conversion_mode mode) -> ConversionSelection;

	fn compatible(Analyzer& this, Type* source, Type* target) -> bool;
	fn builtin_rank(Analyzer& this, SemanticExpression& value, Type& expected) -> i32;

	var TypeStore* types;
	var Diagnostics* diagnostics;
	var SemanticUnit* unit;
	var Entity* function;
	u32 pointer_bits;
	usize loop_depth;
	var SwitchAnalysis* active_switch;
	TemplateEngine templates;
};

fn Analyzer::error(var Analyzer& this, var Syntax* syntax, rt::string_view& message) {
	Token token;

	if (syntax) {
		@token = syntax->token();
	};

	@this.diagnostics->error(token, message);
};

fn Analyzer::node(var Analyzer& this, semantic_kind kind, Type* type, var Syntax* syntax) -> rt::unique<SemanticExpression> {
	Token location;

	if (syntax) {
		@location = syntax->token();
	};

	var result = rt::unique<SemanticExpression>(new var SemanticExpression($kind, type, location));

	if (!result.get()) {
		@this.error(syntax, rt::string_view("out of memory during semantic analysis", 38));
	};

	return $result;
};


fn Analyzer::lookup(var Analyzer& this, var Scope& scope, var Syntax& name) -> var Entity* {
	if (name.kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@scope, @*name.left());

		if (!owner || !@this.resolve((var Entity*(owner)))) {
			return nullptr;
		};

		var Entity* associated = owner->member_owner();

		if (!associated && owner->denotes_type() && owner->type()) {
			@associated = @this.primitive_scope(*owner->type(), owner->token());
		};

		@owner := associated;

		if (!owner) {
			return nullptr;
		};

		if (!@this.unit->record_receiver(@scope, @name, @*owner)) {
			return nullptr;
		};

		var Syntax* member = name.right();

		if (member->kind() == syntax_kind::template_apply) {
			if (!owner->members()->local(member->callable()->token().text())) {
				return nullptr;
			};

			return @this.templates.apply(@this, @*owner->members(), @scope, @*member);
		};

		return owner->find_member(member->token().text());
	};

	if (name.kind() == syntax_kind::template_apply) {
		return @this.templates.apply(@this, @scope, @scope, @name);
	};

	var Entity* result = scope.lookup(name.token().text());

	if (result) {
		return result;
	};

	Type* primitive = this.types->find_primitive(name.token().text());

	if (!primitive) {
		return nullptr;
	};

	return @this.primitive_scope(*primitive, name.token());
};

fn Analyzer::integer(var Analyzer& this, var Syntax& syntax, var u64& result) -> bool {
	if (syntax.kind() != syntax_kind::number) {
		return false;
	};

	var text = syntax.token().text();
	u64 value = 0;
	u64 base = 10;
	usize index = 0;

	if (text.size() > 2 && text.data()[0] == '0') {
		if (text.data()[1] == 'x' || text.data()[1] == 'X') {
			@base = 16;
			@index = 2;
		}
		else if (text.data()[1] == 'b' || text.data()[1] == 'B') {
			@base = 2;
			@index = 2;
		};
	};

	while (index < text.size()) {
		char character := text.data()[index];
		@index = index + 1;

		if (character == '_') {
			continue;
		};

		u64 digit = 0;

		if (character >= '0' && character <= '9') {
			@digit = static_cast<u64>(character - '0');
		}
		else if (character >= 'a' && character <= 'f') {
			@digit = static_cast<u64>(character - 'a') + 10;
		}
		else if (character >= 'A' && character <= 'F') {
			@digit = static_cast<u64>(character - 'A') + 10;
		}
		else {
			return false;
		};

		if (digit >= base || value > (u64::max - digit) / base) {
			return false;
		};

		@value = value * base + digit;
	};

	@result = $value;

	return true;
};

fn Analyzer::type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> Type* {
	if (syntax.kind() == syntax_kind::absent) {
		return nullptr;
	};

	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::type_auto) {
		Type* element = @this.type(@scope, @*syntax.designated_type());
		Type* actual = this.templates.qualifier(@scope, @syntax);

		if (!element || !actual) {
			if (this.failed()) {
				return nullptr;
			};
			@this.error(&@syntax, rt::string_view("automatic qualification requires a deduced parameter binding", 60));

			return nullptr;
		};

		return @this.types->qualified(*element, actual->qualifier());
	};

	if (kind == syntax_kind::type_name) {
		return @this.type(@scope, @*syntax.designated_type());
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		var Entity* entity = @this.lookup(@scope, @syntax);
		if (this.failed()) {
			return nullptr;
		};

		if (kind == syntax_kind::name && !entity) {
			Type* builtin = this.types->find_primitive(syntax.token().text());

			if (builtin) {
				return $builtin;
			};
		};

		if (!entity || !entity->denotes_type()) {
			var message = DiagnosticMessage();
			if (!entity) {
				@message.text(rt::string_view("unknown type name '", 19));
			}
			else {
				@message.text(rt::string_view("name does not denote a type: '", 30));
			};
			diagnostic_name(@message, syntax);
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());
			if (entity) {
				@this.note(entity->token(), rt::string_view("referenced declaration is here", 30));
			};

			return nullptr;
		};

		if (!this.accessible(*entity, @scope)) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("type '", 6));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("' is not accessible from this scope", 35));
			@this.report(syntax.token(), message.view());
			@this.note(entity->token(), rt::string_view("type is declared here", 21));

			return nullptr;
		};

		if (!@this.resolve((var Entity*(entity)))) {
			return nullptr;
		};

		if (!@this.unit->record_name(@this, @scope, @syntax, @*entity, 2)) {
			@this.error(&@syntax, rt::string_view("navigation index storage is unavailable", 39));
			return nullptr;
		};
		return entity->type();
	};

	if (kind == syntax_kind::type_function) {
		rt::buffer<Type*> parameters;
		parameter_arity arity = parameter_arity::fixed;
		var Syntax* list = syntax.function_type_parameters();
		usize index = 0;
		while (list && index < list->size()) {
			var Syntax* parameter = list->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			if (parameter->kind() == syntax_kind::parameter) {
				@parameter = parameter->parameter_type();
			};

			Type* resolved = @this.type(@scope, @*parameter);

			if (!resolved) {
				return nullptr;
			};

			if (!@parameters.push_back(resolved)) {
				return nullptr;
			};

			@index = index + 1;
		};

		Type* result = @this.type(@scope, @*syntax.function_type_result());

		if (!result) {
			@result = this.types->find_primitive(rt::string_view("void", 4));
		};

		return @this.types->function($result, $parameters, parameter_arity(arity));
	};

	if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference || kind == syntax_kind::type_array || (kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
		Type* element = @this.type(@scope, @*syntax.designated_type());

		if (!element) {
			return nullptr;
		};

		if ((kind == syntax_kind::type_const || kind == syntax_kind::type_mutable)) {
			var Syntax* condition = syntax.qualifier_condition();

			if (condition && condition->kind() != syntax_kind::absent) {
				var Entity* parameter = nullptr;
				var Scope* context = &@scope;

				while (context && !parameter) {
					var Entity* owner = context->owner();

					if (owner && owner->kind() == entity_kind::function) {
						usize index = 0;
						while (index < owner->parameters().size()) {
							var Entity* candidate := owner->parameters().data()[index];

							if (candidate->name() == condition->token().text()) {
								@parameter := candidate;
								break;
							};

							@index = index + 1;
						};
					};

					@context = context->parent();
				};

				if (!parameter) {
					@parameter = @this.lookup(@scope, @*condition);
				};

				if (!parameter || !parameter->type()) {
					if (this.failed()) {
						return nullptr;
					};
					var message = DiagnosticMessage();
					@message.text(rt::string_view("conditional qualification requires a named parameter; '", 55));
					diagnostic_name(@message, *condition);
					@message.text(rt::string_view("' does not provide a parameter type", 35));
					@this.report(condition->token(), message.view());

					return nullptr;
				};

				Type* actual = parameter->type();

				if (actual->kind() == type_kind::reference) {
					@actual = actual->element();
				};

				if (actual->qualifier() == type_qualifier::immutable) {
					return @this.types->qualified(*element, type_qualifier::immutable);
				};
				return $element;
			};

			if (kind == syntax_kind::type_mutable) {
				return $element;
			};
			return @this.types->qualified(*element, type_qualifier::immutable);
		};

		if (kind == syntax_kind::type_pointer || kind == syntax_kind::type_reference) {
			if (!syntax.designated_type()->explicitly_qualified()) {
				@element = @this.types->qualified(*element, type_qualifier::immutable);
				if (!element) {
					return nullptr;
				};
			};
		};
		if (kind == syntax_kind::type_pointer) {
			return @this.types->pointer(element);
		};

		if (element->kind() == type_kind::void_type || element->kind() == type_kind::null_type || element->kind() == type_kind::reference) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("cannot form ", 12));
			if (kind == syntax_kind::type_reference) {
				@message.text(rt::string_view("a reference to '", 16));
			}
			else {
				@message.text(rt::string_view("an array of '", 13));
			};
			diagnostic_type(@message, *element);
			@message.text(rt::string_view("'; the element type has no object storage", 41));
			@this.report(syntax.token(), message.view());

			return nullptr;
		};

		if (kind == syntax_kind::type_reference) {
			return @this.types->reference(element);
		};

		u64 count = 0;
		var extent = @this.expression(@scope, @*syntax.array_extent(), rt::optional_ref<const Type>());

		if (!extent.get()) {
			return nullptr;
		};

		if (!extent.get()->type()->kind().is_integer()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be a positive integer constant; received type '", 66));
			diagnostic_type(@message, *extent.get()->type());
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!@this.constant_integer(*extent.get(), @count)) {
			if (this.failed()) {
				return nullptr;
			};
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be a positive integer constant; expression beginning with ", 77));
			@message.quoted(syntax.array_extent()->token().text());
			@message.text(rt::string_view(" of type '", 10));
			diagnostic_type(@message, *extent.get()->type());
			@message.text(rt::string_view("' is not constant", 17));
			@this.report(syntax.array_extent()->token(), message.view());
			return nullptr;
		};

		if (!count) {
			@this.report(syntax.array_extent()->token(), rt::string_view("array extent shall be a positive integer constant; received 0", 61));

			return nullptr;
		};

		if (extent.get()->type()->kind() == type_kind::signed_integer && count & (u64(1) << (static_cast<u64>(extent.get()->type()->bits()) - 1))) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("array extent shall be positive; received -", 42));
			@message.number(u64(0) - u64(extent.get()->type()->signed_value(count)));
			@this.report(syntax.array_extent()->token(), message.view());

			return nullptr;
		};

		return @this.types->array(element, $count);
	};

	var message = DiagnosticMessage();
	@message.text(rt::string_view("unsupported type syntax beginning with ", 39));
	@message.quoted(syntax.token().text());
	@this.report(syntax.token(), message.view());

	return nullptr;
};

fn Analyzer::collect(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool {
	var Scope* scope_cursor = &@scope;
	syntax_kind kind = syntax.kind();

	if (kind == syntax_kind::unit || kind == syntax_kind::brace || kind == syntax_kind::list) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!@this.collect(@*scope_cursor, @*syntax.item(index))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return true;
	};

	if (kind == syntax_kind::access_label) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("access label ", 13));
			@message.quoted(syntax.token().text());
			@message.text(rt::string_view(" requires class scope; current scope is ", 40));
			if (scope_cursor->owner()) {
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(rt::string_view(" ", 1));
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text(rt::string_view("module scope", 12));
			};
			@this.report(syntax.token(), message.view());
			return false;
		};

		Token token = syntax.token();

		if (token.is(rt::string_view("private", 7))) {
			@scope_cursor->set_access(access_kind::private_access);
		}
		else if (token.is(rt::string_view("protected", 9))) {
			@scope_cursor->set_access(access_kind::protected_access);
		}
		else {
			@scope_cursor->set_access(access_kind::public_access);
		};

		return true;
	};

	if (kind == syntax_kind::ambiguity) {
		var Syntax* declaration = nullptr;
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			syntax_kind category = candidate->kind();

			if (category == syntax_kind::variable || category == syntax_kind::function || category == syntax_kind::record || category == syntax_kind::enumeration || category == syntax_kind::namespace_body || category == syntax_kind::template_declaration || category == syntax_kind::using_alias) {
				if (declaration) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("declaration has multiple unresolved interpretations; source begins with ", 72));
					@message.quoted(syntax.token().text());
					if (scope_cursor->owner()) {
						@message.text(rt::string_view(" in ", 4));
						diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
						@message.text(rt::string_view(" ", 1));
						diagnostic_entity(@message, *scope_cursor->owner());
					};
					@this.report(syntax.token(), message.view());
					return false;
				};

				@declaration := candidate;
			};

			@index = index + 1;
		};

		if (!declaration) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("declaration context has no declaration interpretation; source begins with ", 74));
			@message.quoted(syntax.token().text());
			if (scope_cursor->owner()) {
				@message.text(rt::string_view(" in ", 4));
				diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
				@message.text(rt::string_view(" ", 1));
				diagnostic_entity(@message, *scope_cursor->owner());
			};
			@this.report(syntax.token(), message.view());
			return false;
		};

		return @this.collect(@*scope_cursor, @*declaration);
	};

	if (kind == syntax_kind::template_declaration) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	if (kind == syntax_kind::function && this.templates.qualifier_dependent(@syntax)) {
		if (!@this.validate_dispatch_syntax(@syntax, scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record)) {
			return false;
		};

		return @this.templates.collect(@this, @*scope_cursor, @syntax);
	};

	var Syntax* name = nullptr;
	entity_kind category = entity_kind::global;
	var Syntax* members = nullptr;

	if (kind == syntax_kind::function) {
		@name = syntax.function_name();
		@category = entity_kind::function;
	}
	else if (kind == syntax_kind::variable) {
		@name = syntax.variable_name();

		if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
			@category = entity_kind::field;
		};
	}
	else if (kind == syntax_kind::record) {
		@name = syntax.record_name();
		@category = entity_kind::record;
		@members = syntax.record_members();
	}
	else if (kind == syntax_kind::enumeration) {
		@name = syntax.enum_name();
		@category = entity_kind::enumeration;
		@members = syntax.enum_members();
	}
	else if (kind == syntax_kind::enumerator) {
		@name = syntax.item(0);
		@category = entity_kind::enumerator;
	}
	else if (kind == syntax_kind::namespace_body) {
		@name = syntax.namespace_name();
		@category = entity_kind::namespace_body;
		@members = syntax.namespace_members();
	}
	else if (kind == syntax_kind::using_alias) {
		@name = syntax.alias_name();
		@category = entity_kind::alias;
	}
	else {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("declaration required at module or record scope; source begins with ", 67));
		@message.quoted(syntax.token().text());
		if (scope_cursor->owner()) {
			@message.text(rt::string_view(" in ", 4));
			diagnostic_entity_kind(@message, scope_cursor->owner()->kind());
			@message.text(rt::string_view(" ", 1));
			diagnostic_entity(@message, *scope_cursor->owner());
		};
		@this.report(syntax.token(), message.view());
		return false;
	};

	if (!name || name->kind() == syntax_kind::absent) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("declaration requires an unqualified name in its owning scope; ", 62));
		diagnostic_entity_kind(@message, category);
		@message.text(rt::string_view(" declaration begins with ", 25));
		@message.quoted(syntax.token().text());
		@this.report(syntax.token(), message.view());
		return false;
	};

	access_kind declaration_access = scope_cursor->access();

	if (name->kind() == syntax_kind::qualified_name) {
		var Entity* owner = @this.lookup(@*scope_cursor, @*name->left());

		if (!owner || !owner->members()) {
			if (!this.failed()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("cannot declare '", 16));
				diagnostic_name(@message, *name);
				@message.text(rt::string_view("': owner '", 10));
				diagnostic_name(@message, *name->left());
				if (owner) {
					@message.text(rt::string_view("' is a ", 7));
					diagnostic_entity_kind(@message, owner->kind());
					@message.text(rt::string_view(" without a member scope", 23));
				}
				else {
					@message.text(rt::string_view("' is not declared", 17));
				};
				@this.report(name->token(), message.view());
				if (owner) {
					@this.note(owner->token(), rt::string_view("owner is declared here", 22));
				};
			};
			return false;
		};

		@scope_cursor = owner->members();
		@name = name->right();
	};

	var Entity* existing = scope_cursor->local(name->token().text());

	if (existing && category != entity_kind::function) {
		if (existing->kind() != category) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("conflicting declaration kind for ", 33));
			@message.quoted(name->token().text());
			@message.text(rt::string_view(": declaring ", 12));
			diagnostic_entity_kind(@message, category);
			@message.text(rt::string_view(" after ", 7));
			diagnostic_entity_kind(@message, existing->kind());
			@this.report(name->token(), message.view());
			@this.note(existing->token(), rt::string_view("previous declaration is here", 28));
			return false;
		};

		if (category == entity_kind::record) {
			if (members->kind() != syntax_kind::noop) {
				if (existing->declaration()->record_members()->kind() != syntax_kind::noop) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("duplicate record definition for ", 32));
					@message.quoted(name->token().text());
					@message.text(rt::string_view(" (", 2));
					diagnostic_entity_kind(@message, category);
					@message.text(rt::string_view(")", 1));
					@this.report(name->token(), message.view());
					@this.note(existing->token(), rt::string_view("previous record definition is here", 34));
					return false;
				};

				@existing->replace_declaration(&@syntax);
			};
		}
		else if (category != entity_kind::namespace_body) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("duplicate declaration of ", 25));
			@message.quoted(name->token().text());
			@message.text(rt::string_view(" (", 2));
			diagnostic_entity_kind(@message, category);
			@message.text(rt::string_view(")", 1));
			@this.report(name->token(), message.view());
			@this.note(existing->token(), rt::string_view("previous declaration is here", 28));
			return false;
		};
	};

	var Entity* entity = existing;

	if (!entity || category == entity_kind::function) {
		@entity = @this.unit->create_entity(entity_kind(category), name->token(), &@syntax, scope_cursor);

		if (entity) {
			@entity->set_access(access_kind(declaration_access));
		};
	};

	if (!entity) {
		@this.error(&@syntax, rt::string_view("out of memory storing declaration", 33));
		return false;
	};

	if (members) {
		var Scope* nested = entity->members();

		if (!nested) {
			@nested = @this.unit->create_scope(scope_cursor, (var Entity*(entity)));
			@entity->set_members((var Scope*(nested)));
		};

		if (!nested || !@this.collect(@*nested, @*members)) {
			return false;
		};
	};

	if (entity->kind() == entity_kind::field) {
		@entity->set_index(scope_cursor->owner()->fields().size());

		return @scope_cursor->owner()->add_field(entity);
	};

	if (entity->kind() == entity_kind::function && name->kind() == syntax_kind::unary && name->token().kind == token_kind::op_tilde) {
		if (!scope_cursor->owner() || scope_cursor->owner()->kind() != entity_kind::record || !name->operand()->token().same(scope_cursor->owner()->token())) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("destructor '", 12));
			@message.text(rt::string_view("~", 1));
			diagnostic_name(@message, *name->operand());
			@message.text(rt::string_view("' shall name its owning class", 29));
			if (scope_cursor->owner() && scope_cursor->owner()->kind() == entity_kind::record) {
				@message.text(rt::string_view(" ", 1));
				@message.quoted(scope_cursor->owner()->name());
			}
			else {
				@message.text(rt::string_view("; declaration is outside class scope", 36));
			};
			@this.report(name->token(), message.view());
			return false;
		};

		@scope_cursor->owner()->set_destructor(entity);
	};

	return true;
};

fn Analyzer::Analyzer(var Analyzer& this, var TypeStore& types, var Diagnostics& diagnostics, u32 pointer_bits) {
	@this.types = &@types;
	@this.diagnostics = &@diagnostics;
	@this.pointer_bits = $pointer_bits;

	if (!@types.initialize_primitives(this.pointer_bits)) {
		Token location;
		@diagnostics.error(location, rt::string_view("cannot initialize primitive types", 33));
	};
};

fn Analyzer::semantic_unit(Analyzer& this) -> var SemanticUnit* {
	return this.unit;
};

fn Analyzer::type_store(Analyzer& this) -> var TypeStore* {
	return this.types;
};

fn Analyzer::accessible(Analyzer& this, Entity& entity, var Scope& scope) -> bool {
	return entity.accessible_from(@scope);
};

fn Analyzer::set_editor(var Analyzer& this, bool enabled) {
	@this.editor = $enabled;
};

fn Analyzer::recovery_operand(Analyzer& this, Syntax& syntax) -> bool {
	if (syntax.kind() == syntax_kind::error_expression) {
		return true;
	};
	if (syntax.kind() != syntax_kind::unary && syntax.kind() != syntax_kind::binary && syntax.kind() != syntax_kind::index && syntax.kind() != syntax_kind::cast && syntax.kind() != syntax_kind::grouping) {
		return false;
	};
	usize index = 0;
	while (index < syntax.size()) {
		if (this.recovery_operand(*syntax.item(index))) {
			return true;
		};
		@index = index + 1;
	};
	return false;
};

fn diagnostic_entity_kind(var DiagnosticMessage& message, entity_kind kind) {
	switch (kind) {
		case entity_kind::function: {
			@message.text(rt::string_view("function", 8));
			break;
		};
		case entity_kind::global: {
			@message.text(rt::string_view("global variable", 15));
			break;
		};
		case entity_kind::local: {
			@message.text(rt::string_view("local variable", 14));
			break;
		};
		case entity_kind::parameter: {
			@message.text(rt::string_view("parameter", 9));
			break;
		};
		case entity_kind::record: {
			@message.text(rt::string_view("record", 6));
			break;
		};
		case entity_kind::field: {
			@message.text(rt::string_view("field", 5));
			break;
		};
		case entity_kind::enumeration: {
			@message.text(rt::string_view("enumeration", 11));
			break;
		};
		case entity_kind::enumerator: {
			@message.text(rt::string_view("enumerator", 10));
			break;
		};
		case entity_kind::namespace_body: {
			@message.text(rt::string_view("namespace", 9));
			break;
		};
		case entity_kind::alias: {
			@message.text(rt::string_view("type alias", 10));
			break;
		};
		case entity_kind::type_parameter: {
			@message.text(rt::string_view("type parameter", 14));
			break;
		};
		case entity_kind::template_pattern: {
			@message.text(rt::string_view("template", 8));
			break;
		};
		case entity_kind::primitive_type: {
			@message.text(rt::string_view("primitive type", 14));
			break;
		};
		case entity_kind::constant: {
			@message.text(rt::string_view("constant", 8));
			break;
		};
	};
};

fn diagnostic_entity(var DiagnosticMessage& message, Entity& entity) {
	var Scope* scope = entity.scope();
	if (scope && scope->owner() && scope->owner() != &@entity) {
		diagnostic_entity(@message, *scope->owner());
		@message.text(rt::string_view("::", 2));
	};
	@message.text(entity.name());
	TemplateInstantiation* instance = entity.template_arguments();
	if (instance && instance->source_argument_count) {
		@message.text(rt::string_view("<", 1));
		usize index = 0;
		while (index < instance->source_argument_count) {
			if (index) {
				@message.text(rt::string_view(", ", 2));
			};
			TemplateArgument& argument = instance->arguments.data()[index];
			if (argument.kind == template_argument_kind::type) {
				diagnostic_type(@message, *argument.type);
			}
			else {
				if (argument.type && argument.type->kind() == type_kind::signed_integer && argument.type->signed_value(argument.value) < 0) {
					@message.text(rt::string_view("-", 1));
					@message.number(u64(0) - u64(argument.type->signed_value(argument.value)));
				}
				else {
					@message.number(argument.value);
				};
			};
			@index = index + 1;
		};
		@message.text(rt::string_view(">", 1));
	};
};

fn diagnostic_name(var DiagnosticMessage& message, Syntax& syntax) {
	if (syntax.kind() == syntax_kind::qualified_name) {
		diagnostic_name(@message, *syntax.left());
		@message.text(rt::string_view("::", 2));
		diagnostic_name(@message, *syntax.right());
		return;
	};
	if (syntax.kind() == syntax_kind::type_name) {
		diagnostic_name(@message, *syntax.designated_type());
		return;
	};
	if (syntax.kind() == syntax_kind::template_apply) {
		diagnostic_name(@message, *syntax.callable());
		@message.text(rt::string_view("<", 1));
		usize index = 0;
		while (index < syntax.arguments()->size()) {
			if (index) {
				@message.text(rt::string_view(", ", 2));
			};
			diagnostic_name(@message, *syntax.arguments()->item(index));
			@index = index + 1;
		};
		@message.text(rt::string_view(">", 1));
		return;
	};
	@message.text(syntax.token().text());
};

fn diagnostic_indirection_target(var DiagnosticMessage& message, Type& type) {
	bool grouped = type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array || type.kind() == type_kind::function;
	if (type.qualifier() == type_qualifier::mutable) {
		@message.text(rt::string_view("var ", 4));
	};
	if (grouped) {
		@message.text(rt::string_view("(", 1));
	};
	Type view = type.qualified(type_qualifier::mutable);
	diagnostic_type(@message, view);
	if (grouped) {
		@message.text(rt::string_view(")", 1));
	};
};

fn diagnostic_type(var DiagnosticMessage& message, Type& type) {
	if (type.qualifier() == type_qualifier::immutable && type.kind() != type_kind::pointer && type.kind() != type_kind::reference && type.kind() != type_kind::array && type.kind() != type_kind::function) {
		@message.text(rt::string_view("const ", 6));
	};

	switch (type.kind()) {
		case type_kind::void_type: @message.text(rt::string_view("void", 4)); break;
		case type_kind::null_type: @message.text(rt::string_view("null", 4)); break;
		case type_kind::boolean: @message.text(rt::string_view("bool", 4)); break;
		case type_kind::character: @message.text(rt::string_view("char", 4)); break;
		case type_kind::signed_integer:
			@message.text(rt::string_view("i", 1));
			@message.number(u64(type.bits()));
			break;
		case type_kind::unsigned_integer:
			@message.text(rt::string_view("u", 1));
			@message.number(u64(type.bits()));
			break;
		case type_kind::floating_point:
			@message.text(rt::string_view("f", 1));
			@message.number(u64(type.bits()));
			break;
		case type_kind::named:
		case type_kind::parameter:
			diagnostic_entity(@message, *type.entity());
			break;
		case type_kind::pointer:
		case type_kind::reference:
			if (type.kind() == type_kind::pointer && type.qualifier() == type_qualifier::immutable) {
				@message.text(rt::string_view("const (", 7));
			};
			diagnostic_indirection_target(@message, *type.element());
			if (type.kind() == type_kind::pointer) {
				@message.text(rt::string_view("*", 1));
				if (type.qualifier() == type_qualifier::immutable) {
					@message.text(rt::string_view(")", 1));
				};
			}
			else {
				@message.text(rt::string_view("&", 1));
			};
			break;
		case type_kind::array:
			if (type.qualifier() == type_qualifier::immutable) {
				@message.text(rt::string_view("const (", 7));
			};
			diagnostic_type(@message, *type.element());
			@message.text(rt::string_view("[", 1));
			@message.number(type.count());
			@message.text(rt::string_view("]", 1));
			if (type.qualifier() == type_qualifier::immutable) {
				@message.text(rt::string_view(")", 1));
			};
			break;
		case type_kind::function: {
			@message.text(rt::string_view("(", 1));
			FunctionSignature& signature = type.signature();
			usize index = 0;
			while (index < signature.parameters().size()) {
				if (index) {
					@message.text(rt::string_view(", ", 2));
				};
				diagnostic_type(@message, *signature.parameters().data()[index]);
				@index = index + 1;
			};
			if (signature.arity() == parameter_arity::variadic) {
				if (index) {
					@message.text(rt::string_view(", ", 2));
				};
				@message.text(rt::string_view("...", 3));
			};
			@message.text(rt::string_view(") -> ", 5));
			diagnostic_type(@message, *signature.result());
			break;
		};
	};
};

fn Analyzer::cancelled(Analyzer& this) -> bool {
	return this.diagnostics->cancelled();
};

fn Analyzer::failed(Analyzer& this) -> bool {
	return this.diagnostics->failed();
};

fn Analyzer::report(var Analyzer& this, Token& token, rt::string_view& message) {
	@this.diagnostics->error(token, message);
};

fn Analyzer::note(var Analyzer& this, Token& token, rt::string_view& message) {
	@this.diagnostics->note(token, message);
};

fn Analyzer::deleted_function(var Analyzer& this, Token& token, Entity& function) {
	var message = DiagnosticMessage();
	@message.text(rt::string_view("selected function '", 19));
	diagnostic_entity(@message, function);
	@message.text(rt::string_view("' of type '", 11));
	diagnostic_type(@message, *function.type());
	@message.text(rt::string_view("' is deleted", 12));
	@this.report(token, message.view());
	@this.note(function.token(), rt::string_view("function is declared deleted here", 33));
};

fn diagnostic_arguments(var DiagnosticMessage& message, rt::buffer<rt::unique<SemanticExpression>>& arguments) {
	@message.text(rt::string_view("(", 1));
	usize index = 0;
	while (index < arguments.size()) {
		if (index) {
			@message.text(rt::string_view(", ", 2));
		};
		SemanticExpression& argument = *arguments.data()[index].get();
		if (argument.kind() == semantic_kind::deferred_argument) {
			@message.text(rt::string_view("brace expression", 16));
		}
		else {
			diagnostic_type(@message, *argument.type());
		};
		@index = index + 1;
	};
	@message.text(rt::string_view(")", 1));
};

fn diagnostic_candidate(var Diagnostics& diagnostics, Entity& candidate) {
	var detail = DiagnosticMessage();
	@detail.text(rt::string_view("candidate '", 11));
	diagnostic_entity(@detail, candidate);
	@detail.text(rt::string_view("' has type '", 12));
	diagnostic_type(@detail, *candidate.type());
	@detail.text(rt::string_view("'", 1));
	@diagnostics.note(candidate.token(), detail.view());
};

fn diagnostic_conversion_ambiguity(var Diagnostics& diagnostics, Token& token, Type& source, Type& target, ConversionSelection& selection) {
	var message = DiagnosticMessage();
	@message.text(rt::string_view("ambiguous implicit conversion from '", 36));
	diagnostic_type(@message, source);
	@message.text(rt::string_view("' to '", 6));
	diagnostic_type(@message, target);
	@message.text(rt::string_view("'; multiple conversion functions are applicable", 47));
	@diagnostics.error(token, message.view());
	diagnostic_candidate(@diagnostics, *selection.selected);
	diagnostic_candidate(@diagnostics, *selection.conflict);
};

fn diagnostic_candidates(var Diagnostics& diagnostics, Entity& group) {
	rt::buffer<var Entity*>& candidates = group.scope()->bindings();
	usize index = 0;
	while (index < candidates.size()) {
		Entity& candidate = *candidates.data()[index];
		@index = index + 1;
		if (candidate.kind() != entity_kind::function || candidate.name() != group.name() || !candidate.type()) {
			continue;
		};

		diagnostic_candidate(@diagnostics, candidate);
	};
};

fn Analyzer::infer_variable(var Analyzer& this, var Syntax& declaration, SemanticExpression& initializer) -> Type* {
	Type* type = initializer.type();
	if (
		type
		&& type->kind().is_numeric()
		&& type->kind() != type_kind::boolean
		&& type->kind() != type_kind::character
		&& numeric_literal_expression(initializer)
	) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("cannot infer the type of variable ", 34));
		@message.quoted(declaration.variable_name()->token().text());
		@message.text(rt::string_view(" from an untyped numeric literal; specify a variable type or construct a typed value", 84));
		@this.diagnostics->error(declaration.variable_name()->token(), message.view());
		return nullptr;
	};
	return $type;
};

fn SemanticUnit::associated_owner(SemanticUnit& this, Type& type) -> var Entity* {
	usize index = 0;
	while (index < this.associated_scopes.size()) {
		AssociatedScope& association = this.associated_scopes.data()[index];

		if (association.type == &@type) {
			return association.owner;
		};

		@index = index + 1;
	};

	return nullptr;
};

fn SemanticUnit::associate(var SemanticUnit& this, Type& type, var Entity& owner) -> bool {
	AssociatedScope association;
	@association.type = &@type;
	@association.owner = &@owner;

	return @this.associated_scopes.push_back($association);
};

fn Analyzer::primitive_scope(var Analyzer& this, Type& type, Token& location) -> var Entity* {
	if (!type.kind().is_numeric() && type.kind() != type_kind::void_type && type.kind() != type_kind::null_type) {
		return nullptr;
	};

	Type* canonical = @this.types->primitive(type_kind(type.kind()), type.bits());
	if (!canonical) {
		return nullptr;
	};

	var Entity* found = this.unit->associated_owner(*canonical);

	if (found) {
		return found;
	};

	var Scope* declarations = @this.unit->create_scope(this.unit->root_scope(), nullptr);

	if (!declarations) {
		return nullptr;
	};

	var Entity* owner = @this.unit->create_entity(entity_kind::primitive_type, location, nullptr, declarations);

	if (!owner) {
		return nullptr;
	};

	@owner->set_type(canonical);
	@owner->set_origin(declaration_origin::compiler_supplied);
	@owner->set_state(entity_state::ready);
	var Scope* members = @this.unit->create_scope(declarations, (var Entity*(owner)));

	if (!members) {
		return nullptr;
	};

	@owner->set_members((var Scope*(members)));

	if (!@this.unit->associate(*canonical, @*owner) || !@this.primitive_constants(@*owner)) {
		return nullptr;
	};

	return owner;
};

fn Analyzer::primitive_constants(var Analyzer& this, var Entity& owner) -> bool {
	Type* type = owner.type();

	if (!type->kind().is_numeric()) {
		return true;
	};

	Type* value_type = @this.types->qualified(*type, type_qualifier::immutable);
	if (!value_type) {
		return false;
	};

	semantic_kind kind = semantic_kind::literal_integer;

	if (type->kind() == type_kind::floating_point) {
		@kind = semantic_kind::literal_real;
	};

	var value = rt::unique<SemanticExpression>(new var SemanticExpression($kind, value_type, owner.token()));

	if (!value.get()) {
		return false;
	};

	if (type->kind() == type_kind::floating_point) {
		f64 maximum = 0.0;

		if (type->bits() == 32) {
			u32 representation = 2139095039;
			f32 decoded := *reinterpret_cast<f32*>(&@representation);
		@maximum = static_cast<f64>($decoded);
		}
		else {
			u64 representation = 9218868437227405311;
			@maximum := *reinterpret_cast<f64*>(&@representation);
		};

		@value.get()->set_real($maximum);
	}
	else {
		u64 maximum = u64::max >> (64 - static_cast<u64>(type->bits()));

		if (type->kind() == type_kind::signed_integer || type->kind() == type_kind::character) {
			@maximum = maximum >> 1;
		};

		@value.get()->set_integer($maximum);
	};

	var Entity* constant = @this.unit->create_entity(entity_kind::constant, owner.token(), nullptr, owner.members());

	if (!constant || !@constant->set_name(rt::string_view("max", 3))) {
		return false;
	};

	@constant->set_origin(declaration_origin::compiler_supplied);
	@constant->set_type(value_type);
	@constant->set_body($value);
	@constant->set_state(entity_state::ready);
	@constant->set_body_state(entity_state::ready);

	return true;
};

struct FunctionAnalysisScope {
	fn FunctionAnalysisScope(var FunctionAnalysisScope& this, var Entity var*& function, var usize& loop_depth, var SwitchAnalysis var*& selection, rt::optional_ref<Entity>& current);
	fn ~FunctionAnalysisScope(var FunctionAnalysisScope& this);

private:
	var Entity var** function_slot;
	var usize* loop_slot;
	var SwitchAnalysis var** switch_slot;
	var Entity* previous_function;
	usize previous_loop;
	var SwitchAnalysis* previous_switch;
};

fn Analyzer::constant_integer(var Analyzer& this, SemanticExpression& expression, var u64& result) -> bool {
	ConstantEvaluator evaluator;

	return @evaluator.integer(@this, expression, @result);
};

fn Analyzer::prepare_lifetime(var Analyzer& this, Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return @this.prepare_lifetime(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	var Entity* owner = type->entity();

	if (!@this.resolve((var Entity*(owner)))) {
		return false;
	};

	if (owner->virtual_functions().size()) {
		@owner->require_dispatch();
		usize slot = 0;

		while (slot < owner->virtual_functions().size()) {
			if (!@this.function_body(owner->virtual_functions().data()[slot])) {
				return false;
			};

			@slot = slot + 1;
		};
	};

	var Entity* destructor = owner->destructor();

	if (destructor && !@this.function_body((var Entity*(destructor)))) {
		return false;
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_lifetime(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!@this.prepare_lifetime(owner->fields().data()[index]->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_default(var Analyzer& this, Type* type) -> bool {
	if (!@this.prepare_lifetime(type)) {
		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_default(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	var Entity* owner = type->entity();
	var Entity* constructor = nullptr;
	var Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		@constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (!constructor) {
			if (!this.failed()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("default initialization of '", 27));
				diagnostic_type(@message, *type);
				@message.text(rt::string_view("' has no applicable constructor for an empty argument list", 58));
				@this.report(owner->token(), message.view());
				diagnostic_candidates(@*this.diagnostics, *group);
			};
			return false;
		};
		if (constructor->definition() == function_definition::deleted) {
			@this.deleted_function(owner->token(), *constructor);
			return false;
		};
	};

	if (constructor) {
		return @this.function_body(constructor);
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_default(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		var Entity* field = owner->fields().data()[index];

		if (!@this.field_initializer((var Entity*(field)))) {
			return false;
		};

		if (field->body()) {
			if (!@this.prepare_expression(field->body())) {
				return false;
			};
		}
		else if (!@this.prepare_default(field->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_expression(var Analyzer& this, var SemanticExpression* expression) -> bool {
	if (!expression) {
		return true;
	};

	var Entity* selected = expression->entity();

	if (selected && selected->kind() == entity_kind::function && !@this.function_body((var Entity*(selected)))) {
		if (this.failed() && (selected->instantiated() || selected->scope() && this.unit->reference_context(@*selected->scope()))) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("while instantiating function '", 30));
			diagnostic_entity(@message, *selected);
			@message.text(rt::string_view("' requested here", 16));
			@this.note(expression->token(), message.view());
		};
		return false;
	};

	if ((expression->kind() == semantic_kind::variable || expression->kind() == semantic_kind::name) && selected && !@this.prepare_lifetime(selected->type())) {
		return false;
	};

	if (expression->kind() == semantic_kind::construction) {
		if (!@this.prepare_lifetime(expression->type())) {
			return false;
		};

		if (!selected && expression->type()->kind() == type_kind::named && expression->type()->entity()->layout() != record_layout::overlapping) {
			rt::buffer<var Entity*>& fields = expression->type()->entity()->fields();
			usize field = expression->item(0)->size();

			while (field < fields.size()) {
				var Entity* member = fields.data()[field];

				if (!@this.field_initializer((var Entity*(member)))) {
					return false;
				};

				if (!member->body() && !@this.prepare_default(member->type())) {
					return false;
				};

				if (member->body() && !@this.prepare_expression(member->body())) {
					return false;
				};

				@field = field + 1;
			};
		};
	};

	usize index = 0;
	while (index < expression->size()) {
		if (!@this.prepare_expression(expression->item(index))) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::global_initializer(var Analyzer& this, var Entity& entity) -> bool {
	if (!@this.resolve(&@entity)) {
		return false;
	};

	if (entity.body_state() == entity_state::ready) {
		return true;
	};

	if (entity.body_state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("global initializer for '", 24));
		diagnostic_entity(@message, entity);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *entity.type());
		@message.text(rt::string_view("' has a circular dependency", 27));
		@this.report(entity.token(), message.view());
		return false;
	};

	var Syntax* initializer = entity.declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		@entity.set_body_state(entity_state::ready);
		return true;
	};

	@entity.set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (!(entity.type()->kind() == type_kind::named && entity.type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity.type());
	};

	var value = @this.expression(@*entity.scope(), @*initializer, expected);

	if (!value.get()) {
		return false;
	};

	@value = @this.initialize(@*initializer, entity.type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return false;
	};

	@entity.set_body($value);
	@entity.set_body_state(entity_state::ready);

	return @this.prepare_expression(entity.body());
};

fn Analyzer::field_initializer(var Analyzer& this, var Entity* entity) -> bool {
	if (entity->body_state() == entity_state::ready) {
		return true;
	};

	if (entity->body_state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("member initializer for '", 24));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *entity->type());
		@message.text(rt::string_view("' has a circular dependency", 27));
		@this.report(entity->token(), message.view());
		return false;
	};

	var Syntax* initializer = entity->declaration()->variable_initializer();

	if (initializer->kind() == syntax_kind::absent) {
		@entity->set_body_state(entity_state::ready);

		return true;
	};

	if (entity->scope()->owner()->layout() == record_layout::overlapping) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("default initializer for union member '", 38));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *entity->type());
		@message.text(rt::string_view("' is not implemented", 20));
		@this.report(initializer->token(), message.view());
		@this.note(entity->token(), rt::string_view("union member is declared here", 29));
		return false;
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>());

	if (initializer->kind() == syntax_kind::unary) {
		@initializer = initializer->operand();
	};

	rt::optional_ref<const Type> expected;

	if (entity->type()->kind() != type_kind::reference && !(entity->type()->kind() == type_kind::named && entity->type()->entity()->kind() == entity_kind::record)) {
		@expected.bind(*entity->type());
	};

	var value = @this.expression(@*entity->scope(), @*initializer, expected);

	if (!value.get()) {
		return false;
	};

	if (entity->type()->kind() == type_kind::reference && value.get()->category() == value_category::consumable) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("initializer for reference member '", 34));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' of type '", 11));
		diagnostic_type(@message, *entity->type());
		@message.text(rt::string_view("' requires a live place; received a consumable of type '", 56));
		diagnostic_type(@message, *value.get()->type());
		@message.text(rt::string_view("'", 1));
		@this.report(initializer->token(), message.view());
		@this.note(entity->token(), rt::string_view("reference member is declared here", 33));
		return false;
	};

	@value = @this.initialize(@*initializer, entity->type(), rt::unique<SemanticExpression>(@value.release()));

	if (!value.get()) {
		return false;
	};

	@entity->set_body($value);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::prepare_copy(var Analyzer& this, Type* type) -> bool {
	if (type->kind() == type_kind::array) {
		return @this.prepare_copy(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	var Entity* owner = type->entity();
	var Entity* group = owner->members()->local(owner->name());

	if (group && group->kind() == entity_kind::function) {
		rt::buffer<rt::unique<SemanticExpression>> arguments;
		Type* source_type = @this.types->qualified(*type, type_qualifier::immutable);
		var source = @this.node(semantic_kind::name, source_type, owner->declaration());

		if (!source.get()) {
			return false;
		};

		@source.get()->set_category(value_category::place);

		if (!@arguments.push_back($source)) {
			return false;
		};

		var Entity* constructor = @this.select(group, arguments, 1, conversion_mode::explicit_only, @*owner->declaration());

		if (this.diagnostics->failed()) {
			return false;
		};

		if (constructor && constructor->definition() == function_definition::deleted) {
			@this.deleted_function(owner->token(), *constructor);
			return false;
		};

		if (constructor) {
			return @this.function_body(constructor);
		};
	};

	if (owner->layout() == record_layout::overlapping) {
		return true;
	};

	usize index = 0;
	while (index < owner->bases().size()) {
		if (!@this.prepare_copy(owner->bases().data()[index])) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < owner->fields().size()) {
		if (!@this.prepare_copy(owner->fields().data()[index]->type())) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn Analyzer::prepare_copy_assignment(var Analyzer& this, Type* type) -> bool {
	if (type->qualifier() == type_qualifier::immutable || type->kind() == type_kind::reference) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("generated assignment cannot replace component of type '", 55));
		diagnostic_type(@message, *type);
		if (type->kind() == type_kind::reference) {
			@message.text(rt::string_view("' because it is a reference", 27));
		}
		else {
			@message.text(rt::string_view("' because it is const-qualified", 31));
		};
		Token location;
		if (this.function) {
			@location = this.function->token();
			@message.text(rt::string_view(" in function '", 14));
			diagnostic_entity(@message, *this.function);
			@message.text(rt::string_view("'", 1));
		};
		@this.report(location, message.view());

		return false;
	};

	if (type->kind() == type_kind::array) {
		return @this.prepare_copy_assignment(type->element());
	};

	if (type->kind() != type_kind::named || type->entity()->kind() != entity_kind::record) {
		return true;
	};

	var Entity* owner = type->entity();
	rt::buffer<var Entity*> candidates;
	usize index = 0;

	while (index < owner->members()->bindings().size()) {
		var Entity* candidate = owner->members()->bindings().data()[index];
		@index = index + 1;

		if (candidate->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve((var Entity*(candidate)))) {
			return false;
		};

		if (candidate->role() == function_role::assignment && candidate->operator_kind() == token_kind::op_assign && !@candidates.push_back((var Entity*(candidate)))) {
			return false;
		};
	};

	Type* immutable = @this.types->qualified(*type, type_qualifier::immutable);
	var Scope* bindings = @this.unit->create_scope(owner->members(), nullptr);

	if (!bindings) {
		return false;
	};

	var Entity* destination_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);
	var Entity* source_binding = @this.unit->create_entity(entity_kind::parameter, owner->token(), nullptr, bindings);

	if (!destination_binding || !source_binding) {
		return false;
	};

	if (!@destination_binding->set_name(rt::string_view("destination", 11)) || !@source_binding->set_name(rt::string_view("source", 6))) {
		return false;
	};

	@destination_binding->set_origin(declaration_origin::compiler_supplied);
	@source_binding->set_origin(declaration_origin::compiler_supplied);
	@destination_binding->set_type(@this.types->reference(type));
	@source_binding->set_type(@this.types->reference(immutable));
	@destination_binding->set_state(entity_state::ready);
	@source_binding->set_state(entity_state::ready);
	var destination = @this.node(semantic_kind::name, type, owner->declaration());
	var source = @this.node(semantic_kind::name, immutable, owner->declaration());

	if (!destination.get() || !source.get()) {
		return false;
	};

	@destination.get()->bind((var Entity*(destination_binding)), value_category::place);
	@destination.get()->set_mutable_access(true);
	@source.get()->bind((var Entity*(source_binding)), value_category::place);
	rt::buffer<rt::unique<SemanticExpression>> arguments;

	if (!@arguments.push_back($destination)) {
		return false;
	};

	if (!@arguments.push_back($source)) {
		return false;
	};

	var Entity* selected = @this.select_candidates(candidates, arguments, 0, conversion_mode::explicit_only, @*owner->declaration());

	if (!selected) {
		if (!this.failed()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("generated member assignment for '", 33));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' has no applicable assignment function with arguments ", 55));
			diagnostic_arguments(@message, arguments);
			@this.report(owner->token(), message.view());
			usize candidate_index = 0;
			while (candidate_index < candidates.size()) {
				diagnostic_candidate(@*this.diagnostics, *candidates.data()[candidate_index]);
				@candidate_index = candidate_index + 1;
			};
		};
		return false;
	};
	if (selected->definition() == function_definition::deleted) {
		@this.deleted_function(owner->token(), *selected);
		return false;
	};

	var callable = @this.node(semantic_kind::name, selected->type(), owner->declaration());

	if (!callable.get()) {
		return false;
	};

	@callable.get()->bind((var Entity*(selected)), value_category::place);
	var operation = @this.invoke(@*owner->declaration(), selected, $callable, $arguments, rt::optional_ref<const Type>());

	if (!operation.get() || !@this.prepare_expression(operation.get())) {
		return false;
	};

	if (!@this.prepare_lifetime(selected->type()->signature().result())) {
		return false;
	};

	var plan = rt::unique<CopyAssignmentPlan>(new var CopyAssignmentPlan(@*destination_binding, @*source_binding, $operation));

	if (!plan.get()) {
		return false;
	};

	@owner->set_copy_assignment($plan);

	return true;
};

fn FunctionAnalysisScope::FunctionAnalysisScope(var FunctionAnalysisScope& this, var Entity var*& function, var usize& loop_depth, var SwitchAnalysis var*& selection, rt::optional_ref<Entity>& current) {
	@this.function_slot = &@function;
	@this.loop_slot = &@loop_depth;
	@this.switch_slot = &@selection;
	@this.previous_function := function;
	@this.previous_loop := loop_depth;
	@this.previous_switch := selection;
	@function = current.get();
	@loop_depth = 0;
	@selection = nullptr;
};

fn FunctionAnalysisScope::~FunctionAnalysisScope(var FunctionAnalysisScope& this) {
	@*this.function_slot := this.previous_function;
	@*this.loop_slot := this.previous_loop;
	@*this.switch_slot := this.previous_switch;
};

struct CopyAssignmentPlan {
	fn CopyAssignmentPlan(var CopyAssignmentPlan& this, var Entity& destination, var Entity& source, rt::unique<SemanticExpression> expression);
	fn destination(CopyAssignmentPlan& this) -> var Entity&;
	fn source(CopyAssignmentPlan& this) -> var Entity&;
	fn expression(CopyAssignmentPlan& this) -> var SemanticExpression&;

private:
	var Entity* destination_binding;
	var Entity* source_binding;
	rt::unique<SemanticExpression> operation;
};

fn CopyAssignmentPlan::CopyAssignmentPlan(var CopyAssignmentPlan& this, var Entity& destination, var Entity& source, rt::unique<SemanticExpression> expression) {
	@this.destination_binding = &@destination;
	@this.source_binding = &@source;
	@this.operation = $expression;
};

fn CopyAssignmentPlan::destination(CopyAssignmentPlan& this) -> var Entity& {
	return @*this.destination_binding;
};

fn CopyAssignmentPlan::source(CopyAssignmentPlan& this) -> var Entity& {
	return @*this.source_binding;
};

fn CopyAssignmentPlan::expression(CopyAssignmentPlan& this) -> var SemanticExpression& {
	return @*this.operation.get();
};

fn Entity::copy_assignment(Entity& this) -> var CopyAssignmentPlan* {
	return this.copy_assigner.get();
};

fn Entity::set_copy_assignment(var Entity& this, rt::unique<CopyAssignmentPlan> plan) {
	@this.copy_assigner = $plan;
};

fn Analyzer::resolve_impl(var Analyzer& this, var Entity* entity) -> bool {
	if (entity->kind() == entity_kind::template_pattern) {
		return true;
	};

	if (entity->state() == entity_state::ready) {
		return true;
	};

	if (entity->state() == entity_state::resolving) {
		if (entity->kind() == entity_kind::record && entity->type()) {
			return true;
		};

		var message = DiagnosticMessage();
		@message.text(rt::string_view("cyclic entity definition for ", 29));
		diagnostic_entity_kind(@message, entity->kind());
		@message.text(rt::string_view(" '", 2));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("'", 1));
		@this.report(entity->token(), message.view());
		return false;
	};

	@entity->set_state(entity_state::resolving);
	var Syntax* source = entity->declaration();
	var Scope* scope = entity->resolution_scope();
	entity_kind kind = entity->kind();

	if (kind == entity_kind::record) {
		@entity->set_type(@this.types->named(type_kind::named, (var Entity*(entity))));

		if (!@this.resolve_bases((var Entity*(entity)))) {
			return false;
		};

		usize index = 0;
		while (index < entity->fields().size()) {
			if (!@this.resolve(entity->fields().data()[index])) {
				return false;
			};

			@index = index + 1;
		};

		if (!@this.build_dispatch((var Entity*(entity)))) {
			return false;
		};

		if (!@this.supply_special_functions((var Entity*(entity)))) {
			return false;
		};
	}
	else if (kind == entity_kind::enumeration) {
		@entity->set_type(@this.types->named(type_kind::named, (var Entity*(entity))));
		Type* underlying = @this.type(@*scope, @*source->enum_underlying());

		if (!underlying) {
			@underlying = this.types->find_primitive(rt::string_view("i32", 3));
		};

		if (!underlying->kind().is_integer()) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("declaration '", 13));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("': enum underlying type shall be an integer type", 48));
			@message.text(rt::string_view("; received '", 12));
			diagnostic_type(@message, *underlying);
			@message.text(rt::string_view("'", 1));
			@this.report(source->token(), message.view());
			return false;
		};

		@entity->set_underlying(underlying);
	}
	else if (kind == entity_kind::namespace_body) {
		@entity->set_state(entity_state::ready);

		return true;
	}
	else if (kind == entity_kind::alias) {
		@entity->set_type(@this.type(@*scope, @*source->alias_type()));
	}
	else if (kind == entity_kind::enumerator) {
		var Entity* owner = scope->owner();

		if (!@this.resolve((var Entity*(owner)))) {
			return false;
		};

		@entity->set_type(owner->type());
		u64 value = 0;
		rt::buffer<var Entity*>& members = scope->bindings();
		usize index = 0;
		while (index < members.size() && members.data()[index] != entity) {
			var Entity* previous := members.data()[index];

			if (previous->kind() == entity_kind::enumerator) {
				if (!@this.resolve((var Entity*(previous)))) {
					return false;
				};

				@value = previous->integer() + 1;
			};

			@index = index + 1;
		};

		if (source->item(1)->kind() != syntax_kind::absent) {
			var initializer = @this.expression(@*scope, @*source->item(1), rt::optional_ref<const Type>(*owner->underlying()));

			if (!initializer.get()) {
				return false;
			};
			if (!@this.constant_integer(*initializer.get(), @value)) {
				if (this.failed()) {
					return false;
				};
				var message = DiagnosticMessage();
				@message.text(rt::string_view("enumerator '", 12));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("' requires an integer constant of underlying type '", 51));
				diagnostic_type(@message, *owner->underlying());
				@message.text(rt::string_view("'; initializer has type '", 25));
				diagnostic_type(@message, *initializer.get()->type());
				@message.text(rt::string_view("' and is not constant", 21));
				@this.report(source->item(1)->token(), message.view());
				return false;
			};
		};

		@entity->set_integer($value);
	}
	else if (kind == entity_kind::function) {
		var Scope* local = @this.unit->create_scope(scope, (var Entity*(entity)));

		if (!local) {
			@this.error(source, rt::string_view("out of memory storing function scope", 36));
			return false;
		};

		@entity->set_members((var Scope*(local)));
		var Scope* signature = @this.unit->create_scope(scope, (var Entity*(entity)));

		if (!signature) {
			@this.error(source, rt::string_view("out of memory storing function signature scope", 46));

			return false;
		};

		rt::buffer<Type*> signature_parameters;
		parameter_arity arity = parameter_arity::fixed;
		var Syntax* parameters = source->function_parameters();
		usize index = 0;
		while (index < parameters->size()) {
			var Syntax* parameter = parameters->item(index);

			if (parameter->token().kind == token_kind::punct_ellipsis) {
				@arity = parameter_arity::variadic;
				@index = index + 1;
				continue;
			};

			Type* resolved = @this.type(@*signature, @*parameter->parameter_type());

			if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("parameter ", 10));
				@message.number(index + 1);
				@message.text(rt::string_view(" '", 2));
				diagnostic_name(@message, *parameter->parameter_name());
				@message.text(rt::string_view("' of function '", 15));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("' requires an object or reference type", 38));
				if (resolved) {
					@message.text(rt::string_view("; received '", 12));
					diagnostic_type(@message, *resolved);
					@message.text(rt::string_view("'", 1));
				};
				@this.report(parameter->token(), message.view());
				return false;
			};

			var Syntax* name = parameter->parameter_name();
			Token token = parameter->token();

			if (name->kind() != syntax_kind::absent) {
				@token = name->token();

				if (local->local(token.text())) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("duplicate parameter '", 21));
					@message.text(token.text());
					@message.text(rt::string_view("' in function '", 15));
					diagnostic_entity(@message, *entity);
					@message.text(rt::string_view("'", 1));
					@this.report(token, message.view());
					@this.diagnostics->note(local->local(token.text())->token(), rt::string_view("previous parameter is declared here", 35));
					return false;
				};
			};

			var Entity* argument = @this.unit->create_entity(entity_kind::parameter, token, parameter, local);

			if (!argument) {
				return false;
			};

			@argument->set_resolution_scope((var Scope*(signature)));
			@argument->set_type(resolved);
			@argument->set_index(usize(index));
			@argument->set_state(entity_state::ready);

			if (!@entity->add_parameter($argument)) {
				return false;
			};

			if (!@signature_parameters.push_back(resolved)) {
				return false;
			};

			@index = index + 1;
		};

		var Syntax* declarator = source->function_name();

		while (declarator->kind() == syntax_kind::qualified_name) {
			@declarator = declarator->right();
		};

		Type* result = @this.type(@*signature, @*source->function_result());

		if (declarator->kind() == syntax_kind::conversion_name) {
			Type* target = @this.type(@*scope, @*declarator->operator_target());

			if (result && result != target) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': conversion function result does not match its named target", 61));
				@message.text(rt::string_view("; result is '", 13));
				diagnostic_type(@message, *result);
				@message.text(rt::string_view("', target is '", 14));
				if (target) {
					diagnostic_type(@message, *target);
				};
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());
				return false;
			};

			@result := target;
			@entity->set_role(function_role::conversion);
		}
		else if (declarator->kind() == syntax_kind::operator_name) {
			@entity->set_operator_kind(token_kind(declarator->operator_token().kind));

			if (declarator->operator_token().kind == token_kind::op_assign || declarator->operator_token().kind == token_kind::op_copy) {
				@entity->set_role(function_role::assignment);
			};
		};

		if (!result) {
			@result = this.types->find_primitive(rt::string_view("void", 4));
		};

		@entity->set_type(@this.types->function(result, $signature_parameters, parameter_arity(arity)));
		var Entity* owner = entity->scope()->owner();
		bool destructor = declarator->kind() == syntax_kind::unary && declarator->token().kind == token_kind::op_tilde;
		bool constructor = owner && owner->kind() == entity_kind::record && entity->token().same(owner->token());

		if (destructor) {
			@entity->set_role(function_role::destructor);
		}
		else if (constructor) {
			@entity->set_role(function_role::constructor);
		};

		if (destructor || constructor) {
			if (!owner || !entity->parameters().size() || result->kind() != type_kind::void_type || source->function_result()->kind() != syntax_kind::absent) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': constructor or destructor requires an explicit owning-type receiver and no result annotation", 95));
				@message.text(rt::string_view("; declared signature is '", 25));
				diagnostic_type(@message, *entity->type());
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());
				return false;
			};

			if (constructor) {
				if (entity->parameters().size() == 1) {
					@owner->set_default_constructor(entity);
				}
				else if (entity->parameters().size() == 2) {
					Type* source_type = entity->parameters().data()[1]->type();

					if (source_type == owner->type()) {
						@owner->set_move_constructor(entity);
					}
					else if (source_type->kind() == type_kind::reference && source_type->element()->same_shape(*owner->type()) && source_type->element()->qualifier() == type_qualifier::immutable) {
						@owner->set_copy_constructor(entity);
					};
				};
			};

			Type* receiver = entity->parameters().data()[0]->type();

			if (receiver->kind() != type_kind::reference || receiver->element()->kind() != type_kind::named || receiver->element()->entity() != owner || receiver->element()->qualifier() != type_qualifier::mutable || !entity->parameters().data()[0]->token().is(rt::string_view("this", 4)) || destructor && entity->parameters().size() != 1) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': constructor or destructor has an invalid owning-type receiver", 64));
				@message.text(rt::string_view("; expected first parameter '", 28));
				diagnostic_type(@message, *owner->type());
				@message.text(rt::string_view("& this', received '", 19));
				diagnostic_type(@message, *receiver);
				@message.text(rt::string_view(" ", 1));
				@message.text(entity->parameters().data()[0]->name());
				@message.text(rt::string_view("'", 1));
				if (destructor) {
					@message.text(rt::string_view("; destructors require exactly one parameter", 43));
				};
				@this.report(source->token(), message.view());
				return false;
			};
		};

		if (source->function_body()->kind() != syntax_kind::noop) {
			@entity->set_definition(function_definition::user_defined);
		};

		usize attribute = 0;

		while (attribute < source->function_attributes()->size()) {
			Token token = source->function_attributes()->item(attribute)->token();

			if (token.is(rt::string_view("default", 7)) || token.is(rt::string_view("delete", 6))) {
				if (entity->definition() != function_definition::declaration) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("declaration '", 13));
					diagnostic_entity(@message, *entity);
					@message.text(rt::string_view("': function has conflicting definitions", 39));
					@this.report(source->token(), message.view());
					return false;
				};

				if (token.is(rt::string_view("default", 7))) {
					@entity->set_definition(function_definition::defaulted);
				}
				else {
					@entity->set_definition(function_definition::deleted);
				};
			}
			else if (token.is(rt::string_view("implicit", 8))) {
				if (!constructor && entity->role() != function_role::conversion) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("declaration '", 13));
					diagnostic_entity(@message, *entity);
					@message.text(rt::string_view("': implicit requires a constructor or conversion function", 57));
					@this.report(source->token(), message.view());
					return false;
				};

				@entity->set_conversion(conversion_mode::implicit_allowed);
			}
			else if (token.is(rt::string_view("virtual", 7))) {
				@entity->set_dispatch(function_dispatch::virtual_function);
			}
			else if (token.is(rt::string_view("override", 8))) {
				@entity->set_dispatch(function_dispatch::override_function);
			}
			else if (token.is(rt::string_view("final", 5))) {
				@entity->set_dispatch(function_dispatch::final_function);
			}
			else {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': unknown function attribute", 29));
				@message.text(rt::string_view(" '", 2));
				@message.text(token.text());
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());
				return false;
			};

			@attribute = attribute + 1;
		};

		if (entity->role() == function_role::conversion) {
			if (entity->parameters().size() != 1 || arity != parameter_arity::fixed || result->kind() == type_kind::reference) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("conversion '", 12));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("' requires one reference parameter and a result matching its target; declared signature is '", 92));
				diagnostic_type(@message, *entity->type());
				@message.text(rt::string_view("'", 1));
				@this.report(entity->token(), message.view());
				return false;
			};

			var Entity* receiver = entity->parameters().data()[0];
			if (receiver->type()->kind() != type_kind::reference) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("conversion '", 12));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("' requires one reference parameter and a result matching its target; declared signature is '", 92));
				diagnostic_type(@message, *entity->type());
				@message.text(rt::string_view("'", 1));
				@this.report(entity->token(), message.view());
				return false;
			};

			if (entity->conversion() == conversion_mode::implicit_allowed && receiver->type()->element()->same_shape(*result) && receiver->type()->element()->qualifier() != type_qualifier::immutable) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': self conversion requires a const reference receiver", 54));
				@message.text(rt::string_view("; received '", 12));
				diagnostic_type(@message, *receiver->type());
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());
				return false;
			};
		};

		if (entity->dispatch() != function_dispatch::ordinary) {
			if (!owner || owner->kind() != entity_kind::record || entity->role() != function_role::ordinary || !entity->parameters().size() || !entity->parameters().data()[0]->token().is(rt::string_view("this", 4)) || entity->parameters().data()[0]->type()->kind() != type_kind::reference || !entity->parameters().data()[0]->type()->element()->same_shape(*owner->type())) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': virtual operation requires an explicit ordinary class receiver named this", 76));
				@message.text(rt::string_view("; declared signature is '", 25));
				diagnostic_type(@message, *entity->type());
				@message.text(rt::string_view("'", 1));
				if (entity->parameters().size()) {
					Entity& receiver = *entity->parameters().data()[0];
					@message.text(rt::string_view("; first parameter is '", 22));
					diagnostic_type(@message, *receiver.type());
					@message.text(rt::string_view(" ", 1));
					@message.text(receiver.name());
					@message.text(rt::string_view("'", 1));
				}
				else {
					@message.text(rt::string_view("; no receiver parameter was declared", 36));
				};
				if (!owner || owner->kind() != entity_kind::record) {
					@message.text(rt::string_view("; enclosing scope is ", 21));
					if (owner) {
						diagnostic_entity_kind(@message, owner->kind());
						@message.text(rt::string_view(" '", 2));
						diagnostic_entity(@message, *owner);
						@message.text(rt::string_view("'", 1));
					}
					else {
						@message.text(rt::string_view("module scope", 12));
					};
				};
				@this.report(source->token(), message.view());
				return false;
			};

			if (arity == parameter_arity::variadic) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': variadic virtual operations are not implemented", 50));
				@message.text(rt::string_view("; declared signature is '", 25));
				diagnostic_type(@message, *entity->type());
				@message.text(rt::string_view("'", 1));
				@this.report(source->token(), message.view());
				return false;
			};
		};

		if (entity->definition() == function_definition::defaulted && entity->role() != function_role::constructor && entity->role() != function_role::destructor && entity->role() != function_role::assignment) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("declaration '", 13));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("': this function has no compiler-generated implementation", 57));
			@this.report(source->token(), message.view());
			return false;
		};

		rt::buffer<var Entity*>& names = entity->scope()->bindings();
		@index = 0;

		while (index < names.size() && names.data()[index] != entity) {
			var Entity* previous = names.data()[index]->canonical();

			if (previous->kind() == entity_kind::function && previous->name() == entity->name() && previous->type() == entity->type()) {
				@previous->merge_dispatch(*entity);
				bool defined = source->function_body()->kind() != syntax_kind::noop;

				if (defined && previous->declaration()->function_body()->kind() != syntax_kind::noop) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("duplicate function definition for '", 35));
					diagnostic_entity(@message, *entity);
					@message.text(rt::string_view("' of type '", 11));
					diagnostic_type(@message, *entity->type());
					@message.text(rt::string_view("'", 1));
					@this.report(entity->token(), message.view());
					@this.diagnostics->note(previous->token(), rt::string_view("previous definition is here", 27));
					return false;
				};

				if (defined && !@previous->adopt_definition(*entity)) {
					return false;
				};

				@entity->merge_into($previous);
				break;
			};

			@index = index + 1;
		};
	}
	else if (kind == entity_kind::global || kind == entity_kind::field) {
		Type* resolved = @this.type(@*scope, @*source->variable_type());

		if (!resolved) {
			var Syntax* initial = source->variable_initializer();

			if (initial->kind() == syntax_kind::unary) {
				@initial = initial->operand();
			};

			var value = @this.expression(@*scope, @*initial, rt::optional_ref<const Type>());

			if (!value.get()) {
				return false;
			};

			@resolved = @this.infer_variable(@*source, *value.get());
			if (!resolved) {
				return false;
			};

			if (value.get()->type_use().has_value()) {
				@entity->set_type_use(value.get()->type_use().value());
			};
		};

		if (!resolved || resolved->kind() == type_kind::void_type || resolved->kind() == type_kind::null_type || resolved->kind() == type_kind::function) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("declaration '", 13));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("': variable requires object storage or a reference", 50));
			@this.report(source->token(), message.view());
			return false;
		};

		@entity->set_type(resolved);
		Type* element = resolved;

		while (element->kind() == type_kind::array) {
			@element = element->element();
		};

		if (element->kind() == type_kind::named && element->entity()->kind() == entity_kind::record) {
			if (element->entity()->state() == entity_state::resolving || element->entity()->declaration()->record_members()->kind() == syntax_kind::noop) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("declaration '", 13));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("': object requires a complete nonrecursive storage type", 55));
				@this.report(source->token(), message.view());
				return false;
			};
		};
	};

	if (!entity->type()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("declaration '", 13));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("': type could not be resolved", 29));
		@this.report(source->token(), message.view());
		return false;
	};

	@entity->set_state(entity_state::ready);

	return true;
};

fn Analyzer::function_body(var Analyzer& this, var Entity* entity) -> bool {
	if (!@this.resolve(entity)) {
		return false;
	};

	@entity = entity->canonical();

	if (entity->body() || entity->body_state() == entity_state::ready) {
		return true;
	};

	if (entity->definition() == function_definition::deleted) {
		@this.deleted_function(entity->token(), *entity);
		return false;
	};

	if (entity->definition() != function_definition::defaulted && (!entity->declaration() || entity->declaration()->function_body()->kind() == syntax_kind::noop)) {
		@entity->set_body_state(entity_state::ready);

		return true;
	};

	if (entity->body_state() == entity_state::resolving) {
		return true;
	};

	@entity->set_body_state(entity_state::resolving);
	var context = FunctionAnalysisScope(@this.function, @this.loop_depth, @this.active_switch, rt::optional_ref<Entity>(@*entity));

	if (entity->role() == function_role::constructor && entity->scope()->owner()->layout() != record_layout::overlapping && (entity->definition() == function_definition::user_defined || entity->parameters().size() == 1)) {
		var Entity* owner = entity->scope()->owner();
		usize index = 0;
		while (index < owner->bases().size()) {
			if (!@this.prepare_default(owner->bases().data()[index])) {
				return false;
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < owner->fields().size()) {
			var Entity* field = owner->fields().data()[index];

			if (!@this.field_initializer((var Entity*(field)))) {
				return false;
			};

			if (!field->body() && !@this.prepare_default(field->type())) {
				return false;
			};

			if (field->body() && !@this.prepare_expression(field->body())) {
				return false;
			};

			@index = index + 1;
		};
	};

	if (entity->definition() == function_definition::defaulted) {
		Type* receiver = entity->parameters().data()[0]->type()->element();

		if (!@this.prepare_lifetime(receiver)) {
			return false;
		};

		var Entity* owner = receiver->entity();

		if (entity->role() == function_role::constructor && entity->parameters().size() == 2 && entity->parameters().data()[1]->type()->kind() == type_kind::reference && owner->layout() != record_layout::overlapping) {
			usize index = 0;
			while (index < owner->bases().size()) {
				if (!@this.prepare_copy(owner->bases().data()[index])) {
					return false;
				};

				@index = index + 1;
			};

			@index = 0;

			while (index < owner->fields().size()) {
				if (!@this.prepare_copy(owner->fields().data()[index]->type())) {
					return false;
				};

				@index = index + 1;
			};
		};

		if (entity->role() == function_role::assignment) {
			if (entity->parameters().data()[1]->type()->kind() == type_kind::reference) {
				usize index = 0;

				while (index < owner->bases().size()) {
					if (!@this.prepare_copy_assignment(owner->bases().data()[index])) {
						return false;
					};

					@index = index + 1;
				};

				@index = 0;

				while (owner->layout() != record_layout::overlapping && index < owner->fields().size()) {
					if (!@this.prepare_copy_assignment(owner->fields().data()[index]->type())) {
						return false;
					};

					@index = index + 1;
				};
			}
			else if (owner->move_constructor() && !@this.function_body(owner->move_constructor())) {
				return false;
			};
		};

		@entity->set_body_state(entity_state::ready);

		return true;
	};

	var body = @this.expression(@*entity->members(), @*entity->declaration()->function_body(), rt::optional_ref<const Type>());

	if (!body.get()) {
		return false;
	};

	@entity->set_body($body);
	@entity->set_body_state(entity_state::ready);

	return @this.prepare_expression(entity->body());
};

fn Analyzer::analyze(var Analyzer& this, rt::buffer<rt::unique<Syntax>>& syntax) -> rt::unique<SemanticUnit> {
	var owned = rt::unique<SemanticUnit>::make();
	if (!owned.get() || !@this.analyze_into(@*owned.get(), syntax)) {
		return rt::unique<SemanticUnit>();
	};
	return $owned;
};

fn Analyzer::analyze_into(var Analyzer& this, var SemanticUnit& unit, rt::buffer<rt::unique<Syntax>>& syntax) -> bool {
	@this.templates.clear();
	@this.unit = &@unit;
	var Scope* root = @this.unit->create_scope(nullptr, nullptr);

	if (!root) {
		return false;
	};

	usize index = 0;
	while (index < syntax.size() && !this.diagnostics->failed()) {
		if (!@this.unit->record_scope(@*root, @*syntax.data()[index].get()) || !@this.collect(@*root, @*(syntax.data()[index].get()))) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;
	var validator = TemplateDeclarationValidator();

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		var Entity* pattern = this.unit->entities().data()[index].get();
		if (pattern->kind() == entity_kind::template_pattern && !@validator.validate(@this, @*pattern)) {
			return false;
		};
		@index = index + 1;
	};

	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		if (!@this.resolve(this.unit->entities().data()[index].get())) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < this.unit->entities().size() && !this.diagnostics->failed()) {
		var Entity* entity = this.unit->entities().data()[index].get();

		if (!@this.resolve((var Entity*(entity)))) {
			return false;
		};

		if (entity->kind() == entity_kind::function && !entity->instantiated() && entity->origin() != declaration_origin::compiler_supplied && entity->definition() != function_definition::deleted && !@this.function_body((var Entity*(entity)))) {
			return false;
		};

		if (entity->kind() == entity_kind::field && !entity->instantiated() && !@this.field_initializer((var Entity*(entity)))) {
			return false;
		};

		if (entity->kind() == entity_kind::global && !@this.global_initializer(@*entity)) {
			return false;
		};

		@index = index + 1;
	};

	@this.unit = nullptr;

	if (this.diagnostics->failed()) {
		return false;
	};

	return true;
};

fn Analyzer::names_type(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> bool {
	switch (syntax.kind()) {
		case syntax_kind::type_pointer:
		case syntax_kind::type_reference:
		case syntax_kind::type_array:
		case syntax_kind::type_const:
		case syntax_kind::type_mutable:
			return @this.names_type(@scope, @*syntax.designated_type());
		case syntax_kind::type_function:
			return true;
		case syntax_kind::type_name: {
			var Syntax* name = syntax.designated_type();
			var Entity* entity = @this.lookup(@scope, @*name);

			if (entity) {
				return entity->denotes_type();
			};

			return this.types->find_primitive(name->token().text()) != nullptr;
		};
	};

	return false;
};

fn Analyzer::size_query(var Analyzer& this, var Syntax& syntax, Type& type) -> rt::unique<SemanticExpression> {
	if (!type.has_layout()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("sizeof requires a complete object storage type; received '", 58));
		diagnostic_type(@message, type);
		@message.text(rt::string_view("'", 1));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var operand = @this.node(semantic_kind::noop, &@type, &@syntax);
	var result = @this.node(semantic_kind::sizeof_type, this.types->find_primitive(rt::string_view("usize", 5)), &@syntax);

	if (!operand.get() || !result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($operand)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::resolve_bases(var Analyzer& this, var Entity* entity) -> bool {
	var Syntax* declaration = entity->declaration();
	var Syntax* bases = declaration->record_bases();

	if (!bases->size()) {
		return true;
	};

	if (entity->layout() == record_layout::overlapping) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("union '", 7));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' cannot contain a base subobject", 33));
		@this.report(entity->token(), message.view());
		return false;
	};

	if (bases->size() != 1) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("record '", 8));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' declares ", 11));
		@message.number(u64(bases->size()));
		@message.text(rt::string_view(" base types; multiple base analysis is not implemented", 54));
		@this.report(entity->token(), message.view());
		return false;
	};

	Type* base = @this.type(@*entity->resolution_scope(), @*bases->item(0));

	if (!base) {
		return false;
	};
	if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record || base->qualifier() != type_qualifier::mutable || base->entity()->layout() != record_layout::sequential) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("invalid base type '", 19));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("' for record '", 14));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("': ", 3));
		if (base->kind() != type_kind::named || base->entity()->kind() != entity_kind::record) {
			@message.text(rt::string_view("base requires a record type", 27));
		}
		else if (base->qualifier() != type_qualifier::mutable) {
			@message.text(rt::string_view("base type shall be unqualified", 30));
		}
		else {
			@message.text(rt::string_view("base type shall not be a union", 30));
		};
		@this.report(bases->item(0)->token(), message.view());
		return false;
	};

	var Entity* owner = base->entity();

	if (owner->state() == entity_state::resolving) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("base relation contains a cycle; record '", 40));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' names base '", 14));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("'", 1));
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), rt::string_view("base record is declared here", 28));
		return false;
	};

	if (!@this.resolve(owner)) {
		return false;
	};

	if (owner->declaration()->record_members()->kind() == syntax_kind::noop) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("base requires a complete record definition; record '", 52));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' names base '", 14));
		diagnostic_type(@message, *base);
		@message.text(rt::string_view("'", 1));
		@this.report(bases->item(0)->token(), message.view());
		@this.note(owner->token(), rt::string_view("base record is declared here", 28));
		return false;
	};

	if (!@entity->add_base(base)) {
		@this.error(declaration, rt::string_view("base subobject metadata storage is unavailable", 46));
		return false;
	};

	return true;
};

fn Analyzer::validate_dispatch_syntax(var Analyzer& this, var Syntax& syntax, bool class_scope) -> bool {
	if (syntax.kind() == syntax_kind::template_declaration) {
		var Syntax* declaration = syntax.template_declaration();

		if (declaration->kind() == syntax_kind::function) {
			usize index = 0;
			while (index < declaration->function_attributes()->size()) {
				Token token = declaration->function_attributes()->item(index)->token();

				if (token.is(rt::string_view("virtual", 7)) || token.is(rt::string_view("override", 8)) || token.is(rt::string_view("final", 5))) {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("attribute ", 10));
					@message.quoted(token.text());
					@message.text(rt::string_view(" on function template '", 23));
					diagnostic_name(@message, *declaration->function_name());
					@message.text(rt::string_view("' requires virtual function templates, which are not implemented", 64));
					@this.report(token, message.view());
					return false;
				};

				@index = index + 1;
			};
		};

		return @this.validate_dispatch_syntax(@*declaration, $class_scope);
	};

	if (syntax.kind() == syntax_kind::record) {
		return @this.validate_dispatch_syntax(@*syntax.record_members(), true);
	};

	if (syntax.kind() == syntax_kind::namespace_body) {
		return @this.validate_dispatch_syntax(@*syntax.namespace_members(), false);
	};

	if (syntax.kind() == syntax_kind::list || syntax.kind() == syntax_kind::brace || syntax.kind() == syntax_kind::unit) {
		usize index = 0;
		while (index < syntax.size()) {
			if (!@this.validate_dispatch_syntax(@*syntax.item(index), bool(class_scope))) {
				return false;
			};

			@index = index + 1;
		};

		return true;
	};

	if (syntax.kind() != syntax_kind::function) {
		return true;
	};

	bool virtual_operation = false;
	usize index = 0;
	while (index < syntax.function_attributes()->size()) {
		Token token = syntax.function_attributes()->item(index)->token();

		if (token.is(rt::string_view("virtual", 7)) || token.is(rt::string_view("override", 8)) || token.is(rt::string_view("final", 5))) {
			@virtual_operation = true;
		};

		@index = index + 1;
	};

	if (!virtual_operation) {
		return true;
	};

	var Syntax* parameters = syntax.function_parameters();

	if ((!class_scope && syntax.function_name()->kind() != syntax_kind::qualified_name) || !parameters->size() || !parameters->item(0)->parameter_name()->token().is(rt::string_view("this", 4)) || parameters->item(0)->parameter_type()->kind() != syntax_kind::type_reference) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("virtual operation '", 19));
		diagnostic_name(@message, *syntax.function_name());
		@message.text(rt::string_view("' requires an explicit class receiver of reference type named 'this'", 68));
		if (!class_scope && syntax.function_name()->kind() != syntax_kind::qualified_name) {
			@message.text(rt::string_view("; the function is not declared in class scope", 45));
		}
		else if (!parameters->size()) {
			@message.text(rt::string_view("; the function has no receiver parameter", 40));
		}
		else {
			@message.text(rt::string_view("; first parameter is named ", 27));
			@message.quoted(parameters->item(0)->parameter_name()->token().text());
			if (parameters->item(0)->parameter_type()->kind() != syntax_kind::type_reference) {
				@message.text(rt::string_view(" and does not have reference type", 33));
			};
		};
		@this.report(syntax.token(), message.view());
		return false;
	};

	if (this.templates.qualifier_dependent(@syntax)) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("virtual operation '", 19));
		diagnostic_name(@message, *syntax.function_name());
		@message.text(rt::string_view("' cannot have dependent receiver qualification", 46));
		@this.report(syntax.token(), message.view());
		return false;
	};

	return true;
};

fn dispatch_signature(Entity& function, Entity& inherited) -> bool {
	if (function.operator_kind() != token_kind::identifier || inherited.operator_kind() != token_kind::identifier) {
		if (function.operator_kind() != inherited.operator_kind()) {
			return false;
		};
	}
	else if (function.name() != inherited.name()) {
		return false;
	};

	rt::buffer<var Entity*>& first = function.parameters();
	rt::buffer<var Entity*>& second = inherited.parameters();

	if (!first.size() || first.size() != second.size() || first.data()[0]->type()->kind() != type_kind::reference || second.data()[0]->type()->kind() != type_kind::reference || first.data()[0]->type()->element()->qualifier() != second.data()[0]->type()->element()->qualifier()) {
		return false;
	};

	usize index = 1;
	while (index < first.size()) {
		if (first.data()[index]->type() != second.data()[index]->type()) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn dispatch_result(Type& result, Type& inherited) -> bool {
	if (result.same_shape(inherited)) {
		return true;
	};

	if (result.kind() != inherited.kind() || result.kind() != type_kind::pointer && result.kind() != type_kind::reference) {
		return false;
	};

	Type* source = result.element();
	Type* destination = inherited.element();

	return source->derived_from(*destination) && (source->qualifier() != type_qualifier::immutable || destination->qualifier() == type_qualifier::immutable);
};

fn Analyzer::build_dispatch(var Analyzer& this, var Entity* entity) -> bool {
	usize inherited = 0;

	if (entity->bases().size()) {
		rt::buffer<var Entity*>& base = entity->bases().data()[0]->entity()->virtual_functions();

		while (inherited < base.size()) {
			if (!@entity->add_virtual(base.data()[inherited])) {
				@this.error(entity->declaration(), rt::string_view("inherited virtual operation storage is unavailable", 50));
				return false;
			};

			@inherited = inherited + 1;
		};
	};

	rt::buffer<var Entity*> seen;
	usize index = 0;
	while (index < entity->members()->bindings().size()) {
		var Entity* function = entity->members()->bindings().data()[index];
		@index = index + 1;

		if (function->kind() != entity_kind::function) {
			continue;
		};

		if (!@this.resolve((var Entity*(function)))) {
			return false;
		};

		@function = function->canonical();
		usize prior = 0;

		while (prior < seen.size() && seen.data()[prior] != function) {
			@prior = prior + 1;
		};

		if (prior < seen.size()) {
			continue;
		};

		if (!@seen.push_back((var Entity*(function)))) {
			@this.error(function->declaration(), rt::string_view("virtual operation analysis storage is unavailable", 49));
			return false;
		};

		usize slot = 0;

		while (slot < inherited && !dispatch_signature(*function, *entity->virtual_functions().data()[slot])) {
			@slot = slot + 1;
		};

		if (slot < inherited) {
			var Entity* previous = entity->virtual_functions().data()[slot];

			if (previous->is_final()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("final virtual operation cannot be overridden; function '", 56));
				diagnostic_entity(@message, *function);
				@message.text(rt::string_view("' has type '", 12));
				diagnostic_type(@message, *function->type());
				@message.text(rt::string_view("'", 1));
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return false;
			};

			if (!function->requires_override() && !function->is_final()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("override of an inherited virtual operation requires override or final; function '", 81));
				diagnostic_entity(@message, *function);
				@message.text(rt::string_view("' has type '", 12));
				diagnostic_type(@message, *function->type());
				@message.text(rt::string_view("'", 1));
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return false;
			};

			if (!dispatch_result(*function->type()->signature().result(), *previous->type()->signature().result())) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("virtual override has an incompatible result type; function '", 60));
				diagnostic_entity(@message, *function);
				@message.text(rt::string_view("' has type '", 12));
				diagnostic_type(@message, *function->type());
				@message.text(rt::string_view("'", 1));
				@message.text(rt::string_view(" with result '", 14));
				diagnostic_type(@message, *function->type()->signature().result());
				@message.text(rt::string_view("'; inherited result is '", 24));
				diagnostic_type(@message, *previous->type()->signature().result());
				@message.text(rt::string_view("'", 1));
				@this.report(function->token(), message.view());
				diagnostic_candidate(@*this.diagnostics, *previous);
				return false;
			};

			@entity->replace_virtual(usize(slot), @*function);
			@function->set_virtual_slot(slot);
		}
		else if (function->requires_override() || function->is_final() && !function->declares_virtual()) {
			var message = DiagnosticMessage();
			if (function->requires_override()) {
				@message.text(rt::string_view("override", 8));
			}
			else {
				@message.text(rt::string_view("final without virtual", 21));
			};
			@message.text(rt::string_view(" on function '", 14));
			diagnostic_entity(@message, *function);
			@message.text(rt::string_view("' of type '", 11));
			diagnostic_type(@message, *function->type());
			@message.text(rt::string_view("' requires a matching inherited virtual operation", 49));
			@this.report(function->token(), message.view());
			usize inherited_index = 0;
			while (inherited_index < inherited) {
				diagnostic_candidate(@*this.diagnostics, *entity->virtual_functions().data()[inherited_index]);
				@inherited_index = inherited_index + 1;
			};
			return false;
		}
		else if (function->declares_virtual()) {
			@function->set_virtual_slot(entity->virtual_functions().size());

			if (!@entity->add_virtual((var Entity*(function)))) {
				@this.error(function->declaration(), rt::string_view("virtual operation storage is unavailable", 40));
				return false;
			};
		};
	};

	if (entity->layout() == record_layout::overlapping && entity->virtual_functions().size()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("union '", 7));
		diagnostic_entity(@message, *entity);
		@message.text(rt::string_view("' cannot contain virtual operations", 35));
		@this.report(entity->token(), message.view());
		return false;
	};

	return true;
};

fn Analyzer::expression_impl(var Analyzer& this, var Scope& scope, var Syntax& syntax, rt::optional_ref<const Type>& expected) -> rt::unique<SemanticExpression> {
	if (this.diagnostics->failed()) {
		return rt::unique<SemanticExpression>();
	};

	Type* void_type = this.types->find_primitive(rt::string_view("void", 4));
	Type* bool_type = this.types->find_primitive(rt::string_view("bool", 4));
	syntax_kind kind = syntax.kind();

	if (this.editor && kind == syntax_kind::error_expression) {
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};
	if (this.editor && kind == syntax_kind::qualified_name && syntax.right()->kind() == syntax_kind::absent) {
		@this.lookup(@scope, @syntax);
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (this.editor && this.recovery_operand(syntax)) {
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* child = syntax.item(index);
			@index = index + 1;
			if (kind == syntax_kind::cast && child == syntax.cast_type()) {
				if (!@this.type(@scope, @*child)) {
					return rt::unique<SemanticExpression>();
				};
				continue;
			};
			var known = @this.expression(@scope, @*child, rt::optional_ref<const Type>());
			if (!known.get()) {
				return rt::unique<SemanticExpression>();
			};
		};
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::grouping) {
		return @this.expression(@scope, @*syntax.operand(), expected);
	};

	if (kind == syntax_kind::switch_expression) {
		return @this.selection(@scope, @syntax);
	};

	if (kind == syntax_kind::case_label) {
		return @this.label(@scope, @syntax);
	};

	if (kind == syntax_kind::sizeof_type) {
		Type* target = @this.type(@scope, @*syntax.designated_type());

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		return @this.convert(@this.size_query(@syntax, *target), expected, @syntax);
	};

	if (kind == syntax_kind::noop || kind == syntax_kind::absent) {
		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::ambiguity) {
		usize index = 0;
		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);
			var Syntax* type = nullptr;

			if (candidate->kind() == syntax_kind::variable) {
				@type = candidate->variable_type();
			}
			else if (candidate->kind() == syntax_kind::sizeof_type) {
				@type = candidate->designated_type();
			};

			if (candidate->kind() == syntax_kind::call) {
				@type = candidate->callable();
			};

			if (type && @this.names_type(@scope, @*type)) {
				return @this.expression(@scope, @*candidate, expected);
			};

			@index = index + 1;
		};

		@index = 0;

		while (index < syntax.size()) {
			var Syntax* candidate = syntax.item(index);

			if (candidate->kind() == syntax_kind::call) {
				syntax_kind callee = candidate->callable()->kind();

				if (callee == syntax_kind::type_name || callee == syntax_kind::type_pointer || callee == syntax_kind::type_reference || callee == syntax_kind::type_array || (callee == syntax_kind::type_const || callee == syntax_kind::type_mutable) || callee == syntax_kind::type_function || callee == syntax_kind::type_auto) {
					@index = index + 1;
					continue;
				};
			};

			if (syntax.item(index)->kind() != syntax_kind::variable && syntax.item(index)->kind() != syntax_kind::sizeof_type) {
				return @this.expression(@scope, @*syntax.item(index), expected);
			};

			@index = index + 1;
		};

		var message = DiagnosticMessage();
		@message.text(rt::string_view("syntax beginning with ", 22));
		@message.quoted(syntax.token().text());
		@message.text(rt::string_view(" has no interpretation in this scope", 36));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	bool character_literal = kind == syntax_kind::number && syntax.token().text().size() && syntax.token().text().data()[0] == '\'';

	if (kind == syntax_kind::number && !character_literal) {
		u64 integer = 0;

		if (@this.integer(@syntax, @integer)) {
			Type* type = expected.get();

			if (!type || !type->kind().is_integer() || type->kind() == type_kind::boolean) {
				@type = this.types->find_primitive(rt::string_view("i32", 3));

				if (integer > static_cast<u64>(i32::max)) {
					@type = this.types->find_primitive(rt::string_view("i64", 3));
				};

				if (integer > static_cast<u64>(i64::max)) {
					@type = this.types->find_primitive(rt::string_view("u64", 3));
				};
			};

			var result = @this.node(semantic_kind::literal_integer, type, &@syntax);

			if (result.get()) {
				@result.get()->set_integer(u64(integer));
			};

			return @this.convert($result, expected, @syntax);
		};

		var spelling = rt::string(syntax.token().text());
		var char* end = nullptr;
		f64 real = strtod(spelling.c_str(), &@end);

		if (!end || end[0]) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("numeric literal ", 16));
			@message.quoted(syntax.token().text());
			@message.text(rt::string_view(" is not representable as an integer or floating-point value", 59));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		Type* type = this.types->find_primitive(rt::string_view("f64", 3));

		if (expected.has_value() && expected.value().kind() == type_kind::floating_point) {
			@type = expected.get();
		};

		var result = @this.node(semantic_kind::literal_real, type, &@syntax);

		if (result.get()) {
			@result.get()->set_real(f64(real));
		};

		return $result;
	};

	if (kind == syntax_kind::string || character_literal) {
		var text = syntax.token().text();
		rt::string decoded;
		usize index = 1;
		while (index + 1 < text.size()) {
			char character := text.data()[index];
			@index = index + 1;

			if (character == '\\' && index + 1 < text.size()) {
				@character := text.data()[index];
				@index = index + 1;

				if (character == 'n') {
					@character = '\n';
				}
				else if (character == 'r') {
					@character = '\r';
				}
				else if (character == 't') {
					@character = '\t';
				}
				else if (character == '0') {
					@character = '\0';
				}
				else if (character != '\\' && character != '\'' && character != '"') {
					var message = DiagnosticMessage();
					@message.text(rt::string_view("unsupported escape ", 19));
					@message.quoted(rt::string_view(text.data() + index - 2, 2));
					@message.text(rt::string_view(" in literal ", 12));
					@message.quoted(text);
					@this.report(syntax.token(), message.view());

					return rt::unique<SemanticExpression>();
				};
			};

			if (!@decoded.append(rt::string_view(&@character, 1))) {
				return rt::unique<SemanticExpression>();
			};
		};

		Type* character_type = this.types->find_primitive(rt::string_view("char", 4));

		if (text.data()[0] == '\'') {
			if (decoded.size() != 1) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("character literal ", 18));
				@message.quoted(text);
				@message.text(rt::string_view(" shall contain one character; decoded length is ", 48));
				@message.number(u64(decoded.size()));
				@this.report(syntax.token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			var result = @this.node(semantic_kind::literal_integer, character_type, &@syntax);

			if (result.get()) {
				char character := decoded.data()[0];
				@result.get()->set_integer(static_cast<u64>($character));
			};

			return @this.convert($result, expected, @syntax);
		};

		Type* element = @this.types->qualified(*character_type, type_qualifier::immutable);
		var result = @this.node(semantic_kind::literal_text, @this.types->pointer(element), &@syntax);

		if (result.get()) {
			@result.get()->set_text(decoded.view());
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::null_pointer) {
		Type* element = @this.types->qualified(*this.types->find_primitive(rt::string_view("null", 4)), type_qualifier::immutable);

		if (!element) {
			return rt::unique<SemanticExpression>();
		};

		Type* type = @this.types->pointer(element);

		return @this.convert(@this.node(semantic_kind::null_pointer, type, &@syntax), expected, @syntax);
	};

	if (kind == syntax_kind::name || kind == syntax_kind::qualified_name || kind == syntax_kind::template_apply) {
		Token token = syntax.token();

		if (token.is(rt::string_view("true", 4)) || token.is(rt::string_view("false", 5))) {
			var result = @this.node(semantic_kind::literal_integer, bool_type, &@syntax);

			if (result.get() && token.is(rt::string_view("true", 4))) {
				@result.get()->set_integer(1);
			};

			return @this.convert($result, expected, @syntax);
		};

		var Entity* entity = @this.lookup(@scope, @syntax);

		if (!entity) {
			if (!this.diagnostics->failed()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("unknown identifier '", 20));
				diagnostic_name(@message, syntax);
				@message.text(rt::string_view("'", 1));
				@this.diagnostics->error(syntax.token(), message.view());
			};
			return rt::unique<SemanticExpression>();
		};
		if (!@this.resolve((var Entity*(entity)))) {
			return rt::unique<SemanticExpression>();
		};

		@entity = entity->canonical();

		if (entity->kind() != entity_kind::function && !@this.unit->record_name(@this, @scope, @syntax, @*entity, 4)) {
			@this.error(&@syntax, rt::string_view("navigation index storage is unavailable", 39));
			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::constant) {
			return @this.convert(entity->body()->copy_constant(), expected, @syntax);
		};

		if (entity->kind() == entity_kind::enumerator) {
			var result = @this.node(semantic_kind::literal_integer, entity->type(), &@syntax);

			if (result.get()) {
				@result.get()->set_integer(entity->integer());
			};

			return @this.convert($result, expected, @syntax);
		};

		if (entity->kind() != entity_kind::function && entity->kind() != entity_kind::global && entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter && entity->kind() != entity_kind::field) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("identifier '", 12));
			diagnostic_entity(@message, *entity);
			@message.text(rt::string_view("' does not denote a value", 25));
			@this.report(syntax.token(), message.view());
			@this.note(entity->token(), rt::string_view("referenced declaration is here", 30));

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::function && entity->definition() == function_definition::deleted) {
			@this.deleted_function(syntax.token(), *entity);

			return rt::unique<SemanticExpression>();
		};

		if (entity->kind() == entity_kind::field) {
			var Entity* receiver = scope.lookup(rt::string_view("this", 4));

			if (!receiver || receiver->type()->kind() != type_kind::reference || receiver->type()->element()->kind() != type_kind::named || receiver->type()->element()->entity() != entity->scope()->owner()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("field access to '", 17));
				diagnostic_entity(@message, *entity);
				@message.text(rt::string_view("' requires an instance receiver of '", 36));
				diagnostic_entity(@message, *entity->scope()->owner());
				@message.text(rt::string_view("'", 1));
				@this.report(syntax.token(), message.view());
				@this.note(entity->token(), rt::string_view("field is declared here", 22));

				return rt::unique<SemanticExpression>();
			};

			Type* owner = receiver->type()->element();
			Type* field_type = entity->type();

			if (field_type->kind() == type_kind::reference) {
				@field_type = field_type->element();
			}
			else if (owner->qualifier() == type_qualifier::immutable) {
				@field_type = @this.types->qualified(*field_type, type_qualifier::immutable);
			};

			var object = @this.node(semantic_kind::name, owner, &@syntax);

			if (!object.get()) {
				return rt::unique<SemanticExpression>();
			};

			@object.get()->bind(receiver, value_category::place);
			var member = @this.node(semantic_kind::member, field_type, &@syntax);

			if (!member.get()) {
				return rt::unique<SemanticExpression>();
			};

			@member.get()->bind(entity, value_category::place);

			if (!@member.get()->append($object)) {
				return rt::unique<SemanticExpression>();
			};

			return @this.convert($member, expected, @syntax);
		};

		Type* type = entity->type();

		if (type->kind() == type_kind::reference) {
			@type = type->element();
		};

		var result = @this.node(semantic_kind::name, type, &@syntax);

		if (result.get()) {
			@result.get()->bind(entity, value_category::place);
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::brace || kind == syntax_kind::list) {
		if (kind == syntax_kind::brace && !syntax.size() && expected.has_value() && expected.value().kind() == type_kind::array) {
			Type* element = expected.get();

			while (element->kind() == type_kind::array) {
				@element = element->element();
			};

			if (!element->representation()->kind().is_scalar()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("empty initialization of object arrays is not specified; array type is '", 71));
				diagnostic_type(@message, expected.value());
				@message.text(rt::string_view("'", 1));
				@this.report(syntax.token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			return @this.construct(@scope, @syntax, expected.get(), @syntax);
		};

		var Scope* local = &@scope;

		if (kind == syntax_kind::brace) {
			@local = @this.unit->create_scope(&@scope, this.function);
			if (local && !@this.unit->record_scope(@*local, @syntax)) {
				return rt::unique<SemanticExpression>();
			};
		};

		var result = @this.node(semantic_kind::brace, void_type, &@syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			var child = @this.expression(@*local, @*syntax.item(index), rt::optional_ref<const Type>());

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($child)) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::using_alias) {
		if (!@this.collect(@scope, @syntax)) {
			return rt::unique<SemanticExpression>();
		};

		var Entity* alias = scope.local(syntax.alias_name()->token().text());

		if (!alias || !@this.resolve(alias)) {
			return rt::unique<SemanticExpression>();
		};

		return @this.node(semantic_kind::noop, void_type, &@syntax);
	};

	if (kind == syntax_kind::variable) {
		Token name = syntax.variable_name()->token();

		var Entity* previous = scope.local(name.text());
		if (previous) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("duplicate local declaration of ", 31));
			@message.quoted(name.text());
			@this.diagnostics->error(name, message.view());
			@this.diagnostics->note(previous->token(), rt::string_view("previous declaration is here", 28));

			return rt::unique<SemanticExpression>();
		};

		Type* type = @this.type(@scope, @*syntax.variable_type());
		var Syntax* initializer = syntax.variable_initializer();

		if (initializer->kind() == syntax_kind::unary) {
			@initializer = initializer->operand();
		};

		rt::optional_ref<const Type> initializer_type;

		if (type && !(type->kind() == type_kind::named && type->entity()->kind() == entity_kind::record) && syntax.variable_initializer()->token().kind != token_kind::op_copy) {
			@initializer_type.bind(*type);
		};

		var value = @this.expression(@scope, @*initializer, initializer_type);

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!type && value.get()->kind() != semantic_kind::noop) {
			@type = @this.infer_variable(@syntax, *value.get());
			if (!type) {
				return rt::unique<SemanticExpression>();
			};
		};

		if (!type || type->kind() == type_kind::void_type || type->kind() == type_kind::null_type || type->kind() == type_kind::function) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("variable ", 9));
			@message.quoted(name.text());
			@message.text(rt::string_view(" requires object storage or a reference; ", 41));
			if (type) {
				@message.text(rt::string_view("declared type is '", 18));
				diagnostic_type(@message, *type);
				@message.text(rt::string_view("'", 1));
			}
			else {
				@message.text(rt::string_view("neither a declared type nor an inferred initializer type is available", 69));
			};
			@this.report(name, message.view());

			return rt::unique<SemanticExpression>();
		};

		if (type->kind() == type_kind::reference && value.get()->kind() == semantic_kind::noop) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("reference ", 10));
			@message.quoted(name.text());
			@message.text(rt::string_view(" of type '", 10));
			diagnostic_type(@message, *type);
			@message.text(rt::string_view("' requires an initializer", 25));
			@this.report(name, message.view());

			return rt::unique<SemanticExpression>();
		};

		@value = @this.initialize(@syntax, type, rt::unique<SemanticExpression>(@value.release()));

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		var Entity* entity = @this.unit->create_entity(entity_kind::local, name, &@syntax, &@scope);

		if (!entity) {
			return rt::unique<SemanticExpression>();
		};

		@entity->set_type(type);
		@entity->set_state(entity_state::ready);
		var result = @this.node(semantic_kind::variable, void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		@result.get()->bind(entity, value_category::consumable);

		return $result;
	};

	if (kind == syntax_kind::return_value) {
		if (!this.function) {
			@this.error(&@syntax, rt::string_view("return requires an enclosing function", 37));

			return rt::unique<SemanticExpression>();
		};

		Type* result_type = this.function->type()->signature().result();
		var result = @this.node(semantic_kind::return_value, void_type, &@syntax);
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>(*result_type));

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::conditional || kind == syntax_kind::while_loop || kind == syntax_kind::for_loop) {
		semantic_kind category = semantic_kind::conditional;
		var Scope* local = &@scope;

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth + 1;
			@category = semantic_kind::while_loop;
		};

		if (kind == syntax_kind::for_loop) {
			@category = semantic_kind::for_loop;
			@local = @this.unit->create_scope(&@scope, this.function);
			if (local && !@this.unit->record_scope(@*local, @syntax)) {
				return rt::unique<SemanticExpression>();
			};
		};

		var result = @this.node(semantic_kind(category), void_type, &@syntax);

		if (!local || !result.get()) {
			return rt::unique<SemanticExpression>();
		};

		usize index = 0;
		while (index < syntax.size()) {
			rt::optional_ref<const Type> context;

			if (kind == syntax_kind::for_loop && index == 1 || kind != syntax_kind::for_loop && !index) {
				if (syntax.item(index)->kind() != syntax_kind::absent) {
					@context.bind(*bool_type);
				};
			};

			var child = @this.expression(@*local, @*syntax.item(index), context);

			if (!child.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($child)) {
				return rt::unique<SemanticExpression>();
			};

			@index = index + 1;
		};

		if (kind != syntax_kind::conditional) {
			@this.loop_depth = this.loop_depth - 1;
		};

		return $result;
	};

	if (kind == syntax_kind::break_loop || kind == syntax_kind::continue_loop) {
		if (!this.loop_depth && (kind == syntax_kind::continue_loop || !this.active_switch)) {
			if (kind == syntax_kind::continue_loop) {
				@this.report(syntax.token(), rt::string_view("'continue' requires an enclosing loop", 37));
			}
			else {
				@this.report(syntax.token(), rt::string_view("'break' requires an enclosing loop or switch", 44));
			};

			return rt::unique<SemanticExpression>();
		};

		if (kind == syntax_kind::break_loop) {
			return @this.node(semantic_kind::break_loop, void_type, &@syntax);
		};

		return @this.node(semantic_kind::continue_loop, void_type, &@syntax);
	};

	if (kind == syntax_kind::unary) {
		return @this.unary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::binary) {
		return @this.binary(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::call) {
		return @this.call(@scope, @syntax, expected, false);
	};

	if (kind == syntax_kind::cast) {
		return @this.cast(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::member || kind == syntax_kind::index) {
		return @this.component(@scope, @syntax, expected);
	};

	if (kind == syntax_kind::discard_value) {
		var value = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!value.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (value.get()->category() != value_category::consumable) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("discard requires a consumable; operand is a place of type '", 59));
			diagnostic_type(@message, *value.get()->type());
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		var result = @this.node(semantic_kind::discard_value, void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($value)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	if (kind == syntax_kind::allocation) {
		var Syntax* type_syntax = syntax.allocation_type();
		var Syntax* count = nullptr;

		if (type_syntax->kind() == syntax_kind::type_array) {
			@count = type_syntax->array_extent();
			@type_syntax = type_syntax->designated_type();
		};

		Type* target = @this.type(@scope, @*type_syntax);

		if (!target) {
			return rt::unique<SemanticExpression>();
		};

		var construction = @this.construct(@scope, @syntax, target, @*syntax.allocation_arguments());

		if (!construction.get()) {
			return rt::unique<SemanticExpression>();
		};

		Type* pointee = target;

		if (!type_syntax->explicitly_qualified()) {
			@pointee = @this.types->qualified(*target, type_qualifier::immutable);

			if (!pointee) {
				return rt::unique<SemanticExpression>();
			};
		};

		var result = @this.node(semantic_kind::allocation, @this.types->pointer(pointee), &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($construction)) {
			return rt::unique<SemanticExpression>();
		};

		if (count) {
			var extent = @this.expression(@scope, @*count, rt::optional_ref<const Type>());

			if (!extent.get()) {
				return rt::unique<SemanticExpression>();
			};

			if (!extent.get()->type()->kind().is_integer()) {
				var message = DiagnosticMessage();
				@message.text(rt::string_view("array allocation count requires an integer; received '", 54));
				diagnostic_type(@message, *extent.get()->type());
				@message.text(rt::string_view("' when allocating elements of type '", 36));
				diagnostic_type(@message, *target);
				@message.text(rt::string_view("'", 1));
				@this.report(count->token(), message.view());

				return rt::unique<SemanticExpression>();
			};

			if (!@result.get()->append($extent)) {
				return rt::unique<SemanticExpression>();
			};
		};

		return @this.convert($result, expected, @syntax);
	};

	if (kind == syntax_kind::deallocation || kind == syntax_kind::array_deallocation) {
		var pointer = @this.expression(@scope, @*syntax.operand(), rt::optional_ref<const Type>());

		if (!pointer.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (pointer.get()->type()->kind() != type_kind::pointer) {
			var message = DiagnosticMessage();
			if (kind == syntax_kind::array_deallocation) {
				@message.text(rt::string_view("delete[]", 8));
			}
			else {
				@message.text(rt::string_view("delete", 6));
			};
			@message.text(rt::string_view(" requires a pointer; operand has type '", 39));
			diagnostic_type(@message, *pointer.get()->type());
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());

			return rt::unique<SemanticExpression>();
		};

		semantic_kind category = semantic_kind::deallocation;

		if (kind == syntax_kind::array_deallocation) {
			@category = semantic_kind::array_deallocation;
		};

		var result = @this.node(semantic_kind(category), void_type, &@syntax);

		if (!result.get()) {
			return rt::unique<SemanticExpression>();
		};

		if (!@result.get()->append($pointer)) {
			return rt::unique<SemanticExpression>();
		};

		return $result;
	};

	var message = DiagnosticMessage();
	@message.text(rt::string_view("semantic analysis for this expression is not implemented; expression begins with ", 81));
	@message.quoted(syntax.token().text());
	@this.report(syntax.token(), message.view());

	return rt::unique<SemanticExpression>();
};

struct SwitchCase {
	u64 value;
	var Syntax* declaration;
};

struct SwitchAnalysis {
	Type* condition_type;
	Type* source_type;
	rt::buffer<SwitchCase> cases;
	var Syntax* default_label;
};

struct SwitchAnalysisScope {
	fn SwitchAnalysisScope(var SwitchAnalysisScope& this, var SwitchAnalysis var*& slot, var SwitchAnalysis& current);
	fn ~SwitchAnalysisScope(var SwitchAnalysisScope& this);

private:
	var SwitchAnalysis var** slot;
	var SwitchAnalysis* previous;
};

fn Analyzer::selection(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	var condition = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>());

	if (!condition.get()) {
		return rt::unique<SemanticExpression>();
	};

	Type* representation = condition.get()->type()->representation();

	if (!representation->kind().is_integer()) {
		var message = DiagnosticMessage();
		@message.text(rt::string_view("switch condition requires an integer or enumeration value; received '", 69));
		diagnostic_type(@message, *condition.get()->type());
		@message.text(rt::string_view("'", 1));
		@this.report(syntax.item(0)->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	SwitchAnalysis analysis;
	@analysis.condition_type = representation;
	@analysis.source_type = condition.get()->type();
	var context = SwitchAnalysisScope(@this.active_switch, @analysis);
	var body = @this.expression(@scope, @*syntax.item(1), rt::optional_ref<const Type>());

	if (!body.get()) {
		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::switch_expression, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($condition)) {
		return rt::unique<SemanticExpression>();
	};

	if (!@result.get()->append($body)) {
		return rt::unique<SemanticExpression>();
	};

	return $result;
};

fn Analyzer::label(var Analyzer& this, var Scope& scope, var Syntax& syntax) -> rt::unique<SemanticExpression> {
	if (!this.active_switch) {
		var message = DiagnosticMessage();
		@message.quoted(syntax.token().text());
		@message.text(rt::string_view(" label requires an enclosing switch", 35));
		@this.report(syntax.token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	var result = @this.node(semantic_kind::case_label, this.types->find_primitive(rt::string_view("void", 4)), &@syntax);

	if (!result.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (syntax.token().kind == token_kind::kw_default) {
		if (this.active_switch->default_label) {
			@this.error(&@syntax, rt::string_view("switch contains more than one default label", 43));
			@this.note(this.active_switch->default_label->token(), rt::string_view("previous default label is here", 30));

			return rt::unique<SemanticExpression>();
		};

		@this.active_switch->default_label = &@syntax;

		return $result;
	};

	var expression = @this.expression(@scope, @*syntax.item(0), rt::optional_ref<const Type>(*this.active_switch->condition_type));
	u64 value = 0;

	if (!expression.get()) {
		return rt::unique<SemanticExpression>();
	};

	if (!@this.constant_integer(*expression.get(), @value)) {
		if (this.failed()) {
			return rt::unique<SemanticExpression>();
		};
		var message = DiagnosticMessage();
		@message.text(rt::string_view("case label requires an integer constant expression for switch type '", 68));
		diagnostic_type(@message, *this.active_switch->source_type);
		@message.text(rt::string_view("'; expression beginning with ", 29));
		@message.quoted(syntax.item(0)->token().text());
		@message.text(rt::string_view(" of type '", 10));
		diagnostic_type(@message, *expression.get()->type());
		@message.text(rt::string_view("' is not constant", 17));
		@this.report(syntax.item(0)->token(), message.view());

		return rt::unique<SemanticExpression>();
	};

	@value = this.active_switch->condition_type->normalize_integer(value);
	usize index = 0;
	while (index < this.active_switch->cases.size()) {
		SwitchCase& previous = this.active_switch->cases.data()[index];
		if (previous.value == value) {
			var message = DiagnosticMessage();
			@message.text(rt::string_view("duplicate switch case value ", 28));
			if (this.active_switch->condition_type->kind() == type_kind::signed_integer && this.active_switch->condition_type->signed_value(value) < 0) {
				@message.text(rt::string_view("-", 1));
				@message.number(u64(0) - u64(this.active_switch->condition_type->signed_value(value)));
			}
			else {
				@message.number(value);
			};
			@message.text(rt::string_view(" for switch type '", 18));
			diagnostic_type(@message, *this.active_switch->source_type);
			@message.text(rt::string_view("'", 1));
			@this.report(syntax.token(), message.view());
			@this.note(previous.declaration->token(), rt::string_view("previous case label is here", 27));

			return rt::unique<SemanticExpression>();
		};

		@index = index + 1;
	};

	SwitchCase current;
	@current.value = value;
	@current.declaration = &@syntax;
	if (!@this.active_switch->cases.push_back($current)) {
		@this.error(&@syntax, rt::string_view("switch label storage is unavailable", 35));

		return rt::unique<SemanticExpression>();
	};

	@result.get()->set_integer(value);

	return $result;
};

fn SwitchAnalysisScope::SwitchAnalysisScope(var SwitchAnalysisScope& this, var SwitchAnalysis var*& slot, var SwitchAnalysis& current) {
	@this.slot = &@slot;
	@this.previous := slot;
	@slot = &@current;
};

fn SwitchAnalysisScope::~SwitchAnalysisScope(var SwitchAnalysisScope& this) {
	@*this.slot := this.previous;
};

enum object_lifetime : [u08] {
	live;
	relocated;
	discarded;
	destroyed;
	indeterminate;
};

enum flow_exit : [u08] {
	none;
	unreachable;
	return_function;
	break_loop;
	continue_loop;
};

enum flow_region : [u08] {
	loop;
	selection;
};

struct LiveBinding {
	var Entity* entity;
	object_lifetime lifetime;
	rt::optional_ref<Entity> referent;
};

struct FlowState {
	fn declare(var FlowState& this, var Entity* entity) -> bool;
	fn copy_from(var FlowState& this, FlowState& other) -> bool;
	fn truncate(var FlowState& this, usize size);
	fn leave(var FlowState& this, flow_exit exit);
	fn resume(var FlowState& this);

	fn size(FlowState& this) -> usize;
	fn at(var FlowState& this, usize index) -> var LiveBinding*;
	fn find(var FlowState& this, var Entity* entity) -> var LiveBinding*;
	fn exited(FlowState& this) -> bool;

private:
	rt::buffer<LiveBinding> bindings;
	flow_exit exit;
};

struct LoopFlow {
	flow_region region;
	usize break_boundary;
	usize continue_boundary;
	var LoopFlow* parent;
	rt::buffer<rt::unique<FlowState>> breaks;
	rt::buffer<rt::unique<FlowState>> continues;
};

struct LoopScope {
	fn LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop);
	fn ~LoopScope(var LoopScope& this);

private:
	var LoopFlow var** current;
	var LoopFlow* previous;
};

struct LifetimeAnalyzer {
	fn LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics);

	fn sequence(var LifetimeAnalyzer& this, var SemanticExpression& expression, var FlowState& state) -> bool;
	fn validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> bool;

	fn storage_owner(LifetimeAnalyzer& this, SemanticExpression& expression, var FlowState& state) -> rt::optional_ref<Entity>;

private:
	fn error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view& message) -> bool;
	fn binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view& reason, Entity& entity) -> bool;
	fn walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool;
	fn storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool;
	fn merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> bool;
	fn validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> bool;
	fn conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool;
	fn loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool;
	fn selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool;
	fn save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> bool;

	var Diagnostics* diagnostics;
	var LoopFlow* active_loop;
};

fn LifetimeAnalyzer::error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view& message) -> bool {
	Token token;

	if (expression) {
		@token = expression->token();
	};

	@this.diagnostics->error(token, message);
	return false;
};

fn LifetimeAnalyzer::binding_error(var LifetimeAnalyzer& this, var SemanticExpression* expression, rt::string_view& reason, Entity& entity) -> bool {
	if (this.diagnostics->failed()) {
		return false;
	};
	var message = DiagnosticMessage();
	@message.text(reason);
	@message.text(rt::string_view("; object '", 10));
	diagnostic_entity(@message, entity);
	@message.text(rt::string_view("' has type '", 12));
	diagnostic_type(@message, *entity.type());
	@message.text(rt::string_view("'", 1));
	Token location = entity.token();
	if (expression) {
		@location = expression->token();
	};
	@this.diagnostics->error(location, message.view());
	@this.diagnostics->note(entity.token(), rt::string_view("object is declared here", 23));
	return false;
};

fn LifetimeAnalyzer::merge(var LifetimeAnalyzer& this, var FlowState& destination, var FlowState& first, var FlowState& second, var SemanticExpression* expression) -> bool {
	if (first.exited() && second.exited()) {
		return @destination.copy_from(first);
	};

	if (first.exited()) {
		return @destination.copy_from(second);
	};

	if (second.exited()) {
		return @destination.copy_from(first);
	};

	usize index = 0;
	while (index < destination.size()) {
		var LiveBinding* binding = @destination.at(index);
		var LiveBinding* a = @first.find(binding->entity);
		var LiveBinding* b = @second.find(binding->entity);

		if (!a || !b) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable control-flow merge\0", *binding->entity);
		};

		if (a->lifetime == object_lifetime::indeterminate || b->lifetime == object_lifetime::indeterminate || (a->lifetime == object_lifetime::live) != (b->lifetime == object_lifetime::live)) {
			@binding->lifetime = object_lifetime::indeterminate;
		}
		else {
			@binding->lifetime = object_lifetime(a->lifetime);
		};

		if (a->referent.get() != b->referent.get() || !a->referent.has_value()) {
			@binding->referent.reset();
		}
		else {
			@binding->referent.bind(@*a->referent.get());
		};

		@index = index + 1;
	};

	return true;
};

fn LifetimeAnalyzer::validate_backedge(var LifetimeAnalyzer& this, var FlowState& entry, var FlowState& incoming, var SemanticExpression* expression) -> bool {
	usize index = 0;
	while (index < entry.size()) {
		var LiveBinding* binding = @entry.at(index);
		var LiveBinding* repeated = @incoming.find(binding->entity);

		if (!repeated || (binding->lifetime == object_lifetime::indeterminate) != (repeated->lifetime == object_lifetime::indeterminate) || (binding->lifetime == object_lifetime::live) != (repeated->lifetime == object_lifetime::live)) {
			return @this.binding_error(expression, "inconsistent object lifetimes at reachable loop backedge\0", *binding->entity);
		};

		@index = index + 1;
	};

	return true;
};

fn LifetimeAnalyzer::conditional(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool {
	if (!@this.walk(expression->item(0), @state)) {
		return false;
	};

	bool truth = false;

	if (expression->item(0)->constant_truth(@truth)) {
		if (truth) {
			return @this.walk(expression->item(1), @state);
		};

		return @this.walk(expression->item(2), @state);
	};

	FlowState first;
	FlowState second;

	if (!@first.copy_from(state) || !@second.copy_from(state)) {
		return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	if (!@this.walk(expression->item(1), @first) || !@this.walk(expression->item(2), @second)) {
		return false;
	};

	return @this.merge(@state, @first, @second, $expression);
};

fn LifetimeAnalyzer::storage(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool {
	var Entity* owner = expression->owned_binding();

	if (!owner) {
		return @this.walk(expression, @state);
	};

	if (!@state.find(owner)) {
		return @this.binding_error(expression, "object storage does not reach this construction\0", *owner);
	};

	return true;
};

fn LifetimeAnalyzer::save(var LifetimeAnalyzer& this, var rt::buffer<rt::unique<FlowState>>& exits, var FlowState& state, usize boundary, var SemanticExpression* expression) -> bool {
	var snapshot = rt::unique<FlowState>::make();

	if (!snapshot.get() || !@snapshot.get()->copy_from(state)) {
		return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	@snapshot.get()->truncate($boundary);
	@snapshot.get()->resume();

	if (!@exits.push_back($snapshot)) {
		return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	return true;
};

fn LifetimeAnalyzer::loop(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool {
	bool is_for = expression->kind() == semantic_kind::for_loop;
	usize boundary = state.size();

	if (is_for && !@this.walk(expression->item(0), @state)) {
		return false;
	};

	FlowState entry;

	if (!@entry.copy_from(state)) {
		return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	usize condition = 0;
	usize body = 1;

	if (is_for) {
		@condition = 1;
		@body = 3;
	};

	var SemanticExpression* test = expression->item(condition);

	if (!@this.walk(test, @state)) {
		return false;
	};

	bool truth = true;
	bool known = is_for && test->kind() == semantic_kind::noop;

	if (!known) {
		@known = test->constant_truth(@truth);
	};

	if (known && !truth) {
		@state.truncate(boundary);

		return true;
	};

	FlowState repeated;

	if (!@repeated.copy_from(state)) {
		return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	LoopFlow loop;
	@loop.parent := this.active_loop;
	@loop.break_boundary := boundary;
	@loop.continue_boundary = state.size();
	var scope = LoopScope(@this.active_loop, @loop);

	if (!@this.walk(expression->item(body), @repeated)) {
		return false;
	};

	if (!repeated.exited() && !@this.save(@loop.continues, @repeated, loop.continue_boundary, expression)) {
		return false;
	};

	usize body_exits = loop.continues.size();
	usize index = 0;
	while (index < body_exits) {
		var FlowState& backedge = @*loop.continues.data()[index].get();

		if (is_for && !@this.walk(expression->item(2), @backedge)) {
			return false;
		};

		if (!backedge.exited()) {
			if (!@this.validate_backedge(@entry, @backedge, expression)) {
				return false;
			};
		};

		@index = index + 1;
	};

	while (index < loop.continues.size()) {
		if (!@this.validate_backedge(@entry, @*loop.continues.data()[index].get(), expression)) {
			return false;
		};

		@index = index + 1;
	};

	@state.truncate(boundary);
	bool has_exit = !known || !truth;
	@index = 0;

	while (index < loop.breaks.size()) {
		var FlowState& leaving = @*loop.breaks.data()[index].get();

		if (!has_exit) {
			if (!@state.copy_from(leaving)) {
				return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
			};

			@has_exit = true;
		}
		else {
			FlowState previous;

			if (!@previous.copy_from(state) || !@this.merge(@state, @previous, @leaving, expression)) {
				return false;
			};
		};

		@index = index + 1;
	};

	if (!has_exit) {
		@state.leave(flow_exit::unreachable);
	};

	return true;
};

fn LifetimeAnalyzer::walk(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool {
	if (!expression || state.exited()) {
		return true;
	};

	switch (expression->kind()) {
		case semantic_kind::binary:
			if (expression->operation() == token_kind::op_and || expression->operation() == token_kind::op_or) {
				if (!@this.walk(expression->item(0), @state)) {
					return false;
				};

				bool truth = false;

				if (expression->item(0)->constant_truth(@truth)) {
					if (expression->operation() == token_kind::op_and && !truth || expression->operation() == token_kind::op_or && truth) {
						return true;
					};

					return @this.walk(expression->item(1), @state);
				};

				FlowState skipped;
				FlowState evaluated;

				if (!@skipped.copy_from(state) || !@evaluated.copy_from(state)) {
					return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
				};

				if (!@this.walk(expression->item(1), @evaluated)) {
					return false;
				};

				return @this.merge(@state, @skipped, @evaluated, $expression);
			};

			break;
		case semantic_kind::conditional:
			return @this.conditional($expression, @state);
		case semantic_kind::switch_expression:
			return @this.selection(expression, @state);
		case semantic_kind::while_loop:
		case semantic_kind::for_loop:
			return @this.loop($expression, @state);
		case semantic_kind::sequence:
			return @this.sequence(@*expression, @state);
		case semantic_kind::name: {
			var Entity* entity = expression->entity();

			if (!entity || (entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter)) {
				return true;
			};

			var LiveBinding* binding = @state.find($entity);
			var owner = this.storage_owner(*expression, @state);

			if (owner.has_value()) {
				@binding = @state.find(owner.get());
			};

			if (!binding) {
				return @this.binding_error(expression, "object construction does not reach this use\0", *expression->entity());
			};

			if (binding->lifetime == object_lifetime::destroyed) {
				return @this.binding_error(expression, "object has been destroyed\0", *binding->entity);
			};

			if (binding->lifetime != object_lifetime::live) {
				if (binding->lifetime == object_lifetime::relocated) {
					return @this.binding_error(expression, "object has been relocated\0", *binding->entity);
				};
				if (binding->lifetime == object_lifetime::discarded) {
					return @this.binding_error(expression, "object has been discarded\0", *binding->entity);
				};
				return @this.binding_error(expression, "object lifetime differs across reachable control-flow paths\0", *binding->entity);
			};

			return true;
		};
		case semantic_kind::variable: {
			if (!@this.walk(expression->item(0), @state)) {
				return false;
			};

			var owner = this.storage_owner(*expression->item(0), @state);

			if (!@state.declare(expression->entity())) {
				return @this.error($expression, rt::string_view("lifetime state storage is unavailable", 37));
			};

			if (expression->entity()->type()->kind() == type_kind::reference && owner.has_value()) {
				var LiveBinding* binding = @state.find(expression->entity());
				@binding->referent.bind(@*owner.get());
			};

			return true;
		};
		case semantic_kind::relocation: {
			var SemanticExpression* source = expression->item(0);

			if (!@this.walk(source, @state)) {
				return false;
			};

			var Entity* owner = source->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::relocated;
				};
			};

			return true;
		};
		case semantic_kind::destruction: {
			var SemanticExpression* object = expression->item(0);

			if (!@this.walk(object, @state)) {
				return false;
			};

			var Entity* owner = object->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::destroyed;
				};
			};

			return true;
		};
		case semantic_kind::construction: {
			if (expression->size() < 2) {
				return @this.walk(expression->item(0), @state);
			};

			var SemanticExpression* destination = expression->item(1);

			if (!@this.storage(destination, @state) || !@this.walk(expression->item(0), @state)) {
				return false;
			};

			var Entity* owner = destination->owned_binding();

			if (owner) {
				var LiveBinding* binding = @state.find(owner);

				if (binding) {
					@binding->lifetime = object_lifetime::live;
				};
			};

			return true;
		};
		case semantic_kind::return_value:
			if (!@this.walk(expression->item(0), @state)) {
				return false;
			};

			@state.leave(flow_exit::return_function);

			return true;
		case semantic_kind::break_loop:
			if (!this.active_loop) {
				return @this.error(expression, rt::string_view("break requires an enclosing loop or switch", 42));
			};
			if (!@this.save(@this.active_loop->breaks, @state, usize(this.active_loop->break_boundary), expression)) {
				return false;
			};

			@state.leave(flow_exit::break_loop);

			return true;
		case semantic_kind::continue_loop: {
			var LoopFlow* loop = this.active_loop;

			while (loop && loop->region == flow_region::selection) {
				@loop = loop->parent;
			};

			if (!loop) {
				return @this.error(expression, rt::string_view("continue requires an enclosing loop", 35));
			};
			if (!@this.save(@loop->continues, @state, usize(loop->continue_boundary), expression)) {
				return false;
			};

			@state.leave(flow_exit::continue_loop);

			return true;
		};
		default:
			break;
	};

	usize boundary = state.size();
	usize index = 0;
	while (index < expression->size()) {
		if (!@this.walk(expression->item(index), @state)) {
			return false;
		};

		@index = index + 1;
	};

	if (expression->kind() == semantic_kind::brace) {
		@state.truncate(boundary);
	};

	return true;
};

fn LifetimeAnalyzer::validate(var LifetimeAnalyzer& this, SemanticUnit& unit) -> bool {
	usize index = 0;
	while (index < unit.entities().size()) {
		var Entity* function = unit.entities().data()[index].get();
		@index = index + 1;

		if (function->kind() != entity_kind::function || !function->body()) {
			continue;
		};

		FlowState state;
		usize parameter = 0;

		while (parameter < function->parameters().size()) {
			if (!@state.declare(function->parameters().data()[parameter])) {
				return @this.error(nullptr, rt::string_view("lifetime state storage is unavailable", 37));
			};

			@parameter = parameter + 1;
		};

		if (!@this.walk(function->body(), @state)) {
			return false;
		};

		function_completion completion = function_completion::reaches_end;

		if (state.exited()) {
			@completion = function_completion::no_fallthrough;
		};

		@function->set_completion($completion);
	};

	return true;
};

fn FlowState::size(FlowState& this) -> usize {
	return this.bindings.size();
};

fn FlowState::at(var FlowState& this, usize index) -> var LiveBinding* {
	return (@this.bindings).data() + index;
};

fn FlowState::find(var FlowState& this, var Entity* entity) -> var LiveBinding* {
	usize index = this.bindings.size();
	while (index) {
		@index = index - 1;

		if (this.bindings.data()[index].entity == entity) {
			return (@this.bindings).data() + index;
		};
	};

	return nullptr;
};

fn FlowState::declare(var FlowState& this, var Entity* entity) -> bool {
	LiveBinding binding;
	@binding.entity = $entity;
	@binding.lifetime = object_lifetime::live;

	return @this.bindings.push_back($binding);
};

fn FlowState::copy_from(var FlowState& this, FlowState& other) -> bool {
	@this.bindings.clear();
	@this.exit = flow_exit(other.exit);
	usize index = 0;
	while (index < other.bindings.size()) {
		LiveBinding binding := other.bindings.data()[index];

		if (!@this.bindings.push_back($binding)) {
			return false;
		};

		@index = index + 1;
	};

	return true;
};

fn FlowState::truncate(var FlowState& this, usize size) {
	while (this.bindings.size() > size) {
		@this.bindings.pop_back();
	};
};

fn FlowState::exited(FlowState& this) -> bool {
	return this.exit != flow_exit::none;
};

fn FlowState::leave(var FlowState& this, flow_exit exit) {
	@this.exit = $exit;
};

fn FlowState::resume(var FlowState& this) {
	@this.exit = flow_exit::none;
};

fn LoopScope::LoopScope(var LoopScope& this, var LoopFlow var*& current, var LoopFlow& loop) {
	@this.current = &@current;
	@this.previous := current;
	@current = &@loop;
};

fn LoopScope::~LoopScope(var LoopScope& this) {
	@*this.current := this.previous;
};

fn LifetimeAnalyzer::LifetimeAnalyzer(var LifetimeAnalyzer& this, var Diagnostics& diagnostics) {
	@this.diagnostics = &@diagnostics;
};

fn LifetimeAnalyzer::selection(var LifetimeAnalyzer& this, var SemanticExpression* expression, var FlowState& state) -> bool {
	if (!@this.walk(expression->item(0), @state)) {
		return false;
	};

	var SemanticExpression* body = expression->item(1);

	if (body->kind() != semantic_kind::brace) {
		return true;
	};

	usize boundary = state.size();
	u64 condition = 0;
	bool known = expression->item(0)->constant_integer(@condition);
	usize selected = body->size();
	usize fallback = body->size();
	usize index = 0;
	while (index < body->size()) {
		var SemanticExpression* label = body->item(index);

		if (label->kind() == semantic_kind::case_label) {
			if (label->token().kind == token_kind::kw_default) {
				@fallback := index;
			}
			else if (known && label->integer() == condition) {
				@selected := index;
			};
		};

		@index = index + 1;
	};

	if (selected == body->size()) {
		@selected := fallback;
	};

	FlowState combined;

	if (!@combined.copy_from(state)) {
		return @this.error(expression, rt::string_view("lifetime state storage is unavailable", 37));
	};

	if (fallback < body->size() || known && selected < body->size()) {
		@combined.leave(flow_exit::unreachable);
	};

	LoopFlow selection;
	@selection.region = flow_region::selection;
	@selection.parent := this.active_loop;
	@selection.break_boundary := boundary;
	var scope = LoopScope(@this.active_loop, @selection);
	@index = 0;

	while (index < body->size()) {
		if (body->item(index)->kind() != semantic_kind::case_label || known && index != selected) {
			@index = index + 1;
			continue;
		};

		FlowState path;

		if (!@path.copy_from(state)) {
			return @this.error(expression, rt::string_view("lifetime state storage is unavailable", 37));
		};

		usize next = index + 1;

		while (next < body->size() && !path.exited()) {
			if (body->item(next)->kind() != semantic_kind::case_label && !@this.walk(body->item(next), @path)) {
				return false;
			};

			@next = next + 1;
		};

		if (!path.exited() && !@this.save(@selection.breaks, @path, boundary, expression)) {
			return false;
		};

		@index = index + 1;
	};

	@index = 0;

	while (index < selection.breaks.size()) {
		FlowState previous;

		if (!@previous.copy_from(combined) || !@this.merge(@combined, @previous, @*selection.breaks.data()[index].get(), expression)) {
			return false;
		};

		@index = index + 1;
	};

	return @state.copy_from(combined);
};

fn LifetimeAnalyzer::storage_owner(LifetimeAnalyzer& this, SemanticExpression& expression, var FlowState& state) -> rt::optional_ref<Entity> {
	switch (expression.kind()) {
		case semantic_kind::name: {
			var Entity* entity = expression.entity();

			if (!entity || entity->kind() != entity_kind::local && entity->kind() != entity_kind::parameter) {
				return rt::optional_ref<Entity>();
			};

			usize remaining = state.size();
			while (entity->type()->kind() == type_kind::reference) {
				var LiveBinding* binding = @state.find(entity);

				if (!binding) {
					return rt::optional_ref<Entity>(@*entity);
				};

				if (!remaining || !binding->referent.has_value()) {
					return rt::optional_ref<Entity>();
				};

				@entity = binding->referent.get();
				@remaining = remaining - 1;
			};

			return rt::optional_ref<Entity>(@*entity);
		};
		case semantic_kind::access:
		case semantic_kind::cast:
		case semantic_kind::member:
			return this.storage_owner(*expression.item(0), @state);
		case semantic_kind::index:
			if (expression.item(0)->type()->kind() == type_kind::array) {
				return this.storage_owner(*expression.item(0), @state);
			};

			break;
		case semantic_kind::dereference:
			if (expression.item(0)->kind() == semantic_kind::address) {
				return this.storage_owner(*expression.item(0)->item(0), @state);
			};

			break;
		case semantic_kind::sequence:
			return this.storage_owner(*expression.item(2), @state);
	};

	return rt::optional_ref<Entity>();
};

fn LifetimeAnalyzer::sequence(var LifetimeAnalyzer& this, var SemanticExpression& expression, var FlowState& state) -> bool {
	usize boundary = state.size();

	if (!@this.walk(expression.item(0), @state) || !@this.walk(expression.item(1), @state) || !@this.walk(expression.item(2), @state)) {
		return false;
	};

	if (!state.exited() && expression.category() == value_category::place) {
		var owner = this.storage_owner(*expression.item(2), @state);

		if (owner.has_value()) {
			usize index = boundary;
			while (index < state.size()) {
				var LiveBinding* binding = @state.at(index);

				if (binding->entity == owner.get()) {
					return @this.binding_error(&@expression, "sequence result refers to local storage\0", *binding->entity);
				};

				@index = index + 1;
			};
		};
	};

	@state.truncate(boundary);

	return true;
};

