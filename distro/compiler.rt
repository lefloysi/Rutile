fn native_template_modules(var DiagnosticMessage& message, TemplateArgument& argument) {
	if (argument.type) {
		native_type_modules(@message, *argument.type);
	};
	if (argument.kind == template_argument_kind::pack && argument.pack) {
		usize index = 0;
		while (index < argument.pack->elements.size()) {
			native_template_modules(@message, argument.pack->elements.data()[index]);
			@index = index + 1;
		};
	};
};

fn native_entity_modules(var DiagnosticMessage& message, Entity& entity) {
	var Scope* scope = entity.scope();
	if (scope && scope->owner() && scope->owner() != &@entity) {
		native_entity_modules(@message, *scope->owner());
	};
	Token token = entity.token();
	if (entity.kind() != entity_kind::namespace_body && token.source && !token.source->module_name().empty()) {
		@message.text("[");
		@message.text(token.source->module_name());
		@message.text("]");
	};
	TemplateInstantiation* instance = entity.template_arguments();
	if (instance) {
		usize index = 0;
		while (index < instance->arguments.size()) {
			native_template_modules(@message, instance->arguments.data()[index]);
			@index = index + 1;
		};
	};
};

fn native_type_modules(var DiagnosticMessage& message, Type& type) {
	if (type.kind() == type_kind::named || type.kind() == type_kind::parameter) {
		native_entity_modules(@message, *type.entity());
		return;
	};
	if (type.kind() == type_kind::pointer || type.kind() == type_kind::reference || type.kind() == type_kind::array) {
		native_type_modules(@message, *type.element());
		return;
	};
	if (type.kind() == type_kind::function) {
		FunctionSignature& signature = type.signature();
		native_type_modules(@message, *signature.result());
		usize index = 0;
		while (index < signature.parameters().size()) {
			native_type_modules(@message, *signature.parameters().data()[index]);
			@index = index + 1;
		};
	};
};

fn FunctionEmitter::truth(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* type) -> var LLVMOpaqueValue* {
	if (!value) {
		return nullptr;
	};

	if (type->kind() == type_kind::boolean) {
		return value;
	};

	var LLVMOpaqueValue* zero = LLVMConstNull(@this.backend->type(type));

	if (type->kind() == type_kind::floating_point) {
		return LLVMBuildFCmp(this.backend->builder(), 14, value, zero, "truth\0".data());
	};

	return LLVMBuildICmp(this.backend->builder(), 33, value, zero, "truth\0".data());
};

fn FunctionEmitter::convert(var FunctionEmitter& this, var LLVMOpaqueValue* value, Type* source, Type* target) -> var LLVMOpaqueValue* {
	if (!value || !source || !target) {
		return nullptr;
	};

	@source = FunctionEmitter::representation(source);
	@target = FunctionEmitter::representation(target);
	var LLVMOpaqueType* native = @this.backend->type(target);

	if (LLVMTypeOf((var LLVMOpaqueValue*(value))) == native) {
		return value;
	};

	if (target->kind() == type_kind::boolean) {
		return @this.truth(value, source);
	};

	if (source->kind() == type_kind::pointer && target->kind() == type_kind::pointer) {
		return value;
	};

	if (source->kind() == type_kind::pointer) {
		return LLVMBuildPtrToInt(this.backend->builder(), value, native, "pointer.integer\0".data());
	};

	if (target->kind() == type_kind::pointer) {
		return LLVMBuildIntToPtr(this.backend->builder(), value, native, "integer.pointer\0".data());
	};

	if (source->kind() == type_kind::floating_point) {
		if (target->kind() == type_kind::floating_point) {
			if (source->bits() > target->bits()) {
				return LLVMBuildFPTrunc(this.backend->builder(), value, native, "float.narrow\0".data());
			};

			return LLVMBuildFPExt(this.backend->builder(), value, native, "float.widen\0".data());
		};

		if (target->kind() == type_kind::unsigned_integer) {
			return LLVMBuildFPToUI(this.backend->builder(), value, native, "float.unsigned\0".data());
		};

		return LLVMBuildFPToSI(this.backend->builder(), value, native, "float.signed\0".data());
	};

	if (target->kind() == type_kind::floating_point) {
		if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
			return LLVMBuildUIToFP(this.backend->builder(), value, native, "unsigned.float\0".data());
		};

		return LLVMBuildSIToFP(this.backend->builder(), value, native, "signed.float\0".data());
	};

	u32 source_bits = source->bits();
	u32 target_bits = target->bits();

	if (source->kind() == type_kind::boolean) {
		@source_bits = 1;
	};

	if (source->kind() == type_kind::character) {
		@source_bits = 8;
	};

	if (target->kind() == type_kind::character) {
		@target_bits = 8;
	};

	if (source_bits > target_bits) {
		return LLVMBuildTrunc(this.backend->builder(), value, native, "integer.narrow\0".data());
	};

	if (source->kind() == type_kind::unsigned_integer || source->kind() == type_kind::boolean) {
		return LLVMBuildZExt(this.backend->builder(), value, native, "unsigned.widen\0".data());
	};

	return LLVMBuildSExt(this.backend->builder(), value, native, "signed.widen\0".data());
};

fn FunctionEmitter::logical(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	var SemanticExpression* left = expression->item(0);
	usize temporary_boundary = this.temporaries.size();
	var LLVMOpaqueValue* first = @this.truth(@this.value(left), left->type());

	if (!first) {
		return nullptr;
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(this.backend->builder());
	var LLVMOpaqueBasicBlock* right = @this.block("logical.right");
	var LLVMOpaqueBasicBlock* after = @this.block("logical.after");
	u64 immediate = 0;

	if (expression->operation() == token_kind::op_and) {
		discard LLVMBuildCondBr(this.backend->builder(), first, (var LLVMOpaqueBasicBlock*(right)), (var LLVMOpaqueBasicBlock*(after)));
	}
	else {
		@immediate = 1;
		discard LLVMBuildCondBr(this.backend->builder(), first, (var LLVMOpaqueBasicBlock*(after)), (var LLVMOpaqueBasicBlock*(right)));
	};

	LLVMPositionBuilderAtEnd(this.backend->builder(), right);
	var SemanticExpression* source = expression->item(1);
	var LLVMOpaqueValue* second = @this.truth(@this.value(source), source->type());

	if (!second) {
		return nullptr;
	};

	if (!(@this.cleanup_temporaries(temporary_boundary)).has<void>()) {
		return nullptr;
	};

	@this.forget_temporaries(temporary_boundary);
	var LLVMOpaqueBasicBlock* last = LLVMGetInsertBlock(this.backend->builder());
	discard LLVMBuildBr(this.backend->builder(), (var LLVMOpaqueBasicBlock*(after)));
	LLVMPositionBuilderAtEnd(this.backend->builder(), after);
	var LLVMOpaqueType* boolean = LLVMIntTypeInContext(this.backend->context(), 1);
	var LLVMOpaqueValue* phi = LLVMBuildPhi(this.backend->builder(), (var LLVMOpaqueType*(boolean)), "logical\0".data());
	var LLVMOpaqueValue*[2] values {};
	@values[0] = LLVMConstInt(boolean, $immediate, 0);
	@values[1] = second;
	var LLVMOpaqueBasicBlock*[2] blocks {};
	@blocks[0] = before;
	@blocks[1] = last;
	LLVMAddIncoming((var LLVMOpaqueValue*(phi)), &@values[0], &@blocks[0], 2);

	return phi;
};

fn FunctionEmitter::binary(var FunctionEmitter& this, var SemanticExpression* expression) -> var LLVMOpaqueValue* {
	token_kind operation = expression->operation();

	if (operation == token_kind::op_and || operation == token_kind::op_or) {
		return @this.logical(expression);
	};

	var SemanticExpression* left = expression->item(0);
	var SemanticExpression* right = expression->item(1);

	if (operation == token_kind::op_assign || operation == token_kind::op_copy) {
		var assigned = @this.assign(expression);

		return assigned.value;
	};

	var LLVMOpaqueValue* first = @this.value(left);
	var LLVMOpaqueValue* second = @this.value(right);

	if (!first || !second) {
		return nullptr;
	};
	bool condition = false;
	if (this.condition_fact(*expression, @condition)) {
		return LLVMConstInt(@this.backend->type(expression->type(), expression->token()), static_cast<u64>($condition), 0);
	};

	if ((operation == token_kind::op_plus || operation == token_kind::op_minus) && (left->type()->kind() == type_kind::pointer || right->type()->kind() == type_kind::pointer)) {
		if (left->type()->kind() == type_kind::pointer && right->type()->kind() == type_kind::pointer) {
			var LLVMOpaqueValue* difference = LLVMBuildPtrDiff2(this.backend->builder(), @this.backend->type(left->type()->element()), first, second, "pointer.difference\0".data());

			return LLVMBuildIntCast2(this.backend->builder(), difference, @this.backend->type(expression->type()), 1, "pointer.distance\0".data());
		};

		Type* pointer_type = left->type();
		Type* offset_type = right->type();

		if (right->type()->kind() == type_kind::pointer) {
			@pointer_type = right->type();
			@offset_type = left->type();
			var LLVMOpaqueValue* swap = first;
			@first = second;
			@second = swap;
		};

		if (pointer_type->element()->kind() == type_kind::void_type || pointer_type->element()->kind() == type_kind::null_type || pointer_type->element()->kind() == type_kind::function) {
			discard @this.backend->error(expression->token(), "pointer arithmetic requires an object element type");
			return nullptr;
		};

		bool signed_offset = offset_type->kind() != type_kind::unsigned_integer && offset_type->kind() != type_kind::boolean;
		@second = LLVMBuildIntCast2(this.backend->builder(), second, LLVMIntTypeInContext(this.backend->context(), this.backend->pointer_bits()), static_cast<i32>($signed_offset), "pointer.offset\0".data());

		if (operation == token_kind::op_minus) {
			@second = LLVMBuildNeg(this.backend->builder(), second, "pointer.backward\0".data());
		};

		var LLVMOpaqueType* native = @this.backend->type(pointer_type->element(), expression->token());
		if (!native) {
			return nullptr;
		};
		return LLVMBuildGEP2(this.backend->builder(), native, first, &@second, 1, "pointer.advance\0".data());
	};

	Type* operand_type = FunctionEmitter::representation(left->type());
	bool real = operand_type->kind() == type_kind::floating_point;
	bool unsigned_value = operand_type->kind() == type_kind::unsigned_integer || operand_type->kind() == type_kind::boolean || operand_type->kind() == type_kind::pointer;
	var LLVMOpaqueBuilder* builder = this.backend->builder();

	switch (operation) {
		case token_kind::op_plus:
			if (real) {
				return LLVMBuildFAdd(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildAdd(builder, first, second, "arithmetic\0".data());
		case token_kind::op_minus:
			if (real) {
				return LLVMBuildFSub(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildSub(builder, first, second, "arithmetic\0".data());
		case token_kind::op_star:
			if (real) {
				return LLVMBuildFMul(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildMul(builder, first, second, "arithmetic\0".data());
		case token_kind::op_slash:
			if (real) {
				return LLVMBuildFDiv(builder, first, second, "arithmetic\0".data());
			};

			if (unsigned_value) {
				return LLVMBuildUDiv(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildSDiv(builder, first, second, "arithmetic\0".data());
		case token_kind::op_remainder:
			if (real) {
				return LLVMBuildFRem(builder, first, second, "arithmetic\0".data());
			};

			if (unsigned_value) {
				return LLVMBuildURem(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildSRem(builder, first, second, "arithmetic\0".data());
		case token_kind::op_shift_right:
			if (unsigned_value) {
				return LLVMBuildLShr(builder, first, second, "arithmetic\0".data());
			};

			return LLVMBuildAShr(builder, first, second, "arithmetic\0".data());
		case token_kind::op_shift_left:
			return LLVMBuildShl(builder, first, second, "arithmetic\0".data());
		case token_kind::op_ampersand:
			return LLVMBuildAnd(builder, first, second, "arithmetic\0".data());
		case token_kind::op_pipe:
			return LLVMBuildOr(builder, first, second, "arithmetic\0".data());
		case token_kind::op_caret:
			return LLVMBuildXor(builder, first, second, "arithmetic\0".data());
	};

	i32 predicate = -1;

	switch (operation) {
		case token_kind::op_equal:
			@predicate = 32;

			if (real) {
				@predicate = 1;
			};

			break;
		case token_kind::op_not_equal:
			@predicate = 33;

			if (real) {
				@predicate = 14;
			};

			break;
		case token_kind::op_greater:
			@predicate = 34;

			if (real) {
				@predicate = 2;
			};

			break;
		case token_kind::op_greater_equal:
			@predicate = 35;

			if (real) {
				@predicate = 3;
			};

			break;
		case token_kind::op_less:
			@predicate = 36;

			if (real) {
				@predicate = 4;
			};

			break;
		case token_kind::op_less_equal:
			@predicate = 37;

			if (real) {
				@predicate = 5;
			};

			break;
	};

	if (predicate < 0) {
		discard @this.backend->error(expression->token(), "operator has no native lowering");
		return nullptr;
	};

	if (real) {
		return LLVMBuildFCmp(builder, $predicate, first, second, "compare\0".data());
	};

	if (!unsigned_value && predicate >= 34) {
		@predicate = predicate + 4;
	};

	return LLVMBuildICmp(builder, $predicate, first, second, "compare\0".data());
};

fn FunctionEmitter::representation(Type* type) -> Type* {
	while (type->kind() == type_kind::named && type->entity()->kind() == entity_kind::enumeration) {
		@type = type->entity()->underlying();
	};

	return type;
};

fn FunctionEmitter::assign(var FunctionEmitter& this, var SemanticExpression* expression) -> NativeAssignment {
	NativeAssignment result;
	var LLVMOpaqueValue* value = @this.value(expression->item(1));
	var LLVMOpaqueValue* address = @this.address(expression->item(0));

	if (!address || !value) {
		return $result;
	};

	discard LLVMBuildStore(this.backend->builder(), value, address);
	@result.value = value;
	@result.address = address;

	return $result;
};

struct ContextDisposer {
	fn dispose(var LLVMOpaqueContext* value);
};

