000d\u000a\u000d\u000a\u0009export fn string_view::contains(string_view& this, string_view other) -> bool {\u000d\u000a\u0009\u0009if (other.size() > this.length) {\u000d\u000a\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (usize index = 0; index <= this.length - other.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009if (this.slice(index, other.size()) == other) {\u000d\u000a\u0009\u0009\u0009\u0009return true;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return false;\u000d\u000a\u0009};\u000d\u000a\u0009export struct string {\u000d\u000a\u0009\u0009fn string(var string& this) : [default];\u000d\u000a\u0009\u0009fn string(var string& this, string& other);\u000d\u000a\u0009\u0009fn string(var string& this, string_view other);\u000d\u000a\u0009\u0009fn ~string(var string& this);\u000d\u000a\u000d\u000a\u0009\u0009fn operator:=(var string& this, string& other) -> var string&;\u000d\u000a\u0009\u0009fn operator+=(var string& this, string& other) -> var string& | allocation_error;\u000d\u000a\u0009\u0009fn operator+=(var string& this, string_view other) -> var string& | allocation_error;\u000d\u000a\u0009\u0009fn clear(var string& this);\u000d\u000a\u0009\u0009fn append(var string& this, string_view other) -> void | allocation_error;\u000d\u000a\u0009\u0009fn append(var string& this, string& other) -> void | allocation_error;\u000d\u000a\u0009\u0009fn reserve(var string& this, usize required) -> void | allocation_error;\u000d\u000a\u000d\u000a\u0009\u0009fn size(string& this) -> usize;\u000d\u000a\u0009\u0009fn capacity(string& this) -> usize;\u000d\u000a\u0009\u0009fn empty(string& this) -> bool;\u000d\u000a\u0009\u0009fn data(auto string& this) -> const[this] char*;\u000d\u000a\u0009\u0009fn c_str(auto string& this) -> const[this] char*;\u000d\u000a\u0009\u0009fn view(string& this) -> string_view;\u000d\u000a\u0009\u0009fn contains(string& this, string_view other) -> bool;\u000d\u000a\