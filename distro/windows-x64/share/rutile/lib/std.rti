{"format":1,"compiler":"0.0.128","pointer_bits":64,"module":"std","declarations":[{"path":"std\\buffer.rt","text":"namespace rt {\u000d\u000a\u0009export struct empty_buffer_error : [error] {\u000d\u000a\u0009\u0009fn description(empty_buffer_error& this) -> string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn empty_buffer_error::description(empty_buffer_error& this) -> string_view {\u000d\u000a\u0009\u0009return \"Cannot remove an element from an empty buffer.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct buffer {\u000d\u000a\u0009\u0009fn buffer(var buffer& this) : [default];\u000d\u000a\u0009\u0009fn buffer(var buffer& this, buffer& other);\u000d\u000a\u0009\u0009fn ~buffer(var buffer& this);\u000d\u000a\u000d\u000a\u0009\u0009fn operator=(var buffer& this, buffer& other) -> var buffer&;\u000d\u000a\u0009\u0009fn operator:=(var buffer& this, buffer& other) -> var buffer&;\u000d\u000a\u0009\u0009fn reserve(var buffer& this, usize required) -> void | allocation_error;\u000d\u000a\u0009\u0009fn push_back(var buffer& this, T value) -> void | allocation_error;\u000d\u000a\u0009\u0009fn pop_back(var buffer& this) -> void | empty_buffer_error;\u000d\u000a\u0009\u0009fn clear(var buffer& this);\u000d\u000a\u000d\u000a\u0009\u0009fn data(auto buffer& this) -> const[this] T*;\u000d\u000a\u0009\u0009fn size(buffer& this) -> usize;\u000d\u000a\u0009\u0009fn capacity(buffer& this) -> usize;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009fn copy_from(var buffer& this, buffer& other) -> void | allocation_error;\u000d\u000a\u000d\u000a\u0009\u0009var T* _storage;\u000d\u000a\u0009\u0009usize _size;\u000d\u000a\u0009\u0009usize _capacity;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::buffer(var buffer& this, buffer& other) {\u000d\u000a\u0009\u0009@this.copy_from(other);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::operator=(var buffer& this, buffer& other) -> var buffer& {\u000d\u000a\u0009\u0009buffer replacement;\u000d\u000a\u0009\u0009@replacement.copy_from(other);\u000d\u000a\u000d\u000a\u0009\u0009@this = $replacement;\u000d\u000a\u000d\u000a\u0009\u0009return @this;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::copy_from(var buffer& this, buffer& other) -> void | allocation_error {\u000d\u000a\u0009\u0009@this.reserve(other._size);\u000d\u000a\u000d\u000a\u0009\u0009for (; this._size < other._size; @this._size = this._size + 1) {\u000d\u000a\u0009\u0009\u0009@this._storage[this._size].T(other._storage[this._size]);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::operator:=(var buffer& this, buffer& other) -> var buffer& {\u000d\u000a\u0009\u0009return @this = other;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::~buffer(var buffer& this) {\u000d\u000a\u0009\u0009@this.clear();\u000d\u000a\u0009\u0009delete[] this._storage;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::reserve(var buffer& this, usize required) -> void | allocation_error {\u000d\u000a\u0009\u0009if (required <= this._capacity) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009const usize element_size = sizeof(T);\u000d\u000a\u0009\u0009usize maximum = usize::max;\u000d\u000a\u0009\u0009if (element_size) {\u000d\u000a\u0009\u0009\u0009@maximum = usize::max / element_size;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (required > maximum) {\u000d\u000a\u0009\u0009\u0009allocation_error error;\u000d\u000a\u0009\u0009\u0009@error.kind = allocation_kind::array;\u000d\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009usize count = grow_capacity(this._capacity, required, maximum, this._capacity);\u000d\u000a\u000d\u000a\u0009\u0009var T* replacement = new T[count]{};\u000d\u000a\u000d\u000a\u0009\u0009for (usize index = 0; index < this._size; @index = index + 1) {\u000d\u000a\u0009\u0009\u0009@replacement[index].T($(this._storage[index]));\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009delete[] this._storage;\u000d\u000a\u0009\u0009@this._storage = $replacement;\u000d\u000a\u0009\u0009@this._capacity = $count;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::push_back(var buffer& this, T value) -> void | allocation_error {\u000d\u000a\u0009\u0009if (this._size == usize::max) {\u000d\u000a\u0009\u0009\u0009allocation_error error;\u000d\u000a\u0009\u0009\u0009@error.kind = allocation_kind::array;\u000d\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this.reserve(this._size + 1);\u000d\u000a\u000d\u000a\u0009\u0009@this._storage[this._size].T($value);\u000d\u000a\u0009\u0009@this._size = this._size + 1;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::pop_back(var buffer& this) -> void | empty_buffer_error {\u000d\u000a\u0009\u0009if (!this._size) {\u000d\u000a\u0009\u0009\u0009return empty_buffer_error();\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this._size = this._size - 1;\u000d\u000a\u0009\u0009@this._storage[this._size].~T();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::clear(var buffer& this) {\u000d\u000a\u0009\u0009for (usize index = 0; index < this._size; @index = index + 1) {\u000d\u000a\u0009\u0009\u0009@this._storage[index].~T();\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this._size = 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::size(buffer& this) -> usize {\u000d\u000a\u0009\u0009return this._size;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::capacity(buffer& this) -> usize {\u000d\u000a\u0009\u0009return this._capacity;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn buffer<T>::data(auto buffer& this) -> const[this] T* {\u000d\u000a\u0009\u0009return this._storage;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct span {\u000d\u000a\u0009\u0009fn span(var span& this, T* data, usize size);\u000d\u000a\u0009\u0009fn data(span& this) -> T*;\u000d\u000a\u0009\u0009fn size(span& this) -> usize;\u000d\u000a\u0009\u0009fn empty(span& this) -> bool;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009T* elements;\u000d\u000a\u0009\u0009usize count;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn span<T>::span(var span<T>& this, T* data, usize size) {\u000d\u000a\u0009\u0009@this.elements = $data;\u000d\u000a\u0009\u0009@this.count = $size;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn span<T>::data(span<T>& this) -> T* {\u000d\u000a\u0009\u0009return this.elements;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn span<T>::size(span<T>& this) -> usize {\u000d\u000a\u0009\u0009return this.count;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn span<T>::empty(span<T>& this) -> bool {\u000d\u000a\u0009\u0009return !this.count;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\equal.rt","text":"namespace rt {\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export struct default_equal {\u000d\u000a\u0009\u0009fn equal(default_equal& this, K& first, K& second) -> bool;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export fn default_equal<K>::equal(default_equal& this, K& first, K& second) -> bool {\u000d\u000a\u0009\u0009return first == second;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\filesystem.rt","text":"fn rutile_file_read(char* path, usize path_size, var void* result);\u000d\u000afn rutile_file_write(char* path, usize path_size, char* bytes, usize size, var void* result);\u000d\u000afn rutile_create_directories(char* path, usize path_size, var void* result);\u000d\u000afn rutile_temporary_directory(var void* result);\u000d\u000afn getenv(char* name) -> char*;\u000d\u000a\u000d\u000anamespace rt::fs {\u000d\u000a\u0009export struct file_not_found_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(file_not_found_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn file_not_found_error::description(file_not_found_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The requested file was not found.\";\u000d\u000a\u0009};\u000d\u000a\u0009export struct permission_denied_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(permission_denied_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn permission_denied_error::description(permission_denied_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"Permission to access the file was denied.\";\u000d\u000a\u0009};\u000d\u000a\u0009export struct file_io_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(file_io_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn file_io_error::description(file_io_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The file operation failed.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009using TextResult = rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000d\u000a\u0009using OperationResult = void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_text_complete(var void* storage, char* bytes, usize size) {\u000d\u000a\u0009\u0009var TextResult& result = @*reinterpret_cast<var TextResult*>(storage);\u000d\u000a\u0009\u0009rt::string text;\u000d\u000a\u0009\u0009var copied = @text.append(rt::string_view(bytes, size));\u000d\u000a\u0009\u0009if (copied.has<rt::allocation_error>()) {\u000d\u000a\u0009\u0009\u0009@result = copied.get<rt::allocation_error>();\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@result = $text;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_text_not_found(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var TextResult*>(storage) = file_not_found_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_text_permission_denied(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var TextResult*>(storage) = permission_denied_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_text_io_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var TextResult*>(storage) = file_io_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_text_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var TextResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_operation_complete(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var OperationResult*>(storage) = OperationResult();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_operation_not_found(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var OperationResult*>(storage) = file_not_found_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_operation_permission_denied(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var OperationResult*>(storage) = permission_denied_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_operation_io_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var OperationResult*>(storage) = file_io_error();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_fs_operation_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var OperationResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn read(rt::string_view path) -> rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000d\u000a\u0009\u0009rt::string terminated;\u000d\u000a\u0009\u0009@terminated.append(path);\u000d\u000a\u0009\u0009TextResult result;\u000d\u000a\u0009\u0009rutile_file_read(terminated.c_str(), path.size(), &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn write(rt::string_view path, rt::string_view contents) -> void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000d\u000a\u0009\u0009rt::string terminated;\u000d\u000a\u0009\u0009@terminated.append(path);\u000d\u000a\u0009\u0009OperationResult result;\u000d\u000a\u0009\u0009rutile_file_write(terminated.c_str(), path.size(), contents.data(), contents.size(), &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn create_directories(rt::string_view path) -> void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000d\u000a\u0009\u0009rt::string terminated;\u000d\u000a\u0009\u0009@terminated.append(path);\u000d\u000a\u0009\u0009OperationResult result;\u000d\u000a\u0009\u0009rutile_create_directories(terminated.c_str(), path.size(), &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn temporary_directory() -> rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000d\u000a\u0009\u0009TextResult result;\u000d\u000a\u0009\u0009rutile_temporary_directory(&@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a\u000d\u000anamespace rt {\u000d\u000a\u0009export fn environment(rt::string_view name) -> string | allocation_error {\u000d\u000a\u0009\u0009string terminated;\u000d\u000a\u0009\u0009@terminated.append(name);\u000d\u000a\u0009\u0009string value;\u000d\u000a\u0009\u0009@value.append(from_c_string(getenv(terminated.c_str())));\u000d\u000a\u0009\u0009return $value;\u000d\u000a\u0009};\u000d\u000a};","module":"std"},{"path":"std\\hash.rt","text":"namespace rt {\u000d\u000a\u0009const u64 splitmix64_first_multiplier = 13787848793156543929;\u000d\u000a\u0009const u64 splitmix64_second_multiplier = 10723151780598845931;\u000d\u000a\u0009const u64 splitmix64_first_shift = 30;\u000d\u000a\u0009const u64 splitmix64_second_shift = 27;\u000d\u000a\u0009const u64 splitmix64_final_shift = 31;\u000d\u000a\u0009const u64 fnv1a64_offset_basis = 14695981039346656037;\u000d\u000a\u0009const u64 fnv1a64_prime = 1099511628211;\u000d\u000a\u000d\u000a\u0009export fn mix_hash(u64 value) -> usize {\u000d\u000a\u0009\u0009@value = (value ^ (value >> splitmix64_first_shift)) * splitmix64_first_multiplier;\u000d\u000a\u0009\u0009@value = (value ^ (value >> splitmix64_second_shift)) * splitmix64_second_multiplier;\u000d\u000a\u000d\u000a\u0009\u0009return static_cast<usize>(value ^ (value >> splitmix64_final_shift));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(f32 value, f32* type_token) -> usize {\u000d\u000a\u0009\u0009if (value == 0.0) {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(*reinterpret_cast<u32*>(&@value)));\u000d\u000a\u0009};\u000d\u000a\u0009\u000d\u000a\u0009export fn hash_value(f64 value, f64* type_token) -> usize {\u000d\u000a\u0009\u0009if (value == 0.0) {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return mix_hash(*reinterpret_cast<u64*>(&@value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(string_view value, string_view* type_token) -> usize {\u000d\u000a\u0009\u0009u64 result := fnv1a64_offset_basis;\u000d\u000a\u0009\u0009for (usize index = 0; index < value.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009char byte = value.data()[index];\u000d\u000a\u000d\u000a\u0009\u0009\u0009@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * fnv1a64_prime;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return static_cast<usize>(result);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(string_view value, string* type_token) -> usize {\u000d\u000a\u0009\u0009return hash_value(value, &value);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009// Default pointer hashing accepts object pointers through const void*.\u000d\u000a\u0009// Function pointers require an explicit compatible hash policy.\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export struct default_hash {\u000d\u000a\u0009\u0009fn hash(default_hash& this, K& value) -> usize;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(bool value, bool* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(char value, char* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(i08 value, i08* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(i16 value, i16* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(i32 value, i32* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(i64 value, i64* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(u08 value, u08* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(u16 value, u16* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(u32 value, u32* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(u64 value, u64* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn hash_value(void* value, void* type_token) -> usize {\u000d\u000a\u0009\u0009return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export fn default_hash<K>::hash(default_hash& this, K& value) -> usize {\u000d\u000a\u0009\u0009// The type token prevents conversions from selecting another primitive hash.\u000d\u000a\u0009\u0009return hash_value(value, &value);\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\identifier.rt","text":"\u000d\u000a\u000d\u000atemplate<typename Tag, typename vnum, typename gnum>\u000d\u000astruct identifier {\u000d\u000a\u0009export fn identifier(var identifier& this) : [default];\u000d\u000a\u0009\u000d\u000a\u000d\u000a\u0009vnum value;\u000d\u000a\u0009gnum generation;\u000d\u000a};\u000d\u000a\u000d\u000a\u000d\u000a","module":"std"},{"path":"std\\json.rt","text":"namespace rt {\u000d\u000a\u0009export struct json_error : [error] {\u000d\u000a\u0009\u0009fn description(json_error& this) -> string_view : [override];\u000d\u000a\u0009\u0009fn json_error(var json_error& this) : [default];\u000d\u000a\u0009\u0009fn json_error(var json_error& this, string_view message, usize offset);\u000d\u000a\u0009\u0009string message;\u000d\u000a\u0009\u0009usize offset;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_error::description(json_error& this) -> string_view {\u000d\u000a\u0009\u0009return this.message.view();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export using json_result = void | json_error | allocation_error;\u000d\u000a\u000d\u000a\u0009export enum json_kind : [u08] {\u000d\u000a\u0009\u0009null_value;\u000d\u000a\u0009\u0009boolean;\u000d\u000a\u0009\u0009number;\u000d\u000a\u0009\u0009string;\u000d\u000a\u0009\u0009array;\u000d\u000a\u0009\u0009object;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct json_member {\u000d\u000a\u0009\u0009fn json_member(var json_member& this, string key, unique<json_value> value);\u000d\u000a\u0009\u0009fn json_member(var json_member& this, json_member& other) : [delete];\u000d\u000a\u000d\u000a\u0009\u0009string key;\u000d\u000a\u0009\u0009unique<json_value> value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export using json_array = buffer<unique<json_value>>;\u000d\u000a\u0009export using json_object = buffer<json_member>;\u000d\u000a\u000d\u000a\u0009export union json_payload {\u000d\u000a\u0009\u0009fn json_payload(var json_payload& this) : [default];\u000d\u000a\u0009\u0009fn ~json_payload(var json_payload& this) : [default];\u000d\u000a\u000d\u000a\u0009\u0009u08 empty;\u000d\u000a\u0009\u0009bool boolean;\u000d\u000a\u0009\u0009string text;\u000d\u000a\u0009\u0009json_array array;\u000d\u000a\u0009\u0009json_object object;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009// Text is UTF-8. Object keys are unique; set and parsing retain the last duplicate value.\u000d\u000a\u0009// Number spelling is retained without conversion to binary floating point.\u000d\u000a\u0009export struct json_value {\u000d\u000a\u0009\u0009fn json_value(var json_value& this) : [default];\u000d\u000a\u0009\u0009fn json_value(var json_value& this, json_value& other) : [delete];\u000d\u000a\u0009\u0009fn ~json_value(var json_value& this);\u000d\u000a\u000d\u000a\u0009\u0009fn make_null() -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_boolean(bool value) -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_number(string_view value) -> unique<json_value> | json_error;\u000d\u000a\u0009\u0009fn make_integer(i64 value) -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_unsigned(u64 value) -> unique<json_value>;\u000d\u000a\u0009\u0009fn clone(json_value& this) -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_string(string_view value) -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_array() -> unique<json_value>;\u000d\u000a\u0009\u0009fn make_object() -> unique<json_value>;\u000d\u000a\u0009\u0009fn append(var json_value& this, unique<json_value> value) -> json_result;\u000d\u000a\u0009\u0009fn set(var json_value& this, string_view key, unique<json_value> value) -> json_result;\u000d\u000a\u000d\u000a\u0009\u0009fn kind(json_value& this) -> json_kind;\u000d\u000a\u0009\u0009fn text(json_value& this) -> string_view;\u000d\u000a\u0009\u0009fn boolean(json_value& this) -> bool;\u000d\u000a\u0009\u0009fn integer(json_value& this) -> i64 | json_error;\u000d\u000a\u0009\u0009fn member(json_value& this, string_view key) -> json_value*;\u000d\u000a\u0009\u0009fn item(json_value& this, usize index) -> json_value*;\u000d\u000a\u0009\u0009fn key(json_value& this, usize index) -> string_view;\u000d\u000a\u0009\u0009fn size(json_value& this) -> usize;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009json_kind tag;\u000d\u000a\u0009\u0009json_payload payload;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export using json_document = unique<json_value> | json_error | allocation_error;\u000d\u000a\u000d\u000a\u0009export struct json_parser {\u000d\u000a\u0009\u0009fn json_parser(var json_parser& this, string_view text);\u000d\u000a\u0009\u0009fn parse(var json_parser& this) -> json_document;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009string_view input;\u000d\u000a\u0009\u0009usize cursor;\u000d\u000a\u0009\u0009usize failure_offset;\u000d\u000a\u0009\u0009string failure;\u000d\u000a\u000d\u000a\u0009\u0009fn whitespace(var json_parser& this);\u000d\u000a\u0009\u0009fn fail(var json_parser& this, string_view message);\u000d\u000a\u0009\u0009fn hex_quad(var json_parser& this, var u32& value) -> json_result;\u000d\u000a\u0009\u0009fn string_value(var json_parser& this, var string& result) -> json_result;\u000d\u000a\u0009\u0009fn value(var json_parser& this, usize depth) -> unique<json_value>;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_member::json_member(var json_member& this, string key, unique<json_value> value) {\u000d\u000a\u0009\u0009@this.key = $key;\u000d\u000a\u0009\u0009@this.value = $value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_value::~json_value(var json_value& this) {\u000d\u000a\u0009\u0009if (this.tag == json_kind::number || this.tag == json_kind::string) {\u000d\u000a\u0009\u0009\u0009@this.payload.text.~string();\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else if (this.tag == json_kind::array) {\u000d\u000a\u0009\u0009\u0009@this.payload.array.~json_array();\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else if (this.tag == json_kind::object) {\u000d\u000a\u0009\u0009\u0009@this.payload.object.~json_object();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_number_end(string_view input, usize begin) -> usize {\u000d\u000a\u0009\u0009usize cursor = begin;\u000d\u000a\u0009\u0009if (cursor < input.size() && input.data()[cursor] == '-') {\u000d\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (cursor >= input.size()) {\u000d\u000a\u0009\u0009\u0009return begin;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (input.data()[cursor] == '0') {\u000d\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009if (input.data()[cursor] < '1' || input.data()[cursor] > '9') {\u000d\u000a\u0009\u0009\u0009\u0009return begin;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000d\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (cursor < input.size() && input.data()[cursor] == '.') {\u000d\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009usize digits = cursor;\u000d\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000d\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009if (cursor == digits) {\u000d\u000a\u0009\u0009\u0009\u0009return begin;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (cursor < input.size() && (input.data()[cursor] == 'e' || input.data()[cursor] == 'E')) {\u000d\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009if (cursor < input.size() && (input.data()[cursor] == '+' || input.data()[cursor] == '-')) {\u000d\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009usize digits = cursor;\u000d\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000d\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009if (cursor == digits) {\u000d\u000a\u0009\u0009\u0009\u0009return begin;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return cursor;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_utf8_width(string_view text, usize offset) -> usize {\u000d\u000a\u0009\u0009if (offset >= text.size()) {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009u08 first = static_cast<u08>(text.data()[offset]);\u000d\u000a\u0009\u0009if (first < 128) {\u000d\u000a\u0009\u0009\u0009return 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009usize width = 0;\u000d\u000a\u0009\u0009u32 code = 0;\u000d\u000a\u0009\u0009u32 minimum = 0;\u000d\u000a\u0009\u0009if (first >= 194 && first <= 223) {\u000d\u000a\u0009\u0009\u0009@width = 2;\u000d\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 31);\u000d\u000a\u0009\u0009\u0009@minimum = 128;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else if (first >= 224 && first <= 239) {\u000d\u000a\u0009\u0009\u0009@width = 3;\u000d\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 15);\u000d\u000a\u0009\u0009\u0009@minimum = 2048;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else if (first >= 240 && first <= 244) {\u000d\u000a\u0009\u0009\u0009@width = 4;\u000d\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 7);\u000d\u000a\u0009\u0009\u0009@minimum = 65536;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (width > text.size() - offset) {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (usize index = 1; index < width; @index = index + 1) {\u000d\u000a\u0009\u0009\u0009u08 byte = static_cast<u08>(text.data()[offset + index]);\u000d\u000a\u0009\u0009\u0009if ((byte & 192) != 128) {\u000d\u000a\u0009\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009@code = (code << 6) | static_cast<u32>(byte & 63);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (code < minimum || code > 1114111 || (code >= 55296 && code <= 57343)) {\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return width;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_valid_utf8(string_view text) -> bool {\u000d\u000a\u0009\u0009usize offset = 0;\u000d\u000a\u0009\u0009while (offset < text.size()) {\u000d\u000a\u0009\u0009\u0009usize width = json_utf8_width(text, offset);\u000d\u000a\u0009\u0009\u0009if (!width) {\u000d\u000a\u0009\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009@offset = offset + width;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return true;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_value::make_null() -> unique<json_value> {\u000d\u000a\u0009\u0009return unique<json_value>::make();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_value::make_boolean(bool value) -> unique<json_value> {\u000d\u000a\u0009\u0009var result = make_null();\u000d\u000a\u0009\u0009if (result.get()) {\u000d\u000a\u0009\u0009\u0009@result.get()->tag = json_kind::boolean;\u000d\u000a\u0009\u0009\u0009@result.get()->payload.boolean = $value;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_value::make_number(string_view value) -> unique<json_value> | json_error {\u000d\u000a\u00