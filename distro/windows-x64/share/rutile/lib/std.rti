tring_view lhs, string& rhs) -> string | allocation_error {\u000d\u000a\u0009\u0009return concatenate(lhs, rhs);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string::reserve(var string& this, usize required) -> void | allocation_error {\u000d\u000a\u0009\u0009if (required <= this.capacity()) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009if (required > usize::max - 1) {\u000d\u000a\u0009\u0009\u0009allocation_error error;\u000d\u000a\u0009\u0009\u0009@error.requested_bytes = required;\u000d\u000a\u0009\u0009\u0009@error.kind = allocation_kind::array;\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009usize capacity = this.capacity();\u000d\u000a\u0009\u0009usize count = grow_capacity(capacity, required, usize::max - 1, capacity >> 1);\u000d\u000a\u000d\u000a\u0009\u0009var char* replacement = new char[count + 1]{};\u000d\u000a\u000d\u000a\u0009\u0009@replacement = static_cast<var char*>(memcpy(replacement, this.data(), this._size + 1));\u000d\u000a\u0009\u0009if (this._capacity > 15) {\u000d\u000a\u0009\u0009\u0009delete[] this.storage.heap;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this.storage.heap = $replacement;\u000d\u000a\u0009\u0009@this._capacity = $count;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string::append(var string& this, string_view other) -> void | allocation_error {\u000d\u000a\u0009\u0009@this.append_data(other.data(), other.size());\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string::append(var string& this, string& other) -> void | allocation_error {\u000d\u000a\u0009\u0009@this.append_data(other.data(), other.size());\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009fn string::append_data(var string& this, char* other, usize count) -> void | allocation_error {\u000d\u000a\u0009\u0009if (!count) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u00