 json_write_string(string_view value, var string& output) -> json_result {\u000a\u0009\u0009if (!json_valid_utf8(value)) {\u000a\u0009\u0009\u0009json_error error;\u000a\u0009\u0009\u0009@error.message = string(\"JSON strings require valid UTF-8.\");\u000a\u0009\u0009\u0009return json_result($error);\u000a\u0009\u0009};\u000a\u0009\u0009try {\u000a\u0009\u0009\u0009@output.append(\"\\\"\");\u000a\u0009\u0009\u0009var digits = \"0123456789abcdef\";\u000a\u0009\u0009\u0009for (usize index = 0; index < value.size(); @index = index + 1) {\u000a\u0009\u0009\u0009\u0009u08 byte = static_cast<u08>(value.data()[index]);\u000a\u0009\u0009\u0009\u0009if (byte == 34 || byte == 92) {\u000a\u0009\u0009\u0009\u0009\u0009@output.append(\"\\\\\");\u000a\u0009\u0009\u0009\u0009\u0009@output.append(value.slice(index, 1));\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009else if (byte < 32) {\u000a\u0009\u0009\u0009\u0009\u0009char[2] hex;\u000a\u0009\u0009\u0009\u0009\u0009@hex[0] := digits.data()[byte >> 4];\u000a\u0009\u0009\u0009\u0009\u0009@hex[1] := digits.data()[byte & 15];\u000a\u0009\u0009\u0009\u0009\u0009@output.append(\"\\\\u00\");\u000a\u0009\u0009\u0009\u0009\u0009@output.append(string_view(&@hex[0], 2));\u000a\u0009\u0009\u0009\u0009}\u000a\u0009\u0009\u0009\u0009else {\u000a\u0009\u0009\u0009\u0009\u0009@output.append(value.slice(index, 1));\u000a\u0009\u0009\u0009\u0009};\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009@output.append(\"\\\"\");\u000a\u0009\u0009\u0009return json_result();\u000a\u0009\u0009}\u000a\u0009\u0009catch (allocation_error error) {\u000a\u0009\u0009\u0009return json_result($error);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn json_write_value(json_value& value, var string& output, usize depth) -> json_result {\u000a\u0009\u0009if (depth > 128) {\u000a\u0009\u0009\u0009json_error error;\u000a\u0009\u0009\u0009@error.message = string(\"JSON nesting exceeds the supported depth.\");\u000a\u0009\u0009\u0009return json_re