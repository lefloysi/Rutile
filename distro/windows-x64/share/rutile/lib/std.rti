eplacement.copy_from(other);\u000a\u0009\u0009if (copied.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(copied.get<allocation_error>());\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this = $replacement;\u000a\u000a\u0009\u0009return @this;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::copy_from(var buffer& this, buffer& other) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009var reserved = @this.reserve(other._size);\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009return $reserved;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009while (this._size < other._size) {\u000a\u0009\u0009\u0009@this._storage[this._size].T(other._storage[this._size]);\u000a\u0009\u0009\u0009@this._size = this._size + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::operator:=(var buffer& this, buffer& other) -> var buffer& {\u000a\u0009\u0009return @this = other;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::~buffer(var buffer& this) {\u000a\u0009\u0009@this.clear();\u000a\u0009\u0009free(this._storage);\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::reserve(var buffer& this, usize required) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009if (required <= this._capacity) {\u000a\u0009\u0009\u0009return Result();\u000a\u0009\u0009};\u000a\u000a\u0009\u0009const usize element_size = sizeof(T);\u000a\u0009\u0009if (element_size && required > usize::max / element_size) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize count = $required;\u000a\u0009\u0009if (this._capacity <= (usize::max >> 1)) {\u000a\u0009\u0009\u0009const usize grown = this._capacity << 1;\u000a\u0009\u0009\u0009if (grown > count && (!element_size || grown <= usize::max / element_size)) {\u000a\u0009\u0009\u0009\u0009@count = grown;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize bytes = count * element_size;\u000a\u0009\u0009if (!bytes) {\u000a\u0009\u0009\u0009@bytes = 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009var T* replacement = static_cast<var T*>(malloc(bytes));\u000a\u0009\u0009if (!replacement) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = bytes;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize index = 0;\u000a\u0009\u0009while (index < this._size) {\u000a\u0009\u0009\u0009@replacement[index].T($(this._storage[index]));\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009free(this._storage);\u000a\u0009\u0009@this._storage = $replacement;\u000a\u0009\u0009@this._capacity = $count;\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::push_back(var buffer& this, T value) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009if (this._size == usize::max) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009var reserved = @this.reserve(this._size + 1);\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009return $reserved;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this._storage[this._size].T($value);\u000a\u0009\u0009@this._size = this._size + 1;\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::pop_back(var buffer& this) -> void | empty_buffer_error {\u000a\u0009\u0009using Result = void | empty_buffer_error;\u000a\u0009\u0009if (!this._size) {\u000a\u0009\u0009\u0009return Result(empty_buffer_error());\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this._size = this._size - 1;\u000a\u0009\u0009@this._storage[this._size].~T();\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::clear(var buffer& this) {\u000a\u0009\u0009for (usize index = 0; index < this._size; @index = index + 1) {\u000a\u0009\u0009\u0009@this._storage[index].~T();\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this._size = 0;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::size(buffer& this) -> usize {\u000a\u0009\u0009return this._size;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::capacity(buffer& this) -> usize {\u000a\u0009\u0009return this._capacity;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn buffer<T>::data(auto buffer& this) -> const[this] T* {\u000a\u0009\u0009return this._storage;\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/equal.rt","text":"namespace rt {\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export struct default_equal {\u000d\u000a\u0009\u0009fn equal(default_equal& this, K& first, K& second) -> bool;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename K>\u000d\u000a\u0009export fn default_equal<K>::equal(default_equal& this, K& first, K& second) -> bool {\u000d\u000a\u0009\u0009return first == second;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/filesystem.rt","text":"enum native_file_error_kind : [i32] {\u000a\u0009success;\u000a\u0009not_found;\u000a\u0009permission_denied;\u000a\u0009io;\u000a\u0009allocation;\u000a};\u000a\u000astruct NativeFileResult {\u000a\u0009var char* data;\u000a\u0009usize size;\u000a\u0009native_file_error_kind error_kind;\u000a\u0009i32 native_code;\u000a};\u000afn rutile_file_read(char* path, usize path_size, var NativeFileResult* result);\u000afn rutile_file_write(char* path, usize path_size, char* bytes, usize size, var NativeFileResult* result);\u000afn rutile_create_directories(char* path, usize path_size, var NativeFileResult* result);\u000afn rutile_temporary_directory(var NativeFileResult* result);\u000afn rutile_environment(char* name, var NativeFileResult* result);\u000afn free(void* memory);\u000a\u000anamespace rt::fs {\u000a\u0009export struct file_not_found_error {\u000a\u0009\u0009i32 native_code;\u000a\u0009};\u000a\u000a\u0009export struct permission_denied_error {\u000a\u0009\u0009i32 native_code;\u000a\u0009};\u000a\u000a\u0009export struct file_io_error {\u000a\u0009\u0009i32 native_code;\u000a\u0009};\u000a\u000a\u0009template<typename Result>\u000a\u0009fn failure(NativeFileResult& native) -> Result {\u000a\u0009\u0009if (native.error_kind == native_file_error_kind::not_found) {\u000a\u0009\u0009\u0009file_not_found_error error;\u000a\u0009\u0009\u0009@error.native_code = native.native_code;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (native.error_kind == native_file_error_kind::permission_denied) {\u000a\u0009\u0009\u0009permission_denied_error error;\u000a\u0009\u0009\u0009@error.native_code = native.native_code;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (native.error_kind == native_file_error_kind::allocation) {\u000a\u0009\u0009\u0009rt::allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = native.size;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009file_io_error error;\u000a\u0009\u0009@error.native_code = native.native_code;\u000a\u0009\u0009return Result($error);\u000a\u0009};\u000a\u000a\u0009export fn read(rt::string_view path) -> rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000a\u0009\u0009using Result = rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000a\u0009\u0009rt::string terminated;\u000a\u0009\u0009var terminated_path = @terminated.append(path);\u000a\u0009\u0009if (terminated_path.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Result(terminated_path.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009NativeFileResult native;\u000a\u0009\u0009rutile_file_read(terminated.c_str(), path.size(), &@native);\u000a\u0009\u0009if (native.error_kind) {\u000a\u0009\u0009\u0009return failure<Result>(native);\u000a\u0009\u0009};\u000a\u0009\u0009rt::string contents;\u000a\u0009\u0009var copied_contents = @contents.append(rt::string_view(native.data, native.size));\u000a\u0009\u0009if (copied_contents.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009free(native.data);\u000a\u0009\u0009\u0009return Result(copied_contents.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009free(native.data);\u000a\u0009\u0009return Result($contents);\u000a\u0009};\u000a\u000a\u0009export fn write(rt::string_view path, rt::string_view contents) -> void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000a\u0009\u0009using Result = void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000a\u0009\u0009rt::string terminated;\u000a\u0009\u0009var terminated_path = @terminated.append(path);\u000a\u0009\u0009if (terminated_path.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Result(terminated_path.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009NativeFileResult native;\u000a\u0009\u0009rutile_file_write(terminated.c_str(), path.size(), contents.data(), contents.size(), &@native);\u000a\u0009\u0009if (native.error_kind) {\u000a\u0009\u0009\u0009return failure<Result>(native);\u000a\u0009\u0009};\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009export fn create_directories(rt::string_view path) -> void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000a\u0009\u0009using Result = void | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000a\u0009\u0009rt::string terminated;\u000a\u0009\u0009var terminated_path = @terminated.append(path);\u000a\u0009\u0009if (terminated_path.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Result(terminated_path.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009NativeFileResult native;\u000a\u0009\u0009rutile_create_directories(terminated.c_str(), path.size(), &@native);\u000a\u0009\u0009if (native.error_kind) {\u000a\u0009\u0009\u0009return failure<Result>(native);\u000a\u0009\u0009};\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009export fn temporary_directory() -> rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error {\u000a\u0009\u0009using Result = rt::string | file_not_found_error | permission_denied_error | file_io_error | rt::allocation_error;\u000a\u0009\u0009NativeFileResult native;\u000a\u0009\u0009rutile_temporary_directory(&@native);\u000a\u0009\u0009if (native.error_kind) {\u000a\u0009\u0009\u0009return failure<Result>(native);\u000a\u0009\u0009};\u000a\u0009\u0009rt::string contents;\u000a\u0009\u0009var copied_contents = @contents.append(rt::string_view(native.data, native.size));\u000a\u0009\u0009if (copied_contents.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009free(native.data);\u000a\u0009\u0009\u0009return Result(copied_contents.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009free(native.data);\u000a\u0009\u0009return Result($contents);\u000a\u0009};\u000a};\u000a\u000anamespace rt {\u000a\u0009export fn environment(rt::string_view name) -> rt::string {\u000a\u0009\u0009var terminated = rt::string(name);\u000a\u0009\u0009NativeFileResult native;\u000a\u0009\u0009rutile_environment(terminated.c_str(), &@native);\u000a\u0009\u0009if (native.error_kind == native_file_error_kind::allocation) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = native.size;\u000a\u0009\u0009\u0009throw $error;\u000a\u0009\u0009};\u000a\u0009\u0009string result;\u000a\u0009\u0009var copied = @result.append(string_view(native.data, native.size));\u000a\u0009\u0009free(native.data);\u000a\u0009\u0009if (copied.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(copied.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009return $result;\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/hash.rt","text":"namespace rt {\u000a\u0009const u64 splitmix64_first_multiplier = 13787848793156543929;\u000a\u0009const u64 splitmix64_second_multiplier = 10723151780598845931;\u000a\u0009const u64 splitmix64_first_shift = 30;\u000a\u0009const u64 splitmix64_second_shift = 27;\u000a\u0009const u64 splitmix64_final_shift = 31;\u000a\u0009const u64 fnv1a64_offset_basis = 14695981039346656037;\u000a\u0009const u64 fnv1a64_prime = 1099511628211;\u000a\u000a\u0009export fn mix_hash(u64 value) -> usize {\u000a\u0009\u0009@value = (value ^ (value >> splitmix64_first_shift)) * splitmix64_first_multiplier;\u000a\u0009\u0009@value = (value ^ (value >> splitmix64_second_shift)) * splitmix64_second_multiplier;\u000a\u000a\u0009\u0009return static_cast<usize>(value ^ (value >> splitmix64_final_shift));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(f32 value, f32* type_token) -> usize {\u000a\u0009\u0009if (value == 0.0) {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return mix_hash(static_cast<u64>(*reinterpret_cast<u32*>(&@value)));\u000a\u0009};\u000a\u0009\u000a\u0009export fn hash_value(f64 value, f64* type_token) -> usize {\u000a\u0009\u0009if (value == 0.0) {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return mix_hash(*reinterpret_cast<u64*>(&@value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(string_view value, string_view* type_token) -> usize {\u000a\u0009\u0009u64 result := fnv1a64_offset_basis;\u000a\u0009\u0009usize index = 0;\u000a\u0009\u0009while (index < value.size()) {\u000a\u0009\u0009\u0009char byte = value.data()[index];\u000a\u000a\u0009\u0009\u0009@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * fnv1a64_prime;\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return static_cast<usize>(result);\u000a\u0009};\u000a\u000a\u0009export fn hash_value(string_view value, string* type_token) -> usize {\u000a\u0009\u0009return hash_value(value, &value);\u000a\u0009};\u000a\u000a\u0009// Default pointer hashing accepts object pointers through const void*.\u000a\u0009// Function pointers require an explicit compatible hash policy.\u000a\u0009template<typename K>\u000a\u0009export struct default_hash {\u000a\u0009\u0009fn hash(default_hash& this, K& value) -> usize;\u000a\u0009};\u000a\u000a\u0009export fn hash_value(bool value, bool* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(char value, char* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(i08 value, i08* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(i16 value, i16* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(i32 value, i32* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(i64 value, i64* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(u08 value, u08* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(u16 value, u16* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(u32 value, u32* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(u64 value, u64* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(value));\u000a\u0009};\u000a\u000a\u0009export fn hash_value(void* value, void* type_token) -> usize {\u000a\u0009\u0009return mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));\u000a\u0009};\u000a\u000a\u0009template<typename K>\u000a\u0009export fn default_hash<K>::hash(default_hash& this, K& value) -> usize {\u000a\u0009\u0009// The type token prevents conversions from selecting another primitive hash.\u000a\u0009\u0009return hash_value(value, &value);\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/identifier.rt","text":"\u000d\u000a\u000d\u000atemplate<typename Tag, typename vnum, typename gnum>\u000d\u000astruct identifier {\u000d\u000a\u0009export fn identifier(var identifier& this) : [default];\u000d\u000a\u0009\u000d\u000a\u000d\u000a\u0009vnum value;\u000d\u000a\u0009gnum generation;\u000d\u000a};\u000d\u000a\u000d\u000a\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/json.rt","text":"namespace rt {\u000a\u0009export struct json_error {\u000a\u0009\u0009fn json_error(var json_error& this) : [default];\u000a\u0009\u0009fn json_error(var json_error& this, string_view message, usize offset);\u000a\u0009\u0009string message;\u000a\u0009\u0009usize offset;\u000a\u0009};\u000a\u000a\u0009export using json_result = void | json_error | allocation_error;\u000a\u000a\u0009export enum json_kind : [u08] {\u000a\u0009\u0009null_value;\u000a\u0009\u0009boolean;\u000a\u0009\u0009number;\u000a\u0009\u0009string;\u000a\u0009\u0009array;\u000a\u0009\u0009object;\u000a\u0009};\u000a\u000a\u0009export struct json_member {\u000a\u0009\u0009fn json_member(var json_member& this, string key, unique<json_value> value);\u000a\u0009\u0009fn json_member(var json_member& this, json_member& other) : [delete];\u000a\u000a\u0009\u0009string key;\u000a\u0009\u0009unique<json_value> value;\u000a\u0009};\u000a\u000a\u0009export using json_array = buffer<unique<json_value>>;\u000a\u0009export using json_object = buffer<json_member>;\u000a\u000a\u0009export union json_payload {\u000a\u0009\u0009fn json_payload(var json_payload& this) : [default];\u000a\u0009\u0009fn ~json_payload(var json_payload& this) : [default];\u000a\u000a\u0009\u0009u08 empty;\u000a\u0009\u0009bool boolean;\u000a\u0009\u0009string text;\u000a\u0009\u0009json_array array;\u000a\u0009\u0009json_object object;\u000a\u0009};\u000a\u000a\u0009// Text is UTF-8. Object keys are unique; set and parsing retain the last duplicate value.\u000a\u0009// Number spelling is retained without conversion to binary floating point.\u000a\u0009export struct json_value {\u000a\u0009\u0009fn json_value(var json_value& this) : [default];\u000a\u0009\u0009fn json_value(var json_value& this, json_value& other) : [delete];\u000a\u0009\u0009fn ~json_value(var json_value& this);\u000a\u000a\u0009\u0009fn make_null() -> unique<json_value>;\u000a\u0009\u0009fn make_boolean(bool value) -> unique<json_value>;\u000a\u0009\u0009fn make_number(string_view value) -> unique<json_value> | json_error;\u000a\u0009\u0009fn make_integer(i64 value) -> unique<json_value>;\u000a\u0009\u0009fn make_unsigned(u64 value) -> unique<json_value>;\u000a\u0009\u0009fn clone(json_value& this) -> unique<json_value>;\u000a\u0009\u0009fn make_string(string_view value) -> unique<json_value>;\u000a\u0009\u0009fn make_array() -> unique<json_value>;\u000a\u0009\u0009fn make_object() -> unique<json_value>;\u000a\u0009\u0009fn append(var json_value& this, unique<json_value> value) -> json_result;\u000a\u0009\u0009fn set(var json_value& this, string_view key, unique<json_value> value) -> json_result;\u000a\u000a\u0009\u0009fn kind(json_value& this) -> json_kind;\u000a\u0009\u0009fn text(json_value& this) -> string_view;\u000a\u0009\u0009fn boolean(json_value& this) -> bool;\u000a\u0009\u0009fn integer(json_value& this) -> i64 | json_error;\u000a\u0009\u0009fn member(json_value& this, string_view key) -> json_value*;\u000a\u0009\u0009fn item(json_value& this, usize index) -> json_value*;\u000a\u0009\u0009fn key(json_value& this, usize index) -> string_view;\u000a\u0009\u0009fn size(json_value& this) -> usize;\u000a\u000a\u0009private:\u000a\u0009\u0009json_kind tag;\u000a\u0009\u0009json_payload payload;\u000a\u0009};\u000a\u000a\u0009export using json_document = unique<json_value> | json_error | allocation_error;\u000a\u000a\u0009export struct json_parser {\u000a\u0009\u0009fn json_parser(var json_parser& this, string_view text);\u000a\u0009\u0009fn parse(var json_parser& this) -> json_document;\u000a\u000a\u0009private:\u000a\u0009\u0009string_view input;\u000a\u0009\u0009usize cursor;\u000a\u0009\u0009usize failure_offset;\u000a\u0009\u0009string failure;\u000a\u000a\u0009\u0009fn whitespace(var json_parser& this);\u000a\u0009\u0009fn fail(var json_parser& this, string_view message);\u000a\u0009\u0009fn hex_quad(var json_parser& this, var u32& value) -> json_result;\u000a\u0009\u0009fn string_value(var json_parser& this, var string& result) -> json_result;\u000a\u0009\u0009fn value(var json_parser& this, usize depth) -> unique<json_value>;\u000a\u0009};\u000a\u000a\u0009export fn json_member::json_member(var json_member& this, string key, unique<json_value> value) {\u000a\u0009\u0009@this.key = $key;\u000a\u0009\u0009@this.value = $value;\u000a\u0009};\u000a\u000a\u0009export fn json_value::~json_value(var json_value& this) {\u000a\u0009\u0009if (this.tag == json_kind::number || this.tag == json_kind::string) {\u000a\u0009\u0009\u0009@this.payload.text.~string();\u000a\u0009\u0009}\u000a\u0009\u0009else if (this.tag == json_kind::array) {\u000a\u0009\u0009\u0009@this.payload.array.~json_array();\u000a\u0009\u0009}\u000a\u0009\u0009else if (this.tag == json_kind::object) {\u000a\u0009\u0009\u0009@this.payload.object.~json_object();\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn json_number_end(string_view input, usize begin) -> usize {\u000a\u0009\u0009usize cursor = begin;\u000a\u0009\u0009if (cursor < input.size() && input.data()[cursor] == '-') {\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009};\u000a\u0009\u0009if (cursor >= input.size()) {\u000a\u0009\u0009\u0009return begin;\u000a\u0009\u0009};\u000a\u0009\u0009if (input.data()[cursor] == '0') {\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009}\u000a\u0009\u0009else {\u000a\u0009\u0009\u0009if (input.data()[cursor] < '1' || input.data()[cursor] > '9') {\u000a\u0009\u0009\u0009\u0009return begin;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009if (cursor < input.size() && input.data()[cursor] == '.') {\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009usize digits = cursor;\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009if (cursor == digits) {\u000a\u0009\u0009\u0009\u0009return begin;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009if (cursor < input.size() && (input.data()[cursor] == 'e' || input.data()[cursor] == 'E')) {\u000a\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009if (cursor < input.size() && (input.data()[cursor] == '+' || input.data()[cursor] == '-')) {\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009usize digits = cursor;\u000a\u0009\u0009\u0009while (cursor < input.size() && input.data()[cursor] >= '0' && input.data()[cursor] <= '9') {\u000a\u0009\u0009\u0009\u0009@cursor = cursor + 1;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009if (cursor == digits) {\u000a\u0009\u0009\u0009\u0009return begin;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009return cursor;\u000a\u0009};\u000a\u000a\u0009export fn json_utf8_width(string_view text, usize offset) -> usize {\u000a\u0009\u0009if (offset >= text.size()) {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u0009\u0009u08 first = static_cast<u08>(text.data()[offset]);\u000a\u0009\u0009if (first < 128) {\u000a\u0009\u0009\u0009return 1;\u000a\u0009\u0009};\u000a\u0009\u0009usize width = 0;\u000a\u0009\u0009u32 code = 0;\u000a\u0009\u0009u32 minimum = 0;\u000a\u0009\u0009if (first >= 194 && first <= 223) {\u000a\u0009\u0009\u0009@width = 2;\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 31);\u000a\u0009\u0009\u0009@minimum = 128;\u000a\u0009\u0009}\u000a\u0009\u0009else if (first >= 224 && first <= 239) {\u000a\u0009\u0009\u0009@width = 3;\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 15);\u000a\u0009\u0009\u0009@minimum = 2048;\u000a\u0009\u0009}\u000a\u0009\u0009else if (first >= 240 && first <= 244) {\u000a\u0009\u0009\u0009@width = 4;\u000a\u0009\u0009\u0009@code = static_cast<u32>(first & 7);\u000a\u0009\u0009\u0009@minimum = 65536;\u000a\u0009\u0009}\u000a\u0009\u0009else {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u0009\u0009if (width > text.size() - offset) {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u0009\u0009usize index = 1;\u000a\u0009\u0009while (index < width) {\u000a\u0009\u0009\u0009u08 byte = static_cast<u08>(text.data()[offset + index]);\u000a\u0009\u0009\u0009if ((byte & 192) != 128) {\u000a\u0009\u0009\u0009\u0009return 0;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009@code = (code << 6) | static_cast<u32>(byte & 63);\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u0009\u0009if (code < minimum || code > 1114111 || (code >= 55296 && code <= 57343)) {\u000a\u0009\u0009\u0009return 0;\u000a\u0009\u0009};\u000a\u0009\u0009return width;\u000a\u0009};\u000a\u000a\u0009export fn json_valid_utf8(string_view text) -> bool {\u000a\u0009\u0009usize offset = 0;\u000a\u0009\u0009while (offset < text.size()) {\u000a\u0009\u0009\u0009usize width = json_utf8_width(text, offset);\u000a\u0009\u0009\u0009if (!width) {\u000a\u0009\u0009\u0009\u0009return false;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009@offset = offset + width;\u000a\u0009\u0009};\u000a\u0009\u0009return true;\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_null() -> unique<json_value> {\u000a\u0009\u0009return unique<json_value>::make();\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_boolean(bool value) -> unique<json_value> {\u000a\u0009\u0009var result = make_null();\u000a\u0009\u0009if (result.get()) {\u000a\u0009\u0009\u0009@result.get()->tag = json_kind::boolean;\u000a\u0009\u0009\u0009@result.get()->payload.boolean = $value;\u000a\u0009\u0009};\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_number(string_view value) -> unique<json_value> | json_error {\u000a\u0009\u0009using Result = unique<json_value> | json_error;\u000a\u0009\u0009if (!value.size() || json_number_end(value, 0) != value.size()) {\u000a\u0009\u0009\u0009return Result(json_error(\"Invalid JSON number.\", 0));\u000a\u0009\u0009};\u000a\u0009\u0009var result = make_null();\u000a\u0009\u0009if (!result.get()) {\u000a\u0009\u0009\u0009return Result($result);\u000a\u0009\u0009};\u000a\u0009\u0009@result.get()->payload.text.string();\u000a\u0009\u0009@result.get()->tag = json_kind::number;\u000a\u0009\u0009var appended = @result.get()->payload.text.append(value);\u000a\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(appended.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009return Result($result);\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_unsigned(u64 value) -> unique<json_value> {\u000a\u0009\u0009char[20] digits;\u000a\u0009\u0009usize begin = 20;\u000a\u0009\u0009while (true) {\u000a\u0009\u0009\u0009@begin = begin - 1;\u000a\u0009\u0009\u0009@digits[begin] = static_cast<char>(value % 10 + 48);\u000a\u0009\u0009\u0009@value = value / 10;\u000a\u0009\u0009\u0009if (!value) {\u000a\u0009\u0009\u0009\u0009break;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009unique<json_value> result = make_number(string_view(&@digits[begin], 20 - begin));\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_integer(i64 value) -> unique<json_value> {\u000a\u0009\u0009if (value >= 0) {\u000a\u0009\u0009\u0009return make_unsigned(static_cast<u64>($value));\u000a\u0009\u0009};\u000a\u0009\u0009var magnitude = make_unsigned(static_cast<u64>(-(value + 1)) + 1);\u000a\u0009\u0009string text;\u000a\u0009\u0009@text.append(\"-\");\u000a\u0009\u0009@text.append(magnitude.get()->text());\u000a\u0009\u0009unique<json_value> result = make_number(text.view());\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009export fn json_value::clone(json_value& this) -> unique<json_value> {\u000a\u0009\u0009switch (this.tag) {\u000a\u0009\u0009\u0009case json_kind::null_value: return make_null();\u000a\u0009\u0009\u0009case json_kind::boolean: return make_boolean(this.boolean());\u000a\u0009\u0009\u0009case json_kind::number: {\u000a\u0009\u0009\u0009\u0009unique<json_value> number = make_number(this.text());\u000a\u0009\u0009\u0009\u0009return $number;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009case json_kind::string: return make_string(this.text());\u000a\u0009\u0009};\u000a\u0009\u0009var result = make_array();\u000a\u0009\u0009if (this.tag == json_kind::object) {\u000a\u0009\u0009\u0009@result = make_object();\u000a\u0009\u0009};\u000a\u0009\u0009if (!result.get()) {\u000a\u0009\u0009\u0009return $result;\u000a\u0009\u0009};\u000a\u0009\u0009usize index = 0;\u000a\u0009\u0009while (index < this.size()) {\u000a\u0009\u0009\u0009var child = this.item(index)->clone();\u000a\u0009\u0009\u0009json_result stored;\u000a\u0009\u0009\u0009if (this.tag == json_kind::object) {\u000a\u0009\u0009\u0009\u0009@stored = @result.get()->set(this.key(index), unique<json_value>(@child.release()));\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009else {\u000a\u0009\u0009\u0009\u0009@stored = @result.get()->append(unique<json_value>(@child.release()));\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009if (stored.has<allocation_error>()) {\u000a\u0009\u0009\u0009\u0009throw allocation_error(stored.get<allocation_error>());\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009if (stored.has<json_error>()) {\u000a\u0009\u0009\u0009\u0009throw json_error(stored.get<json_error>());\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009export fn json_value::make_string(string_view value) -> unique<json_value> {\u000a\u0009\u0009if (!json_valid_utf8(value)) {\u000a\u0009\u0009\u0009json_error error;\u000a\u0009\u0009\u0009@error.message = string(\"Invalid UTF-8 JSON string.\");\u000a\u0009\u0009\u0009throw $error;\u000a\u0009\u0009};\u000a\u0009\u0009var result = make_null();\u000a\u0009\u0009if (!result.get()) {