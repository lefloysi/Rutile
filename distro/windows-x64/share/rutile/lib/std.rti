 != ':') {\u000d\u000a\u0009\u0009\u0009\u0009\u0009\u0009@this.fail(\"expected ':' after object key\");\u000d\u000a\u0009\u0009\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009\u0009@this.cursor = this.cursor + 1;\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009var child = @this.value(depth + 1);\u000d\u000a\u0009\u0009\u0009\u0009if (!result.get() || !child.get()) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009json_result stored;\u000d\u000a\u0009\u0009\u0009\u0009if (object) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@stored = @result.get()->set(key.view(), unique<json_value>(@child.release()));\u000d\u000a\u0009\u0009\u0009\u0009}\u000d\u000a\u0009\u0009\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@stored = @result.get()->append(unique<json_value>(@child.release()));\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009if (stored.has<json_error>()) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@this.fail(stored.get<json_error>().message);\u000d\u000a\u0009\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009stored;\u000d\u000a\u0009\u0009\u0009\u0009@this.whitespace();\u000d\u000a\u0009\u0009\u0009\u0009if (this.cursor >= this.input.size()) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@this.fail(\"unterminated JSON container\");\u000d\u000a\u0009\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009@byte := this.input.data()[this.cursor];\u000d\u000a\u0009\u0009\u0009\u0009@this.cursor = this.cursor + 1;\u000d\u000a\u0009\u0009\u0009\u0009if (byte == closing) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009return $result;\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009if (byte != ',') {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@this.fail(\"expected ',' between JSON elements\");\u000d\u000a\u0009\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (byte == '-' || (byte >= '0' && byte <= '9')) {\u000d\u000a\u0009\u0009\u0009usize end = json_number_end(this.input, this.cursor);\u000d\u000a\u0009\u0009\u0009if (end == this.cursor) {\u000d\u000a\u0009\u0009\u0009\u0009@this.fail(\"invalid JSON number\");\u000d\u000a\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009var result = json_value::make_number(this.input.slice(this.cursor, end - this.cursor));\u000d\u000a\u0009\u0009\u0009if (result.has<json_error>()) {\u000d\u000a\u0009\u0009\u0009\u0009@this.fail(result.get<json_error>().message);\u000d\u000a\u0009\u0009\u0009\u0009return unique<json_value>();\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009@this.cursor = $end;\u000d\u000a\u0009\u0009\u0009var unique<json_value>& number = (@result).get<unique<json_value>>();\u000d\u000a\u0009\u0009\u0009return unique<json_value>(@number.release());\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var remaining = this.input.slice(this.cursor, this.input.size() - this.cursor);\u000d\u000a\u0009\u0009if (remaining.size() >= 4 && remaining.slice(0, 4) == \"null\") {\u000d\u000a\u0009\u0009\u0009@this.cursor = this.cursor + 4;\u000d\u000a\u0009\u0009\u0009return json_value::make_null();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (remaining.size() >= 4 && remaining.slice(0, 4) == \"true\") {\u000d\u000a\u0009\u0009\u0009@this.cursor = this.cursor + 4;\u000d\u000a\u0009\u0009\u0009return json_value::make_boolean(true);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (remaining.size() >= 5 && remaining.slice(0, 5) == \"false\") {\u000d\u000a\u0009\u0009\u0009@this.cursor = this.cursor + 5;\u000d\u000a\u0009\u0009\u0009return json_value::make_boolean(false);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@this.fail(\"expected a JSON value\");\u000d\u000a\u0009\u0009return unique<json_value>();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_parser::parse(var json_parser& this) -> json_document {\u000d\u000a\u0009\u0009try {\u000d\u000a\u0009\u0009\u0009var root = @this.value(0);\u000d\u000a\u0009\u0009\u0009@this.whitespace();\u000d\u000a\u0009\u0009\u0009if (root.get() && this.cursor != this.input.size()) {\u000d\u000a\u0009\u0009\u0009\u0009@this.fail(\"unexpected text after JSON value\");\u000d\u000a\u0009\u0009\u0009\u0009@root.reset(nullptr);\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009if (!root.get()) {\u000d\u000a\u0009\u0009\u0009\u0009return json_error(this.failure.view(), this.failure_offset);\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009return $root;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009catch (json_error error) {\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009catch (allocation_error error) {\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009// Parsing and writing accept at most 128 nested container levels.\u000d\u000a\u0009export fn json_parse(string_view input) -> json_document {\u000d\u000a\u0009\u0009var parser = json_parser(input);\u000d\u000a\u0009\u0009return @parser.parse();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_write_string(string_view value, var string& output) -> json_result {\u000d\u000a\u0009\u0009if (!json_valid_utf8(value)) {\u000d\u000a\u0009\u0009\u0009json_error error;\u000d\u000a\u0009\u0009\u0009@error.message = string(\"JSON strings require valid UTF-8.\");\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@output.append(\"\\\"\");\u000d\u000a\u0009\u0009var digits = \"0123456789abcdef\";\u000d\u000a\u0009\u0009for (usize index = 0; index < value.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009u08 byte = static_cast<u08>(value.data()[index]);\u000d\u000a\u0009\u0009\u0009if (byte == 34 || byte == 92) {\u000d\u000a\u0009\u0009\u0009\u0009@output.append(\"\\\\\");\u000d\u000a\u0009\u0009\u0009\u0009@output.append(value.slice(index, 1));\u000d\u000a\u0009\u0009\u0009}\u000d\u000a\u0009\u0009\u0009else if (byte < 32) {\u000d\u000a\u0009\u0009\u0009\u0009char[2] hex;\u000d\u000a\u0009\u0009\u0009\u0009@hex[0] := digits.data()[byte >> 4];\u000d\u000a\u0009\u0009\u0009\u0009@hex[1] := digits.data()[byte & 15];\u000d\u000a\u0009\u0009\u0009\u0009@output.append(\"\\\\u00\");\u000d\u000a\u0009\u0009\u0009\u0009@output.append(string_view(&@hex[0], 2));\u000d\u000a\u0009\u0009\u0009}\u000d\u000a\u0009\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009\u0009@output.append(value.slice(index, 1));\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@output.append(\"\\\"\");\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_write_value(json_value& value, var string& output, usize depth) -> json_result {\u000d\u000a\u0009\u0009if (depth > 128) {\u000d\u000a\u0009\u0009\u0009json_error error;\u000d\u000a\u0009\u0009\u0009@error.message = string(\"JSON nesting exceeds the supported depth.\");\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009switch (value.kind()) {\u000d\u000a\u0009\u0009\u0009case json_kind::null_value: {\u000d\u000a\u0009\u0009\u0009\u0009@output.append(\"null\");\u000d\u000a\u0009\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009case json_kind::boolean: {\u000d\u000a\u0009\u0009\u0009\u0009if (value.boolean()) {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@output.append(\"true\");\u000d\u000a\u0009\u0009\u0009\u0009}\u000d\u000a\u0009\u0009\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009\u0009\u0009@output.append(\"false\");\u000d\u000a\u0009\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009case json_kind::number: {\u000d\u000a\u0009\u0009\u0009\u0009@output.append(value.text());\u000d\u000a\u0009\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009case json_kind::string: return json_write_string(value.text(), @output);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009bool object = value.kind() == json_kind::object;\u000d\u000a\u0009\u0009if (object) {\u000d\u000a\u0009\u0009\u0009@output.append(\"{\");\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009@output.append(\"[\");\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (usize index = 0; index < value.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009if (index) {\u000d\u000a\u0009\u0009\u0009\u0009@output.append(\",\");\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009if (object) {\u000d\u000a\u0009\u0009\u0009\u0009json_write_string(value.key(index), @output);\u000d\u000a\u0009\u0009\u0009\u0009@output.append(\":\");\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009json_write_value(*value.item(index), @output, depth + 1);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (object) {\u000d\u000a\u0009\u0009\u0009@output.append(\"}\");\u000d\u000a\u0009\u0009}\u000d\u000a\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009@output.append(\"]\");\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_write(json_value& value, var string& output) -> json_result {\u000d\u000a\u0009\u0009string encoded;\u000d\u000a\u0009\u0009json_write_value(value, @encoded, 0);\u000d\u000a\u0009\u0009@output.append(encoded);\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\optional.rt","text":"namespace rt {\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct optional {\u000d\u000a\u0009\u0009fn optional(var optional& this) : [default];\u000d\u000a\u0009\u0009fn optional(var optional& this, T value);\u000d\u000a\u0009\u0009fn optional(var optional& this, optional& other);\u000d\u000a\u0009\u0009fn ~optional(var optional& this);\u000d\u000a\u0009\u0009fn operator:=(var optional& this, optional& other) -> var optional&;\u000d\u000a\u000d\u000a\u0009\u0009fn reset(var optional& this);\u000d\u000a\u0009\u0009fn emplace(var optional& this, T value) -> var T&;\u000d\u000a\u000d\u000a\u0009\u0009fn has_value(optional& this) -> bool;\u000d\u000a\u0009\u0009fn get(auto optional& this) -> const[this] T*;\u000d\u000a\u0009\u0009fn value(auto optional& this) -> const[this] T&;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009union Storage {\u000d\u000a\u0009\u0009\u0009T value;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009Storage storage;\u000d\u000a\u0009\u0009bool engaged;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct optional_ref {\u000d\u000a\u0009\u0009fn optional_ref(var optional_ref& this) : [default];\u000d\u000a\u0009\u0009fn optional_ref(var optional_ref& this, var T& value);\u000d\u000a\u000d\u000a\u0009\u0009fn reset(var optional_ref& this);\u000d\u000a\u0009\u0009fn bind(var optional_ref& this, var T& value);\u000d\u000a\u000d\u000a\u0009\u0009fn has_value(optional_ref& this) -> bool;\u000d\u000a\u0009\u0009fn get(optional_ref& this) -> var T*;\u000d\u000a\u0009\u0009// Requires has_value(). Resetting the optional never destroys its referent.\u000d\u000a\u0009\u0009fn value(optional_ref& this) -> var T&;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009var T* pointer;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this, T value) {\u000d\u000a\u0009\u0009@this.storage.value.T($value);\u000d\u000a\u0009\u0009@this.engaged = true;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this, optional& other) {\u000d\u000a\u0009\u0009if (other.has_value()) {\u000d\u000a\u0009\u0009\u0009@this.storage.value.T(other.storage.value);\u000d\u000a\u0009\u0009\u0009@this.engaged = true;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::~optional(var optional& this) {\u000d\u000a\u0009\u0009@this.reset();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::operator:=(var optional& this, optional& other) -> var optional& {\u000d\u000a\u0009\u0009var replacement = optional(other);\u000d\u000a\u0009\u0009return @this = $replacement;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::has_value(optional& this) -> bool {\u000d\u000a\u0009\u0009return this.engaged;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::get(auto optional& this) -> const[this] T* {\u000d\u000a\u0009\u0009if (!this.has_value()) {\u000d\u000a\u0009\u0009\u0009return nullptr;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return &@this.storage.value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::value(auto optional& this) -> const[this] T& {\u000d\u000a\u0009\u0009return const_cast<const[this] T&>(@const_cast<var T&>(this.storage.value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::reset(var optional& this) {\u000d\u000a\u0009\u0009if (!this.has_value()) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this.storage.value.~T();\u000d\u000a\u0009\u0009@this.engaged = false;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::emplace(var optional& this, T value) -> var T& {\u000d\u000a\u0009\u0009@this.reset();\u000d\u000a\u0009\u0009@this.storage.value.T($value);\u000d\u000a\u0009\u0009@this.engaged = true;\u000d\u000a\u000d\u000a\u0009\u0009return @this.storage.value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::optional_ref(var optional_ref& this, var T& value) {\u000d\u000a\u0009\u0009@this.pointer = &@value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::has_value(optional_ref& this) -> bool {\u000d\u000a\u0009\u0009return this.pointer != nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::get(optional_ref& this) -> var T* {\u000d\u000a\u0009\u0009return this.pointer;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::value(optional_ref& this) -> var T& {\u000d\u000a\u0009\u0009return static_cast<var T&>(*this.pointer);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::reset(var optional_ref& this) {\u000d\u000a\u0009\u0009@this.pointer = nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::bind(var optional_ref& this, var T& value) {\u000d\u000a\u0009\u0009@this.pointer = &@value;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\process.rt","text":"struct Process;\u000d\u000afn rutile_process_start(char** arguments, usize count, char* directory, char** environment, usize environment_count, var void* result);\u000d\u000afn rutile_process_write(var Process* process, char* bytes, usize size, var void* result);\u000d\u000afn rutile_process_close_input(var Process* process);\u000d\u000afn rutile_process_read(var Process* process, u32 timeout_ms, var void* result);\u000d\u000afn rutile_process_wait(var Process* process, u32 timeout_ms, var void* result);\u000d\u000afn rutile_process_dispose(var Process* process);\u000d\u000a\u000d\u000anamespace rt::sys {\u000d\u000a\u0009export struct launch_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(launch_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn launch_error::description(launch_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The process could not be started.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct timeout_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(timeout_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn timeout_error::description(timeout_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The process timed out.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct io_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(io_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn io_error::description(io_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The process I/O operation failed.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct invalid_environment_error : [rt::error] {\u000d\u000a\u0009\u0009fn description(invalid_environment_error& this) -> rt::string_view : [override];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn invalid_environment_error::description(invalid_environment_error& this) -> rt::string_view {\u000d\u000a\u0009\u0009return \"The process environment entry is invalid.\";\u000d\u000a\u0009};\u000d\u000a\u0009export struct Command {\u000d\u000a\u0009\u0009rt::buffer<rt::string> arguments;\u000d\u000a\u0009\u0009rt::string working_directory;\u000d\u000a\u0009\u0009rt::string input;\u000d\u000a\u0009\u0009u32 timeout_ms = 30000;\u000d\u000a\u0009\u0009rt::buffer<rt::string> environment_overrides;\u000d\u000a\u000d\u000a\u0009\u0009fn Command(var Command& this, rt::string_view executable);\u000d\u000a\u0009\u0009fn argument(var Command& this, rt::string_view value) -> void | rt::allocation_error;\u000d\u000a\u0009\u0009fn environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct Result {\u000d\u000a\u0009\u0009i32 exit_code = 0;\u000d\u000a\u0009\u0009rt::string output;\u000d\u000a\u0009\u0009rt::string error;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct Session {\u000d\u000a\u0009\u0009fn Session(var Session& this) : [default];\u000d\u000a\u0009\u0009fn Session(var Session& this, var Process* process);\u000d\u000a\u0009\u0009fn Session(var Session& this, Session& other) : [delete];\u000d\u000a\u0009\u0009fn ~Session(var Session& this);\u000d\u000a\u0009\u0009fn valid(Session& this) -> bool;\u000d\u000a\u0009\u0009fn write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error;\u000d\u000a\u0009\u0009fn close_input(var Session& this);\u000d\u000a\u0009\u0009fn read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error;\u000d\u000a\u0009\u0009fn wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009var Process* handle = nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Command::Command(var Command& this, rt::string_view executable) {\u000d\u000a\u0009\u0009@this.arguments.push_back(rt::string(executable));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Command::argument(var Command& this, rt::string_view value) -> void | rt::allocation_error {\u000d\u000a\u0009\u0009rt::string argument;\u000d\u000a\u0009\u0009@argument.append(value);\u000d\u000a\u0009\u0009@this.arguments.push_back($argument);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Command::environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error {\u000d\u000a\u0009\u0009if (name.empty() || name.contains(\"=\") || name.contains(\"\\0\") || value.contains(\"\\0\")) {\u000d\u000a\u0009\u0009\u0009invalid_environment_error error;\u000d\u000a\u0009\u0009\u0009return $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@this.environment_overrides.push_back(name + \"=\" + value);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::Session(var Session& this, var Process* process) {\u000d\u000a\u0009\u0009@this.handle = $process;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::~Session(var Session& this) {\u000d\u000a\u0009\u0009rutile_process_dispose(this.handle);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::valid(Session& this) -> bool {\u000d\u000a\u0009\u0009return this.handle != nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009using WriteResult = void | io_error | rt::allocation_error;\u000d\u000a\u0009using ReadResult = rt::string | io_error | rt::allocation_error;\u000d\u000a\u0009using WaitResult = Result | launch_error | timeout_error | io_error | rt::allocation_error;\u000d\u000a\u0009using StartResult = Session | launch_error | rt::allocation_error;\u000d\u000a\u000d\u000a\u0009fn \"C\" rutile_process_start_complete(var void* storage, var Process* process) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var StartResult*>(storage) = Session(process);\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_start_launch_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var StartResult*>(storage) = launch_error();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_start_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var StartResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_write_complete(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var WriteResult*>(storage) = WriteResult();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_write_io_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var WriteResult*>(storage) = io_error();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_write_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.kind = rt::allocation_kind::array;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var WriteResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_read_complete(var void* storage, char* bytes, usize size) -> usize {\u000d\u000a\u0009\u0009var ReadResult& result = @*reinterpret_cast<var ReadResult*>(storage);\u000d\u000a\u0009\u0009rt::string text;\u000d\u000a\u0009\u0009var appended = @text.append(rt::string_view(bytes, size));\u000d\u000a\u0009\u0009if (appended.has<rt::allocation_error>()) {\u000d\u000a\u0009\u0009\u0009@result = appended.get<rt::allocation_error>();\u000d\u000a\u0009\u0009\u0009return 0;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@result = $text;\u000d\u000a\u0009\u0009return $size;\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_read_io_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var ReadResult*>(storage) = io_error();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_read_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.kind = rt::allocation_kind::array;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var ReadResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_wait_complete(var void* storage, i32 exit_code, char* output, usize output_size, char* error, usize error_size) {\u000d\u000a\u0009\u0009var WaitResult& outcome = @*reinterpret_cast<var WaitResult*>(storage);\u000d\u000a\u0009\u0009Result result;\u000d\u000a\u0009\u0009@result.exit_code = $exit_code;\u000d\u000a\u0009\u0009var copied_output = @result.output.append(rt::string_view(output, output_size));\u000d\u000a\u0009\u0009if (copied_output.has<rt::allocation_error>()) {\u000d\u000a\u0009\u0009\u0009@outcome = copied_output.get<rt::allocation_error>();\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var copied_error = @result.error.append(rt::string_view(error, error_size));\u000d\u000a\u0009\u0009if (copied_error.has<rt::allocation_error>()) {\u000d\u000a\u0009\u0009\u0009@outcome = copied_error.get<rt::allocation_error>();\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009@outcome = $result;\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_wait_timeout_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var WaitResult*>(storage) = timeout_error();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_wait_io_error(var void* storage) {\u000d\u000a\u0009\u0009@*reinterpret_cast<var WaitResult*>(storage) = io_error();\u000d\u000a\u0009};\u000d\u000a\u0009fn \"C\" rutile_process_wait_allocation_error(var void* storage, usize bytes) {\u000d\u000a\u0009\u0009rt::allocation_error error;\u000d\u000a\u0009\u0009@error.kind = rt::allocation_kind::array;\u000d\u000a\u0009\u0009@error.requested_bytes = bytes;\u000d\u000a\u0009\u0009@*reinterpret_cast<var WaitResult*>(storage) = $error;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error {\u000d\u000a\u0009\u0009if (!this.handle) {\u000d\u000a\u0009\u0009\u0009return io_error();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009WriteResult result;\u000d\u000a\u0009\u0009rutile_process_write(this.handle, input.data(), input.size(), &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::close_input(var Session& this) {\u000d\u000a\u0009\u0009if (this.handle) {\u000d\u000a\u0009\u0009\u0009rutile_process_close_input(this.handle);\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error {\u000d\u000a\u0009\u0009if (!this.handle) {\u000d\u000a\u0009\u0009\u0009return io_error();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009ReadResult result;\u000d\u000a\u0009\u0009rutile_process_read(this.handle, timeout_ms, &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn Session::wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {\u000d\u000a\u0009\u0009if (!this.handle) {\u000d\u000a\u0009\u0009\u0009return launch_error();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009WaitResult result;\u000d\u000a\u0009\u0009rutile_process_wait(this.handle, timeout_ms, &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn start(Command& command) -> Session | launch_error | rt::allocation_error {\u000d\u000a\u0009\u0009rt::buffer<char*> pointers;\u000d\u000a\u0009\u0009for (usize index = 0; index < command.arguments.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009@pointers.push_back(command.arguments.data()[index].c_str());\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009rt::buffer<char*> environment;\u000d\u000a\u0009\u0009for (usize index = 0; index < command.environment_overrides.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009@environment.push_back(command.environment_overrides.data()[index].c_str());\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009StartResult result;\u000d\u000a\u0009\u0009rutile_process_start(pointers.data(), pointers.size(), command.working_directory.c_str(), environment.data(), environment.size(), &@result);\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn cmd(Command& command) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {\u000d\u000a\u0009\u0009var started = start(command);\u000d\u000a\u0009\u0009if (started.has<launch_error>()) {\u000d\u000a\u0009\u0009\u0009return started.get<launch_error>();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (started.has<rt::allocation_error>()) {\u000d\u000a\u0009\u0009\u0009return started.get<rt::allocation_error>();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var Session& session = (@started).get<Session>();\u000d\u000a\u0009\u0009@session.write(command.input);\u000d\u000a\u0009\u0009@session.close_input();\u000d\u000a\u0009\u0009return @session.wait(command.timeout_ms);\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\runtime.rt","text":"namespace rt {\u000d\u000a\u0009export enum byte : [u08] {\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct error {\u000d\u000a\u0009\u0009fn description(error& this) -> string_view : [virtual];\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn error::description(error& this) -> string_view {\u000d\u000a\u0009\u0009return \"Runtime error.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export enum allocation_kind : [u08] {\u000d\u000a\u0009\u0009unknown;\u000d\u000a\u0009\u0009single;\u000d\u000a\u0009\u0009array;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export struct allocation_error : [error] {\u000d\u000a\u0009\u0009fn description(allocation_error& this) -> string_view : [override];\u000d\u000a\u0009\u0009usize requested_bytes;\u000d\u000a\u0009\u0009allocation_kind kind;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn allocation_error::description(allocation_error& this) -> string_view {\u000d\u000a\u0009\u0009return \"Memory allocation failed.\";\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn grow_capacity(usize capacity, usize required, usize maximum, usize increment) -> usize {\u000d\u000a\u0009\u0009usize grown = maximum;\u000d\u000a\u0009\u0009if (capacity <= maximum && increment <= maximum - capacity) {\u000d\u000a\u0009\u0009\u0009@grown = capacity + increment;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (required > grown) {\u000d\u000a\u0009\u0009\u0009return required;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return grown;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export enum ExitCode : [i32] {\u000d\u000a\u0009\u0009success;\u000d\u000a\u0009\u0009failure;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"std\\string.rt","text":"fn memcpy(var void* destination, void* source, usize size) -> var void*;\u000d\u000a\u000d\u000afn memmove(var void* destination, void* source, usize size) -> var void*;\u000d\u000a\u000d\u000anamespace rt {\u000d\u000a\u0009export struct string_view {\u000d\u000a\u0009\u0009fn string_view(var string_view& this) : [default];\u000d\u000a\u0009\u0009fn string_view(var string_view& this, string& other) : [implicit];\u000d\u000a\u0009\u0009fn string_view(var string_view& this, char* data, usize size);\u000d\u000a\u000d\u000a\u0009\u0009fn data(string_view& this) -> char*;\u000d\u000a\u0009\u0009fn size(string_view& this) -> usize;\u000d\u000a\u0009\u0009fn empty(string_view& this) -> bool;\u000d\u000a\u0009\u0009fn slice(string_view& this, usize begin, usize count) -> string_view;\u000d\u000a\u0009\u0009fn contains(string_view& this, string_view other) -> bool;\u000d\u000a\u0009\u0009fn trim(string_view& this) -> string_view;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009char* bytes;\u000d\u000a\u0009\u0009usize length;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator==(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009if (lhs.size() != rhs.size()) {\u000d\u000a\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (usize index = 0; index < lhs.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009if (lhs.data()[index] != rhs.data()[index]) {\u000d\u000a\u0009\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return true;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator!=(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009return !(lhs == rhs);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator<(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009for (usize index = 0; index < lhs.size() && index < rhs.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009if (lhs.data()[index] != rhs.data()[index]) {\u000d\u000a\u0009\u0009\u0009\u0009return static_cast<u08>(lhs.data()[index]) < static_cast<u08>(rhs.data()[index]);\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return lhs.size() < rhs.size();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator<=(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009return !(rhs < lhs);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator>(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009return rhs < lhs;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator>=(string_view lhs, string_view rhs) -> bool {\u000d\u000a\u0009\u0009return !(lhs < rhs);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::string_view(var string_view& this, char* data, usize size) {\u000d\u000a\u0009\u0009@this.bytes = $data;\u000d\u000a\u0009\u0009@this.length = $size;\u000d\u000a\u000