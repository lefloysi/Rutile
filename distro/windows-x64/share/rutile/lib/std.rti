alue> {\u000d\u000a\u0009\u0009switch (this.tag) {\u000d\u000a\u0009\u0009\u0009case json_kind::null_value: return make_null();\u000d\u000a\u0009\u0009\u0009case json_kind::boolean: return make_boolean(this.boolean());\u000d\u000a\u0009\u0009\u0009case json_kind::number: {\u000d\u000a\u0009\u0009\u0009\u0009unique<json_value> number = make_number(this.text());\u000d\u000a\u0009\u0009\u0009\u0009return $number;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009case json_kind::string: return make_string(this.text());\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var result = make_array();\u000d\u000a\u0009\u0009if (this.tag == json_kind::object) {\u000d\u000a\u0009\u0009\u0009@result = make_object();\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009if (!result.get()) {\u000d\u000a\u0009\u0009\u0009return $result;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (usize index = 0; index < this.size(); @index = index + 1) {\u000d\u000a\u0009\u0009\u0009var child = this.item(index)->clone();\u000d\u000a\u0009\u0009\u0009if (this.tag == json_kind::object) {\u000d\u000a\u0009\u0009\u0009\u0009@result.get()->set(this.key(index), unique<json_value>(@child.release()));\u000d\u000a\u0009\u0009\u0009}\u000d\u000a\u0009\u0009\u0009else {\u000d\u000a\u0009\u0009\u0009\u0009@result.get()->append(unique<json_value>(@child.release()));\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return $result;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn json_value::make_string(string_view value) -> unique<json_value> {\u000d\u000a\u0009\u0009if (!json_valid_utf8(value)) {\u000d\u000a\u0009\u0009\u0009json_error error;\u000d\u000a\u0009\u0009\u0009@error.message = string(\"Invalid UTF-8 JSON string.\");\u000d\u000a\u0009\u0009\u0009throw $error;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var result = make_null();\u000d\u000a\u0009\u0009if (!result.get()) {\u000d\u000a\u0009\u0009\u0009return $result;\u000d\u000a\u0009\u0009};