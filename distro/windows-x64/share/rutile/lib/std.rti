8_width(this.input, begin);\r\n\t\t\t\t\tif (!width) {\r\n\t\t\t\t\t\treturn @this.fail(\"invalid UTF-8 in JSON string\");\r\n\t\t\t\t\t};\r\n\t\t\t\t\tif (!@result.append(this.input.slice(begin, width))) {\r\n\t\t\t\t\t\treturn @this.fail(\"cannot allocate JSON string\");\r\n\t\t\t\t\t};\r\n\t\t\t\t\t@this.cursor = begin + width;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t};\r\n\t\t\t};\r\n\t\t\tif (!@result.append(string_view(&@byte, 1))) {\r\n\t\t\t\treturn @this.fail(\"cannot allocate JSON string\");\r\n\t\t\t};\r\n\t\t};\r\n\t\treturn @this.fail(\"unterminated JSON string\");\r\n\t};\r\n\r\n\texport fn json_parser::value(var json_parser& this, usize depth) -> unique<json_value> {\r\n\t\t@this.whitespace();\r\n\t\tif (depth > 128 || this.cursor >= this.input.size()) {\r\n\t\t\t@this.fail(\"expected JSON value within nesting limit\");\r\n\t\t\treturn unique<json_value>();\r\n\t\t};\r\n\t\tchar byte = this.input.data()[this.cursor];\r\n\t\tif (byte == '\"') {\r\n\t\t\tstring text;\r\n\t\t\tif (!@this.string_value(@text)) {\r\n\t\t\t\treturn unique<json_value>();\r\n\t\t\t};\r\n\t\t\treturn json_value::make_string(text.view());\r\n\t\t};\r\n\t\tif (byte == '{' || byte == '[') {\r\n\t\t\tbool object = byte == '{';\r\n\t\t\tvar result = json_value::make_array();\r\n\t\t\tchar closing = ']';\r\n\t\t\tif (object) {\r\n\t\t\t\t@result = json_value::make_object();\r\n\t\t\t\t@closing = '}';\r\n\t\t\t};\r\n\t\t\t@this.cursor = this.cursor + 1;\r\n\t\t\t@this.whitespace();\r\n\t\t\tif (this.cursor < this.input.size() && this.input.data()[this.cursor] == closing) {\r\n\t\t\t\t@this.cursor = this.cursor + 1;\r\n\t\t\t\treturn $result;\r\n\t\t\t};\r\n\t\t\twhile (true) {\r\n\t\t\t\tstring key;\r\n\t\t\t\tif (object) {\r\n\t\t\t\t\t@this.whitespace();\r\n\t\t\t\t\tif (!@this.string_value(@key)) {\r\n\t\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t\t};\r\n\t\t\t\t\t@this.whitespace();\r\n\t\t\t\t\tif (this.cursor >= this.input.size() || this.input.data()[this.cursor] != ':') {\r\n\t\t\t\t\t\t@this.fail(\"expected ':' after object key\");\r\n\t\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t\t};\r\n\t\t\t\t\t@this.cursor = this.cursor + 1;\r\n\t\t\t\t};\r\n\t\t\t\tvar child = @this.value(depth + 1);\r\n\t\t\t\tif (!result.get() || !child.get()) {\r\n\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t};\r\n\t\t\t\tbool stored = false;\r\n\t\t\t\tif (object) {\r\n\t\t\t\t\t@stored = @result.get()->set(key.view(), unique<json_value>(@child.release()));\r\n\t\t\t\t}\r\n\t\t\t\telse {\r\n\t\t\t\t\t@stored = @result.get()->append(unique<json_value>(@child.release()));\r\n\t\t\t\t};\r\n\t\t\t\tif (!stored) {\r\n\t\t\t\t\t@this.fail(\"cannot allocate JSON container\");\r\n\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t};\r\n\t\t\t\t@this.whitespace();\r\n\t\t\t\tif (this.cursor >= this.input.size()) {\r\n\t\t\t\t\t@this.fail(\"unterminated JSON container\");\r\n\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t};\r\n\t\t\t\t@byte := this.input.data()[this.cursor];\r\n\t\t\t\t@this.cursor = this.cursor + 1;\r\n\t\t\t\tif (byte == closing) {\r\n\t\t\t\t\treturn $result;\r\n\t\t\t\t};\r\n\t\t\t\tif (byte != ',') {\r\n\t\t\t\t\t@this.fail(\"expected ',' between JSON elements\");\r\n\t\t\t\t\treturn unique<json_value>();\r\n\t\t\t\t};\r\n\t\t\t};\r\n\t\t};\r\n\t\tif (byte == '-' || (byte >= '0' && byte <= '9')) {\r\n\t\t\tusize end = json_number_end(this.input, this.cursor);\r\n\t\t\tif (end == this.cursor) {\r\n\t\t\t\t@this.fail(\"invalid JSON number\");\r\n\t\t\t\treturn unique<json_value>();\r\n\t\t\t};\r\n\t\t\tvar result = json_value::make_number(this.input.slice(this.cursor, end - this.cursor));\r\n\t\t\t@this.cursor = $end;\r\n\t\t\treturn $result;\r\n\t\t};\r\n\t\tvar remaining = this.input.slice(this.cursor, this.input.size() - this.cursor);\r\n\t\tif (remaining.size() >= 4 && remaining.slice(0, 4) == \"null\") {\r\n\t\t\t@this.cursor = this.cursor + 4;\r\n\t\t\treturn json_value::make_null();\r\n\t\t};\r\n\t\tif (remaining.size() >= 4 && remaining.slice(0, 4) == \"true\") {\r\n\t\t\t@this.cursor = this.cursor + 4;\r\n\t\t\treturn json_value::make_boolean(true);\r\n\t\t};\r\n\t\tif (remaining.size() >= 5 && remaining.slice(0, 5) == \"false\") {\r\n\t\t\t@this.cursor = this.cursor + 5;\r\n\t\t\treturn json_value::make_boolean(false);\r\n\t\t};\r\n\t\t@this.fail(\"expected a JSON value\");\r\n\t\treturn unique<json_value>();\r\n\t};\r\n\r\n\texport fn json_parser::parse(var json_parser& this) -> json_document {\r\n\t\tvar root = @this.value(0);\r\n\t\t@this.whitespace();\r\n\t\tif (root.get() && this.cursor != this.input.size()) {\r\n\t\t\t@this.fail(\"unexpected text after JSON value\");\r\n\t\t\t@root.reset(nullptr);\r\n\t\t};\r\n\t\tif (!root.get() && !this.failure.size()) {\r\n\t\t\t@this.fail(\"cannot allocate JSON value\");\r\n\t\t};\r\n\t\treturn json_document($root, usize(this.failure_offset), string(this.failure.view()));\r\n\t};\r\n\r\n\t// Parsing and writing accept at most 128 nested container levels.\r\n\texport fn json_parse(string_view input) -> json_document {\r\n\t\tvar parser = json_parser(input);\r\n\t\treturn @parser.parse();\r\n\t};\r\n\r\n\texport fn json_write_string(string_view value, var string& output) -> bool {\r\n\t\tif (!@output.append(\"\\\"\")) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\t\tusize index = 0;\r\n\t\tvar digits = \"0123456789abcdef\";\r\n\t\twhile (index < value.size()) {\r\n\t\t\tu08 byte = static_cast<u08>(value.data()[index]);\r\n\t\t\tif (byte == 34 || byte == 92) {\r\n\t\t\t\tif (!@output.append(\"\\\\\") || !@output.append(value.slice(index, 1))) {\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t};\r\n\t\t\t}\r\n\t\t\telse if (byte < 32) {\r\n\t\t\t\tchar[2] hex;\r\n\t\t\t\t@hex[0] := digits.data()[byte >> 4];\r\n\t\t\t\t@hex[1] := digits.data()[byte & 15];\r\n\t\t\t\tif (!@output.append(\"\\\\u00\") || !@output.append(string_view(&@hex[0], 2))) {\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t};\r\n\t\t\t}\r\n\t\t\telse if (!@output.append(value.slice(index, 1))) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\t\treturn @output.append(\"\\\"\");\r\n\t};\r\n\r\n\texport fn json_write_value(json_value& value, var string& output, usize depth) -> bool {\r\n\t\tif (depth > 128) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\t\tswitch (value.kind()) {\r\n\t\t\tcase json_kind::null_value: return @output.append(\"null\");\r\n\t\t\tcase json_kind::boolean: {\r\n\t\t\t\tif (value.boolean()) {\r\n\t\t\t\t\treturn @output.append(\"true\");\r\n\t\t\t\t};\r\n\t\t\t\treturn @output.append(\"false\");\r\n\t\t\t};\r\n\t\t\tcase json_kind::number: return @output.append(value.text());\r\n\t\t\tcase json_kind::string: return json_write_string(value.text(), @output);\r\n\t\t};\r\n\t\tbool object = value.kind() == json_kind::object;\r\n\t\tif (object) {\r\n\t\t\tif (!@output.append(\"{\")) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\t\t}\r\n\t\telse if (!@output.append(\"[\")) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\t\tusize index = 0;\r\n\t\twhile (index < value.size()) {\r\n\t\t\tif (index && !@output.append(\",\")) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\t\t\tif (object && (!json_write_string(value.key(index), @output) || !@output.append(\":\"))) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\t\t\tif (!json_write_value(*value.item(index), @output, depth + 1)) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\t\tif (object) {\r\n\t\t\treturn @output.append(\"}\");\r\n\t\t};\r\n\t\treturn @output.append(\"]\");\r\n\t};\r\n\r\n\texport fn json_write(json_value& value, var string& output) -> bool {\r\n\t\tstring encoded;\r\n\t\tif (!json_write_value(value, @encoded, 0)) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\t\treturn @output.append(encoded.view());\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\optional.rt","text":"namespace rt {\r\n\ttemplate<typename T>\r\n\texport struct optional {\r\n\t\tfn optional(var optional& this);\r\n\t\tfn optional(var optional& this, T value);\r\n\t\tfn optional(var o