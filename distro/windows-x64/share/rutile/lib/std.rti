\u0009\u0009\u0009\u0009var item = json_write_value(*value.item(index), @output, depth + 1);\u000a\u0009\u0009\u0009\u0009if (!item.has<void>()) {\u000a\u0009\u0009\u0009\u0009\u0009return $item;\u000a\u0009\u0009\u0009\u0009};\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009if (object) {\u000a\u0009\u0009\u0009\u0009@output.append(\"}\");\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009else {\u000a\u0009\u0009\u0009\u0009@output.append(\"]\");\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009return json_result();\u000a\u0009\u0009}\u000a\u0009\u0009catch (allocation_error error) {\u000a\u0009\u0009\u0009return json_result($error);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn json_write(json_value& value, var string& output) -> json_result {\u000a\u0009\u0009string encoded;\u000a\u0009\u0009var written = json_write_value(value, @encoded, 0);\u000a\u0009\u0009if (!written.has<void>()) {\u000a\u0009\u0009\u0009return $written;\u000a\u0009\u0009};\u000a\u0009\u0009var appended = @output.append(encoded);\u000a\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009return json_result(appended.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009return json_result();\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/optional.rt","text":"namespace rt {\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct optional {\u000d\u000a\u0009\u0009fn optional(var optional& this);\u000d\u000a\u0009\u0009fn optional(var optional& this, T value);\u000d\u000a\u0009\u0009fn optional(var optional& this, optional& other);\u000d\u000a\u0009\u0009fn optional(var optional& this, optional other);\u000d\u000a\u0009\u0009fn ~optional(var optional& this);\u000d\u000a\u0009\u0009fn operator=(var optional& this, optional other) -> var optional&;\u000d\u000a\u0009\u0009fn operator:=(var optional& this, optional& other) -> var optional&;\u000d\u000a\u000d\u000a\u0009\u0009fn reset(var optional& this);\u000d\u000a\u0009\u0009fn emplace(var optional& this, T value) -> var T&;\u000d\u000a\u000d\u000a\u0009\u0009fn has_value(optional& this) -> bool;\u000d\u000a\u0009\u0009fn get(auto optional& this) -> const[this] T*;\u000d\u000a\u0009\u0009fn value(auto optional& this) -> const[this] T&;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009union Storage {\u000d\u000a\u0009\u0009\u0009fn Storage(var Storage& this) {\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009\u0009fn ~Storage(var Storage& this) {\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009\u0009T value;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009Storage storage;\u000d\u000a\u0009\u0009bool engaged;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export struct optional_ref {\u000d\u000a\u0009\u0009fn optional_ref(var optional_ref& this) : [default];\u000d\u000a\u0009\u0009fn optional_ref(var optional_ref& this, var T& value);\u000d\u000a\u0009\u0009fn optional_ref(var optional_ref& this, optional_ref& other) : [implicit];\u000d\u000a\u000d\u000a\u0009\u0009fn reset(var optional_ref& this);\u000d\u000a\u0009\u0009fn bind(var optional_ref& this, var T& value);\u000d\u000a\u000d\u000a\u0009\u0009fn has_value(optional_ref& this) -> bool;\u000d\u000a\u0009\u0009fn get(optional_ref& this) -> var T*;\u000d\u000a\u0009\u0009// Requires has_value(). Resetting the optional never destroys its referent.\u000d\u000a\u0009\u0009fn value(optional_ref& this) -> var T&;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009var T* pointer;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this) {\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this, T value) {\u000d\u000a\u0009\u0009@this.storage.value.T($value);\u000d\u000a\u0009\u0009@this.engaged = true;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this, optional& other) {\u000d\u000a\u0009\u0009if (other.has_value()) {\u000d\u000a\u0009\u0009\u0009@this.storage.value.T(other.storage.value);\u000d\u000a\u0009\u0009\u0009@this.engaged = true;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::optional(var optional& this, optional other) {\u000d\u000a\u0009\u0009if (other.has_value()) {\u000d\u000a\u0009\u0009\u0009var T* source = &@other.storage.value;\u000d\u000a\u000d\u000a\u0009\u0009\u0009@this.storage.value.T($(*source));\u000d\u000a\u0009\u0009\u0009@this.engaged = true;\u000d\u000a\u0009\u0009\u0009@other.engaged = false;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::~optional(var optional& this) {\u000d\u000a\u0009\u0009@this.reset();\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::operator=(var optional& this, optional other) -> var optional& {\u000d\u000a\u0009\u0009@this.reset();\u000d\u000a\u0009\u0009if (other.has_value()) {\u000d\u000a\u0009\u0009\u0009var T* source = &@other.storage.value;\u000d\u000a\u0009\u0009\u0009@this.storage.value.T($(*source));\u000d\u000a\u0009\u0009\u0009@this.engaged = true;\u000d\u000a\u0009\u0009\u0009@other.engaged = false;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return @this;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::operator:=(var optional& this, optional& other) -> var optional& {\u000d\u000a\u0009\u0009var replacement = optional(other);\u000d\u000a\u0009\u0009return @this = $replacement;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::has_value(optional& this) -> bool {\u000d\u000a\u0009\u0009return this.engaged;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::get(auto optional& this) -> const[this] T* {\u000d\u000a\u0009\u0009if (!this.has_value()) {\u000d\u000a\u0009\u0009\u0009return nullptr;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return &@this.storage.value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::value(auto optional& this) -> const[this] T& {\u000d\u000a\u0009\u0009return const_cast<const[this] T&>(@const_cast<var T&>(this.storage.value));\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::reset(var optional& this) {\u000d\u000a\u0009\u0009if (!this.has_value()) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009@this.storage.value.~T();\u000d\u000a\u0009\u0009@this.engaged = false;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional<T>::emplace(var optional& this, T value) -> var T& {\u000d\u000a\u0009\u0009@this.reset();\u000d\u000a\u0009\u0009@this.storage.value.T($value);\u000d\u000a\u0009\u0009@this.engaged = true;\u000d\u000a\u000d\u000a\u0009\u0009return @this.storage.value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::optional_ref(var optional_ref& this, var T& value) {\u000d\u000a\u0009\u0009@this.pointer = &@value;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::optional_ref(var optional_ref& this, optional_ref& other) : [implicit] {\u000d\u000a\u0009\u0009@this.pointer := other.pointer;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::has_value(optional_ref& this) -> bool {\u000d\u000a\u0009\u0009return this.pointer != nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::get(optional_ref& this) -> var T* {\u000d\u000a\u0009\u0009return this.pointer;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::value(optional_ref& this) -> var T& {\u000d\u000a\u0009\u0009return static_cast<var T&>(*this.pointer);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::reset(var optional_ref& this) {\u000d\u000a\u0009\u0009@this.pointer = nullptr;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn optional_ref<T>::bind(var optional_ref& this, var T& value) {\u000d\u000a\u0009\u0009@this.pointer = &@value;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/process.rt","text":"struct NativeProcess;\u000astruct ProcessBuffer {\u000a\u0009char* data;\u000a\u0009usize size;\u000a\u0009i32 error;\u000a};\u000astruct ProcessStart {\u000a\u0009var NativeProcess* handle;\u000a\u0009i32 error;\u000a};\u000astruct ProcessOutput {\u000a\u0009i32 state;\u000a\u0009i32 exit_code;\u000a\u0009ProcessBuffer output;\u000a\u0009ProcessBuffer error;\u000a};\u000afn rutile_process_start(char** arguments, usize count, char* directory, char** environment, usize environment_count, var ProcessStart* result);\u000afn rutile_process_write(var NativeProcess* process, char* bytes, usize size) -> i32;\u000afn rutile_process_close_input(var NativeProcess* process);\u000afn rutile_process_read(var NativeProcess* process, u32 timeout_ms) -> ProcessBuffer*;\u000afn rutile_process_wait(var NativeProcess* process, u32 timeout_ms) -> ProcessOutput*;\u000afn rutile_process_dispose(var NativeProcess* process);\u000a\u000anamespace rt::sys {\u000a\u0009export struct launch_error {\u000a\u0009};\u000a\u000a\u0009export struct timeout_error {\u000a\u0009};\u000a\u000a\u0009export struct io_error {\u000a\u0009};\u000a\u000a\u0009export struct invalid_environment_error {\u000a\u0009};\u000a\u0009export struct Command {\u000a\u0009\u0009rt::buffer<rt::string> arguments;\u000a\u0009\u0009rt::string working_directory;\u000a\u0009\u0009rt::string input;\u000a\u0009\u0009u32 timeout_ms = 30000;\u000a\u0009\u0009rt::buffer<rt::string> environment_overrides;\u000a\u000a\u0009\u0009fn Command(var Command& this, rt::string_view executable);\u000a\u0009\u0009fn argument(var Command& this, rt::string_view value) -> void | rt::allocation_error;\u000a\u0009\u0009fn environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error;\u000a\u0009};\u000a\u000a\u0009export struct Result {\u000a\u0009\u0009i32 exit_code = -1;\u000a\u0009\u0009rt::string output;\u000a\u0009\u0009rt::string error;\u000a\u0009};\u000a\u000a\u0009export struct Session {\u000a\u0009\u0009fn Session(var Session& this) : [default];\u000a\u0009\u0009fn Session(var Session& this, var NativeProcess* process);\u000a\u0009\u0009fn Session(var Session& this, Session& other) : [delete];\u000a\u0009\u0009fn ~Session(var Session& this);\u000a\u0009\u0009fn valid(Session& this) -> bool;\u000a\u0009\u0009fn write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error;\u000a\u0009\u0009fn close_input(var Session& this);\u000a\u0009\u0009fn read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error;\u000a\u0009\u0009fn wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error;\u000a\u000a\u0009private:\u000a\u0009\u0009var NativeProcess* handle;\u000a\u0009};\u000a\u000a\u0009export fn Command::Command(var Command& this, rt::string_view executable) {\u000a\u0009\u0009var appended = @this.arguments.push_back(rt::string(executable));\u000a\u0009\u0009if (appended.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009throw rt::allocation_error(appended.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn Command::argument(var Command& this, rt::string_view value) -> void | rt::allocation_error {\u000a\u0009\u0009using Result = void | rt::allocation_error;\u000a\u0009\u0009try {\u000a\u0009\u0009\u0009return @this.arguments.push_back(rt::string(value));\u000a\u0009\u0009}\u000a\u0009\u0009catch (rt::allocation_error error) {\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn Command::environment(var Command& this, rt::string_view name, rt::string_view value) -> void | invalid_environment_error | rt::allocation_error {\u000a\u0009\u0009using Result = void | invalid_environment_error | rt::allocation_error;\u000a\u0009\u0009if (name.empty() || name.contains(\"=\") || name.contains(\"\\0\") || value.contains(\"\\0\")) {\u000a\u0009\u0009\u0009invalid_environment_error error;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009try {\u000a\u0009\u0009\u0009var appended = @this.environment_overrides.push_back(name + \"=\" + value);\u000a\u0009\u0009\u0009if (appended.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009\u0009return Result(appended.get<rt::allocation_error>());\u000a\u0009\u0009\u0009};\u000a\u0009\u0009\u0009return Result();\u000a\u0009\u0009}\u000a\u0009\u0009catch (rt::allocation_error error) {\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn Session::Session(var Session& this, var NativeProcess* process) {\u000a\u0009\u0009@this.handle = $process;\u000a\u0009};\u000a\u000a\u0009export fn Session::~Session(var Session& this) {\u000a\u0009\u0009rutile_process_dispose(this.handle);\u000a\u0009};\u000a\u000a\u0009export fn Session::valid(Session& this) -> bool {\u000a\u0009\u0009return this.handle != nullptr;\u000a\u0009};\u000a\u000a\u0009export fn Session::write(var Session& this, rt::string_view input) -> void | io_error | rt::allocation_error {\u000a\u0009\u0009using Result = void | io_error | rt::allocation_error;\u000a\u0009\u0009if (!this.handle) {\u000a\u0009\u0009\u0009io_error error;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009i32 failure = rutile_process_write(this.handle, input.data(), input.size());\u000a\u0009\u0009if (failure == 3) {\u000a\u0009\u0009\u0009rt::allocation_error error;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (failure) {\u000a\u0009\u0009\u0009io_error error;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u0009export fn Session::close_input(var Session& this) {\u000a\u0009\u0009if (this.handle) {\u000a\u0009\u0009\u0009rutile_process_close_input(this.handle);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn Session::read(var Session& this, u32 timeout_ms) -> rt::string | io_error | rt::allocation_error {\u000a\u0009\u0009using Outcome = rt::string | io_error | rt::allocation_error;\u000a\u0009\u0009if (!this.handle) {\u000a\u0009\u0009\u0009io_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009var output = rutile_process_read(this.handle, timeout_ms);\u000a\u0009\u0009if (output->error == 3) {\u000a\u0009\u0009\u0009rt::allocation_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (output->error) {\u000a\u0009\u0009\u0009io_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009rt::string bytes;\u000a\u0009\u0009var copied = @bytes.append(rt::string_view(output->data, output->size));\u000a\u0009\u0009if (copied.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Outcome(copied.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009return Outcome($bytes);\u000a\u0009};\u000a\u000a\u0009export fn Session::wait(var Session& this, u32 timeout_ms) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {\u000a\u0009\u0009using Outcome = Result | launch_error | timeout_error | io_error | rt::allocation_error;\u000a\u0009\u0009if (!this.handle) {\u000a\u0009\u0009\u0009launch_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009var output = rutile_process_wait(this.handle, timeout_ms);\u000a\u0009\u0009if (output->state == 3) {\u000a\u0009\u0009\u0009rt::allocation_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (output->state == 4) {\u000a\u0009\u0009\u0009io_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (output->state == 1) {\u000a\u0009\u0009\u0009launch_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (output->state == 2) {\u000a\u0009\u0009\u0009timeout_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009Result result;\u000a\u0009\u0009@result.exit_code = output->exit_code;\u000a\u0009\u0009var copied_output = @result.output.append(rt::string_view(output->output.data, output->output.size));\u000a\u0009\u0009if (copied_output.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Outcome(copied_output.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009var copied_error = @result.error.append(rt::string_view(output->error.data, output->error.size));\u000a\u0009\u0009if (copied_error.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009return Outcome(copied_error.get<rt::allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009return Outcome($result);\u000a\u0009};\u000a\u000a\u0009export fn start(Command& command) -> Session | launch_error | rt::allocation_error {\u000a\u0009\u0009using Outcome = Session | launch_error | rt::allocation_error;\u000a\u0009\u0009rt::buffer<char*> pointers;\u000a\u0009\u0009for (usize index = 0; index < command.arguments.size(); @index = index + 1) {\u000a\u0009\u0009\u0009var appended = @pointers.push_back(command.arguments.data()[index].c_str());\u000a\u0009\u0009\u0009if (appended.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009\u0009return Outcome(appended.get<rt::allocation_error>());\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009rt::buffer<char*> environment;\u000a\u0009\u0009for (usize index = 0; index < command.environment_overrides.size(); @index = index + 1) {\u000a\u0009\u0009\u0009var appended = @environment.push_back(command.environment_overrides.data()[index].c_str());\u000a\u0009\u0009\u0009if (appended.has<rt::allocation_error>()) {\u000a\u0009\u0009\u0009\u0009return Outcome(appended.get<rt::allocation_error>());\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u0009\u0009ProcessStart started;\u000a\u0009\u0009rutile_process_start(pointers.data(), pointers.size(), command.working_directory.c_str(), environment.data(), environment.size(), &@started);\u000a\u0009\u0009if (started.error == 3) {\u000a\u0009\u0009\u0009rt::allocation_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009if (started.error || !started.handle) {\u000a\u0009\u0009\u0009launch_error error;\u000a\u0009\u0009\u0009return Outcome($error);\u000a\u0009\u0009};\u000a\u0009\u0009return Outcome(Session(started.handle));\u000a\u0009};\u000a\u000a\u0009export fn cmd(Command& command) -> Result | launch_error | timeout_error | io_error | rt::allocation_error {\u000a\u0009\u0009using Outcome = Result | launch_error | timeout_error | io_error | rt::allocation_error;\u000a\u0009\u0009var started = start(command);\u000a\u0009\u0009if (started.has<launch_error>()) {\u000a\u0009\u0009\u00