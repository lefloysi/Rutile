export fn buffer<T>::~buffer(var buffer& this) {\r\n\t\t@this.clear();\r\n\t\tfree(this._storage);\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::reserve(var buffer& this, usize required) -> bool {\r\n\t\tif (required <= this._capacity) {\r\n\t\t\treturn true;\r\n\t\t};\r\n\r\n\t\tconst usize element_size = sizeof(T);\r\n\t\tif (element_size && required > usize::max / element_size) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize count = $required;\r\n\t\tif (this._capacity <= (usize::max >> 1)) {\r\n\t\t\tconst usize grown = this._capacity << 1;\r\n\t\t\tif (grown > count && (!element_size || grown <= usize::max / element_size)) {\r\n\t\t\t\t@count = grown;\r\n\t\t\t};\r\n\t\t};\r\n\r\n\t\tusize bytes = count * element_size;\r\n\t\tif (!bytes) {\r\n\t\t\t@bytes = 1;\r\n\t\t};\r\n\r\n\t\tvar T* replacement = static_cast<var T*>(malloc($bytes));\r\n\t\tif (!replacement) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize index = 0;\r\n\t\twhile (index < this._size) {\r\n\t\t\t@replacement[index].T($(this._storage[index]));\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\tfree(this._storage);\r\n\t\t@this._storage = $replacement;\r\n\t\t@this._capacity = $count;\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::push_back(var buffer& this, T value) -> bool {\r\n\t\tif (this._size == usize::max || !@this.reserve(this._size + 1)) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\t@this._storage[this._size].T($value);\r\n\t\t@this._size = this._size + 1;\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::pop_back(var buffer& this) -> bool {\r\n\t\tif (!this._size) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\t@this._size = this._size - 1;\r\n\t\t@this._storage[this._size].~T();\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::clear(var buffer& this) {\r\n\t\tfor (usize index = 0; index < this._size; @index = index + 1) {\r\n\t\t\t@this._storage[index].~T();\r\n\t\t};\r\n\r\n\t\t@this._size = 0;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::size(buffer& this) -> usize {\r\n\t\treturn this._size;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::capacity(buffer& this) -> usize {\r\n\t\treturn this._capacity;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn buffer<T>::data(auto buffer& this) -> const[this] T* {\r\n\t\treturn this._storage;\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\equal.rt","text":"namespace rt {\r\n\ttemplate<typename K>\r\n\texport struct default_equal {\r\n\t\tfn equal(default_equal& this, K& first, K& second) -> bool;\r\n\t};\r\n\r\n\ttemplate<typename K>\r\n\texport fn default_equal<K>::equal(default_equal& this, K& first, K& second) -> bool {\r\n\t\treturn first == second;\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\hash.rt","text":"namespace rt {\r\n\tconst u64 splitmix64_first_multiplier = 13787848793156543929;\r\n\tconst u64 splitmix64_second_multiplier = 10723151780598845931;\r\n\tconst u64 splitmix64_first_shift = 30;\r\n\tconst u64 splitmix64_second_shift = 27;\r\n\tconst u64 splitmix64_final_shift = 31;\r\n\tconst u64 fnv1a64_offset_basis = 14695981039346656037;\r\n\tconst u64 fnv1a64_prime = 1099511628211;\r\n\r\n\texport fn mix_hash(u64 value) -> usize {\r\n\t\t@value = (value ^ (value >> splitmix64_first_shift)) * splitmix64_first_multiplier;\r\n\t\t@value = (value ^ (value >> splitmix64_second_shift)) * splitmix64_second_multiplier;\r\n\r\n\t\treturn static_cast<usize>(value ^ (value >> splitmix64_final_shift));\r\n\t};\r\n\r\n\texport fn hash_value(f32 value, f32* type_token) -> usize {\r\n\t\tif (value == 0.0) {\r\n\t\t\treturn 0;\r\n\t\t};\r\n\r\n\t\treturn mix_hash(static_cast<u64>(*reinterpret_cast<u32*>(&@value)));\r\n\t};\r\n\t\r\n\texport fn hash_value(f64 value, f64* type_token) -> usize {\r\n\t\tif (value == 0.0) {\r\n\t\t\treturn 0;\r\n\t\t};\r\n\r\n\t\treturn mix_hash(*reinterpret_cast<u64*>(&@value));\r\n\t};\r\n\r\n\texport fn hash_value(string_view value, string_view* type_token) -> usize {\r\n\t\tu64 result := fnv1a64_offset_basis;\r\n\t\tusize index = 0;\r\n\t\twhile (index < value.size()) {\r\n\t\t\tchar byte = value.data()[index];\r\n\r\n\t\t\t@result = (result ^ static_cast<u64>(static_cast<u08>($byte))) * fnv1a64_prime;\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\treturn static_cast<usize>(result);\r\n\t};\r\n\r\n\t// Default pointer hashing accepts object pointers through const void*.\r\n\t// Function pointers require an explicit compatible hash policy.\r\n\ttemplate<typename K>\r\n\texport struct default_hash {\r\n\t\tfn hash(default_hash& this, K value) -> usize;\r\n\t};\r\n\r\n\texport fn hash_value(bool value, bool* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(char value, char* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(i08 value, i08* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(i16 value, i16* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(i32 value, i32* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(i64 value, i64* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(u08 value, u08* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(u16 value, u16* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(u32 value, u32* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(u64 value, u64* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(value));\r\n\t};\r\n\r\n\texport fn hash_value(void* value, void* type_token) -> usize {\r\n\t\treturn mix_hash(static_cast<u64>(reinterpret_cast<usize>(value)));\r\n\t};\r\n\r\n\ttemplate<typename K>\r\n\texport fn default_hash<K>::hash(default_hash& this, K value) -> usize {\r\n\t\t// The type token prevents conversions from selecting another primitive hash.\r\n\t\treturn hash_value(value, &value);\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\identifier.rt","text":"\r\n\r\ntemplate<typename Tag, typename vnum, typename gnum>\r\nstruct identifier {\r\n\texport fn identifier(var identifier& this) : [default];\r\n\t\r\n\r\n\tvnum value;\r\n\tgnum generation;\r\n};\r\n\r\n\r\n"},{"module":"std","path":"compiler/std\\json.rt","text":"namespace rt {\r\n\texport enum json_kind : [u08] {\r\n\t\tnull_value;\r\n\t\tboolean;\r\n\t\tnumber;\r\n\t\tstring;\r\n\t\tarray;\r\n\t\tobject;\r\n\t};\r\n\r\n\texport struct json_member {\r\n\t\tfn json_member(var json_member& this, string key, unique<json_value> value);\r\n\t\tfn json_member(var json_member& this, json_member& other) : [delete];\r\n\r\n\t\tstring key;\r\n\t\tunique<json_value> value;\r\n\t};\r\n\r\n\texport using json_array = buffer<unique<json_value>>;\r\n\texport using json_object = buffer<json_member>;\r\n\r\n\texport union json_payload {\r\n\t\tfn json_payload(var json_payload& this) : [default];\r\n\t\tfn ~json_payload(var json_payload& this) : [default];\r\n\r\n\t\tu08 empty;\r\n\t\tbool boolean;\r\n\t\tstring text;\r\n\t\tjson_array array;\r\n\t\tjson_object object;\r\n\t};\r\n\r\n\t// Text is UTF-8. Object keys are unique; set and parsing retain the last duplicate value.\r\n\t// Number spelling is retained without conversion to binary floating point.\r\n\texport struct json_value {\r\n\t\tfn json_value(var json_value& this) : [default];\r\n\t\tfn json_value(var json_value& this, json_value& other) : [delete];\r\n\t\tfn ~json_value(var json_value& this);\r\n\r\n\t\tfn make_null() -> unique<json_value>;\r\n\t\tfn make_boolean(bool value) -> unique<json_value>;\r\n\t\tfn make_number(string_view value) -> unique<json_value>;\r\n\t\tfn make_integer(i64 value) -> unique<json_value>;\r\n\t\tfn make_unsigned(u64 value) -> unique<json_value>;\r\n\t\tfn clone(json_value& this) -> unique<json_value>;\r\n\t\tfn make_string(string_view value) -> unique<json_value>;\r\n\t\tfn make_array() -> unique<json_value>;\r\n\t\tfn make_object() -> unique<json_value>;\r\n\t\tfn append(var json_value& this, unique<json_value> value) -> bool;\r\n\t\tfn set(var json_value& this, string_view key, unique<json_value> value) -> bool;\r\n\r\n\t\tfn kind(json_value& this) -> json_kind;\r\n\t\tfn text(json_value& this) -> string_view;\r\n\t\tfn boolean(json_value& this) -> bool;\r\n\t\tfn integer(json_value& this, var i64& result) -> bool;\r\n\t\tfn member(json_value& this, string_view key) -> json_value*;\r\n\t\tfn item(json_value& this, usize index) -> json_value*;\r\n\t\tfn key(json_value& this, usize index) -> string_view;\r\n\t\tfn size(json_value& this) -> usize;\r\n\r\n\tprivate:\r\n\t\tjson_kind tag;\r\n\t\tjson_payload payload;\r\n\t};\r\n\r\n\texport struct json_document {\r\n\t\tfn json_document(var json_document& this) : [default];\r\n\t\tfn json_document(var json_document& this, unique<json_value> root, usize offset, string error);\r\n\t\tfn json_document(var json_document& this, json_document& other) : [delete];\r\n\r\n\t\tfn value(json_document& this) -> json_value*;\r\n\t\tfn release(var json_document& this) -> unique<json_value>;\r\n\t\tfn error(json_document& this) -> string_view;\r\n\t\tfn error_offset(json_document& this) -> usize;\r\n\r\n\tprivate:\r\n\t\tunique<json_value> root;\r\n\t\tusize offset;\r\n\t\tstring failure;\r\n\t};\r\n\r\n\texport struct json_parser {\r\n\t\tfn json_parser(var json_parser& this, string_view text);\r\n\t\tfn parse(var json_parser& this) -> json_document;\r\n\r\n\tprivate:\r\n\t\tstring_view input;\r\n\t\tusize cursor;\r\n\t\tusize failure_offset;\r\n\t\tstring failure;\r\n\r\n\t\tfn whites