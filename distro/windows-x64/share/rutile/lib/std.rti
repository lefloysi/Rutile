usize required) -> void | allocation_error;\u000a\u000a\u0009\u0009fn size(string& this) -> usize;\u000a\u0009\u0009fn capacity(string& this) -> usize;\u000a\u0009\u0009fn empty(string& this) -> bool;\u000a\u0009\u0009fn data(auto string& this) -> const[this] char*;\u000a\u0009\u0009fn c_str(string& this) -> char*;\u000a\u0009\u0009fn view(string& this) -> string_view;\u000a\u0009\u0009fn contains(string& this, string_view text) -> bool;\u000a\u0009\u0009fn trim(string& this) -> string_view;\u000a\u000a\u0009private:\u000a\u0009\u0009string_storage storage;\u000a\u0009\u0009usize length;\u000a\u0009\u0009// Zero selects inline storage; heap capacity excludes the terminating NUL.\u000a\u0009\u0009usize heap_capacity;\u000a\u0009};\u000a\u000a\u0009export fn string_view::string_view(var string_view& this, string& text) {\u000a\u0009\u0009@this.bytes = text.data();\u000a\u0009\u0009@this.length = text.size();\u000a\u0009};\u000a\u000a\u0009export fn operator+(string_view first, string_view second) -> string {\u000a\u0009\u0009string result;\u000a\u0009\u0009if (second.size() > usize::max - first.size()) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009throw $error;\u000a\u0009\u0009};\u000a\u0009\u0009var reserved = @result.reserve(first.size() + second.size());\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(reserved.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009\u0009@result.append(first);\u000a\u0009\u0009@result.append(second);\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009export fn string::reserve(var string& this, usize required) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009if (required <= this.capacity()) {\u000a\u0009\u0009\u0009return Result();\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize maximum = usize::max - 1;\u000a\u0009\u0009if (required > maximum) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = required;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize count = $required;\u000a\u0009\u0009usize capacity = this.capacity();\u000a\u0009\u0009usize half = capacity >> 1;\u000a\u0009\u0009if (capacity > maximum - half) {\u000a\u0009\u0009\u0009@count = $maximum;\u000a\u0009\u0009}\u000a\u0009\u0009else if (capacity + half > count) {\u000a\u0009\u0009\u0009@count = capacity + half;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009var char* replacement = static_cast<var char*>(malloc(count + 1));\u000a\u0009\u0009if (!replacement) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = count + 1;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@replacement = static_cast<var char*>(memcpy(replacement, this.data(), this.length + 1));\u000a\u0009\u0009if (this.heap_capacity) {\u000a\u0009\u0009\u0009free(this.storage.heap);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this.storage.heap = $replacement;\u000a\u0009\u0009@this.heap_capacity = $count;\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009export fn string::append(var string& this, string_view text) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009if (text.empty()) {\u000a\u0009\u0009\u0009return Result();\u000a\u0009\u0009};\u000a\u000a\u0009\u0009if (text.size() > usize::max - this.length - 1) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009char* source = text.data();\u000a\u0009\u0009usize address = reinterpret_cast<usize>(source);\u000a\u0009\u0009usize begin = reinterpret_cast<usize>(this.data());\u000a\u0009\u0009bool aliases = address >= begin && address - begin <= this.length;\u000a\u0009\u0009usize offset = 0;\u000a\u0009\u0009if (aliases) {\u000a\u0009\u0009\u0009@offset = address - begin;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize length = this.length + text.size();\u000a\u0009\u0009var reserved = @this.reserve(length);\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009return $reserved;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009var char* destination = (@this).data();\u000a\u0009\u0009if (aliases) {\u000a\u0009\u0009\u0009@source = destination + offset;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009var char* appended = static_cast<var char*>(memmove(destination + this.length, source, text.size()));\u000a\u0009\u0009@appended[text.size()] = '\\0';\u000a\u0009\u0009@this.length = $length;\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a\u000a\u0009export fn string::string(var string& this, string& other) {\u000a\u0009\u0009var appended = @this.append(other.view());\u000a\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(appended.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn string::string(var string& this, string_view text) {\u000a\u0009\u0009var appended = @this.append(text);\u000a\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(appended.get<allocation_error>());\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn string::~string(var string& this) {\u000a\u0009\u0009if (this.heap_capacity) {\u000a\u0009\u0009\u0009free(this.storage.heap);\u000a\u0009\u0009};\u000a\u0009};\u000a\u000a\u0009export fn string::operator:=(var string& this, string& other) -> var string& {\u000a\u0009\u0009string replacement;\u000a\u0009\u0009var appended = @replacement.append(other.view());\u000a\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009throw allocation_error(appended.get<allocation_error>());\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this = $replacement;\u000a\u000a\u0009\u0009return @this;\u000a\u0009};\u000a\u000a\u0009export fn string::size(string& this) -> usize {\u000a\u0009\u0009return this.length;\u000a\u0009};\u000a\u000a\u0009export fn string::capacity(string& this) -> usize {\u000a\u0009\u0009if (this.heap_capacity) {\u000a\u0009\u0009\u0009return this.heap_capacity;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return 15;\u000a\u0009};\u000a\u000a\u0009export fn string::empty(string& this) -> bool {\u000a\u0009\u0009return !this.length;\u000a\u0009};\u000a\u000a\u0009export fn string::data(auto string& this) -> const[this] char* {\u000a\u0009\u0009if (this.heap_capacity) {\u000a\u0009\u0009\u0009return this.storage.heap;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return &@this.storage.inline_bytes[0];\u000a\u0009};\u000a\u000a\u0009export fn string::c_str(string& this) -> char* {\u000a\u0009\u0009return this.data();\u000a\u0009};\u000a\u000a\u0009export fn string::view(string& this) -> string_view {\u000a\u0009\u0009return string_view(this.data(), this.length);\u000a\u0009};\u000a\u000a\u0009export fn string::contains(string& this, string_view text) -> bool {\u000a\u0009\u0009string_view view = this;\u000a\u0009\u0009return view.contains(text);\u000a\u0009};\u000a\u000a\u0009export fn string::trim(string& this) -> string_view {\u000a\u0009\u0009string_view view = this;\u000a\u0009\u0009return view.trim();\u000a\u0009};\u000a\u000a\u0009export fn string::clear(var string& this) {\u000a\u0009\u0009@this.length = 0;\u000a\u0009\u0009var char* bytes = (@this).data();\u000a\u0009\u0009@bytes[0] = '\\0';\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/string_view.rt","text":"namespace rt {\u000d\u000a\u0009export struct string_view {\u000d\u000a\u0009\u0009fn string_view(var string_view& this) : [default];\u000d\u000a\u0009\u0009fn string_view(var string_view& this, string_view& other) : [implicit, default];\u000d\u000a\u0009\u0009fn string_view(var string_view& this, string& text) : [implicit];\u000d\u000a\u0009\u0009fn string_view(var string_view& this, char* data, usize size);\u000d\u000a\u000d\u000a\u0009\u0009fn data(string_view& this) -> char*;\u000d\u000a\u0009\u0009fn size(string_view& this) -> usize;\u000d\u000a\u0009\u0009fn empty(string_view& this) -> bool;\u000d\u000a\u0009\u0009fn slice(string_view& this, usize begin, usize count) -> string_view;\u000d\u000a\u0009\u0009fn compare(string_view& this, string_view other) -> i32;\u000d\u000a\u0009\u0009fn contains(string_view& this, string_view text) -> bool;\u000d\u000a\u0009\u0009fn trim(string_view& this) -> string_view;\u000d\u000a\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009char* bytes;\u000d\u000a\u0009\u0009usize length;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator==(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return !first.compare(second);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator!=(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return first.compare(second) != 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator<(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return first.compare(second) < 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator<=(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return first.compare(second) <= 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator>(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return first.compare(second) > 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn operator>=(string_view first, string_view second) -> bool {\u000d\u000a\u0009\u0009return first.compare(second) >= 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::string_view(var string_view& this, char* data, usize size) {\u000d\u000a\u0009\u0009@this.bytes = $data;\u000d\u000a\u0009\u0009@this.length = $size;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn from_c_string(char* text) -> string_view {\u000d\u000a\u0009\u0009usize length = 0;\u000d\u000a\u0009\u0009while (text && text[length]) {\u000d\u000a\u0009\u0009\u0009@length = length + 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return string_view(text, length);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::data(string_view& this) -> char* {\u000d\u000a\u0009\u0009return this.bytes;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::size(string_view& this) -> usize {\u000d\u000a\u0009\u0009return this.length;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::empty(string_view& this) -> bool {\u000d\u000a\u0009\u0009return !this.length;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::slice(string_view& this, usize begin, usize count) -> string_view {\u000d\u000a\u0009\u0009return string_view(this.bytes + begin, $count);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::compare(string_view& this, string_view other) -> i32 {\u000d\u000a\u0009\u0009usize count := this.length;\u000d\u000a\u0009\u0009if (other.length < count) {\u000d\u000a\u0009\u0009\u0009@count := other.length;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009usize index = 0;\u000d\u000a\u0009\u0009while (index < count) {\u000d\u000a\u0009\u0009\u0009char first_byte := this.bytes[index];\u000d\u000a\u0009\u0009\u0009char second_byte := other.bytes[index];\u000d\u000a\u0009\u0009\u0009u08 first = static_cast<u08>($first_byte);\u000d\u000a\u0009\u0009\u0009u08 second = static_cast<u08>($second_byte);\u000d\u000a\u0009\u0009\u0009if (first < second) {\u000d\u000a\u0009\u0009\u0009\u0009return -1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009\u0009if (first > second) {\u000d\u000a\u0009\u0009\u0009\u0009return 1;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009\u0009@index = index + 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009if (this.length < other.length) {\u000d\u000a\u0009\u0009\u0009return -1;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009if (this.length > other.length) {\u000d\u000a\u0009\u0009\u0009return 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u000d\u000a\u0009\u0009return 0;\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::trim(string_view& this) -> string_view {\u000d\u000a\u0009\u0009usize begin = 0;\u000d\u000a\u0009\u0009usize end = this.length;\u000d\u000a\u0009\u0009for (; begin < end; @begin = begin + 1) {\u000d\u000a\u0009\u0009\u0009char value = this.bytes[begin];\u000d\u000a\u0009\u0009\u0009if (value != ' ' && value != '\\t' && value != '\\r' && value != '\\n' && value != char(11) && value != char(12)) {\u000d\u000a\u0009\u0009\u0009\u0009break;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009for (; end > begin; @end = end - 1) {\u000d\u000a\u0009\u0009\u0009char value = this.bytes[end - 1];\u000d\u000a\u0009\u0009\u0009if (value != ' ' && value != '\\t' && value != '\\r' && value != '\\n' && value != char(11) && value != char(12)) {\u000d\u000a\u0009\u0009\u0009\u0009break;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009return this.slice(begin, end - begin);\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009export fn string_view::contains(string_view& this, string_view text) -> bool {\u000d\u000a\u0009\u0009if (text.size() > this.length) {\u000d\u000a\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009usize last = this.length - text.size();\u000d\u000a\u0009\u0009usize index = 0;\u000d\u000a\u0009\u0009while (true) {\u000d\u000a\u0009\u0009\u0009if (this.slice(index, text.size()) == text) {\u000d\u000a\u0009\u0009\u0009\u0009return true;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009if (index == last) {\u000d\u000a\u0009\u0009\u0009\u0009return false;\u000d\u000a\u0009\u0009\u0009};\u000d\u000a\u0009\u0009\u0009@index = index + 1;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/swap.rt","text":"namespace rt {\u000d\u000a\u0009template<typename T>\u000d\u000a\u0009export fn swap(var T& first, var T& second) {\u000d\u000a\u0009\u0009if (&first == &second) {\u000d\u000a\u0009\u0009\u0009return;\u000d\u000a\u0009\u0009};\u000d\u000a\u0009\u0009var T* first_pointer = &@first;\u000d\u000a\u0009\u0009var T* second_pointer = &@second;\u000d\u000a\u0009\u0009T temporary = $*first_pointer;\u000d\u000a\u0009\u0009@first_pointer[0].T($second_pointer[0]);\u000d\u000a\u0009\u0009@second_pointer[0].T($temporary);\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/tuple.rt","text":"namespace rt {\u000d\u000a\u0009template<typename...Ts>\u000d\u000a\u0009export struct tuple {\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009Ts... _elements;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/unique.rt","text":"namespace rt {\u000a\u0009template<typename T>\u000a\u0009export struct default_delete {\u000a\u0009\u0009fn dispose(var T* pointer);\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D = default_delete<T>>\u000a\u0009export struct unique {\u000a\u0009\u0009fn unique(var unique& this) : [default];\u000a\u0009\u0009fn unique(var unique& this, var T* pointer);\u000a\u0009\u0009fn unique(var unique& this, unique& other) : [delete];\u000a\u0009\u0009fn operator=(var unique& this, unique& other) -> var unique& : [delete];\u000a\u0009\u0009fn operator:=(var unique& this, unique& other) -> var unique& : [delete];\u000a\u0009\u0009fn ~unique(var unique& this);\u000a\u0009\u0009fn make() -> unique;\u000a\u000a\u0009\u0009fn release(var unique& this) -> var T*;\u000a\u0009\u0009fn reset(var unique& this, var T* pointer);\u000a\u000a\u0009\u0009fn get(unique& this) -> var T*;\u000a\u000a\u0009private:\u000a\u0009\u0009var T* pointer;\u000a\u0009};\u000a\u000a\u0009template<typename T>\u000a\u0009export fn default_delete<T>::dispose(var T* pointer) {\u000a\u0009\u0009delete pointer;\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::unique(var unique& this, var T* pointer) {\u000a\u0009\u0009@this.pointer = $pointer;\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::~unique(var unique& this) {\u000a\u0009\u0009@this.reset(nullptr);\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::get(unique& this) -> var T* {\u000a\u0009\u0009return this.pointer;\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::release(var unique& this) -> var T* {\u000a\u0009\u0009var T* result := this.pointer;\u000a\u000a\u0009\u0009@this.pointer = nullptr;\u000a\u000a\u0009\u0009return $result;\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::reset(var unique& this, var T* pointer) {\u000a\u0009\u0009var T* previous := this.pointer;\u000a\u000a\u0009\u0009@this.pointer = $pointer;\u000a\u0009\u0009D::dispose($previous);\u000a\u0009};\u000a\u000a\u0009template<typename T, typename D>\u000a\u0009export fn unique<T, D>::make() -> unique {\u000a\u0009\u0009var pointer = new var T();\u000a\u0009\u0009if (!pointer) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = sizeof(T);\u000a\u0009\u0009\u0009throw $error;\u000a\u0009\u0009};\u000a\u0009\u0009return unique($pointer);\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/unordered_map.rt","text":"namespace rt {\u000a\u0009template<typename T>\u000a\u0009export union unordered_slot {\u000a\u0009\u0009fn unordered_slot(var unordered_slot& this) : [default];\u000a\u0009\u0009fn ~unordered_slot(var unordered_slot& this) : [default];\u000a\u000a\u0009\u0009u08 empty;\u000a\u0009\u0009T object;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V>\u000a\u0009export struct unordered_node {\u000a\u0009\u0009fn unordered_node(var unordered_node& this, K key, V value, usize code);\u000a\u0009\u0009fn ~unordered_node(var unordered_node& this);\u000a\u000a\u0009\u0009unordered_slot<K> key;\u000a\u0009\u0009unordered_slot<V> value;\u000a\u0009\u0009var unordered_node* next;\u000a\u0009\u0009usize hash_code;\u000a\u0009};\u000a\u000a\u0009// Equal must define an equivalence relation; equivalent keys must have equal hashes.\u000a\u0009// Hash and Equal are called through const references and must remain stable while keys are stored.\u000a\u0009// Key storage borrowed by a key (such as string_view bytes) must remain valid and unchanged.\u000a\u0009// Insert consumes both arguments, returning false for an existing key and allocation_error on storage failure.\u000a\u0009// Pointers returned by find survive insert/reserve and moves of their owning map.\u000a\u0009// Erase invalidates only the erased value; clear and destruction invalidate all values.\u000a\u0009template<typename K, typename V, typename Hash = default_hash<K>, typename Equal = default_equal<K>>\u000a\u0009export struct unordered_map {\u000a\u0009\u0009fn unordered_map(var unordered_map& this);\u000a\u0009\u0009fn unordered_map(var unordered_map& this, Hash hash, Equal equal);\u000a\u0009\u0009fn unordered_map(var unordered_map& this, unordered_map& other) : [delete];\u000a\u0009\u0009fn operator=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];\u000a\u0009\u0009fn operator:=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];\u000a\u0009\u0009fn ~unordered_map(var unordered_map& this);\u000a\u000a\u0009\u0009fn insert(var unordered_map& this, K key, V value) -> bool | allocation_error;\u000a\u0009\u0009fn erase(var unordered_map& this, K& key) -> bool;\u000a\u0009\u0009fn clear(var unordered_map& this);\u000a\u0009\u0009fn reserve(var unordered_map& this, usize required) -> void | allocation_error;\u000a\u000a\u0009\u0009fn size(unordered_map& this) -> usize;\u000a\u0009\u0009fn empty(unordered_map& this) -> bool;\u000a\u0009\u0009fn find(auto unordered_map& this, K& key) -> const[this] V*;\u000a\u000a\u0009private:\u000a\u0009\u0009buffer<var unordered_node<K, V>*> buckets;\u000a\u0009\u0009unordered_slot<Hash> hasher;\u000a\u0009\u0009unordered_slot<Equal> comparison;\u000a\u0009\u0009usize length;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V>\u000a\u0009export fn unordered_node<K, V>::unordered_node(var unordered_node& this, K key, V value, usize code) {\u000a\u0009\u0009@this.key.object.K($key);\u000a\u0009\u0009@this.value.object.V($value);\u000a\u0009\u0009@this.hash_code = $code;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V>\u000a\u0009export fn unordered_node<K, V>::~unordered_node(var unordered_node& this) {\u000a\u0009\u0009@this.value.object.~V();\u000a\u0009\u0009@this.key.object.~K();\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this) {\u000a\u0009\u0009@this.hasher.unordered_slot<Hash>();\u000a\u0009\u0009@this.comparison.unordered_slot<Equal>();\u000a\u0009\u0009@this.hasher.object.Hash();\u000a\u0009\u0009@this.comparison.object.Equal();\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this, Hash hash, Equal equal) {\u000a\u0009\u0009@this.hasher.unordered_slot<Hash>();\u000a\u0009\u0009@this.comparison.unordered_slot<Equal>();\u000a\u0009\u0009@this.hasher.object.Hash($hash);\u000a\u0009\u0009@this.comparison.object.Equal($equal);\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::~unordered_map(var unordered_map& this) {\u000a\u0009\u0009@this.clear();\u000a\u0009\u0009@this.comparison.object.~Equal();\u000a\u0009\u0009@this.hasher.object.~Hash();\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::size(unordered_map& this) -> usize {\u000a\u0009\u0009return this.length;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::empty(unordered_map& this) -> bool {\u000a\u0009\u0009return !this.length;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::find(auto unordered_map& this, K& key) -> const[this] V* {\u000a\u0009\u0009if (!this.buckets.size()) {\u000a\u0009\u0009\u0009return nullptr;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize code = this.hasher.object.hash(key);\u000a\u0009\u0009usize index = code % this.buckets.size();\u000a\u0009\u0009var unordered_node<K, V>* node = this.buckets.data()[index];\u000a\u0009\u0009while (node) {\u000a\u0009\u0009\u0009if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {\u000a\u0009\u0009\u0009\u0009return const_cast<const[this] V*>(&@node->value.object);\u000a\u0009\u0009\u0009};\u000a\u000a\u0009\u0009\u0009@node = node->next;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return nullptr;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::insert(var unordered_map& this, K key, V value) -> bool | allocation_error {\u000a\u0009\u0009using Result = bool | allocation_error;\u000a\u0009\u0009if (this.find(key)) {\u000a\u0009\u0009\u0009return Result(false);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009if (this.length == usize::max) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize code = this.hasher.object.hash(key);\u000a\u0009\u0009var reserved = @this.reserve(this.length + 1);\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009return Result(reserved.get<allocation_error>());\u000a\u0009\u0009};\u000a\u000a\u0009\u0009using Node = unordered_node<K, V>;\u000a\u0009\u0009var Node* node = static_cast<var Node*>(malloc(sizeof(Node)));\u000a\u0009\u0009if (!node) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = sizeof(Node);\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@node->Node($key, $value, $code);\u000a\u000a\u0009\u0009usize index = node->hash_code % this.buckets.size();\u000a\u000a\u0009\u0009@node->next = this.buckets.data()[index];\u000a\u0009\u0009@(@this.buckets).data()[index] = node;\u000a\u0009\u0009@this.length = this.length + 1;\u000a\u000a\u0009\u0009return Result(true);\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::erase(var unordered_map& this, K& key) -> bool {\u000a\u0009\u0009if (!this.buckets.size()) {\u000a\u0009\u0009\u0009return false;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize code = this.hasher.object.hash(key);\u000a\u0009\u0009usize index = code % this.buckets.size();\u000a\u0009\u0009var (var unordered_node<K, V>*)* link = &@(@this.buckets).data()[index];\u000a\u0009\u0009while (*link) {\u000a\u0009\u0009\u0009var unordered_node<K, V>* node = *link;\u000a\u0009\u0009\u0009if (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {\u000a\u0009\u0009\u0009\u0009@*link = node->next;\u000a\u000a\u0009\u0009\u0009\u0009using Node = unordered_node<K, V>;\u000a\u000a\u0009\u0009\u0009\u0009@node->~Node();\u000a\u0009\u0009\u0009\u0009free(node);\u000a\u0009\u0009\u0009\u0009@this.length = this.length - 1;\u000a\u000a\u0009\u0009\u0009\u0009return true;\u000a\u0009\u0009\u0009};\u000a\u000a\u0009\u0009\u0009@link = &@node->next;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009return false;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::clear(var unordered_map& this) {\u000a\u0009\u0009usize index = 0;\u000a\u0009\u0009while (index < this.buckets.size()) {\u000a\u0009\u0009\u0009var unordered_node<K, V>* node = this.buckets.data()[index];\u000a\u0009\u0009\u0009while (node) {\u000a\u0009\u0009\u0009\u0009var unordered_node<K, V>* next = node->next;\u000a\u0009\u0009\u0009\u0009using Node = unordered_node<K, V>;\u000a\u000a\u0009\u0009\u0009\u0009@node->~Node();\u000a\u0009\u0009\u0009\u0009free(node);\u000a\u0009\u0009\u0009\u0009@node = next;\u000a\u0009\u0009\u0009};\u000a\u000a\u0009\u0009\u0009@(@this.buckets).data()[index] = nullptr;\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this.length = 0;\u000a\u0009};\u000a\u000a\u0009template<typename K, typename V, typename Hash, typename Equal>\u000a\u0009export fn unordered_map<K, V, Hash, Equal>::reserve(var unordered_map& this, usize required) -> void | allocation_error {\u000a\u0009\u0009using Result = void | allocation_error;\u000a\u0009\u0009if (required <= this.buckets.size()) {\u000a\u0009\u0009\u0009return Result();\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize maximum = usize::max / sizeof(var unordered_node<K, V>*);\u000a\u0009\u0009if (required > maximum) {\u000a\u0009\u0009\u0009allocation_error error;\u000a\u0009\u0009\u0009@error.requested_bytes = usize::max;\u000a\u0009\u0009\u0009return Result($error);\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize count = $required;\u000a\u0009\u0009if (count < 8) {\u000a\u0009\u0009\u0009@count = 8;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009if (this.buckets.size() <= (maximum >> 1)) {\u000a\u0009\u0009\u0009usize grown = this.buckets.size() << 1;\u000a\u0009\u0009\u0009if (grown > count) {\u000a\u0009\u0009\u0009\u0009@count = grown;\u000a\u0009\u0009\u0009};\u000a\u0009\u0009};\u000a\u000a\u0009\u0009buffer<var unordered_node<K, V>*> replacement;\u000a\u0009\u0009var reserved = @replacement.reserve(count);\u000a\u0009\u0009if (reserved.has<allocation_error>()) {\u000a\u0009\u0009\u0009return $reserved;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009usize index = 0;\u000a\u0009\u0009while (index < count) {\u000a\u0009\u0009\u0009var appended = @replacement.push_back(nullptr);\u000a\u0009\u0009\u0009if (appended.has<allocation_error>()) {\u000a\u0009\u0009\u0009\u0009return $appended;\u000a\u0009\u0009\u0009};\u000a\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@index = 0;\u000a\u0009\u0009while (index < this.buckets.size()) {\u000a\u0009\u0009\u0009var unordered_node<K, V>* node = this.buckets.data()[index];\u000a\u0009\u0009\u0009while (node) {\u000a\u0009\u0009\u0009\u0009var unordered_node<K, V>* next = node->next;\u000a\u0009\u0009\u0009\u0009usize bucket = node->hash_code % count;\u000a\u000a\u0009\u0009\u0009\u0009@node->next = replacement.data()[bucket];\u000a\u0009\u0009\u0009\u0009@(@replacement).data()[bucket] = node;\u000a\u0009\u0009\u0009\u0009@node = next;\u000a\u0009\u0009\u0009};\u000a\u000a\u0009\u0009\u0009@index = index + 1;\u000a\u0009\u0009};\u000a\u000a\u0009\u0009@this.buckets = $replacement;\u000a\u000a\u0009\u0009return Result();\u000a\u0009};\u000a};\u000a","module":"std"},{"path":"C:/Users/lefloysi/Documents/Projects/Rutile/build/verification/errors123-review/poststack-source/std/variant.rt","text":"namespace rt {\u000d\u000a\u0009export struct monostate {\u000d\u000a\u0009};\u000d\u000a\u000d\u000a\u0009template<typename...Ts>\u000d\u000a\u0009export struct variant {\u000d\u000a\u0009private:\u000d\u000a\u0009\u0009union {\u000d\u000a\u0009\u0009\u0009Ts... _elements;\u000d\u000a\u0009\u0009} _storage;\u000d\u000a\u0009\u0009usize _index;\u000d\u000a\u0009};\u000d\u000a};\u000d\u000a","module":"std"}]}