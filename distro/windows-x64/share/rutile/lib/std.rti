rst = static_cast<u08>($first_byte);\r\n\t\t\tu08 second = static_cast<u08>($second_byte);\r\n\t\t\tif (first < second) {\r\n\t\t\t\treturn -1;\r\n\t\t\t};\r\n\r\n\t\t\tif (first > second) {\r\n\t\t\t\treturn 1;\r\n\t\t\t};\r\n\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\tif (this.length < other.length) {\r\n\t\t\treturn -1;\r\n\t\t};\r\n\r\n\t\tif (this.length > other.length) {\r\n\t\t\treturn 1;\r\n\t\t};\r\n\r\n\t\treturn 0;\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\tuple.rt","text":"namespace rt {\r\n\ttemplate<typename...Ts>\r\n\texport struct tuple {\r\n\tprivate:\r\n\t\tTs... _elements;\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\unique.rt","text":"namespace rt {\r\n\ttemplate<typename T>\r\n\texport struct default_delete {\r\n\t\tfn dispose(var T* pointer);\r\n\t};\r\n\r\n\ttemplate<typename T, typename D = default_delete<T>>\r\n\texport struct unique {\r\n\t\tfn unique(var unique& this) : [default];\r\n\t\tfn unique(var unique& this, var T* pointer);\r\n\t\tfn unique(var unique& this, unique& other) : [delete];\r\n\t\tfn operator=(var unique& this, unique& other) -> var unique& : [delete];\r\n\t\tfn operator:=(var unique& this, unique& other) -> var unique& : [delete];\r\n\t\tfn ~unique(var unique& this);\r\n\t\tfn make() -> unique;\r\n\r\n\t\tfn release(var unique& this) -> var T*;\r\n\t\tfn reset(var unique& this, var T* pointer);\r\n\r\n\t\tfn get(unique& this) -> var T*;\r\n\r\n\tprivate:\r\n\t\tvar T* pointer;\r\n\t};\r\n\r\n\ttemplate<typename T>\r\n\texport fn default_delete<T>::dispose(var T* pointer) {\r\n\t\tdelete pointer;\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::unique(var unique& this, var T* pointer) {\r\n\t\t@this.pointer = $pointer;\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::~unique(var unique& this) {\r\n\t\t@this.reset(nullptr);\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::get(unique& this) -> var T* {\r\n\t\treturn this.pointer;\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::release(var unique& this) -> var T* {\r\n\t\tvar T* result := this.pointer;\r\n\r\n\t\t@this.pointer = nullptr;\r\n\r\n\t\treturn $result;\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::reset(var unique& this, var T* pointer) {\r\n\t\tvar T* previous := this.pointer;\r\n\r\n\t\t@this.pointer = $pointer;\r\n\t\tD::dispose($previous);\r\n\t};\r\n\r\n\ttemplate<typename T, typename D>\r\n\texport fn unique<T, D>::make() -> unique {\r\n\t\treturn unique(new var T());\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\unordered_map.rt","text":"namespace rt {\r\n\ttemplate<typename T>\r\n\texport union unordered_slot {\r\n\t\tfn unordered_slot(var unordered_slot& this) : [default];\r\n\t\tfn ~unordered_slot(var unordered_slot& this) : [default];\r\n\r\n\t\tu08 empty;\r\n\t\tT object;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V>\r\n\texport struct unordered_node {\r\n\t\tfn unordered_node(var unordered_node& this, K key, V value, usize code);\r\n\t\tfn ~unordered_node(var unordered_node& this);\r\n\r\n\t\tunordered_slot<K> key;\r\n\t\tunordered_slot<V> value;\r\n\t\tvar unordered_node* next;\r\n\t\tusize hash_code;\r\n\t};\r\n\r\n\t// Equal must define an equivalence relation; equivalent keys must have equal hashes.\r\n\t// Hash and Equal are called through const references and must remain stable while keys are stored.\r\n\t// Key storage borrowed by a key (such as string_view bytes) must remain valid and unchanged.\r\n\t// Insert consumes both arguments, returning false on duplicate or allocation failure.\r\n\t// Pointers returned by find survive insert/reserve and moves of their owning map.\r\n\t// Erase invalidates only the erased value; clear and destruction invalidate all values.\r\n\ttemplate<typename K, typename V, typename Hash = default_hash<K>, typename Equal = default_equal<K>>\r\n\texport struct unordered_map {\r\n\t\tfn unordered_map(var unordered_map& this);\r\n\t\tfn unordered_map(var unordered_map& this, Hash hash, Equal equal);\r\n\t\tfn unordered_map(var unordered_map& this, unordered_map& other) : [delete];\r\n\t\tfn operator=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];\r\n\t\tfn operator:=(var unordered_map& this, unordered_map& other) -> var unordered_map& : [delete];\r\n\t\tfn ~unordered_map(var unordered_map& this);\r\n\r\n\t\tfn insert(var unordered_map& this, K key, V value) -> bool;\r\n\t\tfn erase(var unordered_map& this, K& key) -> bool;\r\n\t\tfn clear(var unordered_map& this);\r\n\t\tfn reserve(var unordered_map& this, usize required) -> bool;\r\n\r\n\t\tfn size(unordered_map& this) -> usize;\r\n\t\tfn empty(unordered_map& this) -> bool;\r\n\t\tfn find(auto unordered_map& this, K& key) -> const[this] V*;\r\n\r\n\tprivate:\r\n\t\tbuffer<var unordered_node<K, V>*> buckets;\r\n\t\tunordered_slot<Hash> hasher;\r\n\t\tunordered_slot<Equal> comparison;\r\n\t\tusize length;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V>\r\n\texport fn unordered_node<K, V>::unordered_node(var unordered_node& this, K key, V value, usize code) {\r\n\t\t@this.key.object.K($key);\r\n\t\t@this.value.object.V($value);\r\n\t\t@this.hash_code = $code;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V>\r\n\texport fn unordered_node<K, V>::~unordered_node(var unordered_node& this) {\r\n\t\t@this.value.object.~V();\r\n\t\t@this.key.object.~K();\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this) {\r\n\t\t@this.hasher.unordered_slot<Hash>();\r\n\t\t@this.comparison.unordered_slot<Equal>();\r\n\t\t@this.hasher.object.Hash();\r\n\t\t@this.comparison.object.Equal();\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::unordered_map(var unordered_map& this, Hash hash, Equal equal) {\r\n\t\t@this.hasher.unordered_slot<Hash>();\r\n\t\t@this.comparison.unordered_slot<Equal>();\r\n\t\t@this.hasher.object.Hash($hash);\r\n\t\t@this.comparison.object.Equal($equal);\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::~unordered_map(var unordered_map& this) {\r\n\t\t@this.clear();\r\n\t\t@this.comparison.object.~Equal();\r\n\t\t@this.hasher.object.~Hash();\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::size(unordered_map& this) -> usize {\r\n\t\treturn this.length;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::empty(unordered_map& this) -> bool {\r\n\t\treturn !this.length;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::find(auto unordered_map& this, K& key) -> const[this] V* {\r\n\t\tif (!this.buckets.size()) {\r\n\t\t\treturn nullptr;\r\n\t\t};\r\n\r\n\t\tusize code = this.hasher.object.hash(key);\r\n\t\tusize index = code % this.buckets.size();\r\n\t\tvar unordered_node<K, V>* node = this.buckets.data()[index];\r\n\t\twhile (node) {\r\n\t\t\tif (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {\r\n\t\t\t\treturn const_cast<const[this] V*>(&@node->value.object);\r\n\t\t\t};\r\n\r\n\t\t\t@node = node->next;\r\n\t\t};\r\n\r\n\t\treturn nullptr;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::insert(var unordered_map& this, K key, V value) -> bool {\r\n\t\tif (this.find(key) || this.length == usize::max) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize code = this.hasher.object.hash(key);\r\n\t\tif (!@this.reserve(this.length + 1)) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusing Node = unordered_node<K, V>;\r\n\t\tvar Node* node = static_cast<var Node*>(malloc(sizeof(Node)));\r\n\t\tif (!node) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\t@node->Node($key, $value, $code);\r\n\r\n\t\tusize index = node->hash_code % this.buckets.size();\r\n\r\n\t\t@node->next = this.buckets.data()[index];\r\n\t\t@(@this.buckets).data()[index] = node;\r\n\t\t@this.length = this.length + 1;\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::erase(var unordered_map& this, K& key) -> bool {\r\n\t\tif (!this.buckets.size()) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize code = this.hasher.object.hash(key);\r\n\t\tusize index = code % this.buckets.size();\r\n\t\tvar (var unordered_node<K, V>*)* link = &@(@this.buckets).data()[index];\r\n\t\twhile (*link) {\r\n\t\t\tvar unordered_node<K, V>* node = *link;\r\n\t\t\tif (node->hash_code == code && this.comparison.object.equal(node->key.object, key)) {\r\n\t\t\t\t@*link = node->next;\r\n\r\n\t\t\t\tusing Node = unordered_node<K, V>;\r\n\r\n\t\t\t\t@node->~Node();\r\n\t\t\t\tfree(node);\r\n\t\t\t\t@this.length = this.length - 1;\r\n\r\n\t\t\t\treturn true;\r\n\t\t\t};\r\n\r\n\t\t\t@link = &@node->next;\r\n\t\t};\r\n\r\n\t\treturn false;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::clear(var unordered_map& this) {\r\n\t\tusize index = 0;\r\n\t\twhile (index < this.buckets.size()) {\r\n\t\t\tvar unordered_node<K, V>* node = this.buckets.data()[index];\r\n\t\t\twhile (node) {\r\n\t\t\t\tvar unordered_node<K, V>* next = node->next;\r\n\t\t\t\tusing Node = unordered_node<K, V>;\r\n\r\n\t\t\t\t@node->~Node();\r\n\t\t\t\tfree(node);\r\n\t\t\t\t@node = next;\r\n\t\t\t};\r\n\r\n\t\t\t@(@this.buckets).data()[index] = nullptr;\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\t@this.length = 0;\r\n\t};\r\n\r\n\ttemplate<typename K, typename V, typename Hash, typename Equal>\r\n\texport fn unordered_map<K, V, Hash, Equal>::reserve(var unordered_map& this, usize required) -> bool {\r\n\t\tif (required <= this.buckets.size()) {\r\n\t\t\treturn true;\r\n\t\t};\r\n\r\n\t\tusize maximum = usize::max / sizeof(var unordered_node<K, V>*);\r\n\t\tif (required > maximum) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize count = $required;\r\n\t\tif (count < 8) {\r\n\t\t\t@count = 8;\r\n\t\t};\r\n\r\n\t\tif (this.buckets.size() <= (maximum >> 1)) {\r\n\t\t\tusize grown = this.buckets.size() << 1;\r\n\t\t\tif (grown > count) {\r\n\t\t\t\t@count = grown;\r\n\t\t\t};\r\n\t\t};\r\n\r\n\t\tbuffer<var unordered_node<K, V>*> replacement;\r\n\t\tif (!@replacement.reserve(count)) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize index = 0;\r\n\t\twhile (index < count) {\r\n\t\t\tif (!@replacement.push_back(nullptr)) {\r\n\t\t\t\treturn false;\r\n\t\t\t};\r\n\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\t@index = 0;\r\n\t\twhile (index < this.buckets.size()) {\r\n\t\t\tvar unordered_node<K, V>* node = this.buckets.data()[index];\r\n\t\t\twhile (node) {\r\n\t\t\t\tvar unordered_node<K, V>* next = node->next;\r\n\t\t\t\tusize bucket = node->hash_code % count;\r\n\r\n\t\t\t\t@node->next = replacement.data()[bucket];\r\n\t\t\t\t@(@replacement).data()[bucket] = node;\r\n\t\t\t\t@node = next;\r\n\t\t\t};\r\n\r\n\t\t\t@index = index + 1;\r\n\t\t};\r\n\r\n\t\t@this.buckets = $replacement;\r\n\r\n\t\treturn true;\r\n\t};\r\n};\r\n"},{"module":"std","path":"compiler/std\\variant.rt","text":"namespace rt {\r\n\texport struct monostate {\r\n\t};\r\n\r\n\ttemplate<typename...Ts>\r\n\texport struct variant {\r\n\tprivate:\r\n\t\tunion {\r\n\t\t\tTs... _elements;\r\n\t\t} _storage;\r\n\t\tusize _index;\r\n\t};\r\n};\r\n"}],"format":1,"module":"std","pointer_bits":64}