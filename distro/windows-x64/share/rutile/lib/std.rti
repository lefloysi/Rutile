 - 1;\r\n\t\tif (required > maximum) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tusize count = $required;\r\n\t\tusize capacity = this.capacity();\r\n\t\tusize half = capacity >> 1;\r\n\t\tif (capacity > maximum - half) {\r\n\t\t\t@count = $maximum;\r\n\t\t}\r\n\t\telse if (capacity + half > count) {\r\n\t\t\t@count = capacity + half;\r\n\t\t};\r\n\r\n\t\tvar char* replacement = static_cast<var char*>(malloc(count + 1));\r\n\t\tif (!replacement) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tmemcpy(replacement, this.data(), this.length + 1);\r\n\t\tif (this.heap_capacity) {\r\n\t\t\tfree(this.storage.heap);\r\n\t\t};\r\n\r\n\t\t@this.storage.heap = $replacement;\r\n\t\t@this.heap_capacity = $count;\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\texport fn string::append(var string& this, string_view text) -> bool {\r\n\t\tif (text.empty()) {\r\n\t\t\treturn true;\r\n\t\t};\r\n\r\n\t\tif (text.size() > usize::max - this.length - 1) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tchar* source = text.data();\r\n\t\tusize address = reinterpret_cast<usize>(source);\r\n\t\tusize begin = reinterpret_cast<usize>(this.data());\r\n\t\tbool aliases = address >= begin && address - begin <= this.length;\r\n\t\tusize offset = 0;\r\n\t\tif (aliases) {\r\n\t\t\t@offset = address - begin;\r\n\t\t};\r\n\r\n\t\tusize length = this.length + text.size();\r\n\t\tif (!@this.reserve(length)) {\r\n\t\t\treturn false;\r\n\t\t};\r\n\r\n\t\tvar char* destination = (@this).data();\r\n\t\tif (aliases) {\r\n\t\t\t@source = destination + offset;\r\n\t\t};\r\n\r\n\t\tmemmove(destination + this.length, source, text.size());\r\n\t\t@destination[length] = '\\0';\r\n\t\t@this.length = $length;\r\n\r\n\t\treturn true;\r\n\t};\r\n\r\n\texport fn string::string(var string& this, string& other) {\r\n\t\t@this.append(other.view());\r\n\t};\r\n\r\n\texport fn string::string(var string& this, string_view text) {\r\n\t\t@this.append(text);\r\n\t};\r\n\r\n\texport fn string::~string(var string& this) {\r\n\t\tif (this.