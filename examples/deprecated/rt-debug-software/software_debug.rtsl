struct Point { vec3 position; vec4 color; };

struct Vertex : Position {
    vec4 color;
    fn Vertex(Point point) : Position(vec4(point.position, 1.0)) { color = point.color; }
};

@stage : vertex
fn main(Point point) -> Vertex { return Vertex(point); }

@stage : fragment
fn main(Vertex vertex) -> vec4 { return vertex.color; }
