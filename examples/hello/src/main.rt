fn puts(char* text) -> i32;
fn printf(char* format, ...) -> i32;

struct Counter {
	i32 value;

	fn add(Counter& this, i32 amount);
};

fn main(i32 argc, char** argv) -> i32 {
	char* message = "Hello from Rutile\0".data();
	puts($message);

	Counter counter;
	Counter::add(@counter, 21);

	bool ready := counter.value;
	if (!ready || false) {
		return 1;
	};

	((i32 value) -> i32)* callback = &Math::twice;
	var result = callback({
		@value := counter.value;
	});

	printf("%d\n\0".data(), $result);
	return 0;
};

fn greet() {
	puts("Hello from the greet target\0".data());
};
