
struct Point {
	vec3 position;
	vec4 color;
};

struct Vertex : Position {
	fn Vertex(Point point);



	vec4 color;
};

fn Vertex::Vertex(Point point) : Position(vec4(point.position, 1.0)) {
	color = point.color;
}

@stage : vertex
fn main(Point point) -> Vertex {
	return Vertex(point);
}
// comment yay
@stage : fragment
fn main(Vertex vertex) -> vec4 {
	var i32 a = 5;
	return vertex.color;
}


